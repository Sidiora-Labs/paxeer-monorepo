[service.router]
kind = "repo"
dockerfile = "docker/platform-gateway/Dockerfile"
root = "/"
watch = ["/docker/platform-gateway/**", "/docker/common/**", "/services/platform/**", "/services/agent/**", "/services/interop/**", "/services/human/**", "/programs/**"]
health = "/livez"
restart = "ALWAYS"
replicas = 3
public = 1
order = 5
needs = ["redis-router", "sequencer-primary", "sequencer-standby"]

[vars.router]
PORT = "8080"
LAYERX_FILES_TABLE = "/etc/layerx/native-files.tsv"
LAYERX_GATEWAY_LISTENER = "plain"
LAYERX_GATEWAY_NETWORK_ID = "env:PLATFORM_ROUTER_LAYERX_GATEWAY_NETWORK_ID"
LAYERX_GATEWAY_PROTOCOL_NETWORK_ID = "env:PLATFORM_ROUTER_LAYERX_GATEWAY_PROTOCOL_NETWORK_ID"
LAYERX_GATEWAY_LXP_WIRE_VERSION = "env:PLATFORM_ROUTER_LAYERX_GATEWAY_LXP_WIRE_VERSION"
LAYERX_GATEWAY_REDIS_URL = "rediss://${{redis-router.RAILWAY_PRIVATE_DOMAIN}}:6379"
LAYERX_GATEWAY_REDIS_USERNAME_FILE = "/run/secrets/redis-username"
LAYERX_GATEWAY_REDIS_PASSWORD_FILE = "/run/secrets/redis-password"
LAYERX_GATEWAY_OUTBOUND_CA_DER = "/run/secrets/ca.crt.der"
LAYERX_GATEWAY_PAXEER_RPC_URLS = "env:PLATFORM_ROUTER_LAYERX_GATEWAY_PAXEER_RPC_URLS"
LAYERX_GATEWAY_RECEIPT_KEYS_FILE = "/run/secrets/receipt-keys.json"
ENDPOINT_OUTBOUND_CA = "env:PLATFORM_ROUTER_ENDPOINT_OUTBOUND_CA"
ENDPOINT_REDIS_USERNAME = "env:PLATFORM_ROUTER_ENDPOINT_REDIS_USERNAME"
ENDPOINT_REDIS_PASSWORD = "env:PLATFORM_ROUTER_ENDPOINT_REDIS_PASSWORD"
ENDPOINT_RECEIPT_KEYS = "env:PLATFORM_ROUTER_ENDPOINT_RECEIPT_KEYS"

[inputs.router]
# Hosted discovery identity label, an ASCII identifier of at most 64 characters.
PLATFORM_ROUTER_LAYERX_GATEWAY_NETWORK_ID = "operator"
# Native protocol network identifier, an unsigned decimal 32-bit integer.
PLATFORM_ROUTER_LAYERX_GATEWAY_PROTOCOL_NETWORK_ID = "operator"
# Current receipt/state-commitment wire version, a decimal unsigned 16-bit integer.
PLATFORM_ROUTER_LAYERX_GATEWAY_LXP_WIRE_VERSION = "operator"
# Node RPC endpoints, a JSON array of two to eight distinct HTTPS URLs.
PLATFORM_ROUTER_LAYERX_GATEWAY_PAXEER_RPC_URLS = "operator"
# Outbound TLS trust certificate, base64-encoded DER bytes.
PLATFORM_ROUTER_ENDPOINT_OUTBOUND_CA = "operator"
# Redis ACL username shared with redis-router, base64-encoded UTF-8 text.
PLATFORM_ROUTER_ENDPOINT_REDIS_USERNAME = "operator"
# Redis ACL password shared with redis-router, base64-encoded UTF-8 secret text.
PLATFORM_ROUTER_ENDPOINT_REDIS_PASSWORD = "generated"
# Authenticated governed receipt-key export, base64-encoded JSON array with base64 keyId/publicKey and integer firstHeight/lastHeight.
PLATFORM_ROUTER_ENDPOINT_RECEIPT_KEYS = "operator"
