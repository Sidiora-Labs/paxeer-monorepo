[service.human-web]
kind = "repo"
dockerfile = "docker/web/Dockerfile"
root = "."
watch = ["docker/web/**", "apps/web/**", "services/agent/sdk/typescript/**", "sdk/wallet/**", "services/wallet/**", "package.json", "package-lock.json"]
health = "/"
restart = "ALWAYS"
replicas = 1
volume = "/data"
public = 1
order = 15
needs = ["human", "gateway"]

[vars.human-web]
PORT = "3000"
LAYERX_HUMAN_SERVICE_URL = "env:PLATFORM_HUMAN_WEB_LAYERX_HUMAN_SERVICE_URL"
LAYERX_HUMAN_WEB_ORIGIN = "https://${{RAILWAY_PUBLIC_DOMAIN}}"
LAYERX_GATEWAY_URL = "https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}"
PAXEER_X_EXPLORER_BASE_URL = "env:PLATFORM_HUMAN_WEB_PAXEER_X_EXPLORER_BASE_URL"
NEXT_PUBLIC_PAXEER_X_EXPLORER_BASE_URL = "env:PLATFORM_HUMAN_WEB_NEXT_PUBLIC_PAXEER_X_EXPLORER_BASE_URL"
LAYERX_RUM_STORAGE_DIRECTORY = "/data/performance"
LAYERX_SUPPORT_REPORT_DIR = "/data/support"
LAYERX_SUPPORT_REPORT_BEARER_TOKEN = "env:PLATFORM_HUMAN_WEB_LAYERX_SUPPORT_REPORT_BEARER_TOKEN"

[inputs.human-web]
# Human service HTTPS origin, without credentials, query or fragment; an optional /human suffix is accepted.
PLATFORM_HUMAN_WEB_LAYERX_HUMAN_SERVICE_URL = "operator"
# Server explorer HTTPS origin, without credentials, path, query or fragment.
PLATFORM_HUMAN_WEB_PAXEER_X_EXPLORER_BASE_URL = "operator"
# Browser explorer HTTPS origin embedded at build time, without credentials, path, query or fragment.
PLATFORM_HUMAN_WEB_NEXT_PUBLIC_PAXEER_X_EXPLORER_BASE_URL = "operator"
# Support retrieval bearer credential, a string of at least 32 characters after trimming.
PLATFORM_HUMAN_WEB_LAYERX_SUPPORT_REPORT_BEARER_TOKEN = "operator"
