[service.gateway]
kind = "repo"
dockerfile = "docker/platform-gateway/Dockerfile"
root = "/"
watch = ["/docker/platform-gateway/**", "/docker/common/**", "/services/platform/**", "/services/agent/**", "/services/interop/**", "/services/human/**", "/programs/**"]
health = "/livez"
restart = "ALWAYS"
replicas = 3
public = 1
order = 5
needs = ["redis-gateway", "sequencer-primary", "sequencer-standby"]

[vars.gateway]
PORT = "8080"
LAYERX_FILES_TABLE = "/etc/layerx/native-files.tsv"
LAYERX_ROLE = "identity"
LAYERX_GATEWAY_LISTENER = "plain"
LAYERX_GATEWAY_NETWORK_ID = "env:PLATFORM_GATEWAY_LAYERX_GATEWAY_NETWORK_ID"
LAYERX_GATEWAY_PROTOCOL_NETWORK_ID = "env:PLATFORM_GATEWAY_LAYERX_GATEWAY_PROTOCOL_NETWORK_ID"
LAYERX_GATEWAY_LXP_WIRE_VERSION = "env:PLATFORM_GATEWAY_LAYERX_GATEWAY_LXP_WIRE_VERSION"
LAYERX_GATEWAY_REDIS_URL = "rediss://${{redis-gateway.RAILWAY_PRIVATE_DOMAIN}}:6379"
LAYERX_GATEWAY_REDIS_USERNAME_FILE = "/run/secrets/redis-username"
LAYERX_GATEWAY_REDIS_PASSWORD_FILE = "/run/secrets/redis-password"
LAYERX_GATEWAY_OUTBOUND_CA_DER = "/run/secrets/ca.crt.der"
LAYERX_GATEWAY_PAXEER_RPC_URLS = "env:PLATFORM_GATEWAY_LAYERX_GATEWAY_PAXEER_RPC_URLS"
LAYERX_GATEWAY_RECEIPT_KEYS_FILE = "/run/secrets/receipt-keys.json"
LAYERX_GATEWAY_IDENTITY_URL = "env:PLATFORM_GATEWAY_LAYERX_GATEWAY_IDENTITY_URL"
LAYERX_GATEWAY_TENANT = "env:PLATFORM_GATEWAY_LAYERX_GATEWAY_TENANT"
LAYERX_GATEWAY_IDENTITY_TOKEN_FILE = "/run/secrets/identity-token"
LAYERX_GATEWAY_IDENTITY_PROVISIONING_TOKEN_FILE = "/run/secrets/identity-provisioning-token"
LAYERX_GATEWAY_CLIENT_IDENTITY_PKCS12 = "/run/secrets/client.p12"
LAYERX_GATEWAY_CLIENT_IDENTITY_PASSWORD_FILE = "/run/secrets/client-password"
ENDPOINT_OUTBOUND_CA = "env:PLATFORM_GATEWAY_ENDPOINT_OUTBOUND_CA"
ENDPOINT_REDIS_USERNAME = "env:PLATFORM_GATEWAY_ENDPOINT_REDIS_USERNAME"
ENDPOINT_REDIS_PASSWORD = "env:PLATFORM_GATEWAY_ENDPOINT_REDIS_PASSWORD"
ENDPOINT_RECEIPT_KEYS = "env:PLATFORM_GATEWAY_ENDPOINT_RECEIPT_KEYS"
ENDPOINT_IDENTITY_TOKEN = "env:PLATFORM_GATEWAY_ENDPOINT_IDENTITY_TOKEN"
ENDPOINT_IDENTITY_PROVISIONING_TOKEN = "env:PLATFORM_GATEWAY_ENDPOINT_IDENTITY_PROVISIONING_TOKEN"
ENDPOINT_CLIENT_P12 = "env:PLATFORM_GATEWAY_ENDPOINT_CLIENT_P12"
ENDPOINT_CLIENT_PASSWORD = "env:PLATFORM_GATEWAY_ENDPOINT_CLIENT_PASSWORD"

[inputs.gateway]
# Hosted discovery identity label, an ASCII identifier of at most 64 characters.
PLATFORM_GATEWAY_LAYERX_GATEWAY_NETWORK_ID = "operator"
# Native protocol network identifier, an unsigned decimal 32-bit integer.
PLATFORM_GATEWAY_LAYERX_GATEWAY_PROTOCOL_NETWORK_ID = "operator"
# Current receipt/state-commitment wire version, a decimal unsigned 16-bit integer.
PLATFORM_GATEWAY_LAYERX_GATEWAY_LXP_WIRE_VERSION = "operator"
# Node RPC endpoints, a JSON array of two to eight distinct HTTPS URLs.
PLATFORM_GATEWAY_LAYERX_GATEWAY_PAXEER_RPC_URLS = "operator"
# Outbound TLS trust certificate, base64-encoded DER bytes.
PLATFORM_GATEWAY_ENDPOINT_OUTBOUND_CA = "operator"
# Redis ACL username shared with redis-gateway, base64-encoded UTF-8 text.
PLATFORM_GATEWAY_ENDPOINT_REDIS_USERNAME = "operator"
# Redis ACL password shared with redis-gateway, base64-encoded UTF-8 secret text.
PLATFORM_GATEWAY_ENDPOINT_REDIS_PASSWORD = "generated"
# Authenticated governed receipt-key export, base64-encoded JSON array with base64 keyId/publicKey and integer firstHeight/lastHeight.
PLATFORM_GATEWAY_ENDPOINT_RECEIPT_KEYS = "operator"
# Identity service address, an absolute HTTPS URL of the identity service.
PLATFORM_GATEWAY_LAYERX_GATEWAY_IDENTITY_URL = "operator"
# Registration tenant, 1 to 95 lowercase letters, digits, dots, underscores or hyphens.
PLATFORM_GATEWAY_LAYERX_GATEWAY_TENANT = "operator"
# Identity service token, base64-encoded token text issued by the identity service.
PLATFORM_GATEWAY_ENDPOINT_IDENTITY_TOKEN = "operator"
# Registration provisioning token, base64-encoded token text issued by the identity service.
PLATFORM_GATEWAY_ENDPOINT_IDENTITY_PROVISIONING_TOKEN = "operator"
# Base64-encoded PKCS#12 client identity bundle written by the launcher.
PLATFORM_GATEWAY_ENDPOINT_CLIENT_P12 = "generated"
# Base64-encoded client identity password written by the launcher.
PLATFORM_GATEWAY_ENDPOINT_CLIENT_PASSWORD = "generated"
