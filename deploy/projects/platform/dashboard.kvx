# The dashboard API is built from the repository root and serves its readiness
# route on the plain listener used by the hosting platform.
[service.dashboard]
kind = "repo"
dockerfile = "docker/platform-dashboard/Dockerfile"
root = "."
watch = ["docker/platform-dashboard/**", "docker/common/**", "services/platform/**", "services/agent/**", "services/interop/**", "services/human/**", "programs/**"]
health = "/healthz"
restart = "ALWAYS"
replicas = 1
order = 8
needs = ["redis-gateway", "redis-internal", "identity"]

[vars.dashboard]
PORT = "9445"
DASHBOARD_CLIENT_CERT = "env:PLATFORM_DASHBOARD_DASHBOARD_CLIENT_CERT"
DASHBOARD_CLIENT_P12 = "env:PLATFORM_DASHBOARD_DASHBOARD_CLIENT_P12"
DASHBOARD_CLIENT_PASSWORD = "env:PLATFORM_DASHBOARD_DASHBOARD_CLIENT_PASSWORD"
DASHBOARD_CLIENT_CA_DER = "env:PLATFORM_DASHBOARD_DASHBOARD_CLIENT_CA_DER"
DASHBOARD_WEBHOOKS_REDIS_USERNAME = "env:PLATFORM_DASHBOARD_DASHBOARD_WEBHOOKS_REDIS_USERNAME"
DASHBOARD_WEBHOOKS_REDIS_PASSWORD = "env:PLATFORM_DASHBOARD_DASHBOARD_WEBHOOKS_REDIS_PASSWORD"
DASHBOARD_GATEWAY_REDIS_USERNAME = "env:PLATFORM_DASHBOARD_DASHBOARD_GATEWAY_REDIS_USERNAME"
DASHBOARD_GATEWAY_REDIS_PASSWORD = "env:PLATFORM_DASHBOARD_DASHBOARD_GATEWAY_REDIS_PASSWORD"
DASHBOARD_IDENTITY_TOKEN = "env:PLATFORM_DASHBOARD_DASHBOARD_IDENTITY_TOKEN"
LAYERX_DASHBOARD_GATEWAY_REDIS_URL = "env:PLATFORM_DASHBOARD_LAYERX_DASHBOARD_GATEWAY_REDIS_URL"
LAYERX_DASHBOARD_GATEWAY_REDIS_USERNAME_FILE = "/run/layerx/dashboard-redis/username"
LAYERX_DASHBOARD_GATEWAY_REDIS_PASSWORD_FILE = "/run/layerx/dashboard-redis/password"
LAYERX_DASHBOARD_REDIS_CA_DER = "/run/layerx/ca/internal.der"
LAYERX_DASHBOARD_INTERNAL_CA_DER = "/run/layerx/ca/internal.der"
LAYERX_DASHBOARD_CLIENT_IDENTITY_PKCS12 = "/run/layerx/client/identity.p12"
LAYERX_DASHBOARD_CLIENT_IDENTITY_PASSWORD_FILE = "/run/layerx/client/password"
LAYERX_DASHBOARD_IDENTITY_URL = "env:PLATFORM_DASHBOARD_LAYERX_DASHBOARD_IDENTITY_URL"
LAYERX_DASHBOARD_IDENTITY_TOKEN_FILE = "/run/layerx/tokens/identity"
LAYERX_DASHBOARD_LISTEN = "[::]:9445"
LAYERX_DASHBOARD_LISTENER = "plain"
LAYERX_WEBHOOKS_REDIS_URL = "env:PLATFORM_DASHBOARD_LAYERX_WEBHOOKS_REDIS_URL"
LAYERX_WEBHOOKS_INTERNAL_CA_DER = "/run/layerx/ca/internal.der"
LAYERX_WEBHOOKS_REDIS_USERNAME_FILE = "/run/layerx/redis/username"
LAYERX_WEBHOOKS_REDIS_PASSWORD_FILE = "/run/layerx/redis/password"

[inputs.dashboard]
# Base64-encoded client certificate material written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_CLIENT_CERT = "generated"
# Base64-encoded client identity bundle written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_CLIENT_P12 = "generated"
# Base64-encoded client identity password written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_CLIENT_PASSWORD = "generated"
# Base64-encoded internal CA certificate written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_CLIENT_CA_DER = "generated"
# Redis username for the webhook event store, written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_WEBHOOKS_REDIS_USERNAME = "generated"
# Redis password for the webhook event store, written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_WEBHOOKS_REDIS_PASSWORD = "generated"
# Redis username for the gateway store, written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_GATEWAY_REDIS_USERNAME = "generated"
# Redis password for the gateway store, written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_GATEWAY_REDIS_PASSWORD = "generated"
# Identity session token, written by the launcher.
PLATFORM_DASHBOARD_DASHBOARD_IDENTITY_TOKEN = "generated"
# Internal Redis endpoint used by the gateway store.
PLATFORM_DASHBOARD_LAYERX_DASHBOARD_GATEWAY_REDIS_URL = "operator"
# Identity service endpoint used to authenticate dashboard sessions.
PLATFORM_DASHBOARD_LAYERX_DASHBOARD_IDENTITY_URL = "operator"
# Internal Redis endpoint used by the webhook event store.
PLATFORM_DASHBOARD_LAYERX_WEBHOOKS_REDIS_URL = "operator"
