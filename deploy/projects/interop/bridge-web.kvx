[service.bridge-web]
kind = "repo"
railway_service = "bridge-web"
dockerfile = "docker/bridge-web/Dockerfile"
root = "/"
watch = ["docker/bridge-web/**", "apps/bridge/**"]
health = "/"
restart = "ALWAYS"
replicas = 1
public = 1
order = 14
needs = []

[vars.bridge-web]
PORT = "3000"
NEXT_PUBLIC_BRIDGE_API_URL = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_API_URL"
NEXT_PUBLIC_BRIDGE_RPC_ARBITRUM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_ARBITRUM"
NEXT_PUBLIC_BRIDGE_RPC_AVALANCHE = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_AVALANCHE"
NEXT_PUBLIC_BRIDGE_RPC_BASE = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_BASE"
NEXT_PUBLIC_BRIDGE_RPC_BNB = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_BNB"
NEXT_PUBLIC_BRIDGE_RPC_ETHEREUM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_ETHEREUM"
NEXT_PUBLIC_BRIDGE_RPC_HYPEREVM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_HYPEREVM"
NEXT_PUBLIC_BRIDGE_RPC_OPTIMISM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_OPTIMISM"
NEXT_PUBLIC_BRIDGE_RPC_POLYGON = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_POLYGON"
NEXT_PUBLIC_BRIDGE_RPC_SOLANA = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_SOLANA"
NEXT_PUBLIC_BRIDGE_SOLANA_PROGRAM_ID = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_SOLANA_PROGRAM_ID"
NEXT_PUBLIC_BRIDGE_VAULT_ARBITRUM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_ARBITRUM"
NEXT_PUBLIC_BRIDGE_VAULT_AVALANCHE = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_AVALANCHE"
NEXT_PUBLIC_BRIDGE_VAULT_BASE = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_BASE"
NEXT_PUBLIC_BRIDGE_VAULT_BNB = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_BNB"
NEXT_PUBLIC_BRIDGE_VAULT_ETHEREUM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_ETHEREUM"
NEXT_PUBLIC_BRIDGE_VAULT_HYPEREVM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_HYPEREVM"
NEXT_PUBLIC_BRIDGE_VAULT_OPTIMISM = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_OPTIMISM"
NEXT_PUBLIC_BRIDGE_VAULT_POLYGON = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_POLYGON"
NEXT_PUBLIC_PAXEER_EXPLORER_URL = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_PAXEER_EXPLORER_URL"
NEXT_PUBLIC_PAXEER_RPC_URL = "env:INTEROP_BRIDGE_WEB_NEXT_PUBLIC_PAXEER_RPC_URL"

[inputs.bridge-web]
# Bridge attestation API, an absolute HTTP(S) base URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_API_URL = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_ARBITRUM = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_AVALANCHE = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_BASE = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_BNB = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_ETHEREUM = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_HYPEREVM = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_OPTIMISM = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_POLYGON = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_RPC_SOLANA = "operator"
# Solana custody program, a base58 public key.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_SOLANA_PROGRAM_ID = "chain"
# Arbitrum custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_ARBITRUM = "chain"
# Avalanche custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_AVALANCHE = "chain"
# Base custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_BASE = "chain"
# Bnb custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_BNB = "chain"
# Ethereum custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_ETHEREUM = "chain"
# Hyperevm custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_HYPEREVM = "chain"
# Optimism custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_OPTIMISM = "chain"
# Polygon custody vault, a checksummed EVM address.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_BRIDGE_VAULT_POLYGON = "chain"
# Paxeer explorer, an absolute HTTP(S) base URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_PAXEER_EXPLORER_URL = "operator"
# Chain JSON-RPC endpoint, an absolute HTTP(S) URL.
INTEROP_BRIDGE_WEB_NEXT_PUBLIC_PAXEER_RPC_URL = "operator"
