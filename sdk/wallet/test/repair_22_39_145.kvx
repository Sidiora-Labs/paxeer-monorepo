command = "cg spec done 22.39.145 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Three task-related failures: decoded plan omitted current EVM fields, gas module foreign-account refusal is session_changed, and px methods are implemented in px_account.go rather than spelled out in server.go."
repair = "Preserve and strictly validate every schema EVM leg field with malformed-field coverage and the current single layerx fee. Assert the module refusal plus retain direct provider account-mismatch coverage. Check the actual namespace registration and method declarations."
producer = "services/human/schema/human-api/intent.kvx:38; sdk/wallet/src/modules/gas-station.ts:403; rpc/server.go:329; rpc/px_account.go:213; rpc/px_account.go:279"

