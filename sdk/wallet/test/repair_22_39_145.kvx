[producer.journey]
files = ["sdk/wallet/src/human.ts", "sdk/wallet/src/types.ts", "sdk/wallet/src/ladder.ts"]
repair = "The decoder omitted schema states and stage tx_hash/nonce, so a valid producer golden could not survive decoding. Add the declared states and strictly validate optional metadata; preserve exact golden equality and negative bounds."

[producer.xweb-event]
file = "sdk/wallet/src/modules/web-data.ts:56"
repair = "XWebProgramRequested now declares kind, payload and sequence exactly as precompiles/xweb/abi.json; the ABI-driven event test checks every field."

[producer.submitted-acknowledgement]
file = "sdk/wallet/src/index.ts:246"
repair = "An inline submitted acknowledgement is not a signed receipt. Check its transaction identity and strict submitted fields directly, retaining authenticated keys/raw transaction checks for signed rungs. Existing source and client tests exercise this branch and foreign receipt rejection."

[producer.module-fallback]
file = "sdk/wallet/src/modules/index.ts:82"
repair = "The fallback poll already returns a receipt authenticated by the production receipt reader. Require that authentication and match the transaction before returning, avoiding a redundant second keys/raw transaction read; direct provider answers still authenticate normally."

[related.consumers]
files = ["sdk/wallet/test/gas-station.test.ts", "sdk/wallet/test/proof_wallet_sdk.test.ts", "sdk/wallet/test/repair-22-33-143.test.ts", "sdk/wallet/test/support/receipt-recordings.ts", "sdk/wallet/test/fixtures/sequencer-receipt.json"]
repair = "Update dependent consumers of the shared recordings for node routing and authenticated evidence. Copy committed bytes and block metadata unchanged from daemon/committed-fixture/vectors/vector-v4-committed.json; persist bigint metadata with an explicit JSON replacer where round-trip recovery is asserted. Expected authentication metadata comes from the conformance recording, never generated signatures or substitute state owners."

[gotcha.receipt-identity]
observed = "The receipted and committed entries in the shared fixture are different real transactions; projecting a committed rung onto the receipted hash cannot authenticate. Polling cases use the V4 receipted and committed views of one transaction."

[gotcha.batch-id]
observed = "A recorded JSON-RPC response id must be replaced after spreading the recorded response, otherwise batch replies cannot answer the active request."

[gotcha.react-renderer]
observed = "Standalone package installation separates the demo React installation from the wallet hooks; the renderer must resolve from the wallet package's declared dev dependencies."

[qualification.repair-one]
