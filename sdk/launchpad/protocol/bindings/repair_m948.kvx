[qualification.notes]
workflow = "Scope excludes root gotchas/spec edits and publication; this record carries finding mappings, out-of-scope wiring and gotchas, hf-done records the verified revision, and the runner commits."
gotcha_rpc = "JSON null in a recorded error field means no RPC error; the replay must preserve its real result rather than returning an empty error response."
gotcha_nonce = "Paxeer reserves pending nonces for the sequencer; serial retained scenarios sign with committed nonces and advance only after successful mining."
gotcha_precompile = "Go bind estimates reject native addresses with no bytecode; the public-method native scenario supplies an explicit transaction gas limit and requires successful receipts."
gotcha_integer = "Decoded and constructed big.Int zero values can have different internal slice representations; compare numeric values with Cmp."
gotcha_hash = "Paxeer RPC returns consensus block hashes independently of synthetic Ethereum Header.Hash; compare receipt and log hashes with the explicit RPC block hash."

