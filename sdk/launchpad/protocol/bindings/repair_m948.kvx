[finding.retained_binding_proof_gap]
proof = "TestRepairM_948_RetainedEmitterV2; TestRepairM_948_BeaconOwnershipHandoff; TestRepairM_948_RoleMetadata"
path = "Reviewed source-hash-checked Solidity artifacts and strict recorded real JSON-RPC execution feed generated Go calls, Parse/Filter/Watch consumers; all seven scalar/array tuple families, indexed provenance, typed grants/revocation, unauthorized calls, malformed tuples, one-time migration and two-owner acceptance are asserted; WebSocket clients reopen before and after acceptance. The original eight producer comparisons remain intact."
qualification = "The declared gate evidence in /out/run/gates.jsonl is authoritative for this candidate revision."

[finding.runtime_emission_proof_gap]
proof = "TestRepairM_948_NativeExecutorTransport; TestRepairM_948_NativeExecutorNode"
status = "open"
path = "NativeExecutorNode drives all eight public initialize methods through role surfaces, checks the exact AlreadyInitialized() revert bytes, failed mined receipts, unchanged role logs and relevant public state, and administrative grant refusals/non-holder renounces. Market creation proves one Initialized(1) at the new pool and actual factory, registry and NFT logs. Buy, fee strategy, fee claim, approval and transfer logs are decoded by generated parsers at production origins. NativeExecutorTransport retains all helper codec, malformed-data, unknown-topic and origin assertions as schema evidence only."
qualification = "Only passing hf-build and hf-done evidence qualifies the production-method coverage claimed here. Helper emitAt grants, revocations and Initialized guard refusals cannot close this finding. Remaining production observations require the wiring request below."

[wiring.native_transcript]
schema = "native-execution.json records emitFamily/emitAt helpers (12 families, 25 role observations, 8 guard refusals). Its role grants, revocations, origin choices and Initialized refusals are schema evidence, not production-handler observations."
production = "native-node-rpc.json records current public ABI execution for all eight non-pool initialization refusals and reachable role operations through the real node; producer-revision.txt and handler/ABI source hashes pin its provenance. FeesRouter strategy logs originate at the FeesRouter and NFT identities even for direct 0x1017 calls. Pool Initialized is decoded with the generated shared Initialized(uint64) parser."
request = "precompiles/launchpad (owning precompile domain): supply governance-authorized production recordings for held-role renounces and FeeAccumulator authorizePool/authorizeOptical grants, ProtocolConfig writes, and successful Quoter/ProtocolConfig AccessControl role emissions. The public fixture accounts hold no migrated privileges, grantRole is refused, and non-holder renounce emits no RoleRevoked; helper-generated observations cannot fill this gap. Keep runtime_emission_proof_gap open until production-method consumers assert each remaining claimed observation."

[wiring.retained_transcripts]
resolved = "Source-artifact-hash-pinned emitter-rpc.json and beacon-rpc.json now capture the real repository node executing all generated-binding calls, tuple logs, refusals, filters, subscriptions and client reconnects. Public fixture keys are integers 1 through 3 on Paxeer chain 125."

[wiring.registry]
request = "sdk/launchpad/protocol/events.go (owning domain 4): register NativeLaunchpadMetaData independently of retained EventEmitter metadata so all native family topics reach protocol.LookupEvent."

[wiring.indexer]
request = "services/launchpad/indexer/internal/decode and internal/processor/airdrop_test.go (owning domain 4): consume the same recorded executor logs through Decoder.Decode and replace constructed non-pool Initialized runtime evidence with actual executor refusals; codec tests remain schema evidence."

