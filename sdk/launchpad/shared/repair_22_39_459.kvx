[repair]
goconst = "Private constants preserve repeated status, role, method and protocol values."
errcheck = "Resource closure, transaction rollback, unlock and temporary-file cleanup errors are observed."
gosec = "Directory-rooted access confines file operations; numeric fields keep validated ranges and wire widths; consumers own lifecycle cancellation."
prealloc = "History, role and query argument slices reserve known capacity."
staticcheck = "Boolean filters and realm and role dispatch use direct conditions; TLS policy rejects legacy custom dialers."
goimports = "Go imports follow the module ordering."
gofmt = "Go source layout uses standard formatting."
govet = "JSON field tags retain their literal names."
typecheck = "Capability roles and getter signatures use distinct constant names."

