[repair.22.33.951]
finding = "22.30.27/measurement-authority-layout"
tests = ["TestRepairM_951_CurrentAuthorityLayout", "TestRepairM_951_CommandProducesPinnedIndex", "TestRepairM_951_CompleteCandidateHashVerification", "TestRepairM_951_EveryAuthorityRequired", "TestRepairM_951_ObsoleteAuthorityCannotSubstitute", "TestRepairM_951_PinnedIndexAndPathGuards"]
implementation = "The source-index contract binds spec/layerx-merge/spec.kvx (current programme decisions and qualification requirements) and spec/layerx-merge/contracts/launchpad.md (reviewed domain-4 lane contract) instead of the absent launchpad/spec/production-system/spec.kvx. All existing deployment, consumer and measurement inputs remain mandatory; source.go is mandatory as the index producer itself."
producer = "The measure command's -write-source-index mode uses -source-root and -source-index, hashes every required input and every additional positional candidate path, validates the resulting index and exclusively writes private JSON. Tests consume that real output through readPinned, strict JSON decode and validateSource, independently checking every source digest. Both measurement-time validateSource calls remain unchanged."
baseline = "No earlier hf-build/hf-done ledger or partial repair was present. The explicit implementation-first and single-verification gate order supersedes do_5's unchanged-tree verification request; no baseline command ran and no pre-change test failure is claimed. The audit's missing-path finding is recorded evidence, not a newly executed gate."
wiring = "Private capability measurement plan/source-index producers owned by launchpad measurement domain 4: invoke sdk/launchpad/shared/config/capabilities/cmd/measure with -write-source-index, include any additional candidate paths, and pin the resulting JSON digest in MeasurementPlan.candidateSha256 and both consumer exports; regenerate private approvals and consumer builds together. No tracked external source-index producer was found."
qualification = "The final candidate's revision, exact command, exit code and private evidence path are the last hf-done JSON record in /out/run/gates.jsonl, copied verbatim into the task response; this record is not a claim that any unrun gate passed."
