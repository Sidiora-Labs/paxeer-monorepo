[finding.env-retired-rpc-fixture]
tests = ["TestRepairM_952_ReviewedSuccessFixtures", "TestRepairM_952_CurrentRPCKeys", "TestRepairM_952_NegativeRPCFixtures"]
proof = "The existing success fixtures use reviewed api1/api2 root origins, with exact fallback preservation asserted. Production Load and LoadWithManifest parse all fourteen numbered origins plus the pooled root as both RPC keys against deployment.Current. Malformed URLs are rejected with no partial environment or secret disclosure; credential-bearing values occur only in negative disclosure and conflicting-export cases, preserving all existing assertions."
