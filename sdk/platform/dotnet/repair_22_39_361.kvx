done_command = "cg spec done 22.39.361 -f layerx-merge --root /work/paxeer-monorepo"
counts_evidence = "The bounded verification log records the actual run counts; qualification requires all 13 selected facts to pass with zero failed and zero skipped. The five sequencer facts include the wrapper, which also executes the preexecution refusal; the portable class contains eight facts. No result is claimed until hf-done passes."
