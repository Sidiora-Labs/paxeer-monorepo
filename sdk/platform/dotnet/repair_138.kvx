[repair.22.31.138]
audit = "22.30.75"
base = "ff6bf6162f496eda36bdb11465eb09d6f21a6fdd"
mode = "BUILD"
evidence = "The runner's hf-build/hf-done ledger records the qualified candidate revision, exact command, exit and private log path. No qualification is claimed by this record."
baseline = "Not run: explicit task gate order forbids testing before complete implementation and allows only the bounded hf-done invocation; step 10's unchanged-tree verify conflicts with that order. No baseline test failures are claimed."
agent-request-version = "TestRepair_138_agent_request_version: all catalogue encoders use transport version 1; an SDK catalogue mutation crosses the production gateway HTTP forwarding client into the daemon decoder and recovered owner-session authorization with an idempotency key."
agent-response-envelope = "TestRepair_138_agent_response_envelope: the real daemon decoder and response producer exchange bytes with the real C# HTTP transport; success and typed refusal have exact unversioned fields."
agent-verification-shapes = "TestRepair_138_agent_verification_shapes: the real daemon emits achieved, unverified, pending and absent; the C# HTTP consumer refuses unknown fields/rungs and non-strict shortfalls."
agent-bootstrap-credential = "TestRepair_138_agent_bootstrap_credential: registration and session opening reach the real daemon owner-session authorization path after session rotation, persistence and reopen; both the SDK and daemon refuse missing credentials and the daemon refuses wrong generations."
portable-validator-trust = "TestRepair_138_portable_validator_trust: independently recorded Comet header pin admits the genuine proof and rejects a cryptographically self-consistent replacement validator/header/commit chain retaining the genuine receipt."
stream-undelivered-cursor = "TestRepair_138_stream_undelivered_cursor: partial delivery and cancellation persist only the delivered cursor; a new OS process reopens it and recovers every remaining event."
trust-api = "PortableReceipt.verify/export accept a PortableReceiptTrust obtained independently of the untrusted bundle; committed promotion requires the selected chain, height and exact header hash. Committed.Verify authenticates the pinned header's validators, successor link and validator transition."
existing-tests = "AgentEnvelopeMajor2Tests now asserts version-1 requests and rejects every versioned response; PortableReceiptTests obtains independent published trust or captures trust when its test consensus producer creates the header, passing the original pin to every tampered-proof refusal. The repair harness also compiles the existing test project."
wiring-owner-session = "services/agent and services/platform/hosted/gateway, owning domain 8: qualify the deployed mTLS gateway route and owner registration/session-preparation effects with a provisioned gateway API key, Redis and node; the offline repair gate uses the production gateway HTTP forwarding client and daemon owner-session authorization, without substituting either codec or session authority."
wiring-consensus-pin = "SDK consumers outside sdk/platform/dotnet, owning domains 8 and 17: obtain the selected network's trusted Comet header hash independently and pass PortableReceiptTrust for committed bundle verification/export."
gotcha-gates = "The declared Go build does not compile C#; the declared Go verify compiles and executes the real C# repair harness and production Rust response producer, retaining private subprocess logs."
gotcha-runtime = "A stock Go sandbox lacks the .NET SDK and ICU; install .NET 8 and libicu before the C# formatter or subprocess qualification. No invariant-globalization switch is used to bypass receipt timestamp verification."
qualification-first = "aca969764faf7aacd3be825e9e49221e42be4ad7; cg spec done 22.31.138 -f layerx-merge --root /work/paxeer-monorepo; exit 1; /out/logs/verify-1.log; trust and process restart/recovery passed, task test helpers required Agent-plane name disambiguation and explicit inclusion of the daemon's private wire module."
qualification-previous-attempt = "47b397f35ae743d53e251bc203f10275681ada8c; cg spec done 22.31.138 -f layerx-merge --root /work/paxeer-monorepo; exit 1; previous attempt private /tmp/repair138-dotnet-3455335291/request.log and credential.log: request-version and bootstrap-credential failed solely because the live fixture was absent; the new harness removes that external prerequisite by executing production components locally."
gotcha-offline-gateway = "The complete gateway route authenticates API keys through Redis; the declared no-Redis gate can execute its real HTTP forwarding client, not the complete deployed gateway route. Full-route qualification is the explicit owning-domain wiring request."
gotcha-existing-tests = "An absent independent consensus pin can make an old malformed-proof test pass for the wrong reason; pass the unchanged producer pin to every existing committed-proof mutation assertion."
