[task.22.31.359]
finding = "jvm-native-prepare-shape"
tests = ["test_native_prepare_contract_matches_declared_schema", "test_native_daemon_answers_round_trip_in_jvm_client"]
baseline = "No baseline verify was run: the task's ordered gate instructions forbid testing before full implementation and forbid invoking verify_cmd outside hf-done. No pre-change test failure is claimed."
proof = "Compile verbatim daemon/API producer items and real wire/crypto dependencies; replay their native approval, native no-approval and EIP-1559 answers over HTTP into JVM request encoding and generated response decoding."
wiring_generated = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/GeneratedSchema.java and GeneratedContract.java — domain 8 (platform SDK): regenerate with generate_jvm.py and update GeneratedCatalogueProgramsTest.java's superseded five-field native result expectations."
wiring_transport = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/HttpProductionTransport.java — domain 8 (platform SDK): align the JVM's version-2 request with the daemon's ENVELOPE_VERSION=1 and align response decoding with agent_rpc.rs success_body (no response version; verification uses rung), before routing native daemon results through callAgentReply."
evidence = "Exact candidate revision, command, exit and private log are recorded by hf-build and hf-done; their gate ledger is authoritative."

[gotcha.native_prepare_interface]
symptom = "Replacing the native preparation schema with transaction fields discards signing and approval disclosure."
cause = "Native and EIP-1559 preparation are different producer records; the existing JVM HTTP response-envelope decoder also uses another contract."
do = "Keep the native record schema-owned, preserve every EIP-1559 fee/signing field separately, and qualify the generated models against real daemon codec output without changing out-of-scope consumers."

[qualification.first_verify]
revision = "6bdaf522b7a60c63e6aaa8fe34877f9bb9180965"
command = "cg spec done 22.31.359 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The isolated producer harness omitted layerx-crypto's custody feature, which owns the genuine EIP-1559 codec; enable its normal default features."

[gotcha.qualification_bytecode]
symptom = "py_compile writes bytecode inside the scoped directory, changing the runner's candidate between build and verify."
do = "Remove only the generated bytecode and set PYTHONPYCACHEPREFIX outside the source tree for both gate commands."
