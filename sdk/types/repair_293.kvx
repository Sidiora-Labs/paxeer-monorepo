[repair.22.31.293]
audit = "22.30.165"
base_revision = "ff6bf6162f496eda36bdb11465eb09d6f21a6fdd"
acceptance = "22998.1"
build_command = "go build ./sdk/types/..."
verify_command = "go test -count=1 -run '^TestRepair_293_' ./sdk/types/"
evidence = "The runner's hf-build/hf-done ledger records the exact candidate revision, command, exit code and private log; qualification requires both gates to pass at the same revision."
baseline = "Not executed: the explicit gate order requires complete implementation before formatting/build/verification, and forbids running verify_cmd manually; no previous gate ledger or repair tests existed at session start. No pre-change test failure is claimed."
wiring_requests = "None; both repair proposals are implemented within sdk/types and consumer implementations outside the scope are exercised without modification."

[finding.normalized-coins-invalid-set]
test = "TestRepair_293_NormalizedCoinsBankGenesis"
repair = "Normalize in SDK 18-place decimal precision, sum per normalized denomination, truncate each total once toward zero, remove zero amounts and sort."
proof = "ParseCoinsNormalized produces balances consumed by real bank Balance.Validate, protobuf JSON serialization, genesis decoding and GenesisState.Validate; cases cover multiple units, fractional carry, zero removal and sorting."
existing_tests = "TestConvertCoins and TestConvertDecCoins now require the single aggregated natom balance and additionally validate the resulting set."

[finding.canonical-json-number-loss]
tests = ["TestRepair_293_CanonicalJSONSignBytes", "TestRepair_293_CanonicalJSONGenesis", "TestRepair_293_CanonicalJSONStrictInput"]
repair = "Use json.Decoder.UseNumber, require EOF after the first JSON value, and marshal with deterministic key sorting while retaining numeric representations."
proof = "Exact positive/negative integers, precise decimals and nested exponent values pass through real MsgExecuteContract.GetSignBytes, StdSignBytes, secp256k1 signature transport/verification and message codec decoding; real GenesisDoc export and genutil genesis import preserve the same values."

[gotcha.gate-order]
observed = "The task's embedded pre-change verification step conflicts with its explicit gate order and wrapper prerequisite that a successful build precedes hf-done."
resolution = "Follow the explicit gate order and retain an honest baseline record; do not consume an undeclared verification run."
