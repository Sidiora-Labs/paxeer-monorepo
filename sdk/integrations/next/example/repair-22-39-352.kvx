[repair.22.39.352]
requirement = "22998.1"
base_revision = "ad52c8e6d41fa99019778be2402c5412cfa7b68a"
baseline = "Gotcha 4154 records Unknown module type for services/agent/sdk/typescript/node_modules/@scure/base/index.ts after make platform-js-install human-js-install; the prescribed implementation-first gate order does not permit a separate baseline Next build."
import_path = "app/paid/route.js:1 and app/layerx/webhooks/route.js:1 import lib/layerx.js:2, which imports @sidiora/layerx-next; sdk/integrations/next/src/index.ts:6-12 imports the agent SDK, whose src/account-derivation.ts:16 imports @scure/bip32; BIP32 imports @scure/base. lib/fulfillment.mjs:5-9 also imports seller middleware."
cause = "next.config.mjs transpiled @scure/bip32 alone while listing the integration, middleware and agent SDK as server external packages; any dependency reached in the bundled graph must still have its own TypeScript transpilation enabled, including the agent SDK's private @scure/base copy. Server external package declarations do not specify how bundled transitive dependencies are compiled."
change = "next.config.mjs includes @scure/base beside @scure/bip32 in transpilePackages; Turbopack and both Node route handlers remain enabled."
installed_exports = "The initial root @scure/base 2.4.0 copy has no exports map: main and module select index.js, types selects index.d.ts, and files includes index.ts; the private copy is inspected after hf-build creates it."
build_command = "make platform-js-install human-js-install"
verify_command = "test -s sdk/integrations/next/example/repair-22-39-352.kvx && npm run build --workspace @sidiora/layerx-example-next && rm -rf services/agent/sdk/typescript/node_modules && npm run build --workspace @sidiora/layerx-example-next"
private_install_result = "First npm run build in the hf-done verify command; its exit status and output are retained in the verification evidence."
root_install_result = "Second npm run build in the hf-done verify command, after removal of the agent SDK private node_modules; its exit status and output are retained in the same verification evidence."
verified_revision = "The exact candidate revision in the final hf-done evidence line and the matching build and verify rows of /out/run/gates.jsonl; an exit-zero verify row establishes both layout results."
evidence = "/out/run/gates.jsonl and /out/logs/build-1.log and /out/logs/verify-1.log (or the final repair run recorded by hf-done)."
