{
  "name": "@sidiora/layerx-next",
  "version": "0.1.0",
  "description": "One-call LayerX x402 route mount and client-bundle secret scanner for Next.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidiora-Labs/Paxeer-X-Network.git",
    "directory": "sdk/integrations/next"
  },
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js",
      "default": "./dist/scan.js"
    }
  },
  "bin": {
    "layerx-scan-bundle": "bin/layerx-scan-bundle.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../../.. run build:dependencies -- @sidiora/layerx-next",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/receipt-keys.test.mjs"
  },
  "dependencies": {
    "@sidiora/layerx-buyer-middleware": "file:../../../services/platform/middleware/buyer",
    "@sidiora/layerx-sdk": "file:../../../services/agent/sdk/typescript",
    "@sidiora/layerx-seller-middleware": "file:../../../services/platform/middleware/seller"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
