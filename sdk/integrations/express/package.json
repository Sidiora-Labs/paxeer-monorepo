{
  "name": "@sidiora/layerx-express",
  "version": "0.1.0",
  "description": "One-call LayerX x402 mount for Express applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidiora-Labs/Paxeer-X-Network.git",
    "directory": "sdk/integrations/express"
  },
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../../.. run build:dependencies -- @sidiora/layerx-express",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/receipt-keys.test.mjs"
  },
  "dependencies": {
    "@sidiora/layerx-buyer-middleware": "0.1.0",
    "@sidiora/layerx-sdk": "0.1.0",
    "@sidiora/layerx-seller-middleware": "0.1.0"
  },
  "peerDependencies": {
    "express": ">=4.18"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
