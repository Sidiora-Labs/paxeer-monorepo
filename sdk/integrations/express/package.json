{
  "name": "@sidiora/layerx-express",
  "version": "0.1.0",
  "description": "One-call LayerX x402 mount for Express applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidiora-Labs/paxeer-monorepo.git",
    "directory": "sdk/integrations/express"
  },
  "homepage": "https://github.com/Sidiora-Labs/paxeer-monorepo/tree/main/sdk/integrations/express",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm --prefix ../../.. run build:dependencies -- @sidiora/layerx-express",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs && npm --prefix example test",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@sidiora/layerx-buyer-middleware": "file:../../../services/platform/middleware/buyer",
    "@sidiora/layerx-sdk": "file:../../../services/agent/sdk/typescript",
    "@sidiora/layerx-seller-middleware": "file:../../../services/platform/middleware/seller"
  },
  "peerDependencies": {
    "express": ">=4.18"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
