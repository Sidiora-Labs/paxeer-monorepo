[repair.22.31.452]
acceptance = "22998.1"
test_class = "com.sidiora.layerx.spring.Repair2231452Test"
resolution = "Move the starter and example from the unpatched Spring Boot 3.3 line to the maintained Spring Boot 4 major, pinned to 4.0.7."
alignment = "Import spring-boot-dependencies 4.0.7 so Boot, auto-configuration, Spring Framework, Servlet, Jackson and JUnit resolve as one supported dependency set; Maven uses the BOM and has no separate lockfile in this module."
example = "Use the Boot 4 Web MVC starter and convert webhook Jackson 2 trees to plain Java values before the example's Boot 4 Jackson 3 HTTP serialization."
evidence = "The bounded hf-build and hf-done ledger records the verified candidate revision, exact commands, exits and private evidence locations; this record makes no independent qualification claim."
qualification = "Maven target output is relocated to private sandbox storage, keeping generated classes and changing Surefire reports outside the source candidate; the test resolves its storage parent to a canonical path and retains every production ownership and permission check."

