test_class = "com.sidiora.layerx.spring.Repair2233620Test"
evidence = "The bounded hf-build/hf-done ledger records the verified candidate revision, command, exit and private log; this mapping makes no independent qualification claim."
baseline = "Not run: the explicit implementation-first order and prohibition on manual verify runs override the contradictory unchanged-tree verification step; the repair test does not exist on the base and no pre-change test failure is claimed."
