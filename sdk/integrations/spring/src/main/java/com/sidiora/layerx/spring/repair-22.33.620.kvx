transport = "Loopback HTTP requests pass through the real payment filter, authority, portable decoder, signature/native-payment verifier and durable store into a keyed effect authority; responses pass through the real settlement decoder and receipt verifier. The external peer retains effect results in an in-memory store across production store/filter restarts."

[finding.028]
tests = ["finding028CrashBeforeReleaseReopensAndReconcilesBeforeExecuting", "finding028CrashAfterReleaseReopensAndRecoversWithoutRepeatingEffect", "finding028InterruptedLegacyReleaseAndConflictingClaimsCannotReplay"]
proof = "An atomic fsynced claim binds the complete payment identity before release. Reopened stores reconcile by the same idempotency key: confirmed absence permits release, recovered effects publish the original resource, and uncertain outcomes or legacy handlers refuse replay. Claims and completed results retain digest, receipt, key and transaction conflict checks."
compatibility = "Completed records without a state marker remain readable. Legacy unkeyed effects may complete their first admission, but an interrupted admission remains claimed until an explicit recovery authority is supplied; no automatic legacy replay is allowed."

[finding.029]
tests = ["finding029SimultaneousEqualRequestsReleaseOnceAndOtherKeysProceed"]
proof = "Concurrent verified equal payments wait on the same per-key admission before release, receive the identical stored resource and settlement header, and execute one release. A different principal proceeds while that key is held; all four conflict fields remain enforced."

[wiring]
