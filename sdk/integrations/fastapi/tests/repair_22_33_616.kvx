qualification = "Run only hf-build then hf-done with an external Python bytecode cache; the runner ledger and final evidence JSON name the exact verified candidate. The explicit offer-purpose interface is repaired within the expanded scope; no producer change is needed."

[gotcha.recorded_offer_purpose]
symptom = "A valid pinned native payment receipt passes direct seller verification but the real mounted route returns verification-failure."
cause = "The recorded transaction purpose and configured resource-bound offer purpose differ; reconstructing environment variables does not retain a manually replaced DeclaredConfig.requirements value."
do = "Bind the committed purpose using LayerXMountOptions.offer_purpose_hash; retain paid-response and restart assertions and refuse a receipt signed for another purpose."

[gotcha.candidate_bytecode]
symptom = "Python bytecode created inside a directory-scoped task can change the gate candidate between compilation and verification."
do = "Set the same external PYTHONPYCACHEPREFIX for hf-build and hf-done and disable import bytecode writes; keep generated caches outside the scoped test directory."

