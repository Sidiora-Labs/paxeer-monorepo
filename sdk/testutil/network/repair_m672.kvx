repair = "Task 22.31.463 repaired those callers on main; preserve the supplied network implementation and tests and qualify them on this base."
baseline = "No extra baseline verification: the supplied prior failure is retained, and the explicit gate order permits only hf-build followed by hf-done after implementation."
evidence = "The final hf-build/hf-done ledger supplies the exact current candidate revision, command, exit code and private log location without changing the candidate between gates."
