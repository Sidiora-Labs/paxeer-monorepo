exit = 1
log = "/out/logs/verify-1.log"
observed = "TestRepairM_1307_ObjectRoot/Unmarshal rejected non-object roots but published an allocated model pointer before returning the error; the other seven test functions passed."
repair = "Defer assigning a custom-unmarshaler pointer until decoding succeeds; retain the failing assertion and assert that a valid object still publishes its model pointer."
