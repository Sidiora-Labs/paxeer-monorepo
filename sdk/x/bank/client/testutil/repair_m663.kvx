[repair.22.33.663]
finding = "bank-cli-network-signature"
test = "TestRepairM_663_BankCLINetworkSignature"
implementation = "The norace entry point forwards t to network.DefaultConfig; the focused regression checks that tagged entry point and executes every existing case of the integration suite against its real in-process network, codecs and bank handlers."
baseline = "Not run: the explicit ordered gate instructions prohibit verification before implementation and prohibit invoking verify_cmd by hand; no pre-change runtime failures are claimed."
evidence = "The runner records the candidate revision, exact command, exit code and private evidence path in /out/run/gates.jsonl."
wiring_requests = []

