[continuation.22.33.663.metadata_cli]
gotcha = "GetCmdDenomsMetadata exposes no pagination flags and sends an empty QueryDenomsMetadataRequest; total-count coverage must explicitly request CountTotal through the real query client."
wiring_request = "sdk/x/bank/client/cli/query.go (owner domain 15): expose and forward pagination flags in GetCmdDenomsMetadata if CLI total-count selection is required; no production CLI change belongs to this task."
