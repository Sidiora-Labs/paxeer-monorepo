assumption = "These existing suite disagreements are independent of forwarding the testing handle; no unrelated repair, assertion change or unchanged gate rerun is authorized."

[continuation.22.33.663]
implementation = "Read the generated validator genesis file; derive supply from its balances and wei, complete bank metadata with the oracle genesis whitelist registrations, and size valid transaction fees from its global and validator gas prices. Preserve DefaultConfig(t), the norace tag, every network-backed case, exact response assertions and negative transaction codes."
prior_failures = "Attempt 1 recorded denomination metadata, total supply and valid-transaction fee failures; the balance cases passed. No unchanged baseline rerun was performed."
gotcha = "Oracle InitGenesis adds whitelisted-denom metadata missing from bank genesis, and the fork genesis imposes a global gas-price floor in addition to validator prices."
evidence = "The final verified revision and exact bounded gate result are recorded by hf-done in /out/run/gates.jsonl and the final /out/logs/verify-<n>.log."

[qualification.continuation.22.33.663]
revision = "b18d4ee8881732d9185ceb1a3acd264d1b91f7e6"
command = "cg spec done 22.33.663 -f layerx-merge --root /work/paxeer-monorepo"
