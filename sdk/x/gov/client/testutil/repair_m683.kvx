[repair.22.33.683]
status = "implemented; qualification requires the bounded hf-build and hf-done evidence"
acceptance = "22998.1"
verified_revision_source = "The hf-build and hf-done ledger records the exact candidate revision, command, exit code and private evidence path; no unchanged-tree verification or passing gate is claimed here."
baseline = "Not run: the explicit task order forbids tests before the entire implementation and permits verification only through hf-done after hf-build, overriding step 7's unchanged-tree baseline request."
wiring_request = "sdk/x/gov/client/utils/query.go, owning domain 15 (fm-cosmos-fork): QueryDepositsByTxQuery must aggregate initial and subsequent deposits by proposal/depositor, matching Keeper.AddDeposit, rather than returning transaction fragments; the scoped regression retains strict cumulative assertions."

[finding.gov-cli-test-config]
test = "TestRepairM_683_CLIConfig"
path = "cli_test.go"
repair = "Pass t to network.DefaultConfig; retain both suite.Run calls and all assertions. The proof builds both suite configurations and invokes the real application constructor, then compares its keeper deposit parameters with decoded governance genesis."

[finding.gov-deposit-fixture]
test = "TestRepairM_683_CumulativeDeposits"
path = "deposits.go"
repair = "Expect one cumulative entry per account and the initial amount plus 50; assert before and after finalization. Decode the live response envelope according to the queried proposal's actual status."
proof = "Real transaction codec and RunMsgs -> governance/bank keepers -> persisted ABCI event index and block store -> local RPC -> production deposit CLI -> existing suite query helpers. Compare single and list queries before finalization, after EndBlocker removes live deposits, and after stopping and reopening the on-disk index without replay."

[finding.gov-params-fixture]
test = "TestRepairM_683_Params"
path = "suite.go"
repair = "Derive aggregate and individual expectations from DefaultParams/DefaultVotingParams/DefaultTallyParams/DefaultDepositParams; assert equivalent complete JSON and YAML including expedited voting, quorum, threshold and nested deposit parameters."
proof = "Real governance keeper parameter store -> registered protobuf query service -> local ABCI RPC -> production aggregate/individual CLI -> the actual suite methods and semantic JSON/YAML assertions."

[gotcha.683]
area = "test"
symptom = "Historical deposit lists still expose transaction fragments although the single-depositor historical query sums the same messages."
cause = "The existing out-of-scope list consumer appends initial and later deposits without per-account aggregation."
do = "Retain the regression's cumulative expectations and route the wiring request to the consumer's owning domain; do not normalize the result inside a test helper."

[qualification.1]
revision = "58c0a82f390a9b4544142c9cba38aa296d0b0db4"
