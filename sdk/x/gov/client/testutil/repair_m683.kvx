exit = 1
log = "/out/logs/verify-1.log; detailed Go output /tmp/repair-m683.log"
observed = "Config, parameters and live cumulative deposits passed; the historical list exposed the pre-existing out-of-scope transaction fragments, then index reopening stopped at an empty-validator genesis state."
repair = "Supply a real validator in the fixture's persisted genesis and reuse that genesis when reopening; retain every cumulative single/list assertion and the owning-domain wiring request."

[gotcha.683.reopen]
area = "test"
symptom = "Reopening the on-disk consensus state reports validatorSet proposer error: nil validator."
cause = "A newly constructed test node accepted a genesis without validators, but that empty set cannot be decoded from its persisted state."
do = "Initialize persisted node fixtures with a real validator and reuse the genesis when reopening the index."

