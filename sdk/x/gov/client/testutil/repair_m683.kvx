[gotcha.683.constructor]
area = "test"
symptom = "The network application constructor fails on an empty Validator's nil AppConfig."
cause = "The constructor renders the validator's actual configuration and opens stores before InitChain populates keeper parameters."
do = "Provide default app and consensus configuration rooted in a temporary directory and initialize the configured genesis before querying keeper defaults."

[gotcha.683.message_logs]
area = "test"
symptom = "Historical deposit lookup cannot identify an indexed proposal submission even when its transaction events exist."
cause = "The fixture discarded RunMsgs result.Log, which binds the submission's proposal event to its message index."
do = "Persist the real producer's Log alongside Data and Events in the indexed ExecTxResult; never manufacture message logs or normalize historical query answers."
