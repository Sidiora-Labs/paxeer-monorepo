[repair.22.31.303]
audit = "22.30.166"
acceptance = "22998.1"
baseline = "Not run: the explicit gate order requires complete implementation before hf-build and permits verification only through hf-done; no pre-change test failure is claimed."
previous_attempt_revision = "f40e2e20e577965e0dcf0b210b97de7995a4c9bb"
previous_attempt_result = "TestRepair_303_BlockTxReversePagination failed comparing the locally decoded Any message cache against the uncached query response; the supplied previous-attempt evidence does not establish a pre-repair baseline."
evidence = "The runner's hf-build/hf-done ledger records the exact candidate revision, commands, exit codes and private log locations."
wiring = "spec/layerx-merge/spec.kvx — fm-cosmos-fork: copy the finding-to-test mapping below into the task record; task scope forbids editing spec files."

[finding.gas-estimate-stale-authinfo]
test = "TestRepair_303_GasEstimateStaleAuthInfo"
path = "sdk/x/auth/tx/repair_303_test.go"
proof = "Real builder, binary encoder/decoder, JSON codec and direct signing handler agree after encoding, decoding or signing primes the auth cache; repeated changes include zero and maximum uint64."

[finding.block-tx-reverse-pagination]
test = "TestRepair_303_BlockTxReversePagination"
path = "sdk/x/auth/tx/repair_303_test.go"
proof = "Builder-produced bank transactions pass through the real local consensus block store and client, registered transaction query router and protobuf query client; reverse pages cover one and five transactions including index zero and offsets past the end retain their error."

[gotcha.config-import]
observed = "An unaliased consensus/config import in an in-package test collides with the package-level config type."
fix = "Alias the consensus configuration import as tmconfig."

[gotcha.query-any-cache]
observed = "A protobuf query response preserves Any type URLs and values but does not necessarily populate nested message caches like the transaction decoder does."
fix = "Assert serialized transaction equality, then unpack the response through the real interface registry before asserting complete decoded transaction equality."
