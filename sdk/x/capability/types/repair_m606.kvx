baseline = "Not run: the ordered implementation-first instructions and the single hf-done gate override do_5's contradictory unchanged-tree verification request; no baseline test result is claimed."
wiring_request = "sdk/x/capability/genesis.go (cosmos-fork, domain 15): invoke genState.Validate before InitializeIndex/SetOwners so direct InitGenesis callers also enforce the boundary without relying on AppModuleBasic validation."
evidence = "The runner's hf-build/hf-done ledger records the exact candidate revision, command, exit code and private log location."
