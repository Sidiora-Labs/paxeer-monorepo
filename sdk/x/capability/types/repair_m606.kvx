[repair.22.33.606]
finding = "capability-genesis-invariants"
tests = ["TestRepairM_606_RejectConflictingGenesis", "TestRepairM_606_ImportRestartAuthenticateRelease", "TestRepairM_606_OwnerKeyOrdering"]
