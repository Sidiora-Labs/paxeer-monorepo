[qualification.continued_attempt]
baseline = "The inherited attempt failed TestRepairM_673_TestConfig, TestRepairM_673_DefaultFixture and both TestRepairM_673_OutputDenom cases at the first block: Commit(false) returned version zero instead of one."
repair = "Advance block versions with Commit(true); retain and reopen each block's actual committed database bytes because the legacy store explicitly rejects historical version reads."

[wiring.historical_store]
request = "sdk/store/rootmulti/store.go: domain 15 owns historical query support for network-backed CLI queries; CacheMultiStoreWithVersion currently refuses all versioned reads, so the focused gate serves reopened committed database fixtures."

