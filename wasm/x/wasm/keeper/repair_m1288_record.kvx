[gotcha.storev2_context]
observed = "storev2 commitment.Store buffers writes for commit and reads from committed trees; block execution needs a real CacheMultiStore."
fix = "The supplied-store fixture creates a cached context, writes it before the source commit, and replaces the destination context cache after restore."
