[task.22.39.150]
mode = "BUILD"
base_revision = "0afb3102d027a86c66782f3324ba8c3777b83055"
evidence = "The runner records the verified candidate revision, exact command, exit code and private log in /out/run/gates.jsonl; hf-build and hf-done must qualify the same candidate."

[producer.cw721-owner-lookup]
fact = "Keeper.execute calls emitCW721OwnerBeforeTransferIfApplicable before native Execute; CW1155 burn carries from, token_id and amount and rejects owner_of, so action-name-only classification aborted execution with ErrCW721OwnerLookup."
repair = "CW721TransferTokenID excludes amount-bearing burn/transfer_nft/send_nft and every send/send_batch/burn_batch/mint_batch action before querying; CW721 token decoding, malformed-transfer errors, query body, owner validation and owner event attributes retain their existing behavior."
consumer = "node/receipt_test.go TestEvmEventsForCw1155 is rerun by task 22.39.138 after this producer repair lands."

[test.cw1155-burn]
name = "TestRepair_184_CW1155BurnSkipsCW721Lookup"
proof = "Direct classification covers CW1155 shapes and all three CW721 shapes plus malformed tokens/transfers; real repair184CW721 contracts.Execute covers rejected amount-bearing burns with missing and existing tokens; real cw1155_base.wasm contracts.Execute additionally proves a successful amount-bearing burn with balance changing from one to zero, with no owner lookup error or pre-transfer owner event, and checks actual burned or retained ownership."
unchanged_tests = ["TestRepair_184_CW721OwnerFailures", "TestRepair_184_CW721JSONStrings"]

[qualification.fixture-repair]
revision = "7b1164d9c31655075f7540528ec77e1dd6a5c192"
command = "cg spec done 22.39.150 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The real CW721 fixture rejects unknown amount fields; the successful-burn case needs the repository's real CW1155 fixture, retaining the successful-execution assertion and proving a balance transition from one to zero."

[gotcha.fixture-protocol]
fact = "CW721 burn denies unknown amount fields, while CW1155 uses balance_of rather than owner_of; use contracts/wasm/cw1155_base.wasm for successful amount-bearing execution and keep CW721 rejection coverage."

