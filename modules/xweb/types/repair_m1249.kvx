[repair.22.33.1249]
audit = "22.30.61"
baseline = "Attempt 1 had no previous hf-build/hf-done ledger or repair tests. The explicit gate order prohibits testing before implementation and running verify by hand, so no unchanged-tree failure is claimed."
evidence = "hf-build and hf-done record the exact candidate revision, command, exit code and private log; the runner publishes only matching build and verify revisions."
policy = "SDK xweb error 26 is LXP_XWEB_INVALID_PAYLOAD, invalid storage receipt payload, terminal (Retryable no). Paid pending and all fulfilled records require a valid asset denomination. Historical zero-fee pending fixtures remain valid without a mapping. Answer headers and the exact chunk set must agree with the production writer and reader."

[finding.storage-receipt-error-name]
tests = ["TestRepairM_1249_StorageReceiptErrorName"]
proof = "Real payload encoder, keeper and 0x1019 EVM call; ABI Error(string) decode agrees with the common registry, with terminal classification against committed Python and TypeScript consumer maps."
wiring_contract = "spec/layerx-merge/contracts/address-table.md (chain-modules contract domain): add LXP_XWEB_INVALID_PAYLOAD, SDK xweb code 26, message invalid storage receipt payload, Retryable no; regenerate address-inventory.md and web.md as owned."
wiring_sdk = "services/agent/sdk/python/layerx_sdk/revert.py and services/agent/sdk/typescript/src/revert.ts (agent SDK domain): publish the code as terminal via scripts/ci/result-codes-gen.py; retain the Rust services/agent/crates/layerx-types/build.rs registry-derived classification."

[finding.pending-genesis-fee-denom]
tests = ["TestRepairM_1249_PendingGenesisFeeDenom", "TestRepairM_1249_ZeroFeeGenesisPolicy"]
proof = "Real paid request producer and bank ledger, module JSON export/import, disk close/reopen, protobuf QueryClient and signed fulfilment pay all four original denominations; second reopen preserves payouts and fulfilled records. Missing mappings are rejected without import writes."

[finding.program-answer-genesis]
tests = ["TestRepairM_1249_ProgramAnswerGenesisRecovery", "TestRepairM_1249_ProgramAnswerGenesisRejectsCorruption"]
proof = "Real signed fulfilment produces empty, boundary and multipart answers through 4096 bytes; module JSON import and disk reopen recover query results and invariants. Missing, extra, malformed and misowned chunks or invalid header lengths are rejected before import writes."

[gotcha.gate-order]
observed = "The embedded task asks for unchanged-tree verification while the explicit order allows verification only after complete implementation and hf-build."
resolution = "Follow the explicit order, preserve the gate budget, and report no baseline test result. GOTCHA.kvx and spec files are outside this task's scope."

[wiring.registry-parity]
request = "precompiles/common/lxp_errors_test.go (chain-modules domain): after the address-table owner adds the code-26 row, retain its exact registry/table parity assertions; do not weaken or bypass them."

