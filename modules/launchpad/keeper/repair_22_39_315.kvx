[qualification.finding.1]
task = "22.39.315"
file = "sdk/baseapp/abci_test.go:166"
symbol = "TestBaseAppCreateQueryContext"
observed = "At revision 539eb835e045e4597e5558fcaf8c1807ceb1abcf, cg spec done 22.39.315 -f layerx-merge --root /work/paxeer-monorepo exited 1 (log /out/logs/verify-1.log) because valid_height expects success from the legacy store, which refuses the requested versioned height-2 read."
assumption = "The inherited test must use a committed versioned store in its owning scope; production must retain the legacy store's refusal rather than silently query mutable working state."
severity = "blocker"

[qualification.finding.2]
task = "22.39.315"
