[baseline]
revision = "f738d3da03469c5e6080322b26260492a1879014"
command = "go test -count=1 ./modules/launchpad/keeper/... -run '^(TestCreateMarket|TestEveryPoolMigrates|TestQueryAirdropEpochABCICodes)$'"
