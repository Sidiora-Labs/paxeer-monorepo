symbol = "TestQuery"
observed = "At revision 539eb835e045e4597e5558fcaf8c1807ceb1abcf, cg spec done 22.39.315 -f layerx-merge --root /work/paxeer-monorepo exited 1 (log /out/logs/verify-1.log) because the inherited legacy-store query expected the committed value goodbye and received an empty value."
assumption = "The legacy-store query fixture must be repaired in its owning scope without restoring unsupported versioned reads or weakening the committed-value assertion."
severity = "blocker"

[qualification.finding.3]
