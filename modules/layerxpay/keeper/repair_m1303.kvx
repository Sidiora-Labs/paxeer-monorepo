baseline = "Working tree inspection found only runner-owned .cgignore and task in_progress changes, no repair code and no earlier gate ledger. No unchanged-tree verify ran: mandatory Order requires complete implementation followed by hf-build and hf-done, forbids running verify_cmd by hand and bounds gate runs. No baseline failure is claimed."

[finding.declaration-authority]
test = "TestRepairM_1303_DeclarationAuthority"
repair = "Contract declares CallerAuthority with DID/key/kernel authority fields; real binding, identity, family wrapper, Submit and stored hold prove the boundary without changing runtime authority."

[finding.budget-time-view]
test = "TestRepairM_1303_BudgetTimeView"
repair = "Detached projection mirrors kernel period advance, configured limit fallback, reset/capped carry and inclusive expiry; exact period/expiry milliseconds, skipped periods, exhausted periods, balance cap, unchanged host/pay bytes and a matching real spend are asserted."

[finding.escrow-corruption-panic]
test = "TestRepairM_1303_EscrowRecovery; TestRepairM_1303_EscrowPublicReads"
repair = "Keeper escrow reads return typed ErrEscrowCorruptState errors and distinct absence; precompile escrow handlers and service dispute readers propagate errors. Both keeper imports validate canonical owned keys, full wire lengths/versions, hold key/body identity and result/hold asset links before any writes. Real mutated exports fail atomically, including checksummed chunks; valid imports, database reopen and ABI public reads are proven."
boundary = "Keeper.GetEscrow, EscrowRemaining and GetEscrowResult now return three values directly with no panic path. All production consumers and keeper tests are updated in scope; out-of-scope test callers need the third return as wiring work below."

[finding.declaration-submit]
test = "TestRepairM_1303_DeclarationSubmit"
repair = "Contract declares common.Address/method inputs, method lookup, binding resolution, sequence/timestamp and bound-principal boundary; real wrapper, host receipt/result, typed refusals and reopened reads prove it."

[finding.declaration-gate]
test = "TestRepairM_1303_DeclarationGate"
repair = "Contract declares two-argument CheckWrite and method-derived family identity; real EscrowCapture caller proves disabled-family, pause and kernel gate refusals without writes, and exit/read gate behavior."

[finding.declaration-query]
test = "TestRepairM_1303_DeclarationQuery"
repair = "Contract declares Querier receiver and registration plus nil-request InvalidArgument; protobuf query-router transport and QueryServer consumer prove stored Params and read-only behavior."

[finding.declaration-keeper]
test = "TestRepairM_1303_DeclarationKeeper"
repair = "Contract declares EVMBinding and CustodyReader read signatures; real binding/custody producers and agent stream consumers prove pointer, native and factory asset/amount mapping."

[finding.declaration-constructor]
test = "TestRepairM_1303_DeclarationConstructor"
repair = "Contract declares implemented dependency interfaces and (Keeper,error), preserving missing-dependency refusals and optional custody behavior with real host, EVM and custody peers."

