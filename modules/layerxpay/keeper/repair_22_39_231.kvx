repair = "The index version is persistent module schema state, not a per-offer market or registry record to delete. TestServiceOfferPublishWithdraw asserts exactly the initial module snapshot plus that producer's version byte after publish, then exact snapshots after withdraw and refusal."
tests = "The full ServiceOffer equality remains and now binds ActivityID to the decoded real receipt, explicitly asserts both publication flags and names the kernel producer; balance, receipt, authorization, pause, sequence and withdrawal assertions remain intact."

[producer.genesis]
owner = "21f6e29026 (22.99.110): modules/layerxpay/keeper/escrow_views.go:42 Keeper.GetEscrow returns (types.EscrowRecord, bool, error), distinguishing absence from corrupt state."
consumer = "modules/layerxpay/integration/genesis_test.go reads the escrow produced by the real escrowOpen precompile before genesis export/import and checks its absence before restoration and equality after restoration."
repair = "Destructure all three GetEscrow results at all three consumer calls and require nil errors; retain the true presence flags and full EscrowRecord equalities before export and after restoration, and the false presence flag before restoration. No keeper implementation or keeper test changes in attempt 2."

[gotcha]
dispute = "A stricter general escrow view can mask a service-specific identifier mismatch; classify the link at its service consumer without weakening general corruption validation."
offer = "First successful service submission initializes a persistent service index version even when the activity creates no delivery/progress indexes."
genesis = "Gotcha 3762 and decision 2908: the integration consumer retained GetEscrow's former two-value shape after its producer added an error; the expanded attempt-2 scope permits this consumer correction."
restoration = "The first attempt-2 build exposed two additional former two-value GetEscrow calls in the same test's restoration path; migrate both together to the producer's three-value shape without changing presence or equality assertions."

