repair = "Check the stored escrow identifier against the agreement before invoking the stricter escrow reader, preserving explicit corrupt-state errors for malformed records whose identifiers match. All existing owner, beneficiary, asset, missing-record and arbiter checks remain."
tests = "TestServiceDisputeArbiterRefusals retains all cases and assertions and adds open/resolve identifier-mismatch precedence over missing arbiters and unauthorized callers, with empty receipts and exact host/pay store equality."

[producer.offer]
owner = "22.33.1304 (9b206de728): modules/layerxpay/keeper/execute.go Keeper.Submit calls RebuildServiceIndexes, whose modules/layerxpay/keeper/service_indexes.go producer persists service/index-version = 1."
