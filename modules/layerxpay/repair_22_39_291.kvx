[repair.activity]
site = "modules/layerxpay/types/activity.go MethodActivity; precompiles/layerxpay/stream.go openAskStream; modules/layerxpay/keeper/stream_open.go StreamOpenForAsk"
change = "Register streamOpenForAsk as ActivityStreamOpen, StreamModuleID, and 236 bytes: the 204-byte fixed open payload plus its single 32-byte meter authority. Preserve every existing entry."
tests = "TestMethodActivityMatchesKernelTypes freezes the ABI/kernel row beside streamOpen; TestMethodActivitySharedOrdinals checks the real EncodeStreamOpen output length; TestCheckWritePauseExitPaths explicitly requires the ABI sweep to include streamOpenForAsk and retains every pause, family, gate and store assertion."

[repair.genesis]
site = "modules/layerxpay/module_test.go TestPayAppModuleGenesisAndServices"
change = "Replace the opaque escrow-state placeholder with a typed fixed-width escrow hold at its canonical hold:<id> kernel key, retain the enable record, and validate the bytes through the production DecodeEscrowRecord and Keeper.GetEscrow paths."
tests = "Preserve all import, export, restoration and service assertions. Both the original unknown escrow key and truncated hold bytes fail genesis import without modifying the exported state; the real hold reader returns ErrEscrowCorruptState, false and a zero record for the placeholder."

[repair.view_inventory]
site = "modules/layerxpay/keeper/gate_test.go TestCheckWriteViewsUngated"
change = "Pin the ungated ABI view inventory to eighteen, including askStreamOf, while retaining every gating and store assertion."
qualification_base = "1c275076a4ee21935406ccf600a75d4d1c0b8d55"
prerequisite = "Task 22.39.298 merged at bcc8cfba08307540a76d838a4a6724d4390c50bc is already an ancestor of the qualification base and repairs the historical keeper genesis, proof, recovery and types params findings recorded below."

[gotcha]
codec = "The escrow record codec exposes DecodeEscrowRecord but no record encoder; binary.Write encodes the fixed-width typed EscrowRecord in big-endian wire order and the production decoder checks equality before import."
errors = "GenesisState.Validate rejects truncated canonical holds before keeper validation; genesis checks assert ErrInvalidGenesis and the exact producer-specific error, while the reader checks ErrEscrowCorruptState with ErrorIs and the unknown key checks its exact corruption message."

[evidence]
ledger = "/out/run/gates.jsonl"
revision = "The final kind=verify ledger row names the verified candidate revision and must match the successful kind=build revision."
build = "hf-build: go build ./modules/layerxpay/... && go vet ./modules/layerxpay/..."
verify = "hf-done: cg spec done 22.39.291 -f layerx-merge --root /work/paxeer-monorepo"
verify_cmd = "test -s modules/layerxpay/repair_22_39_291.kvx && go test -count=1 ./modules/layerxpay/..."
policy = "The gate ledger supplies exact revision, command, exit and private log location after execution; this record makes no advance success claim. Evidence stays external so build and verification use the same candidate. The runner owns publication."

