[case.keeper_runtime]
test = "TestPurgePrefixNotHang"
first_error = "Historical keeper package timeout after ten minutes while executing keeper_test.go:39 on 7de3a9051436."
goroutine_evidence = "The historical goroutine dump is not present in this sandbox; gotcha 4095 identifies the active call. Source inspection traces PurgePrefix -> prefix.DeleteAll -> gaskv.collectRangeKeys -> nested cacheMergeIterator.Valid/Key/Value, which repeatedly recurse through parent iterators at each of fifty cache levels."
cause = "Metered SDK bulk deletion enumerates through merge iterators, whose repeated parent validity and key lookups grow exponentially with nested caches; range-key enumeration in CacheKV already merges live writes and tombstones directly."
repair = "For ordinary execution enumerate the visible range through the raw store's range-key API, materialize that range in memory and use the existing SDK gas iterator to charge and trace the same scan before deleting from the original context. Tracing retains Context's historical/next-height store routing."
regressions = ["TestPurgePrefixNotHang", "TestPurgePrefixPreservesScanGasAndOutOfGas", "TestPurgePrefixTracingUsesTheSelectedHeightStore"]
proof = "Retain all fifty cache levels and NotPanics; additionally assert inherited and per-layer writes are purged, tombstones remain absent, the parent and another account stay intact, and a repeated purge succeeds. Compare exact gas with SDK DeleteAll for empty, single and multiple entries in ordinary and tracing contexts; zero gas must panic before deleting anything. Prove tracing deletes the selected next-height store only."
keeper_suite_runtime_record = "The attempt-1 hf-done log /out/logs/verify-1.log records a completed keeper package duration of 80.671 seconds on its FAIL line, bound to candidate 6817a46cdf413dcd265a7c071c924877c3fd04d2 by /out/run/gates.jsonl; the package failed assertions rather than timing out."

