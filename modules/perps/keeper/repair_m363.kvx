[repair.continuation-fixtures]
action = "Consume insurance-close profits through real CoverDeficit before the exact restart/debt assertion; prove no extra ADL match and exact USDL-to-USD debt reduction."
quote_action = "Compare every transported quote integer exactly by decimal value, assign historical maker volume to the inactive historical maker, and deposit one additional USDL through the real ABI before the multi-fill quote/execution snapshots. All existing position, fee, custody, receipt, debt and cap assertions remain exact."

[gotcha.quote-fixture-fees-and-margin]
observed = "Historical maker volume selects a maker rebate as well as the taker tier; fills away from mark can require more cross collateral than compatibility sizing alone deposits."
action = "Keep historical maker and current book maker distinct in the fee-tier fixture, and supply the multi-fill slippage margin through a real collateral deposit before taking equivalent snapshots."

[gotcha.insurance-close-profit]
observed = "An insurance close settles its full held position at the fill price, so a profitable close leaves collateral that CoverDeficit correctly uses before testing the ADL budget."
action = "Assert the exact profit-to-debt conversion first, then reopen and compare retained debt with zero available collateral."
