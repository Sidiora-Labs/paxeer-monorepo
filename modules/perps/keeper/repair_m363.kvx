[qualification.insolvent-insurance-fee]
observed = "The prior-attempt gate reports a zero-collateral insurance fund refused by the real trading-fee debit when its close realises a loss; that fee policy is independent of the shared ADL allowance."
request = "modules/perps/keeper/insurance.go and modules/perps/keeper/fees.go, owning domain 3 (markets): resolve trading-fee collection for a loss-making close by an already insolvent insurance fund; the bounded ADL proof uses a profitable close that pays the unchanged fee."

[gotcha.quote-refusal-diagnostics]
observed = "ABI selector 12b52d40 is PerpsInsufficientMargin, while PerpsPriceStale is 737dedba."
action = "Compare the real keeper producer and decoded ABI quote, retaining the detailed keeper refusal when fixture admission fails."

