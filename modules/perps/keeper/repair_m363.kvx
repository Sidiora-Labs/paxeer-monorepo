[meta]
task = "22.33.363"
audit = "22.30.14"
mode = "BUILD"
base_revision = "de8ab245609a7e0707cc32c502b6dcbe17ce3aca"
baseline = "The supplied attempt-1 evidence at ae5fe956b61638507e7e35deff33081c1ee36121 reports TestRepairM_363_ADLBlockAllowanceAndContinuation failing for bounds 1 and 2, and TestRepairM_363_OpenQuoteExecution failing own_best_bid, partial_fill, fee_tier and multiple_fills; unaligned_mark passed. The original private log was not carried into this sandbox. No additional unchanged-tree verify is run because the explicit gate order forbids it."
evidence = "/out/run/gates.jsonl and the final hf-done evidence line name the immutable candidate revision, exact command, exit and private log; qualification is recorded by the runner, without editing this record after the gate."

[repair.adl-bound-test-misses-block]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_ADLBlockAllowanceAndContinuation"
proof = "Actual EndBlock at caps 1 and 2: five deficits/backstops, insurance draw, step-8 coverage, fee-paying insurance close; count all ADLMatched logs in the real synthetic receipt and bound next-block continuation."

[repair.adl-budget-renewed-in-block]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_ADLBlockAllowanceAndContinuation"
proof = "EndBlock carries the prerequisite durable per-height allowance through its cached pass; nested ExecuteADL calls debit that same ledger only with committed work. Reopen the real keeper/store at the same height, refuse additional matches, retain debt, then resume in the next block."

[repair.leverage-acceptance-conflict]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_LeverageTierPolicy"
proof = "Preserve the existing fixed 1000x tier-0 safety policy. Execute actual codec/router MsgSetMarket for all six TierClasses; standalone leverage changes fail atomically with wire identity. Actual order admission demonstrates the changed Class B notional-tier limit (500x refused, 200x accepted). Spec reconciliation is requested below; no mutable-MaxLeverage policy is introduced."

[repair.pause-authority-order]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_PauseAuthorityBeforeState"
proof = "Wrong authority is refused before SDK context unwrapping and before decoding valid/corrupt persisted parameters; the real codec/MsgServiceRouter boundary returns perps/35 without writes or events, while authorized corrupt state retains its validation refusal."

[repair.refusal-test-expected-sentinel]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_ProducedOrderRefusalWireIdentity"
proof = "Real PlaceOrder unknown-market, stale-price and margin refusals pass through ResponseDeliverTx and protobuf; received perps codes and ABCIError identity are asserted alongside errors.Is and unchanged stores. requireRefused now checks the actual produced error for all existing order tests."

[repair.pause-proof-pins-wrong-refusal]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_PauseGovernanceProof"
proof = "The existing governance proof now expects ErrUnauthorized and validates its received SDK wire identity for wrong-authority SetPaused over corrupt params, retaining unchanged-store/no-event assertions and the actual persisted governance execution/reopen proof."

[repair.open-quote-test-bypasses-execution]
test = "modules/perps/keeper/repair_m363_test.go:TestRepairM_363_OpenQuoteExecution"
companion = "precompiles/perps/quotes_test.go:TestQuotesOpenPositionRealExecution"
proof = "Real 0x1015 ABI quoteOpenPosition/openPosition with identical arguments and unchanged initial store/token balances: unaligned mark, caller-owned best bid, partial liquidity, volume-selected fee tier and multiple fills. Decode execution receipts and compare position, notional, fees, collateral, USDL custody, liquidation, impact, maintenance and funding with the quote."

[wiring.leverage-policy]
request = "spec/layerx-merge/spec.kvx req.3001.18 and spec/layerx-merge/contracts/markets.md, owning domain 3 (markets): reconcile mutable-MaxLeverage acceptance with req.3010.1 and current fixed tier-0 1000x/TierClass governance before any leverage behavior change."

[wiring.adl-policy]
request = "spec/layerx-merge/spec.kvx req.3006.3 and spec/release-v6-12-0/contracts/perps-parameters.md, owning domain 3 (markets): specify one shared per-height ADL match/index-visit allowance across every liquidation, deficit-coverage and insurance-close invocation, including retained debt and cached rollback."

[qualification.inherited-insurance-scan]
observed = "The existing prerequisite recovery proof records the insurance fund's own liquidation scan refusal; this scenario retains that exact assertion on its second block and does not alter the unrelated scan."

[gotcha.scope-and-baseline]
observed = "The task requests an unchanged-tree verify and spec/GOTCHA records, but the explicit Order forbids early tests and all out-of-scope writes."
action = "Use only hf-build then hf-done after implementation; record baseline, finding mappings, gotchas and domain wiring requests in this in-scope task record."

[gotcha.receipt-indexes]
observed = "Fill maker is argument 3, and FeeCollected's nonindexed token count is feeTokens; these names differ from informal position/deposit field labels."
action = "Use the production ABI to decode receipts and compare the indexed user when summing feeTokens."

