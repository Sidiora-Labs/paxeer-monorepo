[repair.22.33.571]
findings = ["mint-proposal-example", "mint-null-handler"]
baseline = "Not run: the explicit bounded Order requires complete implementation before hf-build and hf-done and prohibits invoking verify_cmd by hand; no pre-change test failure is claimed."
wiring_requests = []
evidence = "The bounded runner ledger records the verified candidate revision, command, exit code and private log path; the final response copies that evidence."

[finding.mint-proposal-example]
test = "TestRepairM_571_ReadmeProposals"
proof = "README fresh and ongoing payloads -> registered offline governance CLI -> generated transaction JSON and protobuf codec -> proposal validator -> real mint handler/store -> minter query; the ongoing example preserves the documented prior issuance and last-mint metadata."

[finding.mint-null-handler]
tests = ["TestRepairM_571_MissingContent", "TestRepairM_571_NilProposal", "TestRepairM_571_InvalidMinter"]
proof = "Omitted/null JSON and protobuf content -> governance codec -> shared content validation and real proposal handler; refusals preserve raw minter bytes, parameters and events, and occur before any store access."
