[repair.22.39.387]
task = "22.39.387"
cause = "The host occupancy finalizer had no production caller, so a later-height Programs call encountered an unfinalized batch gap in occupancy.c:435. Attempt 1 wrote the selected state before looking for schedules: at height 1 its new root context saw neither complete schedule set nor an occupancy head, so it skipped the transition. At height 2 the root held the fee schedule with last_occupancy_batch 0 but no occupancy head; the new receipt named batch 2 and fees.c:1498-1503 refused it with LXP_ERR_CONTEXT_MISMATCH. The asset and prices in the active fee row were unchanged, and occupancy.c:442 and :446 require an open head, so neither of those two branches caused the observed height-2 failure. The earlier hand call used the fixture's selected context before WriteState and did see the schedule state."
selected_state = "FinalizeBlocker selects the sealed cache, optimistic proposal cache, or deliver cache; WriteState copies that selected state to the root multistore. The occupancy transition now runs on that selected cache after ProcessBlock or sealed block processing and before WriteState. Commit persists that selected cache; no post-write root context or second state selection participates in the transition."
simulation = "Host.Simulate uses a CacheContext and a kernel batch snapshot; its cache write function is discarded and the snapshot is destroyed, so no simulated result commits."
call_site = "node/app.go FinalizeBlocker invokes finalizeProgramsOccupancy on the selected state before WriteState, LightInvarianceChecks and app-hash calculation in each of the sealed, optimistic, and ordinary deliver branches. EndBlock alone also runs during proposals, so it is not the commit site."
first_block = "The first finalized block whose selected root host store contains both Programs active schedule rows; for a merge installation this is the merge-upgrade block. Before both rows exist, the function returns without reading a sequence or writing a host key."
inputs = "NextSequence reads the host's global last-sequence key and supplies its value as the next context sequence. The finalizer's context gets batch number from the consensus header height and timestamp from its block time; it uses StateCommitmentProtocolVersion."
failure = "Errors return through FinalizeBlocker and FinalizeBlock before WriteState, so the block cannot reach a successful Commit. Replaying a finalized height before Commit returns LXP_ERR_IDEMPOTENT_REPLAY."
cost = "In TestBlockEndTransitionRunsOncePerBlock, 1000 inactive block transitions measured inside finalizeProgramsOccupancy averaged 3.483615ms and reached 18.180981ms maximum. The measurement excludes the rest of FinalizeBlock."
idle_block_keys = "An inactive block changes host keys 02 (global last sequence), 010009+ex/head/v1, 010009+progfee/active/v1, 010009+progocc/final/v3, 010009+progocc/head/v3 and 010009+progocc/l/v3/0000. TestBlockEndTransitionRunsOncePerBlock diffs committed rows after an inactive block and logs the exact hex keys."
inside_reader = "modules/lxphost/ctx.go:124 NextSequence reads global last sequence without assuming a matching activity receipt. The formerly hand-finalized node/upgrades_merge_programs_abi_test.go restart case now reaches FinalizeBlocker. The node/programs_block_end_test.go call cases use the optimistic state selected for Commit and assert that a call plus transition advances the committed global sequence by two, while an idle block advances it by one."
outside_reader = "rpc/repair_22_31_491_test.go:107 maps receipt.GlobalSequence-1 to the previous receipt root in its direct-host fixture. Its contiguous-receipt assumption is local to that fixture; the rpc tests retain their hand finalization calls and are outside this task's edit scope."
generated_expectations = "No committed generated expected value inside modules/lxphost or node was identified as requiring regeneration; the affected ABI restart case computes its expected sequence from the committed host store at runtime."
