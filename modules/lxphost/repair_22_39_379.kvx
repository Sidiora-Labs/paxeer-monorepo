[repair.22.39.379]
task = "22.39.379"
base_revision = "4e0c32c6ac6883e7b3424729e090bae260e288dd"
inventory = "Before this task, the only Go callers of the fee and metering genesis materializers were test support at modules/lxphost/internal/m909fixture/records.go:70 and :78; the native full-genesis path calls them at src/protocol/lxp_genesis.c:1016 and :1018, and no on-chain product Go path called them."
upgrade_before = "node/upgrades.go:503 wrote only the two-byte hosted Programs guest ABI row into the host store, inside the merge handler's cached write."
base_coin = "node/params/config.go:15 names uhpx as the base coin unit, and node/sequencer/receipt.go:234 encodes a bank denomination as its SHA-256 asset identity; node/sequencer/receipt_equality_test.go:906 verifies SHA-256(uhpx). modules/layerxledger/types/denom.go:8-15 maps kernel asset IDs to layerx/<hex> bank denoms; no native uhpx asset registration in the LayerX ledger host exists at this revision. The upgrade uses the established SHA-256(uhpx) 32-byte chain receipt identity for occupancy."
authority = "modules/layerxgov/types/proposal.go:90 names the governance authority as the gov module account's bech32 address, consumed by node/app.go:958 and modules/layerxauth/keeper/keeper.go:19; modules/layerxauth/keeper/authority.go:17-34 gives the host's bound actors 32-byte DID keys and principals. The upgrade hashes the governance module address into a deterministic 32-byte genesis signer identity, whose digest the kernel commits in both records."
current_batch = "src/modules/programs/fees.c:1476 reads the active fee record without a batch cutoff; src/modules/programs/metering.c:205-241 chooses the latest history whose activation_batch is at most the requested nonzero batch. The native genesis producers require activation_batch 1 at src/modules/programs/fees.c:438-447 and src/modules/programs/metering.c:321-328, so both answer from batch 1, including the first sequenced height after merge."
inventory_readers = "The pre-change sweep found no test or fixture outside modules/lxphost and node that expects an empty host store after a real merge handler, a fixed application hash across that height, or LXP_NOT_FOUND for a schedule view after that handler. The isolated precompile tests in precompiles/layerxprograms/view_fees_test.go:137 and view_metering_test.go:104 assert missing rows in their own stores, so their expectation does not change."
baseline_command = "CGO_ENABLED=1 go test -count=1 ./modules/lxphost/ ./node/ ./precompiles/layerxprograms/"
baseline_log = "/out/logs/baseline-22-39-379.log"
baseline_exit = 1
baseline_failures = "node: TestTestWrapperMountsRpcStores was running when the package reached its 10-minute timeout; precompiles/layerxprograms: TestProgramsGateRefusesValueAndStaticWrites, TestProofLayerxprograms0x101d, TestProgramViewsAnswerAtExplicitHeight, FuzzProgramsDecodeArgs. modules/lxphost passed."
final_command = "CGO_ENABLED=1 go test -count=1 ./modules/lxphost/ ./node/ ./precompiles/layerxprograms/"
final_log = "/out/logs/final-22-39-379-4.log"
final_exit = 1
final_failures = "precompiles/layerxprograms: TestProgramsGateRefusesValueAndStaticWrites, TestProofLayerxprograms0x101d, FuzzProgramsDecodeArgs. modules/lxphost and node passed; every final failing name also failed at baseline."
implementation_repair = "The first post-change sweep exited 1 before tests at /out/logs/final-22-39-379.log because cgo found inconsistent Go-visible C.lxp_kernel definitions; the producer now owns that native type entirely in C and returns four fixed-size kernel-produced rows."
implementation_repair_2 = "The second post-change sweep exited 1 before tests at /out/logs/final-22-39-379-2.log because lxp_hash_payload takes const void *; the Go call now passes unsafe.Pointer for its signer buffer."
implementation_repair_3 = "The third post-change sweep exited 1 for node test compilation at /out/logs/final-22-39-379-3.log because ProgramsABI is test-only in the precompile package; the node test now gets the ABI of the actual registered precompile. The host package passed; precompile failures were the baseline cases except TestProgramViewsAnswerAtExplicitHeight."
