[finding.listing-share-pointer]
tests = ["TestRepair_17_listingSharePointer", "TestRepair_17_listingRollback"]
repair = "Governance creates every new pool's share metadata and native pointer using activation's symbol validation before publishing its cached registration, and emits ShareTokenCreated; failures discard all books, metadata, pointers and events."
proof = "Real governance proposal handler to spot registry, public vault ABI deposits and withdrawals, pointer balance/supply and bank supply, closing and reopening all application stores on LevelDB and rebuilding the production spot rails."

[finding.retained-token-decimals]
tests = ["TestRepair_17_retainedTokenDecimals"]
repair = "Retained units and custody kinds are immutable; every retained token must match its physical decimals and existing book. Metadata changes require a separate liability-safe migration."
proof = "Funded deployed six-decimal ERC20 and native pool reject decimal and custody changes atomically; physical metadata and book drift are refused; an ordinary cap update, public token/share metadata, quotes and a real swap retain six-decimal units."

[finding.expiry-head-starvation]
tests = ["TestRepair_17_expiryHeadStarvation"]
repair = "CursorPrefix/0x02 stores the last examined expiry key. The bounded scan wraps once, advancing past failures and backoff entries while retaining cached atomic refunds. Export rotates Expiries into circular scan order; import resumes after its last entry, preserving the next position without changing the genesis schema."
proof = "A full leading window of real ERC20 refunds failing for insufficient custody cannot starve later native refunds; work stays bounded, backoff and escrow remain intact, future orders remain pending, and progress survives disk reopen and JSON export/import before every subsequent block."

[wiring]
request_keys = "modules/spot/types/keys.go; owning domain 3 (markets): document the keeper's CursorPrefix/0x02 expiry scan position alongside the existing cursor namespace."
request_genesis = "modules/spot/types/genesis.go; owning domain 3 (markets): document GenesisState.Expiries as circular expiry scan order so downstream exporters preserve its array order."
request_listing_test = "precompiles/spot/listing_test.go; owning domain 3 (markets): replace the obsolete manual CreateShareToken calls after governance listing with assertions on the governance-created pointers."

