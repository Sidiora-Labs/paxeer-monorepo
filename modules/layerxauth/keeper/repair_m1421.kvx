[repair.22.33.1421]
finding_capability = "22.30.8/capability-test-endpoint-gap: TestRepairM_1421_CapabilityEndpoint, also registered in TestGrantCapability"
finding_proof = "22.30.8/auth-proof-endpoint-gap: TestRepairM_1421_AuthProofEndpoint, also registered in TestProofLayerxauthKeeperCapability"
path = "Keeper.GrantCapability and real host receipt -> producer-created SDK authz mirror -> encoded and decoded MsgExec transaction -> production RevocationDecorator -> authz.Keeper.Exec -> real bank MsgSend handler and persisted balances/spending"
coverage = "Successful transfers consume per-activity, period and total budgets; excess per-activity, exhausted period and exhausted total are refused with typed errors and unchanged stores/balances. The next period permits remaining total authority. A fresh branch executes before keeper revocation, then the same affordable payment is refused with ErrAuthRevoked while the original mirror and spending remain intact."
baseline = "No baseline verify ran: the ordered gate rules forbid testing before complete implementation and require hf-build before hf-done. No prior gate ledger or keeper changes existed at session start; no pre-change failures are claimed."
evidence = "The runner records the exact candidate revision, command, exit code and private evidence log in /out/run/gates.jsonl; its final hf-done record qualifies this task."
wiring_requests = "None: both repairs and their test registrations are confined to modules/layerxauth/keeper; production dependencies are consumed without edits."
gotcha = "The current bank scope consumer requires a canonical layerx/<asset-id> denomination; the endpoint fixture uses that real asset mapping and a nonzero BankSendPurpose hash required by the kernel; each issued grant binds the exact payment, with a separate 11-unit grant proving the per-activity refusal and repeated 5-unit payments proving cumulative limits."
first_qualification = "ec8f7c92dd6d2a72fb7af051a77d91d848b4a046; cg spec done 22.33.1421 -f layerx-merge --root /work/paxeer-monorepo; exit 1; /out/logs/verify-1.log: the kernel refuses a zero capability purpose with LXP_ERR_MALFORMED_GRANT; repair binds each fixture grant to the real BankSendPurpose without changing the enforced limits or expected refusal reasons."
