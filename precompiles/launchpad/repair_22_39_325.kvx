[case.TestOpticalHooksSeeTheContractCallers]
site = "precompiles/launchpad/optical_test.go:opticalContracts"
cause = "The compiler subprocess is mandatory, but solc was absent from the sandbox PATH; the inherited inventory identifies command.Output as the first failing assertion without retaining its diagnostic here."
producer_commit = "44838a0598: task 18.924.1 compiles the real in-tree optical contracts by default; 696461f54c8a66d3ef53e87c6a495358f90af595 relocates their source tree to contracts/launchpad."
repair = "Install the genuine native solc 0.8.27 compiler matching contracts/launchpad/hardhat.config.js into the gate PATH; preserve the existing source compilation, Paris target, callback caller, flags, storage, accounting, vesting and revert assertions unchanged."
compiler = "solc-linux-amd64-v0.8.27+commit.40a35a09"
compiler_sha256 = "0xb9977d500c17cba6f0032ca939ef98c4decf6363f19f386d05fb02f708115264"
compiler_origin = "ethereum/solc-bin linux-amd64 release binary, checksum checked against its list.json before installation."

[case.TestCollectionServesEverySelector]
site = "precompiles/launchpad/nft_test.go:nftGenesis and newNFTEnv"
cause = "The fixture predates the explicit FeeRightCollection.OwnerTokens export contract; validation refuses fee-right owner enumeration missing or wrong owner for 1 before any selector executes."
producer_commit = "74b08abddb101496da616c7337d2436500dd77d2, task 22.31.34: preserve ERC721Enumerable owner order across export/import rather than deriving it from global token order."
repair = "Include the actual holder's ordered token list [1] in the genesis fixture and assert exact OwnerTokens equality after the real keeper imports and exports it; retain genesis validation and all 37 selector, enumeration, event and refusal assertions."

[case.TestFeeRightReceiverHook]
site = "precompiles/launchpad/nft_test.go:newNFTEnv and nftGenesis"
cause = "The same missing OwnerTokens record prevents genesis import for the contract receiver holder."
producer_commit = "74b08abddb101496da616c7337d2436500dd77d2"
repair = "The shared fixture records whichever holder the case supplies, including nftReceiver, and asserts its exported enumeration; preserve mint and both safe-transfer overloads, caller and data checks, receiver refusal bytes, and state/log rollback assertions unchanged."

[case.TestTreasurySurfaceServesTheABI]
