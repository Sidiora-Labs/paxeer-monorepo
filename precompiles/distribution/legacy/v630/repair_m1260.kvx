[repair.22.33.1260]
finding = "historical-rewards-value-v630"
tests = ["TestRepairM_1260_HistoricalActivationRawCALL", "TestRepairM_1260_LiveRoutingActivation", "TestRepairM_1260_ZeroValueRewards", "TestRepairM_1260_FrozenReplayBytes"]
implementation = "Keep distribution.go and abi.json byte-identical. Exercise distribution.GetVersioned through the real EVM keeper's ordinary and tracing routes, the EVM CALL/STATICCALL machinery, distribution query keeper, ABI transport and in-memory SDK stores. Directly construct production auth, bank, staking, distribution, upgrade and EVM keepers; create a validator through the real staking message server and allocate its rewards through the distribution keeper."
activation = "The fixture records v6.3.0 at height 10 and v7.0 at height 20 through the real upgrade keeper. Historical tracing selects v630 from its recorded activation until the next completed version. Ordinary routing uses the current executor, whose value refusal activates at the recorded v7.0 done height, inclusive. These fixture heights are not deployment heights."
proof = "Positive CALL values of one wei, one bank base unit and one base unit plus one wei succeed historically and transfer their exact value to 0x1007. From v7.0 activation, current ordinary and tracing routes revert and preserve both balances. Zero-value CALL and STATICCALL return every nonzero rewards tuple field from the real distribution keeper. Finalized balances are checked through a reopened state DB. Embedded source and ABI hashes pin the unchanged historical bytes."
baseline = "No unchanged-tree test result is claimed: the explicit Order permits verification only through hf-done after complete implementation and hf-build. The inherited qualification.initial records an earlier compile failure; attempt 2 also failed while compiling sdk/x/auth/client/cli and sdk/x/staking/client/cli, before any TestRepairM_1260_ test executed."
wiring_request = "Domain 6: link precompiles/distribution/legacy/v630/repair_m1260_test.go from precompiles/distribution tests and carry README.md historical CALL-value guidance into docs/system/precompiles.md; no out-of-scope file is changed here."
evidence = "The private hf-done ledger and final task evidence record the exact verified candidate revision, command, exit code and log path."
gotcha = "Historical tracing and ordinary execution intentionally choose different executors below the merge height; assert both routing identity and payment effects, and use ABI wire order for nested tuple decoding."
continuation = "Retain the inherited three-file implementation from attempt 3 (1e2d2d2e7f787299c9eae43accde5329cb96050f) on base f25ab9129415b70e1e47d668e4d2d04777519969. The direct-keeper fixture avoids importing the full application but the production EVM keeper still imports wasm/x/wasm/keeper, which imports the SDK auth and staking modules and their CLI packages. Qualify the retained real path through hf-build and hf-done, whose private ledger supplies the verified revision."
wiring_cli = "SDK CLI domain: complete task 22.31.463 in sdk/x/auth/client/cli and sdk/x/staking/client/cli so their NewFactoryCLI callers handle both return values; preserve the real EVM keeper routing proof here rather than replacing it with a test double."

