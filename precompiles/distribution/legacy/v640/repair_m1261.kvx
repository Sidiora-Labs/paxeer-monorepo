qualification_continuation = "revision=963b1fd747c2653d319e76bfa24217f32986fa13; command=cg spec done 22.33.1261 -f layerx-merge --root /work/paxeer-monorepo; exit=1; log=/out/logs/verify-1.log; observed=hf-build passed but hf-done failed before tests compiled because the real EVM keeper still imports the incompatible auth and staking CLI callers through wasm/x/wasm/keeper; assumption=retain all real-path tests and leave unrelated out-of-scope files unchanged."
