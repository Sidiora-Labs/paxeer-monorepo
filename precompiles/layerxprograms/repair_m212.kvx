[repair.22.33.212]
audit = "22.30.121"
base_revision = "9e535b4932ba8111a729a5cef10e0ca2370ca435"
evidence = "The hf-build/hf-done private ledger records the exact candidate revision, command, exit and log; this record does not claim qualification before the gates run."
baseline = "Not run: the explicit implementation/build/done order forbids an unchanged-tree verify or a manual verify_cmd; no TestRepairM_212_* existed and the initial ledger contained no gate runs."
prior_repairs = "The base already returns schedule.Asset and account.Frozen and provides a Go execution decoder and bounded Wasm fixture in repair_251_test.go; preserve those repairs."

[finding.solidity-output-semantics]
test = "TestRepairM_212_SolidityOutputSemantics"
repair = "Preserve named Solidity returns; prove the actual node adapter, bound caller, host and EVM agree through freeze/unfreeze and active schedule replacement."

[finding.abi-output-semantics]
test = "TestRepairM_212_ABIOutputSemantics"
repair = "Parse the shipped ABI, assert the named types and execute both real host-backed methods against decoded fee and account records."

[finding.bank-parity-frozen]
test = "TestRepairM_212_BankParityFrozen"
repair = "Extend the existing bank parity test with a freeze/unfreeze transition of a real registered account, refusal of transfers while frozen, and preserved balance, supply, transfer and no-write checks."

[finding.registry-address-type]
test = "TestRepairM_212_RegistryAddressType"
repair = "Use the live common.Address variable at exact address 0x101D through EVM receipt emission and real event decoding; reject wrong emitters."
wiring = "Domain 13 Programs: spec/layerx-merge/interfaces.kvx row 13.go-layerxprograms-address-j52 and spec/layerx-merge/contracts/programs.md must declare var Address common.Address owned by precompiles/layerxprograms/events.go."

[finding.registry-hostkeepers]
test = "TestRepairM_212_RegistryHostKeepers"
repair = "Add the node adapter's compile-time HostKeepers assertion and construct and call the production merge precompile with actual node PrecompileKeepers and XWebK()."
wiring = "Domain 13 Programs: spec/layerx-merge/interfaces.kvx row 13.go-layerxprograms-hostkeepers-j52 and spec/layerx-merge/contracts/programs.md must name XWebK() *xwebkeeper.Keeper, matching node/precompiles.go and layerxprograms.go."

[finding.retired-custody-wiring]
test = "TestRepairM_212_RetiredCustodyWiring"
repair = "Remove retired custody discovery and resolver types; resolve real host assets to layerxledger's canonical bank mirror denom, retaining xweb's recorded governed fee mapping and allowlist checks; prove actual node construction with nil custody, real bank transfers, and governed fee acceptance/refusal using an in-memory harness with no custody store or genesis."

[finding.call-test-response-oracle]
test = "TestRepairM_212_CallTestResponseOracle"
repair = "Extend method_call_test.go with independently known 64-byte Wasm output and seven-unit transfer; decode real EVM returns through the existing scoped Go consumer against independent receipt/event transfer roots, retain gas, state parity, event and refusal assertions."
wiring = "Domain 9 agent SDK: services/agent/sdk/python/layerx_sdk/ai_market.py decode_programs_call_result and services/agent/sdk/typescript/src/ai_market.ts must accept canonical terminal/authority/occupancy frames with independently verified transfer context and guest-only responseCapacity; this scope's Go-only gate cannot prove those SDK consumers fixed."

[finding.quote-test-digest]
test = "TestRepairM_212_QuoteTestDigest"
repair = "Extend every successful method_quote_test.go quote with comparisons to the decoded host schedule and getCurrentFeeSchedule asset; execute price arithmetic, overflow, malformed record and immutability checks as well as active replacement/reopen proofs."

[gotcha.m212.1]
observed = "The graph index did not return scoped host symbols or audit finding sections; direct reads and rg resolved their actual locations."
fix = "Use direct scoped inspection when cg's current index omits source files; do not infer an interface is absent from an empty graph search."

[gotcha.m212.2]
observed = "The task requests a pre-change verify but its explicit gate order forbids verification before implementation, and Python/TypeScript SDK changes and registry changes are outside scope."
fix = "Follow the explicit gate order, claim no baseline test evidence, and record exact external wiring requests without editing forbidden paths."

[qualification.build]
revision = "e6717219a575fcc52a24ccfb47abe7fc17750d49"
command = "make -s paxd-native-libs && CGO_ENABLED=1 go build ./precompiles/layerxprograms/..."
exit = 1
log = "/out/logs/build-1.log"
observed = "Untouched sdk/x/staking/client/cli/tx.go:62 and sdk/x/auth/client/cli/{tx_multisign.go:84,260,tx_sign.go:69,validate_sigs.go:216} consume tx.NewFactoryCLI as one value although it returns (Factory,error); build failed before this package could qualify and hf-done was not run."
assumption = "The SDK owning domain must repair its callers; this task must not edit those paths or rerun the recorded unrelated failure."

[gotcha.m212.3]
observed = "A focused Programs package build reaches SDK CLI consumers with an inherited NewFactoryCLI return-arity mismatch."
fix = "Retain the exact failed build evidence and report implemented-not-qualified; do not fix callers outside task scope or claim tests compiled or executed."

[continuation.attempt3]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
implementation = "Preserved the eleven carried-over paths and reviewed all eight proving tests against the production handlers, node adapter, host records and event consumer."
prior_failure = "The qualification.build entry is historical attempt evidence; prerequisite 22.31.463 repairs the SDK CLI return-arity mismatch and explicitly authorizes qualification on the current base."
qualification = "Run only hf-build followed by hf-done; their private ledger supplies the exact current candidate revision and result. No baseline or manual verify_cmd was run."

[gotcha.m212.4]
observed = "A scoped search included a nonexistent modules/lxphost/bank* shell glob and rg returned exit 2 after reporting matches in the other paths."
fix = "Read the concrete host and ledger asset authority paths; an absent filename glob is not evidence of a missing authority."

[qualification.attempt3_repair1]
revision = "71a83a0bb276311fecd5131d415e25702dc9f657"
command = "cg spec done 22.33.212 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log; stack trace retained in /out/logs/repair-m212-verify-1.log"
observed = "The first two tests passed; the bank test was stopped with SIGQUIT after two minutes of CPU-active iteration, exposing repeated cacheMergeIterator traversal from bank_parity_test.go's no-write store comparison."
repair = "Finish each successful fixture write transaction and each asserted read-only batch with the real StateDB.CleanupForTracer; retain every balance, total-supply, transfer, freeze and no-write assertion while bounding the cache hierarchy."

[gotcha.m212.5]
observed = "Repeated EVM calls on one StateDB accumulate nested snapshot caches; full-store comparisons in the bank parity fixture become exponentially slow."
fix = "After asserting each transaction or read-only batch, flush its snapshots with CleanupForTracer before starting the next fixture transaction; ResetForTracer deliberately does not flush them."
