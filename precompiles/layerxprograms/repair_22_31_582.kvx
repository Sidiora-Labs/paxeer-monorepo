[gotcha.abi-receipt-tuples]
observed = "The ABI unpacks receipt tuples into an anonymous struct slice with JSON field tags, distinct from the host ReceiptAuthority slice."
action = "Decode the ABI tuple slice explicitly into ReceiptAuthority values before submission, as transfer tuple decoding does."
