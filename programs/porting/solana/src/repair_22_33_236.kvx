[gotcha.replay-error-format]
symptom = "The integration test did not compile when a storage reopen refusal used display formatting."
cause = "ReplayWitnessError implements Debug but not Display."
do = "Use debug formatting for storage snapshot codec errors. Recorded here because the task scope forbids modifying the root gotcha ledger."

[gotcha.pool-host-refusals]
symptom = "Direct scoped host calls return integer denial statuses; trapping on them produces a RuntimeFault receipt rather than a typed Rust authority or response error."
cause = "The guest must enforce rollback and its Rust call API must separately preserve precise preflight refusals."
do = "Bind preflight to the emitted module hash, use real capability narrowing and response bounds, and also test raw host transfer denial after both writes were staged."
