[qualification]
build = "hf-build"
verify = "hf-done"
revision_source = "/out/run/gates.jsonl: final matching build and verify revisions, if both pass"
build_evidence = "/out/run/gates.jsonl: final build row records revision, command, exit and private log"
verify_evidence = "/out/run/gates.jsonl: final verify row records revision, command, exit and private log"
policy = "No verified revision is claimed before both declared gates pass; gate output remains private and is referenced without editing the built candidate."

[blocker.rank_migration]
file = "programs/crates/layerx-programs-ai-market/src/queries.rs"
symbol = "FINALIZED_RANK"
observed = "The public constant remains imported by integration tests and by the hosted indexer and agent client; existing tests explicitly require rank-based encoding and refusal behavior."
assumption = "Retiring the public rank contract requires coordinated changes to those consumers and tests, which are outside the three allowed files."
severity = "blocker"
action = "Preserve the existing public constant and all assertions; document that the discriminator is not proof verification, rather than hide findings through an equivalent rename or an inline literal."
resolved = "Decision 3125 authorizes the live FINALIZED_RANK allowance in tools/paxeer-x/retired_callers.json for queries.rs; no coordinated migration is needed for this repair."

[blocker.runtime_scope]
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
symbol = "receipt_authority"
observed = "The required baseline scan reports 30 findings across runtime files that this task cannot edit."
assumption = "The broad --path programs verification cannot be clean until the runtime owner repairs those findings."
severity = "blocker"
resolved = "Attempt 2 narrows verification to the ai-market crate and programs/README.md; runtime findings belong to task 22.39.251 and remain outside this task's scope."

[compatibility_consumers]
paths = ["programs/crates/layerx-programs-ai-market/tests/view_binding.rs", "programs/crates/layerx-programs-ai-market/tests/proof_ai_market_guest.rs", "programs/crates/layerx-programs-ai-market/tests/repair_22_33_233.rs", "programs/crates/layerx-programs-ai-market/tests/repair_22_33_261.rs", "programs/crates/layerx-programs-ai-market/tests/rewards_native.rs", "services/platform/hosted/indexer/src/ai_market.rs", "services/agent/crates/layerx-client/src/ai_market.rs"]
assertions = "Existing tests require ranks below four to round-trip while refusing publication, ranks above four to be noncanonical, and the exact rank byte to remain in the wire encoding."
live_producer = "services/agent/crates/layerx-client/src/ai_market.rs: ObservedSnapshot::finalize assigns FINALIZED_RANK after checking the verified program-state witness against the capture and block commit."
allowance = "tools/paxeer-x/retired_callers.json: allowed_references entry with exact path programs/crates/layerx-programs-ai-market/src/queries.rs and symbol FINALIZED_RANK."

[gotcha.1]
area = "scope"
symptom = "The declared scan includes runtime files outside the exclusive file scope, and the ai-market public rank is required by tests outside that scope."
cause = "The scan and migration surface are wider than the three declared paths."
action = "Record every finding here; preserve checks and report the bounded gate result without editing catalogue, runtime, tests or spec files."
resolved = "Attempt 2 authorizes the catalogue allowance and removes runtime paths from this task's gate while preserving the original findings."

[gotcha.2]
area = "tooling"
symptom = "The initial record-writing script asserted an incorrect manually counted finding total and stopped before creating the record."
cause = "The count was transcribed manually rather than derived from the baseline diagnostics."
action = "Derive the finding and blocked totals from the captured scan; the corrected baseline contains 38 findings, including 30 runtime findings."

