verify_command = "test -s programs/crates/layerx-programs-ai-market/repair_22_39_252.kvx && cargo test --locked --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --lib && python3 tools/paxeer-x/tests/retired_callers_test.py --path programs/crates/layerx-programs-ai-market --path programs/README.md"
