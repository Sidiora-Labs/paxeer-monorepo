do = "Finish the entire repair before the final matching build and verify pair"

[continuation]
restoration = "All 25 tracked seed files match the prerequisite-merged main version before qualification; the new real read-header regression test and historical repair record are retained"
reason = "The 24 files with seed conflicts duplicate landed producers or fixture repairs; preserve the current source order, single bulk copy and strict assertions, and restore the two non-conflicting seed additions until their cases fail"
production_sources = "No seed production repair is reapplied before the merged baseline sweep; the published 256-boundary replay profile remains unchanged"
main_repairs = "22.99.77 already carries joint-table readers, twelve prefix-preserving loaders, created-state and availability expectations, delegate refresh and strict manifest-version tests"

