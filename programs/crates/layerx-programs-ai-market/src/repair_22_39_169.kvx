[meta]
attempt = 2
merged_starting_revision = "2b6ebb44422cd1ff9bd0cf3978c1f2ebec483ca4"
prerequisite_revision = "f367b74df0a1dfb522309232d3829928c26d4ffc"
task = "22.39.169"
starting_revision = "0edc903b4a4120ea145e68acb1a9712c54d7976a"
basis = "Decisions 2900, 2908, 2955, 2968 and 2973; restore the seed to the already merged 22.99.77 prerequisite and reapply only repairs whose cases still fail"
deployment_bound_bytes = 524184

[inventory]
command = "cargo test --locked --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --no-fail-fast"
before = "The before.* sections preserve the historical attempt-1 first sweep; continuation_baseline references this attempt's first bounded whole-crate sweep on the prerequisite-merged tree"
after = "/out/run/gates.jsonl: final verify row and its private log contain every executed target and case result"
policy = "Record observed failures by target and test name after the first sweep; no existing test is removed, skipped, ignored or weakened"

[regression]
target = "repair_22_39_169"
test = "read_header_preserves_ordered_fields_and_rejects_every_truncated_prefix"
producer = "src/codec.rs: encode_read_header, Writer::fields, decode_read_header and read_fields"
criterion = "Distinct identities and multibyte scalars retain their exact wire order, both presence forms round-trip through the real encoder and decoder, and every truncated prefix is refused"

[qualification]
build = "hf-build"
verify = "hf-done"
revision_source = "/out/run/gates.jsonl: matching final build and verify revision"
build_evidence = "/out/run/gates.jsonl: final build row records revision, command, exit and private log"
verify_evidence = "/out/run/gates.jsonl: final verify row records revision, command, exit and private log"
guest_size_source = "/out/logs/22.39.169-size.json: packaged build/paxai-host-boundary/ai_market.wasm size and deployment headroom at each built revision"
policy = "Only passing hf-done with a matching passing hf-build qualifies the task; final evidence is retained by reference without editing the built candidate"

[attempt1_baseline]
revision = "6d7e527537d539ebdd0d4f8db4ec22ac620389b3"
command = "cg spec done 22.39.169 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
guest_size_bytes = 504494
headroom_bytes = 19690
failing_targets = 21
failing_cases = 161

