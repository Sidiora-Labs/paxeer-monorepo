[implementation]
records = "Bond rows share RoomBook beside bids; shared typed field writer and ordered destination reader encode every bond record and request"
slash_guard = "LapSettlement stores a bit per peer and lap; ReceiptBatch commits missing_countersigners and its summary binds the sealed evidence"
bid_setups = "The five actual PostBid producers lock before applying; f04 and f05 reuse those producers; f11_family_table encodes envelopes without posting bids"
refund = "CloseRoom requires completed payouts and no open challenge; RefundBond waits for all peer deals and both close and canary challenge windows"

