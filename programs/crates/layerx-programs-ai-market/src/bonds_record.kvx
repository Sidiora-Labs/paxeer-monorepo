[attempt4.gotchas]
merge = "The seed book version and fixed room width conflict with the current versioned profile; retain current ROOM_RECORD_BYTES and use the bond book version consistently in decoder and writer"
name_mapping = "A diagnostic build without stripping is incompatible with compressed relocations; use strip=debuginfo for the private name map, and match the twenty-five largest binary metrics by position and size against the real stripped package"
