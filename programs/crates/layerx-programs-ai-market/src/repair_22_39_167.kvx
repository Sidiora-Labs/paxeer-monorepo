final_function_table_source = "/out/logs/22.39.167-size.json:final.largest_functions"

[measurement]
method = "Two packaged measurements from the permitted task builds; per-module attribution is the signed difference of pre-Binaryen Wasm function-body metrics, includes compiler effects and is not a claim of isolated causal packaged savings"
modules = "/out/logs/22.39.167-size.json:modules"
techniques_per_module = "codec: shared typed identity/fixed readers and borrowed proof scratch; types: shared identity initialization and removed dead constructors; epoch: owned state carry without region cloning; rewards: shared numeric field traversal; placement: ordered record decoding; reputation, reputation_codec, reputation_transition, aggregation_codec, roster, canary and laps: shared never-inlined helpers"
starting_tree_limitation = "No fresh baseline or per-technique builds were run because the direct task instructions allow only bounded hf-build/hf-done gates after implementation; the inherited 504494-byte measurement is labeled separately"
build_evidence = "/out/run/gates.jsonl and /out/logs/build-3.log"
verify_evidence = "/out/run/gates.jsonl and /out/logs/verify-1.log"

[gotcha.registry_borrow]
symptom = "Administration accepts Option<&SharedState>, so moving its control is illegal"
fix = "Keep the original clone at that borrowed API boundary"

[gotcha.metrics_names]
symptom = "Binaryen's default output omits the function names even without an explicit strip-debug pass"
fix = "Run the required metrics pass on the real package; retain a private -g optimization twin and require its stripped code to match the packaged bytes before attaching names"

