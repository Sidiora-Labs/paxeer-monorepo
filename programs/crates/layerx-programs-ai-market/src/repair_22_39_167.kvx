[techniques.epoch]
implementation = "Share carry preparation and completion outside the generic producer wrapper; validate the original reputation region once and carry its canonical prefix verbatim; move owned control into stripped state, retain produced-region rejection, storage and shared-state capacity checks"
measurement = "Packaged and per-module differences are retained in /out/logs/22.39.167-size.json; no isolated attribution build is claimed"

[techniques.codecs]
implementation = "Payout credit prefix and reward epoch numeric fields use the ordered destination reader; placement records use the same reader; ledger counters use the typed field writer"
wire_contract = "Original field order, reserved bytes, identity checks, status codes and semantic validations retained"

[techniques.shared_helpers]
implementation = "Keep the shared reputation transitions, region splitter, reward and aggregation checks, placement and lap codecs, roster operations and canary handlers out of their callers with guest-only inline(never)"

[techniques.registry_ops]
implementation = "Keep the borrowed administration API and its required replay clone unchanged"

