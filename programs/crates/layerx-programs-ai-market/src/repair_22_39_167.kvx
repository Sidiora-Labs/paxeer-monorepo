[repair.2]
observed = "The first packaged table is dominated by transition_inner at 208055 bytes; its body repeats checked identity copies and seeded decoder initialization; the current artifact is 21527 bytes over the qualification bound"
implementation = "Keep typed identity reads, fixed-width reads and identity scratch initialization in shared never-inlined bodies; borrow CheckedIdentityBytes from the first checked field instead of copying a Digest32 seed; remove the now-unused private from_seed constructors"
safety = "The borrowed seed is an existing nonzero identity proof; each destination is overwritten in the original order by the fallible field reader before it is returned; errors remain errors"

[after]
bytes_source = "/out/logs/22.39.167-size.json:final.bytes"
revision_source = "/out/run/gates.jsonl final matching build and verification candidate"
bytes_saved_from_first_packaged_measurement_source = "/out/logs/22.39.167-size.json:packaged_bytes_saved"
