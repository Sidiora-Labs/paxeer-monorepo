[gotcha.failed_representation_reduction]
symptom = "The initial identity/score/operation representation changes increased the packaged guest to 523935 bytes"
fix = "Restore those original representations and use shared wire-field traversal plus the existing compact hashing implementation"

[gotcha.candidate_base]
symptom = "The gate wrapper advances HEAD to its candidate, so restoring from HEAD preserves the first attempt's changes"
fix = "Compare against and selectively restore the original 3d1eff197f5a931feb5afc3e595d856f9f57e02b source"

[gotcha.operation_inventory]
symptom = "An early source-edit precondition assumed 69 operations and refused before writing; the inventory has 72"
fix = "The final repair retains the entire original operation table"

[gotcha.typed_writer_literals]
symptom = "Source review of pre-encoded writer tables found lost literal-width context at three fields"
fix = "Use typed shared writer variants and preserve the original u64/u32 literal widths; endian conversion stays shared"

