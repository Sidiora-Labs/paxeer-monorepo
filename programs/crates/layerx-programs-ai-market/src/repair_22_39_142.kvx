[techniques.codec]
technique = "Common typed field writer keeps endian conversion and refusal propagation in one loop; fixed-width identity entries avoid repeated lengths; ordered destination reader shares checked field decoding across 24 records and seven local field groups"
safety = "Every decoder destination is overwritten in original wire order before exposure; initialization uses a real checked input identity and never substitutes for a missing or malformed field"
errors = "Policy-specific reader helpers retain truncated-field errors before the original F01 invalid-value mapping; all semantic validations remain at their original boundaries"
bytes_saved_source = "/out/logs/22.39.142-after.json:modules.codec.code_bytes_saved; includes shared helper costs"

[techniques.types]
