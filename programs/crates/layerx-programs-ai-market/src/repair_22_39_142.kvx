[techniques.borrowed_identity_decoding]
modules = "codec.rs and types.rs; all family decoders using their Reader methods benefit without source duplication"
technique = "A private CheckedIdentityBytes proof returns a wire reference after the existing nonzero check; typed wrappers copy it directly into the final identity instead of propagating padded array-bearing Results through multiple functions"
safety = "No unsafe code, altered public representation, unchecked constructor, skipped validation or substitute value; the proof can only be produced by the shared nonzero check"
order = "take still advances only after its overflow and input-bound checks; identity nonzero validation follows take; salt retains its distinct F04 code and policy-specific invalid-value remapping remains after the short-input check"
destinations = "All checked identity destinations share one validated copy; fixed-width destinations share one bounds-checked copy; unused private Signature64 and DealState reader arms removed"
