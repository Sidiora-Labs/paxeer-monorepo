outside_scope_file = "services/agent/crates/layerx-agentd/src/inference_market/deals.rs"
outside_scope_line = 772
outside_scope_assumption = "refresh_negotiation considers a negotiation valid only if its ask is Open, so it drops a negotiation for a Matched ask; recorded without changing the file."
retained_case_file = "programs/crates/layerx-programs-ai-market/tests/f11_placement_book.rs"
retained_case_line = 810
retained_case = "record_deal_removes_its_ask_and_every_consumed_bid_and_rejects_bid_reuse checks an open different ask with a reused bid, not a matched ask; unchanged."
client = "src/ai_market.rs:531 deal_envelope and :491 verify_recorded_deal bind by room/deal IDs and add no ask-state restriction."

