[implementation]
file = "programs/crates/layerx-programs-ai-market/src/rooms.rs:933"
symbol = "apply_record_deal"
change = "Refuse AskState::Closed instead of every state other than Open; the existing enum decoder admits only Open, Matched and Closed."
preservation = "Every other check and error, request encoding and stored record layout is unchanged; the entry arm still sets the ask Matched and inserts each deal by its distinct deal_id without replacing an earlier deal."
closed_ask = "No operation assigns AskState::Closed; only the decoder recognizes its value, and no closed-ask test was added."

[cases]
success = "a_matched_ask_accepts_a_further_deal_of_the_room_host records a distinct second deal, fresh bids from admitted peers and a different layer split; reloads persisted state, reads both DealViews, compares the entire earlier deal and matched ask, and checks exact replay retention."
checks = "a_further_deal_passes_the_checks_of_a_first_deal compares an open ask and the matched ask against the same stale prior-epoch roster, over-ceiling price, duplicate peer across distinct bids and occupied first deal_id; asserts F11_ROSTER_DIGEST_MISMATCH or CONFLICT, unchanged state and sequence, then accepts valid terms."
authority = "a_further_deal_is_refused_from_another_account checks UNAUTHORIZED for admitted non-host PEER_A, unchanged state and sequence, then host acceptance of the same valid request."
fixture = "tests/fixtures/f11_rooms_and_deals.rs::recorded_journey includes the further-deal success trajectory for real guest observers."
existing_case_changes = "None; no existing in-scope case asserted refusal solely because an ask was Matched."

[downstream_review]
laps = "src/laps.rs:313,338,406,449: settlement lookup, insertion, deal binding and prior-batch checks use deal_id, never ask_id."
rewards = "src/rewards.rs:1390,2160,3662,3676,3706,4248: settlement and payout cursors use deal IDs; credits merge per worker/epoch with per-deal payout accounting."
queries = "src/queries.rs:284,312,341,420: RoomView walks every deal for consumed bids, lists only open asks as before, and DealView/ReceiptBatchView bind reads to a deal ID."
placement = "src/placement.rs:123,150: each deal consumes its own bids; repeated bid consumption remains CONFLICT and matched asks stay out of new-order matching. Fresh bids preserve that rule for a further deal."
result = "No single-deal-per-ask assumption requires a downstream wire or stored-layout change."

[search]
paths = "programs/crates/layerx-programs-ai-market/tests; services/agent/crates/layerx-client; services/agent/crates/layerx-agentd"
