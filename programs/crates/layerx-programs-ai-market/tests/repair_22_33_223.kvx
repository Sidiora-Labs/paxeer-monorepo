inherited_failures = ["fuel_budget::every_routed_operation_fits_the_protocol_cpu_fuel_cap", "fuel_budget::maximum_state_fuel_scaling", "fuel_budget::roster_state_fuel_scaling"]
before = "Candidate seven at 32/8 and sixteen tasks: OPEN_EPOCH calls 833545, 872662, 908311, 943960, then refused at attempted 1000046; FinalizeAggregation calls 515041, 620550, 621383, 622216, 941581. Candidate six's final opening was refused at attempted 1000003; these are capped stopping positions, not completed fuel costs. Every historical per-call row above remains. No new unchanged baseline or aggregate command is allowed in this continuation."
implementation = "Opening decodes only the current chunk of original participant records and the selected frozen workers' existing records. Prior journal records and history stay encoded; checked ordered replacement/insertion preserves all untouched bytes. The original and staged frames retain their schema, count, market, completed-epoch, padding, exact-length and no-seal checks; each changed record is validated by the production codec. The roster bound, six-participant full-roster cursor protocol, eight-worker aggregation chunk and every existing fuel assertion remain."
proof = "Journey::open compares the complete chunked reputation state against production open_segments and prune_released after every opening, through real native routing and the compiled ABI-5 guest. Existing journeys cover new and existing members, departed workers, retained history, reopening, persisted partial calls, exact retries and 8/2, 16/4, 24/6, 32/8 rosters. The case comment preceding participant_call_totals records the before costs; emitted participant_call and participant_calls rows are the after costs, counts and totals for candidate six."
after = "Every maximum, roster, fixed-roster and all-selector row is recorded in the final hf-done private log referenced by the verify entry of /out/run/gates.jsonl. This includes each opening and finalization call at each executed roster/task count; no successful measurement or qualification outcome is claimed in advance."
qualification = "Exact revision, command, exit and private evidence location are the final build and verify entries of /out/run/gates.jsonl. Both must name the same candidate; no source or record edits follow a passing hf-done. The regenerated source/artifact digests and deployment length are tests/fixtures/ai-market-opt-z.kvx."
gotcha = "The ruling's line numbers belong to an earlier source layout. The carried opening code rebuilds the roster projection, but the growing per-call cost also comes from decoding and serializing every already staged reputation record. Keep those bytes encoded and load only the records consumed by the participant step; preserve the complete-transition comparison."

