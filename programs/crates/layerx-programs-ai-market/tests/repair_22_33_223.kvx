[attempt.fifteenth_baseline]
source_revision = "c35ee22bb79c4f47ce862497bd0f55762f3aebc1"
source = "Attempt-14 final sweep, as transcribed in gotcha 3734 and decision 3037; no gate ledger exists yet in this continuation. The historical baseline and census evidence above are preserved; only hf-build and hf-done are allowed in this continuation."
open_rows = "8/2 approximately 283000 (implied by the ruling), 16/4 779305, 24/6 refused, 32/8 refused. The 8-to-16 increment implies approximately 62000 fuel per added worker with evaluator count proportional; 24/6 approximately 1275000 and 32/8 approximately 1771000. Refused attempted fuel is the interruption position, not total cost."
begin_rows = "8/2 not emitted by the sealed sweep (fewer than quorum); 16/4 587315, 24/6 791622, 32/8 997527. Adjacent slopes are 25538.375 and 25738.125 per added worker; overall 25638.25; the implied full-roster cost is 997527. Extrapolated 8/2 is 382209, not a measured row."
process_rows = "8/2 not emitted (fewer than quorum); 16/4 first chunk 529378, 24/6 first chunk 706846, 32/8 first chunk 879147. Adjacent slopes 22183.5 and 21537.625, overall 21860.5625 per added worker; extrapolated first chunk at 8/2 is 354494, not measured. Later chunks add approximately 41000 at 16/4, 50000 at 24/6 and 59000 at 32/8; implied full-roster chunks are 879147, 938147, 997147 and 1056147."
finalize_rows = "Decision 3037 reports admission only at 8/2 and refusal from 16/4; this sweep emits no aggregation at 8/2. Neither successful adjacent finalize fuel values nor a total-cost measurement are available, so its per-worker slope and full-roster total cannot honestly be inferred numerically. At 32/8 required fuel exceeds 1000000; repeated whole-state validation and per-worker segment hashing must be removed rather than treating the interruption position as the total."
targets = "OPEN_EPOCH, BeginAggregation and FinalizeAggregation at most 900000 at 32/8; each ProcessAggregation call reads its eight-worker chunk and running record without decoding earlier outputs or the whole roster, within ten percent of the first 16/4 chunk. Public operations, outputs, refusal codes, eight-worker chunk bound and protocol cap are unchanged."
after_evidence = "The final verify log in /out/run/gates.jsonl contains every roster_sweep row at 8/2, 16/4, 24/6 and 32/8, plus every maximum-state row. The final build and verify entries record revision, command, exit and private log; no source edit follows the final pair. Fuel slopes are also printed alongside these rows by the integration test."

[repair.fifteenth_implementation]
opening = "The epoch boundary consumes a borrowed F02 projection, not replay journals or metadata revisions of unchanged workers; due removals alone decode and rewrite the worker table. The immutable F03 snapshot is encoded once, then its byte projection supplies the canonical roster digest without per-worker serialization."
aggregation = "The section reader consumes the admission epoch header and reserve count/roster digest for processing. A borrowed running record keeps the sealed commitments, cursor, weight and raw prior outputs separate from reports. Processing decodes the selected eight frozen workers, seeks each admitted report to the chunk and appends only new outputs, preserving previous output bytes without decoding or validating them. Begin/finalize recover only the immutable snapshot and consumed reward records; they carry policy/task bytes when updating a revision."
completion = "Finalization consumes the checked running outputs directly without reopening report bodies. One checked aggregation projection supplies allocation, terminal encoding and F07 observations. Reputation completion validates each replacement and the appended completion row; it checks encoded size and encodes the produced records without another whole-state reputation validation. Strict public decoders/encoders remain the boundary for untrusted inputs."
proof = "roster_state_fuel_scaling retains every original row and assertion and additionally asserts the 900000 margin for the full-roster handlers and at most ten percent first-chunk fuel growth from 16/4 to 32/8; it prints handler_slope rows beside the original measured rows. The compiled/native journey still compares every state byte, response and event. aggregation_chunk_merge_preserves_sparse_votes_and_zero_scores continues to check chunk votes against the independent per-worker aggregation path."
baseline_correction = "The 8/2 sweep intentionally expects READINESS_BLOCKED: fuel is measured for that refusal, not for a complete opening, and no aggregation row is emitted. The decision-3037 estimates above are inherited slope estimates, not measured complete costs at 8/2; missing finalize values cannot support a numeric slope."
qualification = "Final build and verification evidence is the last matching-revision pair in /out/run/gates.jsonl. Guest regeneration is /out/logs/guest-generation-15.log (or its numbered repair suffix); exact artifact length and hashes are in tests/fixtures/ai-market-opt-z.kvx. No aggregate census or unchanged-tree gate is authorized by this continuation; the inherited decision-2900 census records are retained."

[measurement.fifteenth_after]
rows = "Read roster_sweep tasks=16 workers=W evaluators=E operation=OP in the final verify log referenced by /out/run/gates.jsonl for W/E = 8/2,16/4,24/6,32/8 and OP = OPEN_EPOCH,BeginAggregation,ProcessAggregation,FinalizeAggregation. Every chunk is a separate row. 8/2 emits its expected READINESS_BLOCKED opening only."
slopes = "The adjacent handler_slope selector=0111,0501,0502,0503 rows of that same log state measured fuel, fuel_per_added_worker and implied_32. Each process chunk retains its separate measured fuel; a refusal retains its exact attempted fuel in the roster row. No refusal interruption position is interpreted as completed fuel."

[gotcha.fifteenth_worker_state_reader]
observed = "The first guest regeneration reported E0599: WorkerState exposes from_u8, not decode. The committed projection now uses the existing checked from_u8 method; no qualification gate had run. Evidence: /out/logs/guest-generation-15.log."

[gotcha.fifteenth_optimizer_setup]
observed = "Guest compilation passed, then build-guest.sh stopped at wasm-opt: command not found. Binaryen is installed as sandbox tooling and the unchanged production command regenerates the fixture; no qualification gate had run. Initial evidence /out/logs/guest-generation-15-final.log; final regeneration evidence /out/logs/guest-generation-15-canonical.log."


[repair.fifteenth_final_readers]
snapshot = "The strict F03 decoder and bounded aggregation consumers share Snapshot::read and the same captured-roster constructor. Process keeps its borrowed eight-worker snapshot reader and never decodes previous output rows. Snapshot storage carries one presence bit for each bounded array; canonical serialization, ordering checks and the 32/8 bounds are unchanged."
aggregation = "A compact reserve header carries status, roster, count and budget instead of copying a complete reward row through each operation. The consumed reservation is decoded and checked by the shared captured-roster reader. CurrentPrefix is shared by the strict current-record decoder and the borrowed running-record reader. Admitted reports are packed once."
opening = "The public reputation opening retains strict segment-key validation. The internal committed-state opening compares the previous and selected policy bindings once and preserves unchanged segments without hashing each participant again; changed segments still use the checked rollover producer."
reputation = "Checked record field readers and writers share guest code; the directly included native vector source retains explicit checked codec calls. Completed-history fields write directly into the produced section, while the public history encoder still validates its input. Strict section encoders validate the complete input, and the produced encoder consumes producer-checked records."
optimizer = "Binaryen 132, release opt-level z, chain 125, exactly one wasm-opt -Oz --strip-debug --strip-producers pass. Production's optimizer command is unchanged. No compiler, protocol, payload or fuel bound is raised."
fixture = "Final formatted-source regeneration: /out/logs/guest-generation-15-qualified-source.log; exact byte counts and source/artifact digests are in tests/fixtures/ai-market-opt-z.kvx."
qualification = "The final matching-revision build and verify entries of /out/run/gates.jsonl provide both commands, exits and private logs. Verification runs with RUST_TEST_NOCAPTURE=1 so successful roster rows and handler_slope rows remain in that log; no gate is run manually or duplicated."

[gotcha.fifteenth_size_and_source_vectors]
observed = "Binaryen 120 initially produced an oversized guest; sharing the committed snapshot decoder, current header, bounded array storage and reputation writers brought the canonical Binaryen 132 artifact below the unchanged limit. Source review also found that reputation_vectors includes reputation_codec.rs through a public codec alias, so crate-private bulk helpers are guest specializations and native vectors retain explicit checked fields. No qualification gate had run during these repairs."
evidence = "Guest generation logs /out/logs/guest-generation-15-*.log; final artifact provenance in tests/fixtures/ai-market-opt-z.kvx; build and verification evidence by the final matching-revision pair in /out/run/gates.jsonl."

