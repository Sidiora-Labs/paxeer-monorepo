[implementation.thirteenth_sections]
opening = "The router passes a framed SectionReader to epoch opening. It reads policy, admission and the epoch reservation before lazily decoding replay state needed by rollover; immutable input decoders lend validated tables instead of copying full rosters. Reservation checks changed row/dictionary/ledger bindings while preserving previously validated padding and payout journals."
reveal = "The committed report index validates receipt framing without re-hashing unrelated admitted bodies; the ordered commitment index decodes only the revealing evaluator record. Admission borrows its validated roster and reuses the newly computed report digest for real signature verification."
aggregation = "Per-chunk votes come from admitted report vectors and sealed receipt digests. Strict public structural and digest decoders remain; the committed consumer checks frozen evaluator bindings and sealed commitments without re-hashing immutable reports. Reputation composition edits only its produced joint section and avoids decoding preserved replay bytes again."
proof = "Every opening, reveal and aggregation row now additionally runs the full strict reward, report and captured-roster decoders over the real native producer output before the compiled guest must produce exactly the same complete state, result and events. The maximum 32/8 journey, task-count sweeps, CPU cap and runtime clamp remain unchanged."
qualification = "Regenerate the opt-level z guest at the formatted source, run hf-build and hf-done on the same candidate. Private evidence is /out/run/gates.jsonl; final census records failures by target and compares all baseline-passing names."

[gotcha.thirteenth_fixture_compile]
observed = "Fixture generation first exited 101 for a duplicate Clone/Copy derive on StateFrame; remove the redundant derive, preserving its existing traits. Private log: /out/logs/thirteenth-guest-build.log."

[gotcha.thirteenth_frame_borrow]
observed = "Fixture generation then exited 101 with E0502: save the policy length before mutating the produced frame, keeping the same F01 capacity check. Private log: /out/logs/thirteenth-guest-build-final.log."

