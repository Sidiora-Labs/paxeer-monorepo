dependents = "All 32 dependent crates compiled: /out/logs/dependents-1.log, exit 0."

[implementation.thirteenth_repair]
opening = "Rollover's shared section kernel now emits a framed state; opening carries the original encoded control unchanged unless it actually retires a worker. Retention checks decode replay on demand only for due worker exits, and the retirement path clears exactly those slots. The routed opening reads the committed reward header and validates reservation's changed row, recipient references and ledger counters. Public serialized reward decoding remains strict."
reveal = "The canonical ingress report bytes supply both its digest and stored signed report. F03 encoding/decoding performs each vector check once while retaining the exact public refusal codes. Live worker ownership reads the committed owner fields without materializing unrelated replay/metadata fields. The selected commitment, signature, evidence, role and replay checks remain."
aggregation = "The immutable opening roster is checked against epoch/config/recipient bindings without hashing it again; the public captured-roster reader still recomputes the full digest. Committed admitted report frames expose encoded vectors, and the chunk's existing binary vote search decodes the selected cells. Terminalization checks the produced row, ledger and recipient bindings without rescanning preserved padding and payout journals."
proof = "Every opening/reveal/aggregation output still passes full native reward, report and captured-roster decoders before complete byte equality with the compiled guest. opening_preserves_control_and_retires_only_departing_worker drives both replay branches through real routed and compiled transitions. strict_report_boundaries_retain_vector_refusals proves duplicate, range and truncated report refusals at both public decoders."
qualification = "Regenerate the guest from the final formatted source, record final census failing names and fuel rows, then run hf-build followed by hf-done. Authoritative revision/command/exit/log are recorded by reference in /out/run/gates.jsonl at build n=2 and verify n=2; no completion is claimed before those records pass on the same candidate."
remaining_rows = "Any refused final row's attempted fuel will remain in /out/logs/verify-2.log and in the final census row records; exhaustion charges are lower bounds. The cap, clamp, 32/8 journey and assertions are unchanged."

[gotcha.thirteenth_patch_tool]
observed = "apply_patch rejects multiple Update File operations naming the same path within one patch; combine that path's hunks in a single operation. The rejected patch applied no edits."

[gotcha.thirteenth_strict_roster_wrapper]
observed = "Fixture regeneration initially failed with E0425 in tasks.rs because its strict captured_roster_row caller remained after the internal committed reader rename; restored the strict wrapper with the complete roster digest check. Log: /out/logs/thirteenth-repair-guest-build.log, exit 101."

[census.thirteenth_repair_final]
revision = "148d29066896286e92cc823dffa6c919ea009f58 plus final source_sha256 34c8826bb0922834dabe8a3faeafcd595c32628513f13249ac6874fe7984ab88"
command = "cargo test --locked --manifest-path programs/Cargo.toml -p layerx-programs-ai-market --no-fail-fast"
exit = 101
log = "/out/logs/thirteenth-repair-final-census.log"
baseline_passing_regressions = []
observed = "The census retains the three existing fuel failures and the missing native host artifact failures. Both new regression tests and the compiled close-settlement journey pass; no baseline-passing test fails."

[census.thirteenth_repair_final.target.0]
target = "tests/f03_evaluator_host.rs"
failed = ["native_f03_schedule_capacity_role_conflicts_and_revocation"]

[census.thirteenth_repair_final.target.1]
target = "tests/fuel_budget.rs"
failed = ["every_routed_operation_fits_the_protocol_cpu_fuel_cap", "maximum_state_fuel_scaling", "roster_state_fuel_scaling"]

[census.thirteenth_repair_final.target.2]
target = "tests/host_boundary.rs"
failed = ["a01_native_create_binds_principal_origin_and_refuses_duplicates", "a02_native_activation_schedule_rebinds_worker_revision_and_needs_readiness", "a03_native_stage_open_refusal_cancel_and_restage", "a09_native_policy_variants_and_maxima", "a16_native_policy_width_and_assessment_modes", "a19_native_treasury_presence_and_later_setters", "native_context_binds_chain_program_and_height", "native_read_selectors_return_exact_snapshot_without_writes", "native_selectors_preserve_exact_routed_refusals"]

[census.thirteenth_repair_final.target.3]
target = "tests/repair_22_33_223.rs"
failed = ["fuel_budget::every_routed_operation_fits_the_protocol_cpu_fuel_cap", "fuel_budget::maximum_state_fuel_scaling", "fuel_budget::roster_state_fuel_scaling"]

[census.thirteenth_repair_final.target.4]
target = "tests/rewards_native.rs"
failed = ["reward_conservation_authority_and_rollback", "reward_finality_recovery_and_capacity"]

[measurement.thirteenth_repair_final]
log = "/out/logs/thirteenth-repair-final-census.log"
rows = 700
interpretation = "Exhaustion attempted fuel is a lower bound, not total required fuel. The unchanged 32/8 journey now executes all eight reveals below the cap and the first aggregation chunk at 998539; opening, begin, later chunks and finalize still exceed the cap. The cap and runtime clamp are unchanged; 8/2 correctly refuses READINESS_BLOCKED under the existing three-evaluator policy."
guest = "Final regenerated opt-z Wasm is 523128 bytes, packaged 523232, within 524288; source_sha256 34c8826bb0922834dabe8a3faeafcd595c32628513f13249ac6874fe7984ab88."
qualification = "Exact final build and verify evidence is recorded by reference in /out/run/gates.jsonl (build n=2 and verify n=2). They must use the identical candidate; no completion is asserted unless hf-done passes."

