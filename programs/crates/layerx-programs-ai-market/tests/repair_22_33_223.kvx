repair = "Carry F07 through direct close producers, preserve the F05 reward tail, maintain the next epoch quorum and identify guest operation/height without increasing the protocol cap."

[continuation.third_attempt]
inherited_failures = "The supplied attempt-2 evidence reports every_routed_operation_fits_the_protocol_cpu_fuel_cap and close_settlement_coverage_through_compiled_guest failing; no unchanged-tree gate is rerun in this continuation."
repair = "Cache the validated unsigned request digest in the router and decode the visible revision only for unchanged/refused frames; decode the F08 table after splitting its current F07 container for public task-set consumers. Keep the protocol fuel cap and all result/state/event comparisons."
capacity = "The maximum journey derives its task count from the actual F01 section headroom and the production task binding length, capped by MAX_TASKS, retaining the full 32-worker/8-evaluator roster."
gotcha = "A joint F07/F08 section begins with RP07; passing the whole section to AdmissionTable::decode produces BAD_VERSION even though both component versions are current. Split the container before decoding its F08 table."

[qualification.continuation_first_gate]
revision = "f013078266d639f6f14be6d82a924bcdcd757cfd"
command = "cg spec done 22.33.223 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Nine tests passed; fuel-selector and compiled close journeys failed. FUND and maximum-state mutations exhausted CPU; history/read/prune requests violated envelope bindings; full-roster completion refused CAPACITY."
repair = "Preserve joint F07/F08 sections directly in mutation producers, compose roster section views without intermediate state encoding, replace changed encoded sections in place, preflight all frozen recipients in one validated dictionary traversal, and reuse the SDK rewards-account derivation between header and transfer validation. Bind history/read/prune requests canonically and derive reputation-root scratch length from its actual domain tag, retaining all 32 records."

[gotcha.continuation_joint_consumers]
observed = "Removing the carry wrapper requires every F08 consumer in F03/F04/F06/F09/closure to split RP07 before decoding its table; mutation encoders already retain the untouched joint section."

[gotcha.continuation_reputation_root]
observed = "PAXAI/reputation-root/v1 with its NUL occupies 25 bytes; a hard-coded 24-byte scratch allowance refuses only at the full 32-record boundary. The corrected buffer is sized from the literal, without changing any protocol capacity."

[gotcha.continuation_requests]
observed = "History requires the current roster binding, program reads require config zero and no roster, and object-local PruneInactive requires sequence zero. Maximum task capacity reserves the 32-byte seal as well as each task binding."

[continuation.fourth_attempt]
inherited_failures = "The supplied attempt-3 evidence reports nine passing tests and CPU-exhausted FUND and maximum-state guest calls; no unchanged-tree gate is rerun."
repair = "Retain validated shared-state, policy, identity, admission, reputation and reward views only for exact slices of the immutable activity input; use host SHA-256 for deployment-domain validation and avoid a duplicate state hash in chunk reads. Regenerate the deployment guest from current source with every check and CPU bound retained."
provenance = "The fixture records a digest of every production Rust source path and byte; the in-process guest loader verifies it before validation, preventing stale guests from qualifying a changed boundary. Every completed execution asserts nonzero measured CPU fuel."
gotcha = "A compiled fixture can retain the old routing despite native-source repairs; its wasm digest alone proves artifact identity, so source provenance must also be checked."

