[implementation.eleventh_attempt]
repair = "Preserve current main compact dispatch and memory routines; direct joint-aware producers no longer strip and re-encode the state. Aggregation keeps its F07 update but edits the produced joint section in place, and ProcessAggregation carries it unchanged. Task opening reads only the committed epoch row and validates its referenced dictionary slots, admission table, identity roster and task set; untouched sections are checked by exact length and SHA-256. The same immutable task-set, epoch and seal digest proofs are reused within one guest call."
reads = "READ_HEADER and READ_STATE_CHUNK project the bounded stored frame, header record and opening bindings without decoding feature sections; the full snapshot digest and every chunk pin remain checked. The maximum journey compares both outputs with the existing strict public readers in addition to native/compiled result, event and state equality."
constraints = "All 72 selectors, the 32-worker/8-evaluator/64-task maximum journey, every protocol cap and every existing test assertion remain. No runtime path or budget bound changes."

