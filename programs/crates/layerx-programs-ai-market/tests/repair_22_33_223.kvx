assumption = "Bulk memory operations cost one fuel per 64 bytes under the frozen schedule; explicit word loops increased instruction work and have been removed. Immutable input views may be validated once and reused without changing checks on next-state buffers."

[gotcha.fourth_attempt_meter]
observed = "The frozen Wasmi fuel schedule meters bulk memory operations per 64 bytes; replacing them with word loops adds fuel. Production decoders repeatedly read the same immutable activity input, so cache only exact subslices of that retained input, never mutable scratch or next-state bytes."

[gotcha.fourth_attempt_cache_image]
observed = "Nested Option niches in large empty static caches added roughly 48 KiB of initialized Wasm data. An explicit zero-tag cache representation retains the same checked values in zero-initialized memory; the regenerated guest is 505850 bytes before its 104-byte deployment envelope."

[continuation.fifth_attempt]
inherited_failures = "Attempt 4 reports nine passing cases and CPU BudgetExceeded in FUND and maximum-state paths; the unchanged failure is not rerun."
repair = "Validate zero padding in four-word blocks without omitting any byte, and count ledger epochs during the existing validation pass rather than decoding them twice. The guest loader and selector suite use DeclaredBudget::protocol_maximum().cpu_fuel(), checked against the runtime default."
provenance = "Regenerate src/fixtures/ai-market-opt-z.hex and its source/artifact digest metadata from the current production sources at explicit release opt-level z. Qualification reads those committed bytes in process."
regression = "padding_validation_retains_all_bytes rejects nonzero bytes at every position through multiple word-block and tail boundaries; reward_padding_and_counter_invariants_remain_enforced rejects malformed empty dictionary slots, unused epoch rows and ledger row counters."
gotcha = "A budget refusal's attempted value is the point where execution stopped, not its total required fuel; a few reported excess units do not justify increasing the protocol cap."

