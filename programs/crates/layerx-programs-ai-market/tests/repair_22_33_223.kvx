revision = "dd6ac1af1ed90a9c48eb0808852b0e137ec1af23"
build = "cargo build --locked --manifest-path programs/crates/layerx-programs-ai-market/Cargo.toml --tests; exit 0; /out/logs/build-1.log"
verify = "cg spec done 22.33.223 -f layerx-merge --root /work/paxeer-monorepo; exit 1; /out/logs/verify-1.log; 21 passed, 3 failed: every_routed_operation_fits_the_protocol_cpu_fuel_cap, roster_state_fuel_scaling, maximum_state_fuel_scaling. All 32 dependent checks passed in /out/logs/dependents-1.log."
open = "8/2 283977 expected READINESS_BLOCKED, 16/4 775119, 24/6 refused attempted 1000195, 32/8 refused attempted 1000002. The inherited 8-to-16 slope is 61392.75 per added worker and implies 1757403 at 32/8, with the explicit caveat that the 8/2 point is an early readiness refusal rather than a completed opening."
begin = "8/2 unreachable; 16/4 550827; 24/6 758498; 32/8 968527. Adjacent slopes 25958.875 and 26253.625 per worker; the full-roster cost is measured, not extrapolated."
process = "8/2 unreachable; 16/4 chunks 266144,263721; 24/6 chunks 337706,337339,335173; 32/8 chunks 410918,408559,408571,405671. First-chunk slopes 8945.25 and 9151.5 per worker; cursor-dependent report/output decoding is gone but roster-dependent decoding and staging remain."
finalize = "8/2 unreachable; 16/4 908468; 24/6 refused attempted 1000015; 32/8 refused attempted 1000006. One completed point cannot establish a numeric slope or full-roster total; required full-roster fuel exceeds the cap."
