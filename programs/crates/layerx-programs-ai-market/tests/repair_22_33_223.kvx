[repair.22.33.223]
audit = "22.30.125"
base_revision = "ae54d4a258f28571b14af5ccafba438ccb58dd1c"
verify_cmd = "cargo test --locked --manifest-path programs/crates/layerx-programs-ai-market/Cargo.toml --test repair_22_33_223"
evidence = "hf-build and hf-done publish the exact candidate revision, exit and private log in /out/run/gates.jsonl."
baseline = "Decision 2900 baseline census ran once on an unchanged private archive of merged main before source changes; the repair target did not exist there. See census.baseline."

[continuation.twenty_first_attempt]
inherited = "Attempt 20, d74a1c29af7da4ca0c685260a52ab036f287fbf9: 31 passed, only roster_state_fuel_scaling failed; first ProcessAggregation cost 189384 at 16/4 and 276514 at 32/8. Preserve that tree and the earlier census; only hf-build and hf-done are authorized gates in this continuation."
measurement = "The --aggregation-probe artifact keeps the original byte-copy primitive and runs the real state-frame decoder, control replay decoder/encoder and committed roster reader with Context::remaining_fuel. roster_state_fuel_scaling supplies the exact first ProcessAggregation input from each real 16/4 and 32/8 journey, checks the computed frozen digest and the unchanged stored state, and prints the three pairs as aggregation_passes in the private verification log. No extra gate or unchanged-tree test run is performed."
path_review = "The supplied line 1520 is answer_view, not the aggregation route. ProcessAggregation already reads eight workers through CommittedSnapshot and preserves the control encoding in Call::commit; neither read_replay nor encode_replay runs on a successful new chunk. Their per-call invocation pair is 0/0. The diagnostic measures their isolated cost rather than claiming they run on this route. Begin and Finalize still consume the full frozen roster because they seal or terminalize that roster."
repair = "Compare unchanged control in 32-byte blocks while still checking every byte, and measure the process phases with the same runtime meter. Artifact inspection showed that Rust already emits metered memory.copy for carried sections; the attempted bulk-copy wrapper produced an identical artifact and was removed before gates. No replay entry, frozen digest or operation response changes."
bounded_votes = "The chunk stores eight bounded score columns rather than copying the same evaluator identity into every worker vote. Validate the distinct ascending evaluator stream once before its scores enter the columns; retain score-range, support, capacity, median, weight, binding and input-digest checks. aggregation_chunk_merge_preserves_sparse_votes_and_zero_scores compares all chunk outputs with the independent per-worker projection for typed and encoded reports."
baseline_artifact = "The diagnostic fixture is captured before compact score columns, source SHA256 dae8baba5c2e06d002d43b42071e63de12c2e6311413061b7d5b2fa1ca2465f6. It measures the original readers plus the original process phases on real first-chunk state; the deployment fixture is regenerated from the final source."
proof = "The complete selector inventory compares the compiled deployment guest with real native dispatch for result/event/state, including Begin/Process/Finalize, exact retries and the close settlement recovery journey. Existing ten-percent chunk scaling, 900000 per-call margin, protocol cap and all prior assertions remain unchanged."
gotcha = "A monolithic state-frame copy and preserved-control comparison can grow with the roster even when the aggregation arithmetic already uses a bounded worker slice; measure those separately from full-roster decoding."
qualification = "Exact final candidate, command, exit and private log are recorded by hf-build/hf-done in /out/run/gates.jsonl; measurement rows are in the corresponding verify log. Stop on the bounded gate result and leave publication to the runner."
build_repair = "568460b963d123d1ad2214c6da7890e68bc0a636; cargo build --locked --manifest-path programs/crates/layerx-programs-ai-market/Cargo.toml --tests; exit 101; /out/logs/build-1.log. The new diagnostic calls returned boxed errors while the fuel suite returns Failure; map those errors to Failure::Guest at the five call sites. No production source or guest artifact changed for this repair."
verification = "e1722222b475df1fd7a7d24db80ce21ba5ad5a7c; cg spec done 22.33.223 -f layerx-merge --root /work/paxeer-monorepo; exit 1 (cargo test exit 101); /out/logs/verify-1.log. 31 passed; only roster_state_fuel_scaling failed: first chunks 175338 at 16/4 and 251901 at 32/8. All dependent crates compiled successfully."
measured_pairs = "At 16/4 and 32/8 respectively: frame_decode 3572/3572; replay_decode_encode 38478/65466; full_roster 115850/181783; chunk_roster 18005/18005; frame_copy 4227/4633; control_compare 3572/6497. Baseline Process phases: envelope 3980/3980; roster 11876/11876; commitments 6671/8919; votes 66026/130658; median 14459/22651; settlement 10102/10106; commit 10411/10817."
fuel_repair = "The measured growing phase projects report cells. Borrow checked worker identities and scores directly from canonical vectors, retain nonzero/range/bounds checks, and compare identities by equal eight-byte words with a big-endian comparison of the first different word. This preserves byte-lexicographic order and removes repeated identity materialization and bytewise comparison of equal workers; the exhaustive identity comparison test and the independent sparse-vote projection remain unchanged."
packaging_repair = "The initial regenerated repair artifact measured 524244 bytes, 60 over the 524184-byte wasm allowance after the 104-byte envelope. Reuse GuestIndex for the already range-checked 36-byte score cell's field slices, retaining trapping bounds checks without formatted guest panics; the regenerated deployment fixture passes the unchanged packaging bound."
gate_allowance = "The runner counts each extra build and each extra verification as a separate repair allowance. build-2 consumed one allowance; the final required build consumes the second. Attempt hf-done after that build without bypassing its budget guard; if refused, the final source remains unverified and the last executed verification remains verify-1 above. Final build evidence is recorded by reference in /out/run/gates.jsonl."

[finding.fuel_selector_coverage]
test = "fuel_budget::every_routed_operation_fits_the_protocol_cpu_fuel_cap"
proof = "Real native dispatch and compiled ABI-5 guest agree on result, event and stored state for every selector; inventory equals dispatch metadata; maximum 32-worker/8-evaluator state filled to the current F01 task-capacity bound exercises chunked aggregation, votes and reads."

[finding.fuel_guest_build_profile]
test = "fuel_guest_build_profile"
proof = "A committed production guest fixture uses explicit release opt-level z, chain 125 and the versioned runtime validator; wasm plus 104 deployment bytes must fit 524288 before validation and execution."
wiring_request = "Programs domain 13: align programs/Cargo.toml [profile.release] and Makefile paxai-host-boundary-build with explicit opt-level z; both files are outside this task's scope."

[finding.close_settlement_coverage]
test = "market_protocol_boundary::close_settlement_coverage_through_compiled_guest"
proof = "Compiled CREATE/FUND/REQUEST_CLOSE/ADVANCE_CLOSE/CLAIM/EXPIRE_EPOCH_CLAIMS consume real producer state and the production transfer host; the account store and runtime storage are encoded, stopped and reopened before uncertain-delivery retries, asserting conservation and exact recipients."
wiring_request = "Programs domain 13: programs/crates/layerx-programs-runtime/src/execute.rs exposes no public ABI-5 affine kernel-settlement qualification seam; this test asserts real host-issued transfer effects against its in-memory account-store peer."

[qualification.first_attempt]
