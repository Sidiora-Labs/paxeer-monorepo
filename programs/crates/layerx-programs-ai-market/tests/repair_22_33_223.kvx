[repair.fourteenth_bounded_cycle]
implementation = "Snapshot append and decode read the previous slot directly. WorkerCursor merges canonical worker identities for rollover, opening and retirement; opening projects the roster in one pass without a second optional array. Aggregation borrows admission epoch presence, preserves validated control bytes directly, and merges each report with its contiguous worker chunk. Begin reuses the unchanged committed admission and identity sections for the F07 seal. Finalize carries its immutable checked outputs to F07, checks a current record once across history and encoding, and validates the completed reputation state once after appending its preflighted history. Shared worker and reputation writers encode records directly without intermediate buffers."
regression = "aggregation_chunk_merge_preserves_sparse_votes_and_zero_scores compares every output, running weight and cursor of four chunks against aggregate_worker with eight sparse typed and encoded reports over 32 workers, including explicit zero scores, the exhausted cursor and refusal beyond the roster. Existing compiled/native state, event, conservation, replay, deployment and fuel assertions remain unchanged."
final_evidence = "The final candidate is the revision common to the last build and verify entries in /out/run/gates.jsonl. Commands, exits and private logs are recorded by reference; the final verification log contains all post-repair roster and maximum-state rows, including every refusal's attempted CPU fuel. No edit follows qualification."
fixture = "Regenerated by tests/fixtures/build-guest.sh after the complete repair, using release opt-level z and one production wasm-opt pass; generation evidence /out/logs/guest-generation-14-repair.log and final immutable byte counts/digests in tests/fixtures/ai-market-opt-z.kvx."

