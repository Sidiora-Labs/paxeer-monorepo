[attempt.nineteenth.repair_packaging]
observed = "The direct fixed-offset decoder and worker serializer variants grew the regenerated artifact beyond its unchanged 524184-byte allowance; the builder refused publication. They were replaced before qualification by the compact strict field-table decoders and the existing worker serializer. The reputation serializer uses the existing checked scalar writers without a dynamic field table; the repeated authorization/snapshot projection now reuses only checked immutable input rows."
optimizer = "The pinned production fixture recipe is unchanged. Every qualification guest carries the regenerated source digest, exact optimizer recipe and wasm digest; no oversized trial artifact is published."


[attempt.nineteenth.final_packaging]
implementation = "Retain the existing full word-and-tail equality scan for variable-length buffers; the four-word identity comparison remains. Inline the single-caller projection-cache wrapper, share its checked decoder on cache misses, omit the unused identity copy from the private projection, and write the reputation status/flags/two reserved zeros as one checked four-byte field. These eliminate helper and call overhead without changing any encoded byte or validation."
measurements = "Candidate six's complete per-call fuel and totals are recorded by reference to the final hf-done log in /out/run/gates.jsonl, alongside the embedded candidate-seven measurement rows above. Every call still executes at the protocol cap and is asserted <=900000 at 32/8. The production artifact size and source hash are the checked fixture metadata."

[attempt.nineteenth.decoder_compaction]
implementation = "OpeningWorker reads the same identity, owner, public key, metadata, generation, key version, expiry, effective epoch, status and slot through the existing checked Reader methods; the unused worker field is validated and discarded rather than copied into the private projection. The cache holds only successfully decoded rows and binds them to the exact immutable storage slice; all other slices use that same strict decoder. No protocol record changes."
qualification = "Final candidate-six measurements and their result are the participant_call and participant_calls lines in /out/logs/verify-2.log, identified by the final verify row of /out/run/gates.jsonl. The matching build is /out/logs/build-2.log. These references do not claim an outcome before the gates run."

[attempt.nineteenth.final_artifact]
wasm_bytes = 524144
deployment_envelope_bytes = 104
packaged_bytes = 524248
limit_bytes = 524288
remaining_bytes = 40
implementation = "Keep the unrolled four-word identity equality. Nonzero construction directly ORs those same four words in an inline helper, avoiding comparison against a separate zero array; every byte is still checked. participant_identity_comparisons_preserve_every_byte now also checks every single-byte nonzero identity at all 32 positions and values 1 through 255. The reputation writer retains sequential checked scalar calls and emits status, flags and zero padding as one big-endian u32. The cached worker projection remains bound to the exact immutable input slice."
gotcha = "The four timestamp loop variants grew the artifact and were removed; the final serializer retains the existing field order. Explicit u8 flags keep the packed four-byte field typed correctly. The builder rejected every oversized trial before publishing a fixture. No protocol cap, envelope allowance, assertion or optimizer recipe changed."
evidence = "The final artifact source and wasm digests are ai-market-opt-z.kvx. Final gate revision, exact command, exit and private evidence are the build-2 and verify-2 rows of /out/run/gates.jsonl; candidate-six measurements are the participant_call and participant_calls lines in /out/logs/verify-2.log. No gate outcome is claimed before execution and no edits follow the final gate result."


