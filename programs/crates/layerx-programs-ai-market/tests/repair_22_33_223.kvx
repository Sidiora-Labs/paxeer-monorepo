observed = "All downstream compilation checks passed; 27 of 30 declared cases passed, including the room profile, compiled close settlement and identity equality regressions. The three inherited fuel sweeps still failed at the unchanged 900000 margin assertion."
chunk = 7
open_32_8 = [833545, 872662, 908311, 943960]
open_32_8_last = "No completed measurement; CPU refusal at attempted 1000046 against 1000000."
finalize_32_8 = [515041, 620550, 621383, 622216, 941581]
open_24_6 = [659327, 703536, 892608]
finalize_24_6 = [420200, 500596, 762268]
repair = "Use the next candidate chunk size six at 32 participants only; ProcessAggregation stays eight and every smaller roster stays unchanged. Encode reputation fixed records sequentially without a dynamic field table, retaining the compact strict decoders and their exact length, identity/version/score, flag, padding and record checks. Cache each opening worker projection only for the exact immutable committed input slice and its checked row index, so rollover authorization and snapshot freezing consume the same checked projection without decoding it again. Scratch and changed identity sections are never cached. This removes the repeated dynamic field-table traversal and per-field cursor/copy overhead on the accumulated participant journal and the full frozen roster; it does not remove any validation. The independent participant_record_codec_keeps_the_canonical_layout test fixes wire bytes and malformed/truncated inputs."
qualification = "The final hf-build and hf-done rows of /out/run/gates.jsonl reference the exact same final revision and private evidence. The next hf-done log contains every measured candidate-six call at each executed maximum and roster journey size, with call counts and totals; this record does not claim their outcome in advance. No edits follow that result."

