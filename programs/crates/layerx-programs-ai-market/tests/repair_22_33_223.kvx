exit = 101
log = "/out/logs/roster-before-16.log"
open = "8/2 284340 (expected READINESS_BLOCKED),16/4 747867,24/6 refused attempted 1000005,32/8 refused attempted 1000008; the inherited 8-to-16 implied slope is 57940.875 per added worker and implies 1674921 at 32/8, but 8/2 is an early refusal and this is not a completed-opening estimate."
begin = "16/4 419046,24/6 571284,32/8 726721; adjacent slopes 19029.75 and 19429.625 per added worker; no dependence beyond the single-copy task slope."
finalize = "16/4 804628,24/6 refused attempted 1000003,32/8 refused attempted 1000015; only one completed point exists, so no numeric roster slope or 32/8 full cost is claimed."
process = "16/4 234038,231663;24/6 293796,293477,291281;32/8 355172,352917,352929,349997; unchanged production code is retained."
handler_review = "SectionReader::new indexes all six frame sections once; opening receives that reader in compose_sections and rollover_roster_framed, and aggregation::apply_finishing constructs it once then carries its frame in View. eligible_inputs resolves reports through its once-decoded admission and evaluator regions. complete_region consumes the produced section and the captured roster once. No per-participant lookup from the frame head was found; no additional index is justified by the measured task slope."
stop = "Decision 3052 requires the intrinsic-cost case to stop without a handler repair or a new continuation operation. The final declared gates retain every assertion and record the existing full-roster refusals; no second repair cycle is taken. Opening total-fuel measurement remains incomplete, explicitly recorded above."

