record = "The final candidate revision, exact command, exit and private log are the last build/verify rows in /out/run/gates.jsonl; no pass is claimed before hf-done executes."

[qualification.tenth_attempt_repair1_gate]
revision = "8dba3555d90488c8da303835e481810c7ebd7be4"
command = "cg spec done 22.33.223 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-2.log"
observed = "Build and all 32 dependent crates passed; 15 verification cases passed and the all-selector fuel case retained CPU refusals. The complete attempted fuel per row is recorded in qualification.tenth_attempt_repair1_census."
repair = "Reuse decoded immutable input for byte-identical copied identity/admission sections; use binary lookup in validated sorted worker/admission and score tables; retain one exclusive validated reputation editor through roster insertion; scan only occupied reward slots after Draft validation; inline the checked Reader::take boundary while retaining compact scalar calls. All bounds, errors and protocol fuel limits remain unchanged."

[gotcha.tenth_attempt_final_repair_import]
observed = "ScoreEntry is defined publicly in types, while its codec import is private; the new aggregation helper references crate::types::ScoreEntry. The fixture build exposed this before task qualification."

[gotcha.tenth_attempt_final_repair_size]
observed = "Inlining all Reader scalar methods exceeded the deployment envelope limit during fixture generation. Retaining non-inlined scalar methods and inlining only take produces a 516432-byte guest plus the unchanged 104-byte envelope."

[qualification.tenth_attempt_budget_stop]
revision = "8dba3555d90488c8da303835e481810c7ebd7be4"
command = "cg spec done 22.33.223 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-2.log"
status = "Implemented, not qualified; the runner counts build-2 and verify-2 as the two allowed repair cycles. No third gate is authorized. Final source optimizations and the regenerated fixture postdate this last candidate and have no hf-build/hf-done evidence."

[gotcha.tenth_attempt_gate_budget]
observed = "The gate runner counts repeated builds and repeated verifications separately: max(0, builds-1) plus max(0, verifications-1). Build-2 plus verify-2 exhaust both cycles; treating that pair as one repair cycle incorrectly left additional implementation after the stop result."

