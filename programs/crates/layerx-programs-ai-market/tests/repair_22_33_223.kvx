[repair.fifteenth_bounded_repair]
opening = "The committed reputation editor uses the already checked container, validates inserted records and checks the produced size, preserving the strict public editor and opening validation. Opening and aggregation stage preserved control through a section reader and an exact byte comparison; a real departing-worker control edit still takes strict control decoding."
begin = "The F07 seal consumes only the committed header, worker IDs and history statuses in one ascending join. It appends the checked eligible count and allowed bitmap while copying every reputation record and completed history byte unchanged; no reputation state is decoded or re-encoded merely to add a seal."
process = "ChunkVotes merges admitted score slices directly. The committed report reader checks exact frozen binding bytes encoded once per call, the evaluator receipt, versions, evidence and vector framing; inconsistent binding bytes retain field-specific codec refusals. No packed array of full report bindings is constructed, no earlier output is decoded, and report lookup remains one ordered traversal. The general sparse typed/encoded projection test exercises the same chunk merge."
finalize = "The composer decodes consumed reputation records once without a second container-wide validation. Completion uses the segment binding established by opening, checks worker/generation/owner and frozen binding, validates each replacement and the appended completion record, and writes the resulting records once. Public segment checks, untrusted decoders and strict completion vectors remain intact."
regression = "aggregation_seal_preserves_suspended_history_bytes drives real approval, enrollment, opening, suspension, evidence, signed reveal, seal, exact Begin retry, chunk and completion through both production routing and the compiled guest. It asserts byte-preservation of the pre-seal reputation region and admission table, eligible count three, a clear suspended-worker bit, no qualifying observation and unchanged segment/status after completion. opening_preserves_control_and_retires_only_departing_worker retains its strict departing-slot and survivor assertions."
qualification = "The final build and verification are the last matching-candidate entries of /out/run/gates.jsonl; both commands, exits and private log locations are recorded there by reference before the pair. Successful and refused rows at all four rosters, each process chunk, and their implied slopes are printed by roster_state_fuel_scaling into the final verify log with RUST_TEST_NOCAPTURE=1. A missing completed finalize point does not establish a numeric slope; a refused attempted value is never treated as total fuel. No edit follows the final gate result."
fixture = "Generated after the complete source repair and formatting by tests/fixtures/build-guest.sh with Binaryen 132 and the unchanged explicit production opt-level z/postprocess configuration. Private regeneration log: /out/logs/guest-generation-15-bounded-repair.log. Exact source digest, artifact digest and byte length are in tests/fixtures/ai-market-opt-z.kvx."

[gotcha.fifteenth_repeated_control_decode]
observed = "The first bounded handlers still reached DirectCall::stage_state_and_events, which materialized the whole replay/control table after each producer preserved it unchanged. The bounded staging path checks the frame revision and exact unchanged control bytes; actual control mutations still use the strict path."

[repair.fifteenth_deployment_size]
sharing = "Strict and committed reputation decoding and record updates use one implementation selected by an explicit checked-input flag. The opening roster join and history-seal writer are shared, and host staging is kept out of line. All original strict validation and produced-record checks remain; no protocol bound or optimizer argument changes."
evidence = "The initial bounded repair generated 526189 wasm bytes with Binaryen 132 and exceeded the 524288-byte payload limit with its 104-byte envelope. The final regenerated fixture's exact size and source/artifact digests are in tests/fixtures/ai-market-opt-z.kvx; its generation log is /out/logs/guest-generation-15-bounded-repair.log. Qualification remains the final matching-revision build/verify pair in /out/run/gates.jsonl."

[gotcha.fifteenth_seal_writer_result]
observed = "During guest regeneration the shared wasm seal writer initially returned unit because the macro result had a semicolon; it now explicitly returns the checked writer result, matching the existing codec writers. No additional qualification gate was run."

[repair.fifteenth_shared_seal_projection]
begin = "BeginAggregation computes the frozen evaluator eligibility count while its existing eligible-input reader holds the decoded identity and admission sections, then carries that count into the history-seal composer. The composer does not decode those sections a second time; the count includes every eligible frozen evaluator, including those without a report. Finalization consumes the previously sealed count unchanged."
artifact = "The final source generates 523936 wasm bytes plus the unchanged 104-byte deployment envelope, total 524040, below 524288. Build-guest.sh completed with explicit release opt-level z and Binaryen 132 using the unchanged optimizer command; /out/logs/guest-generation-15-bounded-repair.log."
qualification = "The final build-2 and verify-2 records in /out/run/gates.jsonl are the exact revision, command, exit and private evidence references for this repair. All roster/chunk rows and slopes are emitted into the verify log; no source edit follows that pair."

[gotcha.fifteenth_regression_score_import]
observed = "At ae707a1ad825f2de8f332cbec7da4b3857d07bb7, cargo build --locked --manifest-path programs/crates/layerx-programs-ai-market/Cargo.toml --tests exited 101 because aggregation_seal_preserves_suspended_history_bytes used Score without importing it; /out/logs/build-2.log. The regression now imports the production Score type, preserving its exact coverage assertion."
qualification = "The following build-3 record and any subsequent verify record in /out/run/gates.jsonl supersede the earlier build-2/verify-2 reference. No guest source or fixture changes follow generation; only the missing test import and this evidence record changed."

