[repair.22.39.235]
decision = "3053"
gotcha = "3772"
baseline_revision = "ab70c667c76cc8c73a12aab4ad20e6c53ae65d5e"
baseline_command = "cargo clippy --locked --manifest-path programs/Cargo.toml -p layerx-programs-runtime --no-deps --all-targets -- -D warnings"
baseline_exit = 101
baseline_log = "/out/logs/lint-inventory.log"
baseline_unique_diagnostics = 313
baseline_coverage = "Library and library-test diagnostics; dependent integration targets could not be checked until the library compiles cleanly."
qualification = "The runner-owned /out/run/gates.jsonl binds both hf-build and hf-done to the unchanged candidate revision, commands, exit codes, and private evidence logs. The final response copies its last verify row."
required_final_lint_count = 0
final_lint_count = "Reference: the final verify row of /out/run/gates.jsonl and its private log; an exit-zero all-targets Clippy gate establishes zero remaining lints, otherwise the recorded diagnostics remain unqualified."
final_count_evidence = "This count is qualified only by an exit-zero hf-done row for the same revision as hf-build; until that gate passes it is a required postcondition, not a measured result."
verified_revision = "Reference: revision of the matching successful build and verify rows in the current runner-owned /out/run/gates.jsonl; the final response copies the exact verification evidence."
build_evidence = "Reference: matching-revision build row in /out/run/gates.jsonl, with command, exit, and private log."
verify_evidence = "Reference: final verify row in /out/run/gates.jsonl; /out/logs/verify-N.log includes the all-targets Clippy command and graph qualification."
assertion_preservation = "Every original test function and assertion is retained; success extraction uses a matching assertion, and long tests delegate unchanged assertion stages to named helpers."

[gotcha.scope]
observed = "The baseline Clippy run cannot compile integration targets while the library and library-test targets fail, so the initial 313 distinct diagnostics are the reported inventory rather than proof of full target coverage."
repair = "Repair all reported sources and existing integration success assertions before the bounded all-targets gates; use the final denied-warning gate as authoritative coverage."

[gotcha.evidence]
observed = "Embedding a candidate hash in its own repair file would change that candidate hash."
repair = "Name the verified revision and both gate records by reference to the runner-owned immutable ledger; copy exact final evidence in the response."

