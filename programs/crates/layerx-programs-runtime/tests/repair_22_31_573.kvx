[repair.22.31.573]
mode = "BUILD"
base_revision = "a2929e37fb9b23a6cbd9057b325de3dc9cdf4c53"
decisions = ["2679", "2683", "2685", "2689", "2692", "2698", "2750"]
gotchas = ["3264", "3269", "3275", "3279", "3282", "3288", "3290", "3365"]
evidence = "The exact candidate revision, build command, verify command, exit codes and private logs are recorded by reference to /out/run/gates.jsonl; the final response copies the final bounded gate result. No successful qualification is claimed before hf-done passes."
accounting = "The store keeps the previous retained snapshot independently of the sampled-transition pending snapshot. The first observation uses full state sizes; subsequent observations charge memory expansion plus changed 4096-byte pages and changed instance members. A separate canonical ObservationCharge preserves full snapshot sizes, instance sizes, commitment fuel and witness bytes while the host and observer authorize the same retained byte and work totals."
host = "Canonical host preimages and storage overlays are compared with the preceding retained supplement. Unchanged pages and overlay entries are not charged again. Retention history resets with a new capture or trace, and restored single-step replay seeds the store's previous retained snapshot."
diagnostic = "A retained-limit refusal appends retained_bytes, remaining_bytes and remaining_work to execution_supplement.retained_limit in the EngineFault reason."
requested_regression = "The real ABI-v2 guest declares 17 Wasm pages, writes shared storage, emits an event and performs 128 storage reads into distinct 4096-byte pages. Per decision 2683 the authenticated request uses the exact declared budget, sequence 1, height 1000 and kernel maximum 4096-boundary, 1048576-byte profile; it requires more than 128 and at most 4096 boundaries, every host result, storage, event and fuel assertion. The 2-boundary case asserts the exact commitment-limit refusal and storage rollback."
bounded_regression = "An additional eight-read authenticated case requires the total full linear-memory snapshots to exceed 64 MiB while retaining a valid replay record under the same 128-boundary profile. It checks every actual host result and changed memory page on decoded production replay boundaries."
resolved_contract = "ProgramReplayProfile fixes the source-instruction interval at 1, so 128 host calls require more than 128 boundaries. Decision 2683 authorizes the kernel maximum 4096 for the distinct-page case and preserves the eight-read case under the 128-boundary profile."
baseline_numbers = "No pre-repair gate was run: the task forbids building or testing until the entire implementation is complete. No unobserved retained-limit numbers are asserted as measured evidence."
frozen_vectors = "program_replay, repair_22_31_259 and repair_22_31_569 are unchanged; repair_22_31_564 changes only its stale refusal reason to include at retain_boundary_capture.source and are qualified only by the declared hf-done invocation at the candidate revision. MAX_TRACE_STATE_BYTES, MAX_PROGRAM_REPLAY_BYTES, captured_leaf, from_captured and witness digests are unchanged."
qualification_reference = "The final build and verification evidence is the last build and verify entries for the same revision in /out/run/gates.jsonl, including exact commands, exit codes and private log paths; hf-done must pass before this task is qualified."
dependency_resolution = "Task 22.31.572 repairs the historical compat.rs include failure and is required by this task; the historical finding below is retained by reference without reinvestigation."
continuation = "Attempt 5 preserves the attempt-4 tree on the supplied base 6e6455302579344df116b87109309a9f1131a2eb with 22.31.572 and 22.31.574 merged. Decision 2692 avoids legacy trace materialization for every profiled V2 outcome and reduces only this proof's storage baseline to 32 bytes, including its rollback expectation. All existing assertions and RETAINED_PAGE_BYTES remain. Only hf-build and hf-done are allowed in this session; hf-done runs the dependent-crate check and all five test binaries, so no individual binary is run separately. The current /out/run/gates.jsonl entries supersede historical qualification results below."
module_start = "The instantiation callback refuses captured module initializers before retaining a boundary without an entrypoint context. After successful instantiation, entrypoint execution installs execution_supplement_retained. This preserves program_replay::actual_module_start_refuses_unobservable_start_state and prevents stale terminal authorization from carrying an initializer's byte count into the entrypoint."


legacy_trace = "Profiled V2 executions leave the optional legacy trace None on success, published failure and all budget-refusal exits, skipping measure_execution_transitions and account_trace_snapshot entirely. Replay record capture, canonical commitments, witness encoding, limits and unprofiled execution are unchanged; commit.rs is unchanged. Both successful 573 cases assert the legacy trace is absent."
legacy_trace_compatibility = "The declared verify suites contain no assertion requiring a legacy trace under a replay profile; program_replay requires None for a retained guest trap."
witness_measurements = "Measured admitted host_calls, boundary count, leaf_bytes (sum of encoded leaves), framed_leaf_bytes (leaves plus four-byte length prefixes) and record_bytes are recorded by reference to the repair_22_31_573 measurement line in the final verify log named by /out/run/gates.jsonl. Each boundary line records portable state, semantic and remaining metadata bytes. The test asserts the framed leaf total and whole record fit the unchanged 1048576-byte limit; no unobserved numbers are asserted here."
baseline = "The shared-storage baseline is 32 bytes of 0x33, verified on rollback; the guest writes VALUE and reads into distinct 4096-byte retained pages. The proof first attempts 128 calls under the merged chunk-root encoding; only a witness-bound refusal starts the search of real authenticated executions between 65 and 128 calls for the largest admitted count. That branch asserts adjacent maximality and rollback for every refusal. The admitted count and per-boundary witness composition are emitted to the final verify log; all successful-case assertions apply to the selected count. No runtime fallback or profile bound changes."

