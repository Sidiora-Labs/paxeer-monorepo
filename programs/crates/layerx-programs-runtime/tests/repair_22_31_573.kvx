result = "Stopped at the explicit reader condition before changing the leaf encoding or frozen vectors; attempt-5 implementation stands, no test was weakened or rerun, no memory-delta implementation or successful qualification is claimed, and hf-build evidence is retained by reference to /out/run/gates.jsonl."

[continuation.attempt8]
decision = "2750 supersedes the withdrawn memory-encoding change of 2696; portable_replay.rs and replay.rs remain unchanged, as do the recorded vector suites and their already-sited 564 refusal assertion."
reader = "Every raw leaf is decoded with its record header. Host result and 17-page assertions use PortableBoundary::rebuild_memory starting from the validated guest initial_replay_memory and advancing through every preceding leaf; the eight-read proof separately retains the empty accounting baseline so the first observation must still charge the whole state."
merge = "The inherited execute.rs contained six unresolved current/seed conflict blocks. They are resolved by preserving the current initializer and trap guards and the retained-state callback. The two streaming capture setup sites introduced by 577 now install the retention-aware callback too; module initialization retains its refusal callback."
measurements = "The final verify log referenced by /out/run/gates.jsonl contains the admitted host_calls, boundaries, leaf_bytes, framed_leaf_bytes and record_bytes, plus each boundary's encoded state, encoded semantic, metadata and changed-chunk count. These are measured by the test in the declared hf-done invocation at the same candidate revision as hf-build, without editing the record after qualification."
gate_reference = "The exact revision, command, exit code and private log locations are the final same-candidate build and verify entries in /out/run/gates.jsonl. Only hf-build and hf-done are run; no individual binary or extra gate is run."

