[repair.22.39.349]
base_revision = "a61b1b58f6493189bfb383cd953820d52e35fa2e"
decision = "3215"
gotcha = "4137"
defect = "repair_22_33_259 included src/ffi_interface.rs unconditionally; host-ffi also exports its three unmangled functions from the runtime library, producing duplicate definitions at link time."
change = "Include the production interface module only without host-ffi. With host-ffi, declare the same scalar C functions and resolve them to the runtime library, preserving the activity byte source and every existing case and assertion."
without_feature = "All seven original tests plus retain_host_ffi_exports execute; descriptor validation uses the locally compiled production module."
with_feature = "The same eight tests remain registered and execute when this target is run with host-ffi; descriptor validation and ABI admission call the runtime library's exports. The declared feature gate builds and links every package test target but does not execute feature-enabled tests."
symbol_test = "retain_host_ffi_exports asserts admitted and refused ABI transitions and account-profile-2 versions, then proves descriptor binding and real pre-entry event execution."

