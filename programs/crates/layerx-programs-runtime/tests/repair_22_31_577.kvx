[attempt_8]
decision = "2735"
gotcha = "3346"
initial_executor_breakdown = "Before decision 2735, the requested exact executor diagnostic exited 101 at the carried layout: cargo test --locked --manifest-path programs/Cargo.toml -p layerx-programs-runtime --test repair_22_31_577 -- market_tests::profiled_executor_admits_128_distinct_chunk_writes_in_17_wasm_pages --exact --nocapture; /out/logs/executor-before-header-flags.log. Step 734: witness observed=1048815 permitted=1048576; leaf=853; arbitration=235 plus framing 4 (legacy=131, memory=40, changed_chunks=0, engine=54, host commitment=40); frames=24; instruction=6; fuel expansion=16; supplement=48; semantic=515 plus framing 4 (host=382, storage=89, composition digest=32, field framing=12); trap=1; header=988. Host split: code hash=0, ABI effects=16, runtime=284, meter=70, storage baseline=0, field framing=12. Composition inside runtime: code hash=0, revision=1, graph bytes including flags and graph field framing=252. The earlier diagnostic compilation used a private cursor offset; the printer was repaired to sum parsed field sizes before this one proof executed."
implementation = "Host and embedded composition record encodings carry explicit presence flags for program identity, ABI, storage baseline and composition revision. Equal immutable fields restore from the authenticated record header; explicit immutable disagreement refuses Binding in the shared decoder reached by both boundary entry points. A present duplicate equal value refuses Encoding as noncanonical. The header ABI stores the authority and the four canonical empty effect-list counts; an unchanged ABI is absent, while a changed ABI carries its real bytes and must retain exactly the header authority. Mutable effects, runtime graphs and meter state remain lossless per-boundary data. Raw semantic witness canonical bytes, digests, memory roots/change chunks, replay hash domains, fuel and profile limits are unchanged."
amended_assertions = "program_replay::composition_semantic_digest_authenticates_the_decoded_witness restores revision V2 from the header, asserts its absent flag, retains all composition graph/digest checks and the revision-disagreement Binding refusal through both boundary entry points. It additionally forges present host code hash, ABI authority, storage baseline and composition code hash, requiring Binding from both decoders. Existing carried suites continue to inspect restored canonical witnesses and full rebuilt memory. repair_22_31_577::captured_leaf_breakdown measures both compact and restored host fields, prints executor steps 456/734 if admitted and sandbox middle step 456, retaining every original assertion."
final_metrics = "By reference to /out/run/gates.jsonl and its final verify log: executor and sandbox admitted_count/leaf_total/record_total lines, compact and restored middle-leaf splits, or an exact executor Bounds refusal and its new breakdown if admission still exceeds the unchanged 1048576-byte limit. No failing proof is reported as an admitted record."
qualification = "Final identical-candidate hf-build and hf-done evidence (revision, command, exit and private log): by reference to /out/run/gates.jsonl. The task record is not changed after successful qualification. The ruling requires stopping on the exact remaining bound finding without altering another layout or increasing a limit."

