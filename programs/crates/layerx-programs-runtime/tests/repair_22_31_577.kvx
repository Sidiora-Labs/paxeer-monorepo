sandbox_metric = "repair_22_31_577 sandbox admitted_count=128 leaf_total=1027329 record_total=1032153"
sandbox_step_456 = "Measured leaf_total=4649; arbitration=4320 plus framing 4 (legacy=4216, memory=4140 with one changed chunk, engine=54, host commitment=40); frames=21; instruction=5; fuel expansion=16; supplement=48; semantic=230 plus framing 4 (host=97, storage=89, composition digest=32, field framing=12); trap=1; header_total=1038. Host code hash flag=1, ABI flag=1, runtime=16, meter=70, storage baseline flag=1, field framing=8; embedded composition code hash flag=1, revision=0, graph flags=2."
executor_metric = "No admitted executor record exists: capture refused at step 900 with witness observed=1048953 permitted=1048576, 377 bytes over, leaf_length=518. The final record consumer therefore cannot print an admitted_count, leaf_total, record_total or a measured step-743 leaf; none is claimed."
executor_step_900 = "Measured leaf_total=518; arbitration=185 plus framing 4 (legacy=81, memory=40 with no changed chunks, engine=54, host commitment=40); frames=4; instruction=6; fuel expansion=16; supplement=48; semantic=250 plus framing 4 (host=117, storage=89, composition digest=32, field framing=12); trap=1; header_total=1255. Host code hash flag=1, ABI flag=1, runtime=36, meter=70, storage baseline flag=1, field framing=8; embedded composition code hash flag=1, revision flag=1, graph flags including the new graph flag=3."
remaining_field = "The compact host runtime is 36 bytes versus the live-snapshot runtime's 16. Two bytes are the composed revision and graph flags. The other 18 are the existing runtime outcome: host/mod.rs write_v2_runtime_state writes Some(V2OutcomeRegion::Response) as its tag, an eight-byte length and the ten-byte empty ResponseRegion state (capacity u64 plus published/refusal flags); the sandbox writes a single None tag. composed_with_response initializes this real response region, while sandbox does not. The graph itself is now restored from the record header and is not repeated in the leaf."
remaining_layout_finding = "Replacing the carried 250-byte graph field with one flag removes exactly 249 bytes. The carried step-743 size 4918 therefore projects 4669, not 4666; this arithmetic is not presented as a measured successful leaf. The remaining response outcome and every other semantic field are required to stand, so eliminating the additional 377 witness bytes would need a further layout ruling. No limit, profile, assertion, response state, failure graph, meter, frame, instruction, fuel expansion, supplement or memory section is changed to bypass this finding, and the known failing bound is not rerun unchanged."
status = "implemented_not_qualified"
record_amendment = "This finding-only task-record amendment follows the failed bounded gate. The implementation was built and verified at the identical named revision; this subsequent evidence amendment is not claimed as a qualified candidate. No commit, push or additional gate follows the remaining-bound finding."

[attempt_10]
decision = "2741"
gotcha = "3354"
implementation = "ReplayRecordHeader carries response_capacity as an optional u64 after composition_graph, derived from the first captured runtime response region and bound by the existing header digest. A response leaf carries its tag, header-relative capacity presence field, publication marker and optional code/length/payload, and refusal marker and optional canonical refusal. It omits the redundant response-state length word. expand_semantic restores the capacity and original eight-byte state length and validates the exact ResponseRegion canonical bytes; explicit capacity disagreement or a response against a header without capacity refuses Binding. Failure outcomes and composition refusals retain their original encoding; memory, semantic witnesses, fuel, limits and profile stand."
amended_assertions = "program_replay::composition_semantic_digest_authenticates_the_decoded_witness retains all carried checks and adds explicit capacity disagreement and missing header capacity Binding checks through decode_with_header and decode_untrusted. No assertion is removed or relaxed. The breakdown printer adds outcome byte count, tag, capacity flag size, response-state size and exact outcome encoding; the restored-host line includes the reconstructed outcome size. Executor diagnostics now include step 900 as well as steps 456, 734 and 743."
executor_step_900 = "Measured final layout is recorded by reference to the 'after middle_step=900', 'captured_leaf_breakdown step=900' and 'restored_host step=900' lines in the final verify log referenced by /out/run/gates.jsonl. Before this change the same step measured leaf_total=518, semantic_host=117, host_runtime=36 and a 19-byte empty response outcome. The changed empty response encoding is four bytes [01, 00, 00, 00]: response tag, absent capacity flag, absent publication, absent refusal. The canonical restored outcome retains its original nineteen bytes."
executor_metric = "Exact admitted_count, leaf_total and record_total are recorded by reference to the 'repair_22_31_577 executor admitted_count=' line in the final verify log referenced by /out/run/gates.jsonl; no inferred total is claimed as measured. The proof retains 128 calls, 4096 boundaries, 1048576 bytes and every memory assertion."
sandbox_metric = "Exact live-snapshot admitted_count, leaf_total and record_total and middle-step breakdown are recorded by reference to the 'repair_22_31_577 sandbox admitted_count=' and step-456 lines in the same final verify log. Its None outcome remains one byte and its header gains only the absent response-capacity presence byte."
qualification = "The final build, dependent-crate compilation check and verify are recorded by reference to the final build, dependents and verify rows of /out/run/gates.jsonl, each naming the exact revision, command, exit and private evidence location (the dependent row records its commands in its log). Build and verify must name the same candidate; only a passing hf-done establishes qualification. This record is finalized before gates and is not edited after successful qualification. The runner publishes; no manual commit or push."
implementation_gotcha = "Composition MeteringPlanMismatch contains two 76-byte metering plan identities; the outcome locator traverses all 152 bytes before copying the unchanged refusal. The referenced repair_22_31_573.rs is absent in this checkout, so the carried real 17-page proofs remain the implementation source and are preserved."
qualification_repair = "Initial build and all 58 dependent checks passed at 69e400492a28c84b5dbf913130e7eac77280abd9; hf-done exited 1 (/out/logs/verify-1.log) after all ten market tests passed. The added program_replay capacity test omitted the failure-graph presence byte while traversing its real captured runtime, mistaking the composition refusal marker for the outcome. The repair consumes and asserts the absent failure graph before the unchanged composition-refusal and response-outcome assertions. Production code and every original assertion are unchanged by this test-reader repair. Final evidence and measurements remain by reference to the final ledger rows and verify log."
