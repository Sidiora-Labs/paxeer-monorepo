[resolution.authorization-grants]
observed = "The catalogue substring matches the live canonical authorization-grant codec and identifier functions; governance grant creation/amendment, session keys, fee allowances and authority resolution call them."
citations = ["src/modules/governance/lxp_governance.c:391", "src/modules/governance/lxp_governance.c:414", "src/modules/governance/lxp_governance.c:416", "src/state/lxp_authority.c:263", "src/state/lxp_authority.c:570"]
required_action = "Retain the API and canonical bytes; request path-scoped catalogue allowances for its header and implementation instead of equivalent-name renaming or deletion."

[resolution.committed-receipts]
observed = "The flagged type and context API expose canonical committed receipt facts bound to network and block height; Programs validates these facts through the verified receipt index."
citations = ["src/modules/programs/call.c:989", "src/modules/programs/call.c:1009", "src/protocol/lxp_receipt.c:1061", "tests/proof/lxp_proof_lxp_module_h.c:329", "tests/proof/lxp_proof_lxp_receipt_h.c:390"]
required_action = "Retain the committed-receipt proof API and its validation; request path-scoped catalogue allowances for the two headers and two implementations."

[resolution.retirement-probes]
observed = "These opaque declarations have no engine implementation; existing weak-link tests use the pointer types to assert that the retired engine entry points remain absent."
citations = ["tests/codec/lxp_test_programs_retired.c:50", "tests/codec/lxp_test_programs_retired.c:52", "tests/proof/lxp_proof_programs_h.c:24", "tests/proof/lxp_proof_programs_h.c:25"]
required_action = "Retain the opaque test-interface declarations; request a header-only catalogue allowance without permitting retired engine code."

[resolution.governed-schedules]
observed = "The flagged APIs implement the retained governed fee schedule, including validation, staging, activation and occupancy pricing; the chain host binds its runtime resolver."
citations = ["modules/lxphost/host.go:343", "src/modules/governance/lxp_governance.c:129", "src/modules/programs/occupancy.c:896", "src/modules/programs/fees.c:1029", "src/modules/programs/fees.c:1671"]
required_action = "Retain the governed schedule APIs; request a header-only catalogue allowance while preserving the retired activity ordinal and handler refusal."

[resolution.genesis-namespace]
observed = "The reserve namespace is reached by the current genesis validator, materializer and default builder, and canonical account-id fixtures assert its historical hashes; it is not an unreachable disclosure path."
citations = ["src/protocol/lxp_genesis.c:489", "src/protocol/lxp_genesis.c:526", "src/protocol/lxp_genesis.c:911", "src/protocol/lxp_genesis.c:1082", "include/layerx/lxp_genesis.h", "tests/ledger/test_account_id.c:32"]
required_action = "Obtain a ruling for historical genesis compatibility and a path-scoped allowance, or authorize coordinated genesis-contract and fixture changes; deleting or substituting the name alone breaks the current genesis contract."

[qualification]
