evidence_2 = "do do_2 file addiqate/hyperfide/.github/workflows/platform.yml lines 3-53 note Push and pull_request path filters name the target categories apps, core, sdk, contracts, lib, plugins, tools, examples, tests, assets, patches."
evidence_3 = "do do_2 file addiqate/hyperfide/.github/workflows/ci.yml lines 33-87 note Working directories and cache-dependency-path point at core/control-plane and its package-lock.json."
evidence_4 = "do do_2 file addiqate/hyperfide/deploy/hyperfide/sandbox/layout.mjs lines 9-64 note Prepared layout marker binds layout_generation and mapping_digest and refuses an incompatible prepared image with LAYOUT_IMAGE_INCOMPATIBLE; provision.mjs lines 13 and 58-59 and run-job.mjs line 58 stamp and probe it; layout.test.mjs covers the refusal."
evidence_5 = "do do_3 file addiqate/hyperfide/tools/repository/release.sh lines 1-20 note Nonpublishing release builder with --dry-run and --skip-tests exists; the dist-stamp.mjs module under deploy lines 42-43 resolves the contract copy from the target category."
evidence_6 = "do do_4 file addiqate/hyperfide/tests/hyperfide/cases/source_control/0_8.py lines 81-156 note Typed reference classifier over tools, deploy, .github, .agents and docs with installed-artifact, historical and layout-schema exceptions."
evidence_7 = "do do_4 file addiqate/hyperfide/tests/hyperfide/cases/source_control/0_8.py lines 233-374 note Driver checks absent old containers, CI category routing, nested CI entrypoint, source stamp, git-ignore privacy boundary, checkpoint compatibility, release assembly, packaged startup and prepared image; exits 0 only on PASS, 2 on BLOCKED."
missing_1 = "No old platform, services, src, scripts, kvx or editors directories remain, so the move part is done, but the verify_cmd cannot reach PASS: it needs build/layout/0.8/inputs.json naming a nonpublishing release directory and command receipt, an installed control service startup receipt bound to the service archive digest, and a prepared image with provider read-back. None of these exist in the snapshot (build/ is absent and ignored)."
missing_2 = "The typed reference exceptions for nine current docs files (docs/SOURCE-REFERENCE.md, the six docs/reference/services-*.md files, docs/<project>/console-evaluation.md and docs/<project>/operations.md) rely on untracked receipts under build/layout/0.9 (docs-forward-verification and operations-history-current). In a fresh checkout these rows would be marked unresolved-current-reference, so the references command exits 1 and the driver reports FAIL."
missing_3 = "The driver binds git rev-parse HEAD and HEAD tree from inside the vendored directory, which gives the monorepo commit and the monorepo root tree, not the project subtree. Retained-command ancestry checks use upstream commits that are not in monorepo history."
missing_4 = "The source-stamp check needs core/control-plane/dist, which is a build output, so a build must run before verify."
qualification = "No done record for 0.8. The only related entry is progress.layout_relocation at revision working-tree category-layout-v1, which covers focused relocation checks, pinned installs and a pnpm build. It is not a run of the verify_cmd and cannot be tied to a commit in this repository, so for this task it is absent or stale."
notes = "The relocation and rewiring work for 0.8 is in the tree. What is missing is execution evidence plus two portability defects in the driver: untracked receipt dependencies and host-repository revision binding. The prepared-image and installed-startup assertions need an external executor, so the completion task may end as implemented-not-qualified."

