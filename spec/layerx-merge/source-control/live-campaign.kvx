[task.22.37.31]
task = "22.37.31"
mode = "BUILD"
status = "UNRUN"
cwd = "tools/hyperfide"
registry = "tools/hyperfide/tests/hyperfide/source-control/registry.json"
input_policy = "Variable names and fixture identities only; no access values. Missing inputs remain UNRUN, never PASS."
exit_policy = "Return 0 only for a current REAL_S3 sparse PASS with no executed case failed; missing owner inputs remain UNRUN. Return 77 for an unexecuted sparse proof and 1 for any failed case."
manifest_input = "HF_SOURCE_LIVE_CAMPAIGN_MANIFESTS names a private directory of owner-supplied campaign manifests, using each registration filename; the existing qualifier verifies native capture, pinned inputs, approvals and the exact assertion inventory."
status_policy = "These are admission-time statuses. The private task result inventory and registry contain observed statuses, exact revision, command, exit and redacted log for every executed case; they are referenced below to preserve the immutable build and verify revision."
private_result_ref = "${HF_OUT_DIR}/source-control/22.37.31/latest.json"
build_ref = "${HF_RUN_DIR}/gates.jsonl#kind=build (final row; revision, command, exit, log)"
verification_ref = "${HF_RUN_DIR}/gates.jsonl#kind=verify (final row; revision, command, exit, log)"
repair_revision_ref = "${HF_RUN_DIR}/gates.jsonl#kind=verify.revision"
sparse_driver = "tools/hyperfide/tests/hyperfide/cases/source_control/sparse_live.py"
sparse_command = "python3 tests/hyperfide/cases/source_control/sparse_live.py --actor"
sparse_variables = ["S3_ENDPOINT", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "S3_REGION", "S3_BUCKET"]
sparse_missing = []
sparse_admission_status = "READY"
sparse_status_ref = "${HF_OUT_DIR}/source-control/22.37.31/latest.json#sparse_status"
sparse_receipt_ref = "${HF_OUT_DIR}/source-control/22.37.31/latest.json#sparse_receipt"
postgres_fixture_supplied = true
postgres_failover_supplied = false
provider_execution_supplied = false
gotcha = "The task supplies S3_*; the native backend reads HF_SOURCE_S3_*. Map each of the five explicitly without printing values. Ordinary withpg disables synchronous commits and does not establish PostgreSQL18 failover capability."

[gotcha.task-tooling]
observed = "apply_patch rejects a delete and add for the same path in one patch; use an update. Corepack resolves the root package manager before pnpm --dir; invoke it from the vendored working directory."

[repair.process-ownership]
revision = "648117e7180fb40415c0c396b116b27397c24151"
command = "cg spec done 22.37.31 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The sparse actor emitted a REAL_S3 PASS receipt with fourteen passing host assertions, but strict process supervision rejected its teardown."
repair = "The sparse actor owns and reaps orphaned compiler helpers before returning; the campaign retains all strict descendant checks and records their results in each private receipt."
verified_revision_ref = "${HF_RUN_DIR}/gates.jsonl#kind=verify (final row; revision, command, exit, log)"

