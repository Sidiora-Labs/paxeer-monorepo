ac_4 = "A SequencerForwardOption sets SendConfig.SequencerURL (rpc/send.go:52), never set at HEAD, so eth_sendRawTransaction forwards the bytes to that endpoint."

[req.7013]
title = "Config keys are read, rendered and enforced on the transports"
ac_1 = "ConfigTemplate (rpc/config/config.go:484) renders max_tx_pool_txs, enable_test_api, max_concurrent_simulation_calls and rpc_stats_interval, keys ReadConfig reads at rpc/config/config.go:350 that the template omits at HEAD."
ac_2 = "evm.checktx_timeout, read at rpc/config/config.go:345 and used nowhere, is retired: an app.toml that still carries it reads without an error and the template no longer renders it."
ac_3 = "ipRateLimiter (planned) admits burst requests from one address and refuses the next until the rate refills, enforcing evm.ip_rate_limit_rps and evm.ip_rate_limit_burst (rpc/config/config.go:170), which nothing reads at HEAD."
ac_4 = "ipRateLimiter (planned) keys by the RemoteAddr host so a different address keeps its own budget, and rps 0 disables limiting as documented at rpc/config/config.go:170."
ac_5 = "An address over evm.ip_rate_limit_burst is refused with HTTP 429 and JSON-RPC error -32005 before the request reaches the handler built at rpc/rpcstack.go:322."
ac_6 = "evm.batch_request_limit reaches SetBatchLimits (rpc/rpcstack.go:312), whose limits are never set at HEAD, so a batch above the limit is refused."
ac_7 = "ReadConfig (rpc/config/config.go:268) reads evm.batch_request_limit and evm.batch_response_max_size and defaults them to 1000 and 25000000."
ac_8 = "ReadConfig (rpc/config/config.go:268) reads evm.send_raw_tx_sync_timeout as a duration defaulting to 2s and refuses a value that does not parse."
ac_9 = "ReadConfig (rpc/config/config.go:268) reads evm.max_subscriptions_logs defaulting to 10000, the default of max_subscriptions_new_head at rpc/config/config.go:197."
ac_10 = "ConfigTemplate renders evm.deny_list as a TOML string array instead of the Go slice text produced at rpc/config/config.go:552."
ac_11 = "Every evm. flag ReadConfig reads (rpc/config/config.go:225-265) has a key in the rendered ConfigTemplate."

[req.7014]
title = "Metrics are recorded under served names and the legacy emission stops"
ac_1 = "The InfoAPI records eth_blockNumber, eth_chainId, eth_coinbase, eth_accounts, eth_gasPrice, eth_blobBaseFee and eth_syncing instead of the capitalised labels at rpc/info.go:55 and rpc/info.go:339."
ac_2 = "The trace baker counters, readable only through DroppedCount, BakedCount and FailedCount at rpc/trace_baker.go:153, are exported as evmrpc_trace_bake_dropped_total, evmrpc_trace_bake_baked_total and evmrpc_trace_bake_failed_total."
ac_3 = "A WebSocket connection is counted only by evmrpc_websocket_connects_total; the legacy IncWebsocketConnects call at rpc/websockets.go:16 is gone."
ac_4 = "recordMetricsWithError (rpc/utils.go:483) records only the OTel latency histogram; the legacy request counter and latency calls at rpc/utils.go:493 are gone."
ac_5 = "pax_getTransactionByHash records its latency under endpoint pax_getTransactionByHash, not the eth_getTransactionByHash literal at rpc/tx.go:272."
ac_6 = "Every served eth_, net_, web3_, txpool_ and debug_ method records evmrpc_request_latency_seconds (rpc/metrics.go:49) under its served name."

[req.7015]
title = "Block lookups and simulations carry no foreign chain-id branches"
ac_1 = "Block lookups no longer refuse heights below 79123881 on chain id pacific-1, the floor applied at rpc/utils.go:254 for a chain this network never runs."
ac_2 = "Simulated headers keep baseFee on every chain id; the pacific-1 branch at rpc/simulate.go:881 is removed."

[req.7016]
title = "No lx_* name is served by the node"
ac_1 = "None of the 26 lx_* names of spec/layerx-merge/contracts/clients.md:197-222 is served by the node over HTTP; each answers -32601."
ac_2 = "None of the 26 lx_* names of spec/layerx-merge/contracts/clients.md:197-222 is served by the node over WebSocket; each answers -32601."

[req.7017]
title = "eth_getLogs answers errors instead of silent empty results"
ac_1 = "eth_getLogs returns an error when the earliest available height cannot be read, instead of scanning from height 0 as the fallback at rpc/filter.go:1076 does."
ac_2 = "eth_getLogs with a blockHash that is zero or not found answers the error unknown block instead of the empty list returned at rpc/filter.go:1677."

[req.7018]
title = "Debug raw transaction and tracer shapes follow geth"
ac_1 = "debug_getRawTransaction returns the binary envelope of a committed transaction instead of the ErrEVMNotSupported answer at rpc/tracers.go:739."
ac_2 = "debug_traceTransaction (rpc/tracers.go:282) with callTracer returns the geth call frame shape."
ac_3 = "debug_traceTransaction (rpc/tracers.go:282) with prestateTracer returns the geth prestate map."
ac_4 = "debug_traceBlockByNumber (rpc/tracers.go:639) returns one entry per EVM transaction of the block, in block order, each with the transaction hash."

[req.7019]
title = "The go-ethereum client decodes every node answer it requests"
ac_1 = "ethclient BlockByNumber (core/deps/geth/ethclient/ethclient.go:105) decodes eth_getBlockByNumber of the test server, passing the uncle and transaction checks of getBlock (core/deps/geth/ethclient/ethclient.go:140)."
ac_2 = "ethclient HeaderByHash (core/deps/geth/ethclient/ethclient.go:216) returns the header whose fields equal those of the block returned by number."
ac_3 = "ethclient TransactionByHash (core/deps/geth/ethclient/ethclient.go:268) decodes a committed transaction with isPending false."
ac_4 = "ethclient TransactionInBlock (core/deps/geth/ethclient/ethclient.go:319) returns the transaction at the index of a block found by hash."
ac_5 = "ethclient TransactionReceipt (core/deps/geth/ethclient/ethclient.go:338) decodes eth_getTransactionReceipt with status, gasUsed, logs and blockHash."
ac_6 = "ethclient BlockReceipts (core/deps/geth/ethclient/ethclient.go:124) decodes eth_getBlockReceipts with one receipt per EVM transaction."
ac_7 = "ethclient BalanceAt (core/deps/geth/ethclient/ethclient.go:396) and NonceAt (core/deps/geth/ethclient/ethclient.go:441) return the funded test account balance and nonce."
ac_8 = "ethclient CodeAt (core/deps/geth/ethclient/ethclient.go:426) and StorageAt (core/deps/geth/ethclient/ethclient.go:411) return the deployed test contract code and slot 0."
ac_9 = "ethclient CallContract (core/deps/geth/ethclient/ethclient.go:550) returns the output of a view call on the test contract."
ac_10 = "ethclient EstimateGas (core/deps/geth/ethclient/ethclient.go:650) returns 21000 for a plain value transfer."
ac_11 = "ethclient SuggestGasPrice (core/deps/geth/ethclient/ethclient.go:583) and SuggestGasTipCap (core/deps/geth/ethclient/ethclient.go:593) return positive values with the price at least the tip."
ac_12 = "ethclient FeeHistory (core/deps/geth/ethclient/ethclient.go:618) decodes eth_feeHistory with blockCount base fees plus one and one reward row per block."
ac_13 = "ethclient ChainID (core/deps/geth/ethclient/ethclient.go:71) and NetworkID (core/deps/geth/ethclient/ethclient.go:382) both return the keeper chain id that net_version formats at rpc/net.go:24."
ac_14 = "ethclient SyncProgress (core/deps/geth/ethclient/ethclient.go:349) decodes eth_syncing as nil for a node that is not catching up."
ac_15 = "ethclient FilterLogs (core/deps/geth/ethclient/ethclient.go:457) decodes eth_getLogs over a block range and by block hash with the same logs."
ac_16 = "A header received through ethclient SubscribeNewHead (core/deps/geth/ethclient/ethclient.go:368) hashes to the hash eth_getBlockByNumber returns for the same height."
ac_17 = "A transaction sent with ethclient SendTransaction (core/deps/geth/ethclient/ethclient.go:685) is returned by TransactionByHash and its receipt by TransactionReceipt once committed."
ac_18 = "ethclient PendingNonceAt (core/deps/geth/ethclient/ethclient.go:529) counts a pending transfer and the pending block lists it on a server built with the sequencer and pending options."

[req.7020]
title = "JSON-RPC error codes are frozen"
ac_1 = "The node answers -32000 for unsupported methods (rpc/rpc_unsupported.go:5), -32601 for disabled pax methods (rpc/pax_legacy_http.go:19), 3 for reverts, -32005 for rate limits and 4 for a sync send timeout."

