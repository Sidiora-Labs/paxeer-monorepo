[override.J21.1]
target = "interface.1.c-lxp-result-domain"
status = "change"
basis = "src/protocol/lxp_result.c:14-53 buckets every negative value by range, so unregistered values such as -740 get a domain; task 1.1.2 returns LXP_RESULT_DOMAIN_UNKNOWN for them."

[override.J21.2]
target = "interface.1.c-lx-service-deliverable-check"
status = "change"
basis = "src/modules/service/lx_service_deliver.c:28 returns LXP_ERR_DA_MISSING, a DA code with no DA layer behind it; task 1.1.4 returns LXP_ERR_NON_CANONICAL."

[override.J21.3]
target = "interface.1.c-lxp-state-store-init"
status = "change"
basis = "lxp_state_store_init (src/state/lxp_journal.c:156-164) allocates and initialises the idempotency table of include/layerx/lxp_state.h:40-42; task 1.2.3 removes that table with the idempotency retirement."

[override.J21.4]
target = "interface.1.c-lxp-state-journal-commit"
status = "change"
basis = "lxp_state_journal_commit reserves and appends idempotency entries at src/state/lxp_journal.c:1056-1076 through lxp_idempotency_commit_staged (include/layerx/lxp_state.h:145); task 1.2.3 removes that staging and keeps the cell and sequence commit."

[override.J21.5]
target = "interface.1.c-lx-asset-state-root"
status = "change"
basis = "entry_order at src/modules/asset/lx_asset_state.c:24-25 tie-breaks equal keys by pointer address, which is host-memory dependent; task 1.4.1 refuses duplicates."

[override.J21.6]
target = "interface.1.c-lxp-programs-state-record-encode"
status = "change"
basis = "src/modules/programs/state_record.c:304-305 sorts value-account views without refusing equal ids; task 1.4.2 returns LXP_ERR_NON_CANONICAL on a duplicate."

[override.J21.7]
target = "interface.1.c-lxp-determinism-guard-check"
status = "retire"
basis = "include/layerx/lxp_kernel.h:658 reads a process-global atomic (src/protocol/lxp_determinism_guard.c:9) that is not per-kernel under cgo hosting; task 1.4.5 deletes it."

[override.J21.8]
target = "interface.1.c-lxp-determinism-guard-trip"
status = "retire"
basis = "include/layerx/lxp_kernel.h:659 writes the process-global guard of src/protocol/lxp_determinism_guard.c:9; task 1.4.5 deletes it."

[override.J21.9]
target = "interface.1.c-lxp-determinism-guard-reset"
status = "retire"
basis = "include/layerx/lxp_kernel.h:660 resets the process-global guard of src/protocol/lxp_determinism_guard.c:9; task 1.4.5 deletes it."

[override.J21.10]
target = "interface.1.c-lxp-kernel-execution"
status = "change"
basis = "lxp_kernel_execution carries a host-filled lxp_fee_meter fee_meter (include/layerx/lxp_kernel.h:382) that lxp_kernel_execute_activity passes to lxp_fee_compute at src/protocol/lxp_kernel.c:7119; task 1.5.2 requires it zero on entry."

[override.J21.11]
target = "interface.1.c-enum-lxp-queue-disposition-magic"
status = "retire"
basis = "include/layerx/lxp_fee.h:113-118 frames the queue disposition WAL record whose codec at src/state/lxp_journal.c:1112-1208 has only a test caller; task 1.6.2 deletes it."

[override.J21.12]
target = "interface.1.c-lxp-state-diff-entry"
status = "retire"
basis = "include/layerx/lxp_state_diff.h:7 serves only the state diff codec of src/state/lxp_state_diff.c, whose remaining caller is tests/state/lxp_test_state_diff.c; task 1.6.3 deletes it."

[override.J21.13]
target = "interface.1.c-lxp-state-diff-encode"
status = "retire"
basis = "include/layerx/lxp_state_diff.h:12 has no product caller at HEAD; task 1.6.3 deletes it."

[override.J21.14]
target = "interface.1.c-lxp-state-diff-decode"
status = "retire"
basis = "include/layerx/lxp_state_diff.h:15 has no product caller at HEAD; task 1.6.3 deletes it."

[override.J21.15]
target = "interface.1.c-enum-lxp-capacity-format-version"
status = "retire"
basis = "The capacity ledger of include/layerx/lxp_kernel.h:725-860 is reserved and reconciled only by the retired daemon (cmd/layerxd/lxp_daemon_lni.c) and tests under tests/programs; task 1.2.4 deletes it, as decision.102 records."

