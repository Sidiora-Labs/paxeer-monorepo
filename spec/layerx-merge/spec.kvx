ac_1 = "gaskv.Store.Has (sdk/store/gaskv/store.go:98) and Delete (sdk/store/gaskv/store.go:110) write no go-metrics sample, matching Get and Set of the same store."
ac_2 = "Has and Delete keep charging HasCost and DeleteCost of KVGasConfig (sdk/store/types/gas.go:349) after the timing is removed."

[req.15020]
title = "Saturate the infinite gas meter at MaxUint64 on overflow"
ac_1 = "infiniteGasMeter.ConsumeGas (sdk/store/types/gas.go:231) sets consumed to math.MaxUint64 on overflow as basicGasMeter does at sdk/store/types/gas.go:107, instead of the 0 returned by addUint64Overflow (sdk/store/types/gas.go:92)."
ac_2 = "After saturation the meter never wraps to a small consumed value, so a recovered overflow cannot be followed by cheap execution (sdk/store/types/gas.go:236)."

[req.15021]
title = "Map scheduler aborts to ErrOCCAbort in runTx only when OCC is enabled"
ac_1 = "runTx (sdk/baseapp/baseapp.go:853) wraps the recovery chain with newOCCAbortRecoveryMiddleware (sdk/baseapp/recovery.go:68) when ctx.IsOCCEnabled() (sdk/types/context.go:135) holds."
ac_2 = "With OCC disabled a scheduler.Abort is an unexpected panic and reaches the default recovery middleware, which settles the open question at sdk/baseapp/baseapp.go:889."

[req.15022]
title = "Pin the OCC rerun rule for validated tasks that gain a conflict"
ac_1 = "shouldRerun (sdk/tasks/scheduler.go:360) invalidates a validated task when findConflicts (sdk/tasks/scheduler.go:173) reports a conflict, through invalidateTask (sdk/tasks/scheduler.go:134)."
ac_2 = "A validated task without conflicts is not re-executed; the ordered fail-fast validation noted at sdk/tasks/scheduler.go:370 is the only mode the scheduler runs."

