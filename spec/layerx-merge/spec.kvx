[req.2241]
title = "Generate layerxpay Params and MsgUpdateParams from api/layerxpay/tx.proto"
ac_1 = "MsgUpdateParams.ValidateBasic in modules/layerxpay/types/msgs.go (planned) refuses a non-bech32 authority with sdkerrors.ErrInvalidAddress and accepts a bech32 governance authority with every combination of the five Params booleans, matching the rule of modules/layerxledger/types/msgs.go:23-28."
ac_2 = "RegisterInterfaces in modules/layerxpay/types/codec.go (planned) registers MsgUpdateParams as an sdk.Msg implementation with type URL /paxprotocol.paxchain.layerxpay.MsgUpdateParams and registers the Msg service descriptor."

[req.2242]
title = "Register layerxpay codespace errors for unbound callers, disabled families, gate drift"
ac_1 = "modules/layerxpay/types/errors.go (planned) registers ErrUnboundCaller (code 4, LXP_PAY_UNBOUND_CALLER), ErrFamilyDisabled (code 5, LXP_MODULE_DISABLED) and ErrKernelGateMismatch (code 6, LXP_PAY_KERNEL_GATE_MISMATCH) in codespace layerxpay beside ErrInvalidGenesis code 3 (modules/layerxpay/types/params.go:11)."
ac_2 = "PayRevertCode (planned) maps the three errors to registry codes for which pcommon.LXPRevert (precompiles/common/lxp_errors.go:339) yields revert data starting with that code and not LXP_UNKNOWN, and returns empty for any other error."

[req.2243]
title = "Derive per-call idempotency keys and 0x0906 stream ids deterministically"
ac_1 = "DeriveIdempotencyKey(txHash, callOrdinal, selector) in modules/layerxpay/types/idempotency.go (planned) equals sha256(\"layerxpay/idempotency/v1\" || txHash || be32(callOrdinal) || selector), is never the zero key, and changes when any one input changes."
ac_2 = "DeriveStreamID(txHash, callOrdinal, payer) (planned) equals sha256(\"layerxpay/stream-id/v1\" || txHash || be32(callOrdinal) || payer), is nonzero as the kernel open decode requires, and differs for two payers in one transaction."

[req.2244]
title = "Freeze the 0x101B method to kernel activity type table"
ac_1 = "MethodActivity in modules/layerxpay/types/activity.go (planned) maps each of the 38 nonpayable methods of precompiles/layerxpay/abi.json:2-58 to one kernel activity type of include/layerx/lx_escrow.h:14-20, include/layerx/lx_budget.h:16-26, include/layerx/lx_stream.h:27-33 or include/layerx/lx_service.h:14-26 and to the module id of modules/layerxpay/types/keys.go:10-13, and maps no view method."
ac_2 = "escrowPartialCapture maps to 0x00020003 with the 80-byte capture payload (modules/layerxpay/types/payload_escrow.go:34), escrowTimeout to 0x00020005 with the 64-byte release payload (:43), budgetCreateNative to 0x00030001 with the 251-byte payload (modules/layerxpay/types/payload_budget.go:13) and budgetFundNative to 0x00030002 with the 58-byte payload (:15), as the kernel decoders accept (src/modules/escrow/lx_escrow_module.c:156-163)."

[req.2245]
title = "Decode kernel escrow and budget records for the 0x101B views"
ac_1 = "DecodeEscrowRecord in modules/layerxpay/types/records_escrow.go (planned) accepts exactly LX_ESCROW_RECORD_BYTES = 305 bytes (include/layerx/lx_escrow.h:24) laid out as lx_escrow_record (include/layerx/lx_escrow.h:47), refuses any other length with LXP_NON_CANONICAL, and DecodeEscrowResult accepts the 243-byte and 276-byte result forms (include/layerx/lx_escrow.h:25-27)."
ac_2 = "DecodeBudgetRecord in modules/layerxpay/types/records_budget.go (planned) reads lx_budget_record (include/layerx/lx_budget.h:54-76), LX_BUDGET_RECORD_FIXED_BYTES = 278 plus 32 bytes per delegate up to LX_BUDGET_MAX_DELEGATES = 16 (include/layerx/lx_budget.h:15, :30-32) and refuses truncated input."

[req.2246]
title = "Decode kernel stream records and stream results for the 0x101B views"
ac_1 = "DecodeStreamRecord in modules/layerxpay/types/records_stream.go (planned) accepts exactly LX_STREAM_RECORD_BYTES = 541 bytes (include/layerx/lx_stream.h:17) laid out as lx_stream_record (include/layerx/lx_stream.h:42) and refuses any other length."
ac_2 = "DecodeStreamResult (planned) accepts exactly LX_STREAM_RESULT_BYTES = 99 bytes (include/layerx/lx_stream.h:18) as lx_stream_economic_result (include/layerx/lx_stream.h:69-76) and yields the StreamResult tuple of precompiles/layerxpay/LayerXPay.sol:77."

[req.2247]
title = "Decode kernel service offer, agreement, commitment, delivery, progress, dispute records"
ac_1 = "DecodeServiceOffer, DecodeServiceCommitment, DecodeServiceProgress and DecodeServiceExecution in modules/layerxpay/types/records_service.go (planned) accept exactly 252, 220, 245 and 417 bytes (include/layerx/lx_service.h:55, :59, :68, :62) and refuse other lengths."
ac_2 = "DecodeServiceAgreement and DecodeServiceDispute (planned) accept 247 + 32n and 185 + 32n bytes for n <= LX_SERVICE_MAX_DELIVERABLES = 16 (include/layerx/lx_service.h:56-58, :65-67, :13) and DecodeServiceDelivery accepts 138 bytes plus 73-byte deliverable records (include/layerx/lx_service.h:63-64)."

[req.2248]
title = "Add the layerxpay Params query proto"
ac_1 = "api/layerxpay/query.proto (planned) defines service Query { rpc Params(QueryParamsRequest) returns (QueryParamsResponse) } with GET /paxprotocol/paxchain/layerxpay/params, and QueryParamsResponse carries the Params of api/layerxpay/tx.proto (planned) through a proto round trip."

[req.2249]
title = "Add the layerxpay keeper over the shared lxphost host with a real-host test harness"
ac_1 = "Keeper.SetParams stores the Params of modules/layerxpay/types/params.go:13-19 as JSON under ParamsKey 0x05 (modules/layerxpay/types/keys.go:21) in the layerxpay store and GetParams returns DefaultParams (Paused true, modules/layerxpay/types/params.go:21-23) when nothing is stored."
ac_2 = "NewKeeper (planned) refuses a nil *lxphost.Host, a nil host store key, a nil layerxpay store key and an empty authority, and the harness builds the host with lxphost.NewHost over an IAVL store as modules/lxphost/host_test.go:40-85 does."

[req.2250]
title = "Resolve the kernel authority of an EVM caller from its 0x1004 DID binding"
ac_1 = "AuthorityFor(ctx, caller) in modules/layerxpay/keeper/authority.go (planned) reads the DID public key bound to caller through GetLayerXDid (modules/evm/keeper/layerx_binding.go:18) and returns ActorDID \"did:layerx:<hex key>\", KernelAuthority{Actor: DIDID(did), Principal: DIDID(did), VerifiedKey: key} (modules/lxphost/host.go:568-572, :760) and AuthorityKey = key."
ac_2 = "AuthorityFor returns ErrUnboundCaller in modules/layerxpay/types/errors.go (planned) for an address with no binding, and never derives an authority from the EVM address alone (decision.236)."

[req.2251]
title = "Gate every pay write on module pause, family enable flags and kernel enable records"
ac_1 = "CheckWrite(ctx, method) in modules/layerxpay/keeper/gate.go (planned) calls layerxgov CheckPauseScope(\"layerxpay\", params.Paused, method) (modules/layerxgov/types/proposal.go:38-50) so a paused module refuses escrowOpen with LXP_PAUSED_SCOPE and still admits the nine exit paths of modules/layerxgov/types/proposal.go:29-32."
ac_2 = "CheckWrite refuses a method whose family flag (EscrowEnabled, BudgetEnabled, StreamEnabled, ServiceEnabled of modules/layerxpay/types/params.go:15-18) is false with ErrFamilyDisabled, and refuses with ErrKernelGateMismatch when the flag is true but the kernel module-enable record of KernelModuleEnableKey (modules/layerxpay/types/keys.go:37-60) in the host store is absent or zero."
ac_3 = "CheckWrite admits every view method of precompiles/layerxpay/abi.json:13, :22, :24-37, :51 regardless of Paused and family flags, since MethodActivity (planned) has no row for a view."

[req.2252]
title = "Submit one kernel activity per pay write through HostExecute"
ac_1 = "Submit(ctx, caller, method, payload, idempotencyKey) in modules/layerxpay/keeper/execute.go (planned) builds an lxphost.Activity (modules/lxphost/host.go:555-566) with ProtocolVersion 3, Type from MethodActivity, AccountSequence = identity sequence + 1, NotBefore/NotAfter = block-open ms -/+ TimestampWindowMs, runs HostExecute (modules/lxphost/host.go:678) under WithSequence(last + 1) (modules/lxphost/ctx.go:71) and returns the receipt."
ac_2 = "A nonzero Receipt.ResultCode becomes an error whose registry code is pcommon.LXPCodeName(code) (precompiles/common/lxp_errors.go:320) and no host-store write survives the refused call."
ac_3 = "A second Submit with the same idempotency key returns the stored receipt through ReadIdempotentReceipt (modules/lxphost/read.go:444) instead of executing again."

[req.2253]
title = "Import and export layerxpay genesis with kernel records in the host store"
ac_1 = "InitGenesis in modules/layerxpay/keeper/genesis.go (planned) validates GenesisState (modules/layerxpay/types/params.go:38), sets Params and writes every KernelRecords pair (modules/layerxpay/types/params.go:31) into the host store at its KernelKVKey, and ExportGenesis returns the same params and the records under the 0x01 0x0002..0x0005 and 0x0007 prefixes (modules/layerxpay/types/keys.go:22-27) in key order."
ac_2 = "InitGenesis refuses a genesis whose family flag is set without the kernel enable record or whose record count exceeds MaxKernelRecords 512 (modules/layerxpay/types/keys.go:15) before writing anything."

[req.2254]
title = "Implement escrow open, capture and partial capture in the pay keeper"
ac_1 = "EscrowOpen in modules/layerxpay/keeper/escrow_open.go (planned) encodes the 288-byte payload with EncodeEscrowOpen (modules/layerxpay/types/payload_escrow.go:17) and submits activity 0x00020001 (include/layerx/lx_escrow.h:14); the stored record decodes with status open and lockedAmount equal to the amount."
ac_2 = "EscrowCapture submits 0x00020002 and EscrowPartialCapture submits 0x00020003, both with the 80-byte capture payload of modules/layerxpay/types/payload_escrow.go:34 (decision.222), and a partial capture leaves the escrow open with the remainder locked."

[req.2255]
title = "Implement escrow release, timeout, dispute open and dispute resolve"
ac_1 = "EscrowRelease submits 0x00020004 and EscrowTimeout submits 0x00020005, both with the 64-byte release payload of modules/layerxpay/types/payload_escrow.go:43 (src/modules/escrow/lx_escrow_module.c:160-163); timeout before expiryMs is refused by the kernel."
ac_2 = "EscrowDisputeOpen submits 0x00020006 with the 32-byte payload (modules/layerxpay/types/payload_escrow.go:50) and EscrowDisputeResolve submits 0x00020007 with beneficiaryBps (modules/layerxpay/types/payload_escrow.go:56) from the arbiter, splitting lockedAmount by basis points."

[req.2256]
title = "Serve escrow views from kernel records in the host store"
ac_1 = "GetEscrow, EscrowRemaining and GetEscrowResult in modules/layerxpay/keeper/escrow_views.go (planned) read the host store at KernelKVKey(2, key) (modules/layerxpay/types/keys.go:30) and decode with DecodeEscrowRecord and DecodeEscrowResult (planned); EscrowRemaining equals lockedAmount."
ac_2 = "Every escrow view returns the zero record and found=false for an unknown escrow id without touching the host sequence."

[req.2257]
title = "Implement budget create, create native, fund, fund native and amend"
ac_1 = "BudgetCreate submits 0x00030001 with the 211-byte payload of EncodeBudgetCreate (modules/layerxpay/types/payload_budget.go:35) and BudgetFund submits 0x00030002 with the 50-byte payload (modules/layerxpay/types/payload_budget.go:58); the budget record amount grows by the funded amount."
ac_2 = "BudgetCreateNative and BudgetFundNative reuse activity types 0x00030001 and 0x00030002 with the 251-byte and 58-byte v2 payloads (modules/layerxpay/types/payload_budget.go:44, :65; include/layerx/lx_budget.h:35, :37), and BudgetAmend submits 0x00030003 with the 75-byte payload (modules/layerxpay/types/payload_budget.go:77)."

[req.2258]
title = "Implement budget spend, delegate add, delegate remove and delegate spend"
ac_1 = "BudgetSpend submits 0x00030006 with the 82-byte payload (modules/layerxpay/types/payload_budget.go:99) and the kernel refuses a spend above perPeriodLimit (include/layerx/lx_budget.h:54-76)."
ac_2 = "BudgetDelegateAdd and BudgetDelegateRemove submit 0x00030004 and 0x00030005 with the 66-byte payload (modules/layerxpay/types/payload_budget.go:89), and BudgetDelegateSpend submits 0x0003000a with the idempotency key from DeriveIdempotencyKey (planned) because budgetDelegateSpend (precompiles/layerxpay/abi.json:9) carries none."

[req.2259]
title = "Implement budget pull against a payer grant"
ac_1 = "BudgetPull submits 0x0003000b with EncodeBudgetPull (modules/layerxpay/types/payload_budget.go:133), the 346-byte payer grant (modules/layerxpay/types/payload_budget.go:23) and a derived idempotency key (decision.223), and the grant state read through ReadPayerGrant (modules/lxphost/read.go:412) records the pulled amount."
ac_2 = "BudgetPull refuses a grant that is not exactly PayerGrantBytes 346 with LXP_NON_CANONICAL from the encoder (modules/layerxpay/types/payload_budget.go:30-31) before any host call."

[req.2260]
title = "Implement budget close, defund and revoke"
ac_1 = "BudgetClose submits 0x00030007 with the 42-byte payload of EncodeBudgetClose (modules/layerxpay/types/payload_budget.go:108) and the remaining amount returns to the owner."
ac_2 = "BudgetDefund submits 0x00030008 with the 50-byte payload (modules/layerxpay/types/payload_budget.go:112) and BudgetRevoke submits 0x00030009 with the 42-byte payload (modules/layerxpay/types/payload_budget.go:119); a stale revocation sequence is refused by the kernel."

[req.2261]
title = "Serve getBudget and budgetRemaining from kernel records"
ac_1 = "GetBudget and BudgetRemaining in modules/layerxpay/keeper/budget_views.go (planned) read the 39-byte budget state key (include/layerx/lx_budget.h:33) under KernelKVKey(3, key) and decode with DecodeBudgetRecord (planned); BudgetRemaining is the record amount."

[req.2262]
title = "Implement stream open and top up in the pay keeper"
ac_1 = "StreamOpen submits 0x00040001 with EncodeStreamOpen (modules/layerxpay/types/payload_stream.go:43), 204 bytes plus 32 per meter authority up to 8 (modules/layerxpay/types/payload_stream.go:12-14), funding the stream through the kernel fund leg."
ac_2 = "StreamTopUp submits 0x00040002 with the 50-byte payload of EncodeStreamTopUp (modules/layerxpay/types/payload_stream.go:69)."

[req.2263]
title = "Implement stream meter, settle and close in the pay keeper"
ac_1 = "StreamSettle submits 0x00040004 with the 66-byte keyed payload (modules/layerxpay/types/payload_stream.go:92) and pays the recipient what accrued to the block-open time; the kernel admits payer or recipient (src/modules/stream/lx_stream_execution.h:257)."
ac_2 = "StreamMeter submits 0x00040003 with the 138-byte payload signed by a meter authority (modules/layerxpay/types/payload_stream.go:80), and StreamClose submits 0x00040007, pays the recipient, refunds the payer and is payer-only (src/modules/stream/lx_stream_lifecycle.c:19-20)."

[req.2264]
title = "Implement stream pause, resume and the kernel rate change"
ac_1 = "StreamPause and StreamResume submit 0x00040005 and 0x00040006 with the 34-byte id payload (modules/layerxpay/types/payload_stream.go:102), and no amount accrues between pause and resume."
ac_2 = "StreamRateChange submits 0x00040008 (include/layerx/lx_stream.h:34) with the 82-byte payload of EncodeStreamRateChange (modules/layerxpay/types/payload_stream.go:111), which the kernel settles at the old rate up to block-open time before applying the new rate (decision.237)."

[req.2265]
title = "Serve getStream, getStreamResult and streamAccrued from the kernel"
ac_1 = "StreamAccrued in modules/layerxpay/keeper/stream_views.go (planned) returns (accruedTotal, unsettled) at block-open time through the lxphost accrue reader requested by wiring.J24.4, which runs lx_stream_accrue (src/modules/stream/lx_stream_accrue.c:34) on a copy, and writes nothing."
ac_2 = "GetStream decodes the 541-byte record and GetStreamResult the 99-byte result (include/layerx/lx_stream.h:17-18) from the host store under KernelKVKey(4, key) with the 39-byte stream key (include/layerx/lx_stream.h:16)."

[req.2266]
title = "Expose the 0x0906 agent stream API on the pay keeper"
ac_1 = "OpenAgentStream(ctx, payer, payee, token common.Address, ratePerSecond *big.Int, startTime, stopTime uint64, cap *big.Int) in modules/layerxpay/keeper/stream_agent.go (planned) maps token address(0) to the native asset and any other token through GetAssetByPointer (modules/layerxcustody/keeper/keeper.go:172), converts seconds to ms, derives the stream id with DeriveStreamID (planned) and opens through StreamOpen."
ac_2 = "SettleAgentStream, CloseAgentStream and UpdateAgentStreamRate call StreamSettle, StreamClose and StreamRateChange with derived keys, and AgentStreamView returns (id, payer, payee, token, ratePerSecond, cap, startTime, stopTime, settled, active) in the 0x0906 getStream order (spec/layerx-merge/contracts/agent-functions.md:124)."
ac_3 = "OpenAgentStream refuses a token address with no custody mapping with ErrStreamsUnknownToken (precompiles/layerxagent/common/common.go:56) before any host call."

[req.2267]
title = "Implement service offer publish and withdraw in the pay keeper"
ac_1 = "ServiceOfferPublish submits 0x00050001 with EncodeServiceOffer (modules/layerxpay/types/payload_service.go:31) and ServiceOfferWithdraw submits 0x00050002 with the 34-byte identifier payload (modules/layerxpay/types/payload_service.go:50); a withdrawn offer cannot be withdrawn again."

[req.2268]
title = "Implement service agreement propose, accept, commit and abandon"
ac_1 = "ServiceAgreementPropose submits 0x00050003 with EncodeServicePropose (modules/layerxpay/types/payload_service.go:59) naming an escrow id, and ServiceAgreementAccept submits 0x00050004 from the provider."
ac_2 = "ServiceCommitTask submits 0x00050005 with EncodeServiceCommit (modules/layerxpay/types/payload_service.go:71) and ServiceCommitAbandon submits 0x00050006 with EncodeServiceAbandon (:85)."

[req.2269]
title = "Implement service tool attest, progress, deliver, accept and reject"
ac_1 = "ServiceProgressReport (0x00050008, modules/layerxpay/types/payload_service.go:95), ServiceDeliver (0x00050009, :108) and ServiceAccept (0x0005000a, :50) move the agreement to accepted."
ac_2 = "ServiceReject submits 0x0005000b with contested hashes (modules/layerxpay/types/payload_service.go:133) and ServiceToolExecAttest submits 0x00050007 with the 416-byte execution (modules/layerxpay/types/payload_service.go:14, :181)."

[req.2270]
title = "Implement service dispute open and resolve with the escrow arbiter link"
ac_1 = "ServiceDisputeResolve in modules/layerxpay/keeper/service_dispute.go (planned) loads the agreement's escrow, requires the caller to be its arbiter (LXP_UNAUTHORIZED_ARBITER, precompiles/common/lxp_errors.go:152), requires escrowResolutionID to name that escrow (LXP_ESCROW_LINK_MISMATCH, :153), then submits 0x0005000d and resolves the escrow through EscrowDisputeResolve (decision.240)."
ac_2 = "ServiceDisputeResolve refuses a non-arbiter with LXP_UNAUTHORIZED_ARBITER, an escrow without an arbiter with LXP_ARBITER_REQUIRED (precompiles/common/lxp_errors.go:151) and a mismatched escrow id with LXP_ESCROW_LINK_MISMATCH, each before any host write."

[req.2271]
title = "Serve the nine service views from kernel records"
ac_1 = "GetOffer, GetAgreement, GetCommitment, GetExecution, GetDelivery, GetProgress, GetDispute, LatestDelivery and ProgressHighWater in modules/layerxpay/keeper/service_views.go (planned) read the 40-byte service keys (include/layerx/lx_service.h:52-54) under KernelKVKey(5, key) and decode with the service decoders (planned)."
ac_2 = "Every service view returns a zero record with found=false for an unknown id."

[req.2272]
title = "Serve layerxpay MsgUpdateParams with the governance authority"
ac_1 = "msgServer.UpdateParams in modules/layerxpay/keeper/msg_server.go (planned) refuses an authority other than Keeper.Authority() with sdkerrors.ErrUnauthorized (as modules/layerxcustody/keeper/keeper.go:98 wraps it) and stores the params otherwise."
ac_2 = "UpdateParams refuses enabling a family whose kernel module-enable record (modules/layerxpay/types/keys.go:37-60) is absent with ErrKernelGateMismatch (decision.224)."

[req.2273]
title = "Serve the layerxpay Params gRPC query"
ac_1 = "Querier.Params in modules/layerxpay/keeper/grpc_query.go (planned) returns the stored Params and refuses a nil request with codes.InvalidArgument."

[req.2274]
title = "Add the layerxpay AppModule with genesis, services and no block hooks"
ac_1 = "AppModule in modules/layerxpay/module.go (planned) returns ModuleName layerxpay, DefaultGenesis from modules/layerxpay/types/params.go:34, ValidateGenesis through GenesisState.Validate, runs Keeper.InitGenesis and ExportGenesis, and registers the Msg and Query services, after modules/layerxcustody/module.go:81-137."

[req.2275]
title = "Add the layerxpay params query CLI command"
ac_1 = "GetQueryCmd in modules/layerxpay/client/cli/query.go (planned) adds the command \"layerxpay params\" with no arguments that calls the Params query of api/layerxpay/query.proto (planned) and prints the response."

[req.2276]
title = "Serve 0x101B as a merge precompile with the pay gas table and registry reverts"
ac_1 = "init in precompiles/layerxpay/layerxpay.go (planned) registers NewMergePrecompile for 0x000000000000000000000000000000000000101B through RegisterMergeConstructor (precompiles/setup.go:89), the address the merge table names layerxpay (precompiles/setup.go:63), and NewMergePrecompile refuses keepers that do not implement LayerXPayKeepers."
ac_2 = "The precompile is built with pcommon.NewPrecompile(...).WithLXPReasons().WithGasTable(methodGas) (precompiles/common/precompiles.go:93, :107, :115) so RequiredGas charges the methodGas rows of precompiles/layerxpay/gas.go:18-76 and gas.go RequiredGas (:82) stays the estimator (decision.235)."

[req.2277]
title = "Map pay keeper and kernel errors to 0x101B registry revert strings"
ac_1 = "RevertError in precompiles/layerxpay/errors.go (planned) turns a keeper error carrying a kernel result code into pcommon.LXPRevert(LXPCodeName(code), detail) (precompiles/common/lxp_errors.go:320, :339), so a refused escrowCapture reverts with Error(string) beginning with the kernel registry code."
ac_2 = "RevertError maps ErrUnboundCaller, ErrFamilyDisabled and ErrKernelGateMismatch through PayRevertCode (planned), layerxgov ErrPausedScope to LXP_PAUSED_SCOPE (precompiles/common/lxp_errors.go:149) and the arbiter errors to their rows at precompiles/common/lxp_errors.go:151-153, and never yields LXP_UNKNOWN for these."

[req.2278]
title = "Pack 0x101B event logs from call arguments and post-call records"
ac_1 = "The event table of precompiles/layerxpay/events.go (planned) has one packer per event of precompiles/layerxpay/abi.json:59-96 whose topic 0 is the ABI event id, followed by the record id as the single indexed topic for the 25 escrow, budget, stream and DefaultOutcomeApplied events, and by the indexed primary and secondary ids for the 13 service events (precompiles/layerxpay/LayerXPay.sol:199-211)."
ac_2 = "emitPayEvent writes the log at the 0x101B address through pcommon.EmitEVMLog (precompiles/common/evm_events.go:16), packing values read after the kernel call because lxphost.Receipt carries no effect list (modules/lxphost/host.go:574-581, decision.234)."

[req.2279]
title = "Serve the ten 0x101B escrow methods and seven escrow events"
ac_1 = "escrowOpen, escrowCapture, escrowPartialCapture, escrowRelease, escrowTimeout, escrowDisputeOpen and escrowDisputeResolve (precompiles/layerxpay/abi.json:16-23) call the pay keeper and emit EscrowOpened, EscrowCaptured, EscrowPartiallyCaptured, EscrowReleased, EscrowTimedOut, EscrowDisputed and EscrowResolved (precompiles/layerxpay/LayerXPay.sol:172-178)."
ac_2 = "getEscrow, escrowRemaining and getEscrowResult (precompiles/layerxpay/abi.json:22, :29-30) return the Escrow tuple of precompiles/layerxpay/LayerXPay.sol:19, the locked amount and the encoded result bytes."
ac_3 = "An escrowOpen from an address with no 0x1004 binding reverts with LXP_PAY_UNBOUND_CALLER and emits no log."

[req.2280]
title = "Serve the fifteen 0x101B budget methods and nine budget events"
ac_1 = "budgetCreate, budgetFund, budgetAmend, budgetDelegateAdd, budgetSpend, budgetDelegateRemove, budgetDefund, budgetClose and budgetRevoke (precompiles/layerxpay/abi.json:2-15) call the pay keeper and emit BudgetCreated, BudgetFunded, BudgetAmended, BudgetDelegateAdded, BudgetSpent, BudgetDelegateRemoved, BudgetDefunded, BudgetClosed and BudgetRevoked (precompiles/layerxpay/LayerXPay.sol:180-188)."
ac_2 = "budgetCreateNative, budgetFundNative, budgetDelegateSpend and budgetPull (precompiles/layerxpay/abi.json:5, :9, :11, :12) reach the keeper with derived idempotency keys for the two unkeyed calls, and getBudget and budgetRemaining (:13, :25) return the Budget tuple of precompiles/layerxpay/LayerXPay.sol:34 and the remaining amount."

[req.2281]
title = "Serve the ten 0x101B stream methods and eight stream events"
ac_1 = "streamOpen, streamTopUp, streamMeter, streamSettle, streamPause, streamResume and streamClose (precompiles/layerxpay/abi.json:52-58) call the pay keeper and emit StreamOpened, StreamToppedUp, StreamMetered, StreamSettled, StreamPaused, StreamResumed and StreamClosed (precompiles/layerxpay/LayerXPay.sol:190-196)."
ac_2 = "getStream, getStreamResult and streamAccrued (precompiles/layerxpay/abi.json:34-35, :51) return the Stream tuple of precompiles/layerxpay/LayerXPay.sol:55, the StreamResult of :77 and (accruedTotal, unsettled) at block-open time."
ac_3 = "The 0x101B event table packs StreamRateUpdated(bytes32 indexed streamId, uint128 oldRate, uint128 newRate, uint128 paid) (precompiles/layerxpay/LayerXPay.sol:197) and the pay keeper rate change path logs it at 0x101B, since 0x101B has no rate-change method (decision.237)."

[req.2282]
title = "Serve the thirteen 0x101B service writes and fourteen service events"
ac_1 = "serviceOfferPublish, serviceAgreementPropose, serviceAgreementAccept, serviceCommitTask, serviceProgressReport, serviceDeliver and serviceAccept (precompiles/layerxpay/abi.json:38-48) call the pay keeper and emit OfferPublished, AgreementProposed, AgreementAccepted, TaskCommitted, ProgressReported, Delivered and OutcomeAccepted."
ac_2 = "serviceReject, serviceDisputeOpen and serviceDisputeResolve emit OutcomeRejected, DisputeOpened and DisputeResolved, and serviceDisputeResolve from a non-arbiter reverts with LXP_UNAUTHORIZED_ARBITER (precompiles/common/lxp_errors.go:152)."
ac_3 = "serviceOfferWithdraw, serviceCommitAbandon and serviceToolExecAttest emit OfferWithdrawn, CommitAbandoned and ExecutionAttested, and an accept window that lapses applies the default outcome logged as DefaultOutcomeApplied (precompiles/layerxpay/abi.json:71)."

[req.2283]
title = "Serve the nine 0x101B service views"
ac_1 = "getOffer, getAgreement, getCommitment, getExecution, getDelivery, getProgress, getDispute, latestDelivery and progressHighWater (precompiles/layerxpay/abi.json:24, :26-28, :31-33, :36-37) return the Offer, Agreement, Commitment, Delivery, Progress and Dispute tuples of precompiles/layerxpay/LayerXPay.sol:86-170."
ac_2 = "Service views answer while Params.Paused is true and every family is disabled, since CheckWrite admits views (decision.225)."

[req.2284]
title = "Generate layerxagent Params and MsgUpdateParams from api/layerxagent/tx.proto"
ac_1 = "DefaultParams in modules/layerxagent/types/params.go (planned) returns the six defaults of modules/layerxagent/keeper/keeper.go:37-42 plus MaxCallDataBytes 8192, MaxBlockGas 30000000 and Paused false, and Validate refuses any zero bound and MaxJobGasLimit above MaxBlockGas."
ac_2 = "MsgUpdateParams.ValidateBasic in modules/layerxagent/types/msgs.go (planned) refuses a non-bech32 authority with sdkerrors.ErrInvalidAddress and invalid Params with the Validate error, and RegisterInterfaces registers /paxprotocol.paxchain.layerxagent.MsgUpdateParams."

[req.2285]
title = "Generate layerxagent GenesisState, Job and the Query service"
ac_1 = "GenesisState.Validate in modules/layerxagent/types/genesis.go (planned) refuses a duplicate job id, a job id at or above next_job_id, a zero target, an inactive job, a creator or target that is not a 0x hex address and a deposit that is not a nonnegative integer."
ac_2 = "DefaultGenesis returns DefaultParams (planned), no jobs and next_job_id 1, the first id of modules/layerxagent/keeper/keeper.go:150-157, and round-trips through ModuleCdc JSON."

[req.2286]
title = "Bound scheduled calldata and honour the governance pause in the agent keeper"
ac_1 = "Keeper.Schedule (modules/layerxagent/keeper/keeper.go:265) refuses callData longer than Params.MaxCallDataBytes with ErrSchedulerCallDataTooLarge (planned) right after the target check (:268-270) and before any escrow transfer."
ac_2 = "With Params.Paused true, Schedule and Reschedule fail through layerxgov CheckPauseScope (modules/layerxgov/types/proposal.go:38-50) with ErrPausedScope, and Cancel (modules/layerxagent/keeper/keeper.go:318) still refunds, the layerxagent exit path of wiring.J24.6."
ac_3 = "keeper.Params is an alias of types.Params (planned) and GetParams (modules/layerxagent/keeper/keeper.go:126) decodes params stored at HEAD as JSON with the six names of :48-53, filling the three new fields from DefaultParams."

[req.2287]
title = "Cap end-block job gas with MaxBlockGas and report the gas through RunDue"
ac_1 = "RunDue beside EndBlocker (modules/layerxagent/keeper/scheduler.go:27) admits due jobs in (block, id) order (modules/layerxagent/keeper/keeper.go:218-231) while the sum of admitted GasLimit stays within Params.MaxBlockGas and MaxJobsPerBlock; the first job that would exceed it and every later one stay due for the next height."
ac_2 = "RunDue returns the sum of the gasUsed values that runJob (modules/layerxagent/keeper/scheduler.go:47) charged, the number the end block adds to blockGasUsed (wiring.J24.11)."
ac_3 = "While Params.Paused is true RunDue runs no job and returns 0, the jobs stay due, and EndBlocker (modules/layerxagent/keeper/scheduler.go:27) keeps its contract by returning the error of RunDue."

[req.2288]
title = "Convert stored scheduler jobs to and from the genesis Job message"
ac_1 = "JobToProto and JobFromProto in modules/layerxagent/keeper/job_proto.go (planned) map the keeper Job of modules/layerxagent/keeper/keeper.go:85-94 to types.Job (planned) with checksummed hex addresses and a decimal deposit, and back without loss."
ac_2 = "JobFromProto refuses a creator or target that is not a 20-byte 0x hex string and a deposit that is not a nonnegative integer."

[req.2289]
title = "Import and export layerxagent genesis with escrow coverage"
ac_1 = "InitGenesis in modules/layerxagent/keeper/genesis.go (planned) stores params through SetParams (modules/layerxagent/keeper/keeper.go:138), every job through SetJob (:193) with its due and creator indexes and next_job_id through setNextJobID (:159), and ExportGenesis returns the same state with jobs in id order."
ac_2 = "InitGenesis refuses a state whose summed job deposits exceed the balance of ModuleAddress (modules/layerxagent/keeper/keeper.go:109) and refuses next_job_id at or below a stored job id."

[req.2290]
title = "Serve layerxagent MsgUpdateParams and the Params, Job and Pending queries"
ac_1 = "msgServer.UpdateParams in modules/layerxagent/keeper/msg_server.go (planned) refuses an authority other than the configured governance authority with govtypes.ErrInvalidSigner and stores valid params through SetParams (modules/layerxagent/keeper/keeper.go:138)."
ac_2 = "Querier.Job returns the stored job through JobToProto (planned) or codes.NotFound, and Querier.Pending returns Keeper.Pending (modules/layerxagent/keeper/keeper.go:235) for a 0x creator, refusing a malformed address with codes.InvalidArgument."
ac_3 = "Querier.Params returns GetParams (modules/layerxagent/keeper/keeper.go:126) and refuses a nil request with codes.InvalidArgument."

[req.2291]
title = "Add the layerxagent AppModule with genesis, services and the RunDue end block"
ac_1 = "AppModule in modules/layerxagent/module.go (planned) returns name layerxagent, DefaultGenesis and ValidateGenesis from modules/layerxagent/types/genesis.go (planned), runs Keeper.InitGenesis and ExportGenesis and registers the Msg and Query services, after modules/layerxcustody/module.go:81-137."
ac_2 = "AppModule has no EndBlock method of its own: jobs run only from the legacy end block through Keeper.RunDue (wiring.J24.11), so module-manager ordering cannot run them twice."

[req.2292]
title = "Add the layerxagent params, job and pending query CLI commands"
ac_1 = "GetQueryCmd in modules/layerxagent/client/cli/query.go (planned) adds params (no args), job [id] (one uint64) and pending [creator-0x-address] (one 0x address), each calling the matching rpc of api/layerxagent/query.proto (planned)."

[req.2293]
title = "Serve the 0x0905 scheduler methods and its three EVM logs over the agent keeper"
ac_1 = "schedule (0x849ba0a3) in precompiles/layerxagent/scheduler/scheduler.go (planned) moves msg.value into the precompile through HandlePaymentUhpxWei (precompiles/common/precompiles.go:405), calls Keeper.Schedule (modules/layerxagent/keeper/keeper.go:265) with the precompile account as payer and msg.sender as creator, returns the job id and emits JobScheduled(jobId, creator, target, executeAtBlock, gasLimit, deposit) through pcommon.EmitEVMLog (precompiles/common/evm_events.go:16)."
ac_2 = "cancel (0x40e58ee5) and reschedule (0x08e6f770) call Keeper.Cancel and Keeper.Reschedule (modules/layerxagent/keeper/keeper.go:318, :331) for msg.sender, refuse a jobId above u64 with LXP_AGENT_ABI_DECODE and emit JobCancelled(jobId, creator, refund) and JobRescheduled(jobId, newBlock)."
ac_3 = "getJob (0xbf22c457) returns (id, creator, target, callData, executeAtBlock, gasLimit, deposit, active) from GetJob (modules/layerxagent/keeper/keeper.go:179) with a zero tuple when absent, and pending (0x5eebea20) returns Keeper.Pending (:235)."
ac_4 = "Every write refuses delegatecall and staticcall through GuardWrite (precompiles/layerxagent/common/common.go:68), cancel and reschedule refuse value through ValidateNonPayable (:114), and a paused module reverts schedule with LXP_PAUSED_SCOPE (modules/layerxgov/types/proposal.go:26)."

[req.2294]
title = "Register the 0x0905 merge constructor and publish job outcomes as typed events"
ac_1 = "init in precompiles/layerxagent/scheduler/merge.go (planned) registers NewMergePrecompile for 0x0905 through RegisterMergeConstructor (precompiles/setup.go:89), and NewMergePrecompile refuses keepers that do not implement LayerXAgentKeepers with LXP_PRECOMPILE_NO_CONTEXT, after precompiles/layerxagent/teeattestor/teeattestor.go:103-128."
ac_2 = "A job scheduled through 0x0905 and run by RunDue (planned) reports JobExecuted or JobFailed as the typed events EventJobExecuted and EventJobFailed (modules/layerxagent/keeper/scheduler.go:68, :75), never as an EVM log, because no receipt exists at end block."

[req.2295]
title = "Serve the 0x0906 stream methods over the pay keeper agent stream API"
ac_1 = "open (0x93e5b08b) in precompiles/layerxagent/streams/streams.go (planned) calls OpenAgentStream in modules/layerxpay/keeper/stream_agent.go (planned) for msg.sender, returns the stream id as uint256 and emits StreamOpened(streamId, payer, payee, token, ratePerSecond, cap) at 0x0906, holding no stream store of its own."
ac_2 = "settle (0x8df82800) is accepted from payer or recipient and close (0x0aebeb4e) from the payer only, the kernel rule of src/modules/stream/lx_stream_execution.h:257-259 and src/modules/stream/lx_stream_lifecycle.c:19-20 (decision.238), each emitting StreamSettled(committed = paid) or StreamClosed(finalPaid, refund)."
ac_3 = "updateRate (0x405abb41) is payer only, calls UpdateAgentStreamRate (planned), emits StreamRateUpdated(streamId, oldRate, newRate) at 0x0906 and the 0x101B StreamRateUpdated topic through EmitStreamRateUpdated in precompiles/layerxpay/stream.go (planned) (decision.237)."
ac_4 = "accrued (0xf52981f4) and getStream (0x894e9a0d) return the pay keeper values in the order of spec/layerx-merge/contracts/agent-functions.md:123-124 and zero when absent, and writes refuse delegatecall, staticcall and value through GuardWrite and ValidateNonPayable (precompiles/layerxagent/common/common.go:68, :114)."

