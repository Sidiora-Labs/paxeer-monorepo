ac_7 = "MsgUpdateParams.ValidateBasic in modules/perps/types/msgs.go (planned) refuses a non-bech32 authority and a Params that fails Validate (modules/perps/types/params.go:166) with ErrInvalidParams (modules/perps/types/errors.go:14) and accepts DefaultParams with the gov authority."
ac_8 = "MsgSetMarket.ValidateBasic refuses a Market that fails Validate (modules/perps/types/market.go:37), MsgSetPaused.ValidateBasic refuses a bad authority, and GetSigners of all three Msgs returns the authority account."
ac_9 = "RegisterInterfaces in modules/perps/types/codec.go (planned) registers MsgUpdateParams, MsgSetMarket and MsgSetPaused as sdk.Msg so InterfaceRegistry.Resolve returns each by type url."
ac_10 = "RegisterLegacyAminoCodec in modules/perps/types/codec.go (planned) names the Msgs perps/MsgUpdateParams, perps/MsgSetMarket and perps/MsgSetPaused in amino JSON, in the pattern of modules/pricefeed/types/codec.go:11."
ac_11 = "Keeper.SetPaused added to modules/perps/keeper/pause.go:19-28 refuses any authority other than the keeper authority (modules/perps/keeper/keeper.go:26) with ErrUnauthorized (modules/perps/types/errors.go:47)."
ac_12 = "SetPaused writes only Params.Paused (modules/perps/types/params.go:90) and leaves every other field of the stored Params byte-identical in JSON."
ac_13 = "UpdateParams of NewMsgServerImpl in modules/perps/keeper/msg_server.go (planned) writes msg.Params through Keeper.UpdateParams (modules/perps/keeper/keeper.go:87) and emits the event perps_params_updated with attribute authority."
ac_14 = "UpdateParams refuses a Params whose CollateralToken (modules/perps/types/params.go:55) differs from the stored token with ErrInvalidParams (modules/perps/types/errors.go:14) and writes nothing."
ac_15 = "UpdateParams with an authority other than the gov module account fails with ErrUnauthorized (modules/perps/types/errors.go:47) as checked by Keeper.UpdateParams (modules/perps/keeper/keeper.go:87)."
ac_16 = "SetMarket of the perps msg server in modules/perps/keeper/msg_server_market.go (planned) stores a market whose id and OracleSymbol match a listed pricefeed market through Keeper.SetMarket (modules/perps/keeper/keeper.go:114) and emits perps_market_set with market_id and enabled."
ac_17 = "SetMarket refuses with ErrUnknownMarket (modules/perps/types/errors.go:15) a market whose id is unlisted in pricefeed or whose OracleSymbol differs from the pricefeed Symbol, a check Keeper.SetMarket (modules/perps/keeper/keeper.go:114) does not make."
ac_18 = "SetMarket refuses a change of Symbol, OracleSymbol, SzDecimals or PxDecimals of a stored market (modules/perps/types/market.go:19-33) with ErrInvalidParams (modules/perps/types/errors.go:14) and accepts a change of MaxLeverage and Enabled."
ac_19 = "After MsgSetPaused{Paused: true} served by modules/perps/keeper/msg_server_pause.go (planned), PlaceOrder (modules/perps/keeper/orders.go:58) refuses a non-reduce-only order with ErrPaused at modules/perps/keeper/orders.go:63-64 and CheckPause (modules/perps/keeper/pause.go:24) refuses openPosition."
ac_20 = "SetPaused of the msg server emits perps_pause_set with attribute paused and leaves the store unchanged when the value already holds."

[req.3002]
title = "Perps and pricefeed coupling: market identity and symbol agree between the venue and the price source"
ac_1 = "Keeper.MarketSymbol added to modules/pricefeed/keeper/price.go returns the Symbol and Enabled flag of the listed market of Params.Markets (modules/pricefeed/types/params.go:31) for ids 0 to 17 of the market table at modules/pricefeed/types/market.go:32-51."
ac_2 = "MarketSymbol of an unlisted id returns ErrUnknownMarket (modules/pricefeed/types/errors.go:19), the same refusal GetPrice (modules/pricefeed/keeper/price.go:22) gives."
