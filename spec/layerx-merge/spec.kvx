[task.9.23.7]
title = "Finalize AI market snapshots and journal records on block commits instead of checkpoints"
status = "done"
mode = "BUILD"
wave = 3
requires = ["9.31.3", "13.29.1"]
reqs = ["9267.1", "9267.2", "9267.3"]
capabilities = ["9.23.7"]
interfaces = ["interface.9.rs-client-ai-market-checkpointfinality-j44", "interface.9.rs-client-ai-market-observedsnapshot-j44", "interface.9.rs-client-ai-market-finalizedsnapshot-j44", "interface.9.rs-client-ai-market-commitfinality-j44"]
do_1 = "CheckpointFinality (services/agent/crates/layerx-client/src/ai_market.rs:148) is verified from a guarantor certificate through verify_declared_certificate (services/agent/crates/layerx-client/src/ai_market.rs:40), which task 9.27.4 deletes, and ObservedSnapshot::finalize (services/agent/crates/layerx-client/src/ai_market.rs:288) fills a checkpoint FinalityEvidence; task 9.96.2 (wave 5) then encodes SnapshotBinding v2 at services/agent/crates/layerx-client/src/ai_market.rs:303 from block commit facts."
do_2 = "Replace CheckpointFinality with `pub struct CommitFinality` built by `CommitFinality::new(block_height, block_hash, app_hash, store_proof_digest)`, refusing a zero block_hash or app_hash with QueryError::FinalityUnavailable; the four facts are the fields of FinalityEvidence as task 13.29.1 left them (services/agent/crates/layerx-client/src/evidence.rs: block_height, block_hash, app_hash, store_proof_digest); task 9.23.5 later reads them through rpc::evidence."
do_3 = "Change ObservedSnapshot::finalize to take `Option<&CommitFinality>`, refuse a commit whose block_height is below the observed height with QueryError::BindingMismatch, and keep the commit on FinalizedSnapshot through `pub fn commit(&self) -> &CommitFinality` in place of the checkpoint evidence beside settlement (services/agent/crates/layerx-client/src/ai_market.rs:302), which task 9.96.2 encodes."
do_4 = "Change OperationJournal::finalize (services/agent/crates/layerx-client/src/ai_market.rs:1685) to take `&CommitFinality`, require the record's receipt height to be at or below block_height and store the block hash where the checkpoint id was stored."
do_5 = "Drop the layerx_proof::checkpoint import (services/agent/crates/layerx-client/src/ai_market.rs:40); the operation signing path keeps sign_disclosed over the canonical activity bytes until task 9.23.6 submits operations through rpc::submit::submit_signed and signs them with sign_disclosed_call."
do_6 = "Create services/agent/crates/layerx-client/tests/ai_market_commit.rs (planned)."
do_7 = "Update services/agent/crates/layerx-client/tests/ai_market_client.rs, which the build compiles with --tests, to the shapes on main and in this task: import CommitFinality in place of CheckpointFinality (:16), drop the batch_id field from the ReadProof literal (:325; removed by 13.29.1), replace the binding.checkpoint and binding.settlement assertions (:659-660; fields removed by 13.29.1) with assertions on the block commit facts SnapshotBinding now carries, and assert the stored block hash where record.checkpoint() was compared with finality.checkpoint() (:1144); keep every other case as written."
symbols = ["CommitFinality", "ObservedSnapshot::finalize", "OperationJournal::finalize", "finalize_keeps_the_block_commit", "finalize_refuses_a_zero_app_hash_or_an_older_commit", "journal_finalize_records_the_block_hash"]
touches = ["services/agent/crates/layerx-client/src/ai_market.rs", "services/agent/crates/layerx-client/tests/ai_market_commit.rs", "services/agent/crates/layerx-client/tests/ai_market_client.rs"]
