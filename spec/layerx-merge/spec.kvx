[req.15252]
title = "Declare the Autobahn RPC sentinel errors in coretypes"
ac_1 = "ErrCommitNotAvailable, ErrConsensusStateNotAvailable and ErrEvidenceNotAccepted are distinct sentinels whose messages contain neither \"height is not available\" nor the chain-head message, so the light provider string match at consensus/light/provider/http/http.go:306-311 cannot mistake them for a missing block."

[req.15253]
title = "Return ErrCommitNotAvailable from the commit route under Autobahn"
ac_1 = "Under Autobahn the commit route answers ErrCommitNotAvailable for every height; at HEAD Commit at consensus/internal/rpc/core/blocks.go:216-218 validates against the unfed BlockStore and answers ErrHeightExceedsChainHead, which the light provider maps to ErrHeightTooHigh and retries."

[req.15254]
title = "Build tx proofs from the Autobahn block when tx is called with prove"
ac_1 = "tx with prove under Autobahn returns a TxProof built from the finalized Autobahn block; at HEAD consensus/internal/rpc/core/tx.go:34-35 dereferences the nil block of the unfed BlockStore and panics."
ac_2 = "tx with prove on the classic path answers ErrHeightNotAvailable when the block of an indexed tx is absent from the BlockStore."

[req.15255]
title = "Build tx_search proofs from the Autobahn block"
ac_1 = "tx_search with prove under Autobahn returns a TxProof for every result; at HEAD consensus/internal/rpc/core/tx.go:112-113 dereferences the nil block of the unfed BlockStore."

[req.15256]
title = "Report latest block hash and time in status under Autobahn"
ac_1 = "Under Autobahn status reports the latest block hash and time of the executed block; at HEAD consensus/internal/rpc/core/status.go:84-97 sets only the height and app hash."

[req.15257]
title = "Report the earliest retained Autobahn block in status"
ac_1 = "Under Autobahn status reports the earliest retained Autobahn block; at HEAD the earliest fields come from BlockStore.LoadBaseMeta at consensus/internal/rpc/core/status.go:49-54, which is empty under Autobahn."

[req.15258]
title = "Compute lag_status from Autobahn executed and committed heights"
ac_1 = "Under Autobahn lag_status reports the executed height, the committed height and their gap; at HEAD consensus/internal/rpc/core/lag_status.go:11 reads the unfed BlockStore height and always answers 0."

[req.15259]
title = "Serve consensus_params from the genesis document under Autobahn"
ac_1 = "Under Autobahn consensus_params answers the genesis consensus parameters; at HEAD consensus/internal/rpc/core/consensus.go:167 reads StateStore.LoadConsensusParams, which Autobahn never writes."

[req.15260]
title = "Refuse dump_consensus_state and consensus_state under Autobahn"
ac_1 = "Under Autobahn dump_consensus_state answers ErrConsensusStateNotAvailable; at HEAD DumpConsensusState at consensus/internal/rpc/core/consensus.go:92 reads the CometBFT round state that Autobahn does not run."
ac_2 = "Under Autobahn consensus_state answers ErrConsensusStateNotAvailable; at HEAD GetConsensusState at consensus/internal/rpc/core/consensus.go:146 reads the CometBFT round state."

[req.15261]
title = "Refuse broadcast_evidence under Autobahn"
ac_1 = "Under Autobahn broadcast_evidence answers ErrEvidenceNotAccepted; at HEAD consensus/internal/rpc/core/evidence.go:12-27 hands the evidence to the CometBFT evidence pool, which Autobahn consensus never reads."

[req.15262]
title = "Serve header from the Autobahn block"
ac_1 = "Under Autobahn header answers the header of the finalized Autobahn block; at HEAD Header at consensus/internal/rpc/core/blocks.go:188-201 reads only the unfed BlockStore."

[req.15263]
title = "Serve header_by_hash from the Autobahn block"
ac_1 = "Under Autobahn header_by_hash answers the header of the finalized Autobahn block with that hash; at HEAD HeaderByHash at consensus/internal/rpc/core/blocks.go:204-213 reads only the unfed BlockStore."

[req.15264]
title = "Serve blockchain from Autobahn blocks"
ac_1 = "Under Autobahn blockchain lists the metas of the finalized Autobahn blocks; at HEAD BlockchainInfo at consensus/internal/rpc/core/blocks.go:28-53 reads only the unfed BlockStore and answers an empty list."

[req.15265]
title = "Pass the Autobahn lower bound to height validation"
ac_1 = "Under Autobahn height validation rejects heights below the retained range with the lowest retained height in the message; at HEAD autobahnCheckAndGetHeight at consensus/internal/rpc/core/blocks.go:147-152 validates against BlockStore.Base(), always 0 under Autobahn."

[req.15266]
