title = "Write the sandbox profile manifest for the eleven task profiles"
status = "done"
mode = "BUILD"
wave = 0
requires = ["17.0.1"]
reqs = ["17007.1", "17007.2"]
capabilities = ["17.6.1"]
interfaces = ["interface.17.fmt-sandbox-profiles-j60"]
do_1 = "Create spec/layerx-merge/programme/data/sandbox-profiles.kvx (planned) with one [profile.<name>] for go, go-cgo, rust, node, elixir, solidity, python, jvm, dotnet, swift and mixed, each with toolchains, network and prebuild keys."
