[task.9.1.6]
title = "Port layerx-mirror to the rung and height read types"
status = "done"
mode = "BUILD"
wave = 4
requires = ["9.1.1", "9.1.2", "9.23.7"]
reqs = ["9005.1", "9005.2", "9005.3", "9005.4", "9006.1", "9006.2", "9006.3"]
capabilities = ["9.1.6"]
interfaces = ["interface.9.http-rpc-project", "interface.9.rs-agent-api-read-relativeto", "interface.9.rs-agent-api-read-freshness", "interface.9.rs-agent-api-read-verifiedread", "interface.9.rs-agent-api-read-readrequest", "interface.9.rs-agent-api-read-modulestateselector", "interface.9.rs-agent-api-read-historyselector", "interface.9.rs-agent-api-read-balancevalue", "interface.9.rs-agent-api-read-historyvalue", "interface.9.rs-agent-api-read-checkpointvalue", "interface.9.rs-agent-api-read-proofbundle", "interface.9.rs-agent-api-read-offlineexport", "interface.9.rs-agent-api-read-feeprojection", "interface.9.proto-agent-api-read-type-verifiedread", "interface.9.proto-agent-api-read-type-freshness", "interface.9.proto-agent-api-read-type-proofbundle", "interface.9.proto-agent-api-read-type-feeprojection", "interface.9.err-rs-layerx-agent-api-error-class-idempotency-conflict", "interface.9.rs-agent-api-identity-protocolbudgetview", "interface.9.rs-agent-api-stream-receiptreference", "interface.9.rs-agent-api-protocolbudgetview-from-proven-j70"]
do_1 = "services/interop/crates/layerx-mirror/src/node.rs builds Freshness from the node report as { chain_head: the report's head sequence as u64, value_height: report.last_sequence(), relative_to: RelativeTo::Block { height, hash: the advertised block hash } }, and VerifiedRead carries achieved_rung: Rung::Committed where it carried Level::StateProven."
do_2 = "services/interop/crates/layerx-mirror/src/node.rs builds CheckpointValue as { commit: the certificate bytes, validator_set: verified.context_bytes(), height } in place of the certificate and sequence fields."
