ac_2 = "From the merge plan height the pause check of FulfilProgram (modules/xweb/keeper/program_fulfil.go:118-120) still applies first among the remaining checks, so a paused module refuses origin-2 answers with LXP_XWEB_PAUSED."

[req.6733]
