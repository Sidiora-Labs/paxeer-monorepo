[req.15267]
title = "Answer block_search results from Autobahn blocks"
ac_1 = "Under Autobahn block_search returns the matching finalized Autobahn blocks; at HEAD consensus/internal/rpc/core/blocks.go:354 loads from the unfed BlockStore and returns an empty Blocks list with a non-zero TotalCount."

[req.15268]
