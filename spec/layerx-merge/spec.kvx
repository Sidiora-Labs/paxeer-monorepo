ac_2 = "For a bound address Actor returns the DID key, the DID id derived by lxphost.DIDID of did:layerx:<hex key> and a KernelAuthority (modules/lxphost/host.go:568) whose Actor and Principal are the DID id and whose VerifiedKey is the bound key, with the binding flag requested from lxphost so the kernel skips the envelope signature."

[req.2019]
title = "A paused ledger refuses writes except revokeGrant while views answer"
ac_1 = "checkPause in modules/layerxledger/keeper/pause.go (planned) calls CheckPauseScope(\"layerxledger\", params.Paused, method) (modules/layerxgov/types/proposal.go:38) before every write and returns ErrPausedScope code 735 (modules/layerxgov/types/proposal.go:26) for register, pause, unpause, openAccount, send, draw, payExact, issueGrant, mint and burn when Paused is true."
ac_2 = "With Paused true revokeGrant passes the check because the ledger exit set at modules/layerxgov/types/proposal.go:34 gains revokeGrant through wiring J23.17, and views never call checkPause."

[req.2020]
title = "Ledger activities run through HostExecute with a fresh global sequence and kernel idempotency"
ac_1 = "execute in modules/layerxledger/keeper/execute.go (planned) builds an lxphost.Activity (modules/lxphost/host.go:555) from the Actor, sets ctx.WithSequence (modules/lxphost/ctx.go:71) to the host NextSequence export requested by wiring J23.1 against modules/lxphost/ctx.go:111, calls Host.Execute (modules/lxphost/host.go:669) and maps a nonzero receipt code with FromKernel."
ac_2 = "A second execute with the same actor and idempotency key returns ErrIdempotentReplay (modules/layerxledger/types/errors.go:19) and the stored receipt that ReadIdempotentReceipt (modules/lxphost/read.go:444) returns equals the first receipt."

[req.2021]
title = "Bank balances under layerx denoms track kernel balances"
ac_1 = "Mirror in modules/layerxledger/keeper/mirror.go (planned) mints, for a register receipt, the supply cap (or 2^128-1 for an unbounded asset) of MirrorDenom to BankAddress (modules/lxphost/accountmap.go:78) of IssuanceAccountID (modules/lxphost/accountmap.go:64) through the layerxledger module account."
ac_2 = "For each transfer leg of the receipt (receipt Transfers requested by wiring J23.2 against modules/lxphost/host.go:574) Mirror calls bank SendCoins from BankAddress of the source kernel account to BankAddress of the destination, and a bank failure is returned as ErrFatalSupplyMismatch (modules/layerxledger/types/errors.go:30)."

[req.2022]
title = "Ledger receipts decode into typed events for the precompile logs"
ac_1 = "LedgerEvents in modules/layerxledger/keeper/events.go (planned) returns AssetRegistered, AssetPaused, AssetUnpaused, AccountOpened, Transfer, PayerGrantIssued, PayerGrantRevoked, PaymentDrawn and PaymentExact for the activity types of include/layerx/lx_asset.h:21-31 and the receipt Events requested by wiring J23.2 against modules/lxphost/host.go:574, and refuses an unknown activity type with ErrNonCanonical."

[req.2023]
title = "Assets register, pause and unpause through the kernel asset module"
ac_1 = "RegisterAsset encodes RegisterArgs with EncodeRegisterPayload, executes LX_ASSET_REGISTER (include/layerx/lx_asset.h:21) and the asset becomes readable through ReadAsset (modules/lxphost/read.go:292) with the issuer as the actor DID."
ac_2 = "A second RegisterAsset for the same asset id returns ErrAssetAlreadyRegistered (modules/layerxledger/types/errors.go:27)."
ac_3 = "PauseAsset and UnpauseAsset execute LX_ASSET_PAUSE and LX_ASSET_UNPAUSE (include/layerx/lx_asset.h:22-23) with EncodePausePayload and only the issuer may call them; another DID gets ErrUnauthorizedDebit."

[req.2024]
title = "Issuers mint within the cap and holders burn their units"
ac_1 = "Mint encodes EncodeSupplyPayload and executes LX_ASSET_MINT (include/layerx/lx_asset.h:30); minting above the supply cap returns the kernel refusal mapped by FromKernel and ReadTotalUnits (modules/lxphost/read.go:341) is unchanged."
ac_2 = "Burn executes LX_ASSET_BURN (include/layerx/lx_asset.h:31) and reduces ReadBalance (modules/lxphost/read.go:325) and ReadTotalUnits; burning more than the balance returns ErrInsufficientBalance (modules/layerxledger/types/errors.go:23)."

[req.2025]
title = "Holders open an asset account whose id is derived from their DID"
ac_1 = "OpenAccount executes LX_ASSET_ACCOUNT_OPEN (include/layerx/lx_asset.h:24) with EncodeOpenAccountPayload, and AccountID returns the id of AssetAccountID (modules/lxphost/accountmap.go:53) whose owner ReadAccountOwner (modules/lxphost/read.go:357) reports as the DID."
ac_2 = "OpenAccount on a kernel-paused asset returns ErrAssetPaused (modules/layerxledger/types/errors.go:26)."

[req.2026]
title = "Holders send units with the canonical send envelope"
ac_1 = "Send checks the envelope with ValidateSendEnvelope (modules/layerxledger/types/msgs.go:120), requires its from field to be the actor main account, executes LX_ASSET_SEND (include/layerx/lx_asset.h:25) and moves the amount between ReadBalance values, with Mirror moving the bank coins."
ac_2 = "Send refuses an envelope whose from is not the actor account with ErrUnauthorizedDebit, an expired envelope with ErrExpired and a zero amount with ErrZeroAmount (modules/layerxledger/types/errors.go:16, :20, :24)."

[req.2027]
title = "payExact moves an exact amount bound to a derived context hash"
ac_1 = "PayExact takes from, to, asset, amount, expiresAt and paymentReference (spec/layerx-merge/contracts/ledger-auth.md:63), uses paymentReference as the send idempotency key, derives the context hash as the send context over from, to, asset, amount and idempotency key (src/modules/asset/lx_asset_registry.c:101-115), executes LX_ASSET_SEND and returns a PaymentExact event."
ac_2 = "PayExact with expiresAt not after the block time returns ErrExpired (modules/layerxledger/types/errors.go:20) and moves nothing."

[req.2028]
title = "Payers issue and revoke draw grants"
ac_1 = "IssueGrant checks the 346-byte grant with ValidateIssueGrantPayload, executes LX_ASSET_GRANT_ISSUE (include/layerx/lx_asset.h:27) and ReadPayerGrant (modules/lxphost/read.go:412) returns the grant as live."
ac_2 = "RevokeGrant executes LX_ASSET_GRANT_REVOKE (include/layerx/lx_asset.h:28) with EncodeRevokeGrantPayload and a later draw on that grant fails with the kernel revocation code passed through by FromKernel."

[req.2029]
title = "Payees draw from a payer grant within its limits"
ac_1 = "Draw builds the receive payload with EncodeReceivePayload from the seven typed arguments of the stale draw row (spec/layerx-merge/contracts/ledger-auth.md:62), executes LX_ASSET_RECEIVE (include/layerx/lx_asset.h:26) and the grant remaining amount drops by the drawn amount."
ac_2 = "Draw naming an unknown grant id returns ErrNoPayerGrant (modules/layerxledger/types/errors.go:18)."

[req.2030]
