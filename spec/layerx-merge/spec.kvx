[contract_context.6.xweb-origin-two-j37]
interface = "xweb precompile 0x1019 fulfilProgram(bytes), getProgramResult(bytes32,uint64) and getKernelNetworkId() (precompiles/xweb/abi.json), keeper RequestFromProgram, FulfilProgram, GetProgramResult and ProgramOriginActive"
storage = "xweb store: web/pending||programId||requestId -> 123-byte record, web/answer||programId||requestId||part -> 40-byte header or 1024-byte chunk, web/feedenom||asset -> denom, the pending and committed counters (modules/xweb/keeper/keeper.go:52-53); all carried in GenesisState"
errors = "LXP_MODULE_DISABLED below the merge plan; LXP_XWEB_PAUSED; LXP_NON_CANONICAL, LXP_WRONG_NETWORK, LXP_UNKNOWN_FIELD, LXP_SEQUENCE_REUSED, LXP_ARENA_EXHAUSTED, LXP_CONTEXT_MISMATCH, LXP_ATTESTATION_THRESHOLD, LXP_UNSORTED_SEQUENCE, LXP_AUTH_DUPLICATE_SIGNER, LXP_BAD_SIGNATURE, LXP_INVALID_ATTESTATION, LXP_ASSET_MISMATCH; LXP_XWEB_STATICCALL for a static fulfilProgram"
events = "None: fulfilProgram emits no EVM log and no xweb event; the guest request event is the request record"
gas = "fulfilProgram 30000 + 16 per input byte + 8000 per observation signature (16 when unreadable); getProgramResult and getKernelNetworkId 3000 + 16 per input byte; charged at every height"
activation = "From the v7.0 merge plan height through IsUpgradeActiveAtHeight; below it every origin-2 path refuses with LXP_MODULE_DISABLED"
invariants = "Pending counter equals unfulfilled records and is at most 256; committed counter equals fulfilled records and answer headers and is at most 64; each fulfilled asset has one fee denom"
pause = "The module pause refuses RequestFromProgram and FulfilProgram after the activation check; views stay readable"
interfaces = ["interface.6.pc-0x1019-fulfilprogram", "interface.6.pc-0x1019-getprogramresult", "interface.6.pc-0x1019-getkernelnetworkid", "interface.6.go-xweb-keeper-requestfromprogram-j37", "interface.6.go-xweb-keeper-fulfilprogram-j37", "interface.6.go-xweb-keeper-getprogramresult-j37", "interface.6.go-xweb-keeper-programoriginactive-j37", "interface.6.key-xweb-program-pending-j37", "interface.6.key-xweb-program-answer-j37", "interface.6.key-xweb-program-feedenom-j37", "interface.6.gen-xweb-program-pending-j37", "interface.6.gen-xweb-program-counters-j37", "interface.6.gen-xweb-program-answers-j37", "interface.6.gen-xweb-program-feedenoms-j37", "interface.6.go-pxweb-fulfilprogrammethod-j37", "interface.6.go-pxweb-getkernelnetworkidmethod-j37", "interface.6.go-pxweb-getprogramresultmethod-j37", "interface.6.go-pxweb-programfulfilgas-j37", "interface.6.go-xweb-appmodule-j37", "interface.6.go-xweb-appmodulebasic-j37", "interface.6.go-xweb-cli-getquerycmd-j37", "interface.6.go-xweb-keeper-errprogrammoduledisabled-j37", "interface.6.go-xweb-keeper-exportgenesis-j37", "interface.6.go-xweb-keeper-initgenesis-j37", "interface.6.go-xweb-keeper-programanswerentries-j37", "interface.6.go-xweb-keeper-programcountersinvariant-j37", "interface.6.go-xweb-keeper-programfeedenom-j37", "interface.6.go-xweb-keeper-programfeedenomentries-j37", "interface.6.go-xweb-keeper-programfeedenomkey-j37", "interface.6.go-xweb-keeper-programpendingentries-j37", "interface.6.go-xweb-keeper-programresult-j37", "interface.6.go-xweb-types-genesisstate-j37", "interface.6.go-xweb-types-programanswerentry-j37", "interface.6.go-xweb-types-programfeedenomentry-j37", "interface.6.go-xweb-types-programpendingentry-j37", "interface.6.go-xweb-types-upgradereader-j37"]

