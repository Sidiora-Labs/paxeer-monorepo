ac_1 = "splitProgramFee (modules/xweb/keeper/program_fulfil.go:192) pays the attestors in the denom recorded for the request's asset, with equal floor shares and the remainder to the lowest signer."
ac_2 = "A deposit of another mapped denom into a fee account changes neither the outcome nor the denom of the split, which balance probing at modules/xweb/keeper/program_fulfil.go:233-248 made ambiguous."
ac_3 = "A pending record whose asset has no recorded denom is refused with LXP_ASSET_MISMATCH inside the cached context, so no answer part, counter or balance changes."

[req.6757]
