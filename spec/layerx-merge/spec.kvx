ac_1 = "After wave 2 the launchpad Msg service has exactly UpdateParams and TreasuryWithdraw (api/launchpad/tx.proto:5-8), the Query service exactly the 17 rpcs of api/launchpad/query.proto (planned), ConsensusVersion is 1 (modules/launchpad/module.go:128) and GetTxCmd is nil (modules/launchpad/module.go:77)."

[req.4047]
title = "Expose the launchpad query commands and prove the Query service on a live domain"
ac_1 = "GetQueryCmd in modules/launchpad/client/cli/query.go (planned) returns a launchpad command whose subcommands are the 17 commands of the wave 2 CLI files, and AppModuleBasic.GetQueryCmd (modules/launchpad/module.go:79) returns it instead of nil."
ac_2 = "On the launchpadtest domain of modules/launchpad/launchpadtest/domain_test.go:146, a market created through the Router surface createMarket call is served by Query/Market, Query/MarketByAddress, Query/PoolMetadata and Query/FeeRight of keeper.NewQuerier with the pool, token and fee-right id createMarket returned."

[req.4048]
title = "Report native surfaces as healthy identities in the production health check"
ac_1 = "The code probe of inspectHealth at contracts/launchpad/scripts/lib/production-health.js:50-63 reports an address whose code isNativeSurface accepts as identity ok with nativeSurface true and proxy ok with administration through MsgUpdateParams, instead of critical identity and EIP-1967 proxy drift."

[req.4049]
title = "Refuse UUPS upgrade preflight against native surfaces"
ac_1 = "upgradePreflight (contracts/launchpad/scripts/lib/upgrade-preflight.js:7) refuses a plan item whose proxy holds the native surface runtime through assertNotNativeSurface of contracts/launchpad/scripts/lib/native-surface.js (planned), with an error naming the proxy key and MsgUpdateParams, before the EIP-1967 slot read at contracts/launchpad/scripts/lib/upgrade-preflight.js:30-31."

[req.4050]
title = "Route the creation fee change through MsgUpdateParams on native surfaces"
ac_1 = "planCreationFee({ code, params, fee, authority }) exported by contracts/launchpad/scripts/set-creation-fee.js returns { kind: \"contract\" } for ordinary ProtocolConfig code and, for code isNativeSurface accepts, { kind: \"governance\", msg } with msg a /paxprotocol.paxchain.launchpad.MsgUpdateParams body (api/launchpad/tx.proto:27-33) carrying authority, the given params with creation_fee set to fee and empty role_grants and role_revokes, instead of the setCreationFee send at contracts/launchpad/scripts/set-creation-fee.js:48."

[req.4051]
title = "Retire the launchpad bank balance-change hook and holding history"
ac_1 = "The current keeper declares no BeforeBalanceChange (modules/launchpad/keeper/history.go:110), HoldingCheckpointCount (modules/launchpad/keeper/history.go:56) or holding-history helpers (modules/launchpad/keeper/history.go:28-77), node/app.go:839-840 registers no launchpad balance-change hook once wiring.J28.2 lands, and transfers of a launchpad market token leave prefixes 0x22, 0x23 and 0x24 (modules/launchpad/types/keys.go:45-47) empty."

[req.4052]
title = "Delete the generation 1 key builders and keep their prefixes reserved"
ac_1 = "modules/launchpad/types/keys.go declares none of the ten generation 1 key builders ProtocolFeesKey, AirdropEpochKey, AirdropClaimKey, ParseAirdropClaimKey, HoldingHistoryKey, HoldingCountKey, HoldingEntryKey, AirdropBasisKey, ParseHoldingHistoryKey and ParseHoldingEntryKey (modules/launchpad/types/keys.go:76, :90-112 and :114-157), while ProtocolFeesPrefix and AirdropEpochPrefix to AirdropBasisPrefix (modules/launchpad/types/keys.go:38 and :43-48) stay declared."

[req.4053]
title = "Prove the v6.12.0 migration leaves the generation 1 prefixes empty"
ac_1 = "After MigrateV6120 over node/testdata/v6120-halt-export.json the launchpad store holds no key under ProtocolFeesPrefix or prefixes 0x20 to 0x25 (modules/launchpad/types/keys.go:38 and :43-48), the replay basis of decision.409 together with CheckNoNativeMarkets (modules/launchpad/keeper/migration_record.go:77-81)."

[req.4054]
title = "Prove Query/Markets and Query/PoolMetadata agree with the PoolRegistry views"
ac_1 = "For every market of a precompile env, Query/Markets lists the pools PoolRegistry getAllPools (precompiles/launchpad/views.go:414) returns in the same order and Query/PoolMetadata equals the getPoolMetadata view (precompiles/launchpad/views.go:458) field for field."

[req.4055]
title = "Bind the compiled generation 2 role addresses to the deployment manifest"
ac_1 = "Each of the nine roles of Generation2Surfaces (modules/launchpad/keeper/surfaces.go:16-26) and generation2Roles (modules/launchpad/keeper/keeper.go:49-62) equals the proxy address recorded for that contract in contracts/launchpad/deployments/paxeer-x-network-addresses.json:941-966, and the PoolBeacon field equals the PoolBeacon entry at contracts/launchpad/deployments/paxeer-x-network-addresses.json:954."

[req.4056]
title = "Prove the launchpad market REST routes against a live network"
ac_1 = "Against a one-validator network from tests/testutil/network.New (tests/testutil/network/network.go:45), the GET routes params, market, markets and markets_by_creator under /pax-protocol/paxchain/launchpad/ answer the JSON of the matching gRPC response: params equal the genesis Params, markets lists none with total 0 and market of an unknown denom answers the code 12 error body."

[req.4057]
title = "Prove the launchpad ledger REST routes against a live network"
ac_1 = "Against a one-validator network from tests/testutil/network.New (tests/testutil/network/network.go:45), the GET routes treasury, quote_ledger and fee_accounting under /pax-protocol/paxchain/launchpad/ answer the JSON of the matching gRPC response: treasury of the QuoteToken and quote_ledger treasury_held answer 0 and fee_accounting answers total_liabilities 0."

[req.4058]
title = "Prove the launchpad registry REST routes against a live network"
ac_1 = "Against a one-validator network from tests/testutil/network.New (tests/testutil/network/network.go:45), the GET routes surface, retired, fee_right, pool_metadata, airdrop_epoch, airdrop_claimed and has_role under /pax-protocol/paxchain/launchpad/ answer the JSON of the matching gRPC response: each lookup of an unregistered address answers found false or false and a malformed address answers a 400-class error body."

[req.4059]
