lerequest", "interface.8.go-sdkjvm-nativeprogramlifecyclerequest-nativeprogramlifecyclerequest", "interface.8.go-sdkjvm-nativeprogramlifecyclerequest-ordinal", "interface.8.go-sdkjvm-nativeprogramlifecyclerequest-payload", "interface.8.go-sdkjvm-nativeprogramlifecyclerequest-signedactivity", "interface.8.go-sdkjvm-nativeprogramlifecyclerequest-activityid", "interface.8.go-sdkjvm-nativeprogramlifecyclerequest-idempotencykey"]
do_1 = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java sends program.call, program.simulate, program.discover, program.interface, program.receipt and program.activity over /v1/programs (sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:168 Interface; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:229 lifecycleReceipt; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:239 deploy; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:240 upgrade); build layerxprograms 0x101D calls instead: call(bytes32,uint16,string,bytes,bytes,bytes,uint32,uint64[7],uint128) selector 0x54bd2b48 as an unsigned EIP-1559 transaction and simulateCall selector 0x3044bd56 through eth_call at the pending tag (spec/layerx-merge/contracts/clients.md:69)."
do_2 = "Read program.discover through getProgram(bytes32) 0xb1ffb3d4, program.interface through getInterface(bytes32) 0x8efc7240, program.receipt through layerxauth resultByIdempotency(bytes32,bytes32) and program.activity through eth_getTransactionByHash (spec/layerx-merge/contracts/clients.md:71)."
do_3 = "Replace the kernel activity id carried by the program call and submission shapes (sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:28 ProgramsClient; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:95 SubmissionState; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:113 Call) with the transaction hash, and verify submissions with LocalVerifier.verifySequencerReceipt instead of the kernel programs-module receipt (sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:435 verifyReceipt; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java:743 verifyTerminalV5)."
do_4 = "Make the native lifecycle requests (sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/NativeProgramCall.java:24 bindSignedActivity; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/NativeProgramCall.java:28 decodeSignedActivity; sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/NativeProgramLifecycleRequest.java:9 NativeProgramLifecycleRequest) produce unsigned EIP-1559 transactions to 0x101D: deploy(bytes32,uint16,uint8,bytes32,bytes32,bytes,bytes) 0xbde3ff66 and upgrade(bytes32,uint16,uint8,bytes32,bytes32,bytes,bytes,bytes,uint128) 0xa860929f (spec/layerx-merge/contracts/clients.md:70), chainId 125, nonce from eth_getTransactionCount(addr, \"pending\") and gas from eth_estimateGas(tx, \"pending\") (spec/layerx-merge/contracts/clients.md:40)."
do_5 = "Create sdk/platform/jvm/src/test/java/com/sidiora/layerx/sdk/ProgramsEvmTest.java (planned) checking calldata against the re-recorded sdk/platform/conformance/fixtures/native-program-call-v4.json:1 and sdk/platform/conformance/fixtures/native-program-deploy-v4.json:1 vectors."
