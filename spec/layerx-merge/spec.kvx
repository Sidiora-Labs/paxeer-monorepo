[task.4.21.2]
title = "Make the fmt target fail when goimports fails"
status = "done"
mode = "BUILD"
wave = 1
requires = ["4.21.1"]
reqs = ["4242.1"]
capabilities = ["4.21.2"]
interfaces = ["interface.4.mk-launchpad-fmt-j29"]
