do_1 = "sdk/platform/swift/Sources/LayerXSDK/Programs.swift sends program.call, program.simulate, program.discover, program.interface, program.receipt and program.activity over /v1/programs (sdk/platform/swift/Sources/LayerXSDK/Programs.swift:104 lifecycleReceipt; sdk/platform/swift/Sources/LayerXSDK/Programs.swift:123 deploy; sdk/platform/swift/Sources/LayerXSDK/Programs.swift:128 upgrade; sdk/platform/swift/Sources/LayerXSDK/Programs.swift:133 windDown); build layerxprograms 0x101D calls instead: call(bytes32,uint16,string,bytes,bytes,bytes,uint32,uint64[7],uint128) selector 0x54bd2b48 as an unsigned EIP-1559 transaction and simulateCall selector 0x3044bd56 through eth_call at the pending tag (spec/layerx-merge/contracts/clients.md:69)."
do_2 = "Read program.discover through getProgram(bytes32) 0xb1ffb3d4, program.interface through getInterface(bytes32) 0x8efc7240, program.receipt through layerxauth resultByIdempotency(bytes32,bytes32) and program.activity through eth_getTransactionByHash (spec/layerx-merge/contracts/clients.md:71)."
