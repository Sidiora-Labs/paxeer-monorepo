[task.9.31.1]
title = "Disclose EIP-1559 layerxledger and bank calls from their calldata"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["9321.1", "9321.2", "9321.3"]
capabilities = ["9.31.1"]
interfaces = ["interface.9.rs-crypto-disclosure-disclosure", "interface.9.rs-crypto-disclosure-call-bind-call-j44", "interface.9.rs-crypto-disclosure-call-constructmethod-j44"]
do_1 = "Disclosure (services/agent/crates/layerx-crypto/src/disclosure.rs:144) is built only from canonical kernel activity bytes by bind (services/agent/crates/layerx-crypto/src/disclosure.rs:1236), while every write is now an Eip1559Call (services/agent/crates/layerx-crypto/src/evm_transaction.rs:13) whose calldata clients.md O2 (spec/layerx-merge/contracts/clients.md:41) decodes against the construct ABI."
do_2 = "Create services/agent/crates/layerx-crypto/src/disclosure/call.rs (planned) with `pub enum ConstructMethod` and `pub fn bind_call(call: &Eip1559Call, from: [u8; 20])`, matching `to` and the four-byte selector against layerxledger 0x101A `send(bytes)`, `issueGrant(bytes)`, `draw(bytes32,bytes32,uint128,bytes32,uint64,bytes32,bytes32)` and `revokeGrant(bytes32,uint64)` (spec/layerx-merge/contracts/clients.md:85) and bank 0x1001 `send(address,address,string,uint256)` (spec/layerx-merge/contracts/clients.md:72)."
do_3 = "For layerxledger send(bytes) pass the ABI-decoded bytes argument to the existing send payload decoder decode_send (services/agent/crates/layerx-crypto/src/disclosure.rs:285) so counterparties, amounts, asset, expiry and idempotency key are the same fields an activity disclosure shows; `actor` becomes the 20-byte sender and `fee_limit` is gas_limit times max_fee_per_gas."
do_4 = "Replace the private `activity: Activity` field (services/agent/crates/layerx-crypto/src/disclosure.rs:172) with `source: Source` where `enum Source { Activity(Activity), Call(Eip1559Call) }`, and set `signing_digest` to Eip1559Call::signing_hash (services/agent/crates/layerx-crypto/src/evm_transaction.rs:195) for the call source; declare `pub mod call;` beside the program and native submodules (services/agent/crates/layerx-crypto/src/disclosure.rs:6)."
do_5 = "Refuse a call whose target or selector is not in the table, whose ABI head offsets or lengths are out of bounds, or that carries trailing bytes, with DisclosureError::MalformedPayload (services/agent/crates/layerx-crypto/src/disclosure.rs:216)."
do_6 = "Create services/agent/crates/layerx-crypto/tests/disclosure_call.rs (planned) with one fixture call per method, built from the payment fixtures under services/agent/crates/layerx-crypto/tests/fixtures/payments (planned file reads)."
symbols = ["bind_call", "ConstructMethod", "Source", "ledger_send_call_discloses_the_send_payload_fields", "unknown_target_or_selector_is_refused", "trailing_calldata_is_refused"]
touches = ["services/agent/crates/layerx-crypto/src/disclosure.rs", "services/agent/crates/layerx-crypto/src/disclosure/call.rs", "services/agent/crates/layerx-crypto/tests/disclosure_call.rs"]
tests = ["services/agent/crates/layerx-crypto/tests/disclosure_call.rs::ledger_send_call_discloses_the_send_payload_fields", "services/agent/crates/layerx-crypto/tests/disclosure_call.rs::unknown_target_or_selector_is_refused", "services/agent/crates/layerx-crypto/tests/disclosure_call.rs::trailing_calldata_is_refused"]
planned_paths = ["services/agent/crates/layerx-crypto/src/disclosure/call.rs", "services/agent/crates/layerx-crypto/tests/disclosure_call.rs"]
build_cmd = "cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-crypto --tests"
verify_cmd = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-crypto --test disclosure_call -- --exact ledger_send_call_discloses_the_send_payload_fields unknown_target_or_selector_is_refused trailing_calldata_is_refused"
