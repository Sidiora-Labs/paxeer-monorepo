[task.1.21.3]
title = "Freeze the lxphost result surface: a non-cgo Code table and the kernel fee, effects and program outcome in Receipt"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["1243.1", "1243.2", "1243.3"]
capabilities = ["1.21.3"]
interfaces = ["interface.1.go-lxphost-code-j22", "interface.1.go-lxphost-code-error-j22", "interface.1.go-lxphost-receipt-j22"]
fulfils = ["wiring.J23.2", "wiring.J51.6", "wiring.J52.2", "wiring.J52.3"]
do_1 = "Move type Code int32 (modules/lxphost/host.go:516) and its Error method (modules/lxphost/host.go:518) out of the //go:build cgo file into modules/lxphost/code.go (planned) without a build constraint, so precompiles/layerxexchange/errors.go:11 compiles KernelCodeText without cgo."
do_2 = "Code.Error looks the code up in a generated table codeNames in modules/lxphost/code_names.go (planned), one entry per X(name, value) row of the LXP_ result registry (include/layerx/lxp_result.h:42 is one row), and returns LXP_ERR_UNKNOWN for a value outside the table, the string lxp_result_name (include/layerx/lxp_result.h:163) returns for an unknown value."
do_3 = "Keep codeNonCanonical, codeSequenceReused and codeFatalInvariant (modules/lxphost/host.go:523) in host.go and add kernelResultName(code int32) string in host.go wrapping C.lxp_result_name, used only to check the table."
do_4 = "Create modules/lxphost/code_test.go (planned) with TestCodeNamesMatchKernel: for every value from -2000 to 2000, Code(value).Error() equals kernelResultName(value)."
do_5 = "lxphost_outcome (modules/lxphost/host.go:55) gains fee_hi and fee_lo, which lxphost_outcome_read (modules/lxphost/host.go:478) copies from node->receipt.fee_charged (lxp_u128, include/layerx/lxp_receipt.h:90); at HEAD the fee is only inside Receipt.Encoded."
do_6 = "Receipt (modules/lxphost/host.go:574) gains FeeCharged sdk.Int built with readAmount (modules/lxphost/read.go:217) in HostExecute (modules/lxphost/host.go:727); create modules/lxphost/receipt_fee_test.go (planned) with TestHostReceiptFeeMatchesEncoded."
do_7 = "Receipt (modules/lxphost/host.go:574) gains Events []ReceiptEvent {Code uint16; Body []byte}, one per node->receipt.effects entry of kind LXP_EFFECT_EVENT (include/layerx/lxp_receipt.h:14-18, :20-34) in effect order with Code from event_type and Body a copy of body[:body_length], and Transfers []TransferLeg {Asset, From, To [32]byte; Amount sdk.Int} holding the receipt asset, amount, from and to (include/layerx/lxp_receipt.h:96-102) when amount is non-zero; lxphost_outcome carries the effect pointer and count and the leg fields; this fulfils wiring.J23.2 and wiring.J52.2."
do_8 = "Receipt gains ProgramOutcome *ProgramOutcome {Status int32; Kind uint8; Response []byte; FeeScheduleVersion, MeteringScheduleVersion uint64; Events []byte}, nil unless node->receipt.program_outcome.present (include/layerx/lxp_receipt.h:48-79, :112): Status from result_code, Kind from terminal_kind, Response a copy of terminal_payload, and Events a copy of event_envelope_payload, the call's full event list (include/layerx/lxp_receipt.h:78), which lxphost_outcome_read copies before the lxp_arena_reset at modules/lxphost/host.go:485; this fulfils wiring.J52.3 and the host read of wiring.J51.6, whose EVM log emission stays with the requester 13.0.3."
do_9 = "Add TestHostReceiptEffectsMatchEncoded to modules/lxphost/receipt_fee_test.go (planned): for the register and mint receipts, Events equals the kind-3 Effects and Transfers the Asset, From, To and Amount that DecodeReceipt (layerxproof/codec/receipt.go:364) reads from Receipt.Encoded (layerxproof/codec/receipt.go:87, :94-100), and ProgramOutcome is nil as the decoded ProgramOutcome (layerxproof/codec/receipt.go:108) is."
symbols = ["Code", "codeNames", "kernelResultName", "TestCodeNamesMatchKernel", "lxphost_outcome", "lxphost_outcome_read", "Receipt.FeeCharged", "TestHostReceiptFeeMatchesEncoded", "ReceiptEvent", "TransferLeg", "ProgramOutcome", "Receipt.Events", "Receipt.Transfers", "Receipt.ProgramOutcome", "TestHostReceiptEffectsMatchEncoded"]
touches = ["modules/lxphost/host.go", "modules/lxphost/code.go", "modules/lxphost/code_names.go", "modules/lxphost/code_test.go", "modules/lxphost/receipt_fee_test.go"]
tests = ["modules/lxphost/code_test.go::TestCodeNamesMatchKernel", "modules/lxphost/receipt_fee_test.go::TestHostReceiptFeeMatchesEncoded", "modules/lxphost/receipt_fee_test.go::TestHostReceiptEffectsMatchEncoded"]
planned_paths = ["modules/lxphost/code.go", "modules/lxphost/code_names.go", "modules/lxphost/code_test.go", "modules/lxphost/receipt_fee_test.go"]
build_cmd = "make paxd-native-libs && CGO_ENABLED=1 go build ./modules/lxphost/"
verify_cmd = "CGO_ENABLED=1 go test -count=1 ./modules/lxphost/ -run '^(TestCodeNamesMatchKernel|TestHostReceiptFeeMatchesEncoded|TestHostReceiptEffectsMatchEncoded)$'"
gate_kind = "planned"
sandbox_profile = "go-cgo"
owner_role = "fm-kernel"
rollback = "Revert host.go and delete code.go, code_names.go, code_test.go and receipt_fee_test.go; Code keeps its cgo Error method and Receipt loses FeeCharged, Events, Transfers and ProgramOutcome."
