build_cmd = "cargo build --locked --manifest-path services/platform/Cargo.toml -p layerx-ramp-toolkit"
verify_cmd = "cargo test --locked --manifest-path services/platform/Cargo.toml -p layerx-ramp-toolkit --test evm_config --test evm_submit -- --exact layerx_config_refuses_zero_chain_id layerx_config_refuses_inverted_receipt_key_range layerx_config_rejects_retired_gateway_field signature_from_other_key_is_refused_before_submission submit_prepared_sends_raw_transaction_once resolve_reports_submitted_receipt_as_pending"
