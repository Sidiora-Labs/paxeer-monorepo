storage = "tools/paxeer-x/gates/registry.kvx sections [task.<id>]; the service catalogue in spec/layerx-merge/spec.kvx."
errors = "verify-task.sh exit codes 2 to 12 as documented at tools/paxeer-x/verify-task.sh:10-12."
events = "Gates print PAXEER_X_GATE tests=<n> skipped=<m>."
