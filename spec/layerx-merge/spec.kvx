ac_1 = "oteltest.Install in sdk/testutil/oteltest/oteltest.go (planned) installs one ManualReader-backed MeterProvider for the process so instruments created at package init through otel.Meter (sdk/x/slashing/metrics.go:9) are observable in tests."
ac_2 = "oteltest.InstallLegacySink in sdk/testutil/oteltest/oteltest.go (planned) captures every key written through the telemetry wrappers (sdk/telemetry/wrapper.go:48) so removal tasks can assert a key is gone."

[req.15002]
title = "Regenerate the bank query gateway with the by_denom and query-string routes"
ac_1 = "The regenerated sdk/x/bank/types/query.pb.gw.go registers pattern_Query_SupplyOf_1 for GET /cosmos/bank/v1beta1/supply/by_denom beside pattern_Query_SupplyOf_0 (sdk/x/bank/types/query.pb.gw.go:853) and fills denom from the query string."
ac_2 = "The regenerated sdk/x/bank/types/query.pb.gw.go registers pattern_Query_DenomMetadata_1 for GET /cosmos/bank/v1beta1/denoms_metadata_by_query_string beside pattern_Query_DenomMetadata_0 (sdk/x/bank/types/query.pb.gw.go:857)."

[req.15003]
title = "Add BaseApp.SetSealedStateToCommit so Commit writes an externally sealed block"
ac_1 = "SetSealedStateToCommit installs state{ms, ctx} as stateToCommit beside SetDeliverStateToCommit (sdk/baseapp/abci.go:258), so Commit (sdk/baseapp/abci.go:269) writes the sealed store and reads the header from its context (sdk/baseapp/abci.go:282)."
ac_2 = "SetSealedStateToCommit refuses a nil CacheMultiStore with an error and leaves stateToCommit unchanged, so Commit keeps its nil guard at sdk/baseapp/abci.go:279."

