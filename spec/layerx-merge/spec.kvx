ac_1 = "Submitting the same transaction hash and call ordinal twice yields one kernel execution: the second submit returns the receipt stored under IdempotencyKey via ReadIdempotentReceipt (modules/lxphost/read.go:444) and the fee asset balance is charged once."

[req.13295]
title = "Prove 0x101D logs and outputs are identical across two independent executions"
