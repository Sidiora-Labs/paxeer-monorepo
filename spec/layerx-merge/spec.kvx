do_1 = "Change lxp_verified_receipt_authority_facts (include/layerx/lxp_receipt.h:128-146) to version 2 with block_height in place of batch_number and without epoch, global_sequence, authorization_first_batch_number, authorization_last_batch_number, sequencer_id and sequencer_public_key (finality-authority req 11009, decision.116)."
