ac_1 = "ExecuteResting (modules/spot/keeper/execute.go:108) expiring ten orders costs within 5 percent at 10 and 2000 resting orders."

[req.3252]
title = "Spot migration preserves exported state"
ac_1 = "A store migrated by Migrate1to2 (planned) exports a genesis that re-imports to an identical export (modules/spot/keeper/genesis.go:294-302)."

[req.3253]
title = "Spot params validation bounds work and listings"
ac_1 = "Params.Validate refuses each EndBlock budget and maxActiveOrdersPerUser above its limit, where HEAD refuses only zero (modules/spot/types/params.go:232-240)."
ac_2 = "Params.Validate refuses a non-stablecoin token with MarketID 0, which IndexPrice refuses later (modules/spot/keeper/pricing.go:33-34)."
ac_3 = "Params.Validate refuses more than 64 tokens before the loop at modules/spot/types/params.go:241-242."

[req.3254]
title = "Spot listing registers books and refuses delisting funded tokens"
ac_1 = "ListTokens registers a token new in after through RegisterToken (modules/spot/keeper/vault.go:742-775), writing its book decimals and share denom."
ac_2 = "ListTokens refuses removing a token whose book reserves are non-zero (modules/spot/types/genesis.go:15-23)."

[req.3255]
title = "Spot listing checks the pricefeed market"
ac_1 = "ValidatePriceMarket maps pricefeed ErrUnknownMarket (modules/pricefeed/keeper/price.go:29) to InvalidOracle and accepts a listed market."

[req.3256]
title = "Spot MsgUpdateParams lists tokens completely"
ac_1 = "MsgUpdateParams adding a token registers its book, which HEAD skips (modules/spot/keeper/msg_server.go:120-144)."
ac_2 = "MsgUpdateParams refuses a token on a market the pricefeed does not list (modules/pricefeed/keeper/price.go:29)."
ac_3 = "MsgUpdateParams refuses dropping a token whose book holds reserves (modules/spot/types/genesis.go:15-23)."

[req.3257]
