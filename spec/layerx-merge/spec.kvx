ac_1 = "Query/PriceHistory{denom, from_height, to_height} returns the PricePoint list of Keeper.PriceHistory in modules/launchpad/keeper/price_history.go (planned) unchanged."
ac_2 = "Query/PriceHistory refuses a nil request with codes.InvalidArgument and passes ErrUnknownMarket and ErrInvalidRange of Keeper.PriceHistory through unchanged."

