# spec.kvx — layerx-merge v2. Generated from spec fragments by the specification build; edit fragments, not this file.
# Grammar: [section.id] then key = "string" | int | ["a", "b"], one per line. Task ids are <feature>.<slot>.<n>.

[meta]
name = "LayerX merge into Paxeer X"
slug = "layerx-merge"
version = "2.0.0"
status = "draft"
goal = "Fold the LayerX kernel into the Paxeer X Network as one execution domain: every kernel capability runs inside paxd transactions with the same results, ledger, payments, authority, programs, agent functions and markets are native chain constructs, and the proposer is the executor, so a transaction is executed at receipt, answered with a signed receipt and proposed in exactly that order."
scope = "One execution domain (paxd: Cosmos SDK, EVM, CosmWasm, OCC) across 17 domains that partition the repository by exclusive path prefixes: the kernel C modules and the Rust program runtime hosted through the cgo host in modules/lxphost, the ledger, auth, pay and agent-function constructs at 0x101A-0x101D and 0x0901-0x0908, the native perps, spot, pricefeed and launchpad venues, the sequencer runtime and its consensus rule from the v7.0 plan, the retired executors 0x1012-0x1014 that stay registered and refuse, and the off-chain services, SDKs and clients re-pointed to sequencer receipts and chain state."
revision = "2a1033aa2"
completion = "Every task of waves 0 to 6 passes its verify_cmd at one revision, every acceptance criterion of the 2360 requirements of features 1 to 17 holds on that revision through its one test, the 17 domain completion gates N.0.9 pass on the merged candidate, and the programme gate 17.0.9 passes after them, including the activation rehearsal of the v7.0 plan with bond return, retired-method refusals and receipt order equal to block order."


[design]
flow = "Wallet, agent or developer client -> gateway or node RPC -> sequencer primary (eth_sendRawTransaction) -> execute at receipt on the open speculative block -> WAL group fsync and hot-standby acknowledgement -> signed ProtocolReceipt v2 (pax_sequencerReceipt, rung receipted) and pending reads from the open block -> block proposed with MsgSequenceBatch at tx 0 in receipt order -> validators verify the batch in ProcessProposal, re-execute with OCC and commit (rung committed) -> committed receipts, history and proofs."
domains = "One execution domain, paxd. The kernel C modules and the Rust program runtime run inside the node through the cgo host (HostExecute, modules/lxphost/host.go:678), staging their writes into the transaction's KV store (modules/lxphost/ctx.go:232) so BaseApp commit is the only commit (decision.1). Kernel accounts are derived bank addresses (decision.2). The kernel daemon, its WAL, replicas, finality and checkpoint anchoring are retired because block commit is finality. The repository is partitioned into 17 delivery domains, each with one feature manager, one [feature.N] block and anchor tasks N.0.1-N.0.4 and N.0.9."
native_constructs = "Served at HEAD: bank 0x1001, wasmd 0x1002, json 0x1003, addr 0x1004 (EVM to DID binding), staking 0x1005, gov 0x1006, distribution 0x1007, oracle 0x1008 (refusal surface), ibc 0x1009, pointerview 0x100A, pointer 0x100B, solo 0x100C, p256 0x1011, layerxVerify 0x1012, layerxCustody 0x1013, layerxAnchor 0x1014, perps 0x1015 (decision.301), layerxBridge 0x1016, launchpad 0x1017 (decision.1704), feeToken 0x1018, xweb 0x1019, pricefeed 0x1020 (decision.1702) and spot 0x1021-0x1025 (decision.334), registered at precompiles/setup.go:164 and node/app.go:3528. Declared in MergeAddressTable (precompiles/setup.go:61) and gated by mergePrecompileGate (node/upgrades.go:521) but not served at HEAD: layerxledger 0x101A, layerxpay 0x101B, layerxauth 0x101C, layerxprograms 0x101D and the agent functions 0x0901-0x0908; each is served once its constructor is registered (precompiles/setup.go:89) and imported by the node. Every new method charges a fixed GasTable row (precompiles/common/precompiles.go:65; decision.30)."
sequencer = "The proposer is the executor (decision.18): an operator-run primary and hot standby in node/sequencer execute every transaction at receipt (sequential first, OCC micro-batches after measurement, decision.19), sign ProtocolReceipt v2 with a receipt key separate from validator keys (decision.15; node/sequencer/receipt.go:325), replicate the WAL to the standby before release (node/sequencer/standby.go:214), serve pending reads from the open block and seal MsgSequenceBatch at tx 0 (node/sequencer/consensus_source.go:56). The keeper admits the batch (modules/sequencer/keeper/keeper.go:56); the first sequenced height is keeper state (decision.521). Clients see the rungs submitted, receipted and committed (rpc/sequencer_receipt.go:33; decision.17)."
fees = "Fees are policy, not security: the EVM minimum fee per gas is 0.067 gwei (modules/evm/types/params.go:52) and the draw sender class pays at most that (decision.10); the sequencer applies the node floor to Cosmos transactions before Accept (node/sequencer/fee.go:22); SID is self-paid through feeToken 0x1018 at the governed rate with a governance-raised rate age (modules/evm/types/params.go:39; decision.7); sponsored writes go through executeSponsored (contracts/src/BatchCallAndSponsor.sol:135) with one paymaster nonce and per-DID gas-station budgets (decision.14); paid search is USD 0.001 per request drawn at 0x101A (decision.10); the program fee stays on top of gas (decision.9)."
activation = "Activation is a bring-up at the height of the v7.0 plan (MergeUpgrade, node/upgrades.go:112; mergeUpgradePlan, node/upgrades.go:432); no account-state migration is required. The plan adds the sequencer store and, through task 5.6.5, the ledger, auth, pay, programs, agent and host stores; it returns every guarantor bond and releases stranded custody balances to the custody authority (decision.642); the merge-gated precompile methods switch on per method; 0x1012-0x1014 refuse with LXP_MODULE_DISABLED while staying registered, and layerxAnchor reads stay served until the later v7.0-anchor-store-delete step (decision.21). The activation height, plan info and receipt key coverage of the first sequenced height are fixed at activation rehearsal."
include = "design.body.md"


[execution]
planning_state = "Task completion requires the declared implementation and its verify_cmd evidence at one revision. A specification or task status alone establishes no runtime result; every acceptance block starts with qualification UNRUN."
task_policy = "Read the exact declared source, contract section and interface blocks, keep code that already meets the contract, implement every unmet criterion of the task inside its declared touches, then run one bounded build and one verify run, with at most two repair cycles inside 30 minutes. Implementation, qualification and activation evidence are recorded separately."
gate_policy = "Every planned gate is implemented by the task that owns its acceptance criteria. A verify_cmd runs exactly the tests the task lists and names a target that exists at the revision or is listed in planned_paths with gate_kind planned; whole-package runs, prefix selectors, unknown, empty or skipped selectors and exit-code-hiding pipes are refused. A wave starts only after the previous wave's gate passed."
candidate_policy = "A passing gate is reused only while its source, inputs, scope and environment stay the same. Aggregate, sanitizer, cluster, conformance and activation-rehearsal gates run once per wave on the merged wave revision, not per task."
parallelism = "every task of a wave runs concurrently in its own sandbox"
privacy = "Credentials, key material, operational inventories and raw execution logs stay in access-controlled storage. Everything in this feature directory is public and is reviewed before publication."
ownership = "Each repository path prefix belongs to exactly one domain; a task touches only exact files of its own domain, at most 12, and every path appears in the touches of at most one task per wave. A change in another domain's path is a wiring request fulfilled by a task of the owning domain, which the build adds to the requester's requires."
citation_policy = "Every do_n names the path:line it changes or reproduces at revision 2a1033aa2, or a planned path; every cited line is checked against that revision, and the code at the revision wins over earlier text, recorded as a decision with basis citing the code."
requirement_ids = "Feature N declares its requirements as req.<N*1000+k> (req.3007 is requirement 7 of feature 3); a task reqs entry <id>.<a> names acceptance criterion a of that requirement and acceptance.N.k.a is its scenario and its one test. There are no programme-level requirements outside the 17 features; decisions 1 to 94 carry earlier rulings forward and decision.<N*100+k> are per-domain decisions."
test_ratio = "one acceptance criterion equals one test equals one task"
sandbox_profiles = "kernel go-cgo; ledger-auth-pay go-cgo; markets go; launchpad mixed; node-runtime go-cgo; chain-modules go; rpc-api go; platform rust; agent rust; human rust; interop rust; wallet mixed; programs rust; web-explorer-bridge node; cosmos-fork go; tools-ops mixed; programme mixed. Allowed profiles: go, go-cgo, rust, node, elixir, solidity, python, jvm, dotnet, swift, mixed; a task declares its own sandbox_profile."
roles = ["fm-kernel", "fm-ledger-auth-pay", "fm-markets", "fm-launchpad", "fm-node-runtime", "fm-chain-modules", "fm-rpc-api", "fm-platform", "fm-agent", "fm-human", "fm-interop", "fm-wallet", "fm-programs", "fm-web-explorer-bridge", "fm-cosmos-fork", "fm-tools-ops", "fm-programme"]


[decision.1]
title = "Kernel C modules and the Rust program runtime inside paxd"
value = "The kernel C modules behind layerxledger, layerxpay, layerxauth and layerxprograms are hosted through cgo behind the lxp_module_ctx shim of modules/lxphost; 0x1015 is not a kernel venue: it serves the pure-Go perps module, and the cgo exchange keeper is legacy replay only (decision.301)."
basis = "modules/lxphost/ctx.go:1 builds only under cgo and imports C at modules/lxphost/ctx.go:50; the kernel modules execute through lxp_module_ctx (src/modules/programs/registration.c:164); precompiles/perps/perps.go:27 binds PerpsAddress to the exchange address 0x1015 (modules/layerxexchange/types/ids.go:15)."
affects = ["modules/layerxledger", "modules/layerxpay", "modules/layerxauth", "modules/layerxprograms", "modules/layerxexchange", "0x101A", "0x101B", "0x101C", "0x101D", "0x1015"]
carry = "rewritten"

[decision.2]
title = "Kernel account and margin model"
value = "Kernel accounts become derived bank addresses per DID and sub-account suffix; perps margin is not in that namespace: the perps module holds margin accounts of EVM addresses itself."
basis = "Kernel accounts carry a sub-account kind and parent account id (include/layerx/lxp_genesis.h:148-149); perps deposits credit an EVM address account in modules/perps/keeper/account.go:54."
affects = ["0x1001 bank", "0x1015 layerxexchange", "0x101A layerxledger", "explorer balance views"]
carry = "rewritten"

[decision.3]
title = "Home of session keys and delegated authorities"
value = "Session keys and delegated capabilities are authz grants carrying a LayerX-scope Authorization that covers kernel and program calls, keeping all eight authority kinds."
basis = "The kernel defines eight authority kinds including SESSION_KEY (include/layerx/lxp_authority.h:11-19)."
affects = ["0x101C layerxauth", "sdk/x/authz", "0x101A", "0x101B", "0x101D"]
carry = "kept"

[decision.4]
title = "Custody claims and guarantor bonds at the activation height (superseded by decision.642)"
value = "Superseded by decision.642: at the merge plan every custodied balance and posted guarantor bond is released to the authority account, replacing the bond-return-only bring-up."
basis = "modules/layerxcustody holds the custodied balances the release moves (decision.642); the merge plan handler is mergeUpgradePlan (node/upgrades.go:432)."
affects = ["0x1013 layerxCustody", "0x1014 layerxAnchor", "activation handler"]
carry = "superseded"

[decision.5]
title = "Kernel balances without an addr binding at activation"
value = "Not applicable: activation is a bring-up at a height, no account-state migration; the activation handler creates no claim record and no held balance."
basis = "Activation remains a bring-up at a height with no account-state migration: activationStoreUpgrades only adds stores (node/upgrades.go:402-406)."
affects = ["0x1004 addr", "activation handler"]
carry = "kept"

[decision.6]
title = "Precompile error encoding"
value = "Every kernel-backed precompile reverts with Error(string) carrying LXP_<code> through the opt-in WithLXPReasons path of the shared precompile base; perps 0x1015 and pricefeed 0x1020 reasons come from their registry rows (decision.313)."
basis = "WithLXPReasons is at precompiles/common/precompiles.go:107 and RevertReason at precompiles/common/precompiles.go:121; the stale citation precompiles/common/precompiles.go:51 no longer names the switch."
affects = ["0x1001", "0x1004", "0x1015", "0x1017", "0x1019", "0x101A", "0x101B", "0x101C", "0x101D", "0x0901-0x0908", "precompiles/common"]
carry = "rewritten"

[decision.7]
title = "Time semantics under the sequencer cadence"
value = "The receipt timestamp is fixed at pending-block open, AI and market height windows are re-tuned for the new cadence, and the fee-token rate age is raised by governance."
basis = "The kernel batch carries one timestamp (include/layerx/lxp_batch.h:32) and the fee-token rate age is a governance parameter read at modules/evm/keeper/params.go:310."
affects = ["node/sequencer", "modules/evm params", "0x1018 feeToken", "0x101D AI and market guests", "0x1019 xweb TimeoutBlocks"]
carry = "kept"

[decision.8]
title = "Trading semantics where kernel and exchange differ"
value = "Kernel books keep capacity 256 with 8 fills per dispatch and spot settlement requests stay refused in the kernel; the served venues are perps at 0x1015 (decision.301) and spot on PECOR at 0x1021-0x1025 (decision.334), whose order ids and fees follow their own modules; launchpad fees accumulate per market."
basis = "Kernel caps are at include/layerx/lx_perps.h:27 and :34; spot addresses are modules/spot/types/keys.go:12-24; the launchpad swap records FeeRecorded (modules/launchpad/keeper/swap.go:32)."
affects = ["0x1015 layerxexchange", "0x1017 launchpad", "agent SDK order API"]
carry = "rewritten"

[decision.9]
title = "Program fee versus gas"
value = "The program fee (metering times prices) is kept on top of near-zero gas."
basis = "Program fees remain metering times prices on top of gas (src/modules/programs/deploy.c:485 executes through the metered program context)."
affects = ["0x101D layerxprograms"]
carry = "kept"

[decision.10]
title = "Paid search settlement and lxpay placement"
value = "Paid web search settles as one draw per request through layerxledger at 0x101A (the lxpay construct), at USD 0.001 per request, with the EVM minimum gas price at most 0.067 gwei for the draw sender class."
basis = "The x402 conformance payload suite is in place (services/interop/specs/conformance/x402/README.md:9)."
affects = ["0x101A layerxledger", "modules/evm params", "x-websearch sidecar", "x402 seller"]
carry = "kept"

[decision.11]
title = "Program-origin web request terms"
value = "Program-origin (origin 2) web requests pay the kernel per-asset fee from the per-asset program fee account and the fee is split in equal shares among the signers, remainder to the first signer; origin-1 fees go to the xweb module account (decision.561, decision.1705)."
basis = "splitProgramFee is at modules/xweb/keeper/program_fulfil.go:189-226 and programFeeDenom at modules/xweb/keeper/program_fulfil.go:233; origin-1 payment is at modules/xweb/keeper/request.go:53."
affects = ["0x1019 xweb", "0x101D layerxprograms"]
carry = "rewritten"

[decision.12]
title = "Program-origin observation admission"
value = "Origin-2 observations admit with at most 16 signers and the kernel network id kept as an xweb param."
basis = "The kernel caps attestors at 16 (include/layerx/lx_web.h:29) and xweb observations use the EVM chain id (modules/xweb/keeper/fulfil.go:72)."
affects = ["0x1019 xweb", "modules/xweb params", "x-websearch sidecar"]
carry = "kept"

[decision.13]
title = "Reference guest deployment"
value = "The interpreter, compute-lease market and AI market reference guests are deployed at the activation height through MsgDeploy by the chain operator, with expected code hashes."
basis = "The three reference guests are in-tree crates (programs/crates/layerx-programs-interpreter/Cargo.toml:1, programs/crates/layerx-programs-market/Cargo.toml:1, programs/crates/layerx-programs-ai-market/Cargo.toml:1)."
affects = ["0x101D layerxprograms", "activation runbook"]
carry = "kept"

[decision.14]
title = "Sponsorship path and per-identity budget home"
value = "Every sponsored agent write is an EIP-7702 executeSponsored batch through the gas station with one paymaster nonce, and per-identity budgets live in a gas-station ledger keyed by the DID resolved through addr 0x1004."
basis = "executeSponsored is at contracts/src/BatchCallAndSponsor.sol:135 and the gas station builds that batch (services/interop/crates/layerx-gas-station/src/tx.rs:245); an on-chain budget would change modules/evm/ante/fee.go:36."
affects = ["gas station", "BatchCallAndSponsor", "0x1004 addr", "agent SDK nonce handling"]
carry = "kept"

[decision.15]
title = "Sequencer receipt signing key"
value = "Receipts are signed by a separate ed25519 receipt key per sequencer host, distinct from the validator key and pinned in the authority service and the settle endpoint."
basis = "The receipt verifier takes a pinned ed25519 key (services/agent/crates/layerx-proof/src/receipt.rs:273); primary and standby keys may overlap per host (modules/sequencer/keeper/receipt_keys.go:75)."
affects = ["node/sequencer", "modules/sequencer ReceiptKeys", "authority service", "SDK verifiers"]
carry = "kept"

[decision.16]
title = "DID key rotation and the embedded-wallet ed25519 share"
value = "Application level, decided with the wallet feature; no task of this feature depends on it and addr 0x1004 gains no rotation or recovery method here."
basis = "addr 0x1004 carries binding refusals only (precompiles/common/lxp_errors.go:255-264); rotation is not a chain method."
affects = ["0x1004 addr", "embedded wallet"]
carry = "kept"

[decision.17]
title = "Client-facing contract"
value = "Landed: agent-api is at major 2 with the clean-break write rungs."
basis = "services/agent/schema/agent-api/v1.kvx:3 declares major = 2."
affects = ["agent SDKs", "gateway", "CLI", "x402 seller", "seller middleware", "explorer status UI", "wallet status UI"]
carry = "kept"

[decision.18]
title = "Sequencer consensus scope"
value = "Landed: the leader pin of the sequencer fork is in consensus; BeginBlock still reads last-commit votes for slashing."
basis = "SetLeaderPin is at consensus/internal/consensus/types/round_state.go:201 and LeaderPin at :414; votes are read at node/legacyabci/begin_block.go:61."
affects = ["modules/sequencer", "node/sequencer", "consensus Leader()", "node/legacyabci BeginBlock", "activation height"]
carry = "kept"

[decision.19]
title = "Sequencer execution mode"
value = "The sequencer executes OCC micro-batches in receipt order, with the strictly sequential executor landed first and the switch to micro-batches made on measurement."
basis = "DeliverTx is at node/abci.go:169 and DeliverTxBatch with the OCC scheduler at node/abci.go:230."
affects = ["node/sequencer executor"]
carry = "kept"

[decision.20]
title = "Legacy surfaces"
value = "layerxctl stays an operator EVM client and the program registry service a read cache; the eight agent functions 0x0901-0x0908 are named in MergeAddressTable, but production registers none of them until their constructors are imported by the node (decision.1706)."
basis = "MergeAddressTable is at precompiles/setup.go:61-74; newMergePrecompiles builds only registered constructors (precompiles/setup.go:117); the gateway routes name 0x0901 (services/wallet/gateway/src/precompiles.ts:18)."
affects = ["cmd/layerxctl", "program registry service", "0x0901-0x0908"]
carry = "rewritten"

[decision.21]
title = "layerxAnchor reads after the fold"
value = "layerxAnchor 0x1014 reads are served until every posted guarantor bond is returned, then the store is deleted and the retired executor remains at the address."
basis = "0x1014 stays registered with the retired executor at the merge plan (precompiles/setup.go:180)."
affects = ["0x1014 layerxAnchor"]
carry = "kept"

[decision.22]
title = "Agent functions 0x0901-0x0904"
value = "orob, clearing, oracle and pofq are implemented as packages under precompiles/layerxagent and named in the address table; they serve only once registered in production (decision.1706)."
basis = "0x0901 orob is at precompiles/setup.go:66 and computeClearing at precompiles/layerxagent/clearing/clearing.go:22."
affects = ["0x0901", "0x0902", "0x0903", "0x0904"]
carry = "rewritten"

[decision.23]
title = "Revert reasons for addr and bank"
value = "addr 0x1004 and bank 0x1001 return Error(string) LXP_<code> reasons through WithLXPReasons on DynamicGasPrecompile."
basis = "DynamicGasPrecompile is at precompiles/common/precompiles.go:274 and WithLXPReasons at :107."
affects = ["0x1001 bank", "0x1004 addr", "precompiles/common"]
carry = "rewritten"

[decision.24]
title = "Service dispute resolution"
value = "Service disputes are resolved by the linked escrow's arbiter, and the linked escrow settles on the ruling in the same call."
basis = "Either agreement party may still resolve today (src/modules/service/lx_service_dispute.c:89); the ruling stands as the target."
affects = ["0x101B layerxpay service and escrow"]
carry = "kept"

[decision.25]
title = "Exchange withdrawMargin"
value = "withdrawMargin stays declared on layerxexchange only for legacy replay below v6.12.0; live margin withdrawal is the perps module path at 0x1015 (decision.323)."
basis = "WithdrawMarginMethod is at precompiles/layerxexchange/layerxexchange.go:52; perps accounts are at modules/perps/keeper/account.go:54."
affects = ["0x1015 layerxexchange"]
carry = "rewritten"

[decision.26]
title = "Signer of the agent-host web payer"
value = "The embedded-wallet attestor set signs for the agent-host web payer, one attestor set for all custody."
basis = "The xweb attestor set verifies observations (modules/xweb/keeper/fulfil.go:17)."
affects = ["agentd-host", "embedded wallet attestors", "0x101A payer grants"]
carry = "kept"

[decision.27]
title = "Typed exact payment at 0x101A"
value = "payExact is a typed send carrying a payment reference and emitting PaymentExact."
basis = "x402 conformance stays unchanged (services/interop/specs/conformance/x402/README.md:9)."
affects = ["0x101A layerxledger", "x402 seller"]
carry = "kept"

[decision.28]
title = "xweb error naming"
value = "Go-origin xweb errors use LXP_XWEB_* names and kernel-origin (origin 2) errors keep kernel codes."
basis = "Go-origin xweb errors use LXP_XWEB_* names (modules/xweb/types/errors.go:43)."
affects = ["0x1019 xweb"]
carry = "kept"

[decision.29]
title = "One stream state"
value = "Agent streams 0x0906 keep no store and execute through the layerxpay 0x101B stream keeper."
basis = "0x0906 streams is listed at precompiles/setup.go:71 and the stream id layout is at include/layerx/lx_stream.h:26."
affects = ["0x0906", "0x101B layerxpay"]
carry = "kept"

[decision.30]
title = "Gas rule across the new precompiles"
value = "Every new precompile charges from a fixed per-method gas table built on DefaultGasCost; perps and pricefeed follow the same rule."
basis = "DefaultGasCost is at precompiles/common/precompiles.go:441; perps states its fixed gas at precompiles/perps/perps.go:2."
affects = ["0x101A", "0x101B", "0x101C", "0x101D", "0x0901-0x0908", "0x1015", "0x1019"]
carry = "rewritten"

[decision.31]
title = "computeClearing and scoreBatch ABI form"
value = "0x0902 computeClearing and 0x0904 scoreBatch use the struct ABI (tuple arrays) only, one selector per method."
basis = "computeClearing is declared once at precompiles/layerxagent/clearing/clearing.go:22."
affects = ["0x0902", "0x0904"]
carry = "kept"

[decision.32]
title = "submitPrice signer rule"
value = "0x0903 submitPrice writes the exchange keeper oracle store for legacy consumers (decision.239); the perps venue reads prices from pricefeed 0x1020 and pushOracle on 0x1015 is void (decision.304)."
basis = "Pricefeed is at precompiles/pricefeed/pricefeed.go:23; the pushOracle refusal is exercised at precompiles/perps/switch_test.go:711."
affects = ["0x0903", "0x1015 oracle store"]
carry = "rewritten"

[decision.33]
title = "TEE attestor roots"
value = "0x0907 uses the xweb attestor set as its registered roots."
basis = "One attestor set is verified at modules/xweb/keeper/fulfil.go:17."
affects = ["0x0907", "0x1019 xweb attestor set"]
carry = "kept"

[decision.34]
title = "TEE signer threshold and key type"
value = "0x0907 verifies threshold signatures, 3 of 5, over secp256k1 attestor keys."
basis = "Attestor signatures are verified by verifySignatures (modules/xweb/keeper/fulfil.go:17)."
affects = ["0x0907", "embedded wallet attestors"]
carry = "kept"

[decision.35]
title = "Result-code retryability source of truth"
value = "The result-code registry table is the single source of truth for retryability; the Rust mirror in result.rs and every SDK decoder are regenerated from it, including the seventeen divergent codes and LXP_MODULE_DISABLED."
basis = "LXPCodeName derives registry names from the kernel enum (precompiles/common/lxp_errors.go:318-323)."
affects = ["stale-spec 10.1.1", "result.rs", "SDK result decoders"]
carry = "kept"

[decision.36]
title = "Receipt key range overlap"
value = "Primary and standby receipt key ranges may overlap, as the clients and sequencer contracts state; acceptance 6.72.2 forbids overlap only between two primary ranges."
basis = "modules/sequencer/keeper/receipt_keys.go:75 states that primary and standby keys may overlap."
affects = ["stale-spec acceptance.6.72.2", "stale-spec 6.5.32"]
carry = "kept"

[decision.37]
title = "Stream rate update ordinal 8"
value = "Ordinal 8 is admitted; the owning task follows the one-task-per-file-per-wave rule of the v2 graph rather than the stale task id."
basis = "LX_STREAM limits are at include/layerx/lx_stream.h:14 and the StreamRateUpdated event at precompiles/layerxpay/abi_test.go:127."
affects = ["stale-spec 2.2.2"]
carry = "rewritten"

[decision.38]
title = "Blob store key layout"
value = "Blob store rows live under key prefix 0x05; the storage contract records this layout."
basis = "Blob rows keep their single prefix; the program store layout is read by modules/lxphost/read.go:1."
affects = ["stale-spec 13.2.2"]
carry = "kept"

[decision.39]
title = "Payments and exchange governance surfaces"
value = "layerxpay governance is its Params.Paused default true (modules/layerxpay/types/params.go:14, :22); layerxexchange gains no new governance surface because it is replay-only after v6.12.0 (decision.323)."
basis = "modules/layerxpay/types/params.go:14; modules/layerxexchange/types/params.go:12."
affects = ["stale-spec 13.3.14"]
carry = "rewritten"

[decision.40]
title = "Kernel result codes -737 to -739"
value = "Open: the three codes -737..-739 are still missing from include/layerx/lxp_result.h and must be added with the names the merge code uses."
basis = "include/layerx/lxp_result.h:1 declares the result enum without -737..-739."
affects = ["stale-spec 10.0.4"]
carry = "kept"

[decision.41]
title = "Subscription lag signalling"
value = "A lag object carrying the dropped count is the final subscription overflow behaviour; no server-side close is added to the pinned RPC notifier."
basis = "A receipt-log listener that falls behind keeps its registration: logs it cannot take are dropped and counted in lagged, which is reported ahead of its next log (rpc/filter.go:241-262, :356)."
affects = ["stale-spec 0.21", "stale-spec 13.3.2"]
carry = "kept"

[decision.42]
title = "Cross-module grant state stage"
value = "A grant-state stage in lxp_module_ctx.c lets receive path 0x101A see budget pull draws; a new kernel task delivers it."
basis = "Pulls and receives draw on one ledger through lxp_module_ctx (modules/lxphost/ctx.go:50)."
affects = ["stale-spec 2.4.1"]
carry = "kept"

[decision.43]
title = "Activity proof verifier"
value = "A chain-header and ICS23 verifier reachable through the registry is delivered by a new task; 4.2.14 requires it and layerx-proof retires only after lease.rs and expiry.rs use it."
basis = "Proof verification stays in services/agent/crates/layerx-proof/src/checkpoint.rs:175 until the replacement verifier lands."
affects = ["stale-spec 4.2.14"]
carry = "kept"

[decision.44]
title = "Agent signing and client interfaces"
value = "Not carried as a task-ownership ruling: each interface is owned by the v2 task that touches its file in its wave; the interfaces listed stay required."
basis = "services/agent/crates/layerx-proof/src/receipt.rs:273 is the receipt decoder the gas station uses."
affects = ["stale-spec 6.5.1", "stale-spec 6.5.3", "stale-spec 6.5.41", "stale-spec 6.5.42"]
carry = "rewritten"

[decision.45]
title = "Committed proof codecs"
value = "Not carried as a task-ownership ruling; one shared committed fixture set and codec remains the rule."
basis = "services/agent/crates/layerx-proof/src/checkpoint.rs:175."
affects = ["stale-spec 6.5.19", "stale-spec 6.5.27", "stale-spec 6.5.29", "stale-spec 6.5.30", "stale-spec 6.5.36", "stale-spec 8.5.31"]
carry = "rewritten"

[decision.46]
title = "Sequencer handover encoding"
value = "Not carried as a task-ownership ruling; MsgSequenceBatch transaction-0 encoding stays one node interface."
basis = "A sealed block carries its MsgSequenceBatch as transaction 0 (consensus/internal/state/execution.go:33-35) and the sequential acceptor delivers each transaction through one deliver path (node/sequencer/accept.go:16)."
affects = ["stale-spec 9.2.6", "stale-spec 9.2.8", "stale-spec 9.2.9"]
carry = "rewritten"

[decision.47]
title = ".NET and Swift gates"
value = "Folded into the sandbox profiles: the dotnet and swift profiles of the programme manifest carry their toolchains (task 17.6.1)."
basis = "The repository ships a .NET SDK (sdk/platform/dotnet/LayerX.Sdk.csproj:1) and a Swift SDK (sdk/platform/swift/Package.swift:1) whose gates need the dotnet and swift toolchains."
affects = ["stale-spec 6.5.28"]
carry = "rewritten"

[decision.48]
title = "PXVE v1 dev attestation envelope"
value = "big-endian header of 95 bytes (magic PXVE, version 0x01, family, debug, mrtd, reportData, u64 timestamp, u64 chainId, u64 nonce), u8 count n, n 65-byte low-s secp256k1 signatures over keccak256(data[0:95]) in strictly ascending signer order; signers drawn from the xweb attestor set at its threshold; length exactly 96 + 65n"
basis = "verifySignatures is at modules/xweb/keeper/fulfil.go:17."
affects = ["stale-spec 6.2.6", "stale-spec 13.3.11"]
carry = "kept"

[decision.49]
title = "Pure agent helpers gate on the agent module"
value = "mergePrecompileGate names layerxagent for 0x0901, 0x0902, 0x0904 and 0x0908"
basis = "The evm keeper refuses an activation address with no module (modules/evm/keeper/keeper.go:217-227); mergePrecompileGate names layerxagent (node/upgrades.go:521-540)."
affects = ["stale-spec 10.0.1", "stale-spec 10.6.1"]
carry = "kept"

[decision.50]
title = "AI reputation history retention prune runs at epoch opening"
value = "Completed reputation summaries are pruned when an epoch opens, retaining 32 rows."
basis = "programs/crates/layerx-programs-ai-market/src/rewards.rs:1600-1609; the stale bare src/ and tests/ citations do not exist at HEAD."
affects = ["stale-spec 4.2.12"]
carry = "rewritten"

[decision.51]
title = "Merge plan name constant in the precompiles package"
value = "precompiles.MergeUpgrade (precompiles/setup.go:50) is a second declaration of node.MergeUpgrade (node/upgrades.go:117), both \"v7.0\"; precompiles/setup_test.go:194 requires the two to be equal, and the merge entries carry the plan through the registered constructors and their MergeUpgrade version key (precompiles/setup.go:117-199), not through PrecompileLastUpgrade."
basis = "precompiles/setup.go:50 and node/upgrades.go:112 both declare \"v7.0\"; precompiles/setup_test.go:194 requires equality."
affects = ["stale-spec 0.1", "stale-spec 10.0.1", "stale-spec 10.6.1"]
carry = "kept"

[decision.52]
title = "Gas station: a finalized earlier publication never consumes the renewal tick"
value = "The rate publisher's recovery and settlement bookkeeping is separate from renewal scheduling; the existing assertion that publish returns the old publication after a late commit encoded the fault reported in issue 578 and is replaced by the settlement checks plus a fresh rate evaluation, which is a spec correction and not a weakening"
basis = "The rate publisher is in services/interop/crates/layerx-gas-station/src/tx.rs:245."
affects = ["stale-spec 0.110", "stale-spec 7.0.6"]
carry = "kept"

[decision.53]
title = "Autobahn receiptsRoot is the same-block results root"
value = "Landed: block_results under Autobahn loads the stored FinalizeBlock responses."
basis = "consensus/internal/rpc/core/blocks.go:271 calls LoadFinalizeBlockResponses."
affects = ["stale-spec 0.51", "stale-spec 0.112"]
carry = "kept"

[decision.54]
title = "KMS secp256k1 key kind for EVM sender handles"
value = "The internal KMS gains a secp256k1 key kind for EVM sender handles: handle prefix kms-secp256k1-, address = the last 20 bytes of keccak256 of the uncompressed public key, deterministic RFC 6979 ECDSA over a 32-byte prehash returning r, low s and the recovery id. Ed25519 stays the key kind for kernel identities, and every existing Ed25519 handle, request and response is unchanged."
basis = "The KMS seals secp256k1 scalars (services/platform/hosted/internal/src/kms.rs:25)."
affects = ["stale-spec 7.0.8"]
carry = "kept"

[decision.55]
title = "Wallet SDK formatting configuration"
value = "sdk/wallet has no prettier configuration of its own and formats with apps/wallet/.prettierrc (npx prettier --config apps/wallet/.prettierrc --write on the touched files); every task touching sdk/wallet applies it to its touched files in its format step, so the SDK reaches the wallet style file by file."
basis = "apps/wallet/.prettierrc:1 is the shared configuration."
affects = ["stale-spec 5.2.5", "stale-spec 0.116"]
carry = "kept"

[decision.56]
title = "addr 0x1004 revert reasons use the registry LXP_ADDR codes"
value = "addr 0x1004 emits the LXP_ADDR_* codes of the address-table registry (section (b)) for its refusals: LXP_ADDR_EVM_NOT_BOUND for getLayerXDid of an unbound address and the eight LXP_ADDR_LAYERX_* codes for binding errors; the kernel codes LXP_UNKNOWN_DID, LXP_BAD_SIGNATURE, LXP_DUPLICATE_ENTRY, LXP_SEQUENCE_EXHAUSTED and LXP_NON_CANONICAL are not used at this address."
basis = "precompiles/common/lxp_errors.go:255-264 and precompiles/addr/addr_test.go:414."
affects = ["stale-spec 1.1.5", "stale-spec 10.2.1"]
carry = "kept"

[decision.57]
title = "CosmWasm transaction counter is the block position from the merge plan height"
value = "From the height the merge plan is done, every path that executes a transaction at a block position (App.DeliverTx for the synchronous, concurrent and sequencer paths, and the Giga per-transaction deliver function) sets the CosmWasm transaction counter to that position, so env.transaction.index of a contract is the transaction's index in the sealed block at the sequencer and at every validator; before that height no path sets it, as on the existing code, so historical blocks replay unchanged. SetTxPosition only places the context; the counter is set inside the deliver path."
basis = "The per-transaction deliver paths are node/abci.go:169 and node/abci.go:230."
affects = ["stale-spec 9.1.7", "stale-spec 0.118"]
carry = "kept"

[decision.58]
title = "Stream rate change is activity ordinal 8 end to end"
value = "Stream rate change is activity ordinal 8 in every layer: the stream result codec stores and loads ordinals 1 through 8 with the existing result layout, module_execute passes ordinal 8 to stream_execute_typed, the stored result of a rate change carries ordinal 8 and its replay returns that result, and a key stored for another ordinal or stream returns LXP_ERR_CONTEXT_MISMATCH in validate and in execute; lifecycle_load is exported and shared rather than copied. The test assertion that execute refuses ordinal 8 with LXP_ERR_UNKNOWN_ACTIVITY described the state before the rate change executed and is replaced by acceptance assertions, a spec correction and not a weakening."
basis = "StreamRateUpdated is exercised at precompiles/layerxpay/abi_test.go:127."
affects = ["stale-spec 2.3.2"]
carry = "kept"

[decision.59]
title = "Checkpoint settlement header without the retired policy field"
value = "make build writes LXP_CHECKPOINT_MAXIMUM_ATTESTATION_DELAY_SECONDS from a Makefile constant of 3600 (the prior value) instead of reading checkpoint-settlement.json; the rule and constant leave with the guarantor runtime"
basis = "Makefile:29 sets CHECKPOINT_MAXIMUM_ATTESTATION_DELAY_SECONDS := 3600."
affects = ["stale-spec 0.122", "stale-spec 11.7.19"]
carry = "kept"

[decision.60]
title = "One serde_json pin"
value = "every Rust workspace pins serde_json =1.0.151 and programs/vendor is refreshed to match"
basis = "tools/platform/Cargo.toml:24 and programs/sdk/rust/Cargo.toml:17 pin serde_json =1.0.151."
affects = ["stale-spec 0.123", "stale-spec 0.114"]
carry = "kept"

[decision.61]
title = "FinalizeBlock response retention"
value = "the giga router prunes FinalizeBlock responses below the positive block RetainHeight; RetainHeight 0 keeps everything"
basis = "FinalizeBlock responses are loaded at consensus/internal/rpc/core/blocks.go:271."
affects = ["stale-spec 0.119"]
carry = "kept"

[decision.62]
title = "Fatal kernel codes in the exchange code table"
value = "Fatal rows give an empty code name; the rule binds every kernel code table, the exchange table only for legacy replay."
basis = "precompiles/common/lxp_errors.go:318-323."
affects = ["stale-spec 3.2.8", "stale-spec 3.5.1"]
carry = "rewritten"

[decision.63]
title = "Intent plan vector holder"
value = "Not carried as a task-ownership ruling; intent-plan-v1.json stays one fixture."
basis = "services/agent/sdk/typescript/test/intent.test.ts:30."
affects = ["stale-spec 6.5.36", "stale-spec 12.5.102"]
carry = "rewritten"

[decision.64]
title = "transactionsRoot verifier"
value = "in-crate ordered Merkle-Patricia root over layerx-crypto RLP and the existing sha3 keccak; no new dependency"
basis = "The agent workspace verifier is in services/agent/crates/layerx-proof/src/checkpoint.rs:175."
affects = ["stale-spec 6.6.5"]
carry = "kept"

[decision.65]
title = "History finality API removal order"
value = "Not carried as a task-ownership ruling; callers move before the function is removed, as the v2 requires edges order them."
basis = "tools/paxeer-x/retired_callers.json:2."
affects = ["stale-spec 6.6.11"]
carry = "rewritten"

[decision.66]
title = "Explorer paxeer-x page retirement"
value = "Not carried as a task-ownership ruling; the paxeer-x explorer pages retire before route maps are regenerated."
basis = "tools/paxeer-x/retired_callers.json:2."
affects = ["stale-spec 11.5.69", "stale-spec 11.5.67", "stale-spec 11.5.68"]
carry = "rewritten"

[decision.67]
title = "Guarantor header trim order"
value = "Not carried as a task-ownership ruling; the guarantor header retires after its runtime."
basis = "tools/paxeer-x/retired_callers.json:2."
affects = ["stale-spec 11.5.115", "stale-spec 11.7.19", "stale-spec 11.7.23"]
carry = "rewritten"

[decision.68]
title = "xweb program pair and the applied v6.10 state"
value = "the v6.10 handler writes paused=false through the params store; governance Unpause refuses an unset pair; InitGenesis refuses it only for a genesis carrying the merge plan height or a program pair field"
basis = "xweb refuses while paused (modules/xweb/types/errors.go:15)."
affects = ["stale-spec 5.2.1"]
carry = "kept"

[decision.69]
title = "newHeads receiptsRoot"
value = "newHeads and simulate serve the results root of block H (req 10.4); the autobahn subscribe test asserts that root"
basis = "consensus/internal/rpc/core/blocks.go:271."
affects = ["stale-spec 0.111"]
carry = "kept"

[decision.70]
title = "lxphost raw-key scan scope"
value = "TestReadBridgeNoRawKeys covers non-test files of modules/lxphost except accountmap.go"
basis = "modules/lxphost/read_test.go:22 defines TestReadBridgeNoRawKeys."
affects = ["stale-spec 1.1.13"]
carry = "kept"

[decision.71]
title = "layerxagent params"
value = "MaxJobsPerBlock 64, MaxJobGasLimit 10000000, MaxReasonBytes 256 and a callData size cap are governed params with these defaults, enforced in the keeper and the 0x0905 precompile"
basis = "modules/layerxagent/keeper/keeper.go:40 sets DefaultMaxJobsPerBlock 64."
affects = ["stale-spec 6.2.8", "stale-spec 6.2.5", "stale-spec 10.6.1", "stale-spec 0.129"]
carry = "kept"

[decision.72]
title = "Pay contract record views and stream rate event"
value = "record views return one named struct; StreamRateUpdated is kernel stream event type 8"
basis = "precompiles/layerxpay/abi_test.go:127."
affects = ["stale-spec 2.4.9", "stale-spec 0.130"]
carry = "kept"

[decision.73]
title = "Retained exchange intent selectors"
value = "getIntent and requestSettlement stay declared on layerxexchange and are served only for replay below v6.12.0; after it every exchange-intent call returns ErrRetired code 14 LXP_EXCHANGE_RETIRED (decision.324)."
basis = "GetIntentMethod is at precompiles/layerxexchange/layerxexchange.go:56; error codes end at 13 (modules/layerxexchange/types/errors.go:36)."
affects = ["stale-spec 11.5.190"]
carry = "rewritten"

[decision.74]
title = "Committed-proof verifier per language"
value = "each retirement task calls its language's sequencer receipt verifier instead of custodyproof Verify; for C bridge exit settlement is the block commit"
basis = "custodyproof/verify.go:260 accepts custody state proofs only."
affects = ["stale-spec 11.5.168", "stale-spec 11.5.169", "stale-spec 11.5.170", "stale-spec 11.5.171", "stale-spec 11.5.172", "stale-spec 11.5.173", "stale-spec 11.5.174", "stale-spec 11.5.175", "stale-spec 11.5.176", "stale-spec 11.5.177", "stale-spec 11.5.178", "stale-spec 11.5.183", "stale-spec 11.5.205", "stale-spec 11.5.232", "stale-spec 11.5.138", "stale-spec 11.5.139"]
carry = "kept"

[decision.75]
title = "Sequencer log ordinal"
value = "effect ordinal = logIndex + 1: effects are one-based, served logs zero-based"
basis = "The sequencer receipt is built in node/sequencer/accept.go:1."
affects = ["stale-spec 0.25"]
carry = "kept"

[decision.76]
title = "Indexer position migration"
value = "Not carried as a task-ownership ruling; position migration follows contracts/clients.md."
basis = "tools/paxeer-x/retired_callers.json:2."
affects = ["stale-spec 0.27"]
carry = "rewritten"

[decision.77]
title = "Prepared EIP-1559 fields order"
value = "Not carried as a task-ownership ruling."
basis = "services/agent/crates/layerx-proof/src/receipt.rs:273."
affects = ["stale-spec 6.5.1", "stale-spec 6.5.2"]
carry = "rewritten"

[decision.78]
title = "native_terminal_outcome evidence"
value = "Not carried as a task-ownership ruling; retained captures stay outside the checkout."
basis = "spec/layerx-merge/qualification.kvx:1."
affects = ["stale-spec 0.113"]
carry = "rewritten"

[decision.79]
title = "Explorer receipts heights"
value = "Not carried as a task-ownership ruling."
basis = "tools/paxeer-x/retired_callers.json:2."
affects = ["stale-spec 0.131", "stale-spec 8.7.20"]
carry = "rewritten"

[decision.80]
title = "8.73 acceptance vector"
value = "Not carried; acceptance ids are renumbered in v2."
basis = "services/agent/crates/layerx-proof/src/receipt.rs:273."
affects = ["stale-spec 8.5.36"]
carry = "rewritten"

[decision.81]
title = "Gateway position cursor ownership"
value = "Not carried as a task-ownership ruling; the gateway accepts the indexer position cursor."
basis = "page() in the hosted gateway history accepts the indexer next_cursor only when it parses as a Position (services/platform/hosted/gateway/src/history.rs:220, :236-239)."
affects = ["stale-spec 0.27", "stale-spec 7.5.6"]
carry = "rewritten"

[decision.82]
title = "Wallet SDK curve library version"
value = "sdk/wallet stays on the pnpm-locked @noble/curves 1.9.1 with ed25519.ExtendedPoint; the root package-lock.json does not govern the pnpm packages under services/wallet, and their gates run from the package directory with pnpm"
basis = "sdk/wallet/package.json:44 pins @noble/curves ^1.9.1 under the pnpm lock."
affects = ["stale-spec 0.125", "stale-spec 0.116"]
carry = "kept"

[decision.83]
title = "Oracle feeder transaction path"
value = "Acceptance 7039.1 governs: feeder pushes go sponsored through the gas station; the self-paid type-2 path of task 7.3.2 is the interim until task 0.141 lands, and the shared EVM sender gains prehash and EIP-7702 authorization signing in task 0.140 so no service re-reads the relayer key source"
basis = "The gas station builds executeSponsored batches only (services/interop/crates/layerx-gas-station/src/tx.rs:245)."
affects = ["stale-spec 7.3.2", "stale-spec 7.1.2", "stale-spec 0.140", "stale-spec 0.141"]
carry = "kept"

[decision.84]
title = "Model runner engine binding"
value = "The paxai worker's model runner (task 0.149) executes the engine pinned inside each (model, deployment) directory under PAXAI_RUNNER_MODELS; the repository bundles no inference engine and no model weights, so a gate host with an empty model directory exercises the recorded CapabilityMismatch path and the real engine path is exercised only where a pinned model directory is provisioned. The choice of engine and the first provisioned models are an operator decision recorded when they are provisioned."
basis = "services/platform/hosted/paxai-worker/src/bin/paxai-runner.rs:11."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "kept"

[decision.85]
title = "Giga block fee-token charge destination"
value = "After a giga block the fee-token charge is asserted at the fee-token holding account, not at the coinbase: EndBlock sweeps each coinbase's fee tokens to the fee collector (modules/evm/keeper/abci.go:165-178) and ProcessBlock routes the collector to the fee-token holding account (modules/evm/keeper/feecollect.go:17), which modules/evm/keeper/abci_test.go:119-121 requires; neither step is removed."
basis = "modules/evm/keeper/abci.go:165-178 sweeps coinbase fee tokens; the charge reaches the coinbase at node/app.go:2405."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "kept"

[decision.86]
title = "Curve library resolution in the wallet app"
value = "apps/wallet/tsconfig.json carries no @noble/* path mapping; each linked SDK source (sdk/wallet, services/agent/sdk/typescript) resolves its own pinned copy of @noble/curves, @noble/hashes and @noble/ciphers from its own package directory, and the app's own package pins follow only what apps/wallet/src imports."
basis = "sdk/wallet/package.json:44."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "kept"

[decision.87]
title = "Vendor-native quotes in the exchange interface"
value = "Acceptance 6.13.1-6.13.3 stand. Resolution 13.206 is narrowed: vendor-native TDX, SEV-SNP, SGX and NVIDIA H100 quotes are delivered by the task 6.7.1 widening, which verifies them through the vendor verifiers of task 0.154 against the governance-set roots, and the PXVE v1 dev envelope stays accepted beside them."
basis = "Vendor quote verification is delivered with the attestor widening (precompiles/layerxagent/teeattestor/teeattestor.go:103)."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "kept"

[decision.88]
title = "Malformed snapshot ring refusal in launchpad price history"
value = "Task 3.2.10 do_2 admits a third refusal: a stored market whose snapshot ring is shorter than SnapshotSlots or whose SnapshotIndex lies outside the ring is refused with ErrInvalidMarket. The preserved malformed-ring assertions in modules/launchpad/keeper/history_test.go stand unchanged."
basis = "modules/launchpad/keeper/swap_test.go:55 builds SnapshotSlots rings."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "kept"

[decision.89]
title = "Relay journal restore admits the local signer beyond the observation cap"
value = "Task 0.171 do_2 stands: ProgramExchange::restore bounds the retained map at MAX_OBSERVATION_SIGNATURES current signers besides the local signer's own entry, while MAX_OBSERVATION_SIGNATURES stays at 16 and the Ready limit is unchanged; accept prunes signers who left the roster before any snapshot."
basis = "services/interop/crates/x-websearch/src/kernel.rs:70 keeps MAX_OBSERVATION_SIGNATURES 16."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "kept"

[decision.90]
title = "eth_subscribe relays over the WebSocket entry; HTTP answers WebSocket required"
value = "The eth_subscribe relay to the sequencer of contracts/services.md S03 is the WebSocket entry ws::serve_evm (services/platform/hosted/gateway/src/ws.rs:450, routed at services/platform/hosted/gateway/src/main.rs:3787). An HTTP eth_subscribe answers -32004 WebSocket required at services/platform/hosted/gateway/src/rpc.rs:407, and the EVM relay refuses subscription methods with -32004 Subscriptions are not relayed at services/platform/hosted/gateway/src/paxeer.rs:174-175. Stale-spec task lines that say relay eth_subscribe at paxeer.rs:172 (stale 13.5.1 do_1, 7.5.2 do_6, 6.5.48 do_2, req.7005 ac_1, acceptance 7.5.3) read as the WebSocket relay with the HTTP refusal kept."
basis = "serve_evm is at services/platform/hosted/gateway/src/ws.rs:450; HTTP answers -32004 at services/platform/hosted/gateway/src/rpc.rs:407."
affects = ["stale-spec 13.5.1", "stale-spec 7.5.2", "stale-spec 6.5.48", "stale-spec 7.5.3"]
carry = "kept"

[decision.91]
title = "Explorer signature route vectors"
value = "The signature route proves rung receipted with the sequencer-layout cases of receipt_vectors.json (V1 and V2 with their pinnedKey). The kernel-layout vectors valid-0..2 answer 422 naming R3, as the verifier test of task 0.46 asserts, because their batch_id is not a sequencer height. A refusal that needs the client's predecessor pin (V3-seq-hash-mismatch at R6) is asserted at the verifier with its recorded prevSeqHash, not through the single-hash route."
basis = "services/agent/crates/layerx-proof/src/receipt.rs:273."
affects = ["stale-spec 8.5.37"]
carry = "kept"

[decision.92]
title = "Router sequence batch read"
value = "The unified router serves px_getSequenceBatch [height] answering tx 0 of the committed block and its Txs.Proof(0) under the header DataHash, so clients that reach the chain only through the router can run R7 batch coverage (contracts/clients.md (c) R7; receiptInclusion row of clients.md (c)) beside px_getCommit and px_getValidators."
basis = "Sequence batches are accepted in node/sequencer/accept.go:1."
affects = ["stale-spec 0.165", "stale-spec 0.166", "stale-spec 0.163"]
carry = "kept"

[decision.93]
title = "Hosted registry retirement is one compile unit"
value = "Tasks 11.5.163, 11.5.164 and 11.5.165 land as one change owned by task 11.5.163: the registry Config fields (services/platform/hosted/registry/src/lib.rs:46, :68-70), their readers (main.rs, routes.rs), the native deploy client (deployment.rs, node_state.rs) and the head attestation callers (routes.rs, node_state.rs) are retired together, with deployment answering as a 0x101D transaction and head evidence verified through the chain proof verifier of task 0.64."
basis = "services/platform/hosted/registry/src/lib.rs:46."
affects = ["stale-spec 11.5.163", "stale-spec 11.5.164", "stale-spec 11.5.165", "stale-spec 7.5.13"]
carry = "kept"

[decision.94]
title = "AI market guest size is met by a binaryen post-pass"
value = "The wasm32 release guest of layerx-programs-ai-market is post-processed by binaryen wasm-opt -Oz --strip-debug --strip-producers inside Makefile paxai-host-boundary-build before the LXP_MAX_PAYLOAD_BYTES - 104 size check (task 0.160); the protocol payload bound stays 524288 and no program source is cut for size. A build host without wasm-opt refuses the guest build."
basis = "programs/crates/layerx-programs-ai-market/Cargo.toml:1."
affects = ["stale-spec 0.160", "stale-spec 0.161", "stale-spec 4.2.11", "stale-spec 4.2.12"]
carry = "kept"

[decision.101]
title = "Idempotency replay retires; the actor sequence is the replay guard"
value = "The kernel stops looking up and recording idempotency entries at wave 3 and deletes the table at wave 6; a reused sequence returns LXP_ERR_SEQUENCE_REUSED and a reused key with the next sequence executes."
basis = "The stale spec bounded the table by a retention window, but HEAD lookups at src/protocol/lxp_kernel.c:3517, :6866 and :7092 serve only the retired daemon replay path and the idempotency retirement (req 11013) removes it."
affects = ["task.1.2.1", "task.1.2.2", "task.1.2.3"]

[decision.102]
title = "Capacity ledger retires whole"
value = "The capacity types, codecs and kernel calls of include/layerx/lxp_kernel.h:725-860 and the module context hold capacity_grants_hold (src/protocol/lxp_module_ctx.c:1145-1197) with its call at src/protocol/lxp_module_ctx.c:1261 are deleted; blob admission no longer reserves capacity."
basis = "Only cmd/layerxd/lxp_daemon_lni.c installs and reconciles the ledger, and cmd/layerxd retires; tests/programs/test_blob_admission.c:1351 and tests/programs/test_paxai_native_gaps.c:962 are the remaining callers."
affects = ["task.1.2.4"]

[decision.103]
title = "Snapshot keeps the idempotency count word at zero"
value = "lxp_snapshot_write keeps the u32 count word of the idempotency section and writes 0; lxp_snapshot_load refuses a nonzero count, so the snapshot layout keeps its offsets."
basis = "src/state/lxp_snapshot.c:557-572 writes the count before the module rows; dropping the word would shift every later offset that src/state/lxp_snapshot.c:898-919 parses."
affects = ["task.1.2.2", "task.1.6.1"]

[decision.104]
title = "Bridge and web module ids stay reserved"
value = "LXP_MODULE_BRIDGE and LXP_MODULE_WEB keep their enumerators in include/layerx/lxp_module.h:14-27 while their genesis rows and modules leave."
basis = "Module ids are bound into committed module_kv keys and receipt encodings; reusing ids 3 and 11 would let old rows decode as a new module."
affects = ["task.1.18.1", "task.1.18.2", "task.1.0.2"]

[decision.105]
title = "Bridge reserve credit leaves the kernel"
value = "lxp_ctx_bridge_credit and lxp_ledger_apply_bridge_credit are deleted with the bridge credit and light-client sources."
basis = "The credit path at src/protocol/lxp_module_ctx.c:2220-2420 admits guarantor-certified custody credits (custody-credit req 11019) and no kept module calls it."
affects = ["task.1.2.4", "task.1.2.5", "task.1.19.3"]

[decision.106]
title = "Fee relay entries retire; fee governance staging stays"
value = "Only the fee relay decode, validate and execute entries of src/modules/programs/registration.c:96, :143 and :194 are refused; staging, pending, activation, observation, runtime resolution and the proposal validator stay stable."
basis = "src/modules/governance/lxp_governance.c:131 and :240 call lxp_programs_fee_governance_proposal_validate, and lxp_programs_fee_governance_resolve_runtime has 53 references in 29 files."
affects = ["task.1.14.3", "task.1.15.2"]

[decision.107]
title = "Governance keeps its genesis key after handover leaves"
value = "The kernel holds a governance_authority key set at genesis in place of the handover state; handover execution is removed at wave 1 and the handover files are deleted at wave 6."
basis = "src/protocol/lxp_handover.c serves the guarantor hand-off only, while governance proposals still need an authority key."
affects = ["task.1.17.1", "task.1.17.2", "task.1.17.3"]

[decision.108]
title = "Guarantor includes leave kernel headers before anchor 1.0.3"
value = "include/layerx/lxp_bridge.h:5 and src/protocol/lxp_receipt_verify.c drop their guarantor includes by wave 4 so the guarantor header can be deleted after the anchor."
basis = "J22 task 1.38.1 deletes the guarantor sources and requires anchor 1.0.3; any kernel include left after it breaks the build."
affects = ["task.1.19.1", "task.1.16.2", "task.1.0.3"]

[decision.109]
title = "Payer grant host read is coordinated with domain 1 host work"
value = "lx_asset_payer_grant_read and the receive and grant stores are deleted at wave 6 after J22 task 1.30.1 removes ReadPayerGrant from modules/lxphost/read.go:416."
basis = "The host reader is a domain-1 path owned by J22; the kernel deletion must not land before it."
affects = ["task.1.12.1"]

[decision.110]
title = "Qualification table drops to 49 entries"
value = "include/layerx/lxp_qualification.h lists 49 qualification cases after the receive, budget pull and replay cases leave."
basis = "tests/qualification/lxp_qual_replay.c:28-45 enumerates the HEAD table; the removed cases exercise deleted paths."
affects = ["task.1.12.3"]

[decision.111]
title = "Module KV and staged write bounds are 4096 and 512"
value = "LXP_KERNEL_MAX_MODULE_KV becomes 4096 and LXP_MODULE_MAX_STAGED_WRITES 512; encodings of states within the old bounds are unchanged."
basis = "A 128-lease expiry sweep stages about 384 writes, above the HEAD bound at include/layerx/lxp_kernel.h:21."
affects = ["task.1.16.3"]

[decision.112]
title = "Asset binding authority replaces per-activity signature checks for bound hosts"
value = "lx_asset_runtime gains bool binding_authority; when set, asset issuance and account stages skip only the activity signature check."
basis = "The host binds the verified authority before execution (domain-2 request), so the duplicate check at src/protocol/lxp_module_ctx.c:588 and :646 rejects host-signed activities."
affects = ["task.1.11.1"]

[decision.113]
title = "Module ids are frozen at the wave-2 anchor"
value = "The eleven enumerators and LXP_MODULE_RESERVED_COUNT of include/layerx/lxp_module.h:14-27 are pinned by tests/codec/lxp_test_surface_frozen.c."
basis = "Hosts built at wave 2 compile against these values; later waves may only retire modules while keeping their ids (decision.104)."
affects = ["task.1.0.2"]

[decision.114]
title = "Daemon header deletion lands at wave 6"
value = "include/layerx/lxp_daemon.h is deleted at wave 6 after its in-scope includers are removed; out-of-domain includers are wiring requests."
basis = "tests/test_layerxd.c:3, tools/platform/emulator/core/emulator_core.c:15, services/agent/tests/boundary/node/layerxd_lni.c:6 and tests/bridge/test_credit_admission.c:4 include it."
affects = ["task.1.18.3"]

[decision.115]
title = "Authority grant codecs stay"
value = "lxp_grant_encode, lxp_grant_id_compute and lxp_grant_decode of include/layerx/lxp_authority.h:80-141 stay stable."
basis = "The kept governance module and src/state/lxp_authority.c use them; they share only a name prefix with the retired payer grant store."
affects = ["task.1.12.1"]

[decision.116]
title = "Native receipt authority is a 151-byte V2 record keyed by block height"
value = "lxp_verified_receipt_authority_facts and the program arbiter authority become version 2: version, network, protocol version, module, operation, result, block height and four 32-byte hashes; the sequencer and batch window fields leave."
basis = "wiring.J51.8 asks for the V2 emitter at src/modules/programs/call.c:930 to match RawNativeReceiptAuthorityV2 of the programs runtime, and the sequencer authorization behind src/protocol/lxp_receipt.c:1039 retires."
affects = ["task.1.17.4"]

[decision.121]
title = "Settlement-chain client retired whole"
value = "Every src/paxeer file and include/layerx/lxp_paxeer.h retire; no paxeer declaration is kept for a later bridge."
basis = "src/paxeer/lxp_bond_client.c:128 and src/paxeer/lxp_paxeer_client.c:140 implement the guarantor bond and checkpoint submission only; checkpoints retire with the guarantor set."
affects = ["task.1.32.1", "task.1.32.2", "task.1.32.3", "task.1.32.4", "task.1.32.5", "task.1.38.1"]

[decision.122]
title = "Oracle observation codec split from the adapter"
value = "lx_oracle_observation_encode and lx_oracle_observation_sign move to src/network/lx_oracle_codec.c; the adapter loop and transport encoders retire."
basis = "src/modules/perps/lx_oracle_intake.c:55 and src/modules/perps/lx_perps_command.c:72 call the encoder and signer from the kept perps module."
affects = ["task.1.29.1", "task.1.29.2", "interface.1.c-lx-oracle-observation-encode", "interface.1.c-lx-oracle-observation-sign"]

[decision.123]
title = "Kernel admission kept, sequencer queue retired"
value = "lxp_admit_activity and lxp_activity_check_timestamp_bound stay in src/sequencer/lxp_admission.c; the admission queue and allocator retire."
basis = "src/protocol/lxp_kernel.c:3530 calls lxp_admit_activity on every execution and src/state/lxp_authority.c:764 calls the timestamp bound."
affects = ["task.1.28.1", "task.1.28.2", "task.1.28.3"]

[decision.124]
title = "Retired log kinds refused on append and readable on read"
value = "lxp_log_append refuses kinds 3, 6, 8 and 9; lxp_log_read and recovery keep accepting kinds 1..9."
basis = "src/storage/lxp_log.c:28 valid_kind serves both directions, and src/protocol/lxp_handover.c:1076 still reads LXP_LOG_BATCH_BODY records of existing segments."
affects = ["task.1.27.1", "interface.1.fmt-kernel-log-segment"]

[decision.125]
title = "Host loads only the modules an activity can read"
value = "branch.load, loadBlobs and the read bridge iterate 0x01 and 0x05 prefixes per module of the loading set instead of the whole store."
basis = "modules/lxphost/ctx.go:134 and modules/lxphost/host.go:816 scan every row of the prefix on each execution."
affects = ["task.1.22.1", "task.1.22.2", "task.1.39.1"]

[decision.126]
title = "Proof codec primitives stay stable"
value = "DecodeMerkleProof, MaxMessageBytes, MaxStateWitnessBytes, the batch header codec and WithdrawalEffect stay; only checkpoint, inclusion and discovery verifiers retire."
basis = "layerxproof/codec/receipt.go:16 derives MaxSequencerEffects from MaxMessageBytes and layerxproof/verify/withdrawal.go:121 returns WithdrawalEffect."
affects = ["task.1.36.1", "task.1.36.2", "interface.1.go-layerxproof-verify-withdrawal-effect", "interface.1.go-layerxproof-codec-decode-merkle-proof"]

[decision.127]
title = "Legacy idempotency rows are ignored, not migrated"
value = "After the idempotency table retires the host neither reads nor deletes 0x04 rows, and the 0x04 prefix stays reserved."
basis = "modules/lxphost/ctx.go:65 declares idempotencyPrefix and modules/lxphost/ctx.go:281 writes its rows at HEAD."
affects = ["task.1.25.1", "task.1.39.1", "interface.1.key-lxphost-idempotency-j22"]

[decision.128]
title = "Host node pool ceiling"
value = "Config.Workers is 1..16 with 0 meaning 1; each node keeps the 4 MiB arena."
basis = "modules/lxphost/host.go:16 fixes LXPHOST_ARENA_BYTES at 4194304 per node, so 16 nodes bound host memory at 64 MiB of arenas."
affects = ["task.1.26.1", "task.1.39.2", "interface.1.go-lxphost-config-j22"]

[decision.129]
title = "Kernel headers are deleted after their definitions"
value = "The seven retired headers and the trims of lxp_batch.h, lxp_history.h, lxp_tools.h and lxp_crypto.h land in two ordered tasks, 1.38.1 then 1.38.2, that require every C retirement task."
basis = "Makefile:44 builds LIB_SOURCES with find over src, so a deleted source leaves the archive at once while its header still compiles until the includers move."
affects = ["task.1.38.1", "task.1.38.2"]

[decision.130]
title = "Batch header format kept"
value = "The 354-byte batch header codec and lxp_batch_verify_signature stay; sealing, signing, the body archive and eligibility retire."
basis = "src/protocol/lxp_receipt.c:1065 decodes the header and src/protocol/lxp_receipt.c:1068 verifies its signature for receipt verification."
affects = ["task.1.35.1", "interface.1.fmt-batch-header", "interface.1.c-lxp-batch-verify-signature"]

[decision.131]
title = "Signature validity is computed, binding authority is explicit"
value = "The host stops forcing signature_valid; an unsigned activity is accepted only with the node-verified binding flag that also sets binding_authority."
basis = "modules/lxphost/host.go:468 sets execution->signature_valid = true for every activity at HEAD."
affects = ["task.1.23.1", "task.1.23.2", "task.1.26.3"]

[decision.132]
title = "Host executes on a node pool"
value = "The single mutex and node of Host are replaced by a channel of nodes shared by HostExecute and the read bridge."
basis = "modules/lxphost/host.go:583 declares Host with one sync.Mutex and one node, so every execution and read serialises."
affects = ["task.1.26.1", "task.1.39.2", "interface.1.go-lxphost-host-j22"]

[decision.133]
title = "Daemon header retires with the daemon"
value = "include/layerx/lxp_daemon.h retires with cmd/layerxd; the cmd retirement is a wiring request to domain 5."
basis = "include/layerx/lxp_daemon.h:9 and include/layerx/lxp_daemon.h:12 include the retired guarantor and settlement headers."
affects = ["task.1.38.1"]

[decision.134]
title = "Batch body records retire although handover reads them"
value = "LXP_LOG_BATCH_BODY appends stop; the handover reader keeps parsing historic body records."
basis = "src/protocol/lxp_handover.c:1076 reads LXP_LOG_BATCH_BODY records written before the retirement."
affects = ["task.1.35.2", "task.1.27.1", "interface.1.fmt-batch-body-archive"]

[decision.135]
title = "Batch signature verification moves to the header codec"
value = "lxp_batch_verify_signature moves from src/sequencer/lxp_batch_seal.c to src/sequencer/lxp_batch_header.c with an unchanged declaration."
basis = "src/protocol/lxp_receipt.c:1068 is the kept caller and src/sequencer/lxp_batch_seal.c:100 is the definition at HEAD."
affects = ["task.1.35.1"]

[decision.136]
title = "Kernel fee exposed in the host receipt"
value = "Receipt gains FeeCharged copied from the kernel receipt fee_charged."
basis = "include/layerx/lxp_receipt.h:90 holds fee_charged and modules/lxphost/host.go:55 lxphost_outcome omits it at HEAD."
affects = ["task.1.21.3", "interface.1.go-lxphost-receipt-j22"]

[decision.137]
title = "Retirement is proven on build products"
value = "C retirements are checked against the defined symbols of build/liblayerx.a and Go retirements against compiled export data, not by source text scans."
basis = "Makefile:46 names the build/liblayerx.a archive the host links and Makefile:44 selects its sources."
affects = ["task.1.21.1", "task.1.21.2"]

[decision.190]
title = "The golden replay release gate is kept and ported"
value = "Release gates are never deleted (No Weakening); wiring.J21.4 asks domain 16 task 16.98.1 to port tests/replay/lxp_test_golden_replay.c off lxp_kernel_replay to a local lxp_module_ctx_init loop, and its Makefile rule and replay-matrix call stay."
basis = "tests/replay/lxp_test_golden_replay.c:121 calls lxp_kernel_replay; the rule is Makefile:374-381 and the release gate scripts/ci/replay-matrix.sh:25-27."
affects = ["1.4.5", "16.98.1"]

[decision.191]
title = "Wiring requests with no owner after merges are dropped"
value = "wiring.J23.6 (with task 2.7.5) and wiring.J52.13 are deleted because the fulfilling work was already merged into other tasks; their requesters keep no do line that depends on them."
basis = "Idempotency is kernel-owned at src/state/lxp_idempotency.c:128."
affects = ["2.7.4", "13.32.1"]

[decision.192]
title = "The wave-6 host pool task fills the height authority index"
value = "lxp_verified_receipt_index_add_height_authority gets its caller in task 1.26.1, because modules/lxphost/host.go is owned by a domain-1 task in every wave; domain 13 must place ReceiptAuthorities on host activities it submits."
basis = "lxphost_execute is modules/lxphost/host.go:446 and the kernel execution reads verified_receipts at include/layerx/lxp_kernel.h:220."
affects = ["1.26.1", "1.17.4"]

[decision.201]
title = "One shared kernel host over its own host store key; module stores hold params only"
value = "node/app.go constructs one lxphost.Host over a new layerxhost store key shared by the layerxledger and layerxauth keepers; each module store keeps only ParamsKey 0x01 and KernelKVPrefix is retired."
basis = "Host prefixes 0x01..0x06 at modules/lxphost/ctx.go:62-66 overlap the layerxledger ParamsKey and KernelKVPrefix at modules/layerxledger/types/keys.go:18-21, and NewHost (modules/lxphost/host.go:600) has no production caller."
affects = ["2.3.1", "2.6.1", "2.14.4", "2.14.5"]

[decision.202]
title = "Idempotency is kernel-owned"
value = "Idempotency records live in the host store under prefix 0x04 and are pruned by the kernel; the keeper-level IdempotencyPrefix, IdempotencyBySequencePrefix, IdempotencyKey and IdempotencyBySequenceKey are retired, and IdempotencyRetention stays a layerxauth param that no host setter carries to the kernel."
basis = "The host writes idempotency entries at modules/lxphost/ctx.go:281 and the kernel prunes them at src/state/lxp_idempotency.c:128 from the retention field of include/layerx/lxp_state.h:42; the module keys at modules/layerxauth/types/keys.go:21-35 are used only by a test."
affects = ["2.1.6", "2.6.4", "2.14.4"]

[decision.203]
title = "Pause routing goes through the layerxgov pause scope with revokeGrant as the exit"
value = "Every keeper write calls CheckPauseScope with the ABI method name; views never check pause; revokeGrant is the only exit path of both modules; layerxauth code 11 is retired because refusals carry layerxgov code 735."
basis = "CheckPauseScope is defined at modules/layerxgov/types/proposal.go:38 with empty exit sets for both modules at modules/layerxgov/types/proposal.go:34-35, and layerxgov registers LXP_PAUSED_SCOPE 735 at modules/layerxgov/types/proposal.go:26 while layerxauth duplicates it as code 11 at modules/layerxauth/types/errors.go:17."
affects = ["2.1.7", "2.3.3", "2.6.3", "2.12.3"]

[decision.204]
title = "Bank mirror under a native layerx denom"
value = "Each kernel asset mirrors into bank as layerx/<64 lowercase hex of the asset id>; register mints the cap, or 2^128-1 when unbounded, to the bank address of the issuance account; every transfer leg becomes a bank SendCoins; the layerxledger module account holds Minter and Burner."
basis = "Tokenfactory subdenoms are capped at 44 characters (modules/tokenfactory/types/denoms.go:17), too short for a 64-digit asset id, and kernel accounts map to bank addresses through BankAddress (modules/lxphost/accountmap.go:78) with IssuanceAccountID at modules/lxphost/accountmap.go:64."
affects = ["2.1.5", "2.3.5", "2.0.3"]

[decision.205]
title = "Global sequence comes from a host export"
value = "Keepers set the activity global sequence from a NextSequence export of lxphost so that two activities in one block never reuse a sequence."
basis = "newBranchCtx at modules/lxphost/ctx.go:84 refuses a sequence not above lastSequence (modules/lxphost/ctx.go:111), which is unexported."
affects = ["2.3.4", "2.6.4"]

[decision.206]
title = "The EVM DID binding replaces the envelope signature"
value = "On the EVM path the actor is the DID bound to the caller through 0x1004; the host passes a binding flag in KernelAuthority so the kernel skips the ed25519 envelope signature check while keeping the controller, key and context checks."
basis = "The kernel verifies the envelope signature at src/modules/asset/lx_asset_execution.h:184 and the host writes the authority at modules/lxphost/host.go:229; bindings are kept by modules/evm/keeper/layerx_binding.go:18-56."
affects = ["2.3.2", "2.6.2"]

[decision.207]
title = "Receipts carry events and transfer legs"
value = "lxphost.Receipt gains Events and Transfers decoded from the kernel receipt so keepers can emit logs and mirror bank legs."
basis = "Receipt at modules/lxphost/host.go:574-581 carries only the result code, sequence, timestamp, state roots and encoded bytes."
affects = ["2.3.5", "2.3.6", "2.6.5"]

[decision.208]
title = "Precompile packages self-register as merge constructors"
value = "precompiles/layerxledger and precompiles/layerxauth register NewMergePrecompile through RegisterMergeConstructor from init, declare their own keepers accessor interfaces, revert with WithLXPReasons and charge WithGasTable rows with the provisional gas numbers."
basis = "RegisterMergeConstructor is defined at precompiles/setup.go:89 and newMergePrecompiles checks address and name at precompiles/setup.go:133-135; no constructor is registered for 0x101A or 0x101C at HEAD."
affects = ["2.10.1", "2.11.1", "2.2.5", "2.2.6"]

[decision.209]
title = "No gRPC Query service; views are precompile-only and genesis carries params only"
value = "layerxledger and layerxauth expose only the Msg service UpdateParams; reads go through the 0x101A and 0x101C views; module genesis holds Params and kernel state exports through the host store."
basis = "api/layerxledger/tx.proto:11 and api/layerxauth/tx.proto:9 define only the Msg service and no query proto exists in either api directory."
affects = ["2.1.1", "2.1.2", "2.5.3", "2.9.3"]

[decision.210]
title = "Capability grants are mirrored as authz grants and a decorator supplies revocation sequences"
value = "grantCapability saves a LayerXScopeAuthorization through authz for the grantee address and revokeGrant deletes it; a RevocationDecorator next to AuthzNestedMessageDecorator is the production caller of WithGrantorRevocation."
basis = "WithGrantorRevocation is defined at modules/layerxauth/types/authorization.go:35 with no production caller, and the ante chain places AuthzNestedMessageDecorator at node/ante.go:100."
affects = ["2.7.2", "2.7.3", "2.8.2", "2.12.4"]

[decision.211]
title = "LayerXScopeAuthorization gains the kernel scope fields"
value = "Fields kind 10, period_length 11, max_per_period 12, purpose_hash 13, not_before 14, not_after 15 and spent_total 16 are added and checked by ValidateBasic and Accept."
basis = "The message at api/layerxauth/tx.proto:24-34 has fields 1 to 9 only while the kernel scope at include/layerx/lxp_authority.h:27-47 carries kind, period caps, purpose and validity."
affects = ["2.1.8", "2.8.1"]

[decision.212]
title = "Go payload encoders live in the types packages; issueGrant is 346 bytes"
value = "The types packages own the encoders that are the inverses of the landed validators; issueGrant accepts exactly the 346-byte payer grant wire."
basis = "The validators are landed at modules/layerxledger/types/msgs.go:62-120 and modules/layerxauth/types/msgs.go:54-79, and read_grant decodes the payer grant at src/ledger/lxp_receive.c:168-197."
affects = ["2.1.3", "2.1.4", "2.1.9"]

[decision.213]
title = "Bank 0x1001 context-hash send and addr 0x1004 binding are baseline"
value = "The five-argument send with a context hash and the bindLayerX and getLayerXDid methods with LXP_ADDR_ reverts are landed and get no task; the ledger tasks consume them."
basis = "sendWithContext is served at precompiles/bank/bank.go:261-299 and bindLayerX and getLayerXDid at precompiles/addr/addr.go:338 and precompiles/addr/addr.go:394."
affects = ["2.3.2", "2.13.1", "2.0.4"]

[decision.221]
title = "The pay keeper runs on the shared kernel host; the layerxpay store keeps params only"
value = "The layerxpay keeper takes the one lxphost.Host the application builds over the shared host store key (decision.201) and reads and writes kernel records only through it; the layerxpay module store keeps ParamsKey 0x05 and KernelKVPrefix with the four family prefixes is not written by the keeper."
basis = "The pay keys at modules/layerxpay/types/keys.go:20-28 address a kernel KV space inside the module store, while the kernel writes its records through the host context (modules/lxphost/ctx.go:292) and NewHost (modules/lxphost/host.go:600) has no production caller, so two copies of kernel state would diverge."
affects = ["2.22.1", "2.22.5", "2.38.6"]

[decision.222]
title = "escrowPartialCapture and escrowTimeout reuse the capture and release payloads"
value = "escrowPartialCapture submits ordinal 3 with the 80-byte capture payload and escrowTimeout submits ordinal 5 with the 64-byte release payload; no new payload encoder is added."
basis = "The kernel escrow decoder routes ordinals 2 and 3 to decode_capture and 4 and 5 to decode_release (src/modules/escrow/lx_escrow_module.c:152-163), and the Go encoders exist at modules/layerxpay/types/payload_escrow.go:11-12."
affects = ["2.21.4", "2.23.1", "2.23.2"]

[decision.223]
title = "Idempotency keys and 0x0906 stream ids are derived from the transaction"
value = "Writes whose ABI carries no idempotency key (budgetPull, budgetDelegateSpend, 0x0906 settle and close) and the 0x0906 stream id use sha256 domain-tagged digests of (tx hash, call ordinal, selector or payer), never zero."
basis = "The encoders require an idempotency key the ABI does not supply (modules/layerxpay/types/payload_budget.go:123, :133) and the stream open encoder requires a nonzero stream id (modules/layerxpay/types/payload_stream.go:125)."
affects = ["2.21.3", "2.24.2", "2.24.3", "2.25.5"]

[decision.224]
title = "layerxpay Params.Validate stays a no-op; family flags are checked against kernel enable records"
value = "Params.Validate keeps accepting every combination; genesis import, MsgUpdateParams and every write refuse a family flag set true whose kernel module-enable record is absent with ErrKernelGateMismatch."
basis = "Validate is a no-op at modules/layerxpay/types/params.go:25-27 and the kernel enable record keys exist only at modules/layerxpay/types/keys.go:37-60, so the cross-check needs the host store, which Validate cannot read."
affects = ["2.22.3", "2.22.5", "2.27.1"]

[decision.225]
title = "Pause lives in module Params and the layerxgov pause scope"
value = "layerxpay and layerxagent each carry Params.Paused; writes call CheckPauseScope with their module name and method, the pay exit paths stay as listed and layerxagent gets the scope with cancel as its only exit; a paused scheduler runs no job and keeps them due."
basis = "CheckPauseScope refuses a module with no scope (modules/layerxgov/types/proposal.go:38-50) and the scope table lists layerxpay exits but no layerxagent row (modules/layerxgov/types/proposal.go:28-36)."
affects = ["2.22.3", "2.32.3", "2.32.4", "2.38.5"]

[decision.226]
title = "Scheduled jobs run in (block, id) order"
value = "The end block runs due jobs in ascending executeAtBlock, then ascending id, the order of the due index."
basis = "The due key is block BE then id BE (modules/layerxagent/keeper/keeper.go:167-169) and IterateDue walks it in order (modules/layerxagent/keeper/keeper.go:218-231)."
affects = ["2.32.4", "2.40.6"]

[decision.227]
title = "Agent end-block gas is capped by MaxBlockGas and counted in block gas"
value = "Params.MaxBlockGas defaults to 30000000 and bounds the summed GasLimit of the jobs admitted per height; RunDue returns the gas used and the legacy end block adds it to blockGasUsed before the EVM end block."
basis = "EndBlocker caps only the job count (modules/layerxagent/keeper/scheduler.go:31-36) and runs each job on an infinite gas meter (modules/layerxagent/keeper/scheduler.go:99), so 64 jobs of 10000000 gas (modules/layerxagent/keeper/keeper.go:40-41) are unaccounted for at node/legacyabci/end_block.go:42."
affects = ["2.32.1", "2.32.4", "2.38.3", "2.40.6"]

[decision.228]
title = "Scheduled calldata is capped at MaxCallDataBytes 8192"
value = "Params.MaxCallDataBytes defaults to 8192 and Schedule refuses longer callData with the new code LXP_AGENT_SCHEDULER_CALLDATA_TOO_LARGE."
basis = "Schedule stores callData of any length (modules/layerxagent/keeper/keeper.go:297) while the contract caps it at activation rehearsal (spec/layerx-merge/contracts/agent-functions.md:81) and no registry row exists for the refusal (precompiles/common/lxp_errors.go:280-313)."
affects = ["2.32.1", "2.32.3", "2.39.1"]

[decision.229]
title = "0x0901 refusal codes follow the code at HEAD"
value = "toOffset with a result outside int16 reverts LXP_AGENT_OVERFLOW and an empty resolveOffsetBatch reverts LXP_AGENT_ABI_DECODE, as the code does."
basis = "The contract lists OROB_OFFSET_RANGE for both (spec/layerx-merge/contracts/agent-functions.md:73-74) but orob refuses an empty batch as ABI_DECODE (precompiles/layerxagent/orob/orob.go:154-156) and an out-of-range result as OVERFLOW (precompiles/layerxagent/orob/orob.go:181)."
affects = ["2.37.1"]

[decision.230]
title = "Merge constructors pass explicit provisional caps"
value = "Each merge.go names its caps as constants: orob MergeMaxBatchSize 64, clearing MergeMaxOrders 256, pofq MergeMaxBatch 256, eip712 name and version 256 bytes, oracle MergeMaxFeeds 32 and MergeMaxConfidence 10^18; the activation rehearsal replaces the values, not the shape."
basis = "The constructors take the caps as arguments (precompiles/layerxagent/orob/orob.go:39, precompiles/layerxagent/clearing/clearing.go:42, precompiles/layerxagent/pofq/pofq.go:51, precompiles/layerxagent/eip712/eip712.go:41) and the contract defers them to activation rehearsal (spec/layerx-merge/contracts/agent-functions.md:73)."
affects = ["2.36.2", "2.37.1", "2.37.2", "2.37.3", "2.37.4"]

[decision.231]
title = "Agent gas is charged on the full call input"
value = "The bound executor charges MethodGas on len(input)+4, counting the selector the framework strips, and Precompile.RequiredGas charges MethodGas on the full input; both give the D2 table numbers."
basis = "boundExecutor.RequiredGas adds 4 to the stripped input (precompiles/layerxagent/common/common.go:134-139) and the table rows sit in precompiles/layerxagent/common/gas.go:30-57."
affects = ["2.34.1", "2.35.1", "2.36.1"]

[decision.232]
title = "0x0907 trusts the xweb attestor set and does not check the envelope nonce"
value = "Verify accepts envelopes signed by members of the xweb attestor set at its threshold; the nonce field is decoded and reported but never checked, replay protection resting with reportData."
basis = "The executor decodes the nonce (precompiles/layerxagent/teeattestor/teeattestor.go:224) without a check and the set is read from GetAttestorSet (modules/xweb/keeper/keeper.go:140), not a root list of its own."
affects = ["2.38.1"]

[decision.233]
title = "AttestationVerified stays in the frozen ABI and is never emitted"
value = "verify and verifyAndExpect remain view methods and emit no log; the event stays in the ABI for selector compatibility, and JobExecuted and JobFailed of 0x0905 likewise stay ABI topics with typed Cosmos events as their only record."
basis = "verify is a view method (precompiles/layerxagent/teeattestor/teeattestor.go:232) and job outcomes are typed events because no receipt exists at end block (modules/layerxagent/keeper/scheduler.go:66-75)."
affects = ["2.34.2", "2.38.1"]

[decision.234]
title = "0x101B logs are packed from call arguments and post-call kernel records"
value = "Each 0x101B write emits its event after HostExecute commits, taking indexed ids from the call arguments and amounts from the kernel record read back through the host."
basis = "The kernel returns a receipt without event payloads (modules/lxphost/host.go:574) and the precompile events are logged by pcommon.EmitEVMLog (precompiles/common/evm_events.go:16)."
affects = ["2.28.3", "2.28.4", "2.28.5", "2.28.6", "2.28.7"]

[decision.235]
title = "0x101B charges the gas table through WithGasTable"
value = "The 0x101B precompile is built WithGasTable(methodGas) so the framework charges the methodGas rows; gas.go RequiredGas stays as the estimator used by tests."
basis = "methodGas rows exist at precompiles/layerxpay/gas.go:18-76 and RequiredGas at precompiles/layerxpay/gas.go:82, and the framework hook is WithGasTable (precompiles/common/precompiles.go:115)."
affects = ["2.28.1"]

[decision.236]
title = "Kernel authority comes from the caller's 0x1004 binding, with no signature"
value = "The pay keeper resolves the acting kernel identity from GetLayerXDid of msg.sender; an unbound caller is refused with ErrUnboundCaller and no ed25519 signature is carried in the call."
basis = "GetLayerXDid maps an EVM address to its did:layerx key (modules/evm/keeper/layerx_binding.go:18) and the host authority type carries the identity only (modules/lxphost/host.go:568)."
affects = ["2.22.2", "2.21.2"]

[decision.237]
title = "The rate change is a kernel activity; StreamRateUpdated is logged at both addresses"
value = "0x0906 updateRate submits LX_STREAM_RATE_CHANGE 0x00040008 through the pay keeper and emits StreamRateUpdated at 0x0906 and, through EmitStreamRateUpdated, at 0x101B, which has no rate method of its own."
basis = "The kernel activity exists at include/layerx/lx_stream.h:34 with an 82-byte payload (include/layerx/lx_stream.h:25), while the contract row says the topic is logged by 0x0906 updateRate (spec/layerx-merge/contracts/pay.md:188)."
affects = ["2.25.3", "2.28.6", "2.35.1"]

[decision.238]
title = "0x0906 accepts the kernel stream authority"
value = "settle is accepted from payer or recipient and close from the payer only, as the kernel enforces."
basis = "The kernel checks the principal at src/modules/stream/lx_stream_execution.h:257-259 and src/modules/stream/lx_stream_lifecycle.c:19-20."
affects = ["2.35.1", "2.40.4"]

[decision.239]
title = "The 0x0903 oracle write and committed read belong to the exchange keeper"
value = "submitPrice and getValidatorPrice call exchange keeper methods SubmitOracleObservation and CommittedOraclePrice requested from domain 3; 0x0903 holds no price store."
basis = "The exchange keeper has no oracle method at HEAD (modules/layerxexchange/keeper/keeper.go:138-144) and the committed read lives in the kernel (src/modules/perps/lx_oracle_read.c:97)."
affects = ["2.36.1"]

[decision.240]
title = "The service dispute arbiter check runs in the pay keeper until the kernel carries it"
value = "The pay keeper refuses serviceDisputeResolve from a caller other than the escrow arbiter with LXP_UNAUTHORIZED_ARBITER before HostExecute; the kernel-side rule is requested from domain 1."
basis = "The kernel dispute path refuses only non-parties (src/modules/service/lx_service_dispute.c:89) while the registry carries ARBITER_REQUIRED, UNAUTHORIZED_ARBITER and ESCROW_LINK_MISMATCH (precompiles/common/lxp_errors.go:151-153)."
affects = ["2.26.4", "2.40.3"]

[decision.301]
title = "0x1015 is served by the pure-Go perps module and precompile"
value = "The canonical venue at 0x1015 is modules/perps with precompiles/perps from the v6.12.0 activation; the layerxexchange surface is legacy replay only and no task in this domain extends it."
basis = "precompiles/perps/perps.go:1-5 states the v6.12.0 activation and node/app.go:3502 registers perps NewPrecompile."
affects = ["3.0.1", "3.0.2", "3.0.3", "3.0.4"]

[decision.302]
title = "0x1015 revert data stays the parameterless custom-error selector"
value = "Every 0x1015 refusal keeps the 4-byte custom-error selector as the whole revert data; the LXP registry rows added by task 3.4.2 name the sdk errors and never change the revert bytes."
basis = "revertOf at precompiles/perps/errors.go:70-77 returns the selector, and precompiles/perps/perps.go:127-129 states the precompile carries no LXP reasons."
affects = ["3.4.1", "3.4.2"]

[decision.303]
title = "Perps margin is USDL held as ERC20 store accounts"
value = "The venue keeps no bank keeper and no bank coins; margin moves as the ERC20 of Params.CollateralToken through CallEVM."
basis = "modules/perps/types/expected_keepers.go:11-20 declares EVMKeeper only and states the module holds no bank coins."
affects = ["3.6.3"]

[decision.304]
title = "Pricefeed is the price source of the venue"
value = "The perps mark and liquidation paths read pricefeed GetPrice; the pushOracle path of the stale spec task 3.3.2 is void and is not rebuilt."
basis = "PricefeedKeeper at modules/perps/types/expected_keepers.go:25-27 and the call at modules/perps/keeper/mark.go:73."
affects = ["3.2.1", "3.2.2", "3.2.3"]

[decision.305]
title = "Order ids come from the keeper sequence and order caps from params"
value = "Order ids are allocated by NextOrderID from the stored sequence and every per-account cap reads Params; no hard-coded cap is added."
basis = "NextOrderID at modules/perps/keeper/keeper.go:176 and MaxOpenOrdersPerAccount at modules/perps/types/params.go:87."
affects = ["3.6.12"]

[decision.306]
title = "The fixed 0x1015 gas table is baseline"
value = "GasTable at precompiles/perps/perps.go:43 is landed and frozen; tasks only assert it through the existing perps tests and never edit rows."
basis = "precompiles/perps/perps.go:43 declares the table and precompiles/perps/perps_test.go:159 reads it."
affects = ["3.3.1"]

[decision.307]
title = "Oracle 0x1008 is retired at latest and v6.4.0"
value = "The latest and v6.4.0 executors revert with ErrOraclePrecompileRetired; the v5.5.2 to v6.3.0 legacy executors keep serving historical replay and are not touched."
basis = "GetVersioned at precompiles/oracle/setup.go:23-39 and ErrOraclePrecompileRetired at precompiles/oracle/oracle.go:29."
affects = ["3.18.1"]

[decision.308]
title = "Oracle snapshots stay frozen at genesis"
value = "The oracle module keeps the snapshots imported at genesis; CalculateTwaps answers from them and no task adds new snapshot writers."
basis = "AddPriceSnapshot at modules/oracle/keeper/keeper.go:422, CalculateTwaps at modules/oracle/keeper/keeper.go:488 and the genesis import at modules/oracle/genesis.go:53."
affects = ["3.18.1"]

[decision.309]
title = "Oracle EventTypeVote is retired"
value = "The vote event constant is deleted because no code emits it; aggregate_vote stays."
basis = "modules/oracle/types/events.go:6 declares EventTypeVote with no emitter."
affects = ["3.18.1"]

[decision.310]
title = "Perps governance goes through Msgs in api/perps/tx.proto and a LayerX proposal"
value = "MsgUpdateParams, MsgSetMarket and MsgSetPaused carry the gov authority, are served by a Msg service and are admitted by the LayerX proposal allow-list; the keeper methods stay the only writers."
basis = "UpdateParams at modules/perps/keeper/keeper.go:87 has no Msg route because RegisterServices at modules/perps/module.go:97 is a no-op, and governanceMessage at modules/layerxgov/types/proposal.go:169 lists no perps Msg."
affects = ["3.0.1", "3.0.2", "3.0.3", "3.1.1", "3.1.4"]

[decision.311]
title = "The perps pause stays local and withdraw is blocked while paused"
value = "CheckPause keeps its exit-path list; withdraw is not an exit path, so a paused venue refuses withdraw by design."
basis = "exitPaths at modules/perps/keeper/pause.go:8-17 lists close, cancel, deposit and collateral paths and omits withdraw."
affects = ["3.1.5"]

[decision.312]
title = "Pricefeed MsgSetParams joins the LayerX proposal allow-list"
value = "Pricefeed parameter changes run through a LayerX proposal carrying MsgSetParams, requested from domain 6 by wiring.J25.4."
basis = "governanceMessage at modules/layerxgov/types/proposal.go:169 holds no pricefeed case."
affects = ["3.14.1", "3.14.2"]

[decision.313]
title = "Perps and pricefeed sdk errors get LXP registry rows without changing revert data"
value = "The shared registry gains LXP_PERPS_* and LXP_PRICEFEED_* rows; 0x1015 keeps selectors and 0x1020 keeps the LXP_ prefix lxpError already writes."
basis = "The registry table ends at precompiles/common/lxp_errors.go:313 and lxpError at precompiles/pricefeed/pricefeed.go:148-153 wraps with the LXP name."
affects = ["3.4.2", "3.13.1", "3.13.2"]

[decision.314]
title = "PerpsAddress becomes a literal"
value = "PerpsAddress is the 0x1015 literal instead of an alias of the exchange types address, so the perps package no longer imports the legacy exchange types."
basis = "precompiles/perps/perps.go:27 aliases exchangetypes.ExchangeAddress."
affects = ["3.3.1"]

[decision.315]
title = "getValidatorByFeedAccount keeps the zero-address sentinel"
value = "An unknown feed account answers the zero address and never reverts."
basis = "precompiles/pricefeed/pricefeed.go:139-140 packs common.BytesToAddress of the empty operator."
affects = ["3.15.1"]

[decision.316]
title = "Pricefeed gets a read-only Query service and CLI; perps gets none"
value = "Pricefeed serves Params, Price, Prices, FeedKey, ValidatorByFeedAccount and Observation over gRPC, REST and CLI; perps state stays readable only through the 0x1015 views."
basis = "modules/perps/module.go:71-73 registers no gateway routes by design, while modules/pricefeed/module.go:90 returns a nil query command."
affects = ["3.0.4", "3.16.1", "3.16.2", "3.16.3", "3.16.4", "3.16.5", "3.16.6", "3.16.7", "3.16.8"]

[decision.317]
title = "CollateralToken and listed-market identity are immutable through governance"
value = "MsgUpdateParams refuses a changed CollateralToken and MsgSetMarket refuses a changed symbol for a listed market id."
basis = "CollateralToken at modules/perps/types/params.go:55 and Market at modules/perps/types/market.go:19."
affects = ["3.1.1", "3.1.2"]

[decision.318]
title = "The withdraw floor and the ADL bound read params"
value = "Withdrawable reads Params.WithdrawFloorPpm and the ADL sweep reads Params.AdlPositionsPerBlock instead of the constants."
basis = "accountNotionalFloorDivisor is used at modules/perps/keeper/account.go:231 and adlCounterpartiesPerBlock is fixed at modules/perps/keeper/adl.go:15."
affects = ["3.6.1", "3.6.2"]

[decision.319]
title = "Lowering MaxOpenOrdersPerAccount below an open count is refused"
value = "MsgUpdateParams refuses a MaxOpenOrdersPerAccount lower than the largest open order count, so the invariant cannot break on a governance change."
basis = "The invariant at modules/perps/keeper/invariants.go:216-219 reports accounts above the limit."
affects = ["3.6.12"]

[decision.320]
title = "Perps and pricefeed ConsensusVersion stay 1"
value = "The Msg and Query services add no store layout change, so no migration is registered."
basis = "modules/perps/module.go:125 and modules/pricefeed/module.go:144 return 1."
affects = ["3.0.2", "3.0.4"]

[decision.321]
title = "Spot ABI custom errors are frozen"
value = "The 118 custom errors of the five spot ABIs and the share ABI keep their selectors and argument types; precompiles/spot/spot.go:190-238 packs them through packError and precompiles/common/precompiles.go:187-216 keeps the executor bytes, so no spot error moves to Error(string)."
basis = "precompiles/spot/spot.go:192-196"
affects = ["interface.3.pc-0x1021-err-zeroamount", "interface.3.pc-0x1025-err-wethonly", "contract_context.3.spot-served-set-j26"]

[decision.322]
title = "Production serves the dynamic-gas spot wrapper"
value = "node/app.go:3524 must serve spot.NewServedSet, whose values are *spot.Precompile (vm.DynamicGasPrecompiledContract, precompiles/spot/spot.go:248); NewPrecompileSet is unexported once no caller outside the package remains."
basis = "node/app.go:3524"
affects = ["task.3.21.1", "task.3.21.2", "task.3.21.4", "wiring.J26.1"]

[decision.323]
title = "layerxexchange is replay-only after v6.12.0"
value = "The exchange keeper, its intent store and its Msg service stay so blocks before v6.12.0 replay; 0x1015 serves perps from v6.12.0 (node/app.go:3529), so the intent store is not deleted and the stale store-removal task is superseded."
basis = "node/app.go:3529"
affects = ["task.3.27.2", "task.3.27.3", "interface.3.msg-layerxexchange-setmarket"]

[decision.324]
title = "Retirement refusal semantics"
value = "Once IsUpgradeActiveAtHeight(\"v6.12.0\", height) holds (sdk/x/upgrade/keeper/keeper.go:296-299) every exchange write refuses with ErrRetired code 14 LXP_EXCHANGE_RETIRED; a keeper without an upgrade keeper refuses with ErrKeeperMissing code 12 (modules/layerxexchange/types/errors.go:35)."
basis = "sdk/x/upgrade/keeper/keeper.go:296-299"
affects = ["task.3.27.1", "task.3.27.2", "task.3.27.3"]

[decision.325]
title = "Governance keeps the exchange codec"
value = "modules/layerxgov/types/proposal.go:59-60 keeps registering the exchange MsgUpdateParams and MsgSetMarket codecs and :186-189 keeps their authority cases so historical proposals decode; refusal happens in the exchange Msg service."
basis = "modules/layerxgov/types/proposal.go:59-60"
affects = ["task.3.27.4", "wiring.J26.3"]

[decision.326]
title = "Spot parameter bounds"
value = "Params.Validate (modules/spot/types/params.go:194-261) bounds maxExpiriesPerBlock at 2000, activationScanPerBlock and fillScanPerBlock at 5000, maxFillsPerBlock at 2000, maxFillBackoffBlocks at 2560, maxActiveOrdersPerUser at 1000, the token list at MaxRegisteredTokens 64, and refuses a non-stablecoin token with MarketID 0."
basis = "modules/spot/types/params.go:232-240"
affects = ["task.3.23.1"]

[decision.327]
title = "Governance listing registers the token book"
value = "MsgUpdateParams (modules/spot/keeper/msg_server.go:120-144) writes the tokens list without calling RegisterToken (modules/spot/keeper/vault.go:742-775), although TokenParamLogs (modules/spot/keeper/vault.go:781) says a new token logs through it; listing must register the book."
basis = "modules/spot/keeper/msg_server.go:130"
affects = ["task.3.23.2", "task.3.23.4"]

[decision.328]
title = "Active index position keys"
value = "The active lists keep id-to-position entries under 0x09, 0x0A and 0x0B and gain position-to-id entries under 0x15 and list lengths under 0x16; Migrate1to2 builds them and the spot consensus version moves from 1 (modules/spot/module.go:128) to 2."
basis = "modules/spot/keeper/orders.go:194-225"
affects = ["task.3.22.1", "task.3.22.2", "task.3.22.5"]

[decision.329]
title = "Epoch hooks re-emit their events"
value = "panicCatchingEpochHook (modules/epoch/types/hooks.go:40-52) runs each hook on ctx.CacheContext, which installs a fresh event manager (sdk/types/context.go:571-575), and drops its events; after write() the cache events are emitted on ctx, while a panic still re-panics and halts the block."
basis = "modules/epoch/types/hooks.go:49-51"
affects = ["task.3.25.1", "task.3.26.4"]

[decision.330]
title = "Mint release amount fits int64"
value = "validateTokenReleaseSchedule (modules/mint/types/params.go:99-130) refuses token_release_amount above math.MaxInt64 and the minter converts amounts with sdk.NewIntFromUint64, so int64 casts at modules/mint/types/minter.go:114 and :118 cannot yield a negative coin that panics in AfterEpochEnd."
basis = "modules/mint/types/minter.go:118"
affects = ["task.3.26.1", "task.3.26.2", "task.3.26.3"]

[decision.331]
title = "Retire the legacy mint REST routes"
value = "GET /minting/parameters and /minting/minter (modules/mint/client/rest/query.go:16, :20) query the custom querier that LegacyQuerierHandler always refuses (modules/mint/module.go:136-140); the gRPC gateway routes (api/mint/v1beta1/query.proto:14, :19) stay."
basis = "modules/mint/module.go:136-140"
affects = ["task.3.26.5"]

[decision.332]
title = "Resting execution skips unpriced tokens"
value = "ExecuteResting continues past a token whose RecordSample fails with ErrInvalidOracle (modules/spot/keeper/pricing.go:33-34) or the pricefeed ErrUnknownMarket (modules/pricefeed/keeper/price.go:29), as it does for ErrStalePrice and ErrTokenPaused at modules/spot/keeper/execute.go:137."
basis = "modules/spot/keeper/execute.go:137"
affects = ["task.3.24.1"]

[decision.333]
title = "layerxexchange revert data stays Error(string)"
value = "NewPrecompile reverts through WithRevertReasons (precompiles/layerxexchange/layerxexchange.go:151); RevertError and KernelCodeText (precompiles/layerxexchange/errors.go:11-28) stay as the helpers the registry conformance test exercises, so the stale plan to move this precompile to ABI custom errors does not apply."
basis = "precompiles/layerxexchange/layerxexchange.go:151"
affects = ["interface.3.go-pclxex-reverterror-j26", "task.3.27.1"]

[decision.334]
title = "Spot runs on PECOR at 0x1021-0x1025"
value = "The stale hosted-engine exchange tasks for spot at 0x1015 are superseded: spot is served at 0x1021-0x1025 (modules/spot/types/keys.go:20-24) and 0x1015 serves perps, which belongs to another job."
basis = "modules/spot/types/keys.go:20-24"
affects = ["task.3.21.1"]

[decision.341]
title = "0x1015 is served by the Go perps precompile and the app ABI equals its JSON"
value = "The app and perps-data read 0x1015 as the pure-Go perps precompile of the v6.12.0 set; the app ABI of apps/perps/src/core/network/abi/PerpsPrecompile.ts carries the same entries as precompiles/perps/abi/abi.json, so the six J12 ABI change interfaces are stable and parity is guarded by a wave-6 test."
basis = "node/app.go:3496-3499 builds the v6.12.0 contracts and node/app.go:3529 registers 0x1015; services/platform/perps-data/internal/markets/markets.go:23 imports precompiles/perps/abi."
affects = ["3.47.1", "3.47.2"]

[decision.342]
title = "App tests run on node:test with tsx; service tests on go test"
value = "The job card names vitest and cargo, but apps/perps has neither: its test script is node --test --import tsx and perps-data is Go, so every verify_cmd uses node --test-name-pattern or go test -run."
basis = "apps/perps/package.json:10 declares the test script node --test --import tsx tests/*.test.ts."
affects = ["3.48.1", "3.42.1"]

[decision.343]
title = "Market and explorer streams and candles stay on the external market-data feed"
value = "Tickers, candles and the explorer stream of the app keep the MARKET_DATA_URL feed; only market identity, limits, tiers, fees and status move to 0x1015 and the gateway."
basis = "apps/perps/src/core/feeds.ts:2-3 names the external feed as the source of tickers and candles."
affects = ["3.48.6"]

[decision.344]
title = "The app market catalog comes from gateway GraphQL; order limits come from chain views"
value = "The app lists markets from the gateway markets query and validates orders against getMarketConfig and getMarginTiers read from 0x1015, replacing the static PERPS_MARKETS list and its leverage 1000."
basis = "modules/perps/keeper/orders.go:221-226 refuses off-tick, off-lot and over-leverage orders that the static list at apps/perps/src/core/perps/config.ts:57-76 cannot predict."
affects = ["3.48.5", "3.48.7", "3.55.1"]

[decision.345]
title = "The perps-data market set follows perps.markets"
value = "Every perps-data surface resolves a symbol through perps.markets, which the chain refresh maintains, and records.MarketIDs is retired."
basis = "services/platform/perps-data/internal/records/records.go:18-21 is a static map while services/platform/perps-data/internal/markets/markets.go:79 inserts markets the chain lists."
affects = ["3.41.1", "3.41.3"]

[decision.346]
title = "Retire the eight phantom spot GraphQL roots"
value = "spotBatchClearings, spotEpochSettlements, spotFastSettlements, spotMarketModeChanges, spotPofqUpdates, spotPLVs, spotKeeperCycles and spotBatchClearFailures resolve to no facts of the v6.12 spot rails and are removed from the gateway and the app."
basis = "services/platform/perps-data/internal/graphql/spot.go:668-706 resolves the eight roots of services/platform/perps-data/internal/graphql/schema.go:665-705."
affects = ["3.43.1", "3.43.3"]

[decision.347]
title = "Minimum and maximum order value are enforced by mapping the chain reverts"
value = "0x1015 exposes no view of the minimum or maximum order value, so the app maps PerpsMinOrderValue and PerpsMaxOrderValue reverts to VALIDATION_BELOW_MIN and VALIDATION_ABOVE_MAX instead of pre-checking them."
basis = "modules/perps/keeper/orders.go:311-332 checks the order value bounds against params that no view returns."
affects = ["3.47.3"]

[decision.348]
title = "Spot order fills are valued gross"
value = "The spot leaderboard and PnL value order fills at the gross execution price because the order rails emit no fee event."
basis = "services/platform/perps-data/internal/rest/spotusers.go:271-272 records that the net amount is not in the facts."
affects = ["3.46.2"]

[decision.349]
title = "NativeSwap stays excluded from PnL"
value = "Native swaps feed spot trades but not the realized PnL fold, as at HEAD."
basis = "services/platform/perps-data/internal/pnl/pnl.go:249 excludes native swaps from the fold."
affects = ["3.46.2"]

[decision.350]
title = "Spot venue topics stay fixed to PAX and SID"
value = "The spot token rank and the spot websocket topics remain PAX and SID because the spot registry carries no symbols."
basis = "services/platform/perps-data/internal/records/records.go:26 and services/platform/perps-data/internal/feeds/topics.go:59 fix the spot set."
affects = ["3.48.9"]

[decision.351]
title = "Markets are refreshed periodically"
value = "perps-indexer refreshes perps.markets on an interval because none of the 30 perps ABI events announces a listing, replacing Retry which stops after one success."
basis = "services/platform/perps-data/internal/markets/markets.go:177 returns after the first successful Refresh."
affects = ["3.42.3", "3.42.5"]

[decision.361]
title = "The unwired oracle v6.5 snapshot is recorded, not tasked"
value = "precompiles/oracle/legacy/v65 stays in the tree unwired while precompiles/oracle/versions lists v6.5; GetVersioned keeps serving latest and v5.5.2 to v6.4.0 only, the same ruling decision.611 makes for every legacy v6.5 snapshot, and no domain 3 task rewires or deletes it."
basis = "precompiles/oracle/setup.go:23-39 maps no v6.5 key while precompiles/oracle/versions:14 lists v6.5 and precompiles/oracle/legacy/v65/oracle.go:1 declares the unwired package"
affects = ["interface.3.go-oracle-getversioned-j25"]

[decision.362]
title = "Perps and spot genesis do not cross-check pricefeed listings"
value = "InitGenesis keeps running perps and spot before pricefeed; neither genesis path reads the pricefeed keeper, so the order is kept and listing checks apply only to MsgSetMarket (task 3.1.5) and spot MsgUpdateParams (task 3.23.4)."
basis = "node/app.go:1123-1125 orders perps and spot before pricefeed in SetOrderInitGenesis and modules/perps/keeper/genesis.go:30-46 calls no pricefeed method"
affects = ["3.1.5", "3.23.4"]

[decision.363]
title = "The spot user order index is append-only"
value = "Placing an order writes a UserOrder entry that is never deleted, so GetUserLimitOrders and the stop-order user lists return every order id a user has placed; the programme keeps that history and adds no pruning task, while the active lists that EndBlock walks become constant-cost in task 3.22.2."
basis = "modules/spot/keeper/orders.go:419 writes the UserOrder entry, modules/spot/keeper/orders.go:156-175 iterates it without a status filter and modules/spot/keeper/stoporders.go:233-234 writes the stop-order entry"
affects = ["3.22.2"]

[decision.364]
title = "The chain is the authority for perps-data market configuration"
value = "The open-interest caps of the seed migration disagree with the chain seed for PAX, SID, ASTER and TRUMP (2e24 against 0 for class E); the market refresh of task 3.42.2 overwrites every config column from getMarketConfig, and the seed conformance of task 3.42.6 compares only decimals and oracle symbol."
basis = "services/platform/perps-data/migrations/0005_markets_seed.sql:13-18 seeds max_open_interest 2000000000000000000000000 while modules/perps/keeper/seed_v6120.go:44-49 seeds oiCapUsd 0 for class E"
affects = ["3.42.2", "3.42.6"]

[decision.365]
title = "Duplicate telemetry, the per-block epoch log and dead helpers are recorded, not tasked"
value = "The TODO(PLT-336) duplicate legacy telemetry calls in mint, oracle and epoch, the Info log of every epoch BeginBlocker, the unused layerxexchange PauseCheck, the mint MintHooks and SetHooks with no production hook and the epoch and mint GetTxCmd roots stay as they are; no acceptance criterion depends on them and removing them changes no chain behaviour."
basis = "modules/mint/types/minter.go:127, modules/epoch/keeper/abci.go:20-24, modules/layerxexchange/keeper/msg_server.go:52, modules/mint/keeper/keeper.go:52 and modules/epoch/client/cli/tx.go:19"
affects = ["interface.3.cli-epoch-tx-root"]

[decision.401]
title = "Launchpad at HEAD is the v6.12.0 native rewrite; v6.10 is a frozen replay copy"
value = "Stale tasks that target the v6.10 native-denom surface (getConfig, getProtocolFees, per-market protocol counters) are retargeted to the v6.12.0 role surfaces: the current precompile loads eleven Launch-x role ABIs and serves ten of them, SidioraERC20 encoding only the nested pool-token calls (precompiles/launchpad/abi.go:10-16), over the keeper in modules/launchpad/keeper, and modules/launchpad/legacy/v610 plus precompiles/launchpad/legacy/v610 serve only heights below the v6.12.0 upgrade."
basis = "precompiles/launchpad/setup.go:11-18 maps v6.12.0 to NewPrecompile and v6.10 to the legacy/v610 package; node/app.go:3510-3530 installs both at 0x1017; precompiles/launchpad/abi.go:12-15 lists the eleven roles; stale spec/layerx-merge/spec.kvx:11048 (task 3.2.10), :11366 (3.3.9), :85681-85739 (12.3.28-30) and :98491 (13.4.2) name v6.10 methods"
affects = ["task.3.2.10", "task.3.3.9", "task.12.3.28", "task.12.3.29", "task.12.3.30", "task.13.4.2", "req.3020", "req.3021"]

[decision.402]
title = "Surface reverts use Launch-x custom-error selectors; keeper-only errors use Error(string)"
value = "A launchpad keeper error that maps to a Launch-x custom error reverts with that selector and ABI arguments at every role surface; the seven keeper-only errors (codes 2, 22, 24, 25, 26, 29, 30) revert with Error(string) carrying the registered LXP_LAUNCHPAD_ text. This supersedes the stale rule that every launchpad refusal reverts as Error(string) with an LXP code."
basis = "precompiles/launchpad/errors.go:49-98 (revertData and contractRevertData); modules/launchpad/types/errors.go:98-106 (KeeperOnlyErrors) and :139 (ContractErrorOf); stale spec/layerx-merge/spec.kvx:41 (decision.6) and :44880 (req.10006)"
affects = ["decision.6", "req.10006"]

[decision.403]
title = "No per-market protocol fee counter; the protocol cut is credited to the Treasury ledger"
value = "RecordFee credits the protocol cut to the Treasury quote ledger and never writes the 0x03 ProtocolFeesPrefix store; MigrateV6120 deletes the legacy bare-key total and refuses a nonzero one. AddProtocolFees and GetProtocolFees are retired; no query serves a per-market protocol counter."
basis = "modules/launchpad/keeper/fees.go:169-275 (RecordFee); modules/launchpad/keeper/treasury.go:187 (TreasuryCreditFee); modules/launchpad/keeper/migrate_v6120.go:403-415 (clearLegacyProtocolFees); modules/launchpad/keeper/keeper.go:179 (AddProtocolFees, no caller); stale spec/layerx-merge/spec.kvx:53 (decision.8)"
affects = ["decision.8", "req.3021", "task.3.2.11"]

[decision.404]
title = "FeeAccumulator.getProtocolFeesPending stays a constant zero"
value = "The generation 2 FeeAccumulator surface answers getProtocolFeesPending, accountingMigrationCursor and legacyAirdropUnallocated with zero because the migration and genesis refuse a nonzero value and the keeper never accrues one."
basis = "precompiles/launchpad/fees.go:386-389; modules/launchpad/types/genesis.go:168-176 (FeeAccounting)"
affects = ["interface.4.pc-fee-accumulator-get-protocol-fees-pending"]

[decision.405]
title = "Add a Cosmos Query service for operators, governance and indexers"
value = "The module registers a paxprotocol.paxchain.launchpad.Query gRPC service with grpc-gateway routes under /pax-protocol/paxchain/launchpad/ and a layerxd query launchpad command tree; the EVM role views at 0x1017 remain the Launch-x client surface and are not changed."
basis = "modules/launchpad/module.go:73-79 (no gateway routes, nil GetQueryCmd); modules/launchpad/module.go:98-100 (RegisterServices registers only the Msg server); api/launchpad/tx.proto:5-8 (only service Msg); stale spec/layerx-merge/spec.kvx:8356 (req.3020) and :8382 (keeper PriceHistory query)"
affects = ["req.3022", "task.3.3.9"]

[decision.406]
title = "PriceHistory reads the eight-slot snapshot ring with the swap refusals"
value = "PriceHistory returns the ring oldest first as orderedSnapshots does, filtered to from_height..to_height inclusive; a malformed ring refuses with ErrInvalidMarket (code 22), an unknown market with ErrUnknownMarket (code 12) and from_height greater than to_height with ErrInvalidRange (code 30); a market whose SnapshotHeights is empty reports height 0 for every point."
basis = "modules/launchpad/keeper/swap.go:193-196 (ring check); modules/launchpad/keeper/market.go:388-402 (orderedSnapshots); modules/launchpad/types/market.go:87-89 (ring fields); modules/launchpad/types/math.go:17 (SnapshotSlots); stale spec/layerx-merge/spec.kvx:529 (decision.88)"
affects = ["decision.88", "req.3022"]

[decision.407]
title = "Launchpad error codes without a registry row get one in the shared LXP registry"
value = "Every code registered in modules/launchpad/types/errors.go has a row in precompiles/common/lxp_errors.go so LXPRevert never answers LXP_UNKNOWN for a launchpad code; rows are requested from the owning domain through wiring."
basis = "modules/launchpad/types/errors.go:18-92 (codes 2..75); precompiles/common/lxp_errors.go:212-237 (rows for codes 3-23 and 25-29 only); precompiles/common/lxp_errors.go:339 (LXPRevert falls back to LXP_UNKNOWN)"
affects = ["interface.4.err-sdk-launchpad-2-invalid-params", "interface.4.err-sdk-launchpad-24-invalid-genesis", "interface.4.err-sdk-launchpad-30-invalid-range"]

[decision.408]
title = "Generation 2 role addresses stay compiled into the keeper"
value = "generation2Roles and Generation2Surfaces stay compiled in; a conformance test binds them to the published deployment manifest instead of moving them to params."
basis = "modules/launchpad/keeper/keeper.go:49-62; modules/launchpad/keeper/surfaces.go:16-26; contracts/launchpad/deployments/paxeer-x-network-addresses.json:941-966"
affects = ["interface.4.go-launchpad-keeper-keeper-generation2"]

[decision.409]
title = "Retire the generation 1 native airdrop, holding-history, balance hook and protocol-fee state"
value = "The native-denom airdrop path (ExecuteAirdrop, ClaimAirdrop, AirdropEntitlement, ClaimAirdropForEpoch), the holding-history writer and bank balance-change hook, the per-market protocol counter and their genesis fields and key builders are removed from the current keeper; prefixes 0x03 and 0x20-0x25 stay reserved and genesis refuses non-empty generation 1 fields. Replay safety rests on CheckNoNativeMarkets: no native market exists at the v6.12.0 migration, so the hook never wrote state and its removal changes no historical result; the v6.10 replay keeper keeps its own copy."
basis = "modules/launchpad/keeper/migration_record.go:77-81 and modules/launchpad/keeper/migrate_v6120_read.go:229 (CheckNoNativeMarkets); modules/launchpad/keeper/market.go:176 (generation 2 denoms are launchpad/<pool>, not factory denoms); modules/launchpad/keeper/history.go:28 (hook acts only on factory/<module>/ denoms); modules/launchpad/keeper/fees.go:508-640 (no caller); node/app.go:839-840 (sole balance-change hook)"
affects = ["interface.4.go-launchpad-keeper-keeper-add-protocol-fees", "task.13.4.2"]

[decision.410]
title = "The precompile versions file lists the served versions v6.10 and v6.12.0"
value = "precompiles/launchpad/versions names the versions GetVersioned serves; the stale v6.5 line names a package that does not exist."
basis = "precompiles/launchpad/versions:1-2; precompiles/launchpad/setup.go:15-16; precompiles/launchpad/setup_test.go:60-64"
affects = ["interface.4.go-lppc-get-versioned"]

[decision.411]
title = "Contract operation scripts recognise native surfaces and refuse admin writes there"
value = "On the network where the nine generation 2 role addresses hold the 41-byte surface runtime, every DEFAULT_ADMIN_ROLE setter and upgrade is refused by the precompile and administration goes through MsgUpdateParams; the health check, upgrade preflight and set-creation-fee script detect the runtime and report or refuse instead of treating it as a drifted proxy."
basis = "modules/launchpad/keeper/roles.go:50 (AdminRefusal); modules/launchpad/keeper/market.go:31 (surface runtime); contracts/launchpad/scripts/lib/production-health.js:54-62 (identity and EIP-1967 checks); contracts/launchpad/scripts/lib/upgrade-preflight.js:30-31; contracts/launchpad/scripts/set-creation-fee.js:35-48"
affects = ["interface.4.cli-lp-contracts-script-lib-production-health", "interface.4.cli-lp-contracts-script-lib-upgrade-preflight", "interface.4.cli-lp-contracts-script-set-creation-fee"]

[decision.412]
title = "Stale launchpad tasks already landed at HEAD carry no new task"
value = "Stale tasks 3.2.11, 3.2.13 and 3.4.8 are done; their behaviour is the baseline described in req.4001..req.4240 and in stable interfaces. Stale task 3.2.10 is in_progress with no artifact and is superseded by decision.401 and decision.405."
basis = "modules/launchpad/keeper/fees.go:169 (RecordFee to Treasury); precompiles/common/lxp_errors.go:222 (PAUSED row); stale spec/layerx-merge/spec.kvx:11076 (3.2.11), :11106 (3.2.13), :11589 (3.4.8), :11048 (3.2.10)"
affects = ["task.3.2.10", "task.3.2.11", "task.3.2.13", "task.3.4.8"]

[decision.421]
title = "The in-repo frozen catalog and schema documents are the launchpad contract authority"
value = "Tests and measurement bindings that read the absent launchpad/spec/production-system contract files are repointed to the operation catalog sdk/launchpad/packages/sdk/src/operations.gen.ts:205 and the v2 schema document sdk/launchpad/packages/production-contracts-v2/src/schemas.gen.json; migrations and handoff SQL have no in-repo replacement and stay unresolved."
basis = "services/launchpad/livestream/internal/streams/frozen_adapter_test.go:15"
affects = ["task.4.30.1", "task.4.33.1", "task.4.34.1", "task.4.34.2", "task.4.22.1"]

[decision.422]
title = "Unbacked frozen api operations answer 503 not configured"
value = "The 21 frozen api operations with no backing service are mounted in production and answer the WriteV2NotConfiguredError body (503 DEPENDENCY_UNAVAILABLE, retryable false), as the development table already does at services/launchpad/api/internal/app/dev_network_reads.go:42."
basis = "services/launchpad/api/internal/app/dev_network_reads.go:42"
affects = ["task.4.24.4", "task.4.24.5"]

[decision.423]
title = "The user service serves the frozen v2 owner operations behind the gateway"
value = "Watchlist, profile patch, preferences, devices, exports and deletion requests are served by the user service in frozen v2 shapes and forwarded by the gateway user table, as the gateway already forwards /v2/me/preferences (services/launchpad/gateway/internal/proxy/connected.go:274); the SDK origin mapping belongs to the SDK job."
basis = "services/launchpad/gateway/internal/proxy/connected.go:274"
affects = ["task.4.22.4", "task.4.23.3", "task.4.23.4"]

[decision.424]
title = "Ranking produces gainers and losers from the signed 24h change"
value = "Policy accepts the eight frozen IF_RANKINGS categories and finiteScore keeps the sign of PriceChange24h for gainers and losers instead of the absolute value at services/launchpad/ranking-algo/internal/ranker/finite.go:25."
basis = "services/launchpad/ranking-algo/internal/ranker/finite.go:25"
affects = ["task.4.31.1", "task.4.31.2", "interface.4.err-ranking-algo-invalid-category-j11"]

[decision.425]
title = "Social serves the frozen v2 voice templates beside the connected v3 routes"
value = "POST /v2/voice-rooms, GET /v2/voice-rooms/{roomId}, :end, :leave and /tickets are served by social and forwarded by the gateway; squad-scoped rooms and v2 moderation actions answer 503 because rooms carry only a pool scope (services/launchpad/social/internal/voice/control.go:47) and Mute takes a wallet, not an account id."
basis = "services/launchpad/social/internal/voice/control.go:387"
affects = ["task.4.32.2", "task.4.32.3", "task.4.22.5"]

[decision.426]
title = "Asset upload and room message templates are not served at the gateway"
value = "The metadata asset-upload and social room-message templates of the connected tables (services/launchpad/gateway/internal/proxy/connected.go:85) have no serving route and are retired at the gateway with WriteNotServed; the room message operations remain api not-configured operations."
basis = "services/launchpad/gateway/internal/proxy/connected.go:85"
affects = ["task.4.22.2", "task.4.22.3"]

[decision.427]
title = "Social comments, callouts, bounties and reports stay platform-profile surfaces"
value = "These routes are served by the development social runtime (services/launchpad/social/internal/devsocial/runtime.go:216) and are recorded as baseline with no production task in this job."
basis = "services/launchpad/social/internal/devsocial/runtime.go:216"
affects = ["task.4.32.4"]

[decision.428]
title = "Service chain reads match the launchpad precompile ABIs"
value = "The indexer creation topic, pool reserves selector, api development MarketCreated topic and ERC20 metadata selectors already equal the precompile ABIs (precompiles/launchpad/abi/SidioraFactory.json:150); they are baseline and pinned by parity tests."
basis = "services/launchpad/indexer/internal/chainreader/creation.go:63"
affects = ["task.4.28.1", "task.4.28.2", "task.4.24.7", "task.4.35.1"]

[decision.429]
title = "Frozen notification ids are a generated UUID over the inbox key"
value = "The inbox key is a 64-hex identity hash (services/launchpad/notifications/model.go:18) and IF_NOTIFICATION_READ takes a UUID, so the inbox gains v2_id uuid GENERATED ALWAYS AS (md5(id)::uuid) STORED."
basis = "services/launchpad/notifications/schema.sql:7"
affects = ["task.4.27.2", "interface.4.key-notifications-inbox-v2-id-j29"]

[decision.430]
title = "Discovery serves the frozen /v2/squads operations"
value = "Squad create, read and membership are served from the discovery store: invite maps to Invite, request and approve to the join-request flow, remove and ban to SetMemberStatus (services/launchpad/discovery/squads.go:137), promote and demote to a new SetMemberRole."
basis = "services/launchpad/discovery/squads.go:137"
affects = ["task.4.26.2", "task.4.26.4", "task.4.24.6"]

[decision.431]
title = "Discovery serves the frozen /v2/me/alerts operations with a wallet resolver"
value = "The frozen Alert requires the owner wallet while discovery authenticates an account id (services/launchpad/discovery/http.go:13); HTTP gains a Wallet resolver wired by the api from the identity principal, and the alert routes answer 503 where no resolver is wired."
basis = "services/launchpad/discovery/http.go:13"
affects = ["task.4.36.3", "task.4.24.8"]

[decision.441]
title = "Service route registrations at HEAD are the route authority for clients"
value = "A client operation is served only when a launchpad service registers its method and path at HEAD; operation descriptors and client literals do not establish a route."
basis = "operationDefinitions (sdk/launchpad/packages/sdk/src/operations.gen.ts:205) was generated from a v2 bundle that is absent at HEAD, and 33 of its 201 operations match no registered route."
affects = ["4.48.1", "4.48.2", "4.46.3", "4.46.4", "4.46.5", "4.46.6", "4.46.7"]

[decision.442]
title = "Unrouted SDK operations are refused locally with CapabilityUnavailableError"
value = "Operations.call refuses unrouted operations before any network request with CapabilityUnavailableError status 501 from the planned served-routes registry; operations.gen.ts is not regenerated until the v2 contract bundle exists."
basis = "CapabilityUnavailableError at sdk/launchpad/packages/sdk/src/transport.ts:15 already carries status 501 and the web maps it to Unsupported at apps/launchpad/web/src/core/market/unsupported.ts:28."
affects = ["4.48.1", "4.48.2"]

[decision.443]
title = "Development-only operations are refused in production clients"
value = "Operations whose routes are registered only by the development network reads are refused when TransportConfig.production is true and allowed otherwise."
basis = "The routes are registered by services/launchpad/api/internal/app/dev_network_reads.go:79 and TransportConfig.production is declared at sdk/launchpad/packages/sdk/src/transport.ts:28."
affects = ["4.48.3", "4.48.6"]

[decision.444]
title = "IF_REWARD_CLAIM is corrected and the duplicate voice operations are retired"
value = "IF_REWARD_CLAIM is sent to POST /v2/me/rewards/claim through a route-correction table; IF_VOICE_END and IF_VOICE_LEAVE stay unrouted because IF_CONNECTED_VOICE_END and IF_CONNECTED_VOICE_LEAVE are served."
basis = "The pnl tracker registers the claim route at services/launchpad/pnl-tracker/internal/app/app.go:296; the served voice operations are declared at sdk/launchpad/packages/sdk/src/operations.gen.ts:3160 and sdk/launchpad/packages/sdk/src/operations.gen.ts:3188."
affects = ["4.48.2", "4.48.4"]

[decision.445]
title = "Clients pin surface roles by runtime hash only"
value = "Router, Quoter, PoolRegistry, Treasury and the other surface roles are pinned by the SurfaceRuntime hash of current.json with no implementation slot; EventEmitter, OpticalRegistry and PoolBeacon keep their erc1967 or beacon pins."
basis = "current.json declares Router kind surface at sdk/launchpad/shared/config/deployment/current.json:21 and Treasury at sdk/launchpad/shared/config/deployment/current.json:75."
affects = ["4.43.4", "4.45.2", "4.47.1", "4.55.1"]

[decision.446]
title = "The tools/launchpad/production self-qualification harness gets no tasks"
value = "The harness reads the launchpad spec and evidence trees, which are absent at HEAD; it stays as-is until those inputs exist."
basis = "tools/launchpad/production/interfaces/codegen.py reads launchpad/spec paths (tools/launchpad/production/interfaces/codegen.py:151) that hold no v2 bundle."
affects = ["4.49.1"]

[decision.447]
title = "Embedded wallet calls stay with the wallet domain"
value = "The embedded wallet client under apps/launchpad/web/src/core/wallet-sdk calls wallet routes served by domain 12; this job changes none of them."
basis = "The embedded client reads NEXT_PUBLIC_AUTH_REDIRECT_URL at apps/launchpad/web/src/core/wallet-sdk/embedded_sdk/embedded/client.ts:68."
affects = ["4.42.5"]

[decision.448]
title = "Evidence-bound lane fixtures are blocked, not rewritten"
value = "Lane suites that require fixtures from the absent evidence tree keep their environment variables unchanged; only their cache defaults move inside the workspace."
basis = "The funding suite reads L25_FIXTURE_ARTIFACTS at apps/launchpad/web/src/core/wallet-sdk/funding.integration.test.ts:19."
affects = ["4.42.5"]

[decision.449]
title = "The private fixture authority profile never applies in production"
value = "parsePrivateFixtureAuthorityProfileV1 throws in production builds; non-production runs keep the fixture schema."
basis = "The layout reads the profile in every build at apps/launchpad/web/src/app/layout.tsx:14."
affects = ["4.44.1"]

[decision.501]
title = "The CosmWasm transaction counter stays unset on the sequencer path"
value = "SetTxPosition sets only the tx index; no ante decorator of the block path sets the CosmWasm counter, so the sequencer leaves it unset too."
basis = "node/sequencer/precompiles.go:21-27"
affects = ["task.5.4.1", "task.5.4.7"]

[decision.502]
title = "A bad sequence batch halts the node; ProcessProposal rejects it first"
value = "FinalizeBlocker keeps returning the ProcessBlock error (fail-stop) wrapped in ErrSequencedBlockHalt; ProcessProposal runs the same checks on a branch and rejects before a block can be decided."
basis = "node/app.go:1723-1726"
affects = ["task.5.0.2", "task.5.2.2", "task.5.3.1"]

[decision.503]
title = "The merge plan pins a key for the first sequenced height"
value = "The receipt key coverage check of the merge plan tests the plan height plus one, because Sequenced is true only above the plan height."
basis = "node/upgrades.go:458-463"
affects = ["task.5.6.2"]

[decision.504]
title = "The Layers seal path is retired"
value = "SealBatch with the Executor is the live seal path; Layers, OpenLayer, NewLayers and Seal have no production caller and are removed."
basis = "node/sequencer/layers.go:63"
affects = ["task.5.17.2"]

[decision.505]
title = "The executor serves upgrade heights"
value = "The executor opens a block at a plan height and refreshes the precompile set after BeginBlock; only the retired Layers path refused upgrade heights with ErrUpgradeHeight."
basis = "node/sequencer/layers.go:32"
affects = ["task.5.4.2", "task.5.17.2"]

[decision.506]
title = "The wasm capability list is kept"
value = "The node keeps iterator,staking,stargate,pax; test contracts that export another capability name are recorded as unresolved."
basis = "node/app.go:772"
affects = ["task.5.13.1"]

[decision.507]
title = "Embedded foreign genesis documents are retired"
value = "The three embedded genesis documents name chain ids that are not a Paxeer network and are removed with the daemon init branch that writes them."
basis = "node/genesis/genesis.go:14"
affects = ["task.5.11.2"]

[decision.508]
title = "An absent snapshot writer limit keeps the default"
value = "parseSCConfigs reads the writer limit only when the key is present, so a missing key no longer forces 0."
basis = "node/paxdb.go:109"
affects = ["task.5.12.1", "task.5.12.3"]

[decision.509]
title = "The anchor store-delete step is its own plan"
value = "The store deletion runs under the separate plan name v7.0-anchor-store-delete after the merge plan returned every bond; the handler also runs module migrations."
basis = "node/upgrades.go:543-545"
affects = ["task.5.7.1", "task.5.7.2"]

[decision.510]
title = "MergeUpgrade has one source"
value = "node MergeUpgrade is defined as the precompiles common constant."
basis = "precompiles/common/precompiles.go:30"
affects = ["task.5.6.1"]

[decision.511]
title = "The node role is a config key"
value = "sequencer.role selects primary or standby; on a standby sequencer.standby-address is the listen address."
basis = "node/sequencer/config.go:18"
affects = ["task.5.5.1", "task.5.5.9"]

[decision.512]
title = "The replication link is plain TCP bounded by the replication timeout"
value = "DialStandby dials TCP with the replication timeout; transport authentication is recorded as unresolved."
basis = "node/sequencer/standby.go:164-172"
affects = ["task.5.5.5"]

[decision.513]
title = "The accepter fails stop after a replication failure"
value = "After the first Release failure every Accept returns ErrReplicationHalted until a restart replays the WAL."
basis = "node/sequencer/standby.go:214"
affects = ["task.5.5.4", "task.5.5.17"]

[decision.514]
title = "A chain born merged follows the keeper activation height"
value = "No node genesis hook marks the merge plan done; the sequencer keeper stores the first sequenced height at InitGenesis and Sequenced reads it."
basis = "node/app.go:1506-1518"
affects = ["task.5.0.2", "task.5.11.4"]

[decision.515]
title = "The application checks proposer membership only"
value = "ProcessProposal accepts any proposer in the pinned leader list; the round pin is enforced by consensus and the upgrade-height gate sequencerPinnedLeader is removed."
basis = "node/upgrades.go:472-484"
affects = ["task.5.1.2", "task.5.6.4", "task.5.18.1"]

[decision.516]
title = "Sequenced reads the keeper activation height"
value = "App.Sequenced returns SequencerKeeper.Sequenced instead of comparing with the merge plan done height."
basis = "node/app.go:3099-3102"
affects = ["task.5.0.2"]

[decision.517]
title = "Sequenced blocks distribute from stored votes"
value = "BeginBlock at a sequenced height distributes from the votes stored for the previous height, so the executor, which passes nil votes, and every validator agree."
basis = "node/sequencer/executor.go:271"
affects = ["task.5.9.1", "task.5.9.2", "task.5.0.3"]

[decision.518]
title = "seqHash and the tx-0 codec live in the module types"
value = "The node fold and codec delegate to the sequencer module types."
basis = "node/sequencer/executor.go:342"
affects = ["task.5.17.1"]

[decision.519]
title = "The sequencer config reaches the App through the daemon"
value = "package app cannot import node/sequencer, so no App option carries sequencer.Config; the daemon reads it and installs the runtime through the App seams."
basis = "node/sequencer/consensus_source.go:13"
affects = ["task.5.0.1", "task.5.5.12", "task.5.5.15"]

[decision.520]
title = "A superseded primary is fenced in the executor"
value = "The executor refuses Open, Accept and Seal with the retryable ErrLeaseFenced after Fence, and ConsensusSource.Seal fences on the replication ErrFenced."
basis = "node/sequencer/executor.go:40"
affects = ["task.5.15.3", "task.5.15.4"]

[decision.521]
title = "The first sequenced height is keeper state"
value = "S is stored under ActivationHeightKey 0x07; genesis activation_height 0 means InitGenesis stores ctx.BlockHeight()+1, so the merge plan run at H makes H+1 the first sequenced height; App.Sequenced reads Keeper.Sequenced."
basis = "App.Sequenced at node/app.go:3099-3103 derives S from the upgrade done height, and the receipt key check at node/upgrades.go:457-461 tests Covers(ctx.BlockHeight()) for the plan height instead of the first sequenced height."
affects = ["5.21.1", "5.24.2", "5.24.3", "5.25.2", "5.25.4"]

[decision.522]
title = "The leader list is a governed param synced to LeaderListKey"
value = "Leaders is a param in subspace sequencer validated by ValidateLeaders; the param change handler writes it to LeaderListKey in the same cache context, effective from the next height."
basis = "Keeper.Leaders at modules/sequencer/keeper/keeper.go:149 is written only by InitGenesis and the param handler at modules/sequencer/module.go:218 handles ReceiptKeys only."
affects = ["5.21.2", "5.25.1", "5.25.3", "5.25.4", "5.25.5"]

[decision.523]
title = "No round number crosses ABCI"
value = "Consensus enforces Leader(h, r) = L[r mod len(L)] through the leader pin; the application checks only that the proposer is in L."
basis = "RequestProcessProposal at consensus/abci/types/plain_types.go:207 carries no round and RoundState.Leader at consensus/internal/consensus/types/round_state.go:473 already applies the pin."
affects = ["5.31.1", "5.31.2"]

[decision.524]
title = "Consensus reads the schedule through an in-process LeaderSource"
value = "consensus/types.LeaderSource is installed by makeNode when the application implements it and is asked in updateToState for every new height before the start time is computed; a source error panics and stops the state machine."
basis = "makeNode installs the SequencerSource by type assertion at consensus/node/node.go:263-264 and SetLeaderPin at consensus/internal/consensus/state.go:287 has no production caller."
affects = ["5.31.1", "5.31.2", "5.34.1"]

[decision.525]
title = "The leader rotation runs over the full list"
value = "L[r mod len(L)] is not filtered by the validator set; a leader that is not a validator costs its round a propose timeout."
basis = "LeaderPin.Leader at consensus/internal/consensus/types/round_state.go:451 indexes the list and validation at consensus/internal/state/validation.go:113 already refuses a proposer outside the validator set."
affects = ["5.31.1"]

[decision.526]
title = "sequencer.enable only selects timeouts and excludes Autobahn"
value = "consensus.sequencer.enable switches propose, vote and commit timeouts at pinned heights and is refused together with autobahn-config-file."
basis = "SequencerConfig at consensus/config/config.go:1226-1240 has no reader in the state machine and the giga branch at consensus/node/node.go:201 never installs the sequencer source."
affects = ["5.32.1", "5.32.2", "5.33.1", "5.34.1"]

[decision.527]
title = "Pinned heights never wait for mempool transactions"
value = "enterNewRound skips the waitForTxs branch whenever the leader pin applies."
basis = "Sequenced transactions arrive through SequencerSource.Seal, not the consensus mempool, so the condition at consensus/internal/consensus/state.go:1057 would stall a pinned height with create-empty-blocks false."
affects = ["5.33.2"]

[decision.528]
title = "seqHash, txRoot and the tx-0 codec are canonical in modules/sequencer/types"
value = "SeqHash, TxRoot, EncodeSequenceBatchTx, DecodeSequenceBatchTx and VerifyBatchTxs live in modules/sequencer/types; node copies switch to them."
basis = "The same hash is written twice at node/sequencer/executor.go:342 and node/sequencer/layers.go:351, and the codec and root live in node/app.go:3112 and node/app.go:3157 where the module cannot use them."
affects = ["5.22.1", "5.22.2", "5.22.3", "5.22.4"]

[decision.529]
title = "Decided votes are stored per height and two heights are kept"
value = "StoredVotesKey 0x05 is a prefix; entries live under 0x05||u64be(h) and StoreVotes deletes h-2."
basis = "StoredVotesKey at modules/sequencer/types/keys.go:20 is declared with no reader or writer."
affects = ["5.21.1", "5.23.1", "5.23.2"]

[decision.530]
title = "Fencing travels in the replication ack"
value = "A host that took a later lease answers every group with AckRefused and its epoch; the primary turns that into ErrFenced and stops; Ack.Epoch is zero on every other answer."
basis = "Ack at node/sequencer/standby.go:64-74 has no epoch and receive at node/sequencer/standby.go:616-653 accepts any continuous group, so a promoted standby would keep taking the old primary's ACCEPTs."
affects = ["5.27.2", "5.27.3", "5.27.4"]

[decision.531]
title = "Recovery order after both hosts stop"
value = "Replay first on the host with the higher lease epoch, then the longer logged ACCEPT seq; equal seqs with different receipt bytes stop recovery."
basis = "ReplayResult at node/sequencer/wal/wal.go:705-714 reports only the ACCEPTs after the last COMMITTED, which cannot rank two logs."
affects = ["5.27.1", "5.27.3"]

[decision.532]
title = "Executor fencing lives in the executor"
value = "Executor gains Fence; after it Open, Accept and Seal return the retryable ErrLeaseFenced; handover.go calls it through the Fencer interface and the executor change is requested from its owner."
basis = "Accept at node/sequencer/accept.go:16 and Seal at node/sequencer/executor.go:274 have no lease check."
affects = ["5.27.4"]

[decision.533]
title = "No store migration for the sequencer module"
value = "ConsensusVersion stays 1; every new key is absent on an unmerged chain and reads as zero."
basis = "ConsensusVersion returns 1 at modules/sequencer/module.go:210 and no chain has applied the merge plan."
affects = ["5.24.2", "5.25.2"]

[decision.541]
title = "occ_tests is absent; OCC tests live under tests/occ"
value = "No occ_tests directory exists at HEAD; the OCC harness is tests/occ/utils/utils.go:160 (domain 16), so J33 writes no OCC task."
basis = "tests/occ/utils/utils.go:160"
affects = ["occ_tests"]

[decision.542]
title = "tests/daemon retires with the C daemons"
value = "Every tests/daemon file drives layerxd, the guarantor or the LNI socket (tests/daemon/program-admission.sh:10, tests/daemon/withdraw-custody.py:178), so the directory retires with them."
basis = "tests/daemon/program-admission.sh:10"
affects = ["task.5.54.1", "task.5.54.11"]

[decision.543]
title = "layerxd retires entirely"
value = "The node runs as paxd; layerxd sources are built only by the LAYERXD_SOURCES rule at Makefile:1400."
basis = "Makefile:1400"
affects = ["task.5.50.1", "task.5.50.7"]

[decision.544]
title = "The agent store key is a storage constant"
value = "The agent keeper opens store key layerxagent (modules/layerxagent/keeper/keeper.go:21-23) with no constant in storage/common/keys/store_keys.go:13-47."
basis = "modules/layerxagent/keeper/keeper.go:21"
affects = ["task.5.41.1", "task.5.41.2"]

[decision.545]
title = "The exact store-key golden list is extended, not loosened"
value = "TestXWebStoreKeyFollowsTheV6120StoreKeys keeps the exact list at storage/common/keys/store_keys_test.go:90-98 and gains the merge keys; the end-anchored index checks move to relative checks."
basis = "storage/common/keys/store_keys_test.go:90"
affects = ["task.5.41.2"]

[decision.546]
title = "mvcc metric names are kept"
value = "The mvcc instruments share names with NewPebbleMetrics under meter paxdb_pebble (storage/db_engine/pebbledb/pebble_metrics.go:17-20); only bucket boundaries change."
basis = "storage/db_engine/pebbledb/pebble_metrics.go:20"
affects = ["task.5.44.1"]

[decision.547]
title = "layerxctl reports submitted and receipted only"
value = "submit stops at the submitted rung at cmd/layerxctl/src/main.rs:195-220; the receipted rung uses the published receipt verifier, and no committed rung is printed."
basis = "cmd/layerxctl/src/main.rs:195"
affects = ["task.5.47.2", "task.5.47.3"]

[decision.548]
title = "The genesis builder is kept and its file formats stay stable"
value = "layerx-genesis-build keeps the LXGB input (cmd/layerx-genesis/lxp_genesis_build_cli.c:114) and LXGN output (cmd/layerx-genesis/lxp_genesis_cli.c:20); only custody and handover inputs retire."
basis = "cmd/layerx-genesis/lxp_genesis_build_cli.c:114"
affects = ["task.5.49.1", "task.5.49.2"]

[decision.549]
title = "Module registry read-node retires with the LNI"
value = "read-node dials the layerxd LNI socket (cmd/layerx-module-registry/node.c:89), which retires."
basis = "cmd/layerx-module-registry/node.c:89"
affects = ["task.5.48.1"]

[decision.550]
title = "The wasm runtime link is baseline"
value = "wasm-runtime builds as at HEAD; no merge requirement changes it."
basis = "wasm/x/wasm/module.go:243"
affects = ["wasm-runtime"]

[decision.551]
title = "memory_cache_size replaces lru_size"
value = "ReadWasmConfig reads memory_cache_size (wasm/x/wasm/module.go:37); lru_size at daemon/paxd/cmd/root.go:442 has no reader."
basis = "daemon/paxd/cmd/root.go:442"
affects = ["task.5.46.1"]

[decision.552]
title = "Receipt vectors are recorded under daemon/committed-fixture/vectors"
value = "The recorder needs a running paxd built from daemon/paxd/cmd/root.go:63; vectors sit beside it and platform fixtures read them by wiring."
basis = "daemon/paxd/cmd/root.go:63"
affects = ["task.5.55.1", "task.5.55.5"]

[decision.553]
title = "admin, modules/store and wasm-runtime are baseline"
value = "No merge requirement changes the admin server, the store module or the wasm runtime; their interfaces stay stable."
basis = "storage/common/keys/store_keys.go:54"
affects = ["admin", "modules/store", "wasm-runtime"]

[decision.554]
title = "go.mod changes arrive by the tasks that need them"
value = "J33 writes no standalone go.mod task; each Go task changes go.mod only through its build."
basis = "storage/config/sc_config.go:41"
affects = ["go.mod", "go.sum"]

[decision.555]
title = "The sequencer config is still discarded by paxd"
value = "A done stale task parsed the sequencer config, but newApp discards the result at daemon/paxd/cmd/root.go:249, so task 5.46.7 hands it to the node."
basis = "daemon/paxd/cmd/root.go:249"
affects = ["task.5.46.7"]

[decision.556]
title = "Landed baseline is not re-tasked"
value = "The layerx-wire limit import is the only part of the layerxctl rewrite left at cmd/layerxctl/src/main.rs:10; everything else in the CLI landed."
basis = "cmd/layerxctl/src/main.rs:10"
affects = ["task.5.47.1"]

[decision.557]
title = "The host store key is mounted with the merge keys"
value = "wiring.J23.7 asks for LayerXHostStoreKey and the ledger and auth keys in MemIAVLStoreKeys (storage/common/keys/store_keys.go:54); task 5.41.2 fulfils it in the same change."
basis = "storage/common/keys/store_keys.go:44"
affects = ["task.5.41.2"]

[decision.558]
title = "Merge fail-fast addresses live in their own list"
value = "wiring.J34.18 asks for the merge addresses in LateFailFastPrecompileAddresses, whose length is asserted at engine/executor/precompiles/failfast_test.go:24; task 5.45.1 fulfils it with MergeFailFastPrecompileAddresses and a merged map so the existing assertion holds."
basis = "engine/executor/precompiles/failfast_test.go:24"
affects = ["task.5.45.1"]

[decision.581]
title = "Merge precompile packages are linked by blank import"
value = "node/precompiles.go blank-imports every merge precompile package so their init registers a constructor before the custom precompile set is built."
basis = "precompiles/setup.go:89"
affects = ["task.5.19.4", "task.5.19.1"]

[decision.582]
title = "Consensus receives the sequencer source from the App by value"
value = "App.Sequenced(ctx, height) cannot satisfy SequencerSource.Sequenced(height), so the App hands consensus the installed ConsensusSource."
basis = "consensus/types/sequencer.go:13"
affects = ["task.5.0.1", "task.5.5.12"]

[decision.601]
title = "Precompile retirement is enforced per executor"
value = "Each retiring precompile calls RetiredAt with UpgradeReaderOf, or is built WithRetirement; no keeper-side retirement list is added."
basis = "precompiles/common/retire.go:24 and precompiles/common/retire.go:18-23 define the gate as a per-executor call"
affects = ["6.1.3", "6.1.4"]

[decision.602]
title = "Upgrade reader comes from the EVM keeper UpgradeKeeper method"
value = "Helpers assert interface{ UpgradeKeeper() *upgradekeeper.Keeper } on the EVM keeper; utils.Keepers gains no UpgradeK accessor."
basis = "precompiles/common/precompiles.go:314-327 and precompiles/bank/bank.go:207-215 read the upgrade keeper through the EVM keeper; precompiles/utils/expected_keepers.go:34 has no upgrade accessor"
affects = ["6.1.1", "6.1.4", "6.3.1"]

[decision.603]
title = "Keeper accessors are declared in the consuming package"
value = "Packages that need a module keeper declare a local accessor interface and assert it on utils.Keepers, as SpotKeepers does, to avoid an import cycle with node."
basis = "precompiles/spot/spot.go:328-330 asserts SpotKeepers on utils.Keepers"
affects = ["6.6.3"]

[decision.604]
title = "Bank site codes follow the addr site rows"
value = "LXP_BANK_STATICCALL, LXP_BANK_DELEGATECALL and LXP_BANK_ZERO_VALUE are code-only rows shaped like LXP_ADDR_STATICCALL and LXP_ADDR_DELEGATECALL."
basis = "precompiles/common/lxp_errors.go:250-251 holds the addr site rows; precompiles/bank/bank.go:231, :345, :348 and :354 return uncoded errors"
affects = ["6.2.1", "6.3.3", "6.3.5"]

[decision.605]
title = "Constructor GetName values win over stale contract names"
value = "The name each merge constructor reports is the MergeAddressTable name in code; contract text that differs is corrected through the programme domain."
basis = "precompiles/setup.go:61-74 is the table the node registers from"
affects = ["6.12.1", "6.12.5", "6.12.11"]

[decision.606]
title = "Merge constructor registration happens in node"
value = "Merge packages register through init and RegisterMergeConstructor; node imports each package so registration runs, because precompiles cannot import node."
basis = "precompiles/layerxagent/teeattestor/teeattestor.go:103-107 registers in init and precompiles/setup.go:89 records it; no non-test file imports that package"
affects = ["6.6.5", "6.12.11"]

[decision.607]
title = "GetCustomPrecompilesE is added and the panicking form is kept"
value = "Callers that can return an error use GetCustomPrecompilesE; GetCustomPrecompiles keeps its signature and panics with the same error."
basis = "precompiles/setup.go:193-196 panics on a merge build error; node/app.go:990 and precompiles/layerxagent/teeattestor/resolution_test.go:74 call the panicking form"
affects = ["6.6.2"]

[decision.608]
title = "Perps errors stay outside the LXP registry"
value = "The perps precompile keeps its own custom errors; no LXP_PERPS rows are added by domain 6."
basis = "precompiles/common/lxp_errors.go:39 has no perps rows and precompiles/perps/perps.go:130 builds the precompile without WithLXPReasons"
affects = ["6.2.1"]

[decision.609]
title = "evm_pending_nonce counts added and rejected CheckTx nonces"
value = "The counter declared at the ante metrics is recorded with attribute type=added or type=rejected in the CheckTx branch only."
basis = "modules/evm/ante/metrics.go:29-33 declares the counter and modules/evm/ante/sig.go:70-74 is the CheckTx branch that never records it"
affects = ["6.8.2"]

[decision.610]
title = "Fee-denom preferences are genesis state"
value = "Entries under AccountFeeDenomKeyPrefix 0x23 are exported, streamed and imported with validation; fee-token rate errors stay plain keeper errors."
basis = "modules/evm/genesis.go:72-82 and modules/evm/genesis.go:151-161 omit modules/evm/types/keys.go:71; modules/evm/keeper/params.go:16-19 declares the rate errors"
affects = ["6.7.6", "6.7.7", "6.7.9"]

[decision.611]
title = "Unwired legacy v6.5 snapshots are recorded, not tasked"
value = "The precompiles/common legacy v6.5 snapshot exports are interface blocks with status stable; no task rewires or deletes them in this programme."
basis = "precompiles/setup.go:5-26 imports no legacy snapshot package"
affects = ["6.0.1"]

[decision.612]
title = "Stale binding call-form task is superseded"
value = "The LayerX binding keeper and genesis validation are landed; the stale binding call-form test task is not carried forward."
basis = "modules/evm/types/layerx_binding.go:77-100 validates binding genesis entries at HEAD"
affects = ["6.7.6"]

[decision.613]
title = "0x1015 carries both the layerxexchange and perps names"
value = "PrecompileNamesToInfo keeps layerxexchange for 0x1015 and adds perps for the same address."
basis = "precompiles/setup.go:331 records layerxexchange and node/upgrades.go:521-536 serves perps at the same address after the merge"
affects = ["6.6.3", "6.8.4"]

[decision.621]
title = "Denom pause gates user transfer paths, not keeper-level module flows"
value = "A paused tokenfactory denom is refused by MsgSend, MsgMultiSend, the GigaBankKeeper send path and tokenfactory mint and burn; keeper-level x/bank SendCoins and module-account transfers stay ungated; the stale claim that every bank transfer is refused is not adopted."
basis = "The only IsSendEnabledCoins callers are sdk/x/bank/keeper/msg_server.go:34 and sdk/x/bank/keeper/msg_server.go:95; keeper SendCoins at sdk/x/bank/keeper/send.go:177 has no check."
affects = ["6.25.1", "6.25.2"]

[decision.622]
title = "GigaBankKeeper consults the tokenfactory send-enabled checker"
value = "The GigaBankKeeper gains a send-enabled checker list fed by TokenFactoryKeeper.SendEnabledChecker, because the Giga IsSendEnabledCoin reads only params."
basis = "engine/deps/xbank/keeper/send.go:366 returns GetParams(ctx).SendEnabledDenom only; the checker is registered on BankKeeper alone at node/app.go:766 while GigaBankKeeper registers only a recipient checker at node/app.go:918."
affects = ["6.25.1", "wiring.J35.1", "wiring.J35.2"]

[decision.623]
title = "Denom pause authority is issuer-bound and not governance-routed"
value = "An issuer-bound denom is paused only by its issuer DID through SetDenomPausedByIssuer; tokenfactory has no layerxgov pause scope; denoms without an issuer keep the bech32 admin path."
basis = "The kernel PAUSE rule refuses a non-issuer at src/modules/asset/lx_asset_execution.h:240-242; pauseExitPaths at modules/layerxgov/types/proposal.go:28-36 has no tokenfactory entry; the admin check is at modules/tokenfactory/keeper/msg_server.go:228."
affects = ["6.22.3", "6.22.6", "6.27.2", "6.28.6"]

[decision.624]
title = "LXP_PAUSED_SCOPE text in two codespaces is kept"
value = "tokenfactory code 27 (repeat pause) and layerxgov code 735 (scope refusal) both carry LXP_PAUSED_SCOPE; neither is renumbered."
basis = "modules/tokenfactory/types/errors.go:35 and modules/layerxgov/types/proposal.go:26 register the two codes; both are consensus-visible ABCI codes."
affects = ["6.27.2", "6.28.6"]

[decision.625]
title = "Retirement is by refusal; types and codecs stay for replay"
value = "layerxanchor MsgUpdateParams keeps its type, codec registration and NewMsgServerImpl; only the app route built with the upgrade reader refuses it after the merge plan."
basis = "NewMsgServerImpl at modules/layerxanchor/keeper/msg_server.go:13 and the amino name at modules/layerxgov/types/proposal.go:58 are needed to decode pre-merge blocks."
affects = ["6.31.4", "6.31.5", "6.28.5"]

[decision.626]
title = "tokenfactory consensus version and historical migrations stay"
value = "paused_denoms is an additive genesis field; ConsensusVersion stays 5 and migrations 1 to 4 are not edited."
basis = "modules/tokenfactory/module.go:143-160 registers the migrations and modules/tokenfactory/module.go:205 returns 5; the paused| key already exists in state at modules/tokenfactory/types/keys.go:55."
affects = ["6.21.1", "6.21.4"]

[decision.627]
title = "The tokenfactory gov proposal route stays registered and refusing"
value = "NewProposalHandler of tokenfactory keeps refusing all content and stays on the gov router so old proposals still resolve to a refusal."
basis = "modules/tokenfactory/handler.go:11 rejects every content type and is routed at node/app.go:966."
affects = ["modules/tokenfactory/handler.go"]

[decision.628]
title = "CustodyAnchor stays until custody retires; the keeper AnchorReader goes"
value = "Only the AnchorReader interface and its assertion are deleted; NewCustodyAnchor keeps serving custody until the custody retirement removes its caller."
basis = "AnchorReader at modules/layerxanchor/keeper/keeper.go:187-194 has no consumer, while node/app.go:832 wires NewCustodyAnchor (modules/layerxanchor/keeper/custody_reader.go:40) into custody."
affects = ["6.34.1"]

[decision.629]
title = "The anchor store-delete step is named v7.0-anchor-store-delete"
value = "The second retirement step that ends 0x1014 reads and deletes the layerxanchor store is the upgrade plan v7.0-anchor-store-delete; its height is set at activation rehearsal."
basis = "precompiles/common/retire.go:19-20 names a second step whose height is set at activation rehearsal but no constant exists at HEAD."
affects = ["6.31.2", "6.32.2", "wiring.J35.9"]

[decision.630]
title = "No layerxgov-level retired-message list"
value = "layerxgov adds no retired-message gate; a LayerXProposal carrying layerxanchor MsgUpdateParams reaches the gated anchor msg server through the MsgServiceRouter and fails there."
basis = "The handler dispatches every message through router.HandlerByTypeURL at modules/layerxgov/handler.go:26 inside one CacheContext."
affects = ["6.28.5"]

[decision.631]
title = "Bonds are returned at the merge plan; reads continue until store delete"
value = "RetireAtMerge runs ReturnAllBonds inside the v7.0 handler; reads stay served until the store-delete step."
basis = "ReturnAllBonds at modules/layerxanchor/keeper/bond_return.go:8 has no production caller; mergeUpgradePlan runs migrations at node/upgrades.go:443."
affects = ["6.33.1", "6.33.2", "6.32.2"]

[decision.632]
title = "0x1014 Solidity interfaces are retired by executor refusal, not deletion"
value = "precompiles/layerxanchor/LayerXAnchor.sol and contracts/src/precompiles/ILayerXAnchor.sol stay as the decode reference of the retired address; every selector and event is retired by the executor gate."
basis = "The address stays registered at precompiles/setup.go:180 per precompiles/common/retire.go:21-23, and the ABI at precompiles/layerxanchor/abi.json:1 is still loaded by NewPrecompile."
affects = ["6.32.1", "6.32.2", "6.32.3"]

[decision.633]
title = "An issuer binding closes the bech32 admin pause path"
value = "MsgSetDenomPaused from the admin of an issuer-bound denom returns ErrIssuerMismatch; a missing denom returns ErrDenomDoesNotExist."
basis = "SetDenomPaused compares only msg.Sender with the admin at modules/tokenfactory/keeper/msg_server.go:228-230 and IssuerDid is read at modules/tokenfactory/keeper/admins.go:73."
affects = ["6.22.6"]

[decision.641]
title = "Custody retires at the v7.0 merge plan with no drain window"
value = "From the v7.0 plan height every custody state change is refused at the keeper, Msg, proposal and precompile layers; state, protos and events stay defined for replay."
basis = "precompiles/common/retire.go:24, modules/layerxcustody/keeper/msg_server.go:70, node/upgrades.go:201"
affects = ["task.6.42.1", "task.6.43.1", "task.6.44.1", "task.6.45.1"]

[decision.642]
title = "Funds stranded in custody are released at the plan to the custody authority"
value = "ReleaseRetired cancels pending claims and sends every custodied balance to Keeper.Authority (default the gov module address); this supersedes the carried-forward no-settlement decision."
basis = "modules/layerxcustody/keeper/keeper.go:86, modules/layerxcustody/types/proposal.go:36, modules/layerxcustody/keeper/claims.go:127, modules/layerxcustody/keeper/deposit.go:83"
affects = ["task.6.46.1", "task.6.47.1"]

[decision.643]
title = "The 0x1013 retire gate runs first in Execute and returns error text"
value = "The gate sits after the recover defer and before the delegatecall, payable and static checks; it returns an error whose RevertReason equals RetiredRevert(\"layerxCustody\") because the precompile runs WithRevertReasons; ABI decoding in Prepare still precedes it."
basis = "precompiles/layerxcustody/layerxcustody.go:159, precompiles/common/precompiles.go:121, precompiles/common/precompiles.go:246"
affects = ["task.6.45.1"]

[decision.644]
title = "Retired custody calls keep their RequiredGas"
value = "RequiredGas is unchanged so a retired call costs what it cost before the plan."
basis = "precompiles/layerxcustody/layerxcustody.go:207, precompiles/common/retire.go:13"
affects = ["task.6.45.1"]

[decision.645]
title = "The bridge precompile real upgrade-keeper path has landed"
value = "No task: the activation path through the app upgrade keeper is already tested."
basis = "precompiles/layerxbridge/layerxbridge_test.go:71, precompiles/layerxbridge/layerxbridge_test.go:344"
affects = []

[decision.646]
title = "Forge gates in contracts/bridge/evm run bootstrap-libs first"
value = "Any forge gate on contracts/bridge/evm runs bash contracts/bridge/evm/bootstrap-libs.sh before forge test because foundry.toml is offline with libs = [\"lib\"]; the vault attestation and relayer ABI forge tests have landed, so no forge task is written here."
basis = "contracts/bridge/evm/foundry.toml:1, contracts/bridge/evm/test/PaxeerXVault.t.sol:538, contracts/bridge/evm/test/RelayerAbiParity.t.sol:62"
affects = ["task.6.50.1"]

[decision.647]
title = "Re-targeting the bridge and custody precompile tests is unnecessary"
value = "The precompile tests already run in-process against the test app, so the stale re-target tasks are not carried."
basis = "precompiles/layerxbridge/layerxbridge_test.go:71, precompiles/layerxcustody/layerxcustody_test.go:71"
affects = []

[decision.648]
title = "The Sidiora proxy timelock and its four libraries are retained"
value = "SidioraProxyTimelock.sol, SidioraProxyGovernanceProposal.json and the Arithmetic, SafeCall, Constants and Types libraries stay; their retire statuses are overridden to stable."
basis = "contracts/governance/SidioraProxyTimelock.sol:4, contracts/governance/SidioraProxyTimelock.sol:13, scripts/SidioraProxyGovernance.s.sol:4"
affects = ["task.6.55.1", "task.6.55.2"]

[decision.649]
title = "Kernel Solidity retirement is proven by tracked-file and live-reference checks"
value = "assert_retired fails on a tracked retired path or a live reference outside the retired set; docs/, spec/, *.md and GOTCHA.kvx are excluded, and inventoried retire files in contracts/security and contracts/storage count as retired referrers."
basis = "contracts/README.md:1, scripts/PaxeerBetaDeploy.s.sol:4"
affects = ["task.6.51.1"]

[decision.650]
title = "tests/bridge/files.h and tests/bridge/requirements.txt stay"
value = "files.h is included by tests/daemon C tests and requirements.txt is installed by CI lanes, so neither is retired."
basis = "tests/daemon/lxp_test_arbiter_admission.c:101, .github/workflows/agent.yml:41"
affects = ["task.6.60.2"]

[decision.651]
title = "The custody transaction CLI is removed in wave 6"
value = "client/cli/tx.go is deleted and GetTxCmd returns nil after the Msg gates have landed."
basis = "modules/layerxcustody/module.go:72, modules/layerxcustody/client/cli/tx.go:37"
affects = ["task.6.48.1"]

[decision.652]
title = "The exchange custody margin hop fails with ErrModuleRetired after the plan"
value = "Domain 3 retires or re-routes the hop through a wiring request; custody does not keep a deposit exception for it."
basis = "modules/layerxexchange/keeper/intents.go:63, modules/layerxcustody/keeper/deposit.go:64"
affects = ["task.6.43.1"]

[decision.653]
title = "Retire for custody protos and events means refused or not emitted"
value = "Retired proto messages stay registered for decoding history; retired events are never emitted after the plan height."
basis = "api/layerxcustody/events.proto:77, modules/layerxcustody/keeper/claims.go:162"
affects = ["task.6.42.1", "task.6.44.1"]

[decision.654]
title = "ErrModuleRetired takes custody error code 29"
value = "Code 29 is the next free code after ErrDepositFrozen."
basis = "modules/layerxcustody/types/errors.go:34"
affects = ["task.6.41.1"]

[decision.655]
title = "Origin-2 fees stay in the per-asset web fee accounts"
value = "A program request fee stays in the web fee account of its asset until FulfilProgram splits it; no module escrow and no refund path is added."
basis = "ProgramFeeAccount derives one account per asset (modules/xweb/keeper/program.go:146-158) and RequestFromProgram documents that the fee stays there with no refund (modules/xweb/keeper/program.go:174-191)."
affects = ["6.63.2", "6.63.3"]

[decision.656]
title = "The xweb keeper reads the merge plan through the upgrade keeper the EVM keeper carries"
value = "NewKeeper fills an UpgradeReader from the EVM keeper's UpgradeKeeper when it is non-nil; ProgramOriginActive fails closed without one; the plan is v7.0 and the refusal is LXP_MODULE_DISABLED."
basis = "The same assertion serves addr at precompiles/addr/addr.go:526-531, MergeUpgrade is v7.0 at precompiles/common/precompiles.go:30, and custody fails closed the same way at modules/layerxcustody/keeper/keeper.go:36-45."
affects = ["6.61.1", "6.61.2", "6.61.3", "6.65.3"]

[decision.657]
title = "Origin-2 methods of 0x1019 are height-gated in the order activation, pause, decode"
value = "Below the merge plan fulfilProgram, getProgramResult and getKernelNetworkId revert LXP_MODULE_DISABLED after the precompile guard; the keeper checks activation before pause; gas follows the D2 formula at every height; fulfilProgram is a transaction method refused from a static call."
basis = "Contract section F11 gates rows A10, B7, B8 and A9 per method by IsUpgradeActiveAtHeight (contracts in spec/layerx-merge/contracts/web.md); the guard needs the keeper (precompiles/xweb/xweb.go:297-308) and RequiredGas runs before Execute (precompiles/xweb/xweb.go:185-194)."
affects = ["6.61.2", "6.61.3", "6.65.2", "6.65.3"]

[decision.658]
title = "The fee denom of each asset is recorded at request time"
value = "RequestFromProgram records the bank denom of the first accepted fee per asset under web/feedenom; a later fee of another denom for that asset is LXP_ASSET_MISMATCH; the split pays in the recorded denom and refuses an asset without one."
basis = "splitProgramFee probes balances to choose a denom (modules/xweb/keeper/program_fulfil.go:233-248), so a third-party deposit of another mapped denom changes the outcome."
affects = ["6.63.1", "6.63.2", "6.63.3"]

[decision.659]
title = "Origin-2 state is carried in genesis with the kernel capacities"
value = "GenesisState carries pending records, answer parts, fee denoms and both counters; Validate enforces record layout, the 256 and 64 capacities and counter agreement; the capacity constants move to types and the keeper refers to them."
basis = "ExportGenesis writes origin-1 state only (modules/xweb/keeper/genesis.go:35-44) while the kernel capacities are 256 and 64 (include/layerx/lx_web.h:39-40)."
affects = ["6.64.1", "6.64.2", "6.64.3", "6.64.4", "6.75.1"]

[decision.660]
title = "The attestor set cap stays at 64 entries"
value = "MaxAttestorSetSize stays 64 and the observation keeps at most 16 signatures; no task changes either bound."
basis = "MaxAttestorSetSize is at modules/xweb/types/state.go:210 and ObservationMaxSignatures is 16 at modules/xweb/types/observation.go:11."
affects = ["6.66.1"]

[decision.661]
title = "Activation params arrive by governance MsgSetParams"
value = "kernelNetworkId and programFeeDenoms are set by an ordinary governance MsgSetParams after the plan; no upgrade-handler param step is written and DefaultFee stays 1000000."
basis = "MsgSetParams carries fields 6 and 7 (api/xweb/tx.proto:87-88), UpdateParams applies them (modules/xweb/keeper/msg_server.go:163), and DefaultFee is at modules/xweb/types/state.go:79."
affects = ["6.67.1"]

[decision.662]
title = "Interchain accounts stay unrouted"
value = "No task routes the interchain-accounts host or controller; the IBC router keeps its current routes."
basis = "The IBC core genesis carries client, connection and channel state only (interchain/proto/ibc/core/types/v1/genesis.proto:13-29)."
affects = ["6.73.1"]

[decision.663]
title = "The CosmWasm stargate querier stays disabled"
value = "StargateQuerier keeps refusing; the advertised stargate capability is a domain 5 question recorded as unresolved."
basis = "StargateQuerier is disabled at wasm/x/wasm/keeper/query_plugins.go:273-275 while node/app.go:772 advertises stargate."
affects = ["6.72.1"]

[decision.664]
title = "A CosmWasm gov message without a plain vote is refused"
value = "EncodeGovMsg returns ErrUnknownMsg for a nil vote or an unknown option instead of dereferencing nil."
basis = "msg.Vote.Vote is read without a nil check at wasm/x/wasm/keeper/handler_plugin_encoders.go:298 and GovMsg also carries vote_weighted (wasm-runtime/types/msg.go:135-140)."
affects = ["6.72.1"]

[decision.665]
title = "No precompile version bump for 0x1019"
value = "The origin-2 methods are added to the current xweb precompile behind the height gate; no legacy version directory is added."
basis = "The xweb versions list holds v6.8 only and GetVersioned maps to the latest (precompiles/xweb/xweb.go:151-172)."
affects = ["6.65.2", "6.65.3"]

[decision.666]
title = "The committed answer capacity of 64 is permanent"
value = "Committed origin-2 answers are never pruned; the 65th fulfilment is LXP_ARENA_EXHAUSTED as the kernel refuses it."
basis = "The kernel store capacity is 64 (include/layerx/lx_web.h:40) and the intake refuses at capacity (src/modules/web/lx_web_intake.c:569)."
affects = ["6.64.1", "6.69.3"]

[decision.667]
title = "IBC core params become genesis field 4"
value = "Params is a proto message carried as nullable GenesisState field 4; nil imports the defaults; export writes the live flags."
basis = "InitGenesis resets the flags to DefaultParams at interchain/modules/core/genesis.go:17 and ExportGenesis omits them (interchain/modules/core/genesis.go:25-31)."
affects = ["6.73.1", "6.73.2", "6.73.3"]

[decision.668]
title = "The gas table for 0x1019 origin-2 methods is the web.md D2 formula"
value = "fulfilProgram costs 30000 + 16 per input byte + 8000 per observation signature (16 when unreadable); the two views cost 3000 + 16 per input byte."
basis = "The gas constants are at precompiles/xweb/xweb.go:57-66 and signatureCount charges the maximum for unreadable input at precompiles/xweb/xweb.go:198-208."
affects = ["6.66.1", "6.65.2"]

[decision.681]
title = "contracts/security and contracts/storage are owned by domain 6 and retire with the kernel contracts, except ReentrancyLock"
value = "DelegateCallAware, Governed, LayerXComponent, UUPSNotUpgradeable and WithdrawalNullifierRegistry are deleted in wave 6 under the J36 retirement harness; ReentrancyLock stays because the retained Sidiora proxy timelock inherits it."
basis = "contracts/governance/SidioraProxyTimelock.sol:4 imports ReentrancyLock; every other importer of contracts/security and contracts/storage is a retired kernel contract (contracts/EmergencyExit.sol:1, contracts/deployment/Blueprint.sol:1) or a test suite deleted by domains 16 and 5 in wave 6"
affects = ["task.6.80.1", "task.6.80.2", "task.6.80.3", "task.6.80.4", "task.6.80.5", "interface.6.err-reentrancylock-reentrancy-ab143c06"]

[decision.682]
title = "Hardhat aligns to the Foundry solc pin for contracts/src"
value = "contracts/hardhat.config.js compiles with 0.8.27, the solc_version of foundry.paxeer.toml, because domain 6 owns the Hardhat config and domain 16 owns the Foundry config."
basis = "contracts/hardhat.config.js:8 sets 0.8.28 while foundry.paxeer.toml:10 pins 0.8.27 with auto_detect_solc false at foundry.paxeer.toml:11 for the same sources (foundry.paxeer.toml:2, contracts/hardhat.config.js:21)"
affects = ["task.6.81.1", "interface.6.cfg-contracts-hardhat-solidity-version"]

[decision.683]
title = "IBank drops the two methods 0x1001 never served"
value = "sendFromCaller and sendFromOrigin are removed from contracts/src/precompiles/IBank.sol rather than served, since no in-repo caller exists and precompiles/bank/abi.json declares neither."
basis = "contracts/src/precompiles/IBank.sol:19 and :25 declare them; precompiles/bank/abi.json:1 lists all_balances, balance, decimals, name, send (two overloads), sendNative, supply and symbol only"
affects = ["task.6.82.1", "interface.6.sol-ibank-sendfromcaller-0b5765aa", "interface.6.sol-ibank-sendfromorigin-9fdfa201"]

[decision.684]
title = "Legacy precompile snapshots are replay copies; the unwired v65 snapshots stay untasked"
value = "precompiles/<module>/legacy/<version>/abi.json and their Go packages are frozen per-upgrade copies served through GetVersioned for historical heights; they are covered by the interface.6.cfg-serve-0x10xx dispatch blocks and the current-ABI blocks, not by one block per snapshot. The v65 snapshots are listed in every versions file but no setup.go serves them; they equal v640 except for package names, so the gap changes no replay result and no task regenerates or deletes them (affirms decision.611)."
basis = "node/tags:105 lists v6.5; precompiles/bank/versions:15 lists v6.5 while precompiles/bank/setup.go:40 ends the dispatch at v6.4.0; scripts/bump_version/README.md:9-11 regenerates setup.go from the versions files; precompiles/bank/legacy/v65/bank.go:1 and precompiles/bank/legacy/v640/bank.go:1 differ only in the package clause and the pcommon import"
affects = ["6.0.1", "interface.6.cfg-serve-0x1001", "interface.6.go-pc-ibc-getversioned"]

[decision.685]
title = "Retired 0x1012, 0x1013 and 0x1014 calls decode their arguments before the retire gate"
value = "A retired call with calldata that does not decode returns the Prepare decode error, not RetiredRevert; well-formed calls get RetiredRevert as the first check of Execute. No task moves the gate into Prepare, matching decision.643 for 0x1013."
basis = "precompiles/common/precompiles.go:198-201 returns the Prepare error before Execute runs; the gates of task.6.71.1 and task.6.45.1 sit in Execute (precompiles/layerxverify/layerxverify.go:188, precompiles/layerxcustody/layerxcustody.go:219)"
affects = ["task.6.71.1", "task.6.45.1", "task.6.32.1"]

[decision.701]
title = "lx_* at HEAD"
value = "No lx_* method is registered in rpc/; the node answers -32601 for every lx_* name on HTTP and WS. The gateway still routes lx_* and its switch-off belongs to domain 8."
basis = "No lx_ registration in the HTTP or WS lists (rpc/server.go:214, rpc/server.go:392); the clients contract lists L1-L26 at spec/layerx-merge/contracts/clients.md:197-222; gateway routing at services/platform/hosted/gateway/src/rpc.rs:237."
affects = ["7.16.1", "7.0.2"]

[decision.702]
title = "eth_sendRawTransactionSync semantics"
value = "Send through SendRawTransaction, poll the receipt store, return the receipt; on timeout answer code 4 with the hash as data; the timeout parameter is capped by evm.send_raw_tx_sync_timeout."
basis = "SendRawTransaction at rpc/send.go:164 returns only the hash; clients call eth_sendRawTransactionSync."
affects = ["7.8.1", "7.8.2", "7.13.5"]

[decision.703]
title = "debug raw header, block and receipts"
value = "debug_getRawHeader, debug_getRawBlock and debug_getRawReceipts stay refused with ErrEVMNotSupported; only debug_getRawTransaction is implemented."
basis = "Refusals at rpc/tracers.go:715; there is no RLP header of a Comet block that a client could verify."
affects = ["7.18.1"]

[decision.704]
title = "Methods not served"
value = "trace_*, txpool_besuPendingTransactions, eth_mining, eth_requestAccounts and eth_signTypedData are not served; clients that call them get -32601."
basis = "No service registers them at rpc/server.go:214; their callers are wallet-side or third-party client code paths."
affects = ["7.0.4"]

[decision.705]
title = "newHeads stateRoot"
value = "The Autobahn newHeads stateRoot is the header AppHash, the value eth_getBlockByNumber returns."
basis = "rpc/subscribe.go:472 versus rpc/block.go:478."
affects = ["7.10.3"]

[decision.706]
title = "newHeads field set"
value = "newHeads carries exactly the header keys of the eth_getBlockByNumber map; sha3Uncles EmptyUncleHash; no blob or withdrawal keys; bloom and gasUsed from EVM receipts."
basis = "encodeHead at rpc/subscribe.go:524 versus the block map at rpc/block.go:630."
affects = ["7.10.1", "7.10.2"]

[decision.707]
title = "Pending block field set"
value = "The pending block carries parentHash, miner, gasLimit, baseFeePerGas, gasUsed, logsBloom, sha3Uncles, nonce, difficulty, extraData, mixHash and uncles; hash and stateRoot stay null; fullTx stays refused."
basis = "pendingBlock at rpc/block.go:296 has five keys."
affects = ["7.11.1", "7.11.2", "7.11.3"]

[decision.708]
title = "WebSocket service set"
value = "WS serves eth (including filters, raw and uncle lookups), net, web3 and the subscriptions; debug_, txpool_ and pax_ are HTTP-only."
basis = "WS list at rpc/server.go:392; pax legacy gate is HTTP middleware (rpc/rpcstack.go:324)."
affects = ["7.9.2", "7.0.4"]

[decision.709]
title = "rpc/AGENTS.md"
value = "rpc/AGENTS.md lists eth_newPendingTransactionFilter as a refused method although FilterAPI implements it, and its debug_getRawTransaction entry goes stale with task 7.18.1; J38 records this and creates no task because documentation is out of scope."
basis = "rpc/AGENTS.md:13 versus rpc/filter.go:840."
affects = []

[decision.710]
title = "web3_clientVersion"
value = "web3_clientVersion keeps answering Geth/<os>-<arch>/<go version> because client libraries branch on the Geth prefix."
basis = "rpc/web3.go:7."
affects = ["7.4.1"]

[decision.711]
title = "Rate limit key and answer"
value = "The per-IP limiter keys by the RemoteAddr host, ignores forwarding headers and answers HTTP 429 with JSON-RPC -32005."
basis = "Config keys at rpc/config/config.go:170 are read but enforced nowhere."
affects = ["7.13.3", "7.13.4"]

[decision.712]
title = "checktx_timeout"
value = "evm.checktx_timeout is retired; an app.toml still carrying it reads without an error."
basis = "Read at rpc/config/config.go:345; no reader of Config.CheckTxTimeout exists."
affects = ["7.13.2"]

[decision.713]
title = "Sequencer options in the node"
value = "The node does not pass sequencer options at HEAD; rpc/ adds and tests them and domain 5 wires them through wiring.J38.1 and wiring.J38.2."
basis = "node/app.go:3266 and node/app.go:3275."
affects = ["7.12.1", "7.12.2", "7.0.3"]

[decision.714]
title = "txpool scope"
value = "txpool_content and txpool_status report the consensus mempool only; queued is always empty."
basis = "rpc/txpool.go:40."
affects = ["7.7.1"]

[decision.715]
title = "Pending receipts"
value = "Pending receipts are served only through pax_sequencerReceipt and eth_sendRawTransactionSync; eth_getTransactionReceipt answers committed receipts."
basis = "rpc/sequencer_receipt.go:100."
affects = ["7.8.1", "7.0.3"]

[decision.716]
title = "Accidental exports"
value = "Exported helpers on served services are unexported with test wrappers in export_*_test.go files; no served name is retired by a deny list."
basis = "Cleanup at rpc/filter.go:1206 and SetReceiptLogFeed at rpc/filter.go:583."
affects = ["7.2.1", "7.2.2", "7.2.3"]

[decision.717]
title = "Pax registered set"
value = "The registered pax and pax2 set equals PaxLegacyAllGatedMethodNames; names outside it are removed because the gate refuses them fail-closed."
basis = "rpc/pax_legacy.go:42-79."
affects = ["7.3.1", "7.3.2", "7.1.1"]

[decision.718]
title = "Legacy metrics"
value = "rpc/ stops calling the utils/metrics request counter, latency and websocket connect helpers; the helpers stay in utils/metrics, which no domain owns."
basis = "rpc/utils.go:493 and rpc/websockets.go:16."
affects = ["7.14.3", "7.14.4"]

[decision.719]
title = "Unknown blockHash in eth_getLogs"
value = "eth_getLogs with an unknown or zero blockHash answers the error unknown block, as geth does."
basis = "rpc/filter.go:1677."
affects = ["7.17.2"]

[decision.720]
title = "Batch limit defaults"
value = "batch_request_limit 1000 and batch_response_max_size 25000000, the geth node defaults; 0 disables either."
basis = "SetBatchLimits at rpc/rpcstack.go:312 receives zero values at HEAD."
affects = ["7.13.5", "7.13.4"]

[decision.721]
title = "The api/ test package belongs to rpc-api"
value = "Go test files directly under api/ (package api_test) are owned by domain 7; module protos under api/<module>/ stay with their module's domain."
basis = "api/README.md:3 lists module directories only and no Go file exists directly under api/ at HEAD; scope paths of domain 7 include api/README.md and api/*.yaml"
affects = ["7.21.1", "7.29.1", "7.29.2"]

[decision.722]
title = "The root buf v2 workspace is the single buf authority"
value = "buf.yaml, buf.gen.yaml and buf.lock at the root are the only buf configuration; api/buf.yaml, api/buf.gen.yaml and api/buf.lock retire in wave 6, and generation runs only through scripts/protoc.sh. Tasks that cite api/buf.gen.yaml for generation use the root template instead."
basis = "scripts/protoc.sh:26 runs buf generate with the root template buf.gen.yaml:1-27, whose gocosmos opt at buf.gen.yaml:12 adds interfacetype, while api/buf.gen.yaml:5 omits it and writes to .. (api/buf.gen.yaml:4)"
affects = ["7.22.3", "interface.7.fmt-api-buf-yaml", "interface.7.fmt-api-buf-gen-yaml"]

[decision.723]
title = "Frozen camelCase proto fields keep their names"
value = "The seven camelCase fields keep their names and their buf:lint:ignore comments; no lint rule is relaxed in buf.yaml for them."
basis = "api/evm/receipt.proto:30-31, api/evm/tx.proto:45-50, sdk/proto/cosmos/base/abci/v1beta1/abci.proto:113-114 and consensus/proto/tendermint/abci/types.proto:183-189 carry buf:lint:ignore FIELD_LOWER_SNAKE_CASE; renaming changes the JSON names clients read"
affects = ["7.22.1"]

[decision.724]
title = "Breaking changes are checked with WIRE and WIRE_JSON against a committed image"
value = "buf breaking runs with the rules at buf.yaml:29-32 against buf.baseline.binpb at the root; an intended break replaces the baseline in the same change."
basis = "buf.yaml:29-32 already selects WIRE and WIRE_JSON; api/buf.yaml:6-8 selects FILE for a module that buf no longer builds on its own"
affects = ["7.22.2"]

[decision.725]
title = "Proto parity is checked at descriptor shape level"
value = "Each module's proto sources are compared with the descriptors its generated Go registers: package, imports, messages, fields, enums, rpcs and HTTP rules; byte-equal regeneration is checked once in wave 6."
basis = "generated descriptors are gzipped FileDescriptorProto bytes returned by Descriptor methods such as modules/epoch/types/epoch.pb.go:41 and registered by RegisterFile such as modules/epoch/types/tx.pb.go:26"
affects = ["7.21.2", "7.24.4", "7.26.2", "7.29.2"]

[decision.726]
title = "Denom-valued REST routes gain query-string bindings"
value = "Routes whose path variable is a bank denom keep the path form and gain an additional binding that takes denom from the query string; this covers bank SupplyOf and DenomMetadata and tokenfactory DenomAuthorityMetadata and DenomPaused. The oracle ExchangeRate route keeps the path form only."
basis = "grpc-gateway v1.16.0 (go.mod:48) binds {denom} to one segment, see pattern_Query_SupplyOf_0 at sdk/x/bank/types/query.pb.gw.go:853 and pattern_Query_DenomAuthorityMetadata_0 at modules/tokenfactory/types/query.pb.gw.go:520, while factory denoms contain slashes (modules/tokenfactory/types/denoms.go:26)"
affects = ["7.26.1", "7.26.2", "7.26.3", "7.26.4"]

[decision.727]
title = "REST path prefixes stay as declared"
value = "The three REST prefixes in use (/pax-protocol/paxchain/, /pax-protocol/pax-chain/ for oracle, /paxchain/ for mint) are frozen; clients call them and no route is renamed."
basis = "api/tokenfactory/query.proto:24, api/oracle/query.proto:14 and api/mint/v1beta1/query.proto:14 declare the three prefixes"
affects = ["7.29.1"]

[decision.728]
title = "Reflection services stay gRPC-only"
value = "cosmos.base.reflection v1beta1 and v2alpha1 keep their generated gateways unmounted; the mount test lists them as the only exception."
basis = "node/app.go:3014-3033 registers authtx, tmservice and ModuleBasics gateways only; sdk/client/grpc/reflection/reflection.pb.gw.go:1 and sdk/server/grpc/reflection/v2alpha1/reflection.pb.gw.go:1 are generated and not mounted"
affects = ["7.29.1"]

[decision.729]
title = "Removed field numbers are reserved"
value = "A field removed from a message is replaced by reserved statements for its number and name."
basis = "api/evm/params.proto:12-41 and api/oracle/tx.proto:24 leave removed fields as comments without reserved, while api/launchpad/tx.proto:13-14 and api/oracle/genesis.proto:17 reserve them"
affects = ["7.27.1", "7.27.2"]

[decision.730]
title = "One registration per proto file name"
value = "No generated package registers a proto file name that another linked package registers; copies under engine/deps carry their own file names and packages."
basis = "engine/deps/xevm/types/params.pb.go:446 and modules/evm/types/params.pb.go:533 register the same name, and sdk/server/grpc/gogoreflection/fix_registration.go:29 serves whichever bytes the registry holds"
affects = ["7.28.1", "7.28.2"]

[decision.731]
title = "layerxprograms protos are owned by the programs domain"
value = "api/layerxprograms and its generated Go belong to domain 13, which picks a Go directory it owns for go_package."
basis = "api/layerxprograms/tx.proto:6 names a Go directory that does not exist and no domain owns, and the programs domain owns precompiles/layerxprograms/gas.go:1"
affects = ["7.28.3"]

[decision.732]
title = "Codegen toolchain pins"
value = "buf v1.58.0, protoc-gen-gocosmos from the cosmos-proto module at go.mod:144, grpc-gateway v1.16.0 and gogofaster v1.3.2 are the generation toolchain; tests run the same pins."
basis = "scripts/protoc.sh:19-26, buf.gen.yaml:23, buf.gen.yaml:39 and go.mod:48"
affects = ["7.29.2", "interface.7.fmt-buf-gen-yaml-j39"]

[decision.733]
title = "Logs subscription lifetime"
value = "A logs subscription lives until the client unsubscribes or the connection closes (rpcSub.Err()), on a context owned by the subscription; the polling goroutine no longer waits on the eth_subscribe call context, so its lifetime is neither one poll (HEAD) nor unbounded. The live count stays capped by evm.max_subscriptions_logs (task 7.10.5)."
basis = "rpc/subscribe.go:316 waits on ctx.Done() of the call context, which startCallProc cancels when the call returns (core/deps/geth/rpc/handler.go:387-389); notifyReceiptedLogs ends on sub.Err() at rpc/subscribe.go:355; TestSubscribeNewLogs is skipped at rpc/subscribe_test.go:224"
affects = ["7.10.4", "7.10.5"]

[decision.801]
title = "px_getReceiptKeys answers the gateway's pinned receipt key list"
value = "The router answers px_getReceiptKeys from the list loaded from LAYERX_GATEWAY_RECEIPT_KEYS_FILE, the same ReceiptKeyList the settlement verifier uses, so router and clients verify receipts against one list; the list loads without kernel backends."
basis = "ReceiptKeyList is defined at services/platform/hosted/gateway/src/lib.rs:1295 and loaded only inside the kernel backend block at services/platform/hosted/gateway/src/main.rs:1021-1033; no router method serves it at HEAD."
affects = ["8.1.1", "8.1.2"]

[decision.802]
title = "Faucet funding stays on the faucet, testnet-control and core boundary chain"
value = "px_requestFunds keeps the claim path of the gateway faucet module; the gateway never signs. The bank send is made by the core boundary treasury sender (task 8.10.1), reached through the testnet control service, so the faucet service and its funding contract are unchanged."
basis = "The faucet posts claims to LAYERX_TESTNET_FUNDING_URL (services/platform/hosted/faucet/src/main.rs:310) and the testnet control forwards /admin/v1/testnet/fund to the core boundary (services/platform/hosted/testnet/src/main.rs:1235-1262); the stale plan had the faucet sign itself."
affects = ["8.2.1", "8.10.1"]

[decision.803]
title = "lx_ switch-off is one change across HTTP, WebSocket and OpenRPC"
value = "Every lx_ name answers -32601 from dispatch before backend admission, the WebSocket session sends lx_ frames to the same dispatcher, and the OpenRPC lx_ entries are deleted in the same task, because the schema test and the unified service test read all three."
basis = "The schema test at services/platform/hosted/gateway/src/rpc.rs:1114 lists lx_ names from openrpc.json, the WebSocket session excludes lx_ names at services/platform/hosted/gateway/src/ws.rs:588-594 and lx_reads_switched_off at services/platform/hosted/gateway/tests/unified_service_paths.rs:422 expects -32601."
affects = ["8.3.1"]

[decision.804]
title = "px_getAccount and px_getBalances drop the kernel half"
value = "Both methods answer from chain state at one height: balances are the bank all_balances coin list and the account is the EVM half; the layerx member and the custody join are removed instead of being derived, because no kernel account exists after the merge."
basis = "get_account joins the kernel /v1/accounts read at services/platform/hosted/gateway/src/paxeer.rs:521-535 and get_balances joins /v1/dids/{did}/accounts and 0x1013 getAsset at services/platform/hosted/gateway/src/paxeer.rs:641-661."
affects = ["8.5.1"]

[decision.805]
title = "px_getNetwork reports the consensus head, not an anchor checkpoint"
value = "Finality is the committed consensus block, so px_getNetwork answers the consensus status head and drops the anchor and kernel members; there is no anchored checkpoint to report."
basis = "get_network reads 0x1014 latestFinalized and statusOf through anchor_head at services/platform/hosted/gateway/src/paxeer.rs:714-742 and derives kernel availability at services/platform/hosted/gateway/src/paxeer.rs:783-799."
affects = ["8.5.3", "8.4.4"]

[decision.806]
title = "Capability probes cover every merged construct with one served view each"
value = "Each construct surface is probed with one cheap view taken from its served ABI file and reported with its address; 0x101B and 0x101D are probed from wave 2, 0x101A and 0x101C once their ABI files exist."
basis = "The probe table holds exchange, bridge and launchpad only at services/platform/hosted/gateway/src/capabilities.rs:47-96; precompiles/layerxpay/abi.json and precompiles/layerxprograms/abi.json exist, the ledger and auth ABI directories do not."
affects = ["8.4.2", "8.4.3"]

[decision.807]
title = "Agent-boundary receipt identifiers are EVM transaction hashes"
value = "After the merge an activity is an EVM transaction, so GET /v1/receipts/{id} and /internal/v1/receipts/{id} take the 32-byte transaction hash and answer the pax_sequencerReceipt receipt for it; the route shapes and the 32-byte hex rule are unchanged."
basis = "receipt_route parses a 32-byte hex id (services/platform/hosted/agent-boundary/src/main.rs:1809) and pax_sequencerReceipt takes a transaction hash (rpc/sequencer_receipt.go:232)."
affects = ["8.8.1", "8.8.2"]

[decision.808]
title = "Kernel program surfaces of the hosted services retire rather than translate"
value = "The gateway, agent-boundary and registry program REST routes are retired, not mapped onto 0x101D calls: clients call the programs construct through eth_call and eth_sendRawTransaction on the router, so no hosted service signs or relays program activities."
basis = "The inventory marks the program routes retire (services/platform/hosted/gateway/src/lib.rs:917-966, services/platform/hosted/agent-boundary/src/main.rs:2200-2238) and the programs construct is served at 0x101D (precompiles/layerxprograms/abi.json:1)."
affects = ["8.7.2", "8.7.3", "8.8.2", "8.8.3"]

[decision.809]
title = "One task per wave edits the platform lock file"
value = "Only task 8.20.3 in wave 5 and task 8.9.2 in wave 6 edit services/platform/Cargo.lock; other code retirements leave unused dependency lines in place until task 8.9.2, which compiles unchanged, so no two tasks of a wave collide on the lock."
basis = "services/platform/Cargo.lock is shared by every member of services/platform/Cargo.toml:2-24."
affects = ["8.9.1", "8.9.2", "8.20.3", "8.28.1"]

[decision.810]
title = "Testnet funding pays the EVM address bound to the funded DID"
value = "The core boundary funds the address addr getEvmAddrByLayerX answers for the DID's key, so the fund command keeps its fields and the faucet and testnet control are unchanged; a DID without a binding is refused, not funded natively."
basis = "FundingCommand carries did and public_key only (services/platform/hosted/core/src/main.rs:127-132) and the gateway resolves bindings through 0x1004 (services/platform/hosted/gateway/src/evm.rs:60)."
affects = ["8.10.1", "8.10.2"]

[decision.811]
title = "The core boundary keeps its kernel routes in this card"
value = "The core boundary moves its funding path to the chain in waves 3 and 4; its activity and program routes retire in wave 6 by task 8.20.1, while its state and public read routes stay inventoried stable until the kernel node they front is replaced, which this card does not schedule."
basis = "Every core route is inventoried stable (services/platform/hosted/core/src/main.rs:1640-1718) and every one is served through the kernel client (services/platform/hosted/core/src/main.rs:572)."
affects = ["8.10.1", "8.10.2", "8.20.1"]

[decision.812]
title = "Hosted readers pin receipt keys from a file, not from checkpoints"
value = "The receipt authority and agent boundary verify receipts against a pinned ReceiptKeyList file, as the gateway does, instead of a sequencer history rebuilt from kernel checkpoints; rotation is a file change and restart."
basis = "The gateway loads ReceiptKeyList from a file (services/platform/hosted/gateway/src/lib.rs:1295-1330) while the authority rebuilds history over the kernel socket (services/platform/hosted/authority/src/trust.rs:128)."
affects = ["8.11.1", "8.11.2", "8.8.1"]

[decision.813]
title = "Webhook finality on the merged chain is the committed block"
value = "A delivery is final once the receipt's block is committed; the kernel words checkpoint-finalised and paxeer-finalised are retired after a wave in which block-committed is accepted beside them, so subscribers can move their minimum first."
basis = "The vocabulary names checkpoint certificates and the Paxeer anchor (services/platform/hosted/webhooks/src/events.rs:24-27), both kernel settlement stages the merged chain does not have."
affects = ["8.13.1", "8.13.2"]

[decision.814]
title = "Testnet journeys keep their scripts and change their methods"
value = "The payment journey keeps its shape and checks but calls px_, eth_ and pax_ methods; the programs journey retires with the kernel program routes instead of being ported, since program calls are eth transactions to 0x101D."
basis = "payment-journey.py calls lx_ methods at services/platform/hosted/testnet/tests/payment-journey.py:133-260 and program-journey.py drives the retired program routes."
affects = ["8.14.3", "8.14.4"]

[decision.815]
title = "Router anchors are integration tests over the real gateway binary"
value = "Anchors 8.0.3 and 8.0.4 add integration tests that start the real gateway against local chain, consensus and indexer listeners; they edit no service code and gate the wave after them."
basis = "The degraded test harness already starts the gateway against local listeners (services/platform/hosted/gateway/tests/degraded.rs:284-300)."
affects = ["8.0.3", "8.0.4"]

[decision.816]
title = "Indexer finality on the merged chain is the committed block"
value = "The paxeer source marks a block stable when it is committed (finality depth 0) and history rows carry final_basis block_commit; a fixed LAYERX_INDEXER_FINALITY_DEPTH remains as an operator override."
basis = "The depth was derived from the anchor challenge window (services/platform/hosted/indexer/src/config.rs:33, services/platform/hosted/indexer/src/config.rs:276-295), a kernel settlement stage the merged chain does not have."
affects = ["8.16.2", "8.16.7"]

[decision.817]
title = "Kernel settlement and relay ingestion retire from the indexer"
value = "The indexer stops verifying kernel checkpoint settlement and stops ingesting the kernel relay archive; every hosted history row comes from the paxeer chain."
basis = "Settlement verification (services/platform/hosted/indexer/src/settlement.rs:95-100) and the relay source (services/platform/hosted/indexer/src/config.rs:297) read kernel artifacts that the merge retires."
affects = ["8.16.4", "8.16.7"]

[decision.818]
title = "The storage keeper and the hosted guarantors retire with the kernel checkpoint path"
value = "The storage keeper and its admission module are deleted, and the hosted node pod stops running guarantors; the guarantor script and checkpoint authority helper are deleted in wave 6 by task 8.19.1 once the kernel image stops running them."
basis = "The keeper reads the kernel node socket (services/platform/hosted/paxai-storage-keeper/src/native.rs:6) and the guarantors publish to the retired anchor (services/platform/hosted/node/deployment.yaml:244, services/platform/hosted/node/deployment.yaml:279-344)."
affects = ["8.17.1", "8.17.2", "8.18.1", "8.19.1"]

[decision.819]
title = "The hosted node launcher stays until a merged-chain pod replaces it"
value = "This card deletes the kernel node test drivers, the guarantor launcher and the custody provisioning, but keeps bootstrap.sh, supervisor.sh and sequencer-env.sh because the node pod still runs them; replacing the pod's layerxd container with the paxd deployment is a separate change this card does not schedule."
basis = "The node pod runs layerxd through the supervisor (services/platform/hosted/node/deployment.yaml:186-189) while the merged chain node is deployed separately (services/platform/hosted/paxeer/deployment.yaml:1)."
affects = ["8.19.1", "8.19.2", "8.19.3"]

[decision.820]
title = "Human provisioning funds accounts by chain transfer, not custody deposit"
value = "The owner and the explorer read principal are no longer funded through a custody deposit and a kernel credit; the owner is funded by the core testnet fund route and the owner policy drops its movement intervals."
basis = "The custody deposit deploys the retired custody contracts (services/platform/hosted/human/owner_custody.py:54-56) and the movement intervals name checkpoint stages (services/platform/hosted/human/beta-owner-policy.json:14-19)."
affects = ["8.19.4", "8.19.10"]

[decision.821]
title = "x402 commitment terms are the receipted and committed rungs"
value = "PaymentCommitment becomes \"receipted\" | \"committed\": receipted means a signed sequencer receipt under a pinned key, committed means the landing block carries a Comet commit over more than 2/3 of voting power; executed, batched and finalised are refused, and verification labels name the rung instead of sequencer-signed."
basis = "services/platform/middleware/seller/src/commitment.ts:12 declares PaymentCommitment as executed | batched | finalised and services/platform/middleware/seller/src/index.ts:76 labels evidence sequencer-signed, both kernel batch concepts that do not exist on the merged chain."
affects = ["task.8.21.2", "task.8.23.1", "task.8.24.1", "task.8.25.1", "task.8.33.2", "task.8.34.1", "task.8.34.4"]

[decision.822]
title = "x402 networks are CAIP-2 eip155 identifiers"
value = "Middleware and reference applications accept only eip155:<decimal chain id> networks, eip155:125 for the beta network, and refuse every layerx: network with unsupported-payment."
basis = "parseNetwork accepts only layerx:<id> at services/platform/middleware/seller/src/index.ts:868-875 while the hosted node runs network id 125 (services/platform/hosted/node/fly.toml:8)."
affects = ["task.8.21.2", "task.8.23.1", "task.8.24.1", "task.8.33.2", "task.8.34.2", "task.8.26.2"]

[decision.823]
title = "Payment receipt evidence is the PortableReceiptV2 document"
value = "Receipt evidence is PortableReceiptV2 with format layerx-receipt-proof-v2, verificationLevel receipted or committed, rawTransaction, signedReceipt, receiptDigest and receiptKey; committed evidence adds landingBlockHeight, blockHeader, receiptInclusion, commit and validatorSet in place of kernel batch headers, Merkle proofs and guarantor checkpoints."
basis = "LayerXReceiptEvidence carries a base64 kernel receipt at services/platform/middleware/seller/src/index.ts:73-78 and PaymentCommitmentEvidence carries kernel batch and checkpoint material at services/platform/middleware/seller/src/commitment.ts:14-25."
affects = ["task.8.22.1", "task.8.22.2", "task.8.26.1"]

[decision.824]
title = "Receipt protocol version selection retires; receipt keys are pinned"
value = "protocolVersion, requireProtocolVersion, SELECTABLE_PROTOCOL_VERSIONS and LAYERX_PROTOCOL_VERSION are removed from every middleware, conformance and example configuration; each verifier takes a receiptKeys list of pinned sequencer receipt key entries instead."
basis = "requireProtocolVersion selects kernel receipt protocol versions at services/platform/middleware/seller/src/index.ts:159-169 and services/platform/examples/support/runtime.mjs:59-65 selects them for the reference applications; signed sequencer receipts carry no such version."
affects = ["task.8.22.1", "task.8.23.2", "task.8.24.3", "task.8.24.4", "task.8.25.2", "task.8.26.1", "task.8.26.3", "task.8.33.1", "task.8.33.2", "task.8.33.4", "task.8.34.1", "task.8.34.2", "task.8.34.3"]

[decision.825]
title = "Agent daemon verification levels are Submitted, Receipted and Committed"
value = "The agent middleware accepts exactly the agentd verification levels Submitted, Receipted and Committed and refuses the six kernel levels."
basis = "services/platform/middleware/agent/src/daemon.ts:141-143 accepts Unverified, SequencerSigned, BatchIncluded, StateProven, CheckpointFinalised and SettlementAnchored."
affects = ["task.8.24.2"]

[decision.826]
title = "Kernel wire fixtures of the conformance suite are replaced by EVM fixtures"
value = "The pay6 receive, draw, batch and checkpoint fixtures built with the kernel C encoder are deleted with their generators and tests; the commitment, RPC and agent tests read an EVM receipt fixture of a 0x101A transaction, and the batched branch is dropped."
basis = "services/platform/middleware/conformance/pay6/receive_fixture.c:1 and services/platform/middleware/conformance/pay6/batch_fixture.c:1 compile kernel wire fixtures that no merged-chain surface accepts."
affects = ["task.8.26.4", "task.8.26.5", "task.8.26.6", "task.8.27.2"]

[decision.827]
title = "Ramp LayerX legs are ledger calls to 0x101A"
value = "Every ramp LayerX leg compiles to a LedgerCall to the 0x101A ledger (payExact for operator sends, draw for customer grants) submitted as an EIP-1559 transaction; the kernel LxpSend, native receive and layerx-intents compiler are removed."
basis = "services/platform/ramps/toolkit/src/lib.rs:349-378 compile_operator_send builds a kernel LxpSend with an owner authorization signature."
affects = ["task.8.28.2", "task.8.28.3", "task.8.29.1", "task.8.30.3", "task.8.31.2"]

[decision.828]
title = "The ramp signer signs secp256k1 transaction signing hashes"
value = "The ramp toolkit posts the EIP-1559 signing_hash to the signer /v1/signatures route with algorithm secp256k1 and requires the recovered sender to equal operator_address; the Ed25519 kernel digest signature is removed."
basis = "services/platform/ramps/toolkit/src/clients.rs:1319-1365 sign posts a kernel canonical digest and checks a 64-byte Ed25519 signature."
affects = ["task.8.28.4"]

[decision.829]
title = "Ramp finality is the committed rung read from the sequencer endpoint"
value = "Custody and settlement finality is read through the LayerxClient sequencer endpoint as the receipted and committed rungs; the layerx-paxeer-client FinalityTracker, RPC agreement and confirmation depth settings are removed because a committed block is final."
basis = "services/platform/ramps/toolkit/src/engine.rs:1 imports FinalityTracker from layerx_paxeer_client and services/platform/ramps/reference/src/main.rs:113-129 configures RPC agreement, confirmations and delay."
affects = ["task.8.29.2", "task.8.29.3", "task.8.30.1", "task.8.30.3", "task.8.30.4", "task.8.31.2"]

[decision.830]
title = "Ramp LayerxConfig names the sequencer endpoint, chain id and fee bounds"
value = "LayerxConfig holds rpc_endpoint, rpc_trust_anchor_der, chain_id, operator_address, receipt_keys, max_fee_per_gas, max_priority_fee_per_gas and gas_limit_cap with the existing signer fields; gateway, receipt authority, kernel protocol version, network id, Ed25519 key and sequencer batch range fields are removed."
basis = "services/platform/ramps/toolkit/src/clients.rs:876-892 LayerxConfig carries gateway_endpoint, receipt_authority_endpoint and kernel protocol fields."
affects = ["task.8.28.3", "task.8.30.4"]

[decision.831]
title = "The relay archive retires with the kernel"
value = "services/platform/relay_archive is deleted with its deployment assets, image, Makefile targets, tests and documentation; the merged node serves eth_ and pax_ reads itself, so no archive role is kept or translated."
basis = "RelayArchive serves kernel lx_ methods and batch history at services/platform/relay_archive/runtime.py:108 while the merged node serves pax_sequencerReceipt at rpc/sequencer_receipt.go:232."
affects = ["task.8.32.1", "task.8.32.2", "task.8.32.3", "task.8.32.4"]

[decision.834]
title = "Ramp journals move to a v2 domain and replay v1 read-only"
value = "New ramp journal records carry tx_hash and raw_transaction under a v2 journal domain; v1 records stay readable for projection and are never appended."
basis = "services/platform/ramps/toolkit/src/journal.rs:12 binds every record to LXP/market-maker-ramp/journal/v1 and existing journals hold kernel activity ids."
affects = ["task.8.29.1"]

[decision.841]
title = "Sequencer receipt vectors V1-V3 are already recorded"
value = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json holds V1-V3 at HEAD; SDK receipted-rung tasks 8.41.1-8.44.1 read it and task 8.47.7 republishes the cases as vector-v1 to vector-v3"
basis = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json:1 exists at HEAD with its generator in rpc/sequencer_receipt_vectors_test.go; no SDK verifies it yet"
affects = ["task.8.41.1", "task.8.42.1", "task.8.43.1", "task.8.44.1", "task.8.47.7"]

[decision.842]
title = "Kernel receipt verifier entry points stay until wave 6"
value = "the receipted and committed rungs are added in waves 1-2 beside the kernel verifier; batch inclusion, checkpoint and AuthorizedBatch verification are deleted in wave 6 together with the kernel fixtures"
basis = "spec/layerx-merge/contracts/clients.md:55 and :114 remove the checkpoint certificate and the AuthorizedBatch input at activation; the kernel fixtures have readers in domain 16 until wiring.J42.2-4 land"
affects = ["task.8.41.5", "task.8.42.5", "task.8.43.5", "task.8.44.5", "task.8.47.4", "task.8.47.5", "task.8.47.6"]

[decision.843]
title = "Payload codecs stay inside layerxprograms calldata"
value = "the native-program, account-derivation and intent-plan vectors keep their payload codec bytes and gain an evm object; they are not replaced"
basis = "spec/layerx-merge/contracts/clients.md:257 keeps the payload codecs inside the layerxprograms bytes argument and adds EVM transaction wrapping vectors"
affects = ["task.8.47.1", "task.8.47.2", "task.8.47.9"]

[decision.844]
title = "The pipeline lock is resealed once in wave 6"
value = "layerx-platform-sdkgen --write runs once after every generated, added and retired platform SDK file of waves 0-6 is in place"
basis = "sdk/platform/pipeline.kvx:252-422 digests cover files changed by tasks in waves 0, 1, 4, 5 and 6; resealing per task would put pipeline.kvx in several tasks of one wave"
affects = ["task.8.45.4"]

[decision.845]
title = "Already landed CLI register and derive bind are not re-specified"
value = "layerx register already calls px_register and layerx wallet derive --bind already submits eth_sendRawTransaction at HEAD; no J42 task covers them"
basis = "tools/platform/cli/src/rpc.rs:89 builds the px_register params that tools/platform/cli/src/register.rs:175 asserts, and tools/platform/cli/src/wallet_derive.rs:161 uses eth_sendRawTransaction"
affects = ["task.8.50.4"]

[decision.846]
title = "The platform CLI already uses no retired layerx_client module"
value = "wiring.J44.24 needs no domain-8 change: the platform CLI imports only layerx_client::account_binding, so retiring the lni, client, read, receipt and submit modules leaves tools/platform untouched and no J42 task fulfils it"
basis = "tools/platform/cli/src/wallet_derive.rs:10 is the only layerx_client import under tools/platform at HEAD; tools/platform/cli/Cargo.toml:21 declares the layerx-client dependency that account_binding still needs"
affects = ["9.24.3"]

[decision.890]
title = "Task 8.28.1 is the wave-0 lock-file editor"
value = "Task 8.28.1 edits services/platform/Cargo.lock for the wiring.J41.8 dependency removal in wave 0; the other J41.8 requester 8.31.2 drops the wiring and its lock line stays until task 8.9.2."
basis = "services/platform/Cargo.lock:1706-1716 holds the entries; decision.809 limits lock edits to one task per wave."
affects = ["8.28.1", "8.31.2", "8.9.2"]

[decision.891]
title = "Retirement of the gateway receipt views wins over the explorer receipt consumer"
value = "Per RULING J54.3 the consumers decide: the explorer UI moves to archive routes (14.32.3, 14.32.4) and the data-boundary test drops the receipt cases, so task 8.6.1 retires the receipt allowlist and proxies the archive routes; task 14.23.3 keeps no receipt consumer."
basis = "The allowlist entries are services/platform/hosted/gateway/src/explorer_proxy.rs:540-544 and :920-924."
affects = ["8.6.1", "14.23.3", "14.32.3", "14.32.4"]

[decision.901]
title = "The agent RPC envelope version stays 1 across the merge"
value = "Envelope version 1 is kept; the contract major moves to 2 inside the version exchange and every other envelope version is refused with envelope.version."
basis = "services/agent/crates/layerx-agentd/src/agent_rpc.rs:21 declares ENVELOPE_VERSION 1 and services/agent/schema/agent-api/v1.kvx:644 defines envelope.version as any version other than 1."
affects = ["9.0.2"]

[decision.902]
title = "The agent API schema is already at contract major 2 with rungs"
value = "No task re-raises the schema major; tasks bring the Rust types, daemon and generators up to the major-2 schema that is already committed."
basis = "services/agent/schema/agent-api/v1.kvx:3 declares major 2 and services/agent/schema/agent-api/write.kvx:44-45 already declares the rung-annotated SubmissionState; the stale spec lists the schema bump as pending."
affects = ["9.1.3", "9.1.4", "9.18.4"]

[decision.903]
title = "The outbox adopts the nine schema submission states"
value = "The outbox state machine uses exactly Prepared, Signed, Queued, Submitted, Unknown, Executed, Committed, Failed and Expired; an acknowledged send folds into Submitted and a superseded nonce becomes Failed with reason submission.nonce_consumed."
basis = "services/agent/schema/agent-api/write.kvx:44-45 lists the nine variants with their rungs."
affects = ["9.3.1", "9.3.2", "9.3.3"]

[decision.904]
title = "Faucet funding is an MCP tool over px_requestFunds only"
value = "faucet.claim stays refused by the agent RPC and the MCP faucet tool calls the node's px_requestFunds; the daemon holds no faucet path."
basis = "services/agent/crates/layerx-agentd/src/agent_rpc.rs:24 lists faucet.claim in RETIRED_OPERATIONS."
affects = ["9.1.5", "9.15.1"]

[decision.905]
title = "Managed agent owner rotation is refused after the merge"
value = "The rotation entry point returns a typed refusal with reason rotation_unsupported before any decode, since no chain precompile accepts a kernel owner rotation."
basis = "services/agent/crates/layerx-agentd/src/managed_agent_rotation.rs:129-131 decodes an OwnerRotation through the retired wire codec."
affects = ["9.2.4"]

[decision.906]
title = "The human peer frame LXHAGT01 is kept with its codec moved into agentd"
value = "The agent side keeps the LXHAGT01 and LXHAGT02 frame magic and moves the frame codec into human_frame.rs; the human service keeps its matching codec."
basis = "services/agent/crates/layerx-agentd/src/human.rs:14 and services/human/crates/layerx-human-service/src/server/agent_runtime.rs:31 both declare LXHAGT01."
affects = ["9.13.1", "9.13.2", "9.13.3"]

[decision.907]
title = "Kernel verification levels map onto the three rungs"
value = "Unverified and SequencerSigned map to Submitted, BatchIncluded and StateProven to Receipted, CheckpointFinalised to Committed and SettlementAnchored to no rung; Level is deleted in wave 6."
basis = "services/agent/crates/layerx-agent-api/src/error.rs:129 declares the six-variant Level."
affects = ["9.0.1", "9.4.1", "9.1.4"]

[decision.908]
title = "Idempotency windows are swept by block height"
value = "Idempotency reservations expire by committed block height instead of kernel sequence."
basis = "services/agent/crates/layerx-agentd/src/idempotency.rs:224 sweeps by current_sequence."
affects = ["9.3.2"]

[decision.909]
title = "Subscription cursors become a block, transaction and log index triple"
value = "Stored subscription records carry the magic LXS3 and a block height, transaction index and log index cursor; LXS2 and LXSB records are refused with a reset instruction."
basis = "services/agent/crates/layerx-agentd/src/events/subscription.rs:29-30 declares the LXS2 and LXSB record magics over a kernel sequence cursor."
affects = ["9.11.1", "9.11.2", "9.11.3"]

[decision.910]
title = "The layerx-wire crate stays as the agent's canonical encoding library"
value = "Only the LNI frame and kernel activity envelope uses are retired; budget, approval and evidence encodings keep using layerx-wire, so no task drops it from the agent manifests or bans it in the purity check."
basis = "services/agent/crates/layerx-agentd/Cargo.toml:17 depends on layerx-wire, which more than forty agentd source files import."
affects = ["9.18.3", "9.19.1"]

[decision.921]
title = "The layerx-wire crate stays a workspace member; only its kernel activity envelope retires"
value = "services/agent/crates/layerx-wire stays in the agent workspace as the canonical encoding library for receipts, budgets, approvals and maintenance records; the activity module (Activity, encode_signed, decode_signed, signing_bytes) and the kernel signing preimage retire because writes are EIP-1559 transactions, and no task deletes the crate."
basis = "services/agent/Cargo.toml:4 lists crates/layerx-wire as a member and services/agent/crates/layerx-agentd/Cargo.toml:17 depends on it from more than forty agentd source files, while services/agent/crates/layerx-wire/src/activity.rs:31 defines the kernel Activity that services/agent/crates/layerx-crypto/src/evm_transaction.rs:13 replaces; the stale spec task 11.7.33 deleted the whole crate."
affects = ["9.29.1"]

[decision.922]
title = "The layerx-paxeer-verifier crate retires and leaves the agent workspace"
value = "layerx-paxeer-verifier verifies kernel checkpoint certificates against layerxAnchor CheckpointSubmitted events over a pinned endpoint; with checkpoint certificates and the settlement domain retired, a block commit is the committed rung, so every caller drops the crate and the workspace member is deleted in wave 5, with wiring requests for the platform and human crates that still depend on it."
basis = "services/agent/crates/layerx-paxeer-verifier/src/contract.rs:1 imports layerx_proof::checkpoint::Certificate and :10 defines the layerxAnchor CheckpointSubmitted topic, services/agent/Cargo.toml:7 lists the member, and services/agent/crates/layerx-types/src/rung.rs:17 defines Committed as a verified Comet commit at the receipt height."
affects = ["9.28.1", "9.25.2"]

[decision.923]
title = "layerx-client keeps the node JSON-RPC client and retires the LNI kernel client modules"
value = "layerx-client keeps account_binding, paxeer_binding, sequencer, budget, grants and runtime_clock, adds px and subscription, rebases read, payments, receipt, stream, submit, batch, withdrawal, evidence and ai_market onto SequencerEndpoint, and deletes lni, client, head, resolver, handover, handover_policy, availability, caps, execution_prestate, arbiter_admission, arbiter_prestate and the evidence submodules caps, execution_prestate, arbiter_admission and arbiter_prestate, because every one of them reads kernel frames through FrameTransport, which the node no longer serves."
basis = "services/agent/crates/layerx-client/src/lni/transport.rs:122 defines FrameTransport, the only transport of services/agent/crates/layerx-client/src/read.rs:304 and services/agent/crates/layerx-client/src/submit.rs:183; services/agent/crates/layerx-client/src/sequencer.rs:197 is the node JSON-RPC client and spec/layerx-merge/contracts/clients.md:197 maps lx_sendActivity to eth_sendRawTransaction; the stale spec kept the LNI client as a compatibility path."
affects = ["9.21.6", "9.21.7", "9.24.1", "9.24.2", "9.24.3", "9.24.4", "9.24.6", "9.24.7", "9.25.1", "9.25.2"]

[decision.924]
title = "layerx-crypto discloses and signs EIP-1559 calls and retires the kernel activity disclosure"
value = "Disclosure gains a call source decoded from Eip1559Call calldata against the construct ABI rows (layerxledger send(bytes), issueGrant(bytes), draw, bank send); sign_disclosed_call signs the EIP-1559 preimage through Signer::sign_transaction; the activity source, bind over canonical activity bytes, encode_send_envelope, encode_payment_envelope, sign_disclosed, onboarding.rs and rotation.rs are deleted at wave 5 because layerx_wire::activity is deleted at wave 6; KeystoreSigner keeps ed25519 for the bind message and the payer grant authorization only."
basis = "services/agent/crates/layerx-crypto/src/disclosure.rs:22 imports the kernel activity codec and services/agent/crates/layerx-crypto/src/disclosure.rs:144 Disclosure keeps a private Activity field (services/agent/crates/layerx-crypto/src/disclosure.rs:172); services/agent/crates/layerx-crypto/src/evm_transaction.rs:13 is the transaction the node accepts; spec/layerx-merge/contracts/clients.md:41 replaces the kernel payload codec by a calldata decoder, spec/layerx-merge/contracts/clients.md:65 moves onboarding to bindLayerX, spec/layerx-merge/contracts/clients.md:66 puts DID rotation out of scope and spec/layerx-merge/contracts/clients.md:127 limits the DID key to the bind message and payer grants."
affects = ["9.31.1", "9.31.2", "9.31.3", "9.35.1", "9.35.3"]

[decision.925]
title = "layerx-sdk reads through eth_* and px_*, writes EIP-1559 layerxledger calls and verifies receipts against pinned receipt keys"
value = "RpcClient replaces every lx_ method by the clients.md section (d) replacement, Wallet builds layerxledger calls signed by the secp256k1 key, verify_receipt takes ReceiptKeys instead of an AuthorizedBatch, and the SDK stops re-exporting SettlementDomain; the kernel activity decoders in agent_envelope, programs, program_lifecycle and program_http decode raw EIP-1559 transactions instead."
basis = "services/agent/crates/layerx-sdk/src/rpc.rs:746 lists the lx_ methods; spec/layerx-merge/contracts/clients.md:82, spec/layerx-merge/contracts/clients.md:83, spec/layerx-merge/contracts/clients.md:85 and spec/layerx-merge/contracts/clients.md:88 name the replacements; services/agent/crates/layerx-sdk/src/lib.rs:30 re-exports a type task 9.27.4 deletes."
affects = ["9.32.1", "9.32.2", "9.32.3", "9.32.4", "9.35.2", "9.35.4", "9.35.5"]

[decision.926]
title = "The TypeScript and Python SDKs verify sequencer receipts at the receipted and committed rungs and drop anchor and checkpoint verification"
value = "verifySequencerReceipt and verifyCommittedReceipt (TypeScript) and verify_sequencer_receipt (Python) are the receipt verifiers; verifyBatchInclusion and verifyCheckpoint retire with the kernel batch header and guarantor certificate, and the px clients drop PxAnchorHead because px_getNetwork finality comes from the commit."
basis = "services/agent/sdk/typescript/src/verifier.ts:633 verifies a guarantor checkpoint certificate, services/agent/sdk/typescript/src/px.ts:106 decodes the layerxanchor head, spec/layerx-merge/contracts/clients.md:90 drops anchor fields and spec/layerx-merge/contracts/clients.md:100 re-implements the verifiers against the sequencer receipt."
affects = ["9.34.2", "9.33.5", "9.36.1"]

[decision.927]
title = "VerificationLevel stays through wave 6 and gains a rung mapping"
value = "layerx_types::verify::VerificationLevel is not deleted in wave 6; task 9.26.1 adds VerificationLevel::rung with the decision.907 mapping and the type is removed only after every caller has a removing task. Stale tasks 6.5.13 (do_2) and 0.58 delete it, which the code does not allow yet."
basis = "services/agent/crates/layerx-types/src/verify.rs:19 declares the type and 42 agentd source files import it without any removing task, for example services/agent/crates/layerx-agentd/src/identity.rs:4, alongside the mcp tests, the agent-api tests and services/agent/tests/qualify/fabrication.rs:1."
affects = ["9.26.1"]

[decision.928]
title = "Guarantor checkpoint certificates and the checkpoint settlement document retire in wave 6"
value = "layerx-proof deletes checkpoint.rs and settlement.rs, the complete export drops checkpoint facts and layerx-types deletes settlement.rs; the committed rung is a verified block commit served by agentd, so GuarantorKey, Certificate, verify_certificate and verify_declared_certificate retire instead of changing."
basis = "services/agent/crates/layerx-proof/src/checkpoint.rs:479 reads the embedded document of services/agent/crates/layerx-proof/src/settlement.rs:10-12, and services/agent/crates/layerx-types/src/rung.rs:17 defines Committed as a verified Comet commit at the receipt height."
affects = ["9.27.3", "9.27.4", "9.26.3"]

[decision.929]
title = "Proof verifiers that bind a signed kernel activity retire with the activity envelope"
value = "receipt::withdrawal::verify, verify_native_owner_outcome and the complete export activity facts retire in wave 6 before the layerx-wire activity module is deleted; receipts keep verifying through receipt::verify_outcome."
basis = "services/agent/crates/layerx-proof/src/receipt/withdrawal.rs:179 takes signed_activity bytes decoded through layerx_wire::activity (services/agent/crates/layerx-proof/src/receipt/withdrawal.rs:9), services/agent/crates/layerx-proof/src/receipt/owner_module.rs:2 imports decode_signed and encode_signed, and services/agent/crates/layerx-proof/src/export.rs:7 imports the same codec."
affects = ["9.27.3", "9.27.5", "9.29.1"]

[decision.930]
title = "Revert classification of registry-only rows is a layerx-types change; the header mirror needs no Rust edit"
value = "Stale task 0.162 becomes task 9.26.2; stale task 2.2.3 needs no layerx-types edit because the mirror table is generated from the header and the registry at build time."
basis = "services/agent/crates/layerx-types/build.rs:489 generates result_codes.rs from include/layerx/lxp_result.h and the registry, and services/agent/crates/layerx-types/src/result.rs:110 returns Terminal for every reason the header mirror does not recognise."
affects = ["9.26.2"]

[decision.990]
title = "J44 agent caller migrations for wiring.J44.20 and J44.21 go to J98"
value = "The callers of wiring.J44.20 and J44.21 span more than twelve files, several owned by late-wave tasks, so no single migration task fits the 12-path limit; J98 must split them by crate."
basis = "The callers start at services/agent/crates/layerx-agentd/src/main.rs:782."
affects = ["9.24.3", "9.24.7", "9.25.1", "9.25.2"]

[decision.991]
title = "J44 caller migration for wiring.J44.22 is owned by task 11.25.5"
value = "Task 11.25.5 fulfils wiring.J44.22 and task 9.24.3 no longer lists it; the requester waits for wave 4."
basis = "The request originates at services/agent/crates/layerx-agentd/src/main.rs:782."
affects = ["9.24.3", "11.25.5"]

[decision.992]
title = "J44 caller migration for wiring.J44.25 goes to J98"
value = "wiring.J44.25 has callers in files owned by tasks of a later wave than its requester 9.35.1, so the wiring is dropped from 9.35.1 and J98 must place the migration."
basis = "The request originates at services/agent/crates/layerx-agentd/src/main.rs:782."
affects = ["9.35.1"]

[decision.1001]
title = "The human-api stays at major 1 and retires operations by refusal"
value = "Deposit, withdraw, exit and wallet binding operations stay declared with retired = \"true\", the service answers them HTTP 410 operation-retired before dispatch, and the schema moves to minor 10."
basis = "services/human/schema/human-api/v1.kvx:6 makes removal a major-version change and services/human/schema/human-api/errors.kvx:10 forbids removing an error code within a major version."
affects = ["10.15.2", "10.0.2", "10.15.5", "10.15.7"]

[decision.1002]
title = "Human code uses layerx_types rungs and keeps the human-api VerificationLevel strings"
value = "Rust code carries layerx_types::rung::Rung; projections map submitted to unverified, receipted to receipt-verified and committed to checkpoint-finalised, and paxeer-finalised and settlement-anchored become retired variants."
basis = "services/agent/crates/layerx-types/src/rung.rs:11 declares Rung and services/human/schema/human-api/journeys.kvx:24 declares the VerificationLevel variants the web client decodes."
affects = ["10.2.1", "10.2.3", "10.15.3", "10.14.1"]

[decision.1003]
title = "The account_sequence field name is kept and carries the pending-tag nonce"
value = "IntentLegBinding.account_sequence and the agent runtime ACCOUNT_SEQUENCE answer keep their names and carry the EVM pending-tag nonce of the sender."
basis = "services/human/schema/human-api/intent.kvx:48 declares account_sequence in IntentLegBinding and services/human/crates/layerx-human-service/src/server/agent_runtime.rs:1783 reads it from the ACCOUNT_SEQUENCE opcode."
affects = ["10.7.1", "10.13.4", "10.13.7", "10.5.2"]

[decision.1004]
title = "The human service carries its own frame transport and keeps the LXHAGT peer codec"
value = "src/frame.rs ports the LNI transport and framing; every human socket uses it, and the LXHAGT01 and LXHAGT02 peer magics and opcode numbers stay."
basis = "services/agent/crates/layerx-client/src/lni/transport.rs:41 declares the Limits the human sockets use and services/human/crates/layerx-human-service/src/server/agent_runtime.rs:31-32 declares the LXHAGT magics."
affects = ["10.0.1", "10.4.1", "10.4.4", "10.13.3"]

[decision.1005]
title = "KMS EVM keys live in the attestor secp256k1 quorum"
value = "The KMS signs EIP-1559 transactions through the attestor /v1/sign kind evm_tx; the local seed wallet and the kernel send signers are removed and the registry file carries a chain snapshot."
basis = "services/wallet/attestor/internal/server/sign.go:31 declares kind evm_tx mapped to Secp256k1 at services/wallet/attestor/internal/server/sign.go:48, while services/human/crates/layerx-human-kms/src/evm.rs:12 holds a local seed."
affects = ["10.11.1", "10.11.2", "10.11.3", "10.11.5"]

[decision.1006]
title = "Onboarding is sponsored by the gas station with bindLayerX first"
value = "The onboarding sponsor builds a 0x1004 bindLayerX call, quotes and submits it through the gas station and confirms completion by the LayerXBound log."
basis = "services/human/crates/layerx-human-service/src/server/onboarding_sponsor.rs:176-182 requires an LNI protocol_version 3 registry and services/interop/crates/layerx-gas-station/src/service.rs:289-291 serves /quote, /submit and /status."
affects = ["10.12.1", "10.12.2"]

[decision.1007]
title = "The settlement recipient is retired end to end"
value = "LXKP op 13, the service recipient server, the custody settlement recipient and the onboarding settlement-recipient command are deleted."
basis = "services/human/crates/layerx-human-kms/src/wire.rs:50 maps (4,13) to AuthorizeRecipient and services/human/crates/layerx-human-service/src/custody/signer.rs:20-22 mounts the settlement recipient."
affects = ["10.11.4", "10.20.3", "10.12.2"]

[decision.1008]
title = "Retired workspace members: superseded by decision.1081"
value = "Superseded by decision.1081: the member removal moves to wave-5 task 10.96.1 and task 10.1.2 keeps only the manifest trim and the retired-workspace gate in wave 6."
basis = "services/human/Cargo.toml:8 and services/human/Cargo.toml:11 list the two members and services/human/Cargo.toml:38 declares the paxeer client dependency; services/human/crates/layerx-human-movement-provider/src/service.rs:16 imports layerx_paxeer_client."
affects = ["10.1.2", "10.10.1"]

[decision.1009]
title = "The human service holds no direct chain endpoint"
value = "The Paxeer RPC endpoint and finality agreement are removed; balances, nonces and receipts are read through the agent runtime peer."
basis = "services/human/crates/layerx-human-service/src/server/production_components.rs:606 probes eth_chainId on the Paxeer endpoint while services/human/crates/layerx-human-service/src/server/production_components.rs:6994-6997 already reads balances from the agent runtime."
affects = ["10.20.3"]

[decision.1010]
title = "Compatibility rows are backfilled for schema 1.8 and 1.9"
value = "The rows missing at HEAD are added with the 1.10 row and the schema check requires one row per minor."
basis = "services/human/schema/human-api/compatibility.kvx:40 ends at schema 1.7 while services/human/schema/human-api/v1.kvx:4 declares minor 9."
affects = ["10.15.2", "10.16.3"]

[decision.1011]
title = "Rung imports and decode_rung are already landed"
value = "No task re-adds the Rung imports or decode_rung; tasks 10.2.1 and 10.13.3 only remove the Level fallback and narrow the byte range."
basis = "services/human/crates/layerx-human-service/src/activity/mod.rs:18 and services/human/crates/layerx-human-service/src/server/agent_runtime.rs:20 import Rung and services/human/crates/layerx-human-service/src/server/agent_runtime.rs:4209 declares decode_rung."
affects = ["10.2.1", "10.13.3"]

[decision.1021]
title = "Paxeer client and explorer index leave the human workspace in wave 5"
value = "layerx-paxeer-client and layerx-explorer-index are deleted in wave 5 (tasks 10.26.1-10.26.16 and 10.27.1-10.27.11) and their workspace members leave in wave 5 through wiring.J46.1, one wave before task 10.1.2."
basis = "Both crates depend on layerx-paxeer-verifier (services/human/crates/layerx-paxeer-client/Cargo.toml:9, services/human/crates/layerx-explorer-index/Cargo.toml:9), which task 9.28.1 removes in wave 5 (wiring.J44.12); services/human/Cargo.toml:11 and services/human/Cargo.toml:12 list them."
affects = ["10.26.1", "10.27.1", "10.1.2"]

[decision.1022]
title = "The explorer index crate is deleted, not re-targeted"
value = "The explorer index binary, its HTTP routes, configuration and indexer library are retired; account, program and receipt pages are served by the native explorer."
basis = "The binary verifies guarantor checkpoints (services/human/crates/layerx-explorer-index/src/main.rs:217) and indexes custody events of 0x1013 (services/human/crates/layerx-explorer-index/src/unified.rs:26) and receipt-authority batches (services/human/crates/layerx-explorer-index/src/receipt_authority.rs:38), all retired surfaces."
affects = ["10.27.1", "10.27.3", "10.27.5", "10.27.7", "10.27.11"]

[decision.1023]
title = "The owner activity envelope retires instead of moving to EIP-1559"
value = "layerx_intents::owner_activity and the layerx_wire::activity re-exports of layerx_intents::canonical are deleted; owner EIP-1559 transactions are built over layerx_crypto::evm_transaction by the human service and the KMS (decision.1005)."
basis = "owner_activity builds kernel envelopes with EnvelopeBuilder (services/human/crates/layerx-intents/src/owner_activity.rs:35) and canonical re-exports layerx_wire::activity (services/human/crates/layerx-intents/src/canonical.rs:1); Eip1559Call already exists at services/agent/crates/layerx-crypto/src/evm_transaction.rs:13."
affects = ["10.21.4"]

[decision.1024]
title = "LxpSend keeps account_sequence unchanged"
value = "LxpSend.account_sequence keeps its name and type and carries the pending-tag nonce (decision.1003); layerx-intents needs no code change for it."
basis = "LxpSend stores account_sequence as Sequence (services/human/crates/layerx-intents/src/vocabulary.rs:422) and LxpSend::new applies no sequence check (services/human/crates/layerx-intents/src/vocabulary.rs:469-497)."
affects = ["override.J46.1", "override.J46.2", "override.J46.3"]

[decision.1025]
title = "Retired intent tags are refused as a retired shape and never reused"
value = "Kind tags 4, 11, 12 and 16 answer RejectReason::RetiredShape from inspect_intent; tags 1-3, 5-10, 13-15 and 17 keep their numbers."
basis = "IntentKindTag numbers the kinds at services/human/crates/layerx-intents/src/reject.rs:9-27 and RejectReason::RetiredShape is already answered at services/human/crates/layerx-intents/src/reject.rs:129."
affects = ["10.21.3"]

[decision.1026]
title = "Disclosure of 0x1015 v2 methods is not added to layerx-intents"
value = "The stale request to disclose depositMargin, withdrawMargin, placeOrder, cancelOrder and closePosition in layerx-intents is dropped; the exchange-routed kinds it would disclose are deleted with the router."
basis = "The exchange disclosure arms live at services/human/crates/layerx-intents/src/disclosure.rs:469 and are only reachable through precompile routing (services/human/crates/layerx-intents/src/precompile.rs:1142)."
affects = ["10.21.1", "10.21.2"]

[decision.1027]
title = "The gateway client follows the chain-only px_ answers"
value = "layerx-network-gateway decodes px_getBalances and px_getAccount (wave 4), px_listAssets (wave 5) and px_getNetwork (wave 6) in the shapes of tasks 8.5.1, 8.5.2 and 8.5.3."
basis = "The client decodes custody and kernel joins at services/human/crates/layerx-network-gateway/src/lib.rs:950, :976 and the anchor head at services/human/crates/layerx-network-gateway/src/lib.rs:1047."
affects = ["10.24.1", "10.24.2", "10.24.3"]

[decision.1081]
title = "All three retired crates leave the human workspace members in wave 5; task 10.1.2 trims the manifest in wave 6"
value = "The members layerx-human-movement-provider, layerx-paxeer-client and layerx-explorer-index, the workspace dependency layerx-paxeer-client and their lock entries leave services/human in wave 5 through task 10.96.1 (fulfilling wiring.J46.1); tasks 10.26.1-10.26.16 and 10.27.1-10.27.11 delete the two crate trees in wave 5; tasks 10.10.1 and 10.10.2 delete the movement provider tree in wave 6 after its member is gone; task 10.1.2 in wave 6 makes HumanWorkspaceManifest list layerx-intents and layerx-human-service only and runs the retired-workspace gate. Supersedes decision.1008 and completes decision.1021."
basis = "layerx-paxeer-client and layerx-explorer-index depend on layerx-paxeer-verifier by path (services/human/crates/layerx-paxeer-client/Cargo.toml:9, services/human/crates/layerx-explorer-index/Cargo.toml:9), which task 9.28.1 deletes in wave 5 (wiring.J44.12); layerx-human-movement-provider imports layerx_paxeer_client (services/human/crates/layerx-human-movement-provider/src/service.rs:16, services/human/crates/layerx-human-movement-provider/src/config.rs:13); Cargo loads every member listed at services/human/Cargo.toml:8, :11 and :12, so a member left in wave 6 fails every human build; HumanWorkspaceManifest lists layerx-paxeer-client and layerx-explorer-index at services/human/crates/layerx-human-service/src/lib.rs:39-40 and decision.1022 deletes the explorer index, so the manifest cannot keep it."
affects = ["10.1.2", "10.10.1", "10.10.2", "10.26.1", "10.27.1", "10.96.1"]

[decision.1101]
title = "Stale finding 5.0.8 is not reproduced at HEAD"
value = "The interop Cargo.lock lists every member and dependency edge with matching versions; no lock fix is needed at HEAD, and task 11.15.1 adds a test that keeps it so."
basis = "Members at services/interop/Cargo.toml:2-18 and pins at services/interop/Cargo.toml:27-51 each have a package entry in services/interop/Cargo.lock:1."
affects = ["11.15.1", "11.15.2"]

[decision.1102]
title = "The service relays payer-signed transactions instead of posting hosted activities"
value = "Settling handlers relay layerxTransaction with eth_sendRawTransaction and read pax_sequencerReceipt; POST /v1/activities is retired."
basis = "Hosted submission at services/interop/crates/layerx-interop-service/src/server.rs:2526; client calls at services/agent/crates/layerx-client/src/sequencer.rs:321 and services/agent/crates/layerx-client/src/sequencer.rs:337."
affects = ["11.11.2", "11.16.2", "11.16.3", "11.16.4", "11.18.1"]

[decision.1103]
title = "One canonical receipt digest"
value = "Every adapter records SHA-256 over LXP/v1/receipt, the unsigned prefix and a zero flag byte, computed by the gateway evidence module."
basis = "Private copies at services/interop/crates/layerx-ucp/src/lib.rs:794, services/interop/crates/layerx-visa-tap/src/lib.rs:590 and services/interop/crates/layerx-portable/src/receipt.rs:634; the gateway hashes whole bytes at services/interop/crates/layerx-interop-gateway/src/gateway.rs:567."
affects = ["11.0.1", "11.1.1", "11.9.2", "11.17.2"]

[decision.1104]
title = "Committed is reported only with a verified committed proof"
value = "x402 renders verificationLevel committed only when layerx-committed-proof verifies the block commit and batch inclusion; otherwise receipted."
basis = "The buyer already refuses unproved committed rungs (services/interop/crates/layerx-x402/src/buyer.rs:482)."
affects = ["11.4.2", "11.5.2"]

[decision.1105]
title = "A pending x402 settlement names the transaction hash"
value = "transaction of a pending answer is the relayed transaction hash, not the idempotency key."
basis = "Pending answer uses the idempotency hex at services/interop/crates/layerx-interop-service/src/server.rs:1236."
affects = ["11.16.2", "11.4.1"]

[decision.1106]
title = "AP2 keeps the lxp: digest reference"
value = "AP2 PaymentReceipt references stay lxp: plus the canonical digest; the transaction-hash form applies to x402 only."
basis = "Reference built at services/interop/crates/layerx-ap2/src/adapter.rs:513."
affects = ["11.7.1", "11.6.1"]

[decision.1107]
title = "A pinned receipt keys file replaces the batch-window variables"
value = "LAYERX_INTEROP_RECEIPT_KEYS_FILE pins keys by height range and is compared with px_getReceiptKeys at start; the sequencer id, key and batch-window files are retired."
basis = "Batch-window reads at services/interop/crates/layerx-interop-service/src/config.rs:268-275; key list call at services/agent/crates/layerx-client/src/sequencer.rs:367."
affects = ["11.12.1", "11.12.4", "11.12.5", "11.18.1"]

[decision.1108]
title = "J47 owns the layerx-committed-proof crate"
value = "The crate is a new interop workspace member specified by this job; the committed vectors come from the domain-5 recorder of wiring.J47.1."
basis = "Workspace members at services/interop/Cargo.toml:2-18 have no committed-proof crate."
affects = ["11.15.1", "11.2.2", "11.14.3"]

[decision.1121]
title = "The xweb precompile address is 0x1019"
value = "x-websearch watches XWebRequested and calls fulfilProgram on 0x0000000000000000000000000000000000001019; the earlier plan's 0x101D is not used."
basis = "services/interop/crates/x-websearch/src/watch.rs:13 and precompiles/xweb/abi.json:14 at HEAD."
affects = ["interface.11.rs-xws-xweb-precompile", "task.11.32.1", "task.11.32.3"]

[decision.1122]
title = "layerx-migrate mapping v2 already reads at one finalized height"
value = "No task is written for reading the mapping at a finalized height; the crate keeps its current interfaces."
basis = "services/interop/crates/layerx-migrate/src/mapping_v2.rs:76-80 reads finalized_block once and passes finalized.number to every precompile call."
affects = ["contract_context.11.bridge-relayer"]

[decision.1123]
title = "x-websearch settles paid routes on the 0x101A ledger precompile with receiver-signed EVM transactions"
value = "Metered draws are draw() transactions signed by the receiver secp256k1 key, exact payments are payExact transaction hashes, and both are concluded from pax_sequencerReceipt; the kernel activity path is retired."
basis = "services/interop/crates/x-websearch/src/payment.rs:273-352 signs a kernel activity and services/interop/crates/x-websearch/src/payment.rs:2026-2076 submits and recovers it with lx_ calls."
affects = ["task.11.34.1", "task.11.34.2", "task.11.34.3", "task.11.34.5", "task.11.34.6"]

[decision.1124]
title = "gateway.endpoint is kept as the settlement endpoint field"
value = "The config key gateway.endpoint keeps its name and now names the EVM JSON-RPC endpoint that answers eth_ and pax_sequencerReceipt; no new key is added."
basis = "services/interop/crates/x-websearch/src/config.rs:156 defines GatewayConfig with the endpoint the settlement client uses."
affects = ["interface.11.cfg-xws-gateway-endpoint", "task.11.34.4"]

[decision.1125]
title = "layerx-mirror-signer has no task"
value = "The remote signer signs digests for the mirror publisher and bridge relayer and does not read batches or receipts, so its interfaces stay stable."
basis = "services/interop/crates/layerx-mirror-signer/src/lib.rs:1-2 describes the crate as the reference remote signer."
affects = []

[decision.1126]
title = "The x-websearch conformance suite is re-recorded once after the settlement fixtures settle"
value = "Tasks that re-record gateway fixtures do not run the pinned-suite test; task 11.36.3 recomputes the digest and count in the last wave."
basis = "services/interop/crates/x-websearch/src/lib.rs:40-46 pins the count and digest over tests/fixtures/gateway."
affects = ["task.11.36.3", "task.11.34.2", "task.11.34.5", "task.11.34.6"]

[decision.1127]
title = "The ingester removal check lives in layerx-portable"
value = "The cargo metadata check that no interop package is named or depends on layerx-intent-ingester is a layerx-portable integration test, because the deleted crate cannot hold its own check."
basis = "services/interop/crates/layerx-portable/Cargo.toml:1 is a workspace member with no dependency on the ingester."
affects = ["task.11.30.1"]

[decision.1190]
title = "wiring.J48.3 is fulfilled by task 16.3.1, not 11.30.1"
value = "Task 11.30.1 cannot move to the wave of the request because task 11.22.2 owns services/interop/Cargo.lock there, so 16.3.1 fulfils wiring.J48.3 and requires 11.0.3."
basis = "services/interop/Cargo.lock is shared by the interop workspace."
affects = ["11.30.1", "16.3.1", "11.22.2"]

[decision.1201]
title = "lx_send_authorization is evaluated under its own policy kind"
value = "Add policy kind lx_send_authorization and retire lx_activity as both a sign kind and a policy kind; at HEAD a send authorization is evaluated under policy kind lx_activity."
basis = "services/wallet/attestor/internal/server/sign.go:739 returns policy.KindLXActivity for kind lx_send_authorization; services/wallet/attestor/internal/policy/lx/lx.go:667 evaluates it under KindLXActivity."
affects = ["12.3.1", "12.3.3", "12.11.3"]

[decision.1202]
title = "EVM review is a new route family beside the narrowed lx routes"
value = "Add attestor POST /v1/evm/review and gateway /v1/wallet/evm/review, /approve, /approvals/:id and /sign; the /v1/wallet/lx/* routes keep serving lx_send_authorization only instead of being re-pointed in place."
basis = "services/wallet/gateway/src/routes/sign.ts:830 accepts lx_activity and lx_send_authorization; the stale design re-points the same paths, but lx_send_authorization stays a sign kind (services/wallet/attestor/internal/server/sign.go:38)."
affects = ["12.0.2", "12.10.1", "12.10.3", "12.10.4", "12.11.2"]

[decision.1203]
title = "keys.generate is gated on the gateway certificate"
value = "The schema follows the code: POST /v1/keys/generate requires the gateway certificate."
basis = "services/wallet/attestor/internal/server/server.go:140 registers gatewayOnly keys.generate while services/wallet/schema/attestor-api/v1.kvx:41 says operator certificate."
affects = ["12.1.1"]

[decision.1204]
title = "Activity types narrow to the asset send 0x10005"
value = "ATTESTOR_ACTIVITY_TYPES admits only 0x10005 after lx_activity retires."
basis = "services/wallet/attestor/internal/server/sign.go:722 refuses a send authorization whose type is not lx.OpAssetTransfer (services/wallet/attestor/internal/policy/lx/lx.go:69); services/wallet/deploy/attestor-1.env.example:22 lists four types."
affects = ["12.12.1", "12.3.4", "12.19.3"]

[decision.1205]
title = "Attestor fee sponsors, trusted spenders and fee caps are landed baseline"
value = "No task: fee_sponsors, trusted_spenders and the fee-cap ledger separation are present at HEAD and tested; the shipped fee_sponsors list stays empty because the station signer is a deploy input."
basis = "services/wallet/attestor/internal/policy/policy.go:76 and services/wallet/attestor/internal/policy/policy.go:81 declare FeeSponsors and TrustedSpenders, services/wallet/attestor/internal/policy/policy.go:289 parses sponsors, services/wallet/deploy/attestor-policy.json:68 ships fee_sponsors empty."
affects = ["12.8.1"]

[decision.1206]
title = "The gateway sponsor key read is already retired"
value = "Stale task 8.5.4 is landed for the key input: provisionDepsFromEnv sets sponsor null; only the top-up branch of the provisioning state machine remains and task 12.6.3 replaces it."
basis = "services/wallet/gateway/src/routes/wallet.ts:64 sets sponsor null; services/wallet/gateway/src/provision/state.ts:519 still refuses with sponsor_unconfigured."
affects = ["12.6.3", "12.16.1"]

[decision.1207]
title = "layerxledger and layerxauth ABIs come from domain 2"
value = "The embedded copies are made after domain 2 publishes precompiles/layerxledger/abi.json and precompiles/layerxauth/abi.json; task 12.2.2 requires anchor 2.0.2 and wiring J49.1 and J49.2."
basis = "precompiles/setup.go:62 and precompiles/setup.go:64 name 0x101A and 0x101C while no precompiles/layerxledger or precompiles/layerxauth directory exists at HEAD; precompiles/layerxpay/abi.json:1 and precompiles/layerxprograms/abi.json:1 exist."
affects = ["12.2.1", "12.2.2"]

[decision.1208]
title = "Gateway writes go to SEQUENCER_RPC_URL and read the signed receipt"
value = "sendRawTransaction keeps its hash answer and posts to the sequencer endpoint; routes read receipts through RpcPool.sequencerReceipt over pax_sequencerReceipt."
basis = "services/wallet/gateway/src/rpc/pool.ts:347 posts eth_sendRawTransaction to the read pool; rpc/sequencer_receipt.go:26 defines pax_sequencerReceipt."
affects = ["12.0.1", "12.5.1", "12.5.2", "12.5.3", "12.6.2", "12.5.5", "12.5.6", "12.9.3", "12.10.4"]

[decision.1209]
title = "Retired tables are dropped by a forward migration"
value = "Applied migrations 005, 011 and 013 stay byte-identical; migration 019 drops layerx_accounts, wallet_custody_submissions and wallet_custody_authorizations."
basis = "services/wallet/gateway/migrations/005_agent_actions.sql:115, services/wallet/gateway/migrations/011_wallet_custody_submissions.sql:1 and services/wallet/gateway/migrations/013_wallet_custody_authorizations.sql:1 create the tables."
affects = ["12.14.4", "12.11.1"]

[decision.1210]
title = "Bind availability reads addr 0x1004"
value = "readKernelAvailability calls layerXBindNonce on 0x1004 in place of latestFinalized on the retired anchor 0x1014."
basis = "services/wallet/gateway/src/provision/bind.ts:130 reads ANCHOR_PRECOMPILE (services/wallet/gateway/src/provision/bind.ts:22); services/wallet/gateway/src/provision/bind.ts:28 declares layerXBindNonce."
affects = ["12.6.1"]

[decision.1211]
title = "Attestor metrics are served at /metrics to the operator"
value = "cmd/attestor builds NewMetrics and the server mux serves GET /metrics behind the operator certificate."
basis = "services/wallet/attestor/internal/health/health.go:147 NewMetrics has no non-test caller and services/wallet/attestor/internal/health/health.go:206 Handler is mounted nowhere."
affects = ["12.4.1", "12.4.2", "12.4.3"]

[decision.1221]
title = "The wallet ladder rungs are submitted, receipted and committed with no anchor rung"
value = "LadderRung, ExplorerRung and the app labels use submitted, receipted and committed; the anchor source and ANCHOR_TABLE are deleted."
basis = "rpc/sequencer_receipt.go:31-38 declares the rungs submitted, receipted and committed and services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/status.ex:7 declares the same three; sdk/wallet/src/ladder.ts:4 still declares instant, sealed and final."
affects = ["12.22.1", "12.22.2", "12.34.1", "12.35.1"]

[decision.1222]
title = "The wallet SDK reads pax_sequencerReceipt from the node and trusts the reported rung"
value = "readSequencerReceipt calls pax_sequencerReceipt on the wallet RPC URL; the SDK does not verify a sequencer signature and does not depend on the gateway returning the receipt."
basis = "rpc/sequencer_receipt.go:26 serves pax_sequencerReceipt with the SequencerReceiptResult of rpc/sequencer_receipt.go:150-157; no TypeScript verifier exists in sdk/wallet/src, and services/wallet/gateway/src/routes/sign.ts:570 answers only the hash at HEAD."
affects = ["12.23.1", "12.23.3", "12.23.4"]

[decision.1223]
title = "Wallet history stays on px_getUnifiedHistory and drops LayerX rows client side"
value = "getChainHistory reads px_getUnifiedHistory and keeps paxeer rows only; the stale plan to read explorer transactions is not followed."
basis = "sdk/wallet/src/endpoint.ts:99 calls px_getUnifiedHistory, which gateway task 8.2.2 keeps with only its registry source changed."
affects = ["12.24.1", "12.34.6"]

[decision.1224]
title = "The endpoint client adds chain reads beside the joined reads and retires the joined reads in wave 6"
value = "getChainAccount, getBankBalances, listBankAssets and getChainHistory are added in waves 1 to 4; getAccount, getBalances, listAssets and getUnifiedHistory are deleted in wave 6 after the app moved."
basis = "apps/wallet/src/account/AssetList.tsx:91 and apps/wallet/src/account/HistoryView.tsx:37 call the joined reads, so an in-place shape change would break the app type check before wave 5."
affects = ["12.24.2", "12.24.3", "12.24.4", "12.24.6"]

[decision.1225]
title = "KernelClient and KernelAvailability keep their names over the merged reads"
value = "KernelClient reads px_getAccount, px_getBalances, eth_getTransactionCount pending and pax_sequencerReceipt; KernelAvailability follows the px_getNetwork consensus head; getActivityStatus is deleted."
basis = "sdk/wallet/src/human.ts:102 takes options.kernel and sdk/wallet/src/human.ts:125 gates submitPlan on it; keeping the names leaves HumanClient unchanged."
affects = ["12.25.2", "12.25.3", "12.25.4"]

[decision.1226]
title = "Wallet caps are observed at a block height on a rung"
value = "WalletCapsSnapshot.observation is rung, block_number and state_root; sequence, batch and state_proven are dropped."
basis = "apps/wallet/src/surfaces/useSurface.ts:458 already reads caps by eth_call at the finalized block and apps/wallet/src/surfaces/useSurface.ts:502 fills sequence and batch with that block height."
affects = ["12.25.1", "12.33.1"]

[decision.1227]
title = "The SDK sponsored quote is served by the gateway"
value = "GasStationModule.quote posts POST /v1/wallet/sponsored/quote and reports budget_exhausted on 429."
basis = "sdk/wallet/src/modules/gas-station.ts:431 computes the quote locally from eth_gasPrice and the gateway inventories POST /v1/wallet/sponsored/quote as new."
affects = ["12.26.1"]

[decision.1228]
title = "The custody deposit flow is removed from the wallet app and SDK"
value = "The deposit route, DepositFlow, the custody helpers and the provider custody methods are deleted in wave 6."
basis = "apps/wallet/src/account/custody.ts:4 and sdk/wallet/src/provider.ts:829 target the 0x1013 custody precompile that the merge retires."
affects = ["12.28.1", "12.28.2", "12.28.3", "12.34.8", "12.34.9"]

[decision.1229]
title = "EVM transaction review replaces lx activity review in the wallet SDK"
value = "PaxeerWallet gains reviewEvmTransaction, approveEvmTransaction and evmApprovalStatus in wave 5 and loses the lx methods in wave 6; the gateway routes are named /v1/wallet/evm/review, /v1/wallet/evm/approve and /v1/wallet/evm/approvals/:id by wiring.J50.1."
basis = "sdk/wallet/src/index.ts:272-372 reviews lx_activity through /v1/wallet/lx routes served at services/wallet/gateway/src/routes/sign.ts:865, which the gateway inventory marks for re-pointing to EVM review."
affects = ["12.27.1", "12.27.2"]

[decision.1230]
title = "The exchange module on 0x1015 is the landed baseline"
value = "The exchange module and ExchangeView follow the perps v2 call shapes of 9.33.13 through task 12.33.8; no receipt task changes them."
basis = "sdk/wallet/src/modules/exchange.ts:54 and apps/wallet/src/surfaces/ExchangeView.tsx:61 still call the v1 perpsOpenPositionCall and one-argument perpsCancelOrderCall that 9.33.13 (ccec3dfd1) replaced; apps/wallet/src/surfaces/ExchangeView.test.tsx:42 tests the view."
affects = ["12.33.2", "12.33.8", "12.34.6", "14.5.1", "14.8.2"]

[decision.1231]
title = "The app health check uses the gateway /healthz"
value = "GET /api/health checks {gatewayUrl}/healthz."
basis = "apps/wallet/src/app/api/health/route.ts:125 calls /v1/wallet/health, which the gateway does not serve; services/wallet/gateway/src/index.ts:81 serves /healthz."
affects = ["12.32.1"]

[decision.1301]
title = "Chain proofs are verified by an in-crate verifier without new crates"
value = "The registry crate verifies Comet signed headers, commits, simple-merkle proofs and ICS23 IAVL and multistore proofs in its own chain_proof module, using only sha2, ed25519-dalek and curve25519-dalek that the programs lock already pins, and the kernel proof crates layerx-proof and layerx-wire leave the registry and sandbox dependencies."
basis = "programs/deny.toml:29 denies multiple versions; programs/Cargo.lock:384 and programs/Cargo.lock:479 already lock curve25519-dalek 4.1.3 and ed25519-dalek 2.2.0; the node builds proofs with sdk/store/rootmulti/proof.go:22."
affects = ["13.0.1", "13.1.1", "13.1.2", "13.1.3", "13.1.4", "13.8.2"]

[decision.1302]
title = "Programs state keys use the host module KV layout"
value = "A programs kernel key k is proven under the store key 0x01 || be16(9) || k in the host store; the store name is a parameter of the verifier, not a constant of the crate."
basis = "modules/lxphost/ctx.go:62 sets moduleKVPrefix 0x01 and modules/lxphost/ctx.go:292-296 builds moduleKVKey; programs/crates/layerx-programs-registry/src/protocol_evidence.rs:31 fixes module id 9."
affects = ["13.0.2", "13.1.4", "13.2.5", "13.3.10"]

[decision.1303]
title = "Maintenance heads, trust history and batch fields retire"
value = "VerifiedMaintenanceHead, the maintenance proofs, the trust-history constructors and every batch header digest, global sequence and sequencer key accessor are deleted; freshness comes from verified header time and trust from a persisted validator set."
basis = "programs/crates/layerx-programs-registry/src/protocol_evidence.rs:462 and programs/crates/layerx-programs-registry/src/protocol_evidence.rs:696 are the maintenance head and trust-history entry points; the kernel batch they describe is retired by the merge."
affects = ["13.3.3", "13.3.6", "13.4.6"]

[decision.1304]
title = "Sandbox expiry sweep bound becomes 128 per block"
value = "MAX_SWEEP_LEASES_PER_BATCH rises from 6 to 128 in Rust first; the kernel keeps passing its own MAX_EXPIRIES_PER_BATCH until the domain 1 change raises it to 128, so the Rust bound is never below the kernel bound."
basis = "programs/crates/layerx-programs-sandbox/src/expiry.rs:25 and src/modules/programs/sandbox_expiry.c:14 both hold 6 at HEAD and src/modules/programs/sandbox_expiry.c:350 passes the kernel value into the Rust sweep."
affects = ["13.6.1", "13.0.3"]

[decision.1305]
title = "Native receipt authority is keyed by block height"
value = "A 151-byte RawNativeReceiptAuthorityV2 keyed by block height replaces the 247-byte V1 record; Rust decodes both from wave 1 and drops V1 at wave 6 after the kernel emitter switches."
basis = "programs/crates/layerx-programs-runtime/src/ffi_call.rs:3870-3946 define the V1 record with epoch, global sequence and sequencer fields; src/modules/programs/call.c:930 emits it."
affects = ["13.7.2", "13.7.3", "13.7.5"]

[decision.1306]
title = "Program events become 0x101D logs"
value = "Guest events are emitted as ProgramGuestEvent logs of the 0x101D precompile with topic1 the program id; the canonical event envelope stays byte-identical as the commitment over one call's logs."
basis = "programs/crates/layerx-programs-runtime/src/abi/mod.rs:577 builds the envelope and programs/crates/layerx-programs-runtime/src/ffi_call.rs:1146-1163 feed it to the kernel event feed retired by the merge."
affects = ["13.7.1", "13.7.4", "13.0.3"]

[decision.1307]
title = "The frozen ABI checksum file is baseline"
value = "programs/abi-frozen.sha256 needs no task; the runtime test already compares it with the frozen sources, and the documentation mismatch belongs to domain 17."
basis = "programs/crates/layerx-programs-runtime/tests/web_read.rs:346 verifies the frozen checksums at HEAD."
affects = []

[decision.1308]
title = "The workspace release profile is baseline"
value = "The five release profile keys keep their values; no per-package profile is added."
basis = "programs/Cargo.toml:31-36 set opt-level 3, lto, codegen-units 1, panic abort and strip."
affects = []

[decision.1309]
title = "layerx_programs_call_begin keeps its signature"
value = "The call entry keeps its C signature; event logs and the V2 authority are reached through separate exports so the kernel call site does not change."
basis = "programs/crates/layerx-programs-runtime/src/ffi_call.rs:2641 and its caller src/modules/programs/call.c:2031."
affects = ["13.7.4"]

[decision.1310]
title = "Sandbox evidence is state-based"
value = "Sandbox receipts, lease transitions and terminal records are verified from transaction inclusion, the deterministic transaction result and ICS23 proofs of the kernel sandbox keys at the app hash of the next height; signed kernel activities are no longer decoded."
basis = "src/modules/programs/sandbox.c:676-684 builds the 34-byte sandbox key; programs/crates/layerx-programs-sandbox/src/activity.rs:340 holds the kernel activity, receipt and header evidence that the merge retires."
affects = ["13.3.10", "13.6.2", "13.6.3", "13.6.4"]

[decision.1311]
title = "The protocol adapter crate is deleted, not retargeted"
value = "The protocol adapter crate is removed with its C reads; its consumers read program state through eth_call on 0x101D, so no Rust replacement crate is written."
basis = "programs/crates/layerx-programs-protocol-adapter/src/lib.rs:6 exports only read_program_state, ProtocolAdapterError and ProtocolProgramStateRead over the kernel reads declared at programs/crates/layerx-programs-protocol-adapter/src/ffi.rs:148-172."
affects = ["13.8.2"]

[decision.1312]
title = "Validator signatures follow ZIP-215"
value = "The Rust commit verifier accepts exactly the signatures the consensus engine accepts, using the cofactored ZIP-215 rule rather than the strict rule of ed25519-dalek."
basis = "consensus/crypto/ed25519/ed25519.go:36 sets verifyOptions to VerifyOptionsZIP_215."
affects = ["13.1.14", "13.2.8"]

[decision.1321]
title = "deploy keeps seven inputs without feeLimit"
value = "The 0x101D deploy method keeps the seven-input signature of the ABI at HEAD; the stale contract's feeLimit form of deploy is dropped and deploy submits with a zero fee limit because the kernel deploy validate charges the lifecycle fee itself."
basis = "precompiles/layerxprograms/abi.json:71 declares deploy with seven inputs; src/modules/programs/deploy.c:453-482 is the deploy validate, which ends in lxp_ctx_charge_gas at src/modules/programs/deploy.c:481."
affects = ["13.21.1", "13.23.1"]

[decision.1325]
title = "Sandbox expiry and retirement events are logged only inside 0x101D calls"
value = "SandboxDestroyed and StorageRetired EVM logs are emitted only when the kernel events 0x090A or 0x090B appear in the receipt of a 0x101D call; expiries the kernel runs outside a call produce no EVM log."
basis = "src/modules/programs/sandbox_expiry.c:317 emits 0x090A from the expiry path and no end-block path calls pcommon.EmitEVMLog (precompiles/common/evm_events.go:16)."
affects = ["13.22.7"]

[decision.1326]
title = "Activity idempotency key from transaction hash and call ordinal"
value = "IdempotencyKey = sha256(\"layerxprograms/idempotency/v1\" || txHash || be32(ordinal) || selector), never zero, so each 0x101D call of one transaction has a distinct kernel idempotency key."
basis = "lxphost.Activity carries IdempotencyKey [32]byte at modules/lxphost/host.go:562 and the envelope field is idempotency_key at include/layerx/lxp_activity.h:24."
affects = ["13.21.8", "13.34.4"]

[decision.1329]
title = "0x101D principal is the bound DID's kernel main account"
value = "The precompile resolves the EVM caller to its bound DID and uses MainAccountID as principal with the DID as actor; an unbound caller is refused with LXP_ADDR_EVM_NOT_BOUND."
basis = "modules/evm/keeper/layerx_binding.go:18 holds the binding and modules/lxphost/accountmap.go:43 defines MainAccountID."
affects = ["13.22.3"]

[decision.1330]
title = "Static calls serve views and simulateCall only"
value = "Under readOnly the precompile serves view methods and simulateCall and refuses every other write method with ErrReadOnlyWrite; value sent to any method is refused with LXP_PRECOMPILE_NON_PAYABLE."
basis = "precompiles/layerxprograms/abi.json:1041 is the only view mutability among 0x101D methods and precompiles/common/lxp_errors.go:275 is the non-payable registry row."
affects = ["13.22.2", "13.24.2"]

[decision.1331]
title = "quoteCallFee uses the occupancy formula of the current fee schedule"
value = "quoteCallFee returns the current fee schedule version, the fee ceiling of the seven budget words computed by the kernel occupancy formula, and the schedule digest; it never runs the program."
basis = "src/modules/programs/occupancy.c:302-315 is the occupancy fee formula (budget word times schedule price, summed) and precompiles/layerxprograms/abi.json:666 declares quoteCallFee."
affects = ["13.24.3"]

[decision.1332]
title = "AI market snapshot binding v2 uses block-commit finality"
value = "FinalityEvidence and SnapshotBinding replace kernel checkpoint and settlement digests with block height, block hash, app hash and the digest of the ICS23 store proof; a committed block is final so rank is FINALIZED_RANK; snapshot_id keeps hashing only the content prefix."
basis = "programs/crates/layerx-programs-ai-market/src/queries.rs:275-281 holds checkpoint and settlement from the native checkpoint verifier, which the merged chain does not run."
affects = ["13.29.1", "13.29.2", "13.29.3"]

[decision.1333]
title = "Arbiter verifies ICS23 IAVL proofs in-crate without a new dependency"
value = "The arbiter crate carries its own IAVL existence proof verifier over its existing sha2 dependency, checked against vectors produced by the Go ics23 package, so the programs workspace lockfile gains no crate."
basis = "programs/crates/layerx-programs-arbiter/Cargo.toml:8-17 lists sha2 and no ics23 crate; go.mod:18 pins the Go ics23 package used for the vectors."
affects = ["13.30.1", "13.30.3", "13.30.4", "13.30.5"]

[decision.1334]
title = "AI market chain domain is derived from the merged chain id"
value = "PAXAI_CHAIN_DOMAIN for the merged chain is sha256(\"PAXAI/chain-domain/v1\" || chain id u64 big-endian); the Makefile host-boundary default stays for the boundary test build only."
basis = "programs/crates/layerx-programs-ai-market/src/lib.rs:42 reads PAXAI_CHAIN_DOMAIN at build time and Makefile:3624 sets the ASCII host-boundary default."
affects = ["13.31.1"]

[decision.1341]
title = "layerxprograms Msg and Query services stay descriptor-only"
value = "No Msg or Query server is registered for paxprotocol.paxchain.layerxprograms; task 13.95.1 only links the generated descriptors. Program fee governance is staged through the kernel governance activity LXP_GOVERNANCE_PROGRAMS_FEE, retirement profiles through lxp_programs_retirement_profile_stage, and every schedule, program state and balance read is a 0x101D view, so the proto rpc and message shapes stay as they are at HEAD."
basis = "src/modules/governance/lxp_governance.c:128-131 validates program fee proposals; include/layerx/programs.h:814 stages retirement profiles; precompiles/layerxprograms/abi.json:1 declares getCurrentFeeSchedule, getCurrentMeteringSchedule, getRetirementControl and getStateHead; api/layerxprograms/tx.proto:6 names modules/layerxprograms/types, which does not exist at HEAD."
affects = ["13.95.1", "7.28.3"]

[decision.1342]
title = "The arbiter crate keeps its agent-client, proof and wire dependencies"
value = "Only the registry and sandbox crates drop layerx-proof and layerx-wire (task 13.8.2, decision.1301). layerx-programs-arbiter keeps layerx-client, layerx-proof, layerx-wire and layerx-types, because it consumes VerifiedAdmissionPrestate from layerx-client, which itself depends on layerx-proof and layerx-wire; tasks 13.30.2 to 13.30.5 replace only the kernel batch, range and signed-activity paths inside the arbiter."
basis = "programs/crates/layerx-programs-arbiter/Cargo.toml:13-16 lists layerx-client, layerx-proof, layerx-wire and layerx-types; services/agent/crates/layerx-client/Cargo.toml:12-13 depends on layerx-wire and layerx-proof; programs/crates/layerx-programs-arbiter/src/step.rs:4 imports layerx_client::evidence::VerifiedAdmissionPrestate."
affects = ["13.8.2", "13.30.2", "13.30.3", "13.30.4", "13.30.5"]

[decision.1401]
title = "sdk/js becomes a first-party package aligned to HEAD by hand"
value = "sdk/js stops being a vendored snapshot in wave 0: its pin record is deleted and its provenance recorded in its README, because the snapshot ships only dist, its generate scripts name buf templates and a scripts directory that are not in the tree, and the protos it must follow live in this repository. From then on its three dist flavours are edited here to drop modules and fields no proto at HEAD declares and to add the fields HEAD declares, each edit with a node:test file under sdk/js/test. The programme domain updates the documents that list sdk/js as vendored (wiring.J53.1-3)."
basis = "CONTRIBUTING.md:19 forbids in-place edits of vendored snapshots, sdk/js/VENDOR.kvx:1-4 pins sdk/js, sdk/js/package.json:17-21 generate from buf templates absent from the tree, and consensus/proto/tendermint/types/types.proto:165-169 declares Proposal fields the snapshot lacks"
affects = ["14.0.1", "14.1.1", "14.1.2", "14.1.3", "14.3.1", "14.3.2", "14.3.3", "14.3.4", "14.3.5", "14.3.6", "14.3.7", "14.3.8", "14.3.9", "14.3.10", "14.1.4"]

[decision.1402]
title = "Perps custom-error decoding is baseline"
value = "The web decoding of 0x1015 custom errors stays as it is; no J53 task changes PERPS_ERRORS, perpsRevertReason or perpsPreflight."
basis = "precompiles/perps/errors.go:70-77 returns the custom-error selector and apps/web/src/api/precompiles.ts:367 lists those errors"
affects = []

[decision.1403]
title = "Send receipts are read with eth_getTransactionReceipt"
value = "The web app reads the receipt of every sent transaction with eth_getTransactionReceipt through the gateway relay and reports a reverted outcome for status 0x0; it does not call a sequencer receipt method."
basis = "services/platform/hosted/gateway/src/evm.rs:12 relays only the eth_, net_ and web3_ namespaces"
affects = ["14.0.2", "14.4.1", "14.4.2", "14.4.3", "14.0.4"]

[decision.1404]
title = "One explorer origin"
value = "Every explorer read goes to PAXEER_X_EXPLORER_BASE_URL without a bearer token; the separate API and program origins and the program bearer token are retired."
basis = "apps/web/src/explorer/client.ts:40-41 and :59 read two further origins and a program bearer token beside the PAXEER_X_EXPLORER_BASE_URL origin at apps/web/src/explorer/client.ts:81"
affects = ["14.5.3", "14.5.4"]

[decision.1405]
title = "Three verification rungs in the web kit"
value = "The kit renders unverified, receipt-verified and checkpoint-finalised; paxeer-finalised, settlement-anchored and unknown levels render unverified, following decision.1002."
basis = "apps/web/src/kit/model.ts:38-44 presents five levels while decision.1002 keeps three"
affects = ["14.9.1", "14.5.2", "14.5.5", "14.10.3", "14.9.2", "14.9.3", "14.9.4", "14.9.5", "14.9.6"]

[decision.1406]
title = "Custody journeys and wallet binding leave the web app"
value = "The deposit, withdraw, exit and custody hand-off journeys, their routes and the wallet payout binding screen are deleted; outward moves go to /bridge."
basis = "decision.1001 retires the operations listed at apps/web/src/api/generated/index.ts:5370-5374, and apps/web/src/app/bridge/bridge-client.tsx:133 already sends bridgeOut"
affects = ["14.7.1", "14.7.2", "14.7.3", "14.7.4", "14.7.5", "14.8.1", "14.8.2", "14.10.2", "14.11.1", "14.0.3"]

[decision.1407]
title = "sdk/js REST path segments are escaped"
value = "The tokenfactory REST clients pass every path segment through encodeURIComponent and send pagination as query parameters."
basis = "sdk/js/dist/esm/rest/tokenfactory/query.js:10 and :16 interpolate raw denom and creator strings into the path"
affects = ["14.3.6"]

[decision.1421]
title = "Keep the lx_* tables and stop writing the retired ones"
value = "No drop migration; ingestion of 0x1013 and 0x1014 stops and the custody, deposit-root and guarantor schemas and runners are deleted."
basis = "services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/custody_event.ex:52 maps lx_custody_events and services/explorer/backend/apps/indexer/lib/indexer/transform/paxeer_x_logs.ex:94-95 still parses both retired precompiles."
affects = ["task.14.25.1", "task.14.25.3", "task.14.25.4"]

[decision.1422]
title = "Serve kernel anchors and receipts read-only under /api/v2/paxeer-x/archive"
value = "Three archive routes answer the frozen rows with frozen true; the live routes retire to 404."
basis = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/routers/api_router.ex:275-277 serve the live lists from tables nothing will write after the runner retirement."
affects = ["task.14.23.2", "task.14.23.3", "task.14.23.6"]

[decision.1423]
title = "Keep the kernel frontend routes and repoint them at the archive"
value = "/paxeer-x/anchors, /paxeer-x/receipts and /paxeer-x/receipts/[id] stay; their resources read the archive routes."
basis = "apps/web/src/explorer/links.ts:26 and :41 link to the two pages."
affects = ["task.14.32.1", "task.14.32.2", "task.14.32.3", "task.14.32.4", "task.14.32.5"]

[decision.1424]
title = "Remove the unread finality settings instead of implementing a cache"
value = "runtime.exs drops the Finality statement and the env example drops the three variables."
basis = "services/explorer/backend/config/runtime.exs:656-659 sets keys that Finality.heights/1 at services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/finality.ex:62-71 never reads."
affects = ["task.14.26.2"]

[decision.1425]
title = "The contract verifier stays at its baseline"
value = "No task changes the smart-contract-verifier service; its source lookup is already disabled locally."
basis = "services/explorer/deploy/docker-compose.local.yml:106 already disables the extra source lookup."
affects = ["task.14.30.2"]

[decision.1426]
title = "A committed sequencer verification places an unindexed hash on the committed rung"
value = "Status.of/3 maps {:committed, key, height} to committed with reason :sequencer_receipt."
basis = "services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/status.ex:36-41 maps every verified answer to receipted, and SequencerReceipt.verify/4 at services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/sequencer_receipt.ex:170 already returns committed after R8."
affects = ["task.14.22.2", "task.14.22.3", "task.14.36.1"]

[decision.1427]
title = "The unified account schemas follow the controller answer"
value = "Identities are evm, pax and did; balances are asset and total; activity rows carry no side."
basis = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/v2/paxeer_x/unified_account_controller.ex:184-193 sends that shape while services/explorer/backend/apps/block_scout_web/lib/block_scout_web/schemas/api/v2/paxeer_x/unified_account/identities.ex:20 still declares kernel_account."
affects = ["task.14.27.1", "task.14.27.2", "task.14.33.1"]

[decision.1428]
title = "The sig-provider answers precompile selectors from the ABI files in the repository"
value = "A fourth source embeds the addr, layerxexchange, layerxbridge and launchpad ABIs and ranks first."
basis = "services/explorer/services/sig-provider/sig-provider/src/sources/mod.rs:1-3 lists only eth_bytecode_db, fourbyte and sigeth, none of which know the precompile selectors."
affects = ["task.14.30.1", "task.14.30.2", "task.14.30.3", "task.14.30.4"]

[decision.1429]
title = "newHeads headers are compared on parentHash and receiptsRoot as well"
value = "new_head_matches_block?/2 compares number, hash, parentHash and receiptsRoot; receiptsRoot stays LastResultsHash and is compared for equality only."
basis = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/paxeer_x.ex:247-254 compares only number and hash and services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/paxeer_x.ex:235-236 marks receiptsRoot unverifiable."
affects = ["task.14.28.1", "task.14.28.2"]

[decision.1441]
title = "The services/bridge/deploy test suite needs no re-targeting task"
value = "The stale requirement req.12411 asks to re-target services/bridge/deploy/tests at the merged chain; the suite is offline and dials nothing public, so its cases are baseline and only the new app-env cases are tasks (14.53.4, 14.58.1)."
basis = "services/bridge/deploy/tests/evm-dry-run-check.sh:45 and services/bridge/deploy/tests/solana-dry-run-check.sh:48 state that nothing public is dialled; services/bridge/deploy/tests/checklist-check.sh:21 runs checklist.sh against fixtures."
affects = ["task.14.53.4", "task.14.58.1"]

[decision.1442]
title = "The bridge app invents no Paxeer explorer"
value = "paxeerExplorerUrl is undefined when NEXT_PUBLIC_PAXEER_EXPLORER_URL is unset and every Paxeer link is then omitted."
basis = "apps/bridge/src/lib/bridge/config.ts:5-7 states nothing is invented while apps/bridge/src/lib/bridge/config.ts:33 substitutes a fixed explorer."
affects = ["task.14.57.1"]

[decision.1443]
title = "The copied telemetry hook is retired, not registered"
value = "apps/bridge ships no OpenTelemetry hook; instrumentation.node.ts and its ten packages are removed."
basis = "apps/bridge/instrumentation.node.ts:48-49 filters /explorer/ asset paths of another app and no instrumentation.ts registers the file; apps/bridge/package.json:27-36 lists the packages."
affects = ["task.14.56.1"]

[decision.1444]
title = "Submitted transfers are keyed by source hash and direction"
value = "A ledger record is written when the source transaction is submitted, under transferIdOf(direction, sourceTxHash); logIndex and bridgeOutNonce are filled later from the receipt."
basis = "apps/bridge/src/lib/bridge/transfers.ts:12 keys by logIndex or nonce, which apps/bridge/src/components/bridge/transfers-panel.tsx:46-100 only learns from the receipt, and saveTransfer at apps/bridge/src/lib/bridge/transfers.ts:75 has no caller."
affects = ["task.14.45.1", "task.14.47.2", "task.14.48.3"]

[decision.1445]
title = "The app's vault variables come from deployment records"
value = "NEXT_PUBLIC_BRIDGE_VAULT_<CHAIN> and NEXT_PUBLIC_BRIDGE_SOLANA_PROGRAM_ID are rendered by paxeer-bridge-app-env from the records deploy-evm-chain.sh and deploy-solana-program.sh write, and checked by checklist.sh."
basis = "apps/bridge/src/lib/bridge/config.ts:36-46 reads the vaults from deploy records by name and services/bridge/deploy/deploy-evm-chain.sh:12 writes one record per chain."
affects = ["task.14.53.1", "task.14.53.2", "task.14.53.3", "task.14.58.1"]

[decision.1501]
title = "Legacy go-metrics emissions are removed only after a test proves the OTel replacement records"
value = "each package gets a wave-1 verification task and a wave-6 removal task; the legacy keys are not kept behind a flag"
basis = "sdk/x/slashing/abci.go:28 carries TODO(PLT-414): remove once slashing_begin_blocker_duration verified, and the same marker shape stands beside every dual emission in sdk/baseapp/abci.go:110"
affects = ["15.2.1", "15.2.2", "15.2.3", "15.2.4", "15.2.5", "15.2.6", "15.2.7", "15.2.8", "15.2.9", "15.2.10", "15.2.11", "15.2.12", "15.2.13", "15.2.14", "15.2.15", "15.2.16", "15.3.1", "15.3.2", "15.3.3", "15.3.4", "15.3.5", "15.3.6", "15.3.7", "15.3.8", "15.3.9", "15.3.10", "15.3.11", "15.3.12", "15.3.13", "15.3.14", "15.3.15", "15.3.16"]

[decision.1502]
title = "Bank refusal of paused tokenfactory denoms is landed through the send-enabled checker"
value = "no sdk/x/bank task; the stale spec planned an edit of sdk/x/bank/keeper/send.go, HEAD registers TokenFactoryKeeper.SendEnabledChecker instead"
basis = "node/app.go:766 registers the checker; sdk/x/bank/keeper/send.go:372 consults it; the bank precompile refuses paused assets itself at precompiles/bank/bank.go:197"
affects = ["sdk/x/bank/keeper/send.go"]

[decision.1503]
title = "Integration repoints are gated by behaviour tests, not caller scans"
value = "each sdk/integrations task runs node:test, pytest, JUnit or XCTest cases of the repointed path; the stale gate tools/paxeer-x/tests/retired_callers_test.py is a source scan and is not used"
basis = "sdk/integrations/express/src/index.ts:299 still builds the authorized-batch resolver at HEAD and no test file exists under sdk/integrations/express"
affects = ["task.15.0.4", "task.15.4.1", "task.15.4.2", "task.15.4.3", "task.15.4.4", "task.15.4.5", "task.15.4.6", "task.15.4.7", "task.15.4.8", "task.15.4.9", "task.15.4.10", "task.15.4.11", "task.15.4.12"]

[decision.1504]
title = "The sealed-state setter takes the sealed context as well as the multistore"
value = "BaseApp.SetSealedStateToCommit(ctx sdk.Context, ms sdk.CacheMultiStore) error; wiring.J31.1 names only ms, but Commit needs the context of the sealed block"
basis = "sdk/baseapp/abci.go:282 reads app.stateToCommit.ctx.BlockHeader() and sdk/baseapp/abci.go:289 passes the same context to the precommit handler"
affects = ["task.15.0.3", "wiring.J31.1"]

[decision.1505]
title = "The OTel upgrade plan gauges drop the info label"
value = "plan_height and upgrade_pending_plan_height carry only the name attribute; the legacy info label is not carried forward"
basis = "sdk/x/upgrade/abci.go:60 records only attribute name while the legacy gauge beside it also labels info"
affects = ["15.3.4", "15.2.4"]

[decision.1521]
title = "Commit under Autobahn answers a named sentinel"
value = "The commit route answers coretypes.ErrCommitNotAvailable for every height under Autobahn; no CometBFT commit is synthesised from a CommitQC."
basis = "Commit at consensus/internal/rpc/core/blocks.go:216-247 reads BlockStore.LoadSeenCommit and LoadBlockCommit, and executeBlock at consensus/internal/p2p/giga_router.go:296-346 writes neither, so no commit with validator signatures exists to serve."
affects = ["5.64.1", "5.64.2", "5.68.1"]

[decision.1522]
title = "consensus/networks/remote stays out of the gated surface"
value = "The ansible and terraform trees under consensus/networks/remote are left untouched and get no task; nothing in the build or test path reads them."
basis = "consensus/Makefile:223-244 reaches only consensus/networks/local; consensus/networks/remote/integration.sh:1 clones the pre-fork repository and is called by no Makefile target."
affects = ["5.62.5"]

[decision.1523]
title = "Version stamping targets the fork module path"
value = "LD_FLAGS writes github.com/Sidiora-Labs/Paxeer-X-Network/consensus/version.TMVersion and TMVersion becomes a var so the flag takes effect."
basis = "consensus/Makefile:14 names the pre-fork module path and consensus/version/version.go:16 declares TMVersion inside a const block, so the reported version is always TMVersionDefault at consensus/version/version.go:11."
affects = ["5.61.1", "5.61.2"]

[decision.1524]
title = "IBC light-client verification of this chain under Autobahn is out of scope"
value = "No task synthesises CometBFT signed headers under Autobahn; counterparty light clients cannot verify headers of this chain until a separate design lands."
basis = "The light provider builds signed headers from the commit route at consensus/light/provider/http/http.go:237-278, and decision.1521 fixes that route to answer ErrCommitNotAvailable under Autobahn."
affects = ["5.68.1"]

[decision.1525]
title = "lag_status under Autobahn measures execution behind consensus"
value = "Under Autobahn CurrentHeight is the executed height from ABCIInfo, MaxPeerHeight is GigaRouter.LastCommittedBlockNumber and Lag is their gap, checked against Config.LagThreshold."
basis = "LagStatus at consensus/internal/rpc/core/lag_status.go:10-34 compares BlockStore.Height with the block-sync peer height, and Status at consensus/internal/rpc/core/status.go:84-97 already treats the committed height as leading the executed height."
affects = ["5.64.7"]

[decision.1526]
title = "consensus_params under Autobahn answers the genesis parameters"
value = "Until FinalizeBlock consensus parameter updates are tracked per height under Autobahn, consensus_params answers GenesisDoc.ConsensusParams for every valid height."
basis = "ConsensusParams at consensus/internal/rpc/core/consensus.go:159-175 reads StateStore.LoadConsensusParams, and executeBlock at consensus/internal/p2p/giga_router.go:336 saves only FinalizeBlock responses, not consensus parameter records."
affects = ["5.64.8"]

[decision.1527]
title = "Router event publication never fails block execution"
value = "A publish error from the event bus is logged and executeBlock continues to Commit and PushAppHash."
basis = "executeBlock at consensus/internal/p2p/giga_router.go:336-345 returns on any error, and a failed index write must not halt Autobahn execution."
affects = ["5.67.1"]

[decision.1601]
title = "Paxeer-x gate registrations move to a committed registry"
value = "tools/paxeer-x/gates/registry.kvx holds one [task.<id>] section per gate; verify-task.sh and release.sh read it."
basis = "tools/paxeer-x/verify-task.sh:283 reads spec/paxeer-x/spec.kvx, which no longer exists at HEAD."
affects = ["task.16.9.1"]

[decision.1602]
title = "Tooling reads the layerx-merge spec and ledger"
value = "Service catalogue and qualification ledger readers use spec/layerx-merge/spec.kvx and spec/layerx-merge/qualification.kvx."
basis = "scripts/ci/beta-ledger-check.sh:685 and tools/qualification/paxeer_x_release.py:63 read deleted spec trees."
affects = ["task.16.9.2", "task.16.5.1", "task.16.10.1", "task.16.10.2", "task.16.10.3", "task.16.7.1"]


[contract_context.108.decision]
derivation_message = "The account-derivation message names paxportwallet.com as the signing origin; that name is part of every derived account and is not a served name."

[contract_context.108.decision.public_names]
title = "Public names the bring-up docs may carry, read by tools/bringup/docs-names.sh"
router = "api-mainnet-beta.paxeer.network -> the unified router; its RPC endpoint is https://api-mainnet-beta.paxeer.network/rpc."
rpc = "api1..api16.mainnet-beta.paxeer.network -> the sixteen public RPC nodes, unchanged."
developers = "dev.paxeer.network -> the dashboard web app; api-dev.paxeer.network -> the dashboard API app; hooks.paxeer.network -> the webhooks app."
ramp = "ramp.paxeer.network -> the reference ramp app."

[decision.1603]
title = "Retired daemons leave the container images"
value = "docker/platform-node, docker/relay-archive and docker/intent-ingester retire; the kernel image drops layerxd, guarantor, handover, archive codec and custody-proof."
basis = "docker/platform-node/Dockerfile:13 packages only retired binaries; docker/kernel/Dockerfile:16 builds them."
affects = ["task.16.3.1", "task.16.3.2", "task.16.3.3", "task.16.3.4"]

[decision.1604]
title = "The beta deployment script retires whole"
value = "scripts/PaxeerBetaDeploy.s.sol is deleted rather than edited."
basis = "scripts/PaxeerBetaDeploy.s.sol:4-22 imports only retired root contracts."
affects = ["task.16.6.1"]

[decision.1605]
title = "The root Foundry profile stays for the kept contracts"
value = "Only the checkpoint read permissions leave foundry.toml."
basis = "foundry.toml:17-20 grants the retired checkpoint vectors; contracts/governance/SidioraProxyTimelock.sol:1 still builds under the profile."
affects = ["task.16.12.1"]

[decision.1606]
title = "Makefile retirements run dependents first"
value = "Kernel library rules wave 1, kernel component tests wave 2, agent wire and LNI wave 3, daemon dependants waves 4 and 5, the layerxd core wave 6."
basis = "LAYERXD_SOURCES at Makefile:1400-1418 is linked by the daemon tests at Makefile:3825-4146."
affects = ["task.16.2.2", "task.16.0.2", "task.16.2.3", "task.16.0.3", "task.16.0.4", "task.16.2.4"]

[decision.1607]
title = "Wave gates compose existing aggregates"
value = "scripts/gates/wave-<n>.sh runs fixed aggregate commands through scripts/gates/run_gate.py."
basis = "workspace-build, workspace-test and workspace-lint exist at Makefile:3309, :3313 and :3319."
affects = ["task.16.0.1", "task.16.1.1"]

[decision.1608]
title = "Human service tooling stays except the movement role"
value = "The human service image, rollout unit and dependency policy stay; only the movement role and provider binary leave the image (task 16.3.6)."
basis = "services/human/Cargo.toml:1 is live; the movement provider exec at docker/human-service/entrypoint.sh:242 is retired by the human domain."
affects = ["task.16.3.6"]

[decision.1609]
title = "Generated, relative and non-path names are not defects"
value = "Inventory entries flagged only for build outputs, GitHub action names, MCP methods, case ids or build-context paths are stable."
basis = "tools/qualification/beta_driver.py:918 declares the case id; docker/web/Dockerfile:19 starts a build output."
affects = []

[decision.1610]
title = "Rules whose source names a retired symbol keep their rule"
value = "The test source changes belong to the kernel and test owners; the Makefile rule text is unchanged."
basis = "Makefile:430 compiles tests/ledger/test_receive.c, whose symbol use is the retirement point."
affects = []

[decision.1611]
title = "The replay golden release gate retires with its target"
value = "The replay-matrix job, scripts/ci/replay-matrix.sh and the replay golden inventory rows leave CI in wave 1, together with the Makefile targets."
basis = "scripts/ci/replay-matrix.sh:25 runs test-replay-golden-local, whose source tools/paxeer-x/retired_callers.json:224-225 lists as deleted."
affects = ["task.16.2.2", "task.16.5.6"]

[decision.1621]
title = "C suites are selected by Makefile target, and named cases by --run"
value = "Every C test binary stays selectable by its Makefile target; binaries that register cases with the harness also accept --run <name> through lxp_test_main, because at HEAD lxp_test_run_all is the only entry point and runs every case."
basis = "tests/lxp_test_harness.c:29"
affects = ["16.21.1", "16.23.1", "16.23.2"]

[decision.1622]
title = "No kernel-to-chain parity harness under tests/parity"
value = "The stale parity harness at tests/parity/kernel_chain (stale requirement 12038) is not written: its fixture loader lxp_replay_fixture_load is retired with the kernel replay engine (wiring.J22.42), and tests/parity does not exist at HEAD."
basis = "src/replica/lxp_replay_fixture.c:76"
affects = ["16.31.2", "16.33.4"]

[decision.1623]
title = "tests/solidity retires as a whole"
value = "Every Solidity suite under tests/solidity imports a contracts/ source that the chain-modules domain retires, including contracts/governance/SidioraProxyTimelock.sol, so all eighteen files are deleted rather than retargeted, and the foundry.toml test directory is removed through wiring."
basis = "tests/solidity/SidioraProxyGovernance.t.sol:4"
affects = ["16.30.1", "16.30.2"]

[decision.1624]
title = "The paxload report is JSON"
value = "The --report-path file holds the JSON FinalStats document, as the LoadConfig comment states, not the text rendering that LogFinalStats writes at HEAD."
basis = "tools/loadtest/config/config.go:20"
affects = ["16.24.2", "16.24.3"]

[decision.1625]
title = "Sourceless benchmark scenarios retire"
value = "The univ2 and wasm OCC benchmark scenarios retire because their contracts have no source in the repository (the deploy script compiles absent files and the tester is a prebuilt binary), while erc20 and erc721 get their sources restored to match the committed bindings."
basis = "tools/benchmark/loadtest/contracts/deploy_univ2.sh:27"
affects = ["16.26.1", "16.26.2", "16.26.3"]

[decision.1626]
title = "Daemon-driven test suites retire with the daemon"
value = "Python qualification drivers, the relay-archive end-to-end suite and the C suites that include cmd/layerxd sources are deleted, not retargeted, because each builds or runs tests/daemon programs or layerxd binaries that the node-runtime domain retires."
basis = "tests/modules/paxeer_x_budget_lifecycle.py:26"
affects = ["16.34.1", "16.34.2", "16.34.3", "16.35.1"]

[decision.1627]
title = "Benchmark regression threshold"
value = "benchmark-compare.sh compares each label's median against the first label and fails above a 5 percent drop by default, keeping the warm-up and low-reading filter that the script applies at HEAD."
basis = "tools/benchmark/benchmark-compare.sh:273"
affects = ["16.25.1", "16.25.2"]

[decision.1628]
title = "OCC harness fixtures follow the node capability list"
value = "The node keeps its wasm capability list iterator,staking,stargate,pax, so the OCC harness stops storing mars.wasm, which exports requires_sei, and instantiates the in-tree cw20_base.wasm instead; the node list is not widened for a test fixture."
basis = "tests/occ/utils/utils.go:160"
affects = ["16.38.1"]

[decision.1701]
title = "0x1015 is the perps venue"
value = "0x1015 serves the pure-Go perps module from v6.12.0; the layerxexchange keeper and precompile at the same address are legacy replay below that plan (decision.301)."
basis = "precompiles/perps/perps.go:27 sets PerpsAddress = exchangetypes.ExchangeAddress (modules/layerxexchange/types/ids.go:15); v6120StoreUpgrades adds the perps store (node/upgrades.go:410-415)."
affects = ["0x1015", "modules/perps", "precompiles/perps", "modules/layerxexchange"]
carry = "new"

[decision.1702]
title = "pricefeed 0x1020 is the price source"
value = "pricefeed at 0x1020 is the price source of the perps and spot venues from v6.12.0; the stale exchange pushOracle path is void (decision.304)."
basis = "precompiles/pricefeed/pricefeed.go:23 declares 0x1020 and node/giga_v6120.go:12 repeats it; v6120StoreUpgrades adds the pricefeed store (node/upgrades.go:412)."
affects = ["0x1020", "modules/pricefeed", "precompiles/pricefeed"]
carry = "new"

[decision.1703]
title = "spot runs on PECOR at 0x1021-0x1025"
value = "Spot trading is the PECOR set at 0x1021 PECOR, 0x1022 Orders, 0x1023 StopOrders, 0x1024 Quoter, 0x1025 Vault; production serves spot.NewServedSet (decision.322, decision.334)."
basis = "modules/spot/types/keys.go:12-24 declares the five addresses; v6120StoreUpgrades adds the spot store (node/upgrades.go:412)."
affects = ["0x1021", "0x1022", "0x1023", "0x1024", "0x1025", "modules/spot"]
carry = "new"

[decision.1704]
title = "launchpad is the v6.12.0 native rewrite"
value = "Launchpad at 0x1017 is the native rewrite registered by the v6.12.0 plan; the v6.10 precompile is frozen for replay under precompiles/launchpad/legacy/v610 (decision.401)."
basis = "modules/launchpad/types/keys.go:26 declares LaunchpadAddress; precompiles/launchpad/launchpad.go:37 binds it; node/upgrades_v6120.go:75 runs the launchpad step of the plan."
affects = ["0x1017", "modules/launchpad", "precompiles/launchpad"]
carry = "new"

[decision.1705]
title = "xweb fee destinations by origin"
value = "Origin-1 web fees are paid into the xweb module account; origin-2 fees are paid from the per-asset program fee account to the signers' payout accounts in equal shares, remainder to the first signer (decision.561)."
basis = "modules/xweb/keeper/request.go:53 and splitProgramFee at modules/xweb/keeper/program_fulfil.go:189-226."
affects = ["modules/xweb", "0x1019"]
carry = "new"

[decision.1706]
title = "address-table reality: production serves none of the twelve merge addresses"
value = "MergeAddressTable names twelve addresses (0x101A-0x101D, 0x0901-0x0908) whose names win (decision.605), but at HEAD no production import registers a constructor, so a merged node serves none of them until the node imports the constructor packages; the programme activation table records served_at_head = false for all twelve."
basis = "precompiles/setup.go:61-74 lists the table; newMergePrecompiles builds registered constructors only (precompiles/setup.go:117); the only registrar is precompiles/layerxagent/teeattestor/teeattestor.go:103-104, imported by tests alone; node/app.go:990 calls GetCustomPrecompiles."
affects = ["precompiles/setup.go", "0x101A", "0x101B", "0x101C", "0x101D", "0x0901", "0x0908"]
carry = "new"

[decision.1707]
title = "saturn.wasm and venus.wasm are retired fixtures"
value = "saturn.wasm and venus.wasm export requires_sei and are not deployable after the merge; their deploy scripts move to the in-tree cw20 fixture, as task 16.38.1 does for mars.wasm."
basis = "tests/integration/contracts/deploy_wasm_contracts.sh:36 and :50 and tools/benchmark/loadtest/contracts/deploy_ten_contracts.sh:34-35 deploy them."
affects = ["tests/integration/contracts", "tools/benchmark/loadtest/contracts"]
carry = "new"

[decision.1708]
title = "launchpad API bundles and SQL tree are external gaps"
value = "The launchpad OpenAPI and AsyncAPI bundles and the root launchpad SQL tree are not in the repository; they are recorded in the external gap register and no task regenerates their consumers until they are committed."
basis = "The consumer tree is services/launchpad (CONTRACT domain 4); the gap register is task 17.13.1 at spec/layerx-merge/programme/data/external-gaps.kvx (planned)."
affects = ["services/launchpad", "apps/launchpad"]
carry = "new"

[decision.1709]
title = "go-cgo tasks prebuild the kernel archives"
value = "Every task whose package links modules/lxphost runs in the go-cgo profile, whose prebuild makes build/liblayerx.a and the programs sandbox archive before build_cmd."
basis = "modules/lxphost/ctx.go:1 builds only under cgo; precompiles/setup.go:117 links the kernel through its constructors."
affects = ["modules/lxphost", "precompiles"]
carry = "new"

[decision.1710]
title = "one programme gate at one revision"
value = "The programme gate passes only when every wave gate evidence line carries exit=0 at the same revision; mixed revisions refuse the candidate."
basis = "spec/layerx-merge/spec.kvx:9 states the completion clause; spec/workflow.kvx:32 sets max_gate_runs_per_task."
affects = ["spec/layerx-merge/programme"]
carry = "new"

[decision.1711]
title = "qualification ledger sections are unique"
value = "The duplicate finding sections of the qualification ledger are renamed with a .2 suffix; no body changes."
basis = "spec/layerx-merge/qualification.kvx:4 and :46 both open finding.5.0.8; :18 and :53 both open finding.7.0.8."
affects = ["spec/layerx-merge/qualification.kvx"]
carry = "new"

[decision.1712]
title = "stale task-ownership rulings are not carried"
value = "Decisions whose ruling only named stale task ids (37, 44-47, 63, 65-67, 76-81) are not carried as rulings; v2 ownership is one task per file per wave and order is the requires graph."
basis = "spec/workflow.kvx:145-156 lists the roles that own the waves; tools/paxeer-x/retired_callers.json:2 holds the caller inventory those rulings sequenced."
affects = ["spec/layerx-merge/spec.kvx"]
carry = "new"

[decision.1713]
title = "Eight requires cycles are broken by earlier fulfilment or by dropping same-wave requires"
value = "C1: wiring.J22.65 is fulfilled by 5.53.1 and wiring.J40.702 by 5.54.2 and 5.54.10 instead of 5.97.1. C2: 2.95.2 requires 6.0.2 instead of 6.0.3. C3: wiring.J33.59 is fulfilled by 6.60.5 instead of 6.97.2. C4: wiring.J33.12 moves from 5.55.5 to the wave-7 gate 5.0.9. C5: 17.93.1 drops 6.0.2. C6: 8.93.1 and 16.93.1 require 14.0.1 instead of 14.0.2. C7: 10.96.1 drops 10.26.1. C8: 16.97.5 drops 16.33.5 and requires 16.0.4. No fulfils or wiring entry was removed to hide a cycle."
basis = "resolve_wiring adds every fulfilling task to the requester's requires and the strongly connected components of the expanded graph were eight sets; each edit removes one edge per set and keeps the work and its fulfilment."
affects = ["5.97.1", "5.53.1", "5.54.2", "5.54.10", "2.95.2", "6.97.2", "6.60.5", "5.55.5", "5.0.9", "17.93.1", "8.93.1", "16.93.1", "10.96.1", "16.97.5"]
carry = "new"

[decision.1714]
title = "Merge-table interfaces not served at HEAD are new, and address values are hex only"
value = "Every interface at an address of MergeAddressTable whose effective status was change is new (158 edits, through the override block where one exists). 23 address values that were not 0x-hex move into notes as Address: text. The 68 interfaces without an address keep none, because the key is optional for shared agent errors and spot share tokens."
basis = "MergeAddressTable (precompiles/setup.go:60) serves an address only when a merge constructor is registered; only teeattestor registers one and no node package imports it, so no merge address is served at HEAD."
affects = ["MergeAddressTable", "interface status", "override status"]
carry = "new"

[decision.1715]
title = "Wave gates are fulfilled by each wave's own transition task and the final gate replays the evidence"
value = "wiring.J60.1 to J60.7 are fulfilled by 16.1.1 to 16.1.7 and need waves 0 to 6; 17.5.1 to 17.5.7 sit in waves 0 to 6. run_programme checks the transition evidence of waves 0 to 6, then reruns wave-0.sh to wave-6.sh and wave-programme.sh at the candidate revision and refuses when two revisions differ (17.5.8, 17.0.9, req 17061)."
basis = "16.97.4 at wave 6 fulfilled every wave gate, so a wave-0 transition waited for a wave-6 task; the earlier-wave rule of resolve_wiring forbids that order."
affects = ["16.97.4", "16.1.1", "16.1.7", "17.5.1", "17.5.7", "17.5.8", "17.0.9", "req.17061"]
carry = "new"

[decision.1716]
title = "Contract and service facts follow the code at HEAD"
value = "pricefeed 0x1020 events list the EVM events it emits; oracle 0x1008 storage describes the MidBlocker vote tally; layerxpay escrowDisputeResolve gas is 80000; ten of the eleven launchpad role ABIs are served; human-kms serves TCP TLS; platform-runtime-clock serves the clock socket; human-network-gateway is a client crate only; human-explorer-index is retired."
basis = "Authority order of the contract: the code at HEAD wins over a stale fragment; each edited value cites its source line in logs/J98.md."
affects = ["contract_context.3.pricefeed-0x1020", "contract_context.3.oracle-0x1008", "contract_context.2.layerxpay-0x101b", "decision.401", "service.human-kms", "service.platform-runtime-clock", "service.human-network-gateway", "service.human-explorer-index"]
carry = "new"

[decision.1717]
title = "Service dependencies name existing service blocks"
value = "gas-station-relayer is gas-station, ai-artifacts is platform-ai-artifacts, receipt-authority is platform-receipt-authority and unified-router is platform-gateway; platform-faucet depends on platform-core-boundary because it forwards claims to the core boundary funding endpoint. archive-node, monitoring and indexer stay external names: no service of the repository serves them."
basis = "Dependency strings that matched no service block could not be resolved by a reader; the faucet forward is in services/platform/hosted/faucet/src/main.rs."
affects = ["service.platform-faucet", "service dependencies"]
carry = "new"

[decision.1718]
title = "Idempotent receipt consumers conflict with the replay retirement: unresolved, flagged for domains 1, 2 and 13"
value = "decision.101 stays in force: the kernel stops idempotency lookups at wave 3 and deletes the table at wave 6, and 1.25.1 and 1.25.2 retire the host 0x04 rows and ReadIdempotentReceipt at wave 5. Planned consumers still read that store: 2.7.4 and the resultByIdempotency view of 2.40.4 and 2.58.4, the replay acceptances 2.20.2 and 2.252.3 of 2.22.4, 2.40.1, 13.22.4 (13.253.1, 13.257.2), 13.30.3 (13.284.1) and 13.294.1. Before wave 3 either those consumers move to the sequence guard and to the receipt that Submit returns, or decision.101 is narrowed to keep the record and the read; J98 made neither edit because both cascade into state-root, snapshot and ICS23 vectors owned by other jobs."
basis = "At HEAD ReadIdempotentReceipt (modules/lxphost/read.go:444) has no production caller, while the kernel lookup at src/protocol/lxp_kernel.c:3517 is on the main execute path; the consumers are planned tasks only, so the consumers-decide ruling has no HEAD consumer to apply."
affects = ["decision.101", "1.2.1", "1.2.3", "1.25.1", "1.25.2", "2.7.4", "2.22.4", "2.40.1", "13.22.4", "13.30.3", "req.13294"]
carry = "new"

[decision.1719]
title = "Domain 13 places ReceiptAuthorities on the activities it submits"
value = "Task 13.98.1 copies the receipt authorities a program call cites into Activity.ReceiptAuthorities, which task 1.26.1 adds and fills into the node verified receipt index through wiring.J98.1."
basis = "decision.192 requires it; Activity is modules/lxphost/host.go:555-566 and the kernel reads verified_receipts at include/layerx/lxp_kernel.h:220."
affects = ["13.98.1", "1.26.1", "wiring.J98.1", "decision.192"]
carry = "new"

[decision.1720]
title = "The J44 caller migrations are split by crate and wave"
value = "wiring.J44.20 and J44.21 (needed by 9.24.3 at wave 3) and wiring.J44.25 (needed by 9.35.1 at wave 5) are fulfilled by 8.98.1 to 8.98.13 and 10.98.1 to 10.98.14, one task per crate and free wave with at most eleven caller files and one planned absence test; three files that another task owns in every earlier wave are migrated inside that task (10.20.3, 10.25.2, 10.0.3)."
basis = "decisions 990 and 992 left the migrations unplaced; a path may be touched by one task per wave and a fulfilling task may not be later than its requester. The callers start at services/platform/hosted/core/Cargo.toml:1 and services/human/crates/layerx-human-service/Cargo.toml:1."
affects = ["wiring.J44.20", "wiring.J44.21", "wiring.J44.25", "9.24.3", "9.35.1", "10.20.3", "10.25.2", "10.0.3"]
carry = "new"

[decision.1721]
title = "endOfBlock stays and KeyID is the pinned sequencer id"
value = "5.17.2 deletes Seal only and keeps endOfBlock, which SealBatch calls; 7.94.1 and req 7961 check KeyID against the SequencerID that ReceiptKeys pins for the receipt height, not a digest of the signing key."
basis = "SealBatch calls endOfBlock at node/sequencer/seal.go:174; ReceiptKey.KeyID returns the pin's SequencerID at node/sequencer/receiptkey.go:91-100."
affects = ["5.17.2", "7.94.1", "req.7961"]
carry = "new"

[decision.1722]
title = "Interface notes follow the code at HEAD"
value = "The launchpad add-protocol-fees notes cite ProtocolFeesKey at keys.go:76 under ProtocolFeesPrefix at keys.go:38; pax_sequencerReceipt notes state the -32000 not-served answer; override.J55.17 carries both transfers-panel spans and override.J55.16 agrees with it."
basis = "ProtocolFeesPrefix is modules/launchpad/types/keys.go:38; sequencerNotServedCode is rpc/sequencer_receipt.go:49."
affects = ["interface.4.go-launchpad-keeper-keeper-add-protocol-fees", "interface.7.rpc-pax-sequencerreceipt", "override.J55.17"]
carry = "new"

[decision.1723]
title = "The J16 launchpad Solidity inventory is canonical"
value = "The 1660 J11 interfaces of launchpad Solidity files repeat J16 entries at the same path and line; each J11 entry keeps its block and notes its J16 twin. No task names a J11 entry, so readers and tasks use the J16 ids."
basis = "Both inventories cite identical path:line pairs; J16 also covers 213 further lines."
affects = ["interface.4.sol-lp-*", "interface.4.sol-*"]
carry = "new"

[decision.1724]
title = "Verify commands match their toolchain and select every named test"
value = "Rust commands carry --locked and --exact; layerx-registry is layerx-platform-registry; 5.94.3 runs one go test with an anchored -run; vitest -t uses a word-boundary group; a task whose verify toolchain is outside its profile uses mixed; 9.27.6 is existing because every test it names exists; node --test-name-pattern tasks register one case per named test because the runner exits 0 when no case matches. 19 cargo commands without -p run single-package manifests and stay."
basis = "The package name is services/platform/hosted/registry/Cargo.toml:2; sweep logs/J98-scripts/sweep_verify.py reports the remaining shapes."
affects = ["verify_cmd", "sandbox_profile", "9.27.6", "5.94.3"]
carry = "new"

[decision.1725]
title = "The J60 service generator is stale and refuses to run"
value = "fragments/J60/_gen/gen_services.py raises before writing, because J79 and J98 edited fragments/J60/service.kvx in place; its operation task selection also skips the N.0.9 gates."
basis = "A rerun would overwrite the in-place corrections of decisions 1716 and 1717."
affects = ["fragments/J60/_gen/gen_services.py", "service blocks"]
carry = "new"

[decision.1726]
title = "8.9.2 also removes the ramp toolkit lock entries"
value = "8.9.2 removes the layerx-intents and layerx-paxeer-client lines of layerx-ramp-toolkit in the platform lock file and its acceptance asserts it."
basis = "decision.890 names the lock entry at services/platform/Cargo.lock:1361."
affects = ["8.9.2", "req.8082", "acceptance.8.82.1"]
carry = "new"

[decision.1727]
title = "Handoff findings recorded without an edit"
value = "Recorded for the owning domain, no gate weakened: pay gas 2.28.1 against 2.40.5 and programs gas 13.22.1 against the HEAD gas table stay as written, with the HEAD table authoritative; programs native runtime binding and genesis visibility; standby signed replay 5.5.8, accepted-without-receipt, adoption header 5.19.3, replication auth 5.5.5 and the missing archive-node service; 3.93.1 against wiring.J24.14 and the SQL bundles of decisions 442 and 446; broad operation_task bindings; paxai-worker key source and px_requestFunds not served; 27 file-only citations; 9.33.10 legacy exchange calldata, 8.41.2 H+1 against commit height, 211 client edges without receiver ids, launchpad browser-stream receivers, program-read REST paths and SDK route gaps; 54 brace-line citations of the 0x101D interfaces and the wasm-meter signature; buf module names in the buf config signature (public module identifiers of the repository); 12 JSON-RPC notes that start with the transport; N.0.9 completion gates that check retirement and file existence; the C test binaries named as their only test; the file-driven merge Info: the upgrade-info file holds only name and height (sdk/store/types/store.go:56-59) and applyNamedUpgrade builds the plan without Info (node/upgrades.go:616) while mergeUpgradePlan reads plan.Info as the sequencer genesis (node/upgrades.go:434), so until domain 5 adds a genesis source the merge must be scheduled by a plan that carries Info; no interface kind for Python SDK items; 180 deleted items skipped by the inventory."
basis = "Each needs a ruling or code reading by the owning domain beyond a final sweep; out/BUILD-REPORT.md lists them one per line."
affects = ["2.28.1", "2.40.5", "13.22.1", "5.5.5", "5.5.8", "5.19.3", "3.93.1", "9.33.10", "8.41.2", "applyNamedUpgrade"]
carry = "new"

[decision.1728]
title = "J95 programme findings follow the code at HEAD and the domain decisions"
value = "ReleaseRetired (6.46.1) runs only while the merge plan is being applied and refuses once it is done, because the done height is written after the handler; the activation plan (17.1.1) records v7.0 with the sequencer and six LayerX stores and the anchor store delete plan after it; the bring-up golden (17.1.3) pins a receipt key covering S = H_act+1 (decision.521); the receipt-order golden (17.1.9) names App.LeaderSchedule because 5.6.4 deletes sequencerPinnedLeader; the merge rehearsal (5.6.9) serves 0x101D once 13.32.2 registers it; the anchor golden (17.1.8) expects refusal after the anchor store delete (decision.631); the refusal table (17.2.3) uses ErrModuleRetired code 29 (decision.654) and the retired-callers catalogue (16.9.4) states LXP_EXCHANGE_RETIRED (decision.324)."
basis = "The upgrade keeper calls the handler at sdk/x/upgrade/keeper/keeper.go:375 and SetDone at :394; sequencerPinnedLeader is node/upgrades.go:466-484; the anchor module name is modules/layerxanchor/types/keys.go:6."
affects = ["6.46.1", "17.1.1", "17.1.3", "17.1.8", "17.1.9", "5.6.9", "17.2.3", "16.9.4", "req.6485", "req.17002", "req.5063"]
carry = "new"

[decision.1790]
title = "Waves 0-6 are balanced by moving free tasks"
value = "274 tasks moved (wave 6 to 5 or 4, wave 1 to 2) only where every require and wiring fulfiller sits at or below the new wave, every dependent at or above it, and no task of the new wave owns one of its paths; anchors and domain 17 never move."
basis = "The completion clause of spec/layerx-merge/spec.kvx:9 needs every verify_cmd to pass at one revision."
affects = ["1.0.4", "16.0.4"]

[decision.1791]
title = "J57 consensus and interchain tasks belong to domains 5 and 6"
value = "The 37 J57 tasks under consensus/ became 5.61-5.69 and task 15.26.1 under interchain/ became 6.13.1, with owner roles fm-node-runtime and fm-chain-modules; requires, wiring requesters and decision references follow."
basis = "interchain/scripts/protocgen.sh:1 is a domain-6 surface."
affects = ["6.13.1", "5.61.1"]


