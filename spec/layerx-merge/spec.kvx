ac_2 = "getRetirementControl (precompiles/layerxprograms/abi.json:513) returns the retirement control record bytes, the genesis record before any retirement."

[req.13279]
title = "Bind AI market snapshots to block-commit finality instead of kernel checkpoints"
ac_1 = "FinalityEvidence (programs/crates/layerx-programs-ai-market/src/queries.rs:275) carries native_state_root, block_height, block_hash, app_hash and store_proof_digest in place of checkpoint and settlement, and bind_snapshot (programs/crates/layerx-programs-ai-market/src/queries.rs:309) copies them into the binding only when native_state_root equals the capture root (decision.1332)."
ac_2 = "bind_snapshot returns QueryError::BindingMismatch for evidence naming another native_state_root and NON_CANONICAL for a zero block_hash or app_hash, replacing the rank-above-4 refusal at programs/crates/layerx-programs-ai-market/src/queries.rs:322."

[req.13280]
title = "Encode SnapshotBinding v2 with the block-commit section and keep the content id"
ac_1 = "SnapshotBinding::encode (programs/crates/layerx-programs-ai-market/src/queries.rs:367) writes the unchanged content prefix, then block_height u64, block_hash, app_hash and store_proof_digest, rank u8, publication_time_ms u64 and 8 zero bytes, and BINDING_MAX_BYTES (programs/crates/layerx-programs-ai-market/src/queries.rs:37) equals BINDING_PREFIX_MAX_BYTES + 8 + 3 * 32 + 1 + 8 + 8."
ac_2 = "snapshot_id keeps hashing only the content prefix under PAXAI/view/v1 (programs/crates/layerx-programs-ai-market/src/queries.rs:384-389), so two bindings of one capture with different block-commit evidence share one id."
ac_3 = "require_finalized (programs/crates/layerx-programs-ai-market/src/queries.rs:395) returns FinalityUnavailable unless rank equals FINALIZED_RANK and block_hash and app_hash are nonzero."

[req.13281]
