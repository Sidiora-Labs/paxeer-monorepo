storage = "none; bounds live in Settings and LoadConfig"
errors = "ErrPerformanceBounds wrapped with every Violation; main exits 1 at tools/loadtest/main.go:89"
events = "final report JSON written to --report-path"
gas = "none"
activation = "flags in wave 2, profile bounds in wave 6"
invariants = "a zero bound is unset; a flag value overrides a profile value; the exit code is 0 only when Check returns no Violation"
