[task.1.23.1]
title = "Set the asset binding authority and stop forcing signature_valid in the host"
status = "done"
mode = "BUILD"
wave = 5
requires = ["1.22.1", "1.0.2"]
reqs = ["1246.1", "1246.2", "1246.3"]
capabilities = ["1.23.1"]
interfaces = ["interface.1.go-lxphost-host-execute-j22"]
do_1 = "At HEAD lxphost_execute sets execution->signature_valid = true (modules/lxphost/host.go:468) for every activity, so lxp_admit_activity (src/protocol/lxp_kernel.c:7112) never refuses a bad signature for governance and Programs activities."
do_2 = "Set signature_valid to the result of lxp_activity_verify_signature (include/layerx/lxp_activity.h:47) == LXP_OK when Activity.Signature is non-empty, and to true for an empty signature only when the caller passes the node-verified binding flag added to lxphost_execute."
do_3 = "lxphost_bind_assets (modules/lxphost/host.go:159) sets node->asset_runtime.binding_authority from the same flag, the bool the kernel adds last in lx_asset_runtime (include/layerx/lx_asset.h:122-130) under anchor 1.0.2; a zero-initialised runtime keeps it false."
do_4 = "HostExecute (modules/lxphost/host.go:678) derives the flag from KernelAuthority: true only when Bound (task 1.22.1) is set, Activity.Signature is empty and VerifiedKey equals the AuthorityKey of the activity; any other empty-signature activity is refused with LXP_ERR_BAD_SIGNATURE (include/layerx/lxp_result.h:49)."
do_5 = "Create modules/lxphost/binding_test.go (planned) with TestHostBindingAuthorityUnsignedRegister, TestHostRejectsForgedSignature and TestHostBindingAuthorityKeepsPayloadHash."
do_6 = "Bind an lx_programs_transfer_runtime (include/layerx/programs.h:1014) on the host node beside lxphost_bind_assets (modules/lxphost/host.go:169-193), setting node->kernel.module_runtime[LXP_MODULE_PROGRAMS] with resolve_metering_schedule and resolve_occupancy_parameters (include/layerx/programs.h:1020 and :1023), so lxp_kernel_batch_snapshot_create (src/protocol/lxp_kernel.c:785-792) no longer answers LXP_ERR_MODULE_DISABLED and task 1.93.2 can simulate an LX_PROGRAMS_CALL activity."
symbols = ["lxphost_execute", "lxphost_bind_assets", "binding_authority", "signature_valid", "TestHostBindingAuthorityUnsignedRegister", "TestHostRejectsForgedSignature", "TestHostBindingAuthorityKeepsPayloadHash"]
touches = ["modules/lxphost/host.go", "modules/lxphost/binding_test.go"]
tests = ["modules/lxphost/binding_test.go::TestHostBindingAuthorityUnsignedRegister", "modules/lxphost/binding_test.go::TestHostRejectsForgedSignature", "modules/lxphost/binding_test.go::TestHostBindingAuthorityKeepsPayloadHash"]
planned_paths = ["modules/lxphost/binding_test.go"]
build_cmd = "make paxd-native-libs && CGO_ENABLED=1 go build ./modules/lxphost/"
verify_cmd = "CGO_ENABLED=1 go test -count=1 ./modules/lxphost/ -run '^(TestHostBindingAuthorityUnsignedRegister|TestHostRejectsForgedSignature|TestHostBindingAuthorityKeepsPayloadHash)$'"
gate_kind = "planned"
sandbox_profile = "go-cgo"
