[contract_context.2.layerxagent-module]
interface = "Module layerxagent: proto Params, MsgUpdateParams, GenesisState and Job, gRPC queries Params, Job and Pending, CLI query commands, typed job events and the keeper RunDue end-block entry"
storage = "layerxagent store: params, next job id, job records and the due index keyed by block BE then id BE (modules/layerxagent/keeper/keeper.go:167-169); escrowed deposits held by the module account"
errors = "Keeper refusals map to the layerxagent registry codes; MsgUpdateParams from a non-governance authority is refused; genesis with an underfunded escrow is refused at InitGenesis"
events = "Typed module events EventJobExecuted and EventJobFailed per run job (modules/layerxagent/keeper/scheduler.go:66-75)"
gas = "Params.MaxBlockGas 30000000 bounds the summed GasLimit admitted per height and RunDue returns the gas used, which the legacy end block adds to blockGasUsed (decision.227); MaxCallDataBytes 8192 (decision.228)"
activation = "Jobs run only after the MergeUpgrade plan is active (modules/layerxagent/keeper/keeper.go:113); the AppModule registers genesis and services and has no end block of its own"
invariants = "Due jobs run in ascending (block, id) order (decision.226); next job id exceeds every stored id; module account balance covers every active job deposit"
pause = "Params.Paused stops RunDue from running jobs, which stay due, and refuses schedule and reschedule while cancel stays open (decision.225)"
interfaces = ["interface.2.cli-layerxagent-query-job-j24", "interface.2.cli-layerxagent-query-params-j24", "interface.2.cli-layerxagent-query-pending-j24", "interface.2.evt-layerxagent-event-job-executed", "interface.2.evt-layerxagent-event-job-failed", "interface.2.gen-layerxagent-jobs-j24", "interface.2.gen-layerxagent-max-block-gas-j24", "interface.2.gen-layerxagent-max-call-data-bytes-j24", "interface.2.gen-layerxagent-paused-j24", "interface.2.go-layerxagent-appmodule-j24", "interface.2.go-layerxagent-keeper-defaultmaxjobgaslimit-j24", "interface.2.go-layerxagent-keeper-defaultmaxjobsperblock-j24", "interface.2.go-layerxagent-keeper-defaultmaxjobspercreator-j24", "interface.2.go-layerxagent-keeper-defaultmaxreasonbytes-j24", "interface.2.go-layerxagent-keeper-defaultmaxschedulehorizon-j24", "interface.2.go-layerxagent-keeper-defaultmindepositfactor-j24", "interface.2.go-layerxagent-keeper-defaultparams-j24", "interface.2.go-layerxagent-keeper-exportgenesis-j24", "interface.2.go-layerxagent-keeper-initgenesis-j24", "interface.2.go-layerxagent-keeper-job-j24", "interface.2.go-layerxagent-keeper-keeper-active-j24", "interface.2.go-layerxagent-keeper-keeper-cancel-j24", "interface.2.go-layerxagent-keeper-keeper-deletejob-j24", "interface.2.go-layerxagent-keeper-keeper-endblocker-j24", "interface.2.go-layerxagent-keeper-keeper-getjob-j24", "interface.2.go-layerxagent-keeper-keeper-getparams-j24", "interface.2.go-layerxagent-keeper-keeper-iteratedue-j24", "interface.2.go-layerxagent-keeper-keeper-j24", "interface.2.go-layerxagent-keeper-keeper-moduleaddress-j24", "interface.2.go-layerxagent-keeper-keeper-nextjobid-j24", "interface.2.go-layerxagent-keeper-keeper-pending-j24", "interface.2.go-layerxagent-keeper-keeper-reschedule-j24", "interface.2.go-layerxagent-keeper-keeper-schedule-j24", "interface.2.go-layerxagent-keeper-keeper-setjob-j24", "interface.2.go-layerxagent-keeper-keeper-setparams-j24", "interface.2.go-layerxagent-keeper-modulename-j24", "interface.2.go-