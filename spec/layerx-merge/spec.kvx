[req.13282]
title = "Write an in-crate ICS23 IAVL existence proof verifier for the arbiter"
ac_1 = "verify_existence (planned in programs/crates/layerx-programs-arbiter/src/ics23.rs) accepts the IAVL existence proofs of programs/tests/vectors/ics23-iavl-existence.json (planned), produced by the Go ics23 package pinned at go.mod:18, computing the root with the IAVL leaf and inner op rules over sha256 only (decision.1333)."
ac_2 = "verify_existence returns ProofError::RootMismatch when the value, key or one inner-op byte differs and ProofError::Malformed for a leaf op whose hash is not sha256."

[req.13283]
