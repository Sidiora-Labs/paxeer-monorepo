ac_2 = "A keeper whose evmKeeper does not provide a non-nil upgrade keeper fails closed: ProgramOriginActive answers false at every height, so origin 2 stays disabled rather than opening without an activation record (modules/xweb/keeper/keeper.go:23)."

[req.6722]
title = "Refuse RequestFromProgram with LXP_MODULE_DISABLED below the merge plan"
