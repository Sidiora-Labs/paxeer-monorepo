[task.8.28.2]
title = "Compile ramp legs as ledger calls and verify them from signed sequencer receipts"
status = "pending"
mode = "BUILD"
wave = 4
requires = ["8.28.1", "9.23.7"]
reqs = ["8267.1", "8267.2", "8267.3", "8267.4"]
capabilities = ["8.28.2"]
interfaces = ["interface.8.rs-ramp-toolkit-lib-compiledpayment-j41", "interface.8.rs-ramp-toolkit-lib-compile-payer-grant-draw-j41", "interface.8.rs-ramp-toolkit-lib-operator-send-authorization-message-j41", "interface.8.rs-ramp-toolkit-lib-compile-operator-send-j41", "interface.8.rs-ramp-toolkit-lib-receiptevidence-j41", "interface.8.rs-ramp-toolkit-lib-verifiedlayerxleg-j41", "interface.8.rs-ramp-toolkit-lib-verify-order-receipt-j41", "interface.8.rs-ramp-toolkit-lib-ledgercall-j41"]
do_1 = "services/platform/ramps/toolkit/src/lib.rs:349-378 compile_operator_send builds a kernel LxpSend with an owner authorization signature; build a LedgerCall to LEDGER_ADDRESS with encode_pay_exact(from operator account id, to customer account id, layerx_asset, layerx_amount, quote expires_at, order_digest as payment reference) per decision.827."
do_2 = "services/platform/ramps/toolkit/src/lib.rs:279-302 compile_payer_grant_draw builds a kernel LxpReceive; for an off-ramp order build a LedgerCall with encode_draw(from customer account id, asset, amount, payer grant id, receiver sequence, order_digest, order context) and refuse an on-ramp order with RampError::PayerGrantRequired."
do_3 = "services/platform/ramps/toolkit/src/lib.rs:306-346 operator_send_authorization_message builds the kernel owner authorization message; remove it, since the EIP-1559 signature authorises the call."
do_4 = "services/platform/ramps/toolkit/src/lib.rs:393-405 ReceiptEvidence holds a canonical receipt and an AuthorizedBatch and VerifiedLayerxLeg holds batch_id and resulting_state_root; hold raw_transaction, the signed receipt bytes and the receipt key entries, and return tx_hash, receipt_digest (keccak256 of the signed receipt), height and rung."
do_5 = "services/platform/ramps/toolkit/src/lib.rs:409-461 verify_order_receipt checks a kernel receipt against the order; verify the Ed25519 sequencer signature with verify_sequencer_signature (services/agent/crates/layerx-proof/src/receipt.rs:666), require the key range to cover the height, require activity hash equal to keccak256 of the raw transaction, and require exactly one decode_ledger_payment result whose fields bind the order direction, accounts, asset, amount and reference."
do_6 = "services/platform/ramps/toolkit/tests/contracts.rs:215 payment_direction_selects_direct_send_or_customer_grant calls the kernel compilers; move it to the LedgerCall compilers keeping its direction assertions, and remove native_receive_binds_genuine_signed_grant_to_order_and_operator at services/platform/ramps/toolkit/tests/contracts.rs:1005 per decision.827."
do_7 = "Create services/platform/ramps/toolkit/tests/evm_order.rs (planned) with the four tests below over receipts signed in the test with an ed25519-dalek key."
do_8 = "Adapt only the call sites in services/platform/ramps/toolkit/src/clients.rs (:26, :1022, :1038, :1230-1250, :1270, :2470), services/platform/ramps/toolkit/src/engine.rs:331 and services/platform/ramps/toolkit/src/bin/ramp-verify-receipt.rs that reach the removed compilers and fields so the crate compiles; their rewrite belongs to task 8.28.3."
symbols = ["compile_operator_send", "compile_payer_grant_draw", "verify_order_receipt", "ReceiptEvidence", "VerifiedLayerxLeg", "LedgerCall"]
touches = ["services/platform/ramps/toolkit/src/lib.rs", "services/platform/ramps/toolkit/tests/contracts.rs", "services/platform/ramps/toolkit/tests/evm_order.rs", "services/platform/ramps/toolkit/src/clients.rs", "services/platform/ramps/toolkit/src/engine.rs", "services/platform/ramps/toolkit/src/bin/ramp-verify-receipt.rs"]
