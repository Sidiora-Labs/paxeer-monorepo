ac_1 = "A LayerX proposal carrying spot MsgUpdateParams executes, which modules/layerxgov/types/proposal.go:220-221 refuses at HEAD."
ac_2 = "A LayerX proposal carrying spot MsgSyncReserves reconciles reserves (modules/spot/keeper/msg_server.go:149-173)."

[req.3258]
title = "A governance-listed token trades end to end"
ac_1 = "A token listed by governance MsgUpdateParams trades through production 0x1021 with its book registered by RegisterToken (modules/spot/keeper/vault.go:742-775)."

[req.3259]
title = "One unpriced token does not stop spot resting execution"
ac_1 = "ExecuteResting continues past ErrInvalidOracle and pricefeed ErrUnknownMarket as it does past stale and paused tokens at modules/spot/keeper/execute.go:137."

