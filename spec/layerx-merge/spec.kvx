ac_1 = "PackageExports (planned) of layerxproof/codec reports MerkleNodeHash (layerxproof/codec/domain.go:104), Receipt.UnsignedBytes and IsProtocolReceiptShape as exported and foldPath as absent."

[req.1243]
title = "Freeze the lxphost result surface: a non-cgo Code table and the kernel fee, effects and program outcome in Receipt"
ac_1 = "Code(v).Error() from the non-cgo table in modules/lxphost/code_names.go (planned) equals lxp_result_name(v) (include/layerx/lxp_result.h:163) for every v in -2000..2000."
ac_2 = "Receipt.FeeCharged returned by Host.Execute equals the FeeCharged field that DecodeReceipt (layerxproof/codec/receipt.go:364) reads from Receipt.Encoded, the kernel fee_charged of include/layerx/lxp_receipt.h:90."
ac_3 = "Receipt.Events and Receipt.Transfers returned by Host.Execute equal the event effects and the asset, from, to and amount leg that DecodeReceipt (layerxproof/codec/receipt.go:364) reads from Receipt.Encoded, and Receipt.ProgramOutcome is nil exactly when the decoded ProgramOutcome is nil."

[req.1244]
title = "Load only the module rows and blobs an activity's modules can read"
ac_1 = "An asset activity executes with 600 unrelated module-9 rows in the store, more than LXP_KERNEL_MAX_MODULE_KV (modules/lxphost/host.go:250), because branch.load (modules/lxphost/ctx.go:133) reads only the activity, asset and governance module prefixes."
ac_2 = "Rows of modules outside the loading set keep their exact bytes after an execution, because commit (modules/lxphost/ctx.go:232) only writes or deletes keys recorded by the scoped load."
ac_3 = "loadBlobs (modules/lxphost/host.go:816) loads 0x05 rows of the loading set only and leaves 0x05 rows of other modules untouched."
ac_4 = "Activity.FeeLimit is signed: Host.SigningHash (modules/lxphost/host.go:746) differs for FeeLimit 0 and 1, because fee_limit is field 9 of the activity encoding (src/protocol/lxp_activity.c:64)."
ac_5 = "Activity.FeeLimit reaches the kernel envelope: a FeeLimit above the actor fee balance returns LXP_ERR_FEE_UNPAYABLE (src/sequencer/lxp_admission.c:39)."
ac_6 = "KernelAuthority.Bound passed to Host.Execute is recorded in the node authority_bound field for that execution only."

[req.1245]
title = "Scope the read bridge store restore to the modules each read needs"
ac_1 = "ReadBalance (modules/lxphost/read.go:325) returns the minted balance with 600 module-9 rows in the store instead of LXP_ERR_ARENA_EXHAUSTED."
ac_2 = "ReadAsset (modules/lxphost/read.go:292) returns the same AssetRecord with and without unrelated module rows in the store."

[req.1246]
title = "Set the asset binding authority and stop forcing signature_valid in the host"
ac_1 = "An asset register with an empty signature and KernelAuthority.VerifiedKey equal to the activity authority key executes with result LXP_OK through the binding authority set by lxphost_bind_assets (modules/lxphost/host.go:159)."
ac_2 = "A governance activity whose signature was made by another key is refused with LXP_ERR_BAD_SIGNATURE instead of being admitted with signature_valid forced true (modules/lxphost/host.go:468)."
ac_3 = "Binding authority skips only the ed25519 verification: an unsigned bound activity whose payload hash does not match its payload is still refused by the kernel payload-hash check."

[req.1247]
title = "Add ExecuteActivity and ResultError for EVM-bound kernel activities"
ac_1 = "ExecuteActivity in modules/lxphost/execute.go (planned) registers an asset without an ed25519 signature for a node-verified key and the registered asset is readable."
ac_2 = "ExecuteActivity carries the caller's account sequence and a reused sequence is refused by the kernel admission (src/protocol/lxp_kernel.c:7112)."
ac_3 = "ResultError (planned) returns nil for LXP_OK, LXP_BAD_SIGNATURE for LXP_ERR_BAD_SIGNATURE and LXP_FATAL_SUPPLY_MISMATCH unchanged."

[req.1248]
title = "Carry authority kind, scope and grant in KernelAuthority and register budget and escrow"
ac_1 = "A KernelAuthority of kind LXP_AUTHORITY_DELEGATED_CAPABILITY reaches the kernel as lxp_authority_resolved.kind 3 with its scope instead of the forced owner kind (modules/lxphost/host.go:237)."
ac_2 = "lxphost_authority_write refuses kind 9, above LXP_AUTHORITY_KIND_TIMELOCK (include/layerx/lxp_authority.h:19), with LXP_ERR_NON_CANONICAL before execution."
ac_3 = "A budget create executes through the host once lx_budget_module_iface (include/layerx/lx_budget.h:219) is registered, instead of LXP_ERR_MODULE_DISABLED."
ac_4 = "An escrow capture (LX_ESCROW_CAPTURE, include/layerx/lx_escrow.h:15) succeeds under a delegated authority whose scope covers the capture ordinal and is refused for an owner authority of a non-holder."

[req.1249]
title = "Register perps, spot, stream and service modules in the hosted kernel"
