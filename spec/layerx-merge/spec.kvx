touches = ["sdk/wallet/src/modules/exchange.ts", "apps/wallet/src/surfaces/ExchangeView.tsx", "apps/wallet/src/surfaces/ExchangeView.test.tsx", "apps/web/src/app/exchange/exchange-client.tsx", "apps/web/e2e/exchange-perps.test.ts"]
