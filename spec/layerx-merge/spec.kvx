ac_1 = "Query/PoolMetadata{pool} returns found with the PoolMetadata record GetPoolMetadata (modules/launchpad/keeper/market.go:94) reads, whose Token is the market's TokenAddress and whose NFTID is its FeeRightID."
ac_2 = "Query/PoolMetadata refuses a malformed pool with sdkerrors.ErrInvalidAddress."

[req.4034]
