[task.8.28.3]
title = "Configure the ramp LayerX client for the sequencer endpoint, chain id and pinned receipt keys, and prepare, sign, submit and resolve ramp legs through it"
status = "pending"
mode = "BUILD"
wave = 5
requires = ["8.28.1", "8.28.2"]
reqs = ["8268.1", "8268.2", "8268.3", "8269.1", "8269.2", "8269.3"]
capabilities = ["8.28.3"]
interfaces = ["interface.8.rs-ramp-toolkit-layerx-ramp-toolkit-clients-layerxconfig", "interface.8.rs-ramp-toolkit-layerx-ramp-toolkit-clients-layerxclient", "interface.8.rs-ramp-toolkit-clients-activityconfig-j41", "interface.8.rs-ramp-toolkit-clients-configured-sequencer-j41", "interface.8.rs-ramp-toolkit-clients-maintainedbatchdocument-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-gateway-endpoint", "interface.8.cfg-ramp-toolkit-layerxconfig-receipt-authority-endpoint", "interface.8.cfg-ramp-toolkit-layerxconfig-gateway-key-file", "interface.8.cfg-ramp-toolkit-layerxconfig-authority-token-file", "interface.8.cfg-ramp-toolkit-layerxconfig-protocol-version", "interface.8.cfg-ramp-toolkit-layerxconfig-network-id", "interface.8.cfg-ramp-toolkit-layerxconfig-fee-limit", "interface.8.cfg-ramp-toolkit-layerxconfig-signer-public-key", "interface.8.cfg-ramp-toolkit-layerxconfig-sequencer-id", "interface.8.cfg-ramp-toolkit-layerxconfig-sequencer-public-key", "interface.8.cfg-ramp-toolkit-layerxconfig-sequencer-first-batch", "interface.8.cfg-ramp-toolkit-layerxconfig-sequencer-last-batch", "interface.8.cfg-ramp-toolkit-layerxconfig-rpc-endpoint-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-rpc-trust-anchor-der-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-chain-id-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-operator-address-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-receipt-keys-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-max-fee-per-gas-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-max-priority-fee-per-gas-j41", "interface.8.cfg-ramp-toolkit-layerxconfig-gas-limit-cap-j41", "interface.8.rs-ramp-toolkit-layerx-ramp-toolkit-clients-layerxsubmission-verified", "interface.8.rs-ramp-toolkit-clients-preparedlayerx-j41"]
do_1 = "services/platform/ramps/toolkit/src/clients.rs:876-892 LayerxConfig carries the gateway, receipt authority, kernel protocol version, network id, Ed25519 signer key and sequencer batch range; replace them with rpc_endpoint, rpc_trust_anchor_der, chain_id, operator_address, receipt_keys, max_fee_per_gas, max_priority_fee_per_gas and gas_limit_cap per decision.830, keeping signer_endpoint, signer_token_file and actor_did."
do_2 = "services/platform/ramps/toolkit/src/clients.rs:895-924 LayerxConfig::build creates gateway and authority endpoints and a SequencerAuthorization; create a SequencerEndpoint (services/agent/crates/layerx-client/src/sequencer.rs:213) from rpc_endpoint and the trust anchor, parse operator_address as 20 bytes, and refuse chain_id 0, an empty receipt_keys list, a key whose firstHeight exceeds lastHeight, max_priority_fee_per_gas above max_fee_per_gas and gas_limit_cap 0."
do_3 = "services/platform/ramps/toolkit/src/clients.rs:952-962 LayerxClient holds gateway, receipt authority and kernel activity fields; hold the SequencerEndpoint, the signer endpoint and token, chain_id, operator_address, receipt keys and fee bounds."
do_4 = "services/platform/ramps/toolkit/src/clients.rs:795-874 ActivityConfig validates kernel native receives, and services/platform/ramps/toolkit/src/clients.rs:1649-1765 configured_sequencer and MaintainedBatchDocument authorise kernel batches; remove them per decision.827."
do_5 = "Create services/platform/ramps/toolkit/tests/evm_config.rs (planned) with the three evm_config tests below."
do_6 = "services/platform/ramps/toolkit/src/clients.rs:1006-1085 prepare_payment and prepare_native_receive build kernel unsigned activities; build an Eip1559Call (services/agent/crates/layerx-crypto/src/evm_transaction.rs:13) from the LedgerCall with chain_id, pending_nonce (services/agent/crates/layerx-client/src/sequencer.rs:251), estimate_gas bounded by gas_limit_cap and the configured fee bounds, and remove prepare_native_receive per decision.827."
do_7 = "services/platform/ramps/toolkit/src/clients.rs:1319-1365 sign posts a kernel digest to /v1/signatures and checks an Ed25519 signature; post the signing_hash (services/agent/crates/layerx-crypto/src/evm_transaction.rs:195) with algorithm secp256k1 per decision.828, assemble the 65-byte signature (services/agent/crates/layerx-crypto/src/evm_transaction.rs:223) and require recover_sender (services/agent/crates/layerx-crypto/src/evm_transaction.rs:307) to equal operator_address."
do_8 = "services/platform/ramps/toolkit/src/clients.rs:1087-1148 submit_prepared posts to the gateway /v1/activities; call send_raw_transaction (services/agent/crates/layerx-client/src/sequencer.rs:321) once and map a JSON-RPC refusal to LayerxSubmission::Refused with its LXP_ code."
do_9 = "services/platform/ramps/toolkit/src/clients.rs:1150-1263 resolve_with_evidence reads the gateway receipt and the authorised batch; call sequencer_receipt (services/agent/crates/layerx-client/src/sequencer.rs:337), map Submitted to Pending, and pass Receipted or Committed receipts to verify_order_receipt of task 8.28.2."
do_10 = "services/platform/ramps/toolkit/src/clients.rs:965-1001 LayerxSubmission and PreparedLayerx carry activity_id and canonical_activity; carry tx_hash and raw_transaction."
do_11 = "Create services/platform/ramps/toolkit/tests/evm_submit.rs (planned) with the three evm_submit tests below against a loopback JSON-RPC listener on std::net::TcpListener started in the test, signing with layerx_crypto sign (services/agent/crates/layerx-crypto/src/evm_transaction.rs:207)."
symbols = ["LayerxConfig", "LayerxConfig::build", "LayerxClient", "ReceiptKeyConfig", "LayerxClient::prepare_payment", "LayerxClient::submit_prepared", "LayerxClient::resolve", "LayerxSubmission", "PreparedLayerx"]
touches = ["services/platform/ramps/toolkit/src/clients.rs", "services/platform/ramps/toolkit/tests/evm_config.rs", "services/platform/ramps/toolkit/tests/evm_submit.rs"]
tests = ["services/platform/ramps/toolkit/tests/evm_config.rs::layerx_config_refuses_zero_chain_id", "services/platform/ramps/toolkit/tests/evm_config.rs::layerx_config_refuses_inverted_receipt_key_range", "services/platform/ramps/toolkit/tests/evm_config.rs::layerx_config_rejects_retired_gateway_field", "services/platform/ramps/toolkit/tests/evm_submit.rs::signature_from_other_key_is_refused_before_submission", "services/platform/ramps/toolkit/tests/evm_submit.rs::submit_prepared_sends_raw_transaction_once", "services/platform/ramps/toolkit/tests/evm_submit.rs::resolve_reports_submitted_receipt_as_pending"]
