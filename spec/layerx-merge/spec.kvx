pause = "layerxledger params paused refuses every write except revokeGrant through CheckPauseScope (modules/layerxgov/types/proposal.go:38); views always answer"
interfaces = ["interface.6.pc-0x101a-register", "interface.6.pc-0x101a-pause", "interface.6.pc-0x101a-unpause", "interface.6.pc-0x101a-openaccount", "interface.6.pc-0x101a-send", "interface.6.pc-0x101a-draw", "interface.6.pc-0x101a-payexact", "interface.6.pc-0x101a-issuegrant", "interface.6.pc-0x101a-revokegrant", "interface.6.pc-0x101a-mint", "interface.6.pc-0x101a-burn", "interface.6.pc-0x101a-getasset", "interface.6.pc-0x101a-balanceof", "interface.6.pc-0x101a-totalunits", "interface.6.pc-0x101a-accountid", "interface.6.pc-0x101a-accountowner", "interface.6.pc-0x101a-getpayergrant", "interface.6.pc-0x101a-nextsequence", "interface.6.pc-0x101a-evt-assetregistered", "interface.6.pc-0x101a-evt-assetpaused", "interface.6.pc-0x101a-evt-assetunpaused", "interface.6.pc-0x101a-evt-accountopened", "interface.6.pc-0x101a-evt-transfer", "interface.6.pc-0x101a-evt-payergrantissued", "interface.6.pc-0x101a-evt-payergrantrevoked", "interface.6.pc-0x101a-evt-paymentdrawn", "interface.6.pc-0x101a-evt-paymentexact", "interface.2.pc-0x101a-err-lxp-j23", "interface.2.fmt-layerxledger-abi-j23", "interface.2.go-layerxledger-fromkernel-j23", "interface.2.go-pc-layerxledger-address-j23", "interface.2.go-pc-layerxledger-gastable-j23", "interface.2.go-pc-layerxledger-getabi-j23", "interface.2.go-pc-layerxledger-keepers-j23", "interface.2.go-pc-layerxledger-newmergeprecompile-j23", "interface.2.go-pc-layerxledger-newprecompile-j23", "interface.2.go-pc-layerxledger-reverterror-j23"]

[contract_context.2.layerxpay-0x101b]
interface = "Precompile 0x000000000000000000000000000000000000101B named layerxpay: 57 ABI methods of precompiles/layerxpay/abi.json over the escrow, budget, stream and service kernel modules 2 to 5, and its Solidity binding"
storage = "No precompile-owned state; every write submits one kernel activity through the pay keeper on the shared layerxhost store (decision.221) and every view decodes the kernel record read back through the host"
errors = "Error(string) reasons LXP_<CODE> from kernel names through LXPCodeName (precompiles/common/lxp_errors.go:320), the layerxpay codespace codes 4 to 6 through PayRevertCode and LXP_PAUSED_SCOPE 735 from layerxgov"
events = "One 0x101B log per successful write as listed in the events context layerxpay-0x101b-events"
gas = "methodGas rows of precompiles/layerxpay/gas.go:18-76 charged by the framework WithGasTable (decision.235): escrow writes 60000 except escrowDisputeResolve 80000 (precompiles/layerxpay/gas.go:25), dispute open 30000, plus DefaultGasCost of the input; views charge the read rows"
activation = "Served from the height where MergeUpgrade is done, gated by mergePrecompileGate (node/upgrades.go:521) on the layerxpay module (node/upgrades.go:526)"
invariants = "Every write acts for the DID bound to the EVM caller (decision.236); idempotency keys and stream ids are never zero (decision.223); the ledger effect of a call equals its kernel receipt"
pause = "Params.Paused refuses every write except escrowRelease, escrowTimeout, budgetClose, budgetDefund, budgetRevoke, streamPause, streamClose, serviceOfferWithdraw and serviceCommitAbandon (modules/layerxgov/types/proposal.go:28-32); views always answer"
interfaces = ["interface.2.go-layerxpay-pc-layerxpaykeepers-j24", "interface.2.go-layerxpay-pc-newmergeprecompile-j24", "interface.2.go-layerxpay-pc-newprecompile-j24", "interface.2.go-layerxpay-pc-payaddress-j24", "interface.2.go-layerxpay-pc-requiredgas-j24", "interface.2.go-layerxpay-pc-reverterror-j24", "interface.2.pc-0x101b-budgetamend", "interface.2.pc-0x101b-budgetclose", "interface.2.pc-0x101b-budgetcreate", "interface.2.pc-0x101b-budgetcreatenative", "interface.2.pc-0x101b-budgetdefund", "interface.2.pc-0x101b-budgetdelegateadd", "interface.2.pc-0x101b-budgetdelegateremove", "interface.2.pc-0x101b-budgetdelegatespend", "interface.2.pc-0x101b-budgetfund", "interface.2.pc-0x101b-budgetfundnative", "interface.2.pc-0x101b-budgetpull", "interface.2.pc-0x101b-budgetremaining", "interface.2.pc-0x101b-budgetrevoke", "interface.2.pc-0x101b-budgetspend", "interface.2.pc-0x101b-escrowcapture", "interface.2.pc-0x101b-escrowdisputeopen", "interface.2.pc-0x101b-escrowdisputeresolve", "interface.2.pc-0x101b-escrowopen", "interface.2.pc-0x101b-escrowpartialcapture", "interface.2.pc-0x101b-escrowrelease", "interface.2.pc-0x101b-escrowremaining", "interface.2.pc-0x101b-escrowtimeout", "interface.2.pc-0x101b-getagreement", "interface.2.pc-0x101b-getbudget", "interface.2.pc-0x101b-getcommitment", "interface.2.pc-0x101b-getdelivery", "interface.2.pc-0x101b-getdispute", "interface.2.pc-0x101b-getescrow", "interface.2.pc-0x101b-getescrowresult", "interface.2.pc-0x101b-getexecution", "interface.2.pc-0x101b-getoffer", "interface.2.pc-0x101b-getprogress", "interface.2.pc-0x101b-getstream", "interface.2.pc-0x101b-getstreamresult", "interface.2.pc-0x101b-latestdelivery", "interface.2.pc-0x101b-progresshighwater", "interface.2.pc-0x101b-serviceaccept", "interface.2.pc-0x101b-serviceagreementaccept", "interface.2.pc-0x101b-serviceagreementpropose", "interface.2.pc-0x101b-servicecommitabandon", "interface.2.pc-0x101b-servicecommittask", "interface.2.pc-0x101b-servicedeliver", "interface