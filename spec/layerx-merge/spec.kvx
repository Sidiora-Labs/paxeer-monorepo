[task.1.22.1]
title = "Load only the module rows and blobs an activity's modules can read"
status = "done"
mode = "BUILD"
wave = 1
requires = ["1.21.3"]
reqs = ["1244.1", "1244.2", "1244.3", "1244.4", "1244.5", "1244.6"]
capabilities = ["1.22.1"]
interfaces = ["interface.1.go-lxphost-host-execute-j22", "interface.1.go-lxphost-activity-j22", "interface.1.go-lxphost-kernel-authority-j22"]
fulfils = ["wiring.J23.3", "wiring.J52.1"]
do_1 = "At HEAD branchCtx.load (modules/lxphost/ctx.go:133) iterates every 0x01 row (modules/lxphost/ctx.go:134) and loadBlobs (modules/lxphost/host.go:816) every 0x05 row (modules/lxphost/host.go:818) of the store on each HostExecute, so every execution costs the whole store and fails with LXP_ERR_ARENA_EXHAUSTED once 512 rows exist (modules/lxphost/host.go:250)."
do_2 = "Add lxphost_activity_module(node, &module_id) to the cgo preamble of host.go calling lxp_kernel_module_for_activity (include/layerx/lxp_kernel.h:331) after writeEnvelope, and pass the loading set {activity module, LXP_MODULE_ASSET, LXP_MODULE_GOVERNANCE} (include/layerx/lxp_module.h:15-25) to branch.load and loadBlobs."
do_3 = "branch.load iterates one prefix per module of the set, 0x01 || u16be module id (moduleKVKey, modules/lxphost/ctx.go:292), in ascending module id order; loadBlobs iterates 0x05 || u16be module id the same way; rows of other modules are neither loaded nor recorded in branchCtx.loaded, so commit (modules/lxphost/ctx.go:232) never deletes them."
do_4 = "Create modules/lxphost/scope_test.go (planned) with TestHostLoadScopedToActivityModules, TestHostUnrelatedModuleRowsIgnored and TestHostBlobLoadScopedToModule, signing activities with the ed25519 helper of modules/lxphost/host_test.go:142."
do_5 = "Activity (modules/lxphost/host.go:555) gains FeeLimit [16]byte, a big-endian u128 that writeEnvelope (modules/lxphost/host.go:766) copies into the envelope activity fee_limit hi and lo (include/layerx/lxp_activity.h:25, include/layerx/lxp_u128.h:9-12); fee_limit is activity field 9 of the signed encoding (src/protocol/lxp_activity.c:64), so a zero FeeLimit keeps every existing signing hash; this fulfils wiring.J52.1."
do_6 = "KernelAuthority (modules/lxphost/host.go:568) gains Bound bool; lxphost_authority_write (modules/lxphost/host.go:229, called at modules/lxphost/host.go:696) takes it as a fourth argument and stores it in a new lxphost_node field authority_bound, rewritten on every execution, which task 1.23.1 reads as the binding flag; this fulfils wiring.J23.3."
do_7 = "Create modules/lxphost/activity_fields_test.go (planned) with TestHostFeeLimitSigned (Host.SigningHash, modules/lxphost/host.go:746, differs for FeeLimit 0 and 1), TestHostFeeLimitUnpayable (a FeeLimit above the actor fee balance returns LXP_ERR_FEE_UNPAYABLE, src/sequencer/lxp_admission.c:39) and TestHostAuthorityBoundRecorded (an unexported authorityBound() reads authority_bound as true then false over two executions)."
symbols = ["lxphost_activity_module", "branchCtx.load", "loadBlobs", "TestHostLoadScopedToActivityModules", "TestHostUnrelatedModuleRowsIgnored", "TestHostBlobLoadScopedToModule", "Activity.FeeLimit", "KernelAuthority.Bound", "lxphost_authority_write", "authority_bound", "TestHostFeeLimitSigned", "TestHostFeeLimitUnpayable", "TestHostAuthorityBoundRecorded"]
touches = ["modules/lxphost/host.go", "modules/lxphost/ctx.go", "modules/lxphost/scope_test.go", "modules/lxphost/activity_fields_test.go"]
tests = ["modules/lxphost/scope_test.go::TestHostLoadScopedToActivityModules", "modules/lxphost/scope_test.go::TestHostUnrelatedModuleRowsIgnored", "modules/lxphost/scope_test.go::TestHostBlobLoadScopedToModule", "modules/lxphost/activity_fields_test.go::TestHostFeeLimitSigned", "modules/lxphost/activity_fields_test.go::TestHostFeeLimitUnpayable", "modules/lxphost/activity_fields_test.go::TestHostAuthorityBoundRecorded"]
planned_paths = ["modules/lxphost/scope_test.go", "modules/lxphost/activity_fields_test.go"]
build_cmd = "make paxd-native-libs && CGO_ENABLED=1 go build ./modules/lxphost/"
verify_cmd = "CGO_ENABLED=1 go test -count=1 ./modules/lxphost/ -run '^(TestHostLoadScopedToActivityModules|TestHostUnrelatedModuleRowsIgnored|TestHostBlobLoadScopedToModule|TestHostFeeLimitSigned|TestHostFeeLimitUnpayable|TestHostAuthorityBoundRecorded)$'"
gate_kind = "planned"
sandbox_profile = "go-cgo"
owner_role = "fm-kernel"
rollback = "Revert host.go and ctx.go to the full-prefix scans and drop Activity.FeeLimit and KernelAuthority.Bound; scope_test.go and activity_fields_test.go are deleted."
