ac_1 = "Query/HasRole{contract, role, account} returns HasRole (modules/launchpad/keeper/roles.go:56) for a 0x-prefixed 32-byte role, true for PoolRole (modules/launchpad/keeper/market.go:35) of a created pool on the FeeAccumulator surface."
ac_2 = "Query/HasRole refuses a role that is not 0x followed by 64 hex digits with sdkerrors.ErrInvalidRequest and a malformed contract or account with sdkerrors.ErrInvalidAddress."

[req.4031]
