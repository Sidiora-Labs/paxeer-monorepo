[req.1001]
title = "Kernel test binaries dispatch named cases and fail on unknown names"
ac_1 = "lxp_kernel_case_main in tests/codec/lxp_kernel_case.h (planned) runs exactly the cases named on the command line in argument order and returns 0 only when every named case returns 0, keeping the plain int main result convention of tests/codec/lxp_test_codec_primitives.c:7."
ac_2 = "lxp_kernel_case_main returns 2 without running any case when a named case is absent from the table or when no case is named, so a misspelt verify_cmd case name fails the gate."

[req.1002]
title = "The kernel result registry and module ids are frozen by a surface test"
ac_1 = "lxp_result_registry_count and lxp_result_registry_at (planned) enumerate every row of LXP_RESULT_CODE_LIST (include/layerx/lxp_result.h:29) in list order, and that enumeration equals the frozen name and value table of tests/codec/lxp_test_surface_frozen.c (planned), which holds -737 LXP_ERR_ARBITER_REQUIRED, -738 LXP_ERR_UNAUTHORIZED_ARBITER and -739 LXP_ERR_ESCROW_LINK_MISMATCH."
ac_2 = "The module id enum keeps LXP_MODULE_ASSET 1 through LXP_MODULE_SPOT 10 and LXP_MODULE_WEB 11 with LXP_MODULE_RESERVED_COUNT 11 (include/layerx/lxp_module.h:14-27), so a retired module number is never reused."

[req.1003]
title = "Integrated kernels are deterministic under cgo-style hosting"
ac_1 = "Two kernels initialised from the same genesis, whose module_kv rows are loaded through lxp_kernel_module_kv_load (planned) in two different permutations, execute the same 64-activity asset and stream sequence with identical lxp_kernel_execution inputs and return byte-identical receipts and state roots at every global_sequence (include/layerx/lxp_kernel.h:643)."
ac_2 = "A kernel whose writer is reclaimed with lxp_kernel_claim_writer (planned) on a second thread between activities produces the same receipts and state roots as a kernel driven from one thread."

[req.1004]
title = "Client read helpers are side-effect free"
ac_1 = "lx_stream_accrued_read, lxp_programs_interface_read and lxp_programs_sandbox_read each return LXP_OK on a populated kernel and leave kernel->module_kv, module_kv_count (include/layerx/lxp_kernel.h:243) and the state root byte-identical."
ac_2 = "For an id with no committed record the stream, interface and sandbox reads return LXP_ERR_UNKNOWN_FIELD, and none of the three writes a staged entry."

[req.1005]
title = "The arbiter and escrow-link refusals are kernel result codes"
ac_1 = "LXP_RESULT_CODE_LIST gains X(LXP_ERR_ARBITER_REQUIRED, -737), X(LXP_ERR_UNAUTHORIZED_ARBITER, -738) and X(LXP_ERR_ESCROW_LINK_MISMATCH, -739) after LXP_ERR_PROGRAM_REFUSED -736 (include/layerx/lxp_result.h:141), and lxp_result_name (src/protocol/lxp_result.c:3) returns each name."
ac_2 = "lxp_result_domain (src/protocol/lxp_result.c:14) places -737, -738 and -739 in LXP_RESULT_DOMAIN_MODULE and lxp_result_is_fatal returns false for each."

[req.1006]
title = "Only registered result values map to a result domain"
ac_1 = "lxp_result_domain (src/protocol/lxp_result.c:14-53) returns LXP_RESULT_DOMAIN_UNKNOWN (include/layerx/lxp_result.h:22) for a negative value that is not a row of LXP_RESULT_CODE_LIST, such as -9, -740 and -999, where HEAD buckets every negative value by range."
ac_2 = "lxp_result_is_registered (planned in include/layerx/lxp_result.h) returns true for every LXP_RESULT_CODE_LIST row and false for every other int32 value in -1100..10."

[req.1007]
title = "The result registry is enumerable from C and cgo"
ac_1 = "lxp_result_registry_count (planned) returns the number of LXP_RESULT_CODE_LIST rows and lxp_result_registry_at (planned) returns LXP_OK with the value and the lxp_result_name text of row i for every i below the count and LXP_ERR_UNKNOWN_FIELD at i equal to the count."
ac_2 = "No two rows returned by lxp_result_registry_at share a value or a name."

[req.1008]
title = "Service deliverable refusals use codec result codes, not DA codes"
ac_1 = "lx_service_deliverable_check returns LXP_ERR_NON_CANONICAL instead of LXP_ERR_DA_MISSING (src/modules/service/lx_service_deliver.c:28) for a deliverable whose artifact_size is 0 or whose availability_reference is all zero."
ac_2 = "A deliverable whose hash differs from the offer deliverable_specification_hash still returns LXP_ERR_DELIVERABLE_MISMATCH (src/modules/service/lx_service_deliver.c:24-25)."

[req.1009]
title = "The DA-missing result code leaves the registry once no emitter remains"
ac_1 = "LXP_ERR_DA_MISSING (include/layerx/lxp_result.h:146) is removed from LXP_RESULT_CODE_LIST, lxp_result_is_registered(-804) returns false and lxp_result_name(-804) returns LXP_ERR_UNKNOWN (src/protocol/lxp_result.c:10-11); the value -804 is not reassigned."

[req.1010]
title = "Kernel execution has no idempotency replay path"
ac_1 = "lxp_kernel_execute_activity no longer calls lxp_idempotency_lookup or lxp_idempotency_canonical_lookup (src/protocol/lxp_kernel.c:3517, :6866, :7092) nor records through lxp_idempotency_record (src/protocol/lxp_kernel.c:3228), so an activity reusing an idempotency key with the next sequence executes instead of returning LXP_ERR_IDEMPOTENT_REPLAY."
ac_2 = "Replay protection rests on the actor sequence alone: re-submitting sequence 1 returns LXP_ERR_SEQUENCE_REUSED and the state root is unchanged."
ac_3 = "After 64 executed activities the store idempotency count (include/layerx/lxp_state.h:40-42) is 0, because the module context preview no longer appends staged entries (src/protocol/lxp_module_ctx.c:1401-1469)."

[req.1011]
title = "State commitments carry no idempotency entries"
ac_1 = "lxp_state_root no longer folds idempotency entries (src/state/lxp_state_root.c:21-36, :549-562) and lxp_state_proof no longer proves them (src/state/lxp_state_proof.c:153-157), so two stores differing only in idempotency entries have equal roots."
ac_2 = "lxp_snapshot_write keeps the u32 idempotency count word and writes it as 0 with no entries (src/state/lxp_snapshot.c:557-572), and lxp_snapshot_load refuses a nonzero count with LXP_ERR_SNAPSHOT_MISMATCH (src/state/lxp_snapshot.c:898-919)."

[req.1012]
title = "The state store carries no idempotency table"
ac_1 = "lxp_idempotency_lookup, lxp_idempotency_record, lxp_idempotency_canonical_lookup, lxp_idempotency_snapshot_encode, lxp_idempotency_snapshot_decode, lxp_idempotency_reserve, lxp_idempotency_prune, lxp_idempotency_append, lxp_idempotency_live_count and lxp_idempotency_can_commit resolve to null weak references against build/liblayerx.a."
ac_2 = "lxp_state_journal_commit (src/state/lxp_journal.c:1038-1081) commits cells and advances next_sequence with no idempotency reserve or staged append, and lxp_state_store_init leaves no idempotency array."

[req.1013]
title = "The kernel header exports no retired daemon entry point"
ac_1 = "lxp_kernel_capacity_observe, lxp_kernel_capacity_reserve, lxp_kernel_capacity_reconcile, lxp_kernel_capacity_cancel, lxp_capacity_ledger_install, lxp_kernel_finalize_batch_maintenance, lxp_kernel_idempotency_receipt_validate, lxp_kernel_idempotency_state_value and lxp_ctx_bridge_credit resolve to null weak references against build/liblayerx.a."
ac_2 = "A blob-carrying program activity is admitted by the module context without the capacity grant hold capacity_grants_hold (src/protocol/lxp_module_ctx.c:1145-1197, called at src/protocol/lxp_module_ctx.c:1261) and returns its HEAD receipt for a kernel that never installed a capacity ledger."

[req.1014]
title = "The ledger apply layer has no bridge reserve credit"
ac_1 = "lxp_ledger_apply_bridge_credit (include/layerx/lxp_transfer.h:133, src/ledger/lxp_apply.c:210-225) resolves to a null weak reference once its only product caller lxp_ctx_bridge_credit (src/protocol/lxp_module_ctx.c:2416) is gone with task 1.2.4."
ac_2 = "lxp_ledger_restore_account_snapshot (include/layerx/lxp_transfer.h:136) still restores an account balance, asset and next_sequence as at HEAD."

[req.1015]
title = "Hosted module KV loads are ordered, unique and bounded"
ac_1 = "lxp_kernel_module_kv_load (planned in include/layerx/lxp_kernel_host.h) stores the rows in the (module_id, key) order of kv_order (src/state/lxp_snapshot.c:290-297) whatever the input order, so kernel->module_kv (include/layerx/lxp_kernel.h:243) equals the order lxp_snapshot_load enforces at src/state/lxp_snapshot.c:972-974."
ac_2 = "lxp_kernel_module_kv_load returns LXP_ERR_SEQUENCE_REUSED and leaves module_kv_count 0 when two rows share module_id and key, where the cgo loader at modules/lxphost/host.go:240-258 appends duplicates."
ac_3 = "lxp_kernel_module_kv_load returns LXP_ERR_LENGTH_LIMIT for more than LXP_KERNEL_MAX_MODULE_KV rows (include/layerx/lxp_kernel.h:18) or a key or value above the lxp_module_kv_entry bounds (include/layerx/lxp_kernel.h:38-44), the checks the snapshot loader applies at src/state/lxp_snapshot.c:953."

[req.1016]
title = "Writer ownership moves between host threads only at a quiescent point"
ac_1 = "lxp_kernel_claim_writer (planned in include/layerx/lxp_kernel_host.h) sets kernel->state->writer to pthread_self, after which lxp_state_writer_assert_owner (src/state/lxp_journal.c:977-982) passes on the claiming thread and fails on the thread that called lxp_state_store_init (src/state/lxp_journal.c:162)."
ac_2 = "lxp_kernel_claim_writer returns LXP_ERR_CONTEXT_MISMATCH and leaves the writer unchanged while a state journal of the kernel is open."

[req.1017]
title = "The asset state root is a function of distinct keys only"
ac_1 = "lx_asset_state_root (src/modules/asset/lx_asset_state.c:115) returns LXP_ERR_SEQUENCE_REUSED when two entries share the 64-byte key, where entry_order (src/modules/asset/lx_asset_state.c:18-26) breaks the tie by pointer and hashes both."
ac_2 = "For distinct keys lx_asset_state_root returns the same root for every permutation of the asset and account arrays."

[req.1018]
title = "Programs state records never carry two views of one account"
ac_1 = "lxp_programs_state_record_encode (src/modules/programs/state_record.c:198) returns LXP_ERR_NON_CANONICAL when two value-account views carry the same account id after the sort at src/modules/programs/state_record.c:304-305, whose comparison account_pointer_compare (:178-185) leaves ties unordered."

[req.1019]
title = "Prepared batches do not depend on worker count"
ac_1 = "lxp_kernel_prepare_activity_batch (include/layerx/lxp_kernel.h:508) with maximum_workers 1 and 4 returns prepared batches whose receipts, state roots and retry_prefix_count are byte-identical for the same activities and executions; the 4-worker run starts threads at src/protocol/lxp_kernel.c:5997."

[req.1020]
title = "Execution is bound to the store sequence"
ac_1 = "lxp_kernel_execute_activity (src/protocol/lxp_kernel.c:6950) refuses an lxp_kernel_execution whose global_sequence differs from kernel->state->next_sequence with LXP_ERR_SEQUENCE_GAP (src/state/lxp_journal.c:992, returned through lxp_state_journal_open) and commits nothing."
ac_2 = "After a successful execution at global_sequence 7, a second execution at 7 is refused with LXP_ERR_SEQUENCE_GAP (src/state/lxp_journal.c:992)."

[req.1021]
title = "Replay evidence is the two-kernel property, not a global guard"
ac_1 = "Re-executing a recorded activity sequence on a fresh kernel from the same genesis yields the recorded receipts and roots, replacing lxp_kernel_replay and lxp_replay_golden_run (src/protocol/lxp_determinism_guard.c:37, :79) and the process-global atomic guard at src/protocol/lxp_determinism_guard.c:9."
ac_2 = "include/layerx/lxp_kernel.h no longer declares lxp_replay_record, lxp_determinism_guard_check, lxp_determinism_guard_trip, lxp_determinism_guard_reset, lxp_kernel_replay, lxp_replay_compare_roots or lxp_replay_golden_run (include/layerx/lxp_kernel.h:649-668) and src/protocol/lxp_determinism_guard.c is deleted."

[req.1022]
title = "Fee parameter bytes have exactly one decoding and one encoding"
ac_1 = "For 2000 seeded lxp_fee_params values of every supported version, lxp_fee_params_decode (include/layerx/lxp_fee.h:144) of the bytes written by lxp_fee_params_encode (include/layerx/lxp_fee.h:142) returns LXP_OK and an equal structure, and re-encoding returns identical bytes."
ac_2 = "For every single-byte mutation of an encoded schedule, lxp_fee_params_decode either refuses the bytes or returns a structure whose encoding equals the mutated bytes, so no two byte strings decode to the same schedule."

[req.1023]
title = "Execution fees never depend on host-supplied meter units"
ac_1 = "lxp_kernel_execute_activity (src/protocol/lxp_kernel.c:6950) returns LXP_ERR_CONTEXT_MISMATCH before lxp_fee_compute (src/protocol/lxp_kernel.c:7119-7120) when any field of execution->fee_meter (include/layerx/lxp_kernel.h:401) is non-zero, and commits nothing; no host at HEAD sets the field, so every existing execution keeps its fee."
ac_2 = "lxp_kernel_prepare_activity (src/protocol/lxp_kernel.c:3442) applies the same refusal before its fee compute at src/protocol/lxp_kernel.c:3539, and a zero meter keeps the HEAD fee."

[req.1024]
title = "Fee computation refuses overflow instead of wrapping"
ac_1 = "lxp_fee_compute (src/protocol/lxp_fee.c:185) returns LXP_ERR_OVERFLOW (include/layerx/lxp_result.h:98) when a per-unit price times its meter units exceeds 2^128 - 1 in multiply_units (src/protocol/lxp_fee.c:164-170), and leaves *fee unwritten."
ac_2 = "lxp_fee_compute returns LXP_ERR_OVERFLOW for the per_encoded_byte and per_storage_unit components (src/protocol/lxp_fee.c:218-226) under the same boundary; the base_fee and module price overflows are already covered by tests/protocol/lxp_test_fee_gate.c:39-42 and tests/test_fees_v4.c:105-111 and are not repeated."

[req.1025]
title = "Genesis fee schedules and fees are frozen across implementations"
ac_1 = "The fee schedule a fresh genesis commits, read through lxp_fee_committed_schedule (include/layerx/lxp_fee.h:149) and encoded with lxp_fee_params_encode, has a SHA-256 digest equal to the constant recorded in tests/codec/lxp_test_fee_golden.c (planned)."
ac_2 = "lxp_fee_compute with a zero meter returns, for every asset ordinal and every module activity type of the committed schedule, the fee recorded in the golden table of tests/codec/lxp_test_fee_golden.c (planned)."

[req.1026]
title = "The kernel snapshot format is frozen by a golden digest"
ac_1 = "lxp_snapshot_write (include/layerx/lxp_snapshot.h:47) of a kernel built from the default genesis and a fixed 24-activity asset, stream and service sequence produces bytes whose SHA-256 equals the recorded golden, with the idempotency count word written as 0 by task 1.2.2."
ac_2 = "lxp_snapshot_load (include/layerx/lxp_snapshot.h:64) of the golden bytes followed by lxp_snapshot_write returns the same bytes and the same state root."

[req.1027]
title = "The queue disposition record codec leaves the kernel"
ac_1 = "lxp_queue_disposition_encode, lxp_queue_disposition_decode and lxp_queue_disposition_header (include/layerx/lxp_fee.h:134-138, src/state/lxp_journal.c:1148-1208) and the LXP_QUEUE_DISPOSITION_ magic enum (include/layerx/lxp_fee.h:113-118) are removed, while the lxp_queue_disposition struct (include/layerx/lxp_fee.h:120-127) stays because include/layerx/lxp_daemon.h:482 embeds it."

[req.1028]
title = "The state diff format leaves the kernel with its DA and replica users"
ac_1 = "include/layerx/lxp_state_diff.h (19 lines) and src/state/lxp_state_diff.c (200 lines) are deleted, so lxp_state_diff_encode (src/state/lxp_state_diff.c:43) and lxp_state_diff_decode (src/state/lxp_state_diff.c:156) no longer link into the kernel library."

[req.1029]
title = "The ledger transfer journal restores every touched account on rollback"
ac_1 = "lxp_journal_rollback (src/ledger/lxp_journal.c:56) after lxp_journal_open (src/ledger/lxp_journal.c:28) and applied legs restores balance, asset id, has_asset and next_sequence of every from and to account through lxp_balance_restore_snapshot (src/ledger/lxp_apply.c:366-385); none of the three functions has a direct test at HEAD."
ac_2 = "lxp_journal_commit (src/ledger/lxp_journal.c:49) and lxp_journal_rollback return LXP_ERR_NON_CANONICAL on a journal that is not open, and lxp_journal_open returns LXP_ERR_TOO_MANY_LEGS for zero legs and LXP_ERR_NON_CANONICAL for a leg with a null account."

[req.1030]
title = "Send idempotency replays survive the spill from the bounded store to metered history"
ac_1 = "After LXP_SEND_STORE_CAPACITY (include/layerx/lxp_ledger.h:78) appends, lxp_send_store_admit (src/ledger/lxp_send_store.c:137) moves the records into history charged at LXP_SEND_HISTORY_RECORD_BYTES each to the store meter, and lxp_send_store_lookup (src/ledger/lxp_send_store.c:106) of a spilled key returns LXP_ERR_IDEMPOTENT_REPLAY with replayed true; none of the three has a direct test at HEAD."
ac_2 = "lxp_send_store_lookup returns LXP_ERR_SEQUENCE_REUSED for a known activity hash in either the store or history, lxp_send_store_append (src/ledger/lxp_send_store.c:174) returns LXP_FATAL_INVARIANT at capacity, and lxp_send_store_admit returns LXP_ERR_ARENA_EXHAUSTED at capacity without a meter."

[req.1031]
title = "Versioned structure headers round-trip and refuse foreign tags"
ac_1 = "lxp_codec_write_struct_header_version (src/codec/lxp_codec.c:292) writes the protocol version then the structure tag as two big-endian u16 values, and lxp_codec_read_struct_header_version (src/codec/lxp_codec.c:313) returns the same version for the same tag."
ac_2 = "lxp_codec_write_struct_header_version returns LXP_ERR_INVALID_TAG for tag 0 or an unsupported version, and lxp_codec_read_struct_header_version returns LXP_ERR_VERSION_UNSUPPORTED for a different expected tag, an expected tag of 0 or an unsupported version (src/codec/lxp_codec.c:323-326)."

[req.1032]
title = "Stream payload and record bytes decode canonically"
ac_1 = "For 1000 seeded values each, lx_stream_record_encode and lx_stream_record_decode (include/layerx/lx_stream.h:153-156) and the open, amount, meter, keyed and id payload codecs (include/layerx/lx_stream.h:188-214) round-trip to identical bytes."
ac_2 = "Every single-byte mutation, truncation by one byte and extension by one byte of an encoded stream payload is either refused or re-encodes to the mutated bytes, and an extension is always refused with LXP_ERR_TRAILING_BYTES or LXP_ERR_LENGTH_LIMIT."

[req.1033]
title = "Service offer, agreement, dispute and execution bytes decode canonically"
ac_1 = "For 1000 seeded values each, the offer, agreement, commitment, progress, dispute and execution codecs of include/layerx/lx_service.h:297-392 round-trip to identical bytes."
ac_2 = "Every single-byte mutation and one-byte extension of an encoded service record is either refused or re-encodes to the mutated bytes, and every extension is refused."

[req.1034]
title = "Escrow record and result bytes decode canonically"
ac_1 = "For 1000 seeded values, lx_escrow_record_encode and lx_escrow_record_decode (include/layerx/lx_escrow.h:138-141) and lx_escrow_result_encode and lx_escrow_result_decode (include/layerx/lx_escrow.h:142-145) round-trip to identical bytes, including the legacy 243-byte result form that decodes with context_bound false (include/layerx/lx_escrow.h:80-82)."
ac_2 = "Every single-byte mutation and one-byte extension of an encoded escrow record is either refused or re-encodes to the mutated bytes, and every extension is refused."

[req.1035]
title = "Snapshot migration authorizations have one 315-byte encoding bound to the target manifest"
ac_1 = "lxp_snapshot_migration_authorization_encode (src/state/lxp_snapshot.c:72) writes LXP_SNAPSHOT_MIGRATION_AUTHORIZATION_BYTES (include/layerx/lxp_snapshot.h:20) bytes with the signature and 251 without it, and lxp_snapshot_migration_authorization_decode (src/state/lxp_snapshot.c:127) of the signed form restores an equal migration record; neither has a direct test at HEAD."
ac_2 = "Encoding refuses a zero root, a zero renamed_account_count or a source sequence that differs from the manifest with LXP_ERR_NON_CANONICAL (src/state/lxp_snapshot.c:82-93), and decoding returns LXP_ERR_VERSION_UNSUPPORTED for a wrong magic or version and LXP_ERR_SNAPSHOT_MISMATCH when the target sequence, roots or digest differ."

[req.1036]
title = "Account record bytes decode canonically"
ac_1 = "lx_account_record_encode (src/state/lxp_snapshot.c:761) and lx_account_record_decode (src/state/lxp_snapshot.c:777) round-trip 1000 seeded lx_account values with names of 1 to LX_ACCOUNT_NAME_MAX bytes to identical bytes; neither has a direct test at HEAD."
ac_2 = "Encoding refuses an empty or over-long name with LXP_ERR_NON_CANONICAL (src/state/lxp_snapshot.c:766-768), decoding refuses one appended byte with LXP_ERR_TRAILING_BYTES (src/state/lxp_snapshot.c:786-787), and every accepted single-byte mutation re-encodes to the mutated bytes."

[req.1037]
title = "Keccak-256 matches the published Ethereum vectors"
ac_1 = "lxp_keccak256 (include/layerx/lxp_crypto.h:49) returns c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470 for the empty input and 4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45 for the ASCII input abc, the Ethereum Keccak padding and not SHA3-256; at HEAD only web tests call it."
ac_2 = "lxp_keccak256 of 135, 136 and 137 bytes of 0x61 equals the digest of the same bytes fed through the reference sponge in the test, covering the 136-byte rate boundary."

[req.1038]
title = "Merkle node hashes and proof bytes are domain-separated and canonical"
ac_1 = "lxp_merkle_node_hash (include/layerx/lxp_merkle.h:22) of two 32-byte children differs from lxp_merkle_leaf_hash (include/layerx/lxp_merkle.h:21) of their 64-byte concatenation and is not symmetric in its arguments; neither function has a direct test at HEAD."
ac_2 = "lxp_merkle_proof_encode (include/layerx/lxp_merkle.h:36) writes a proof generated by lxp_merkle_proof_generate (include/layerx/lxp_merkle.h:28) as bytes whose length is a function of the sibling count only, and the encoding of the same proof is byte-identical across two calls."

[req.1039]
title = "Account ids and public keys have one canonical form"
ac_1 = "lxp_hash_account_id (include/layerx/lxp_hash.h:35) is deterministic and differs from lxp_hash_context_value (include/layerx/lxp_hash.h:33) and SHA-256 of the same bytes; it has no direct test at HEAD."
ac_2 = "lxp_ed25519_pubkey_is_canonical (include/layerx/lxp_crypto.h:22) returns false for a y coordinate at or above the field prime 2^255 - 19 and for the small-order identity encoding, and true for the public key of a seeded signing key."

[req.1040]
title = "Snapshot loading is total and leaves a refused kernel untouched"
ac_1 = "lxp_snapshot_load (include/layerx/lxp_snapshot.h:64) returns a registered result for every single-byte mutation, truncation and module_kv row swap of a valid snapshot, and on refusal the target kernel's module_kv_count stays 0."
ac_2 = "Every mutated snapshot that lxp_snapshot_load accepts writes back through lxp_snapshot_write to the mutated bytes."

[req.1041]
title = "Payer grant bytes decode canonically"
ac_1 = "lxp_payer_grant_encode and lxp_payer_grant_decode (include/layerx/lxp_ledger.h:394-397) round-trip 2000 seeded lxp_payer_grant values to identical bytes."
ac_2 = "Every single-byte mutation and one-byte extension of an encoded payer grant is either refused or re-encodes to the mutated bytes, and every extension is refused."

[req.1042]
title = "Signed 128-bit subtraction refuses overflow and never yields negative zero"
ac_1 = "lxp_i128_sub (src/protocol/lxp_i128.c:41) returns LXP_ERR_OVERFLOW and leaves *out untouched for positive 2^128 - 1 minus negative one and for negative 2^128 - 1 minus positive one; the add overflow and negative-zero add cases are already covered by tests/arith/lxp_test_rounding.c:33-39 and are not repeated."
ac_2 = "lxp_i128_sub returns negative false and magnitude 0 for x minus x and for negative zero minus zero, for 1000 seeded x including both magnitude extremes."

[req.1043]
title = "Transfer sets conserve every asset exactly, including supply-mode legs"
ac_1 = "lxp_conservation_check (src/ledger/lxp_journal.c:137) returns LXP_OK for a set whose credit-only and debit-only legs (include/layerx/lxp_transfer.h:29-30) balance per asset id and LXP_ERR_CONSERVATION when one asset is unbalanced while another balances; it has no direct test at HEAD."
ac_2 = "lxp_conservation_check accumulates in 256 bits (src/ledger/lxp_journal.c:61-68), so 256 legs (LXP_MAX_TRANSFER_SET_LEGS, include/layerx/lxp_protocol.h:17) of amount 2^128 - 1 in one asset return LXP_OK, 257 legs return LXP_ERR_TOO_MANY_LEGS and a supply_mode above LXP_TRANSFER_DEBIT_ONLY returns LXP_ERR_NON_CANONICAL."

[req.1044]
title = "A bound host authority replaces the ed25519 activity signature for asset activities"
ac_1 = "With bool binding_authority set last in lx_asset_runtime (include/layerx/lx_asset.h:122-130), asset_execute_typed skips lxp_activity_verify_signature (src/modules/asset/lx_asset_execution.h:184) and lx_asset_registry.c skips it at src/modules/asset/lx_asset_registry.c:214, while the payload hash, actor and authority checks stay."
ac_2 = "A zero-initialised runtime keeps binding_authority false and the same unsigned send returns LXP_ERR_BAD_SIGNATURE; a bound runtime with a wrong payload hash still returns the payload hash refusal."
ac_3 = "validate_send copies the flag into lxp_send_environment (include/layerx/lxp_ledger.h:184-196, src/modules/asset/lx_asset_registry.c:157-164) and lxp_send_validate skips only the inner ed25519 verify at src/ledger/lxp_send.c:281-285."

[req.1045]
title = "Context-staged asset issuance and account open accept a bound authority"
ac_1 = "lxp_ctx_asset_issuance_stage (src/protocol/lxp_module_ctx.c:565) reads the asset runtime through lxp_ctx_module_runtime (include/layerx/lxp_module.h:168) and skips only lxp_activity_verify_signature at src/protocol/lxp_module_ctx.c:588 when binding_authority is set."
ac_2 = "lxp_ctx_asset_account_stage (src/protocol/lxp_module_ctx.c:617) skips only the signature check at src/protocol/lxp_module_ctx.c:646 when bound; a wrong verified key, an over-long actor DID or a bad payload hash still return LXP_ERR_UNAUTHORIZED_DEBIT or the hash refusal."

[req.1046]
title = "Hosts derive the custody asset ids from one kernel table"
ac_1 = "lxp_genesis_custody_asset_id(index, out) (planned) returns LXP_OK and SHA-256 of layerx-asset:125:PAX, SID, USDC and USDL for index 0..3, the table registry_profiles hashes at src/protocol/lxp_genesis.c:453-466."
ac_2 = "Index 4 and a null output return LXP_ERR_PARAMETER_BOUNDS and LXP_ERR_NON_CANONICAL without writing the output."

[req.1047]
title = "The kernel no longer executes receive or payer-grant activities"
ac_1 = "The asset module type list no longer contains 0x00010006, 0x00010007 and 0x00010008, so lxp_kernel_execute_activity of each returns the unknown activity type refusal; the branches at src/modules/asset/lx_asset_execution.h:316-407 and the decode cases at src/modules/asset/lx_asset_registry.c:381-390 are gone."
ac_2 = "lxp_receive_validate, lxp_grant_store_put, lxp_grant_revoke, lxp_grant_draw_record, lxp_grant_authorization_message and lx_asset_payer_grant_read resolve to null weak references in the test binary linked against build/liblayerx.a."

[req.1048]
title = "Budget pull no longer reads kernel payer grants"
ac_1 = "LX_BUDGET_PULL 0x0003000b (include/layerx/lx_budget.h:26) leaves the budget type list (src/modules/budget/lx_budget_module.c:16), so a pull activity is refused as an unregistered type and lx_asset_payer_grant_read is no longer called from src/modules/budget/lx_budget_module.c:790."
ac_2 = "LX_BUDGET_DELEGATE_SPEND keeps its HEAD result for a valid delegated spend after the pull branch and lx_budget_pull_request (include/layerx/lx_budget.h:126-130) are removed."

[req.1049]
title = "The qualification header matches the activity types the kernel registers"
ac_1 = "LXP_QUAL_ACTIVITY_TYPE_COUNT (include/layerx/lxp_qualification.h:11) is 49, the 53 types of tests/qualification/lxp_qual_replay.c:28-45 minus 0x00010006, 0x00010007, 0x00010008 and 0x0003000b retired by tasks 1.12.1 and 1.12.2."
ac_2 = "include/layerx/lxp_qualification.h no longer declares lxp_partition_sim and lxp_sequencer_loss_sim (include/layerx/lxp_qualification.h:43-44)."

[req.1050]
title = "Clients read the accrued total of a stream without a state write"
ac_1 = "lx_stream_accrued_read (planned) loads the record with lx_stream_load, runs lx_stream_accrue (include/layerx/lx_stream.h:228) on a copy and never calls lx_stream_save (src/modules/stream/lx_stream_state.c:37): a TIME stream at rate 3 per 1000 ms from 1000 reads (30, 30) at 11000 and (31, 31) at 11500."
ac_2 = "A METERED, paused or closed stream returns its stored totals because accrual is a no-op there (src/modules/stream/lx_stream_accrue.c:48-56), and a missing stream id returns the lx_stream_load refusal unchanged."

[req.1051]
title = "Clients read program interfaces and sandbox records through kernel helpers"
ac_1 = "lxp_programs_interface_read (planned) returns the interface bytes stored under program_interface_key (src/modules/programs/deploy.c:204) for a deployed program and LXP_ERR_UNKNOWN_FIELD for an unknown program id, without staging a write."
ac_2 = "lxp_programs_sandbox_read (planned) returns the lease, escrow or usage encoding selected by kind under sandbox_state_key (src/modules/programs/sandbox.c:676) and refuses an unknown kind with LXP_ERR_NON_CANONICAL."

[req.1052]
title = "Native sandbox fund and activate stage their writes under a lifecycle reservation"
ac_1 = "lxp_programs_sandbox_execute (include/layerx/programs.h:852) reserves three staged writes for SANDBOX_FUND and one for SANDBOX_ACTIVATE with lxp_module_staged_reserve (include/layerx/lxp_module.h:166) in its non-Execute branch, where HEAD reserves only for Execute (src/modules/programs/sandbox.c:118)."
ac_2 = "layerx_programs_call_sandbox_state_stage_begin (src/modules/programs/sandbox.c:716) accepts the lifecycle reservation as well as the Execute reservation, and the lifecycle buffers are released on every exit so a refused Fund leaves staged_count unchanged."

[req.1053]
title = "The Programs module refuses the fee-governance relay"
ac_1 = "LX_PROGRAMS_FEE_GOVERNANCE 0x00090008 (include/layerx/programs.h:176) leaves the Programs type lists at src/modules/programs/registration.c:34-64, so the relay is refused as an unregistered type and registration.c no longer dispatches it at src/modules/programs/registration.c:95-96, :142-143 and :193-194."
ac_2 = "The per-batch price derivation lxp_programs_fee_governance_observe_batch (src/modules/programs/occupancy.c:896) still runs at batch close and yields the HEAD next price for a fixed occupancy receipt."

[req.1054]
title = "The sandbox expiry sweep destroys up to 128 leases per batch"
ac_1 = "layerx_programs_sandbox_sweep_host (src/modules/programs/sandbox_expiry.c:353) accepts limit 128 now that MAX_EXPIRIES_PER_BATCH is 128 (src/modules/programs/sandbox_expiry.c:14), matching the Rust sweep bound of task 13.6.1, and stages its writes within the 512 staged-write bound of task 1.16.3."
ac_2 = "A limit of 0 or 129 is refused by the check at src/modules/programs/sandbox_expiry.c:365 and leaves the context unchanged."

[req.1055]
title = "The kernel programs header declares layerx_programs_event_log_encode"
ac_1 = "include/layerx/programs.h declares int32_t layerx_programs_event_log_encode(uint64_t call_token, uint32_t index, uint8_t *out, uint32_t out_len) next to layerx_programs_call_begin (include/layerx/programs.h:504), so a pointer of exactly that type binds to the name."

[req.1056]
title = "Kernel execution never reads the program state feed"
ac_1 = "Kernel module binding and batch preparation no longer read programs_runtime.state_feed (src/protocol/lxp_kernel.c:1678-1680, :5183, :5231, :7044, :7672), so a Programs runtime with state_feed NULL executes a program call that HEAD refuses at src/protocol/lxp_kernel.c:7044."
ac_2 = "Two kernels, one with a feed bound through lx_programs_transfer_runtime (include/layerx/programs.h:1008) and one without, return byte-identical receipts and state roots for the same 16 program calls."

[req.1057]
title = "Programs headers carry no feed store, replay or relay surface"
ac_1 = "lxp_programs_state_feed_store_open, lxp_programs_bind_state_feed, lxp_programs_state_feed_observe, lxp_programs_replay_finalize, lxp_programs_replay_engine_bind, lxp_programs_fee_governance_decode, lxp_programs_fee_governance_validate and lxp_programs_fee_governance_execute resolve to null weak references against build/liblayerx.a."
ac_2 = "include/layerx/programs.h no longer defines LX_PROGRAMS_FEE_GOVERNANCE (include/layerx/programs.h:176) nor the state_feed member of lx_programs_transfer_runtime (include/layerx/programs.h:1008)."

[req.1058]
title = "The Programs header compiles without the retiring replica header"
ac_1 = "include/layerx/programs.h forward-declares lxp_replay_engine and lxp_replay_activity_output instead of including layerx/lxp_replica.h (include/layerx/programs.h:7), so LAYERX_LXP_REPLICA_H stays undefined after including programs.h alone."

[req.1059]
title = "Offline receipt verification no longer names guarantor records"
ac_1 = "include/layerx/lxp_verify.h no longer includes layerx/lxp_guarantor.h (include/layerx/lxp_verify.h:5) nor declares lxp_receipt_verify_checkpointed (include/layerx/lxp_verify.h:15-23), and lxp_receipt_verify_offline (include/layerx/lxp_verify.h:7) keeps its HEAD result for a valid receipt."
ac_2 = "lxp_receipt_verify_checkpointed (src/protocol/lxp_receipt_verify.c:73) resolves to a null weak reference against build/liblayerx.a."

[req.1060]
title = "Kernel module storage holds the sandbox lease working set"
ac_1 = "LXP_KERNEL_MAX_MODULE_KV (include/layerx/lxp_kernel.h:18) is 4096 and LXP_MODULE_MAX_STAGED_WRITES (include/layerx/lxp_kernel.h:21) is 512, and a kernel holding 1200 module rows writes and reloads a snapshot through the bound checks of src/state/lxp_snapshot.c:371 and src/state/lxp_snapshot.c:953."
ac_2 = "One module context stages 384 writes, the writes of 128 lease destroys, and the 513th staged write returns the staged bound refusal; snapshots and roots of states within the old bounds are byte-identical to HEAD."

[req.1061]
title = "The kernel executes no handover and governance keeps its genesis key"
ac_1 = "LXP_GOVERNANCE_HANDOVER 0x00070009 (include/layerx/lxp_handover.h:9) leaves the governance type list (src/modules/governance/lxp_governance.c:678-686), so the activity is refused as unregistered and lxp_handover_stage (src/modules/governance/lxp_governance.c:573) is no longer reached."
ac_2 = "LXP_GOVERNANCE_PROGRAMS_FEE and LXP_GOVERNANCE_MIGRATION_BUDGET are still authorised against the genesis governance key and network id, now held in the kernel governance_authority record (planned) instead of kernel->handover (src/modules/governance/lxp_governance.c:221-256)."

[req.1062]
title = "The kernel library carries no handover protocol"
ac_1 = "lxp_handover_prepare, lxp_handover_stage, lxp_handover_evidence_decode, lxp_handover_history_resolve and lxp_handover_genesis_authority resolve to null weak references against build/liblayerx.a after src/protocol/lxp_handover.c is deleted."

[req.1063]
title = "The genesis builder header declares no handover trust build"
ac_1 = "include/layerx/lxp_genesis_builder.h no longer declares lxp_genesis_handover_trust_build (include/layerx/lxp_genesis_builder.h:27-29), whose definition domain 5 deletes in task 5.49.2."

[req.1064]
title = "Program arbiter authority is a height-keyed V2 record without sequencer fields"
ac_1 = "layerx_programs_call_arbiter_authority_begin (src/modules/programs/call.c:930) writes ARBITER_AUTHORITY_BYTES 151 bytes (src/modules/programs/call.c:31): u16 version 2, u32 network_id, u16 protocol_version, u16 module_id, u8 operation, u32 result_code, u64 block_height, then receipt_digest, activity_id, previous_state_root and resulting_state_root, with no epoch, global sequence, authorization window or sequencer fields (decision.116)."
ac_2 = "The begin call returns LXP_ERR_ROOT_MISMATCH when block_height differs from the expected height, LXP_ERR_NOT_YET_VALID when block_height is not below the context batch number, and LXP_ERR_WRONG_NETWORK for another network id; the LXP_ERR_AUTH_SCOPE window check is gone."
ac_3 = "lxp_verified_receipt_index_add_height_authority (planned) decodes the canonical receipt, refuses a zero height or a non-canonical receipt with LXP_ERR_NON_CANONICAL, accepts an identical repeat and refuses a conflicting repeat with LXP_ERR_ROOT_MISMATCH, and the signed-header lxp_verified_receipt_index_add_authority (src/protocol/lxp_receipt.c:1039) resolves to a null weak reference."

[req.1065]
title = "Genesis registers neither the kernel web module nor the bridge module"
ac_1 = "The genesis module table (src/protocol/lxp_genesis.c:53-54, :67-68) has no LXP_MODULE_BRIDGE or LXP_MODULE_WEB row, module ids 3 and 11 stay reserved, and a genesis that enables either returns LXP_ERR_UNKNOWN_MODULE."
ac_2 = "The program web_read host call no longer calls lx_web_committed_read (src/modules/programs/call.c:1190-1201) and returns LXP_ERR_MODULE_DISABLED."
ac_3 = "Kernel receipt binding no longer routes LXP_MODULE_BRIDGE receipts to lxp_bridge_credit_bind_receipt (src/protocol/lxp_kernel.c:4610, :7377), whose definition at src/protocol/lxp_kernel.c:2396 is deleted."

[req.1066]
title = "The kernel library carries no web module"
ac_1 = "lx_web_module_iface, lx_web_committed_read and lx_web_request_record_decode resolve to null weak references against build/liblayerx.a after src/modules/web is deleted."

[req.1067]
title = "The public headers carry no daemon surface"
ac_1 = "include/layerx/lxp_daemon.h (include/layerx/lxp_daemon.h:1-739) does not exist, so __has_include(\"layerx/lxp_daemon.h\") is false with -Iinclude."

[req.1068]
title = "Bridge headers name no guarantor certificate"
ac_1 = "include/layerx/lxp_bridge.h no longer includes layerx/lxp_guarantor.h (include/layerx/lxp_bridge.h:5) nor defines lxp_withdrawal_claim and lxp_exit_claim (include/layerx/lxp_bridge.h:34-43, :63-69), and lxp_deposit_nullifier and lxp_withdrawal_nullifier (include/layerx/lxp_bridge.h:71, :82) still return their HEAD values."
ac_2 = "lxp_bridge_withdraw_finalize, lxp_exit_claim_build, lxp_exit_verify_balance_proof and lx_checkpoint_registry_register_deposit_root (src/modules/bridge/lxp_bridge_withdraw.c:143, src/modules/bridge/lxp_bridge_exit.c:86, :127, src/modules/asset/lx_asset_custody.c:85) resolve to null weak references."

[req.1069]
title = "The genesis builder header declares no custody bridge builders"
ac_1 = "include/layerx/lxp_genesis_builder.h no longer declares lxp_genesis_build_fresh_custody and lxp_genesis_build_fresh_custody_registry (include/layerx/lxp_genesis_builder.h:31-48), whose definitions domain 5 deletes in task 5.49.1."

[req.1070]
title = "The kernel library carries no custody credit or light client"
ac_1 = "lxp_bridge_credit_parse, lxp_bridge_credit_verify_asset, lxp_bridge_light_trust_encode, and lxp_bridge_module_iface resolve to null weak references against build/liblayerx.a."
ac_2 = "lxp_deposit_nullifier and lxp_withdrawal_nullifier (include/layerx/lxp_bridge.h:71, :82) still link and return the HEAD values used by src/modules/asset/lx_asset_custody.c:223 and :262."

[req.1071]
title = "The service module reads its linked escrow through a runtime callback"
ac_1 = "lx_service_escrow_link and lx_service_runtime (planned) are declared in include/layerx/lx_service.h, and a dispute open whose context has no service runtime returns LXP_ERR_MODULE_DISABLED as escrow does at src/modules/escrow/lx_escrow_module.c:380."
ac_2 = "With a runtime registered the dispute branches call the escrow link reader exactly once and pass its result next to the agreement (src/modules/service/lx_service_module.c:313-356)."

[req.1072]
title = "Only the linked escrow arbiter resolves a service dispute"
ac_1 = "lx_service_dispute_resolve_execute (include/layerx/lx_service.h:425) replaces agreement_party (src/modules/service/lx_service_dispute.c:8-13, :87-90) with the arbiter rule: a principal other than the linked escrow arbiter returns LXP_ERR_UNAUTHORIZED_ARBITER (-738), and a non-DISPUTED agreement keeps LXP_ERR_UNAUTHORIZED_DISPUTANT."
ac_2 = "lx_service_dispute_open_execute (include/layerx/lx_service.h:422) returns LXP_ERR_ARBITER_REQUIRED (-737) when the linked escrow has a zero arbiter and LXP_ERR_ESCROW_LINK_MISMATCH (-739) when holder, beneficiary or asset differ from buyer, provider and offer asset."
ac_3 = "The window, sequence and state rules of open and the escrow_resolution_id record of resolve keep their HEAD results (src/modules/service/lx_service_dispute.c:33-44, :94-95)."

[req.1241]
title = "Add the kernel archive symbol harness used by every retirement test"
ac_1 = "The archive harness lists lxp_kernel_create (src/protocol/lxp_kernel.c:1729) and lxp_log_append as defined symbols of build/liblayerx.a and lists no symbol of the excluded src/storage/lxp_projection.c (Makefile:44)."

