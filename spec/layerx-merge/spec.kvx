ac_1 = "NewParamChangeProposalHandler (modules/sequencer/module.go:218) applies a ParameterChangeProposal on subspace sequencer key Leaders and writes the accepted list to LeaderListKey through Keeper.SetLeaders in the same cache context, so LeaderSchedule returns it from the next block."
ac_2 = "A Leaders change the param validator refuses returns the error and leaves both the param and LeaderListKey unchanged; changes of other keys still pass to next unchanged as at modules/sequencer/module.go:221-223."

[req.5259]
title = "WAL replay restores the lease epoch"
ac_1 = "WAL.Replay (node/sequencer/wal/wal.go:720) sets ReplayResult.Lease to the last LEASE entry in the retained segments even when a COMMITTED entry follows it; today the collector at node/sequencer/wal/wal.go:737-740 drops every entry before the last COMMITTED."
ac_2 = "When a later LEASE follows the last COMMITTED, ReplayResult.Lease is that later lease, and a WAL without LEASE entries gives a nil Lease."

[req.5260]
title = "A restarted standby keeps refusing stale leases"
ac_1 = "NewStandby (node/sequencer/standby.go:494) sets its cursor leaseEpoch from ReplayResult.Lease, so after a restart a replicated LEASE with an epoch below the held one is refused with ErrStaleLease (node/sequencer/standby.go:46) as admit does at node/sequencer/standby.go:455-457."

[req.5261]
title = "Consensus reads the leader pin from an application schedule"
ac_1 = "LeaderPinFromSchedule(0, leaders) returns the zero LeaderPin and nil, so RoundState.Leader (consensus/internal/consensus/types/round_state.go:473) keeps the power-weighted choice on an unmerged chain."
ac_2 = "LeaderPinFromSchedule(S, leaders) converts each 32-byte key with ed25519.PublicKeyFromBytes (consensus/crypto/ed25519/conv.go:21) and returns NewLeaderPin (consensus/internal/consensus/types/round_state.go:429) of them, refusing what NewLeaderPin refuses."
ac_3 = "LeaderPin.Applies(h) is true exactly when the pin holds leaders and h is at or above its activation height, the condition Leader checks at consensus/internal/consensus/types/round_state.go:452."

[req.5262]
title = "The leader pin follows chain state at every height"
ac_1 = "State.SetLeaderSource(src) installs the pin LeaderPinFromSchedule builds from src.LeaderSchedule(height) for the current height at once, replacing the test-only SetLeaderPin path at consensus/internal/consensus/state.go:287."
ac_2 = "updateToState (consensus/internal/consensus/state.go:529) asks the source for the next height before computing the start time at consensus/internal/consensus/state.go:610, so a schedule change committed at height h takes effect at h+1."
ac_3 = "An error from LeaderSchedule stops the state machine through the receive routine's panic handling instead of proposing under a stale pin."

[req.5263]
title = "Sequencer mode runs only on the non-Autobahn consensus path"
ac_1 = "Config.ValidateBasic (consensus/config/config.go:136) refuses consensus.sequencer.enable = true when autobahn-config-file (consensus/config/config.go:80) is set, because the sequencer hook is installed only on the non-giga branch at consensus/node/node.go:241-264."

[req.5264]
title = "Operators get the sequencer settings in the generated config"
ac_1 = "The config template ends the [consensus] section at consensus/config/toml.go:537 with a [consensus.sequencer] table carrying enable, timeout-propose, timeout-propose-delta, timeout-vote and timeout-commit, so WriteConfigFile (consensus/config/toml.go:50) followed by a viper read returns the written SequencerConfig."

[req.5265]
title = "Pinned heights run on the sequencer timeouts"
ac_1 = "With consensus.sequencer.enable, proposeTimeout (consensus/internal/consensus/state.go:2739) returns SequencerConfig.ProposeTimeout(round) (consensus/config/config.go:1252) at a height the leader pin applies to."
ac_2 = "At a pinned height voteTimeout (consensus/internal/consensus/state.go:2754) returns Sequencer.TimeoutVote and commitTime (consensus/internal/consensus/state.go:2767) adds Sequencer.TimeoutCommit."
ac_3 = "Below the pin activation, or with enable false, the three functions keep the consensus-param and unsafe-override behaviour of consensus/internal/consensus/state.go:2739-2773."

[req.5266]
title = "The sequencer leader proposes without consensus mempool transactions"
ac_1 = "enterNewRound (consensus/internal/consensus/state.go:983) skips the waitForTxs branch at consensus/internal/consensus/state.go:1057 when the leader pin applies at the height, because sequenced transactions never enter the consensus mempool."
ac_2 = "Below the pin activation the waitForTxs rule of consensus/internal/consensus/state.go:1057 is unchanged."

[req.5267]
title = "The leader never proposes a sealed block validators must refuse"
ac_1 = "CreateProposalBlock (consensus/internal/state/execution.go:241) returns the new ErrOpenTimeNotAfterLastBlock when SealedBlock.OpenTime is not after state.LastBlockTime, the rule validators apply at consensus/internal/state/validation.go:124, instead of proposing a block every validator rejects."

[req.5268]
title = "The node installs the chain leader schedule into consensus"
ac_1 = "makeNode (consensus/node/node.go:82) calls csState.SetLeaderSource when the application implements types.LeaderSource, next to the SequencerSource hook at consensus/node/node.go:263-264, so SetLeaderPin is no longer test-only."
ac_2 = "makeNode refuses consensus.sequencer.enable = true when the application does not implement types.LeaderSource, so the sequencer timeouts never run without a chain schedule."

[req.5269]
title = "The e2e harness can describe a pinned leader network"
ac_1 = "Manifest (consensus/test/e2e/pkg/manifest.go:13) gains leader_pin (node names, primary first) and leader_pin_height, and LoadTestnet (consensus/test/e2e/pkg/testnet.go:110) resolves them into Testnet.LeaderPin as the nodes' validator keys."
ac_2 = "Testnet.Validate (consensus/test/e2e/pkg/testnet.go:294) refuses a leader_pin name that is not a validator node."
ac_3 = "Testnet.Validate refuses a leader_pin_height below the manifest initial_height and a non-empty leader_pin with height 0."

[req.5270]
title = "An e2e network runs with the leader pin installed"
ac_1 = "The e2e Application (consensus/test/e2e/app/app.go:28) implements types.LeaderSource from Config.LeaderPin (hex ed25519 keys) and Config.LeaderPinHeight, so node.New installs the pin through makeNode as consensus/test/e2e/node/main.go:125 starts it."
ac_2 = "With no LeaderPin configured LeaderSchedule returns activation 0, and MakeAppConfig (consensus/test/e2e/runner/setup.go:312) writes leader_pin and leader_pin_height from the Testnet so every node gets the same list."

[req.5271]
title = "The integrated chain keeps sequencer activation in chain state"
ac_1 = "A chain started from the default genesis by processblock.NewTestApp (tests/testutil/processblock/common.go:36) has SequencerKeeper.ActivationHeight 0 after several blocks, so no height is sequenced on an unmerged chain."
ac_2 = "A chain whose genesis carries a sequencer leader list, a receipt key and activation_height 5 exports the same activation_height through the app genesis export, so an export and re-import keeps the first sequenced height."

[req.5272]
title = "WAL replay reports how far the log reaches"
ac_1 = "WAL.Replay (node/sequencer/wal/wal.go:720) sets ReplayResult.LastLogged to the last ACCEPT entry in the retained segments, including one before the last COMMITTED, while LastAccept (node/sequencer/wal/wal.go:712) keeps meaning the last ACCEPT re-executed after it."
ac_2 = "A WAL without ACCEPT entries gives a nil LastLogged."

[req.5273]
title = "A host holding a later lease refuses the old primary"
ac_1 = "Standby.TakeLease(lease) appends and syncs a LEASE whose epoch is above the held epoch to the standby WAL, then answers every later replicated group with AckRefused and Ack.Epoch set to the held epoch; a group with a LEASE above the held one keeps the admit rule of node/sequencer/standby.go:455-457."
ac_2 = "TakeLease refuses an epoch at or below the held epoch with ErrStaleLease (node/sequencer/standby.go:46) and writes nothing."
ac_3 = "Replicator.Release (node/sequencer/standby.go:214) returns the new ErrFenced when the standby refuses with an Ack.Epoch above the last LEASE epoch the replicator released, so the old primary learns it lost the lease and releases no receipt; Ack.Epoch is zero on every other answer, so the acks compared at node/sequencer/resolution_test.go:297 keep their value."

[req.5274]
title = "The standby takes over with no reordering and no duplicate seq"
ac_1 = "Failover(s, key, openHeight, expiryMs) takes the lease on the standby at the held epoch plus one with KeyID = key.KeyID(openHeight) (node/sequencer/receiptkey.go:91) and returns FailoverResult{Lease, LastSeq, OpenHeight}, where LastSeq is the last replicated ACCEPT, so the next Accept on the standby executor takes LastSeq+1."
ac_2 = "Failover refuses a receipt key that no ReceiptKeys pin covers at the open height with ErrReceiptKeyNotPinned (node/sequencer/receiptkey.go:27), and a receipt key other than the standby's own, and takes no lease."
ac_3 = "After Failover the old primary's next Release returns ErrFenced and the standby WAL holds no ACCEPT from it, so two hosts never receipt the same seq."
ac_4 = "RecoveryOrder(a, b) picks the host to replay first when both stopped: the higher ReplayResult.Lease epoch, then the higher LastLogged seq; equal seqs with different receipt bytes return the new ErrDivergentLogs."

[req.5275]
title = "A planned handover drops no seq and never receipts twice"
ac_1 = "Handover(ctx, cfg) runs the steps in order: Fence on the primary executor, Replicator.Drain until the standby acknowledges the primary's last ACCEPT, then TakeLease on the standby at the replicator epoch plus one; HandoverResult.LastSeq equals the last seq the primary accepted."
ac_2 = "From Fence on, Accept on the primary executor returns the retryable ErrLeaseFenced requested by wiring.J32.2 and nothing reaches either WAL, so a send in the handover window is refused and never receipted twice."
ac_3 = "Handover refuses before fencing when the standby receipt key is not pinned at the open height (node/sequencer/receiptkey.go:91), so the new primary always signs with its own pinned key."
ac_4 = "After Handover the standby executor seals the open block with the same FromSeq, LastSeq and LastSeqHash the primary executor would seal, the equality TestResolutionStandbyReplay checks at node/sequencer/resolution_test.go:308-316 for a stopped primary."

