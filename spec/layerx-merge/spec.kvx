ac_1 = "Executions on 8 goroutines against separate stores with Workers 4 produce the same receipts and state roots as the same executions run one by one on a single-node host (modules/lxphost/host.go:583 at HEAD)."
ac_2 = "NewHost (modules/lxphost/host.go:600) refuses Config.Workers 17 with LXP_ERR_NON_CANONICAL and accepts 16."

