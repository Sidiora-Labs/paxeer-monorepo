ac_1 = "PrecompileABIs returns the five spot precompile names and ABIs without any keeper."

[req.3965]
title = "Drop the cosmos telemetry validator slashed counter from the oracle slash path"
ac_1 = "An oracle slash adds 1 to the OTel validator slashed counter with type=oracle and the package no longer calls the cosmos telemetry counter."

[req.3999]
title = "Domain 3 is complete"
ac_1 = "TestMarketsCompletionRetiredSurfacesAbsent passes on the merged candidate: no retired domain-3 surface remains and every planned domain-3 wave-6 path exists."

[req.4001]
title = "List the served precompile versions v6.10 and v6.12.0 in the versions file"
ac_1 = "precompiles/launchpad/versions:1-2 lists v6.10 and v6.12.0, the two keys GetVersioned serves at precompiles/launchpad/setup.go:15-16, and no longer lists v6.5, which names no package."

[req.4002]
title = "Declare the launchpad Query service in api/launchpad/query.proto and generate it"
ac_1 = "api/launchpad/query.proto (planned) declares service Query in package paxprotocol.paxchain.launchpad with the 17 rpcs Params, Market, MarketByAddress, Markets, MarketsByCreator, PriceHistory, Quote, Treasury, Surface, Retired, FeeRight, AirdropEpoch, AirdropClaimed, HasRole, QuoteLedger, FeeAccounting and PoolMetadata, generated into modules/launchpad/types/query.pb.go (planned); api/launchpad/tx.proto:5-8 declares only service Msg at HEAD."
ac_2 = "Every rpc carries a google.api.http GET rule under /pax-protocol/paxchain/launchpad/ as api/epoch/query.proto does, generated into modules/launchpad/types/query.pb.gw.go (planned), with denom passed as a query parameter because launchpad denoms contain a slash (modules/launchpad/keeper/market.go:176)."

[req.4003]
title = "Add a native-surface detector to the launchpad contract scripts"
ac_1 = "contracts/launchpad/scripts/lib/native-surface.js (planned) exports NATIVE_SURFACE_RUNTIME, the 41-byte runtime of modules/launchpad/keeper/market.go:31, and isNativeSurface(code), which is true only for that exact code compared case-insensitively."

[req.4004]
title = "Read a market's price snapshot ring as height-ordered price points"
ac_1 = "Market.PriceHistory(fromHeight, toHeight) in modules/launchpad/types/price.go (planned) returns the SnapshotCount ring prices oldest first, starting at SnapshotIndex once the ring is full as orderedSnapshots does at modules/launchpad/keeper/market.go:388-402, each paired with its SnapshotHeights entry and filtered to fromHeight..toHeight inclusive."
ac_2 = "PriceHistory refuses fromHeight greater than toHeight with ErrInvalidRange (modules/launchpad/types/errors.go:46) and a ring that updateSnapshot refuses at modules/launchpad/keeper/swap.go:193-196 with ErrInvalidMarket (modules/launchpad/types/errors.go:38); a Market with empty SnapshotHeights reports height 0 for every point."

[req.4005]
title = "Validate query paging and hex address arguments"
ac_1 = "ValidatePage(offset, limit) in modules/launchpad/types/query_validate.go (planned) accepts limit 1 to 100 and refuses limit 0, limit 101 and an offset whose sum with limit overflows uint64 with ErrInvalidRange (modules/launchpad/types/errors.go:46), bounding the pages GetMarkets reads at modules/launchpad/keeper/keeper.go:259."
ac_2 = "ParseHexAddress(field, value) in modules/launchpad/types/query_validate.go (planned) returns the common.Address of a 0x-prefixed 40-hex-digit value of either case, refuses any other value with sdkerrors.ErrInvalidAddress naming the field and refuses the zero address with ErrZeroAddress (modules/launchpad/types/errors.go:26)."

[req.4006]
title = "Convert a launchpad Market into the MarketInfo query view"
ac_1 = "MarketInfoOf in modules/launchpad/types/query_market.go (planned) copies every field of the Market struct at modules/launchpad/types/market.go:70-111 into MarketInfo, writing Int fields as decimal strings and dropping none."

[req.4007]
title = "Convert fee accounting and parse quote ledger kinds for queries"
ac_1 = "ParseQuoteLedgerKind in modules/launchpad/types/query_ledger.go (planned) maps held, fee-held and treasury-held to the three QuoteLedgerKind values matching HeldQuoteLedger, FeeHeldLedger and TreasuryHeldLedger at modules/launchpad/keeper/custody.go:63-71 and refuses any other string with sdkerrors.ErrInvalidRequest."
ac_2 = "FeeAccountingInfoOf in modules/launchpad/types/query_ledger.go (planned) copies PendingProtocolFees, TotalLiabilities, AccountingInitialized and AccountingMigrationCursor of FeeAccounting (modules/launchpad/types/genesis.go:168-176) and the counts of its Pools, Epochs and Claims."

[req.4008]
title = "Convert fee rights, airdrop epochs and retired addresses into query views"
ac_1 = "FeeRightInfoOf, AirdropEpochInfoOf and RetiredInfoOf in modules/launchpad/types/query_registry.go (planned) copy every field of FeeRight (modules/launchpad/types/genesis.go:100), PoolAirdropEpoch (modules/launchpad/types/genesis.go:148) and RetiredAddress (modules/launchpad/types/genesis.go:205) into FeeRightInfo, AirdropEpochInfo and RetiredInfo."

[req.4009]
title = "Add the launchpad Querier that serves the Query service"
ac_1 = "keeper.Querier in modules/launchpad/keeper/grpc_query.go (planned) embeds *Keeper and types.UnimplementedQueryServer, satisfies types.QueryServer at compile time, and NewQuerier(k) registers on a gRPC query router under /paxprotocol.paxchain.launchpad.Query/."

[req.4010]
title = "Serve a market's price history from the keeper"
ac_1 = "Keeper.PriceHistory(ctx, denom, fromHeight, toHeight) in modules/launchpad/keeper/price_history.go (planned) reads the market with GetMarket (modules/launchpad/keeper/keeper.go:200) and returns Market.PriceHistory over it, whose heights are the block heights updateSnapshot records at modules/launchpad/keeper/swap.go:199-204."
ac_2 = "Keeper.PriceHistory refuses an unknown denom with ErrUnknownMarket (modules/launchpad/types/errors.go:28) and fromHeight greater than toHeight with ErrInvalidRange (modules/launchpad/types/errors.go:46)."

[req.4011]
title = "Delete the uncalled generation 1 native airdrop functions"
ac_1 = "The current keeper declares no ExecuteAirdrop, ClaimAirdrop, AirdropEntitlement or ClaimAirdropForEpoch (modules/launchpad/keeper/fees.go:508-640) and no OpenHoldingHistory (modules/launchpad/keeper/history.go:83) or EpochBalance (modules/launchpad/keeper/history.go:155), while the generation 2 airdrop of TriggerAirdrop (modules/launchpad/keeper/airdrop.go:167) and ClaimAirdropEpoch (modules/launchpad/keeper/airdrop.go:232) is unchanged."

[req.4012]
title = "Refuse generation 1 genesis state and stop writing or exporting it"
ac_1 = "GenesisState.Validate (modules/launchpad/types/genesis.go:251) refuses a non-empty AirdropEpochs, AirdropClaims, ProtocolFees, AirdropBases, HoldingHistories or HoldingCheckpoints (modules/launchpad/types/genesis.go:226-231) with ErrInvalidGenesis (modules/launchpad/types/errors.go:40) naming the JSON field, replacing the entry checks at modules/launchpad/types/genesis.go:255-262 and :280-329."
ac_2 = "InitGenesis (modules/launchpad/keeper/genesis.go:14) writes no generation 1 state in place of modules/launchpad/keeper/genesis.go:21-53, and ExportGenesis (modules/launchpad/keeper/genesis.go:205) exports the six fields empty in place of modules/launchpad/keeper/genesis.go:208-274, so a chain with generation 2 markets round-trips."

[req.4013]
title = "Delete the generation 1 keeper accessors and the per-market protocol counter"
ac_1 = "The current keeper declares no TreasuryAddress (modules/launchpad/keeper/keeper.go:78), GetProtocolFees (modules/launchpad/keeper/keeper.go:146), setProtocolFees (modules/launchpad/keeper/keeper.go:164), AddProtocolFees (modules/launchpad/keeper/keeper.go:179) or generation 1 airdrop accessors (modules/launchpad/keeper/keeper.go:300-350), and RecordFee (modules/launchpad/keeper/fees.go:169) still credits the protocol cut to the Treasury quote ledger."

[req.4014]
title = "Assert at compile time that the keeper serves PoolKeeper"
ac_1 = "precompiles/launchpad/pool.go declares var _ PoolKeeper = (*launchpadkeeper.Keeper)(nil) beside the PoolKeeper interface at precompiles/launchpad/pool.go:34-50, and servePool (precompiles/launchpad/run.go:77-90) passes p.keeper directly without the run-time assertion at precompiles/launchpad/run.go:81-85."

[req.4015]
title = "Export the surface runtime from the keeper and alias it in the precompile"
ac_1 = "The keeper exports SurfaceRuntime in place of surfaceRuntime at modules/launchpad/keeper/market.go:31, and precompiles/launchpad/surface.go:12 aliases launchpadkeeper.SurfaceRuntime instead of repeating the 41 bytes, so InstallSurface and createMarket write the same runtime."

[req.4016]
title = "Register a launchpad store decoder for simulation"
ac_1 = "NewDecodeStore in modules/launchpad/simulation/decoder.go (planned) renders a pair of launchpad store values for ParamsKey, MarketCountKey, MarketPrefix and SurfacePrefix (modules/launchpad/types/keys.go:36-50) and names the prefix byte of any other key, and RegisterStoreDecoder at modules/launchpad/module.go:140 registers it under types.StoreKey."

[req.4017]
title = "Serve Query/Params from the launchpad keeper"
ac_1 = "Query/Params returns the Params that GetParams (modules/launchpad/keeper/keeper.go:92) reads, including CreationFee and QuoteToken (api/launchpad/tx.proto:24-25)."
ac_2 = "Query/Params refuses a nil request with codes.InvalidArgument and reads no other store key."

[req.4018]
title = "Serve Query/Market from the launchpad keeper"
ac_1 = "Query/Market{denom} returns MarketInfoOf of the market GetMarket (modules/launchpad/keeper/keeper.go:200) reads, carrying the PoolAddress, TokenAddress and FeeRightID createMarket writes at modules/launchpad/keeper/market.go:193-206."
ac_2 = "Query/Market refuses an empty denom with codes.InvalidArgument and an unknown denom with ErrUnknownMarket (modules/launchpad/types/errors.go:28)."

[req.4019]
title = "Serve Query/MarketByAddress from the launchpad keeper"
ac_1 = "Query/MarketByAddress{address} resolves a pool surface address through poolMarket (modules/launchpad/keeper/airdrop.go:45) and a token address through PoolByToken (modules/launchpad/keeper/market.go:107), returning the same MarketInfo for both."
ac_2 = "Query/MarketByAddress refuses a malformed address with sdkerrors.ErrInvalidAddress through ParseHexAddress and an address that is neither a pool nor a token with ErrUnknownMarket (modules/launchpad/types/errors.go:28)."

[req.4020]
title = "Serve Query/Markets from the launchpad keeper"
ac_1 = "Query/Markets{offset, limit} returns the page GetMarkets (modules/launchpad/keeper/keeper.go:259) reads in index order with total equal to GetMarketCount (modules/launchpad/keeper/keeper.go:142)."
ac_2 = "Query/Markets refuses limit 0 and limit 101 with ErrInvalidRange (modules/launchpad/types/errors.go:46) through ValidatePage."

[req.4021]
title = "Serve Query/MarketsByCreator from the launchpad keeper"
ac_1 = "Query/MarketsByCreator{creator, offset, limit} returns the page GetMarketsByCreator (modules/launchpad/keeper/keeper.go:272) reads for the bech32 creator account that createMarket records at modules/launchpad/keeper/market.go:188."
