[task.1.26.1]
title = "Replace the single host mutex with a bounded pool of kernel nodes"
status = "pending"
mode = "BUILD"
wave = 32
requires = ["1.25.1", "1.17.4"]
reqs = ["1252.1", "1252.2", "1990.1", "1990.2"]
capabilities = ["1.26.1", "1.98.1"]
interfaces = ["interface.1.go-lxphost-config-j22", "interface.1.go-lxphost-host-j22", "interface.1.go-lxphost-new-host-j22", "interface.1.go-lxphost-close-j22"]
do_1 = "At HEAD Host holds one mutex and one lxphost_node (modules/lxphost/host.go:583); HostExecute locks it (modules/lxphost/host.go:683) and pins the OS thread (modules/lxphost/host.go:688), so concurrent executions serialise."
do_2 = "Config (modules/lxphost/host.go:546) gains Workers int; NewHost (modules/lxphost/host.go:600) allocates Workers nodes (0 means 1) into a buffered channel and refuses Workers above 16 with LXP_ERR_NON_CANONICAL, each node holding a 4 MiB arena (LXPHOST_ARENA_BYTES)."
do_3 = "HostExecute takes a node from the channel, runs the unchanged reset-load-execute-commit sequence on it and returns it; Close (modules/lxphost/host.go:612) drains the channel, frees every node and makes later HostExecute calls return LXP_ERR_NON_CANONICAL."
do_4 = "withRead (modules/lxphost/read.go:224) takes a node from the same channel instead of locking h.mu and reading h.node (modules/lxphost/read.go:225), and returns LXP_ERR_NON_CANONICAL after Close exactly as the nil-node check of modules/lxphost/read.go:227 does at HEAD."
do_5 = "Create modules/lxphost/pool_test.go (planned) with TestHostConcurrentExecuteMatchesSequential and TestNewHostRefusesWorkersAboveLimit."
do_6 = "Activity (modules/lxphost/host.go:555-566) gains ReceiptAuthorities []ReceiptAuthority{CanonicalReceipt []byte; BlockHeight uint64}; lxphost_node (modules/lxphost/host.go:33) gains an lxp_verified_receipt_index verified_receipts member reset with the node."
do_7 = "lxphost_execute (modules/lxphost/host.go:446) calls lxp_verified_receipt_index_add_height_authority (planned by task 1.17.4) once per entry before execution, sets execution->verified_receipts (include/layerx/lxp_kernel.h:220) to the node index, and refuses an entry whose BlockHeight is not below the batch height with LXP_ERR_NON_CANONICAL."
do_8 = "Create modules/lxphost/receipt_authority_test.go (planned) with TestHostFillsHeightAuthorityIndex and TestHostRefusesFutureHeightAuthority."
symbols = ["Config.Workers", "NewHost", "HostExecute", "Close", "TestHostConcurrentExecuteMatchesSequential", "TestNewHostRefusesWorkersAboveLimit", "withRead", "Activity.ReceiptAuthorities", "ReceiptAuthority", "TestHostFillsHeightAuthorityIndex", "TestHostRefusesFutureHeightAuthority"]
touches = ["modules/lxphost/host.go", "modules/lxphost/read.go", "modules/lxphost/pool_test.go", "modules/lxphost/receipt_authority_test.go"]
tests = ["modules/lxphost/pool_test.go::TestHostConcurrentExecuteMatchesSequential", "modules/lxphost/pool_test.go::TestNewHostRefusesWorkersAboveLimit", "modules/lxphost/receipt_authority_test.go::TestHostFillsHeightAuthorityIndex", "modules/lxphost/receipt_authority_test.go::TestHostRefusesFutureHeightAuthority"]
planned_paths = ["modules/lxphost/pool_test.go", "modules/lxphost/receipt_authority_test.go"]
build_cmd = "make paxd-native-libs && CGO_ENABLED=1 go build ./modules/lxphost/"
