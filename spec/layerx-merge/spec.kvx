[task.4.26.1]
title = "Answer every discovery failure with the frozen v2 Error envelope"
status = "done"
mode = "BUILD"
wave = 0
requires = []
reqs = ["4265.1", "4265.2"]
capabilities = ["4.26.1"]
interfaces = ["interface.4.err-discovery-discovery-unavailable-j11", "interface.4.err-discovery-frozen-error-envelope-j29"]
do_1 = "reply (services/launchpad/discovery/http.go:44) writes {\"error\":\"discovery_unavailable\"} for every failure (services/launchpad/discovery/http.go:59) and the route handlers write bare 401 and 400 statuses with no body (services/launchpad/discovery/http.go:72, services/launchpad/discovery/http.go:85); the frozen Error requires code, message, requestId, retryable, retryAfterMs, fieldErrors and details (sdk/launchpad/packages/production-contracts-v2/src/schemas.gen.json:12197)."
do_2 = "Create services/launchpad/discovery/errors.go (planned) with writeError(w http.ResponseWriter, r *http.Request, status int, code string) writing the seven Error fields, requestId from the X-Request-Id header or a new UUID, retryable true only for 503, retryAfterMs null, fieldErrors [] and details null, and errorStatus(e error) (int, string) mapping ErrInvalid 400 INVALID_REQUEST, ErrForbidden 403 SCOPE_DENIED, ErrConflict 409 CONFLICT, sql.ErrNoRows 404 NOT_FOUND, other 503 DEPENDENCY_UNAVAILABLE."
do_3 = "Make reply call writeError on failure and replace every bare w.WriteHeader(401) with writeError(w, r, 401, \"AUTH_REQUIRED\") and every bare w.WriteHeader(400) with writeError(w, r, 400, \"INVALID_REQUEST\") in HTTP.Handler (services/launchpad/discovery/http.go:64)."
