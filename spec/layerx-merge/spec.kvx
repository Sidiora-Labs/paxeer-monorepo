storage = "0x0905 jobs live in the layerxagent store; 0x0906 streams are the pay kernel stream records (decision.237)"
errors = "Error(string) reasons in registry form LXP_<code>: <message> through pcommon.LXPRevert for every layerxagent common error, including the new LXP_AGENT_NOT_ACTIVE and LXP_AGENT_SCHEDULER_CALLDATA_TOO_LARGE rows (decision.228)"
events = "JobScheduled, JobCancelled, JobRescheduled, StreamOpened, StreamSettled, StreamClosed and StreamRateUpdated EVM logs; JobExecuted and JobFailed stay ABI topics with typed module events as their only record (decision.233)"
gas = "D2 table rows of precompiles/layerxagent/common/gas.go:30-57 charged on the full call input including the selector (decision.231); merge constructors pass explicit provisional caps (decision.230)"
activation = "Served from the height where MergeUpgrade is done, gated by mergePrecompileGate (node/upgrades.go:521) on the layerxagent module, 0x0903 also on layerxexchange and 0x0906 on layerxpay (node/upgrades.go:529-536)"
invariants = "A scheduled job deposit is refunded or spent exactly once; a 0x0906 stream record is identical to the 0x101B stream record of the same id; settle from payer or recipient and close from payer only (decision.238)"
pause = "layerxagent Params.Paused refuses schedule and reschedule with LXP_PAUSED_SCOPE and keeps cancel as the only exit (decision.225); 0x0906 follows the layerxpay pause scope; pure helpers and views always answer"
interfaces = ["interface.2.go-layerxagent-scheduler-address-j24", "interface.2.go-layerxagent-scheduler-layerxagentkeepers-j24", "interface.2.go-layerxagent-scheduler-newmergeprecompile-j24", "interface.2.go-layerxagent-streams-address-j24", "interface.2.go-layerxagent-streams-newmergeprecompile-j24", "interface.2.pc-0x0905-cancel", "interface.2.pc-0x0905-evt-jobcancelled", "interface.2.pc-0x0905-evt-jobexecuted", "interface.2.pc-0x0905-evt-jobfailed", "interface.2.pc-0x0905-evt-jobrescheduled", "interface.2.pc-0x0905-evt-jobscheduled", "interface.2.pc-0x0905-getjob", "interface.2.pc-0x0905-pending", "interface.2.pc-0x0905-reschedule", "interface.2.pc-0x0905-schedule", "interface.2.pc-0x0906-accrued", "interface.2.pc-0x0906-close", "interface.2.pc-0x0906-evt-streamclosed", "interface.2.pc-0x0906-evt-streamopened", "interface.2.pc-0x0906-evt-streamrateupdated", "interface.2.pc-0x0906-evt-streamsettled", "interface.2.pc-0x0906-getstream", "interface.2.pc-0x0906-open", "interface.2.pc-0x0906-settle", "interface.2.pc-0x0906-updaterate"]

[contract_context.2.api-layerxauth-j97]
interface = "3 surfaces under api/layerxauth (1 cosmos_msg, 2 proto_message; 2 change, 1 new) frozen at the anchors contracts/ledger-auth.md#layerxauth-genesis, contracts/ledger-auth.md#msg-layerxauth-updateparams, contracts/ledger-auth.md#proto-layerxauth-layerxscopeauthorization: paxprotocol.paxchain.layerxauth.Msg/UpdateParams: rpc UpdateParams(MsgUpdateParams) return (api/layerxauth/tx.proto:9); message paxprotocol.paxchain.layerxauth.GenesisState { Params params = 1; } (api/layerxauth/genesis.proto (planned)); message paxprotocol.paxchain.layerxauth.LayerXScopeAuthorization { uint64 module_mask = 1; (api/layerxauth/tx.proto:24)"
storage = "no storage_key item in this context; the api/layerxauth items read or write state only through the keepers and stores frozen by the other domain-2 contexts"
errors = "no error_code item in this context; failures surface through the error registries frozen by the other domain-2 contexts"
events = "no event, precompile_event or sol_event item is named by this context; events of the handlers behind these items are frozen by the other domain-2 contexts"
gas = "not metered: no item in this context is a precompile method"
activation = "lands with tasks 2.1.2, 2.1.8, 2.9.2 in waves 0, 2"
invariants = "each item keeps the kind, path and signature of its interface block once its landing task passes; a later change of any item needs a new decision of domain 2"
pause = "no pause parameter governs these items; they are disabled only by reverting the touches of their landing tasks"
interfaces = ["interface.2.msg-layerxauth-updateparams", "interface.2.proto-layerxauth-genesisstate-j23", "interface.2.proto-layerxauth-layerxscopeauthorization"]

