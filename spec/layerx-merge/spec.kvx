[req.7279]
title = "The regenerated bank gateway serves factory denoms through the query-string bindings"
ac_1 = "Every .proto under sdk/proto/cosmos/bank/v1beta1 (5 at HEAD, for example sdk/proto/cosmos/bank/v1beta1/authz.proto:1) matches the descriptor of its generated package read through a representative type, in package, imports, messages, fields, enums, rpcs and HTTP rules (planned)."
ac_2 = "GET /cosmos/bank/v1beta1/supply/by_denom?denom=factory%2F<creator>%2Frest returns the supply of that factory denom through SupplyOf (sdk/x/bank/keeper/grpc_query.go:127), while the path form on pattern_Query_SupplyOf_0 (sdk/x/bank/types/query.pb.gw.go:853) returns 404."
ac_3 = "GET /cosmos/bank/v1beta1/denoms_metadata_by_query_string?denom=factory%2F<creator>%2Frest returns the metadata CreateDenom stored (modules/tokenfactory/keeper/createdenom.go:13) through DenomMetadata (sdk/x/bank/keeper/grpc_query.go:183), while the path form on pattern_Query_DenomMetadata_0 (sdk/x/bank/types/query.pb.gw.go:857) returns 404."

[req.7280]
title = "Tokenfactory DenomAuthorityMetadata is reachable over REST for factory denoms"
ac_1 = "GET /pax-protocol/paxchain/tokenfactory/denom_authority_metadata?denom=factory%2F<creator>%2Fmeta returns Admin equal to the creator through DenomAuthorityMetadata (modules/tokenfactory/keeper/grpc_query.go:22), while the path route of api/tokenfactory/query.proto:24 returns 404 for that denom."

[req.7281]
title = "Tokenfactory DenomPaused is reachable over REST for factory denoms"
ac_1 = "GET /pax-protocol/paxchain/tokenfactory/denom_paused?denom=factory%2F<creator>%2Fhalt reports paused true for a paused factory denom and false for an unpaused one, while the planned path route under /pax-protocol/paxchain/tokenfactory/denoms/ returns 404 for that denom (planned)."

