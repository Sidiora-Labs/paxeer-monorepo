interface = "Makefile targets build, test, core-test-all, core-qualification-environment and workspace-* (Makefile:211, :292, :3276, :3294, :3309)"
storage = "build/ outputs only."
errors = "make exits 2 for a retired target name."
events = "none"
gas = "none (build graph)"
activation = "Retirements land dependents first: kernel library rules wave 1, kernel component tests wave 2, agent wire and LNI wave 3, daemon dependants waves 4 and 5, the layerxd core wave 6."
invariants = "make -n build test exits 0 at every wave revision."
pause = "none"
interfaces = ["interface.16.mk-test-exchange-native", "interface.16.mk-build", "interface.16.mk-test", "interface.16.mk-core-test-all"]

[contract_context.16.paxeer-x-gates]
