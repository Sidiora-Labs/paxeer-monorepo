[task.9.2.1]
title = "Prepare EIP-1559 transactions at the pending nonce"
status = "pending"
mode = "BUILD"
wave = 7
requires = ["9.12.1", "9.0.1", "9.1.8"]
reqs = ["9010.1", "9010.2", "9010.3"]
capabilities = ["9.2.1"]
interfaces = ["interface.9.rs-agentd-prepare-prepared", "interface.9.http-rpc-prepare"]
do_1 = "services/agent/crates/layerx-agentd/src/prepare/mod.rs:35 `CorePreparationState` holds network_id, account_sequence, protocol_timestamp and observed_head_sequence read through the LNI preparation-state request (services/agent/crates/layerx-agentd/src/prepare/mod.rs:123 maps layerx_client::lni::PreparationStateError); replace it with `EvmPreparationState { chain_id: u64, pending_nonce: u64, base_fee_per_gas: u128, head_height: u64 }` read through `SequencerEndpoint::pending_nonce` (services/agent/crates/layerx-client/src/sequencer.rs:251) and `block_by_number` (services/agent/crates/layerx-client/src/sequencer.rs:393)."
do_2 = "services/agent/crates/layerx-agentd/src/prepare/mod.rs:166 `Prepared` carries an UnsignedEnvelope, canonical_bytes and a 32-byte signing_preimage; it carries `call: layerx_crypto::evm_transaction::Eip1559Call` (services/agent/crates/layerx-crypto/src/evm_transaction.rs:13), `signing_hash` from `Eip1559Call::signing_hash` (services/agent/crates/layerx-crypto/src/evm_transaction.rs:195) and `observed_head_height` instead."
do_3 = "services/agent/crates/layerx-agentd/src/prepare/mod.rs:371 `prepare_bound` compares request.expected_account_sequence with state.account_sequence (services/agent/crates/layerx-agentd/src/prepare/mod.rs:384-390); it compares an expected nonce with the pending nonce and returns `PrepareError::StaleNonce { expected, pending }` in place of StaleSequence (services/agent/crates/layerx-agentd/src/prepare/mod.rs:187)."
do_4 = "services/agent/crates/layerx-agentd/src/prepare/mod.rs:10-13 import layerx_wire encode_unsigned_envelope, payload_hash_for, PROTOCOL_VERSION and preimage_unsigned; drop them and encode the call data through the precompile ABI target chosen by the request (layerxledger 0x101A transfers, layerxpay 0x101B, layerxauth 0x101C, layerxprograms 0x101D)."
do_5 = "gas_limit comes from `SequencerEndpoint::estimate_gas` (services/agent/crates/layerx-client/src/sequencer.rs:260) and max_fee_per_gas is base_fee_per_gas * 2 + max_priority_fee_per_gas, refused with PrepareError::InvalidDefaults when the request ceiling is lower."
do_6 = "Re-target services/agent/crates/layerx-agentd/tests/prepare.rs fixtures that build a CorePreparationState to the new state type and create services/agent/crates/layerx-agentd/tests/evm_preimage_golden.rs (planned)."
symbols = ["EvmPreparationState", "Prepared", "PrepareError::StaleNonce", "prepare_activity"]
touches = ["services/agent/crates/layerx-agentd/src/prepare/mod.rs", "services/agent/crates/layerx-agentd/tests/prepare.rs", "services/agent/crates/layerx-agentd/tests/evm_preimage_golden.rs", "services/agent/crates/layerx-agentd/src/human_runtime.rs"]
tests = ["services/agent/crates/layerx-agentd/tests/evm_preimage_golden.rs::prepared_transfer_signing_hash_matches_the_eip1559_golden", "services/agent/crates/layerx-agentd/tests/evm_preimage_golden.rs::prepare_refuses_an_expected_nonce_behind_the_pending_nonce", "services/agent/crates/layerx-agentd/tests/evm_preimage_golden.rs::prepare_derives_fee_caps_from_the_head_base_fee"]
planned_paths = ["services/agent/crates/layerx-agentd/tests/evm_preimage_golden.rs"]
build_cmd = "cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd"
verify_cmd = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd --test evm_preimage_golden -- --exact prepared_transfer_signing_hash_matches_the_eip1559_golden prepare_refuses_an_expected_nonce_behind_the_pending_nonce prepare_derives_fee_caps_from_the_head_base_fee"
