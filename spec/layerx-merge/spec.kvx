ac_2 = "A spot activity routed to lx_spot_module_iface (include/layerx/lx_spot.h:123) is no longer refused with LXP_ERR_MODULE_DISABLED."
ac_3 = "LX_STREAM_OPEN (include/layerx/lx_stream.h:27) executes against the registered stream module."
ac_4 = "LX_SERVICE_OFFER_PUBLISH (include/layerx/lx_service.h:14) executes against the registered service module."

[req.1250]
title = "Stop loading and writing the kernel idempotency rows in the host store"
ac_1 = "After an execution with a non-zero idempotency key the store holds no 0x04 row, which commit writes at HEAD (modules/lxphost/ctx.go:281)."
ac_2 = "A store holding malformed legacy 0x04 rows executes normally because load no longer parses them (modules/lxphost/ctx.go:151)."

