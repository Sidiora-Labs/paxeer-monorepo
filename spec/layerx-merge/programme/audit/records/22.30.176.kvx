[finding.8]
file = "scripts/ci/no-float-scan.sh"
line = 46
class = "test-gap"
severity = "medium"
observed = "The object inventory hides find failures with || true, and objdump/nm failures inside conditional pipelines are treated like grep finding no forbidden text. A missing object tree or unavailable inspection tool can therefore print the unconditional no-floating-point success claim without a completed binary inspection."
expected = "A consensus binary scan must distinguish no forbidden instructions from no inspectable artifacts or a failed tool, and must cover the current built source inventory."
proposal = "In scripts/ci/no-float-scan.sh require the expected object inventory and successful objdump/nm exit statuses before matching output; report source-only inspection separately and add negative cases for missing artifacts and failed inspection tools."
owner_domain = 16

[finding.9]
file = "scripts/ci/symbol-allowlist.sh"
line = 9
class = "test-gap"
severity = "medium"
observed = "symbol-allowlist.sh exits zero when its object search yields nothing, hides find errors, and does not propagate nm failures through its grep pipelines. Its operating-system, SQLite and balance-writer checks can grant success after inspecting no usable binary symbols."
expected = "The declared consensus symbol boundary must be checked against the actual built objects, with unavailable or unreadable inputs refused rather than credited as a clean symbol inventory."
proposal = "Require the expected object set and successful nm extraction in scripts/ci/symbol-allowlist.sh before evaluating forbidden names; cover empty inventory and nm failure as refused checks while preserving all current forbidden symbols."
owner_domain = 16

