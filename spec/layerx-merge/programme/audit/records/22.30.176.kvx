[finding.12]
file = "scripts/ci/secret-scan.sh"
line = 17
class = "security"
severity = "medium"
observed = "run_rg suppresses all xargs/rg errors with || true and the private-key scan similarly hides failures. Even when the scanner self-test passes, an unreadable or removed publication file can be skipped and the actual scan can return success without examining it."
expected = "A publication scan must fail closed when any selected file cannot be inspected; passing its synthetic pattern self-test is not evidence that every real publication input was read."
proposal = "Preserve no-match as a successful scan but propagate unreadable-file and tool errors in scripts/ci/secret-scan.sh; retain safe redacted diagnostics and prove a selected inaccessible input refuses publication."
owner_domain = 16

[finding.13]
file = "scripts/ci/public-repo-audit.sh"
line = 134
class = "security"
severity = "medium"
observed = "audit_rg ends its publication-file search pipeline with || true and treats an empty output file as no private reference. File read or rg execution failures are indistinguishable from a clean search, so the outer public repository audit may overlook uninspected inputs."
expected = "Every selected publication file must be inspected successfully for private infrastructure references before the repository is declared publishable."
proposal = "Change scripts/ci/public-repo-audit.sh audit_rg to retain and classify rg/xargs failures separately from a genuine no-match result, and refuse publication when any selected file could not be searched."
owner_domain = 16

