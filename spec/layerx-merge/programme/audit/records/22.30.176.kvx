[file.47]
path = "tests/occ/messages/test_msgs.go"
lines = 185
verdict = "clean"
note = "WasmInstantiate uses the CW20-compatible message, EVM transactions are signed, and the pointer harness supplies current merge keepers through precompiletest.Install."

[file.48]
path = "tests/occ/occ_test.go"
lines = 300
verdict = "issues"
note = "assertEqualEventAttributes converts attributes to a boolean set, and assertEqualExecTxResults searches without consuming a match. Equal-length multisets [A,A,B] and [A,B,B] can therefore compare equal, hiding repeated or missing event/result effects in OCC versus sequential execution. assertEqualState compares store-key counts and compares contents only inside equal-name pairs. Two stores with the same count but a replaced store name leave that name unmatched and its contents unexamined."

[file.49]
path = "tests/occ/utils/utils.go"
lines = 396
verdict = "clean"
note = "The node wrapper stores only supported cw20_base wasm, uses real accounts/transaction encoding and node ProcessBlock; fixture CodeID aliases CW20CodeID as req.16301 requires."

