[finding.3]
file = "tools/qualification/paxeer-x/paid-web-contract.py"
line = 808
class = "interface-mismatch"
severity = "high"
observed = "Harness.success, KernelHarness.receipt and OperationalHarness.observed import _decode_protocol_receipt, which does not exist anywhere in the current Python SDK. verifier.py declares _decode_sequencer_receipt and its receipt type has no program_outcome. The normal success/recovery paths therefore fail at the SDK boundary before validating the node receipt."
expected = "The pax_sequencerReceipt producer in rpc/sequencer_receipt.go returns the current signed sequencer layout and authenticated keyId/signingKey fields; qualification must consume the matching SDK verifier and its actual result type."
proposal = "Migrate the receipt consumers in tools/qualification/paxeer-x/paid-web-contract.py to the current authenticated sequencer receipt verifier in services/agent/sdk/python/layerx_sdk/verifier.py, obtain program outcome from the declared execution result, and prove real node JSON through signature verification across a restart."
owner_domain = 16
interface = "7.rpc-pax-sequencerreceipt"

[finding.4]
file = "tools/qualification/paxeer-x/paid-web-contract.py"
line = 1802
class = "interface-mismatch"
severity = "high"
observed = "KernelHarness.signed constructs a legacy LXP v3 envelope beginning 00 03 10 01. KernelHarness.send and receipt pass those bytes to transaction_hash, which explicitly permits only EVM type bytes 2 or 4. reference_deployment similarly requires an LXP envelope and immediately feeds it to receipt, so the kernel recovery case refuses its own required input."
expected = "Registry schema 16.fmt-schema-paxeer-x-kernel-web-recovery-v1 must carry a deployment and calls that can round-trip through the merged node EVM submission, transaction hash and receipt path without contradictory encodings."
proposal = "Replace the KernelHarness legacy envelope builder and deployment fixture in tools/qualification/paxeer-x/paid-web-contract.py with real chain-125 signed EVM transactions to the current program and web precompiles; bind the metadata to those bytes and retain restart, exact retry and fee-conservation assertions."
owner_domain = 16
interface = "16.fmt-schema-paxeer-x-kernel-web-recovery-v1"

