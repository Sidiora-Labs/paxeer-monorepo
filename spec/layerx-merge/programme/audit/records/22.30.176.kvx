[file.39]
path = "scripts/ci/runner-routing-check.sh"
lines = 222
verdict = "clean"
note = "Workflow checks preserve runner exclusion and container constraints without restoring the removed replay-matrix job."

[file.40]
path = "scripts/ci/secret-scan.sh"
lines = 90
verdict = "issues"
note = "run_rg suppresses all xargs/rg errors with || true and the private-key scan similarly hides failures. Even when the scanner self-test passes, an unreadable or removed publication file can be skipped and the actual scan can return success without examining it."

[file.41]
path = "scripts/ci/solidity-state-surface.sh"
lines = 39
verdict = "issues"
note = "The state-surface script strips each ABI entry to its bare function name and accepts any matching token in a .t.sol file. A comment, an unrelated assertion or a different overload satisfies it; no passing test result is consumed even though it prints selectors have test evidence."

[file.42]
path = "scripts/ci/symbol-allowlist.sh"
lines = 46
verdict = "issues"
note = "symbol-allowlist.sh exits zero when its object search yields nothing, hides find errors, and does not propagate nm failures through its grep pipelines. Its operating-system, SQLite and balance-writer checks can grant success after inspecting no usable binary symbols."

[file.43]
path = "scripts/ci/vendor-verify.sh"
lines = 262
verdict = "clean"
note = "The vendor comparison explicitly concerns the Git index against declared upstream provenance, not a claim that arbitrary working files are clean."

[file.44]
path = "scripts/ci/xweb-forge-libs.sh"
lines = 38
verdict = "issues"
note = "xweb-forge-libs.sh compares origin and HEAD to a tag but never checks tracked or untracked working-tree contents. An existing clone with modified Solidity files retains the expected HEAD and is accepted as the pinned library used by Forge."

[file.45]
path = "scripts/ci/xweb-workflow-check.sh"
lines = 1260
verdict = "issues"
note = "DECLARED_PATHS still contains deleted cmd/layerxd process/protocol sources and other retired feature paths. present_or_declared explicitly blesses absent entries as added by a task of the retired paxeer-x-web feature instead of requiring a live source or current task."

