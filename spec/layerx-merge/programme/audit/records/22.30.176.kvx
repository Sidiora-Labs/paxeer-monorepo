[file.30]
path = "scripts/ci/no-float-scan.sh"
lines = 59
verdict = "issues"
note = "The object inventory hides find failures with || true, and objdump/nm failures inside conditional pipelines are treated like grep finding no forbidden text. A missing object tree or unavailable inspection tool can therefore print the unconditional no-floating-point success claim without a completed binary inspection."

[file.31]
path = "scripts/ci/path-length-check.sh"
lines = 94
verdict = "clean"
note = "Tracked path and output-prefix length accounting is bounded and handles its root/path selection explicitly."

[file.32]
path = "scripts/ci/public-repo-audit.sh"
lines = 195
verdict = "issues"
note = "audit_rg ends its publication-file search pipeline with || true and treats an empty output file as no private reference. File read or rg execution failures are indistinguishable from a clean search, so the outer public repository audit may overlook uninspected inputs."

[file.33]
path = "scripts/ci/release-artifact-record.sh"
lines = 77
verdict = "clean"
note = "Artifact records require digest/signature/SBOM/attestation inputs and reject malformed supplied path fields."

[file.34]
path = "scripts/ci/release-gate.sh"
lines = 116
verdict = "issues"
note = "release-gate.sh says its emitted gate entry obeys beta-ledger-check.sh, but writes no source_evidence field. The consumer at beta-ledger-check.sh:843 requires that field and at 916 validates its private source sidecar; every record from this producer fails that contract even if its make command passes. The release gate writes the raw command log and its record under spec/layerx-beta/evidence in the source checkout, without an owner-only evidence directory. A repeated job and revision also reuses command.log and record.kvx, overwriting prior execution evidence."

[file.35]
path = "scripts/ci/release-version.py"
lines = 226
verdict = "clean"
note = "Version synchronization maps retained release packages and omits the retired wire crate."

[file.36]
path = "scripts/ci/restore-build-ownership.py"
lines = 166
verdict = "clean"
note = "Ownership restoration validates captured identity, repository containment and no-follow inode metadata before changing owned outputs."

[file.37]
path = "scripts/ci/result-codes-gen.py"
lines = 165
verdict = "clean"
note = "Result-code tables are generated from the declared canonical result-code source with explicit check/write modes."

[file.38]
path = "scripts/ci/run-tests.sh"
lines = 12
verdict = "clean"
