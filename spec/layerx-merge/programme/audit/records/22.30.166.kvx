# Pre-upgrade source audit of the auth/bank package (decision 2515).

[audit.22.30.166]
task = "22.30.166"
revision = "2b99f88520e4e809ad5593f3bee2df74fe355d7b"
files_reviewed = 204
findings = 44
docs_reviewed = 23
upgrade_ready = false
blocking = ["vesting-allowlist-bypass", "allowlist-genesis-loss", "gas-estimate-stale-authinfo", "block-tx-reverse-pagination", "legacy-supply-request-shape"]
coverage = "All 204 members reviewed in full, including four upstream Atlas files classified as vendored historical material with provenance notes. Reviewed all 311 produced and 340 consumed interface rows, including names, types, encodings, errors and state lifecycle, against actual source and node registration."
requirements_reviewed = ["7288.1", "15002.1", "15002.2", "15017.1", "15017.2", "15017.3", "15018.1", "15018.2", "15027.1", "15033.1", "15028.1", "15034.1", "7289.1"]
interface_review = "Compared auth identity/Any queries, ante feegrant/signatures/params, binary and JSON transaction/signing boundaries, vesting creation and account schedules, bank send/authz, metadata slash-safe gateway bindings, fractional wei and supply accounting, balance hooks, deferred cache and genesis recovery. Existing legacy metric declarations are retired and replacement OTel emitters are present; no member references a retired LayerX router, daemon or public /rpc component."
lifecycle_review = "Node CompleteBlock flushes deferred bank balances before EndBlock/commit; they are not reported as an unflushed-restart defect. Persisted allowlists survive ordinary restart but are lost through genesis recovery. The EVM GetBalance consumer subtracts LockedCoins before reporting spendable base-denom funds, so SubWei borrowing alone does not establish a vesting bypass."
evidence_limits = "Findings describe reviewed source behavior and registry/document agreement. No source repair, Go compilation or runtime regression qualification is asserted by this record."

