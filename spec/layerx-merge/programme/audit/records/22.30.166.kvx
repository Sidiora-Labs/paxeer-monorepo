[finding.vesting-cancellation-unwired]
file = "sdk/x/auth/vesting/types/vesting_account.go"
line = 228
class = "wiring-gap"
severity = "medium"
observed = "BaseVestingAccount declares Admin and CancelledTime, and vesting.proto describes administrator oversight and cancellation time, but continuous, delayed and periodic GetVestedCoins never read CancelledTime. No non-generated auth, node or module execution path reads or sets this field to perform cancellation. An imported account carrying a nonzero cancellation marker continues vesting by time alone."
expected = "The declared BaseVestingAccount lifecycle must distinguish supported administrator/cancellation behavior from reserved schema fields. Accounts marked cancelled must not silently retain the ordinary active schedule contrary to the meaning of that persisted marker."
proposal = "In sdk/x/auth/vesting define the cancellation policy with the network owner, implement an authorized message and consistent schedule/locked/delegated-coin handling, and preserve the state through genesis and restart tests. If cancellation is intentionally unsupported, explicitly reserve the fields and reject nonzero cancellation markers during account validation rather than implying an effective lifecycle."
owner_domain = 15
interface = "7.proto-cosmos-vesting-v1beta1-basevestingaccount-j39"

[finding.wrapper-signature-cardinality]
file = "sdk/x/auth/tx/builder.go"
line = 182
class = "security"
severity = "medium"
observed = "wrapper.GetSignaturesV2 allocates by len(AuthInfo.SignerInfos) and indexes tx.Signatures[i] for each nonnil ModeInfo without first checking signature count. Decoding an unsigned or malformed externally supplied Tx with signer infos but fewer signatures can therefore panic when CLI validation or conversion asks for signatures."
expected = "The signature retrieval API returns an error and must handle externally decoded transaction shapes, including unsigned transactions, without unchecked indexing before cardinality validation."
proposal = "In sdk/x/auth/tx/builder.go validate the signature/signer-info lengths and nil signer-info entries before iterating, distinguish supported unsigned simulation shapes explicitly and return typed errors for malformed cases. Extend builder/CLI tests with actual decoded short-signature TxRaw values and require errors without panic."
owner_domain = 15
interface = "7.proto-cosmos-tx-v1beta1-txraw-j39"

