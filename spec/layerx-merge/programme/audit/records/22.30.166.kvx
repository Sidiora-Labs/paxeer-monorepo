[finding.vesting-allowlist-bypass]
file = "sdk/x/auth/vesting/msg_server.go"
line = 94
class = "security"
severity = "high"
observed = "CreateVestingAccount checks send-enabled and the recipient blocklist, then calls BankKeeper.SendCoins without checking either address against the denomination allowlist. Bank MsgServer.Send/MultiSend perform IsInDenomAllowList for both parties; SendCoins itself does not. Node registers this vesting server with its bank keeper, allowing a restricted factory denomination to reach an unlisted new vesting recipient."
expected = "Tokenfactory README states that a denom allow_list restricts who may send and receive its tokens. The registered cosmos.vesting.v1beta1.Msg/CreateVestingAccount path must enforce the same user-transfer authorization as bank messages; rows 15.go-x-auth-vesting-types-bank-keeper-j76 and 7.proto-cosmos-bank-v1beta1-allowlist-j39 cross this boundary."
proposal = "In sdk/x/auth/vesting/msg_server.go and types/expected_keepers.go, expose and apply the shared bank user-transfer policy before creating/funding the account, preserving intentional module-transfer permissions. Add a real restricted-denom vesting transaction test for both forbidden sender and recipient and assert unchanged accounts/balances on rejection."
owner_domain = 15
interface = "7.msg-cosmos-vesting-v1beta1-createvestingaccount-j39"

[finding.allowlist-genesis-loss]
file = "sdk/x/bank/keeper/genesis.go"
line = 73
class = "restart-recovery"
severity = "high"
observed = "Bank SetDenomAllowList persists transfer authorization, but ExportGenesis emits only params, balances, supply, metadata and WeiBalances, and InitGenesis restores only those fields. Tokenfactory keeper/genesis.go also exports/restores no allowlist. After export into a fresh genesis, GetDenomAllowList returns empty and IsInDenomAllowList permits every address. Ordinary KV-store restart preserves these keys; genesis recovery does not."
expected = "The bank GenesisState and AllowList interfaces must carry persistent token transfer policy through supported state export/import recovery, retaining exactly the same allowed and denied transfers after recovery."
proposal = "Extend sdk/proto/cosmos/bank/v1beta1/genesis.proto and bank genesis types/keeper export-import paths with versioned denom allowlists, including address/duplicate validation, and coordinate tokenfactory ownership. Add a real export/fresh-init recovery test comparing lists and both allowed and forbidden sends before/after recovery."
owner_domain = 15
interface = "7.proto-cosmos-bank-v1beta1-genesisstate-j39"

[finding.gas-estimate-stale-authinfo]
file = "sdk/x/auth/tx/builder.go"
line = 243
class = "interface-mismatch"
severity = "high"
observed = "wrapper.SetGasEstimate mutates tx.AuthInfo.Fee.GasEstimate but never clears authInfoBz. Once DefaultTxEncoder or direct GetSignBytes caches AuthInfo, changing the estimate leaves binary TxRaw/sign bytes at the old value while GetGasEstimate and JSON encoding expose the new value. Other fee setters explicitly invalidate this cache."
expected = "TxBuilder setters and the Fee protobuf representation must round-trip the same gas_estimate through JSON, binary encoding and direct signing, including after decoding an existing transaction or previously producing sign bytes."
proposal = "In sdk/x/auth/tx/builder.go invalidate authInfoBz whenever SetGasEstimate updates Fee. Extend builder_test.go with encode/decode-then-set and sign-bytes-then-set cases that compare decoded binary Fee.GasEstimate, JSON and GetGasEstimate without an intervening setter that hides the defect."
owner_domain = 15
interface = "15.go-client-tx-builder-j76"

[finding.block-tx-reverse-pagination]
file = "sdk/x/auth/tx/service.go"
line = 223
class = "interface-mismatch"
severity = "high"
observed = "GetBlockWithTxs initializes its reverse loop at Pagination.Offset and continues only while i > 0. A nonempty block queried with Reverse=true and the default Offset=0 therefore returns no transactions; nonzero offsets are counted from the front, and transaction index zero is never returned."
expected = "GetBlockWithTxsRequest.PageRequest reverse pagination must return the requested suffix in reverse order, with offset measured from the reversed sequence and every transaction reachable exactly once."
proposal = "In sdk/x/auth/tx/service.go derive the reverse starting index from block transaction count and offset, using bounds that include index zero without unsigned underflow. Add service tests through the registered transaction query server for a one-transaction block, default reverse page and successive reverse offsets/limits."
owner_domain = 15
interface = "7.proto-cosmos-tx-v1beta1-getblockwithtxsrequest-j39"

[finding.legacy-supply-request-shape]
file = "sdk/x/bank/client/rest/query.go"
line = 76
class = "interface-mismatch"
severity = "high"
observed = "totalSupplyHandlerFn serializes NewQueryTotalSupplyParams(page, limit), whose fields are Page and Limit, and forwards it to custom/bank/total_supply. keeper/querier.go:79 instead unmarshals QueryTotalSupplyRequest and reads Pagination. The HTTP producer never sends the pagination object the consumer uses; rejection or ignored fields prevents the requested page/limit from round-tripping."
expected = "The registered legacy REST total-supply transport must translate its page/limit arguments into the custom querier accepted request shape and return the requested supply page consistently with direct queries."
proposal = "In sdk/x/bank/client/rest/query.go translate page/limit to QueryTotalSupplyRequest.Pagination using the shared pagination rules, or restore an explicitly versioned legacy decoder in keeper/querier.go. Add an end-to-end REST-to-custom-querier test with more denoms than one page and compare page two and nondefault limits."
owner_domain = 15
interface = "15.go-x-bank-types-new-query-total-supply-params-j76"

[finding.empty-block-query-rejected]
file = "sdk/x/auth/tx/service.go"
line = 206
class = "runtime-risk"
severity = "medium"
observed = "GetBlockWithTxs rejects offset >= len(block.Data.Txs) before constructing the response. A valid committed empty block queried with the default offset zero is rejected as out of range, although the block itself exists and GetProtoBlock has succeeded."
expected = "A valid empty block must remain queryable with its block identity, empty transaction list and a zero pagination total; absence of transactions is a normal committed-block condition."
proposal = "Handle the empty-block/default-offset case in sdk/x/auth/tx/service.go before the nonempty pagination bounds check. Add a registered-service regression that queries an empty committed block and checks the block id, empty Txs and total zero."
owner_domain = 15
interface = "7.proto-cosmos-tx-v1beta1-getblockwithtxsresponse-j39"

[finding.multisig-mode-shape-panic]
file = "sdk/x/auth/tx/sigs.go"
line = 75
class = "security"
severity = "medium"
observed = "ModeInfoAndSigToSignatureData dereferences modeInfo.Sum and nested Single/Multi values without nil checks, then indexes sigv2s[i] and sigs[i] for every ModeInfos element without equal cardinality validation. A malformed protobuf multisig can therefore panic during signature conversion instead of returning its declared error."
expected = "Untrusted transaction signature structures must be checked before recursion and indexing; malformed mode or multisig lengths must produce an SDK transaction-decode error rather than a panic in node or offline clients."
proposal = "Validate mode discriminants, nested pointers, bitarray shape and signature/mode counts in sdk/x/auth/tx/sigs.go before recursive conversion. Add malformed wire-signature tests for missing/extra signatures, nil nested modes and invalid bitarrays, asserting returned errors and no panic."
owner_domain = 15
interface = "7.proto-cosmos-tx-v1beta1-modeinfo-multi-j39"

[finding.multisig-gas-shape-panic]
file = "sdk/x/auth/ante/sigverify.go"
line = 431
class = "security"
severity = "medium"
observed = "ConsumeMultisignatureVerificationGas trusts sig.BitArray.Count, indexes pubkey.GetPubKeys()[i] and sig.Signatures[sigIndex] for set bits, and never verifies either length. Malformed multisig structures reaching gas consumption can panic before signature validation can reject them."
expected = "Ante signature gas accounting must reject inconsistent key, bitarray and signature cardinalities with a typed validation error before any untrusted-derived index is used."
proposal = "In sdk/x/auth/ante/sigverify.go validate nonnil bitarrays, key count, set-bit count and signature count at the gas-consumer boundary. Add tests invoking the actual decorator/consumer with short signatures, oversized bitarrays and nested malformed multisigs and require deterministic SDK errors."
owner_domain = 15

[finding.amino-multisig-shape-panic]
file = "sdk/x/auth/legacy/legacytx/stdsign.go"
line = 164
class = "security"
severity = "medium"
