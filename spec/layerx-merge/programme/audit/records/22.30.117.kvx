[finding.1]
file = "services/wallet/attestor/internal/policy/lx/lx.go"
line = 654
class = "wiring-gap"
severity = "high"
observed = "EvaluateSendAuthorization deliberately returns empty Spends and inspectSendAuthorizationCall discards the cap totals. Server doSign announces that empty list. The production attestor has no committed-send ingestion path that later applies these debits; only acceptKernelSend in durability_test.go applies and announces them."
expected = "Authorizing a send must leave balances unchanged, but a committed debit must enter the durable rolling ledger exactly once so subsequent authorizations see prior spend across all quorum members and restarts."
proposal = "Add authenticated committed-receipt ingestion in services/wallet/attestor/internal/server and a durable cursor in internal/store. Bind each debit to its held key, chain, asset, authorization digest and transaction identity, verify committed evidence, deduplicate and replicate it before further cap-sensitive authorizations."
owner_domain = 12
interface = "12.go-att-lx-evaluator-evaluate-send-authorization"

[finding.2]
file = "services/wallet/attestor/internal/server/sign.go"
line = 440
class = "restart-recovery"
severity = "high"
observed = "doSign identifies accounting solely by key_id/session_id. SpendLedger.ForRequest excludes entries with that ID and RecordSpend merges their maximum. No durable request-body or signing-digest binding exists on this route. A changed nonce or recipient under the same session is a different JWT RequestDigest and can be signed after the transport tombstone expires (default 30 seconds), or after quorum restart, while prior spend is excluded."
expected = "One accounting identity must refer to one immutable signing intent across token changes, transport expiry and restarts. Distinct signed transactions must consume separate daily and request-rate budgets."
proposal = "Persist key, session, epoch and canonical signing-intent digest before policy evaluation in services/wallet/attestor/internal/server/sign.go using internal/store. Refuse changed intents and return durable results for exact retries; bind peer announcements to the same identity. Follow the native_purpose.go durable consent binding pattern."
owner_domain = 12
interface = "12.go-att-policy-spend-ledger-for-request"

[finding.3]
file = "services/wallet/attestor/internal/policy/policy.go"
line = 740
class = "interface-mismatch"
severity = "high"
observed = "inspectCall maps every layerxprograms.transfer leg to AssetNative and ignores its Asset, From and To. sandboxFund also charges amount as native, and budgetFund/budgetFundNative assume native without resolving the budget asset. The canonical ABIs and execution paths retain bytes32 assets: method_transfer.go encodes leg.Asset and layerxpay budget handlers use the stored Budget.AssetID."
expected = "The policy decision must describe the same asset and amount the precompile debits. An asset without a cap must be refused, and asset units must never be compared with the native wei cap merely because calldata contains an amount."
proposal = "Implement asset-aware construct inspection in services/wallet/attestor/internal/policy/policy.go. Preserve transfer leg asset IDs and owned source/destination effects, include sandbox funding legs, and resolve budget assets from a pinned verified state read; refuse unresolved effects. Use one canonical asset-key convention with existing send and grant accounting."
owner_domain = 12
interface = "12.go-att-policy-inspect-construct-spends-j49"

[finding.4]
file = "services/wallet/attestor/internal/policy/policy.go"
line = 694
class = "wiring-gap"
severity = "high"
observed = "The inspectCall switch has no debit case for budgetCreate, budgetCreateNative or escrowOpen. With a listed selector and zero EVM value these produce no spend. The shipped-policy test explicitly accepts budgetCreate and escrowOpen amounts of 100 PAX with an empty spend list. Actual budget creation emits an owner-to-budget transfer in src/modules/budget/lx_budget_create.c, and escrow opening locks owner funds in src/modules/escrow/lx_escrow_open.c."
expected = "A selector allowlist authorizes a method, while monetary policy must still bound the actual owner debit or reservation. Creating a funded budget or escrow must enforce the asset cap and rolling daily limit."
proposal = "Extend services/wallet/attestor/internal/policy/policy.go to extract the initial amount, asset and owned source of budgetCreate, budgetCreateNative and escrowOpen. Charge their real debit once and refuse unsupported spend-bearing methods until effects can be established. Prove decisions against executed precompile balance changes."
owner_domain = 12
interface = "12.go-att-policy-policy-evaluate"

[finding.5]
file = "services/wallet/attestor/internal/policy/policy_test.go"
line = 408
class = "test-gap"
severity = "medium"
observed = "TestLayerxpayBudgetFundCountsNativeSpend gives program transfer legs Asset=[32]byte{3} and sandbox funding Asset=[32]byte{5}, then requires native accounting. TestShippedPolicyAllowsConstructSelectors requires empty spends for funded budgetCreate and escrowOpen calls. These expectations reproduce the inspector rather than the executed asset transfers."
expected = "Construct policy tests must compare policy decisions with actual precompile effects, including non-native assets and initial funding, rather than enforce a different asset shape or zero debit."
proposal = "Replace these expectations in services/wallet/attestor/internal/policy/policy_test.go with funded canonical-account fixtures and a real precompile execution path. Assert exact asset IDs, source balances, daily totals and refusal of uncapped assets for all debit-bearing selectors."
owner_domain = 12
interface = "12.go-att-policy-inspect-construct-spends-j49"

[finding.6]
file = "services/wallet/attestor/internal/server/durability_test.go"
line = 380
class = "test-gap"
severity = "medium"
observed = "acceptKernelSend calls the evaluator, constructs spends itself, invokes server.spends.Apply directly and then Announce. Daily-cap and restart assertions therefore test a debit inserted by test code; no running node submission, committed receipt or production debit-ingestion handler supplies it."
expected = "The restart and quorum proof must establish that the running product records accepted sends, including receipt verification, duplicate delivery and recovery, without tests writing the ledger themselves."
proposal = "Change services/wallet/attestor/internal/server/durability_test.go to submit a real signed send and feed its committed evidence through the production ingestion path. Restart a member before delivery, replay the evidence, and assert one debit and consistent refusal across different signing quorums."
owner_domain = 12
interface = "12.go-att-policy-spend-ledger-apply"

[finding.7]
file = "services/wallet/attestor/internal/server/send_authorization_test.go"
line = 203
class = "test-gap"
severity = "medium"
observed = "TestSendAuthorizationSignedByTheHeldKeyCompletesAnAcceptedSend verifies a real quorum signature but delegates acceptance to acceptKernelSend, which manually applies the spend. Its second-authorization daily-cap refusal does not prove that a real accepted network send reaches accounting."
expected = "The declared send completion proof must connect quorum authorization, network execution, committed receipt transport and durable attestor accounting using the same bytes and identities."
proposal = "Extend services/wallet/attestor/internal/server/send_authorization_test.go to submit the completed bytes to the actual node and exercise the production committed-receipt consumer. Assert the next authorization is refused without any direct ledger mutation in the test."
owner_domain = 12
interface = "12.go-att-lx-evaluator-evaluate-send-authorization"

[finding.8]
file = "services/wallet/attestor/internal/server/token_scope_test.go"
line = 34
class = "test-gap"
severity = "medium"
observed = "TestOneTokenAuthorisesDistinctRequestsAndRefusesARepeat covers only identical request bodies under the same token, including after one node restarts. It does not try a changed transaction under a reused session ID, which changes RequestDigest and evades the accounting identity assumption in doSign."
expected = "Replay coverage must include the distinction between token replay and signing-intent identity, with the latter preserved across fresh credentials, transport expiry and full quorum restart."
proposal = "Add a real quorum regression in services/wallet/attestor/internal/server/token_scope_test.go: sign a cap-sized EVM transfer, change nonce and recipient while retaining session_id, and retry after transport expiry and quorum restart with original and fresh tokens. Require refusal and unchanged durable totals."
owner_domain = 12
interface = "12.go-att-jwt-request-digest"

[finding.9]
file = "apps/wallet/src/providers/LocaleProvider.tsx"
line = 78
class = "wiring-gap"
severity = "medium"
observed = "The currency-rates event increments an unnamed state value, but ctx is memoized only on locale, dir and setLocale, so the provider does not notify context consumers. Fiat widgets such as HeroBalance render formatUsd from mutable rates and preferences without subscribing to this event or context; updating the provider alone cannot refresh their unchanged props."
expected = "Changing display currency or receiving exchange rates must update visible fiat values promptly through the subscribed render path, including components whose other props and locale remain unchanged."
proposal = "Expose currencyRevision from apps/wallet/src/providers/LocaleProvider.tsx, include it in context dependencies and subscribe fiat widgets to it, or use an external currency store directly in those widgets. Cover a mounted portfolio amount changing after CURRENCY_RATES_EVENT without a locale or balance change."
owner_domain = 12
interface = "12.evt-app-currency-rates-event"

[finding.10]
file = "apps/wallet/src/providers/PWAProvider.tsx"
line = 153
class = "runtime-risk"
severity = "low"
observed = "The install effect adds an anonymous appinstalled listener but removes only beforeinstallprompt. Its three-second install prompt timeout is also untracked. Remounts retain listeners, and an install or dismissal during that delay can be followed by an obsolete prompt opening."
expected = "The provider lifecycle must remove its window listeners and cancel delayed install prompts when installed, dismissed, rerun or unmounted."
proposal = "Use a named appinstalled handler and a tracked timer in apps/wallet/src/providers/PWAProvider.tsx. Remove both listeners and clear the timer in cleanup and successful-install handling; cancel it when the user dismisses or accepts the install prompt."
owner_domain = 12

[finding.11]
file = "services/wallet/attestor/internal/server/server.go"
line = 418
class = "runtime-risk"
severity = "medium"
observed = "Serve sets only ReadHeaderTimeout. readBody limits bytes but uses io.ReadAll without a body deadline, and ProtocolTimeout is applied only later to TSS sessions. A permitted mTLS client can finish headers and indefinitely drip a request body, retaining a connection and handler."
expected = "Every exposed request must have a bounded body-read lifetime independently of the byte limit and the later signing protocol timeout."
proposal = "Set an API read deadline in services/wallet/attestor/internal/server/server.go or use per-request response-controller read deadlines before reading bodies. Preserve the separate longer TSS execution budget and prove a stalled body is closed within the configured bound."
owner_domain = 12
interface = "12.go-att-server-apitlsconfig"

[finding.12]
file = "services/wallet/attestor/internal/server/server.go"
line = 294
class = "runtime-risk"
severity = "medium"
observed = "lockKey permanently inserts a mutex for every keyID into keyLocks. EVM review, public identity and native signing can acquire a key lock before store lookup or owner authentication, so repeated nonexistent IDs from an admitted client grow this map for the process lifetime."
expected = "Rejected or unknown key identifiers must not create unbounded permanent process state, and concurrent operations for a valid key must still share one lock."
proposal = "Replace the permanent map in services/wallet/attestor/internal/server/server.go with reference-counted keyed locks that remove entries only when no holder or waiter remains, or bound locks to the approved inventory. Add coverage for many rejected IDs and simultaneous same-key requests."
owner_domain = 12

[finding.13]
file = "services/wallet/attestor/internal/policy/policy_test.go"
line = 1437
class = "test-gap"
severity = "low"
observed = "TestShippedPolicySponsoredFeeAndPaymasterDelegation calls PrecompileAddress(\"layerxcustody\") and ignores its false result. After retirement the returned address is zero, so the assertion named custody exercises delegation to zero rather than the retired 0x1013 address."
expected = "A regression concerning a retired address must use that exact address and separately prove it is absent from the active registry; ignoring lookup failure must not silently change the tested input."
proposal = "Use the explicit historical 0x0000000000000000000000000000000000001013 address in services/wallet/attestor/internal/policy/policy_test.go and assert PrecompileAddress reports it absent. Keep both the retirement and delegate refusal assertions meaningful."
owner_domain = 12
interface = "12.go-att-evm-precompile-address"

[finding.14]
file = "services/wallet/attestor/internal/policy/policy.go"
line = 761
class = "config-drift"
severity = "medium"
observed = "The perps.addCollateral spend is hardcoded to token 0x85FcD13735F4309833A503EE804ea32395851479. The actual perps executor obtains the collateral asset from governed Params.CollateralToken. A collateral-parameter change leaves attestor caps charging USDL while the executor handles a different asset."
