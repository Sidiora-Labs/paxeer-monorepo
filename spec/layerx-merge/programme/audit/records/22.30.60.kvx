[finding.001]
file = "modules/evm/client/cli/tx.go"
line = 494
class = "interface-mismatch"
severity = "high"
interface = "6.cli-evm-tx-call-precompile"
observed = "CmdCallPrecompile declares an outer valueBig initialized to zero, then shadows it with valueBig, success := inside the value branch; the transaction always carries zero even when --value is positive."
expected = "The registered call-precompile --value flag must become the exact payment in the transaction consumed by payable precompiles."
proposal = "In modules/evm/client/cli/tx.go assign the parsed payment to the transaction's value variable and prove a payable precompile call receives the requested amount through the command and node."
owner_domain = 6

[finding.002]
file = "modules/evm/client/cli/tx.go"
line = 643
class = "runtime-risk"
severity = "medium"
observed = "getNonce and getChainId assert resObj[\"result\"].(string) without checking JSON-RPC error, missing result or result type; a normal server error response panics the CLI."
expected = "RPC errors and malformed results must return actionable command errors without panicking or treating a failed lookup as transaction metadata."
proposal = "Decode a typed JSON-RPC response in modules/evm/client/cli/tx.go, propagate its error and check result type and hex encoding before signing; exercise actual error responses."
owner_domain = 6
interface = "7.rpc-eth-gettransactioncount"

[finding.003]
file = "modules/evm/client/cli/tx.go"
line = 630
class = "runtime-risk"
severity = "medium"
observed = "The association, nonce and chain-ID HTTP requests use http.DefaultClient without a deadline and io.ReadAll without a response bound; sendTx also uses context.Background and leaves ethClient open."
expected = "A command contacting a configured RPC endpoint must terminate on cancellation or a bounded timeout and bound response memory."
proposal = "Use the Cobra context with a finite timeout and capped response reads in modules/evm/client/cli/tx.go, close the ethclient and propagate cancellation through transaction submission."
owner_domain = 6
interface = "6.cli-evm-tx-associate-address"

[finding.004]
file = "modules/evm/client/cli/tx.go"
line = 239
class = "runtime-risk"
severity = "medium"
observed = "CmdDeployContract panics when the supplied binary cannot be read or its contents are not exact bare hexadecimal, losing the underlying error and command error contract."
