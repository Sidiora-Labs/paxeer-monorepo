[finding.startup-policy]
file = "services/interop/crates/layerx-bridge-relayer/src/main.rs"
line = 49
class = "restart-recovery"
severity = "high"
observed = "Before the first tick, main publishes Relayer::attestation_view from the reopened journal. Relayer::new initializes thresholds empty and attestation_view substitutes 1 for every historical chain at relayer.rs:594. A persisted item with one local signature is therefore advertised ready even when its destination requires three signatures; failed policy reads can leave that answer in place."
expected = "Requirements 11421.3 and 11423.1 require readiness to use the destination threshold. A restart must preserve a truthful attesting state until the destination policy has been authenticated; the bridge app stops its polling after a ready bundle."
proposal = "In services/interop/crates/layerx-bridge-relayer/src/relayer.rs and src/main.rs, publish unknown policy as attesting, remove the threshold-of-one substitution, and refresh the authenticated destination policy before declaring any replayed bundle ready. Add a real journal-reopen and HTTP-read regression with one stored signature and a threshold of three."
owner_domain = 11
interface = "11.rs-relayer-relayer-attestation-view-j48"

[finding.directional-policy]
file = "services/interop/crates/layerx-bridge-relayer/src/relayer.rs"
line = 1165
class = "interface-mismatch"
severity = "high"
observed = "attestor_policy stores native inbound and foreign-vault outbound thresholds in the same thresholds[chain_id] entry. Both observations use the foreign chain id, so the last policy read overwrites the other direction. attestation_view then exposes that shared value to both deposit_answer and release_answer; the Solana release policy also writes the same map."
expected = "Requirements 11421.3 and 11423.1 require each bundle to use its own destination threshold. The native mint and the external release vault are independent destinations and can have different thresholds for the same foreign chain."
proposal = "In services/interop/crates/layerx-bridge-relayer/src/relayer.rs and src/attestation_api.rs, key the authenticated policy by direction and destination identity, including vault or program, and select it from the observation. Exercise inbound threshold three and outbound threshold one in both loop orders and after restart."
owner_domain = 11
interface = "11.rs-relayer-attestation-view-j48"

[finding.bundle-membership]
file = "services/interop/crates/layerx-bridge-relayer/src/attestation_api.rs"
line = 262
class = "interface-mismatch"
severity = "high"
observed = "signatures recovers and deduplicates every local or collected signer, without testing membership in the current destination attestor set; status counts that entire list. AttestationView carries no membership set. A removed attestor can make a bundle ready, and its signature is returned even alongside enough current signatures. PaxeerXVault._verifyThreshold rejects every nonmember signature at contracts/bridge/evm/src/PaxeerXVault.sol:267."
expected = "Requirement 11421.3 counts distinct destination attestors. Both served bundle routes must return signatures that their destination consumer accepts; a stale signer must neither satisfy quorum nor poison an otherwise valid release bundle."
proposal = "Extend the policy snapshot in services/interop/crates/layerx-bridge-relayer/src/attestation_api.rs and src/relayer.rs with current authenticated membership and filter before counting and returning signatures, using the same eligibility rule as transaction assembly. Test rotation with old local and cosign signatures through the HTTP bundle and actual vault verification."
owner_domain = 11
interface = "11.http-relayer-v1-release-j48"

[finding.solana-caught-cpi]
file = "services/interop/crates/layerx-bridge-relayer/src/solana/observe.rs"
line = 354
class = "runtime-risk"
severity = "high"
observed = "transaction_findings treats every attempted custody deposit instruction in an outer-successful transaction as a completed call. solana/rpc.rs:220-241 flattens innerInstructions without invocation outcomes, and observe.rs:376 fetches the receipt account for each attempt. A caller can catch a failed deposit CPI, leaving no receipt while the outer transaction succeeds. The missing account returns Malformed and observe_deposits retries that same scan window indefinitely, blocking later valid deposits."
expected = "A failed custody invocation produces no locked deposit and must not block observation of successful deposits. The producer at contracts/bridge/solana/src/deposit.rs writes its receipt and deposit log only after its checks and token transfer succeed; outer transaction success does not prove every inner invocation succeeded."
proposal = "In services/interop/crates/layerx-bridge-relayer/src/solana/rpc.rs and src/solana/observe.rs, preserve invocation identity and successful completion, including successful ancestors, and correlate only committed custody calls with their logs and receipt accounts. Keep missing evidence for a successful deposit fail-closed. Use a real caller program that catches a failed CPI before a valid deposit, and prove progress and restart recovery."
owner_domain = 11
interface = "11.rs-relayer-observe-deposits"

[finding.solana-scan-budget]
file = "services/interop/crates/layerx-bridge-relayer/src/solana/observe.rs"
line = 428
class = "runtime-risk"
severity = "medium"
observed = "signatures_in starts at the newest signature for every requested slot window and follows every full page until it reaches from. max_slot_range bounds slots but neither the number of pages above to nor the number of transactions held in found. A relayer catching up from old history repeatedly traverses the entire newer history and can spend an unbounded tick on an increasingly busy custody program."
expected = "The runtime-risk check requires bounded work and memory for externally growing history. Catch-up must eventually advance without dropping a signature, even when the live history is much larger than the configured slot window."
proposal = "Add a persisted backfill continuation and per-pass page or transaction budget in services/interop/crates/layerx-bridge-relayer/src/solana/observe.rs and the journal. Persist the program identity, inclusive from/to slot bounds and before signature together, so restart resumes the fixed window rather than starting at the growing head. Advance its slot cursor only after complete coverage, and prove paginated catch-up and restart against producer history larger than the budget."
owner_domain = 11
interface = "11.rs-relayer-observe-deposits"

[finding.journal-growth]
file = "services/interop/crates/layerx-bridge-relayer/src/journal.rs"
line = 832
class = "runtime-risk"
severity = "medium"
observed = "Journal::append clones the complete State for every entry; State retains completed observations, signatures and submission bytes without a checkpoint or archival boundary. Journal::open replays the entire file, and Relayer::attestation_view clones all historical items and recollects their cosigns. Memory, append cost and startup time therefore grow with lifetime bridge volume rather than pending work."
expected = "The brief runtime and recovery checks require a bridge that remains operable over sustained network use. Durable replay protection, pending raw transactions and historical attestations must remain available without forcing every new append and tick to copy the entire lifetime history."
proposal = "Design crash-safe checkpoints and indexed historical storage in services/interop/crates/layerx-bridge-relayer/src/journal.rs, with bounded pending-state snapshots in src/relayer.rs. Preserve nullifier and idempotency history, exact pending transaction bytes and API lookup capability; prove equivalent replay after checkpoint replacement and interrupted archival."
owner_domain = 11

[finding.duplicate-quorum]
file = "services/interop/crates/layerx-bridge-relayer/src/rpc.rs"
line = 125
class = "security"
severity = "medium"
observed = "PaxeerRpc::new checks list size and chain ids but accepts repeated endpoint entries. request issues a call per entry and call counts each identical answer as an independent vote. Repeating one URL can therefore satisfy a configured multi-endpoint strict majority from a single backend; tests/paxeer_rpc.rs:210 explicitly accepts eight clones."
expected = "Requirement 11241.5 uses endpoint agreement to protect Paxeer reads, including burn observations. A configured quorum should not imply independent agreement when its votes are repeated aliases of one endpoint; the mirror RpcCluster already validates independent endpoint identities."
proposal = "In services/interop/crates/layerx-bridge-relayer/src/rpc.rs and src/config.rs, reject duplicate normalized authorities and require explicit independent-backend identities for a multi-endpoint quorum. Retain deliberately configured single-endpoint operation as such, and test duplicate URLs and backend aliases without claiming extra votes."
owner_domain = 11
interface = "11.rs-relayer-paxeer-rpc-new"

[finding.evidence-identity]
file = "services/interop/crates/layerx-interop-gateway/src/gateway.rs"
line = 583
class = "security"
severity = "medium"
observed = "settle_with_sequencer_evidence verifies the receipt signature, logs and paymentReference but never compares evidence.transaction_hash with the authenticated receipt protocol activity_id. Changing that declared evidence identity leaves settlement unchanged. The receipt convenience method derives the identity correctly, and the inspected AP2 and x402 callers perform their own checks, so this is a weakness of the public core boundary rather than demonstrated theft through those callers."
expected = "The SequencerEvidence boundary must describe one transaction consistently across producer, transport and settlement consumer. Receipt authentication should bind the declared transaction identity inside GatewayCore so every caller receives the same refusal semantics."
proposal = "In services/interop/crates/layerx-interop-gateway/src/gateway.rs, compare the evidence hash with the verified protocol receipt activity_id before recording settlement, return a traced receipt rejection on mismatch and leave the translation pending. Add a mutation test that changes only transaction_hash on genuine signed evidence."
owner_domain = 11
interface = "11.rs-gw-gateway-core-settle-with-sequencer-evidence-j47"

[finding.receipt-key-contract]
file = "services/interop/crates/layerx-bridge-relayer/src/config.rs"
line = 118
class = "interface-mismatch"
severity = "high"
observed = "The served registry row 11.cfg-relayer-receipt-keys declares entries with key_id, and spec/layerx-merge/contracts/interop-bridge-relayer.md:571 repeats that shape. ReceiptKeyConfig denies unknown fields and requires sequencer_id instead. A configuration produced from the declared contract is rejected at startup; the code agrees with requirement 11242.2."
expected = "The declared receipt-key producer shape and the strict configuration consumer must round-trip. Requirement 11242.2 defines the canonical fields as sequencer_id, public_key, first_height and last_height, with validated authorization windows."
proposal = "Correct 11.cfg-relayer-receipt-keys in spec/layerx-merge/interfaces.kvx and its source contract generation inputs to use sequencer_id, then regenerate spec/layerx-merge/contracts/interop-bridge-relayer.md. Prove the published configuration example loads through RelayerConfig::load without adding a permissive alias or weakening unknown-field validation."
owner_domain = 11
interface = "11.cfg-relayer-receipt-keys"

[finding.rpc-constructor-contract]
file = "services/interop/crates/layerx-bridge-relayer/src/rpc.rs"
line = 121
class = "interface-mismatch"
severity = "high"
observed = "Registry row 11.rs-relayer-paxeer-rpc-new and its frozen contract declare new(Vec<EndpointConfig>), while the public constructor accepts Vec<PaxeerEndpoint>. The EndpointConfig comes from the retired verifier transport and is not accepted by the current implementation; callers built from the published signature cannot construct the relayer RPC."
expected = "The public Rust interface declaration must name the actual authenticated transport type. Requirement 11244.1 removes the verifier transport dependency, and the constructor contract must expose the replacement PaxeerEndpoint type consistently."
proposal = "Update 11.rs-relayer-paxeer-rpc-new in spec/layerx-merge/interfaces.kvx and regenerate spec/layerx-merge/contracts/interop-bridge-relayer.md with Vec<PaxeerEndpoint>. Include a small compiling consumer of the published constructor and preserve the current pinned-TLS and chain-id checks."
owner_domain = 11
interface = "11.rs-relayer-paxeer-rpc-new"

[finding.receipt-error-contract]
file = "services/interop/crates/layerx-bridge-relayer/src/receipt.rs"
line = 202
class = "interface-mismatch"
severity = "high"
observed = "The served rows 11.rs-relayer-sequencer-receipt-decode-j48 and 11.rs-relayer-sequencer-receipt-verify-j48 declare Result values with RpcFault, but decode and verify return ReceiptError. The contract page spec/layerx-merge/contracts/interop.md:22-24 repeats RpcFault. A consumer written against that result type or its error cases does not compile against the implementation."
expected = "Declared receipt decoding and verification must expose the same error type and refusal categories that the consumer receives. ReceiptError distinguishes malformed data, signature verification, signed-view mismatch and log refusal and must remain visible in the contract."
proposal = "Correct both served rows in spec/layerx-merge/interfaces.kvx and regenerate spec/layerx-merge/contracts/interop.md to publish ReceiptError and its cases. Prove a public consumer handles an authentic receipt and the real malformed, mismatch and verification errors without erasing their distinctions."
owner_domain = 11
interface = "11.rs-relayer-sequencer-receipt-decode-j48"

[finding.paxeer-transport-contract]
file = "services/interop/crates/layerx-bridge-relayer/src/transport.rs"
line = 13
class = "interface-mismatch"
severity = "high"
observed = "Served row 11.rs-relayer-paxeer-endpoint-j48 declares trust_anchor and local_emulator fields, but PaxeerEndpoint has trust_anchor_der and expected_chain_id and no local_emulator field. The related call row declares an instance method although PaxeerTransport::call takes endpoint as an explicit argument. The transport-fault row also names Timeout and Malformed variants absent from the real enum and omits its structured refusal cases."
expected = "Published transport construction, call signatures and errors must match the Rust producer and consumer. Requirement 11242.1 requires endpoints to carry chain id, timeout and trust-anchor bytes; local_emulator is a constructor validation input rather than a stored public field."
proposal = "Reconcile 11.rs-relayer-paxeer-endpoint-j48, 11.rs-relayer-paxeer-transport-call-j48 and 11.rs-relayer-transport-fault-j48 in spec/layerx-merge/interfaces.kvx with src/transport.rs, then regenerate spec/layerx-merge/contracts/interop.md. Compile a contract example that constructs the endpoint, calls the associated transport function and matches actual structured errors."
owner_domain = 11
interface = "11.rs-relayer-paxeer-endpoint-j48"

[finding.attestation-policy-coverage]
file = "services/interop/crates/layerx-bridge-relayer/tests/attestation_api.rs"
line = 218
class = "test-gap"
severity = "medium"
observed = "deposit_status_follows_the_collected_signatures builds AttestationView directly with a manually assigned threshold and counts all recoverable signatures. It cannot express destination membership, and the tests do not drive a reopened relayer with different inbound and outbound thresholds into the HTTP server. These fixtures therefore miss the startup, direction and membership failures recorded in this audit."
expected = "Requirements 11421.3 and 11423.1 and the brief path-proof check require readiness evidence from the actual policy producer through the snapshot and served bundle, including replay and attestor rotation."
proposal = "Extend services/interop/crates/layerx-bridge-relayer/tests/attestation_api.rs and tests/attestation_server.rs with genuine destination policy changes and journal restart, then read the actual HTTP bundle. Assert that one of three signatures stays attesting, opposite-direction policy reads cannot change it, and removed members never enter a ready bundle."
owner_domain = 11

[finding.quorum-coverage]
file = "services/interop/crates/layerx-bridge-relayer/tests/paxeer_rpc.rs"
line = 210
class = "test-gap"
severity = "medium"
observed = "paxeer_rpc_refuses_mixed_chain_ids_and_more_than_eight_endpoints explicitly asserts that eight copies of the same endpoint are accepted. It checks cardinality and chain identity but blesses the duplicate-vote configuration that defeats independent quorum agreement."
expected = "Quorum qualification must distinguish repeated configuration entries from independently authenticated backends; an accepted eight-entry list must not silently stand for one backend when operators intend multiple votes."
proposal = "After defining endpoint independence in services/interop/crates/layerx-bridge-relayer/src/rpc.rs, update tests/paxeer_rpc.rs to assert duplicate and alias refusal and demonstrate that divergent independent backends cannot be outvoted by cloning one entry. Keep the existing mixed-chain and size bounds intact."
owner_domain = 11

[finding.evidence-identity-coverage]
file = "services/interop/crates/layerx-interop-gateway/tests/proof_gateway_sequencer_evidence.rs"
line = 197
class = "test-gap"
severity = "medium"
observed = "The proof test asserts receipt.protocol().activity_id equals evidence.transaction_hash before invoking GatewayCore. That proves the positive producer case but does not test whether the consumer rejects a changed transaction_hash; the current consumer accepts that mutation because it ignores the field."
expected = "The real producer-to-consumer proof must cover refusal when the transport identity disagrees with the authenticated receipt, leaving both translation state and audit history unchanged."
proposal = "Add a negative case to services/interop/crates/layerx-interop-gateway/tests/proof_gateway_sequencer_evidence.rs that retains the genuine receipt and logs, mutates only transaction_hash, invokes settle_with_sequencer_evidence and asserts a traced refusal with pending state and no completion audit entry."
owner_domain = 11

[finding.capture-prerequisite]
file = "services/interop/crates/layerx-bridge-relayer/tests/outbound_isolation.rs"
line = 746
class = "test-gap"
severity = "medium"
observed = "outbound_isolation_captured_production_boundaries unconditionally calls Corpus::load. load returns an error when LAYERX_BRIDGE_CAPTURE_MANIFEST or its independent SHA256 pin is absent at lines 198-203. Consequently the source path fails an ordinary no-environment cargo test instead of producing the prerequisite disposition required by 22022.1; no Rust test execution is claimed by this audit."
expected = "Requirement 22022.1 says the relayer suite with no environment inputs must pass or print a reason naming a missing prerequisite. The production-boundary qualification must still require genuine, independently pinned capture artifacts and must never be reported as proved without them."
proposal = "In services/interop/crates/layerx-bridge-relayer/tests/outbound_isolation.rs and its owning qualification job, separate explicit missing-prerequisite reporting for the no-input suite from the mandatory captured-boundary gate. Provision and pin the genuine corpus in that gate, retaining every scenario assertion and failing qualification when required artifacts are absent."
owner_domain = 11

