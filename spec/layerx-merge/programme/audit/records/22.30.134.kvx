observed = "getFromCookieString splits on name= anywhere in the header instead of matching a cookie-name boundary. A cookie such as other_app_profile=private can be read as app_profile, making SSR privacy/CSP selection differ from the browser exact-name lookup."
expected = "Cookie names are exact semicolon-delimited tokens. Server rendering and browser behavior must select the same application profile from the same cookie header."
proposal = "Parse exact cookie name/value pairs in apps/explorer/lib/cookies.ts, preserve values containing equals signs, and use a deliberate duplicate-name policy. Verify prefixed names, missing names and exact app_profile selection."
owner_domain = 14

