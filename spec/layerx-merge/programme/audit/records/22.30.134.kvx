[finding.chain_api_upstream]
file = "apps/explorer/lib/api/resources.ts"
line = 54
class = "wiring-gap"
severity = "high"
observed = "The five paxeer_x_chain resources use general, which getResourceParams resolves to config.apis.general, the Blockscout backend. Their /v1/chains paths are implemented only by services/platform/hosted/indexer/src/api.rs:541-609. The Blockscout router and gateway explorer_proxy ROUTES have no such routes; both the direct backend and /explorer/backend path therefore lack this read path."
expected = "Requirement 20007.1 requires the chain directory, detail, summary and recent activity to be reachable from the explorer, with tenant identity preserved from the indexer through the public transport."
proposal = "Give the chain resources an explicitly configured indexer-backed API in apps/explorer/lib/api/resources.ts and configs/app/apis.ts; domain 8 must expose a bounded public gateway route to the real indexer. Register that interface and prove directory, detail, feeds, unknown-chain errors and cursor recovery through that route."
