[finding.env-anchor-substring]
file = "services/explorer/services/libs/env-collector/src/lib.rs"
line = 273
class = "runtime-risk"
severity = "medium"
observed = "from_markdown finds anchors by substring and update_markdown uses line.contains. With no postfix, anchors.envs.start also matches anchors.envs.start.other before the intended unqualified section; the supplied fixture already demonstrates multiple suffixed sections. Selecting the wrong pair can validate or overwrite another environment table."
expected = "An environment-table update must select the exact requested anchor pair and preserve every other documentation section."
proposal = "In services/explorer/services/libs/env-collector/src/lib.rs, parse exact full anchor markers with the requested postfix, require a unique ordered pair, and exercise unqualified anchors following a different suffixed table through both validation and update."
owner_domain = 14

[finding.env-anchor-order-panic]
file = "services/explorer/services/libs/env-collector/src/lib.rs"
line = 281
class = "runtime-risk"
severity = "medium"
observed = "from_markdown subtracts one from the first end-anchor offset and slices line_start..=line_end without checking order. A README with the end marker before the start marker causes an invalid string range panic instead of the Result error promised by the API."
expected = "Malformed documentation anchors should produce a contextual validation error before slicing or writing the file."
proposal = "In services/explorer/services/libs/env-collector/src/lib.rs, validate start and end marker order and UTF-8 slice boundaries before extracting the table, return an anyhow error on malformed input, and ensure update_markdown applies the same validation without writing on error."
