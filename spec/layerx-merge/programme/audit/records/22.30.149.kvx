lines = 129
verdict = "clean"
note = "Read in full: environment settings serialization, prefix filtering, builder/CLI options, Markdown table parsing and generation, and embedded tests were compared with the library README and actual public entry points."

[finding.missing-range-crash-loss]
file = "services/explorer/backend/apps/explorer/lib/explorer/utility/missing_block_range.ex"
line = 570
class = "restart-recovery"
severity = "high"
observed = "sanitize_missing_block_ranges calls delete_intersecting_ranges, which commits Repo.delete_all at line 605, before save_batch reinserts the merged ranges at line 578. Explorer.Migrator.SanitizeMissingBlockRanges invokes this during indexer startup without an enclosing transaction. A crash between these operations permanently removes outstanding missing-block work."
expected = "Missing-block repair work must remain durable across migration failures and restarts; resuming a started migration must recover every range that existed before the interrupted attempt."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/utility/missing_block_range.ex, lock and merge the affected rows inside one Repo.transaction, check every insert result and roll back on failure. Add a recovery test that interrupts replacement after deletion and proves all missing heights remain queued after restart."
owner_domain = 14

[finding.missing-range-allocation]
file = "services/explorer/backend/apps/explorer/lib/explorer/utility/missing_block_range.ex"
line = 450
class = "runtime-risk"
severity = "medium"
observed = "fill_ranges_between materializes every block number in the full historical interval into a list and MapSet whenever a priority range intersects it, then materializes each priority interval again. A large catch-up gap consumes memory proportional to the number of missing heights rather than the number of ranges."
expected = "Catch-up range maintenance must operate within bounded memory even when a newly started indexer is millions of blocks behind."
proposal = "Replace the per-height MapSet subtraction in services/explorer/backend/apps/explorer/lib/explorer/utility/missing_block_range.ex with sorted interval subtraction; preserve priority boundaries and add a large-gap case whose number of stored intervals stays bounded."
owner_domain = 14

[finding.rate-limit-expiry-process]
file = "services/explorer/backend/apps/explorer/lib/explorer/utility/rate_limiter.ex"
line = 147
class = "runtime-risk"
severity = "medium"
observed = "The ETS branch schedules Process.send_after(self(), {:delete, key}, expire_after). check_rate runs in the requesting process, while the deletion handler belongs to the RateLimiter GenServer. An ordinary web request exits with its timer and the named ETS entry remains, retaining ban history and accumulating identifiers."
expected = "The on_demand limitation_period in registry row 14.cfg-explorer-explorer-utility-ratelimiter must expire ban history regardless of the lifetime of the calling request."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/utility/rate_limiter.ex, make the owning GenServer schedule expiry or store deadlines and sweep them there. Protect newer entries from older timers and test expiry after the calling process exits."
owner_domain = 14
interface = "14.cfg-explorer-explorer-utility-ratelimiter"

[finding.metadata-redirect-filter-bypass]
file = "services/explorer/backend/apps/explorer/lib/explorer/token/metadata_retriever.ex"
line = 855
class = "security"
severity = "medium"
observed = "fetch_metadata_from_uri validates only the initial URI with MetadataURIValidator, then passes follow_redirect: true to Explorer.HttpClient. The configured Tesla adapter installs Tesla.Middleware.FollowRedirects without reapplying that validator; a public metadata host can redirect an indexer request to a blacklisted private or link-local address."
expected = "The host_filtering_enabled? and cidr_blacklist policy in registry row 14.cfg-indexer-indexer-fetcher-tokeninstance-helper must cover every destination contacted for untrusted token metadata, including redirects."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/token/metadata_retriever.ex, follow a bounded number of redirects explicitly and validate each target before connecting; enforce the destination policy on resolved connection addresses as well. Exercise a public-to-private redirect through the actual HTTP adapter."
owner_domain = 14
interface = "14.cfg-indexer-indexer-fetcher-tokeninstance-helper"

[finding.metadata-subscribe-race]
file = "apps/explorer/ui/tokenInstance/TokenInstanceMetadataFetcher.tsx"
line = 63
class = "runtime-risk"
severity = "medium"
observed = "initializeUpdate awaits the PATCH response before entering WAITING_FOR_RESPONSE, and useSocketChannel is disabled until that state. The controller casts work to TokenInstanceMetadataRefetch before returning HTTP 200; a fast fetched_token_instance_metadata broadcast can therefore occur before the browser joins token_instances:<hash>, after which the UI only times out."
expected = "The refresh lifecycle for 14.ws-explorer-push-token-instances-hash-fetched-token-instance-metadata must show a completed refresh even when the worker finishes before the PATCH response or the socket reconnects."
proposal = "In apps/explorer/ui/tokenInstance/TokenInstanceMetadataFetcher.tsx, join and acknowledge the channel before sending PATCH, then reconcile the canonical token-instance GET on timeout or reconnect. Cover completion before the HTTP response and reconnect after completion through the real producer and consumer."
owner_domain = 14
interface = "14.ws-explorer-push-token-instances-hash-fetched-token-instance-metadata"

[finding.metadata-failure-event-unhandled]
file = "apps/explorer/ui/tokenInstance/TokenInstanceMetadataFetcher.tsx"
line = 134
class = "wiring-gap"
severity = "medium"
observed = "The frontend subscribes only to fetched_token_instance_metadata. The same worker publishes not_fetched_token_instance_metadata with reason retry_cooldown or error, and notifier.ex forwards that event on the joined topic. These terminal responses leave the UI waiting for the full two-minute timeout and conceal the actionable cooldown reason."
expected = "Every terminal response in the token-instance refresh lifecycle should leave the waiting state and explain whether the user must wait or retry."
proposal = "Add the not_fetched_token_instance_metadata handler in apps/explorer/ui/tokenInstance/TokenInstanceMetadataFetcher.tsx, filter it by token_id, clear the timeout, and surface the documented reason. Extend lib/socket/types.ts with the producer payload and exercise both cooldown and fetch failure."
owner_domain = 14
interface = "14.ws-explorer-push-token-instances-hash-not-fetched-token-instance-metadata"

[finding.metadata-refresh-media-shape]
file = "apps/explorer/ui/tokenInstance/TokenInstanceMetadataFetcher.tsx"
line = 104
class = "runtime-risk"
severity = "medium"
observed = "The refresh handler overwrites image_url and animation_url with raw metadata strings, preferring image before image_url. The normal TokenView.prepare_token_instance path uses NFTHelper, which prefers image_url, handles map/list image forms and converts ipfs:// and ar:// values to gateway URLs. The same persisted NFT can display differently or lose its image immediately after refresh."
