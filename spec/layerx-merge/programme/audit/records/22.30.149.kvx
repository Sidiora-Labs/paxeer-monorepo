proposal = "In apps/explorer/ui/tokenInstance/TokenInstanceMetadataFetcher.tsx, invalidate and fetch the canonical token_instance resource after completion, or consume a backend-rendered instance payload rather than reconstructing media fields from raw metadata. Cover IPFS URLs, image_url precedence and map/list images."
owner_domain = 14
interface = "14.ws-explorer-push-token-instances-hash-fetched-token-instance-metadata"

[finding.token-market-cap-unknown-decimals]
file = "apps/explorer/ui/tokens/TokensTableItem.tsx"
line = 40
class = "runtime-risk"
severity = "medium"
observed = "getOnchainMarketCap treats nullable decimals as zero through Number(decimals) || 0. TokenInfo explicitly permits null, and MetadataRetriever.limit_decimals can produce nil while total_supply and exchange_rate remain present, so the UI publishes an unscaled market capitalization as if token precision were known."
