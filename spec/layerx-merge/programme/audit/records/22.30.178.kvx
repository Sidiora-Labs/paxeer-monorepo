[finding.59]
file = "scripts/wallet/gate-lint.sh"
line = 49
class = "test-gap"
severity = "medium"
observed = "GOFMT_CMD tests only captured stdout and does not propagate a failing gofmt exit; it runs in bash -c without errexit, so a parse error with no listed filenames can pass the formatting target."
expected = "A formatting target must fail when its formatter fails to parse or inspect any required Go source, as well as when files need formatting."
proposal = "In scripts/wallet/gate-lint.sh check the gofmt invocation exit explicitly before examining its output and preserve stderr in the target log; exercise a malformed Go input as a failing gate case."
owner_domain = 16
interface = "16.cli-scr-wallet-gate-lint"

[finding.60]
file = "scripts/wallet/scan-secrets.sh"
line = 103
class = "security"
severity = "medium"
observed = "The scanner suppresses grep stderr and unconditionally ignores xargs/grep failures, treating unreadable inputs or scanning errors as a clean scan when no matches are produced."
expected = "A clean secret-scan result must mean every selected file was inspected successfully; no-match and incomplete-scan outcomes must remain distinct."
proposal = "In scripts/wallet/scan-secrets.sh preserve scanning errors, distinguish grep no-match from error statuses and fail with affected paths whenever any selected file could not be inspected."
owner_domain = 16
interface = "16.cli-scr-wallet-scan-secrets"

