[finding.export_capability]
file = "services/launchpad/gateway/internal/proxy/connected.go"
line = 252
class = "interface-mismatch"
severity = "high"
observed = "The connected request header allowlist drops X-Export-Authorization. The real user account DownloadHandler requires its 64-character capability at user/internal/account/jobs_http.go:247, so valid owner export downloads are denied."
expected = "The declared export download route must carry the owner session and single-use export capability to the user authority without changing either credential."
proposal = "In gateway/internal/proxy, forward one bounded X-Export-Authorization only for export downloads, reject ambiguous values, and prove actual export creation, capability redemption and replay refusal through the gateway."
owner_domain = 4
interface = "4.http-gateway-proxy-user-get-v2-me-exports-job-id-download"

[finding.deletion_receipt]
file = "services/launchpad/gateway/internal/proxy/connected.go"
line = 357
class = "interface-mismatch"
severity = "high"
observed = "The response allowlist copies only ETag and Retry-After. It discards X-Recovery-Receipt emitted by user/internal/account/jobs_http.go:231 after accepting deletion, leaving the client without its recovery credential."
expected = "Account deletion must return the authority-issued recovery receipt so progress remains available after deletion revokes the normal session."
proposal = "In gateway/internal/proxy, forward a validated bounded receipt on successful deletion responses and prove receipt capture, session revocation, restart and recovery against the real user authority."
owner_domain = 4
