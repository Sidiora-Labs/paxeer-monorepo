[finding.f001]
file = "apps/perps/sentry.client.config.ts"
line = 48
class = "security"
severity = "medium"
observed = "beforeSend only redacts event.message and exception values; redactSecrets does not match 0x-prefixed private keys or wallet addresses, and request, breadcrumbs and extra data pass through unchanged."
expected = "Error reporting must not send wallet identifiers, secret keys or seed phrases to third parties; sendDefaultPii false does not sanitize explicit event data."
proposal = "Apply the shared structured redactor to the entire Sentry event in apps/perps/sentry.client.config.ts and verify prefixed keys, addresses and nested request and breadcrumb fields are removed."
owner_domain = 3

