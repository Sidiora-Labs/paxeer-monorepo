[file.001]
path = "apps/perps/data_api.md"
lines = 675
verdict = "issues"
note = "Read in full. The /perp_stats and perp_stats topic examples still advertise est_funding_rate, volume_24h and open_interest as the funding and notional contract. The current client expects exact funding_rate strings and volume_24h_usd, and records.PerpStats exposes last_funding_rate_hourly instead."

[file.002]
path = "apps/perps/sentry.client.config.ts"
lines = 79
verdict = "issues"
note = "Read in full. beforeSend only redacts event.message and exception values; redactSecrets does not match 0x-prefixed private keys or wallet addresses, and request, breadcrumbs and extra data pass through unchanged."
consumes = ["12.env-gw-node-env"]

