[file.050]
path = "apps/perps/src/pages/api/candle/[...path].ts"
lines = 250
verdict = "issues"
note = "Read in full. clientIp trusts the first caller-controlled x-forwarded-for element; ipBuckets only removes expired entries after 5000 and admits unlimited fresh keys inside the current minute. GET and HEAD are allowed, but the HEAD fetch response is passed to upstreamRes.json whenever its content-type is JSON; HEAD has no body and decoding throws, returning 502 for a healthy upstream."
produces = ["3.env-perps-market-proxy-host", "3.http-perps-get-head-api-candle-path", "3.ts-perps-pages-api-candle-path-parsemarketproxyorigin"]
consumes = ["11.err-gas-timeout", "3.env-perps-market-proxy-origin", "8.cfg-ramp-reference-config-quotes", "8.cfg-ramp-toolkit-sourcesettlementconfig-quotes", "8.cfg-ramps-quotes"]

[file.051]
path = "apps/perps/src/pages/api/presence.ts"
lines = 182
verdict = "issues"
note = "Read in full. computeSnapshot uses history.find for slots at least five minutes old; history is oldest first, so a full twelve-slot window compares against the oldest slot rather than the five-minute baseline. POST /api/presence accepts arbitrary caller-chosen sessionId values without rate limiting; a caller can fill MAX_SESSIONS, evict live visitors and fabricate market popularity."
produces = ["3.http-perps-get-post-api-presence"]

