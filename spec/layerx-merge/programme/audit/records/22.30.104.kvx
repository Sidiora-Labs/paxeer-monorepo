[finding.refresh_context]
file = "services/human/crates/layerx-human-service/src/server/backend.rs"
line = 865
class = "interface-mismatch"
severity = "high"
observed = "component_protocol.rs:428-429 emits refresh_token and refresh_csrf from authorization, but parse_authorized preserves only assertion and did. UnixComponents::execute at line 673 also omits both refresh fields. component.rs accepts the pair, while production_components.rs:4864 requires refresh_credentials, so the real Unix component path loses credentials before session refresh."
expected = "Registry 10.fmt-human-component-protocol and 10.http-human-session-refresh require the authorized refresh pair to reach the refresh consumer with request, tenant and destination binding intact."
proposal = "In services/human/crates/layerx-human-service/src/server/backend.rs carry both refresh secrets through authorization parsing and execute serialization using existing bounds and zeroization. Prove browser HTTP through UnixComponents and HumanComponentServer into real session refresh, including replay refusal and restart."
owner_domain = 10
interface = "10.fmt-human-component-protocol"

[finding.balance_material_rank]
file = "services/human/crates/layerx-human-service/src/server/production_reads.rs"
line = 883
class = "interface-mismatch"
severity = "high"
observed = "cached_balance_verification reads LXHB1 byte 5 as legacy ranks 1 through 5. AccountBalance::evidence_material in production_components.rs:227 writes Rung ranks 0, 1 or 2 and omits the byte for None. A committed balance is exported as receipt-verified, a submitted balance is refused, and an absent rung is parsed from the timestamp-length prefix."
expected = "Registry 10.http-human-evidence-get and account.balance require the same achieved rung and evidence provenance across production, persisted cache and export. Committed is rank 2 and absent verification must remain explicitly unverified."
proposal = "In services/human/crates/layerx-human-service/src/server/production_reads.rs and production_components.rs define a versioned balance-material envelope with an explicit presence marker and Rung decoder. Handle legacy persisted material by version, preserve the achieved label and exercise genuine production material before and after store reopen."
owner_domain = 10
interface = "10.http-human-evidence-get"

[finding.balance_fixture]
file = "services/human/crates/layerx-human-service/src/server/production_reads.rs"
line = 1005
class = "test-gap"
severity = "medium"
observed = "cached_balance_preserves_achieved_level_and_authenticates_the_label fabricates LXHB1 records with ranks 1 through 5 and arbitrary trailing bytes. It expects rank 2 to mean receipt-verified and rank 5 to mean settlement-anchored, unlike AccountBalance::evidence_material, which produces only Rung ranks 0, 1, 2 or no rank byte."
expected = "Brief check 7 and requirements 10023.1-3 and 10024.4 require fixtures to reflect the actual producer and the achieved rung to survive authenticated cache retrieval without retired settlement labels."
proposal = "In services/human/crates/layerx-human-service/src/server/production_reads.rs use AccountBalance::evidence_material outputs for every rung and the unverified case. Assert identical labels through persistence, reopen and HTTP evidence retrieval while preserving the tampering checks."
owner_domain = 10

[finding.stepup_timestamp]
file = "services/human/crates/layerx-human-service/src/server/identity_dispatch.rs"
line = 344
class = "interface-mismatch"
severity = "high"
observed = "step_up_challenge serializes expires_at as an integer; step_up_evidence serializes completed_at and expires_at as integers. Production stepup.begin and stepup.finish call these helpers, and http.rs:593 rejects their successful results through ApiSchema::encode_response."
expected = "Registry 10.http-human-stepup-begin and stepup.finish use StepUpChallenge and StepUpEvidence. identity.kvx:257,264 declares Timestamp fields; v1.kvx defines Timestamp as an RFC3339 UTC JSON string."
proposal = "In services/human/crates/layerx-human-service/src/server/identity_dispatch.rs project step-up times through the checked RFC3339 conversion already used by identity_services.rs. Prove a real provider ceremony through production dispatch and HTTP validation, retaining expiry and confirmation binding."
owner_domain = 10
interface = "10.http-human-stepup-begin"

[finding.onboarding_journey_shape]
file = "services/human/crates/layerx-human-service/src/server/identity_dispatch.rs"
line = 355
class = "interface-mismatch"
severity = "high"
observed = "onboarding_status omits journey_id, state_copy_key, evidence, started_at and updated_at, while adding account_active. Stages use stage rather than stage_id and omit copy_key; queued, local-complete and complete are outside JourneyState and custody-key is outside EvidenceClass. Account creation and onboarding status/resume dispatch this result."
expected = "Registry 10.http-human-onboarding-status, account.create and onboarding.resume require canonical Journey or OnboardingJourney responses from identity.kvx and journeys.kvx, including stable identity, declared stages, truthful evidence and RFC3339 times."
proposal = "In services/human/crates/layerx-human-service/src/server/identity_dispatch.rs and its production callers project the persisted onboarding journey with canonical identifiers, enums, evidence and timestamps. Prove account creation, status and post-reopen resume through strict response validation without presenting local completion as protocol finality."
owner_domain = 10
interface = "10.http-human-onboarding-status"

[finding.security_timestamps]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 2484
class = "interface-mismatch"
severity = "high"
observed = "authenticator_method_json emits numeric enabled_at and last_used_at; timed_secret_json at line 2514 emits numeric remask_at. Setup, backup-code rotation and key export similarly emit numeric expiry, remask and self_custodied_at values. Strict HTTP validation rejects the result after a provider or custody operation may already have changed security state."
expected = "Registry 10.fmt-human-api-type-timed-secret and authenticator-method declare RFC3339 Timestamp fields, as do AuthenticatorSetupChallenge, BackupCodeSet and ExportedKey. Successful security mutations must return schema-valid browser results."
proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs consistently project every security timestamp with checked RFC3339 conversion, including optional method times and secret wrappers. Prove real provider setup, backup rotation and key export through HTTP validation and retry after committed mutation."
owner_domain = 10
interface = "10.fmt-human-api-type-timed-secret"

[finding.passkey_timestamps]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 6575
class = "interface-mismatch"
severity = "high"
observed = "bootstrap_passkey_assert_begin returns the u64 challenge.expires_at directly and bootstrap_passkey_assert_finish returns numeric completed_at and expires_at. Registration begin uses the same numeric-expiry projection. HTTP response validation rejects these results before the browser can complete the declared authentication flow."
