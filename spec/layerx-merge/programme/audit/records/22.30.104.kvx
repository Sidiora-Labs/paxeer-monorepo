proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs use canonical entry/filter projectors, omit absent optional fields and align exhausted-cursor representation with the shared schema and consumers. Prove empty, filtered and multi-page real feeds through HTTP and continuation after reopen."
owner_domain = 10
interface = "10.http-human-activity-query"

