line = 239
class = "runtime-risk"
severity = "medium"
observed = "AuthDiscoveryIndex::bind and issue clone and rewrite the complete discovery/capability maps. Expired registrations, assertions, step-ups and session discoveries are never removed; abandoned capabilities also remain after expiry because expired consume returns before removal. Reopening reloads all retained entries."
expected = "The registered auth-discovery index is a long-running authentication boundary. Expiring transient identifiers must not make every login progressively more expensive or grow durable state without a retention policy."
proposal = "In services/human/crates/layerx-human-service/src/server/production_auth.rs compact expired transient discoveries and abandoned capabilities under bounded retention, preserving durable account bindings and replay refusal. Apply safe admission limits with atomic persistence and prove retained authentication/replay behavior after reopen."
owner_domain = 10
interface = "10.rs-human-service-server-production-auth-auth-discovery-index"

[finding.identity_field_allocation]
file = "services/human/crates/layerx-human-service/src/server/identity_dispatch.rs"
line = 426
class = "runtime-risk"
severity = "medium"
observed = "decode_provider_response trusts a u32 field count and calls Vec::with_capacity before proving the frame contains the four-byte length prefixes. A ten-byte successful LXIP reply can request billions of Vec entries, causing allocation failure despite a bounded provider frame."
expected = "Registry 10.rs-human-service-server-identity-dispatch-remote-identity-provider and brief check 4 require malformed configured-provider responses to remain within resource bounds before allocation."
proposal = "In services/human/crates/layerx-human-service/src/server/identity_dispatch.rs bound field count by remaining frame bytes and operation arity before allocation. Preserve checked lengths and UTF-8 validation; exercise maximal counts, short frames, overlong fields and trailing data through the actual provider transport."
owner_domain = 10
interface = "10.rs-human-service-server-identity-dispatch-remote-identity-provider"

[finding.protocol_selection_ignored]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 448
class = "config-drift"
severity = "medium"
observed = "ProductionComponentsConfig::from_environment always calls selected_custody_protocol(None, attestor_configured), never reading LAYERX_HUMAN_PROTOCOL_VERSION. Helper tests exercise explicit values, but real non-attestor startup selects protocol 2 despite configured 3, and attestor startup ignores an invalid configured value."
expected = "Registry 10.env-layerx-human-protocol-version declares a read configuration input, while merged owner signing requires protocol 3. Deployment settings and invalid configuration must affect the actual environment loader."
proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs either read and validate supported merged protocol configuration at startup or explicitly retire the variable across registry/deployment contracts while enforcing protocol 3. Exercise the real environment loader with valid, absent and invalid values."
owner_domain = 10
interface = "10.env-layerx-human-protocol-version"

[finding.defund_replay_stuck]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 8731
class = "restart-recovery"
severity = "high"
observed = "submit_budget_defund persists signed bytes before sending, then always calls send_raw_transaction and maps every error to upstream-degraded before receipt lookup. After an accepted broadcast with a lost reply or restart, the node may return -32000 same nonce already receipted or held. advance_evm_intent at line 8844 handles that duplicate response, but reclaim/archive defund never reaches its committed receipt."
expected = "Registry 10.http-human-agent-reclaim and agent.archive require retained fund-disposition transactions to converge after ambiguous submission and restart without moving funds twice or permanently hiding completed reclaim."
proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs reconcile retained transaction hash/exact signed bytes against receipts before resending; continue receipt resolution for an authenticated matching duplicate. Prove crashes before send, after accepted send and before receipt persistence for reclaim and archive."
owner_domain = 10
interface = "10.http-human-agent-reclaim"

[finding.attestor_send_lifetime_ceiling]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 7505
class = "runtime-risk"
severity = "medium"
observed = "AttestorKms::sign_send_now stores every distinct signed send in inner.sends and refuses new requests at ATTESTOR_SEND_CACHE_LIMIT 4096. No completion or removal path exists in this implementation, so 4096 successful sends over the process lifetime disable unrelated new transfers until restart."
expected = "The production attestor boundary must bound replay state while continuing to serve user transfers over a long-running process. Cache capacity must govern retained work rather than impose a permanent lifetime transfer quota."
proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs use durable bounded replay/nonce state with explicit completion and safe expiry. Evict only after reconciliation preserves exact-request replay and nonce collision protection; prove continued signing beyond retention capacity and duplicate safety after restart."
owner_domain = 10

[finding.projection_legacy_rank]
file = "services/human/crates/layerx-human-service/src/server/projection.rs"
line = 21
class = "retired-reference"
severity = "medium"
observed = "projection::verification maps 0..=1 to Submitted, 2..=3 to Receipted and 4 to Committed. Managed evidence/spend projection therefore retains legacy verification bytes instead of typed Rung values. Some agentd managed-state producers still emit that legacy lattice, so changing labels in isolation would also be incorrect."
expected = "Requirements 10023.1-3 and 10026.1 require agent-boundary fields and API projections to use rungs only: Receipted is 1 and Committed is 2. Retired ranks cannot silently become achieved merged-network evidence."
proposal = "In services/human/crates/layerx-human-service/src/server/projection.rs and corresponding services/agent/crates/layerx-agentd producers migrate managed-state fields to a versioned typed Rung contract together. Migrate retained records explicitly and prove real evidence/spend projection through the peer boundary at every rung."
owner_domain = 10

[finding.rotation_challenge_rank]
file = "services/human/crates/layerx-human-service/src/server/production_rotation.rs"
line = 122
class = "interface-mismatch"
severity = "high"
observed = "Rotation::challenge refuses announced evidence unless verification is 4 or 5; ProductionAgentCreation::finalization_evidence emits committed Rung value 2. Even after execution is wired, a genuine committed announcement cannot be returned as a challenge. CommittedOutcome stores this field as an unversioned u8."
expected = "Registry 10.http-human-agent-rotation-start and requirement 10021.1 require committed announcement and persisted challenge to agree with the real finalization producer and its rung encoding."
proposal = "In services/human/crates/layerx-human-service/src/server/production_rotation.rs persist a versioned typed rung and consume it consistently with shared lifecycle finalization and projection. Prove announcement, challenge, wait and resumed completion using node-produced receipts, including explicit old-record handling."
owner_domain = 10
interface = "10.http-human-agent-rotation-start"

[finding.identity_documentation]
file = "docs/site/docs/concepts/identity.md"
line = 34
class = "doc-drift"
severity = "medium"
observed = "Lines 16-19 describe every native account as DID-derived, lines 34-35 deny balance authority to the EVM key, and lines 54-58 describe Human onboarding through DID registration. The reviewed owner identity, native onboarding and signed lifecycle paths instead support EVM-owner authority and bind signed calls to an authoritative owner wallet."
expected = "The finished-network identity guide must distinguish application passkeys from current merged owner authority and account encodings. An integrator must not mistake an authoritative EVM owner for an optional payout-only binding."
proposal = "Rewrite docs/site/docs/concepts/identity.md with the domain-10 owners of server/owner_identity.rs and production_onboarding.rs. Describe current owner/account encodings, committed-receipt activation and session/recovery authority, replacing obsolete payout-only and universal DID-registration claims."
owner_domain = 17

[finding.services_contract_topology]
file = "spec/layerx-merge/contracts/services.md"
line = 1555
class = "doc-drift"
severity = "medium"
observed = "The Human service contract at lines 1555-1565 describes sends through the sequencer and dependencies on gas-station-relayer. Its shared catalogue at lines 38-45 presents a separately operated sequencer private to a router and /rpc gateway routes as after-merge topology. Human submits signed EVM transactions to the node, and the audit brief retires the standalone topology."
expected = "Brief facts 1-3 specify one BFT node-hosted network, committed receipt finality and root-path public node RPC. Service contracts must distinguish node-internal sequencing code from separately operated services and name current dependencies."
proposal = "Amend spec/layerx-merge/contracts/services.md through its domain-10 Human contract owners and domain-8 platform owners. Describe current Human-to-node submission, sponsorship and durable recovery, replace standalone sequencer/router claims and update the dependency diagram and evidence description."
owner_domain = 10

[finding.readme_pt_BR]
file = "docs/readme/README.pt-BR.md"
line = 37
class = "doc-drift"
severity = "medium"
observed = "Lines 37-39 describe a separate layerxd domain beside Paxeer and custody/anchor contracts at 0x1013 and 0x1014. The runtime text near line 125 and diagrams at lines 158-230 retain a separately operated sequencer, LNI, relay archive and guarantor topology as current network behavior."
expected = "Brief facts 1-4 specify one BFT paxd chain, chain id 125, committed receipts as final, node RPC at the root and bank 0x1001. No running layerxd daemon, separate sequencer service, router or retired custody-hop network remains."
proposal = "Update docs/readme/README.pt-BR.md with the documentation owners to describe the single node-hosted network, tenant domains, root-path public RPC, bank transfers and committed finality. Replace two-domain diagrams and obsolete service startup/layout instructions, coordinating the translation with the current product."
owner_domain = 17

