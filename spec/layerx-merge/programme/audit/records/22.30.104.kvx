proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs share canonical session/revocation projectors using checked RFC3339 conversion. Prove open, list, refresh and revoke through ProductionComponents, Unix transport and HTTP cookie delivery, including retry and reopen."
owner_domain = 10
interface = "10.http-human-session-open"

[finding.creation_recovery_idempotency]
file = "services/human/crates/layerx-human-service/src/server/agent_creation_native.rs"
line = 344
class = "restart-recovery"
severity = "high"
observed = "retained_protocol_evidence compares disclosure.idempotency_key to action.action_key and queries the receipt by action.action_key. prepare_scoped and submit_prepared already use ProtocolEvidence::creation_idempotency_key: budgetCreate uses the budget id and budgetFund uses zero. Accepted budget transactions cannot pass retained-state recovery when these differ from the journey key."
expected = "Requirement 181392.1 and registry 10.rs-human-service-server-agent-creation-production-agent-creation require the call-derived budget idempotency rule to hold through retained transaction recovery and receipt lookup after a crash."
proposal = "In services/human/crates/layerx-human-service/src/server/agent_creation_native.rs use creation_idempotency_key for the disclosure comparison and receipt lookup while keeping the journey action key for local row identity. Prove restart after signing and broadcast for budgetCreate with a distinct budget id and budgetFund with its zero key."
owner_domain = 10
interface = "10.rs-human-service-server-agent-creation-production-agent-creation"

[finding.creation_export_idempotency]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 2194
class = "interface-mismatch"
severity = "high"
observed = "creation_material rejects disclosure.idempotency_key != action_key and calls receipt_by_idempotency_key with action_key. The signed budget transaction it loads from native-create-activity or protocol-signed rows instead carries the accepted budget id for budgetCreate or zero for budgetFund under requirement 181392.1, so its evidence reference cannot resolve."
expected = "Registry 10.http-human-evidence-get requires creation evidence references to resolve to the genuine signed transaction and receipt using the same method-derived key accepted by the creation producer."
proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs creation_material use the common call-derived key for comparison and receipt lookup, retaining owner, chain, transaction and stage checks. Resolve real budget-stage creation evidence through HTTP before and after reopen."
owner_domain = 10
interface = "10.http-human-evidence-get"

[finding.lifecycle_finalization_rank]
file = "services/human/crates/layerx-human-service/src/server/agent_runtime.rs"
line = 3230
class = "interface-mismatch"
severity = "high"
observed = "encode_finalization refuses verification outside 4..=5. ProductionAgentCreation::finalization_evidence at agent_creation.rs:689 emits evidence.rung.wire_rank(), which is 2 for its required committed receipts. Lifecycle control, limit, reclaim, archive and owner-rotation calls use this encoder and refuse genuine evidence before transport."
expected = "Registry 9.proto-human-peer-agent-control and requirement 10026.1 require producer, peer transport and consumer to agree on Rung bytes 0, 1, 2 and refuse retired ranks. A committed lifecycle proof must remain committed across the peer boundary."
proposal = "In services/human/crates/layerx-human-service/src/server/agent_runtime.rs use typed Rung finalization and coordinate the corresponding services/agent/crates/layerx-agentd decoder. Require the operation-appropriate committed proof and prove a genuine node receipt through the actual lifecycle peer call and restart while retaining authority checks."
owner_domain = 10
interface = "9.proto-human-peer-agent-control"

