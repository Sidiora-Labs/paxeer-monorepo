line = 6114
class = "interface-mismatch"
severity = "high"
observed = "execute_activity_query emits integer occurred_at and always echoes agent_id, from and to as nullable values. ActivityFilter allows optional typed strings, not null; an unfiltered page must echo an empty filter. An exhausted feed also returns an empty next_cursor. Strict response validation rejects the numeric timestamps and nullable filter values."
