proposal = "In services/human/crates/layerx-human-service/src/server/production_reads.rs keep signed receipt and ReceiptKeys metadata inside PortableReceiptV2 bytes_base64, or coordinate a versioned schema extension across consumers. Prove a node-produced managed receipt through the real HTTP edge and independent portable receipt verification."
owner_domain = 10
interface = "10.http-human-evidence-get"

