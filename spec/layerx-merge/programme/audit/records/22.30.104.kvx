[finding.evm_receipt_execution_domain]
file = "services/human/crates/layerx-human-service/src/server/agent_creation.rs"
line = 673
class = "interface-mismatch"
severity = "high"
observed = "finalization_evidence calls ProtocolEvidence::verify_outcome with the disclosed construct activity type and then compares protocol.module_id to expected_module again at line 680. Node EVM receipts use module id 12 (node/app.go:3503-3505), while session callers pass Governance and budget callers pass Budget. verify_move_evm_outcome in production_components.rs already distinguishes the EVM receipt execution domain."
expected = "Registry 10.rs-human-service-server-agent-creation-production-agent-creation-finalization-evidence requires genuine EIP-1559 lifecycle transactions and committed node receipts to round-trip. Signed disclosure determines the construct operation; receipt headers identify the EVM execution domain."
proposal = "In services/human/crates/layerx-human-service/src/server/agent_creation.rs and src/agents/create.rs separate signed construct-intent binding from strict node EVM receipt verification using one shared verifier. Preserve signature, hashes, height, fee, expiry and result checks; prove real session-grant and budget receipts through finalization."
owner_domain = 10
interface = "10.rs-human-service-server-agent-creation-production-agent-creation-finalization-evidence"

[finding.rotation_unreachable]
file = "services/human/crates/layerx-human-service/src/server/production_rotation.rs"
line = 193
class = "wiring-gap"
severity = "high"
observed = "execute_agent_rotate always returns upstream-degraded for agent.recover and operation-retired when no rotation row exists, so no new rotation starts. advance_owner_rotation at lines 225-226 also refuses Announce, Commit and Cancel; retained Wait advances into refused phases. Production dispatch still advertises agent.rotate, agent.rotation.start and agent.recover."
expected = "Registry 10.http-human-agent-rotation-start and agent.recover remain live contracts. Rotation/recovery must execute the merged authority lifecycle and resume retained work, or receive an explicit coordinated contract retirement rather than fail behind an available disclosure UI."
proposal = "In services/human/crates/layerx-human-service/src/server/production_rotation.rs implement the approved merged owner rotation/recovery lifecycle with persisted resumable phases and real receipt/challenge checks. Coordinate intentional retirement with schema/browser owners if required; do not restore the retired algorithm. Prove new, repeated and post-restart requests."
owner_domain = 10
interface = "10.http-human-agent-rotation-start"

[finding.activity_date_filter]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 1534
class = "interface-mismatch"
severity = "high"
observed = "activity_filters reads filter.from and filter.to only with Value::as_u64. ApiSchema admits these fields as RFC3339 Timestamp strings, so every valid date bound becomes None and feed queries, statement exports and evidence exports use an unbounded date range instead of the requested interval."
expected = "Registry 10.http-human-activity-query and activity export operations share ActivityFilter. Its Timestamp strings must select exactly the requested interval and be echoed as the applied filter."
proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs parse declared RFC3339 bounds with checked conversion, reject invalid or reversed ranges and preserve their meaning in responses. Drive a real persisted feed through query and both exports with entries inside and outside each bound."
owner_domain = 10
interface = "10.http-human-activity-query"

