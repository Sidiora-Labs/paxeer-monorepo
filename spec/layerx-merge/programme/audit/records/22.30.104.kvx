[finding.receipt_evidence_shape]
file = "services/human/crates/layerx-human-service/src/server/production_reads.rs"
line = 350
class = "interface-mismatch"
severity = "high"
observed = "The managed receipt evidence_get branch emits signed_receipt, tx_hash and receipt_key as extra top-level fields. journeys.kvx:50-53 EvidenceMaterial permits only five required fields plus optional settlement_domain, rung and inclusion_height. ApiSchema rejects unknown object fields, so http.rs:593 changes this genuine receipt response to upstream-degraded."
