proposal = "In services/human/crates/layerx-human-service/src/server/production_components.rs convert challenge and proof times at the API boundary while preserving numeric internal expiry checks. Prove genuine provider registration/assertion through HTTP and the declared schema, including expired and reopened ceremonies."
owner_domain = 10
interface = "10.http-human-passkey-assert-begin"

[finding.session_timestamps]
file = "services/human/crates/layerx-human-service/src/server/production_components.rs"
line = 4881
class = "interface-mismatch"
severity = "high"
observed = "execute_session_refresh and bootstrap_session_open at lines 6701-6702 emit numeric opened_at and last_active_at, whereas session.list at line 5082 emits RFC3339 strings. Revoke and revoke-all emit numeric revoked_at. A successful open or refresh fails validation before new cookies are returned; revocation may succeed while returning upstream-degraded."
