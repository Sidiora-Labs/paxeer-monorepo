lines = 217
verdict = "clean"
note = "Reviewed all tier values, boundaries, continuity, class handling and invalid tables against actual producer definitions."

[finding.trigger-live-margin]
file = "modules/perps/keeper/triggers.go"
line = 310
class = "runtime-risk"
severity = "high"
observed = "triggerOrder moves an admitted trigger directly to Match or BookInsert without CheckOpen, a current fee reserve or current governed value/leverage checks. AccountMargin ignores UNTRIGGERED orders, so collateral can be withdrawn after placement and an opening stop can activate with only enough balance for its fee."
expected = "Every opening exposure must satisfy current cross equity, initial margin and fee reserve. Pending activation must apply the same governed risk limits as a newly admitted opening order."
proposal = "In modules/perps/keeper/triggers.go revalidate live opening exposure and current governed limits before activating either stop type, atomically cancel refused EndBlock activations, and add actual 0x1015 placement, withdrawal and subsequent activation scenarios."
owner_domain = 3
interface = "3.go-perps-keeper-executeorder-j64"

[finding.pending-reduce-only-flip]
file = "modules/perps/keeper/positions.go"
line = 820
class = "interface-mismatch"
severity = "high"
observed = "positionReduceOnlyOrders selects only RESTING orders. A whole-position TP/SL remains at its old SizeBase after a partial close; triggerOrder checks position existence but not its live side/size. ApplyFill can close the remainder and open an opposite position with the excess of the supposedly reduce-only leg."
expected = "The declared TP/SL pair protects the live position and every reduce-only order must only shrink exposure, including after intervening partial reductions and recovery."
proposal = "In modules/perps/keeper/positions.go and triggers.go reconcile UNTRIGGERED reduce-only legs on every position change and enforce closing side/current size at each fill. Prove partial close followed by TP and SL execution through 0x1015, including export/import."
owner_domain = 3
interface = "3.go-perps-keeper-setpositiontpsl-j64"

[finding.cancelled-attachment-export]
file = "modules/perps/keeper/orders.go"
line = 563
class = "restart-recovery"
severity = "high"
observed = "closeOrder removes account/cloid/expiry keys but leaves the cancelled id in AttachedTpSl. ExportGenesis preserves that attachment while types.ValidateGenesis requires attached legs to be UNTRIGGERED. A valid public cancellation can therefore leave an export that fresh-store InitGenesis refuses. cancelUntriggered has the same omission."
expected = "Public cancellation must leave recoverable, valid genesis state and attached protection metadata must refer only to live legs; req.3005.2 requires valid venue exports to be accepted."
proposal = "In modules/perps/keeper/orders.go and triggers.go clear the corresponding attachment leg atomically on cancellation, expiry and activation refusal, deleting an empty pair. Test actual 0x1015 cancellation/refusal, exported state validation and fresh-store import together."
owner_domain = 3
interface = "3.go-perps-keeper-cancelorder-j64"

[finding.genesis-ownership-and-counts]
file = "modules/perps/types/genesis.go"
line = 397
class = "interface-mismatch"
severity = "high"
observed = "validateOrderIndexes and validatePositionIndexes check supplied ownership entries only in one direction. They do not require each open order/position to be indexed, reconcile account counts, or reconcile market OI. keeper.initGenesis imports AccountOrders and AccountMarketPositions verbatim, so an omitted position is invisible to AccountMargin, withdrawal and netting after recovery."
expected = "Validated recovery state must preserve every liability and ownership relation; canonical orders/positions, ownership indexes, account counts and market OI must agree before a restored account can trade or withdraw."
proposal = "In modules/perps/types/genesis.go require complete bidirectional ownership indexes and count/OI agreement, or derive them canonically in keeper/genesis.go before validation and writes. Use real filled/exported state to test omitted indexes and mismatched counts/OI, then inspect restored margin and withdrawal behavior."
owner_domain = 3
interface = "3.go-perps-types-validategenesis-j64"

[finding.adl-uses-current-mark]
file = "modules/perps/keeper/insurance.go"
line = 286
class = "interface-mismatch"
severity = "high"
observed = "insuranceAdlInputs passes MarketState.MarkPrice to ExecuteADL. endBlockPrices has already overwritten it with this block’s mark before Backstop/CoverDeficit executes. Thus real EndBlock ADL settles at the current mark; MarketState retains no previous committed mark for the promised pricing rule."
expected = "perps.md section 16 and perps-parameters.md section 7 require paired deficit/counterparty ADL reductions at the previous block’s mark, including across restart."
proposal = "Persist the previous committed mark in modules/perps/keeper/mark.go and types/state.go, carry it through genesis and pass it from insuranceAdlInputs. Add a two-block actual EndBlock scenario with different marks, restart before ADL, and assert settlement balances and ADLMatched prices."
owner_domain = 3
interface = "3.go-perps-keeper-endblock-j64"

[finding.settlement-leaves-adl-rank]
file = "modules/perps/keeper/account.go"
line = 298
class = "runtime-risk"
severity = "high"
observed = "Settle rewrites ReferencePrice, CostBasisUsd and funding basis while preserving RankScore and AdlRankIndex. Deposit/withdrawal then change collateral without reranking. RankADL consumes the stale index, so the documented sweep never refreshes its priority and a different profitable counterparty can be deleveraged."
expected = "The ADL index must represent the position at its last settlement using final account value, and the EndBlock sweep must refresh that state as the storage and EndBlock contracts specify."
proposal = "In modules/perps/keeper/account.go refresh rank keys for affected positions after the final account balance is known, sharing the calculation with positions.go/insurance.go and including post-fee effects. Prove rank reordering after settlement, deposit, withdrawal and reopened-store recovery before actual ADL."
owner_domain = 3
interface = "3.key-perps-adl-rank-index-prefix-j25"

[finding.adl-index-visit-bound]
file = "modules/perps/keeper/adl.go"
line = 70
class = "runtime-risk"
severity = "high"
observed = "RankADL stops on len(ranked), but unprofitable and same-account records consume no limit. A deficit may scan the entire opposite-side index in every block when few or no profitable counterparties are eligible; the configured match count does not bound database work."
expected = "The EndBlock contract requires a fixed work bound independent of account/position count, with unfinished work carried rather than an arbitrary prefix rescanned each block."
proposal = "In modules/perps/keeper/adl.go budget examined entries separately from matches and retain a deterministic persisted continuation cursor, sharing the visit allowance across the block. Test a real EndBlock deficit behind a large ineligible prefix, bounded progress and restart continuation."
owner_domain = 3
interface = "3.go-perps-keeper-endblock-j64"

[finding.paused-trigger-visit-bound]
file = "modules/perps/keeper/triggers.go"
line = 175
class = "runtime-risk"
severity = "high"
observed = "crossedInDirection limits len(ids) but continues over crossed opening triggers while paused without charging a visit. The same potentially unbounded prefix of opening triggers is decoded again each block before protective reduce-only stops can be collected."
expected = "Pause must preserve protective exits while every EndBlock index walk has a fixed visit bound and recovery-safe continuation; counting only collected orders does not bound execution cost."
proposal = "In modules/perps/keeper/triggers.go use a separately bounded reduce-only index or a persisted visited-entry budget that cannot starve exits. Test a large crossed opening prefix under pause with protective stops and restart between bounded passes."
owner_domain = 3
interface = "3.go-perps-keeper-endblock-j64"

[finding.adl-budget-renewed-in-block]
file = "modules/perps/keeper/endblock.go"
line = 377
class = "config-drift"
severity = "medium"
observed = "endBlockDeficits calls CoverDeficit separately per candidate, and ExecuteADL starts a fresh AdlPositionsPerBlock allowance on every call. Liquidation Backstop and insurance-position closes can call coverage again, so the real block can exceed the advertised per-block counterparty cap."
expected = "The parameter sheet and EndBlock contract advertise a block-wide ADL allowance. req.3006.3 checks a per-call bound and does not establish the whole-block claim."
proposal = "In modules/perps/keeper/endblock.go carry one ADL allowance through liquidation, deficit coverage and backstop closes, charging committed work and retaining deficits for the next block. Add a multi-deficit actual EndBlock test and reconcile the per-call requirement wording."
owner_domain = 3
interface = "3.gen-perps-adl-positions-per-block-j25"

[finding.trigger-fok-becomes-ioc]
file = "modules/perps/keeper/triggers.go"
line = 353
class = "interface-mismatch"
severity = "high"
observed = "PlaceOrder admits STOP_MARKET with TimeInForceFOK, but triggerOrder unconditionally replaces its time in force with IOC. A pending FOK stop can partially fill and cancel its remainder instead of rolling back when full liquidity is unavailable."
expected = "The FOK contract refuses incomplete execution with PerpsFokNotFilled and applies no partial trade. Activation must preserve the execution policy accepted and exposed in OrderDetails, or reject that combination at admission."
proposal = "In modules/perps/keeper/triggers.go preserve admitted FOK on activation or reject unsupported trigger/time-in-force combinations explicitly in orders.go. Test public placement and activation against insufficient liquidity, asserting no partial balances, positions or logs and valid recovery state."
owner_domain = 3
interface = "3.go-perps-types-timeinforcefok-j64"

[finding.expired-orders-still-fill]
file = "modules/perps/keeper/matching.go"
line = 373
class = "interface-mismatch"
severity = "high"
observed = "fillMaker and validateTaker never inspect Deadline. Trigger activation also lacks a deadline check and runs before expiry cleanup. An expired stop or resting maker remaining in the bounded expiry backlog can still execute after its declared deadline."
expected = "The DeadlineExpired contract treats a nonzero deadline below block time as expired; asynchronous bounded cleanup must not extend a trader’s authorization to execute an order."
proposal = "In modules/perps/keeper/matching.go refuse or atomically expire past-deadline takers and skip/expire makers before fills, and share the check with triggers.go. Test real 0x1015 calls before cleanup plus stop activation with a backlog of due expiries."
owner_domain = 3
interface = "3.err-sdk-perps-22-deadline-expired"

[finding.open-fill-margin]
file = "modules/perps/keeper/matching.go"
line = 407
class = "runtime-risk"
severity = "high"
observed = "PlaceOrder checks opening margin at sizing notional, then fillMaker calls ApplyFill without a resulting-equity check. At BTC mark 60000, a 6000 USD market buy at 10x with 602.7 USD collateral passes CheckOpen; a fill at the allowed 60300 price charges 2.7135 USD and leaves equity 569.9865 USD at mark, below 600 USD initial margin."
expected = "The parameter sheet requires equity after the fee and position increase to cover all resulting initial margin. Accepted slippage cannot silently bypass the same requirement for an immediately matched opening order."
proposal = "In modules/perps/keeper/orders.go and matching.go reserve risk at the executable worst price and validate resulting margin atomically after actual settlement/fees, also rechecking stale maker risk. Add the explicit adverse-fill case through PlaceOrder/0x1015 and require refusal without partial state or logs."
owner_domain = 3
interface = "3.go-perps-keeper-placeorder-j64"

[finding.quote-open-base-rounding]
file = "modules/perps/keeper/quotes.go"
line = 217
class = "interface-mismatch"
severity = "high"
observed = "CompatOpenOrder floors base times mark to SizeUsd, then QuoteOpen calls quotePlace with a zero exact-base override and divides by mark again. Real precompiles/perps/positions.go compatibilitySize rounds that product up. At mark 60000e18+1 the quote loses a lot while actual open retains the intended base."
expected = "quoteOpenPosition and openPosition at the same state and arguments must agree on base size, fills, fees, entry, funding estimate and liquidation output as the order confirmation contract promises."
proposal = "In modules/perps/keeper/quotes.go and precompiles/perps/positions.go share compatibility sizing or carry exact base through both paths. Add a real quote/deposit/open EVM comparison at off-tick marks, checking exact lot, notional and fee outputs."
owner_domain = 3
interface = "3.pc-0x1015-quoteopenposition"

[finding.quote-short-self-bid]
file = "modules/perps/keeper/quotes.go"
line = 187
class = "interface-mismatch"
severity = "high"
observed = "CompatOpenOrder excludes caller-owned bids when selecting a short sizing price. Actual compatibilitySize uses BestBid including the caller’s bid, which Match then cancels via self-trade prevention. With an own best bid above an external bid, quote and execution calculate different base sizes."
expected = "The public confirmation quote must reproduce the same compatibility sizing and self-trade behavior as actual execution for the same account and starting book."
proposal = "Unify short sizing and self-trade treatment in modules/perps/keeper/quotes.go and precompiles/perps/positions.go under one documented rule. Compare actual 0x1015 quote and open on equivalent snapshots with an own best bid and lower external liquidity."
owner_domain = 3
interface = "3.pc-0x1015-quoteopenposition"

[finding.pause-authority-order]
file = "modules/perps/keeper/msg_server_pause.go"
line = 18
class = "security"
severity = "medium"
observed = "msgServer.SetPaused reads GetParams before Keeper.SetPaused checks authority. With corrupt stored params a wrong authority receives ErrInvalidParams rather than ErrUnauthorized, exposing store validity and differing from UpdateParams and direct SetPaused."
expected = "Governance callers without authority must be refused before protected state is read, consistently whether persisted parameter bytes are valid or corrupt."
proposal = "In modules/perps/keeper/msg_server_pause.go call checkGovernanceAuthority before unwrapping/decoding state, retain cached writes, and test the real MsgServiceRouter path with a wrong authority and corrupt parameters."
owner_domain = 3
interface = "3.go-perps-keeper-setpaused-j25"

[finding.abci-keeper-core]
file = "modules/perps/keeper/keeper.go"
line = 101
class = "interface-mismatch"
severity = "high"
observed = "GetMarket and UpdateParams/SetMarket contextualize ErrUnknownMarket, ErrUnauthorized and ErrInvalidParams with fmt.Errorf and %w. The consumed SDK ABCIInfo encoder follows Cause() rather than Unwrap(), so these errors encode as undefined codespace/code 1 instead of their registered perps identity. errors.Is and the custom EVM selector mapping can still recognize them."
expected = "The declared perps error codes must retain codespace, numeric identity and LXP name through the actual SDK response/protobuf/client decoder, with contextual details preserved. Generic internal errors do not round-trip as the registered refusal."
proposal = "Replace contextual registered-error wrapping in modules/perps/keeper/keeper.go with the SDK-aware Error.Wrap/Wrapf pattern used in orders.go and triggers.go. Add actual producer to ResponseDeliverTx/protobuf to ABCIError assertions for these branches, retaining sentinel, LXP and EVM selector checks."
owner_domain = 3
interface = "3.err-sdk-perps-3-unknown-market"

