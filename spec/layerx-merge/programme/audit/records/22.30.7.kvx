[finding.snapshot-growth]
file = "modules/layerxpay/keeper/genesis.go"
line = 39
class = "interface-mismatch"
severity = "high"
observed = "ExportGenesis appends every escrow, budget, stream, service and governance row and all agent stream metadata without a count bound. GenesisState.Validate in types/params.go:35,55 refuses either collection above MaxKernelRecords=512. Live writers impose no equivalent combined lifetime limit, so normal multi-family state or accumulated results can produce a snapshot that InitGenesis refuses."
expected = "Every snapshot exported from admitted live state must round-trip through the declared JSON genesis import and restore all economic records and agent metadata."
proposal = "In modules/layerxpay/keeper/genesis.go and types/params.go, provide a complete scalable recovery envelope with bounded chunks, validated completeness and existing per-record bounds. Prove a real export/import/reopen containing more than 512 combined family records and metadata; reconcile the genesis contract."
owner_domain = 2
interface = "2.go-layerxpay-keeper-exportgenesis-j24"

[finding.escrow-receipt-binding]
file = "modules/layerxpay/keeper/escrow_settle.go"
line = 11
class = "interface-mismatch"
severity = "high"
observed = "The real escrow settlement receipt returned through Submit has zero TransferSetRoot while its durable result has a nonzero root. types/proof_views_test.go:379-396 explicitly compares these facts. src/modules/escrow/lx_escrow_module.c:361-417 fills a local lxp_receipt and returns the state event without carrying its economic binding into the outer receipt."
expected = "Canonical lxp_receipt.transfer_set_root must bind the actual balance-changing transfer set and agree with the economic result read by consumers after settlement and recovery."
proposal = "In src/modules/escrow/lx_escrow_module.c, propagate executed and replayed economic facts through the kernel receipt-binding path. Require identical nonzero roots in real outer receipts and stored results, exact transfer effects, replay and reopened-store proofs."
owner_domain = 1
interface = "1.c-lxp-receipt"

[finding.default-event-loss]
file = "precompiles/layerxpay/service.go"
line = 65
class = "interface-mismatch"
severity = "high"
observed = "Lapsed serviceAccept/serviceReject calls the global ServiceApplyDefaultOutcomes sweep. keeper/service_delivery_test.go:126-160 demonstrates two code-14 events for two changed agreements. serviceHandlers ignores receipt.Events, reads only the requested agreement and emits one log at line 130, leaving the other committed outcome absent from the EVM event transport."
expected = "Every committed default outcome must reach subscribers and projections as DefaultOutcomeApplied with the affected agreement id, state, sequence and timestamp."
proposal = "In precompiles/layerxpay/service.go, validate and translate every default-outcome event in the sweep receipt into its ABI log. Prove one real EVM call changing two differently configured agreements, all decoded logs and matching queries after reopen."
owner_domain = 2
interface = "2.pc-0x101b-evt-defaultoutcomeapplied"

[finding.unused-budget-revoke]
file = "modules/layerxpay/keeper/budget_close.go"
line = 32
class = "runtime-risk"
severity = "high"
observed = "BudgetRevoke reaches src/modules/budget/lx_budget_module.c:789, which sets per_period_limit=spent_this_period. For an unused funded budget this is zero; lx_budget_record_validate in lx_budget_create.c:28 rejects it. proof_layerxpay_0x101b_test.go:295-313 pins LXP_ERR_NON_CANONICAL and spends then refunds before proving revocation."
expected = "An authorized owner must be able to revoke an unused funded budget and recover its balance without first sending an unrelated payment; terminal records must remain canonical."
proposal = "In src/modules/budget/lx_budget_module.c and lx_budget_create.c, define canonical revoked allowance semantics supporting zero prior spending while retaining live-record bounds. Prove unused and spent revocation, exact refunds, replay, atomic refusals and recovery through the real 0x101B path."
owner_domain = 1
interface = "2.pc-0x101b-budgetrevoke"

[finding.opaque-genesis]
file = "modules/layerxpay/types/params.go"
line = 67
class = "restart-recovery"
severity = "medium"
observed = "Genesis validation checks envelopes, duplicates, size limits and gates but does not decode owned economic records or linked service delivery items. keeper/proof_pay_genesis_test.go:213-232 truncates a real exported offer to one byte; module validation and initialization accept it, then GetOffer panics."
expected = "Accepted recovery input must contain canonical owned record bodies and consistent links so its first public query is usable after initialization."
proposal = "In modules/layerxpay/types/params.go and keeper/genesis.go, validate owned record versions, key/body ids, delivery item links and agent metadata linkage before any writes. Prove malformed real exports fail atomically while valid snapshots import and reopen."
owner_domain = 2

[finding.service-corruption-panic]
file = "modules/layerxpay/keeper/service_views.go"
line = 27
class = "runtime-risk"
severity = "medium"
observed = "decodeServiceView panics on decode errors; delivery and aggregate views also panic on malformed keys, headers and missing items. The accepted one-byte imported offer in proof_pay_genesis_test.go is a concrete route to this panic; the served wrapper only translates gas panics."
expected = "Public service reads must distinguish absent records from typed corrupt-state errors and preserve request and node availability."
proposal = "Return explicit decode errors from modules/layerxpay/keeper/service_views.go through its precompile adapters, preserving absent-record semantics. Validate owned genesis records and prove corrupted real exports produce a stable refusal without panic or writes."
owner_domain = 2

[finding.escrow-corruption-panic]
file = "modules/layerxpay/keeper/escrow_views.go"
line = 19
class = "runtime-risk"
severity = "medium"
observed = "GetEscrow and GetEscrowResult panic on existing malformed record bytes at lines 19 and 37. Genesis validation admits short values for these keys, so accepted recovery input can make normal escrow views propagate non-gas panics."
expected = "Escrow hold and result reads must return stable typed corruption refusals and distinguish absence without an unhandled panic."
proposal = "In modules/layerxpay/keeper/escrow_views.go and precompiles/layerxpay/escrow.go, propagate explicit corruption errors and enforce canonical owned-record import validation. Prove mutated real hold/result exports are rejected before writes and public reads remain available."
owner_domain = 2

[finding.escrow-global-snapshot-read]
file = "precompiles/layerxpay/escrow.go"
line = 56
class = "runtime-risk"
severity = "medium"
observed = "getEscrowResult first reads its directly keyed result, then calls ExportGenesis and copies every pay-family, governance and agent metadata row to retrieve the same raw bytes. This fixed-size lookup allocates and charges store work proportional to unrelated network history; the work is metered, not free."
expected = "A result lookup by idempotency key should read only its owned result with bounded work independent of other families and tenants."
proposal = "Add a direct validated raw-result reader in modules/layerxpay/keeper/escrow_views.go and use it in precompiles/layerxpay/escrow.go. Preserve the exact result bytes and prove scoped store reads remain bounded as unrelated histories grow and after reopen."
owner_domain = 2
interface = "2.pc-0x101b-getescrowresult"

[finding.service-global-scans]
file = "modules/layerxpay/keeper/service_views.go"
line = 82
class = "runtime-risk"
severity = "medium"
observed = "LatestDelivery scans every delivery header and ProgressHighWater scans every progress record before filtering by agreement or commitment. Charged gas and read latency grow with unrelated histories, and a malformed unrelated record can break the requested view."
expected = "Agreement and commitment queries should remain usable as other users accumulate histories and should depend on the requested state and bounded owned indexes."
proposal = "Persist agreement-to-latest-delivery and commitment-to-high-water indexes in the owning service writer and modules/layerxpay/keeper/service_views.go, with canonical recovery/rebuild rules. Prove exact producer values, unrelated-record isolation and reopen behavior."
owner_domain = 2
interface = "2.pc-0x101b-latestdelivery"

[finding.budget-time-view]
file = "modules/layerxpay/keeper/budget_views.go"
line = 35
class = "runtime-risk"
severity = "medium"
observed = "BudgetRemaining subtracts persisted SpentThisPeriod from PerPeriodLimit and caps by balance without consulting block time. Hosted spending applies lx_budget_rollover first. An exhausted old period can report zero although the next-period spend succeeds; expired records can still report positive allowance."
expected = "budgetRemaining should describe allowance usable at the same block time as budgetSpend, including rollover and expiry, without writing state."
proposal = "In modules/layerxpay/keeper/budget_views.go, project a detached record through kernel-equivalent period, carry and expiry rules. Prove exact boundary timestamps, capped carry, expired budgets, unchanged store bytes and a matching real spend at the queried context."
owner_domain = 2
interface = "2.pc-0x101b-budgetremaining"

