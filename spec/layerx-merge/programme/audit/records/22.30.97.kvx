[finding.session_tools_unbound]
file = "services/agent/crates/layerx-mcp/src/server.rs"
line = 525
class = "wiring-gap"
severity = "high"
observed = "Server::bind_for_mode selects TOOL_CATALOGUE and WEB_TOOLS but omits SESSION_TOOLS. ScopeBinding recognises session scopes and catalogue::surface describes eleven approval/subscription tools, yet session-only scopes receive NoScope and mixed sessions cannot list or invoke those tools. Binding::daemon_invocation uses this server for mcp.describe and calls."
expected = "Requirements 9053.1 and 9053.2 require declared approval/subscription tools to be reachable with major-2 cursor and approval result shapes through authenticated MCP."
proposal = "Include SESSION_TOOLS in layerx-mcp/src/server.rs binding, deployment filtering, descriptions and dispatch. Prove daemon mcp.describe and MCP tools/list and tools/call with session-only and mixed scopes, including read-only filtering and triple-cursor acknowledgement."
owner_domain = 9
interface = "9.http-mcp-tool-approval-get"

[finding.shared_payer_methods]
file = "services/agent/crates/layerx-mcp/src/binding.rs"
line = 311
class = "interface-mismatch"
severity = "high"
observed = "SharedPayer forwards grant/pay/draw/submit but inherits standing_grant returning None and view returning Unavailable. web_route wraps the attached payer in this adapter, discarding a supplied standing grant and preventing getPayerGrant for an offered grantId. The production WebPayerBoundary also lacks these overrides."
expected = "Requirement 1812793.1 requires existing grants to be returned and checked through WebPayer::view, with issueGrant used only when no standing grant exists."
proposal = "Implement and forward standing_grant and view in layerx-mcp/src/binding.rs and layerx-agentd-host/src/payer.rs. Exercise offered and host-held grants through the opened daemon web route, retaining receipt checks and asserting no issueGrant submission for an existing grant."
owner_domain = 9
interface = "9.rs-mcp-tools-web-webpayer"

[finding.seller_rpc_misroute]
file = "services/agent/crates/layerx-mcp/src/tools/web.rs"
line = 1242
class = "interface-mismatch"
severity = "high"
observed = "payer_account sends POST /rpc eth_call(accountId) to WebConfig.endpoint, the x-websearch seller. offer_facts performs it for exact and metered prices. The real x-websearch route_of serves GET search/fetch/content and has no /rpc, so valid paid offers fail before settlement."
expected = "The seller exposes resource HTTP; authenticated node RPC uses its own merged root endpoint. Requirements 9055.1 and 1812793.1 require ledger facts and a complete paid resource exchange."
proposal = "Move accountId lookup behind the authenticated node/payer boundary in layerx-mcp/src/tools/web.rs. Keep seller requests on resource routes and prove exact and metered purchases against the actual x-websearch router and node transport rather than inventing a seller RPC route."
owner_domain = 9
interface = "11.http-xws-search"

[finding.native_disclosure_legacy]
file = "services/agent/crates/layerx-mcp/src/tools/write.rs"
line = 441
class = "interface-mismatch"
severity = "high"
observed = "execute_native_alias checks input bytes and the native_disclosure_v1 answer with disclosure::bind. That binder calls retired activity decode_unsigned; the merged preparation producer builds Eip1559Call and bind_call disclosure. Unsigned call RLP cannot pass this consumer, while the native owner path still exchanges legacy preparation shapes."
expected = "Requirement 22062.1 explicitly requires SDK/MCP consumers to decode the served unsigned call, bind the actor address and compare every disclosed field without the retired canonical-bytes binder."
proposal = "Migrate layerx-mcp/src/tools/write.rs and the native owner answer to unsigned EIP-1559 decoding plus disclosure::call::bind_call with the authenticated sender. Compare every response and requested intent field and prove prepare/disclose/sign/submit through the actual daemon transport."
owner_domain = 9
interface = "9.rs-crypto-disclosure-bind"

[finding.effect_carrier_legacy]
file = "services/agent/crates/layerx-agentd/src/approval/native_effect.rs"
line = 307
class = "interface-mismatch"
severity = "high"
observed = "NativeEffectApprovalCarrier::disclosure uses bind/bind_budget_mutation; validate decodes layerx_wire::activity::decode_unsigned with protocol_version 3. Actor, authority and expiry remain activity-envelope facts, so durable restoration rejects the merged unsigned call rather than rebinding its sender."
expected = "Requirement 22058.1 requires native-effect carrier facts from the call and bound disclosure, with durable restoration by call decoding and sender rebinding."
proposal = "Replace legacy restoration in layerx-agentd/src/approval/native_effect.rs with call-bound preparation and retained sender. Version durable carriers explicitly and prove reopen, altered bytes/sender refusal and terminal decision recovery through the native owner path."
owner_domain = 9
interface = "9.rs-crypto-disclosure-bind"

[finding.program_carrier_legacy]
file = "services/agent/crates/layerx-agentd/src/approval/native_program.rs"
line = 107
class = "restart-recovery"
severity = "high"
observed = "NativeProgramApprovalCarrier uses crate::prepare::Prepared, still re-exported from legacy, reads envelope actor/authority/timestamps and restores through restore_canonical. native_rate_submission_update decodes a signed Activity. These durable paths cannot replay the merged call-bound preparation and signed type-2 transaction."
expected = "Requirement 22058.1 requires program settlement and carriers to read call-derived facts and restore by unsigned call decoding and sender rebinding."
proposal = "Migrate layerx-agentd/src/approval/native_program.rs to call-bound preparation and verified EVM submission/receipt identities. Version durable state, preserve budget/decision atomicity and prove an admitted program call survives restart, approval, submission and settlement with identical facts."
owner_domain = 9
interface = "9.rs-agentd-approval-native-program-presentation-read-owned-j43"

[finding.program_presentation_legacy]
file = "services/agent/crates/layerx-agentd/src/approval/native_program_presentation.rs"
line = 95
class = "wiring-gap"
severity = "medium"
observed = "read_owned verifies legacy disclosure binding, reads module/actor/fee from prepared.envelope and derives the allocation actor with did_id_for_protocol instead of binding the EVM call sender."
expected = "Requirement 22058.1 requires program presentations and allocation checks to use the same call-derived actor, activity, expiry, nonce, fee and idempotency facts as execution."
proposal = "Update layerx-agentd/src/approval/native_program_presentation.rs with the carrier migration so operation, sender, gas fee bounds and allocation checks come from the rebound call. Compare the human presentation with the exact approved and submitted call."
owner_domain = 9
interface = "9.rs-agentd-approval-native-program-presentation-read-owned-j43"

[finding.program_requirement_legacy]
file = "services/agent/crates/layerx-agentd/src/approval/program_requirement.rs"
line = 116
class = "wiring-gap"
severity = "medium"
observed = "binding checks prepared.envelope.actor_did and idempotency_key, re-encodes the unsigned activity envelope and retains its payload_hash. Requirement records bind the legacy representation rather than the merged unsigned call."
expected = "Requirement 22058.1 requires program requirement checks to consume call-bound facts and preserve them through durable decisions and recovery."
proposal = "Migrate layerx-agentd/src/approval/program_requirement.rs to call-derived sender, canonical digest, operation and idempotency fields. Bind durable requirement decisions to the exact unsigned call and prove replay refuses a changed call or sender."
owner_domain = 9
interface = "9.rs-agentd-approval-native-program-presentation-read-owned-j43"

[finding.grant_before_persist]
file = "services/agent/crates/layerx-agentd/src/approval/mod.rs"
line = 2220
class = "restart-recovery"
severity = "medium"
observed = "ApprovalService::approve calls submissions.release before persist_grant. A failed complete_claim or fallback decision write leaves the queue entry published. authorize_submit can observe a release without a successful durable grant, and restart cannot preserve the same outcome."
expected = "Decisions, released preparations and submission authority must become visible only after their joined durable grant succeeds, including storage failure and restart."
proposal = "In layerx-agentd/src/approval/mod.rs stage the queue release, atomically persist the decision and released record, then publish it using the program release ordering. Inject a durable write failure and reopen to prove no release is visible until commit."
owner_domain = 9
interface = "9.rs-agentd-approvalservice-approve-j70"

[finding.web_hold_not_call]
file = "services/agent/crates/layerx-mcp/src/tools/web.rs"
line = 1458
class = "restart-recovery"
severity = "medium"
observed = "spend_preparation creates JSON resource/offer bytes, a SHA-256 signing preimage and DID actor, then calls policy::approval::hold without budget reservations. validate_registry and replay_released require unsigned EIP-1559 bytes, matching sender/address actor and durable reservation evidence; memory-only web fixtures hide this incompatibility."
expected = "Requirement 22057.1 requires held bytes to decode as the unsigned call and disclosure to be rebound with the sender after restart, rejecting changed bytes or sender."
proposal = "Hold the actual prepared payment call with sender, signing hash and budget reservations through the durable approval boundary in layerx-mcp/src/tools/web.rs. Bind resource/offer commitment separately to that preparation and prove restart, approval and exact retry through the served route."
owner_domain = 9
interface = "9.rs-agentd-policy-approval-hold"

[finding.rate_lifetime_cap]
file = "services/agent/crates/layerx-agentd/src/approval/native_program.rs"
line = 923
class = "runtime-risk"
severity = "medium"
observed = "StagedNativeRateUse::stage refuses previous.len() >= 4096 before considering expired windows. native_rate_receipt_update marks records committed without removing them; pending_native_uses still counts all RATE_PREFIX entries. Unsigned rejection/expiry removes records, but successful committed entries have no pruning path, eventually exhausting tenant admission."
expected = "A bound on outstanding rate reservations must not become a lifetime limit on successful operations; committed uses outside authenticated applicable windows must stop consuming pending capacity."
proposal = "Prune safely expired committed rate records in layerx-agentd/src/approval/native_program.rs, joined to authenticated window advancement and durable updates. Preserve in-flight/replay evidence and verify more than 4096 completed uses across expired windows remain admissible."
owner_domain = 9
interface = "9.rs-agentd-approvalservice-approve-j70"

[finding.hex_length_validation]
file = "services/agent/crates/layerx-mcp/src/catalogue.rs"
line = 503
class = "interface-mismatch"
severity = "medium"
observed = "Shape::Hex32 and Hex64 schemas require 64 and 128 hex digits, but check only enforces maximum length, evenness and hex alphabet. Two-digit non-native program or activity identifiers pass validation and fail later in the actual read consumer."
expected = "Published schema, pre-dispatch validator and read decoder must agree on fixed identifier lengths and reject malformed inputs before creating invocations."
proposal = "Enforce exact lengths for Hex32 and Hex64 separately from Bytes in layerx-mcp/src/catalogue.rs. Check short, exact and oversized identifiers through tools/call and confirm malformed requests never reach the daemon."
owner_domain = 9
interface = "9.rs-mcp-catalogue-validate-j43"

[finding.approval_page_bound]
file = "services/agent/crates/layerx-mcp/src/catalogue.rs"
line = 927
class = "interface-mismatch"
severity = "medium"
observed = "Ordinary approval.list schema and validation permit limit through u8::MAX (255), while ApprovalService::list rejects page_limit above 100. Schema-valid requests can therefore fail solely because the service declares a different bound."
expected = "The MCP approval.list schema and owning approval service must agree on the supported page limit without weakening the service maximum."
proposal = "Align approval.list schema/validation in layerx-mcp/src/catalogue.rs with the service maximum of 100 and verify limits 100 and 101 through the authenticated approval transport."
owner_domain = 9
interface = "9.http-mcp-tool-approval-list"

[finding.listener_monopolisation]
file = "services/agent/crates/layerx-mcp/src/listener.rs"
line = 169
class = "runtime-risk"
severity = "medium"
observed = "serve_protocol accepts one admitted Unix peer and runs its protocol until EOF before accepting another. Per-read/write deadlines reset on activity, so a peer sending ping before each timeout can retain the only serving slot indefinitely."
expected = "One admitted client must not indefinitely deny access to other admitted clients by holding an idle or periodically active healthy connection."
proposal = "Add a bounded connection policy in layerx-mcp/src/listener.rs, such as isolated bounded concurrent sessions or a total connection/request budget. Prove another admitted client receives service while the first keeps its connection alive."
owner_domain = 9
interface = "9.rs-mcp-listener-serve-j70"

[finding.connect_deadline]
file = "services/agent/crates/layerx-mcp/src/boundary.rs"
line = 204
class = "runtime-risk"
severity = "medium"
observed = "AgentSurface::get calls blocking TcpStream::connect before setting self.deadline read/write timeouts. A saturated loopback listener backlog can stall connection establishment outside the configured deadline and occupy the sequential serving connection."
expected = "The binding request deadline must cover connection establishment and response I/O so unavailable daemon calls return bounded typed transport refusals."
proposal = "Use a parsed loopback SocketAddr and connect_timeout with a shared elapsed-time budget in layerx-mcp/src/boundary.rs. Verify backlog saturation and stalled response return the existing unavailable outcome within the configured deadline."
owner_domain = 9
interface = "9.rs-mcp-boundary-agentsurface-j43"

