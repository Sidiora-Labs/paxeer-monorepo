[finding.daemon_web_fixture_retired]
file = "services/agent/crates/layerx-mcp/tests/daemon_bound.rs"
line = 1015
class = "test-gap"
severity = "medium"
observed = "web_section emits sequencer_public_key without receipt_key_index, but web_binding rejects that retired field. Positive tests such as missing-attached-payer expect Binding::open success and stop on configuration parsing before their intended assertions."
expected = "Requirement 9055.2 requires receipt_key_index and refusal of sequencer_public_key; positive documents must match the actual producer, with isolated invalid-field cases."
proposal = "Update positive web fixtures in layerx-mcp/tests/daemon_bound.rs to a complete current receipt-key binding, retain separate retired-key negatives and prove missing-payer and web-field cases reach their intended branch."
owner_domain = 9
interface = "9.cfg-mcp-binding-web-sequencer-public-key"

