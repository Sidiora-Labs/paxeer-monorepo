[finding.deployment-projection]
file = "services/platform/hosted/registry/src/routes.rs"
line = 1366
class = "wiring-gap"
severity = "high"
observed = "POST /__registry/deployments returns 200 after ChainDeployment::journal writes chain-deployments/<transaction>.json. Registrar::rebuild reads only FileDeploymentJournal::load().units, whose root scan accepts envelope/deployment/admission units and ignores chain-deployments and chain-proofs. Accepted chain deployments never enter list, detail or source-verification projections, including after restart."
expected = "Requirements 8115.1, 8116.1 and 21003.1 require accepted committed Programs deployments to become usable durable registry facts through the actual service."
proposal = "In services/platform/hosted/registry/src/routes.rs, programs_chain.rs and journal.rs, feed authenticated chain deployment evidence into the durable projection consumed by rebuild; prove real POST, program GET, source lookup and restart GET for a committed transaction."
owner_domain = 8
interface = "8.http-registry-post-registry-deployments"

[finding.head-authority-route]
file = "services/platform/hosted/registry/src/node_state.rs"
line = 610
class = "interface-mismatch"
severity = "high"
observed = "parse_head_authority GETs /v1/protocol/account-state/head?height=<observed_sequence> from the receipt authority and requires matching chain_evidence plus authority_replica_id. deployment.yaml points this at layerx-receipt-authority, whose authority/src/main.rs::route has no such endpoint and rejects the query with 404."
expected = "The registry consumer and configured authority producer must agree on an authenticated committed proof route so current and historical registry reads succeed."
proposal = "Establish a committed-head proof contract in services/platform/hosted/authority/src/main.rs and registry/src/node_state.rs and mount its authenticated producer, or bind the consumer to a maintained chain proof provider; prove actual TLS head retrieval and historical replay."
owner_domain = 8
interface = "8.env-registry-layerx-registry-receipt-authority-endpoint"

[finding.retired-anchor-finality]
file = "services/platform/hosted/authority/src/main.rs"
line = 659
class = "retired-reference"
severity = "high"
observed = "checkpoint_for calls latestFinalized() and checkpoint(uint64) on 0x1014, requires status 2 and decodes an 18-word checkpoint. Human identity, capability and key-policy evidence still uses this path. The retired component.anchor contract returns ErrModuleRetired after upgrade."
expected = "Committed BFT blocks supply finality; human authority must bind committed height, app hash and state membership without an anchor checkpoint registration."
proposal = "Replace checkpoint_for and its human callers in services/platform/hosted/authority/src/main.rs and src/human.rs with pinned committed-header and per-key proofs; verify human identity and capability routes against a node with anchor retirement active."
owner_domain = 8
interface = "8.http-authority-any-v1-agent"

[finding.mixed-height-and-sequence]
file = "services/platform/hosted/authority/src/human/dynamic.rs"
line = 558
class = "interface-mismatch"
severity = "high"
observed = "current() sets Current.head to Session.committed_height and Current.checkpoint to the EVM block hash. route() requires latest.last_sequence from a receipt batch header to equal that height and the native anchor checkpoint ID to equal that block hash. These are different coordinate and digest domains."
expected = "Subject authority must compare committed height with committed height and bind state and receipts to one authenticated block; a receipt sequence or anchor ID cannot stand in for block identity."
proposal = "In services/platform/hosted/authority/src/human/dynamic.rs, carry explicit committed height/hash and receipt sequence separately and authenticate their relationship; exercise multiple receipts in one block and blocks without relevant receipts."
owner_domain = 8
interface = "8.http-authority-any-v1-agent"

[finding.receipt-staging-recovery]
file = "services/platform/hosted/authority/src/human.rs"
line = 376
class = "restart-recovery"
severity = "medium"
observed = "Human::retain creates a fixed .receipt.pending with create_new and leaves it on interrupted write, sync or rename. Human::evidence reads every directory entry and requires an activity-ID .json filename. The leftover blocks later retention and evidence replay after restart."
expected = "An interrupted publication must preserve already committed human evidence and permit independent subsequent receipts to be retained and read."
proposal = "In services/platform/hosted/authority/src/human.rs, publish unique staging units and recover or quarantine incomplete units before replay; exercise interruption at write, sync, rename and directory-sync boundaries."
owner_domain = 8

[finding.rotated-human-receipt-key]
file = "services/platform/hosted/authority/src/human.rs"
line = 438
class = "interface-mismatch"
severity = "high"
observed = "verify obtains a valid per-receipt authorization from trust::replica and the full pinned key list, then rejects it unless derived equals the single config.authorization. When human routes are enabled, by_activity calls retain and returns state_persistence_unavailable for another applicable pinned key."
expected = "Requirements 8112.1, 89817.1 and 181427.1 permit any applicable pinned receipt key, identified by SHA256(public key), through lookup, human retention and replay."
proposal = "In services/platform/hosted/authority/src/human.rs, retain the derived key identity and verify against the pinned list and validity range rather than the legacy singleton; prove rotated-key lookup and human evidence after restart with human configuration enabled."
owner_domain = 8
interface = "8.rs-authority-layerx-platform-authority-authorized-batch-by-activity"

[finding.source-route-abi-five]
file = "services/platform/hosted/registry/src/routes.rs"
line = 1166
class = "interface-mismatch"
severity = "high"
observed = "source_deployment and rebuild restrict deployment ABI to 1..=4. The evaluator declares GUEST_ABI=5; programs/sdk/rust/src/abi_policy.rs admits ABI 5 and the reproducible-build pipeline uses that admission policy. Valid ABI-5 source requests and replay are refused."
expected = "Brief fact 6 requires host and guest ABI agreement on every registration path; VerifiedDeploymentEvidence::abi_version may return all runtime-admitted versions."
proposal = "Use shared runtime ABI admission in services/platform/hosted/registry/src/routes.rs for live reads and replay, retaining refusal of unknown versions; prove a real ABI-5 deployment can be read, source-verified and reopened."
owner_domain = 13
interface = "13.rs-reg-protocol-evidence-verifieddeploymentevidence-abi-version"

[finding.source-store-abi-five]
file = "services/platform/hosted/registry/src/verified.rs"
line = 66
class = "interface-mismatch"
severity = "high"
observed = "VerifiedSourceDeployment::decode and VerifiedSourceStore::record independently enforce ABI 1..=4 despite runtime admission of ABI 5. Fixing route admission alone still leaves valid ABI-5 source results unwritable and unreadable on restart."
expected = "Durable source verification must preserve every admitted deployment ABI through serialization and replay while rejecting unsupported ABI values."
proposal = "Use shared ABI admission in services/platform/hosted/registry/src/verified.rs for record validation and decoding; prove ABI-5 provenance through durable publication and reopen using the actual deployment producer."
owner_domain = 8
interface = "13.rs-reg-protocol-evidence-verifieddeploymentevidence-abi-version"

[finding.mismatch-outcome-persistence]
file = "services/platform/hosted/registry/src/routes.rs"
line = 1277
class = "interface-mismatch"
severity = "medium"
observed = "reproduce prepares a VerifiedSource for SourceStatus::Mismatch and constructs a source_mismatch response. persist_artifact then rejects the unequal artifact/deployment hashes as deployment_changed; VerifiedSourceStore::record also refuses them. The intended terminal mismatch result cannot settle."
expected = "The source_mismatch outcome must be distinct from deployment changes, idempotent across retries and durable without claiming mismatching source was verified."
proposal = "Model a durable mismatch separately from verified provenance in services/platform/hosted/registry/src/routes.rs and src/verified.rs, settle the original 409 and replay it unchanged; prove genuine reproducible mismatch, retry and restart."
owner_domain = 8
interface = "8.err-registry-source-mismatch"

[finding.mutable-source-mirror]
file = "services/platform/hosted/registry/src/mirror.rs"
line = 103
class = "restart-recovery"
severity = "medium"
observed = "SourceMirror::publish separately replaces archive, plan and URI under a key derived only from archive bytes. Republishing the same archive with another plan or URI changes prior source identity; interruption can mix the tuple. Registrar::rebuild requires the old URI and exact plan and then fails reopening."
expected = "Published source identity must remain stable for all completed verifications, and interrupted publication must not invalidate earlier durable registry state."
proposal = "In services/platform/hosted/registry/src/mirror.rs, atomically commit an immutable archive/plan/URI binding, rejecting conflicts or versioning the whole binding; cover same-archive different-plan publication and each crash boundary."
owner_domain = 8

[finding.upgrade-journal-schema]
file = "services/platform/hosted/registry/src/journal.rs"
line = 200
class = "interface-mismatch"
severity = "high"
observed = "decode_record calls DeploymentRecord::decode and validate. protocol_evidence.rs produces old_code_hash=None for version 2, but DeploymentRecord::validate requires a predecessor hash above version 1. The hosted journal quarantines valid committed upgrades, as tests/journal.rs:395-435 demonstrates with empty units and JournalUnavailable."
expected = "Authenticated Programs upgrade evidence must round-trip through DeploymentRecord and journal replay while preserving contiguous versions and authenticated predecessor identity."
proposal = "In programs/crates/layerx-programs-registry/src/protocol_evidence.rs and authority.rs, authenticate predecessor history or define a chain lifecycle record that proves it; update hosted replay to preserve deploy, upgrade and restart without inventing hashes."
owner_domain = 13
interface = "13.rs-reg-authority-deploymentrecord"

[finding.missing-chain-rpc-deployment]
file = "services/platform/hosted/registry/deployment.yaml"
line = 59
class = "config-drift"
severity = "high"
observed = "The registry env list omits LAYERX_REGISTRY_CHAIN_RPC_URL and has no envFrom. src/main.rs::config requires that variable at 419-420 and errors before serving. The shipped deployment cannot start the current binary even when listed secrets and builder configuration are available."
expected = "The deployment must configure the required committed-chain transport with a reachable root-path endpoint and matching network egress."
proposal = "Supply the actual chain RPC endpoint in services/platform/hosted/registry/deployment.yaml using supported TLS or loopback transport and admit its egress; start the real rendered service and exercise committed Programs reads."
owner_domain = 8
interface = "8.env-registry-layerx-registry-chain-rpc-url-j40"

[finding.retired-explorer-topology]
file = "services/platform/hosted/registry/deployment.yaml"
line = 126
class = "retired-reference"
