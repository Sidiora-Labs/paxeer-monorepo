[finding.1]
file = "services/human/crates/layerx-human-security-provider/src/state.rs"
line = 70
class = "interface-mismatch"
severity = "high"
observed = "RecoveryReceipt::verify passes canonical protocol receipt bytes to layerx_programs::verify_tx. That verifier hashes its argument as the complete Comet transaction and checks header.data_hash (programs/crates/layerx-programs-registry/src/chain_proof/tx.rs:5-11). The merged node commits a containing sequence-batch transaction, not the standalone receipt. Genuine node receipt material therefore cannot satisfy this proof."
expected = "Recovery ingestion, reveal and replay must accept evidence emitted by the merged node. Transaction inclusion authenticates the actual block transaction and must bind its successful recovery outcome to the exact receipt returned to the human service."
proposal = "In services/human/crates/layerx-human-security-provider/src/state.rs extend RecoveryReceipt with the containing transaction and selected receipt/outcome binding. Verify the real sequence-batch transaction against the consensus head, decode and match its receipt, then prove ingestion, reveal and reopen with node-produced recovery evidence."
owner_domain = 10
