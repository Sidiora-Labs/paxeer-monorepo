[finding.5]
file = "services/human/crates/layerx-human-service/src/activity/export.rs"
line = 448
class = "interface-mismatch"
severity = "high"
observed = "EvidenceBundle::verify_receipt accepts Receipted or Committed after signature/key checks; rung is not part of signed canonical receipt bytes and ReceiptFact carries no committed sequence-batch proof. A signed uncommitted receipt can be relabeled Committed and accepted with a recomputed bundle digest. rpc/sequencer_receipt.go:39-42 explicitly distinguishes a signed receipt from coverage by a committed MsgSequenceBatch."
expected = "Requirement 10024 requires exported fact tampering to fail. A portable Committed claim must establish coverage by a committed block. A receipt signature alone establishes Receipted and cannot authenticate an artifact-supplied Committed label."
proposal = "In services/human/crates/layerx-human-service/src/activity/export.rs carry and verify the containing sequence-batch transaction, consensus header/commit and selected receipt binding for Committed exports. Derive the accepted rung from authenticated evidence; prove rung-only mutation cannot upgrade Receipted, while real committed evidence survives export/decode/reopen."
owner_domain = 10
