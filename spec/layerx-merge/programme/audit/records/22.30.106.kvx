[finding.7]
file = "services/human/crates/layerx-human-service/src/auth/mod.rs"
line = 1231
class = "security"
severity = "medium"
observed = "prepare_open_session checks assertion.consumed before minting a session, but commit_open_session does not recheck it when that new session id is absent. Two preparations before either commit have different session ids; both commits consume the same verified assertion. A separate replayable preparation API does not protect this public two-phase method."
expected = "A verified passkey assertion must authorize one durable session opening. Identical opening replay may recover its original session; a second distinct prepared session must fail once the assertion is consumed."
proposal = "In services/human/crates/layerx-human-service/src/auth/mod.rs durably bind the assertion to the opening/session id and enforce that binding at commit. Permit identical-session replay, reject a second prepared session and cover interleaved preparation, expiration and reopen after each durable write."
