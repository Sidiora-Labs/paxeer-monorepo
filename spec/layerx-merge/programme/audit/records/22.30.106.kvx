[finding.6]
file = "services/human/crates/layerx-human-service/src/activity/export.rs"
line = 1059
class = "interface-mismatch"
severity = "high"
observed = "verify_receipt_export passes fact.sequencer_authorization from the artifact directly to verify_activity/verify_state, without matching it to externally supplied receipt_keys or binding its inclusion header to the selected receipt. An artifact-selected key can sign an unrelated tree/header and be counted as a verified inclusion."
expected = "The inclusion consumer requires independently selected authority (services/agent/crates/layerx-proof/src/inclusion.rs:176-199). An export may supply proof data but cannot confer trust on its own signing key or count an unrelated root as evidence for the selected receipt."
proposal = "In services/human/crates/layerx-human-service/src/activity/export.rs resolve inclusion authority from external pinned key history and bind the header, height and root to the exported receipt and its committed evidence. Refuse artifact-only keys and substituted headers; cover foreign keys, unrelated roots and real producer round trips."
