[finding.shared-wallet]
file = "services/human/crates/layerx-human-kms/src/store.rs"
line = 449
class = "interface-mismatch"
severity = "high"
observed = "EvmAttestor is loaded once with one evm_key_id, address and owner assertion. Operation 6 copies that same address into every binding record. Each record then has its own Wallet.next_nonce and action map (evm.rs:10-22). Keystore::evm_wallet/public_wallet_identity consume the result as that principal's wallet. Two tenants or principals therefore share spending authority and can independently reserve the same address/chain nonce."
expected = "The EVM wallet returned for a principal must preserve principal and tenant custody isolation, and nonce reservations must be unique for the actual signing address and chain across all records and restarts."
proposal = "In services/human/crates/layerx-human-kms/src/store.rs resolve and retain an attestor key and owner assertion for each validated tenant/principal binding; coordinate nonce reservations by chain and actual address. Add a two-principal and two-tenant real-attestor round trip that proves distinct control and recovery after restart; coordinate owner mapping with services/wallet/attestor."
owner_domain = 10
interface = "10.fmt-lxkp-op-evm-wallet"

[finding.export-delivery-loss]
file = "services/human/crates/layerx-human-kms/src/store.rs"
line = 367
class = "restart-recovery"
severity = "high"
observed = "export_primary erases seed, wallet and send_actions and fsyncs self_custodied before the server writes the response. A dropped TLS response leaves no managed seed and no replayable export. RemoteKmsProvider::export_primary_key (provider.rs:973-985) receives only a raw 32-byte result and has no acknowledgement or recovery protocol; provider.rs:1351-1379 deliberately demonstrates permanent refusal after a lost reply."
expected = "A successful custody handover must leave the human with recoverable key material even when delivery or acknowledgement is interrupted. An uncertain network reply must not destroy the only retained copy of the primary key."
proposal = "In services/human/crates/layerx-human-kms/src/store.rs and services/human/crates/layerx-human-service/src/custody/provider.rs introduce a durable export envelope encrypted to the authenticated ceremony recipient, replayable only for that ceremony until recipient acknowledgement; durably disable managed use during handover. Test disconnects before and after durable publication and after restart."
owner_domain = 10
interface = "10.fmt-lxkp-op-export-primary"

[finding.hosted-chain-snapshot]
file = "services/human/crates/layerx-human-kms/src/config.rs"
line = 90
class = "interface-mismatch"
severity = "high"
observed = "Config::load requires the strict ChainSnapshot { chain_id: u64 } with chain_id 125 and rejects unknown fields. The real hosted material producer services/platform/hosted/human/material.py:960-981, invoked by material.sh:3-5, emits registry.json as network_id, protocol_version and modules. Its unchanged emitted file cannot start this KMS; the stable network_id/protocol_version registry rows also still describe the old shape."
expected = "The file published as LAYERX_HUMAN_KMS_REGISTRY_FILE by the hosted launcher must be the exact chain-125 snapshot accepted by the KMS. Requirement 10012.1 and the retained-material lifecycle require production provisioning and restart to use that same shape."
proposal = "Update services/platform/hosted/human/material.py::kms_prerequisite and its material.sh callers to publish {chain_id:125}, migrate retained registry material while preserving seal and custody state, and prove that the emitted file starts the real KMS and survives restart. Reconcile domain 10 registry network_id/protocol_version rows and the operator contract with that producer."
owner_domain = 8
interface = "10.env-layerx-human-kms-registry-file"

[finding.signer-identity-split]
file = "services/human/crates/layerx-human-kms/src/store.rs"
line = 324
class = "interface-mismatch"
severity = "high"
observed = "Create/describe publish a 32-byte Ed25519 public key (public/description at 103-120), whereas Sign interprets its seed as a local secp256k1 scalar and requires that hidden scalar's EVM address. Operation 6 advertises the independently configured attestor address instead. CustodySigner::sign and RemoteCustodySigner::sign_call consume the public wallet/disclosure and cannot derive the local address from the public Ed25519 descriptor. The happy-path tests obtain it by decrypting state.aead with the operator seal."
expected = "The wallet identity supplied to a human, the key descriptor and the signing operation must identify a coherent supported key and algorithm. A caller using only public provider operations must be able to request and verify a signature from its advertised wallet."
proposal = "In services/human/crates/layerx-human-kms/src/store.rs route EVM Sign to the principal-bound attestor wallet, or define a separate explicit algorithm/address descriptor for a supported local EVM key. Update services/human/crates/layerx-human-service/src/custody/provider.rs to consume that descriptor and prove create/describe/wallet/sign without state-volume access."
owner_domain = 10
interface = "10.fmt-lxkp-op-sign"

[finding.assertion-refresh]
file = "services/human/crates/layerx-human-kms/src/store.rs"
line = 62
class = "config-drift"
severity = "medium"
observed = "LAYERX_HUMAN_KMS_EVM_ASSERTION_FILE is read once during EvmAttestor::load and retained as a Zeroizing<String>. sign_evm_transaction reuses it indefinitely. The real attestor JWT verifier requires exp and iat and enforces DefaultMaxAge=time.Hour (services/wallet/attestor/internal/auth/jwt/jwt.go:39,175-190). Rotating the file does not refresh a running KMS, so new signatures fail once that assertion ages out."
expected = "A long-running KMS must use a current, owner-bound assertion and continue serving after routine credential rotation without requiring custody service downtime or weakening token expiry."
proposal = "In services/human/crates/layerx-human-kms/src/store.rs retain a protected assertion source per owner and refresh it before signing under a bounded expiry policy; validate subject/key binding and surface typed expiration. Add real-attestor expiry, rotated-file and restart coverage, and document the rotation mechanism in the KMS README."
owner_domain = 10
interface = "10.rs-human-kms-attestor-attestor-signer-sign-evm-transaction-j45"

[finding.connection-deadline]
file = "services/human/crates/layerx-human-kms/src/server.rs"
line = 60
class = "runtime-risk"
severity = "medium"
observed = "The 16 connection permits cover unauthenticated TLS handshakes as well as requests. config.deadline is applied only as per-socket read/write timeout; complete_io and read_exact can perform multiple successful partial reads without an absolute request deadline. Sixteen peers sending small fragments within each timeout can retain every permit and prevent legitimate KMS requests."
expected = "A configured KMS deadline must bound the whole handshake and request lifecycle, and unauthenticated peers must not indefinitely exhaust all custody service capacity."
proposal = "In services/human/crates/layerx-human-kms/src/server.rs carry one absolute RuntimeClock deadline through TLS handshake, framed reads, store admission and response writes, reducing individual I/O budgets to the remaining interval. Add fragmented-handshake and fragmented-frame cases proving permits are released by the overall bound."
owner_domain = 10

[finding.queued-authorization-expiry]
file = "services/human/crates/layerx-human-kms/src/server.rs"
line = 90
class = "security"
severity = "medium"
observed = "connection samples now and validates authorization before acquiring the global Store mutex. dispatch uses that old now after an unbounded lock wait, while another request holds the same mutex throughout remote threshold signing. Wallet::sign and accept_external then check not_after against the pre-queue time, allowing signing or accepting a signature after the authorization has expired."
expected = "Validity windows must be checked against a fresh trusted clock at the point signing authority is exercised, and queueing or slow attestors must not extend the human-approved authorization window."
proposal = "In services/human/crates/layerx-human-kms/src/server.rs bound store admission and sample the trusted RuntimeClock after admission; in store.rs/evm.rs recheck expiry immediately before signing and before accepting the result. Add a blocked-attestor case in which a queued plan expires and is refused without consuming fresh authority."
owner_domain = 10

[finding.snapshot-capacity]
file = "services/human/crates/layerx-human-kms/src/store.rs"
line = 229
class = "runtime-risk"
severity = "medium"
observed = "Every mutation serializes the complete JSON state and refuses only after it exceeds MAX_STATE=8 MiB, setting healthy=false. Up to 4096 records, 4096 wallet actions per record and retained transaction/calldata byte arrays are admitted independently; acknowledged actions are never pruned. Valid traffic can exhaust the byte bound long before those count limits and take unrelated principals out of service until recovery."
expected = "Configured count and payload limits must fit the durable storage budget, and reaching a capacity bound must produce an admission refusal without poisoning unrelated custody records or losing action recovery."
proposal = "In services/human/crates/layerx-human-kms/src/store.rs perform byte-budget admission before changing state, and add durable per-wallet journal segmentation or safe archival of acknowledged actions that retains nonce and deduplication facts. Exercise near-capacity sends, typed refusal, unaffected principals and restart recovery."
owner_domain = 10

[finding.send-reservation-gap]
file = "services/human/crates/layerx-human-kms/src/store.rs"
line = 417
class = "restart-recovery"
severity = "medium"
observed = "authorize_send calls Wallet::authorize, mutating next_nonce/actions, and then performs remote Wallet::sign before any persist. A signing timeout or uncertain response returns before persistence; restart discards the reservation even though attestors may already have signed that transaction. The dedicated operation-7 path persists separately, so the combined SEND path has a different recovery boundary."
expected = "SEND nonce/action reservation must survive a restart before any external signer can act, and an uncertain threshold reply must recover the same authorized action rather than permit a conflicting reuse."
proposal = "In services/human/crates/layerx-human-kms/src/store.rs durably publish the exact authorization and nonce reservation before contacting attestors, then durably attach signed bytes using the same action identity. Add a real-attestor response-loss and process-restart test for operation 11 that refuses a changed action at the reserved nonce."
owner_domain = 10
interface = "10.fmt-lxkp-op-authorize-send"

[finding.native-replay-capacity]
file = "services/human/crates/layerx-human-kms/src/attestor.rs"
line = 1081
class = "runtime-risk"
severity = "medium"
observed = "request_native_signature inserts every successful session into native_replays, refuses any new session at 512 entries, and has no expiry, compaction or durable replay recovery. A long-lived AttestorSigner using the public native consent APIs eventually refuses every new consent; constructing or restarting a signer clears the local replay history instead of defining a recovery lifecycle."
expected = "The retained native consent APIs must sustain normal long-running use with bounded replay storage and a documented replay horizon; restart must not be the mechanism for bypassing exhausted replay protection."
proposal = "In services/human/crates/layerx-human-kms/src/attestor.rs define an authorization-bound replay retention horizon and a durable bounded journal or explicit session lifecycle coordinated with the attestor. Test more than 512 sequential valid sessions, replay/conflict handling and restart without weakening request binding."
owner_domain = 10
interface = "10.rs-human-kms-attestor-attestor-signer-sign-native-local-grant"

[finding.concurrent-audit-order]
file = "services/human/crates/layerx-human-kms/src/attestor.rs"
line = 730
class = "runtime-risk"
severity = "medium"
observed = "sign_evm_transaction_with_assertion sends requests before acquiring recorded(), then rejects every response whose per-node audit_sequence is at most the most recently completed call. Concurrent calls on the shared public signer can finish out of order: a later sequence is recorded first and an earlier, correctly signed response is rejected as malformed. KMS store serialization avoids this in that daemon but the exported signer permits concurrent callers."
expected = "Independent authenticated signing sessions must accept valid out-of-order completions while preserving anti-replay and audit integrity; network response scheduling must not turn a valid signature into a malformed response."
proposal = "In services/human/crates/layerx-human-kms/src/attestor.rs serialize complete signing sessions per key or track request/session-specific audit acceptance with a safe replay window. Add a real-attestor concurrent test that delays one response and checks both exact signatures and audit monotonicity."
owner_domain = 10
interface = "10.rs-human-kms-attestor-attestor-signer-sign-evm-transaction-j45"

