[finding.hosted-events-wiki]
file = "docs/wiki/HostedInternal.md"
line = 232
class = "doc-drift"
severity = "medium"
observed = "The event-source section says no layerx-human workload is declared and no source under services/human/crates or hosted sources issues POST /internal/v1/observe (232-250). Hosted human/deployment.yaml now declares the Human service and node-pod selector, and human-service/src/event_producer.rs builds the internal producer client and durable observation outbox. The blanket missing-producer statement is stale."
expected = "Operators need the current Human workload/service mapping and the actual observation, retry, enrollment and outbox recovery path, with remaining live gaps distinguished from obsolete implementation status."
proposal = "Update docs/wiki/HostedInternal.md event-source topology and missing-wiring paragraphs from services/platform/hosted/human/deployment.yaml, services/human/crates/layerx-human-service/src/event_producer.rs and services/platform/hosted/internal/src/producer.rs; describe the current producer credentials, durable delivery and restart behavior."
owner_domain = 8

