[finding.human-journey-map]
file = "docs/wiki/HumanJourneys.md"
line = 4
class = "doc-drift"
severity = "medium"
observed = "The journey guide calls the schema minor 4 although v1.kvx declares 10. It lists wallet-binding/deposit/withdraw/exit as active journeys and gives active operation instructions for routes now returning 410 operation-retired; its onboarding and verification discussion retains the old custody/settlement model."
expected = "The published journey map must distinguish retained historical schema variants from executable routes, document the current minor, and guide users through sponsored onboarding, one-chain moves and submitted/receipted/committed evidence."
proposal = "Rewrite docs/wiki/HumanJourneys.md from schema v1.kvx, retired-operation declarations and production dispatch: mark all eleven retired routes with their final refusal, replace the wallet/deposit/withdraw/exit walkthroughs with chain-125 moves and sponsored bindLayerX onboarding, and update receipt/rung examples."
owner_domain = 10

[finding.kms-service-contract]
file = "spec/layerx-merge/contracts/services.md"
line = 1440
class = "doc-drift"
severity = "medium"
observed = "The human-kms purpose and route table still specify Unix sockets, while its own liveness paragraph acknowledges the real TCP mutual-TLS listener as an open J98 discrepancy. The Human contract and key-variable catalogue also omit the new KMS attestor config/assertion files needed by the EVM store."
expected = "The service contract used for registry conformance must give one consistent current transport and provisioning lifecycle, including the EVM attestor dependencies and exact chain snapshot required for successful startup."
proposal = "Reconcile the human-kms section in spec/layerx-merge/contracts/services.md and its owning service/registry declarations to the TCP mutual-TLS implementation, chain-125 snapshot and owner-bound attestor material; close the already documented J98 transport discrepancy with verified operator startup examples."
owner_domain = 10

[finding.sign-version-registry]
file = "services/human/crates/layerx-human-kms/src/wire.rs"
line = 49
class = "config-drift"
severity = "medium"
observed = "The stable registry row 10.fmt-lxkp-op-sign declares LXKP version 1 operation 5. Operation::from_wire accepts only (7,5), and the current RemoteKmsProvider uses that version-7 EVM request. Current transport peers agree with one another, but an integrator implementing the declared stable version-1 layout receives Refused."
expected = "The registry and operator protocol contract must name the actual supported Sign version, EIP-1559 payload/disclosure layout, 20-byte sender and 65-byte signature, with explicit compatibility and retirement behavior."
proposal = "Reconcile spec/layerx-merge/interfaces.kvx row 10.fmt-lxkp-op-sign and the KMS wire contract with services/human/crates/layerx-human-kms/src/wire.rs and the service provider encoder. Publish the version-7 migration boundary and preserve tests proving old version-1 activity signing is explicitly refused."
owner_domain = 10
interface = "10.fmt-lxkp-op-sign"

[finding.attestor-api-registry]
file = "services/human/crates/layerx-human-kms/src/attestor.rs"
line = 817
class = "config-drift"
severity = "medium"
observed = "Stable row 10.rs-human-kms-attestor-attestor-signer-sign-activity declares canonical bytes plus ModuleRegistry and an AttestorSignature result. The exported function now accepts Eip1559Call, Disclosure, from:[u8;20] and Approval and returns AttestorCallSignature with a 65-byte EVM signature. The real Human consumer has moved to the latter signature while the declared stable Rust API still describes the retired activity shape."
expected = "The declared public Rust API and its service contract must expose the exact types used by the real producer and consumer, and distinguish the migrated EVM call API from retained native consent signatures."
proposal = "Update the owning interface declaration 10.rs-human-kms-attestor-attestor-signer-sign-activity in spec/layerx-merge/interfaces.kvx and its services.md contract to the current EIP-1559 signature and return type; record compatibility/retirement of the former activity API and prove the exact named call through the real Human signer consumer."
owner_domain = 10
interface = "10.rs-human-kms-attestor-attestor-signer-sign-activity"

