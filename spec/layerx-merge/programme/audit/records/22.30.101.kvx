class = "restart-recovery"
severity = "high"
observed = "ResumableStream.events calls accept(page), which advances #cursor to page.nextCursor and records every event ID before yielding the first event. If a consumer stops or checkpoints stream.cursor after one event of a multi-event page, resume starts beyond events that were never delivered."
