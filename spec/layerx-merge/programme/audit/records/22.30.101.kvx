[finding.rpc-root]
file = "services/agent/sdk/typescript/src/rpc.ts"
line = 63
class = "interface-mismatch"
severity = "high"
observed = "JsonRpcClient rewrites every endpoint to a path ending in /rpc. A public node root becomes /rpc, and PxClient inherits this rewrite. rpc/rpcstack.go CheckPath accepts only / for the default node path; services/platform/hosted/gateway/src/main.rs likewise mounts JSON-RPC POST at /. Neither real producer serves this rewritten route."
expected = "Brief facts 2 and 3 require the merged node JSON-RPC at the root and hosted px_ reads at the gateway contract. A configured endpoint must reach its actual producer, including tenant endpoints without an invented suffix."
proposal = "In services/agent/sdk/typescript/src/rpc.ts preserve the configured node or gateway URL, default root URLs to /, and prove eth_ calls against the node handler and px_ calls against the hosted gateway handler. Retain explicit tenant path prefixes supported by the producer."
owner_domain = 9
interface = "9.ts-sdk-rpc-jsonrpcclient"

[finding.websocket-root]
file = "services/agent/sdk/typescript/src/rpc-subscription.ts"
line = 80
class = "interface-mismatch"
severity = "high"
observed = "subscribeRpc appends /ws to its input endpoint. Through JsonRpcClient this connects to /rpc/ws; even a direct root input becomes /ws. The node HTTP/WS stack uses CheckPath with the configured root path, so subscriptions never reach the default node WebSocket handler."
expected = "Requirement 9354 requires live eth_subscribe heads and logs with continuity. Brief facts 2 and 3 prohibit the retired /rpc/ws transport and require the merged node public endpoint."
proposal = "In services/agent/sdk/typescript/src/rpc-subscription.ts select ws or wss while preserving the configured WebSocket endpoint path. Exercise the real node root WebSocket handshake, heads/log notifications, cancellation and reconnect reconciliation."
owner_domain = 9
interface = "9.ts-sdk-rpc-subscription-subscriberpc"

[finding.commit-inclusion]
file = "services/agent/sdk/typescript/src/verifier.ts"
line = 574
class = "security"
severity = "high"
observed = "verifyCommittedReceipt accepts a sequencer-signed receipt and a valid greater-than-two-thirds Comet commit whenever landingHeight is at least receipt.height. CommittedReceiptEvidence has no authenticated execution header, transaction/batch inclusion proof or result proof tying that receipt to blockId. An unrelated later block commit can therefore label the receipt committed."
expected = "Requirement 9962 and docs/site/docs/agents/sdk-verification.md require the receipt and its raw transaction to be included in the authenticated MsgSequenceBatch/execution block and successful result, with consensus commitment of the corresponding headers. Voting power alone authenticates a block, not this receipt."
proposal = "Extend services/agent/sdk/typescript/src/verifier.ts committed evidence with canonical execution and successor headers, batch/transaction/result proofs and trusted header linkage. Return committed only after all bindings pass; add an unrelated-valid-commit refusal using recorded producer evidence."
