interface = "9.ts-sdk-program-lifecycle-encodenativeprogramdeploy"

[finding.draw-restart]
file = "services/agent/sdk/typescript/src/x402/draw.ts"
line = 50
class = "restart-recovery"
severity = "high"
observed = "PreparedGrantDraws.execute durably sets attempted = 1 before sendRawTransaction. A crash between those operations, or a send failure before admission, leaves the stored transaction permanently unsent. Later executions only poll sequencerReceipt and cannot resubmit the retained identical raw transaction, so the payment remains pending indefinitely."
expected = "Brief checks 5 and 7 require durable payment recovery and idempotent redelivery. A retained signed transaction with unknown admission must be reconcilable and safely delivered after restart without creating a second payment."
proposal = "In services/agent/sdk/typescript/src/x402/draw.ts persist an explicit unknown-admission state, reconcile by the stored hash and permit redelivery of the exact stored raw bytes under the same idempotency and period keys. Add disk-backed reopen cases for crashes before send and uncertain send acknowledgement."
owner_domain = 9
interface = "9.ts-sdk-x402-draw-preparedgrantdraws"

