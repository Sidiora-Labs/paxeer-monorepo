[finding.artifact-revocation-restore]
file = "services/platform/hosted/ai-artifacts/src/main.rs"
line = 1731
class = "restart-recovery"
severity = "high"
observed = "Startup passes config.revocation_mark directly to Store::open, while only retention_mark is checked by outside(). With an external retention marker and an internal revocation marker, restoring an older data-directory backup restores both the revoked-grant state and its high-water mark; restore_ready then accepts the old grant or publisher generation."
expected = "The revocation_mark contract in authority.rs:19 requires the live revocation high-water mark outside the restorable directory so a backup cannot restore revoked access. Retention and revocation have independent monotonic recovery barriers."
proposal = "In ai-artifacts startup, require both live marker paths to resolve outside the restored data directory, including existing symlink aliases. Add service restart cases that revoke a grant and a publisher, restore old data, and prove refusal with independently retained markers."
owner_domain = 8
interface = "8.cfg-ai-artifacts-config-revocation-mark"

[finding.artifact-staging-reclamation]
file = "services/platform/hosted/ai-artifacts/src/store.rs"
line = 284
class = "runtime-risk"
severity = "medium"
observed = "expire_staging marks sessions Expired and releases their byte reservations without deleting uploaded chunk files. Quarantined and duplicate-root finalization also release reservations without reclaiming their staging bytes. Repeated abandoned uploads can fill the disk while reported capacity becomes available again."
expected = "The artifact capacity and tenant quota represent durable storage consumption. Terminal staging data must be reclaimed with restart-safe accounting before the same physical capacity is sold again."
proposal = "Add durable staging reclamation in ai-artifacts/store.rs and maintenance: retain a reclaiming disposition until chunk deletion is synced, recover it on reopen, and reconcile physical bytes with quotas. Exercise expiration, failed encrypted finalization and duplicate publication across restart."
owner_domain = 8

[finding.artifact-content-corruption]
file = "services/platform/hosted/ai-artifacts/src/main.rs"
line = 1310
class = "runtime-risk"
severity = "medium"
observed = "The content route returns HTTP 200 for any stored chunk whose length equals expected_chunk_length. A same-length change after publication therefore remains served while metadata can continue to advertise verified integrity and availability; the quarantine branch detects missing or differently sized bytes only."
expected = "Content supplied for a published root must remain bound to its verified content commitment, and damaged durable storage must produce an integrity refusal and quarantine rather than advertise healthy availability. A consumer verifier remains necessary."
proposal = "In ai-artifacts content serving, authenticate the requested bytes against durable verified chunk commitments or revalidate the complete content root before serving. Add same-length corruption and reopen coverage, keeping the real consumer assembler verification intact."
owner_domain = 8
interface = "8.http-ai-artifacts-any-v1-content"

[finding.artifact-finalize-live-state]
file = "services/platform/hosted/ai-artifacts/src/main.rs"
line = 707
class = "runtime-risk"
severity = "medium"
observed = "For a new finalize request on a Published session, finalize returns receipt() before publisher admission or object lifecycle checks. The duplicate-root branch also treats every existing state except Publishing as the same publication. receipt() always reports AVAILABLE and VALID, including an object already tombstoned, purged or quarantined."
expected = "A new publication request must distinguish the immutable original publication acknowledgement from current access and availability. Purged bytes and revoked publisher generations must not receive a fresh live-availability claim; exact request-id replay may retain its historical disposition."
proposal = "Update ai-artifacts finalize and receipt construction to check current object and publisher lifecycle for new request identities, and explicitly label historical acknowledgements. Exercise new request ids after tombstone, purge, quarantine and publisher revocation without changing exact replay semantics."
owner_domain = 8
interface = "8.http-ai-artifacts-any-v1-finalize"

[finding.artifact-listener-admission]
file = "services/platform/hosted/ai-artifacts/src/main.rs"
line = 1783
class = "runtime-risk"
severity = "medium"
observed = "Every accepted TCP connection spawns a new operating-system thread. Per-operation read and write timeouts do not bound concurrent connections or the total request duration, and operations serialize on shared store and ledger locks. Slow clients can exhaust threads before tenant authorization."
expected = "The hosted artifact listener must bound memory, threads and lock contention under unauthenticated or slow traffic, with a finite end-to-end request budget and a clear overload response."
proposal = "Add bounded connection admission and a bounded worker pool in ai-artifacts/main.rs, release permits on every error path, and enforce a total request deadline. Cover saturated admission and slow partial requests while proving normal authenticated traffic still progresses."
owner_domain = 8

[finding.artifact-terminal-fixture-shape]
file = "services/platform/hosted/ai-artifacts/tests/artifact_service.rs"
line = 1156
class = "test-gap"
severity = "medium"
observed = "observe_terminal sends checkpoint, execution_height and batch metadata but omits block_height, app_hash and store_proof_digest. StateHeadReq at main.rs:326 requires all three fields without defaults. The helper expects HTTP 200, although deserialization rejects this request before retention processing."
expected = "Terminal retention tests must use the full committed-head shape accepted by the real producer-to-handler path, including the block commitment and store proof fields introduced by the merged network."
proposal = "Replace the obsolete hand-built terminal observation with the committed ai-market state-head producer and send its complete request through the real service. Preserve the current success and refusal assertions and add a restart before retention consumption."
owner_domain = 8
interface = "8.http-ai-artifacts-any-v1-retention-terminal"

[finding.identity-compaction-replay]
file = "services/platform/hosted/identity/src/store.rs"
line = 353
class = "restart-recovery"
severity = "high"
observed = "Store::open writes the replayed snapshot before truncating journal.log. If a pending signup was in an earlier snapshot, its later Verify record can be the only signup-related journal record. A crash after the new snapshot is durable but before truncation leaves Verify to replay against a snapshot with no pending token; apply then fails with verification references no pending signup. Replayed Signup records can also count the same signup day twice."
expected = "An interrupted snapshot and journal rollover must reopen to the same acknowledged identity state. Reapplying durable journal records must not block startup or inflate signup counts."
proposal = "Give identity snapshots and journal records a durable generation or checkpoint offset committed atomically, or make every record replay idempotent against a durable applied identity. Add crash-boundary cases with Signup already snapshotted and Verify in the following journal, plus daily-count assertions."
owner_domain = 8
interface = "8.fmt-identity-journal-log"

[finding.identity-signup-subject-replacement]
file = "services/platform/hosted/identity/src/store.rs"
line = 525
class = "security"
severity = "medium"
observed = "verify_signup rejects a subject bound to another tenant but permits an already-existing subject in the same tenant. State::verify_signup builds a new Principal and insert_principal replaces signer keys, account and audiences. Desk::start checks email registration rather than an existing subject. A provisioning caller that reuses a subject can replace its existing authority through ordinary signup."
expected = "Signup establishes a new identity binding; an existing subject must require the explicit authorized key-rotation or recovery lifecycle before its signer and account permissions can change. Provisioning authorization alone does not distinguish these operations."
proposal = "In identity signup admission and verification, reject an existing subject or require an explicit authenticated recovery operation bound to the existing principal. Prove that a second email and signer cannot overwrite an existing same-tenant subject and that authorized rotation remains available."
owner_domain = 8

[finding.identity-verify-session-retry]
file = "services/platform/hosted/identity/src/main.rs"
line = 1117
class = "restart-recovery"
severity = "medium"
observed = "The verify route durably consumes the pending token through signup::verify before calling issue_session separately. Entropy failure, a session journal failure or a lost response after verification leaves no retained verification result; retrying the same token returns verification_not_found instead of recovering the intended session."
expected = "Completing email verification and obtaining its session must have an explicit recoverable retry result across a process restart or interrupted response, without reusing the token to create unlimited sessions."
proposal = "Persist a bounded verification completion and session-result identity in the identity store and return that disposition for safe retries. Exercise failures between durable verification, session creation and response delivery using the real service and reopen the store."
owner_domain = 8
interface = "8.http-identity-post-v1-signup-verify"

[finding.identity-outbox-durability]
file = "services/platform/hosted/identity/src/main.rs"
line = 1029
class = "restart-recovery"
severity = "medium"
observed = "deliver_verification fsyncs a temporary mail file and renames it into the outbox without syncing the parent directory. The pending signup is already journaled. A power loss can remove the acknowledged outbox entry while leaving the pending signup durable, and the raw token is not recoverable from its stored digest."
expected = "An acknowledged pending signup must retain a deliverable verification message across a storage crash, or expose a recoverable failure disposition that can safely issue a replacement message."
proposal = "Make the identity verification outbox a durable transaction with pending signup state: sync directory publication, retain retryable delivery metadata and reconcile incomplete publications on restart. Cover crashes before and after rename and ensure no acknowledged signup silently loses its message."
owner_domain = 8

[finding.identity-smtp-deployment]
file = "services/platform/hosted/identity/deployment.yaml"
line = 23
class = "config-drift"
severity = "medium"
observed = "The identity deployment sets neither LAYERX_IDENTITY_SMTP_URL nor LAYERX_IDENTITY_SMTP_FROM, so the mailer remains disabled while signup can queue a verification message and report pending. Its egress NetworkPolicy permits only DNS, preventing an external SMTP connection even if delivery environment variables are added."
expected = "The deployed signup service needs an explicitly configured and reachable verification delivery path, with readiness or a declared operational disposition for delivery failures."
proposal = "Wire SMTP credentials and sender through the identity deployment secret/config contract, allow narrowly scoped mail egress, and include delivery readiness or an explicitly operated outbox consumer. Validate signup-to-delivery behavior through the deployed configuration."
owner_domain = 8
interface = "8.env-identity-layerx-identity-smtp-url"

[finding.identity-rate-window-restart]
file = "services/platform/hosted/identity/src/signup.rs"
line = 133
class = "restart-recovery"
severity = "medium"
observed = "Desk::new initializes empty per-IP and per-email rate windows on every restart, while the daily signup count is durable. Restarting the identity service therefore resets the configured hourly abuse limits within the same hour."
expected = "Configured signup rate limits must have a documented restart disposition and continue enforcing the active hourly window when the service restarts; the daily cap is a separate control."
proposal = "Persist bounded hourly admission counters with the identity store or put them in the authoritative shared limiter used by provisioning. Test a refusal before restart and the same refusal after reopen until the actual window expires."
owner_domain = 8

[finding.identity-expired-signup-growth]
file = "services/platform/hosted/identity/src/store.rs"
line = 514
class = "runtime-risk"
severity = "medium"
observed = "put_signup retains every pending token in State::signups and snapshots. Token expiry is checked during verification, but there is no expiry-removal lifecycle for abandoned signups. signup_days also retains every historical day. The daily admission cap limits the growth rate but not durable state size."
expected = "Expired verification tokens and completed admission windows need a bounded retention policy so long-running identity service state and restart time remain bounded."
proposal = "Add durable expiry reclamation for pending signups and obsolete rate-counter days in identity/store.rs, preserving verified email bindings and audit retention separately. Exercise many expired windows and reopen to prove bounded live state and refusal of expired tokens."
owner_domain = 8

[finding.identity-hourly-key-bound]
file = "services/platform/hosted/identity/src/signup.rs"
line = 125
class = "runtime-risk"
severity = "medium"
observed = "prune only removes windows from earlier hours when the map reaches MAX_TRACKED_KEYS; it retains every current-hour entry and admits another key. Admission inserts the client IP before checking the email limit. Repeated provisioning requests for an already rate-limited email with different client_ip values can therefore grow the IP map beyond the named bound without increasing the durable daily signup count."
expected = "Signup admission must bound tracked abuse-control state independently of successful signup count. Rejected requests must not turn the rate limiter into an unbounded memory consumer."
proposal = "Enforce a strict active-key capacity in identity/signup.rs before allocating a new window and return an explicit overload disposition or use a bounded authoritative limiter. Cover more than MAX_TRACKED_KEYS distinct IPs for one rate-limited email and verify both memory-state bounds and continued limits across the hour boundary."
owner_domain = 8

[finding.identity-signup-service-coverage]
file = "services/platform/hosted/identity/tests/service.rs"
line = 1
class = "test-gap"
severity = "medium"
observed = "The service integration suite exercises principals, sessions, introspection, publication-key resolution and restart, but never drives signup, the verification outbox or SMTP, token verification to session, or starter-credit settlement through the listener. Module unit tests do not prove these exposed routes and their recovery boundaries."
expected = "The signup and starter-credit product path must be covered from authenticated provisioning through durable identity state and the real transport, including restart and refusal behavior, as required by the brief path-proof rule."
proposal = "Extend identity/tests/service.rs with real listener signup, delivered-token verification, session introspection and one-time starter-credit grant/settlement. Reopen between steps and assert duplicate, expired, wrong-subject and interrupted-delivery outcomes without replacing the producer or consumer with a double."
owner_domain = 8

[finding.emulator-retired-route-registry]
file = "tools/platform/emulator/src/main.rs"
line = 1539
class = "retired-reference"
severity = "medium"
observed = "The current dispatcher intentionally returns 404 for activities, moves, move quotes and all program REST routes, and gateway.rs tests that retirement. Interface rows 8.http-emulator-post-v1-activities, 8.http-emulator-post-v1-moves, 8.http-emulator-post-v1-moves-quote and the programs deploy/call/simulate/upgrade rows still declare stable callable handlers from the older dispatcher."
expected = "Requirement 8323.1 and the retired programs-ingress decision require these routes to remain absent. The registry and consumer guidance must describe that retirement rather than promise the pre-merge ingress."
proposal = "Retire the obsolete emulator route rows and migrate their remaining callers and catalogue entries to the merged-node transaction path. Preserve the existing 404 checks and publish the supported emulator surface explicitly."
owner_domain = 8
interface = "8.http-emulator-post-v1-activities"

[finding.emulator-settlement-v2-contract]
file = "tools/platform/emulator/src/settlement.rs"
line = 51
class = "interface-mismatch"
severity = "high"
observed = "EvidenceDocument denies unknown fields and requires receipt plus verificationLevel sequencer-signed, then settled() emits receipt_base64 and authorized_batch. The current buyer emits format, rawTransaction, signedReceipt, receiptDigest, receiptKey and receipted/committed at middleware/buyer/src/index.ts:295; seller/src/index.ts:837 accepts exactly that v2 shape and expects a PortableReceiptV2 result. A verbatim current seller request is rejected and the legacy response cannot satisfy its result contract."
expected = "The stable emulator POST /v1/settle contract claims to admit the seller settlement request verbatim. A declared interface must round-trip the same receipt format, digest encoding, verification rung and result through producer, HTTP and consumer. The retired authorized-batch model is not merged-network finality."
proposal = "Have the platform owner decide and publish whether this legacy HTTP authority is retired or supported. If retained, implement the merged portable v2 receipt and block-commit contract end to end; otherwise retire its stable registry/example promise and use the current receipt authority. Prove the chosen path with actual buyer and seller producers, including restart."
owner_domain = 8
interface = "8.http-emulator-post-v1-settle"

[finding.emulator-settlement-receipt-wiring]
file = "tools/platform/emulator/src/main.rs"
line = 527
class = "wiring-gap"
severity = "medium"
observed = "settle only resolves receipts from emulator.receipts. Runtime initialization makes that map empty; receipt insertion is confined to snapshot decoding, and no registered fresh execution path populates it. Thus a newly booted emulator cannot settle a new payment even while its settlement route is advertised as usable."
expected = "A supported emulator payment path must obtain newly produced receipt evidence from the same execution path its consumers use, or clearly declare that settlement is unavailable and historical imports are inspection only."
proposal = "Connect supported payment emulation to the merged transaction and receipt producer with durable recovery, or remove the unsupported settlement promise from emulator discovery and examples. Test an actual new payment followed by settlement and reopen without reintroducing retired activity REST routes."
owner_domain = 8
interface = "8.http-emulator-post-v1-settle"

[finding.emulator-error-path-root]
file = "tools/platform/emulator/core/emulator_core.c"
line = 1318
class = "runtime-risk"
severity = "medium"
observed = "platform_emulator_execute declares roots without initialization. lxp_batch_roots_compute runs only while status is LXP_OK, but execution.activity_root is copied from roots.activity_merkle_root unconditionally after envelope or signature validation may have failed. Invalid requests therefore cause an indeterminate derived-root read on the error path."
expected = "Rejected input must return its typed refusal before any derived execution fact is consumed. A failed decode or signature check must not use an uncomputed root."
proposal = "Restructure emulator_core.c so failed validation returns before execution-root assembly, and consume computed roots only on the successful branch. Add malformed-envelope and invalid-signature cases through the supported C entry and assert stable refusal and unchanged state."
owner_domain = 8

[finding.emulator-retired-wire-dependency]
