line = 21
class = "retired-reference"
severity = "medium"
observed = "The emulator still directly depends on layerx-wire and its settlement implementation decodes legacy canonical protocol receipts. The retired wire-codec component names services/agent/crates/layerx-wire for deletion and replaces signed activity transport with EIP-1559 transactions."
expected = "An emulator for the finished merged network must use the kept transaction and portable receipt interfaces; a dependency on a component slated for deletion cannot remain an undocumented runtime requirement."
proposal = "Remove the retired wire dependency as the emulator settlement and evidence paths migrate or are retired. Keep the C host links needed by supported state/snapshot inspection, and qualify real merged transaction and receipt encoding instead of reviving the old activity transport."
owner_domain = 8

[finding.emulator-head-proof-coverage]
