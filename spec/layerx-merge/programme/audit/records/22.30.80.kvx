[finding.release-relative-git-fetch]
file = "tools/platform/release/src/fetch.rs"
line = 173
class = "interface-mismatch"
severity = "high"
observed = "fetch_git_archive passes destination unchanged to git -C <destination>.checkout archive --output. For a relative --fetch directory, Git interprets the archive destination inside the checkout, not the caller directory; the nested output parent is absent or the archive lands in the wrong place. The release workflow at platform.yml:1545 invokes --fetch build/release/verification for the Swift git archive."
expected = "The verify --fetch CLI must retrieve every published artifact under the supplied output directory and verify its bytes. Relative and absolute destinations must resolve to the same caller-selected location throughout clone, archive and verification."
proposal = "Normalize the fetch output to an absolute caller-relative path before entering git -C, and use that same path for archive and verification. Add a real tagged Git producer and invoke the CLI with relative and absolute fetch directories, asserting the emitted bytes and manifest digest."
owner_domain = 8
interface = "8.cli-release-layerx-platform-release-verify-fetch"

[finding.release-go-fixture-module]
file = "tools/platform/release/tests/manifest.rs"
line = 125
class = "test-gap"
severity = "medium"
observed = "go_record constructs a proxy URL for github.com/Sidiora-Labs/Layer-X-Protocol/platform/sdk/go and fixtures verify synthetic bytes through --from. Requirement 18820.1, the current registry and workflow use github.com/Sidiora-Labs/LayerX-Network/sdk/platform/go with sdk/platform/go/v<version> tags. The fixture therefore cannot prove the real Go publication locator."
expected = "Release fixtures must use the same canonical module path and prefixed version tag as the Go module, registry publication and fetching consumer; accepting a third historical locator hides a distribution mismatch."
proposal = "Derive the Go release fixture locator from the canonical module and registry declarations, retain digest/refusal checks, and prove that a produced module archive is fetched by the release verifier at the published locator and prefixed tag."
owner_domain = 8

[finding.release-git-fetch-timeout]
file = "tools/platform/release/src/fetch.rs"
line = 185
class = "runtime-risk"
severity = "medium"
observed = "HTTP artifact fetching has a 300-second global timeout and byte bound, but Git clone/archive use Command::output with no deadline or output bound. A stalled remote Git transport can hang release verification indefinitely, and a tagged tree is not constrained by MAX_ARTIFACT_BYTES."
expected = "All registry fetch schemes need bounded execution and storage consumption so release verification fails with a useful reason when a remote source stalls or exceeds supported size."
proposal = "Apply an explicit total deadline, bounded subprocess output and archive/disk size limit to the Git fetch scheme in release/fetch.rs. Kill and reap timed-out processes, clean incomplete checkouts, and test the refusal through the real Git subprocess path."
owner_domain = 8

