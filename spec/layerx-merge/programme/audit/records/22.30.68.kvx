line = 3
class = "doc-drift"
severity = "medium"
observed = "The overview describes separate settlement, custody and sequencer roles with independent trust boundaries at lines 3-20 and lists the old module model near line 38. Its statement that tenant chains share EVM state at lines 26-28 is correct, but the surrounding architecture still describes the pre-merge network."
expected = "Paxd and its embedded kernel form one BFT network; a receipt becomes final at commit with no separate sequencer service or external custody settlement boundary. Tenant domains namespace visibility while intentionally sharing EVM state."
proposal = "Rewrite docs/paxeer-network.md deployment, trust and finality sections around the single network and actual retained modules. Preserve the accurate shared-state tenant explanation and distinguish embedded acceptance from a retired standalone sequencer service."
