[finding.worker-submit-close]
file = "rpc/worker_pool.go"
line = 116
class = "runtime-risk"
severity = "medium"
observed = "SubmitWithMetrics and Submit release the closed-state RLock before sending. Close can then close taskQueue before that send. A select containing done does not make a send to a closed queue safe, so simultaneous submission and shutdown can panic outside a worker."
expected = "Configured simulation worker admission must return a closing/full error during shutdown and never panic in an RPC caller. Accepted work should retain the promised queue-drain behavior."
proposal = "In rpc/worker_pool.go, implement an atomic admission/closure protocol that prevents taskQueue closure while a sender can still enter it, without blocking Close on an undrainable submission. Add simultaneous Submit and SubmitWithMetrics versus Close coverage with real workers and assert accepted work drains and refused work returns an error."
owner_domain = 7
interface = "7.cfg-evm-worker-pool-size"

[finding.profiled-parent-cancel]
file = "rpc/block_trace_profiled.go"
line = 369
class = "runtime-risk"
severity = "medium"
observed = "The profiled execution watcher stops the tracer and EVM only for context.DeadlineExceeded. Parent cancellation resolves deadlineCtx with context.Canceled and exits the watcher, removing even the later timeout while expensive EVM execution continues."
expected = "A canceled request must stop expensive trace execution and release its resources. The configured timeout must not disappear merely because the parent was canceled first."
proposal = "In rpc/block_trace_profiled.go, distinguish normal completed execution from parent cancellation and stop the tracer/EVM for canceled live requests as well as expired deadlines. Join the watcher and exercise an actual long-running EVM trace with parent cancellation, asserting prompt termination and subsequent admission capacity."
