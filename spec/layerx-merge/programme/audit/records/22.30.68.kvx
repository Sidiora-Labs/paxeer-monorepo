[finding.tenant-raw-hash]
file = "rpc/raw_tx.go"
line = 54
class = "interface-mismatch"
severity = "high"
observed = "GetRawTransactionByHash returns pending, mempool and committed EVM envelopes without consulting DomainScopeFrom, domainAllowsTransaction or domainHashSet. A request on /chain/1 can retrieve a root or other tenant transaction hidden by ordinary getTransactionByHash."
expected = "Requirement 8368.1 makes transaction visibility tenant-scoped while root sees all domains. Registry row 7.rpc-eth-getrawtransactionbyhash-j38 must preserve that visibility in every lifecycle branch, with the same hash and envelope identity."
proposal = "In rpc/raw_tx.go, apply the appropriate pending/mempool domainAllowsTransaction and committed domain index checks before returning bytes. Retain rawEnvelopeForHash validation and prove root, own-domain and hidden-domain behavior through real mixed-domain HTTP and WebSocket requests for pending and committed transactions."
owner_domain = 7
interface = "7.rpc-eth-getrawtransactionbyhash-j38"

[finding.tenant-raw-number]
file = "rpc/raw_tx_index.go"
line = 43
class = "interface-mismatch"
severity = "high"
observed = "GetRawTransactionByBlockNumberAndIndex resolves the shared block then calls rawTransactionWithBlock without request context. The helper marshals the selected transaction even when its domain is hidden by the ordinary indexed transaction API."
expected = "Requirement 8368.1 and registry row 7.rpc-eth-getrawtransactionbyblocknumberandindex-j38 require the tenant view to hide other-domain transactions while retaining the canonical shared-block index, including the pending view."
proposal = "In rpc/raw_tx_index.go, thread context into rawTransactionWithBlock and use the same domainAllowsTransaction visibility rule as rpc/tx.go before marshaling. Add real mixed-domain transport assertions for own, root and other-domain transactions at canonical indices for committed and open blocks."
owner_domain = 7
interface = "7.rpc-eth-getrawtransactionbyblocknumberandindex-j38"

