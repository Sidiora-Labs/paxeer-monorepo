expected = "The published RPC catalogue must distinguish callable methods from subscription topics and include the actual configured HTTP/WebSocket dispatch set. Node px_getReceiptKeys is the intentional upstream consumed by the hosted relay, not a retired gateway duplicate."
proposal = "Repair tools/docs/gen-system-docs.sh to derive docs/system/rpc.md from the same served-method registration and subscription classification as rpc/served_methods.go. Regenerate method counts and rows, document transport/gate availability and include polling filters and the intentional node receipt-key upstream."
owner_domain = 7

[finding.precompile-catalogue-drift]
file = "docs/system/precompiles.md"
line = 32
class = "doc-drift"
severity = "medium"
observed = "The catalogue presents anchor, custody claims/verification and legacy external intent ABIs among current precompiles without an active-versus-retired distinction. The introductions and anchor/custody/exchange sections, including lines 1170-1210, 1285-1347, 1552-1562 and 2463 onward, can lead clients to depend on retired behavior."
expected = "The merged network has one execution and finality boundary. Historical ABI declarations may remain for decoding, but retired anchor/custody/intent operations must be labeled with their actual refusal or replay-only behavior rather than advertised as live services."
proposal = "Update tools/docs/gen-system-docs.sh and its precompile inputs so docs/system/precompiles.md separates live callable operations from retained historical ABI material, lists active addresses and explains retired-call refusal. Preserve ABI decoding documentation where replay still uses it."
