[finding.shared-server-lifetime]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 31
class = "runtime-risk"
severity = "medium"
observed = "api_client starts Stubr once in a detached task on the first tokio::test runtime, stores its handle process-wide, sleeps one second and then expects initialization. Each tokio::test owns a separate runtime. Slow startup can leave the Option empty; shutdown of the initializing test runtime can cancel the shared server tasks while later tests still reuse the Once and handle."
expected = "The explorer client suite needs an explicitly owned server lifetime and a bounded readiness result shared by every test; completion of one test must not invalidate another test connection."
proposal = "Give the test harness under services/explorer/services/libs/blockscout-client/crate/tests an explicitly owned runtime/server or a per-test server, await readiness with error propagation, and configure a request deadline so startup failure and server shutdown produce bounded diagnostic failures."
owner_domain = 14

[finding.real-producer-coverage]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 33
class = "test-gap"
severity = "medium"
observed = "All HTTP tests are routed to Stubr recordings from eth.blockscout.com; none starts the local BlockScout routers and views. Thus the suite checks a recorded upstream compatibility surface while local field changes, CHAIN_TYPE differences, access checks and backend recovery are outside its path. The fixture-only health sibling demonstrates that this distinction already matters."
expected = "The audit brief requires interface changes to be demonstrated along the actual producer, HTTP transport and typed consumer. Historical upstream recordings can supplement that proof but cannot stand in for the merged explorer."
proposal = "Add a focused integration path owned by services/explorer that starts the actual backend with controlled chain data and uses blockscout-client over HTTP, asserting identity, amounts, nullability, pagination and typed refusals; retain the upstream compatibility recordings with explicit provenance and version labels."
owner_domain = 14

[finding.refusal-coverage]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 52
class = "test-gap"
severity = "medium"
observed = "Every recording in this slice has response.status 200 and the HTTP tests only request successful reads. The real controllers expose invalid-address, missing-token and restricted-access branches, and HealthController returns 500 when indexing is unhealthy. No assertion checks the consumer status/body contract for those responses, malformed JSON or transport loss."
expected = "Registered public read interfaces must preserve invalid-input and access refusals and unhealthy status without treating them as successful data; the tests must demonstrate the real refusal branches and bounded failure behavior."
