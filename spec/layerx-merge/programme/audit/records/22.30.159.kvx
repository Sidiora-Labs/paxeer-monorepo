[finding.health-metadata]
file = "services/explorer/services/libs/blockscout-client/crate/tests/recorded/eth_blockscout_com/_api_health.json"
line = 8
class = "interface-mismatch"
severity = "high"
observed = "The recording supplies both metadata.blocks.latest_block and metadata.latest_block. it_works.rs:60-68 reads only the latter through models/health_check_response_metadata.rs:24. The local HealthController.health/3 at services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/health_controller.ex:38-44 emits metadata.blocks only, so decoding a real healthy response loses its block metadata."
expected = "Registry rows 14.http-get-api-health and 14.http-get-api-health-l564 reach the same controller. HealthApi must expose the actual metadata.blocks.healthy and metadata.blocks.latest_block database, cache and node numbers, without a fixture-only sibling field."
proposal = "Update the health OpenAPI input and generated metadata models under services/explorer/services/libs/blockscout-client to the local HealthController shape, regenerate this recording from that controller, and assert its block numbers through HealthApi over HTTP."
owner_domain = 14
interface = "14.http-get-api-health"
related_interfaces = ["14.http-get-api-health-l564"]

[finding.legacy-health]
file = "services/explorer/services/libs/blockscout-client/crate/tests/recorded/eth_blockscout_com/_api_v1_health.json"
line = 4
class = "test-gap"
severity = "medium"
observed = "The recording promises GET /api/v1/health returns 200 with data.latest_block_number, and it_works.rs:71-83 requires that legacy response. The local routers/api_router.ex:532-563 v1 scope has search, gas-price-oracle, supply and RPC translation but no health route; health is mounted at /api/health."
expected = "The suite should distinguish upstream-version compatibility recordings from methods actually supported by the merged explorer; a recorded 200 must not certify an absent local route."
proposal = "Have the explorer client owner explicitly version the legacy compatibility case, and add a real local-router assertion for the supported /api/health contract and the declared refusal for unsupported legacy health; document the supported method set in the client package."
owner_domain = 14

[finding.log-emitter]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 350
class = "interface-mismatch"
severity = "high"
observed = "address_logs only checks a nonempty page. Its recording and the local TransactionView.prepare_log/4 at views/api/v2/transaction_view.ex:358 emit the log origin under address, but models/log.rs declares address_hash: Option<AddressParam> with no serde rename. Successful decoding silently leaves the emitter absent."
expected = "The emitter address of every item from registry row 14.http-get-api-v2-addresses-address-hash-param-logs must reach the typed consumer with the same hash; the transaction destination smart_contract is a different address and cannot replace it."
proposal = "Correct the log field mapping in the client OpenAPI source and models/log.rs to the producer address field, then drive the actual AddressController logs route through AddressesApi and assert the emitter hash, including a log whose origin differs from the transaction destination."
owner_domain = 14
interface = "14.http-get-api-v2-addresses-address-hash-param-logs"

[finding.log-nullability]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 339
class = "interface-mismatch"
severity = "high"
observed = "All twelve recorded address logs have decoded objects and smart_contract objects. models/log.rs requires both fields as concrete structs. The local schemas/api/v2/log.ex:18-19 permits null for both, and TransactionView.process_decoded_log/1 at views/api/v2/transaction_view.ex:410-418 returns nil for undecodable events. One valid raw event therefore prevents typed decoding of its whole page."
expected = "Registry row 14.http-get-api-v2-addresses-address-hash-param-logs includes raw undecodable logs and nullable contract context; consumers must still expose topics, data, emitter and transaction identity for those events."
proposal = "Represent exactly the producer-declared nullable decoded and smart_contract fields in the client schema and regenerate models/log.rs. Extend the real controller-to-client test with an undecodable event and absent contract context, asserting raw log data remains available."
owner_domain = 14
interface = "14.http-get-api-v2-addresses-address-hash-param-logs"

[finding.holder-address]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 247
class = "interface-mismatch"
severity = "high"
observed = "token_holders and token_instance_holders at lines 247-248 and 282-283 assert only nonempty items. Both recordings and TokenView.prepare_token_holder/1 at views/api/v2/token_view.ex:98-103 emit address, whereas models/holder.rs:23-24 accepts address_hash: Option<AddressParam>. Every returned balance can decode without its holder identity."
expected = "Registry rows 14.http-get-api-v2-tokens-address-hash-param-holders and 14.http-get-api-v2-tokens-address-hash-param-instances-token-id-param-holders must preserve each holder address together with the exact token_id and value."
proposal = "Align Holder and its generating schema with TokenView address, and prove both actual holder routes through TokensApi with assertions on the checksum address, token ID and integer base-unit balance rather than list length alone."
owner_domain = 14
interface = "14.http-get-api-v2-tokens-address-hash-param-holders"
related_interfaces = ["14.http-get-api-v2-tokens-address-hash-param-instances-token-id-param-holders"]

[finding.nft-transfer-total]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 264
class = "interface-mismatch"
severity = "high"
observed = "The token transfer recording contains fifty ERC-1155 totals with token_id, token_instance, value and decimals; the address transfer recording also contains ERC-1155 totals. models/token_transfer_total.rs tries the untagged TotalErc20 variant first, whose two fields in models/total_erc20.rs are optional and whose decoder accepts extra fields. NFT totals thus match that first variant and discard the token ID and instance while the tests at lines 264-265 and 401-402 pass."
expected = "Registry rows 14.http-get-api-v2-tokens-address-hash-param-transfers and 14.http-get-api-v2-addresses-address-hash-param-token-transfers must carry the NFT identity emitted by TokenTransferView.prepare_token_transfer_total/1 at views/api/v2/token_transfer_view.ex:72-111. ERC-721 and ERC-1155 totals must remain distinguishable from fungible totals."
proposal = "Give the client a typed total decoder that selects the producer-defined NFT structure when token_id is present and validates its required fields. Prove real ERC-20, ERC-721 and ERC-1155 transfers through both HTTP routes, asserting token_id, instance.id, quantity and variant identity."
owner_domain = 14
interface = "14.http-get-api-v2-tokens-address-hash-param-transfers"
related_interfaces = ["14.http-get-api-v2-addresses-address-hash-param-token-transfers", "14.http-get-api-v2-token-transfers"]

[finding.pagination-transport]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 248
class = "interface-mismatch"
severity = "high"
observed = "The holders, validated blocks and NFT instance recordings already contain full fifty-item pages with next_page_params. GetTokenHoldersParams, GetTokenInstanceHoldersParams, GetNftInstancesParams and GetAddressBlocksValidatedParams expose identifiers only; their request methods send no cursor. The other paginated address and token methods likewise omit the returned paging fields. The suite never requests a second page, so typed clients cannot retrieve history beyond the first page."
expected = "Each paginated registry route must accept its own returned next_page_params through the client transport. This applies to blocks-validated, logs, nft/collections, address token-transfers and tokens, token holders and instances, instance holders, token transfers and transaction internal-transactions; counters and the all-balances array do not need a cursor."
proposal = "Extend the operation schemas and client parameter types under services/explorer/services/libs/blockscout-client with each backend-declared cursor, preserving full token-ID precision. Add a real backend-to-client multi-page read that forwards the returned cursor and asserts complete nonduplicated results and continuation after recreating the client."
owner_domain = 14
interface = "14.http-get-api-v2-tokens-address-hash-param-holders"
related_interfaces = ["14.http-get-api-v2-addresses-address-hash-param-blocks-validated", "14.http-get-api-v2-addresses-address-hash-param-logs", "14.http-get-api-v2-addresses-address-hash-param-nft-collections", "14.http-get-api-v2-addresses-address-hash-param-token-transfers", "14.http-get-api-v2-addresses-address-hash-param-tokens", "14.http-get-api-v2-tokens-address-hash-param-holders", "14.http-get-api-v2-tokens-address-hash-param-instances", "14.http-get-api-v2-tokens-address-hash-param-instances-token-id-param", "14.http-get-api-v2-tokens-address-hash-param-instances-token-id-param-holders", "14.http-get-api-v2-tokens-address-hash-param-transfers", "14.http-get-api-v2-transactions-transaction-hash-param-internal-transactions"]

[finding.contract-abi]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 143
class = "interface-mismatch"
severity = "high"
observed = "smart_contracts awaits get_smart_contract without inspecting its success model. The captured verified contract has abi as an array of 36 entries, as emitted by SmartContractView at views/api/v2/smart_contract_view.ex:207. models/smart_contract.rs declares abi: Option<String>; GetSmartContractSuccess can fall through to UnknownValue while the HTTP call still returns Ok. Its optimizations_runs field also differs from producer optimization_runs."
expected = "Registry row 14.http-get-api-v2-smart-contracts-address-hash-param must expose a verified contract ABI as structured ABI entries and its optimization_runs value; transport success alone is not a typed contract result."
proposal = "Correct the source OpenAPI contract and regenerate SmartContract with the actual ABI array and producer field names. Make the real SmartContractController-to-SmartContractsApi test parse the typed result and assert an ABI function and the optimization count, including the existing captured verified-contract case."
owner_domain = 14
interface = "14.http-get-api-v2-smart-contracts-address-hash-param"

