[finding.transaction-lifecycle]
file = "services/explorer/services/libs/blockscout-client/crate/tests/it_works.rs"
line = 213
class = "interface-mismatch"
severity = "high"
observed = "get_transaction and transactions exercise only mined transactions with a destination and a coin exchange rate. models/transaction.rs requires timestamp, block_number, status, to, gas_used, position, base_fee_per_gas and exchange_rate. The local TransactionView at views/api/v2/transaction_view.ex:471-524 emits null block fields for pending transactions, nil to for contract creation and a nullable Market fiat value; schemas/api/v2/transaction.ex:354-450 explicitly describes these nullable fields. A valid lifecycle response is relegated to UnknownValue or fails typed parsing."
expected = "Registry row 14.http-get-api-v2-transactions-transaction-hash-param and the transaction-list route must expose pending and committed transactions, contract creation and unavailable market pricing as distinct valid states. Chain finality is block commit, not the presence of a fiat-price field."
proposal = "Regenerate the client transaction model from the local backend lifecycle schema and prove real pending-to-committed and contract-creation reads through TransactionsApi, including unavailable coin pricing. Assert status and identity at each state without fabricating nonnull fields."
owner_domain = 14
interface = "14.http-get-api-v2-transactions-transaction-hash-param"
related_interfaces = ["14.http-get-api-v2-transactions"]

