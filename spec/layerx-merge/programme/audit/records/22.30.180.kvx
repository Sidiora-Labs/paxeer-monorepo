[finding.unsafe-default-auth]
file = "tools/paxctl/sidecar/server/auth.go"
line = 90
class = "security"
severity = "high"
observed = "An unset SEI_SIDECAR_AUTHN_MODE selects unauthenticated mode and BindAddress exposes :7777 on every interface; registered handlers include reset-data and governance signing with the unlocked keyring."
expected = "The operational task API must restrict destructive and signing actions to authorized callers; omission of a deployment setting must not grant network peers that authority."
proposal = "In tools/paxctl/sidecar/server/auth.go and serve.go, default to a loopback authenticated deployment, require an explicit isolated-development override for unauthenticated exposure, and refuse signing or destructive handlers on an unprotected listener."
owner_domain = 16
interface = "16.env-paxctl-sei-sidecar-authn-mode"

[finding.reset-live-or-validator-state]
file = "tools/paxctl/sidecar/tasks/reset_data.go"
line = 82
class = "runtime-risk"
severity = "high"
observed = "reset-data treats any failed RPC status probe as permission to erase data/ and writes priv_validator_state.json at height zero; the direct task handler checks neither a durable hold nor node mode nor process exit."
expected = "A data reset must require a confirmed stopped non-validator under a durable hold; a disabled or wedged RPC cannot prove that the node stopped, and validator anti-double-sign state must survive."
proposal = "In tools/paxctl/sidecar/tasks/reset_data.go, require a persisted workflow hold, corroborated process termination and verified full-node role before erasure; refuse active-validator identities and preserve last-sign state independently of chain data."
owner_domain = 16
interface = "16.cfg-paxctl-task-type-reset-data"

[finding.paxd-process-invisible]
file = "tools/paxctl/sidecar/tasks/restart_seid.go"
line = 22
class = "interface-mismatch"
severity = "high"
observed = "seidStartFinder requires /proc comm and argv to name seid start, so a running paxd start is never found; stop/restart fail when its RPC answers and can falsely report stopped when that RPC is unavailable."
expected = "The merged network's only chain daemon is paxd; stop-seid and restart-seid must discover and control the actual node process while preserving their published task identifiers."
proposal = "Adapt process discovery in tools/paxctl/sidecar/tasks/restart_seid.go, stop_seid.go and await_condition.go to the deployed paxd identity, pass it through explicit configuration and prove stop/restart against a real paxd child process."
owner_domain = 16
interface = "16.cfg-paxctl-task-type-restart-seid"

[finding.delete-resurrection]
file = "tools/paxctl/sidecar/engine/engine.go"
line = 308
class = "restart-recovery"
severity = "high"
observed = "RemoveResult cancels and deletes without joining the handler; runTaskSync still saves a successful canceled run unconditionally, and Save uses INSERT OR REPLACE without checking generation. Late completion can recreate a deleted row or overwrite a resubmission."
expected = "DELETE's true-deletion contract and per-ID task generations must prevent obsolete work from replacing a newer task or resurrecting deleted recovery state."
proposal = "In tools/paxctl/sidecar/engine, make terminal writes conditional on the persisted task generation and deletion state; retain a durable cancellation tombstone until the old handler has stopped and exercise DELETE/completion/resubmit interleavings."
owner_domain = 16
interface = "16.http-paxctl-delete-v0-tasks-id"

[finding.ready-lost-on-restart]
file = "tools/paxctl/sidecar/engine/engine.go"
line = 89
class = "restart-recovery"
severity = "medium"
observed = "NewEngine starts ready=false and RehydrateStaleTasks reads only running rows; a previously completed mark-ready is never replayed, while Submit of its existing completed UUID returns without restoring readiness."
expected = "After a sidecar-only restart, the persisted release/hold lifecycle must determine readiness consistently, including deterministic re-delivery of an already completed mark-ready."
proposal = "Persist and restore the effective hold/release state in tools/paxctl/sidecar/engine before serving probes, ordered against the newest hold; add a disk-backed restart case with only a completed mark-ready and repeated submission."
owner_domain = 16
interface = "16.http-paxctl-get-v0-healthz"

[finding.witness-duplication]
file = "tools/paxctl/sidecar/tasks/statesync.go"
line = 125
class = "security"
severity = "high"
