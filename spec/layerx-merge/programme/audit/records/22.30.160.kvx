[finding.absolute-source-path]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/verify/solc_compiler_cli.rs"
line = 162
class = "security"
severity = "high"
observed = "InputFiles::try_from_compiler_input joins each submitted source name to files_dir, rejects only ParentDir components, then creates and truncates the resulting file. An absolute source name replaces the temporary-directory prefix. proto_conversions.rs:175-178 preserves such PathBuf names and SolcCompiler::compile selects this path for versions below 0.4.11. A verification request can therefore overwrite service-writable files before compilation fails, including persistent compiler or service state."
expected = "Contract verification must treat source names as untrusted identifiers and keep every filesystem write inside the request temporary directory. Rejecting traversal must also reject rooted paths before any directory or file is created."
proposal = "In src/verify/solc_compiler_cli.rs and the request conversion boundary, validate all source names before writes, reject absolute/root/prefix/parent components, and create files relative to a private directory without following symlinks. Add multipart and standard-JSON regressions with old compiler versions proving an outside sentinel file is untouched; retain the existing parent-directory test."
owner_domain = 14

[finding.selfdestruct-cancun]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/import/runner/internal_transactions.ex"
line = 1026
class = "runtime-risk"
severity = "high"
observed = "empty_selfdestructed_contracts_bytecode excludes contracts created in the same transaction and clears contract_code on every remaining SELFDESTRUCT address. It runs in the normal internal-transaction Multi at line 210. Paxeer enables Cancun from timestamp zero in modules/evm/types/config.go:11,43-44; core/deps/geth/core/vm/instructions.go:923-939 still emits a SELFDESTRUCT trace for opSelfdestruct6780 when the existing contract code is retained. The importer consequently erases valid persisted explorer bytecode."
expected = "Explorer contract code must agree with the committed EVM state under EIP-6780: a pre-existing contract keeps its code after SELFDESTRUCT. Same-transaction creation and destruction, failed traces and fork rules must be distinguished."
proposal = "Replace the unconditional deletion rule in the internal-transactions runner with fork-aware committed-code reconciliation, respecting successful execution and transaction-local creation. Exercise a pre-existing contract, a contract created and destroyed in one transaction, reverted destruction and replay against the real node trace and eth_getCode producers; restore already misclassified address code."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-geth"

[finding.cache-restart-integrity]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/compiler/download_cache.rs"
line = 82
class = "restart-recovery"
severity = "medium"
observed = "DownloadCache::add_versions accepts a version directory whenever path.join(\"solc\").exists(), then publishes it as a cache hit. It does not verify that the entry is a regular non-symlink executable, matches the advertised checksum, or reports the expected version. The server loads these directories at startup, bypassing the checks applied by write_executable to fresh downloads."
expected = "A persisted compiler must retain the same integrity and identity guarantees after a service restart as a newly downloaded compiler. Corruption or a stale replaced binary must not become an executable cache hit."
proposal = "In src/compiler/download_cache.rs, revalidate cached binaries against trusted version/checksum metadata before admitting them, reject unsafe file types and quarantine or redownload invalid entries. Cover restart with a valid cache, truncated executable, wrong-version binary and symlink using the actual cache loading path."
owner_domain = 14

[finding.compiler-install-permissions]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/compiler/fetcher.rs"
line = 61
class = "security"
severity = "medium"
observed = "create_executable requests Unix mode 0777 and opens with create/truncate, while write_executable unlinks and recreates a predictable solc.tmp name. Actual permissions depend on the process umask, and the pathname open follows symlinks. With a group-writable cache or permissive umask another local writer can replace the executable between checksum validation of the downloaded bytes and execution/rename."
expected = "Downloaded compiler installation must preserve the checked bytes in a private, non-writable-by-peers executable and must not follow an attacker-controlled temporary pathname. Security must not depend on an undocumented umask."
proposal = "Install compilers in src/compiler/fetcher.rs through a randomly named create-new temporary file inside a private cache directory, use restrictive permissions such as 0700 or 0755 as policy requires, validate the installed bytes and atomically rename. Add permission and symlink-race regression coverage and document cache directory ownership."
owner_domain = 14

[finding.compiler-download-bounds]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/compiler/fetcher_list.rs"
line = 137
class = "runtime-risk"
severity = "medium"
observed = "ListVersionFetcher::fetch_json_versions and ListFetcher::fetch_file use reqwest::get directly with no configured total deadline or response-size cap; the latter buffers the complete body before checking its SHA256. Neither request calls error_for_status. A stalled or oversized compiler distribution response can hold startup/fetch waiters or consume unbounded memory."
expected = "Compiler discovery and downloads must terminate within configured limits, reject unsuccessful HTTP status codes and limit bytes before buffering or executing compiler content, while retaining checksum validation."
proposal = "Use a shared configured client in src/compiler/fetcher_list.rs with connection/total deadlines, explicit status handling and bounded streaming for both list JSON and binary downloads. Hash the bounded binary stream and report a typed fetch failure on timeout, oversized body or HTTP error; exercise these real HTTP response conditions."
owner_domain = 14

[finding.compiler-execution-deadline]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/verify/evm_compilers.rs"
line = 137
class = "runtime-risk"
severity = "medium"
observed = "EvmCompilersPool::compile waits for a semaphore permit without a queue deadline and awaits C::compile without an execution deadline. The old Solidity CLI at solc_compiler_cli.rs:22-28 awaits Command::output with no timeout or kill policy. A stuck compiler holds a finite compile permit indefinitely and queued verification requests continue to accumulate."
expected = "Verification jobs must have bounded admission, queue wait and execution lifetimes, and cancellation must reap their child compiler processes and release capacity for other users."
proposal = "Implement bounded admission and configured queue/execution deadlines in src/verify/evm_compilers.rs and all compiler subprocess adapters. On timeout or cancellation terminate and reap the process, release gauges/permits and return an explicit verification error. Cover permit recovery after a timed-out real child process."
owner_domain = 14

[finding.cbor-backward-bound]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/verify/cbor_auxdata.rs"
line = 124
class = "runtime-risk"
severity = "medium"
observed = "next_cbor_auxdata_value checks start == already_processed only while CBOR parsing fails. When CBOR parsing succeeds but its encoded trailing length is invalid, the outer loop decrements start without checking that lower bound. A valid CBOR value with an invalid length at the lower boundary can cross into an already processed region or underflow usize at zero, followed by an out-of-bounds slice."
expected = "Auxiliary-data extraction must return a normal verification error for malformed lengths and must never scan before already_processed or panic on malformed compiler bytecode."
proposal = "Guard every backward step in src/verify/cbor_auxdata.rs, including the successful-parse/invalid-length branch, with the same lower-bound check and checked arithmetic. Add Solidity and Vyper cases for a parseable CBOR value at offset zero with missing/wrong length bytes and at a nonzero processed boundary."
owner_domain = 14

[finding.metadata-address-parse]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/proto_conversions.rs"
line = 279
class = "runtime-risk"
severity = "medium"
observed = "decode_verification_metadata parses an explicitly supplied contract_address with Address::from_str but calls transpose().ok().flatten(), silently turning a malformed address into None. The chain_id remains present, so a supplied invalid contract identity becomes indistinguishable from intentionally omitted metadata."
expected = "Verification metadata must preserve the distinction between absent optional identity and an invalid identity supplied by the caller. Malformed addresses must be reported through the request parse error boundary."
proposal = "Make metadata decoding in src/proto_conversions.rs return a Result and propagate address parsing failures through RequestParseError in every Solidity and Vyper request conversion. Cover absent metadata, valid 20-byte addresses and malformed/short/overlong values through the public request conversion path."
owner_domain = 14

[finding.prerelease-validator]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/solidity/validator.rs"
line = 15
class = "runtime-risk"
severity = "medium"
observed = "SolcValidator::validate strips the executable-reported prerelease and build identifiers using semver::Version::new, then compares it with ver.to_semver(), which retains prerelease identifiers for DetailedVersion. The server installs this validator for downloaded Solidity compilers, so an otherwise matching advertised prerelease is rejected solely because only one side was normalized."
expected = "Compiler version validation must apply the same explicitly chosen prerelease/build identity policy to both the requested version and the executable-reported version, and accept a genuinely matching supported prerelease."
proposal = "In src/solidity/validator.rs compare identically normalized identities, or preserve and verify prerelease/commit fields on both sides if that is the supported policy. Add matching and mismatching release/beta/rc cases using compiler version output and the actual DetailedVersion conversion, preserving rejection of a wrong compiler."
owner_domain = 14

[finding.massive-retry-discard]
file = "services/explorer/backend/apps/indexer/lib/indexer/block/catchup/massive_blocks_fetcher.ex"
line = 78
class = "restart-recovery"
severity = "medium"
observed = "MassiveBlocksFetcher.process_block deletes the persistent MassiveBlock marker for every {:ok, _result}. Block.Fetcher.fetch_and_import_range explicitly returns {:ok, %{inserted: ..., errors: blocks_errors}}, including per-block RPC errors. A failed block can therefore be declared successfully processed and lose its dedicated retry marker; finite configured missing-range scans need not rescan it until restart."
expected = "A massive-block retry marker must remain durable until that exact block was imported successfully without a per-block fetch error. Transport-level success alone does not prove block ingestion."
proposal = "In block/catchup/massive_blocks_fetcher.ex inspect errors and the actual import result for the requested height before deleting its marker; keep/requeue failures. Exercise an HTTP-success batch containing a per-block RPC error and a restart with a finite block range, followed by successful retry."
owner_domain = 14
