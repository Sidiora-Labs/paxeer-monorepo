[finding.massive-range-handoff]
file = "services/explorer/backend/apps/indexer/lib/indexer/block/catchup/fetcher.ex"
line = 274
class = "restart-recovery"
severity = "medium"
observed = "add_range_to_massive_blocks first clears MissingBlockRange entries and only then calls MassiveBlock.insert_block_numbers in a separate operation. A process crash or database failure between those steps leaves the timed-out range in neither durable retry store. A finite range collector performs its initial scan once, so it need not repair this gap during the same run."
