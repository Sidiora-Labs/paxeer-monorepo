[interface_review.01]
interface = "14.met-rs-smart-contract-verifier-smart-contract-verifier-compilation-queue-time-seconds"
direction = "produces"
status = "agrees"
producer = "services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/metrics.rs:34"
signature = "register_histogram!(\"smart_contract_verifier_compilation_queue_time_seconds\", \"waiting for the compilation queue in seconds\") -> COMPILATION_QUEUE_TIME: Histogram"
notes = "Registry aliases describe the same seven collectors in src/metrics.rs, not duplicate registrations. Timers record seconds, counters count cache access/hits, and guarded gauges count queued/in-flight jobs. Lazy collectors register with prometheus default_registry, which the launcher exports on configured /metrics (default port 6060) when metrics.enabled is true; enabled defaults false. Process-local metrics reset on restart, not durable job state."

