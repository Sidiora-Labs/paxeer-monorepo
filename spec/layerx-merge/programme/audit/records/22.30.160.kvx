[finding.catchup-monitor-cleanup]
file = "services/explorer/backend/apps/indexer/lib/indexer/block/catchup/bound_interval_supervisor.ex"
line = 273
class = "runtime-risk"
severity = "medium"
observed = "The timeout/network-error task-result handlers enqueue :catchup_index and set task to nil without Process.demonitor(ref, [:flush]); the successful result handlers do demonitor. A normal subsequent DOWN notification reaches the task:nil handler at line 334 and enqueues another immediate retry, or arrives after a replacement task has started without a matching handler. Network failures can thus duplicate retries or restart the supervisor."
