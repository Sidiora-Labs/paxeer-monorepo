[interface_review.66]
interface = "7.ws-eth-subscribe-newheads"
direction = "consumes"
status = "agrees"
producer = "rpc/subscribe.go:185"
signature = "func (a *SubscriptionAPI) NewHeads(ctx context.Context) (s *rpc.Subscription, err error)"
notes = "rpc/subscribe.go emits committed newHeads over eth_subscription with hex number, 32-byte hash and parentHash and the full header. Realtime.Fetcher pattern-matches number/hash and accepts additional header fields, checks parentHash and refetches canonical blocks/receipts by range. Subscription errors retain polling; catchup reconstructs missing ranges from persistent blocks after restart. No separate sequencer or speculative head is required."
