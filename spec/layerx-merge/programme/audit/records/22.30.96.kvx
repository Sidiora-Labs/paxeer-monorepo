[finding.f16]
file = "services/agent/crates/layerx-agentd/src/prepare/expiry.rs"
line = 822
class = "runtime-risk"
severity = "medium"
observed = "PreparationLifecycle stores every registration in a BTreeMap, and sweep_retention only clears terminal signed_bytes. It never removes terminal records or their other metadata, so a long-running daemon accumulates one retained entry per historical preparation."
expected = "Retention must bound completed preparation memory while preserving unresolved signed bytes and the idempotency information needed for safe redelivery. Discarding only transaction bytes does not bound lifecycle metadata."
proposal = "Define a bounded terminal-history policy in prepare/expiry.rs backed by durable idempotency records, evict eligible terminal entries after the retention horizon and retain unresolved operations. Exercise repeated completion/sweep/restart without losing duplicate protection."
owner_domain = 9

