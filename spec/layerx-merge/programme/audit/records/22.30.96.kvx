[finding.f09]
file = "services/agent/crates/layerx-client/src/px.rs"
line = 169
class = "interface-mismatch"
severity = "high"
observed = "quantity limits hexadecimal values to 32 digits and returns u128; PxPaxeerAccount.balance and bank balance carriers also use u128. The gateway serves eth_getBalance uint256 and decimal bank uint256 values, so valid balances at or above 2^128 cannot round-trip."
expected = "The gateway declares full on-chain 256-bit balance values and exact decimal bank amounts. Rust must retain the producer range without reducing a valid quantity to Malformed or silently narrowing it."
