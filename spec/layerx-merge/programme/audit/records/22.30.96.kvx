class = "retired-reference"
severity = "medium"
observed = "The public legacy preparation module remains exported by pub use legacy::* at line 953. prepare_activity_for_protocol still builds UnsignedEnvelope and canonical kernel bytes, while restore_canonical reconstructs that retired preparation path."
expected = "Requirement 22063.1 explicitly removes legacy preparation modules, canonical restore, kernel envelope encoders and canonical-byte binders from the daemon; ordinary writes are prepared as type-2 transactions."
