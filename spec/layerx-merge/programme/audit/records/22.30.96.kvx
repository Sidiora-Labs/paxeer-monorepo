[finding.f47]
file = "services/agent/crates/layerx-client/src/subscription.rs"
line = 203
class = "runtime-risk"
severity = "medium"
observed = "receive loops indefinitely over Ping and Pong messages. Socket read/write timeouts bound each I/O, but a peer sending control messages before each timeout can prevent next or close from ever returning application data or a deadline failure."
expected = "A network-facing client operation must have a bounded total wait for its requested response, including control traffic and unsubscribe. Per-I/O inactivity timeouts alone do not provide that bound."
proposal = "Track an absolute operation deadline in subscription.rs and apply the remaining budget to reads and control-frame flushing, with an explicit cancellation option for streaming waits. Exercise control traffic that never produces the requested response."
owner_domain = 9

