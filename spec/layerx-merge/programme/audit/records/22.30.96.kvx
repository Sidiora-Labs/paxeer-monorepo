[finding.f11]
file = "services/agent/crates/layerx-client/src/ai_market.rs"
line = 1569
class = "restart-recovery"
severity = "medium"
observed = "OperationJournal is Clone and permits multiple opens, but persist uses one fixed .partial path and File::create without a lock or generation check. record_signed can overwrite an existing later state, and load rewrites Submitting to Unknown even if another instance is actively submitting."
expected = "A durable exact-byte journal must preserve monotonic lifecycle state and recover interrupted work without racing a live writer. Atomic rename protects one replacement, not concurrent transitions or stale record snapshots."
proposal = "Serialize each operation with process-safe ownership, exclusive unique temporary files and generation-checked monotonic updates in ai_market.rs. Make repeated signed registration idempotent without overwriting later states, and recover Submitting only after acquiring ownership; exercise concurrent opens and stale writes."
owner_domain = 9

[finding.f12]
file = "services/agent/crates/layerx-types/src/program_lifecycle.rs"
line = 155
class = "runtime-risk"
severity = "medium"
observed = "validate_code permits WASM up to 1048576 bytes, and NativeProgramDeploy::encode appends the 104-byte header and optional interface without checking the final payload size. It can successfully encode a deployment later rejected by Payload::new at 524288 bytes."
expected = "Brief fact 6 and decision 2483 require the entire deployment payload to fit 524288 bytes including the 104-byte envelope and any additional interface bytes; a successful deployment encoder should respect that product bound."
proposal = "Apply the checked final encoded payload limit in program_lifecycle.rs for deployment and applicable upgrades. Budget the fixed header and optional interface before allocation, and cover exactly fitting, one-byte-over and interface-bearing payloads against the downstream native admission path."
owner_domain = 9

