line = 857
class = "interface-mismatch"
severity = "high"
observed = "decode_history_page accepts exactly items, next_cursor and indexedHeight; history then claims the served page has no chain height. The registered gateway history.rs::served always adds account, chainHeight and freshness through envelope, so valid gateway history is rejected before the additional head read."
