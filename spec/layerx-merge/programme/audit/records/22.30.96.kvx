[finding.f01]
file = "services/agent/crates/layerx-client/src/ai_market.rs"
line = 1748
class = "interface-mismatch"
severity = "high"
observed = "OperationJournal::resolve persists receipt.global_sequence(), but finalize compares that sequence to CommitFinality.block_height and marks the operation Finalized. A sequence of 7 executed at height 150 can therefore be covered by an unrelated commit at height 7."
expected = "Receipt sequence and execution height are separate coordinates in pax_sequencerReceipt. Finality must establish that the committed MsgSequenceBatch covers the signed receipt sequence and resulting state root, at or after its execution height."
proposal = "In layerx-client/src/ai_market.rs persist the authenticated execution height and coverage facts in a versioned journal record. Finalize only with a verified covering block and matching receipt root; migrate existing records without inventing missing evidence. Exercise sequence 7 at height 150 across reopen."
owner_domain = 9
interface = "9.rs-client-ai-market-operationjournal-j44"

[finding.f02]
file = "services/agent/crates/layerx-client/src/rpc/module_state.rs"
line = 48
class = "interface-mismatch"
severity = "high"
observed = "module_state obtains two eth_call answers and compares their bytes, block hash and stateRoot with caller-supplied context. No storage witness is requested or verified, so a server can return the same false value twice under the genuine block root."
expected = "Requirements 9252.1, 9252.2 and 92513.1 require the derived module slot value to be verified with an ICS23 storage witness under the committed block stateRoot. Repeating a response does not bind it to that root."
proposal = "Wire SequencerEndpoint::storage_witness and storage_witness::verify_storage_witness into rpc/module_state.rs using the module slot derivation and a verified committed header. Return only the witnessed value, and refuse a different slot, value, store root or app hash."
owner_domain = 9
interface = "9.rs-client-read-module-state"

[finding.f03]
file = "services/agent/crates/layerx-client/src/rpc/evidence.rs"
line = 42
class = "interface-mismatch"
severity = "high"
observed = "proof_bundle ignores _address and _slots and returns ProofBundle containing only landing_block. proof_bundle_with_history delegates to the same operation, so distinct requested storage keys produce indistinguishable bundles without any storage evidence."
expected = "Requirement 9265.1 declares a bundle containing requested proof material and the landing block; its replacement requirement 92513.1 requires verified ICS23 storage witnesses under the committed block stateRoot."
proposal = "Extend rpc/evidence.rs to acquire the requested address and slot witnesses from the node, verify them under a verified committed root, and retain their identities and values with the landing block. Refuse absent or mismatched evidence and cover every requested slot."
owner_domain = 9
interface = "9.rs-client-evidence-proof-bundle"

[finding.f04]
file = "services/agent/crates/layerx-client/src/ai_market.rs"
line = 156
class = "security"
severity = "high"
observed = "CommitFinality::new accepts arbitrary nonzero block/app hashes and a proof digest. ObservedSnapshot::finalize copies the capture root into FinalityEvidence and assigns FINALIZED_RANK; bind_snapshot checks structural consistency but verifies neither a Comet commit nor an ICS23 witness relating those hashes to that root."
expected = "A proof-bound finalized market view must originate from the block commit verifier and a program-state witness for the same root. The public finalized API must not upgrade caller assertions into verified finality merely because their digests are nonzero."
proposal = "Have ai_market.rs consume an opaque verified commit plus verified program-state witness from the real node evidence path. Bind chain, height, block, app root and captured program root before constructing FinalizedSnapshot; keep unverified digest carriers explicitly unverified and test foreign-root evidence."
owner_domain = 9

[finding.f05]
file = "services/agent/crates/layerx-client/src/rpc/receipt.rs"
line = 207
class = "interface-mismatch"
severity = "high"
observed = "lookup_authenticated discards the blockNumber/blockHash of SequencerReceipt::Committed, then promotes to Rung::Committed from an unsigned eth_getTransactionReceipt when its status agrees and height is at least execution.height. No Comet commit or sequence/state-root coverage is verified."
expected = "The shared Rung::Committed contract requires verified block commitment. Requirement 9262.2 describes the narrower height/status check that this code satisfies, but that check alone cannot establish the evidence promised by Rung and the merged-network brief."
proposal = "In rpc/receipt.rs retain the producer covering-block coordinates, verify that block commit against the validator set and establish signed receipt sequence/root coverage before promotion. Preserve Receipted on missing evidence; align requirement 9262.2 with the shared rung contract and permit a proven later covering block."
owner_domain = 9
interface = "9.rs-client-receipt-lookup-authenticated"

[finding.f06]
