[finding.f15]
file = "services/agent/crates/layerx-agentd/src/prepare/expiry.rs"
line = 118
class = "retired-reference"
severity = "medium"
observed = "PreparationLifecycle::register_inner still reads expiry and payload hash from prepared.envelope, and retains a separate PreparationAuthorization path. Lifecycle storage therefore remains coupled to the legacy kernel preparation exported by prepare/mod.rs."
expected = "Requirements 22056.2, 22058.1 and 22063.1 require lifecycle facts to be derived from the call and bound disclosure and remove the second authorization carrier and kernel preparation dependency."
proposal = "Migrate expiry.rs registration, durable restoration and admission to the call-bound preparation facts, with tenant/session identity retained in its owning store. Prove reservation release and unresolved signed-byte recovery after reopen before deleting envelope-based fields."
