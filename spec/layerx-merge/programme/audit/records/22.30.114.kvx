[finding.1]
file = "apps/wallet/src/lib/swap/sdk/abis/Application.ts"
line = 22
class = "interface-mismatch"
severity = "high"
observed = "SIDIORA_ROUTER_ABI declares swapTokenToToken(address,address,uint256,uint256,uint256) with one uint256 return; executor.ts:158 encodes that selector for the generation-2 Router address."
expected = "The served Router ABI in precompiles/launchpad/abi/Router.json:951 and contracts/launchpad/contracts/interfaces/IRouter.sol:110 declares swapTokenForToken with two uint256 returns, amountOut and intermediateUsdl."
proposal = "Regenerate the wallet Application ABI from the generation-2 role ABI and update the executor call and return decoding together; domain 12 should prove a funded token-to-token swap through the domain-4 producer, committed receipt and received balance."
owner_domain = 12
interface = "12.ts-app-sidiora-router-abi"

[finding.2]
file = "apps/wallet/src/lib/portfolio-api/watch.ts"
line = 17
class = "interface-mismatch"
severity = "high"
observed = "watchAddress posts and unwatchAddress deletes /api/v2/watch through portfolioApiBase=/wallet/api/wallet; apps/wallet/src/app/api/wallet/[...path]/route.ts exports mutation handlers that return HTTP 405 before contacting the producer."
expected = "The registered watchAddress and unwatchAddress interfaces must start and stop tracking at the indexer backend, with a successful response only after the requested tracking lifecycle change."
proposal = "Domain 12 should provide explicit authenticated bounded watch mutation routes connected to the domain-14 watch service, preserve its status/error body, and prove create, read, delete and restart behavior through the real proxy."
owner_domain = 12
interface = "12.ts-app-lib-portfolio-api-watch-watch-address"

[finding.3]
file = "apps/wallet/src/lib/portfolio-api/webhooks.ts"
line = 23
class = "interface-mismatch"
severity = "high"
observed = "createWebhook, updateWebhook and deleteWebhook use POST, PATCH and DELETE through the same /wallet/api/wallet proxy; every mutation is answered locally with HTTP 405, so the advertised webhook lifecycle never reaches its producer."
expected = "The registered webhook methods must round-trip their snake_case request and response through an authorized mutation transport to the backend that owns webhook persistence and delivery."
proposal = "Domain 12 should wire dedicated authorized webhook mutation handlers to the domain-14 API, retaining endpoint validation and ownership checks; prove creation, update, deletion, delivery lookup and recovery after service restart."
owner_domain = 12
interface = "12.ts-app-lib-portfolio-api-webhooks-create-webhook"

[finding.4]
file = "apps/wallet/src/lib/swap/executor.ts"
line = 190
class = "runtime-risk"
severity = "high"
observed = "executeV4Multihop never uses quote.amountOut; it executes two transactions with helpers that obtain fresh per-leg quotes and compute new minimums. A moved second-leg price can settle below the final minimum the user confirmed."
expected = "The final output protection must be derived from the confirmed route output and user slippage, including the Sidiora/PECOR bridge route; a fresh quote cannot silently replace that authorized economic bound."
proposal = "Domain 12 should carry the immutable confirmed final minimum and expiry through execution and enforce them on the final leg; use a supported atomic route where available, or obtain an explicit staged confirmation and expose bridge-asset recovery."
owner_domain = 12
interface = "12.ts-app-lib-swap-executor-execute-swap"

[finding.5]
file = "apps/wallet/src/lib/swap/executor.ts"
line = 214
class = "restart-recovery"
severity = "medium"
observed = "The mixed-protocol path commits the first transaction, then holds only its receipt and USDL amount in memory. A rejected second signature, failed second transaction or reload leaves no persisted leg identity for safe continuation."
expected = "A multi-transaction wallet operation must preserve committed progress and reconcile it before retry, so the user can resume from the bridge balance without repeating the initial conversion."
proposal = "Domain 12 should persist wallet, chain, route, confirmed bounds, first-leg hash and exact received USDL before starting leg two; reconcile receipts on reload and offer a bounded resume or retain-bridge-assets action."
owner_domain = 12
interface = "12.ts-app-lib-swap-executor-execute-swap"

[finding.6]
file = "apps/wallet/src/lib/swap/sdk/sidiora.ts"
line = 211
class = "interface-mismatch"
severity = "high"
observed = "The exported swapTokenToToken SDK helper calls router.swapTokenToToken at CONTRACTS.Router, so direct SDK consumers encounter the same unsupported selector independently of the wallet executor."
expected = "Generation-2 IRouter exposes swapTokenForToken and returns amountOut plus intermediateUsdl; the exported wallet helper must encode that method when targeting the configured generation-2 surface."
proposal = "Domain 12 should change the SDK generator and helper to call the producer method with the confirmed bound, regenerate its ABI, and prove successful execution plus a below-minimum rejection against the generation-2 role."
owner_domain = 12
interface = "12.ts-app-sidiora-router-abi"

[finding.7]
file = "apps/wallet/src/lib/swap/executor.test.ts"
line = 390
class = "test-gap"
severity = "medium"
observed = "sidiora_multihop_min_out_uses_confirmed_quote expects CALL_EXCEPTION during estimateGas and then asserts calldata for the unsupported swapTokenToToken method; the test can pass while every multihop swap fails."
expected = "Requirement 18755.1 needs confirmed minimum protection on an executable Sidiora multihop path; calldata recovered from an expected selector failure does not establish a successful producer/consumer round trip."
proposal = "Domain 12 should retain the confirmed-minimum assertions and add a successful funded generation-2 multihop receipt and balance check, followed by an independently induced price move that fails specifically on the minimum-output condition."
owner_domain = 12
interface = "12.ts-app-sidiora-router-abi"

[finding.8]
file = "apps/wallet/src/lib/swap/quoter.ts"
line = 16
class = "wiring-gap"
severity = "medium"
observed = "getProvider creates one JsonRpcProvider from the build-time RPC_URL and retains it forever, while wallet signing follows the active network. Network changes can leave route discovery and price reads on the root or previous endpoint."
expected = "Requirement 20007.1 requires active virtual-network reads and writes to agree on the selected tenant RPC namespace; a quote must identify the chain and endpoint that produced it."
proposal = "Domain 12 should supply an active-network provider to the quoter, include chain identity and expiry in each quote, and invalidate outstanding quotes and pool discovery when the selected network changes."
owner_domain = 12
interface = "12.ts-app-get-swap-quotes"

[finding.9]
file = "apps/wallet/src/lib/constants.ts"
line = 13
class = "wiring-gap"
severity = "medium"
observed = "All indexer and portfolio bases are fixed root proxy paths, even though getActiveRpcUrl selects virtual networks. The proxy forwards path/query to one BLOCKSCOUT_UPSTREAM_BASE with no selected-tenant parameter."
expected = "Requirement 20007.1 and brief fact 5 require virtual-chain reads to describe the same tenant as the selected <rpc>/chain/<id> write endpoint; root-chain portfolio data must not stand in for tenant balances."
proposal = "Domain 12 should define an explicit tenant-aware wallet BFF contract with domain 14, route every address/token/history read with validated selected-chain identity and scope server caches to that identity."
