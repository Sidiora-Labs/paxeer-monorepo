[finding.replay-deployment-identity]
file = "programs/crates/layerx-programs-registry/src/lib.rs"
line = 606
class = "interface-mismatch"
severity = "high"
observed = "record_verified_deployment stores evidence.receipt_digest(), which is the transaction SHA-256. replay_journal instead stores record.digest(), the hash of domain-framed DeploymentRecord bytes. resolve_deployment compares the stored value with the original transaction digest, so replaying the record of a successfully admitted deployment changes its identity and refuses the same verified evidence."
