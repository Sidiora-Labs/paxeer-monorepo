[finding.ss-restore-completion]
file = "sdk/storev2/rootmulti/store.go"
line = 915
class = "restart-recovery"
severity = "high"
observed = "restore starts ssStore.Import in a goroutine, closes its input without joining it, and publishes earliest/latest version metadata before import completion. Import errors panic asynchronously and metadata errors are only logged, including after restoreErr. storage/state_db/ss/composite/store.go Import returns only after its import workers finish."
expected = "A successful snapshot restore must mean that both commitment state and query history at that height are durable and immediately readable, with one recoverable completion boundary across restart."
proposal = "In sdk/storev2/rootmulti/store.go join the SS importer, cancel and drain it on read or SC failure, return import and metadata errors, and publish version metadata only after all imports succeed. Coordinate domain 5 SS durability and prove immediate historical query, failed import and restart through the real storage backend."
owner_domain = 15
interface = "5.go-storage-state-db-ss-new-state-store"

[finding.future-query-height]
file = "sdk/storev2/rootmulti/store.go"
line = 691
class = "interface-mismatch"
severity = "high"
observed = "Store.Query converts any height above lastCommitInfo.Version to scStore.Version. sdk/baseapp/abci.go handleQueryStore then overwrites ResponseQuery.Height with the original requested height. A request for a future height can therefore receive current values and proofs labeled as that future height."
expected = "ABCI RequestQuery.Height and ResponseQuery.Height must identify the same committed state; an unavailable future version must return an explicit query error rather than substitute a different state."
proposal = "Reject heights above the committed tip in sdk/storev2/rootmulti/store.go and retain the actual resolved response height in sdk/baseapp/abci.go. Add real BaseApp-to-CMS queries for zero, tip and future heights, with and without proofs and SS enabled, asserting value, proof, error code and response height together."
owner_domain = 15
interface = "5.go-consensus-abci-types-request-query"

[finding.slashing-window-last-bit]
file = "sdk/x/slashing/keeper/infractions.go"
line = 166
class = "runtime-risk"
severity = "high"
observed = "ResizeMissedBlockArray copies the prefix before index but copies the suffix only when index+1 < old WindowSize. At index oldWindow-1 a set final bit is dropped while MissedBlocksCounter is unchanged. HandleValidatorSignatureConcurrent then updates the new zero slot, leaving a phantom miss that can cause premature slash or jail."
expected = "Changing SignedBlocksWindow must preserve every retained missed-signature bit and keep MissedBlocksCounter equal to the population of the persisted window so validators are penalized only for actual missed votes."
proposal = "In sdk/x/slashing/keeper/infractions.go retain the suffix beginning at index even at the last old slot, maintain the bitmap/counter invariant and document insertion semantics. Exercise governance expansion at every circular offset with real set bits, then restart and run BeginBlock through the penalty threshold."
owner_domain = 15
interface = "7.proto-cosmos-slashing-v1beta1-validatormissedblockarray-j39"

[finding.slashing-resize-fixture]
file = "sdk/x/slashing/keeper/infractions_test.go"
line = 22
class = "test-gap"
severity = "medium"
observed = "TestResizeMissedBlockArray creates ten uint64 words for a ten-bit window, sets no bits, and pairs that empty bitmap with MissedBlocksCounter=5. Assertions inspect sizes and unchanged counters but never the bits or the old final offset."
expected = "The test must start with the packed bitmap emitted by the live keeper, a counter equal to its set bits, and boundary offsets that expose loss or duplication during expansion."
proposal = "Replace the fixture in sdk/x/slashing/keeper/infractions_test.go with real packed missed votes, assert all retained bit positions and population counts, and cover index oldWindow-1 followed by live BeginBlock processing and persisted reload."
owner_domain = 15
interface = "7.proto-cosmos-slashing-v1beta1-validatormissedblockarray-j39"

[finding.slashing-event-order]
file = "sdk/x/slashing/abci.go"
line = 40
class = "runtime-risk"
severity = "medium"
observed = "BeginBlocker launches one HandleValidatorSignatureConcurrent call per vote; that function emits liveness events directly into the shared EventManager at infractions.go:75. Ordered state writes after Wait do not restore vote order for those events; the EventManager mutex protects append safety but scheduler order still decides event order."
expected = "The same committed votes should produce a stable ordered stream of validator events for indexers and consumers, independently of goroutine scheduling."
proposal = "Return per-vote liveness events with SlashingWriteInfo and emit them in the existing ordered write loop in sdk/x/slashing/abci.go. Add a repeated real BeginBlock test with several missing validators that compares complete event order and attributes."
owner_domain = 15
interface = "15.go-x-slashing-types-event-type-liveness-j76"

[finding.slashing-rest-producer-encoding]
file = "sdk/x/slashing/client/rest/query.go"
line = 46
class = "interface-mismatch"
severity = "high"
observed = "signingInfoHandlerFn serializes pk.Address().String(), the consensus library hexadecimal address, into QuerySigningInfoRequest.ConsAddress. The gRPC and CLI request contract uses a Bech32 consensus address; the legacy consumer also fails to decode text, so the HTTP route cannot find the record keyed by the original address bytes."
expected = "The REST producer, ABCI transport and signing-info keeper must exchange one canonical consensus address and resolve exactly the same persisted validator record."
proposal = "In sdk/x/slashing/client/rest/query.go construct sdk.ConsAddress(pk.Address()).String(), coordinate the explicit Bech32 decoder in keeper/querier.go, and run a real registered HTTP-to-ABCI query against a persisted signing record with exact address and error assertions."
owner_domain = 15
interface = "7.proto-cosmos-slashing-v1beta1-querysigninginforequest-j39"

[finding.slashing-legacy-consumer-encoding]
file = "sdk/x/slashing/keeper/querier.go"
line = 51
class = "interface-mismatch"
severity = "high"
observed = "querySigningInfo casts params.ConsAddress directly to sdk.ConsAddress. This converts the string to its ASCII bytes rather than decoding either the REST hexadecimal producer or the canonical Bech32 request, while GetValidatorSigningInfo keys records by raw consensus address bytes."
expected = "QuerySigningInfoRequest.ConsAddress must decode to the same raw address used by signing_info.go, matching the gRPC consumer and preserving invalid-address and missing-record errors."
proposal = "Decode the canonical Bech32 consensus address explicitly in sdk/x/slashing/keeper/querier.go and return a typed invalid-address error before lookup. Coordinate the REST producer change and prove REST, CLI and gRPC return the same real stored signing info, including malformed and unknown addresses."
owner_domain = 15
interface = "7.proto-cosmos-slashing-v1beta1-querysigninginforequest-j39"

[finding.upgrade-name-order]
file = "sdk/x/upgrade/keeper/keeper.go"
line = 300
class = "runtime-risk"
severity = "high"
observed = "GetClosestUpgrade seeds closest from the first reverse name-key entry even if its height is below the requested height. With z-old at 10 and a-new at 20, requesting 18 returns z-old at 10; requesting beyond all upgrades also returns a name. node/app.go RPCContextProvider and SnapshotAwareRPCContextProvider consume this value as the historical EVM upgrade name."
expected = "Historical EVM contexts must select the nearest qualifying upgrade height independently of upgrade-name lexical order and return the empty sentinel when no qualifying upgrade exists so the node fallback applies."
proposal = "Filter heights before selecting the minimum qualifying height in sdk/x/upgrade/keeper/keeper.go, return empty/zero when none qualify, and define equal-height handling. Add adversarial name/height order cases and prove historical RPC and snapshot-aware contexts choose identical upgrade behavior across restart."
owner_domain = 15
interface = "15.go-x-upgrade-keeper-keeper-j76"

[finding.upgrade-lookup-test-order]
file = "sdk/x/upgrade/keeper/keeper_test.go"
line = 276
class = "test-gap"
severity = "medium"
observed = "TestGetClosestUpgrade uses upgrade1, upgrade2 and upgrade3 with correspondingly increasing heights. This correlated lexical order hides the first-entry seeding defect and there is no assertion for a requested height beyond the last completed upgrade."
expected = "Tests for an upgrade lookup consumed by historical RPC must vary names independently from heights and exercise requests before, between, exactly at and after completed upgrades."
proposal = "Extend sdk/x/upgrade/keeper/keeper_test.go with z-old/a-new ordering, several insertion orders, equal-height policy and beyond-last empty results, then exercise the real node historical-context consumer with persisted completion records."
owner_domain = 15
interface = "15.go-x-upgrade-keeper-keeper-j76"

[finding.upgrade-info-atomicity]
file = "sdk/x/upgrade/keeper/keeper.go"
line = 419
class = "restart-recovery"
severity = "medium"
observed = "DumpUpgradeInfoWithInfoToDisk uses os.WriteFile directly on data/upgrade-info.json. A crash during truncate/write can leave empty or partial JSON; ReadUpgradeInfoFromDisk then returns an unmarshal error instead of a recoverable previous complete plan at the binary handoff."
expected = "The upgrade handoff file must remain a complete durable old or new plan across process interruption so a node can restart with the intended store migrations."
proposal = "Write a temporary sibling file, sync its contents, atomically rename it and sync the directory in sdk/x/upgrade/keeper/keeper.go. Define recovery for interrupted writes and test old/new handoff contents through ReadUpgradeInfoFromDisk and the real startup store-loader path."
owner_domain = 15
interface = "15.go-x-upgrade-keeper-keeper-j76"

[finding.evidence-cli-unmounted]
file = "sdk/x/evidence/client/cli/tx.go"
line = 24
class = "wiring-gap"
severity = "medium"
observed = "GetTxCmd constructs submitEvidenceCmd and adds supplied child commands to it, but never adds submitEvidenceCmd to the returned evidence root. A module can provide valid evidence submission commands and still receive a CLI tree with none reachable."
expected = "The declared evidence submit CLI must be mounted under the returned evidence command and preserve the provided concrete evidence handlers."
proposal = "Attach submitEvidenceCmd to cmd in sdk/x/evidence/client/cli/tx.go and execute a real supplied submission child through GetTxCmd in a command-tree test, checking arguments, signing flags and the created MsgSubmitEvidence."
owner_domain = 15
