[finding.evidence-pagination-scan]
file = "sdk/x/evidence/keeper/grpc_query.go"
line = 58
class = "runtime-risk"
severity = "medium"
observed = "AllEvidence calls k.GetAllEvidence(ctx) and discards its fully decoded result before running query.Paginate. Every small page therefore scans and allocates the entire evidence collection before the bounded response is assembled."
expected = "A bounded evidence page should perform the work required by pagination and any explicitly requested total, without an additional unconditional full collection decode."
proposal = "Remove the discarded full scan in sdk/x/evidence/keeper/grpc_query.go and exercise the real Query/AllEvidence service over a large persisted collection with a small page limit, checking bounded decoding and unchanged Any and pagination fields."
owner_domain = 15
interface = "7.qry-cosmos-evidence-v1beta1-allevidence-j39"

[finding.evidence-address-validation]
file = "sdk/x/evidence/types/evidence.go"
line = 56
class = "security"
severity = "medium"
observed = "Equivocation.ValidateBasic accepts any nonempty ConsensusAddress, while GetConsensusAddress discards ConsAddressFromBech32 errors and returns nil for malformed values. FromABCIEvidence emits Bech32, so accepted genesis or submitted evidence can carry an address that cannot resolve its validator."
expected = "Accepted equivocation evidence must contain a correctly encoded consensus address of the configured prefix and valid length, and decoding must not silently erase identity."
proposal = "Validate consensus-address decoding and length in sdk/x/evidence/types/evidence.go and propagate invalid-evidence errors before persistence or handler dispatch. Cover malformed hex/text, wrong prefix and the real FromABCIEvidence-to-Any-to-keeper round trip with address-byte equality."
owner_domain = 15
interface = "7.proto-cosmos-evidence-v1beta1-equivocation-j39"

[finding.evidence-submitter-validation]
file = "sdk/x/evidence/types/msgs.go"
line = 46
class = "security"
severity = "medium"
observed = "MsgSubmitEvidence.ValidateBasic rejects only an empty Submitter. For a nonempty malformed account address, GetSigners and GetSubmitter swallow the Bech32 decode error and return nil, so stateless validation does not establish the single signer promised by the message."
expected = "Every accepted evidence submission must have one valid account submitter whose address is the required signer; malformed addresses must fail before authorization and execution."
proposal = "Decode and validate Submitter in sdk/x/evidence/types/msgs.go ValidateBasic and preserve a typed invalid-address failure. Add malformed-address transactions through the real ante and Msg server path, asserting rejection and no evidence writes; retain valid signed submission coverage."
owner_domain = 15
interface = "7.proto-cosmos-evidence-v1beta1-msgsubmitevidence-j39"

[finding.evidence-node-router]
file = "sdk/x/evidence/keeper/keeper.go"
line = 76
class = "wiring-gap"
severity = "medium"
observed = "NewKeeper leaves router nil and SubmitEvidence/GetEvidenceHandler call router.HasRoute without a nil check. node/app.go:797-801 constructs and copies this keeper without SetRouter, while the evidence Msg service is registered. A new valid submission reaches a nil-router panic rather than ErrNoEvidenceHandlerExists; unit suites install their own router."
expected = "The running node must initialize a sealed evidence routing policy before registering submission handlers and report a typed unsupported-evidence error when no approved route exists."
proposal = "Make router initialization an explicit startup invariant in sdk/x/evidence/keeper/keeper.go and node/app.go, wiring approved routes or a sealed empty router. Exercise MsgSubmitEvidence using the actual node constructor, asserting either handler success or the declared unsupported-route code without panic."
