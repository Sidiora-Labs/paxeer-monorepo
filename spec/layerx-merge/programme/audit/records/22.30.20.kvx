[finding.log-free-receipt-contract]
file = "sdk/launchpad/shared/chain/client.go"
line = 1206
class = "interface-mismatch"
severity = "high"
observed = "Client.ReceiptState verifies a committed receipt and computes an included state, then returns ErrReceiptPosition and no Receipt for len(receipt.Logs)==0. Native transfers and reverted transactions legitimately have no logs. The API projects the same Receipt contract with logIndex zero, so the two public adapters disagree."
expected = "Every valid committed transaction must round-trip its receipt to consumers, including log-free success and reversion, with one agreed transaction-position representation."
proposal = "Define a transaction-level receipt position in sdk/launchpad/shared/interfaces and its source contract, regenerate the Go and TypeScript consumers, and update both sdk/launchpad/shared/chain/client.go and services/launchpad/api/internal/app/network_reads.go. Prove transfer, reversion and event-bearing receipts through the real node path."
owner_domain = 4
interface = "4.go-shared-interfaces-v2-receipt"

[finding.receipt-event-position-invented]
file = "services/launchpad/api/internal/app/network_reads.go"
line = 233
class = "interface-mismatch"
severity = "high"
observed = "networkReads.transaction ignores receipt.logs and always emits position.logIndex as decimal zero. The SDK instead uses the first real receipt log's block-global Index. A transaction whose first event is not block log zero therefore gets different ChainPosition identities from the two producers."
expected = "ChainPosition must identify the same real chain event across producers and consumers; transaction-only positions need an explicitly agreed separate representation."
proposal = "Align the receipt position contract and services/launchpad/api/internal/app/network_reads.go with sdk/launchpad/shared/chain/client.go, preserving actual event indices where events exist. Cover a receipt whose first log index exceeds zero and the agreed log-free case."
owner_domain = 4
interface = "4.go-shared-interfaces-v2-chain-position"

[finding.receipt-chain-identity-unchecked]
file = "services/launchpad/api/internal/app/network_reads.go"
line = 177
class = "security"
severity = "high"
observed = "networkReads.transaction trusts eth_getTransactionReceipt fields and labels the response complete with position.chainId 125. It never checks eth_chainId or compares the reported block and transaction inclusion with committed chain evidence. newNetworkAuthority constructs its preflight engine without attesting the endpoint; RegisterNetworkReads can therefore publish a wrong-chain or conflicting receipt independently of authority readiness."
expected = "A receipt advertised as a complete chain-125 result must be bound to the reviewed chain and its committed block and transaction, refusing conflicting or foreign evidence."
proposal = "Use the verified chain and reported-hash inclusion checks from sdk/launchpad/shared/chain in services/launchpad/api/internal/app/network_reads.go, or perform equivalent pinned identity checks before projection. Prove wrong-chain, conflicting-block and missing-receipt refusal through the HTTP consumer."
owner_domain = 4
interface = "4.http-api-get-v2-transactions-transaction-hash-network-reads"

