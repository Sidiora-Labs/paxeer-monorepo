[finding.node-root]
file = "services/platform/hosted/gateway/src/capabilities.rs"
line = 291
class = "interface-mismatch"
severity = "high"
observed = "chain_rpc replaces an empty base_path with /rpc through CHAIN_RPC_PATH. main.rs:874-875 applies it to every LAYERX_GATEWAY_PAXEER_RPC_URLS endpoint before paxeer::node sends requests. The node HTTPServer in rpc/rpcstack.go:299-302 accepts only / when no prefix is configured, so a documented bare node origin becomes a failing /rpc call."
expected = "Brief facts 2 and 3 and registry 7.http-jsonrpc-root require JSON-RPC at the node root. A configured api-mainnet-beta or numbered node origin must support gateway chain reads and transaction submission without a retired router."
proposal = "In services/platform/hosted/gateway/src/capabilities.rs and main.rs preserve the configured root as / instead of appending /rpc. Prove bare node configuration through the running node HTTP server into gateway reads, capability probing and transaction submission; retain explicitly configured domain paths."
owner_domain = 8
interface = "7.http-jsonrpc-root"

[finding.node-root-test]
file = "services/platform/hosted/gateway/src/capabilities.rs"
line = 1260
class = "test-gap"
severity = "medium"
observed = "The chain endpoint test expects https://router.example and its trailing-slash form to become /rpc. It proves the obsolete rewrite rather than the root accepted by the node, so it endorses the node-root failure."
expected = "Brief checks 3 and 7 require root-path node transport and tests whose endpoint behavior agrees with the real producer."
proposal = "Replace the router-origin expectations in services/platform/hosted/gateway/src/capabilities.rs with the merged node root contract and exercise the configured gateway against a real node listener, including explicit /chain/<id> paths and rejection of obsolete router assumptions."
owner_domain = 8

[finding.history-schema]
file = "services/platform/hosted/gateway/src/history.rs"
line = 263
class = "interface-mismatch"
severity = "high"
observed = "page clones each indexer row and inserts tx_hash equal to tx_id. Both px_getHistory and px_getUnifiedHistory OpenRPC item schemas have additionalProperties false but no tx_hash property (openrpc.json:1627 and 1964). The recorded web fixture includes tx_hash; a client enforcing the declared closed schema rejects these non-empty gateway answers."
expected = "Registry 8.rpc-gateway-px-gethistory and 8.rpc-gateway-px-getunifiedhistory must describe the emitted history rows. Requirement 99713.1 explicitly requires tx_hash beside tx_id and the recorded answer must decode for consumers."
proposal = "In services/platform/hosted/gateway/openrpc.json declare the emitted tx_hash with its hash encoding in both item schemas and coordinate clients under sdk/ and apps/web/. Validate a real indexer-to-gateway answer against the closed schemas and decode that same recording in consumers without weakening exact equality."
owner_domain = 8
interface = "8.rpc-gateway-px-gethistory"

[finding.settlement-component-gate]
file = "services/platform/hosted/gateway/src/main.rs"
line = 1920
class = "interface-mismatch"
severity = "high"
observed = "After production_route accepts POST /v1/settle, the shared ingress unconditionally requires KernelBackend::Component. With kernel variables unset it returns kernel_unavailable before settle, although settle at lines 2724-2797 uses the durable key store, pinned receipt keys and node pax_sequencerReceipt plus eth_getTransactionReceipt, not that component."
expected = "Registry 8.http-gateway-post-v1-settle is a surviving merchant interface. Brief fact 1 and requirement 8153.1 require hosted chain paths to operate without a separate kernel-side service."
proposal = "In services/platform/hosted/gateway/src/main.rs assign dependencies per production route so settlement authenticates and verifies committed node evidence without a Component precondition. Exercise an actual committed payment through merchant POST /v1/settle with every retired backend unset, including pending and refused results."
owner_domain = 8
interface = "8.http-gateway-post-v1-settle"

[finding.identity-config-coupling]
file = "services/platform/hosted/gateway/src/main.rs"
line = 736
class = "wiring-gap"
severity = "high"
observed = "configured_kernel rejects identity variables unless LAYERX_GATEWAY_COMPONENT_URL is set, then requires component, authority, program registry, module configuration and kernel client credentials together. Config::backend exposes Identity only from this Kernel. px_register, px_requestFunds and /v1/keys therefore cannot use the surviving identity service independently in a chain-only deployment."
expected = "The declared hosted registration, starter-credit and key-management interfaces remain available with their identity and durable-store dependencies. Removing the separate kernel service must not remove onboarding or require deployment of retired services."
proposal = "Split identity endpoint, identity credentials and key provisioning configuration from Kernel in services/platform/hosted/gateway/src/main.rs; wire rpc_register.rs, rpc_faucet.rs and key management to that independent target. Prove registration, session introspection, faucet claim and key rotation through actual identity and Redis transports with kernel variables unset."
owner_domain = 8
interface = "8.rpc-gateway-px-register"

[finding.tenant-fixed-beta]
file = "services/platform/hosted/gateway/src/rpc_register.rs"
line = 10
class = "wiring-gap"
severity = "medium"
observed = "TENANT is fixed to beta and is used for signature binding, derived subject, identity request bodies and response verification at lines 198, 254-290 and 334-347. A gateway serving another tenant cannot register a principal in that tenant and instead targets beta."
expected = "Brief fact 5 requires tenant domains to be parameterized namespaces. Registration identity, signature domain and principal ownership must use the authenticated or configured tenant consistently."
proposal = "In services/platform/hosted/gateway/src/rpc_register.rs obtain the tenant from the trusted gateway tenant context, bind the signature and subject to it, and pass it to identity and response checks. Coordinate openrpc.json and prove two tenants over real identity storage, including rejection of cross-tenant signatures."
owner_domain = 8
interface = "8.rpc-gateway-px-register"

[finding.readiness-kernel-drift]
file = "services/platform/hosted/gateway/src/main.rs"
line = 2192
class = "interface-mismatch"
severity = "medium"
observed = "readiness appends every KernelBackend when any kernel backend is configured, and gateway_readiness_scope inserts those entries and principal_state_boundary under components. The capabilities document also omits layerx_activity entirely. Setting a legacy kernel configuration changes readiness and can make an otherwise serving merged gateway degraded."
expected = "Requirement 8153.2 requires readiness to stay unchanged when a kernel backend is configured, with no kernel entries or principal_state_boundary and layerx_activity explicitly not_configured."
proposal = "In services/platform/hosted/gateway/src/main.rs derive merged readiness from the live chain, indexer and durable-store dependencies, omit retired backend probes regardless of leftover configuration, and publish the required layerx_activity status. Verify equal readiness documents with and without legacy variables, preserving observation-time semantics."
owner_domain = 8
interface = "8.http-gateway-get-readyz"

[finding.readiness-required-backends]
file = "services/platform/hosted/gateway/src/main.rs"
line = 2318
class = "runtime-risk"
severity = "medium"
observed = "serving uses backend.ready || !backend.configured, so absent Paxeer and consensus targets do not prevent HTTP 200 ready if the durable store is healthy. readiness never probes the indexer, and complete is just serving even when product_routes reports unavailable dependencies. Traffic can be admitted while chain and history methods cannot serve."
expected = "A ready gateway must have the required serving dependencies for the advertised public methods. Requirement 8153.2 bases readiness on ready chain and indexer listeners rather than accepting their absence."
proposal = "In services/platform/hosted/gateway/src/main.rs define required dependencies for each advertised serving scope, require chain and indexer readiness, and apply product-route dependency results to the appropriate scope. Cover missing, unreachable and recovered dependencies with actual listeners and assert the corresponding 503-to-200 transition."
owner_domain = 8
interface = "8.http-gateway-get-readyz"

[finding.readiness-test-contract]
file = "services/platform/hosted/gateway/src/main.rs"
line = 5298
class = "test-gap"
severity = "medium"
observed = "real_gateway_readiness_capabilities_contract requires eight backends and at line 5311 asserts that capabilities has no layerx_activity. Those assertions preserve the kernel-era document instead of the explicit merged readiness contract; the current test cannot establish configuration-independent readiness."
expected = "Requirement 8153.2 requires no kernel backend entries under either configuration and an explicit layerx_activity not_configured capability. Tests must assert that product contract on real transports."
proposal = "Update the test and its real-service case generation in services/platform/hosted/gateway/src/main.rs to assert the merged dependency set and explicit capability state for both kernel-variable configurations. Keep strict field and status checks and restart dependencies to prove recovery rather than deleting assertions."
owner_domain = 8

[finding.status-permanent-degradation]
file = "services/platform/hosted/gateway/src/main.rs"
line = 2387
class = "runtime-risk"
severity = "medium"
observed = "gateway_status reports hosted_gateway as degraded whenever Redis is ready and unavailable otherwise; it has no available branch. It still probes testnet_core and receipt_authority. Operators cannot distinguish a healthy merged gateway from a degraded one using this surviving status route."
expected = "A healthy hosted gateway should report available based on its live chain, indexer and store dependencies, with retired standalone service health absent from the operational status."
proposal = "In services/platform/hosted/gateway/src/main.rs derive /v1/status from the same live dependency model as readiness, include a reachable healthy state, and remove obsolete core/authority service status. Verify healthy, failed and recovered dependencies against the running gateway."
owner_domain = 8
interface = "8.http-gateway-get-v1-status"

[finding.ai-views-unmounted]
