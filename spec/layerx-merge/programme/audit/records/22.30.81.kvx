[finding.validator-pagination-bound]
file = "services/platform/hosted/gateway/src/chain_reads.rs"
line = 119
class = "runtime-risk"
severity = "medium"
observed = "px_getValidators accumulates every returned validator in a loop bounded only by the consensus response total and increasing page. A large or inconsistent-but-progressing upstream total can hold a public request and grow its vector over arbitrarily many individually timed HTTP calls."
expected = "Brief check 4 requires bounded inputs and request duration. Consensus pagination must fit a declared validator-set bound and one overall gateway request deadline."
proposal = "Add a protocol-supported validator-set/page bound and aggregate deadline in services/platform/hosted/gateway/src/chain_reads.rs; reject oversized or non-progressing responses with the declared unavailable error. Verify real consensus pagination at the boundary and recovery after a refused response."
owner_domain = 8
interface = "8.rpc-gateway-px-getvalidators"

[finding.asset-list-full-scan]
file = "services/platform/hosted/gateway/src/paxeer.rs"
line = 620
class = "runtime-risk"
severity = "medium"
observed = "layerx_assets fetches /v1/assets in pages of 500 until next_cursor is null, stores and sorts the entire catalogue, then truncates it to MAX_JOINED_ASSETS = 16. A small px_listAssets answer therefore costs an unbounded catalogue scan, memory growth and repeated public-read admission that can fail on a large healthy catalogue."
expected = "Brief check 4 requires bounded work for public requests. The documented 16-asset response bound must also bound the metadata discovery work rather than merely trimming the final vector."
proposal = "In services/platform/hosted/gateway/src/paxeer.rs use an indexer ordering and page contract that selects the required 16 assets before retrieval, with an aggregate deadline and explicit continuation semantics. Coordinate services/platform/hosted/indexer/src and prove stable results against a populated indexer without scanning every asset."
owner_domain = 8
interface = "8.rpc-gateway-px-listassets"

