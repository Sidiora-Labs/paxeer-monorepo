line = 53
class = "wiring-gap"
severity = "medium"
observed = "AiViews::respond implements authenticated snapshot, participants and epochs routes under /v1/ai/markets/, with projection freshness and cursor keys. lib.rs exports the module, but main.rs has no AiViews state, respond call or route mount. The gateway binary therefore falls through to 404 for the module advertised routes."
