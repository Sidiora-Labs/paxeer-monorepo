line = 401
class = "runtime-risk"
severity = "medium"
observed = "join_assets invokes registry whenever any asset lookup returns a non-null record. Even a native record or a record whose symbol and decimals are complete triggers a full /v1/assets registry scan; registry failure then rejects a history page that could be served without that lookup."
