[finding.order-price-scale]
file = "src/modules/perps/lx_perps_book.c"
line = 175
class = "interface-mismatch"
severity = "high"
observed = "order_margin divides price times quantity by one, while lx_perps_fill_notional and open_reservation_check divide by market.price_scale. With scale 100, price 10000, quantity 1 and initial margin 1000 bps, opening reserves 10 quote units but order admission requires 1000. The registered dispatcher reaches this check."
expected = "Reservation, order admission and execution must apply the same price scale and quote notional. An adequately collateralized scaled-price order must reach matching."
proposal = "Use the canonical scaled notional calculation in src/modules/perps/lx_perps_book.c, preserving exact-division and overflow refusals. Prove reserve-to-place-to-fill with a non-unit price scale through registered perps activities."
owner_domain = 1
interface = "1.c-lx-perps-order-place-execute"

[finding.close-trading-pnl]
file = "src/modules/perps/lx_perps_dispatch.c"
line = 1430
class = "runtime-risk"
severity = "high"
observed = "execute_position_close computes funding owed but neither reads an exit price nor computes trading P&L. Its zero-funding branch returns the full margin through lx_perps_position_close_execute; the other branch settles funding and returns margin. Exposure and open interest are then removed even when price has moved."
expected = "Closing a perpetual position must realize signed trading gains or losses and funding before returning residual collateral. A losing trader must not recover the unchanged-price payout."
proposal = "Make src/modules/perps/lx_perps_dispatch.c obtain the permitted close price and atomically settle signed P&L against market liquidity together with funding and collateral. Prove profitable and losing long/short closes, insufficient liquidity, rollback and recovery."
owner_domain = 1
interface = "1.c-lx-perps-position-close-execute"

[finding.fill-reduction-pnl]
file = "src/modules/perps/lx_perps_position.c"
line = 442
class = "runtime-risk"
severity = "high"
observed = "fill_reduce removes proportional entry_notional on partial reduction and only settles funding on a full close or reversal. It never values the closed quantity at request.price. lx_perps_fill_settle releases unchanged margin for closed parties, erasing the realized trading gain or loss."
expected = "Matched partial reductions, full offsets and reversals must realize P&L at the actual fill price, preserve remaining cost basis and conserve quote balances across traders and liquidity."
proposal = "Extend the real fill settlement in src/modules/perps/lx_perps_position.c to accumulate and apply signed realized P&L before release or reversal. Exercise both sides, mixed entry prices, partial reduction, full offset and reversal through matching, with exact balances after recovery."
owner_domain = 1
interface = "1.c-lx-perps-position-apply-fill"

[finding.liquidation-equity]
file = "src/modules/perps/lx_perps_liquidate.c"
line = 42
class = "runtime-risk"
severity = "high"
observed = "lx_perps_maintenance_check compares raw margin_balance against maintenance on mark notional, ignoring position.side, entry_notional and funding. validate_liquidate passes raw cash. Rising prices can liquidate a profitable long, while falling mark notional can keep a heavily losing long ineligible."
expected = "Liquidation eligibility must compare maintenance with signed equity including unrealized trading P&L and accrued funding. Profitable adequately funded exposure must remain open and insolvent exposure must be eligible."
proposal = "Compute canonical signed equity in the perps risk path and use it consistently for admission and settlement. Prove profitable-long refusal, adverse long/short eligibility, funding-only insolvency and exact maintenance boundaries on real registered activities."
owner_domain = 1
interface = "1.c-lx-perps-maintenance-check"

[finding.unfilled-margin-release]
file = "src/modules/perps/lx_perps_dispatch.c"
line = 1282
class = "runtime-risk"
severity = "high"
observed = "execute_position_open debits main to margin and sets has_open_reference without storing a position. Close requires a stored open position; execute_order_cancel only deletes the order. A first reservation without a fill, or reopened reservation with a closed position, has no dispatched release. Current asset send requires an asset account rather than this margin account."
expected = "Owners must recover unused margin without first obtaining a market fill. Reserved funds, resting orders and exposure must have a persistent and cancelable lifecycle."
proposal = "Persist reservation lifecycle state in src/modules/perps/lx_perps_dispatch.c and expose authorized release of unencumbered margin. Prove reserve-without-order, no-fill cancellation, IOC no-fill, reopened reservation and durable recovery, preserving live-exposure and ownership checks."
owner_domain = 1
interface = "1.c-lx-perps-margin-release"

[finding.liquidation-funding]
file = "src/modules/perps/lx_perps_dispatch.c"
line = 1631
class = "runtime-risk"
severity = "high"
observed = "execute_liquidate loads funding state but uses it only to remove open interest. liquidation_loss computes trading loss alone and the liquidation request carries no funding debt or credit. Closing the position discards funding_index_at_entry without settling its accrued funding."
expected = "Liquidation must settle or explicitly preserve every accrued funding liability and credit before closing exposure. A debt or receivable must not disappear when a position is liquidated."
proposal = "Combine pending funding and trading P&L in the atomic dispatcher liquidation settlement with explicit pool and deficit treatment. Prove both funding signs after a real tick, insufficient insurance, conserved transfers and recovery without duplicate settlement."
owner_domain = 1
interface = "1.c-lx-perps-liquidate-execute"

[finding.halted-margin-policy]
file = "src/modules/perps/lx_oracle_halt.c"
line = 22
class = "wiring-gap"
severity = "medium"
observed = "lx_oracle_market_action_check permits MARGIN_ADD and ORDER_CANCEL while halted but has no production caller. The dispatched POSITION_INCREASE requires a trading-enabled market, fresh oracle and nonzero size_delta; protective margin-only addition is unavailable during a halt or stale feed."
expected = "The protective action allowed by the oracle policy must be reachable through the registered transport with matching authorization and errors, while exposure increases remain forbidden."
proposal = "Wire a pure margin top-up in src/modules/perps/lx_perps_dispatch.c that preserves exposure during halt or oracle staleness, or explicitly revise the risk contract. Prove the policy through registered activities alongside cancellation and refused exposure increases."
owner_domain = 1
interface = "1.c-lx-oracle-market-action-check"

[finding.parallel-oracle-state]
file = "src/modules/perps/lx_oracle_intake.c"
line = 114
class = "wiring-gap"
severity = "medium"
observed = "lx_oracle_push_execute appends to caller-owned stores and mutates a separate market halt flag, halting invalid observations and clearing halt on success. Registered perps dispatch instead validates projected observations and writes canonical module KV; it never calls this helper and its epoch hook is a no-op."
expected = "Oracle intake, halt and recovery behavior asserted as the kernel contract must agree with the canonical producer and committed consumer state across restart; a parallel in-memory model does not establish it."
proposal = "Consolidate the oracle lifecycle around canonical module state in src/modules/perps and route registered transport through that policy. Explicitly classify any retained bounded helper as compatibility code and prove halt, fresh-update recovery and snapshot restoration against committed records."
owner_domain = 1
interface = "1.c-lx-oracle-push-execute"

[finding.oracle-halt-test-seam]
file = "tests/modules/test_oracle_halt.c"
line = 72
class = "test-gap"
severity = "medium"
observed = "The test asserts halted MARGIN_ADD success and automatic unhalt after a helper push using local stores and a service-module context. It never submits a perps margin action or reads a committed halted market, so it misses the dispatcher disagreement."
expected = "The declared halt policy must be exercised from permitted signed oracle input through registered perps transport to the consumer action, with persisted state restored before recovery."
proposal = "Complement tests/modules/test_oracle_halt.c with actual perps activities for stale/invalid updates, permitted cancellation and protective top-up, refused exposure increases and fresh-update recovery after durable snapshot reload."
owner_domain = 1
interface = "1.c-lx-oracle-market-action-check"

[finding.retired-idempotency-branch]
file = "src/sequencer/lxp_admission.c"
line = 36
class = "dead-code"
severity = "low"
observed = "lxp_admit_activity still refuses idempotency_key_exists with IDEMPOTENT_REPLAY although both current kernel producers pass false. Decision 101 and requirements 2020.2 and 2035.1 allow the same key at the next valid sequence; this branch advertises an obsolete replay rule."
expected = "Admission must have the current sequence-based contract: consumed sequence refuses, and the same key at the next valid sequence remains admissible without a retired idempotency table."
proposal = "Retire the unused admission input and branch with its declaration and callers, preserving all sequence, timestamp, signature and fee checks. Prove consumed-sequence refusal and same-key next-sequence success through kernel admission."
owner_domain = 1

[finding.retired-batch-roots]
file = "src/sequencer/lxp_batch_roots.c"
line = 49
class = "retired-reference"
severity = "low"
observed = "lxp_batch_roots_compute still hashes oracle_inputs and availability_chunks into historical oracle_root and data_availability_root. Remaining callers are tests and fixtures, rather than the merged block producer; DA and oracle-web-root retirement replaces their publication with committed block data."
expected = "Merged execution and verification use committed blocks for availability and finality. Retained historical encodings must be clearly separated from the current block contract."
