[finding.nft-token-revoke]
line = 34
class = "interface-mismatch"
severity = "high"
interface = "6.sol-erc721-approve-095ea7b3"
observed = "useRevoke sends setApprovalForAll(spender, false) for every NFT row, including rows carrying tokenId from getApproved. ERC721.sol stores token-specific approve separately from isApprovedForAll, so the receipt can succeed while the spender retains the token approval; the UI then hides the row as revoked."
expected = "A successful revoke must clear the permission represented by the selected row. A token-specific ERC721 approval is cleared with approve(address(0), tokenId); collection operator revocation clears setApprovalForAll."
proposal = "In apps/explorer/ui/marketplace/essentialDapps/revoke/hooks/useRevoke.tsx select approve(ZERO_ADDRESS, tokenId) for token-specific rows and setApprovalForAll(spender, false) for operator rows. Read back the corresponding permission after the committed receipt and cover both paths against an ERC721 producer."
owner_domain = 14
file = "apps/explorer/ui/marketplace/essentialDapps/revoke/hooks/useRevoke.tsx"

[finding.revoke-rewards-lifecycle]
line = 47
class = "runtime-risk"
severity = "medium"
observed = "After writeContractAsync returns a transaction hash, trackTransactionConfirm is awaited before waitForTransactionReceipt. A rewards API failure reports a failed revoke and leaves the row visible even when the on-chain permission change commits."
expected = "The transaction receipt and the resulting permission state determine whether a revoke succeeded. Rewards availability must not change the user's authoritative transaction outcome."
