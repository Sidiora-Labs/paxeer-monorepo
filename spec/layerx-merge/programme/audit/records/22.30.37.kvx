[finding.reward-history-age-outage]
file = "services/launchpad/pnl-tracker/internal/production/l18/journeys.go"
line = 182
class = "runtime-risk"
severity = "high"
observed = "claimedHistory returns ErrUnavailable when the checkpoint exceeds a market's creation by 100000 blocks. Rewards iterates creations in NFT order and calls claimedHistory at lines 331-345 before excluding unrelated wallets at line 347. No indexed history fallback is wired. Once the oldest market crosses this normal age, first-page creator-fee listing fails for every wallet, including wallets that never owned or claimed from that market."
expected = "The declared RewardsResponse must remain readable as the committed chain grows, preserving complete claimed totals and stable checkpoint paging without making unrelated old markets a global availability dependency."
proposal = "Implement canonical indexed fee-claim history for production/l18/journeys.go and select wallet-relevant rewards at the pinned checkpoint. Retain bounded paging and exact totals; add a real indexed-path case where the oldest unrelated market is over 100000 blocks old and a later wallet reward remains listable."
owner_domain = 4
interface = "4.go-shared-interfaces-v2-rewards-response"

[finding.nonclaim-market-breaks-listing]
file = "services/launchpad/pnl-tracker/internal/production/l18/journeys.go"
line = 351
class = "runtime-risk"
severity = "medium"
observed = "Rewards returns ErrUnavailable for the entire page when an NFT owned by the requested wallet has a capability other than CLAIM, even though StrategyCapability and the native fee system admit BURN, AIRDROP and LP_REWARDS. One legitimate strategy choice prevents that wallet from viewing other creator rewards and historical claimed amounts."
expected = "Reward listing must distinguish inapplicable creator-claim capability from a failed dependency and preserve independently valid reward entries and historical totals."
proposal = "Update production/l18/journeys.go to apply the product's strategy eligibility per reward: omit an inapplicable creator claim or expose zero current creator claimability while preserving history, and keep epoch entitlements on their own supported route. Prove a wallet with both CLAIM and non-CLAIM markets can list its eligible rewards."
owner_domain = 4
interface = "4.go-shared-interfaces-v2-rewards-response"

[finding.community-policy-restart]
file = "services/launchpad/pnl-tracker/internal/production/l18/journeys.go"
line = 778
class = "restart-recovery"
severity = "medium"
observed = "CommunityWatcher stores policy_digest with each observation, but RunOnce selects only the latest owner and treats an unchanged owner as unchanged authority. Restarting with an approvedCommunityWallets list that removes or adds that same owner changes w.policyDigest without triggering Observe; the persisted active/proposed/revoked history and emitted authority event remain under the old policy."
expected = "Persisted community authority must be re-evaluated when either canonical ownership or the approved-wallet policy changes, including after configuration reload or restart."
proposal = "Read and compare the latest policy_digest as well as owner in production/l18/journeys.go RunOnce, append a new observation when either changes, and prove restart with a removed and re-added approved wallet updates the durable authority state without requiring an NFT transfer."
owner_domain = 4

