line = 126
class = "wiring-gap"
severity = "medium"
observed = "emit persists fee.claimed, award and community/preparation events into l18_outbox with published_at, but no production code reads or acknowledges that table. internal/app/app.go constructs a shared delivery.Store/Relay only for inventory.rebuild.v2 and portfolio.snapshot.v2; its started jobs include reward settlement and community scanning but no l18 outbox bridge. Reward records accumulate without reaching a delivery consumer."
