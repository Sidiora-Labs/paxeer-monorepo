[finding.journey-indexer-grants]
file = "services/launchpad/pnl-tracker/internal/production/l18/journeys.go"
line = 151
class = "interface-mismatch"
severity = "high"
observed = "JourneyService.market, Rewards, Prepare, sourceCheckpoint and CommunityWatcher query indexer_canonical_creations, indexer_ingest_watermarks and indexer_block_completeness base tables (also lines 306, 418, 434, 578, 587, 688 and 735). The pnl_runtime manifest in launchpad/spec/production-system/integration/migrations/grants.json grants only their _v1 views; its creation-view column grants also omit nft_id. internal/app/app.go wires these queries to the runtime pool, so reward reads, preparation and community scans fail with insufficient privilege."
expected = "The declared RoleManifest.GrantSQL boundary must let the production PnL runtime consume the indexer's admitted read views and every required column without granting cross-service base-table access."
proposal = "Change production/l18/journeys.go queries to indexer_canonical_creations_v1, indexer_ingest_watermarks_v1 and indexer_block_completeness_v1. In launchpad/spec/production-system/integration/migrations/grants.json admit nft_id on the creation view, then qualify the mounted reward routes and community worker with the coordinator-provisioned pnl_runtime role."
owner_domain = 4
interface = "4.go-shared-db-production-role-manifest-grant-sql"

[finding.schema-sequence-grants]
file = "services/launchpad/pnl-tracker/internal/production/l18/schema.sql"
line = 3
class = "interface-mismatch"
severity = "high"
observed = "The schema creates serial sequences only for l18_entries.sequence and l18_outbox.sequence; funding, inbox, awards, claims, epochs and epoch_claims use natural keys. grants.json nevertheless grants USAGE on l18_funding_sequence_seq, l18_inbox_sequence_seq, l18_awards_sequence_seq, l18_claims_sequence_seq, l18_epochs_sequence_seq and l18_epoch_claims_sequence_seq. Migration 180000.sql has the same natural-key schema; coordinatortest applies GrantSQL statements without suppressing errors, preventing pnl_runtime bootstrap."
expected = "The reviewed production role manifest and migrated schema must agree on actual object names so every runtime GRANT succeeds on a newly provisioned database."
proposal = "Remove the nonexistent sequence grants from launchpad/spec/production-system/integration/migrations/grants.json while retaining the real entry/outbox and later revision sequences. Prove an unmodified coordinator bootstrap of pnl_runtime against the complete reviewed migration plan, without skipping missing-object errors."
owner_domain = 4
interface = "4.go-shared-db-production-role-manifest-grant-sql"

[finding.baseline-role-proof-skips-grants]
file = "services/launchpad/pnl-tracker/internal/production/l16/baseline_ahead_postgres_test.go"
line = 126
class = "test-gap"
severity = "medium"
observed = "reviewedPnlRuntime documents that real pnl_runtime provisioning fails, then applies a partial manifest and ignores PostgreSQL 42P01, 3F000 and 42883 errors at lines 176-181. The tests can pass with a role the production coordinator cannot provision, hiding the schema/manifest incompatibility."
expected = "Baseline recovery tests that claim reviewed runtime privileges must exercise the same successful role provisioning used by production, including every required schema and grant."
proposal = "After correcting the role manifest, replace reviewedPnlRuntime in baseline_ahead_postgres_test.go with the real coordinator-provisioned runtime login and complete dependency migration plan; fail on every invalid production grant rather than skipping its statement."
owner_domain = 4
interface = "4.go-shared-db-production-role-manifest-grant-sql"

[finding.active-snapshot-update-grant]
file = "services/launchpad/pnl-tracker/internal/production/l16/live_transfers.go"
line = 1185
class = "interface-mismatch"
severity = "high"
observed = "livePersistReplayTx advances inventory_l16_active_v2 with INSERT ON CONFLICT DO UPDATE of generation, snapshot_digest and height; service.go line 451 uses the same activation operation and reads the pointer FOR UPDATE. The pnl_runtime manifest grants only SELECT and INSERT on this table. The live authenticated worker therefore cannot commit advancing inventory snapshots under the declared runtime role."
expected = "Atomic replay activation must advance the persisted active pointer with the exact privileges supplied to the running PnL worker, including the update/locking rights required by its SQL."
proposal = "Add a reviewed column-scoped UPDATE grant for generation, snapshot_digest and height on pnl.inventory_l16_active_v2 in grants.json, then prove first activation and a later-height activation through LiveTransferWorker with the actual pnl_runtime login and restart recovery."
owner_domain = 4
interface = "4.go-shared-db-production-role-manifest-grant-sql"

[finding.history-row-insert-grant]
