[finding.start-late-service-error]
file = "sdk/server/start.go"
line = 385
class = "runtime-risk"
severity = "medium"
observed = "API and Rosetta goroutines send errors on unbuffered errCh channels selected only during the five-second startup window. A later server failure leaves the sender blocked and the node running without that service."
expected = "Started services must be supervised for the full node lifecycle and a later failure must reach shutdown or restart handling without leaking a blocked goroutine."
proposal = "In sdk/server/start.go supervise service errors together with shutdown and restart signals for the lifetime of startInProcess, and exercise a listener failure after ServerStartTime to prove propagation and cleanup."
owner_domain = 15

