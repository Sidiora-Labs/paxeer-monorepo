[finding.sdk-json-syntax]
file = "sdk/chainflow/go/internal/apijson/decoder.go"
line = 85
class = "runtime-risk"
severity = "medium"
observed = "decoderBuilder.unmarshal calls gjson.ParseBytes without a syntax check; the struct decoder iterates node.Map without requiring an object, so malformed or scalar responses can become empty successful models."
expected = "The SDK must distinguish a valid API object from malformed JSON or an incompatible root type before returning a successful typed response to a consumer."
proposal = "In internal/apijson/decoder.go validate complete JSON syntax and the required root kind before decoding; retain documented unknown-field handling and add malformed, truncated and scalar response cases through the request path."
owner_domain = 15

[finding.sdk-array-panic]
file = "sdk/chainflow/go/internal/apijson/decoder.go"
line = 345
class = "runtime-risk"
severity = "low"
observed = "The reflect.Array branch uses newArrayTypeDecoder, which always constructs a slice and passes it to value.Set; a fixed-size array destination therefore panics rather than decoding or returning an error."
expected = "An advertised supported reflection kind must be assigned with its own Go type, and invalid array lengths must return an ordinary decoding error rather than panic."
proposal = "In internal/apijson/decoder.go construct a value of the fixed array type, enforce its length and assign each element; retain the separate slice behavior and cover both exact and invalid lengths."
owner_domain = 15

[finding.sdk-test-probe]
file = "sdk/chainflow/go/internal/testutil/testutil.go"
line = 10
class = "test-gap"
severity = "medium"
observed = "CheckTestServer uses http.Get without a timeout, never closes a successful response body, and returns true after a connection error when SKIP_MOCK_TESTS is unset; no member calls this helper."
expected = "A test-server readiness helper must have bounded resource use and report an unavailable prerequisite as a failure; its return value must not claim that an unreachable server exists."
proposal = "In internal/testutil/testutil.go close the response body, use a bounded client and fail on every probe error; either wire the helper into its intended tests or remove the unused helper in its owning SDK task without adding new skip paths."
owner_domain = 15

[finding.names-untrusted-root]
file = "sdk/names/src/resolve.ts"
line = 150
class = "security"
severity = "medium"
observed = "tendermintHeaders returns an unsigned RPC app_hash through the same structural HeaderSource type accepted by resolveContent, which always labels an accepted digest verified:true; the helper comment acknowledges RPC trust."
expected = "A product-level verified resolution must identify its trusted header source and must not imply validator authentication when the proof and its root come from the same unauthenticated RPC source."
proposal = "In sdk/names/src/resolve.ts distinguish trusted RPC roots from commit-verified header sources in the public API and result assurance; require the authenticated source for the verified product flow and cover a forged root plus matching proof."
owner_domain = 8

[finding.names-successor-availability]
file = "sdk/names/src/resolve.ts"
line = 139
class = "runtime-risk"
severity = "medium"
observed = "resolveContent reads the current eth_blockNumber h and immediately asks for header h+1. A live node may not yet have committed that successor, so a valid published name can fail until another block arrives."
expected = "Requirement 181381.1 requires proof height h and appHashAt(h+1); the resolution flow must also cope with the ordinary interval before that committing successor becomes available."
proposal = "In sdk/names/src/resolve.ts preserve the required h and h+1 binding while waiting for the successor under a bounded deadline; expose a retriable not-yet-committed result on expiry and exercise resolution against a progressing paxd node."
owner_domain = 8

[finding.names-network-bounds]
file = "sdk/names/src/resolve.ts"
line = 75
class = "runtime-risk"
severity = "medium"
observed = "The eth_blockNumber, eth_getProof and unsigned commit fetches have no caller cancellation, deadline or response-size bound; a stalled RPC can leave resolution pending indefinitely and an oversized proof is fully buffered."
expected = "Name resolution over public RPC must stop within a caller-selected budget and reject responses exceeding the documented proof and header limits before allocating an unbounded body."
proposal = "Add an AbortSignal and bounded response reader to sdk/names/src/resolve.ts and the header fetch adapter, propagate them through all resolution requests, and test slow headers, oversized bodies and cancellation without weakening proof verification."
owner_domain = 8

[finding.names-chain-trust]
file = "sdk/names/src/header.ts"
line = 389
class = "security"
severity = "medium"
observed = "verifiedTendermintHeaders supplies chainId:header.chain_id to verifyCommit. The expected chain identity is therefore read from the same untrusted response, although verifyCommit itself supports an independent chain-id check."
expected = "A pinned validator set must be bound to the independently configured Paxeer chain identity; a valid signature from another chain using the same keys must not authenticate this network."
proposal = "In sdk/names/src/header.ts require the trusted chain id alongside validators and pass that configured value to verifyCommit; thread it through callers and add an adapter-level wrong-chain refusal with otherwise valid signatures."
owner_domain = 8

[finding.names-producer-test]
file = "sdk/names/test/header.test.ts"
line = 62
class = "test-gap"
severity = "medium"
observed = "The end-to-end resolution test rebuilds signedStorageHeader with locally generated validator keys and serves a hand-built RPC envelope. Its storage root is real vector data, but the matching header and transport are produced by the test."
expected = "Brief check 7 requires a real producer-to-transport-to-consumer proof; the existing signature-mutation test proves the fixture path but cannot prove that a live node emits the exact shape consumed by the adapter."
proposal = "Keep the mutation and vector assertions in sdk/names/test/header.test.ts, and add a disposable paxd flow that writes a resolver value, obtains its real proof and successor commit, then resolves it through the production HTTP adapters."
owner_domain = 8

