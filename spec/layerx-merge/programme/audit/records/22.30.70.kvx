[finding.boundary-cumulative-deadline]
file = "services/platform/hosted/paxeer/src/main.rs"
line = 563
class = "security"
severity = "medium"
observed = "The main TLS/EVM path uses per-read and per-write socket timeouts rather than a cumulative request deadline. A client trickling bytes before each timeout can occupy one of MAX_CONNECTIONS=128 for a very long time; Comet transport already uses a deadline."
expected = "Public network work must have a bounded total request lifetime so slow clients cannot exhaust all accepted connection slots by making minimal periodic progress."
proposal = "Apply a cumulative client and upstream deadline to the maintained node-facing transport; while historical boundary support remains, reuse transport.rs deadline semantics in main.rs and prove slow-progress requests release their slots within that budget."
owner_domain = 8

[finding.boundary-wrong-chain-forwarding]
file = "services/platform/hosted/paxeer/src/main.rs"
line = 398
class = "runtime-risk"
severity = "medium"
observed = "readyz compares upstream eth_chainId with config.chain_id, but relay forwards eth_sendRawTransaction without establishing that identity. Direct service callers can still reach a wrong upstream between or independently of readiness routing."
expected = "A boundary configured for one chain must refuse forwarding write traffic when its upstream identity differs, rather than relying entirely on an external readiness consumer."
proposal = "Remove the relay in the merged deployment; for any supported historical boundary bind forwarding to validated upstream identity with bounded revalidation, and extend the real wrong-chain scenario to assert that write traffic is not forwarded."
owner_domain = 8

[finding.governance-shell-arguments]
file = "services/platform/hosted/paxeer/gov-lib.sh"
line = 268
class = "runtime-risk"
severity = "medium"
observed = "tx_flags renders values with printf %q, but run_tx injects the resulting text through unquoted command substitution. Bash does not reparse those escapes, so spaces in HOME_DIR or a key name split arguments and globs may expand."
expected = "The governance command executed must contain the exact same argument values shown to the operator, including paths and key names containing whitespace or wildcard characters."
proposal = "In the maintained governance library build flags in a Bash array and pass the array directly to paxd; format that same array only for display and qualify a real CLI parse with whitespace and wildcard characters."
owner_domain = 8

[finding.governance-query-failure]
file = "services/platform/hosted/paxeer/gov-lib.sh"
line = 190
class = "runtime-risk"
severity = "medium"
observed = "paxd_query_optional converts every failed paxd query into {}, including network outages, invalid credentials or unsupported interfaces. Upgrade and proposal logic can mistake those failures for an absent plan or empty proposal list."
expected = "An optional missing chain object must remain distinguishable from failure to query the chain, so operator safety decisions never infer absence from an unavailable node."
proposal = "In the maintained governance library handle only the precise documented not-found response as absence and propagate all other failures with their diagnostics; cover actual no-plan, unreachable-node and malformed-query outcomes."
owner_domain = 8

[finding.governance-validator-page]
file = "services/platform/hosted/paxeer/gov-lib.sh"
line = 212
class = "runtime-risk"
severity = "low"
observed = "validator_count counts .validators from the default first RPC page, then callers label it the bonded validator total and print that many operator vote commands. Networks beyond one validators page are undercounted."
expected = "Operator planning output must distinguish a page length from the total validator set and must not omit validator vote instructions because of transport pagination."
proposal = "In the maintained governance library read the RPC total or paginate at one pinned height, and qualify planning output with a real validator set larger than one page while preserving voting power semantics."
owner_domain = 8

[finding.governance-proposal-association]
file = "services/platform/hosted/paxeer/gov-consensus-params.sh"
line = 255
class = "runtime-risk"
severity = "medium"
observed = "After submission the script discards run_tx output, lists proposals and selects the last whose first change key is TimeoutParams. A concurrently submitted proposal can become that last row and receive this command's yes vote."
expected = "A submitted governance action must track the exact proposal id emitted by its own committed transaction, and confirm its content before any automatic vote or success wait."
proposal = "In the maintained gov-consensus-params command extract proposal_id from the successful transaction events, fetch that exact proposal and compare subspace, key and value before voting; qualify concurrent distinct parameter submissions."
owner_domain = 8

