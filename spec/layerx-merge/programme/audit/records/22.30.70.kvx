[finding.export-stream-error]
file = "sdk/server/export.go"
line = 141
class = "runtime-risk"
severity = "medium"
observed = "The streaming export branch returns fmt.Errorf after fmt.Fprintf regardless of whether err is nil, so a successful write still reports error writing genesis state to file: <nil>. Deferred Close errors are ignored."
expected = "A successful streamed export must report success only after its output has been written and closed successfully, and genuine I/O failures must retain their actual error."
