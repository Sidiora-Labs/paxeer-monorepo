[finding.envelope-transport-budget]
file = "services/platform/perps-data/internal/delivery/envelope.go"
line = 123
class = "interface-mismatch"
severity = "high"
observed = "Envelope.Validate accepts an encoded body of exactly MaxEnvelopeBytes (1048576). stream.Config.MaxMsgSize and deploy/nats/nats.conf max_payload are also 1048576. publish.sink.send adds Perps-Seq, Perps-Block, Perps-Kind and JetStream identity/expectation headers, which count toward the broker limit. An enqueued event near the admission limit cannot reach consumers and is permanently quarantined and replaced by a skipped control; publisher_test.go:647-698 expressly expects this outcome."
expected = "A service-admitted envelope must fit its actual producer-to-broker-to-consumer path with all mandatory headers. Brief checks 1 and 4 require length limits to agree between layers; the declared maximum must round-trip without silently losing the event payload."
proposal = "Define a complete transport-size budget in services/platform/perps-data/internal/delivery/envelope.go, internal/publish/publisher.go and internal/stream/layout.go aligned with deploy/nats/nats.conf. Reserve a proven upper bound for all required headers and maximum IDs/sequences before enqueue, or raise stream/broker limits consistently while retaining explicit body/consumer bounds. Prove unchanged delivery of the largest admitted event and retain strict refusal/quarantine for genuinely oversized or legacy-invalid rows."
owner_domain = 8
interface = "3.go-perps-data-delivery-maxenvelopebytes-j27"
related_interfaces = ["3.fmt-perps-data-nats-stream-perps-v1-j27", "3.go-perps-data-natsdriver-publisher-publish-j27", "3.go-perps-data-delivery-envelope-encode-j27"]

