[finding.rewind-projections]
file = "services/platform/perps-data/internal/indexer/indexer.go"
line = 464
class = "interface-mismatch"
severity = "high"
observed = "Indexer.rebuild ignores Affected.Accounts, Markets and FromTime and calls store.Rebuild(a.From, a.From). Follower.rewind has already deleted every fact and perps.blocks row at or above From (follower.go:629-649). Rebuild derives scope from surviving range facts and returns nil when its filtered min(time) is NULL (facts.go:1397-1432). Cursor and rewind notification commit without restoring deleted projections or removing retained fork-derived daily/leaderboard/spot state. A restart reads the same inconsistent persisted projections."
expected = "FollowerOptions.Rebuild requires recomputing affected accounts and markets after fork deletion. Brief checks 1 and 5 and data-services section 5 require atomic recovery. Requirement 3502.1 requires affected projections to equal a fresh fold while unrelated account rows stay unchanged."
proposal = "In services/platform/perps-data/internal/indexer/indexer.go and internal/store/facts.go, add a rebuild entry point accepting the captured pre-deletion accounts, markets, spot entities and first changed time plus the surviving head. Refold surviving history and remove orphaned projections, daily rows, boards and snapshots transactionally before moving the cursor or announcing rewind. Update the equivalent cmd/perps-replay/main.go callback. Prove real follower-to-indexer-to-store recovery, restart and unrelated account preservation."
owner_domain = 8
interface = "3.go-perps-data-store-rebuild-j27"
related_interfaces = ["3.go-perps-data-source-affected-j27", "3.go-perps-data-source-followeroptions-j27"]

