[finding.rpc-url-credentials]
file = "services/platform/perps-data/internal/source/rpc.go"
line = 888
class = "security"
severity = "medium"
observed = "RPC.markFailure logs the complete sl.url and err.Error(); health transitions also log sl.url at rpc.go:964-966. Config.validURL accepts HTTP(S) URL userinfo, query strings and paths; Config.String prints RPCURLs and CometURLs verbatim. Configuring an authenticated upstream can expose its endpoint credentials during ordinary startup, failure, stale-node or recovery logging."
expected = "Brief check 8 requires secrets never to be logged. Operator endpoint credentials must remain private during startup and recovery just as DATABASE_URL, NATS_URL and PERPS_AUTH_SECRET are redacted."
proposal = "Use non-secret endpoint identifiers in services/platform/perps-data/internal/source/rpc.go and redact credential-bearing URL components in internal/config/config.go and source/comet.go error paths. Sanitize wrapped HTTP errors as well as explicit URL attributes, retaining method, endpoint index and failure class. Add log captures with sentinel userinfo/query/path secrets for startup, failures and health transitions."
owner_domain = 8
interface = "3.go-perps-data-source-rpc-j27"

[finding.auth-challenge-retention]
file = "services/platform/perps-data/internal/auth/auth.go"
line = 43
class = "runtime-risk"
severity = "medium"
observed = "Every unauthenticated Challenge inserts a perps.auth_challenges row. Verify only sets used_at; expires_at bounds validity but never removes data. The auth service, gateway background loops and migrations supply no cleanup or retention job. Normal sign-ins and repeated valid-address requests grow the shared PostgreSQL table indefinitely despite the five-minute nonce lifetime and ingress rate limits."
expected = "Brief checks 4 and 5 require bounded growth and a defined persistent-state lifecycle. Expired and consumed login nonces should not occupy shared service storage forever; cleanup must neither revive a nonce nor delete a still-valid challenge."
proposal = "Add bounded indexed expiry cleanup owned by services/platform/perps-data/internal/auth/auth.go with a supporting migration and cancellation-aware wiring in internal/gateway/server.go. Specify retention for expired/consumed challenges, preserve atomic single use and expose cleanup failures. Prove expiry cleanup across gateway restart while valid challenges remain usable and old/consumed nonces stay refused."
owner_domain = 8
interface = "3.go-perps-data-auth-service-j27"

