[finding.readme-premerge-network]
file = "README.md"
line = 47
class = "doc-drift"
severity = "medium"
observed = "Lines 44-47 present two execution domains and a separate cmd/layerxd whose checkpoints settle through layerxAnchor. Lines 79 and 181 call the merge draft, line 145 directs make layerxd, and line 83 lists retired verify/custody/anchor precompiles without post-upgrade refusal behavior."
expected = "Brief network facts 1-2 define one BFT network with its kernel inside paxd. Block commit makes a receipt final. retired.kvx retires verify, custody and anchor settlement instead of making them current deployment dependencies."
proposal = "Rewrite README.md:44-57,79-83,141-147,181 for the merged release: run paxd with the embedded kernel, describe committed-block finality and chain id 125, label legacy sources as historical, and explain retired precompile refusals plus native balance/proof replacements."
owner_domain = 17

