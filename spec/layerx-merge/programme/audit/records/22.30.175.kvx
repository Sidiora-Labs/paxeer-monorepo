domain = 16
lines_reviewed = 30647
bytes_reviewed = 1163646
summary = "OpenZeppelin v5.3.0 is a pinned offline Solidity dependency of the benchmark. Every member receives the vendored verdict permitted by the brief. No high merged-network defect is established in this slice; five documentation defects and two groups of false registry consumer edges require proposals."
qualification_scope = "The task gate qualifies the audit record and graph coverage. It does not compile Solidity, execute contracts, qualify live RPCs or certify every inventory sweep target under requirement 22998.1."

[coverage.provenance]
upstream = "https://github.com/OpenZeppelin/openzeppelin-contracts"
upstream_revision = "e4f70216d759d8e6a64144a9e1f7bbeed78e7079"
version = "5.3.0"
source_archive_sha256 = "49c41e34c683c6593932aa6c5485e621e61ec55d2b9c7c74b5e1aed99c9715a5"
provenance = "tools/benchmark/loadtest/contracts/evm/VENDORING.md:7"
method = "Every member was opened in full for byte and line accounting, provenance classification, import inspection and retired-reference inspection. Vendored verdicts retain attribution instead of claiming independent review of upstream algorithms or a fresh comparison against the archive."
requirements = "The package lists no component requirements and no produced registry rows. Task requirement 22998.1 supplies the recorded-gate evidence obligation; no historical Solidity build or test result is asserted here."

[coverage.wiring]
observed = "The benchmark remappings select this vendor tree. ERC20Token.sol and NoopToken.sol import ERC20; UniswapV2Pair.sol imports Initializable. Their complete OpenZeppelin import closure contains six package members. Other members are optional upstream components or upstream test helpers, not independently running network services."
reachable_members = ["tools/benchmark/loadtest/contracts/evm/lib/openzeppelin-contracts/contracts/interfaces/draft-IERC6093.sol", "tools/benchmark/loadtest/contracts/evm/lib/openzeppelin-contracts/contracts/proxy/utils/Initializable.sol", "tools/benchmark/loadtest/contracts/evm/lib/openzeppelin-contracts/contracts/token/ERC20/ERC20.sol", "tools/benchmark/loadtest/contracts/evm/lib/openzeppelin-contracts/contracts/token/ERC20/IERC20.sol", "tools/benchmark/loadtest/contracts/evm/lib/openzeppelin-contracts/contracts/token/ERC20/extensions/IERC20Metadata.sol", "tools/benchmark/loadtest/contracts/evm/lib/openzeppelin-contracts/contracts/utils/Context.sol"]
compiler = "The benchmark profile pins Solidity 0.8.20. All six reachable OpenZeppelin members declare ^0.8.20. Newer-compiler components elsewhere in the vendor tree do not establish a failure in that import closure."
transport = "The slice contains Solidity code and npm metadata, with no Rust configuration decoder, HTTP client, gateway route registration, sequencer process or disk journal."

[coverage.brief-checks]
interface_agreement = "All 62 supplied consumer rows were compared with listed source references and producer declarations. The 59 Rust configuration edges match unrelated Solidity terms or upstream metadata. The three RPC edges point to explanatory comments. Per-row evidence appears in interface_review blocks; none is a live producer-transport-consumer path in this slice."
retired_references = "Complete member contents contain no retired component symbols from retired.kvx, separate layerxd daemon, public /rpc route or Paxeer public endpoint default. Standard upstream references to governor, timelock and vault are independent of retired LayerX custody and anchor services."
runtime_risk = "The benchmark import closure uses standard ERC20 storage and initializer state. Optional upstream forwarding, governance, proxies, transient-storage and cryptographic helpers are vendored components; their presence does not establish that the merged node exposes them."
restart_recovery = "Reachable Solidity state resides in EVM account storage, including balances, allowances and initializer versions. No host-memory restart cursor, journal replay or background recovery protocol is introduced by this slice."
configuration = "CAIP namespace/chain_id comments, repository.url, ERC4337 fee fields and governance quorum are not interop configuration inputs. No production chain id or RPC endpoint is configured by these vendor members."
tests = "contracts/mocks contains upstream test helpers, not registered first-party network tests or proof of interop transport compatibility. No test is added, skipped, weakened or executed by this audit implementation. The task declares no behavioral tests."
security = "Local hashing and signature recovery do not request node-held keys or bypass public refusal of eth_signTypedData. Service authentication, external signing and production contract deployment belong to their actual consumers. No independent upstream security certification is claimed."
documentation = "All seven package pages and the vendor provenance page were read. The 62 selected registry rows were read as interface documentation. Stale deployment and endpoint instructions have findings with exact source locations and owning-domain proposals."

