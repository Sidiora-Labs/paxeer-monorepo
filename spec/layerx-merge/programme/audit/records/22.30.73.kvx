[finding.armor-password-code]
file = "sdk/crypto/armor.go"
line = 195
class = "interface-mismatch"
severity = "medium"
observed = "DecryptSymmetric emits lowercase ciphertext decryption failed at line 97, but decryptPrivKey compares the capitalized Ciphertext decryption failed. ImportPrivKey therefore receives an untyped error instead of ErrWrongPassword."
expected = "The exported armor decoder must preserve the SDK wrong-password error classification for keyring import callers, including after wrapping."
proposal = "In sdk/crypto/armor.go use a decryption sentinel and typed wrapping rather than matching error text; verify ErrWrongPassword through sdk/crypto/keyring ImportPrivKey with an actual encrypted key."
owner_domain = 15
interface = "15.go-types-errors-err-wrong-password-j76"

[finding.armor-kdf-recovery]
file = "sdk/crypto/armor.go"
line = 123
class = "restart-recovery"
severity = "medium"
observed = "EncryptArmorPrivKey stores kdf and salt but omits the bcrypt cost. decryptPrivKey always uses the current mutable BcryptSecurityParameter. An export created at one effective cost cannot be restored with the correct password after a process starts with another effective cost; arguments below the dependency minimum all normalize to cost 10."
expected = "An exported key must carry the KDF parameters needed to restore the same account across restarts and future password-hardening upgrades."
proposal = "Version the envelope in sdk/crypto/armor.go, store and bound its cost, preserve cost 12 for legacy envelopes, and prove export in one process and restore in a new process with a different configured default."
owner_domain = 15
interface = "15.go-crypto-encrypt-armor-priv-key-j76"

[finding.symmetric-empty-payload]
file = "sdk/crypto/armor.go"
line = 86
class = "runtime-risk"
severity = "medium"
observed = "EncryptSymmetric accepts empty plaintext and emits a 40-byte nonce-plus-tag ciphertext, while DecryptSymmetric rejects every length less than or equal to 40 before authenticating it."
expected = "The symmetric encryption pair must either support an authenticated empty plaintext in both directions or refuse it consistently before encryption."
proposal = "In sdk/crypto/armor.go admit the exact nonce-plus-tag length for authentication and add an empty plaintext round-trip alongside truncated-tag and tampering refusals."
owner_domain = 15

[finding.ledger-algorithm]
file = "sdk/crypto/keyring/keyring.go"
line = 201
class = "interface-mismatch"
severity = "high"
observed = "SupportedAlgosLedger advertises sr25519 as well as secp256k1. SaveLedgerKey always calls NewPrivKeySecp256k1 at line 364 and stores the requested algorithm at line 369, so an sr25519 request produces a secp256k1 public key and signatures labeled sr25519."
expected = "A supported hardware signing algorithm must agree with the device key type, the persisted Info.GetAlgo value, and the verifier that consumes the signature."
proposal = "In sdk/crypto/keyring/keyring.go advertise only hardware algorithms the device path implements and reject sr25519 before device access; add a real supported-device create, reopen and sign proof with matching key type and algorithm."
owner_domain = 15
interface = "15.go-crypto-keyring-keyring-j76"

[finding.keyring-partial-persistence]
file = "sdk/crypto/keyring/keyring.go"
line = 771
class = "restart-recovery"
severity = "medium"
observed = "writeInfo persists name.info and the address index in separate Set calls without rollback or reconciliation. An error or restart between calls leaves a key address lookup cannot find and retries reject as already present. Delete similarly removes the index before the name at lines 409-414."
expected = "Creating and deleting a wallet must leave the name and address views consistent after storage errors or restart, with an explicit recoverable outcome."
proposal = "Add a recoverable operation journal or atomic backend transaction in sdk/crypto/keyring, reconcile incomplete name/address operations on reopen, and exercise actual file-backend interruption and retry without replacing the account."
owner_domain = 15
interface = "15.go-crypto-keyring-keyring-j76"

[finding.keyring-list-invalid-info]
file = "sdk/crypto/keyring/keyring.go"
line = 462
class = "interface-mismatch"
severity = "medium"
observed = "List prints storage or decode errors and returns success with offlineInfo entries whose public key is nil (also lines 472 and 483). The actual keys list consumer calls MkAccKeysOutput and dereferences pk.Address at output.go:67, causing a panic for the supposed successful list."
expected = "A successful key listing must contain usable public information; damaged entries must produce a typed recoverable error rather than an Info that violates the output consumer shape."
proposal = "In sdk/crypto/keyring/keyring.go return a structured corruption error identifying the affected entry and preserve healthy records for recovery; make output.go propagate that condition and test the real persisted-corruption to CLI-output path."
owner_domain = 15
interface = "15.go-crypto-keyring-info-j76"

[finding.keyring-empty-address-index]
file = "sdk/crypto/keyring/keyring.go"
line = 428
class = "runtime-risk"
severity = "medium"
observed = "KeyByAddress calls wrapKeyNotFound with a nil error when an existing index has empty Data; wrapKeyNotFound returns nil. The result is (nil, nil), and SignByAddress and DeleteByAddress then dereference the absent Info."
expected = "A missing or empty address index must return ErrKeyNotFound or an explicit corruption error and never report a successful nil key."
proposal = "Return the typed missing-index error directly in sdk/crypto/keyring/keyring.go and verify KeyByAddress, SignByAddress and DeleteByAddress against a reopened file store containing an empty index."
owner_domain = 15
interface = "15.go-types-errors-err-key-not-found-j76"

[finding.keyring-import-algorithm]
file = "sdk/crypto/keyring/keyring.go"
line = 287
class = "interface-mismatch"
severity = "medium"
