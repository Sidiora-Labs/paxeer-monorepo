[finding.rate-unbound-view]
file = "services/interop/crates/layerx-gas-station/src/rate.rs"
line = 795
class = "security"
severity = "medium"
observed = "verify_signed_receipt checks pinned signature and activity_id only. confirm_by_receipt then trusts separate JSON status/from/to/gas and RateUpdated logs in sequencer_outcome without comparing them to the verified result/effects. A genuine signed receipt for the same transaction can accompany an altered JSON outcome and pass this signature guard. HTTPS quorum remains a separate trust boundary; this does not directly create balances."
expected = "Receipt-verified publication outcome must bind its execution summary and events to canonical signed effects, as the node producer does in rpc/sequencer_receipt.go."
proposal = "In services/interop/crates/layerx-gas-station/src/rate.rs derive outcome from the verified protocol receipt and validate JSON summary/log commitments against its effects using the node layout. Use producer-origin receipts and require rejection when only JSON status, gas or event data is changed."
owner_domain = 11
interface = "7.rpc-pax-sequencerreceipt"

[finding.rate-fixture-effects]
file = "services/interop/crates/layerx-gas-station/tests/rate.rs"
line = 96
class = "test-gap"
severity = "medium"
observed = "The signed receipt builder encodes sequence_length(0,512) for effects while served JSON claims an execution summary and RateUpdated log. rpc/sequencer_receipt.go:531 rejects a receipt without a summary effect. Canonical re-encoding/signing makes this valid wire data but not an answer the actual producer emits."
expected = "Brief check 7 requires publication tests to use the real producer shape and prove that signed execution effects agree with the JSON view."
proposal = "Obtain genuine publication execution receipts for services/interop/crates/layerx-gas-station/tests/rate.rs and preserve their signed effects and JSON unchanged. Cover success, revert, view-only tampering, commitment and recovery of a persisted pending publication through the real producer/consumer path."
owner_domain = 11
interface = "7.rpc-pax-sequencerreceipt"

[finding.gas-journal-growth]
file = "services/interop/crates/layerx-gas-station/src/journal.rs"
line = 1142
class = "runtime-risk"
severity = "medium"
observed = "Journal::append clones all retained State before every transition and adds a synced JSON line. Items, admissions, receipts and rate transactions have no compaction/retention boundary. Active-quote limits do not bound completed history, so memory, append work, policy scans and startup replay grow with lifetime traffic."
expected = "Brief checks 4 and 5 require bounded operational growth while preserving replay guards, nonce history, accounting and recovery evidence after restart."
proposal = "Add authenticated compact snapshots and rotation in services/interop/crates/layerx-gas-station/src/journal.rs, preserving unresolved transactions, nonce/replay guards, finalized accounting and policy identity. Bound working indexes and prove compaction/reopen preserves admission, liabilities and recovery under sustained traffic."
owner_domain = 11

[finding.migration-rpc-deadline]
file = "services/interop/crates/layerx-migrate/src/rpc.rs"
line = 230
class = "runtime-risk"
severity = "medium"
observed = "Endpoint::request performs blocking DNS, up to eight separate full connect timeouts and full per-operation socket read/write timeouts. read_json_rpc has no absolute elapsed deadline. A peer streaming bytes within each read timeout can occupy verification far beyond request_timeout_ms."
expected = "The source and rollback RPC request-timeout contract must provide a bounded lifecycle, including resolution, connection, TLS and response completion rather than an inactivity limit only."
proposal = "Enforce one monotonic total deadline in services/interop/crates/layerx-migrate/src/rpc.rs through resolution, address attempts, TLS, writes, response framing and quorum collection. Apply remaining budget to blocking operations and prove stalled and slowly streaming HTTPS peers terminate within the bound."
owner_domain = 11
interface = "11.cfg-migrate-rpc-quorum-config-request-timeout-ms"

[finding.gateway-deadline-budget]
file = "services/interop/crates/layerx-migrate/src/gateway_client.rs"
line = 143
class = "runtime-risk"
severity = "medium"
observed = "GatewayClient resolves DNS and tries up to eight connect budgets before creating its deadline. Socket read/write timeouts remain the full request_timeout; response checks time only before a blocking read, allowing a late read another full timeout. Header/body writes likewise lack a remaining elapsed budget."
expected = "The gateway timeout must bound the complete funded-operator submission and retain an explicit unknown outcome after an operation might have been accepted."
proposal = "In services/interop/crates/layerx-migrate/src/gateway_client.rs create one deadline before resolution/connection and pass remaining duration into every TLS/write/read operation. Retain GatewaySubmissionUnknown after possible transmission; prove slow headers/bodies and same-idempotency retry behavior."
owner_domain = 11
interface = "11.cfg-migrate-gateway-client-config-request-timeout-ms"

[finding.rollback-authority-unwired]
file = "services/interop/crates/layerx-migrate/src/journal.rs"
line = 709
class = "wiring-gap"
severity = "medium"
observed = "Journal synchronization calls layerx_getMigrationJournalHead and layerx_advanceMigrationJournalHead with compare-and-swap head payloads. Repository call/route search finds these consumer calls and OPERATIONS.md:22-25 but no production handler or deployment for either method. Correct fail-closed behavior still depends on an externally unspecified durable authority."
expected = "The independent rollback authority needed for verifiers and history must have an identified producer, authenticated namespace ownership, durable linearizable CAS and a recoverable deployment contract."
proposal = "Assign services/platform/hosted/authority an explicit migration-head interface and durable implementation or identify the separately delivered production owner. Register and deploy authenticated majority endpoints; prove real journal open/append/reopen, concurrent CAS and local rollback refusal across authority restart."
owner_domain = 8

[finding.attestor-inventory-path]
