line = 6
class = "config-drift"
severity = "medium"
observed = "The checked-in bridge/attestor key_file is /run/secrets/bridge/signer/attestor.key, while all five relayer manifests select/mount attestor-N.key. docker/bridge-relayer/entrypoint.sh:60-62 requires exact equality. Each manifest mounts BRIDGE_SIGNER_KEYS, so a customized secret can work, but the supplied inventory cannot be used unchanged with any instance."
