[finding.failed-sponsor]
file = "services/interop/crates/layerx-gas-station/src/service.rs"
line = 333
class = "interface-mismatch"
severity = "high"
observed = "Service::sequencer_summary and sequencer_receipt require failed execution sponsor=None. The RPC decoder preserves an address string as Some(address). rpc/sequencer_receipt.go:154,552 emits common.Address as a string, including the zero address for failed unsponsored execution. A genuine failed sponsored transaction is therefore reported as malformed/unavailable instead of the intended reverted refusal."
expected = "Registry 7.rpc-pax-sequencerreceipt and requirements 11263.1 and 11264.1 require producer receipts to survive the service boundary and distinguish unsuccessful execution from malformed evidence."
proposal = "Align services/interop/crates/layerx-gas-station/src/service.rs and src/rpc.rs with rpc/sequencer_receipt.go on failed sponsor representation. Normalize the permitted failed zero address while retaining foreign-successful-sponsor rejection. Drive a genuine reverted node receipt through submit, status and reopen recovery and assert the documented refusal."
owner_domain = 11
interface = "7.rpc-pax-sequencerreceipt"

[finding.history-transfer-loss]
file = "services/interop/crates/layerx-migrate/src/ethereum.rs"
line = 713
class = "runtime-risk"
severity = "high"
observed = "prepare_history_page deduplicates on (transaction, source_asset, kind), but history_events:858-879 emits every ERC20 Transfer with its individual source_amount. Distinct same-asset transfers in one transaction collapse to the first amount. The page cursor still advances beyond the block, permanently losing the remaining source history; custody and token-event overlap can also collide."
expected = "External history must preserve all verified amounts and distinguish repeated observations from distinct source logs, including durable page replay after restart."
proposal = "In services/interop/crates/layerx-migrate/src/ethereum.rs deduplicate observations by transaction/log index before checked aggregation into the declared record identity. Alternatively extend identity consistently through src/lib.rs, src/history.rs, src/journal.rs and cursors. Prove genuine multiple same-asset transfers, overlapping queries and sink reopen preserve all amounts."
owner_domain = 11
interface = "11.rs-migrate-external-history-record"

[finding.solana-code-offset]
file = "services/interop/crates/layerx-migrate/src/solana.rs"
line = 1411
class = "interface-mismatch"
severity = "high"
observed = "immutable_program_code returns data[13..] after the ProgramData tag, slot and None authority byte. The upgradeable loader reserves a fixed 45-byte metadata region even when authority is None; executable bytes begin after it. verify_program_boundary:276-279 hashes 32 metadata bytes along with code and refuses a pin computed over deployed code. contracts/bridge/solana/admin/src/main.rs:1186 already uses UpgradeableLoaderState::size_of_programdata_metadata()."
expected = "OPERATIONS.md:18 and custody_program_data_hash describe an immutable program code pin; the verifier must select the same byte region as the actual source deployment hash producer."
proposal = "Use the canonical loader metadata size in services/interop/crates/layerx-migrate/src/solana.rs, validate the full metadata region and explicitly define executable padding in the pin format. Align deployment hash generation and registry documentation; verify a captured finalized immutable ProgramData account with its exact deployed-code hash and reject altered metadata or code."
owner_domain = 11
interface = "11.cfg-migrate-solana-config-custody-program-data-hash"

[finding.registered-budget-unwired]
file = "services/interop/crates/layerx-gas-station/src/config.rs"
line = 335
class = "wiring-gap"
severity = "medium"
observed = "ServiceConfig parses registered_senders and exposes account_budget, but only tests call that helper. Service::new:245-266 does not retain the list and the live policy uses ordinary per_account_limit. A configured sender-specific budget has no effect on quote admission."
expected = "Registry 11.cfg-gas-registered-senders and account_budget promise registered senders their own per-interval cap and ordinary accounts the default cap."
proposal = "Carry registered_senders from services/interop/crates/layerx-gas-station/src/config.rs through src/service.rs to src/policy.rs reservation enforcement and persistent policy identity. Exercise cumulative admissions across different custom/default caps and prove reopening preserves accounting."
owner_domain = 11
interface = "11.cfg-gas-registered-senders"

[finding.revert-fixture-shape]
file = "services/interop/crates/layerx-gas-station/tests/service.rs"
line = 221
class = "test-gap"
severity = "medium"
observed = "The reverted phase passes Value::Null as sponsor and a_reverted_receipt_is_refused_and_reported_reverted asserts 422 against that invented shape. rpc/sequencer_receipt.go emits an address string; tests/sequencer_receipt.rs:90 already recognizes Some(zero address). The synthetic exchange hides the failed-sponsor service mismatch."
expected = "Requirements 11263.1 and 11264.1 and brief check 7 require service tests to consume an actual producer-shaped receipt, including unsuccessful executions."
proposal = "Replace the reverted exchange in services/interop/crates/layerx-gas-station/tests/service.rs with a genuine failed node receipt recording and connect node producer, transport and HTTP service. Keep the refusal assertion and add status/restart coverage without weakening malformed-receipt checks."
owner_domain = 11
interface = "7.rpc-pax-sequencerreceipt"

[finding.registered-budget-test-gap]
file = "services/interop/crates/layerx-gas-station/tests/service.rs"
line = 989
