[finding.committed_without_inclusion]
file = "services/explorer/backend/apps/explorer/test/support/fixture/paxeer_x/committed_vectors.json"
line = 40
class = "test-gap"
severity = "high"
observed = "committed-ok combines V1-pax-transfer with a five-field eth_receipt, caller-supplied batch range 1..4 and the independent four_of_four synthetic header at height 1000. Header data_hash, app_hash and last_results_hash contain repeated 04, 06 and 07 bytes; no transaction, batch or execution-result inclusion witness is present. SequencerReceipt.committed/4 and r7/4 compare receipt fields, range and height, while CometCommit.verify/3 authenticates only the supplied header and validator set. committed_vectors_test.exs expects committed, and status_committed_test.exs promotes an unindexed hash even when the indexed committed head is absent. The positive fixture endorses finality without binding this transaction to the committed block."
expected = "A receipt is final when its own block is committed. Matching a height and an unauthenticated sequence interval does not establish inclusion or independently trusted chain identity. Requirement 14244.1 freezes three R7/R8 outcomes, but brief facts 1 and 7 and docs/site/docs/agents/sdk-verification.md require authenticated execution evidence for the positive outcome."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/sequencer_receipt.ex and comet_commit.ex, bind the transaction and execution result to its authenticated committed block and trusted validator history before returning committed. Replace the positive committed_vectors.json case with same-execution evidence, using daemon/committed-fixture V4 as a reference, and extend committed_vectors_test.exs and status_committed_test.exs with unrelated valid headers, altered ranges, wrong block identities and reconstruction cases. Preserve R7/R8 rejection coverage and coordinate required node proof transport with domain 7."
owner_domain = 14
interface = "7.rpc-eth-gettransactionreceipt"

[finding.historical_pending_shape]
file = "services/explorer/backend/apps/explorer/test/support/fixture/vcr_cassettes/block_importer_import_1_pending.json"
line = 15
class = "test-gap"
severity = "medium"
observed = "This generated February 2018 Parity capture requests eth_getBlockByNumber(pending,true) but returns non-null hash and stateRoot, a numbered block and seven transactions with mined blockHash/blockNumber/index fields. The declared pending-block contract says an open pending block never claims a hash or stateRoot. No current use_cassette reference to this named recording was found; this is a coverage gap, not demonstrated current runtime corruption."
expected = "Historical upstream import samples must be distinguishable from merged-node conformance evidence. Fixtures for the declared open-block RPC path must represent the actual producer and exercise the transition to committed state."
proposal = "In services/explorer/backend/apps/explorer/test/support/fixture/vcr_cassettes, label this capture as historical Parity evidence and preserve its regression purpose. Add separate producer captures from rpc/block.go pendingBlock and consume them through the explorer block decoder, including fullTx selection and commit/restart transition, before relying on cassette coverage to qualify merged pending imports."
owner_domain = 14
interface = "7.rpc-eth-getblockbynumber"

