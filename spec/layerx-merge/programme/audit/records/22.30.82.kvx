[finding.tenant-backfill]
file = "services/platform/hosted/indexer/src/blockscout.rs"
line = 443
class = "interface-mismatch"
severity = "high"
observed = "rpc_blocks emits transactions without chainId. paxeer::chain_activity returns None without that field; Store::write_unit consequently assigns imported tenant transfers and events to paxeer and omits tenant activity totals. The persisted cutover means following never revisits this history."
expected = "Requirement 20006.1 requires tenant transaction rows to retain pax:<id> and per-chain summary totals on historical import as well as live ingestion."
proposal = "Preserve verified transaction chainId through services/platform/hosted/indexer/src/paxscan.rs and blockscout.rs into decode_block. Prove tenant transfers, events and summary equality across backfill, cutover and reopen."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-store-unit"

[finding.tenant-query]
file = "services/platform/hosted/indexer/src/paxscan.rs"
line = 194
class = "wiring-gap"
severity = "medium"
observed = "PaxscanDatabase::range selects transaction hashes, sender, recipient, value and input but no transaction chain id. TransactionRow cannot carry the namespace metadata consumed by live chain_activity."
expected = "The database transport must preserve the transaction domain needed by requirement 20006.1 rather than constructing root-domain transactions from incomplete rows."
proposal = "Extend services/platform/hosted/indexer/src/paxscan.rs and TransactionRow together to obtain verified transaction domains, querying the node when the database cannot supply them; refuse unresolved domains instead of assigning root history."
owner_domain = 8
interface = "8.env-indexer-paxscan-database-public-url-j69"

[finding.backfill-content-authentication]
file = "services/platform/hosted/indexer/src/backfill.rs"
line = 202
class = "security"
severity = "high"
observed = "apply_range compares the database block hash and ordered transaction hashes with the node, then trusts database transaction bodies and receipts. Changed sender, value or log data under the same listed hashes passes. PaxscanTls::Unauthenticated allows this input from a peer with no authenticated identity."
expected = "Imported transfer, name and registry state must represent committed transaction and receipt contents. Comparing identifiers alone cannot authenticate the bodies that determine published history."
proposal = "In services/platform/hosted/indexer/src/backfill.rs verify transaction and receipt contents against committed roots or obtain them from the authenticated node before commit. Cover altered logs and amounts and ensure the unauthenticated database option cannot publish unverified state."
owner_domain = 8
interface = "8.env-indexer-layerx-indexer-paxscan-tls-unauthenticated-j69"

[finding.snapshot-membership]
file = "services/platform/hosted/indexer/src/ai_market.rs"
line = 338
class = "security"
severity = "high"
observed = "verify_block_commit verifies header and validator signatures but only requires nonempty store_proof and hashes it. promote trusts caller-supplied state and the SequencerSigned enum, matches caller metadata to app_hash, and publishes rank 4 without verifying the program state leaf. StateCapture and bind_snapshot check internal consistency, not membership."
expected = "Finalized snapshots must bind the exact program state bytes to authenticated committed state. A digest of arbitrary proof bytes cannot establish membership under the committed app hash."
proposal = "Add real committed state-membership verification in services/platform/hosted/indexer/src/ai_market.rs before finality promotion. Bind the verified key, chain, program, state digest and root; reject nonempty malformed proofs and unrelated valid state proofs."
owner_domain = 8
interface = "13.rs-aim-queries-readproof"

[finding.reputation-membership]
file = "services/platform/hosted/indexer/src/ai_reputation.rs"
line = 407
class = "security"
severity = "high"
observed = "ReputationProjector::admit uses the hash-only proof helper and reassembles caller-supplied F07 chunks. A signed header and matching claimed root permit publication of internally consistent reputation state without proving that the program leaf belongs to the committed root."
expected = "Finalized reputation must derive from the exact program state authenticated under the committed app hash, including after reopening the durable projector."
proposal = "Make services/platform/hosted/indexer/src/ai_reputation.rs consume the authenticated program-state result of the shared membership verifier. Reject changed F07 payloads under an unchanged valid commit and prove refusal across reopen."
owner_domain = 8
interface = "13.rs-aim-queries-statecapture"

[finding.snapshot-archive]
file = "services/platform/hosted/indexer/src/ai_market.rs"
line = 1156
class = "restart-recovery"
severity = "medium"
observed = "make_room and archive set state=NULL and projection=4 without writing the body to an archive or retaining an archive acknowledgement. archive claims to move content to an external archive, but restore_archived requires the caller to supply the bytes the eviction path discarded."
expected = "A snapshot advertised as archived must have recoverable content or an explicit pruned lifecycle. Recovery must not depend on a test retaining original body bytes in memory."
proposal = "In services/platform/hosted/indexer/src/ai_market.rs acknowledge a durable digest-addressed archive and persist its locator before removing a body. Prove recovery after restart, or expose an explicit pruned state and correct the archive claim."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-ai-market-projectionstate"

[finding.authority-regression]
file = "services/platform/hosted/indexer/src/ai_market.rs"
line = 1869
class = "runtime-risk"
severity = "medium"
observed = "market_view and require_fresh_authority use saturating_sub. An independently verified height below the snapshot execution height becomes lag zero, Current, and acceptable for authority use. ai_health::authority_lag instead refuses this as AuthorityRegression."
expected = "Routing, signing and runner release must fail closed when verified authority regresses below the snapshot being used, consistently across market and health projections."
proposal = "Use checked height ordering in services/platform/hosted/indexer/src/ai_market.rs and return a regression refusal. Add lower-height cases to tests/ai_snapshot_minimal.rs for freshness reporting and signing admission."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-ai-market-freshness"

[finding.limiter-retention]
file = "services/platform/hosted/indexer/src/ai_market.rs"
line = 758
class = "runtime-risk"
severity = "medium"
observed = "QueryLimiter inserts one HashMap bucket per viewer visibility. Permit::drop only reduces active; no expiry or cardinality bound removes idle principals, so a long-lived gateway retains all distinct principals even after their keys are revoked."
expected = "The public query limiter must bound memory as well as request rate and concurrency without resetting active principal quotas."
proposal = "Bound and expire zero-active idle buckets in services/platform/hosted/indexer/src/ai_market.rs. Refuse admission at safe capacity and cover principal churn, outstanding permits and expiry while preserving live quotas."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-ai-market-querylimiter"

[finding.abi-bytes24]
file = "services/platform/hosted/indexer/src/abi.rs"
line = 164
class = "runtime-risk"
severity = "medium"
observed = "AbiType::parse maps both bytes24 and function to FixedBytes(24), while canonical emits function for this variant. An ABI event declaring bytes24 therefore gets a different canonical signature and topic from the Solidity producer."
expected = "Canonical signatures must preserve distinct Solidity bytes24 and function names even though their encoded values both use 24 bytes."
proposal = "Give function a distinct AbiType variant in services/platform/hosted/indexer/src/abi.rs, preserve bytes24 canonicalization and cover both topics and nested array forms."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-abi-keccak"

[finding.comet-fallback-wiring]
file = "services/platform/hosted/indexer/src/main.rs"
line = 175
class = "wiring-gap"
severity = "medium"
observed = "The daemon invokes observe_comet(store)? before step. observe_comet rejects status tx_index other than on, preventing the daemon from reaching cosmos_range's TX_INDEX_DISABLED EVM-only fallback on an archive node with transaction indexing disabled."
expected = "The EVM-only fallback must be reachable from the running daemon while readiness honestly reports unavailable Cosmos enrichment."
proposal = "Separate source observation from EVM progress in services/platform/hosted/indexer/src/main.rs and paxeer.rs for the recognized disabled-index condition. Cover the actual daemon callback order with tx_index off."
owner_domain = 8
interface = "8.env-indexer-layerx-indexer-comet-url-j69"

[finding.ai-runtime-wiring]
file = "services/platform/hosted/indexer/src/main.rs"
line = 190
class = "wiring-gap"
severity = "medium"
observed = "The indexer starts only Paxeer following and api::serve_with; no production caller observes or promotes ProjectionStore snapshots or admits ReputationProjector captures. Gateway ai_views::respond is exported by its library but its executable dispatcher does not call it."
expected = "Hosted AI projections need running committed-state producers, durable updates and mounted authenticated query consumers. Exported helpers alone do not make these interfaces operational."
proposal = "Wire committed program-read ingestion and durable AI projections into services/platform/hosted/indexer/src/main.rs and mount services/platform/hosted/gateway/src/ai_views.rs from its dispatcher. Prove authenticated publication and reads across process restart."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-ai-market-projectionstore"

[finding.legacy-settlement-output]
file = "services/platform/hosted/indexer/src/store.rs"
line = 2204
class = "retired-reference"
severity = "medium"
observed = "Store retains settlement_evidence and transfer_document returns its saved JSON whenever present. Reopening a pre-upgrade database can therefore expose retired checkpoint or settlement authority after the ingestion and configuration paths were removed."
expected = "The merged indexer must publish block_commit final_basis without presenting cached retired checkpoint settlement as current authority."
proposal = "Add an explicit upgrade migration and output policy in services/platform/hosted/indexer/src/store.rs that retires legacy settlement documents while preserving history. Cover reopen of a pre-upgrade database with populated settlement_evidence."
owner_domain = 8
interface = "8.fmt-indexer-store-schema"

[finding.names-unbounded-reads]
file = "services/platform/hosted/indexer/src/store.rs"
line = 2333
class = "runtime-risk"
severity = "medium"
observed = "name_events collects every event for a node into a Vec without a limit, and query_names similarly collects every matching portfolio name. Public names routes serialize all results while holding shared store work, unlike bounded history and holder endpoints."
expected = "Public name history and address lookup must have explicit response and database-work bounds so large histories or portfolios cannot exhaust service memory."
proposal = "Introduce bounded pagination or an explicit maximum-result refusal in services/platform/hosted/indexer/src/store.rs and api.rs; coordinate explorer and wallet consumers and cover histories and portfolios above the bound."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-store-store"

[finding.reverse-forward-binding]
file = "services/platform/hosted/indexer/src/store.rs"
line = 2366
class = "security"
severity = "medium"
observed = "name_for_address returns self.name(reverse) for a claimed reverse name without checking the forward record resolves to the queried address or remains unexpired. An address can consequently be displayed with another account's unconfirmed name."
expected = "An address primary name should require matching valid forward and reverse records; an unconfirmed reverse label must not imply ownership of the forward name."
proposal = "Validate the forward target and expiry in services/platform/hosted/indexer/src/store.rs before returning the primary name. Add names API cases for foreign targets, expired registration and valid forward/reverse pairs."
owner_domain = 8
interface = "8.rs-indexer-layerx-indexer-store-store"

[finding.transport-total-deadline]
file = "services/platform/hosted/indexer/src/transport.rs"
line = 309
class = "runtime-risk"
severity = "medium"
observed = "round_trip reads until EOF and socket timeouts apply separately to each read. A peer trickling bytes can exceed LAYERX_INDEXER_TIMEOUT_MS indefinitely within the response-size bound, while a complete Content-Length body still waits for connection close."
expected = "The RPC timeout should bound the complete request lifecycle and complete HTTP framing should end the response independently of peer connection teardown."
proposal = "Apply a monotonic total deadline and incremental bounded HTTP framing in services/platform/hosted/indexer/src/transport.rs, including TLS reads and writes. Cover trickling responses and a complete body on a connection that remains open."
owner_domain = 8
interface = "8.env-indexer-layerx-indexer-timeout-ms-j69"

