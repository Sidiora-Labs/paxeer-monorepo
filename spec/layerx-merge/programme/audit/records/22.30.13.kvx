[finding.018]
file = "modules/oracle/simulation/genesis.go"
line = 96
class = "config-drift"
severity = "medium"
observed = "RandomizedGenState generates VotePeriod and SlashWindow independently, although Params.Validate requires SlashWindow divisible by VotePeriod. Its Params literal also omits LookbackDuration, leaving zero rather than the default positive TWAP history window."
