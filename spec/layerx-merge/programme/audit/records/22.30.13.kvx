[finding.001]
file = "modules/oracle/types/ballot.go"
line = 104
class = "runtime-risk"
severity = "high"
observed = "WeightedMedian and WeightedMedianWithAssertion compare cumulative power to totalPower/2 using integer division. Sorted rates [1,100] with powers [1,2] return 1 even though power 2 supports 100. With total power 1 a leading zero-power abstention can return zero; abci.go:70 and tally.go:14 use this result for stored oracle prices."
expected = "The power-weighted median must not select a price supported only by the lower minority because total voting power is odd, and zero-power abstentions must not determine a positive-power price."
proposal = "In modules/oracle/types/ballot.go use an overflow-safe half-power comparison with explicit zero-power handling in both median methods; preserve the documented even-power tie rule and add odd totals 1 and 3 through the actual MidBlock tally path."
owner_domain = 3
interface = "3.go-oracle-types-exchangerateballot-weightedmedianwithassertion-j64"

[finding.002]
file = "modules/oracle/types/ballot.go"
line = 147
class = "runtime-risk"
severity = "medium"
observed = "StandardDeviation is described as power weighted, but sums every entry equally and divides by ballot length, including zero-power abstentions. It converts the decimal variance to float64, rounds the result to six decimals and silently returns zero on panic. Tally uses this value to widen the valid-vote band."
expected = "The valid-vote band must follow the declared voting-power semantics; a zero-power entry must not widen the band or silently replace arithmetic failure with a legitimate zero deviation."
proposal = "Define the reward-band weighting explicitly in modules/oracle/types/ballot.go and implement its square root with bounded deterministic decimal/integer arithmetic; exclude zero-power observations and surface arithmetic failure. Verify band and penalty outcomes through modules/oracle/tally.go."
owner_domain = 3
interface = "3.go-oracle-types-exchangerateballot-standarddeviation-j64"

[finding.003]
file = "modules/oracle/keeper/migrations.go"
line = 83
class = "restart-recovery"
severity = "high"
observed = "Migrate5To6 sets elapsed to height modulo SlashWindow and backfills success as elapsed minus misses and abstentions. Counters increment once per VotePeriod in abci.go:125-140, not once per block. At window progress 10000 and default VotePeriod=2 with 25 penalties, it writes 9975 successes instead of 4975."
expected = "A store upgrade must preserve the number of observed vote periods and hence the success ratio consumed by SlashAndResetCounters; changing the unit to blocks corrupts accounting and can prevent the intended jail/slash when MinValidPerWindow is enabled."
proposal = "In modules/oracle/keeper/migrations.go derive completed observations using the actual period/window boundary convention and historical period policy, rejecting unreconstructable histories. Keep the atomic cache context and add before/on/after boundary cases with VotePeriod greater than one."
owner_domain = 3

[finding.004]
file = "modules/oracle/genesis.go"
line = 79
class = "restart-recovery"
severity = "high"
observed = "ExportGenesis converts OracleExchangeRate into ExchangeRateTuple, dropping LastUpdate and LastUpdateTimestamp. InitGenesis:31 calls SetBaseExchangeRate, which stamps the import height and UnixMilli time. An old persisted rate is returned by the typed querier as though refreshed at recovery without a new vote."
expected = "The rate, source height and freshness timestamp returned by GetBaseExchangeRate and the gRPC query must survive export/import together, or the recovered rate must remain explicitly unavailable until a new valid observation arrives."
proposal = "Version the oracle genesis rate representation in api/oracle/genesis.proto and modules/oracle/genesis.go to preserve full OracleExchangeRate metadata, with a deliberate legacy import policy. Test export/import into a different height/time and assert stale data does not become fresh."
owner_domain = 3
interface = "3.key-oracle-exchange-rate-key-j25"

[finding.005]
file = "modules/oracle/genesis.go"
line = 14
class = "restart-recovery"
severity = "medium"
observed = "Genesis export does not include VoteTargetKey records and InitGenesis does not reconstruct them from Params.Whitelist. The existing genesis test seeds two targets but never compares recovered targets. The first MidBlock sees zero targets, discards those ballots and can count WinCount=0 as success before ApplyWhitelist runs."
expected = "The set of active oracle targets must be ready before recovered votes are evaluated; recovery must not erase the target state for the first period or report success solely because the target set was lost."
proposal = "In modules/oracle/genesis.go restore exported vote targets or initialize the validated whitelist before processing imported votes. Extend the real-store round trip to compare targets and first-period price/counter results."
owner_domain = 3
interface = "3.key-oracle-vote-target-key-j25"

[finding.006]
file = "apps/perps/tests/proof_hooks.test.ts"
line = 62
class = "interface-mismatch"
severity = "high"
observed = "HooksApplication emits maxLeverage=20*WAD and tier leverage=10*WAD/20*WAD, but precompiles/perps/views.go:337,615 emits plain integers and Perps.sol:10 explicitly declares that unit. decodeMarketConfig passes the integer unchanged; PerpsOrderForm.tsx:280-291 and :783-787 pass it to checkOrderLimits, which rejects maxLeverage below ONE_X in orderPlan.ts:83. The fixture makes this live trading refusal invisible."
expected = "The real Go precompile, ABI transport, market-config hook and form/planner must agree that returned leverage caps are integer multipliers while order leverage is 18-decimal. An aligned enabled-market order at supported leverage must reach placeOrder."
proposal = "In apps/perps/src/widgets/trading/PerpsOrderForm.tsx convert the selected integer cap exactly once to the OrderLimits unit in both construction paths, or give OrderLimits an explicit integer unit and convert its comparison. Replace the inflated test producer with real node output and assert the complete form-to-plan path accepts and refuses boundary leverage."
owner_domain = 3
interface = "3.pc-0x1015-getmarketconfig"

[finding.007]
file = "apps/perps/tests/proof_core.test.ts"
line = 188
class = "test-gap"
severity = "medium"
observed = "quoteAndPlanReachConfirmationAndSnapshotConsumers constructs a MarginTier with maxLeverage=20*WAD, while the getMarginTiers producer returns 20 as a plain integer. The supplied planner limit is already WAD-scaled, so this proof never exercises the production config-to-limit conversion."
expected = "Proof coverage of market configuration must carry the real tier representation into the order-form limit producer and then the planner; preconverted internal limits alone cannot establish the chain-facing unit boundary."
proposal = "In apps/perps/tests/proof_core.test.ts use the actual decoded tier representation and call orderLimitsFromConfig before buildOrderPlan, retaining all confirmation/snapshot assertions and adding the real enabled-market leverage boundary."
owner_domain = 3

[finding.008]
file = "apps/perps/tests/local-order-tick.test.ts"
line = 110
class = "test-gap"
severity = "medium"
observed = "The local tick test reads real config but multiplies config.maxLeverage by 10^18 itself and passes the result straight to buildOrderPlan. The production form passes its plain integer selected cap without this conversion, so this otherwise real-node test cannot detect that all ordinary plans are refused."
expected = "The local-node proof must use the same market-config-to-OrderLimits function as the production order form and exercise the real margin tier as well as the tick boundary."
