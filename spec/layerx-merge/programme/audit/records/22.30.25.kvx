[finding.native-value-loss]
file = "precompiles/launchpad/surface.go"
line = 14
class = "security"
severity = "high"
observed = "SurfaceRuntime appends CALLER and CALLs 0x1017 with zero value. Its canonical bytes in modules/launchpad/keeper/market.go contain no CALLVALUE check. Native currency attached to a successful surface call remains at the surface; the precompile sees zero and the surface exposes no native withdrawal."
expected = "Nonpayable role methods must refuse attached native currency through deployed surfaces as well as directly at 0x1017, preserving user funds."
proposal = "Reject nonzero CALLVALUE in modules/launchpad/keeper/market.go before forwarding; update installation and migration identities. Prove actual value-bearing evm.Call refusal at role and pool surfaces with unchanged sender/target native balances."
owner_domain = 4
interface = "4.go-lppc-surface-runtime"

[finding.surface-value-test]
file = "precompiles/launchpad/surface_test.go"
line = 459
class = "test-gap"
severity = "medium"
observed = "TestSurfaceCallKindRefusals claims value attached to any call reverts but invokes s.contract.Run directly for all value-bearing cases. It bypasses surface bytecode, which forwards zero value, and misses native currency stranded at that address."
expected = "Nonpayable assertions must exercise the installed runtime and actual EVM native transfers along the producer-to-consumer path."
proposal = "Extend precompiles/launchpad/surface_test.go with funded accounts calling real role and pool surfaces via evm.Call with nonzero value. Assert refusal and unchanged native balances, keeper state and logs."
owner_domain = 4
interface = "4.go-lppc-surface-runtime"

[finding.multicall-metering]
file = "precompiles/launchpad/router.go"
line = 201
class = "runtime-risk"
severity = "high"
observed = "multicall invokes routerHandler directly for each entry. run.go deducts only the outer Gas(sent, Writes(multicall)), while gas.go counts multicall as one write. Inner base/write costs are omitted. Recursive multicall has no depth bound and repeatedly decodes and repacks nested payloads outside EVM call-depth accounting, allowing disproportionate validator work within a transaction allowance."
expected = "Every batched Router operation must pay for its execution/storage work from the same remaining gas budget, and nesting must respect bounded execution resources."
proposal = "Meter inner dispatches from the shared budget in precompiles/launchpad/router.go and run.go and bound nested batching consistently with EVM limits. Add real EVM cumulative-gas and depth refusal cases proving full state/log rollback."
owner_domain = 4
interface = "4.pc-router-multicall"

[finding.outer-abort-conversion]
file = "precompiles/launchpad/run.go"
line = 131
class = "runtime-risk"
severity = "medium"
observed = "RunCaller.callNested preserves vm.AbortError, but run converts every non-out-of-gas error to vm.ErrExecutionReverted. A nested execution abort therefore becomes a catchable contract failure at the outer boundary."
expected = "The vm.AbortError contract in core/deps/geth/core/vm/errors.go requires immediate propagation through the call stack, distinct from ABI contract refusals."
proposal = "Preserve the underlying typed abort before revert encoding in precompiles/launchpad/run.go and through batch wrappers. Exercise actual nested EVM callbacks and prove outer contracts cannot catch and continue after an abort."
owner_domain = 4
interface = "4.go-lppc-precompile-run"

[finding.router-abort-loss]
file = "precompiles/launchpad/router.go"
line = 457
class = "runtime-risk"
severity = "medium"
observed = "applyPermit ignores every nested.Call error and has no error return, including execution aborts RunCaller preserves. pullInput also formats sell-transfer errors with %v at line 416, discarding their identity, and multicall encodes failures as ordinary contract reverts."
expected = "Optional token permit refusal may use an existing allowance, but execution aborts must interrupt execution and remain distinct from TransferFromFailed or MulticallFailed."
proposal = "Return and propagate typed aborts from applyPermit at every caller in precompiles/launchpad/router.go. Preserve aborts before sell-transfer and multicall error encoding; cover permit, sell transfer and batching through nested EVM paths."
owner_domain = 4
interface = "4.go-lppc-run-caller-call"

[finding.airdrop-probe-abort]
file = "precompiles/launchpad/fees.go"
line = 686
class = "runtime-risk"
severity = "medium"
observed = "feeSupportsAirdrop returns false without error whenever tokenAddress, getPastTotalSupply or getPastBalance fails, including a typed abort preserved by RunCaller.StaticCall. Unlike requireAirdropSupported in nft.go, these optional probes do not check nestedAborted."
expected = "Unsupported snapshot methods can answer false, but an execution abort must stay an abort rather than becoming a successful false result or UnsupportedSnapshotToken."
proposal = "Propagate nestedAborted before ordinary probe failures in precompiles/launchpad/fees.go using the NFT probe rule. Exercise aborts at all three real EVM probe positions and check no execution continues."
owner_domain = 4
interface = "4.pc-fee-accumulator-supports-airdrop"

[finding.registry-unbounded-reads]
file = "precompiles/launchpad/views.go"
line = 489
class = "runtime-risk"
severity = "medium"
observed = "getAllPools and getPoolsByCreatorPage decode and allocate all markets through registryPools before slicing. getPoolCount builds the full list too; poolByToken scans despite an available keeper PoolByToken index. Fixed view gas does not grow with accumulated markets, including for empty or one-item pages."
expected = "Pagination, counts and point lookup should have work bounded by a requested window or persisted index so ordinary growth does not make small reads consume unbounded validator CPU and memory."
proposal = "Persist pool-order and creator-order indexes/counts in modules/launchpad/keeper with migration/restart coverage. Read bounded windows and the token index from precompiles/launchpad/views.go and meter remaining iteration work."
owner_domain = 4
interface = "4.pc-pool-registry-get-all-pools"

[finding.golden-event-payload-gap]
file = "precompiles/launchpad/surface_parity_test.go"
line = 754
class = "test-gap"
severity = "medium"
observed = "goldenTranslation.events serializes only emitters and topics, drops goldenLog.Data and sorts the results. replayTrace compares these strings while claiming matching logs, allowing wrong nonindexed swap amounts, fees, timestamps or dependent event order to pass replay."
expected = "Producer-to-consumer replay must compare complete event shapes and encodings, including nonindexed data and meaningful order, with only explicit upgrade translations."
proposal = "Compare full decoded event payloads and ordered logs in precompiles/launchpad/surface_parity_test.go after ABI-aware address/time translations. Demonstrate rejection of changed nonindexed amounts and reordered dependent events."
owner_domain = 4
interface = "4.pc-event-buy"

[finding.unused-optical-helpers]
file = "precompiles/launchpad/hooks.go"
line = 32
class = "dead-code"
severity = "low"
observed = "callOptical, callFeeOptical and invokeOptical are called only by optical_test.go. Live swap/fee operations use separate implementations in modules/launchpad/keeper/swap.go and fees.go, so helper assertions can diverge from user behavior."
expected = "Optical behavior should have one production owner, and conformance assertions should exercise the implementation reached by real launchpad operations."
proposal = "Move isolated fixtures into test-only code or remove duplicated helpers from precompiles/launchpad/hooks.go. Consolidate validation under modules/launchpad/keeper and retain real operation callback assertions."
owner_domain = 4

[finding.unused-event-dispatcher]
file = "precompiles/launchpad/events.go"
line = 16
class = "dead-code"
severity = "low"
observed = "PrecompileExecutor.emitAt has callers only in events_test.go. Live handlers use emitABIEvent, feeLog, NFT emitters and keeper paths, so its role/emitter policy is not the policy used in real operations."
expected = "Emitter policies should be enforced in live event paths and verified there, without an unused parallel dispatcher implying production coverage."
proposal = "Consolidate emitter selection in the actual handlers and precompiles/launchpad/events.go or move the unused dispatcher into test code; retain independent vectors and real-handler emitter assertions."
owner_domain = 4

[finding.stale-precompile-contract]
file = "spec/layerx-merge/contracts/launchpad.md"
line = 1453
class = "doc-drift"
severity = "medium"
observed = "Lines 1453-1454 say Launchpad.sol declares no errors and abi.json has zero. Lines 1499 and 1503-1504 describe runtime PoolKeeper assertion, stale v6.5 version metadata and a separately hardcoded surface runtime. Current code has 64 errors, compile-time conformance, v6.10/v6.12.0 and keeper-owned runtime bytes copied for export."
expected = "Integrator-facing documentation and registry facts must describe current error decoding, activation and runtime ownership after requirements 4001, 4014, 4015 and 4045."
proposal = "Update the domain-4 contract/registry source and regenerate spec/layerx-merge/contracts/launchpad.md with the current errors, compile-time check, versions and canonical runtime; explicitly date any historical statements."
owner_domain = 4
interface = "4.fmt-lppc-direct-abi-json-j28"

[doc.1]
path = "spec/layerx-merge/contracts/launchpad.md"
status = "stale"
notes = "Read the precompile sections, consumed module interfaces and retained Solidity interface descriptions. The frozen precompile-go table at lines 1453-1454 and 1499-1504 disagrees with current errors, conformance, versions and runtime ownership; see stale-precompile-contract."
