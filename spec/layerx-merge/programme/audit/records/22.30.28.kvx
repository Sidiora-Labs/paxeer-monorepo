[finding.notification-wallet-boundary]
file = "services/launchpad/notifications/http.go"
line = 137
class = "interface-mismatch"
severity = "high"
observed = "Both frozen handlers require X-Actor-Wallet. The API authenticate callback at services/launchpad/api/internal/app/app.go:617-622 returns only AccountID; SdkClient sends the session and rejects custom X-Actor-Wallet headers. Ordinary authenticated IF_NOTIFICATIONS and IF_NOTIFICATION_READ calls therefore return 400. A caller-supplied valid wallet is also copied into list items without comparison to the authenticated principal."
expected = "Requirements 4274.1 and 21067.1 require actual authenticated producer-to-transport-to-consumer list/read success with frozen envelopes and a wallet derived from the authenticated account."
proposal = "Give services/launchpad/notifications/http.go an authenticated principal or wallet resolver and wire IdentityPrincipal.Wallet from services/launchpad/api/internal/app/app.go. Remove the client-header requirement, reject spoofed identity and prove the real SDK session list/read path with durable recovery."
