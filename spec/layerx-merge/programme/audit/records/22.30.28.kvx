[finding.dialog-close]
file = "apps/launchpad/web/src/components/shared/dialog.tsx"
line = 12
class = "dead-code"
severity = "low"
observed = "Dialog discards onOpenChange and its backdrop dispatches dialog-close globally, with no importer or listener connecting the unused component to controlled state."
expected = "A controlled dialog must deliver backdrop and Escape close requests to its owner and provide the maintained focus and accessibility lifecycle."
proposal = "Remove apps/launchpad/web/src/components/shared/dialog.tsx after confirming its unused exports, or replace it with the maintained modal primitive and callback-based close lifecycle."
owner_domain = 4

[finding.browser-source-inventory]
file = "apps/launchpad/web/src/page-modules/live/production-measurement.mjs"
line = 25
class = "config-drift"
severity = "medium"
observed = "The L40 manifest validator requires four client/apps/web/src paths including this script. That tree is absent after the move to apps/launchpad/web, so a current checkout cannot satisfy its source reads."
expected = "Browser evidence must bind the actual reviewed candidate files while preserving exact digests, workload admission, sample bounds and accessibility checks."
proposal = "Update apps/launchpad/web/src/page-modules/live/production-measurement.mjs and the L40 manifest producer to inventory apps/launchpad/web paths together; retain every digest and evidence check."
owner_domain = 4
interface = "4.env-web-l40-browser-manifest-j30"

