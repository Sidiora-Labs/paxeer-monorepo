[finding.create_source_nonce]
file = "services/agent/crates/layerx-agentd/src/budget/create.rs"
line = 274
class = "interface-mismatch"
severity = "high"
observed = "BudgetRequest::create_protocol_budget rejects encoding-version-2 source_sequence == 0 before submission, although src/modules/budget/lx_budget_codec.c:158-159 accepts zero and only reserves UINT64_MAX; lx_budget_module.c:220 compares it with the source account's next_sequence."
expected = "budgetCreateNative on 0x101B must accept the real source-account nonce, including zero on first use, while retaining exact source ownership and overflow checks."
proposal = "In services/agent/crates/layerx-agentd/src/budget/create.rs validate the native source against its authenticated account nonce and the producer's reserved maximum; prove a first-use zero-nonce source through preparation, submission and confirmation."
owner_domain = 9
interface = "9.rs-agentd-budget-create-create-protocol-budget-j43"

[finding.fund_source_nonce]
file = "services/agent/crates/layerx-agentd/src/budget/mutate.rs"
line = 119
class = "interface-mismatch"
severity = "high"
observed = "budget_mutation_identity names budgetFundNative's third word source_height and rejects zero or a value above observed_head_sequence. modules/layerxpay/keeper/budget_create.go:54 and lx_budget_module.c:229 define it as sourceSequence, an account nonce independent of height."
expected = "A source account can have nonce zero or many operations per block; budgetFundNative must bind its next sequence rather than compare it with block height."
proposal = "In services/agent/crates/layerx-agentd/src/budget/mutate.rs carry a source nonce with its actual units and validate it against the source account at the preparation checkpoint; exercise zero and a nonce greater than block height through the real precompile."
owner_domain = 9
interface = "9.rs-agentd-budget-mutate-budget-mutation-identity-j43"

[finding.revoke_counter]
file = "services/agent/crates/layerx-agentd/src/budget/mutate.rs"
line = 297
class = "interface-mismatch"
severity = "high"
observed = "confirm_budget_mutation additionally requires revocation_height <= executed block height. The budgetRevoke word is a monotonic revocationSequence: src/modules/budget/lx_budget_close.c:115-122 only requires it to exceed the old record's counter."
expected = "A successful budgetRevoke with a valid counter greater than the block height must confirm; its counter and the receipt's block coordinate are different facts."
proposal = "In services/agent/crates/layerx-agentd/src/budget/mutate.rs preserve monotonic counter validation against the prior budget record and match the event and resulting state without applying a block-height ceiling; prove confirmation with a counter above height."
owner_domain = 9
interface = "9.rs-agentd-budget-mutate-confirm-budget-mutation-j43"

[finding.proof_revocation_counter]
file = "services/agent/crates/layerx-agentd/src/budget/budget_proof.rs"
line = 384
class = "interface-mismatch"
severity = "high"
observed = "verify_native_budget_proof refuses state.revocation_sequence above checkpoint.height even when getBudget re-executes to those exact bytes. The producer's revocationSequence is a monotonic caller-selected counter, not a block coordinate."
expected = "Committed budget proof v2 must preserve a valid budget revocation counter independently of the block height, matching layerxpay's creation and revocation semantics."
proposal = "In services/agent/crates/layerx-agentd/src/budget/budget_proof.rs and the authority budget export owner, remove the counter/height conflation while retaining proof binding and monotonic mutation checks; export and verify a real budget whose counter exceeds its height."
owner_domain = 9
interface = "9.fmt-budget-proof"

[finding.proof_owner_join]
file = "services/agent/crates/layerx-agentd/src/budget/budget_proof.rs"
line = 330
class = "security"
severity = "medium"
observed = "verify_native_budget_proof replays getBudget and budgetRemaining, but trusts proofs.account_join from the unsigned export. identity_key and evidence_digest are public hashes; replacing the join's DID and recomputing them can claim another DID owns the same real budget without changing either on-chain call."
expected = "An ownership proof must authenticate the DID-to-owner account binding as well as the budget amounts; a self-consistent JSON hash is not authority for that binding."
proposal = "In services/agent/crates/layerx-agentd/src/budget/budget_proof.rs verify the requested DID's binding through the authenticated node at the proof checkpoint, or verify a state witness for the join; add a changed-join test that recomputes all public digests and still refuses."
owner_domain = 9

[finding.daemon_atomic_creation]
file = "services/agent/crates/layerx-agentd/src/budget/daemon.rs"
line = 272
class = "restart-recovery"
severity = "medium"
observed = "create_daemon_limit writes the tenant's limit-id index with Store::put_local and only then writes its limit record. Process death between writes leaves an index whose budget has no record; a retry reaches the existing-index Corrupt refusal and cannot complete installation."
expected = "The index and daemon limit are one durable object: recovery must observe both or neither and permit an idempotent retry after interruption."
proposal = "In services/agent/crates/layerx-agentd/src/budget/daemon.rs publish the new index and record through the existing atomic store batch operation before installing the limit; interrupt and reopen the real store at creation and prove successful replay."
owner_domain = 9

[finding.history_policy_shape]
file = "services/agent/crates/layerx-agentd/src/read/history.rs"
line = 434
class = "interface-mismatch"
severity = "high"
observed = "HistoryPage::read_newest passes endpoint.history rows to decode_page_ordered, which requires exactly six fields height/kind/canonical/proof/txIndex/logIndex and descending positions. The live px_getHistory producer serves ascending blockHeight-positioned event rows with additional business fields; PolicyHistorySource::page calls this reader."
expected = "The policy history consumer must accept the actual hosted history rows, cursor ordering and same-position groups, then acquire authentic receipt evidence for policy decisions."
proposal = "In services/agent/crates/layerx-agentd/src/read/history.rs and protocol_evidence.rs consume the served block-position page schema and implement bounded reverse-window acquisition with the producer's supported ordering; prove policy admission using real indexer/gateway rows."
owner_domain = 9
interface = "9.rs-agentd-read-history-historypage-j43"

[finding.history_range]
file = "services/agent/crates/layerx-agentd/src/read/history.rs"
line = 176
class = "runtime-risk"
severity = "medium"
observed = "read_account sends only account/cursor/limit to px_getHistory and refuses every returned row outside from_height..=to_height. A request for a later range with no cursor therefore fails on the account's earlier history instead of returning the requested window; human_runtime::read_history exposes these selectors."
expected = "Finite block-range history must page to the requested range, return rows in that range once, and terminate cleanly when older or newer account history exists."
proposal = "In services/agent/crates/layerx-agentd/src/read/history.rs implement a bounded range adapter over the account-history cursor, preserving position groups and byte limits; exercise a later requested range on an account with older and newer rows."
owner_domain = 9

[finding.history_retired_seam]
file = "services/agent/crates/layerx-agentd/src/read/history.rs"
line = 227
class = "dead-code"
severity = "low"
observed = "The exported history function and both HistorySource implementations always return SequencerError::Unavailable; the file retains old exact-field decoding and frame-transport compatibility alongside the functioning account-bound reader."
expected = "The public history surface should have a clear account-scoped contract and should not present the retired range transport as a functioning reader."
proposal = "In services/agent/crates/layerx-agentd/src/read/history.rs migrate callers to the account-scoped reader and retire the unused transport/range seam, preserving typed refusals for explicitly unsupported legacy requests."
owner_domain = 9

[finding.native_checkpoint]
file = "services/agent/crates/layerx-agentd/src/read/native.rs"
line = 145
class = "interface-mismatch"
severity = "high"
observed = "NativeReadRoute::checkpoint reads only evidence::checkpoint and returns rung:null, verified:false, with no commit or validator verification, while the declared checkpoint read must establish a committed block."
expected = "Requirement 9022.1 and the checkpoint route contract require a matching header and commit with more than two thirds of trusted voting power and achieved rung Committed."
proposal = "In services/agent/crates/layerx-agentd/src/read/native.rs acquire and verify the block commit through read/checkpoint.rs under protected validator trust and render the resulting committed coordinates; prove the served route accepts a real quorum and rejects insufficient power."
owner_domain = 9
interface = "9.http-agentd-serve-get-v1-reads-checkpoint"

[finding.native_proof]
file = "services/agent/crates/layerx-agentd/src/read/native.rs"
line = 129
class = "interface-mismatch"
severity = "high"
observed = "NativeReadRoute::proof takes the receipt JSON and adds kind:receipt and proof_type:sequencer_signature. It supplies no block inclusion path or proof-bundle v2 material, so a receipt signature is served where the inclusion-proof operation is declared."
expected = "Requirement 9023.1 requires a receipt proof bundle containing the receipt and an inclusion path that recomputes the block's receipt/results commitment, with the achieved rung stated accurately."
proposal = "In services/agent/crates/layerx-agentd/src/read/native.rs wire proof retrieval to the actual authenticated block-proof producer and its matching verifier, return the complete declared proof bundle, and prove it through the public HTTP route."
owner_domain = 9
interface = "9.http-agentd-serve-get-v1-reads-proof"

[finding.native_history_group]
file = "services/agent/crates/layerx-agentd/src/read/native.rs"
line = 183
class = "interface-mismatch"
severity = "high"
observed = "NativeReadRoute::history rejects page.items.len() greater than limit. The hosted history producer deliberately returns all rows at the last in-limit position, so one transaction with several rows can produce a valid page larger than the requested limit and receive ResultTooLarge here."
expected = "Requirement 181431.1 and gateway history pagination keep the final position group intact so an exclusive cursor neither loses nor repeats same-position rows."
proposal = "In services/agent/crates/layerx-agentd/src/read/native.rs validate overflow by position group as the account reader does, retaining the response byte bound and rejecting later-position overflow; serve a real shared-position page across two requests."
owner_domain = 9
interface = "9.http-agentd-serve-get-v1-reads-history"

[finding.proof_acquisition]
file = "services/agent/crates/layerx-agentd/src/read/proof_bundle.rs"
