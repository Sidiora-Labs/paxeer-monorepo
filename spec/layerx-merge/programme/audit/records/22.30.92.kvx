proposal = "In services/agent/crates/layerx-agentd/src/read/proof_bundle.rs bind retained EIP-1559 bytes to authenticated chain receipts and obtain the actual inclusion/storage material, then construct the API proof bundle; prove both successful receipt and committed account acquisition."
owner_domain = 9

[finding.proof_root_algorithm]
file = "services/agent/crates/layerx-agentd/src/read/proof_bundle.rs"
line = 201
class = "interface-mismatch"
severity = "high"
observed = "verify_bundle requires header H.last_results_hash == receipts_root and verifies a keccak/RLP Ethereum receipt trie. rpc/block.go:292-349 serves receiptsRoot as the Comet Merkle root over marshalled ABCI results of block H, committed by header H+1; it is neither H's previous-results field nor an Ethereum receipt trie."
expected = "The proof producer and consumer must agree on the exact committed bytes, hash/tree algorithm and commitment height; a real node receipt inclusion proof must verify without inventing another root."
proposal = "In services/agent/crates/layerx-agentd/src/read/proof_bundle.rs use the node's actual ABCI-result Merkle proof and authenticate its commitment at the proper signed header, or coordinate an explicitly versioned producer change; prove the path with node-emitted proof bytes."
owner_domain = 9
interface = "9.rs-agentd-read-checkpoint-proof-bundle-j43"

