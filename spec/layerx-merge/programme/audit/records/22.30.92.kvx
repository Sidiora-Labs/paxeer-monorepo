class = "wiring-gap"
severity = "high"
observed = "acquire decodes retained signed bytes with the retired layerx_wire::activity decoder, then every remaining branch ends in read.proof_bundle_v2_material_missing at lines 105-109; AccountState is also unconditionally refused at lines 45-53. No valid native proof request can return a bundle."
