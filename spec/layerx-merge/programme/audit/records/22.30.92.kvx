[finding.committed_remaining]
file = "services/agent/crates/layerx-agentd/src/read/committed.rs"
line = 512
class = "interface-mismatch"
severity = "high"
observed = "inventory_records requires budgetRemaining(bytes32) to equal ProtocolBudgetRecord::remaining(), which computes allowance only. modules/layerxpay/keeper/budget_views.go:30-52 returns min(allowance, funded balance); a valid budget with allowance 100 and balance 20 is refused as Selector."
