[finding.send-recipient-roundtrip]
file = "apps/wallet/src/domains/shell/index.ts"
line = 221
class = "interface-mismatch"
severity = "high"
observed = "ShellRoute.send admits to and parseRouteUrl retains it, but serializeRoute serializes only token. useAppRoute.commit immediately serializes and reparses every route, including a recipient-bearing deep link, so the recipient disappears before the send screen is restored."
expected = "The declared route serializer and parser must round-trip every accepted field of ShellRoute; a send destination must survive navigation and reload."
proposal = "In apps/wallet/src/domains/shell/index.ts serialize the validated to field for send routes, and prove the parse, commit, history and reload path preserves the intended recipient."
owner_domain = 12
interface = "12.ts-app-serialize-route"

[finding.recipient-roundtrip-coverage]
file = "apps/wallet/src/domains/shell/navigation.test.ts"
line = 14
class = "test-gap"
severity = "medium"
observed = "The ROUTES matrix covers send with no token and send with a token, but never send.to. The test named round-trips every user-addressable route therefore misses the recipient loss in serializeRoute."
expected = "Navigation qualification must cover optional recipient fields that the route parser accepts, including recipient-only and token-plus-recipient links."
proposal = "Extend apps/wallet/src/domains/shell/navigation.test.ts with recipient-bearing routes and exercise the real history commit and reload consumer after repairing the serializer."
owner_domain = 12
interface = "12.ts-app-shell-route"

[finding.native-route-origin]
file = "apps/wallet/src/domains/platform/index.ts"
line = 81
class = "security"
severity = "medium"
observed = "parseNativeRouteEvent calls a string same-origin whenever it starts with /. It accepts //evil.example/send and /\\\\evil.example/send, which URL resolution can interpret as an external authority. No production caller of this exported parser was found in the wallet app."
expected = "A boundary advertised as accepting only same-origin native routes must reject authority-relative and backslash-normalized external URLs before returning an accepted event."
proposal = "Resolve native route candidates against a fixed wallet origin in apps/wallet/src/domains/platform/index.ts, require the same origin and allowed route grammar, and reject ambiguous slashes before exposing this parser to native adapters."
owner_domain = 12
interface = "12.ts-app-parse-native-route-event"

[finding.native-origin-coverage]
file = "apps/wallet/src/domains/contracts.test.ts"
