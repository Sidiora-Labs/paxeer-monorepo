owner_domain = 14

[finding.http-errors-as-payloads]
file = "apps/explorer/nextjs/utils/fetchApi.ts"
line = 37
class = "runtime-risk"
severity = "medium"
observed = "fetchApi logs non-200 status but still parses its JSON as ResourcePayload<R>. Its token-instance media handler and token, address and stats metadata callers receive an API error object through the success payload type; the JSON error is never converted to the advertised undefined failure result."
expected = "SSR and metadata consumers need a clear distinction between a successful resource payload and a backend refusal, including valid JSON bodies on 4xx and 5xx responses."
proposal = "In apps/explorer/nextjs/utils/fetchApi.ts classify unsuccessful HTTP responses before returning a resource payload, using a typed failure or the existing undefined result; preserve error logging and cover a real backend refusal through a metadata caller."
owner_domain = 14

[finding.compiler-url-leak]
file = "services/explorer/backend/apps/explorer/test/explorer/smart_contract/compiler_version_test.exs"
line = 27
class = "test-gap"
severity = "medium"
observed = "CompilerVersionTest replaces :explorer, :solc_bin_api_url with a Bypass localhost URL. Its on_exit callbacks restore the Tesla adapter and RustVerifierInterfaceBehaviour but never restore the compiler URL, so later tests can inherit a closed server endpoint."
expected = "Registry 14.cfg-explorer-solc-bin-api-url is shared application configuration; each test must restore its prior presence and value so compiler-version discovery does not depend on suite order."
proposal = "Save the existing compiler URL state and restore it with on_exit in services/explorer/backend/apps/explorer/test/explorer/smart_contract/compiler_version_test.exs, deleting the key if originally absent; verify an ordinary compiler lookup after the fixture closes."
owner_domain = 14
interface = "14.cfg-explorer-solc-bin-api-url"

