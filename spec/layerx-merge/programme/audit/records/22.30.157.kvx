[finding.backfill-partial-block-results]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/backfill.ex"
line = 189
class = "restart-recovery"
severity = "medium"
observed = "fetch_blocks accepts {:ok, %Blocks{blocks_params: blocks}} without examining Blocks.errors. EthereumJSONRPC.Blocks.from_responses partitions successful responses and per-block errors into that struct, so a partially failed chunk is treated as complete and discover_blocks can advance its range cursor."
expected = "An Arbitrum backfill range must be acknowledged only after every requested canonical block and receipt has been obtained and its required updates committed; partial batch errors need retryable recovery."
proposal = "In services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/backfill.ex reject nonempty Blocks.errors and verify requested block coverage before update_db. Exercise a mixed success/error response and restart from the unacknowledged range."
owner_domain = 14

[finding.backfill-transaction-only-holes]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/backfill.ex"
line = 132
class = "restart-recovery"
severity = "medium"
observed = "do_discover_blocks selects only blocks_with_missing_fields. The underlying reader/indexer/general.ex:61-70 tests send_count, send_root and l1_block_number on blocks, with no predicate for transaction gas_used_for_l1. A database with those block fields filled but transaction-specific data absent is never selected for repair."
expected = "The backfill module promises recovery of both Arbitrum block fields and transaction gas_used_for_l1; a transaction-only hole must remain discoverable independently of the block metadata."
proposal = "Extend the owning explorer reader selection used by services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/backfill.ex to include transactions missing data where that field is supported, distinguishing legacy unsupported receipts. Cover a restart with complete block fields and a recoverable transaction-only hole."
owner_domain = 14

[finding.batch-reorg-replacement]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/batches/discovery.ex"
line = 427
class = "restart-recovery"
severity = "medium"
observed = "handle_new_batch_data treats an existing batch number as only a lifecycle timestamp/block update and records the newly observed transaction hash. update_lifecycle_transactions_for_new_blocks at lines 630-645 then loads lifecycle rows by that hash. If a parent-chain reorg republishes the batch in a different transaction, no row is found and the persisted batch remains associated with its orphan commitment."
expected = "Optional Arbitrum batch recovery must reconcile canonical batch number, commitment transaction, block range and DA links after a parent-chain replacement, rather than updating only a transaction whose hash already exists."
proposal = "In services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/batches/discovery.ex reconcile the existing batch against the canonical event, importing and rebinding a replacement commitment atomically with affected block and DA associations. Cover same-hash relocation, replacement-hash republication and orphan removal across restart."
owner_domain = 14
interface = "14.cfg-indexer-indexer-fetcher-arbitrum-trackingbatchesstatuses"

[finding.da-parse-failure-lost]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/batches/discovery.ex"
line = 570
class = "restart-recovery"
severity = "medium"
observed = "execute_transaction_requests_parse_transactions_calldata maps every DataAvailabilityInfo error to {nil, nil}, imports the batch with no DA type and retains no failure state. Existing batch numbers follow only the lifecycle update path at line 427, so rediscovery does not retry parsing that stored batch."
expected = "A batch with unavailable or unsupported DA metadata must expose an explicit recoverable state and be reparsed after provider recovery or decoder support, without requiring an operator to delete indexed batches."
proposal = "Persist the DA parsing outcome and retry eligibility in the owning Arbitrum batch import flow; distinguish known no-DA from failure and schedule reconciliation of unresolved batches in services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/batches/discovery.ex. Cover restart after a parse failure."
owner_domain = 14
interface = "14.cfg-indexer-indexer-fetcher-arbitrum-trackingbatchesstatuses"

[finding.anytrust-keyset-decode]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/da/anytrust.ex"
line = 396
class = "runtime-risk"
severity = "medium"
observed = "get_keyset_raw_data returns nil when the RPC returns no SetValidKeyset logs, but get_keyset_info_from_l1 passes it to a binary-only decode_keyset. Short key lengths raise in decode_pubkeys; its {:error, reason} tuple also matches {pubkeys, _} at line 402 and can produce pubkeys: :error instead of a signer list."
expected = "Missing or malformed remote AnyTrust keysets must yield a typed failure that the batch worker can retry; a certificate record must contain a bounded, valid threshold and signer list before persistence."
proposal = "In services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/da/anytrust.ex validate binary lengths, key count and threshold before decoding, pattern-match successful signer lists explicitly, and propagate missing-log/decoding failures without caching a successful keyset. Cover partial RPC data followed by recovery."
owner_domain = 14

[finding.negative-safe-height]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/utils/rpc.ex"
line = 319
class = "runtime-risk"
severity = "medium"
observed = "get_safe_and_latest_l1_blocks falls back to latest_chain_block + 1 - min(finalization_threshold, hard_limit). On a young parent chain without safe-tag support this can be negative, but Explorer.Chain.Arbitrum.Reader.Indexer.Messages.highest_safe_fully_indexed_message_to_l2 requires safe_block >= 0."
expected = "Safe-height calculations must produce a valid nonnegative parent-chain height for downstream queries on a newly initialized or nonstandard Arbitrum deployment."
proposal = "Clamp the fallback to genesis in services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/utils/rpc.ex and propagate explicit no-safe-history semantics where necessary. Cover latest heights below the configured threshold through the real messages lookup."
owner_domain = 14
interface = "14.cfg-indexer-indexer-fetcher-arbitrum"

[finding.execution-reorg-recovery]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/new_l1_executions.ex"
line = 118
class = "restart-recovery"
severity = "medium"
observed = "discover_new_l1_messages_executions reads latest for low latency, imports execution events and advances start_block to end_block + 1. It does not overlap an unfinalized window or remove orphan execution rows; discovery can leave messages marked relayed after that parent-chain execution is reorganized away."
expected = "Optional Arbitrum execution status must follow canonical parent-chain evidence and remain correct after reorg and restart, including reverting completion derived from an orphan event."
proposal = "In services/explorer/backend/apps/indexer/lib/indexer/fetcher/arbitrum/workers/new_l1_executions.ex track block identity and reconcile a bounded unfinalized observation window, rebinding or revoking execution and message status atomically. Cover an observed execution removed and later replaced, including restart."
owner_domain = 14
interface = "14.cfg-indexer-indexer-fetcher-arbitrum-trackingmessagesonl1"

