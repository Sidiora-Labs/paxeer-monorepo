[finding.private-profile]
file = "apps/explorer/nextjs/middlewares/appProfile.ts"
line = 14
class = "security"
severity = "medium"
observed = "appProfileMiddleware resolves only x-app-profile or app-profile and deletes APP_PROFILE when both are absent. A following cookie-only navigation loses private mode; csp/index.ts:35-39 accepts that cookie, whereas getServerSideProps/handlers.ts:28 accepts the header or cookie but not the query."
expected = "A visitor selecting the private explorer profile needs one consistent profile across middleware, CSP and SSR tracking decisions, including later navigations and conflicting input sources."
proposal = "In apps/explorer/nextjs share a request-profile resolver between middleware, CSP and SSR; preserve a valid private cookie until an explicit profile change. Cover query entry, cookie-only navigation, header overrides and tracking suppression through real requests."
owner_domain = 14

[finding.telemetry-rejection]
file = "apps/explorer/nextjs/getServerSideProps/handlers.ts"
line = 60
class = "runtime-risk"
severity = "medium"
observed = "base starts fetch to https://monitor.blockscout.com/count without awaiting it, handling rejection or providing an abort deadline. DNS, TLS or connection failure leaves an unhandled promise rejection during an otherwise valid page request."
expected = "Optional explorer pageview reporting must have a bounded lifetime and consume transport errors without compromising page delivery or process stability."
proposal = "In apps/explorer/nextjs/getServerSideProps/handlers.ts bound the reporting request with an abort timeout and explicitly handle rejected transport and non-success results; exercise an unavailable monitor while the page still renders."
owner_domain = 14

[finding.safe-origin]
file = "apps/explorer/nextjs/csp/policies/safe.ts"
line = 12
class = "interface-mismatch"
severity = "high"
observed = "safe() permits only *.safe.global in connect-src. configs/app/features/safe.ts accepts NEXT_PUBLIC_SAFE_TX_SERVICE_URL on any valid origin and emits apiUrl; lib/hooks/useIsSafeAddress.tsx:18 fetches that apiUrl directly. A valid custom Safe service on another origin is blocked by the browser CSP."
expected = "Registry 14.cfg-fe-feature-safe declares the enabled feature with apiUrl. Its configuration producer, emitted browser CSP and address-tag consumer must support the same configured service origin."
proposal = "Derive the validated connect-src origin from config.features.safe.apiUrl in apps/explorer/nextjs/csp/policies/safe.ts. Prove configuration to response CSP to the useIsSafeAddress request with a custom HTTPS Safe service, retaining restrictive CSP defaults."
owner_domain = 14
interface = "14.cfg-fe-feature-safe"

[finding.marketplace-analytics-origin]
file = "apps/explorer/nextjs/csp/policies/marketplace.ts"
line = 19
class = "config-drift"
severity = "medium"
observed = "marketplace() replaces every truthy essentialDapps.multisend.posthogHost with *.posthog.com for connect-src and script-src. The marketplace config transports posthogHost as a string and ui/marketplace/essentialDapps/multisend/Multisend.tsx:527 passes the original host to the multisend component; a custom analytics origin is not permitted."
expected = "Registry 14.cfg-fe-feature-marketplace and its EssentialDappsConfig must carry the configured analytics destination consistently into both the embedded component and its browser permissions."
proposal = "In apps/explorer/nextjs/csp/policies/marketplace.ts validate and permit the configured analytics origin, keeping only the actual default when applicable. Cover a self-hosted posthogHost through the config loader, component props and response CSP."
owner_domain = 14
interface = "14.cfg-fe-feature-marketplace"

[finding.legacy-verification-routes]
file = "apps/explorer/nextjs/redirects.js"
line = 165
class = "wiring-gap"
severity = "medium"
observed = "Six legacy verification redirects at lines 165-185 use /address/:hash/contract_verification with an underscore. The address verification page is pages/address/[hash]/contract-verification.tsx; the later Etherscan redirect uses that hyphenated route correctly."
expected = "An existing contract verification link must arrive at the live verification page with its address and selected verification method preserved."
