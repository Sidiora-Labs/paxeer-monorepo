observed = "The tokenURI case mocks selector 0xc87b56dd at a foreign contract and returns a vault.warriders.com URI. It establishes ABI decoding but does not exercise either declared producer: CW721ERC721Pointer uses WasmdPrecompile.query and JsonPrecompile extraction, while MyNFT in contracts/src/ERC721.sol returns its own string."
expected = "Registry rows 6.sol-cw721erc721pointer-tokenuri-c87b56dd and 6.sol-mynft-tokenuri-c87b56dd need their real contract to node eth_call to Explorer.Reader path proven, including pointer ownership refusal and token ID encoding."
proposal = "Add producer-backed reader coverage in the owning explorer smart-contract tests for both contracts, keeping the existing unit decoding assertions; include a uint256 token ID, string ABI output and the pointer missing-token refusal."
owner_domain = 14
interface = "6.sol-cw721erc721pointer-tokenuri-c87b56dd"

