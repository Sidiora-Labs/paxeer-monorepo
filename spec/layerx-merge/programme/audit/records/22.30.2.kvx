interface = "1.c-lxp-kernel-fee-transaction"

[finding.sandbox-live-blob-references]
file = "src/modules/programs/sandbox_expiry.c"
line = 60
class = "runtime-risk"
severity = "high"
observed = "blob_referenced_elsewhere only visits 73-byte progstor heads. Shared program storage uses a 41-byte head key in storage.c, so a live shared head cannot protect a content-addressed value or manifest also used by a destroyed sandbox. The deletions at lines 128 and 142 can remove bytes still referenced by the shared program."
expected = "Sandbox reclamation must delete only blobs with no remaining live Programs reference, including shared storage namespaces, so teardown cannot corrupt another program or its recovered state."
proposal = "In src/modules/programs/sandbox_expiry.c account for every supported live storage-head shape and other Programs blob roots, including staged updates, before deleting a digest; create real shared and sandbox storage with equal content, destroy the sandbox, then reopen and verify the shared values and manifests."
owner_domain = 1
interface = "1.c-lxp-programs-sandbox-destroy-execute"

[finding.sandbox-cleanup-delete-budget]
file = "src/modules/programs/sandbox_expiry.c"
line = 285
class = "runtime-risk"
severity = "high"
observed = "The final snapshot cleanup can delete three distinct value blobs and then two distinct namespace and snapshot manifests in one activity. lxp_ctx_blob_del at src/protocol/lxp_module_ctx.c:1561 permits only LXP_KERNEL_MAX_STAGED_BLOBS = 4 staged blobs. The fifth deletion returns LXP_ERR_ARENA_EXHAUSTED before a cleanup cursor is committed, so retrying the same state repeats the refusal and leaves settlement and refund stuck."
expected = "Every valid sandbox must eventually complete bounded reclamation and its atomic final occupancy settlement and refund, including the largest final cleanup step and restart between steps."
proposal = "In src/modules/programs/sandbox_expiry.c budget value and manifest deletions together and persist deterministic progress before the final atomic settlement; prove destruction with three unique final snapshot values and two different manifests progresses through repeated calls and a reopened store without exceeding the kernel deletion limit."
owner_domain = 1
interface = "1.c-lxp-programs-sandbox-destroy-execute"

[finding.native-block-maintenance]
