[finding.abi-registration]
file = "modules/lxphost/host.go"
line = 175
class = "interface-mismatch"
severity = "high"
observed = "Native node reset selects programs_module_registration_v4_storage_retirement, while programs/sdk/rust/src/abi_policy.rs admits ABI 5 for deployment and upgrade. src/modules/programs/call.c:2437 rejects a call whose ABI exceeds that registration, so an admitted ABI 5 program cannot be called through the native host."
expected = "Brief network fact 6 requires host and guest ABI agreement on every registration path, including the ABI 5 AI market guest; an admitted deployment must remain callable after commit and reopen."
proposal = "In modules/lxphost/host.go and src/modules/programs/registration.c select the registration matching the canonical admitted ABI policy; prove a real ABI 5 guest deployment, committed call and reopened call through the Programs precompile, including unsupported-version refusal."
owner_domain = 1
interface = "1.c-programs-module-registration"

[finding.migration-accounting-version]
file = "src/modules/programs/deploy.c"
line = 124
class = "interface-mismatch"
severity = "high"
observed = "migration_accounting_stage writes request->abi_version into LXMA1 offset 11 at line 155, but lxp_programs_migration_accounting_read rejects values above 4. The Rust migration runtime and ABI admission policy accept version 5, making an admitted ABI 5 migration accounting record unreadable with LXP_FATAL_REPLAY_DIVERGENCE."
expected = "The stable migration accounting reader must accept the canonical record emitted by every admitted migration ABI, with the same version policy before and after persistence and recovery."
proposal = "In src/modules/programs/deploy.c replace the divergent ABI bound with the shared admitted-version policy while preserving canonical validation; execute a real ABI 5 migration, persist its accounting record, reopen the store and read back all 613 bytes through the declared reader."
owner_domain = 1
interface = "1.c-lxp-programs-migration-accounting-read"

[finding.bound-migration-signature]
file = "src/modules/programs/deploy.c"
line = 644
class = "wiring-gap"
severity = "high"
observed = "The native bound-authority path accepts an unsigned EVM activity, but migration admission depends on src/protocol/lxp_kernel.c:377 unconditionally running lxp_activity_verify_signature after checking execution->signature_valid. It ignores execution->binding_authority there, so an authenticated unsigned migration upgrade is refused as a bad signature before the hook can execute."
expected = "Programs migration must honor the same verified native authority as other EVM-bound activities, while preserving envelope, payload hash, activity binding and principal authorization checks."
proposal = "In src/protocol/lxp_kernel.c migration-admission binding carry verified native authority through the unsigned path and retain Ed25519 verification for signed envelopes; prove an actual Programs precompile migration succeeds, with forged authority and altered-payload cases refused."
owner_domain = 1
interface = "1.c-lxp-programs-migration-admit"

[finding.migration-fee-binding]
file = "modules/lxphost/host.go"
line = 269
class = "wiring-gap"
severity = "high"
observed = "lxphost_bind_assets assigns kernel.module_runtime directly and never binds the Programs fee transaction. The automatic lxp_programs_bind_fee_transaction call lives in lxp_kernel_bind_module_runtime at src/protocol/lxp_kernel.c:1670, which this path bypasses. Direct charged migration reaches the NULL prepare check at kernel line 6389 and returns LXP_FATAL_INVARIANT; CALL snapshot setup has a separate binding."
