[finding.payment-reference-genesis]
file = "modules/lxphost/ctx.go"
line = 364
class = "restart-recovery"
severity = "high"
observed = "commitPaymentReference persists each successful LX_ASSET_SEND under host prefix 0x04 and checkPaymentReference makes it authoritative. However ExportStoreGenesis in modules/lxphost/genesis.go:88 exports only asset module rows, identity sequences and accounts, while StoreGenesis.Validate rejects 0x04 at line 75. Export/import therefore loses consumed payment references; a payment using a new account sequence can reuse an already consumed reference."
