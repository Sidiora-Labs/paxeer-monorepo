[finding.receipt-abi]
file = "programs/crates/layerx-programs-runtime/src/execute.rs"
line = 2849
class = "interface-mismatch"
severity = "high"
observed = "V2AuthorizedExecutionRecord::receipt_projection preserves ABI revisions 3, 4 and 5 and canonical_encode writes them, but V2ActivityReceipt::canonical_decode accepts only abi_revision == 2. Receipts emitted for current admitted guests cannot round-trip through the declared public decoder."
expected = "The receipt decoder must accept the exact versioned shapes emitted by admitted ABI 2 through 5 execution, while continuing to reject unallocated revisions and malformed evidence."
proposal = "In programs/crates/layerx-programs-runtime/src/execute.rs, define the admitted revision-specific receipt contract and decode each emitted revision strictly; exercise actual ABI 3, 4 and 5 guest execution, canonical encoding, durable storage and decoding through the public API."
owner_domain = 13
interface = "13.rs-rt-execute-v2activityreceipt-canonical-decode"

[finding.trace-encoding]
file = "programs/crates/layerx-programs-runtime/src/execute.rs"
line = 3229
class = "interface-mismatch"
severity = "high"
observed = "ExecutionRecord::canonical_evidence and V2AuthorizedExecutionRecord::canonical_evidence encode canonical_arbitration_bytes with the v2 arbitration chain. Their host-ffi write_canonical_evidence implementations instead hand-write legacy v1 trace bytes; the ExecutionRecord writer even omits commitment sizes, fuel and totals. ffi_call.rs uses these writers for published native terminals, so the same traced execution has different evidence depending on transport."
expected = "Public Rust execution evidence and C-published evidence must preserve the same versioned trace, commitments and canonical bytes for the same real execution, including arbitration eligibility."
proposal = "In programs/crates/layerx-programs-runtime/src/execute.rs, route both allocating and reserved-buffer writers through one versioned canonical trace encoder; prove exact public-Rust/native-C byte equality and successful proof-client decoding for real traced ABI 1 and ABI 2 through 5 calls."
owner_domain = 13
interface = "13.rs-rt-execute-executionrecord-canonical-evidence"

[finding.receipt-trace-bound]
file = "programs/crates/layerx-programs-runtime/src/execute.rs"
line = 2887
class = "runtime-risk"
severity = "medium"
observed = "canonical_decode reads a u32 trace length and clones cursor.take(length) without checking MAX_TRACE_EVIDENCE_BYTES. The trace bound is incorrectly applied at line 2900 to the success-response length instead. A supplied receipt can therefore allocate an arbitrarily large trace up to its input length despite the declared evidence ceiling."
expected = "Untrusted receipt decoding must enforce a version-correct trace evidence bound before cloning trace bytes; response and graph limits must apply to their own fields."
proposal = "In programs/crates/layerx-programs-runtime/src/execute.rs, check the trace length before allocating and derive its bound from the actual arbitration encoding, leaving response checks on the response field; add maximum and one-past-limit malformed-receipt cases for the public decoder."
owner_domain = 13
interface = "13.rs-rt-execute-v2activityreceipt-canonical-decode"

[finding.continuation-state]
file = "programs/crates/layerx-programs-runtime/src/execute.rs"
line = 1574
class = "restart-recovery"
severity = "high"
observed = "capture_continuation serializes only linear_memory, exported mutable globals, entrypoint and arguments; restore_continuation writes only those fields into a new instance. The enabled and metered reference-types/bulk-memory guest surface admits mutable tables and data/element segment drops, but neither capture eligibility nor RuntimeContinuation preserves those states. A successful snapshot can resume with different indirect-call targets or segment availability after restart."
expected = "A successful sandbox continuation must preserve every admitted mutable Wasm state component so resumed execution has the same behaviour as uninterrupted execution; unsupported states must prevent a successful lossy capture."
proposal = "In programs/crates/layerx-programs-runtime/src/execute.rs and programs/crates/layerx-programs-sandbox/src/snapshot.rs, version and persist table contents, sizes and segment lifecycle, or explicitly restrict resumability before accepting capture; prove mutate, capture, fresh instantiation and restore equivalence for table operations and dropped segments."
owner_domain = 13
interface = "13.rs-rt-execute-programinstance-capture-continuation"

[finding.pinned-dispute-versions]
file = "programs/crates/layerx-programs-runtime/src/execute.rs"
line = 6111
class = "restart-recovery"
severity = "high"
observed = "adjudicate_market_step compares a previously authorized profile against the current fee schedule passed by host/market.rs and the resolver current module, rejecting differing fee version, code hash or metering version. A governance fee change or program upgrade during an open claim makes honest historical reveal evidence Denied; dispute.rs timeout then awards ProviderAbsent or Unadjudicated against the provider."
expected = "A fraud dispute must remain reproducible against the exact artifact and fee/metering versions authorized for its lease throughout the challenge and recovery lifecycle, including governance changes and upgrades."
proposal = "In programs/crates/layerx-programs-runtime/src/host/market.rs and execute.rs, resolve authenticated historical artifacts and fee schedules by the profile versions and code hash and retain them until all dependent disputes close; qualify an actual claim across a fee update, code upgrade and restart through reveal and timeout."
owner_domain = 13
interface = "13.rs-rt-execute-adjudicate-market-step"

[finding.billing-unbound]
file = "programs/crates/layerx-programs-market/src/arbitration.rs"
line = 87
class = "interface-mismatch"
severity = "high"
observed = "billing_claim accepts provider billing.usage and output_digest and prices that supplied usage after checking only profile maxima. execute.rs MARKET_STEP_TERMINAL verifies the final state commitment and termination, but never compares billing usage or output_digest to authoritative replayed usage/output. A valid low-work trace can therefore defend an inflated within-limit bill; market_tests.rs also constructs trace roots with hard-coded output and usage instead of deriving them from execution."
expected = "FraudProvable payment must be based on the actual sandbox billing record: every charged dimension and output digest must be authenticated by the validated execution trace so a dishonest bill loses its challenge."
proposal = "In programs/crates/layerx-programs-runtime/src/execute.rs and programs/crates/layerx-programs-market/src/arbitration.rs, bind billing dimensions and output to authoritative terminal replay facts and profile interval accounting; drive the compiled market guest through genuine low-usage execution with inflated usage and incorrect output and prove dispute refusal without fabricated fixture shapes."
owner_domain = 13
interface = "13.rs-mkt-arbitration-billing-claim"

[finding.challenge-account-overlap]
file = "programs/crates/layerx-programs-market/src/settle.rs"
line = 430
class = "security"
severity = "high"
observed = "challenge accepts stake_account equal to the lease escrow or offer stake account. The live CHALLENGE_USAGE path funds that program account using its public seed and persists ClaimStatus::Frozen. Every resulting adjudication or timeout reaches stake::slash, which rejects those overlaps at stake.rs:276; unchallenged finalization also refuses Frozen, leaving escrow and provider stake locked."
expected = "Every admitted funded challenge must have a reachable settlement and timeout path, with distinct accounts satisfying the same invariants that stake::slash later enforces."
proposal = "In programs/crates/layerx-programs-market/src/settle.rs challenge and src/lib.rs CHALLENGE_USAGE, reject lease-escrow and provider-stake account overlap before funding or persistence; prove refusal and conserved funds through the real guest, plus successful non-overlapping timeout settlement after reload."
owner_domain = 13
interface = "13.rs-mkt-settle-challenge"

[finding.profiled-call-scheduler]
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
line = 89
class = "interface-mismatch"
severity = "high"
observed = "schedule_descriptor_spans_bound interprets canonical_payload byte zero as the ordinary CALL header and uses its fixed 106-byte offset. C lxp_programs_call_profile_decode accepts a replay-profile prefix and lxp_programs_call_schedule_decode adjusts its spans by replay_prefix_length but passes the whole wrapped activity as canonical_payload. Rust checks the prefix as a CALL header and rejects valid profiled CALL descriptors before scheduling."
expected = "The kernel scheduler and Rust access planner must authenticate and interpret the same complete canonical activity, including supported replay-profile wrappers and their exact capability/declaration offsets."
proposal = "In programs/crates/layerx-programs-runtime/src/ffi_call.rs and src/modules/programs/call.c, share the authenticated wrapper decoding and payload offsets without losing the full activity binding; exercise a real profiled CALL through kernel schedule decode, Rust planning and execution."
owner_domain = 13
interface = "13.rs-rt-ffi-call-layerx-programs-schedule-plan"

[finding.sandbox-storage-alias]
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
line = 1442
class = "interface-mismatch"
severity = "high"
observed = "Sandbox execution derives a principal from host principal plus lease, and import_catalog_storage relabels native cells with that derived principal. C call_namespace_for_program still selects the original authority principal, sandbox.c passes that original authority, and export_catalog_storage maps writes back to that native namespace. Distinct leases and ordinary calls for the same program/principal therefore alias cells despite separate Rust sandbox namespaces."
expected = "The authenticated lease namespace must identify the same isolated state through native catalog import, execution, export, occupancy charging and durable recovery; one lease must not read or overwrite another lease or ordinary-call storage."
proposal = "In src/modules/programs/call.c, src/modules/programs/sandbox.c and programs/crates/layerx-programs-runtime/src/ffi_call.rs, carry an authenticated host-plus-lease namespace consistently through storage and occupancy; qualify two leases and an ordinary call with colliding keys, then restart and independently read each value."
owner_domain = 13
interface = "13.c-rt-layerx-programs-call-catalog-storage-cell-count"

[finding.sandbox-event-principal]
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
line = 2136
class = "interface-mismatch"
severity = "high"
observed = "Sandbox authorization and ProgramEvent use the derived execution principal, and emit_events passes event.principal to layerx_programs_call_event_begin. The C consumer at call.c:1735 requires equality to value->authority->principal, which remains the original caller supplied by sandbox.c. An otherwise successful event-emitting sandbox is rejected during post-execution event publication."
expected = "Sandbox event producer, native event validation and receipt transport must agree on the authenticated event principal while preserving the intended separation between host payer and lease execution identity."
proposal = "In programs/crates/layerx-programs-runtime/src/ffi_call.rs and src/modules/programs/call.c, define and propagate one authenticated sandbox event-principal policy; execute an actual event-emitting sandbox guest through native settlement and verify its committed receipt and log principal."
owner_domain = 13
interface = "13.c-rt-layerx-programs-call-event-begin"

[finding.guest-log-unwired]
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
line = 2089
class = "interface-mismatch"
severity = "high"
observed = "layerx_programs_event_log_encode exposes ProgramGuestEvent(bytes32,bytes32,bytes) from a process-local cache, but has no production caller transporting those bytes. precompiles/layerxprograms/events_call.go consumes the older code-6 LXGE hash envelope and abi.json declares the ten-field digest-only event. Runtime payload bytes and the declared new topic0 never reach the 0x101D log consumer; its test asserts the old topic."
expected = "Requirements 13052 and 13055 require the actual 0x101D event path to preserve canonical guest kind and payload with topic0 for ProgramGuestEvent(bytes32,bytes32,bytes) and topic1 the program id, including after receipt replay."
proposal = "In src/modules/programs/call.c and precompiles/layerxprograms/events_call.go, transport the encoded runtime log bytes in committed native receipt evidence, align abi.json and emit the declared event; prove exact topics and payload from a real guest call through precompile emission and replay instead of only calling the export in isolation."
owner_domain = 13
interface = "13.rs-rt-ffi-call-layerx-programs-event-log-encode-j51"

[finding.sandbox-terminal-decoder]
file = "programs/crates/layerx-programs-runtime/src/ffi_call.rs"
line = 2665
class = "interface-mismatch"
severity = "high"
observed = "execution_with_sandbox_receipt wraps sandbox outcomes in LXP/programs/sandbox-settlement/v1 followed by inner evidence, usage receipt and transfer root. terminal.rs unwrap recognizes only transfer-authority and occupancy attachments, and decode_terminal_payload has no sandbox domain. The real layerx-proof program consumer calls this decoder and rejects the published sandbox terminal."
expected = "Every native sandbox receipt must round-trip through the public Rust terminal decoder and proof-client consumer, authenticating the usage receipt and transfer root rather than treating the new wrapper as an unknown execution domain."
proposal = "In programs/crates/layerx-programs-runtime/src/terminal.rs and services/agent/crates/layerx-proof/src/program.rs, add bounded versioned sandbox attachment decoding and authenticate its usage/root against the receipt; qualify actual native sandbox terminal publication, persistence, reload and proof verification."
owner_domain = 13
interface = "13.c-rt-layerx-programs-call-terminal-publish"

[finding.guest-read-allocation]
file = "programs/crates/layerx-programs-runtime/src/host/memory.rs"
line = 68
class = "runtime-risk"
severity = "medium"
observed = "read_guest allocates its Vec before validating pointer plus length against linear memory. read_slice at line 103 likewise checks length against total memory but allocates before checking the pointer range. Invalid large reads, including the hash host path, can allocate and zero memory before returning STATUS_BOUNDS and before the caller reserves byte-copy fuel."
expected = "Untrusted guest ranges must be checked with overflow-safe pointer and length arithmetic before host allocation or copying, and byte-proportional host work must be authorized before materializing the input."
proposal = "In programs/crates/layerx-programs-runtime/src/host/memory.rs, preflight the entire memory range before allocating and expose a validated range for callers to reserve copy fuel first; qualify invalid high pointers with large lengths and verify no proportional allocation occurs."
owner_domain = 13

[finding.hash-preflight]
file = "programs/crates/layerx-programs-runtime/src/host/crypto.rs"
line = 35
class = "runtime-risk"
severity = "medium"
observed = "The hash import calls read_slice before enforcing MAX_HASH_INPUT_BYTES = 1048576 in hash_bytes and before charge_host_cpu. A guest with larger memory can force an oversized input allocation/copy before the declared hash bound rejects it; invalid ranges return before the byte charge."
expected = "The one-MiB hash ceiling and full input/output ranges must be validated before allocating or copying, and the operation must reserve its proportional fuel before expensive host work."
proposal = "In programs/crates/layerx-programs-runtime/src/host/crypto.rs, preflight the hash input ceiling and both ranges, reserve fuel, then copy and hash; cover an oversized valid-memory input, invalid pointer and exhausted fuel through the actual registered import."
owner_domain = 13
interface = "13.wasm-host-hash"

[finding.f04-admission-fixture]
file = "programs/crates/layerx-programs-ai-market/tests/f04_recovery.rs"
line = 689
class = "test-gap"
severity = "medium"
