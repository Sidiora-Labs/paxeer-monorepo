expected = "Requirement 21130.1 and the audit brief require real producer-to-consumer recovery proof; evaluator setup and later requests must use the replay sequence actually committed by routed admission."
proposal = "In programs/crates/layerx-programs-ai-market/tests/f04_recovery.rs, drive evaluator approval, nomination and AdmitEvaluator through dispatch::route and derive subsequent sequences from committed replay state; route aggregation where the test claims live dispatch and correct the obsolete F05 comment."
owner_domain = 13
interface = "13.rs-aim-admission-admit-evaluator"

[finding.f04-reopen-fixture]
file = "programs/crates/layerx-programs-ai-market/tests/f04_recovery.rs"
line = 1208
class = "test-gap"
severity = "medium"
observed = "Journal::open deletes an existing journal, chooses a process-id directory and Drop removes it. The crash test at line 1677 retains the same Journal and in-memory Market while only report locals leave scope. It proves readback of a pending reveal, but never stops, reopens the durable client journal or reloads the committed market/replay state."
expected = "A restart/recovery claim must discard the prior process state, reopen preserved durable bytes and recover the exact reveal against independently reloaded producer state, without recreating or clearing the journal."
proposal = "In programs/crates/layerx-programs-ai-market/tests/f04_recovery.rs, separate create, reopen and cleanup with a stable journal path; destroy and reconstruct the client, reload committed market and replay state, then retry the exact persisted reveal and prove idempotent completion."
owner_domain = 13

