[finding.program-result-grpc]
file = "modules/xweb/keeper/grpc_query_program.go"
line = 61
class = "interface-mismatch"
severity = "high"
observed = "ProgramResult returns QueryProgramResultResponse.ContentDigest as the SDK custom types.Hash32 array. The Google protobuf codec selected by sdk/baseapp/grpcrouter.go cannot marshal that successful producer response: proof_go_api_test.go:254-257 explicitly expects the panic \"invalid Go type types.Hash32 for field paxprotocol.paxchain.xweb.QueryProgramResultResponse.content_digest\". The direct keeper result therefore does not round-trip through the declared gRPC transport."
expected = "The declared ProgramResult query and requirements 6819.2 and 6820.1 must return the persisted digest, lengths and response to the actual QueryClient, including after reopening state; a successful keeper call alone does not provide that interface."
proposal = "In sdk/baseapp/grpcrouter.go and the shared gRPC codec registration, support the generated SDK custom marshal/unmarshal methods while preserving the declared protobuf bytes encoding. Coordinate modules/xweb generated query types with that codec and prove a successful ProgramResult through the registered query transport after disk reopen."
owner_domain = 15
interface = "6.qry-xweb-programresult-j37"

[finding.program-result-proof]
file = "modules/xweb/keeper/proof_go_api_test.go"
line = 254
class = "test-gap"
severity = "medium"
observed = "The proof reads a successful ProgramResult directly from NewQueryServer and asserts that the actual producer response panics when marshalled by the transport codec. ProgramResult wire coverage exercises missing or malformed requests instead of successfully decoding the persisted answer. Other real bank, EVM, LevelDB reopen and genesis replay assertions in this proof are valuable but do not close this transport gap."
expected = "Brief fact_7 and the Go API acceptance criteria require agreement along producer, transport and consumer, with a successful response and durable recovery rather than an expected transport panic."
proposal = "After the shared SDK codec repair, update modules/xweb/keeper/proof_go_api_test.go to retrieve successful ProgramResult, Params, Attestors, Request and Result through their actual query clients and registered transport. Preserve the existing real disk reopen, genesis replay, payout, EVM and replay-protection assertions."
owner_domain = 6
interface = "6.qry-xweb-programresult-j37"

[finding.program-genesis-kind]
file = "modules/xweb/types/genesis.go"
line = 125
class = "interface-mismatch"
severity = "high"
observed = "GenesisState.Validate accepts a version-1 123-byte ProgramPending record with KindStorageReceipt (4), and ProgramPendingRecord.Bytes can encode that kind. keeper/program.go programKind only accepts fetch (1) and search (2), so DecodeProgramPendingRecord rejects the validated record. keeper/genesis.go InitGenesis then panics when importing it."
expected = "The program-pending genesis producer, validator and importer must accept the same origin-2 kind set and restore every validated record without panic. Origin-1 storage receipt support must remain intact."
proposal = "Define one origin-2 kind policy shared by modules/xweb/types/genesis.go and modules/xweb/keeper/program.go. Either reject kind 4 at origin-2 encoding and validation or implement its entire origin-2 lifecycle. Keep origin-1 kind 4 working and prove the actual module JSON export/validate/import path for all supported kinds."
owner_domain = 6
interface = "6.gen-xweb-program-pending-j37"

[finding.program-answer-genesis]
file = "modules/xweb/types/genesis.go"
line = 168
class = "restart-recovery"
severity = "medium"
observed = "ProgramAnswers validation checks ownership, duplicate parts, the 40-byte part-0 header size and the number of headers, but never decodes header lengths or checks chunk coverage and sizes. A fulfilled record and header declaring one response byte with no part 1 passes validation and import, then GetProgramResult returns NON_CANONICAL and the program invariant fails."
expected = "The program-answers genesis interface must restore answers that its consumer can read: response length at most 4096 and no greater than full length, complete ordered 1024-byte chunks with the exact final remainder, and no unreferenced parts."
proposal = "In modules/xweb/types/genesis.go validate decoded answer lengths and the exact required part set against the canonical keeper writer and reader. Reject missing, extra or malformed chunks before any import writes, and add producer-built JSON recovery cases for empty, boundary and multipart answers."
owner_domain = 6
interface = "6.gen-xweb-program-answers-j37"

[finding.pending-genesis-fee-denom]
file = "modules/xweb/types/genesis.go"
line = 134
class = "restart-recovery"
severity = "medium"
observed = "Validate requires a ProgramFeeDenoms mapping only when a program record is fulfilled. A positive-fee pending record without that mapping passes validation and imports, but ProgramRequest returns NotFound and signed fulfilment cannot split its fee because programFeeDenom returns ASSET_MISMATCH. The helper in types/genesis_test.go also constructs paid pending state without the mapping."
expected = "The program fee-denomination genesis interface must retain the asset-to-denomination identity for every paid pending request so that queries and fulfilment recover in the original denomination."
proposal = "Require a valid mapping for every positive-fee pending and fulfilled record in modules/xweb/types/genesis.go, while explicitly preserving any supported historical zero-fee fixture policy. Build genesis fixtures from the real request producer and prove query and payout in the original denomination after JSON import and reopen."
owner_domain = 6
interface = "6.gen-xweb-program-feedenoms-j37"

[finding.committed-capacity-lifetime]
file = "modules/xweb/keeper/program_fulfil.go"
line = 149
class = "runtime-risk"
severity = "high"
observed = "FulfilProgram increments persisted ProgramCommittedCount and refuses every fulfilment once it reaches ProgramCommittedCapacity (64). There is no normal decrement, acknowledgement or reclamation path. RequestFromProgram checks pending capacity (256), continues accepting paid requests after the committed limit, and has no program timeout/refund recovery. TestFulfilProgramCommittedCapacity explicitly leaves request 65 pending with its fee escrowed; restart preserves the permanent saturation."
expected = "A running merged network must continue serving paid program requests across its lifetime and restarts. The bounded answer arena must have a defined durable retention/reclamation policy, admission must respect available capacity, and accepted fees must have a completion or recovery path."
proposal = "Define and implement a bounded hot-answer retention or acknowledgement lifecycle in modules/xweb/keeper/program_fulfil.go, program_result.go and program.go, preserving durable answer availability and replay tombstones. Reserve capacity before paid admission and provide recovery or cancellation for already accepted requests. Prove more than 64 sequential requests across restart without widening the bound or dropping replay checks."
owner_domain = 6
interface = "6.key-xweb-program-count-committed-j37"

[finding.timeout-height-overflow]
file = "modules/xweb/keeper/request.go"
line = 71
class = "runtime-risk"
severity = "medium"
observed = "Request sets TimeoutHeight to ctx.BlockHeight()+int64(params.TimeoutBlocks). ValidateSettings accepts any nonzero uint64 timeout, so a governed value at or above 2^63 or an overflowing height sum becomes a past or negative deadline. The request can be immediately refundable and its exported Request can violate state validation after the fee was accepted."
expected = "The timeout-blocks parameter must produce a representable future block height for each accepted request, and invalid configuration or overflow must be rejected before escrow or nonce changes."
proposal = "Bound TimeoutBlocks in modules/xweb/types/state.go and use checked height addition in modules/xweb/keeper/request.go before escrow and nonce allocation. Add boundary cases at the maximum safe timeout and height and assert that rejected requests leave state and balances unchanged."
owner_domain = 6
interface = "6.gen-xweb-param-timeout-blocks-j37"

[finding.storage-receipt-error-name]
file = "modules/xweb/types/errors.go"
line = 90
class = "interface-mismatch"
severity = "medium"
observed = "storage_receipt.go registers ErrInvalidPayload as SDK xweb code 26, but LXPName maps only codes 2 through 25 and the shared common error registry has no corresponding row. Malformed storage receipt payloads reach the 0x1019 precompile through lxpError and WithRevertReasons as bare error text rather than an agreed named LXP error, leaving clients without the declared stable classification."
expected = "The LXPName interface and shared SDK/revert registry must identify every public xweb validation error consistently across Go, EVM Error(string) transport and SDK consumers."
proposal = "Agree a stable storage-payload error name and add it to modules/xweb/types/errors.go, precompiles/common/lxp_errors.go, the precompile address-table contract and consumer SDK maps. Prove malformed 0x1019 kind-4 payloads through the actual precompile and decode the resulting Error(string) into the same retry classification."
owner_domain = 6
interface = "6.go-xweb-types-lxpname-j37"

[finding.json-solidity-value-location]
file = "precompiles/json/Json.sol"
line = 44
class = "interface-mismatch"
severity = "medium"
observed = "IJson.extractAsBytesFromArray declares uint16 memory arrayIndex. Solidity does not permit a memory data location on a uint16 value parameter, so a consumer importing the supplied interface cannot compile. The embedded ABI and Go implementation correctly accept uint16 with selector 0xb0bf8a47."
expected = "The published Solidity consumer interface for precompile 0x1003 must compile and express the same argument types and selectors as the served ABI, including extractAsBytesFromArray(bytes,uint16)."
proposal = "Remove the invalid memory location from the uint16 argument in precompiles/json/Json.sol and compile a consumer importing that exact interface. Preserve all four frozen selectors, the no-event contract and the existing gas golden assertions."
owner_domain = 6
interface = "6.pc-0x1003-extractasbytesfromarray"

[finding.readme-retired-runtime]
file = "README.md"
line = 46
class = "doc-drift"
severity = "medium"
observed = "The architecture section describes two execution domains, a separate layerxd process and LayerX checkpoint settlement through layerxAnchor. Build instructions include make layerxd and the closing release description still presents a draft separate LayerX settlement model."
expected = "Brief network facts specify one paxd network with the kernel embedded in block production, EVM chain id 125, root-path public RPC and finality at block commit. Retired daemons and checkpoint settlement are not operating components."
