line = 2147
class = "restart-recovery"
severity = "medium"
observed = "validate_record accepts a ReceiptVerified leg with receipt, digest, activity and submission references but does not require rung_evidence or receipt_authority. After decoding, state can report Done while verified_leg_evidence refuses the same leg because either evidence field is absent, leaving an accepted stored record unusable by the read/export path."
