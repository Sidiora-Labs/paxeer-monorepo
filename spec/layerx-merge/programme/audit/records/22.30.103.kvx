interface = "10.fmt-human-api-type-journey-state"

[finding.receipt-operation-domain]
file = "services/human/crates/layerx-human-service/src/journeys/engine.rs"
line = 1951
class = "interface-mismatch"
severity = "high"
observed = "compile_plan sets expected_operation to the intent activity ordinal and receipt_matches_leg requires that byte. Native send is activity 0x00010005, so it expects 5; the real node/sequencer/receipt.go:400 writes etx.Type(), which is 2 for the EIP-1559 transaction signed by this engine, with module_id 12. The committed native receipt therefore cannot complete the declared engine advance interface."
expected = "Receipt verification must agree with the merged node producer on the execution-domain operation and bind the disclosed send separately to its exact signed transaction and authenticated receipt."
proposal = "Update journeys/engine.rs receipt verification and its production adapter to verify EVM receipt module/type, transaction hash, exact bank call and committed evidence using the actual node producer; keep all signature, fee, nonce, identity and rung checks and prove advance plus restart with a real EIP-1559 send receipt."
owner_domain = 10
interface = "10.rs-human-service-journeys-engine-journey-engine-advance"

