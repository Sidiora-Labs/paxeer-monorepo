[finding.export-key-loss]
file = "services/human/crates/layerx-human-service/src/custody/mod.rs"
line = 889
class = "restart-recovery"
severity = "high"
observed = "export_primary_once calls the destructive provider export before persisting its local self-custody marker or returning the key to the owner. layerx-human-kms/src/store.rs:352-377 durably marks self_custodied and erases the seed before replying; a lost reply, local marker failure or subsequent security.rs audit failure leaves the owner without the seed and future exports refused."
expected = "The only primary key must survive interrupted export delivery and restart; the transition to owner custody cannot erase the sole usable copy before a recoverable acknowledged handover."
proposal = "Introduce a durable recipient-encrypted delivery object and stable export ceremony identifier across custody/mod.rs, the KMS store and security.rs; recover the identical object after interruption until owner acknowledgment, then retire managed signing without regenerating a different key."
owner_domain = 10
interface = "10.rs-human-service-custody-keystore-export-primary-once"

[finding.custody-temp-recovery]
file = "services/human/crates/layerx-human-service/src/custody/mod.rs"
line = 1334
class = "restart-recovery"
severity = "medium"
observed = "write_atomic and replace_atomic create the fixed .key.tmp path with create_new. A crash after creation leaves that protected temporary file; startup accepts the tree and record enumeration ignores it, but retrying the same key publication fails AlreadyExists indefinitely."
expected = "Custody startup must reconcile an interrupted key-record publication so a retry can resume safely without losing the remote binding or accepting uncommitted key material."
proposal = "Reconcile protected temporary records during Keystore startup against the committed record and remote binding; resume publication or remove only a verified uncommitted inode, and cover crash-before-link and crash-before-rename recovery in the custody owner's repair."
owner_domain = 10

[finding.custody-read-bound]
file = "services/human/crates/layerx-human-service/src/custody/mod.rs"
line = 1073
class = "runtime-risk"
severity = "medium"
observed = "read_record checks that the record is a nonempty regular file then fs::read allocates the entire file. The 4096-byte provider-reference limit is applied only by the later decoder, so an oversized or corrupted record can exhaust memory before the typed corruption refusal."
expected = "A finite LXCK record encoding must be bounded on the opened descriptor before allocating its body, including during restart and inspection of damaged storage."
proposal = "In custody/mod.rs, calculate the largest supported LXCK record size and perform a bounded descriptor read before decoding; reject excess bytes with the existing corruption result and retain the ownership, link and permission checks."
owner_domain = 10

[finding.gateway-operation-deadline]
file = "services/human/crates/layerx-human-service/src/custody/gateway.rs"
line = 478
class = "runtime-risk"
severity = "medium"
observed = "GatewayLimits.deadline declares a separate budget for the relayed provider operation, but dispatch invokes synchronous create, describe, rotate, destroy and probe without passing that budget. Signing polls a future whose RemoteKmsProvider blocks synchronously, and block_on accepts Ready without checking elapsed time, allowing the provider deadline to exceed the gateway budget."
expected = "Every relayed provider operation must obey the configured total operation deadline in addition to finite worker admission and socket I/O limits."
proposal = "Pass one absolute remaining deadline from custody/gateway.rs through provider operations and the remote transport, including synchronous lifecycle calls; prove that the actual delayed backend is refused within the gateway budget without extending worker lifetime indefinitely."
owner_domain = 10
interface = "10.rs-human-service-custody-gateway-gateway-limits"

[finding.remote-native-signature-gap]
file = "services/human/crates/layerx-human-service/src/custody/provider.rs"
line = 607
class = "interface-mismatch"
severity = "high"
observed = "KmsProvider::sign_native defaults to unconditional KmsError::Refused and RemoteKmsProvider never implements it. Production startup admits ProductionKms::Remote, but the always-exposed native.send.access.begin/confirm flow reaches native_send.rs:433 and sign_native_consent_in_scope, whose accepted remote configuration cannot produce the consent signature. The attestor provider does implement native signing."
expected = "An admitted production provider for an exposed native-access flow must implement the exact declared consent-signature producer consumed by that flow, or reject the unsupported capability before offering it."
proposal = "Implement an authenticated native-consent LXKP request from RemoteKmsProvider through the actual KMS producer, or add explicit provider capability admission to startup and operation discovery with a named unsupported-capability refusal; retain and prove the working attestor path."
