line = 930
class = "runtime-risk"
severity = "medium"
observed = "announce_rotation rejects any identity already present in rotations. reconcile_rotation changes its entry to Effective or Lapsed but never removes or archives it, so one terminal rotation prevents all subsequent rotations of that identity in the generic provisioner."
expected = "An identity must support successive successful rotations and a fresh challenge after a lapsed attempt, while retaining completed rotation evidence."
