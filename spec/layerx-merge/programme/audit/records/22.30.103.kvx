[finding.identity-first-batch]
file = "services/human/crates/layerx-human-identity-provider/src/provision_head.rs"
line = 109
class = "retired-reference"
severity = "medium"
observed = "validate-account-head pins SequencerAuthorization to heights 1..1, decodes the protocol-3 account-head receipt and signed batch header, and returns consumed=0. The hosted provision-owner Job still invokes it through services/platform/hosted/human/provision.sh, whose producer is the old /v1/protocol/account-state/head agent boundary."
expected = "Owner provisioning in the merged network must derive its account and consumed budget state from authenticated committed chain observations and remain usable after the first batch."
proposal = "Migrate provision_head.rs together with services/platform/hosted/human/provision.sh and provision-owner-job.yaml to the committed-chain account-state producer; preserve authentication, identity binding and unsupported-history refusals and prove provisioning after a restart at a later height."
owner_domain = 10
interface = "10.cli-layerx-human-identity-provider-validate-account-head"

