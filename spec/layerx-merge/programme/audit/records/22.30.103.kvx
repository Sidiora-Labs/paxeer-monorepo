interface = "10.rs-human-service-custody-signer-custody-signer-sign-native-consent-in-scope"

[finding.sessions-state-restart]
file = "services/human/crates/layerx-human-service/src/custody/sessions.rs"
line = 750
class = "restart-recovery"
severity = "medium"
observed = "SessionKeyProvisioner stores current and retired leases, pause/archive state and rotation journeys only in its agents and rotations BTreeMaps. new initializes both maps empty and exposes no restore operation, losing external authority identifiers and pending transitions after reconstruction. This is a dormant generic helper."
expected = "Supported session lifecycle authority must be recovered before serving pause, revoke, renewal or rotation operations after restart."
proposal = "Persist principal-scoped leases, lifecycle state and rotation transitions in custody/sessions.rs and reconcile them with the real daemon/chain on reopen; cover interruption between installation, suspension, revocation and receipt reconciliation before enabling the helper in production."
owner_domain = 10
interface = "10.rs-human-service-custody-sessions-session-key-provisioner"

[finding.session-renewal-orphan]
file = "services/human/crates/layerx-human-service/src/custody/sessions.rs"
line = 1263
class = "restart-recovery"
severity = "medium"
observed = "renew_one installs a replacement with provision_new before suspending and revoking the predecessor, but stores the replacement only after both old-authority operations succeed at line 1289. A later error leaves the installed replacement untracked and retry installs another replacement. This helper has no current production driver."
expected = "A partial renewal must retain every installed authority and resume the same transition or revoke its exact replacement after failure."
