[finding.history-state-schema]
file = "services/human/crates/layerx-human-service/src/journeys/engine.rs"
line = 392
class = "interface-mismatch"
severity = "high"
observed = "JourneyEngine returns JourneyState::Closed for retained retired kinds. server/production_reads.rs:624 serializes state=closed, but schema/human-api/journeys.kvx JourneyState excludes closed. server/http.rs:593 validates every response against that enum, so a historical journey get or list containing it becomes upstream_degraded instead of readable closed history."
