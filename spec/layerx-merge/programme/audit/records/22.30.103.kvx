[finding.native-onboarding-refused]
file = "services/human/crates/layerx-human-service/src/agents/create_native.rs"
line = 191
class = "wiring-gap"
severity = "high"
observed = "The native creation stage list always starts with Custody and DidRegistration, but resume_native unconditionally returns Refused(\"native onboarding operation is retired\") at DidRegistration. ProductionComponents still calls start_native and resume_native for agent creation, so a fresh native agent cannot reach funding, budget or session provisioning."
expected = "The exposed managed-agent creation operation must progress through the merged network identity lifecycle and reach its receipt-backed usable-agent result, while historical retired records remain readable."
proposal = "Replace the retired DidRegistration stage and its production adapter with the current chain identity and authority lifecycle in agents/create_native.rs and server/agent_creation_native.rs; retain explicit historical handling and prove the actual HTTP creation-to-receipt and restart path."
owner_domain = 10
interface = "10.rs-human-service-agents-create-creation-journey"

[finding.reclaim-old-key-retry]
file = "services/human/crates/layerx-human-service/src/agents/reclaim.rs"
line = 250
class = "restart-recovery"
severity = "medium"
observed = "Reclaim::start checks the stored last-used nonce before looking up the exact idempotency record at line 292. After a later reclaim records nonce N+1, retrying the original identical request at nonce N returns StaleNonce instead of the already retained reclaim."
expected = "An exact retry of an already recorded principal-scoped reclaim must return the same journey without another effect, including after subsequent reclaims and a store reopen."
proposal = "In agents/reclaim.rs, resolve and validate an existing idempotency record before freshness admission for a new reclaim; exercise reopen, request N, request N+1 and exact retry N, preserving conflict and stale-new-request refusals."
owner_domain = 10
interface = "10.rs-human-service-agents-reclaim-reclaim-start"

[finding.control-state-restart]
file = "services/human/crates/layerx-human-service/src/agents/controls.rs"
line = 366
class = "restart-recovery"
severity = "medium"
observed = "AgentControls keeps active_budget_id, authority evidence and completed_limit_changes only in memory and new reconstructs an empty completion map. Reconstructing this helper after a limit change loses the result needed to recognize the same key and may derive another replacement budget. Production controls have a separate implementation."
expected = "A supported receipt-backed limit change must recover its active authority and exact idempotent result before admitting another change after restart."
proposal = "Persist principal-scoped control requests, active budget and completion evidence in agents/controls.rs, or consolidate the helper with the durable production control path; prove an exact completed-limit retry after reconstruction without creating another authority."
owner_domain = 10
interface = "10.rs-human-service-agents-controls-agent-controls-change-limit"

[finding.archive-history-mutation]
file = "services/human/crates/layerx-human-service/src/agents/archive.rs"
line = 513
class = "runtime-risk"
severity = "medium"
observed = "ArchiveJourney::history dereferences each stored table/key and returns the row's current bytes. The archive record retains neither a snapshot nor a digest, so changed retained history is silently returned even though the method promises to refuse altered rows. This helper is not the running production archive implementation."
expected = "An archived agent's retained history must preserve the content that was archived or detect later mutation before presenting it as immutable evidence."
proposal = "In agents/archive.rs, retain immutable history bytes or authenticated row digests with the archive transition and compare on history reads; cover a changed row at the same table/key and preserve missing-history refusals."
owner_domain = 10
interface = "10.rs-human-service-agents-archive-archive-journey-history"

