[finding.metered-retired]
file = "services/interop/crates/x-websearch/src/payment.rs"
line = 1361
class = "interface-mismatch"
severity = "high"
observed = "payment_required offers METERED for each asset when a payer is named; Plane::draw calls read_payer_grant. The actual precompiles/layerxledger/payments.go getPayerGrant (line 136) and draw (line 92) unconditionally return ErrNoPayerGrant, so the advertised settlement cannot succeed."
expected = "Every offered scheme must execute on the merged ledger. Decision 2340 retires receive and payer-grant activities; req.11392-11395 and the served/planned grant registry wording conflict with that retirement."
proposal = "In services/interop/crates/x-websearch/src/payment.rs remove unusable grant offers and align buyers/sellers with supported exact settlement or an explicitly specified replacement. Reconcile grant requirements and registry rows with domain 6 without restoring retired activities, and prove an offered payment on the actual ledger."
owner_domain = 11
interface = "6.pc-0x101a-getpayergrant"

[finding.fulfilment-nonces]
file = "services/interop/crates/x-websearch/src/submit.rs"
line = 1025
class = "runtime-risk"
severity = "high"
observed = "main.rs opens program-submit and submit with the same keys.submitter() account in separate loops. submit_program and submit independently read the pending nonce before signing; without shared reservations they can journal distinct transactions at one nonce and endlessly rebroadcast the losing transaction."
expected = "Concurrent ordinary/program fulfilments from one account must allocate distinct nonces, including uncertain broadcast and restart recovery, so one valid request cannot strand another."
proposal = "In services/interop/crates/x-websearch/src/submit.rs share a durable chain/account nonce coordinator between both main.rs loops, covering reservation, journal publication and uncertain sends. Exercise simultaneous request kinds and reopen after allocation before broadcast."
owner_domain = 11
interface = "7.rpc-eth-gettransactioncount"

[finding.program-answer-recovery]
file = "services/interop/crates/x-websearch/src/program.rs"
line = 477
class = "restart-recovery"
severity = "high"
observed = "ProgramExchange::open initializes an empty answers map. record/accept retain answers and peer signatures only in memory; snapshot/restore have no live ProgramRelay caller. Restart before transaction signing makes prepare_program reattest the same key against changed content, permitting conflicting signatures and a split quorum."
expected = "Req.11371 one-answer-per-program/request behavior and the brief recovery rule must survive the whole signing, peer transport and quorum lifecycle, before transaction journalling begins."
proposal = "In services/interop/crates/x-websearch/src/program.rs atomically persist an answer before publishing it and persist quorum updates; restore with chain/request/signer checks and retire only with durable completion. Reopen after emission before quorum and prove unchanged digest/bytes despite changed web/index content."
owner_domain = 11
interface = "11.http-xws-program-attestations"

[finding.settlement-authority]
file = "services/interop/crates/x-websearch/src/main.rs"
line = 344
class = "config-drift"
severity = "medium"
observed = "ReadinessProbe checks settlement_usable at gateway.endpoint as req.11394 directs, but PaymentGate::new_with_network_id constructs SettlementRpc from evm.endpoint (payment.rs:1209). Different URLs can report ready while actual payment lacks receipts or block working payment on an unused gateway."
expected = "Paid-delivery readiness must check the same configured chain and receipt authority used by payment, with one unambiguous endpoint responsibility."
proposal = "Align services/interop/crates/x-websearch/src/main.rs, src/payment.rs and req.11394 on a named settlement authority; share that client with readiness. Exercise distinct watcher/settlement URLs where only the selected authority implements pax_sequencerReceipt and assert paid-route eligibility."
owner_domain = 11
interface = "11.cfg-xws-gateway-endpoint"

[finding.watcher-ownership]
file = "services/interop/crates/x-websearch/src/main.rs"
line = 579
class = "runtime-risk"
severity = "medium"
observed = "relay and pipeline open separate RequestWatchers. Each poll journals both event topics, but the ordinary loop retires only ordinary work and ProgramRelay retires only program work. Each opposite-kind queue accumulates permanently and is cloned and serialized on further polls."
expected = "Every durable watched item must have an active completion/retirement owner; normal mixed network traffic must not create an ever-growing duplicate pending queue."
proposal = "In services/interop/crates/x-websearch/src/main.rs use one durable dispatcher for both kinds or explicitly assign and retire foreign-kind work per watcher, preserving req.11366 both-topic discovery. Prove sustained mixed traffic and reopen leave no orphan queue."
owner_domain = 11
interface = "11.rs-xws-kernel-relay-step"

[finding.fetch-dns-deadline]
file = "services/interop/crates/x-websearch/src/fetch.rs"
line = 779
class = "runtime-risk"
severity = "medium"
observed = "Fetcher::destination synchronously calls to_socket_addrs with no resolver timeout. Fetch, robots and API paths cannot interrupt that resolution, so unavailable DNS can hold workers beyond total_timeout_ms despite the subsequent socket deadlines."
expected = "The advertised absolute fetch deadline must bound DNS as well as connect, TLS, redirects, robots and body reads while retaining destination restrictions."
proposal = "In services/interop/crates/x-websearch/src/fetch.rs introduce bounded cancellable resolution under the caller deadline, preserving all-address SSRF checks and address pinning. Exercise slow resolution through the production client and assert timely refusal without weakening destination checks."
owner_domain = 11
interface = "11.rs-xws-fetcher-destination"

[finding.fetch-framing-memory]
file = "services/interop/crates/x-websearch/src/fetch.rs"
line = 416
class = "security"
severity = "medium"
observed = "Wire::fill appends all bytes while consumed bytes only advance start. Tiny chunks, extensions, unlimited trailers or repeated 1xx can retain excessive framing despite a small decoded body. line/head return a found delimiter before checking its offset against the maximum, accepting oversized completed frames at read boundaries."
expected = "Untrusted wire overhead needs strict per-frame and aggregate limits, independently of decoded body size, with consumed data released during the transfer."
proposal = "In services/interop/crates/x-websearch/src/fetch.rs compact consumed buffers, check delimiter offsets, and bound aggregate informational headers, chunk metadata and trailers. Exercise many tiny chunks and oversized completed lines within the existing total time limit."
owner_domain = 11
interface = "11.rs-xws-http-client-get"

[finding.api-framing-memory]
file = "services/interop/crates/x-websearch/src/api.rs"
line = 1558
class = "security"
severity = "medium"
observed = "The API TLS Wire parser similarly retains all consumed bytes. until accepts a completed header/chunk line before checking maximum and chunked permits excessive aggregate trailers and metadata, allowing small JSON responses to consume disproportionate memory."
expected = "The API attestation client must bound untrusted wire overhead separately from accepted body bytes and enforce lengths when delimiters arrive in the same read."
proposal = "In services/interop/crates/x-websearch/src/api.rs use a bounded framing parser with compaction, delimiter-offset checks and aggregate head/chunk/trailer budgets, sharing the corrected HTTP primitive where appropriate. Exercise the real TLS client with adversarial framing while preserving credential checks."
owner_domain = 11
interface = "11.rs-xws-api-client-call"

[finding.search-tie-expansion]
file = "services/interop/crates/x-websearch/src/search.rs"
line = 176
class = "runtime-risk"
severity = "medium"
observed = "search doubles TopDocs until it includes the complete boundary score tie, then retrieves every TantivyDocument including full body into ranked before truncating to ten. Equal-score common queries can materialize the matching corpus, affecting paid workers and readiness probes."
expected = "Ten-result searches must preserve deterministic score/URL ordering while retaining bounded candidates and materializing full bodies only for selected results."
proposal = "In services/interop/crates/x-websearch/src/search.rs collect the best ten using URL as a deterministic tie key during collection and load stored bodies only for winners. Exercise a large tied corpus and establish stable ordering and bounded retained candidates."
owner_domain = 11
interface = "11.fmt-xws-search-result"

