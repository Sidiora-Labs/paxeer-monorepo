[finding.capability-message-url]
file = "modules/layerxauth/keeper/capability.go"
line = 91
class = "interface-mismatch"
severity = "high"
observed = "SaveGrant sets MsgTypeUrl to /paxprotocol.paxchain.layerxauth.LayerXScopeAuthorization, the authorization protobuf rather than an executable message. SDK authz.DispatchActions looks up grants by sdk.MsgTypeURL of the wrapped message, and Accept also requires that exact URL. No Msg service executes the authorization object; successive capabilities for the same address pair also share this single grant key."
expected = "Decision 210 and interface 2.go-layerxauth-grantcapability-j23 require the kernel capability mirror to authorize the intended SDK activity through real MsgExec dispatch."
proposal = "In modules/layerxauth/keeper/capability.go define the supported kernel-scope to executable-message mapping, persist each applicable grant under its actual message URL, and specify how multiple grants for the same pair compose. Prove grantCapability followed directly by MsgExec without replacing the stored grant."
owner_domain = 2
interface = "2.go-layerxauth-grantcapability-j23"

[finding.unscoped-message-bypasses-policy]
file = "modules/layerxauth/types/authorization.go"
line = 79
class = "security"
severity = "high"
observed = "After the revocation check, Accept returns Accept:true for every message that does not implement ScopedActivity. Ordinary bank MsgSend does not implement it; only layerXScopeTestActivity in authorization_test.go supplies LayerXScope. Consequently bank sends bypass module mask, ordinal, asset, maximum amounts and spending updates."
expected = "A LayerX scope must constrain the activity actually executed; a delegated bank payment cannot bypass the stored spending policy because its message lacks a Go-only helper interface."
proposal = "In modules/layerxauth/types/authorization.go reject unsupported message shapes or decode supported production messages into authenticated scope metadata. Add a real bank MsgExec proof showing an out-of-scope or over-limit transfer is refused and an allowed transfer charges the grant."
owner_domain = 2

[finding.grant-validity-not-enforced]
file = "modules/layerxauth/types/authorization.go"
line = 57
class = "security"
severity = "high"
observed = "Accept never compares the block timestamp with NotBefore or NotAfter. ValidateBasic checks only the ordering of the two stored values. SDK authz expiration is a separate value chosen by the MsgGrant sender, and even the capability mirror expiration does not enforce the lower bound."
expected = "Decision 211 says the full kernel scope is checked by Accept; a not-yet-valid or expired authority must not execute an SDK activity."
proposal = "In modules/layerxauth/types/authorization.go enforce the millisecond validity interval against block time on every Accept call, bind SDK grant expiration to that interval, and prove exact start/end behavior through signed MsgGrant and MsgExec."
