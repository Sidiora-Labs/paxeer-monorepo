proposal = "Migrate the account-state consumers and retained relay contract in services/platform/hosted/agent-boundary/src/main.rs, hosted/registry/src/node_state.rs and agentd/src/read/program_node.rs to the chain state/proof APIs, then remove the old HTTP relays and prove the complete transport."
owner_domain = 8

[finding.037]
file = "services/platform/hosted/agent-boundary/src/main.rs"
line = 737
class = "wiring-gap"
severity = "high"
interface = "8.http-agent-boundary-get-readyz"
observed = "readiness first opens the old config.node loopback HTTP port before checking chain_receipts, so a healthy merged chain cannot make this boundary ready without the retired node listener. config also requires NODE_URL and its bearer file and creates unused kernel journal directories."
