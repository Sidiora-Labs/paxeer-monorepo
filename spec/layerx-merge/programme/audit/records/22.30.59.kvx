[file.214]
path = "wasm/contrib/relayer-tests/test_ibc_transfer.sh"
lines = 26
verdict = "issues"
note = "Whole file reviewed; its concrete discrepancies, lifecycle or coverage gaps and owning repair proposals appear in finding entries."

[finding.1]
file = "modules/layerxcustody/keeper/release.go"
line = 57
class = "interface-mismatch"
severity = "high"
observed = "ReleaseRetired resolves empty Params.Authority to the gov module address (keeper.go:89-93), then calls SendCoinsFromModuleToAccount. node/app.go:890-891 supplies the SDK BankKeeper, whose keeper.go:391 rejects this blocked recipient. A mapped asset with a positive balance makes node/upgrades.go:551 return an error and prevents ApplyUpgrade from completing the merge."
expected = "Requirements 6485.1 and 6485.4 require the real merge plan to release every mapped balance to its authority once. The default governance authority is a supported configuration and must receive those balances through a lawful bank transfer."
proposal = "In modules/layerxcustody/keeper/release.go and types/expected_keepers.go provide a governed module-to-module transfer for the default gov destination, retaining the account transfer for valid external authorities and preserving bank protections. Extend keeper/merge_release_test.go to apply the real merge with default params, positive balances and pending claims; assert balances, cancellations and exactly-once behavior."
owner_domain = 6
interface = "6.go-lxcustody-keeper-releaseretired-j36"

[finding.2]
file = "modules/layerxcustody/keeper/retire.go"
line = 14
class = "restart-recovery"
severity = "high"
observed = "Retired depends entirely on the upgrade done-height store. Custody ExportGenesis at keeper/genesis.go:76 exports no retirement activation; sdk/x/upgrade/module.go:104-130 ignores genesis and exports an empty object. node/app.go:1669 restores module versions but no done heights. A fresh app importing post-merge state reports Retired false and reopens deposits/admin writes, while new proof withdrawal and exit verification still return ErrModuleRetired."
expected = "Requirements 6481.3, 6482.4 and 6482.7 and brief check_5 require a merged network recovered from exported state to retain retirement. It must refuse new deposits into custody whose new proof release paths are already retired."
proposal = "Define validated activation recovery in sdk/x/upgrade and node genesis, or a specified custody genesis lifecycle field. Coordinate modules/layerxcustody/keeper/genesis.go: its SetParams/SetAsset currently reject an already-restored retirement marker, so historical loading needs an internal initialization path distinct from runtime mutation. Prove full app export, close, fresh InitChain and post-import deposit/admin refusals."
owner_domain = 6
interface = "6.go-lxcustody-keeper-retired-j36"

[finding.3]
file = "modules/tokenfactory/module.go"
line = 187
class = "runtime-risk"
severity = "medium"
observed = "ExportGenesisStream creates an unbuffered goroutine that reads am.ExportGenesis(ctx, cdc) after returning. The captured SDK context references mutable stores: advancing or closing them before that read can change the snapshot or fail the read. sdk/types/module/module.go:464 currently drains immediately; a production concurrent mutation was not established."
expected = "The streaming genesis API should capture the producer state at invocation, matching the synchronous stream implementations and mutation-before-drain assertions in keeper/proof_genesis_test.go. Recovery bytes should not depend on goroutine scheduling."
proposal = "In modules/tokenfactory/module.go marshal synchronously, enqueue the snapshot on a one-element buffered channel and close it before returning, matching the other repaired module streams. Add tokenfactory stream tests that mutate state and close the producer before draining, asserting exact snapshot bytes and finite channel closure."
owner_domain = 6
interface = "6.go-tokenfactory-module-appmodule-exportgenesisstream-j35"

[finding.4]
file = "modules/tokenfactory/keeper/issuer_supply.go"
line = 17
class = "runtime-risk"
severity = "medium"
observed = "MintByIssuer checks recipient bech32 encoding before mintTo, but bankactions.go:23 mints supply before SendCoinsFromModuleToAccount at line 34 can refuse a valid blocked recipient such as gov. With no local CacheContext, the exported keeper call can return an error after leaving minted coins and bank events in its caller context. Only tests and the IssuerKeeper declaration currently call this supply API."
expected = "An issuer mint refused by bank destination policy should leave supply, account/module balances and events unchanged. The direct keeper API exposed by requirement 6249.1 cannot assume that every consumer supplies transaction-level rollback."
proposal = "Make MintByIssuer in modules/tokenfactory/keeper/issuer_supply.go atomic across mintTo and event emission with an SDK cache committed only on success. Add a real app BankKeeper test in keeper/proof_issuer_did_test.go using a valid blocked module destination; assert refusal, unchanged supply, both balances and events."
owner_domain = 6
interface = "6.go-tokenfactory-mintbyissuer-j35"

[finding.5]
file = "modules/layerxcustody/keeper/keeper.go"
line = 144
class = "runtime-risk"
severity = "medium"
observed = "SetAsset compares raw asset.Pointer with stored other.Pointer before canonicalizing it at lines 162-165. ParseAddress accepts alternate hex letter case; stored pointers use EIP-55. A second asset can reuse the same 20-byte pointer under another spelling and overwrite AssetPointerKey while both asset records remain."
expected = "SetAsset lines 131-133 promise that a pointer already bound to another asset is refused. Pointer identity is the 20-byte address regardless of textual case; the asset store and pointer lookup must agree on its owner."
proposal = "In modules/layerxcustody/keeper/keeper.go parse and canonicalize the pointer before the conflict scan, comparing address bytes or the existing pointer index before writing. Add lower-case, upper-case and EIP-55 alias cases in keeper/keeper_test.go for two assets and assert unchanged original records and indexes on refusal."
owner_domain = 6
interface = "6.msg-layerxcustody-setasset"

[finding.6]
file = "modules/layerxcustody/keeper/merge_release_test.go"
line = 49
class = "test-gap"
severity = "medium"
observed = "prepareCustodyMerge replaces the default governance authority with a random ordinary account at lines 49-52 before either real merge-plan test runs. The tests cover account-destination release but miss the blocked default gov module recipient."
expected = "Requirement 6485.4 requires the actual upgrade keeper release path to work for supported configurations, including default authority. An ordinary-account fixture does not establish module-recipient compatibility with the production bank keeper."
proposal = "Add a default-authority case in modules/layerxcustody/keeper/merge_release_test.go using the real app bank keeper and scheduled v7.0 plan with native/factory balances and pending claims. Assert governance destination balances, terminal claims/nullifiers and repeat refusal; retain the explicit-account case."
owner_domain = 6
interface = "6.go-lxcustody-keeper-releaseretired-j36"

[finding.7]
file = "modules/layerxcustody/keeper/genesis_retire_test.go"
line = 69
class = "test-gap"
severity = "medium"
observed = "TestGenesisRoundTripAfterRetiredRelease asserts Retired only in the source context at line 50. After fresh-app import at line 69 it compares historical records and solvency but never asserts Retired or attempts a new deposit/admin operation. Equal exported custody records hide lost activation."
expected = "Brief check_5 and requirements 6481.3 and 6482.4 require recovery of both historical custody data and its retired lifecycle. Fresh consumer observations must prove the same refusal as the merged source."
proposal = "Extend modules/layerxcustody/keeper/genesis_retire_test.go with app-produced export, real close/reopen and fresh InitChain. Assert recovered Retired, deposit/admin refusals, unchanged balances and no new events. Restore activation through the specified validated production initialization path instead of manually marking the consumer done."
owner_domain = 6
interface = "6.go-lxcustody-keeper-retired-j36"

[finding.8]
file = "modules/tokenfactory/types/msgs.go"
line = 178
class = "runtime-risk"
severity = "medium"
observed = "MsgChangeAdmin.ValidateBasic always parses NewAdmin as bech32 and rejects the empty string. Keeper ChangeAdmin accepts empty admin; README.md:17 promises renunciation with that value, and admins_test.go directly accepts it through the msg server. A normal validated transaction cannot perform the documented renunciation."
expected = "The admin lifecycle must agree across signed message validation, CLI/wasm encoders and keeper state. Supported renunciation must be reachable through the user transaction path and preserve the independent issuer DID."
proposal = "Resolve renunciation policy in modules/tokenfactory/types/msgs.go, keeper/admins.go and README.md. If empty admin stays supported, permit it explicitly while validating nonempty addresses, then prove a signed/validated ChangeAdmin transaction through the real app route, CLI/wasm encoding and issuer preservation."
owner_domain = 6
interface = "6.go-tokenfactory-types-msgchangeadmin-validatebasic-j35"

[finding.9]
file = "modules/tokenfactory/keeper/admins_test.go"
line = 63
class = "test-gap"
severity = "medium"
observed = "TestAdminMsgs and empty-admin cases call msgServer.ChangeAdmin directly and accept success. They bypass MsgChangeAdmin.ValidateBasic, which rejects those messages. Keeper-only success therefore does not prove the advertised transaction lifecycle."
expected = "Admin lifecycle tests must cover behavior reachable by a user transaction, including validation, authorization and issuer retention. Direct server success is insufficient while the message validation refuses the same value."
proposal = "Retain keeper assertions in modules/tokenfactory/keeper/admins_test.go and add a producer-created signed ChangeAdmin transaction through real app validation and routing. Assert the approved renunciation outcome and an unauthorized refusal, with unchanged issuer DID and supply."
owner_domain = 6
interface = "6.msg-tokenfactory-changeadmin"

[finding.10]
file = "modules/tokenfactory/keeper/bankactions_test.go"
line = 197
class = "test-gap"
severity = "low"
observed = "TestBurnDenom declares amount 1000 for its over-balance row at line 182 but constructs every burn with literal 10 at line 197. The row also selects a non-admin, so its refusal exercises authorization rather than its named condition. TestMultipleInterleavedMintsBurns independently covers an over-balance burn."
expected = "Each table row should submit its declared amount and isolate the named refusal. The over-balance case should reach the balance check with a valid admin and prove unchanged supply and balances."
proposal = "In modules/tokenfactory/keeper/bankactions_test.go use tc.amount in the coin, select the lawful admin for the over-balance row and assert the specific insufficient-funds refusal plus unchanged balances and supply. Preserve the separate authorization and interleaved cases."
owner_domain = 6

[finding.11]
file = "modules/tokenfactory/types/msgs_test.go"
line = 255
class = "test-gap"
severity = "medium"
observed = "TestMsgBurn and TestMsgChangeAdmin use msg := baseMsg where baseMsg is a pointer. The empty-sender case mutates the same message used by later zero/negative-amount, empty-admin and invalid-denom cases. Generic Error assertions can pass because Sender remains empty instead of exercising the intended field."
expected = "Brief check_7 requires one-field validation cases to use otherwise valid producer-shaped messages. A prior invalid sender must not mask missing validation of another field."
proposal = "Create a fresh constructor result or value copy per case in modules/tokenfactory/types/msgs_test.go. Assert exact wrapped error identities for sender, amount, denom and new admin, aligning the empty-admin case with the approved public renunciation policy."
owner_domain = 6

[finding.12]
file = "modules/tokenfactory/keeper/proof_genesis_test.go"
line = 214
class = "test-gap"
severity = "medium"
observed = "TestProofGenesisListedModuleConsumers tests mutation-before-drain snapshots for transfer, launchpad, anchor, bridge and custody but omits tokenfactory.AppModule. The tokenfactory producer/consumer proof uses synchronous ExportGenesis, leaving its deferred ExportGenesisStream outside the snapshot assertions."
expected = "The exported tokenfactory stream needs real producer/consumer snapshot coverage equivalent to the other module streams. Synchronous JSON/protobuf recovery cannot establish the asynchronous path behavior."
proposal = "Add the real tokenfactory AppModule to modules/tokenfactory/keeper/proof_genesis_test.go stream cases. Mutate a valid producer parameter before drain and assert earlier snapshot bytes; use the disk harness to close the producer before consuming, then prove channel closure and consumer round-trip."
owner_domain = 6
interface = "6.go-tokenfactory-module-appmodule-exportgenesisstream-j35"

[finding.13]
file = "wasm/contrib/relayer-tests/one_chain.sh"
line = 99
class = "config-drift"
severity = "medium"
observed = "The script accepts PROFPORT at line 28 but Linux and macOS rewrites replace localhost:6060 with P2PPORT at lines 99 and 107. Profiling binds the peer port instead of the requested profiling port, conflicting with the peer listener when profiling is enabled."
expected = "The local harness should honor independently supplied RPC, peer, profiling and gRPC ports. Its two-chain caller supplies separate profiling ports 6060 and 6061."
proposal = "Use PROFPORT in both platform branches of wasm/contrib/relayer-tests/one_chain.sh and check generated configs for the requested distinct listener ports before starting. Retain local ibc-0 and ibc-1 identities, which intentionally target upstream test chains."
owner_domain = 6

[finding.14]
file = "wasm/contrib/relayer-tests/init_two_chainz_relayer.sh"
line = 53
class = "config-drift"
severity = "medium"
observed = "RELAYER_CONF points to the working-directory .relayer and is deleted at line 33, but rly config, keys and light calls at lines 53-64 never receive it through --home. They use the relayer default home rather than the directory reset by the harness."
expected = "Local setup and subsequent transfer operations should share an explicit isolated relayer home. Resetting another directory must not retain old chains/keys or mutate an unrelated relayer installation."
proposal = "Thread a shared explicit relayer home through wasm/contrib/relayer-tests/init_two_chainz_relayer.sh and test_ibc_transfer.sh, passing --home on every rly call. Restrict cleanup to that home and use it for config, key restore, link, query and transfer."
owner_domain = 6

[finding.15]
file = "wasm/contrib/relayer-tests/init_two_chainz_relayer.sh"
line = 36
class = "runtime-risk"
severity = "medium"
observed = "The setup script invokes killall wasmd before starting its two instances. This targets every matching executable rather than nodes owned by this harness and can terminate an unrelated developer node."
expected = "A local example should stop only its own earlier child processes and leave unrelated nodes running. Node lifecycle ownership should be tied to the dedicated test homes and tracked process identities."
proposal = "Replace killall in wasm/contrib/relayer-tests/init_two_chainz_relayer.sh with child PID tracking under the harness data root, populated by one_chain.sh. Validate process identity/home before signaling, wait for those children and implement scoped trap cleanup on failure."
owner_domain = 6

[finding.16]
file = "wasm/contrib/relayer-tests/test_ibc_transfer.sh"
line = 20
class = "test-gap"
severity = "medium"
observed = "The script reports success whenever destination balance does not end in 100000000000test. Empty or unrelated successful balance output passes; it never checks the sent 1000000test as a destination IBC voucher or successful packet acknowledgement."
expected = "IBC transfer success requires the actual destination voucher denom and amount, successful acknowledgement and source movement. Absence of an old native balance is not proof of delivery."
proposal = "In wasm/contrib/relayer-tests/test_ibc_transfer.sh capture initial balances and packet identity, derive the expected ICS20 denom trace from the real path and poll with a finite timeout for successful acknowledgement and exact voucher increment. Reject empty/unparseable output and retain refusals."
owner_domain = 6

[finding.17]
file = "wasm/contrib/devtools/Makefile"
line = 64
class = "config-drift"
severity = "medium"
observed = "Tool recipes at lines 64, 74 and 79 use go get from /tmp to install statik, runsim and golangci-lint. The root declares Go 1.25.8; modern go get does not install commands and rejects this outside-module use. The recipes cannot produce their binary prerequisites with the supported toolchain."
expected = "The tools target should install pinned executable prerequisites to TOOLS_DESTDIR under the repository Go version without changing project dependency manifests."
proposal = "Update wasm/contrib/devtools/Makefile to version-pinned go install with explicit GOBIN matching TOOLS_DESTDIR and tool versions compatible with supported Go. Remove the obsolete /tmp workaround and update devtools/README.md installation guidance."
owner_domain = 16

[finding.18]
file = "wasm/contrib/prototools-docker/Dockerfile"
line = 8
class = "config-drift"
severity = "medium"
observed = "The helper pins buf 0.30.0 and Go 1.16.8/1.17.3, whereas the root buf.gen.yaml uses version v2 and go.mod declares 1.25.8. Its independently selected regen protobuf/gocosmos stack also differs from the root generator path. This image cannot consume the current root buf v2 config."
expected = "Requirement 7288.1 assigns reproducible generation to root plugins/options. A supported helper should use the same configuration and generator resolution, or be explicitly historical upstream tooling."
proposal = "Retire this alternate image from supported generation or update wasm/contrib/prototools-docker/Dockerfile to the root Go/buf toolchain and build/proto/gocosmos generator with root mapping options. Direct its README to the single authoritative generation path."
owner_domain = 16

