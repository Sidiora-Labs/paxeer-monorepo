[finding.edge-reload-durable-state]
file = "tools/bringup/edge.sh"
line = 447
class = "restart-recovery"
severity = "medium"
observed = "apply restores its snapshot only when nginx -t fails. If nginx -s reload fails, the new manifest, sites and pool state remain on disk while the old worker configuration remains live; a restart can later activate the unacknowledged change."
expected = "An edge mutation must either install and acknowledge one durable configuration generation or retain the previously serving generation across failure and restart."
proposal = "Make tools/bringup/edge.sh apply handle reload failure with a recoverable configuration transaction and explicit generation state; qualify a refused reload followed by reopen without losing the last serving routes."
