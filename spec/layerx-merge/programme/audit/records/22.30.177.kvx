[finding.edge-manifest-roundtrip]
file = "tools/bringup/check-live.sh"
line = 1515
class = "interface-mismatch"
severity = "high"
observed = "check_edge and check_ramp at line 3687 accept only four-field name/mode/app/port rows and only http or stream. edge.sh map_line at line 472 emits six fields including a host:port upstream, kind and SNI; RPC manifests add mode rpc. Every current rendered row is discarded before readiness checks."
expected = "The registered edge CLI must emit a manifest that its live-check consumers can decode, including Railway, box, stream and aggregate node RPC routes."
proposal = "In tools/bringup/check-live.sh consume the six-field manifest produced by tools/bringup/edge.sh, dispatch probes by kind and mode, and compare the actual upstream and TLS identity without requiring Fly app metadata. Prove edge.sh output through both live consumers."
owner_domain = 16
interface = "16.cli-bringup-bringup-edge"

[finding.search-front-roundtrip]
file = "tools/bringup/check-live.sh"
line = 1458
class = "interface-mismatch"
severity = "high"
observed = "check_search_front extracts split_clients destinations and requires that set to equal every serving name. search-front.sh render at lines 220-234 deliberately emits exactly one primary or backup destination plus its eligibility map. A valid deployment with multiple serving nodes therefore fails missing-upstream checks."
expected = "Live qualification must accept the renderer's declared single pinned backend and eligibility contract while refusing validator or unknown destinations."
proposal = "Change tools/bringup/check-live.sh to validate the primary/backup pin, eligibility map and typed readiness contract produced by tools/bringup/search-front.sh, and feed real render output into its qualification path."
owner_domain = 16
interface = "16.cli-bringup-bringup-search-front-sub-render"

[finding.xweb-config-roundtrip]
file = "tools/bringup/xweb-config.sh"
line = 243
class = "interface-mismatch"
severity = "high"
observed = "Both render modes emit gateway.sequencer_id and gateway.sequencer_public_key instead of gateway.receipt_keys; attestor rendering also emits a root kernel object at line 319. services/interop/crates/x-websearch/src/config.rs:839 explicitly refuses the legacy gateway keys and root.finish rejects unknown root fields."
expected = "Rendered configurations must load through the real x-websearch Config::parse, including nonempty receipt_keys with key_id, public_key, first_height and last_height, and only supported root fields."
proposal = "Update tools/bringup/xweb-config.sh serve and attestor renderers to the config.rs schema, obtain the complete receipt trust history from its declared producer, and qualify generated files through the actual loader with rotation and refusal cases."
owner_domain = 16
interface = "11.fmt-deploy-x-websearch-config-example"

[finding.internal-probe-identity-location]
file = "tools/bringup/check-live.sh"
line = 2391
class = "interface-mismatch"
severity = "high"
observed = "The internal readiness loop railway_ssh runs inside each internal role but reads /data/tls/human-event-client. ca.sh:175 issues that identity only to box:KERNEL_HOST. docker/platform-internal/files.tsv provisions only INTERNAL_TLS DER server material under /data/tls/internal-<role>, so the migrated consumer cannot present its required PEM client identity."
expected = "The readiness producer, credential transport and caller must agree on the authorized client identity and the host where its files exist."
proposal = "In tools/bringup/check-live.sh probe from the existing authorized kernel identity location over the real private route, or provision a dedicated least-privilege probe identity through ca.sh and the internal deployment manifests; do not copy the Human private key into every role."
owner_domain = 16
interface = "16.cli-bringup-bringup-ca-sub-issue"

