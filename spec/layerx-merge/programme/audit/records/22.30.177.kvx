[finding.edge-concurrent-state-mutation]
file = "tools/bringup/edge.sh"
line = 717
class = "runtime-risk"
severity = "medium"
observed = "rpc-health snapshots and rewrites shared edge state while add, remove, set and rerender do the same. Only the cron invocation uses rpc-health.lock; the mutating CLI paths take no shared lock. A failed concurrent mutation can restore a snapshot over another successful update."
expected = "Every writer of the manifest, generated sites and health state must serialize the same configuration transaction and preserve independently accepted routes."
