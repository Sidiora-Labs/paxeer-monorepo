[finding.migration-dry-run-writes]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex"
line = 375
class = "security"
severity = "high"
observed = "run_phases builds migration items before execute_or_dry_run checks dry_run. merge_duplicate_emails calls Account.merge, transferring associations and deleting secondary identities even during a dry run."
expected = "An operator preview must leave identity ownership, associated account data and authentication state unchanged; only an explicitly applied migration may merge identities."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex, separate a read-only migration plan from execution, and perform approved duplicate merges only in the non-dry apply phase with rollback and a dry-run database invariance test."
owner_domain = 14

[finding.migration-unverified-email]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex"
line = 487
class = "security"
severity = "high"
observed = "Auth0 export requests email_verified, but build_migration_item drops that value; merge_duplicate_emails groups by email alone and build_keycloak_user sets emailVerified true for every email. User-data-bearing unverified identities can therefore share ownership with another account."
expected = "Moving authentication providers must preserve verified ownership evidence and must never grant verified email status or merge private account data merely because email text matches."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex, carry the source verification flag through the plan, preserve false in Keycloak, merge only identities with proven common ownership and require explicit resolution for unverified collisions."
owner_domain = 14

[finding.migration-error-shape]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex"
line = 380
class = "restart-recovery"
severity = "medium"
observed = "The failure branch expects {{:error, reason}, primary}, whereas Account.merge returns {{:error, operation, value, changes}, primary} for an Ecto.Multi failure. A real failed merge raises CaseClauseError after earlier groups may already have committed and account access was disabled."
expected = "A failed migration step must return an actionable failure and preserve a durable record of completed steps so an operator can resume without silently repeating or abandoning earlier merges."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex, handle the actual Multi failure tuple, halt the apply phase with the failing identity group and persist completed merges and an explicit recoverable account-access state."
owner_domain = 14

[finding.migration-provider-restart]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex"
line = 803
class = "restart-recovery"
severity = "medium"
observed = "disable_auth0 clears the OAuth domain only with Application.put_env after persisting replacement identity UIDs. Authentication.responsible_module prefers configured Auth0, so restarting with the original deployment environment restores the old provider against migrated identities."
expected = "A completed authentication cutover must select the new provider after restart and retain enough original-to-target identity mapping to recover a partially completed cutover."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex and authentication.ex, persist migration checkpoints and require the durable provider configuration transition before reporting success and reopening account access."
owner_domain = 14

[finding.migration-revocation-errors]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex"
line = 840
class = "security"
severity = "medium"
observed = "scan_and_delete ignores Redis DEL failures and converts SCAN failures into a successful-looking count; finalize then enables accounts and reports migration success even when old session validation keys remain."
expected = "Authentication cutover must confirm that all old sessions are revoked before access is reopened, and an incomplete revocation must remain visible and recoverable."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex, propagate SCAN and DEL errors, retain a resumable revocation checkpoint and keep cutover incomplete until deletion is acknowledged for the whole namespace."
owner_domain = 14

[finding.receipt-commit-inclusion]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/sequencer_receipt.ex"
line = 749
class = "security"
severity = "high"
observed = "committed verifies a signed receipt and a Comet commit at a matching height, but r7 accepts an unsigned eth_receipt and a from_seq/to_seq range. The transaction-status controller discards px_getSequenceBatch proof and roots; no inclusion check binds that batch or receipt to signed header.data_hash. A valid unrelated commit can accompany fabricated inclusion evidence."
expected = "A committed receipt must be cryptographically tied to the batch included in the signed block, including the sequence range, receipt result and roots, with a configured chain identity and trusted validator context."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/sequencer_receipt.ex and block_scout_web/controllers/api/v2/paxeer_x/transaction_status_controller.ex, preserve px_getSequenceBatch transaction and proof, verify inclusion against the signed data hash, bind receipt roots and sequence to that transaction and reject an unrelated valid commit."
owner_domain = 14
interface = "8.rpc-gateway-px-getsequencebatch"

[finding.retired-router-wiring]
file = "services/explorer/backend/config/runtime.exs"
line = 298
class = "wiring-gap"
severity = "high"
observed = "PAXEER_X_ROUTER_URL is the only SequencerReceipt endpoint. The live transaction-status path sends node pax_sequencerReceipt and eth_getTransactionReceipt calls and hosted-gateway px_getCommit, px_getValidators, px_getSequenceBatch and px_receiptKeys calls to this same URL, requiring the retired unified router."
expected = "Brief facts 2 and 3 require node JSON-RPC at the public root and px_ methods at the hosted gateway; a finished-network receipt lookup must reach both actual producers without a router."
proposal = "In services/explorer/backend/config/runtime.exs, SequencerReceipt and the transaction-status controller, declare separate node-root and hosted-gateway endpoints, dispatch each namespace to its producer and qualify committed and unavailable responses through both real transports."
owner_domain = 14
interface = "14.cfg-explorer-explorer-chain-paxeerx-sequencerreceipt"

[finding.identity-watchlist-atomicity]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/identity.ex"
line = 129
class = "restart-recovery"
severity = "medium"
observed = "create_identity inserts the identity before add_watchlist in a separate operation. A watchlist insertion failure leaves a persistent identity, while session_info later destructures its watchlists as a nonempty list and can crash on login."
expected = "Creating a usable account must establish its default watchlist atomically or repair an existing incomplete identity before returning a session."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/identity.ex, transact identity and initial watchlist creation together and make login recover a legacy identity without a watchlist before constructing session information."
owner_domain = 14

[finding.notification-erc7984-dispatch]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/notifier/notify.ex"
line = 140
class = "runtime-risk"
severity = "medium"
observed = "Summary can produce token type ERC-7984, but watched? handles coin, ERC-20, ERC-721, ERC-1155 and ERC-404 only. A confidential-token notification raises CaseClauseError; the outer Account.Notify rescue abandons the rest of that notification batch."
expected = "Every token type emitted by the summary producer must have an explicit notification preference and safe dispatch behavior without interrupting other watched transactions."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/notifier/notify.ex and watchlist_address.ex, define ERC-7984 preference semantics, add exhaustive dispatch and verify a mixed batch continues after a confidential-token transfer."
owner_domain = 14

[finding.notification-erc7984-amount]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/notifier/email.ex"
line = 50
class = "runtime-risk"
severity = "medium"
observed = "Email.amount has no ERC-7984 case although Summary emits that token type. Once such notifications reach email generation the amount renderer raises rather than rendering the confidential amount semantics."
expected = "Notification rendering must handle every summary token type and must preserve confidentiality when the amount is not publicly available."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/notifier/email.ex, add an explicit confidential-token amount presentation coordinated with notification preferences and verify the actual Summary output reaches a safe email."
