[finding.tag-address-encrypted-lookup]
file = "services/explorer/backend/apps/explorer/lib/explorer/account/tag_address.ex"
line = 175
class = "runtime-risk"
severity = "medium"
observed = "The tag lookup compares tag.address_hash, a randomized Cloak AES.GCM encrypted column, to the requested address. The changeset already maintains address_hash_hash for deterministic lookup, so ciphertext equality can miss an existing private tag."
expected = "Looking up a private address tag must match the same normalized address used when it was saved without relying on randomized ciphertext equality."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/account/tag_address.ex, query the deterministic address_hash_hash column using the same normalization as its changeset and verify a saved encrypted tag can be retrieved after a fresh encryption operation."
owner_domain = 14

[finding.tag-transaction-error-shape]
