[finding.unbounded-address-gas]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/cache/counters/address_gas_usage_sum.ex"
line = 30
class = "runtime-risk"
severity = "medium"
observed = "The counter stores one ETS entry per requested address or token through Helper.create_cache_table. TTL decides when to recompute a value but neither the module nor the plain ETS helper removes old keys, so a long-running public explorer accumulates every distinct lookup."
expected = "A cache exposed to arbitrary address or token lookups must have bounded retained cardinality and reclaim expired entries without requiring a process restart."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/cache/counters/address_gas_usage_sum.ex, add a bounded eviction policy or scheduled deletion of expired keys, coordinate refreshes with eviction and verify that many distinct requests leave retained entries within the configured limit."
owner_domain = 14

