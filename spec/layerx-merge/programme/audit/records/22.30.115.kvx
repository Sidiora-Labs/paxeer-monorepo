line = 70
class = "wiring-gap"
severity = "medium"
observed = "useWallet fetches only when client or tick changes and useStandardAccount likewise has no auth-state subscription when pollMs is omitted. A stable PaxeerWallet that signs in after the initial signed-out read stays empty; signing out or changing users can leave the prior public wallet visible. useSession already exposes the auth event source."
expected = "Wallet and standard-account hooks should track the current authenticated principal, clear prior account data on sign-out and refetch after sign-in without requiring callers to manually repair auth synchronization."
proposal = "Subscribe both account hooks in sdk/wallet/src/react.ts to the client auth lifecycle, invalidate in-flight reads by principal or generation, clear stale values, and prove sign-in, sign-out and account replacement with a stable client instance."
