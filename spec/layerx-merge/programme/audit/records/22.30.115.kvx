[finding.receipt-authentication]
file = "sdk/wallet/src/receipt.ts"
line = 17
class = "security"
severity = "high"
observed = "decodeSequencerReceipt accepts a receipted answer containing only rung, txHash and nonce; waitForSequencerReceipt returns on that rung. Optional receipt bytes, status, logs and keyId are only syntax checked. No governed receipt-key pin, signature or output-digest verification protects module and ladder consumers. rpc/sequencer_receipt.go:176-250 requires a full signed view, authenticates ReceiptKeys and binds every returned field to the receipt bytes."
expected = "A wallet must authenticate the governed receipt signer and the transaction, execution outputs and rung before showing a receipt or consuming its logs; a committed block must cover the receipt height. Brief checks 1 and 8 require receipt verification to be non-skippable."
proposal = "In sdk/wallet/src/receipt.ts, decode rung-specific complete views and verify the signed bytes and output digests against governed height-scoped receipt-key pins. Require that verifier in read, wait, module and ladder paths, with real node answers and tampered-answer rejection tests."
owner_domain = 12
interface = "12.rpc-sdk-calls-pax-sequencer-receipt-j50"

[finding.receipt-fields-lost]
file = "sdk/wallet/src/types.ts"
line = 573
class = "interface-mismatch"
severity = "high"
observed = "SequencerReceiptAnswer omits paymentDenom and signingKey. decodeSequencerReceipt in src/receipt.ts constructs a new object without either field. The real SequencerReceiptView emits both at rpc/sequencer_receipt.go:151,160; paymentDenom is needed to decode the signed fee view and signingKey is used with governed pins. The registry type mirror also describes an older, smaller view."
expected = "The declared wallet receipt answer must preserve the complete node receipt view, including paymentDenom and the 32-byte signingKey, and distinguish the submitted shape from the receipted and committed shapes."
proposal = "Update sdk/wallet/src/types.ts and src/receipt.ts together to preserve and validate the complete producer fields, update interface.12.ts-sdk-sequencer-receipt-answer-j50, and use node-emitted answers to prove a lossless producer-to-SDK round trip."
owner_domain = 12
interface = "12.ts-sdk-sequencer-receipt-answer-j50"

[finding.provider-session-binding]
file = "sdk/wallet/src/provider.ts"
line = 310
class = "security"
severity = "high"
observed = "sendTransaction validates a captured account but omits from from the gateway body, then gateway() awaits a new token at line 613. If the token supplier changes from account A to B, services/wallet/gateway/src/routes/sign.ts:650 chooses B from req.user and broadcasts at line 687 before assertSendTxResponse can reject the mismatch. request() also awaits confirmation before capturing signing context; personalSign and signTypedData return signatures without checking the recovered signer."
expected = "A signing approval and every resulting write must remain bound to the same account, authenticated session, chain and immutable payload through approval and broadcast. A later response check cannot undo a transaction sent by the wrong account."
proposal = "Capture account, chain, session generation and token before confirmation in sdk/wallet/src/provider.ts; invalidate stale approvals, send using that exact authenticated context, and have the wallet gateway enforce the expected sender before signing. Recover and validate message and typed-data signers before returning signatures."
owner_domain = 12
interface = "12.http-gw-post-v1-wallet-send"

[finding.default-node-hosted-methods]
file = "sdk/wallet/src/endpoint.ts"
line = 24
class = "interface-mismatch"
severity = "high"
observed = "EndpointClient defaults to https://api-mainnet-beta.paxeer.network but resolveAccount, getChainAccount, listBankAssets, getCapabilities, getNetwork, getBankBalances and history issue px_ methods. Those methods are dispatched by services/platform/hosted/gateway/src/paxeer.rs and are absent from the node namespace list. A default client therefore targets a producer that does not serve its declared reads."
expected = "Brief fact 3 separates node root JSON-RPC from hosted gateway px_ methods; the SDK must route hosted account, bank, discovery and history reads to their actual hosted producer while EVM reads use the node."
proposal = "Give sdk/wallet/src/endpoint.ts explicit hosted-gateway and node configuration, require the hosted endpoint for px_ reads or supply its declared default, and prove the default account/network path against the actual gateway and node namespaces."
owner_domain = 12
interface = "12.rpc-sdk-calls-px-get-account"

[finding.rpc-has-no-request-bound]
file = "sdk/wallet/src/rpc.ts"
line = 87
class = "runtime-risk"
severity = "medium"
observed = "JsonRpcClient.post awaits fetch and response.text without a deadline, AbortSignal or response-size bound. Receipt polling limits attempts in src/receipt.ts, but a single stalled fetch never completes an attempt and an arbitrarily large response is buffered before decoding."
expected = "Brief check 4 requires bounded network operations and decoding. Wallet reads and receipt recovery should return a definite timeout or cancellation instead of waiting indefinitely or buffering unbounded input."
proposal = "Add configurable bounded transport deadlines, cancellation and response limits in sdk/wallet/src/rpc.ts, propagate cancellation through receipt reads, and cover a stalled real HTTP response and oversized response without weakening existing envelope checks."
owner_domain = 12
interface = "12.ts-sdk-json-rpc-client"

[finding.react-auth-refresh]
