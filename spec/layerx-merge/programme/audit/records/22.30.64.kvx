[file.170]
path = "precompiles/wasmd/wasmd_test.go"
lines = 563
verdict = "issues"
note = "All instantiate, execute, query and batch cases reviewed; negative query selectors, allowed delegate flags, value success assertion and real EVM rollback evidence have separate findings."

[finding.wasmd-query-selector]
file = "precompiles/wasmd/wasmd_test.go"
line = 261
class = "test-gap"
severity = "medium"
observed = "TestQuery packs query(string,bytes) arguments but prefixes ExecuteID in all three negative cases at lines 261, 267 and 271; execute expects three arguments, so an ABI decode refusal satisfies the assertions without reaching query validation."
expected = "The 0x1002 query consumer must observe the real missing-contract, invalid-bech32 and invalid-query refusals from the query producer, rather than an unrelated selector refusal."
proposal = "In precompiles/wasmd/wasmd_test.go prefix QueryID for each negative query case, assert its actual refusal and gas outcome, and verify that contract state and emitted logs remain unchanged."
owner_domain = 6
interface = "6.pc-0x1002-query"

[finding.wasmd-delegatecall-success]
file = "precompiles/wasmd/wasmd_test.go"
line = 193
class = "test-gap"
severity = "medium"
observed = "The allowed delegatecall cases at lines 193, 338 and 506 pass false for isFromDelegateCall; only their disallowed counterparts pass true, so successful pointer authorization is never exercised by those cases."
expected = "Registered CW20, CW721 and CW1155 pointers must be able to execute the intended CosmWasm call through the same delegatecall path that refuses an unregistered pointer."
proposal = "Exercise real EVM delegatecalls from the registered pointer contracts to 0x1002 in precompiles/wasmd tests; check returned ABI bytes, caller authority and state changes, alongside the unregistered-pointer refusals."
owner_domain = 6
interface = "6.pc-0x1002-execute"

[finding.wasmd-value-success]
file = "precompiles/wasmd/wasmd_test.go"
line = 418
class = "test-gap"
severity = "medium"
observed = "TestExecuteBatchValueImmutability ignores every return value from RunAndCalculateGas and checks only the input big.Int; an early refusal before execution would pass the test just as a successful batch would."
expected = "The value-immutability regression must demonstrate that a successful batch consumed the intended coins and returned the expected responses without changing the caller-owned value object."
proposal = "Capture the result and error in TestExecuteBatchValueImmutability, require success, decode the batch response and assert sender and contract balances before checking that value equals valueCopy."
owner_domain = 6
interface = "6.pc-0x1002-execute-batch"

[finding.wasmd-batch-rollback-proof]
file = "precompiles/wasmd/wasmd_test.go"
line = 528
class = "test-gap"
severity = "medium"
observed = "The multiple-message batch cases put a valid execution before an invalid contract, address or coins payload, then assert only an error and zero remaining gas; they do not inspect the earlier execution state or its events after failure."
expected = "A failed EVM transaction must discard every earlier CosmWasm write, coin transfer and log in its batch; the EVM Call and StateDB snapshot machinery is present, but these direct-executor tests do not prove that boundary."
proposal = "Add a real EVM Call regression in precompiles/wasmd tests with a successful first message and failing second message; assert storage, balances and logs are unchanged, commit and reopen the application, and repeat the observations."
owner_domain = 6
interface = "6.pc-0x1002-execute-batch"

[finding.ibc-integration-skipped]
file = "interchain/testing/sdk_test.go"
line = 79
class = "test-gap"
severity = "medium"
observed = "TestIntegrationTestSuite unconditionally calls t.Skip before suite.Run, leaving the signed CLI, consensus and query integration suite unreachable; its comment still describes the monorepo merge as future work."
expected = "The existing integration assertions must execute on the merged SDK and IBC application so that signed transaction and query compatibility is established rather than inferred from isolated helpers."
proposal = "Restore the integration suite in interchain/testing/sdk_test.go against the current simapp and SDK APIs, retaining all assertions and exercising the real signed transaction and committed-query paths without skips."
owner_domain = 15

[finding.ibc-timeout-destination]
file = "interchain/testing/endpoint.go"
line = 459
class = "runtime-risk"
severity = "medium"
observed = "TimeoutPacket and TimeoutOnClose query a destination-key proof on the counterparty, but fetch NextSequenceRecv there using the source endpoint PortID and ChannelID at lines 459 and 489; unequal endpoint identifiers can select a missing or unrelated counterparty channel."
expected = "The next receive sequence and its proof must describe the same packet destination channel on the counterparty, even when source and destination port or channel identifiers differ."
proposal = "Use packet.GetDestPort and packet.GetDestChannel for counterparty sequence reads in interchain/testing/endpoint.go, and cover ordered timeouts and timeout-on-close with deliberately asymmetric endpoint identifiers."
owner_domain = 15
interface = "15.go-interchain-testing-endpoint-j57"

[finding.ibc-connection-version]
file = "interchain/testing/endpoint.go"
line = 167
class = "config-drift"
severity = "medium"
observed = "ConnectionConfig exposes Version, but ConnOpenInit uses DefaultOpenInitVersion and ConnOpenTry and ConnOpenAck use the global ConnectionVersion; changing the per-path version does not change those handshake messages."
expected = "A test path configured with a connection version must negotiate or refuse that version through the actual handshake, so callers can test compatibility independently of global defaults."
proposal = "Wire the proposed and negotiated ConnectionConfig.Version values through the connection handshake helpers in interchain/testing/endpoint.go, with distinct compatible and incompatible version configurations on the two endpoints."
owner_domain = 15
interface = "15.go-interchain-testing-endpoint-j57"

[finding.ibc-mock-genesis-stream]
file = "interchain/testing/mock/mock.go"
line = 159
class = "restart-recovery"
severity = "medium"
observed = "AppModule.ExportGenesisStream returns a nil channel; the registered simapp mock module reaches sdk/types/module/module.go ProcessGenesisPerModule, which ranges each module stream without a nil guard and therefore cannot finish this export."
expected = "A stateless test module must produce a terminating empty export so a simapp genesis export and subsequent restart can finish; this is a test-application recovery defect, not a claim that paxd registers the mock module."
proposal = "Return an already closed empty channel from interchain/testing/mock/mock.go and add a bounded full-simapp export and re-import check that verifies completion and preservation of the stateful IBC modules."
owner_domain = 15

[finding.ibc-delivery-error]
file = "interchain/testing/simapp/test_helpers.go"
line = 367
class = "runtime-risk"
severity = "medium"
observed = "SignAndDeliver assigns the Deliver failure to err and verifies an expected refusal, but overwrites err with app.Commit and returns the commit result; an intentionally refused transaction is returned to its caller as a nil error after a successful commit."
expected = "The transaction helper must preserve the delivery outcome for callers while independently requiring the block commit to succeed; a successful commit does not make a refused message successful."
proposal = "Keep separate deliveryErr and commitErr values in interchain/testing/simapp/test_helpers.go, preserve the documented transaction result on return, and cover a real refused message followed by a successful commit."
owner_domain = 15
interface = "15.go-interchain-testing-simapp-sign-and-deliver-j57"

