[finding.journey-wire]
file = "services/agent/crates/layerx-agentd/src/human.rs"
line = 2951
class = "interface-mismatch"
severity = "high"
observed = "AGENT_JOURNEY reads currency with Reader::text, whose bytes decoder rejects zero length, but rotate/recover require currency.is_empty(). The real Human producer agent_key_change at services/human/crates/layerx-human-service/src/server/agent_runtime.rs:1705 calls Writer::text(\"\") and itself refuses before sending. It also supplies zero pre_observation, whereas managed_agent::finalize_journey:943 requires a nonzero key-policy observation for these operations."
expected = "Opcode 28 must carry key rotation and recovery from the real Human client to agentd with one agreed operation-specific shape and a verified key-policy observation; valid requests must reach the lifecycle owner."
proposal = "Domain 9 should define a shared versioned journey codec with currency present for reclaim only and bind the required key-policy observation. Coordinate the Human producer in domain 10 and prove rotate and recover through the actual socket, persisted observations and store reopen."
owner_domain = 9
interface = "9.proto-human-peer-agent-journey"

[finding.finalization-rungs]
file = "services/agent/crates/layerx-agentd/src/managed_agent.rs"
line = 1612
class = "interface-mismatch"
severity = "high"
observed = "HumanFinalizationEvidence::validate in human.rs:376 accepts only non-Submitted Rung ranks 1 or 2, and From copies that byte unchanged. valid_finalization_shape accepts only legacy VerificationLevel ranks 4 or 5; validate_finalization_source:1567 also looks up legacy receipt metadata and compares the legacy rank. The predicate additionally equates the transaction hash with the caller action key. No finalization received through the Human wire can satisfy both rank checks. Unit tests at :2228 explicitly assert the retired ranks."
expected = "Human control, limit, reclaim, archive and revocation finalization must consume the same transaction hash, independent action key, committed height and Committed rung emitted by the transaction receipt producer, as required by the merged evidence model and req.9047."
proposal = "Domain 9 should move managed finalization onto the transaction receipt store and typed Rung::Committed evidence with a verified commit, retaining the action key as replay identity rather than equating it with the transaction hash. Exercise real Human requests and receipt persistence across restart, including refusal below Committed."
owner_domain = 9
interface = "9.rs-agentd-managed-agent-finalizationevidence-j43"

[finding.session-observation-shape]
file = "services/agent/crates/layerx-agentd/src/managed_agent.rs"
line = 816
class = "interface-mismatch"
severity = "high"
observed = "session_bytes at :1186 writes session_generation as u64 between token and open. require_session_observation reads open immediately after token, then action and digest, without reading generation. Its end-of-buffer check rejects every record its own producer emits, leaving eight bytes and shifted fields. finalize_control and finalize_archive consume this decoder."
expected = "Recorded and prepared session observations must be consumed byte for byte after persistence and reopen, binding the same session, token, generation, action and open state before control or archive is finalized."
proposal = "Domain 9 should use one versioned session-observation codec for the producer, storage and consumer, check generation against the authoritative restored session and agent, and prove suspend/resume/archive through the actual observation and finalization paths after reopen."
owner_domain = 9
interface = "9.rs-agentd-managed-agent-record-session-observation-j43"

