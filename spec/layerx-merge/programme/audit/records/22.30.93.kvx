[finding.human-socket-restart]
file = "services/agent/crates/layerx-agentd/src/human.rs"
line = 1644
class = "restart-recovery"
severity = "medium"
observed = "HumanUnixServer::bind refuses whenever endpoint.exists(). The server has no socket-path cleanup or owned-stale-socket recovery, and dropping UnixListener does not unlink its pathname. After shutdown or a crash, the next start rejects the prior socket before serving Human requests."
