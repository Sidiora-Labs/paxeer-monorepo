class = "runtime-risk"
severity = "medium"
observed = "decode_hex_json checks only even byte length and then slices a Rust str at offset..offset+2. An even-length malformed value such as a followed by U+00E9 followed by a crosses a UTF-8 boundary at byte 2 and panics instead of returning UnverifiedReceipt. The helper reads external simulation receipt fields and program_revert_reason at :1597 uses it on node-provided revert data."
expected = "Malformed external hexadecimal data must yield a bounded typed refusal without panicking or terminating the owner request/process, including non-ASCII and invalid-boundary text."
proposal = "Domain 9 should decode bounded ASCII byte pairs and reject any non-hex input before slicing or allocating unbounded output. Prove malformed Unicode in the actual simulation/revert response path produces ProgramOperationError and leaves the owner available."
owner_domain = 9
interface = "9.rs-agentd-programoperations-simulate-native-j70"

[finding.support-kernel-authorizations]
file = "services/agent/crates/layerx-agentd/tests/support/mod.rs"
line = 20
class = "test-gap"
severity = "medium"
observed = "The shared support imports prepare_activity_for_protocol, attach_kernel_signature and verify_kernel_before_submit and calls them at :201-203 and :292-328. It constructs a protocol-3 canonical activity and protected layerx-sequencer-authority-v1 fixture alongside newer EIP-1559 helpers. These retained fixture paths assert a different authorization shape from the live ledger-call producer."
expected = "req.22061.1 requires test authorizations to prepare and bind the ledger payment call with no encoded activity envelope; req.22059 and req.22056 require restored type-2 call-bound disclosure and signing records."
proposal = "Domain 9 should port the shared authorization, budget and expiry fixtures to real ledger EIP-1559 preparation and the live signing/receipt path, retaining all existing success and refusal assertions. Prove these fixtures through producer, transport, receipt consumer and reopen instead of maintaining a parallel kernel-envelope shape."
owner_domain = 9
interface = "9.rs-agentd-prepare-prepare-activity-for-protocol"

[finding.send-authorization-retired-shape]
file = "services/agent/crates/layerx-agentd/tests/support/send_authorization.rs"
line = 5
class = "test-gap"
severity = "medium"
observed = "sign assumes a 167-byte authorization trailer, overwrites embedded Ed25519 key/signature ranges and computes the retired SignaturePreimage over fixed slices. Its shared caller send_payload in support/mod.rs:91-143 encodes a 0x5301 envelope; signing, expiry, binding and budget tests reuse this helper. It does not produce the live EIP-1559 ledger payment authorization."
expected = "req.22061.1 requires these tests to obtain their authorizations from the real ledger call and binding path. Fixed-offset envelope repair cannot establish that the actual type-2 transaction and disclosure round-trip."
proposal = "Domain 9 should replace the helper consumers with the real typed ledger-call preparation, disclosure binding and transaction signing path, preserving the tests and all negative cases. Include a restored-preparation case so tests detect producer-shape changes rather than silently reconstructing another format."
owner_domain = 9
interface = "9.rs-agentd-prepare-prepare-activity-for-protocol"

[finding.readiness-real-path-test-gap]
file = "services/agent/crates/layerx-agentd/tests/support/real_authority.rs"
line = 54
class = "test-gap"
severity = "medium"
observed = "ReadinessNode::new requires LAYERX_TEST_PAXEER_CHAIN_ID with the message real isolated Paxeer chain id is required, but binds a local TcpListener. readiness_gate:98-106 serves eth_chainId and px_getReceiptKeys responses constructed from fixture signing seeds. restart_authority recreates only Gate against that listener. This proves client consistency with synthetic replies, not the declared real node producer, key rotation or node recovery path."
expected = "req.22045.1 and the brief require readiness and recovery to be demonstrated through the real node producer and transport. A supplied real chain-id string does not turn a fixture server into a live node proof."
proposal = "Domain 9 should retain these focused decoder checks as unit coverage and add the required real isolated-node readiness/restart path with the node-produced receipt key intervals and actual transport. Prove wrong-chain and uncovered/rotated-key refusal without replacing the producer with constructed JSON."
owner_domain = 9
interface = "9.cli-layerx-agentd"

