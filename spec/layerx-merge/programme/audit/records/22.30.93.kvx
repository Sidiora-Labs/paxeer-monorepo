proposal = "Domain 9 should establish Human readiness from eth_chainId and verified committed node evidence without requiring gateway metadata on the node URL. If a product function needs px_getNetwork, give it an explicit hosted gateway dependency. Prove startup against the real direct node interface and reject a chain-id mismatch."
owner_domain = 9
interface = "8.rpc-gateway-px-getnetwork"

[finding.history-commit-inclusion]
file = "services/agent/crates/layerx-agentd/src/protocol_evidence.rs"
line = 2478
class = "security"
severity = "high"
observed = "PolicyHistorySource::prove verifies the signed receipt and compares eth_getTransactionReceipt, pax_sequencerReceipt and block_by_number answers. For a receipt below checkpoint.height it proves neither receipt inclusion under a committed root nor the historical block commitment/ancestry. It then assigns checkpoint.block_hash to CommittedHistoryReceipt.checkpoint_hash at :2581. The authenticated cumulative/time-window consumers trust this assigned checkpoint tag, although the landing and timestamp assertions came from unproven RPC answers."
expected = "A policy decision must count outcomes and timestamps proven to belong to the committed chain at its captured checkpoint. A sequencer signature proves a receipt, not membership in a committed historical block; req.9258.1 and the brief require verified committed evidence."
proposal = "Domain 9 should bind each history outcome to a verified committed block and receipt inclusion proof with the receipt height, index, hash and block timestamp covered by that evidence. Reject a validly signed but uncommitted or foreign-block receipt, altered landing metadata and altered timestamps on the real policy-history path."
owner_domain = 9
interface = "9.rs-agentd-protocol-evidence-authenticatedcumulativeuse-j43"

[finding.history-window-completeness]
file = "services/agent/crates/layerx-agentd/src/protocol_evidence.rs"
line = 2273
class = "security"
severity = "high"
observed = "CumulativeUseWindow::authenticate_history sums only the supplied entries and accepts an empty list as zero use. HistoryWindowBatch::authenticate_history at :2335 trusts first_covered_sequence after simple bounds checks. The live producer read_policy_history in human_runtime.rs:22063-22135 stops when the RPC index reports no next cursor, without authenticating omitted items or coverage; an empty/truncated index response can understate recent spending or activity while returning authenticated usage."
expected = "Policy cumulative-use and time-window limits must cover every relevant committed outcome in the claimed window. Signed individual items and an unauthenticated end-of-pagination marker cannot establish absence or completeness."
proposal = "Domain 9 should derive usage from proof-backed committed counters or authenticated complete history ranges and carry verified coverage into the usage types. Refuse incomplete or stale index coverage and prove omitted-item, premature-end and empty-page cases through the actual history producer and policy consumer after restart."
owner_domain = 9
interface = "9.rs-agentd-protocol-evidence-cumulativeusewindow"

