[finding.rate-window-regression]
file = "services/agent/crates/layerx-agentd/src/limits/rate.rs"
line = 298
class = "runtime-risk"
severity = "medium"
observed = "RateLimiter::admit retains only the selected window for each limit. It accepts authenticated logical_time_ms without a monotonic watermark. After requests in window A and B, a delayed request for A deletes B and starts A from zero; a subsequent B request starts B from zero again. Out-of-order observations can repeatedly reset consumed capacity."
expected = "Authenticated but delayed requests must not erase consumption in newer rate windows or allow a tenant/client to exceed its declared ceiling by interleaving valid timestamps."
proposal = "Domain 9 should retain the required overlap of windows or reject observations behind a durable monotonic admission watermark, with atomic checks and increments. Prove A/B/A/B delivery and concurrent delayed requests preserve the configured ceiling and refusal metadata."
owner_domain = 9
interface = "9.rs-agentd-limits-rate-ratelimiter"

[finding.rate-counter-recovery]
file = "services/agent/crates/layerx-agentd/src/limits/rate.rs"
line = 217
class = "restart-recovery"
severity = "medium"
observed = "CounterLedger is an Arc<Mutex<CounterState>> and shared() creates an empty process-local state. There is no persistence or cross-process backend. A restarted daemon or a second daemon process cannot share the linearizable consumed counters promised by COUNTER_CONSISTENCY_MODEL at :6, and starts with fresh capacity within the same logical window."
expected = "All daemon instances serving the same tenant must use the same atomic rate counters, and reopening within a live window must preserve prior consumption rather than silently granting a new allowance."
proposal = "Domain 9 should implement the declared shared counter authority with durable atomic window updates and restore it before admitting work. Prove two real daemon instances and a stop/reopen share one ceiling under concurrent requests and preserve counter revisions."
owner_domain = 9
interface = "9.rs-agentd-limits-rate-counterledger"

[finding.quota-unbounded-observations]
file = "services/agent/crates/layerx-agentd/src/limits/quota.rs"
line = 321
class = "runtime-risk"
severity = "medium"
observed = "Quota.windows keeps one ClientWindow per tenant/client forever, with no cardinality bound or eviction. Every shed event writes a new timestamped Configuration record at :379-393 with no expiry compaction. active_decision and health scan historical Configuration IDs, so rotating client identifiers grows memory and repeated shedding grows durable state and per-request scan cost."
expected = "Tenant load protection must itself have bounded memory, durable retention and lookup cost under changing client identities and repeated pathological traffic."
proposal = "Domain 9 should bound active-client cardinality and expire idle windows, retain an indexed latest shedding decision per client and compact expired history under a defined audit-retention policy. Prove sustained client churn and repeated shed periods keep memory, storage and lookup work within declared limits."
owner_domain = 9
interface = "9.rs-agentd-limits-quota-quota"

