[finding.startup-gateway-node]
file = "services/agent/crates/layerx-agentd/src/main.rs"
line = 503
class = "interface-mismatch"
severity = "high"
observed = "connect_human_node reads HumanNodeEnvironment.rpc, whose URL is LAYERX_AGENT_NODE_RPC_URL, then requires PxEndpoint::network on that same URL before constructing SequencerEndpoint. The client method emits px_getNetwork (services/agent/crates/layerx-client/src/px.rs:124), which is produced by the hosted gateway, not the direct node endpoint. start_human_owner calls this at :755, so a correctly configured direct public node cannot satisfy startup."
