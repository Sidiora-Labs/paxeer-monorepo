expected = "Each managed projection update must be authorized by the exact owner transaction and committed effect for its tenant, agent and requested fields. An unrelated successful operation must never authorize a local limit or budget replacement."
proposal = "Domain 9 should bind the retained raw transaction, authenticated owner/agent identity and committed budget/grant state to every projected mutation before publication. Prove a genuine limit change, then refuse reuse of a same-module successful receipt for a different agent, amount or budget and retain that refusal after reopen."
owner_domain = 9
interface = "9.rs-agentd-managed-agent-finalize-limit-j43"

