interface = "9.rs-agentd-human-humanunixserver"

[finding.human-total-deadline]
file = "services/agent/crates/layerx-agentd/src/human.rs"
line = 1669
class = "runtime-risk"
severity = "medium"
observed = "HumanUnixServer::serve handles each admitted connection synchronously before accepting the next. AcceptedTransport::new sets only per-syscall read/write timeouts, and receive delegates to frame::read_frame. An admitted peer that supplies bytes within each socket timeout can stretch one frame beyond the configured deadline and monopolize this single listener."
expected = "A Human request must have one bounded elapsed deadline and bounded occupancy so a stalled admitted peer cannot indefinitely block other principals. A socket timeout reset by progress does not enforce the configured whole-request deadline."
proposal = "Domain 9 should enforce a monotonic whole-frame/request deadline and bounded concurrent admission while preserving authenticated tenant isolation. Prove a slow partial frame times out within the declared bound and that another admitted peer can still obtain service."
owner_domain = 9
interface = "9.rs-agentd-human-humanlistenerconfig"

