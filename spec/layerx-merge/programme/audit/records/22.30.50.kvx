[finding.gas-wanted-zero]
file = "node/app.go"
line = 3796
class = "interface-mismatch"
severity = "high"
observed = "checkTotalBlockGas casts Block.MaxGasWanted to uint64 and unconditionally compares totalGasWanted against it. With MaxGasWanted=0, every nonzero-gas transaction causes ProcessProposalHandler to reject a block that node/sequencer/limits.go:62 admitted and the receipt source sealed."
expected = "Requirements 22025.1 and 5020.3 make zero or negative MaxGasWanted an unset bound and require a block filled to Accept limits to pass validator proposal checks."
proposal = "In node/app.go apply the gas-wanted bound only when MaxGasWanted is positive, preserving overflow and MaxGas checks. Prove a real accepted, receipted and sealed block passes ProcessProposal with zero and negative bounds and is rejected above an explicit positive bound."
owner_domain = 5
interface = "5.go-node-app-process-proposal-handler"

[finding.giga-errors-become-empty-results]
file = "node/app.go"
line = 2354
class = "runtime-risk"
severity = "high"
observed = "ProcessTXsWithOCCGiga returns nil results with no error channel on block-cache failure or EVM/V2 scheduler failure (2354,2368,2406). ProcessTxsSynchronousGiga similarly returns nil at 2070. After an EVM-cache write, a V2 scheduler failure can retain the EVM half. ExecuteTxsConcurrently and ProcessBlock still call CompleteBlock and return success with an incomplete result vector."
