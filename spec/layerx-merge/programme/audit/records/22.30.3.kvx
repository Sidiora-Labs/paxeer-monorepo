[finding.host-bound-migration]
file = "src/protocol/lxp_kernel.c"
line = 377
class = "interface-mismatch"
severity = "high"
observed = "precompiles/layerxprograms/method_upgrade.go calls submit.go, which emits protocol-3 upgrades without Activity.Signature and passes principalOf chain-bound authority. modules/lxphost/host.go accepts that envelope and sets signature_valid and binding_authority. kernel_program_signer_binding accepts it, but lxp_kernel_bind_migration_admission unconditionally calls lxp_activity_verify_signature. Upgrades with payload byte 34 bit 0 set therefore return LXP_ERR_BAD_SIGNATURE before migration dispatch."
expected = "Migration upgrades authenticated by the chain authority accepted for Programs execution must reach admission with actor, verified key, payload hash, execution context and fee facts bound consistently across precompile, host and kernel."
proposal = "In src/protocol/lxp_kernel.c honor validated chain authority binding for bound unsigned migration envelopes while retaining actor/principal/key, payload hash, canonical activity id and execution-context checks. Preserve Ed25519 verification for native signed envelopes. Add real precompile -> host -> kernel upgrades in both modes and tampered actor/key/hash refusals."
owner_domain = 1
interface = "1.c-lxp-kernel-bind-migration-admission"

[finding.registration-refusal-mutates]
file = "src/protocol/lxp_kernel.c"
line = 2190
class = "runtime-risk"
severity = "medium"
observed = "lxp_kernel_register_module changes the active registration disabled_epoch to kernel->epoch before checking module_count against LXP_KERNEL_MAX_MODULE_REGISTRATIONS. At capacity an otherwise valid higher-version registration returns LXP_ERR_ARENA_EXHAUSTED but leaves the previous version disabled; lookup then returns LXP_ERR_MODULE_DISABLED."
expected = "A refused registration must preserve the active module and registry state so dispatch remains available after a failed upgrade attempt."
proposal = "Preflight capacity and every version/interface constraint in src/protocol/lxp_kernel.c before mutating registrations, then publish the transition atomically. Add an owning-domain full-capacity case checking refusal, unchanged registry/root and continued dispatch through the prior implementation."
owner_domain = 1
interface = "1.c-enum-lxp-kernel-max-module-registrations"

[finding.arena-base-alignment]
file = "src/protocol/lxp_arena.c"
line = 43
class = "runtime-risk"
severity = "medium"
observed = "lxp_arena_init accepts arbitrary byte-buffer addresses. lxp_arena_alloc aligns only arena->offset and returns arena->buffer + aligned. An unaligned base stays unaligned for typed _Alignof(size_t) and struct allocations used by snapshot and module context callers, despite a successful result."
expected = "Successful arena allocation must honor requested power-of-two alignment for every accepted buffer without overflowing address arithmetic or exceeding capacity."
proposal = "In src/protocol/lxp_arena.c align the checked absolute current address and include base-relative padding in overflow/capacity accounting, preserving reset zeroing. Add an allocator regression with an intentionally offset buffer and production typed alignment requests."
owner_domain = 1
interface = "1.c-lxp-arena-alloc"

[finding.legacy-genesis-guarantors]
file = "src/protocol/lxp_genesis.c"
line = 522
class = "retired-reference"
severity = "medium"
observed = "validate requires a nonzero guarantor_count and 33-byte guarantor keys for every supported manifest protocol, including state-commitment protocol 3. Lines 49-50 still name daemon and guarantor-runtime consumers; bootstrap helpers retain settlement_anchor/finalised registration requirements. The retired guarantor process has no role in the merged BFT network."
expected = "Fresh merged-network genesis should describe chain validators, kernel modules and governed state without requiring separate guarantor provisioning or independent checkpoint settlement. Historical committed encodings need an explicit compatibility boundary."
proposal = "Separate historical decoding/hash compatibility from current-network genesis validation in src/protocol/lxp_genesis.c and its header/builder paths. Remove mandatory retired-guarantor provisioning from the current bootstrap path, replace the obsolete consumer comment and prove fresh genesis and historical import separately while preserving archived hashes."
owner_domain = 1
interface = "1.c-lxp-genesis-manifest"

[finding.transfer-shape-before-dereference]
file = "src/protocol/lxp_module_ctx.c"
line = 2050
class = "runtime-risk"
severity = "medium"
observed = "emit_transfer_set traverses set->leg_count over fixed legs[LXP_MAX_TRANSFER_SET_LEGS] before downstream kernel/ledger count validation. It also dereferences source_authorities up to source_authority_count before checking pointer/count validity. A malformed module transfer can read outside the array or dereference NULL before the intended refusal."
expected = "Module transfer emission must reject malformed counts and pointer/count pairs before reading legs/authorities or taking account snapshots, with ledger validation retained."
proposal = "Validate nonzero/max leg count and source-authority pointer/count bounds at entry to emit_transfer_set in src/protocol/lxp_module_ctx.c using the declared ledger limits. Add oversized-leg and nonzero-count/NULL-authority cases checking explicit refusal and unchanged account snapshots."
owner_domain = 1
interface = "1.c-lxp-ctx-emit-monetary-transfer-set"

[finding.savepoint-overwrite-not-restored]
file = "src/protocol/lxp_module_ctx.c"
line = 2907
class = "runtime-risk"
severity = "medium"
observed = "lxp_module_savepoint_begin captures counts without before-images. stage_change overwrites an already staged key in place, while discard only restores staged_count. Consequently put(k,A), begin, put(k,B), discard leaves B. Sandbox guest rollback and budget delegated-spend paths use this API, which does not exclude keys staged before begin."
expected = "Discarding a module savepoint must restore state as it existed at begin, including updated/deleted preexisting staged entries, so failed nested work cannot survive into the enclosing commit."
proposal = "Journal before-images or use a separate post-savepoint overlay in src/protocol/lxp_module_ctx.c and its savepoint representation, covering KV and mutable blob entries. Preserve gas charging while restoring state/effects. Add nested rollback coverage updating/deleting a pre-staged key and checking the original value at commit."
owner_domain = 1

[finding.migration-fixture-zero-timestamp]
file = "tests/programs/test_lifecycle.c"
line = 1345
class = "test-gap"
severity = "medium"
observed = "migration_attempt starts receipt = {0}, calls lxp_receipt_build, signs and encodes it, then expects lxp_receipt_decode(..., true, ...) to succeed at line 1351. Build clears the receipt and does not set timestamp; no assignment intervenes. src/protocol/lxp_receipt.c rejects timestamp == 0 with LXP_ERR_NON_CANONICAL."
expected = "Migration lifecycle evidence must use the complete production receipt shape, binding execution timestamp and result/outcome facts before signing, while retaining strict decode and signature assertions."
proposal = "Use real lxp_kernel_execute_activity receipts in tests/programs/test_lifecycle.c where possible, otherwise bind all production execution facts including the nonzero timestamp before signing. Keep canonical decoding, signature verification and result/effects/root assertions intact."
owner_domain = 1
interface = "1.fmt-protocol-receipt"

[finding.migration-duplicate-retired-result]
file = "tests/programs/test_lifecycle.c"
line = 1685
class = "test-gap"
severity = "medium"
observed = "The duplicate_no_second_fee restart case expects LXP_ERR_IDEMPOTENT_REPLAY from lxp_kernel_execute_activity. Live kernel admission passes idempotency_key_exists=false and checks identity account sequences. Its sole direct LXP_ERR_IDEMPOTENT_REPLAY return is the unrelated same-epoch transition; the activity idempotency table is retired."
expected = "Restart duplicate tests must assert the current sequence refusal and still prove no second fee, unchanged accounting and no repeated upgrade. Recorded committed replay is a separate contract from resubmitting a consumed activity."
proposal = "Update tests/programs/test_lifecycle.c to submit with actual restored identity/authority/account sequence state and assert the declared sequence refusal. Preserve all balance/accounting/root checks and exercise recorded committed receipt replay independently."
owner_domain = 1
interface = "1.c-lxp-admit-activity"

