status = "stale"
notes = "dist-proposer-doc at line 12: The begin-block page promises 1% to 5% proposer rewards and derives incentives from precommits, whereas DefaultParams sets base and bonus rates to zero and the Autobahn adapter supplies empty votes."

[doc.18]
path = "sdk/x/distribution/spec/04_messages.md"
status = "stale"
notes = "dist-slash-doc at line 56: The reward pseudocode multiplies stake by F(P), defined as the fraction slashed; keeper.CalculateDelegationRewards multiplies by one minus the slash fraction. The pseudocode also replaces rather than accumulates rewards across slash periods."

[doc.19]
path = "sdk/x/distribution/spec/05_hooks.md"
status = "stale"
notes = "dist-hook-doc at line 23: The After hook description says delegation starting height is set to the previous period. initializeDelegation stores PreviousPeriod=currentPeriod-1 and Height=ctx.BlockHeight(), which are different units used by slash and same-block reward handling."

[doc.20]
path = "sdk/x/distribution/spec/06_events.md"
status = "stale"
notes = "dist-events-doc at line 14: The event page calls the proposer_reward amount attribute reward, while keeper.AllocateTokens emits sdk.AttributeKeyAmount, whose wire name is amount."

[doc.21]
path = "sdk/x/distribution/spec/07_params.md"
