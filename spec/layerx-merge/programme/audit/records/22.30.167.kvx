[finding.expedited-votes]
file = "sdk/x/gov/abci.go"
line = 54
class = "runtime-risk"
severity = "high"
observed = "EndBlocker calls Keeper.Tally before converting a failed expedited proposal to regular voting; Tally deletes every vote at sdk/x/gov/keeper/tally.go:69. The extended proposal therefore loses the votes already cast, including after a restart."
expected = "Expedited conversion must extend the proposal lifecycle without silently discarding the electorate's recorded votes."
proposal = "Preserve votes during provisional tally in sdk/x/gov/keeper/tally.go and remove them only on terminal resolution; prove conversion, restart and final regular tally using the same votes."
owner_domain = 15

[finding.slash-height]
file = "sdk/x/distribution/keeper/grpc_query.go"
line = 101
class = "interface-mismatch"
severity = "high"
observed = "ValidatorSlashes filters result.ValidatorPeriod against StartingHeight and EndingHeight. updateValidatorSlashFraction persists block height in the slash key and a separately incremented reward period in the value, so a valid block-height query can omit matching slashes or include unrelated ones."
expected = "7.qry-cosmos-distribution-v1beta1-validatorslashes-j39 accepts a block-height range; CLI, gateway and keeper must return events selected by that range."
proposal = "Decode the block height from each slash-store key in sdk/x/distribution/keeper/grpc_query.go and apply inclusive height filtering before pagination; cover heights deliberately different from reward periods."
owner_domain = 15
interface = "7.qry-cosmos-distribution-v1beta1-validatorslashes-j39"

[finding.feegrant-key]
file = "sdk/x/feegrant/key.go"
line = 48
class = "interface-mismatch"
severity = "high"
observed = "ParseAddressesFromFeeAllowanceKey starts the granter at 3+granterAddrLen instead of 3+granteeAddrLen and adds lengths through byte arithmetic. FeeAllowanceKey writes independently length-prefixed addresses, so unequal supported lengths decode incorrectly or panic in AllowancesByGranter."
expected = "The canonical fee-allowance key must round-trip both independently length-prefixed addresses for the granter listing consumer."
proposal = "Use integer offsets derived from the grantee length in sdk/x/feegrant/key.go, validate the complete two-prefix layout, and prove mixed address lengths through Keeper.AllowancesByGranter."
owner_domain = 15
interface = "15.go-x-feegrant-parse-addresses-from-fee-allowance-key-j76"

[finding.negative-chunks]
file = "sdk/x/distribution/client/cli/tx.go"
line = 58
class = "runtime-risk"
severity = "medium"
observed = "NewWithdrawAllRewardsCmd accepts a signed --max-msgs integer, and NewSplitAndApply handles zero but not negative values. With messages present, a negative chunk produces a negative slice bound and panics."
expected = "A malformed CLI limit must return a useful validation error before building withdrawal chunks."
proposal = "Reject negative chunk sizes in sdk/x/distribution/client/cli/tx.go and cover --max-msgs=-1 through the public withdrawal command."
owner_domain = 15
interface = "15.go-x-distribution-client-cli-new-split-and-apply-j76"

[finding.network-test-config]
file = "sdk/testutil/network/network_test.go"
line = 26
class = "test-gap"
severity = "medium"
observed = "SetupSuite calls network.DefaultConfig() without the *testing.T required by sdk/testutil/network/network.go:98. The norace integration suite cannot compile with the current harness."
expected = "The checked-in network liveness suite must call the actual harness constructor signature and remain executable."
proposal = "Pass s.T() to network.DefaultConfig in sdk/testutil/network/network_test.go and retain the real network height assertion."
owner_domain = 15
interface = "15.go-testutil-network-default-config-j76"

[finding.distribution-test-config]
