[file.069]
path = "sdk/x/distribution/spec/01_concepts.md"
lines = 34
verdict = "clean"
note = "The distribution 01_concepts.md reference agrees with the inspected module concepts, canonical stored records and registered message paths; no separate LayerX runtime is prescribed."

[file.070]
path = "sdk/x/distribution/spec/02_state.md"
lines = 65
verdict = "issues"
note = "dist-state-doc at line 41: The state page defines ValidatorDistInfo and DelegationDistInfo, both under prefix 0x02. The implementation instead stores outstanding rewards at 0x02 and separate historical/current/starting/slash records. Findings: dist-state-doc."

[file.071]
path = "sdk/x/distribution/spec/03_begin_block.md"
lines = 87
verdict = "issues"
note = "dist-proposer-doc at line 12: The begin-block page promises 1% to 5% proposer rewards and derives incentives from precommits, whereas DefaultParams sets base and bonus rates to zero and the Autobahn adapter supplies empty votes. Findings: dist-proposer-doc."

[file.072]
path = "sdk/x/distribution/spec/04_messages.md"
lines = 122
verdict = "issues"
note = "dist-slash-doc at line 56: The reward pseudocode multiplies stake by F(P), defined as the fraction slashed; keeper.CalculateDelegationRewards multiplies by one minus the slash fraction. The pseudocode also replaces rather than accumulates rewards across slash periods. Findings: dist-slash-doc."

[file.073]
path = "sdk/x/distribution/spec/05_hooks.md"
lines = 59
verdict = "issues"
note = "dist-hook-doc at line 23: The After hook description says delegation starting height is set to the previous period. initializeDelegation stores PreviousPeriod=currentPeriod-1 and Height=ctx.BlockHeight(), which are different units used by slash and same-block reward handling. Findings: dist-hook-doc."

[file.074]
path = "sdk/x/distribution/spec/06_events.md"
lines = 48
verdict = "issues"
note = "dist-events-doc at line 14: The event page calls the proposer_reward amount attribute reward, while keeper.AllocateTokens emits sdk.AttributeKeyAmount, whose wire name is amount. Findings: dist-events-doc."

[file.075]
path = "sdk/x/distribution/spec/07_params.md"
lines = 17
verdict = "issues"
note = "dist-params-doc at line 16: The parameter page requires strictly positive tax and proposer rates; the producer accepts zero and initializes all three to zero. The examples retain the upstream 2%, 1% and 4% rates without distinguishing them from network defaults. Findings: dist-params-doc."

[file.076]
path = "sdk/x/distribution/spec/README.md"
lines = 103
verdict = "clean"
note = "The distribution README.md reference agrees with the inspected module concepts, canonical stored records and registered message paths; no separate LayerX runtime is prescribed."

