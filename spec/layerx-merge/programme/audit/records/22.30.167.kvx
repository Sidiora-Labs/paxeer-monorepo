line = 15
class = "test-gap"
severity = "medium"
observed = "TestIntegrationTestSuite calls network.DefaultConfig() without the *testing.T argument required by its producer, preventing the norace distribution CLI suite from compiling."
expected = "Distribution CLI integration tests must construct the current network harness using its declared argument."
proposal = "Pass t to network.DefaultConfig in sdk/x/distribution/client/testutil/cli_test.go and preserve every CLI assertion."
owner_domain = 15
interface = "15.go-testutil-network-default-config-j76"

[finding.distribution-output-denom]
file = "sdk/x/distribution/client/testutil/suite.go"
line = 138
class = "test-gap"
severity = "medium"
observed = "The same query at the same height expects denomination uhpx in JSON but stake in text output (also commission, delegation rewards and community pool). The CLI prints the same protobuf data in either format and does not rename denominations."
expected = "JSON and text fixtures must describe the same chain rewards and denomination emitted by the actual producer."
proposal = "Replace stale stake expectations in sdk/x/distribution/client/testutil/suite.go with the configured bond denomination and derive numeric rewards from the real deterministic genesis and block path."
owner_domain = 15

[finding.http-helper-bounds]
file = "sdk/testutil/rest.go"
line = 18
class = "runtime-risk"
severity = "medium"
observed = "GetRequestWithHeaders creates an http.Client with no timeout, reads the entire body without a bound and closes it only after a successful io.ReadAll. A stalled server can hang the integration suite; a read error leaks the response body."
expected = "Network test helpers must return within a deadline and release response resources on success and failure."
proposal = "Use a bounded request context or client timeout and defer response-body closure immediately after Do in sdk/testutil/rest.go; bound accepted response bytes and preserve transport errors."
owner_domain = 15
interface = "15.go-testutil-get-request-with-headers-j76"

[finding.network-genesis]
file = "sdk/testutil/network/util.go"
line = 50
class = "runtime-risk"
severity = "medium"
observed = "startInProcess replaces the shared genesis validator list with only val.PubKey for each node. Config.NumValidators allows multiple validators, but their consensus genesis validator sets then disagree."
expected = "Every validator of a configured test network must start from the same validator set and canonical genesis."
proposal = "Build the complete shared validator list once in sdk/testutil/network/util.go and pass the same genesis to each node; prove block progress and identical genesis hashes with multiple validators."
owner_domain = 15

[finding.network-app-config]
file = "sdk/testutil/network/network.go"
line = 61
class = "wiring-gap"
severity = "medium"
observed = "NewAppConstructor ignores its Validator argument and encodingCfg and returns app.Setup(t,false,false,false). The advertised network configuration therefore does not reach application home, database, pruning and other per-validator startup options."
expected = "The network's AppConstructor should create an application from the validator configuration prepared by Network.New."
proposal = "Construct the application using Validator.Dir, AppConfig and the configured encoding in sdk/testutil/network/network.go, and prove a custom genesis/configuration survives application restart."
owner_domain = 15
interface = "15.go-testutil-network-app-constructor-j76"

[finding.expedited-cli-flag]
file = "sdk/x/gov/client/cli/tx.go"
line = 136
class = "wiring-gap"
severity = "medium"
observed = "NewCmdSubmitProposal advertises --is-expedited and parseSubmitProposalFlags reads FlagIsExpedited, but the command never registers a Bool flag with that name. Flag-based expedited submission fails as an unknown flag while file-based submission can carry is_expedited."
expected = "The advertised expedited flag must reach MsgSubmitProposalWithExpedite consistently with the JSON proposal field."
proposal = "Register the boolean flag in sdk/x/gov/client/cli/tx.go, reject ambiguous combinations with --proposal, and prove both entry paths emit IsExpedited=true."
owner_domain = 15
interface = "15.cli-x-gov-client-cli-submit-proposal-j76"

[finding.historical-single-vote]
file = "sdk/x/gov/client/cli/query.go"
line = 226
class = "interface-mismatch"
severity = "high"
observed = "GetCmdQueryVote returns immediately when Query.Vote reports a missing stored vote. The keeper deletes votes at final tally and returns InvalidArgument for a missing vote, so the historical QueryVoteByTxQuery branch is unreachable. Even a successful fallback decodes into vote but prints res.Vote."
expected = "15.cli-x-gov-client-cli-vote-j76 must return the recorded vote for a resolved proposal through the transaction-index consumer when live vote state has been removed."
proposal = "Choose the historical path from proposal status in sdk/x/gov/client/cli/query.go, distinguish absent data from transport failure, and print the recovered vote; prove after tally and client restart."
owner_domain = 15
interface = "15.cli-x-gov-client-cli-vote-j76"

[finding.historical-deposit-owner]
file = "sdk/x/gov/client/utils/query.go"
line = 248
class = "interface-mismatch"
severity = "high"
observed = "QueryDepositByTxQuery returns any nonzero initialDeposit before comparing its Depositor with params.Depositor. Querying a different depositor on a finished proposal therefore returns the proposer's initial deposit."
expected = "The declared single-depositor query must identify the requested depositor and preserve that identity across live-state removal and transaction-index recovery."
proposal = "In sdk/x/gov/client/utils/query.go, require the initial depositor to match the request, then aggregate all matching deposits with matching proposal IDs; prove two distinct depositors across proposal finalization."
owner_domain = 15
interface = "15.go-x-gov-client-utils-query-deposit-by-tx-query-j76"

[finding.historical-multi-message]
file = "sdk/x/gov/client/utils/query.go"
line = 66
class = "runtime-risk"
severity = "medium"
observed = "Historical deposit, vote and proposer reconstruction selects transactions by events but then accepts every message of the matching type without checking that message's proposal ID, voter or depositor. A transaction containing messages for two proposals can be relabelled as history for just one."
expected = "Transaction-wide event matches must be narrowed to the requested message identity before presenting governance history."
proposal = "Filter decoded messages by proposal and requested account in sdk/x/gov/client/utils/query.go; aggregate deposits, use the last successful vote per voter, and deduplicate transaction hashes before pagination."
owner_domain = 15
interface = "15.go-x-gov-client-utils-query-deposit-by-tx-query-j76"

[finding.historical-pagination]
file = "sdk/x/gov/client/utils/query.go"
line = 148
class = "runtime-risk"
severity = "medium"
observed = "QueryVotesByTxQuery stops when the combined result length differs from defaultLimit, even though combineEvents fetches a separate page for each of four event groups. A combined full result of 60 or 120 transactions ends pagination early; deposits fetch only one page."
expected = "Historical queries must return all requested records across independent event streams and preserve deterministic page order."
proposal = "Track pagination and exhaustion per event group in sdk/x/gov/client/utils/query.go, merge in block/transaction order, and cover mixed legacy/protobuf vote streams spanning more than one page."
owner_domain = 15
interface = "15.go-x-gov-client-utils-query-votes-by-tx-query-j76"

[finding.failed-proposal-tally]
file = "sdk/x/gov/keeper/grpc_query.go"
line = 270
class = "runtime-risk"
severity = "medium"
observed = "TallyResult reads FinalTallyResult only for StatusPassed and StatusRejected. EndBlocker also produces StatusFailed when a passing proposal's handler errors, after Tally deleted votes; querying that status recomputes an empty tally instead of returning the stored result. The legacy querier repeats the same switch."
expected = "Every terminal proposal status must expose the final tally saved when voting ended."
proposal = "Include StatusFailed in the finalized-result cases in sdk/x/gov/keeper/grpc_query.go and querier.go, and cover a proposal whose execution handler fails after a nonzero tally."
owner_domain = 15
interface = "7.qry-cosmos-gov-v1beta1-tallyresult-j39"

[finding.zero-period]
file = "sdk/x/feegrant/periodic_fee.go"
line = 102
class = "security"
severity = "medium"
observed = "PeriodicAllowance.ValidateBasic rejects only negative durations and permits Period=0. tryResetPeriod then refills PeriodCanSpend whenever blockTime reaches PeriodReset, allowing a zero-period grant to reset for each transaction rather than enforce a recurring time window."
expected = "Periodic allowance creation must require a strictly positive period so the approved per-period limit has a meaningful duration."
proposal = "Reject Period<=0 in sdk/x/feegrant/periodic_fee.go and exercise a serialized zero-duration grant through validation and fee consumption."
owner_domain = 15

[finding.filtered-remove]
file = "sdk/x/feegrant/filtered_fee.go"
line = 77
class = "interface-mismatch"
severity = "high"
observed = "AllowedMsgAllowance.Accept converts an underlying (remove=true, err=ErrFeeLimitExpired) result into (false, err). Keeper.UseGrantedFees only revokes when remove is true, so wrapping an expired BasicAllowance changes its declared removal lifecycle."
expected = "FeeAllowanceI explicitly requires the remove flag to apply regardless of error; filtering must preserve the underlying allowance's lifetime."
