proposal = "Replace or reconcile apps/launchpad/web/src/core/wallet-sdk/embedded_sdk/embedded/eip1193.ts with the maintained sdk/wallet provider's account/chain validation. Check both request and gateway response identity, capture the principal epoch across awaits, and prove mismatched-account and mismatched-chain requests never dispatch."
owner_domain = 4
interface = "12.rpc-sdk-provider-eth-send-transaction"

