file = "apps/launchpad/web/src/core/wallet-sdk/assets.ts"
line = 41
class = "runtime-risk"
severity = "medium"
observed = "assertAssetOnChain rereads ERC20 decimals on every balance/transfer check and records every read as asset.metadata for the same chain/address scope. The phase4 measurement checker rejects more than one such start per scope, so ordinary repeated USDL balance reads cannot satisfy its immutable-metadata budget."
expected = "The admitted immutable metadata budget must hold on the actual wallet path while code identity, chain and committed balance verification remain mandatory and current."
proposal = "Cache verified decimals by chain/address and reviewed runtime/deployment identity in apps/launchpad/web/src/core/wallet-sdk/assets.ts, coalesce concurrent reads and invalidate on identity changes. Preserve committed code/balance checks and prove repeated reads meet the existing measurement assertion."
owner_domain = 4

[finding.session_burst_budget]
file = "apps/launchpad/web/src/core/wallet-sdk/session.ts"
line = 42
class = "runtime-risk"
severity = "medium"
observed = "Each accountsChanged and chainChanged calls select/invalidate and emits wallet.cache_clear immediately. Two events in one 50ms burst produce two clears; primitives.test.ts explicitly expects both epoch changes. The phase4 checker permits only one clear and one refresh per burst, while only refresh is currently batched."
expected = "Every account/chain event must immediately invalidate stale signing scopes while expensive private cache cleanup and refresh meet the declared once-per-burst budget."
proposal = "Separate immediate scope invalidation from a safely coalesced cache-cleanup operation in apps/launchpad/web/src/core/wallet-sdk/session.ts, keeping old data inaccessible throughout the burst. Prove both epoch changes remain synchronous and raw measurement records at most one cleanup/refresh for the burst."
owner_domain = 4

[finding.overlapping_dialog_focus]
file = "apps/launchpad/web/src/core/app-foundation/use-dialog-focus.ts"
line = 68
class = "runtime-risk"
severity = "medium"
observed = "Every open dialog registers a document focusin containment listener and marks sibling branches inert. Opening a second sibling dialog leaves the first listener active, so it redirects focus back to the first while the second redirects it again; the dialogs can also inert each other's containers. The two-dialog test checks cleanup attributes only."
expected = "When dialogs overlap, only the topmost dialog may own active focus containment and be interactive; closing it must restore focus to the underlying dialog without leaving either container incorrectly inert."
proposal = "Introduce a shared dialog stack in apps/launchpad/web/src/core/app-foundation/use-dialog-focus.ts with topmost-only containment and correct branch ownership. Extend use-dialog-focus.test.tsx to assert focus, Tab/Shift-Tab and closure ordering for the existing overlapping-dialog scenario."
owner_domain = 4

[finding.profile_absence_growth]
file = "apps/launchpad/web/src/core/market/profile-absence.ts"
line = 40
class = "runtime-risk"
severity = "medium"
observed = "The absent-profile Set retains every missing wallet for the entire browser session, persists the complete list on each addition and hydrates an unrestricted array from sessionStorage. Long discovery/trading sessions accumulate addresses without a count or time bound, increasing retained memory and repeated serialization work indefinitely."
expected = "Session caches for unbounded public wallet discovery require explicit capacity and age bounds while preserving genuine profile absence and invalidation when a profile is published."
proposal = "Bound and age the negative entries in apps/launchpad/web/src/core/market/profile-absence.ts using an LRU/TTL policy, cap persisted input before parsing/hydrating, and test eviction plus profile-save invalidation without changing absence semantics."
owner_domain = 4

