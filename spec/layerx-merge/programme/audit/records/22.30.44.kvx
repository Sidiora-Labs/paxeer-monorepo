[finding.producer-pending-index-restart]
file = "consensus/internal/autobahn/producer/state.go"
line = 50
class = "restart-recovery"
severity = "medium"
observed = "producer.NewState resumes first and next at Avail.NextBlock but initializes blocks, evmNonces and evmTxs empty. Persisted local lane blocks can still be unexecuted when ingress starts. EvmNextPendingNonce and insertTx then fall back to the committed application nonce, forgetting already sequenced transactions and permitting a duplicate nonce or rejecting the correct following nonce until execution catches up."
expected = "After restart, pending nonce and transaction lookup behavior must account for retained local unexecuted lane payloads before new transactions are admitted. Resuming the lane counter alone does not restore the pending transaction index."
proposal = "In consensus/internal/autobahn/producer/state.go and producer/mempool.go, rebuild the pending nonce and transaction-hash index from retained local unexecuted lane payloads, or hold transaction admission behind a completed replay barrier. Prove a persisted local lane transaction survives a producer restart with the same pending nonce, hash lookup and admission of the following nonce."
owner_domain = 5
interface = "15.go-consensus-internal-autobahn-producer-new-state-j57"

[finding.nonzero-proposer-timeout]
file = "consensus/internal/consensus/state.go"
line = 934
class = "runtime-risk"
severity = "medium"
observed = "enterPropose schedules a RoundStepNewRound timeout with the current round when the local proposer must wait for LastBlockTime. handleTimeout processes that timeout by calling enterPropose with round 0. At a nonzero round the entry guard rejects round 0, so the waiting local proposer neither resumes proposal production nor installs its normal propose timeout."
expected = "A proposer delayed by the previous block timestamp must resume the same height and round when its wait expires, including standby rounds above zero."
proposal = "In consensus/internal/consensus/state.go, preserve the scheduled timeout round when resuming enterPropose. Extend the PBTS/standby-round tests with a real nonzero-round local proposer and a future LastBlockTime, and assert that the fired timeout advances that round to proposing and allows the real proposal path to proceed."
owner_domain = 5

[finding.estimated-gas-test-oracle]
file = "consensus/internal/autobahn/producer/mempool_test.go"
line = 343
class = "test-gap"
severity = "medium"
observed = "blockStats.Push increments count, sizeBytes and gasWanted but never increments gasEstimated before checking MaxGasEstimatedPerBlock. The producer normalizes estimates below 21000 or above gasWanted to gasWanted, whereas the generated small-gas fixtures do not model that normalization. The block-sealing oracle can therefore accept a result without checking the estimated-gas limit it claims to cover."
expected = "The producer test oracle must account for the same effective gas units and normalization as real CheckTx responses, with an estimated-gas limit that can independently cause block sealing."
proposal = "In consensus/internal/autobahn/producer/mempool_test.go, accumulate effective normalized estimated gas and use realistic transaction gas values. Drive the real producer with a workload where estimated gas binds before count, byte size and wanted gas, and assert both that every emitted block stays within the bound and that the next transaction causes sealing."
owner_domain = 5

[finding.catchup-vote-churn]
file = "consensus/internal/consensus/types/height_vote_set.go"
line = 127
class = "security"
severity = "medium"
observed = "HeightVoteSet.AddVote allocates prevote and precommit sets for a new catchup round and records the peer before VoteSet.AddVote verifies the vote signature. Its two-round allowance is per peer ID, and peerCatchupRounds and roundVoteSets survive until the height resets. Peer-ID churn during a stalled height can retain increasing numbers of empty vote sets even when each attempted signature is invalid."
expected = "Untrusted catchup votes must not cause retained memory to grow with cumulative peer identities at a stalled height. Per-connection admission limits alone do not bound state retained after disconnect."
proposal = "In consensus/internal/consensus/types/height_vote_set.go, enforce a global per-height catchup allocation budget and validate vote identity/signature before allocating new round state. Define safe disconnect/round retirement cleanup through consensus/reactor.go, preserving genuine catchup votes. Add a real invalid-signature and peer-churn path test that asserts retained vote-set bounds and continued valid catchup."
owner_domain = 5
interface = "15.go-consensus-internal-consensus-types-new-height-vote-set-j57"

[finding.step-latency-baseline]
file = "consensus/internal/consensus/metrics.go"
line = 259
class = "runtime-risk"
severity = "medium"
observed = "MarkStepLatency subtracts lastRecordedStepLatencyNano from the current Unix nanoseconds, but the field is initially zero. The first observation therefore adds time since the Unix epoch to a step gauge. ClearStepMetrics resets the displayed gauges at a height transition without resetting the sampling baseline, so the next sample can also include time outside the new height."
expected = "Per-height step latency must measure elapsed consensus work from an initialized sampling boundary, so startup and height changes do not produce misleading latency values for operators."
proposal = "In consensus/internal/consensus/metrics.go, initialize the timing baseline on the first sample and reset it at the same height boundary as the step gauges. Add a real metrics collection test around startup and two height transitions that asserts plausible elapsed intervals and no epoch-sized first observation."
owner_domain = 5
interface = "15.met-consensus-internal-consensus-step-latency-j57"

[finding.round-duration-origin]
