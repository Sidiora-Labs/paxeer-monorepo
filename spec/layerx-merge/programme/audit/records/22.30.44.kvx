[finding.full-qc-header-bound]
file = "consensus/internal/autobahn/autobahn.proto"
line = 141
class = "interface-mismatch"
severity = "high"
observed = "FullCommitQC.headers permits only 100 entries in the generated WireguardScan decoder, but avail.State.WaitForLaneQCs selects up to 10 blocks per lane and fullCommitQC concatenates every lane. An admitted 11-lane committee can therefore produce 110 headers. NewFullCommitQC and Verify accept that certificate; FullCommitQCPersister writes it through FullCommitQCConv, but reopening its indexed WAL invokes the bounded decoder and rejects the same bytes."
expected = "A certificate emitted by availability and accepted by certificate verification must survive transport and persistence/restart with identical finalized block headers. The committee constructor does not constrain the committee to ten lanes."
proposal = "In consensus/internal/autobahn/avail/state.go and consensus/autobahn/types/proposal.go, define and enforce a shared total certificate header budget during proposal selection and verification, consistent with consensus/internal/autobahn/autobahn.proto. Regenerate codec outputs from the agreed schema and prove an 11-lane, ten-block-per-lane workload through the real full-certificate producer, wire decoder, persister and reopened data state without dropping finalized blocks."
owner_domain = 5
interface = "15.proto-consensus-internal-autobahn-full-commit-qc-j57"

[finding.wal-proposal-receive-time]
file = "consensus/internal/consensus/wal.go"
line = 114
class = "interface-mismatch"
severity = "high"
observed = "WALMessage.toProto serializes msgInfo.Msg and PeerID but omits ReceiveTime; walFromProto restores a zero timestamp. WAL.Append adds a different envelope Time, which walFromBytes also discards. readReplayMessage passes the restored msgInfo directly to handleMsg, defaultSetProposal stores its zero ReceiveTime, and proposalIsTimely can reject a proposal that was timely before the crash, changing the recovered prevote decision."
expected = "Consensus message persistence must preserve the input used by PBTS timeliness checks so replay reconstructs the same proposal and vote decision. Private-validator double-sign protection does not reconstruct a discarded receive timestamp."
proposal = "In consensus/internal/consensus/wal.go and the owning consensus protobuf schema, persist the actual proposal receive timestamp and restore it on replay with an explicit compatibility policy for older WAL entries. Add a real timed-proposal WAL append, sync, close, reopen and catchupReplay regression that asserts the recovered PBTS result and resulting vote without weakening signature protection."
owner_domain = 5
interface = "15.go-consensus-internal-consensus-open-wal-j57"

[finding.first-batch-wal-crash]
file = "consensus/internal/autobahn/data/state.go"
line = 98
class = "restart-recovery"
severity = "medium"
observed = "DataWAL.reconcile reports corruption and requires statesync whenever CommitQCs.Next equals FirstBlock while Blocks.Next is greater. runPersist writes the first block batch and first QC batch in parallel, so a crash after the block write is durable but before the first QC write reaches disk creates exactly this state. NewDataWAL fails before the node can resume its normal recovery path."
expected = "A crash at either durability boundary of the first legitimate persistence batch should have a defined recovery path, just as the later blocks-ahead-of-QCs case is reconciled. Normal partial persistence must be distinguished from irreversible data corruption."
proposal = "In consensus/internal/autobahn/data/state.go, order certificate durability before dependent block durability or persist a shared recovery watermark that identifies an incomplete first batch. Extend data/state_test.go with a real first-batch persistence interruption and reopen test, proving safe tail reconciliation and subsequent execution without requiring operator statesync."
owner_domain = 5
interface = "15.go-consensus-internal-autobahn-data-new-data-wal-j57"

[finding.unverified-prune-anchor]
file = "consensus/internal/autobahn/avail/state.go"
line = 119
class = "restart-recovery"
severity = "medium"
observed = "loadPersistedState decodes PersistedAvailPruneAnchor and immediately filters loaded QCs and lane blocks with it. NewState then durably truncates their WALs. newInner.prune checks the road index but does not verify signatures or AppQC.GlobalNumber membership in CommitQC.GlobalRange, unlike live PushAppQC. A syntactically valid but inconsistent persisted anchor can therefore control recovery pruning."
expected = "Recovered pruning authority must satisfy the same committee, certificate and global-range invariants as live pruning before any retained data is filtered or removed. This is a local persisted-state consistency boundary, not evidence of an unauthenticated remote write."
proposal = "In consensus/internal/autobahn/avail/state.go, pass the active committee into anchor loading and verify both certificates, matching road indices and global-number range before filtering or truncating. Return an explicit invalid-anchor startup error. Prove restart rejection of inconsistent signed anchors and faithful recovery of an anchor emitted by live PushAppQC through the real persisters."
owner_domain = 5
interface = "15.proto-consensus-internal-autobahn-persisted-avail-prune-anchor-j57"

[finding.impossible-anchor-fixture]
file = "consensus/internal/autobahn/avail/inner_test.go"
line = 272
class = "test-gap"
severity = "medium"
observed = "TestNewInnerLoadedCommitQCsWithAppQC supplies an AppQC for global block 10 but constructs every CommitQC with nil lane QCs, leaving their global ranges empty. It expects newInner to accept this anchor even though the live State.PushAppQC path rejects an AppQC outside its CommitQC global range. The fixture hides the recovery validation disagreement."
expected = "Recovery fixtures must originate from certificates and finalized lane ranges the live producer can emit and accept. A fixture rejected by the live pruning API cannot demonstrate correct restoration of that API state."
proposal = "Rewrite the recovery cases in consensus/internal/autobahn/avail/inner_test.go around actual signed lane blocks and lane QCs, finalize them through availability and persist the resulting AppQC/CommitQC pair. Assert restoration of the same global range and retained queues; add a distinct negative case for the impossible anchor rather than treating it as successful recovery."
owner_domain = 5

