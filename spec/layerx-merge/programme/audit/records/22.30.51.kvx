[finding.promotion-abandons-pending]
file = "node/sequencer/standby.go"
line = 745
class = "restart-recovery"
severity = "high"
observed = "receive acknowledges cur.lastSeq after syncing records that can remain in pending while a prior height commits. TakeLease sets leader=true without draining them; applyPending exits on leader, LastSeq returns appliedSeq, and Failover returns that potentially older position."
expected = "A promoted standby must resume every durably acknowledged ACCEPT, including the tail queued behind a local commit, before exposing its new leader sequence or accepting another send."
proposal = "In node/sequencer/standby.go fence incoming replication first, then reconcile the application height and replay the complete durable tail before publishing leadership. Make Failover and Handover report a position proven equal to the acknowledged tail and test queued ACCEPTs during takeover."
owner_domain = 5
interface = "5.go-node-sequencer-standby-take-lease-j32"

[finding.seal-overtakes-accept-wal]
file = "node/sequencer/consensus_source.go"
line = 159
class = "restart-recovery"
severity = "high"
observed = "ConsensusSource.Seal locks only its own mutex and can seal after Receipter.exec.Accept changes L_open but before Accepter calls Replicator.Release for that ACCEPT. It can therefore append SEAL before the included ACCEPT; the standby reports a gap and primary replay encounters ACCEPT after closing its layer."
expected = "The WAL and replication lifecycle must contain every included ACCEPT before SEAL, so a successful execution cannot become an unreplayable tail when consensus seals concurrently with public RPC admission."
proposal = "Coordinate the admission and seal boundary in node/sequencer/consensus_source.go with Accepter so all included sends complete their WAL release before SEAL is appended. Add a real concurrent send/seal and crash-restart proof with both WALs checked for lifecycle order."
owner_domain = 5
interface = "5.go-node-sequencer-consensus-source-seal"

[finding.receipt-first-record-after-commit]
file = "node/sequencer/receipt_source.go"
line = 128
class = "interface-mismatch"
severity = "high"
observed = "Record silently ignores a first publication at height <= committed. After ACCEPT release unlocks the replicator, the commit listener can finish Driver.OnCommit and advance ReceiptSource.Committed before the accepter reaches Record, so a returned signed send has no hash lookup entry."
expected = "Requirements 5022.1 and 5090.1 require the accepted SequencerSend to remain readable before and after commit until capacity evicts it; commit cannot suppress the first insertion of a durable accepted receipt."
proposal = "In node/sequencer/receipt_source.go distinguish a never-recorded durable send from an evicted duplicate and retain first publication even when commit won the race, or serialize publication with the commit watermark. Prove concurrent acceptance/commit still returns the exact signed receipt by hash."
owner_domain = 5
interface = "5.go-node-sequencer-receipt-source-j31"

[finding.receipt-capacity-after-execution]
file = "node/sequencer/receipt_source.go"
line = 145
class = "runtime-risk"
severity = "medium"
observed = "ReceiptSource has a fixed default capacity of 65536 and panics when all entries are uncommitted. Accepter calls Record only after execution and durable ACCEPT release, and admission has no receipt-source reservation, so capacity failure happens after the transaction changed state."
expected = "A public send must be refused before execution when its receipt cannot be retained, or its durable result must remain retrievable without an RPC panic; block gas and byte limits are not a receipt-count reservation."
proposal = "Reserve receipt-source capacity before execution in node/sequencer/receipt_source.go and the Accepter path, or provide bounded durable lookup for overflow; test a full uncommitted source through the real send path and verify an explicit refusal leaves nonce and state unchanged."
owner_domain = 5
interface = "5.go-node-sequencer-receipt-source-j31"

[finding.nonce-queue-not-on-send-path]
file = "node/sequencer/node.go"
line = 149
class = "wiring-gap"
severity = "medium"
observed = "NewNode constructs NonceAdmission, but Node.Start installs n.Accepter directly in the RPC option and ConsensusSource also calls that accepter. No production caller invokes NonceAdmission.Send or Open; Driver only clears the queue's receipted set, so future nonces are refused rather than held or expired."
expected = "Requirement 5038 and the sequencer nonce contract require future nonces to wait at submitted within configured sender and total bounds, drain when the gap fills, and expire at the configured lifetime."
proposal = "In node/sequencer/node.go connect verified sender/nonce admission to the production RPC send adapter and invoke expiry on each new open block; expose held status to receipt reads and prove n+1 then n through SendAPI reaches the configured queue and drains in nonce order."
owner_domain = 5
interface = "5.go-node-sequencer-new-nonce-admission-j31"

[finding.microbatch-serialized-before-grouping]
file = "node/sequencer/receipt.go"
line = 330
class = "wiring-gap"
severity = "medium"
observed = "Receipter.Accept holds r.mu while waiting for exec.Accept to complete its microbatch window; Accepter and RPC also serialize synchronous sends above it. Only one production call can reach microBatch.join at a time, so a configured MaxCount greater than one never forms a multi-send group."
expected = "ModeMicroBatch must group concurrent public sends within its configured window while retaining deterministic pre-state, receipt order and durability; direct executor concurrency alone does not establish that behavior through RPC."
proposal = "Restructure the admission-to-receipt pipeline in node/sequencer/receipt.go with ordered group ownership and per-entry execution snapshots so concurrent sends can join a batch before receipt assembly serializes them; qualify grouping through the assembled Node and public SendAPI."
owner_domain = 5
interface = "5.go-node-sequencer-new-micro-batch"

[finding.governed-pins-not-refreshed]
