[finding.sealed-tail-restart]
file = "node/sequencer/replay.go"
line = 41
class = "restart-recovery"
severity = "high"
observed = "AppReplayer.Apply seals the executor and discards its returned Batch. If the last durable record is SEAL without COMMITTED, node_start.go:97-98 then refuses startup with WAL ends in an uncommitted sealed block; ConsensusSource has no restored pending or prepared batch."
expected = "A crash after the durable SEAL and before block commit must preserve the receipted transaction order and resume proposing or reconciling that same block, as required by 5009 and 5048."
proposal = "In node/sequencer/replay.go and node/sequencer/node_start.go restore the sealed batch into ConsensusSource and reconcile it with the committed application tip; prove restart immediately after durable SEAL reproduces every receipt and commits the block."
owner_domain = 5
