[finding.microbatch-admission]
file = "node/sequencer/microbatch.go"
line = 244
class = "runtime-risk"
severity = "high"
observed = "microBatch.execute calls deliverBatch and microRecord without sequential.admit; unlike sequential.Accept, grouped sends do not reserve tx 0 or enforce Block.MaxGas, MaxGasWanted, MaxBytes or per-domain gas and byte allowances."
expected = "Requirements 5020.1-3 and 20003.1 require every receipted transaction, in either executor mode, to fit the block and tenant allowance that validators enforce."
proposal = "In node/sequencer/microbatch.go apply the same admission accounting as the sequential path to each candidate in arrival order, retain usage only for accepted entries, and prove over-limit groups cannot receive receipts or produce validator-rejected blocks."
owner_domain = 5
interface = "5.go-node-sequencer-new-micro-batch"

[finding.replication-auth]
file = "node/sequencer/dial.go"
line = 20
class = "security"
severity = "high"
observed = "DialStandby opens plain TCP and NewNode installs that dialer directly in ReplicatorConfig. ACKs have no signature or authenticated peer identity, although ReplicatorConfig.Dial promises mutual TLS; an impersonated standby can return AckOK without persisting a send."
expected = "The declared replication transport must authenticate the configured primary and standby before accepting durable state or allowing an AckOK to release a receipt."
proposal = "Implement authenticated mutual TLS in node/sequencer/dial.go and node/sequencer/standby_role.go with pinned peer identities and configured trust roots; reject unknown peers before reading frames and prove a forged ACK cannot authorize receipt publication."
owner_domain = 5
interface = "5.go-node-sequencer-dial-standby-j31"

[finding.migration-uninitialized-cleanup]
file = "cmd/layerx-genesis/lxp_genesis_builder.c"
line = 366
class = "runtime-risk"
severity = "medium"
observed = "lxp_genesis_build_snapshot_migration allocates kernel and accounts with malloc even after signature or signer validation fails, skips their initialization on error, then reads kernel->blob_count and calls lx_account_registry_release(accounts). materialize_snapshot also releases an uninitialized accounts allocation if another allocation fails."
expected = "Invalid manifests, wrong signer keys and allocation failures must produce a deterministic refusal without reading or freeing uninitialized memory."
proposal = "In cmd/layerx-genesis/lxp_genesis_builder.c initialize ownership-bearing allocations to zero and track successful initialization before traversing blobs or releasing the registry; add invalid-signature, wrong-signer and partial-allocation cleanup cases."
owner_domain = 5
interface = "1.c-lxp-genesis-build-snapshot-migration"

[finding.legacy-genesis-registration]
file = "cmd/layerx-genesis/lxp_genesis_build_cli.c"
line = 139
class = "retired-reference"
severity = "medium"
observed = "build_artifacts still writes paxeer-registration-request.lxrr and paxeer-deployment-descriptor.lxgd from separate kernel genesis roots; parse_request requires a nonempty guarantor set for every fresh genesis."
expected = "The merged network initializes the kernel within paxd, retires guarantor provisioning and obtains finality from the committed block, without a separate checkpoint-registration deployment."
proposal = "Replace the fresh-network artifact contract in cmd/layerx-genesis/lxp_genesis_build_cli.c and its consumers with a paxd-native genesis/import bundle; keep any legacy conversion explicitly offline and versioned, and remove mandatory guarantor input from the merged-network path."
owner_domain = 5
interface = "5.cli-layerx-genesis"

[finding.custody-reconciliation-retired]
file = "cmd/layerx-genesis/lxp_reconcile.c"
line = 127
class = "retired-reference"
severity = "medium"
observed = "lxp_genesis_reconcile gates accepted balances on lxp_custody_attestation_verify and a separate finalised_state checkpoint and custody state root, using an expected Paxeer attestation public key."
expected = "The merged chain owns native bank and derived-subaccount balances; retired custody-credit and checkpoint authorities cannot establish current network balances or finality."
proposal = "In cmd/layerx-genesis/lxp_reconcile.c separate the historical offline import reader from active genesis validation; reconcile imported balances against the committed native bank snapshot and its chain proof with an explicit migration authorization."
owner_domain = 5
interface = "1.c-lxp-custody-attestation-verify"

[finding.nonce-drain-error]
file = "node/sequencer/nonce_queue.go"
line = 150
class = "runtime-risk"
severity = "medium"
observed = "NonceQueue.Drain documents stopping at the gap after an Accept refusal, but drain removes the held transaction and loops after any non-nil accept error. It discards the error and can continue if the nonce reader advanced despite that error."
expected = "A refused held send must leave a visible failure and stop draining at that nonce, especially when execution succeeded but receipt replication failed."
proposal = "In node/sequencer/nonce_queue.go stop immediately on a non-nil accept result and surface or report the held-send refusal through an explicit result/event; test receipt-publication failure and a nonce reader that has already advanced."
owner_domain = 5
interface = "5.go-node-sequencer-nonce-queue-drain"

