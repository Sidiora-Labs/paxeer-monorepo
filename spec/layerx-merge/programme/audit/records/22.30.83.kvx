[finding.merchant-chain-origin]
file = "services/platform/examples/merchant-shop/layerx.example.json"
line = 25
class = "interface-mismatch"
severity = "high"
observed = "The beta rpcUrl is https://api-mainnet-beta.paxeer.network/rpc, so the shared merchant RPC client sends requests to the removed unified RPC path."
expected = "Brief facts 2-3 require mainnet-beta chain JSON-RPC at the root origin, chain id 125, with no unified /rpc route."
proposal = "In services/platform/examples/merchant-shop/layerx.example.json set beta rpcUrl to the root chain origin and exercise the shared merchant RPC consumer against that origin."
owner_domain = 8
interface = "8.cfg-examples-merchant-shop-environments-beta-rpcurl-j41"

[finding.merchant-settlement-origin]
file = "services/platform/examples/merchant-shop/layerx.example.json"
line = 24
class = "interface-mismatch"
severity = "high"
observed = "beta settlementUrl posts /v1/settle to the public chain origin. examples/support/merchant-app.mjs SettlementAuthority expects a hosted settlement response there, while the chain exposes root JSON-RPC namespaces."
expected = "The chain origin and authenticated hosted settlement service have distinct contracts; /v1/settle must reach the gateway that returns the declared settlement state and transaction."
proposal = "Configure an authenticated hosted gateway settlementUrl independently of root chain rpcUrl in services/platform/examples/merchant-shop/layerx.example.json and exercise its actual SettlementAuthority decoder."
owner_domain = 8
interface = "8.cfg-examples-merchant-shop-environments-beta-settlementurl"

[finding.merchant-emulator-rpc]
file = "services/platform/examples/merchant-shop/layerx.example.json"
line = 8
class = "retired-reference"
severity = "medium"
observed = "The shipped emulator rpcUrl still advertises http://127.0.0.1:9402/rpc, preserving a unified RPC route in the merchant environment configuration."
expected = "Brief fact 2 retires unified /rpc references in configuration; development examples must describe the finished network consistently."
proposal = "Migrate services/platform/examples/merchant-shop/layerx.example.json and the owning emulator/shared RPC adapter together to a root JSON-RPC contract while keeping settlement routing explicit."
owner_domain = 8

[finding.custody-retired-precompiles]
file = "services/platform/hosted/core/src/lib.rs"
line = 658
class = "retired-reference"
severity = "high"
observed = "custody_latest_finalized/checkpoint call anchor 0x1014 and read_custody_profile calls custody 0x1013 getAsset(bytes32) before anchor checkpoint gating. These precompiles return retired/disabled errors after the merge."
expected = "Native bank metadata, pointer views and committed chain evidence replace retired custody/anchor. Historical req.8945.2 still names these precompiles and conflicts with current retirement and the brief."
proposal = "Migrate services/platform/hosted/core/src/lib.rs profile/asset readers to bank 0x1001, pointerview 0x100A and native committed evidence with the owning chain domains; reconcile req.8945.2 and prove actual reads."
owner_domain = 8
interface = "8.rs-core-layerx-platform-core-read-custody-profile"

[finding.core-startup-inputs]
file = "services/platform/hosted/node/deployment.yaml"
line = 317
class = "wiring-gap"
severity = "high"
observed = "core-boundary omits LAYERX_CORE_SEQUENCER_ENDPOINT and LAYERX_CORE_SEQUENCER_TRUST_ANCHOR_DER required at core/src/main.rs:315-316. bootstrap.sh:1145 only publishes identity/asset/signer socket, and generation_client does not synthesize endpoint/trust inputs."
expected = "The deployed core must start with its required authenticated RPC endpoint and trust anchor and reach chain and hosted px services using their correct contracts."
proposal = "Wire required RPC and DER trust material in services/platform/hosted/node/deployment.yaml and the bootstrap/generation contract; supply suitable chain and px gateway endpoints and verify actual container startup."
owner_domain = 8

[finding.funding-deployment-inputs]
file = "services/platform/hosted/node/deployment.yaml"
line = 317
class = "wiring-gap"
severity = "high"
observed = "core-boundary supplies neither LAYERX_CORE_CHAIN_RPC_URL nor native FUNDING_SENDER_KEY_FILE/FUNDING_SENDER_KMS_KEY_ID inputs. Its Ed25519 treasury socket cannot satisfy the secp256k1 funding sender, leaving native funding treasury_unavailable."
expected = "Req.8109 and req.21126 require native chain funding using exactly one file or KMS sender; generated legacy treasury identity does not configure a native transfer signer."
proposal = "In services/platform/hosted/node/deployment.yaml wire chain RPC and exactly one protected LAYERX_CORE_FUNDING_SENDER_KEY_FILE or LAYERX_CORE_FUNDING_SENDER_KMS_KEY_ID, including required KMS transport material; prove readiness and transfer."
owner_domain = 8
interface = "8.env-core-layerx-core-chain-rpc-url-j40"

[finding.core-replica-readiness]
file = "services/platform/hosted/core/src/main.rs"
line = 828
class = "retired-reference"
severity = "high"
observed = "readiness requires HTTP 200/404 from config.replica /v1/batches/<zero>/receipt-authority after px_network succeeds. Removing the separate authority replica leaves core permanently unready."
expected = "The merged network commits receipts in paxd and has no authority replica; readiness must reflect live native dependencies and durable journal availability."
proposal = "Replace the replica probe in services/platform/hosted/core/src/main.rs with committed-chain and writable-journal readiness, preserving explicit native funding dependency status; prove startup without a replica."
owner_domain = 8
interface = "8.http-core-get-readyz"

[finding.core-retired-relays]
file = "services/platform/hosted/core/src/main.rs"
line = 998
class = "retired-reference"
severity = "high"
observed = "relay_target forwards protocol account-state head, program account-state changes and batch receipt-authority routes to legacy node/replica HTTP listeners; no corresponding producer exists on native root JSON-RPC."
expected = "Brief facts 1-3 retire daemon/replica REST listeners; surviving consumers must read equivalent committed data through live native or hosted gateway interfaces."
proposal = "Migrate services/platform/hosted/core/src/main.rs relay/state consumers to native chain/query contracts and explicitly retire obsolete HTTP contracts with their callers, replacing forwarding to absent listeners."
owner_domain = 8
interface = "8.http-core-get-v1-state"

[finding.receipt-anchor-dependency]
file = "services/platform/hosted/core/src/main.rs"
line = 626
class = "retired-reference"
severity = "high"
observed = "await_receipt obtains an authenticated native receipt and then calls custody_checkpoint_state_root at its height; that helper calls retired anchor, making valid committed receipts fail as unavailable."
expected = "Committed native receipts are final without checkpoint authority/anchor finality; evidence must bind to their native committed block."
proposal = "Derive receipt state evidence in services/platform/hosted/core/src/main.rs from the native committed block/app hash at the landing height; remove anchor gating and prove public receipt success after anchor retirement."
owner_domain = 8
interface = "8.rs-core-layerx-platform-core-read-custody-profile"

[finding.absent-receipt-status]
file = "services/platform/hosted/core/src/main.rs"
line = 603
class = "interface-mismatch"
severity = "medium"
observed = "await_authenticated_receipt discards Lookup::Absent and Submitted until deadline then returns Err(receipt_unavailable). It never returns Ok(None), so receipt_route missing-receipt 404 handling is unreachable."
expected = "The receipt HTTP contract distinguishes authenticated absence, pending submission and dependency failure; absence must not be reported as infrastructure unavailability."
proposal = "Preserve typed absent/submitted/unavailable outcomes in services/platform/hosted/core/src/main.rs and map them to declared statuses; exercise actual lookup and route behavior for each outcome."
owner_domain = 8
interface = "8.err-core-not-found"

[finding.funding-recovery-schema]
file = "services/platform/hosted/core/src/main.rs"
line = 1817
class = "interface-mismatch"
severity = "high"
observed = "prepare_funding persists SignedFunding {raw, transaction_hash:0x-string} in fund-canonical; funding_intent_route reads the same stage as PreparedFunding {canonical, transaction_hash:32-byte-array, sender}. Live stages conflict with imports and imported stages fail native replay. Live funding also omits legacy FundingIntent archives."
expected = "Req.8109 and brief check 5 require a durable native funding identity across preparation, lost response, export/import, retention and restart, preserving the signed bytes and transaction hash."
proposal = "Unify services/platform/hosted/core/src/main.rs preparation, intent import/export and retention around one versioned native transfer schema shared with chain_fund.rs; migrate old records explicitly and prove live prepare/archive/import/restart replay."
owner_domain = 8
interface = "8.http-core-post-admin-v1-testnet-fund"

[finding.funding-wrong-network]
file = "services/platform/hosted/core/src/chain_fund.rs"
line = 111
class = "config-drift"
severity = "medium"
observed = "ChainFunding::connect accepts every nonzero eth_chainId and signs using that value. A misconfigured origin can become ready and receive a transfer on another network."
expected = "Brief fact 1 fixes EVM chain id 125; funding readiness and signing must reject an origin for a different network before spending funds."
proposal = "Require the validated deployment chain id in services/platform/hosted/core/src/chain_fund.rs before signing, bind it into durable intent validation and prove wrong-network refusal."
owner_domain = 8
interface = "8.env-core-layerx-core-chain-rpc-url-j40"

[finding.account-balance-shape]
