line = 75
class = "interface-mismatch"
severity = "high"
observed = "account copies balance only from joined.layerx. gateway/src/paxeer.rs:584-617 emits result.account and result.paxeer {address,balance,nonce,height}, without layerx, so the public account/balance response succeeds while omitting balance."
expected = "Req.181376 moves account resolution to native joined responses; public balance reads must consume the producer balance with its committed height and documented units."
proposal = "Map paxeer.balance and producer height into the public contract in services/platform/hosted/core/src/public_reads.rs with explicit units, and exercise an actual gateway response through the public balance route."
owner_domain = 8
interface = "8.rpc-gateway-px-getaccount"

[finding.proof-height-and-content]
file = "services/platform/hosted/core/src/public_reads.rs"
line = 478
class = "interface-mismatch"
severity = "high"
observed = "proof fetches a bundle at head.latest_committed_height even for earlier receipts and labels that header landing_block. Client evidence ProofBundle contains only a block and ignores address/slots; account proof has no value/inclusion path, and historical activity bytes can accompany an unrelated later header."
expected = "Evidence must bind the selected value/key to its exact committed root and receipt landing height; a current block header alone does not prove a historical activity, receipt or account."
proposal = "Coordinate services/platform/hosted/core/src/public_reads.rs with domain 9 client rpc/evidence.rs to return and verify native per-key inclusion evidence at the selected height; cover advancing head, wrong account and root disagreement."
owner_domain = 8
interface = "9.rs-client-evidence-proof-bundle"

[finding.receipt-event-authentication]
file = "services/platform/hosted/core/src/public_reads.rs"
line = 542
class = "security"
