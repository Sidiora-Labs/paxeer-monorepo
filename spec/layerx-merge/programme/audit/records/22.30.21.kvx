[finding.legacy-fold-order]
file = "services/launchpad/pnl-tracker/internal/store/positions.go"
line = 100
class = "runtime-risk"
severity = "medium"
observed = "FoldTrade serializes arrival with an advisory lock but folds each newly inserted trade immediately without checking its canonical position. The legacy position.Consumer and reconcile.Reconciler both call it. If a later buy arrives before a missed earlier sell, the later buy changes remaining cost before the sell is replayed; idempotency prevents duplicates but cannot restore the correct historical cost basis."
expected = "The legacy webhook/backfill path claims convergence and must derive PnL from canonical trade order after downtime. Arrival order is not canonical order; the production inventory pipeline is a separate path and does not repair this legacy fold."
proposal = "In services/launchpad/pnl-tracker/internal/store/positions.go retain canonical transaction/log positions and rebuild the affected position transactionally when an earlier unseen trade arrives, or route the legacy consumer through an ordered projection. Cover delayed buys/sells and mixed realtime/backfill delivery with equal final positions."
owner_domain = 4

[finding.reward-sort-scope]
file = "apps/launchpad/web/src/widgets/holder-rewards/holder-rewards-view.tsx"
line = 86
class = "runtime-risk"
severity = "medium"
observed = "HolderRewardsView sends only order.key to the server, then applies ascending or descending order locally to the pages already loaded. A header switch to ascending reverses the loaded top-ranked subset, so the smallest items in the full reward population need not appear, and the page provides no loaded-subset sorting disclosure."
expected = "A user selecting lowest-first must receive the lowest entries in the requested population, or be told clearly that the order applies only to loaded rows. Client sorting cannot invert a truncated server ranking globally."
proposal = "In apps/launchpad/web/src/widgets/holder-rewards/holder-rewards-view.tsx add loaded-row scope disclosure and counts, or extend the owner-controlled pools sort contract to request direction and restart pagination. Cover more than one server page with values below the first page range."
owner_domain = 4

