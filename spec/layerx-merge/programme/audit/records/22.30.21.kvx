[finding.emitter-caller-evidence]
file = "sdk/launchpad/protocol/coverage/correlate.go"
line = 440
class = "interface-mismatch"
severity = "high"
observed = "RPCSource.CallerAt requires tx.To() == id.Emitter and uses the outer transaction sender and selector. SidioraPool.swap calls EventEmitter.emitSwap internally (contracts/launchpad/contracts/core/SidioraPool.sol:271-273); the outer destination and selector belong to the pool or router. Correlate consequently assigns caller_evidence_unavailable and drops core_fill. The measure command constructs this RPCSource without a trace provider."
expected = "Registry rows 4.go-protocol-coverage-rpcsource-caller-at and 4.sevt-ieventemitter-swap-a234ab85 require the actual pool emitter call to reach the coverage consumer with authenticated caller and selector provenance. A valid pool swap must round-trip without losing its fill."
proposal = "In sdk/launchpad/protocol/coverage/correlate.go provide block-bound authenticated internal-call evidence, including call-frame caller, selector and log association, and wire it through coverage/cmd/measure/main.go. Support the native launchpad producer with its verified receipt evidence. Prove a real pool/router swap and a forged caller refusal without treating the EOA as the internal caller."
owner_domain = 4
interface = "4.go-protocol-coverage-rpcsource-caller-at"

[finding.reward-request-schema]
file = "services/launchpad/pnl-tracker/internal/app/app.go"
line = 791
class = "wiring-gap"
severity = "high"
observed = "Production composition opens l18.NewRuntimeLedger in runtime.Schema and exposes reward preparation, but l18.JourneyService.PrepareClaim selects and inserts l18_requests and l18_audit. Neither table is declared by the checked-in l18 schema, legacy migrations or launchpad deployment SQL. proof_launchpad_pnl_tracker_test.go creates both tables explicitly at lines 82-90. A normally provisioned schema cannot persist or replay a successful preparation."
expected = "The served 4.http-pnl-tracker-post-v2-me-rewards-prepare-claim-j29 interface and requirements 4299.1 and 21121.1 require preparation, durable idempotency and replay after reopen using the deployed schema, including its request and audit tables."
proposal = "Add owner-reviewed migrations for l18_requests and l18_audit under services/launchpad/pnl-tracker and apply them through the production schema deployment path before reward routes become ready. Preserve existing request identities during upgrades and verify claim preparation plus replay after service/database reconnect using only those migrations."
owner_domain = 4
interface = "4.http-pnl-tracker-post-v2-me-rewards-prepare-claim-j29"

[finding.reward-proof-schema]
file = "services/launchpad/pnl-tracker/internal/app/proof_launchpad_pnl_tracker_test.go"
line = 82
class = "test-gap"
severity = "medium"
observed = "TestProofLaunchpadPnlTracker provisions l18_requests and l18_audit with test-local CREATE TABLE statements before the HTTP path runs. The real contracts, HTTP and decoder steps are useful, but this setup bypasses the production provisioning gap and therefore cannot establish that an upgraded operator installation can perform the same request."
expected = "Requirement 21121.1 and brief check_7 require the real producer-to-consumer path, with production persistence and restart behavior. Setup must exercise the migration contract rather than supply a schema the deployed producer does not receive."
proposal = "In services/launchpad/pnl-tracker/internal/app/proof_launchpad_pnl_tracker_test.go provision reward tables through the production migration entry point and retain the real-chain ownership, malformed-response and reopen assertions. Add a fresh-install and existing-schema upgrade case that both prepare and replay a claim."
owner_domain = 4

[finding.holder-page-refresh]
file = "apps/launchpad/web/src/widgets/coin/holders-table.tsx"
line = 103
class = "runtime-risk"
severity = "medium"
observed = "HoldersBody stores the first readyPage for each cursor and returns current whenever that key already exists. Later successful useHolders refreshes for that cursor never replace its balance, share, coverage or nextCursor; a long-open coin page therefore continues to display the original holder snapshot."
expected = "A successful holder refresh must update displayed holder facts and pagination provenance. Brief check_4 and the holder/statistics interfaces require current source values to remain distinguishable from an old snapshot."
proposal = "In apps/launchpad/web/src/widgets/coin/holders-table.tsx replace a cached page when its revision changes and keep one consistent snapshot/cursor chain across refreshes. Reset or refetch subsequent pages when the first-page snapshot changes and cover a changed balance and cursor after refresh."
owner_domain = 4

[finding.holder-page-retry]
file = "apps/launchpad/web/src/widgets/coin/holders-table.tsx"
line = 189
class = "wiring-gap"
severity = "medium"
observed = "The LoadMore error action calls setCursor(last.nextCursor). After a failed request for that cursor, last is still the previous loaded page and the cursor state already equals last.nextCursor; clicking the retry makes no state change and never calls holders.retry."
expected = "A visible retry for a failed holder page must actually request that same page again while preserving the pages that succeeded."
proposal = "In apps/launchpad/web/src/widgets/coin/holders-table.tsx dispatch holders.retry for an error on the current page and advance the cursor only for a new page. Exercise one failed continuation followed by a successful click-driven retry."
owner_domain = 4

[finding.risk-unknown-booleans]
file = "apps/launchpad/web/src/widgets/coin/stats-audit-panel.tsx"
line = 90
class = "runtime-risk"
severity = "medium"
observed = "parseRisk converts missing, null and nonboolean hasCreatorSold/isNew fields to false, and AuditRows renders those values as green pass/No. A malformed or older risk response with a valid rating can therefore assert that a creator has not sold and the coin is not new without providing either fact."
expected = "Brief checks 1 and 4 require unknown source facts to remain unknown. The stats-workers risk producer supplies boolean fields; a missing or differently typed field must not be interpreted as an affirmative safety assessment."
proposal = "In apps/launchpad/web/src/widgets/coin/stats-audit-panel.tsx require actual booleans or retain a nullable unknown state and render the unknown icon and explanation. Add missing, null, string and valid true/false response cases against the producer shape."
