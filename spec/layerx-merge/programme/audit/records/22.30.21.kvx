[finding.trade-page-retry]
file = "apps/launchpad/web/src/widgets/coin/trades-table.tsx"
line = 26
class = "wiring-gap"
severity = "medium"
observed = "TradesLive passes an error flag to LoadMore but its action only sets trades.data.nextCursor when data exists. When a newly selected older-page query fails without data the control disappears; after a failed refetch with cached data it can advance past the failed page. There is no explicit continuation retry calling trades.refetch."
expected = "A failed older-trades request must leave loaded trades available and provide an action that retries the failed cursor before moving farther into history."
proposal = "In apps/launchpad/web/src/widgets/coin/trades-table.tsx retain the requested continuation separately from its response and expose trades.refetch on the failure control even when that query has no data. Cover initial continuation failure and cached-page refetch failure."
owner_domain = 4

