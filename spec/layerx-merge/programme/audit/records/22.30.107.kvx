[finding.audit-export-count-allocation]
file = "services/human/crates/layerx-human-service/src/audit/export.rs"
line = 120
class = "runtime-risk"
severity = "medium"
observed = "An exported u32 entry_count is passed directly to Vec::with_capacity before the bundle is shown to contain that many framed entries. A short hostile bundle with a large count can request an enormous allocation instead of returning a typed malformed-export refusal."
expected = "Malformed imported audit material must be refused within memory proportional to its bounded bytes, without an attacker-controlled allocation or process abort."
proposal = "In services/human/crates/layerx-human-service/src/audit/export.rs validate entry/evidence counts against remaining framed bytes and an explicit import budget before allocating, use fallible bounded allocation, and cover oversized counts in short bundles."
