[finding.gateway-amount-width]
file = "services/human/crates/layerx-network-gateway/src/lib.rs"
line = 844
class = "interface-mismatch"
severity = "high"
observed = "The hosted gateway's paxeer.rs::decode_coins emits exact uint256 decimal strings, as openrpc.json:1261 declares. quantity parses only u128; decode_account_balances:966, decode_account:929 and decode_assets:1011 reject valid larger bank balances, EVM balances and supplies. The recorded bank.all_balances vector already contains a valid 2^200 amount."
expected = "Every declared on-chain amount must survive the hosted producer, JSON transport and Human decoder exactly. One large denomination must not make the account's entire balance view unavailable."
proposal = "In services/human/crates/layerx-network-gateway/src/lib.rs preserve full 256-bit quantities in the public read results; convert to any narrower business amount only at a named operation boundary with an explicit refusal. Carry the producer's 2^200 and uint256-maximum vectors through the actual Human balance consumer."
owner_domain = 10
interface = "10.rs-network-gateway-quantity"

[finding.gateway-http-framing]
file = "services/human/crates/layerx-network-gateway/src/lib.rs"
line = 696
class = "interface-mismatch"
severity = "medium"
observed = "http_body checks only the status line and CRLF separator. It ignores Content-Length and Transfer-Encoding, accepting a complete JSON prefix even when the advertised body is truncated, and passes chunk framing directly to the JSON decoder."
expected = "The public http_body interface promises to refuse truncated bodies; valid HTTP framing must be consumed before the JSON-RPC envelope is interpreted."
proposal = "In services/human/crates/layerx-network-gateway/src/lib.rs use the repository's bounded HTTP framing implementation or validate an exact Content-Length and explicitly handle or refuse transfer encodings; cover truncation, conflicting lengths and chunked answers."
owner_domain = 10
interface = "10.rs-network-gateway-http-body"

[finding.gateway-endpoint-control-characters]
file = "services/human/crates/layerx-network-gateway/src/lib.rs"
line = 506
class = "security"
severity = "medium"
observed = "GatewayEndpoint::parse validates authority characters but copies the path verbatim. post:554 interpolates that path into the HTTP request line, so an endpoint containing embedded CR/LF can inject headers or another request."
expected = "An explicitly configured gateway endpoint must still be a valid HTTP URL whose path cannot alter request framing or authentication context."
proposal = "In services/human/crates/layerx-network-gateway/src/lib.rs validate the request target with the existing URL parser, rejecting control characters, whitespace and invalid escapes before storing the endpoint; exercise the parser-to-request path with hostile path text."
owner_domain = 10
interface = "10.rs-network-gateway-gateway-endpoint-parse"

[finding.gateway-total-deadline]
file = "services/human/crates/layerx-network-gateway/src/lib.rs"
line = 681
class = "runtime-risk"
severity = "medium"
observed = "exchange reads until EOF through Read::take/read_to_end. IO_TIMEOUT is a per-socket read/write timeout, so a peer sending a small fragment before each timeout can retain a Human request far beyond that timeout; DNS resolution also has no shared operation deadline."
expected = "Gateway reads must have a bounded total lifetime across resolution, connect, TLS, write and body reads so unavailable upstreams cannot retain service workers indefinitely."
proposal = "In services/human/crates/layerx-network-gateway/src/lib.rs propagate an injected monotonic deadline through the complete exchange and stop reads when its remaining budget expires; retain the byte ceiling and verify a slowly fragmented response terminates within the declared budget."
owner_domain = 10

[finding.gateway-retired-endpoint-example]
file = "services/human/crates/layerx-network-gateway/src/lib.rs"
line = 3
class = "retired-reference"
severity = "low"
observed = "The crate description still says the gateway joins two execution domains, and endpoint_parsing_admits_only_http_and_https_authorities:1063-1067 demonstrates and asserts a /rpc endpoint."
expected = "The merged network is one paxd chain with committed finality and root node RPC; examples must distinguish the hosted px_* gateway from a retired unified /rpc interface."
proposal = "Update the description and endpoint examples in services/human/crates/layerx-network-gateway/src/lib.rs to the merged chain and explicit hosted-gateway/root-node distinction; retain generic URL parsing only where a real hosted deployment requires a path."
owner_domain = 10

[finding.gateway-registry-shape-drift]
file = "services/human/crates/layerx-network-gateway/src/lib.rs"
line = 338
class = "config-drift"
severity = "medium"
observed = "The stable registry row 10.rs-network-gateway-lib-asset-l386-j46 declares asset(asset_id: [u8;32]), but AccountBalances::asset takes denom: &str. Stable row 10.rs-network-gateway-lib-status-name-limit-l34-j46 names STATUS_NAME_LIMIT, which is absent; its recorded line now defines NETWORK_ID_LIMIT. Listed adversarial.rs callers do not call this accessor."
expected = "Stable registry signatures, symbols and caller locations must identify the interface currently exported by the shared client; retired rows may remain only with their retired disposition."
proposal = "Reconcile these rows in spec/layerx-merge/interfaces.kvx to the denom-based accessor and current declarations, re-scan real callers, and retire the removed status constant through the owning Human interface update."
owner_domain = 10

[finding.asset-fixture-rejects-valid-supply]
file = "services/human/crates/layerx-network-gateway/tests/chain_assets.rs"
line = 99
class = "test-gap"
severity = "medium"
observed = "assets_decode_chain_metadata lists decimal 340282366920938463463374607431768211456 (2^128) as invalid supply, although bank metadata emits uint256 supply. Lines 126-138 also call 1024 rows the maximum despite the producer/openrpc joined limit of 16."
expected = "Producer-shaped asset tests must accept the producer's exact numeric domain and use its declared page ceiling; they must not certify a narrower artificial contract."
proposal = "In services/human/crates/layerx-network-gateway/tests/chain_assets.rs derive metadata from real hosted gateway/ABI vectors, assert exact 256-bit supply and the 16-row joined contract, and keep malformed numeric/type cases separate from valid large values."
owner_domain = 10

[finding.balance-fixture-rejects-real-producer]
file = "services/human/crates/layerx-network-gateway/tests/chain_balances.rs"
line = 75
class = "test-gap"
severity = "medium"
observed = "balances_decode_bank_coins_at_one_height copies bank.all_balances.out.response from paxeer-abi-vectors.json and explicitly expects MalformedAnswer. That producer vector contains a valid 2^200 IBC-denom balance. The separate test at 113-117 also treats 2^128 as malformed."
expected = "The real bank producer response must round-trip through decode_account_balances with every denom and exact amount retained; malformed-shape tests must not redefine valid producer data as invalid."
proposal = "Repair the boundary and then update services/human/crates/layerx-network-gateway/tests/chain_balances.rs to assert the exact recorded large balance through WalletObservation/ObservedBalances, with missing fields and out-of-domain encodings remaining refusals."
owner_domain = 10

[finding.gateway-proof-artificial-numeric-domain]
file = "services/human/crates/layerx-network-gateway/tests/proof_human_network_gateway.rs"
line = 226
class = "test-gap"
severity = "medium"
observed = "The proof calls the real decoders and production WalletObservation, but ProducerState::new only creates u128 amounts and the final assertion again rejects 2^128 supply. It therefore proves agreement between a handcrafted narrower JSON fixture and the decoder while missing the actual hosted producer's larger values."
expected = "Requirement 21052.1 and brief check 7 require current producer output to reach the actual consumer with its full numeric and error contract."
proposal = "Extend services/human/crates/layerx-network-gateway/tests/proof_human_network_gateway.rs with captured or directly generated current hosted gateway HTTP responses, including the bank 2^200 vector, exact supply and framing/refusal cases, then feed those decoder results into the existing production consumer."
owner_domain = 10

[finding.store-independent-writer-loss]
file = "services/human/crates/layerx-human-service/src/store/mod.rs"
line = 444
class = "restart-recovery"
severity = "high"
observed = "PrincipalStore::open permits independent handles to the same root without a lock. principal loads a whole-file snapshot and persist:738-743 replaces that whole file. If handles A and B load before either writes, A.put(X) followed by B.put(Y) succeeds twice but B's older snapshot deletes X, including possible journey, enrollment or audit state."
expected = "A successful durable principal mutation must survive other permitted store handles and subsequent reopen; callers must receive an explicit contention refusal rather than silently losing acknowledged rows."
proposal = "In services/human/crates/layerx-human-service/src/store/mod.rs and store/provider.rs serialize principal mutations across all open modes and processes, with a single durable ownership/transaction rule and conflict detection. Exercise two real handles writing distinct rows, then reopen and assert both rows and audit continuity."
owner_domain = 10
interface = "10.rs-human-service-store-principal-store-open"

[finding.store-new-directory-durability]
file = "services/human/crates/layerx-human-service/src/store/codec.rs"
line = 79
class = "restart-recovery"
severity = "medium"
observed = "write_atomic creates a missing principal directory, syncs the temporary file, renames it and syncs the directory itself, but never syncs its parent after directory creation. The static-tenancy path reaches this directly; unlike provider.rs:113 it does not durably publish the new principal directory entry."
expected = "The first acknowledged write for a principal must remain discoverable after a crash just as later atomic replacements do."
proposal = "In services/human/crates/layerx-human-service/src/store/codec.rs make directory creation part of the durable protocol by syncing newly created parent entries before acknowledging the first row; cover first-principal creation and recovery with the storage crash harness."
owner_domain = 10

[finding.store-principal-symlink-traversal]
file = "services/human/crates/layerx-human-service/src/store/mod.rs"
line = 482
class = "security"
severity = "medium"
observed = "verify_principals_tree uses Path::is_dir for both principals and child paths, which follows symlinks. PrincipalStore::principal then reads and writes through the child path. The static open mode can accept a principal-named symlink to another principal's directory or outside the store; provider binding checks do not protect that static mode."
expected = "Principal-scoped reads and writes must remain beneath the authenticated store root and must reject symlink aliases before opening principal state."
proposal = "In services/human/crates/layerx-human-service/src/store/mod.rs use no-follow descriptor-relative directory/file opens and ownership/link validation for both static and provider modes, and test principal aliases and parent replacement without exposing another principal's rows."
owner_domain = 10

[finding.notification-preferences-expire]
file = "services/human/crates/layerx-human-service/src/notify/mod.rs"
line = 154
class = "restart-recovery"
severity = "medium"
observed = "update_preferences stores notify_preferences as an ordinary unpinned Table::Notifications row. RetentionPolicy::period and PrincipalState::expire remove it after the notification period; preferences:140 then returns Summary with every channel/class enabled, silently resetting saved opt-outs and detail settings."
expected = "A user's saved delivery and privacy choices must persist until explicitly changed; routine notification retention must not re-enable disabled channels."
proposal = "In services/human/crates/layerx-human-service/src/notify/mod.rs and store/retention.rs separate durable preference state from expiring event history, migrate existing choices, and assert opt-outs/detail settings survive a retention sweep and store reopen."
owner_domain = 10
interface = "10.rs-human-service-notify-dispatcher-update-preferences"

[finding.notification-read-state-expires]
file = "services/human/crates/layerx-human-service/src/notify/links.rs"
line = 347
class = "restart-recovery"
severity = "medium"
observed = "DeepLinks::mark_read stores an unpinned notify_read_ marker in Table::Notifications. Dispatcher audit evidence permanently pins the corresponding delivery and batch, but retention deletes the read marker; read_state:492 then reports false and old notifications become unread again."
expected = "A retained notification's read status must survive retention and restart for at least as long as that notification remains visible."
proposal = "In services/human/crates/layerx-human-service/src/notify/links.rs and store/retention.rs retain read state alongside the delivery lifecycle, and verify mark-read, sweep, reopen and inventory preserve unread counts without modifying immutable audit evidence."
owner_domain = 10
interface = "10.rs-human-service-notify-links-deep-links-mark-read"

[finding.audit-export-authentication-anchor]
file = "services/human/crates/layerx-human-service/src/audit/export.rs"
line = 117
class = "security"
severity = "medium"
observed = "verify_export takes the expected ChainHead from the same untrusted bundle whose entries it verifies. An attacker can replace the entire principal/head/entry/evidence set with a different self-consistent chain, despite the function comment claiming verification without any trust in the producer."
expected = "Audit export verification must distinguish internal consistency from authenticity and completeness against an independently retained principal and chain-head commitment."
proposal = "In services/human/crates/layerx-human-service/src/audit/export.rs expose an anchored verification entry point requiring the independently authenticated principal/head, compare it before acceptance, and clearly label the existing unanchored report as consistency-only."
