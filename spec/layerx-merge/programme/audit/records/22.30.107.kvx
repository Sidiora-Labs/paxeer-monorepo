[finding.native-approval-clock-units]
file = "services/human/crates/layerx-human-service/tests/native_journey_approval.rs"
line = 187
class = "test-gap"
severity = "medium"
observed = "clock() multiplies the checkpoint timestamp in seconds by 1000 and returns milliseconds. Callers pass that value as now to native_send::load_access, whose HumanOwnerSessionV1::validate multiplies now by 1000 again before comparing expires_at_ms. Valid consent therefore appears expired; the approval test's expiry wait also multiplies twice."
expected = "Producer-derived time must retain explicit units: Human session APIs take seconds and protocol purpose expiry takes milliseconds, with exactly one checked conversion."
proposal = "In services/human/crates/layerx-human-service/tests/native_journey_approval.rs return named seconds/milliseconds values and pass each to the matching API; verify a current real consent is usable before its actual expiry and refused after it, keeping the existing genuine producer fixture and bounded wait."
