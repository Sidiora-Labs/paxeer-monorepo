[finding.11]
file = "services/platform/hosted/webhooks/src/hosted.rs"
line = 1808
class = "runtime-risk"
severity = "medium"
observed = "decode_cursor checks the cursor body byte length is 48, then slices value[..16] without checking ASCII or a UTF-8 boundary. http.rs accepts raw UTF-8 request targets, so an authenticated cursor with a multibyte character crossing byte 16 panics its request worker instead of returning InvalidCursor."
expected = "Every malformed cursor must produce a bounded InvalidCursor response without a panic, including non-ASCII bytes and invalid hexadecimal digits."
proposal = "Validate the entire cursor body as ASCII hexadecimal before slicing in hosted/webhooks/src/hosted.rs, retain constant-time tag comparison, and exercise the real cursor route with a 48-byte body crossing the slice boundary."
owner_domain = 8

[finding.12]
file = "services/platform/hosted/webhooks/src/endpoints.rs"
line = 46
class = "config-drift"
severity = "medium"
observed = "RetryPolicy::validate accepts any nonzero u32 maximum_attempts, but hosted.rs caps stored attempt history at MAX_ATTEMPTS=32. With maximum_attempts above 32, settle rejects the next attempt as CorruptStore and leaves the delivery in flight rather than reaching its configured terminal state."
expected = "The accepted retry configuration must be representable by the durable attempt history and must terminate with delivered or dead-lettered state under its declared maximum."
proposal = "Use one documented attempt bound for RetryPolicy, environment parsing and durable history in hosted/webhooks; reject unsupported configuration at startup and prove the maximum accepted policy completes its final attempt."
owner_domain = 8
interface = "8.cfg-webhooks-retrypolicy-maximum-attempts"

[finding.13]
file = "services/platform/hosted/webhooks/src/hosted.rs"
line = 1133
class = "runtime-risk"
severity = "medium"
observed = "dispatch reuses a single caller-supplied now across its whole serial budget. prepare stamps every later lease and signature with that old time, and settle schedules retries from it. A slow budget can issue an already-expired lease or a signature older than the receiver's 300-second tolerance."
expected = "Each delivery attempt must use a fresh clock for lease creation and signing, and retry timing must be measured from actual settlement so multi-instance recovery does not reclaim live work early."
proposal = "Refresh time at each prepare, signing and settlement boundary in hosted/webhooks/src/hosted.rs, retain deterministic policy calculations, and exercise a slow multi-attempt dispatch with a second worker and the published receiver tolerance."
owner_domain = 8

[finding.14]
file = "services/platform/hosted/webhooks/src/main.rs"
line = 688
class = "runtime-risk"
severity = "medium"
observed = "The background loop discards dispatch and prune_all errors. Readiness checks dependency connectivity but carries no worker failure or shard health, so a corrupt or failing principal can halt each sweep while the service continues to report ready with no diagnostic for the stuck deliveries."
expected = "Persistent delivery and retention failures must be observable and recoverable, and one failing principal must not silently prevent healthy tenants from progressing."
proposal = "Report structured bounded worker failures and affected principals from hosted/webhooks/src/main.rs, retain per-principal failure state for readiness and operator recovery, and continue healthy tenant work without suppressing corrupt-store failures."
