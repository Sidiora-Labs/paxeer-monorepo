[finding.1]
file = "services/platform/hosted/webhooks/src/trusted.rs"
line = 183
class = "interface-mismatch"
severity = "high"
observed = "AuthorityResponse denies unknown fields and omits receipt and protocol_network_id. The real authority response in services/platform/hosted/authority/src/main.rs:820-835 always emits both, so ReceiptVerifier::verify rejects a successful producer response as VerificationRequired."
expected = "The authority's internal activity route must round-trip its complete declared response through the webhook receipt verifier while preserving activity, network, wire-version and evidence checks."
proposal = "Align the explicit response types in hosted/authority and hosted/webhooks/src/trusted.rs, validate the receipt and protocol network fields, and prove the authority HTTP response reaches the real verifier without weakening unknown-field refusal."
owner_domain = 8
interface = "8.http-authority-any-internal-v1-activities"

[finding.2]
file = "services/platform/hosted/webhooks/src/hosted.rs"
line = 854
class = "interface-mismatch"
severity = "high"
observed = "register accepts a 128-byte public idempotency key but prefixes it with 74 bytes of register and principal scope; rotate_key adds 110 bytes for a generated 37-byte endpoint. boundary.rs:331 and internal/src/kms.rs:505 accept at most 128 bytes, so registration keys over 54 bytes and rotation keys over 18 bytes fail before key creation."
expected = "Every accepted endpoint registration or key rotation idempotency key must remain valid across the outbound client and KMS create-key route, preserving principal and operation isolation."
proposal = "Encode the operation, principal, endpoint and public key into a domain-separated fixed-length digest in hosted/webhooks/src/hosted.rs; keep KMS limits intact and prove stable repeat registration and rotation with 64-byte and 128-byte public keys."
owner_domain = 8
interface = "8.http-internal-post-v1-signing-keys"

[finding.3]
file = "services/platform/hosted/webhooks/deployment.yaml"
line = 15
class = "interface-mismatch"
severity = "high"
observed = "LAYERX_WEBHOOKS_NETWORK_ID is testnet, while node/deployment.yaml:6 and :366 configure the receipt authority network name as layerx-testnet. trusted.rs:696 compares these names exactly, so valid authority evidence is refused independently of the response decoding defect."
expected = "The deployed webhook verifier and authority must use the same configured network name and refuse evidence from a different network."
proposal = "Source the webhook network name from the same authoritative configuration as hosted/node/deployment.yaml, use the merged deployment's network identity, and prove one successful receipt and one foreign-network refusal across the deployed adapters."
owner_domain = 8
interface = "8.env-webhooks-layerx-webhooks-network-id"

[finding.4]
file = "services/platform/hosted/webhooks/src/main.rs"
line = 231
class = "wiring-gap"
severity = "high"
observed = "The running binary constructs HostedService and TrustedSources, but never opens MarketOutbox or calls admit, pending, acknowledge or resume. Searches of services, tools, programs and SDK Rust sources find MarketOutbox consumers only in ai_finalized_delivery.rs; the durable finalized AI-market path has no production bridge."
expected = "Finalized AI-market captures must reach subscribed tenants through the running authenticated webhook service, retain pending work across restart and acknowledge it only after the delivery handoff succeeds."
proposal = "Wire the real AI-market capture producer to MarketOutbox under the private producer role, drain its durable rows into hosted delivery, expose tenant-authorized resume and revocation, and restart the actual service between capture and delivery to prove recovery."
owner_domain = 8
interface = "13.rs-aim-queries-snapshotbinding"

[finding.5]
file = "services/platform/hosted/webhooks/src/ai_market.rs"
line = 1330
class = "restart-recovery"
severity = "high"
observed = "apply_once invokes effect(event) before recording Applied and before Store::transact calls commit. A process crash, serialization failure or disk failure after an external effect leaves no durable deduplication record, so replay after reopen can repeat the effect despite the exactly-once API claim."
expected = "The receiver's business effect and deduplication state must commit atomically, or the effect must have a durable event-id idempotency and recovery protocol that survives failure at every boundary."
proposal = "Change MarketConsumer in hosted/webhooks/src/ai_market.rs to transact the effect's durable state with its sequence ledger, or persist an intent and reconcile an idempotent destination keyed by event id; prove crash and disk-failure recovery with an observable durable effect."
owner_domain = 8

[finding.6]
file = "sdk/chainflow/python/src/chainflow_data_gateway/_client.py"
line = 220
class = "interface-mismatch"
severity = "high"
observed = "Both auth_headers implementations merge RestApiKey then WsMintKey under the same X-API-Key name for every operation. Supplying both keys sends the mint key on REST reads; supplying only the REST key sends it to gateway.create_web_socket_token. Resource methods do not select operation-specific security."
expected = "The generated contract and README distinguish REST X-API-Key from the separate WS mint key accepted by POST /auth/ws-token; each operation must send only its declared credential."
proposal = "Correct the Scalar authentication generation feeding sdk/chainflow/python/_client.py and resources so each operation selects its declared scheme, then prove REST reads and WS token minting with distinct keys through the real service contract."
owner_domain = 15
interface = "15.go-chainflow-python-gateway-resource-j76"

[finding.7]
file = "sdk/chainflow/python/src/chainflow_data_gateway/_client.py"
line = 120
class = "runtime-risk"
severity = "medium"
observed = "The sync and async constructors raise when rest_api_key is absent before considering a supplied ws_token or ws_mint_key. A browser-facing or token-only WebSocket integration must supply an unrelated REST secret merely to construct this client."
expected = "An application holding an opaque scope-bound WebSocket token should be able to construct the WebSocket client without also receiving server-side REST or mint credentials."
proposal = "Generate credential validation per operation in sdk/chainflow/python/src/chainflow_data_gateway/_client.py; allow token-only and mint-only clients, reject missing credentials at the protected operation, and document the supported construction modes."
owner_domain = 15
interface = "15.go-chainflow-python-web-sockets-resource-j76"

[finding.8]
file = "sdk/chainflow/python/src/chainflow_data_gateway/resources/web_sockets/ws.py"
line = 589
class = "security"
severity = "medium"
observed = "The sync connection manager logs the full URL after adding the secret token query parameter; the async manager repeats it at line 743. Enabling SDK debug logging therefore writes a still-valid 300-second scope-bound credential to application logs."
expected = "The WS token contract says the returned credential is secret and must never be logged, including during connection establishment, reconnect diagnostics or failure handling."
proposal = "Redact authentication query values before logging connection URLs in sdk/chainflow/python/resources/web_sockets/ws.py and its generator; retain endpoint and scope diagnostics and assert that logs from token-authenticated connections contain no credential."
owner_domain = 15
interface = "15.go-chainflow-python-web-sockets-resource-connection-manager-j76"

[finding.9]
file = "sdk/chainflow/python/src/chainflow_data_gateway/_client.py"
line = 227
class = "security"
severity = "medium"
