line = 181
class = "runtime-risk"
severity = "medium"
observed = "LoadChainConfig uses decoder.More() after decoding a top-level object. More only checks for an enclosing array/object terminator, so a trailing closing brace or bracket is treated as end-of-input and the invalid governance input is accepted."
expected = "The legacy loader promises to reject anything after the document, and the canonical chainconfig loader requires the next Decode to return io.EOF. Both proposal inputs must reject malformed or concatenated JSON consistently."
