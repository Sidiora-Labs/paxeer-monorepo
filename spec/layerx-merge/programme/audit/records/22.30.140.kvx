line = 30
class = "test-gap"
severity = "medium"
observed = "writeFeeTokenFields builds expected protobuf bytes in JavaScript, and the round-trip tests encode/decode with the same SDK codecs. They never decode a Params payload emitted by the maintained Go module or return an SDK-encoded message to that module."
expected = "Req 14028 requires the declared fields to agree with the node producer. Local codec self-consistency and hand-written wire expectations do not establish a cross-language producer-to-consumer round trip."
proposal = "Extend sdk/js/test/evm-params-encoding.test.cjs with a bounded integration using the actual Go Params codec and module query response, covering all current fields in both directions and preserving existing safe-integer refusal assertions."
