[finding.history-cache-publication]
file = "services/explorer/backend/apps/explorer/lib/explorer/market/market_history_cache.ex"
line = 51
class = "runtime-risk"
severity = "medium"
observed = "update_cache publishes :last_update before :history using two independent ConCache.put calls. A concurrent first fetch can observe a fresh timestamp and a nil history, then call Enum.filter on nil; an existing cache can expose old history as freshly updated."
expected = "A cached market history and its freshness timestamp must be observed as one consistent value, including the first concurrent requests after startup or cache expiry."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/market/market_history_cache.ex publish timestamp and history as one cache entry or use an atomic per-key update. Exercise concurrent first reads and expiry while preserving the last complete history."
owner_domain = 14
interface = "14.cfg-explorer-explorer-market-markethistorycache"

