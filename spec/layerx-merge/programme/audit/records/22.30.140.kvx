[finding.bridge-output-recovery]
file = "services/bridge/deploy/proposals/proposals.go"
line = 715
class = "restart-recovery"
severity = "medium"
observed = "Run publishes bundle.Write before WriteProposals and writeAtomically; a later output failure leaves a nonempty bodies directory, and rerunning with the same arguments is refused by requireEmpty."
expected = "The command promises that a refused run writes nothing and operators need a recoverable complete set of governance bodies, proposals and readback expectations."
proposal = "Stage all requested outputs before publishing them in services/bridge/deploy/proposals/proposals.go, or persist a manifest that permits an interrupted generation to resume and verify identical existing outputs."
owner_domain = 14
interface = "14.go-bridge-proposals-run-j55"

[finding.blob-gas-units]
file = "apps/explorer/ui/block/details/BlockDetailsBlobInfo.tsx"
line = 78
class = "runtime-risk"
severity = "medium"
observed = "Excess blob gas is rendered through GasPriceValue, converting a gas counter into a price in gwei; BlockDetailsBlobInfo.spec.tsx expects 0.079429632 for the counter."
expected = "excess_blob_gas is the running count of gas above the target, whereas blob_gas_price is a price per unit and alone needs a currency conversion."
proposal = "Render excess_blob_gas as an integer gas count in apps/explorer/ui/block/details/BlockDetailsBlobInfo.tsx and update the accompanying assertion using a block response from the backend."
owner_domain = 14

[finding.blob-gas-test]
file = "apps/explorer/ui/block/details/BlockDetailsBlobInfo.spec.tsx"
line = 38
class = "test-gap"
severity = "medium"
observed = "The fourth blob value is asserted to contain 0.079429632, endorsing the price formatter's conversion of the excess_blob_gas count."
expected = "The explorer must display excess blob gas in gas units, with its value matching the backend block field without a wei-to-gwei conversion."
proposal = "Assert the backend-emitted integer excess gas count and its unit in apps/explorer/ui/block/details/BlockDetailsBlobInfo.spec.tsx after correcting the associated display component."
owner_domain = 14

[finding.rpc-cache-domain]
file = "apps/explorer/ui/block/useBlockQuery.tsx"
line = 55
class = "config-drift"
severity = "medium"
observed = "The API block cache includes multichainContext.chain.id, but RPC latest and block query keys omit the chain and the fallback calls the singleton publicClient."
expected = "A sub-chain or multichain block request must retain its selected chain throughout fallback and cache lookup; equal heights are not network-wide identities."
proposal = "Resolve the RPC client from the selected chain in apps/explorer/ui/block/useBlockQuery.tsx and include that chain in both RPC query keys, with coverage for switching chains during API failure."
owner_domain = 14
interface = "14.cfg-fe-chain-rpcurls"

