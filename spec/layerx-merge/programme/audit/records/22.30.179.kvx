expected = "Brief check 7 requires fixtures and assertions to agree with the actual producer's hash/error shapes and requires a test on the real sender-to-node path."
proposal = "In tools/loadtest/sender/sender_test.go, preserve distribution assertions and add actual node-backed submission and receipt coverage using signed transactions and their exact hashes, including HTTP-200 JSON-RPC rejection, malformed response refusal and tracking saturation."
