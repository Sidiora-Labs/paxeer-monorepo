[finding.signal-exit-cancellation]
file = "tools/loadtest/main.go"
line = 325
class = "runtime-risk"
severity = "medium"
observed = "On the documented Ctrl+C shutdown the main service callback returns nil, then service.Run cancels background sender/logger/dispatcher loops. Those loops return context.Canceled and errgroup propagates it; errors.Join returns that cancellation even when all performance bounds pass."
expected = "The documented graceful stop of a successful load run must return success while preserving real worker, report and performance failures."
proposal = "In tools/loadtest/main.go and utils/service/start.go, distinguish intentional signal-driven scope cancellation from an operational failure, drain the sender before final stats, and prove actual process exit codes for successful, regressed and failed runs stopped by signal."
owner_domain = 16

[finding.metrics-server-lifecycle]
file = "tools/loadtest/main.go"
line = 354
class = "runtime-risk"
severity = "medium"
observed = "exportPrometheusMetrics returns nil before binding the listener; an address-in-use error is only logged inside a goroutine. It uses the global DefaultServeMux and never shuts down its HTTP server, so repeated in-process CLI runs can panic on duplicate /metrics registration or retain the listener."
expected = "The declared /metrics route must have observable bind/readiness failure and a lifecycle owned by the run context, including shutdown and a subsequent run."
proposal = "In tools/loadtest/main.go, create a private mux/server, bind synchronously, return startup/serve errors through the service scope and shut down with the run context; cover a real occupied port and a clean restart."
owner_domain = 16
interface = "16.http-paxload-loadtest-main-metrics"

[finding.worker-metrics-stale-pointer]
file = "tools/loadtest/sender/metrics.go"
line = 69
class = "restart-recovery"
severity = "medium"
observed = "The global worker observer keys only by workerID and chainID and keeps the first pointer forever. A subsequent run or replacement worker with the same key cannot replace it, so queue metrics continue reading the previous worker and its endpoint; registrations are never removed."
expected = "Worker queue metrics must describe the active run and endpoint and release old workers when a run ends or restarts."
proposal = "In tools/loadtest/sender/metrics.go, scope observer registrations to a sender/run, include endpoint identity where necessary, replace/unregister on lifecycle changes and prove a second run exposes only its own live queue."
owner_domain = 16

[finding.block-subscription-recovery]
file = "tools/loadtest/stats/block_collector.go"
line = 67
class = "restart-recovery"
severity = "medium"
observed = "BlockCollector.Run opens one WebSocket subscription and returns its first error, canceling the load scope. It has no reconnect, committed-height backfill or duplicate-header filter, so a transient node restart ends block evidence and cannot resume the measured interval."
expected = "Brief checks 1 and 5 require node restart/recovery behavior to be defined for stateful observations, with explicit evidence gaps and no duplicate or missing committed blocks hidden in a final report."
proposal = "In tools/loadtest/stats/block_collector.go, track the last observed committed height, reconnect with bounded backoff and backfill via the actual node, deduplicate heights/hashes and expose unrecoverable gaps as a failed/incomplete run."
owner_domain = 16

[finding.block-statistics-semantics]
file = "tools/loadtest/stats/block_collector.go"
line = 110
class = "runtime-risk"
severity = "medium"
observed = "The reported block-time distributions use local header arrival times instead of committed header timestamps, and arrays described as cumulative retain only the last 1000 samples. Delivery bursts or a long run can therefore change the final SLO result independently of actual block production."
expected = "Block production latency and subscriber delivery latency must have distinct names, and cumulative final summaries must cover the declared measurement period or state their sampling window."
proposal = "In tools/loadtest/stats/block_collector.go and logger.go, calculate chain block intervals from ordered committed headers, expose delivery lag separately, and maintain full-run aggregates or label rolling samples explicitly in reports and ramper inputs."
owner_domain = 16

[finding.ramper-stalled-chain]
file = "tools/loadtest/sender/ramper.go"
line = 94
class = "runtime-risk"
severity = "medium"
observed = "The SLO watcher checks only whether the observed p90 exceeds one second. A collector with no blocks returns zero; when the chain stalls or the observation window is empty, the ramper treats the absence of committed progress as healthy and continues increasing load."
expected = "A throughput ceiling must require enough fresh committed-block observations and must stop on lack of progress, rather than passing an empty distribution."
proposal = "In tools/loadtest/sender/ramper.go and the BlockStatsProvider contract, include sample count and last committed progress, impose a bounded no-progress deadline and pause/fail ramping until sufficient fresh evidence exists."
owner_domain = 16

[finding.ramper-tests-live-path]
file = "tools/loadtest/sender/ramper_test.go"
line = 75
class = "test-gap"
severity = "medium"
observed = "Ramper progression/SLO tests supply MockBlockStats rather than real committed node headers. They do not prove the empty-window, stalled-node or WebSocket-restart behavior that determines the reported highest passing TPS."
expected = "Brief check 7 requires the actual block producer, subscription transport, collector and ramper consumer to be exercised before a claimed throughput ceiling is accepted."
proposal = "In tools/loadtest/sender/ramper_test.go and stats block-collector coverage, retain curve/unit assertions and add a real node-backed path proving progress, SLO breach, stalled evidence and restart recovery without replacing producer headers with a third shape."
owner_domain = 16

[finding.user-latency-unrelated-transactions]
file = "tools/loadtest/stats/user_latency_tracker.go"
line = 73
class = "runtime-risk"
severity = "medium"
observed = "UserLatencyTracker treats every positive transaction value in the latest block as a Unix send timestamp. It does not restrict hashes/senders to this workload, truncates arbitrary big.Int values through Int64 and may sample the same latest block repeatedly; ordinary payments can become meaningless latency observations."
expected = "Latency evidence must correlate each generated transaction with its actual committed receipt/block and use a bounded explicit send timestamp from this run."
proposal = "In tools/loadtest/stats/user_latency_tracker.go, correlate by generated transaction hash and retained send time, consume each committed block once, exclude unrelated traffic and report missing receipts/samples explicitly; prove mixed workload and ordinary user payments together."
owner_domain = 16

[finding.loadtest-toolchain-image]
file = "tools/loadtest/Dockerfile"
line = 1
class = "config-drift"
severity = "medium"
observed = "The loadtest builder is pinned to golang:1.24.5-bullseye while its module requires Go 1.25.0 and the repository requirement pins build images to 1.25.8. Default auto-toolchain downloading can hide the mismatch and makes the image's actual compiler differ from its visible pin."
expected = "Requirement 18929.1 requires every literal Go build-image pin to name 1.25.8, with compilation performed by the declared toolchain."
proposal = "In tools/loadtest/Dockerfile, use the repository's pinned 1.25.8 builder and its reproducible image policy, verify the actual compiler identity in the image build, and keep the nested module language directive unchanged unless separately required."
