[finding.binding-tool-provenance]
file = "tools/loadtest/Makefile"
line = 122
class = "config-drift"
severity = "medium"
observed = "install-tools installs abigen@latest, setup-node executes a downloaded nvm shell script and fetches solc into shared /tmp without a checksum, and build-cli runs go mod tidy before building. The advertised regeneration/build workflow can change bindings/dependencies as upstream tool versions or inputs move."
expected = "A repeatable pre-upgrade load generator must bind compiler/generator versions and fetched executable bytes and must not change the dependency graph as an implicit normal build action."
proposal = "In tools/loadtest/Makefile, pin abigen to the reviewed go-ethereum version and solc to verified release bytes in a private tool directory, separate tidy from build, and record tool versions with regenerated binding artifacts; retain normal build failures instead of silently downloading replacements."
