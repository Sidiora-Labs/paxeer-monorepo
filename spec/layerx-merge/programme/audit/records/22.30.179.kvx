observed = "Each worker busy-spins with continue while the shared rate limiter denies a token. At low TPS or during the ramper recovery interval, many idle worker goroutines consume CPU and distort the same node/load-generator measurements being reported."
expected = "A rate-limited load generator must wait cancellably for capacity and spend resources on the configured workload rather than on unbounded polling."
proposal = "In tools/loadtest/sender/worker.go, use the limiter's context-aware wait/reservation path and preserve cancellation and queue ordering; measure behavior at low rates and recovery intervals with actual workers."
owner_domain = 16

[finding.failed-attempt-throughput]
file = "tools/loadtest/stats/collector.go"
line = 87
class = "runtime-risk"
severity = "medium"
observed = "RecordTransaction increments scenario/total counts and TPS for every attempt, even success=false, but records percentile latency only on success. Logger.BuildFinalStats derives bounds inputs from those attempt totals; a run of transport failures can meet minTPS/minTotalTxs and report a zero p99."
expected = "Qualification output must distinguish attempted, accepted and committed traffic and must not describe missing successful samples as zero-latency throughput evidence."
proposal = "In tools/loadtest/stats/collector.go, logger.go and bounds.go, carry explicit outcome counts through the report and use its existing sample_count, define which success level each bound measures, and refuse insufficient evidence for enabled success/latency bounds; prove node rejections and connection failures through the real sender."
owner_domain = 16

[finding.latency-bound-no-evidence]
file = "tools/loadtest/stats/bounds.go"
line = 37
class = "runtime-risk"
severity = "medium"
observed = "Bounds.Check iterates only the endpoint map it receives and accepts zero p99 values without a sample requirement. With only MaxP99Latency enabled, an empty report or endpoints with no successful samples returns no violation."
expected = "An enabled latency qualification needs observable endpoint samples; absent or failed observations must be reported as insufficient evidence rather than a passing latency result."
proposal = "In tools/loadtest/stats/bounds.go and the final report producer, carry required endpoint membership and enforce the existing sample_count, add an explicit insufficient-samples violation for enabled latency checks, and retain the existing numerical comparison assertions."
owner_domain = 16

[finding.sender-tests-third-shape]
file = "tools/loadtest/sender/sender_test.go"
line = 68
class = "test-gap"
severity = "medium"
