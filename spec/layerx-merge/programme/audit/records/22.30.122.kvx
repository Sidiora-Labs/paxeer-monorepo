expected = "Brief facts 1/6, requirements 13287.1/13287.2 and registry row 13.env-paxai-chain-domain-src-lib-rs require the guest code hash and derived market identities to bind the actual merged chain. A different chain's well-formed domain must not be the deployment build default."
proposal = "Derive PAXAI_CHAIN_DOMAIN from chain-125 activation configuration in Makefile and Programs packaging; cross-check merged_chain_domain(125) before deployment. Update programs/crates/layerx-programs-ai-market/tests/chain_domain.rs and tests/ci/test_paxai_chain_domain.py to pin the real identity while retaining foreign-domain refusals."
owner_domain = 13
interface = "13.env-paxai-chain-domain-src-lib-rs"

[finding.guest-release-profile-differs-from-limit-contract]
file = "programs/crates/layerx-programs-ai-market/src/lib.rs"
