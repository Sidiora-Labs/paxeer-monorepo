[finding.finality-test-expects-rank-promotion]
file = "programs/crates/layerx-programs-ai-market/src/queries.rs"
line = 339
class = "test-gap"
severity = "medium"
observed = "bind_snapshot preserves finality.rank and refuses ranks above FINALIZED_RANK=4. tests/view_binding.rs:510 supplies rank 2 but asserts published.rank=4 and successful require_finalized; its loop expects ranks 0,4,5,255 to yield the same binding. This contradicts the producer and proof_ai_market_guest's real committed-head refusal path. This is a static contradiction, not an executed test result."
expected = "Requirements 13279.1/13279.2 and 13280.3 require truthful finality evidence and refusal of uncommitted bindings. Tests must prove lower-rank preservation, invalid-rank rejection and actual rank-4 acceptance without manufacturing finality."
proposal = "In programs/crates/layerx-programs-ai-market/tests/view_binding.rs drive the positive case with committed rank-4 evidence and exact field assertions. Separately assert lower-rank preservation/finalization refusal and invalid-rank rejection, reusing tests/proof_ai_market_guest.rs real capture/transport/reopen path. Do not promote ranks in queries.rs to satisfy the stale fixture."
owner_domain = 13
interface = "13.rs-aim-queries-bind-snapshot"

