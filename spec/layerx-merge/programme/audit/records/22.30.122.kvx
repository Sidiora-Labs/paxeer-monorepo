[finding.header-omits-opened-epoch]
file = "programs/crates/layerx-programs-ai-market/src/queries.rs"
line = 107
class = "interface-mismatch"
severity = "high"
observed = "read_header always returns epoch=Presence::Absent and roster=Presence::Absent, even after epoch::compose persists F08 current_epoch, the F03 evaluator snapshot and F06 reserved row/roster digest. bind_snapshot copies those absences into client/indexer transport, so the opened market cannot round-trip its frozen binding through READ_HEADER."
expected = "Registry row 13.rs-aim-queries-read-header and the exact-state capture contract require the epoch and roster actually committed by OpenEpoch. Absence is valid before a frozen roster exists; brief checks 1 and 7 require the real opened-state producer to reach consumers."
proposal = "In programs/crates/layerx-programs-ai-market/src/queries.rs derive epoch/roster from the captured F08/F03/F06 sections and refuse disagreement among their bindings. Exercise routed creation/enrollment/OpenEpoch, capture, client/indexer decoding and persisted-capture reopen, requiring identical present epoch and roster."
owner_domain = 13
interface = "13.rs-aim-queries-read-header"

[finding.availability-hides-enabled-features]
file = "programs/crates/layerx-programs-ai-market/src/queries.rs"
line = 529
class = "interface-mismatch"
severity = "high"
observed = "feature_availability returns F06=NotEnabled and F03/F04/F05/F07/F08/F09=NotYetProduced regardless of populated regions. Routed epoch, evidence, commitment, aggregation and reward producers already persist those regions. services/platform/hosted/indexer/src/ai_market.rs::observe saves this false availability with its captured market."
expected = "Registry row 13.rs-aim-queries-feature-availability describes the exact captured state. Produced committed rewards, evidence and evaluator data must remain discoverable through the indexer; supported populated regions cannot be advertised as disabled or never produced."
proposal = "In programs/crates/layerx-programs-ai-market/src/queries.rs decode each supported region and distinguish absent, produced, unsupported and unavailable content. Prove a real routed lifecycle capture reaches services/platform/hosted/indexer/src/ai_market.rs and retains the same availability after reopening its persisted index."
owner_domain = 13
interface = "13.rs-aim-queries-feature-availability"

[finding.participant-projection-drops-market-state]
file = "programs/crates/layerx-programs-ai-market/src/queries.rs"
line = 741
class = "interface-mismatch"
severity = "high"
observed = "participant_rows reads live F02 workers, joins evaluators only from an optional external RosterView, and hardcodes score=NotProduced, reward=NotEnabled and history=NotYetProduced. The real indexer rows_of passes None, dropping committed evaluators and reporting every worker outside the frozen roster even when F03/F06 hold an opened roster and settlement data."
expected = "Registry row 13.rs-aim-queries-participant-rows must project participants and frozen membership from captured producer state. Brief checks 1, 5 and 7 require evaluator membership and produced score/reward/history availability to round-trip into the served view and through restart."
proposal = "Make programs/crates/layerx-programs-ai-market/src/queries.rs derive frozen membership and produced fields from captured F03/F05/F06/F07/F08 state. Bind optional supplied rosters to that state. Update services/platform/hosted/indexer/src/ai_market.rs to consume the complete projection and test opened/settled captures before and after persisted-index reopen."
owner_domain = 13
interface = "13.rs-aim-queries-participant-rows"

[finding.reputation-region-never-created]
file = "programs/crates/layerx-programs-ai-market/src/registry_ops.rs"
line = 607
class = "wiring-gap"
severity = "high"
observed = "CREATE initializes feature_sections to policy and four empty slices. No routed transition initializes ReputationState::new for absent RP07: epoch::compose preserves None and with_region simply runs the other producer. History operations refuse F07_UNKNOWN_WORKER. tests/reputation_lifecycle.rs::World::create uses world.edit to insert Region{ReputationState::new(...)} that the real CREATE never emits."
expected = "The finished market must accumulate durable F07 history through ordinary authorized creation, enrollment, opening and settlement. Brief checks 2, 5 and 7 require the production lifecycle to establish the region without an out-of-band fixture edit."
proposal = "Initialize empty RP07 in programs/crates/layerx-programs-ai-market/src/registry_ops.rs CREATE, or add an authorized first-region transition in epoch.rs preserving the F08 suffix. Prove routed creation through multiple opened/settled epochs and history reads, including state reopen, without test-only insertion."
owner_domain = 13

[finding.aggregation-reconstructs-mutable-roster]
file = "programs/crates/layerx-programs-ai-market/src/aggregation.rs"
line = 612
class = "interface-mismatch"
severity = "high"
observed = "frozen_roster loads worker/recipient from reserved F06 but owner, generation, key_version, delegate and metadata from live WorkerTable. workers::publish_metadata and rotate_delegate replace those attributes immediately with effective_epoch=next_epoch. BeginAggregation/ProcessAggregation recompute the original digest through AggregationInputView::structural and refuse WRONG_ROSTER after a valid update, preventing terminal settlement of the active reserve."
expected = "Registry row 13.rs-aim-aggregation-apply consumes the immutable roster committed by OpenEpoch. Next-epoch metadata or delegate changes must not invalidate an opened epoch or stop its reserved funds settling, including after restart."
proposal = "Persist full immutable WorkerRosterEntry values when programs/crates/layerx-programs-ai-market/src/epoch.rs freezes the roster. Make aggregation.rs load them for begin/process/finalize, keeping current revocation eligibility separate. Test opening, permitted metadata/key updates, state reopen, chunked aggregation and final settlement against the original digest."
owner_domain = 13
interface = "13.rs-aim-aggregation-apply"

[finding.task-admission-uses-next-epoch-attributes]
file = "programs/crates/layerx-programs-ai-market/src/tasks.rs"
line = 747
class = "interface-mismatch"
severity = "high"
observed = "check_frozen_worker reconstructs every frozen worker entry from live WorkerTable and compares the digest with opened SetBinding.roster. Any frozen worker publishing next-epoch metadata or rotating a delegate changes that digest. New admissions can refuse WRONG_ROSTER for the whole opened roster, including other workers whose identities did not change."
expected = "Registry row 13.rs-aim-tasks-apply binds work to the opened epoch and frozen metadata. Next-epoch identity publication must preserve admission for eligible current-epoch workers; live revocation checks must not rewrite another worker's frozen binding."
proposal = "In programs/crates/layerx-programs-ai-market/src/tasks.rs read immutable opening entries from the persisted epoch snapshot, compare requested metadata with that snapshot and check current authority separately. Test publishing/rotating one worker during Work and admitting for another before and after state reload with the original roster binding."
owner_domain = 13
interface = "13.rs-aim-tasks-apply"

[finding.authority-route-forgets-aggregate-seal]
file = "programs/crates/layerx-programs-ai-market/src/dispatch.rs"
line = 1229
class = "interface-mismatch"
severity = "medium"
observed = "The authority route always sets AuthorityContext.aggregate_sealed=false. authority::revoke persists/emits excludes_frozen_epoch = region.frozen(evaluator) && !ctx.aggregate_sealed. Revocations after F05 sealing are therefore labelled as excluding the sealed epoch, although retained sealed input commitments are not reselected."
expected = "Registry row 13.rs-aim-evaluators-authority-authoritycontext and aggregation::progress require seal status for the same opened epoch: phase != AggregationPhase::Unsealed. Post-seal revocation must distinguish future authority from the existing sealed input set."
proposal = "In programs/crates/layerx-programs-ai-market/src/dispatch.rs derive aggregate_sealed from aggregation::progress over the same committed state, handling pre-opening explicitly. Test routed revocation before/after BeginAggregation, serialized flags/events and reopened state, with sealed input commitments unchanged."
owner_domain = 13
interface = "13.rs-aim-evaluators-authority-authoritycontext"

