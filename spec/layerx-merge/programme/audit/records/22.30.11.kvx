expected = "The published spot schema must use the dialect named by its openapi version so generators and validators interpret optional and nullable fields consistently with the REST producer."
proposal = "Regenerate apps/perps/swagger_spot.json in a supported dialect: use OpenAPI 3.0 nullable schemas or declare and validate an actual OpenAPI 3.1 contract. Preserve every required field and producer nullability rather than weakening the schema for generation."
