class = "runtime-risk"
severity = "low"
observed = "CustomSlider declares step but rounds pointer positions to fixed five-percent buckets and then integer values, ignoring the step argument. For min=0,max=1,step=0.1 most of the intended grid cannot be selected. No live import of this primitive was found."
expected = "The exported range/step contract should determine selectable values. A reusable amount slider should neither advertise unsupported fractional precision nor silently replace a caller's step with a visual percentage interval."
proposal = "Apply the supplied step relative to min in apps/perps/src/ui/atoms/custom-slider.tsx on every interaction path, separating tick decoration from value precision, or retire this unused primitive in favor of the maintained Radix wrapper."
owner_domain = 3
interface = "3.ts-perps-ui-atoms-custom-slider-default"

[finding.uncontrolled-slider-range]
file = "apps/perps/src/ui/atoms/slider.tsx"
line = 10
class = "runtime-risk"
severity = "low"
observed = "The wrapper accepts all Radix Root props, including defaultValue, but computes its range width only from props.value || [0]. An uncontrolled defaultValue or subsequent internal drag changes the Radix thumb while the inline range width remains based on zero. Current order-form use is controlled."
expected = "Every supported controlled or uncontrolled value mode should show a range matching its thumb. Accepting the Radix prop surface must not produce a contradictory amount indicator for legitimate defaultValue callers."
proposal = "Track uncontrolled value changes or delegate range geometry to Radix in apps/perps/src/ui/atoms/slider.tsx; preserve controlled behavior. Verify initial defaultValue and an uncontrolled drag display the same selected amount as the thumb."
owner_domain = 3

[finding.negative-epoch-duration]
file = "modules/epoch/types/epoch.go"
line = 20
class = "runtime-risk"
severity = "high"
observed = "Epoch.Validate refuses duration.Seconds() == 0 but accepts a negative duration. GenesisState.Validate delegates to it, so such genesis/import state is accepted. keeper.BeginBlock then compares positive elapsed time to a negative duration, advances every block and moves CurrentEpochStartTime backwards with Add(duration), firing consensus epoch hooks on an invalid schedule."
expected = "Epoch duration must be strictly positive before genesis/import state is admitted. Epoch numbers and start times must advance on the configured forward schedule; invalid persisted epoch timing must never drive mint or other module hooks."
proposal = "Require EpochDuration > 0 in modules/epoch/types/epoch.go and cover negative durations in types/genesis_test.go plus real genesis-to-BeginBlock tests. Prove invalid state is refused before hooks can execute and preserve the existing bounded positive-duration catch-up behavior."
owner_domain = 3
interface = "3.go-epoch-types-epoch-validate-j64"

[finding.epoch-hook-timing-comment]
file = "modules/epoch/types/hooks.go"
line = 12
class = "doc-drift"
severity = "low"
observed = "The EpochHooks comment says BeforeEpochStart runs on the next block after epoch EndBlock. keeper.BeginBlock actually calls AfterEpochEnd, stores the next Epoch and calls BeforeEpochStart immediately on the same context and block."
expected = "Hook implementers need the actual same-block order and failure semantics. Both callbacks execute within one BeginBlock transition, and a hook panic aborts rather than being silently skipped; they are not separated by a committed block."
proposal = "Correct the BeforeEpochStart contract comment in modules/epoch/types/hooks.go and the module hook documentation to state same-block end/store/start order and transactional failure handling. Retain the existing event re-emission and panic propagation behavior."
owner_domain = 3

[finding.epoch-boundary-documentation]
file = "modules/epoch/README.md"
line = 39
class = "doc-drift"
severity = "low"
observed = "The README describes callbacks at the start/end of each epoch without stating that BeginBlock requires elapsed > duration and advances at most one elapsed period per block. modules/epoch/spec/README.md says at each epoch boundary, while abci_catchup_test.go intentionally asserts bounded multi-block catch-up."
expected = "Operators and hook implementers need the strict-after boundary and bounded catch-up schedule, especially after a downtime interval. The documentation should explain the implemented timing rather than imply callbacks occur exactly at every wall-clock boundary."
proposal = "Clarify the strict comparison and one-period-per-block recovery in modules/epoch/README.md and modules/epoch/spec/README.md, with the callback order and preserved elapsed start times. Align examples with the existing positive-duration catch-up test."
owner_domain = 3

