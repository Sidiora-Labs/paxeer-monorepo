[file.19]
path = "rpc/websockets.go"
lines = 16
verdict = "issues"
note = "Read all 16 lines. The wrapper delegates the original ResponseWriter and request without replacing upgrade, origin, JWT or message checks. Row 7.met-otel-evmrpc-websocket-connects-total resolves to an Int64Counter with unit {count}; the legacy keep row conflicts with its absent emission. The wrapper runs before successful upgrade/authentication, producing the count error recorded separately. Counters are process-local observations, not restart-persistent chain state."

[finding.ws-handshake-count]
file = "rpc/websockets.go"
line = 10
class = "runtime-risk"
severity = "medium"
observed = "wsConnectionHandler.ServeHTTP increments evmrpc_websocket_connects_total before invoking the underlying handler. NewWSHandlerStack places this wrapper outside JWT validation, and newDenyListWSHandler can subsequently reject the Origin or fail its upgrade, so unsuccessful connection attempts increase the established-connection total."
expected = "Registry row 7.met-otel-evmrpc-websocket-connects-total describes new WebSocket connections; rejected authentication, rejected origins and malformed handshakes establish no connection."
proposal = "Move successful-connection accounting into the successful upgrade path in rpc/rpcstack.go and retain a separately named attempt counter if needed. Extend rpc/websockets_metrics_test.go through real authorized, unauthorized and rejected-origin handshakes to prove the distinction."
owner_domain = 7
interface = "7.met-otel-evmrpc-websocket-connects-total"

[finding.legacy-connect-policy]
file = "rpc/websockets.go"
line = 10
class = "wiring-gap"
severity = "medium"
observed = "The only connection emission is recordWebsocketConnect, whose rpc/metrics.go implementation adds only the OTel counter. Registry row 7.met-pax-websocket-connect remains keep under decision 2278 and promises dual emission until dashboard migration. TestWSConnectDoesNotEmitLegacyCounter instead asserts the legacy sink does not advance."
expected = "The kept legacy metric must reach its operational consumers until the declared migration completes. Requirement 7014.3 and decision 718 prescribe removal, whereas later decision 2278 and the active registry prescribe retention; these lifecycle authorities disagree."
proposal = "Reconcile domain 7 telemetry lifecycle in spec/layerx-merge/interfaces.kvx and the RPC contract with the dashboard migration owner. While the keep policy remains active, emit IncWebsocketConnects from rpc/metrics.go alongside OTel and prove the two real sinks; retire it only with recorded dashboard migration evidence."
owner_domain = 7
interface = "7.met-pax-websocket-connect"

[finding.test-version-global-race]
file = "rpc/test.go"
line = 18
class = "runtime-risk"
severity = "medium"
observed = "IncrementPointerVersion forwards every concurrent cw20 request to SetVersionWithOffset, which writes the process-global uint16 versionOverride without synchronization; CurrentVersion reads that same variable during pointer operations. Separate TestAPI instances share the override, and an HTTP server restart in the same process retains it."
expected = "The consumed row 6.go-evm-artifacts-cw20-setversionwithoffset-j34 must support the concurrency of its HTTP caller without races or accidental cross-instance test state. Live chains are already protected by server registration and GetVersionWthDefault."
proposal = "Make the override access synchronized and give test overrides an explicit node or test lifetime in modules/evm/artifacts/cw20/artifacts.go and rpc/test.go. Exercise simultaneous HTTP changes and pointer reads plus server replacement, with an explicit reset policy for the test network."
owner_domain = 6
interface = "6.go-evm-artifacts-cw20-setversionwithoffset-j34"

