proposal = "Add an owning RPC test using NewEVMHTTPServer and a real HTTP client to call both pointer types and int16 boundaries, observe CurrentVersion on a non-live context, and prove -32601 when disabled, on chain 125 and over WebSocket; cover the agreed override reset lifecycle."
owner_domain = 7
