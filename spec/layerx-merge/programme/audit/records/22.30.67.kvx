[file.12]
path = "rpc/query_builder.go"
lines = 29
verdict = "clean"
note = "Read all 29 lines. Fixed NewBlockHeader and NewBlock event values agree with consensus/types/events.go and consensus/internal/state/execution.go FireEvents. SubscriptionManager passes Build directly to the real client Subscribe/Unsubscribe and FilterAPI uses NewBlockQueryBuilder; no untrusted string enters the query. The builders are stateless selectors, not durable cursors; reconnect/recovery belongs to their subscription/filter owners. The direct-notifier path intentionally bypasses the event-bus selector."

[file.13]
