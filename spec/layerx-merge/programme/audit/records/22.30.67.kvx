line = 14
class = "doc-drift"
severity = "low"
observed = "The linked buf-workspace contract still includes lint ignore wasm/third_party/proto in row 7.fmt-buf-yaml-j39 and repeats at line 21 that the source contains a nonexistent directory, although buf.yaml now has only sdk/third_party/proto."
expected = "The contract selected by the active registry should describe the current root Buf authority and the already removed dead ignore path required by 7244.1; its pinned historical source is insufficient as current configuration guidance."
proposal = "Amend and regenerate spec/layerx-merge/contracts/proto-api.md buf-workspace from the reconciled registry, keeping the eight real module paths, existing lint rules and WIRE/WIRE_JSON breaking protections intact."
owner_domain = 7
interface = "7.fmt-buf-yaml-j39"

[finding.docs-legacy-metrics-conflict]
file = "spec/layerx-merge/contracts/evm-rpc.md"
line = 2078
class = "doc-drift"
severity = "low"
observed = "The metrics-legacy section marks 7.met-pax-websocket-connect retire and says RPC emission stops, whereas its active registry row is keep under decision 2278 and describes dual emission. The current code follows the older removal behavior."
expected = "The active registry, RPC contract and operational dashboard lifecycle must specify one observable metric policy; a pinned earlier contract must not conceal a later contradictory decision."
proposal = "After domain 7 resolves the lifecycle finding legacy-connect-policy, amend the metrics-legacy section of spec/layerx-merge/contracts/evm-rpc.md and regenerate its status/context rows to the governing migration policy."
owner_domain = 7
interface = "7.met-pax-websocket-connect"

[finding.docs-retired-buf-contract-anchor]
file = "spec/layerx-merge/contracts/rpc.md"
line = 0
class = "doc-drift"
severity = "low"
observed = "Consumed row 7.fmt-api-buf-yaml points to contracts/rpc.md#fmt-api-buf-yaml, but that anchor is absent from the resolved spec/layerx-merge/contracts/rpc.md catalogue. The retired api/buf.yaml file is absent too; the root workspace no longer reads it."
expected = "Decision 722 makes root buf.yaml the only workspace authority. A retired interface may remain as history, but its registry contract and callers must resolve and explicitly describe retirement."
proposal = "Reconcile row 7.fmt-api-buf-yaml to the root workspace retirement documentation in spec/layerx-merge/contracts/proto-api.md#buf-workspace, remove its stale root caller edge and document the removed v1 configuration in that section."
owner_domain = 7
interface = "7.fmt-api-buf-yaml"

