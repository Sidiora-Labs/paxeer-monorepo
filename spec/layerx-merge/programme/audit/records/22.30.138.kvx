[finding.bridge-cap-width]
file = "services/bridge/deploy/chainconfig/validate.go"
line = 295
class = "interface-mismatch"
severity = "high"
observed = "ChainConfig.validateCaps accepts any positive decimal big.Int when per_tx_cap <= total_cap. Thus both caps may be 2^256 on an EVM asset or 2^64 on a Solana asset and still pass Validate and the cap checks in RequireDeployable. Asset.PerTx and Asset.Total in config.go impose no width. DeployPaxeerXVault.s.sol:39-40 consumes uint256 arrays; contracts/bridge/solana/src/admin.rs:250-251 and state.rs:171-172 consume u64 caps. Accepted values therefore cannot round-trip through the deployment transport into the destination custody configuration."
expected = "The shared bridge configuration must describe values representable by the destination vault/program and refuse an invalid cap before an operator begins deployment. EVM caps fit uint256; Solana caps fit u64; all caps remain positive and per-transaction does not exceed total."
proposal = "In services/bridge/deploy/chainconfig/validate.go enforce caps <= 2^256-1 for KindEVM and <= 2^64-1 for KindSolana, with field-specific errors before deployment. Bound decimal input length before big.Int conversion in config.go. In config_test.go prove max and max+1 through Load, Overlay.Apply and RequireDeployable, and retain the real EVM/Solana transport checks."
owner_domain = 14
interface = "14.go-bridge-chainconfig-chainconfig-validate-j55"

[finding.solana-mint-case]
file = "services/bridge/deploy/chainconfig/validate.go"
line = 270
class = "runtime-risk"
severity = "medium"
observed = "validateAssets builds its duplicate-address key with strings.ToLower(asset.Address) before selecting the chain kind. Solana mints are case-sensitive base58 keys, so distinct valid public keys differing only by letter case are incorrectly treated as one asset and refused, even when their derived asset handles differ."
expected = "Duplicate checks must preserve Solana public-key identity and reject only the same decoded 32-byte mint. EVM hex addresses may be normalized case-insensitively."
proposal = "In services/bridge/deploy/chainconfig/validate.go derive the uniqueness key from decoded Solana public-key bytes for KindSolana and normalized 20-byte addresses for KindEVM. Add config_test.go cases admitting two valid case-varied Solana mints and refusing an actual duplicate."
owner_domain = 14

[finding.bridge-boundary-tests]
file = "services/bridge/deploy/chainconfig/config_test.go"
line = 1
class = "test-gap"
severity = "medium"
observed = "config_test.go exercises malformed amounts, zero caps, cap ordering, asset identities and overlays, but contains no destination-width max/max+1 cases and no pair of distinct Solana mints that collide under lowercase normalization. The acceptance paths can therefore retain both validation defects without a regression failure."
expected = "The schema and deployability tests must prove the exact numeric and identity boundaries the EVM vault and Solana custody program consume, including private overlay application."
