[finding.solc_mirror_bypass]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solc_downloader.ex"
line = 94
class = "config-drift"
severity = "medium"
observed = "CompilerVersion.source_url reads :solc_bin_api_url for /bin/list.json, but SolcDownloader.download hardcodes https://binaries.soliditylang.org/bin/soljson-<version>.js. A deployment using the declared compiler mirror still contacts the public origin for executable compiler content."
expected = "Compiler version discovery and compiler retrieval must honor the same configured distribution origin so restricted or mirrored deployments can verify contracts."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solc_downloader.ex, build binary URLs from the configured :solc_bin_api_url consistently with CompilerVersion and cover a mirror-only download."
owner_domain = 14
interface = "14.cfg-explorer-solc-bin-api-url"

[finding.solc_partial_download_recovery]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solc_downloader.ex"
line = 58
class = "restart-recovery"
severity = "medium"
observed = "SolcDownloader writes a fixed <version>-tmp.js with exclusive open, ignores IO.binwrite and rename results, and does not close the file. A crash after temp creation leaves a file that makes every later ensure_exists attempt fail with eexist, including after a process restart."
expected = "Interrupted compiler installation must be retryable and the final compiler path must be published only after a successful complete write and close."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solc_downloader.ex, use owned temporary files with cleanup/recovery, check write/close/rename results and atomically publish success; cover a leftover partial temp file and restart."
owner_domain = 14

[finding.vyper_partial_download_recovery]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/vyper_downloader.ex"
line = 58
class = "restart-recovery"
severity = "medium"
observed = "VyperDownloader opens a fixed <version>-tmp with exclusive mode and has no stale-temp recovery. A process stop during the write leaves that path behind, so every retry crashes before installing a compiler; rename and chmod results are also ignored."
expected = "Contract verification must recover from interrupted Vyper downloads without manual deletion and must never return an unusable compiler path as installed."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/vyper_downloader.ex, clean up or resume owned temporary downloads, check all file and chmod results, and cover interrupted installation followed by a fresh process retry."
owner_domain = 14

[finding.solc_http_error_cached]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solc_downloader.ex"
line = 97
class = "runtime-risk"
severity = "medium"
observed = "SolcDownloader takes the body of HttpClient.get! without checking status_code or compiler integrity. A non-2xx HTML error response can be renamed into the final .js path and ensure_exists subsequently accepts it indefinitely because the path exists."
expected = "Only a successfully retrieved, validated compiler artifact may enter the persistent compiler cache; transient HTTP errors must leave a retryable failure."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solc_downloader.ex, require successful HTTP status and validate the artifact against trusted distribution metadata before atomic cache publication; cover an error-body response followed by successful retry."
owner_domain = 14

[finding.vyper_http_error_cached]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/vyper_downloader.ex"
line = 132
class = "runtime-risk"
severity = "medium"
observed = "VyperDownloader extracts the final HTTP body without checking status and then makes that file executable. An error or truncated response is persisted as the requested compiler, and ensure_exists trusts it on every later verification."
expected = "Downloaded executable compilers must be successful, complete artifacts before being cached and executed; failed downloads must remain retryable."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/vyper_downloader.ex, check release and artifact responses, verify available trusted integrity metadata, and publish/chmod only validated content; cover non-2xx and interrupted responses."
owner_domain = 14

[finding.solidity_optional_optimizer]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solidity/verifier.ex"
line = 234
class = "runtime-risk"
severity = "medium"
observed = "extract_settings_from_json destructures settings.optimizer as a map containing both enabled and runs after successful local compilation. Valid Solidity standard JSON may omit optimizer entirely or omit runs with enabled:false, causing a MatchError instead of a verification result."
expected = "A standard-JSON verification must accept the same optional optimizer settings and defaults accepted by its compiler and preserve the effective settings in published metadata."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/solidity/verifier.ex, derive effective optimizer settings using compiler defaults for omitted keys and return typed errors for invalid settings; cover no optimizer and enabled:false without runs."
owner_domain = 14

[finding.reader_empty_abi]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/reader.ex"
line = 652
class = "runtime-risk"
severity = "medium"
observed = "process_abi([], method_id) returns nil, while both query_function_inner and query_function_with_custom_abi_inner handle only an outputs map or {:error, message}. An empty or event-only ABI therefore raises CaseClauseError instead of the method-not-found result."
expected = "Reading a missing function must return a stable typed error for empty and function-free ABIs without crashing the request."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/reader.ex, make empty parsed ABIs return the existing method-not-found error and ensure named-output callers propagate it; cover empty and event-only custom ABIs."
owner_domain = 14

[finding.reader_options_dropped]
file = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/reader.ex"
line = 492
class = "wiring-gap"
severity = "medium"
observed = "The proxy query_function_with_names branch omits options when calling query_function_with_custom_abi_inner, and query_function_inner drops them again at query_contract_and_link_outputs. Options merged into JSON-RPC arguments by query_contracts are consequently lost on these paths."
expected = "Caller-selected read options must reach the same JSON-RPC execution path for regular, proxy and custom-ABI reads."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/smart_contract/reader.ex, forward options through both missing argument positions and verify that a nondefault transport/read option reaches execute_contract_functions on each path."
owner_domain = 14
interface = "14.cfg-explorer-json-rpc-named-arguments"

