[finding.signer-wire]
file = "services/platform/ramps/toolkit/src/clients.rs"
line = 1258
class = "interface-mismatch"
severity = "high"
observed = "The strict sign Response accepts only signature and converts it to 65 bytes at line 1284. The actual hosted KMS SignatureResponse emits a base64 64-byte secp256k1 signature plus recovery_id (kms.rs:124-127,371-421,592-595). Both the extra field and the byte length are refused, so real ramp signing cannot complete."
expected = "POST /v1/signatures must round-trip the maintained KMS response into an authenticated EIP-1559 signature before any transaction is submitted."
proposal = "In services/platform/ramps/toolkit/src/clients.rs consume the KMS signature and recovery_id explicitly, validate their canonical encodings and recovery range, assemble the EVM signature and retain recovered-operator verification. Prove the hosted KMS handler through mTLS into prepare_payment with a provisioned real key."
