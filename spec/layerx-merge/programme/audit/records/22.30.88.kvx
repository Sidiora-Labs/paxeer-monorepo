line = 247
class = "restart-recovery"
severity = "high"
observed = "resolve_layerx passes only tx_hash into resolve_with_evidence although the journal retains raw_transaction. A rebuilt LayerxClient starts with an empty raw_transactions map (clients.rs:900); its uncached receipt path looks for transaction bytes in a committed block at receipt.height (1204-1215). A receipted but uncommitted transaction cannot be verified after restart. A crash after the planned append and before broadcast leaves only repeated unknown lookups, with no path to use the durable signed bytes."
expected = "The persisted exact transaction must survive process loss and allow safe reconciliation of planned and pending funded orders without requiring an in-memory cache or inventing a new payment identity."
proposal = "In services/platform/ramps/toolkit/src/engine.rs and clients.rs pass and authenticate the journal raw_transaction during recovery and resolution. Reconcile transaction and nonce state before any authorized re-delivery of those same bytes; prove crashes before broadcast and before commitment against the real node."
