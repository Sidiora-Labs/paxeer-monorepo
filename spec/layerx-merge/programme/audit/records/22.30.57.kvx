class = "doc-drift"
severity = "medium"
observed = "The worked REST example uses /ibc_transfer/v1beta1/denom_traces/<hash> and a flattened {path,base_denom} result. The registered gateway is /ibc/apps/transfer/v1/denom_traces/{hash} with a denom_trace envelope; channelToA/channelToB examples also differ from canonical channel-N identifiers."
expected = "Client examples must match the real gateway route, response envelope and trace parser, so wallets can resolve actual packet-produced voucher denoms without inventing another shape."
proposal = "Update interchain/modules/apps/transfer/spec/01_concepts.md with canonical channel-N examples and the real registered REST response, generated from a real query. Retain the external multi-hop chain explanation while distinguishing tenant namespaces from external IBC chains."
owner_domain = 6

[finding.transfer-doc-port-storage]
file = "interchain/modules/apps/transfer/spec/02_state.md"
line = 9
class = "doc-drift"
severity = "medium"
observed = "The state table describes Port at key 0x01 as ProtocolBuffer(string). keeper/keeper.go SetPort actually writes []byte(portID), and GetPort decodes the raw byte string without a protobuf envelope."
expected = "Storage documentation must state the exact byte encoding used by the real keeper so migrations and recovery tools do not misdecode the port key."
proposal = "Correct interchain/modules/apps/transfer/spec/02_state.md to describe raw UTF-8 port bytes at 0x01, retain the protobuf DenomTrace value at 0x02, and cite the keeper encoding boundary."
owner_domain = 6

[finding.transfer-doc-timeout-event]
file = "interchain/modules/apps/transfer/spec/05_events.md"
line = 44
class = "doc-drift"
severity = "medium"
observed = "The timeout table names event fungible_token_packet with denom and amount attributes. ibc_module.go emits EventTypeTimeout=\"timeout\" and refund_receiver, refund_denom, refund_amount and memo; the receive table also omits its emitted sender attribute."
expected = "Event consumers must be able to subscribe to the exact emitted event type and attribute names for refunds and packet outcomes."
proposal = "Rewrite the callback tables in interchain/modules/apps/transfer/spec/05_events.md from the real ibc_module.go events, explicitly using timeout/refund_denom/refund_amount and the receive sender; distinguish acknowledgement success/error events from the common packet attributes."
owner_domain = 6

[finding.transfer-doc-metrics]
file = "interchain/modules/apps/transfer/spec/06_metrics.md"
line = 11
class = "doc-drift"
severity = "medium"
observed = "The metrics table calls both amount gauges total amounts and documents only tx_msg_ibc_transfer. The live OpenTelemetry instrument is ibc_transfer_tx_msg with a denom_class label and last-value semantics; the legacy tx_msg_ibc_transfer gauge still coexists with full-denom labels. Amounts outside int64 are not recorded by either amount gauge."
expected = "Operators need the actual instrument names, gauge semantics, label dimensions and integer range, while counters remain cumulative transfer counts."
proposal = "Update interchain/modules/apps/transfer/spec/06_metrics.md to distinguish concurrent legacy and OpenTelemetry series, document last representable packet/transfer amount rather than a sum, list denom_class and source/channel labels, and state the int64 amount-recording limit."
owner_domain = 6

[finding.transfer-doc-receive-gating]
file = "interchain/modules/apps/transfer/spec/07_params.md"
line = 25
class = "doc-drift"
severity = "medium"
observed = "The ReceiveEnabled section says disabling a bank denomination's SendEnabled stops that denomination arriving through IBC. OnRecvPacket checks the transfer-wide ReceiveEnabled and then performs keeper bank flows; those SendCoins/module paths do not enforce the user MsgSend SendEnabled gate."
expected = "The guide must describe the actual receive controls and must not promise a per-denom inbound freeze that the receive producer/consumer path does not implement."
proposal = "Correct interchain/modules/apps/transfer/spec/07_params.md to document ReceiveEnabled as the module-wide inbound control and explain the bank message/module-flow distinction. If per-denom inbound policy is desired, specify and implement it as a separate domain-6 task with real receive/refund proofs rather than silently widening bank gating."
owner_domain = 6

