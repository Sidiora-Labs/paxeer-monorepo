[finding.ica-export-context-lifetime]
file = "interchain/modules/apps/27-interchain-accounts/module.go"
line = 211
class = "restart-recovery"
severity = "medium"
observed = "ExportGenesisStream starts an unbuffered goroutine that calls ExportGenesis using the captured sdk.Context after the function returns. A caller that closes or advances the source store before draining can export later state or use a closed store, and an abandoned stream leaves the sender blocked. The current module manager drains immediately, while transfer/module.go already captures synchronously."
expected = "A genesis stream must capture a stable snapshot while its source context is valid and must finish producing its single module message without depending on a later consumer read."
proposal = "In interchain/modules/apps/27-interchain-accounts/module.go capture and marshal ExportGenesis synchronously into a one-element buffered closed channel, as transfer/module.go does. Prove that changing and closing the producer store after obtaining the stream cannot alter the exported state, then reopen the imported real keeper."
owner_domain = 6

