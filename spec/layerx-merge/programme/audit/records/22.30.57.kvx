[finding.redelegation-shares]
file = "precompiles/staking/staking.go"
line = 1072
class = "interface-mismatch"
severity = "high"
observed = "redelegations maps RedelegationEntryResponse.Balance.String() into SharesDst. The real staking query carries destination shares separately in entry.RedelegationEntry.SharesDst; a non-unit validator exchange rate makes these different quantities. ABI consumers receive token balances under the sharesDst name."
expected = "The sharesDst string in the frozen RedelegationEntry tuple must preserve the staking producer's destination decimal shares, including fractional precision; Balance is a token amount, not a share count."
proposal = "In precompiles/staking/staking.go map SharesDst from entry.RedelegationEntry.SharesDst.String(). Activate the semantic correction through the versioned upgrade policy, preserve historical replay implementations, and prove a real staking keeper response with fractional shares and a non-unit exchange rate through ABI encoding and decoding."
owner_domain = 6
interface = "6.pc-0x1005-redelegations"

[finding.validator-key-length]
file = "precompiles/staking/staking.go"
line = 552
class = "security"
severity = "medium"
observed = "createValidator accepts every hex-decodable pubKeyHex length and constructs ed25519.PubKey directly. MsgCreateValidator.ValidateBasic does not check key length; sdk/x/staking/keeper/msg_server.go:49 obtains its consensus address, whose ed25519 Address method panics unless the key is 32 bytes. The dynamic precompile wrapper does not convert this panic into its ordinary error return."
expected = "Staking.sol:119 promises a 64-character Ed25519 public key. Invalid-length user input must be rejected with a bounded transaction refusal before payment handling or keeper invocation, even when the string is valid hex."
proposal = "In precompiles/staking/staking.go require exactly 32 decoded bytes before HandlePaymentUhpx. Add real EVM transaction refusal cases for empty, 31-byte and 33-byte hex keys with otherwise valid inputs, and assert unchanged validator and balance state. Apply the correction only under the approved forward version policy."
owner_domain = 6
interface = "6.pc-0x1005-createvalidator"

