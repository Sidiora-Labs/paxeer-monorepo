[finding.22.30.5.1]
file = "src/modules/asset/lx_asset_registry.c"
line = 703
severity = "high"
observed = "lx_asset_record_encode accepts an otherwise canonical issuer_kind=1 record with decimals=39 and writes version 3 bytes; lx_asset_record_decode rejects those bytes at lines 775-778. Registration separately enforces decimals <= 38, so this is an exported codec defect, not evidence that ordinary registration admits the value."
expected = "The encoder and decoder declared by 1.c-lx-asset-record-encode and 1.c-lx-asset-record-decode must agree on successful version 3 records; successful encoding must produce readable persisted asset facts."
proposal = "Share complete record validation in src/modules/asset/lx_asset_registry.c between registration, encoding and decoding, refusing decimals above 38 before writing; add accepted-record round trips and unchanged-output refusals at the actual save/restore boundary."
owner_domain = 1
class = "interface-mismatch"
