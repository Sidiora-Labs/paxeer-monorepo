[finding.sdk-credential-selection]
file = "sdk/chainflow/rust/src/client.rs"
line = 66
class = "interface-mismatch"
severity = "high"
observed = "Auth::apply inserts rest_api_key into X-API-Key, then overwrites it with ws_mint_key and appends ws_token to every authenticated URL. Both HTTP dispatch and WebSocket connect call this unconditional renderer. The client built with all three credentials shown in README.md therefore sends the WS mint key on ordinary REST reads, which require the separate REST key."
expected = "The registered ChainflowDataGatewayClient must preserve separate REST, WS mint and WS upgrade credentials. Its builder documents ws_mint_key as ONLY for minting; api.md:86 requires that key for POST /auth/ws-token, while ordinary REST operations use rest_api_key and upgrades use a scoped token."
proposal = "Fix the Scalar generation inputs and sdk/chainflow/rust/src/client.rs to carry each operation security scheme into dispatch and connect_websocket. Select the REST key for REST reads, the mint key only for /auth/ws-token, and the scoped token only for upgrades. Prove all three operations with distinct credentials configured against the real gateway auth handlers."
owner_domain = 15
interface = "15.rs-chainflow-rust-chainflow-data-gateway-client-j76"

[finding.sdk-ci-not-discovered]
file = "sdk/chainflow/rust/.github/workflows/sdk-ci.yml"
line = 1
class = "wiring-gap"
severity = "medium"
observed = "The Rust SDK workflow lives beneath sdk/chainflow/rust/.github/workflows, where GitHub does not discover workflows. Root .github/workflows contains no Chainflow Rust SDK invocation. The nested job also gives cargo commands no crate working-directory, so copying it unchanged to the root would target the wrong directory."
expected = "SDK changes must reach the declared build, clippy, all-features tests and formatting checks from the monorepo checkout with sdk/chainflow/rust as the cargo working directory."
proposal = "Add the verification job to a root .github/workflows workflow with SDK path triggers and sdk/chainflow/rust as working-directory. Preserve its all-features build and test flags so the feature-required mock target and gated surfaces remain checked."
owner_domain = 15

[finding.sdk-doc-oauth]
file = "sdk/chainflow/rust/README.md"
line = 174
class = "doc-drift"
severity = "low"
observed = "The tracing section describes failed OAuth token exchanges, and lines 233-235 promise shared cached access tokens and repeated exchanges when rebuilding clients. client.rs stores supplied API credentials only and has no OAuth exchange, refresh or token cache."
expected = "The usage guide must describe supplied REST and mint keys, caller-managed short-lived WS tokens, and shared transport state across client clones without claiming an unimplemented authentication lifecycle."
proposal = "Rewrite the tracing and reuse paragraphs in sdk/chainflow/rust/README.md to describe static credentials, explicit WS-token minting and replacement, and shared connection pools; remove the OAuth and cached-token claims."
owner_domain = 15

[finding.sdk-doc-feature-matrix]
file = "sdk/chainflow/rust/README.md"
line = 207
class = "doc-drift"
severity = "low"
observed = "The feature paragraph promises that no combination is rejected. transport_reqwest.rs:23-26 emits compile_error for reqwest without either TLS backend; README.md:127-129 already describes that supported-build restriction."
expected = "The feature summary must agree with the compile-time TLS requirement and the earlier no-default-features installation instructions."
proposal = "Replace the unconditional combination claim in sdk/chainflow/rust/README.md with the supported reqwest TLS combinations and independent custom-transport configuration, preserving the existing compile-time TLS protection."
owner_domain = 15

[finding.payment-codec-retired-dependency]
file = "services/agent/crates/layerx-crypto/src/payments.rs"
line = 12
class = "retired-reference"
severity = "medium"
observed = "The maintained payments facade imports Decoder and Encoder from layerx_wire and uses that crate for protocol predicates and signature domain tags. component.wire-codec in programme/data/retired.kvx deletes the layerx-wire crate, while payment encode/decode registry rows remain stable and facade consumers remain live."
expected = "The stable payment payload API and EIP-1559 ledger-call facade required by 8968.2 must remain usable after the retired activity-wire crate is removed; retaining payload bytes must not retain the retired activity transport."
proposal = "Move the required bounded payload reader/writer, domain tags and version checks into the maintained payment or transaction codec in services/agent/crates/layerx-crypto, then re-point payments.rs. Preserve exact payload bytes, canonical decode checks and signature refusals."
owner_domain = 9
interface = "9.rs-crypto-payment-encode-j70"

[finding.payment-tests-old-signing-path]
file = "services/agent/crates/layerx-crypto/tests/payments.rs"
line = 82
class = "retired-reference"
severity = "medium"
observed = "canonical builds a protocol-3 0x1001 eleven-field activity envelope on network 17. Tests call disclosure::bind and SignatureMessage::new, whose registry disposition is retire. The final facade test builds an EIP-1559 call but checks re-export equivalence and signs directly, leaving the old envelope disclosure tests tied to removed interfaces."
expected = "Payment payload checks must survive activity-wire and SignatureMessage retirement, and reviewed payment signing must bind chain-125 EIP-1559 nonce, target, calldata and gas terms as specified by 9321-9323."
proposal = "Migrate services/agent/crates/layerx-crypto/tests/payments.rs disclosure/signing checks to maintained payload fixtures, ledger_payment_call, bind_call and sign_disclosed_call. Preserve every malformed-payload and field-tamper assertion, and prove recovered sender plus changed-call refusal."
owner_domain = 9
interface = "9.rs-crypto-signaturemessage-new-j70"

[finding.chain-read-router-path]
file = "services/platform/hosted/gateway/tests/chain_reads.rs"
line = 403
class = "retired-reference"
severity = "medium"
observed = "chain_reads.rs sends successful gateway JSON-RPC calls to /rpc. Current public_reads::route still serves that alias, so this is a retained pre-merge transport, not a claim that the current route is absent. Registry row 8.http-gateway-any-rpc still labels it stable. These assertions do not establish the finished root endpoint contract."
expected = "Brief network facts 2 and 3 retire the unified /rpc path and require root JSON-RPC. Hosted-gateway px_ methods remain separate from the namespaces and hostnames owned by the node."
proposal = "Migrate services/platform/hosted/gateway/tests/chain_reads.rs successful calls to POST / while preserving all authentication, result and refusal assertions. Coordinate removal of the legacy producer alias and add an explicit retired-path refusal without keeping a compatibility router alive."
owner_domain = 8
interface = "8.http-gateway-any-rpc"

