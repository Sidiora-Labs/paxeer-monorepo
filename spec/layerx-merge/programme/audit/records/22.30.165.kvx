[finding.persistent-cache-bulk-invalidation]
file = "sdk/store/cache/cache.go"
line = 30
class = "interface-mismatch"
severity = "high"
observed = "CommitKVStoreCache embeds CommitKVStore.DeleteAll without invalidating its TwoQueueCache. After Get(k) caches a value, DeleteAll covering k deletes the parent value but Get(k) still returns the cached value. sdk/storev2/rootmulti.SetInterBlockCache is a no-op, so this concerns the exported legacy cache path rather than the production PaxDB cache."
expected = "A write-through KVStore must expose the same post-deletion state through Get, Has and iteration; deleting a range must invalidate every cached key in that range."
proposal = "In sdk/store/cache/cache.go implement range deletion with cache invalidation under the same mutation lock, propagate parent errors, and add a real parent-store round-trip covering cached hits, cached misses, partial ranges and Reset."
owner_domain = 15
interface = "15.go-store-cache-new-commit-kv-store-cache-manager-j76"

[finding.cache-unbounded-end]
file = "sdk/store/cachekv/store.go"
line = 369
class = "interface-mismatch"
severity = "high"
observed = "GetAllKeyStrsInRange compares every pending key against end even when end is nil. bytes.Compare(nonemptyKey,nil)>=0 excludes every cached insert and tombstone. Consequently Set(k,v) followed by DeleteAll(nil,nil) leaves the pending insert alive, and enumeration can resurrect a parent key deleted in the cache. engine/deps/store/cachekv.go repeats the comparison."
expected = "The KVStore nil end denotes an unbounded upper range. Enumeration and DeleteAll must reflect the same pending writes and deletions as Get and Iterator."
proposal = "In sdk/store/cachekv/store.go and engine/deps/store/cachekv.go apply upper-bound comparison only for non-nil end, merge tombstones consistently, and exercise Set/Delete/enumerate/DeleteAll/Write against the real parent for nil and bounded ranges. PrefixStore normally translates nil to a finite prefix end, so test the direct store path as well."
owner_domain = 15
interface = "15.go-store-cachekv-store-j76"

[finding.cache-size-no-op]
file = "sdk/store/cachekv/store.go"
line = 25
class = "config-drift"
severity = "low"
observed = "NewStore saves cacheSize and forwards it when branching, but no code reads it to size, limit or evict entries. A caller changing this parameter cannot change the cache behavior; pending mutations accumulate until Write."
expected = "A cache-size configuration must have a documented, observable effect, with dirty state retained until it is durably propagated."
proposal = "In sdk/store/cachekv/store.go and its constructors either implement a documented safe bound on clean read caching or remove the ineffective size control from callers and document transaction dirty-memory accounting; never evict uncommitted writes."
owner_domain = 15

[finding.cache-iterator-error]
file = "sdk/store/cachekv/mergeiterator.go"
line = 176
class = "interface-mismatch"
severity = "medium"
observed = "cacheMergeIterator.Error returns invalid cacheMergeIterator whenever Valid is false and never forwards parent/cache backend errors. A normal exhausted iterator therefore looks like a failure, while a backend failure on a valid wrapper can be hidden."
expected = "The declared tm-db Iterator interface distinguishes normal exhaustion from an underlying iteration error so consumers can use for Valid/Next followed by Error."
proposal = "In sdk/store/cachekv/mergeiterator.go keep invalid-position panics in Key/Value/Next guards and have Error return underlying iterator errors. Add real empty, exhausted and failing-backend iterator cases without changing pagination limits."
owner_domain = 15
interface = "15.go-store-types-iterator-j76"

[finding.benchmark-fixed-key-bound]
file = "sdk/store/cachekv/store_bench_test.go"
line = 122
class = "test-gap"
severity = "low"
observed = "benchmarkIteratorOnParentWithManyDeletes indexes keys[b.N] although keys has the fixed numKeys length. Benchmark calibration can reach or exceed that length and panic before measuring iteration."
expected = "A benchmark must remain valid for every iteration count selected by the Go benchmark runner and measure the intended fixed-size dataset."
proposal = "In sdk/store/cachekv/store_bench_test.go derive iterator bounds from the dataset rather than b.N, and put the measured walk in a b.N loop with a fresh iterator and deterministic closing for each sample."
owner_domain = 15

[finding.last-range-and-close]
file = "sdk/store/firstlast.go"
line = 23
class = "runtime-risk"
severity = "medium"
observed = "Last calls ReverseIterator(end,start), reversing the KVStore lower and upper bounds. For a nonempty bounded range this yields an invalid iterator; fallback Get(start) returns the first key instead of the last, and the invalid-iterator return occurs before Close is deferred."
expected = "Last must return the greatest key in [start,end) and release its iterator for bounded, unbounded and empty ranges."
proposal = "In sdk/store/firstlast.go pass start,end in the declared order, defer Close immediately, remove the first-key fallback, and verify last-key selection and closing with the same backing store used by First."
owner_domain = 15

[finding.bulk-gas-and-trace]
file = "sdk/store/gaskv/store.go"
line = 171
class = "runtime-risk"
severity = "medium"
observed = "gaskv.Store.DeleteAll and GetAllKeyStrsInRange delegate directly to the parent without gas consumption or StoreTracer events. modules/evm/keeper.PurgePrefix and migrations/RemoveTxHashes reach this wrapper, so bulk work bypasses the accounting applied by Delete and iterator operations."
expected = "State operations exposed by a gas-wrapped Context must have explicit bounded work and consistent metering/tracing; migration exemptions must be deliberate and separated from transaction execution."
proposal = "In sdk/store/gaskv/store.go define metering for bulk range reads/deletes, preserve mutation safety while enumerating, and verify keeper PurgePrefix accounting through Context.KVStore with bounded gas and tracing. Keep removal of legacy Has/Delete timing required by 15019 unchanged."
owner_domain = 15

[finding.validation-removed-version]
file = "sdk/store/multiversion/memiterator.go"
line = 112
class = "runtime-risk"
severity = "high"
observed = "validationIterator.Value dereferences GetLatestBeforeIndex without a nil check. CollectIteratorItems snapshots keys, but a predecessor re-execution can remove its old write before Value reads it; Store.GetLatestBeforeIndex explicitly returns nil in this case. The panic occurs in validateIterator own goroutine, outside transaction recovery."
expected = "Optimistic validation must safely retry or fall back to the parent when a predecessor incarnation removes a snapshotted key; transaction conflicts must not crash the node."
proposal = "In sdk/store/multiversion/memiterator.go and store.go handle absent versions using coherent parent/snapshot semantics or invalidate and retry; add a controlled real-store re-execution test that removes a predecessor key between key collection and value read and proves no goroutine panic or incorrect commit."
owner_domain = 15
interface = "15.go-store-multiversion-multi-version-store-j76"

[finding.validation-abort-worker]
file = "sdk/store/multiversion/store.go"
line = 270
class = "runtime-risk"
severity = "medium"
observed = "validateIterator returns on the first abortChannel receive, while its worker continues without cancellation or joining. validationIterator.Value performs a blocking send for each estimated value. A scan containing further estimates can fill the one-slot channel and strand the worker with open iterators."
expected = "An aborted optimistic validation must stop all work and close its iterators before retry, so repeated transaction conflicts cannot accumulate blocked goroutines."
proposal = "In sdk/store/multiversion/store.go and memiterator.go make abort terminal, cancel and join the validation worker, and test repeated aborts across multiple estimates using real multiversion entries and iterator close tracking."
owner_domain = 15

[finding.multiversion-nil-set]
file = "sdk/store/multiversion/mvkv.go"
line = 265
class = "interface-mismatch"
severity = "medium"
observed = "VersionIndexedStore.Set validates only the key and stores a nil value through setValue. Store.SetWriteset interprets nil as deletion, so a Set(k,nil) accepted by this wrapper becomes a tombstone instead of the KVStore-required panic."
expected = "All implementations of KVStore.Set must reject nil values; deletion must be explicit and behave consistently in serial and optimistic execution."
proposal = "In sdk/store/multiversion/mvkv.go call AssertValidValue before modifying write/read sets and add a real versioned-store case proving nil Set fails without altering the existing value while explicit Delete still commits a tombstone."
owner_domain = 15
interface = "15.go-store-types-kv-store-j76"

[finding.multiversion-iterator-error]
file = "sdk/store/multiversion/mergeiterator.go"
line = 177
class = "interface-mismatch"
severity = "medium"
observed = "mvsMergeIterator.Error reports an error for ordinary exhaustion and suppresses underlying parent/cache iterator failures, mirroring the cache iterator disagreement."
expected = "The exported tm-db Iterator error channel must report backend errors independently of whether the iterator has reached the end of its range."
proposal = "In sdk/store/multiversion/mergeiterator.go separate validity assertions from Error and propagate backing errors; cover normal empty/exhausted scans and a backend failure through a version-indexed iterator."
