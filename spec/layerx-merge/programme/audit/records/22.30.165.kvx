blocking = ["persistent-cache-bulk-invalidation","cache-unbounded-end","validation-removed-version","prefix-enumeration-keyspace","legacy-history-current-state","normalized-coins-invalid-set","stream-reader-error-loss","stream-import-invalid-lines","filtered-pagination-false-end","rest-sanitize-timeout","canonical-json-number-loss","stream-validator-premature-success","gentx-rest-codec-mismatch","mnemonic-validator-key-not-saved"]
review_method = "Every one of the 202 member files was read in full. Findings are source inspection conclusions, with producer/caller tracing; source tests were read but not executed. This audit changes only the record and proposes every repair."
requirements_reviewed = ["7288.1","15019.1","15019.2","15020.1","15020.2","15043.1","15049.1","15049.2","15044.1","15050.1","15961.1"]
requirement_assessment = "7288 custom proto types and alias paths inspected; OTel gas/cache/MidBlock source and absence tests inspected for 15019/15020/15043/15044/15049/15050; real storev2 existence+absence marshal/decoder vector inspected for 15961. No source requirement gate or inventory repair test is claimed by this record."
interface_coverage = "Reviewed all 400 listed produces, all 164 consumes, and the additional 175 registry declarations whose path belongs to the members (575 produced declarations total). Reviewed names, signatures, caller paths, byte/string/Any encodings, codes, bounds and lifecycle. Related row IDs are attached to interface disagreements; source locations and concrete caller compositions are in findings."
coverage_limits = "contracts/cosmos-fork.md is absent, preventing confirmation against its linked normative prose. The consumes list includes 10.err-human-api-conflict with callers outside this slice; it is not a live SDK error consumer. Five stable legacy metrics rows describe removed calls. No HTTP request, source build, source test or live recovery was executed; only the declared record qualification gates are authorized."
runtime_boundary = "paxd requires SetupPaxDB and installs sdk/storev2/rootmulti; legacy sdk/store/rootmulti and CommitKVStoreCache behavior must not be generalized to PaxDB. SDK in-process routers and task batches are not retired public routers/sequencer services."
doc_coverage = "All twelve package pages were read in full, plus both member README pages. Missing normative SDK contract is listed separately. Workflow/spec/registry/retirement/checker inputs are audit control inputs, not product documentation pages."

