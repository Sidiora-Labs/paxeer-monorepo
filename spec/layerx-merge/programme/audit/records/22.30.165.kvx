[finding.mnemonic-validator-key-not-saved]
file = "sdk/x/genutil/utils.go"
line = 86
class = "restart-recovery"
severity = "high"
observed = "InitializeNodeValidatorFilesFromMnemonic builds privval.NewFilePV for a mnemonic but never calls Save. NewFilePV only constructs in-memory Key and LastSignState; it does not persist either file. The returned validator pubkey can differ from the file subsequently loaded/generated on startup, including when an old key file already exists."
