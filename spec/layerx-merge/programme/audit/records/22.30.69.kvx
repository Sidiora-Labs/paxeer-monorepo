[finding.receipt-read-log-loss]
file = "rpc/filter.go"
line = 1678
class = "interface-mismatch"
severity = "high"
observed = "collectLogs logs every GetReceipt error and continues; normalizeRangeQueryLogs also turns the error into found=false. getTxHashesFromBlock can discard the transaction on an earlier receipt lookup. The successful partial answer advances GetFilterChanges.lastToHeight past the failed receipt."
expected = "The receipt-store producer distinguishes ErrNotFound from storage and decoding failures. Log queries must return all matching committed logs with stable indices or fail without consuming the range."
proposal = "In rpc/filter.go and rpc/utils.go, preserve receipt errors through transaction selection, log collection and workers; return an RPC error without advancing the cursor. Add a real receipt-store failure and recovery test proving all logs are delivered on retry."
owner_domain = 7
interface = "6.go-evm-keeper-keeper-getreceipt-j34"

[finding.silent-log-limit]
file = "rpc/filter.go"
line = 1463
class = "interface-mismatch"
severity = "high"
observed = "GetLogsByFilters slices open-ended fallback results to maxLog and returns the full scanned end with nil error. GetFilterChanges stores end+1, permanently skipping omitted logs. The production Pebble store uses this fallback; the efficient path returns before the limit."
expected = "A successful log query must contain its complete matching range. Limits must produce an explicit error or lossless continuation; receipt backend changes must not change completeness."
proposal = "In rpc/filter.go, reject overflow before publishing results or changing filter state, consistently on both paths. Test more than maxLog matches, including a single block exceeding the cap, through the real HTTP filter lifecycle."
owner_domain = 7
interface = "7.rpc-eth-getlogs"

[finding.tagged-filter-never-polls]
file = "rpc/filter.go"
line = 972
class = "interface-mismatch"
severity = "high"
observed = "GetFilterChanges compares the next-height cursor directly with fc.ToBlock.Int64(). Explicit latest (-2), safe and finalized tags satisfy the exhausted comparison before the first fetch and return empty forever. Since the cursor is end+1, >= also treats a numeric end as consumed when the next unread cursor equals it."
expected = "Installed filters accept dynamic tags and inclusive numeric bounds. Polling must resolve dynamic ends on each query and stop only after the final inclusive block is delivered."
proposal = "In rpc/filter.go, distinguish dynamic tags from numeric bounds and use a consistent next-unread-height invariant. Test latest, safe, finalized and the exact inclusive-end cursor with producer blocks and repeated HTTP polls."
owner_domain = 7
interface = "7.rpc-eth-getfilterchanges"

[finding.moving-filter-start]
file = "rpc/filter.go"
line = 1301
class = "interface-mismatch"
severity = "high"
observed = "NewFilter leaves ordinary latest or absent fromBlock unfrozen and initializes lastToHeight to zero. ComputeBlockBounds starts begin at current latest, then only raises it to lastToHeight. Several blocks between polls leave begin at the newest block, omitting intervening logs."
expected = "An installed log filter must retain its installation boundary and resume from its next unread height, including every committed block accumulated between polls."
proposal = "In rpc/filter.go, resolve the initial dynamic start once at installation and retain its next unread cursor as the subsequent lower bound. Test several real commits between polls and require all matching logs exactly once."
owner_domain = 7
interface = "7.rpc-eth-getfilterchanges"

[finding.snapshot-consumes-poll-cursor]
file = "rpc/filter.go"
line = 1086
class = "interface-mismatch"
severity = "high"
observed = "GetFilterLogs overwrites lastToHeight with its snapshot end although GetFilterChanges uses that field as its polling cursor. A snapshot between changes polls can skip unread blocks below that end and cause its end block to be delivered again."
expected = "eth_getFilterLogs is a repeatable snapshot. Only a successful changes poll consumes the filter change stream; a snapshot read must not move that cursor."
proposal = "In rpc/filter.go, keep GetFilterLogs read-only with respect to lastToHeight. Interleave HTTP snapshot reads, real commits and changes polls in a lifecycle test and require every changes log exactly once."
owner_domain = 7
interface = "7.rpc-eth-getfilterlogs"

[finding.filter-expiry-race]
file = "rpc/filter.go"
line = 740
class = "runtime-risk"
severity = "medium"
observed = "cleanupExpiredFilters selects expired IDs under RLock, releases it, then deletes each existing ID under the write lock without rechecking lastAccess. A successful poll refreshing a selected filter between locks still loses the filter and its feed subscription."
expected = "A successful poll before removal must renew filter lifetime. Cleanup must evaluate the current access time while applying its removal decision."
proposal = "In rpc/filter.go, recheck current lastAccess under the removal lock and cancel only a still-expired entry. Add a coordinated cleanup-versus-poll test proving a refreshed filter remains installed."
owner_domain = 7
interface = "7.cfg-evm-filter-timeout"

[finding.filter-ticker-panic]
file = "rpc/filter.go"
line = 703
class = "runtime-risk"
severity = "medium"
observed = "cleanupLoop constructs time.NewTicker(timeout/2) before its recovery defer. ReadConfig accepts zero, negative and 1ns filter_timeout values, which panic before recovery in the background goroutine and terminate the node."
expected = "Operator timing input must be rejected with an actionable startup error when it cannot produce a positive cleanup ticker; it must not crash the node asynchronously."
proposal = "Validate filter_timeout in rpc/config/config.go and enforce the precondition at the rpc/filter.go constructor before starting the goroutine. Cover negative, zero, 1ns and the smallest supported positive duration."
owner_domain = 7
interface = "7.cfg-evm-filter-timeout"

