[finding.legacy_reaction_state]
file = "services/launchpad/stats-workers/internal/httpapi/reactions.go"
line = 166
class = "restart-recovery"
severity = "medium"
observed = "Legacy vote cooldown, previous vote, SRem, SAdd and uservote writes are independent Redis commands with ignored write errors. Concurrent requests can both pass the cooldown read, and a partial failure can leave a wallet in multiple reaction sets or lose its previous vote while a later count succeeds. This live mutation has no PostgreSQL vote ledger or source from which to rebuild its Redis-only authority."
expected = "Acknowledged vote replacement must leave exactly one durable vote per wallet/pool, retain an idempotent operation result and survive partial failure and recovery without accepting an aggregate that disagrees with the vote."
proposal = "Move the legacy compatibility behavior onto the PostgreSQL reaction authority and operation ledger in services/launchpad/stats-workers/internal/httpapi/reactions.go, with Redis restricted to admission/cache. Exercise simultaneous replacements and failures between durable commit and cache publication, then restart and compare vote and tally."
owner_domain = 4
interface = "4.http-stats-workers-post-stats-pool-address-reactions"

