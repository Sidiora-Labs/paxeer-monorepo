[interface_review.redis_channels]
ids = ["4.go-shared-constants-channel-holders-update", "4.go-shared-constants-channel-platform-update", "4.go-shared-constants-channel-pressure-update", "4.go-shared-constants-channel-reactions-update", "4.go-shared-constants-channel-stats-update", "4.go-shared-redis-new-bounded-client", "4.go-shared-redis-new-client", "4.go-shared-redis-policy-snapshot-validate", "4.go-shared-redis-publish-json"]
agreement = "Declared channel constants are used for stats, holder, platform, pressure and reaction notification JSON, with tests reading real Redis subscriptions. Canonical state is PostgreSQL-backed and cache can be bypassed; Redis-only legacy reactions violate durable replacement as recorded."
