line = 39
class = "doc-drift"
severity = "medium"
observed = "The service catalogue still presents a separate sequencer with a synchronous standby and a private router, and line 45 advertises POST /rpc, /rpc/schema and /rpc/ws as the platform gateway surface. Its universal rule at line 28 also describes a pinned sequencer-key baseline. These are stated as current merged-service contracts."
expected = "The audit brief defines one BFT paxd network, committed-block receipt finality, node JSON-RPC at the root path and hosted px_ gateway methods; there is no independent sequencer service or unified LayerX router endpoint."
proposal = "Rewrite the topology and universal receipt rules in spec/layerx-merge/contracts/services.md from the current merged-network source, naming paxd commit verification and the real node-root and hosted gateway contracts. Keep historical topology explicitly historical and regenerate dependent architecture pages."
owner_domain = 8

