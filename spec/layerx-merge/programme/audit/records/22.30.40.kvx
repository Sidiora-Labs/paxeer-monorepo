[requirement_review.package]
ids = ["4301.1", "4302.1", "4303.1", "22998.1", "22076.1", "18946.1", "181528.1", "181182.1"]
source_agreement = "4301.1 and 4302.1 source arrays name existing files and their declared repository-root tests are present. 4303.1 rejects malformed frozen requests before database access. 18946.1 lowercases transaction pool addresses before lookup. 181182.1 authority tests use the restored sdk/launchpad/protocol/contracts/v1/chain fixtures."
qualification_boundary = "22998.1, 22076.1 and 181528.1 require their own recorded command, dependency/advisory or fresh-cache module evidence; this source-only package contains no lockfile/manifests and does not establish those external gates. The declared audit-record gate validates this record, not a standalone module or production capacity claim."
