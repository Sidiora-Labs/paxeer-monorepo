[finding.legacy_reaction_signature]
file = "services/launchpad/stats-workers/internal/httpapi/reactions.go"
line = 148
class = "security"
severity = "medium"
observed = "The production-registered legacy reactionsPost verifies only that wallet signed the caller-provided Message. Neither pool, reaction, HTTP action, environment, nonce nor expiry is compared with signed intent. An observed signature for any message can be reused after each cooldown to set or toggle that wallet vote on arbitrary pools, bypassing the operation binding enforced by the durable v2 route."
expected = "A wallet signature must authorize the specific vote action, target pool, body and environment with expiry and durable replay protection; a cooldown is not evidence that the wallet authorized a different reaction."
proposal = "In services/launchpad/stats-workers/internal/httpapi/reactions.go and internal/app/app.go, retire the legacy mutation through an explicit client migration or route it through the same signed operation, identity, policy and durable ledger as v2. Add negative cases that transplant a real signature across pool, reaction, method, expiry and nonce."
