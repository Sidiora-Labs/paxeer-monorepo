[finding.fee_fixture_wrong_units]
file = "services/launchpad/stats-workers/internal/store/platform_test.go"
line = 79
class = "test-gap"
severity = "medium"
observed = "TestPlatformMetrics seeds a buy fee of 5 and a sell fee of 3 and requires totalFees24h=8. The fixture omits fee asset/decimals, although the canonical producer charges buy fees in USDL and sell fees in the input token. This expected value endorses a sum of unlike raw quantities."
expected = "A platform fee fixture must preserve canonical asset identities and decimals and assert separated totals or a qualified quote value; a fixture cannot establish a unitless cross-asset sum."
proposal = "In services/launchpad/stats-workers/internal/store/platform_test.go, derive fee expectations from real canonical buy/sell fills for differently scaled assets and check the resulting HTTP contract. Preserve strict equality for each declared asset total and add rejection of incomplete conversion evidence."
owner_domain = 4
interface = "4.http-stats-workers-get-stats-platform"

[finding.pressure_fixture_wrong_leg]
file = "services/launchpad/stats-workers/internal/store/platform_test.go"
line = 126
class = "test-gap"
severity = "medium"
observed = "TestPressureStats seeds a sell amount_in of 10 through insertTxFull, which fixes amount_out to 0, and requires SellVolume1h=10 at line 140. Real canonical sell input is token units and its USDL output is the settlement notional, so this fixture asserts the wrong producer leg."
expected = "Pressure test data must carry both real token input and USDL output with unequal values, and expected sell notional must use the settlement leg in the same units as buy notional."
proposal = "In services/launchpad/stats-workers/internal/store/platform_test.go, seed full canonical buy/sell transactions with nonzero distinct token and USDL legs, then assert exact settlement volume through both Store.PressureStats and the registered pressure route."
owner_domain = 4
interface = "4.http-stats-workers-get-stats-pool-address-pressure"

[finding.public_search_fixture_disconnect]
file = "services/launchpad/stats-workers/internal/search/search_test.go"
line = 112
class = "test-gap"
severity = "medium"
observed = "Public search database tests insert generation/documents/visibility v1 rows directly, while integrated/projection tests and app startup exercise only v2 source and authority tables. No test feeds the production canonical search consumer and then queries the registered public /v2/search route, allowing the disconnected index to pass its isolated tests."
expected = "The public search acceptance path must use the same canonical producer, durable transport, generation activation and current visibility authority as the running service, with its frozen DTO validated at the caller."
proposal = "In services/launchpad/stats-workers/internal/search/search_test.go and internal/app integration tests, deliver real canonical creation, metadata and moderation events, activate the real generation and query /v2/search via core-api. Include restart, visibility withdrawal and cursor continuity without manually seeding a second schema."
owner_domain = 4
interface = "4.http-stats-workers-get-v2-search"

[finding.capacity_pause_slo_conflict]
file = "services/launchpad/stats-workers/internal/analytics/phase2_capacity_test.go"
line = 1074
class = "test-gap"
severity = "medium"
observed = "phase4PauseWorker sends SIGSTOP for 30 seconds to the sole pinned stats role 10 seconds into measurement. Concurrent phase4HTTP has a two-second timeout, includes every measured GET in its latency/failure totals and requires zero failures with p99 <=400ms. On the single-stats-process deployment serving that origin, suspending the whole daemon necessarily violates these gates instead of testing consumer-only backlog recovery."
expected = "A recovery qualification must name the actual failed component and served topology and keep valid availability/latency assertions consistent with that fault; steady-state throughput evidence cannot assume a suspended origin keeps serving."
proposal = "In services/launchpad/stats-workers/internal/analytics/phase2_capacity_test.go, bind the origin to verified serving processes and inject a consumer-only failure when reads must remain available, or qualify an explicitly redundant serving topology. Keep the existing read SLOs and require measured backlog catchup and durable-state equality after recovery."
owner_domain = 4
interface = "4.cli-stats-workers-statsd"

[finding.service_retired_topology]
