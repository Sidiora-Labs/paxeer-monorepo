[finding.1]
file = "docker/human-service/entrypoint.sh"
line = 205
class = "retired-reference"
severity = "medium"
observed = "The security role waits for /run/human-material/trust-history, validates it and copies it to the private directory at line 240 before starting the security provider. A deployment without this retired material waits indefinitely."
expected = "Requirement 8358.1 removes handover and trust-history copies from the human-service entrypoint; merged-network startup must use the current committed-node evidence configuration."
proposal = "Remove the trust-history prerequisite and copy from docker/human-service/entrypoint.sh together with the owning security provider deployment configuration; provision the merged-network receipt and consensus authority instead and prove startup without the retired file."
owner_domain = 16
interface = "16.cli-dock-human-service-entrypoint"

[finding.2]
file = "docker/human-service/entrypoint.sh"
line = 139
class = "restart-recovery"
severity = "medium"
observed = "The agent role installs every material journal file over the private journal on every start. It neither distinguishes first initialization from restart nor compares the seed with newer durable records already present."
expected = "A restart must preserve the latest acknowledged submissions, reservations and audit journal rather than replacing them with older bootstrap material."
proposal = "Make docker/human-service/entrypoint.sh initialize the agent journal only once using an explicit durable bootstrap marker, preserve existing journal records, and refuse conflicting seed data; prove a restart after the journal has advanced."
owner_domain = 16
interface = "16.cli-dock-human-service-entrypoint"

[finding.3]
file = "services/agent/crates/layerx-agentd/src/cache.rs"
line = 31
class = "security"
severity = "medium"
observed = "CacheValue::from_receipt, from_inclusion and from_checkpoint accept arbitrary core_bytes independently of the verified evidence, then attach that evidence's level and identifier. revalidate and Controller::serve_cached can return unrelated bytes carrying a verified claim."
expected = "The cache's declared verified-value boundary must bind the served canonical payload to authenticated evidence, including when serving degraded reads."
proposal = "Change services/agent/crates/layerx-agentd/src/cache.rs to derive the cached payload from the verified object or validate its authenticated digest before construction, then add byte-substitution refusals through revalidate and degraded serving."
owner_domain = 9
interface = "9.rs-agentd-cache-cachevalue-j43"

[finding.4]
file = "services/agent/crates/layerx-agentd/src/cache.rs"
line = 171
class = "runtime-risk"
severity = "medium"
observed = "EvidenceCache::insert charges only core_bytes toward maximum_bytes_per_tenant while retaining an unbounded Vec key. revalidate also allocates a new metrics entry for every missing TenantId, outside the entry and byte quotas."
expected = "Tenant cache limits must bound actual retained memory and tenant metadata; misses and oversized keys must not bypass admission."
proposal = "Bound key length, charge key and value storage, and require bounded tenant admission in services/agent/crates/layerx-agentd/src/cache.rs; exercise oversized keys and many distinct miss-only tenants."
owner_domain = 9
interface = "9.rs-agentd-cache-evidencecache-j43"

[finding.5]
file = "services/agent/crates/layerx-agentd/src/degraded.rs"
line = 303
class = "runtime-risk"
severity = "medium"
observed = "enter marks a Ready observation Behind when its height or rung regresses, but then replaces controller.reference and maximum_rung with the regressed observation. An identical second Ready observation becomes Healthy and admits writes without catching up."
expected = "A node that has regressed below the last trusted reference must remain write-blocked until it recovers that reference and the required finality."
proposal = "Preserve a trusted high-water reference separately from the current observed reference in services/agent/crates/layerx-agentd/src/degraded.rs; prove repeated regressed observations remain Behind and only actual catch-up restores write readiness."
owner_domain = 9
interface = "9.rs-agentd-degraded-enter-j43"

[finding.6]
file = "services/agent/crates/layerx-agentd/src/finality.rs"
line = 326
class = "security"
severity = "high"
observed = "augment_verified and SubmissionProgress::observe_block associate a receipt with a verified commit using only block number. Neither checks that receipt.tx_hash is included in the committed block or binds receipt evidence to an authenticated block root; a different block at the same height can promote the receipt to Committed."
expected = "A Committed submission must round-trip its exact transaction and receipt through inclusion evidence authenticated by the consensus commit, not merely share a height with that commit."
proposal = "Require authenticated transaction or receipt inclusion tied to the committed CometBFT header in services/agent/crates/layerx-agentd/src/finality.rs before promotion; reject empty-block, foreign-transaction and same-height conflicting-block evidence and retain that binding across restart."
