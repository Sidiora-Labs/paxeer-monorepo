[finding.node-root-rejected]
file = "services/platform/middleware/seller/src/rpc.ts"
line = 59
class = "interface-mismatch"
severity = "high"
observed = "PaymentRpc requires URL.pathname to equal /rpc. A configured public node such as https://api-mainnet-beta.paxeer.network/ is refused before eth_sendRawTransaction or pax_sequencerReceipt can run."
expected = "Brief facts 2 and 3 put public node JSON-RPC at the root path and retire the unified /rpc endpoint. The seller RPC client must round-trip with that node."
proposal = "In services/platform/middleware/seller/src/rpc.ts accept the node root URL and keep authentication, redirect, deadline and body bounds; route hosted gateway methods through a separate client and prove both origins."
owner_domain = 8
interface = "8.ts-middleware-seller-rpc-paymentrpc-j41"

[finding.daemon-submission-shape]
file = "services/platform/middleware/agent/src/daemon.ts"
line = 143
class = "interface-mismatch"
severity = "high"
observed = "decodeDaemonSubmission requires top-level tx_hash/submission/receipt, inner verification_level with PascalCase values and no inner tx_hash; it rejects Committed state. The real agent_rpc_dispatch.rs decode_observation emits activity_id, inner tx_hash and lowercase rung, and supports Committed; decode_eip1559_submission emits a flat preparation_ref/state/signed_receipt/tx_hash result."
expected = "Submit and tracking responses must retain actual producer fields, enum spellings and terminal states across submission, restart and recovery, as required by the brief and reqs 8253 and 8331."
proposal = "In services/platform/middleware/agent/src/daemon.ts decode the separate submit and observation contracts emitted by services/agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs, resolve trusted receipt keys explicitly, and exercise real producer serialization through transport and resumed tracking."
owner_domain = 8
interface = "8.ts-middleware-agent-sidiora-layerx-agent-middleware-decodedaemonsubmission"

[finding.jvm-native-prepare-shape]
file = "sdk/platform/generators/generate_jvm.py"
line = 42
class = "interface-mismatch"
severity = "high"
observed = "agent_plane overwrites NativePrepareResultV1 with chainId, nonce, gas, to and data and replaces operation.prepare.response. The native_v1 producer dispatches NativePrepareResultV1Wire, whose required version, preparation_id, canonical_bytes, signing_preimage, activity, approval_required and approval_id are declared in services/agent/schema/agent-api/v1.kvx:811."
expected = "Generated native prepare results must preserve the public versioned producer record, including approval and signing disclosure. A separate EIP-1559 preparation contract must preserve its own fee and signing fields."
proposal = "In sdk/platform/generators/generate_jvm.py generate NativePrepareResultV1 from its declared schema rather than substituting TRANSACTION_FIELDS, model EVM preparation separately, and round-trip an actual native daemon answer into the JVM client."
owner_domain = 8
interface = "8.cli-sdkgen-generate-jvm-py"

[finding.buyer-draw-recipient]
file = "services/platform/middleware/buyer/src/index.ts"
line = 1041
class = "interface-mismatch"
severity = "high"
observed = "grantDrawTransaction compares draw calldata bytes 36..68 to paymentPayer; captureSettlement also compares PaymentDrawn.from to those bytes. precompiles/layerxledger/abi.json calls the second argument recipient, so ordinary grant payments with distinct payer and seller cannot bind correctly."
