[finding.explorer-retired-transport]
file = "apps/web/src/explorer/client.ts"
line = 109
class = "interface-mismatch"
severity = "high"
observed = "receiptRecord, accountActivityPage, programRecord, unifiedAccount and resolveName request /v1/explorer/receipts, /v1/explorer/accounts, /v1/programs, /v1/accounts/{id}/unified and /v1/programs/{id}/reads/resolve. Their layerx-explorer-index producer is deleted and registry rows 10.http-explorer-account-unified and 10.http-explorer-program-resolve are retired. The configured native explorer instead registers /api/v2/addresses/:address_hash_param/unified in api_router.ex:262; its archive receipts are under /api/v2/paxeer-x/archive. Changing the configured origin cannot make these paths round-trip."
expected = "The web explorer must read the native merged-network explorer and registered program/transaction interfaces. Requirement 14041 preserves an origin rule but its frozen /v1 path conflicts with the retired producer; origin tests alone do not establish a live transport."
proposal = "In apps/web/src/explorer/client.ts and the native explorer routing owner, replace each removed index call with an explicitly declared native address, transaction or program read. Carry actual not-found, unavailable and cursor refusal responses into the page model; resolve naming through a registered program read. Update the conflicting 14041/14042 contract paths and prove every reader against the real native HTTP producer. Do not restore a separate explorer-index service."
owner_domain = 14
interface = "14.ts-web-explorer-client-receiptrecord"
related_interfaces = ["10.http-explorer-account-unified", "10.http-explorer-program-resolve", "14.ts-web-explorer-client-programrecord", "14.ts-web-explorer-client-unifiedaccountavailability", "14.ts-web-explorer-client-resolvename"]

[finding.native-unified-shape]
file = "apps/web/src/explorer/model.ts"
line = 563
class = "interface-mismatch"
severity = "high"
observed = "UnifiedAccountRecord and its availability decoder require requested/canonical/evidence, balances.items, split paxeer_activity and layerx_activity, settlement and batch/checkpoint freshness. The real unified_account_controller.ex emits identities {evm,pax,did}, balances [{asset,total}], committed activity rows and next_page_params.cursor plus page_cursor/first_page_cursor/page_number/activity_total. A successful native response is rejected; numeric before/before_block pagination also cannot preserve the native account-bound signed cursor, one-hour expiry, snapshot and reorg checks."
expected = "The model, transport query, page rendering and native unified account projection must share names, types, amount encodings, committed status, opaque cursor lifecycle and refusal semantics end to end."
proposal = "In apps/web/src/explorer/model.ts, client.ts and app/explorer/accounts/[accountId]/page.tsx, introduce the native unified-account contract and map balances and committed activity without inventing split settlement facts. Forward opaque next_page_params cursors unchanged, reset expired or invalidated snapshots explicitly, and prove native producer to HTTP to decoded account page including expiry, restart and reorg refusal."
owner_domain = 14
interface = "14.ts-web-explorer-model-decodeunifiedaccountavailability"
related_interfaces = ["10.http-explorer-account-unified"]

[finding.explorer-retired-finality]
file = "apps/web/src/explorer/model.ts"
line = 5
class = "retired-reference"
severity = "medium"
observed = "ExplorerFreshness, CheckpointRecord, BatchRecord and UnifiedSettlement model observedSealedBatch, observedFinalisedCheckpoint, batchesBehind, finalizedBatch and anchorStatus as live network facts. UnifiedBalanceRecord also keeps custody/paxeer/layerx partitions. Retired explorer-kernel-views and the old index no longer supply this live settlement model."
expected = "A live merged-network receipt is final when its block commits. Historical pre-merge batch and settlement evidence must be explicitly archived and must not define current account freshness or funding partitions."
proposal = "Replace the live types and encoders in apps/web/src/explorer/model.ts with committed block/address facts from the native explorer; move genuine old batch/checkpoint and custody records behind an explicit historical archive contract, and migrate active page consumers together."
owner_domain = 14

[finding.retired-explorer-receipt-link]
file = "apps/web/src/explorer/links.ts"
line = 29
class = "retired-reference"
severity = "medium"
observed = "explorerLinkPath still returns /paxeer-x/receipts/{receiptId} for a valid receipt target. The native explorer removed this public receipt surface with explorer-kernel-views; current native links use transaction/address pages and explicit archive API paths. No live application importer beyond the client helper was found, so this is an exported broken link contract rather than evidence of failed transaction execution."
expected = "An exported explorer link must land on a registered native page with the correct identifier, and historical receipt navigation must identify an actual archive destination."
proposal = "In apps/web/src/explorer/links.ts and its client helper, resolve a current receipt to its transaction hash and native /tx route. If historical receipt browsing is retained, declare and implement an explicit archive destination before emitting its URL; retain the existing identifier and origin checks."
owner_domain = 14
interface = "14.ts-web-explorer-links-explorerlinkpath"

[finding.retired-freshness-presentation]
file = "apps/web/src/explorer/components.tsx"
line = 59
class = "retired-reference"
severity = "medium"
observed = "FreshnessDisplay presents observed sealed batches, batchesBehind and indexed checkpoints as current freshness. MirrorFreshnessDisplay at line 68 additionally exposes batch lag and checkpoint canonicality after the mirror-verification route was retired. The active unavailable/not-found components reuse this vocabulary."
expected = "Current explorer freshness should describe indexed committed blocks and genuine source availability; archived settlement or mirror facts should only appear in an explicitly historical context."
proposal = "Update apps/web/src/explorer/components.tsx and its copy keys to present native committed/indexed positions and explicit stale/unavailable states, and remove the unused mirror display or place it under a genuine archive consumer."
owner_domain = 14

[finding.program-unearned-finality]
file = "apps/web/src/app/explorer/programs/[programId]/page.tsx"
line = 41
class = "security"
severity = "medium"
observed = "Every decoded program fact and value account receives a hardcoded checkpoint-finalised badge, and ExplorerFreshness is always current at line 55. ProgramRecord supplies observed_at, sequence, receipt digest and state root but no independently established achieved verification level or comparison establishing currentness. The HTTP decoder alone does not perform receipt verification."
expected = "The page must distinguish reported program observations from verified committed evidence and must not assign stronger finality or freshness than the producer and verification path establish."
proposal = "In apps/web/src/app/explorer/programs/[programId]/page.tsx, derive verification and currentness from authenticated committed evidence and the observed head. Until such evidence exists, label the data as reported and show its observation position and age without a finality badge."
owner_domain = 14

[finding.abi-array-allocation]
file = "apps/web/src/api/abi-read.ts"
line = 189
class = "runtime-risk"
severity = "medium"
observed = "tail decodes a dynamic array count with offset and allocates Array.from({length}) before verifying that count times the element head size fits the remaining response. offset bounds the count only by the entire byte buffer, allowing a malformed but bounded RPC response to allocate millions of entries before sequence detects truncated elements."
expected = "Untrusted ABI lengths must be checked against the available element head and safe arithmetic before allocation or iteration, with canonical offsets and bounded decoding work."
proposal = "In apps/web/src/api/abi-read.ts, validate the array head extent with overflow-safe multiplication and remaining-byte bounds before constructing entries; apply a declared decoding work bound and canonical offset checks, and exercise malformed dynamic arrays through the real view decoder."
owner_domain = 14
interface = "14.ts-web-api-abi-read-decodeabiresult"

[finding.rpc-response-memory-bound]
file = "apps/web/src/api/gateway.ts"
line = 91
class = "runtime-risk"
severity = "medium"
observed = "rpc awaits response.text() in full and checks MAX_RESPONSE_BYTES only afterwards. The comparison uses JavaScript string length instead of received UTF-8 bytes, so a large upstream response consumes memory before the advertised nine-MiB boundary is enforced and multibyte text is counted inconsistently."
expected = "The RPC adapter must enforce its byte boundary while receiving the body and cancel oversized responses within the request deadline, before JSON parsing and large allocations."
proposal = "Read the response body as a bounded byte stream in apps/web/src/api/gateway.ts, cancel when the byte budget is exceeded, retain the deadline across body consumption, and then decode UTF-8 and JSON with the existing envelope and identifier checks."
owner_domain = 14

[finding.rum-orphaned-temporary]
file = "apps/web/src/api/performance-sink.ts"
line = 353
class = "restart-recovery"
severity = "medium"
observed = "persistDurably writes and syncs a private .json.tmp before rename. Process death can leave that file behind. durableSnapshot ignores it only for ACTIVE_TEMPORARY_MS, then throws on every snapshot; performanceSinkSnapshot returns degraded health and empty aggregates. pruneSeries only prunes final records and never recovers the stale temporary, so committed observations remain unreadable indefinitely after this crash window."
expected = "Reopening the durable sink after a crash must retain committed observations and handle incomplete private temporary files without permanently suppressing all aggregates."
proposal = "Add safe orphan recovery in apps/web/src/api/performance-sink.ts that validates ownership and distinguishes active writes from abandoned temporaries, quarantines or removes only incomplete records, and continues reading committed records. Prove recovery after termination before rename and after reopening the same private directory."
owner_domain = 14

[finding.bridge-wide-log-scan]
file = "apps/web/src/api/precompiles.ts"
line = 44
class = "runtime-risk"
severity = "medium"
observed = "recentLogs requests one eth_getLogs range covering up to 50,000 blocks. BridgeOut history scans all events before recipient filtering, while the gateway deadline is eight seconds. Large scans are already a recorded RPC pitfall in GOTCHA.kvx and can repeatedly make otherwise available bridge history appear unavailable as chain traffic grows."
expected = "Account history reads must have bounded per-request work and resumable coverage rather than requiring a single large node log scan to finish inside a short UI deadline."
proposal = "In apps/web/src/api/precompiles.ts, query supported indexed account history or chunk logs into bounded block windows with explicit upper boundaries, stable ordering, deduplication and a continuation cursor. Preserve visible partial/unavailable states and verify the real node query behavior on a busy range."
owner_domain = 14

[finding.launchpad-first-page-only]
file = "apps/web/src/app/launchpad/page.tsx"
line = 68
class = "wiring-gap"
severity = "medium"
observed = "The page always calls launchpadMarkets(0n, PAGE_SIZE), where PAGE_SIZE is 50, and shows the full market count. No offset, cursor, search or next-page control reaches later markets, and LaunchpadActions receives only that first set. Existing markets after the first fifty cannot be selected from this page."
expected = "Users must be able to discover and act on every listed launchpad market through bounded navigation while the displayed count describes the same reachable collection."
proposal = "Add stable market pagination or indexed search in apps/web/src/app/launchpad/page.tsx and launchpad-client.tsx, preserving the active account and query when navigating; expose subsequent pools and verify selecting a pool beyond the first fifty against the real producer."
owner_domain = 14

[finding.program-fixture-proof]
file = "apps/web/src/explorer/program-contract.test.ts"
line = 7
class = "test-gap"
severity = "medium"
observed = "projection constructs a program response entirely inside the decoder test, including verified source metadata, timestamps and digests. It never starts or calls the real program producer. The separate proof_explorer server also hand-builds the old explorer response, so these assertions cannot expose the removed /v1 producer or establish requirement 21142 real-path agreement."
expected = "Program interface qualification must drive the real registered producer through HTTP into the client and rendered observable result; local malformed-input assertions remain useful but do not establish that path."
proposal = "Keep the strict decoder assertions in apps/web/src/explorer/program-contract.test.ts and add the owning real native program HTTP-to-client-to-page proof, covering source metadata, cross-program refusal, malformed commitments and actual not-found responses without a test-owned substitute producer."
owner_domain = 14

[finding.approval-operation-digest]
file = "apps/web/src/journeys/approvals/model.ts"
line = 185
