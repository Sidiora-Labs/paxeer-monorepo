[finding.receipt-committed-rung]
file = "sdk/platform/swift/Sources/LayerXSDK/Verifier.swift"
line = 699
class = "interface-mismatch"
severity = "high"
observed = "verifySequencerJSON requires rung receipted. rpc/sequencer_receipt.go:173-199 changes the response to committed after block commit, and ProgramsClient.activity passes it unchanged, so a settled transaction fails verification."
expected = "The pax_sequencerReceipt signed fields remain verifiable at both receipted and committed rungs; committing a block must not make its receipt unreadable."
proposal = "Update sdk/platform/swift/Sources/LayerXSDK/Verifier.swift to validate common signed fields at both producer rungs and validate commitment evidence separately before raising verification; prove one real transaction before and after commit."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.receipt-payment-denom]
file = "sdk/platform/swift/Sources/LayerXSDK/Verifier.swift"
line = 733
class = "interface-mismatch"
severity = "high"
observed = "The verifier hashes feeDenom and compares it with ProtocolReceipt.asset. rpc/sequencer_receipt.go:560-569 binds asset to paymentDenom, explicitly allowing the payment and fee denominations to differ."
expected = "The summary fee currency and the signed payment asset have independent bindings, and valid different-currency transactions must round-trip."
proposal = "Validate feeDenom against the signed summary and paymentDenom against asset independently in sdk/platform/swift/Sources/LayerXSDK/Verifier.swift; prove real transfer and revert receipts with different payment and fee denominations."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.portable-receipt-fields]
file = "sdk/platform/swift/Sources/LayerXSDK/PortableReceipt.swift"
line = 116
class = "interface-mismatch"
severity = "high"
observed = "verifyReceipt requires an exact receiptJson key set without paymentDenom, emitted by the current node, or blockNumber and blockHash, added on commit. Export and import reject actual node response objects."
expected = "Portable receipt v2 must preserve and validate the current node receipt shape and its payment asset and committed metadata through transport."
proposal = "Align the exact versioned receiptJson schema in sdk/platform/swift/Sources/LayerXSDK/PortableReceipt.swift with rpc/sequencer_receipt.go; prove cross-language portable export and import using actual receipted and committed RPC responses."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.committed-chain-trust]
file = "sdk/platform/swift/Sources/LayerXSDK/Committed.swift"
line = 204
class = "security"
severity = "high"
observed = "Committed.verify checks validatorSet against the same supplied header and its signatures. PortableReceipt.verify:92-106 reads both headers and validator sets from the bundle; independent input pins only the receipt signer, not the consensus chain."
expected = "A committed result must authenticate inclusion on the configured chain under independently trusted consensus history; internally consistent self-signed headers are insufficient."
proposal = "Require an independent chain ID and trusted consensus checkpoint or verified validator history in sdk/platform/swift/Sources/LayerXSDK/Committed.swift and PortableReceipt.swift; reject an attacker chain embedding a genuine receipted transaction."
owner_domain = 8

[finding.deploy-payload-limit]
file = "sdk/platform/swift/Sources/LayerXSDK/NativeProgramLifecycle.swift"
line = 374
class = "runtime-risk"
severity = "medium"
observed = "validateLifecycleWasm permits 1048576 WASM bytes and NativeProgramDeploy adds the envelope and optional interface without enforcing the complete deployment payload ceiling."
expected = "Decision 2483 and brief fact 6 cap the deployment payload at 524288 bytes including its 104-byte envelope."
proposal = "Enforce the full encoded size in sdk/platform/swift/Sources/LayerXSDK/NativeProgramLifecycle.swift; cover exactly 524288 bytes and the first rejected byte with envelope and interface overhead while retaining hash and ABI checks."
owner_domain = 8
interface = "8.go-sdkswift-nativeprogramdeploy-init"

[finding.programs-inert-constructor]
file = "sdk/platform/swift/Sources/LayerXSDK/Programs.swift"
line = 403
class = "wiring-gap"
severity = "medium"
observed = "The public ProgramsClient(client:sequencerPublicKey:...) initializer validates arguments but discards them, installing rpc=nil and empty receiptKeys; its operations subsequently throw protocolIncompatibility."
expected = "Successful client construction must expose usable advertised operations, or explicitly report migration when a retired configuration is supplied."
proposal = "Make the retired initializer explicitly unavailable with migration to rpcURL, sender and receiptKeys in sdk/platform/swift/Sources/LayerXSDK/Programs.swift, or provide a fully configured supported path and prove its public operations."
owner_domain = 8

[finding.programs-sequence-recovery]
file = "sdk/platform/swift/Sources/LayerXSDK/Programs.swift"
line = 382
class = "restart-recovery"
severity = "medium"
observed = "ProgramsClient retains one immutable prevSeqHash, default zero, and reuses it for every receipt at line 617. Subsequent or interleaved transactions require a different authenticated predecessor; no progress or recovery mechanism is provided."
expected = "A reusable client must resolve sequence context appropriate to each receipt, including interleaved transactions and restart, without weakening the chain hash check."
proposal = "Provide authenticated per-transaction chain context and a durable or caller-supplied recovery mechanism in sdk/platform/swift/Sources/LayerXSDK/Programs.swift; prove consecutive and interleaved receipts across client restart."
owner_domain = 8

[finding.program-rpc-response-bound]
file = "sdk/platform/swift/Sources/LayerXSDK/Programs.swift"
line = 87
class = "runtime-risk"
severity = "medium"
observed = "ProgramRPC uses URLSession.data(for:) and parses JSON after allocating the entire body, so a faulty configured RPC can return an arbitrarily large receipt or transaction response."
expected = "Network data must be bounded before allocation and decoding, consistent with the SDK limits on transaction and receipt bytes."
proposal = "Use bounded response streaming and cancel oversized requests in sdk/platform/swift/Sources/LayerXSDK/Programs.swift; retain typed transport errors and prove rejection of an oversized actual HTTP response."
owner_domain = 8

[finding.stream-memory-and-pacing]
file = "sdk/platform/swift/Sources/LayerXSDK/Stream.swift"
line = 52
class = "runtime-risk"
severity = "medium"
observed = "ResumableStream keeps every historical event ID, and events(from:) uses the default unbounded AsyncThrowingStream buffer while immediately polling again on empty pages."
expected = "Long-lived human streams need bounded replay memory, consumer backpressure and empty-page pacing while preserving cursor order and recovery."
proposal = "Define bounded replay and demand behavior in sdk/platform/swift/Sources/LayerXSDK/Stream.swift, pace empty pages and surface overflow with a resumable cursor; prove a slow consumer remains bounded without silent event loss."
owner_domain = 8

[finding.legacy-lifecycle-verification]
file = "sdk/platform/swift/Sources/LayerXSDK/Verifier.swift"
line = 229
class = "retired-reference"
severity = "medium"
observed = "verifyProgramLifecycleReceipt still decodes kernel receipts with sequencerOnly:false and returns sequencer-signed, outside the current receipted and committed verification rungs."
expected = "Requirement 8503 retires kernel batch and checkpoint verification; lifecycle outcomes must bind a pinned sequencer receipt to the retained EVM transaction."
proposal = "Retire the legacy successful verifier in sdk/platform/swift/Sources/LayerXSDK/Verifier.swift and migrate callers to current sequencer receipts, retaining explicit old-kernel refusals and proving a live lifecycle transaction."
owner_domain = 8
interface = "8.go-sdkswift-localverifier-verifyprogramlifecyclereceipt"

[finding.legacy-http-status-decoder]
file = "sdk/platform/swift/Sources/LayerXSDK/Transport.swift"
line = 90
class = "dead-code"
severity = "low"
observed = "The unavailable AgentHTTPTransport retains a private legacy decoder with uppercase SequencerSigned states alongside the current lowercase AgentEnvelopeTransport verifier."
expected = "Unused retired transport vocabulary should not appear to be an alternative supported verification contract to the current daemon envelope."
proposal = "Remove the unreachable legacy decoder from sdk/platform/swift/Sources/LayerXSDK/Transport.swift after confirming callers; retain explicit retired transport refusal and the legitimate daemon POST /rpc envelope path."
owner_domain = 8

[finding.program-pending-test]
file = "sdk/platform/swift/Tests/LayerXSDKTests/ProgramsContractTests.swift"
line = 24
class = "test-gap"
severity = "medium"
observed = "The positive pending-receipt test constructs the retired ProgramsClient with a transport that always throws, then requests sequencer-signed instead of a current rung."
expected = "Requirement 181264 resolves the retained transaction through the supported RPC client; a positive pending test must reach that consumer with current rungs."
proposal = "Rewrite sdk/platform/swift/Tests/LayerXSDKTests/ProgramsContractTests.swift pending coverage around the live retained-transaction receipt path, preserving expected-activity mismatch refusals and asserting a genuine pending response."
owner_domain = 8

[finding.program-abi-five-test]
file = "sdk/platform/swift/Tests/LayerXSDKTests/ProgramsContractTests.swift"
line = 169
class = "test-gap"
severity = "medium"
observed = "The lifecycle bounds test explicitly expects guestABI 5 to throw and tests positive ABIs only through 4, while ProgramGuestABI declares v5 and the codec admits it."
expected = "ABI admission tests must match the current declared ABI set and reject genuinely unsupported versions rather than a supported version."
proposal = "Prove ABI 5 with its required interface and actual registration path in sdk/platform/swift/Tests/LayerXSDKTests/ProgramsContractTests.swift; retain zero and unknown ABI refusals and the existing hash and size bounds."
owner_domain = 8

[finding.program-old-status-test]
file = "sdk/platform/swift/Tests/LayerXSDKTests/ProgramsContractTests.swift"
line = 49
class = "test-gap"
severity = "medium"
observed = "The status matrix uses uppercase Unverified and SequencerSigned envelopes, and discovery cases assert sequencer-signed kernel proofs as successful verification."
expected = "Requirement 181256 uses lowercase achieved or unverified over submitted, receipted and committed; current producer responses must drive positive cases."
proposal = "Migrate the positive status and discovery cases in sdk/platform/swift/Tests/LayerXSDKTests/ProgramsContractTests.swift to actual daemon envelopes and current receipt proofs, retaining old labels only as negative cases."
owner_domain = 8

[finding.committed-test-trust]
file = "sdk/platform/swift/Tests/LayerXSDKTests/CommittedReceiptTests.swift"
line = 128
class = "test-gap"
severity = "medium"
observed = "The committed positive fixture creates local validator keys and committed-sdk-test headers, then supplies those validators to verification without testing an unrelated self-signed chain refusal."
expected = "Committed proof coverage must establish independent consensus trust and reject otherwise internally consistent evidence from another chain."
proposal = "Add real node committed evidence with independently pinned chain state to sdk/platform/swift/Tests/LayerXSDKTests/CommittedReceiptTests.swift and an attacker-validator refusal; retain voting-power and inclusion mutations."
owner_domain = 8

[finding.portable-test-producer-shape]
file = "sdk/platform/swift/Tests/LayerXSDKTests/PortableReceiptTests.swift"
line = 146
class = "test-gap"
severity = "medium"
