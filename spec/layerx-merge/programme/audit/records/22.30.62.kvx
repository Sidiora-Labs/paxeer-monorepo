[finding.sidiora-cap-genesis]
file = "modules/layerxbridge/keeper/msg_server.go"
line = 131
class = "interface-mismatch"
severity = "high"
observed = "SetCap creates types.Subdenom for an absent asset, including (SidioraHomeChainID, SidioraRemoteAddress). This stores the generic lxb denom; ExportGenesis emits it, but GenesisState.Validate requires AssetDenom for that pair to equal SidioraDenom and InitGenesis panics. TestSidioraPairIsRefusedOnceACapBoundItElsewhere demonstrates that the cap-first order currently succeeds."
expected = "The governance SetCap producer and bridge genesis consumer must agree on the canonical denom for every accepted asset. The canonical Sidiora pair must export and import as factory/<bridge>/usid, independent of a mistaken proposal order."
proposal = "In modules/layerxbridge/keeper/msg_server.go refuse a canonical Sidiora cap before its pair is registered, before creating any denom or mapping. Retain strict genesis validation; define an explicit governed migration for any existing generic mapping and its supply. Prove both proposal orders through governance, full application export and import, including the refusal and unchanged balances."
owner_domain = 6
interface = "6.go-lxbridge-types-genesisstate-j36"

[finding.sidiora-helper-home]
file = "modules/layerxbridge/keeper/sidiora.go"
line = 30
class = "runtime-risk"
severity = "medium"
observed = "EnsureSidioraDenom only checks that chainID is registered before storing usid against it. A direct call with chain 1 succeeds, although IsSidioraPair and GenesisState.Validate only permit usid on SidioraHomeChainID. RegisterSidioraPair validates the home chain, so this bypass is in the exported helper and its direct callers."
expected = "All exported keeper entry points that can create a Sidiora asset must enforce the same Solana home-chain invariant as MsgRegisterSidioraPair and the genesis decoder."
proposal = "In modules/layerxbridge/keeper/sidiora.go reject a non-SidioraHomeChainID before tokenfactory or bridge writes. Keep the message validation and add helper refusal, unchanged-store and exported-genesis validation assertions using the real tokenfactory keeper."
owner_domain = 6
interface = "6.msg-layerxbridge-registersidiorapair"

[finding.sidiora-fixture-chain]
file = "modules/layerxbridge/keeper/sidiora_test.go"
line = 24
class = "test-gap"
severity = "medium"
observed = "newSidioraSuite and TestSidioraDenomAndMetadata initialize usid with chainID=1 from keeper_test.go. Their successful mint, burn and metadata assertions operate on a mapping that the real genesis consumer rejects, rather than the Solana pair accepted by MsgRegisterSidioraPair."
expected = "Sidiora success fixtures must use the canonical pair emitted by the governance registration path; invalid foreign-chain mappings must be explicit refusal cases."
proposal = "Change the Sidiora success fixtures in modules/layerxbridge/keeper/sidiora_test.go to register SidioraHomeChainID through the actual message or governance path, retain mint/burn assertions, and assert ExportGenesis.Validate plus import. Add chain 1 as an explicit helper refusal without weakening validation."
owner_domain = 6
interface = "6.msg-layerxbridge-registersidiorapair"

[finding.cap-first-test-invariant]
file = "modules/layerxbridge/keeper/keeper_test.go"
line = 677
class = "test-gap"
severity = "medium"
observed = "TestSidioraPairIsRefusedOnceACapBoundItElsewhere accepts the cap-first transaction and only asserts that the later pair registration leaves the exported object unchanged. It never calls before.Validate, so it blesses a state that cannot be re-imported."
expected = "A successful governance mutation must preserve the bridge genesis invariants; a refusal test must also establish that the retained state is valid and recoverable."
proposal = "Update this test in modules/layerxbridge/keeper/keeper_test.go alongside the cap-order repair to assert the early cap refusal, no created denom or supply, valid exported state and successful subsequent canonical pair registration. Keep the existing no-write checks for refused calls."
owner_domain = 6
interface = "6.go-lxbridge-types-genesisstate-j36"

[finding.bridge-sidiora-reopen-proof]
file = "modules/layerxbridge/keeper/genesis_test.go"
line = 34
class = "restart-recovery"
severity = "medium"
observed = "TestGenesisRoundTripsTheRegisteredSidioraPair creates a fresh bridge overlay with bridgetestutil.NewKeeper on the same application and context. The overlay is backed by NewMemDB; tokenfactory and bank state are retained from the original app, and no persistent database is closed and reopened."
expected = "Brief check_5 and requirement 21088.1 require a real producer-to-genesis-consumer proof with persistent stop/reopen, including tokenfactory ownership, supply, balances and replay protection."
proposal = "Add a persistent full-application export/import test owned by modules/layerxbridge/keeper/genesis_test.go. Commit a mint and burn, close the application database, reopen or import the full bank/tokenfactory/bridge genesis, then assert balances, metadata, admin, duplicate inbound refusal and the next outbound nonce."
owner_domain = 6
interface = "6.go-lxbridge-types-genesisstate-j36"

[finding.bridge-general-reopen-proof]
file = "modules/layerxbridge/keeper/keeper_test.go"
line = 428
class = "restart-recovery"
severity = "medium"
observed = "TestGenesisRoundTrip exports nullifiers, in-flight supply and outbound nonce into a fresh bridge overlay on the same live app. Equality of JSON state is checked, but the imported keeper is never used to reject the old deposit or produce the next release after a database restart."
expected = "The bridge state lifecycle must preserve idempotence and release ordering through the actual durable store, not only equality of an exported struct."
proposal = "Extend the persistent bridge recovery coverage in modules/layerxbridge/keeper/keeper_test.go to commit, close and reopen a full application, replay the original attested deposit expecting ErrNullified, and burn again expecting nonce 2 and conserved bank supply. Preserve the existing struct round-trip test."
owner_domain = 6
interface = "6.go-lxbridge-types-outboundnonce-j36"

[finding.bridge-release-nonce-overflow]
file = "modules/layerxbridge/keeper/bridge.go"
line = 185
class = "runtime-risk"
severity = "medium"
observed = "BridgeOut burns the bridged coins and calculates OutboundNonce+1 without checking MaxUint64. GenesisState.Validate accepts that boundary nonce; the next release wraps to 0, and GetOutboundNonces omits a zero value, erasing the exhaustion state from export."
expected = "Outbound release nonces must remain monotonic across burns, exports and recovery. Exhaustion must refuse before coins are burned or in-flight supply is reduced."
proposal = "In modules/layerxbridge/keeper/bridge.go check the stored nonce against MaxUint64 before any bank or tokenfactory work and return a registered refusal. Add valid-genesis boundary and reopen tests proving that the exhausted nonce, balances and in-flight amount stay unchanged."
owner_domain = 6
interface = "6.go-lxbridge-types-outboundnonce-j36"

[finding.rewards-accepts-value]
file = "precompiles/distribution/distribution.go"
line = 122
class = "interface-mismatch"
severity = "high"
observed = "Execute dispatches RewardsMethod to rewards without ValidateNonPayable and without forwarding value. The ABI and Solidity expose rewards(address) as view. core/deps/geth/core/vm/evm.go transfers CALL value to 0x1007 before invoking the precompile; a valid rewards query succeeds and leaves that native value at the precompile address without a refund or withdrawal path."
expected = "Registry 6.pc-0x1007-rewards and Distribution.sol require a nonpayable view: a raw EVM CALL carrying any native value must revert and preserve caller and precompile balances."
proposal = "Add the nonpayable check to the current rewards dispatch in precompiles/distribution/distribution.go under an explicit activation/version decision that preserves historical replay. Prove a positive-value raw EVM transaction reverts with unchanged balances, a zero-value query still returns the real rewards tuple, and historical-height behavior remains pinned."
owner_domain = 6
interface = "6.pc-0x1007-rewards"

[finding.historical-rewards-value-v580]
file = "precompiles/distribution/legacy/v580/distribution.go"
line = 94
class = "runtime-risk"
severity = "medium"
observed = "The v580 rewards branch discards value and calls rewards without ValidateNonPayable, although its embedded rewards ABI is view. A historical raw CALL can therefore accept value for a query. This is frozen historical behavior, not a second current executor."
expected = "Historical execution must remain reproducible, while nonpayable-query hazards must be explicit and must not be copied into a newly served implementation."
proposal = "Keep precompiles/distribution/legacy/v580/distribution.go byte-compatible for historical replay. In precompiles/distribution tests pin its raw CALL payment behavior at its historical activation height, verify that live dispatch uses the repaired version after the chosen activation, and document the historical value hazard for clients."
owner_domain = 6
interface = "6.pc-0x1007-rewards"

