[finding.sidiora-doc-native-units]
file = "docs/site/docs/protocol/sidiora.md"
line = 21
class = "doc-drift"
severity = "medium"
observed = "The Sidiora page says the network coin base denom uhpx carries eighteen decimals. node/params/config.go registers uhpx at exponent 6, while modules/evm/state/utils.go converts one uhpx to 10^12 EVM value units. Reading the sentence as a bank-unit conversion mis-scales amounts by 10^12."
expected = "Sidiora remains six-decimal SID, and documentation must distinguish six-decimal bank uhpx from the eighteen-decimal native EVM value representation used by payable governance and other precompiles."
proposal = "Clarify docs/site/docs/protocol/sidiora.md line 21 with both unit systems: one whole network coin is 10^6 uhpx and 10^18 EVM value units; one uhpx is 10^12 EVM value units. Keep SID at 10^6 base units per coin and use explicit units in bridge and fee examples."
owner_domain = 6
