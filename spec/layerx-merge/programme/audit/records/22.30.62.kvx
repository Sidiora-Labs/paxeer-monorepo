class = "test-gap"
severity = "medium"
observed = "The success row named returns proposal id on submit parameter change proposal with multiple changes omits type from its JSON. RegisterProposalHandlers maps an empty type to TextProposalHandler, which ignores Changes; the test only checks a returned proposal ID and therefore passes after submitting a Text proposal."
expected = "A ParameterChange success test must assert the actual typed proposal and parameter values emitted by the JSON handler and accepted by governance, including execution of those changes."
proposal = "Set type to ParameterChange in this fixture in precompiles/gov/gov_test.go and assert stored content is ParameterChangeProposal with the intended quorum JSON. Execute the proposal through the real parameter handler and assert the resulting tally params; retain a separate explicit empty-type Text default test."
owner_domain = 6
interface = "6.pc-0x1006-submitproposal"

[finding.bridge-rest-trailing-json]
file = "modules/layerxbridge/client/cli/tx.go"
line = 241
class = "runtime-risk"
severity = "medium"
observed = "newBridgeProposalPostHandler enables DisallowUnknownFields but calls Decode only once and never checks for EOF. A valid envelope followed by another JSON value or trailing garbage is accepted; DecodeBridgeProposal checks EOF for the inner proposal. The standard API server already bounds the outer body with MaxBytesHandler."
expected = "The registered POST /gov/proposals/layerxbridge route should accept exactly one request envelope and reject bytes outside it, consistent with the strict proposal-file decoder."
proposal = "In modules/layerxbridge/client/cli/tx.go require a second decoder read to return io.EOF after the envelope. Add mounted-handler cases for whitespace, a second JSON object and trailing invalid bytes, preserving the unsigned transaction response and the API server body limit."
owner_domain = 6
interface = "6.rest-layerxbridge-gov-proposal"

