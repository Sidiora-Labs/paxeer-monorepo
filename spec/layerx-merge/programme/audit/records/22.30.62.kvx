line = 32
class = "doc-drift"
severity = "medium"
observed = "The ABI catalogue lists layerxanchor, layerxcustody and layerxverify functions, including checkpoint and sequencer authorization methods, without indicating that the merge retires those executors or that anchor reads end at store deletion. Readers see source ABI presence as current availability."
