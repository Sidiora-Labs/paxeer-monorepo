severity = "medium"
observed = "spec/layerx-merge/contracts/clients.md:13 claims every client operation is one of E/S/R/Q/B/W, and :17 describes every user write as an EIP-1559 transaction with DID binding. The shared-Go group at :319 includes this slice, but operation.go:62 signs KindleLaunch HTTP operation envelopes, ledger.go:60 atomically applies authorized PostgreSQL effects and replays by nonce/digest, contract.go:116 verifies EOA/ERC1271 proofs, and assertion.go:31 binds mTLS service assertions to identity and request digest. HTTP ticket/session clients and bodyless DELETE authorization are not any of the stated on-chain write/binding operations."
expected = "The client contract must distinguish wallet-authorized off-chain HTTP effects, session/ticket reads and service assertions from on-chain EIP-1559 writes, preserving each actual replay, audience, route, body and expiry binding."
proposal = "Amend spec/layerx-merge/contracts/clients.md operations/identity and launchpad-sdk-shared-go sections with the signed-operation, EIP-191/ERC1271, session-ticket and mTLS boundaries; attach real existing authorization/audit integration criteria separately from the unrelated preflight criteria at :346 and :347."
owner_domain = 4
observation_revision = "0f3fe6b8c5c1973c0e80408097cf66e06e40785f"

[finding.services-receipt-authority]
file = "spec/layerx-merge/contracts/services.md"
line = 28
class = "doc-drift"
severity = "medium"
observed = "spec/layerx-merge/contracts/services.md:28 applies separate sequencer ReceiptKeys admission to every service, and :39 lists that sequencer as private to a router; :346 makes platform-gateway the indexer dependency. The reviewed auth/reported_hash_backend.go:65 and auth/contract.go:67 instead bind wallet state to node-reported committed-block identities, while load/phase2_feeder.py:114 consumes ordinary eth_getTransactionReceipt on the node root. services.md:29 correctly requires signed chain writes, but its receipt and topology guidance would make operators provision an authority these launchpad paths do not call."
expected = "BRIEF network facts 1 through 3 require merged paxd BFT commit finality and node-root RPC, with hosted gateway methods distinguished from node receipt/state authority. Signature checks for wallet proofs, service assertions and webhook delivery are separate contracts."
proposal = "Amend spec/layerx-merge/contracts/services.md universal receipt rule, catalogue and launchpad dependencies to document the merged node and actual receipt/state verification paths, preserving named refusals and request/webhook signature checks; remove the separate sequencer/router requirement rather than adding it to launchpad consumers."
owner_domain = 4
observation_revision = "0f3fe6b8c5c1973c0e80408097cf66e06e40785f"

[finding.services-recovery-contract]
file = "spec/layerx-merge/contracts/services.md"
line = 347
class = "doc-drift"
severity = "medium"
observed = "spec/layerx-merge/contracts/services.md:347 and :352 reduce indexer recovery to re-indexing from the last committed height, and :379 through :384 list only market-topic/reserves ABI criteria. The shared slice requires actual PostgreSQL/object-store providers and source/deployment/decoder/ABI/code provenance in delivery/archive.go:55 and :61, leases and matching active generation state in replay.go:53, scoped shadow proof in shadow.go:103 and alias promotion in replay.go:254. The runtime constructs NewArchive at services/launchpad/indexer/internal/app/app.go:513 and invokes ReplayEngine.Rebuild at :557. A bare height restart omits the operational prerequisites and generation/readiness boundary."
expected = "Operators must know the archive provenance, durable generation/lease/alias state, shadow coverage and readiness/refusal conditions required for real recovery; ABI parity tests alone cannot establish restart, cutover or rollback qualification."
proposal = "Extend spec/layerx-merge/contracts/services.md#launchpad-indexer with the actual archive/rebuild inputs, generation and alias lifecycle, authority and failure behavior and owner-qualified restart/cutover criteria. Retain active-rebuild-restart and all related historical recovery findings until the owning domain supplies qualification evidence."
owner_domain = 4
observation_revision = "0f3fe6b8c5c1973c0e80408097cf66e06e40785f"

