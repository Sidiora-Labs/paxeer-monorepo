[finding.launchpad_code_probe]
file = "services/explorer/backend/apps/explorer/test/explorer/chain/paxeer_x/capabilities_test.exs"
line = 84
class = "interface-mismatch"
severity = "high"
observed = "The live-case matrix requires nonempty @bytecode from eth_getCode(0x1017) before snapshot.launchpad can become true. Capabilities uses @code_surfaces at capabilities.ex:73 and read_code/1 at :316. rpc/state.go:66 delegates to modules/evm/keeper/code.go:17, which reads stored EVM code; native dispatch in node/precompiles_v6120.go:44 works independently. modules/launchpad/keeper/surfaces.go:106 installs forwarding runtime at role addresses, excluding the native 0x1017 address. A working native launchpad can therefore be advertised as unavailable."
expected = "Registry 7.rpc-eth-getcode returns stored bytecode, not native method availability. The explorer must advertise a launchpad whose native methods answer. Requirement 18771.1 deliberately retains the launchpad code probe, but that retained choice does not establish native liveness under the finished-network model."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/capabilities.ex, probe a supported launchpad view such as getPoolCount() at the same explicit height as the other probes, validating its ABI result. Add a node-to-RPC-to-explorer case with empty stored code and a live launchpad view, plus refused and malformed responses; reconcile requirement 18771.1 with that native-service behavior."
owner_domain = 14
interface = "7.rpc-eth-getcode"

