[finding.1]
file = "services/interop/crates/layerx-x402/src/facilitator.rs"
line = 650
class = "interface-mismatch"
severity = "high"
observed = "settle_executed emits receipt, receiptDigest and verificationLevel, adding only blockNumber and blockHash for committed responses. Buyer::capture_settlement deserializes mandatory logs and requires proof for committed evidence, so a successful facilitator response cannot be captured by the buyer."
expected = "The facilitator, transport and buyer must exchange the same locally verifiable settlement evidence; a success response must retain the authenticated log view and the inclusion proof for its claimed rung."
proposal = "In layerx-x402/src/facilitator.rs and seller.rs share the evidence renderer, including canonical logs and committed proof. Prove facilitator settle through each transport into Buyer::capture_settlement for receipted and committed results."
owner_domain = 11
interface = "11.fmt-x402-layerx-evidence"

[finding.2]
file = "services/interop/crates/layerx-x402/src/buyer.rs"
line = 516
class = "interface-mismatch"
severity = "high"
observed = "capture_settlement selects PaymentDrawn and the 128-byte grant layout only when scheme equals metered. A subscription offer takes the PaymentExact branch, although seller::pay_drawn_matches accepts the subscription PaymentDrawn settlement."
expected = "Both supported grant schemes, metered and subscription, must bind grantId, idempotencyKey and purposeHash to the same native ledger PaymentDrawn event throughout seller and buyer."
proposal = "In layerx-x402/src/buyer.rs dispatch both grant schemes to the draw verifier and reject unsupported schemes explicitly. Add a subscription settlement produced by Seller and captured by Buyer, including wrong grant, purpose and reference refusals."
owner_domain = 11
interface = "11.rs-x402-buyer-capture-settlement"

[finding.3]
file = "services/interop/crates/layerx-x402/src/buyer.rs"
line = 656
class = "interface-mismatch"
severity = "high"
observed = "The buyer unhex helper accepts bare identifiers only when all letters are lowercase. PaymentRequirements::parse_hex32 accepts uppercase bare asset and payTo identifiers, and seller::matches_identifier compares them case-insensitively. A valid accepted offer can settle at the seller and fail buyer capture."
expected = "Every identifier representation accepted by the payment requirements model and seller must decode to the same 32 bytes at buyer capture, independently of hexadecimal letter case."
proposal = "Use the shared bounded 32-byte identifier parser in layerx-x402/src/buyer.rs, model.rs and seller.rs. Exercise lowercase and uppercase, prefixed and bare asset/payTo values through model validation, seller settlement and buyer capture."
owner_domain = 11
interface = "11.fmt-x402-payment-requirements"

[finding.4]
file = "services/interop/crates/layerx-x402/src/buyer.rs"
line = 246
class = "security"
severity = "high"
observed = "verify_committed_evidence obtains both validators and chainId from the untrusted PAYMENT-RESPONSE proof and passes them as the trust inputs to verify_committed. Receipt keys authenticate execution but do not authenticate that validator set. A genuine receipt can be placed in a privately signed consensus history and accepted as committed."
expected = "A committed claim for Paxeer must anchor the consensus chain identity and validator authority independently of the response being checked, including authorised validator-set changes."
proposal = "Extend the buyer trust configuration and capture boundary in layerx-x402/src/buyer.rs with a trusted consensus anchor for the offered network and validated set transitions. Reject response-selected chains and self-signed validator sets; retain receipt and inclusion checks."
owner_domain = 11
interface = "11.rs-x402-buyer-capture-settlement"

[finding.5]
file = "services/interop/crates/layerx-mirror/src/ethereum.rs"
line = 436
class = "restart-recovery"
severity = "high"
observed = "prepare_and_broadcast durably appends Prepared with TransactionIdentity::None before signing. After a crash in that window, advance routes the existing Prepared record to observe_stage, which immediately requires TransactionIdentity::Ethereum and returns Transaction on every restart."
expected = "A durable prepared publication that has never been signed or sent must resume its exact stage after restart without requiring manual journal replacement or losing publication progress."
proposal = "Handle Prepared explicitly in EthereumArchiveClient::advance and resume signing the persisted stage after checking its payload digest. Add process-reopen cases at Prepared, Signed and broadcast boundaries using the concrete client and journal."
owner_domain = 11
interface = "11.rs-mirror-ethereum-archive-client-advance"

[finding.6]
file = "services/interop/crates/layerx-mirror/src/solana.rs"
line = 483
class = "restart-recovery"
severity = "high"
observed = "prepare_and_broadcast persists Prepared with no transaction identity before sign_transaction. advance resumes that record in observe_stage, whose Solana identity pattern fails immediately. A restart between the durable preparation and signed append permanently stalls this archive stage."
expected = "Solana mirror publication must recover every persisted pre-broadcast state and continue with a valid blockhash while preserving the stage payload and archive commitment."
proposal = "Route Prepared to a verified resume-signing path in layerx-mirror/src/solana.rs. Reopen the real journal at each signing and broadcast boundary, and prove that the intended manifest/chunk/finalize instruction is published exactly once."
owner_domain = 11
interface = "11.rs-mirror-solana-archive-client-advance"

[finding.7]
file = "services/interop/crates/layerx-mirror/src/store.rs"
line = 588
class = "restart-recovery"
severity = "high"
observed = "validate_transition permits Pending only to Pending, Finalized or PermanentRefusal. Ethereum observe_stage can move Pending to BroadcastUnknown or Reorged; Solana can move it to BroadcastUnknown or BroadcastExpired. The journal rejects these observations as InvalidTransition, preventing expiry replacement or reorg recovery."
expected = "The durable publication state machine must represent all legitimate observations produced by both concrete chain clients while preserving identity checks and ambiguity protection."
proposal = "Reconcile validate_transition in layerx-mirror/src/store.rs with ethereum.rs and solana.rs using an explicit recovery transition table. Prove persisted pending disappearance, expired Solana blockhash and canonical-hash replacement through the real clients, without permitting unverified rebroadcast."
owner_domain = 11
interface = "11.rs-mirror-publication-journal-append"

[finding.8]
file = "services/interop/crates/layerx-x402/src/facilitator.rs"
line = 578
class = "interface-mismatch"
severity = "high"
observed = "validate_supported accepts configured metered and subscription kinds, but settle_executed recognises only PaymentExact and its 64-byte data layout. A supported grant payment returns PaymentDrawn with a 128-byte layout and is refused; no grant purpose is rendered for buyer verification."
expected = "A facilitator must settle every advertised scheme using its actual native event and bind grant identity, draw reference and purpose for metered or subscription payments."
proposal = "Implement the native grant event verification and purpose evidence in layerx-x402/src/facilitator.rs, sharing the seller grant rules; until implemented reject unsupported grant kinds when constructing the support declaration. Prove advertised kinds against real settlement output."
owner_domain = 11
interface = "11.rs-x402-facilitator-settle"

[finding.9]
file = "services/interop/crates/layerx-mirror/src/bin/layerx-mirror-verify.rs"
line = 24
class = "config-drift"
severity = "medium"
observed = "The strict verifier Config requires receipt_keys and rejects unknown fields. The README-linked deploy/mirror/verify-config.example.json supplies sequencer_id_hex, sequencer_public_key_hex and first/last_batch_number instead, so the documented example cannot start this binary."
expected = "The shipped verifier example must deserialize through the current Config and provide bounded receipt-key height windows using the same names and types as the loader."
proposal = "Update services/interop/deploy/mirror/verify-config.example.json to receipt_keys and the current source schema. Add an example-loading test through the actual verifier Config boundary in layerx-mirror/src/bin/layerx-mirror-verify.rs."
owner_domain = 11
interface = "11.cli-mirror-verify"

[finding.10]
file = "services/interop/crates/layerx-mirror/src/runtime.rs"
line = 279
class = "wiring-gap"
severity = "medium"
observed = "The acquisition worker requests only the next numeric block and never calls latest_committed. A null next block becomes Unavailable and record_committed clears readiness even when the publisher is caught up. Freshness is measured against the last acquired block, and only one block is acquired per poll interval."
expected = "A healthy caught-up mirror must stay ready, and lag must be measured against the observed native finalized head rather than a locally advanced acquisition cursor."
proposal = "In layerx-mirror/src/runtime.rs poll latest_committed separately, retain healthy caught-up status, and drain a bounded range up to that head per poll. Prove steady tip, advancing head, backlog and endpoint refusal as distinct status outcomes."
owner_domain = 11
interface = "11.rs-mirror-committed-block-source-latest-j48"

[finding.11]
file = "services/interop/crates/layerx-mirror/src/runtime.rs"
line = 491
class = "runtime-risk"
severity = "medium"
observed = "ordered_archives loads and decodes every spooled archive into a vector each chain poll. Each lane repeatedly walks historical archives and recreates stage work; the spool and journals have no retention limit, so memory, disk and RPC work grow with the entire chain history."
expected = "Continuous mirror publication must have bounded per-poll work and memory, with durable progress and a retention policy that preserves recovery and the promised archive availability."
proposal = "Add a durable ordered spool index and per-lane progress cursor in layerx-mirror/src/runtime.rs and store.rs. Limit each poll and reorg window, and define archival/retention ownership so verified history is not repeatedly loaded or silently discarded."
owner_domain = 11

[finding.12]
file = "services/interop/crates/layerx-mirror/src/store.rs"
line = 625
class = "restart-recovery"
severity = "medium"
observed = "append writes and syncs the framed log before replacing its head. replay accepts complete hash-linked extensions, but a crash leaving an incomplete unsealed frame returns Corrupt or an actual_length mismatch; the intact sealed prefix cannot reopen automatically."
expected = "A crash during append must permit recovery of the last authenticated sealed prefix without accepting sealed corruption, rollback, or a partially persisted publication."
proposal = "In layerx-mirror/src/store.rs distinguish a verified unsealed crash suffix from corruption inside the sealed prefix and define an explicit durable recovery/truncation operation. Add fault injection during frame and head writes; continue refusing authenticated-prefix damage."
owner_domain = 11

[finding.13]
file = "services/interop/crates/layerx-mirror/src/rpc.rs"
line = 341
class = "runtime-risk"
severity = "medium"
observed = "RpcEndpoint uses blocking to_socket_addrs and socket read/write timeouts. read_json_rpc performs repeated reads without an overall deadline, so a peer that drips bytes before each timeout or slow DNS can exceed request_timeout_ms indefinitely. Quorum calls visit endpoints sequentially."
expected = "The configured RPC deadline must bound the whole DNS/connect/TLS/request/body exchange so one endpoint cannot prevent source or chain-worker progress indefinitely."
proposal = "Apply one monotonic end-to-end request budget across resolver, connection, TLS and body reads in layerx-mirror/src/rpc.rs. Test a slow-drip body and delayed resolution, and ensure other independent endpoints can still establish quorum."
owner_domain = 11

[finding.14]
file = "services/interop/crates/layerx-mirror/src/signer.rs"
line = 162
class = "interface-mismatch"
severity = "medium"
observed = "RemoteChainSigner::sign_digest permits an Ed25519 configuration and encodes an empty message. The real mirror-signer rejects Ed25519 requests without a nonempty message as required by deploy/mirror/signer-protocol.md. The runtime Solana path correctly uses sign_message, so the mismatch is in the public digest API."
expected = "The exposed signer methods must accept only request shapes the actual signer authorises: secp256k1 digest signing and Ed25519 signing of the complete bounded message."
proposal = "Restrict sign_digest to secp256k1 at the public boundary in layerx-mirror/src/signer.rs and direct Ed25519 callers to sign_message. Exercise each method against the actual mirror-signer request decoder and refusal codes."
owner_domain = 11
interface = "11.fmt-msigner-request"

[finding.15]
file = "services/interop/crates/layerx-x402/src/transport.rs"
line = 285
class = "security"
severity = "medium"
observed = "decode_core deserializes MCP/A2A JSON by cloning Value directly, bypassing MAXIMUM_JSON_BYTES. HTTP decode_header and encode_json/decode_json enforce the 64 KiB budget, but object-valued payload and extension contents allow oversized MCP/A2A core messages to pass model validation."
expected = "All supported transports must enforce the same bounded core message contract before cloning or decoding potentially large payment payloads and extension objects."
proposal = "Use a shared bounded decoding boundary for MCP/A2A core messages in layerx-x402/src/transport.rs and bound ingress before constructing unbounded Values. Exercise just-below and over-limit payloads through each real transport decoder."
owner_domain = 11
interface = "11.rs-x402-decode-payment-payload"

[finding.16]
file = "services/interop/crates/layerx-x402/src/buyer.rs"
line = 400
class = "interface-mismatch"
severity = "medium"
observed = "build_payment checks only that the plane output is an object and stores the caller idempotency_key separately. It does not require payload.idempotencyKey to match. The live interop-service BuyerPlane ignores PaymentBuildRequest and returns caller JSON; seller may derive a different key and the resulting valid settlement fails buyer capture."
expected = "A successful buyer build must carry the same nonzero settlement identity across BuiltPayment, encoded PAYMENT-SIGNATURE, seller submission and later buyer capture."
proposal = "Validate the constructed scheme identity against PaymentBuildRequest in layerx-x402/src/buyer.rs and make services/interop/crates/layerx-interop-service/src/server.rs construct the bound payload. Add build-to-seller-to-capture cases with missing and conflicting keys."
owner_domain = 11
interface = "11.rs-x402-buyer-build-payment"

[finding.17]
file = "services/interop/crates/layerx-mirror/tests/sequencer_vectors.rs"
line = 286
class = "test-gap"
severity = "medium"
observed = "The shared V3 activity-id, sequence-hash and tampered-log cases unwrap a successful committed_receipt result. The tampered-log branch merely checks the fixture string refusedAt equals R5. This does not prove the requirement 11369.2 claim that the mirror consumer refuses every V3 case."
expected = "Requirement 11369.2 calls for refusal by the actual mirror consumer, with raw-transaction, log-view and sequence context available at the boundary where those checks are claimed."
