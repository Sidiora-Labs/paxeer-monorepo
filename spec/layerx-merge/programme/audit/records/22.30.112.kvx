[finding.portable_json_budget]
file = "services/interop/crates/layerx-portable/src/receipt.rs"
line = 240
class = "interface-mismatch"
severity = "high"
observed = "PortableReceiptV2::export accepts a signed receipt up to 1,048,576 bytes and export_with_transaction permits another 1,048,576 bytes. Both fields become hex strings. to_json validates individual fields but does not enforce MAX_JSON_BYTES; from_json rejects every JSON body above 1,500,000 bytes. A valid large receipt, or receipt plus transaction, can therefore be exported and serialized successfully but cannot be imported again."
expected = "The portable proof emitted by the exporter must be accepted by its bounded importer. The sequencer receipt layout permits enough effects to cross this JSON threshold; successful export must preserve a usable portable proof."
proposal = "In services/interop/crates/layerx-portable/src/receipt.rs enforce one shared encoded-wire budget before export and serialization succeed, retaining the importer bound. Add boundary coverage using a real producer receipt with many effects and a bound raw transaction, then import and independently verify the emitted bytes."
owner_domain = 11
interface = "11.rs-portable-portable-receipt-v2-to-json"

[finding.ucp_currency_units]
file = "services/interop/crates/layerx-ucp/src/lib.rs"
line = 609
class = "interface-mismatch"
severity = "high"
observed = "CheckoutSubmission documents total_minor as ISO-4217 minor units, but complete_checkout copies it into UcpPaymentIntent.amount and verify_sequencer_payment hashes the same number into PaymentExact atomic amount data. UcpServicePlane in layerx-interop-service/src/server.rs:1888-1900 compares transfer.amount directly with intent.amount. Currency and token atomic scale are never reconciled. A USD total_minor of 1000 with a six-decimal dollar asset accepts 1000 atomic units or refuses the correctly scaled 10000000."
expected = "A merchant checkout total must debit the equivalent asset amount and verify that same amount in the native payment receipt. Currency, merchant asset and atomic scale must be deployment-owned bindings rather than an implicit one-to-one unit assumption."
proposal = "Add a merchant-owned currency/asset/scale binding to the UCP service configuration and perform checked conversion in the checkout adapter before constructing the payment intent. Verify receipts against that converted amount and cover a real checkout with a non-unit scale through relay, receipt verification and order completion."
owner_domain = 11
interface = "11.rs-ucp-ucp-adapter-complete-checkout"

[finding.gateway_rotation]
file = "services/interop/deploy/gateway/render.py"
line = 906
class = "interface-mismatch"
severity = "high"
observed = "render.py accepts a list of receipt-key windows but refuses deployment when their publicKey values contain more than one distinct key. The live service validate_x402_binding in layerx-interop-service/src/config.rs:682-718 accepts all distinct receipt public keys and compares them with the supported signer set. A normal old/new signing-key rotation therefore cannot be rendered."
expected = "Deployment rendering must preserve the same authorized key windows and signer identities that the live service consumes, including historical and current public keys during rotation and recovery."
proposal = "Change services/interop/deploy/gateway/render.py to derive every did:layerx signer from the validated receipt-key list and emit the complete set. Prove the rendered manifest starts the real service before and after rotation and still verifies receipts from both permitted height windows after restart."
owner_domain = 11
interface = "11.cli-deploy-gateway-render"

[finding.mirror_verify_shape]
file = "services/interop/deploy/mirror/verify-config.example.json"
line = 3
class = "interface-mismatch"
severity = "high"
observed = "verify-config.example.json supplies sequencer_id_hex, sequencer_public_key_hex, first_batch_number and last_batch_number at the top level and omits receipt_keys. The real layerx-mirror-verify Config in layerx-mirror/src/bin/layerx-mirror-verify.rs:22-27 uses deny_unknown_fields and requires receipt_keys, so this published verifier configuration is rejected before any archive can be verified."
expected = "The declared verifier example and its registry format must deserialize through the actual verifier and carry the same receipt-key windows as the publisher and archived receipt verification path."
proposal = "Replace the obsolete single-key fields in services/interop/deploy/mirror/verify-config.example.json with the actual receipt_keys shape and update its registry contract. Load the example through the real verifier configuration path and verify an archive produced under the corresponding publisher key window."
owner_domain = 11
interface = "11.fmt-deploy-mirror-verify-config-example"

[finding.solana_mutable_deployment]
file = "services/interop/deploy/mirror/deploy-solana-mirror.sh"
line = 61
class = "interface-mismatch"
severity = "high"
observed = "deploy-solana-mirror.sh deploys with the publisher as upgrade authority and lines 85-86 require that authority to remain the publisher. It writes a successful deployment record without finalization. The actual mirror Solana client validates program data on read and publish and returns ProgramMutable when the authority option byte is nonzero (layerx-mirror/src/solana.rs:1184-1191). solana-deployment.json itself requires finalization before readiness."
expected = "A completed mirror deployment must satisfy the immutable-program identity policy used by both publisher and archive reader, with rooted program data matching the declared ELF digest and no remaining upgrade authority."
proposal = "Give services/interop/deploy/mirror/deploy-solana-mirror.sh an explicit authorized finalization stage, then re-fetch rooted program data and verify the deployed ELF identity and absent upgrade authority before producing a ready deployment record. Exercise deployment through the real publisher and reader identity checks."
owner_domain = 11
interface = "11.cli-deploy-mirror-deploy-solana-mirror"

[finding.signer_secret_readability]
file = "services/interop/crates/layerx-mirror-signer/src/lib.rs"
line = 778
class = "security"
severity = "medium"
observed = "key_file_bytes follows symlinks with fs::metadata, rejects group/other write bits only, and then opens the path separately with fs::read. A world-readable 0644 private key is accepted, and the check and read do not bind the same opened file."
expected = "Signer private material must not be readable by unrelated users, and file ownership, type and permission checks must apply to the file actually opened for signing."
proposal = "In services/interop/crates/layerx-mirror-signer/src/lib.rs open key files with an explicit symlink policy and validate metadata on that descriptor. Refuse world-readable private keys, define any trusted-group read policy explicitly, and cover permission and file-replacement cases using real filesystem files."
owner_domain = 11

[finding.signer_role_alias]
file = "services/interop/crates/layerx-mirror-signer/src/lib.rs"
line = 549
class = "security"
severity = "medium"
observed = "load_bridge forbids mixing attestation and transaction domains on one handle but only checks uniqueness of the handle string. It loads each key independently and does not compare derived identities. The same private key can be registered under separate handles for attestation and fee-paying, bypassing the stated attestor-key separation."
expected = "The bridge signer guarantee that an attestor key never pays fees must hold for cryptographic identities across all handles, not just for a domain list attached to one handle."
proposal = "In services/interop/crates/layerx-mirror-signer/src/lib.rs compare the loaded public identities across policies and refuse any identity shared between attestation and transaction roles. Cover distinct handles that refer to the same key bytes as well as correctly separated real keys."
owner_domain = 11
interface = "11.rs-msigner-signer-service-load-bridge"

[finding.gateway_duplicate_key_id]
file = "services/interop/deploy/gateway/render.py"
line = 873
class = "config-drift"
severity = "medium"
observed = "receipt_keys rejects overlapping windows but accepts the same keyId in disjoint windows. layerx-proof/src/receipt.rs:807-818 refuses a receipt whenever more than one trusted entry matches its context key id, regardless of whether their height ranges overlap. The renderer can approve key configuration unusable by the receipt verifier."
expected = "Receipt key identifiers must be unique across the configured list in addition to having valid non-overlapping windows, consistently with the actual proof consumer."
proposal = "Reject repeated keyId values in services/interop/deploy/gateway/render.py before writing configuration, and exercise a rendered list through the real proof verifier with receipts for both permitted windows. Preserve the existing signature and range checks."
owner_domain = 11
interface = "11.cli-deploy-gateway-render"

[finding.mirror_key_policy_drift]
file = "services/interop/deploy/mirror/render-config.py"
line = 175
class = "config-drift"
severity = "medium"
observed = "checkpoint_policy accepts repeated keyId values in disjoint windows and rejects firstHeight zero. The gateway renderer accepts height zero, while the receipt proof consumer rejects duplicate ids regardless of disjoint ranges. These tools do not share one receipt-key validation policy."
expected = "Deployment tools consuming the same ReceiptKeys input must agree on valid identity uniqueness and inclusive uint64 height windows, including a window starting at zero."
proposal = "Align services/interop/deploy/mirror/render-config.py with the actual ReceiptKeys consumer: require unique ids and accept the supported zero boundary without weakening signature or range checks. Use one canonical key file through both renderers and a real receipt verification path."
owner_domain = 11
interface = "11.cli-deploy-mirror-render-config"

[finding.gateway_example_pins]
file = "services/interop/deploy/gateway/config.example.json"
line = 29
class = "config-drift"
severity = "medium"
observed = "config.example.json advertises 26 UCP vectors and 26 fiat vectors. render.py:1196 and 1198 pins the current derived suite counts to 29 and 31 respectively. The shipped manifest example does not represent the suite identities the checkout renderer declares."
