[finding.liveness-request-deadline]
file = "sdk/contrib/localnet_liveness.sh"
line = 32
class = "runtime-risk"
severity = "medium"
observed = "The status curl has no connection or total deadline, so one stalled peer bypasses the intended ITER/SLEEP completion bound."
