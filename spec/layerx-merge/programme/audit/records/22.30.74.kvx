[finding.image-build-context]
file = "sdk/contrib/images/Makefile"
line = 5
class = "wiring-gap"
severity = "medium"
observed = "Both Docker build targets choose sdk/ as context, but sdk/go.mod is absent and the chain module lives at the repository root."
expected = "Development image targets must provide the existing module, source paths and executable consumed by their Dockerfile."
proposal = "Port this Makefile and both Dockerfiles together to the root chain build, or retire the executable targets with an explicit inherited-tooling explanation."
owner_domain = 15

[finding.debug-image-build]
file = "sdk/contrib/images/simd-dlv/Dockerfile"
line = 1
class = "config-drift"
severity = "medium"
observed = "The image pins Go 1.18, copies contrib/ paths and expects build/simd; the root module requires Go 1.25.8, assets live under sdk/contrib and simapp is absent."
expected = "A supported Paxeer debug image must use the declared toolchain and package the executable actually produced by chain.mk."
proposal = "Port sdk/contrib/images/simd-dlv/Dockerfile to the root module, current toolchain, paxd output and matching wrapper paths, or withdraw its supported build target."
owner_domain = 15

[finding.environment-image-build]
file = "sdk/contrib/images/simd-env/Dockerfile"
line = 1
class = "config-drift"
severity = "medium"
observed = "Go 1.18, ./ics23/go.mod, contrib/ and build/simd are assumed under an sdk-root context with no go.mod; these inputs do not describe this checkout."
expected = "A runnable local image must build an existing module and copy the binary produced by its declared chain build."
proposal = "Update sdk/contrib/images/simd-env/Dockerfile and its Makefile caller together for root module paths, Go 1.25.8 and paxd, or explicitly retire the image."
owner_domain = 15

[finding.debug-log-branch]
file = "sdk/contrib/images/simd-dlv/wrapper.sh"
line = 19
