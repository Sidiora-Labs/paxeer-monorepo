[finding.faucet-transfer-outcome]
file = "sdk/contrib/rosetta/configuration/faucet.py"
line = 14
class = "runtime-risk"
severity = "medium"
observed = "subprocess.call failure is ignored before HTTP 200, while any malformed-request exception invokes os._exit and kills the entire faucet."
expected = "A construction faucet must report failed funding accurately and isolate malformed requests without terminating unrelated requests."
proposal = "Check child status and return bounded non-success responses in sdk/contrib/rosetta/configuration/faucet.py; replace os._exit with per-request validation errors."
owner_domain = 15

[finding.faucet-input-and-process-bounds]
file = "sdk/contrib/rosetta/configuration/faucet.py"
line = 11
class = "security"
severity = "medium"
observed = "Content-Length and body reads have no size or time limit, and the funding subprocess has no deadline; one container-network peer can monopolize this single-threaded fixture server."
expected = "The local faucet must bound request bodies, socket reads and bank-command execution before serving another funding request."
proposal = "Bound Content-Length, validate addresses, set request deadlines and supervise a timed funding subprocess with cleanup in sdk/contrib/rosetta/configuration/faucet.py."
owner_domain = 15

[finding.rosetta-faucet-currency]
file = "sdk/contrib/rosetta/configuration/send_funds.sh"
line = 5
class = "config-drift"
severity = "medium"
observed = "The faucet sends 100stake, but transfer.ros requests and waits for a uhpx balance; successful funding cannot satisfy the construction currency check."
expected = "The bank transfer denomination and Rosetta construction currency must describe the same asset and precision."
proposal = "Read shared fixture currency metadata in sdk/contrib/rosetta/configuration/send_funds.sh and synchronize bootstrap.json, data.sh and transfer.ros with it."
owner_domain = 15

