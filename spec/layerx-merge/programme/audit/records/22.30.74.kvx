[finding.ics23-compressed-index-bounds]
file = "sdk/ics23/compress.go"
line = 154
class = "security"
severity = "medium"
observed = "decompressExist directly indexes lookup[step] with an int32 decoded from proof input; negative, oversized or empty-table indexes panic before boolean verification can reject them."
expected = "Serialized lookup indexes must be validated and invalid compressed proofs must be rejected without terminating the embedding process."
proposal = "Add checked decompression in sdk/ics23/compress.go, propagate errors through combination/verification and exercise actual decoded negative and out-of-range index cases."
owner_domain = 15
interface = "15.go-ics23-decompress-j76"

[finding.ics23-compress-empty-variant]
file = "sdk/ics23/compress.go"
line = 64
class = "runtime-risk"
severity = "medium"
observed = "compressEntry assumes every entry without Exist has Nonexist and dereferences non.Key; a nil entry or unset protobuf oneof panics in Compress/CombineProofs."
expected = "Compression must validate batch-entry variants before dereferencing them and report structurally invalid proof input predictably."
proposal = "Validate nil and missing variants in sdk/ics23/compress.go and carry a real error through compression/combination, preserving valid round trips in tests."
owner_domain = 15
interface = "15.go-ics23-compress-j76"

