[finding.liveness-empty-container-set]
file = "sdk/contrib/localnet_liveness.sh"
line = 47
class = "runtime-risk"
severity = "medium"
observed = "The first iteration computes RANDOM modulo the discovered array length even when no simd-named container exists, causing division by zero."
