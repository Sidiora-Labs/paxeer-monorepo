[finding.030]
file = "engine/executor/lib/evmlib.go"
class = "runtime-risk"
severity = "low"
observed = "InitEvmoneVM locates its shared library beside the build-time source path returned by runtime.Caller. A copied or trimpath binary need not have that path; node startup silently keeps geth after a best-effort load failure."
expected = "Operators selecting an alternative VM need an explicit, deployment-stable artifact location and a visible unsupported/load-failure state."
proposal = "Resolve packaged VM artifacts through an explicit validated path or executable-relative location in engine/executor/lib/evmlib.go; prove a source-free installed binary loads the intended library and reports incompatible artifacts."
owner_domain = 5
interface = "5.go-engine-executor-lib-init-evmone-vm"
line = 21

[finding.031]
file = "docs/site/docs/concepts/paxeer-boundary.md"
class = "doc-drift"
severity = "medium"
observed = "The page presents services/platform/hosted/paxeer as a required trusted relay and instructs deployment of LayerXVault, GuarantorBond and CheckpointRegistry with bond/finalize phases. The retirement inventory removes that relay and the external checkpoint/custody-claims architecture."
expected = "Operators deploy the integrated paxd network and use committed-block finality; no retired relay, guarantor process or separate settlement suite is required for the merged kernel."
