[finding.1]
file = "precompiles/layerxledger/views.go"
line = 102
class = "interface-mismatch"
severity = "high"
observed = "nextSequence forwards ABI accountId to Keeper.NextSequence, whose modules/layerxledger/keeper/views.go:31 derives AssetAccountID from a DID public key. Passing the accountId returned by openAccount or accountId therefore derives a second, nonexistent account; balanceOf accepts the actual accountId."
expected = "The declared nextSequence(accountId, assetId) view must read the same persisted account produced by openAccount and accepted by balanceOf, so an integrator can obtain its next debit sequence."
proposal = "In modules/layerxledger/keeper/views.go and precompiles/layerxledger/views.go, resolve the supplied account ID directly and validate its asset. Keep any owner-key convenience helper separately named. Prove openAccount output through ABI nextSequence before and after committing and reopening the host."
owner_domain = 2
interface = "6.pc-0x101a-nextsequence"

[finding.2]
file = "precompiles/layerxledger/abi.json"
line = 8
class = "interface-mismatch"
severity = "medium"
observed = "The published payExact fifth argument is named sequence although payments.go maps it to ExpiresAt, and nextSequence names its first argument accountId although views.go supplies it to a DID-key derivation. ABI-driven clients receive misleading names and units; findings 1 and 3 describe the failing calls."
expected = "The ABI metadata must identify the actual semantic input and unit of every value, consistently with the handler, keeper, SDK and public reference."
proposal = "Publish expiresAtMs for the existing payExact uint64 without changing its selector, reconcile nextSequence account semantics with finding 1, and update Solidity bindings, SDK parameter names and generated documentation together."
owner_domain = 2
interface = "2.fmt-layerxledger-abi-j23"

[finding.3]
file = "precompiles/layerxledger/payments.go"
line = 114
class = "interface-mismatch"
severity = "high"
observed = "payExact binds ExpiresAt with abi:sequence and passes it as PayExactArgs.ExpiresAt. The keeper compares it with BlockTime().UnixMilli() and independently reads the actual sequence. A caller supplying the advertised next account sequence is refused as expired; the receipt-vector caller already calls the value expiresAt."
expected = "A declared sequence must retain its account replay meaning across ABI and keeper, or the public contract must explicitly declare an expiry in milliseconds and explain that the keeper chooses the account sequence."
proposal = "Align precompiles/layerxledger/abi.json, payments.go, the Solidity interface and SDK wrappers on expiresAtMs, documenting automatic account-sequence selection. Add a real bound, funded payExact call using a current expiry and prove expired timestamp refusal and persisted sequence advancement."
owner_domain = 2
interface = "6.pc-0x101a-payexact"

[finding.4]
file = "precompiles/layerxledger/transfers.go"
line = 51
class = "interface-mismatch"
severity = "high"
observed = "The send handler delegates to Keeper.Send, which at modules/layerxledger/keeper/send.go:21 requires envelope.from to equal MainAccountID(actor.DIDKey). openAccount produces AssetAccountID, and the kernel source_matches_actor in src/modules/asset/lx_asset_registry.c explicitly accepts actor-owned asset accounts. A legitimately opened and minted asset account cannot send through 0x101A."
expected = "An account created by the ledger openAccount interface and funded by mint must be usable as the source of its supported asset transfer; ownership validation must agree with the kernel canonical account rules."
proposal = "Replace the main-account-only check in modules/layerxledger/keeper/send.go with canonical source ownership and asset validation through the shared host. Prove bind/register/openAccount/mint/send over the EVM path, refusing a foreign owner and checking bank, kernel balances and persisted sequences after reopening."
owner_domain = 2
interface = "6.pc-0x101a-send"

[finding.5]
file = "modules/layerxagent/keeper/scheduler.go"
line = 56
class = "runtime-risk"
severity = "high"
observed = "RunDue snapshots all admitted Job values before execution and never reloads them. Job A can target 0x0905 cancel(B) as the same creator: B is refunded and deleted, then the stale B still executes and settles its deposit again from pooled escrow. If A reschedules B, stale execution deletes B but leaves its new due index; IterateDue later panics on the missing job."
expected = "Cancel and reschedule must take effect before a later due job executes, deposits must settle once, and due indexes must never reference a deleted obligation after a restart."
proposal = "In modules/layerxagent/keeper/scheduler.go, reload and validate each admitted job immediately before execution, including its stored due block or version, and skip canceled or moved jobs without consuming their deposit. Add real scheduled EVM cancel and reschedule calls against another admitted job, check escrow conservation, then reopen and run beyond the moved height."
owner_domain = 2
interface = "2.go-layerxagent-keeper-rundue-j24"

[finding.6]
file = "modules/layerxagent/keeper/scheduler.go"
line = 67
class = "restart-recovery"
severity = "high"
observed = "runJob deletes the job before execution; fee and refund transfers then commit independently. A failed transfer only becomes text in EventJobFailed, while the return value reports event encoding errors. No durable outstanding refund or fee remains for export or retry. The overdraw reachable through finding 5 can leave another creator unpaid with no recoverable job record."
expected = "Committed target effects and every remaining deposit obligation must have a durable, exactly-once settlement lifecycle; a failed payment must remain recoverable across restart without executing the target twice."
proposal = "Persist execution outcome and pending fee/refund obligations in modules/layerxagent/keeper before deleting the runnable job. Settle each leg idempotently, retain failures for retry, and include obligations in genesis export/import. Exercise a real bank refusal, reopen the keeper, and prove eventual payment without repeating target effects."
owner_domain = 2
interface = "2.evt-layerxagent-event-job-failed"

[finding.7]
file = "precompiles/layerxauth/lifecycle.go"
line = 27
class = "interface-mismatch"
severity = "high"
observed = "recordLifecycle receives a successful kernel receipt but returns only GlobalSequence and ignores Receipt.Events. Registration and recovery updates emit kernel event 0x7110 in src/modules/governance/lxp_governance.c and lxp_governance_onboarding.c. Unlike grantResult and revokeGrant, this handler emits no declared IdentityStateUpdated EVM log."
expected = "Successful identity lifecycle writes must carry their committed IdentityStateUpdated event from the kernel receipt into the declared 0x101C log so consumers observing identity history see registration and recovery changes."
proposal = "Decode AuthEvents in precompiles/layerxauth/lifecycle.go, validate lifecycle event shapes and emit IdentityStateUpdated through the shared log encoder before committing the branch. Add real EVM registration and recovery calls asserting topic, DID, exact LXGI1 body and receipt inclusion, with no log on refusal."
owner_domain = 2
interface = "6.pc-0x101c-evt-identitystateupdated"

[finding.8]
file = "modules/layerxagent/keeper/keeper.go"
line = 113
class = "config-drift"
severity = "medium"
observed = "SetParams validates only the new parameter values. Governance can lower MaxJobGasLimit and MaxBlockGas below an already persisted job GasLimit. RunDue then stops at that first oversized due job on every block, preventing all subsequent due jobs from progressing until its creator cancels or governance raises the cap."
expected = "A valid governance limit change must preserve scheduler progress and provide an explicit disposition for deposits of jobs that no longer fit the execution budget."
proposal = "In modules/layerxagent/keeper/keeper.go and scheduler.go, reject an incompatible reduction or implement a bounded, deterministic refund or migration of oversized jobs. Add a governance-path case with a preexisting large job followed by a smaller job and verify progress and escrow conservation after restart."
owner_domain = 2
interface = "2.go-layerxagent-keeper-keeper-setparams-j24"

