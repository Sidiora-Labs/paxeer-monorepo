[finding.backup-consistency]
file = "tools/ops/backup/backup.sh"
line = 42
class = "restart-recovery"
severity = "high"
observed = "backup.sh accepts tar exit 1 for changing live state, then checks only the age header and a newly computed ciphertext checksum before pruning old archives at line 59. Neither check establishes that node and kernel state can be restored consistently."
expected = "A retained recovery point must contain a coherent snapshot of committed node and kernel state; an unreadable or inconsistent new archive must not evict the last recoverable checkpoint."
proposal = "In tools/ops/backup/backup.sh, archive a quiesced or storage-supported consistent snapshot, reject incomplete captures, and permit retention pruning only after an isolated restore validates the committed state and required key material."
owner_domain = 16
interface = "16.cli-ops-ops-backup-backup"

[finding.key-enumeration]
file = "tools/ops/keyring-migrate.sh"
line = 111
class = "restart-recovery"
severity = "high"
observed = "Failure of keys list on the test backend is converted to an empty want list. The comparison at line 135 then succeeds vacuously, and a matching archive listing allows removal of keyring-test at line 150 although no keys were imported."
