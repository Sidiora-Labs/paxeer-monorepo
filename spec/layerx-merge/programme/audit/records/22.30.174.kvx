proposal = "In tools/specgen/kvx.go, share an escape-aware scanner and proper string decoder for comment/list/string handling, with vectors covering escaped quotes, hashes and backslashes."
owner_domain = 16

[finding.address-invalid-key]
file = "utils/helpers/address.go"
line = 87
class = "runtime-risk"
severity = "medium"
observed = "PubkeyToEVMAddress accepts any nonempty bytes beginning with 0x04, including a single prefix. GetAddressesFromPubkeyBytes then calls PubkeyBytesToPaxPubKey, which ignores ParsePubKey failure and dereferences the nil parsed key."
expected = "Public-key conversion must validate a complete secp256k1 point and return a typed error for invalid input rather than manufacturing an address or panicking."
proposal = "In utils/helpers/address.go, validate point encoding before either address derivation, propagate parse errors through the public conversion path, and exercise prefix-only and invalid-curve inputs."
owner_domain = 16

