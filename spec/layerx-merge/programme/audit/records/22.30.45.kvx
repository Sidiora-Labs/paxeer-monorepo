[finding.sign-state-after-save-error]
file = "consensus/privval/file.go"
line = 453
class = "restart-recovery"
severity = "high"
observed = "saveSigned mutates LastSignState before Save. After a failed disk write, identical same-HRS retries return that cached signature without retrying persistence at lines 386-404 and 434-439. Reopening loads the older HRS, allowing a conflicting signature after an unpersisted signature was released."
expected = "Validator signing must never release a signature without its durable HRS safety record; retry and reopen must preserve the same non-equivocation boundary."
proposal = "In consensus/privval/file.go retain an uncommitted pending signature and fail closed until its state is durably written. Add real filesystem-write failure, identical retry, reopen and conflicting-vote refusal coverage."
owner_domain = 15
interface = "15.go-consensus-privval-file-pv-j57"

