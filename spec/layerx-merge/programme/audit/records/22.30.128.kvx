[finding.terminal-token-lifecycle]
file = "programs/crates/layerx-programs-sandbox/src/host_ffi.rs"
line = 264
class = "interface-mismatch"
severity = "medium"
observed = "layerx_programs_sandbox_destroy_terminal ignores _token and takes the thread-local terminal before checking capacity. A wrong-token call can consume another pending result; an undersized output irreversibly discards it. Unlike the other host entrypoints this export is outside guarded."
