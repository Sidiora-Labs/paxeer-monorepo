[finding.truncated-submission]
file = "programs/crates/layerx-programs-sandbox/src/activity.rs"
line = 161
class = "runtime-risk"
severity = "medium"
observed = "SandboxSubmission::decode accepts a valid four-byte header and then slices payload[4..36] before checking the operation length; inputs of 4 through 35 bytes panic."
expected = "Malformed public submission bytes must return NonCanonical without panicking, including a truncated lease identifier."
proposal = "In programs/crates/layerx-programs-sandbox/src/activity.rs, check the minimum lease prefix before slicing and cover every truncated operation prefix with refusal assertions."
owner_domain = 13

[finding.live-registration]
file = "programs/crates/layerx-programs-sandbox/src/activity.rs"
line = 62
class = "interface-mismatch"
severity = "high"
observed = "SandboxProtocolContext::new accepts only protocol 2 and Programs registration ABI 3. precompiles/layerxprograms/submit.go emits StateCommitmentProtocolVersion=3, while modules/lxphost/host.go:175 mounts programs_module_registration_v4_storage_retirement; src/protocol/lxp_genesis.c also selects Programs v4."
expected = "The canonical sandbox submission surface must accept the authenticated protocol and module registration used by the merged node, while preserving the distinction between module ABI and guest ABI."
proposal = "Update compatibility selection in programs/crates/layerx-programs-sandbox/src/activity.rs to the live protocol-3/Programs-v4 registration and prove funding, activation and execution through the actual native registration path."
owner_domain = 13
interface = "13.rs-sbx-activity-sandboxprotocolcontext-new"

[finding.included-transaction]
file = "programs/crates/layerx-programs-sandbox/src/activity.rs"
line = 364
class = "interface-mismatch"
severity = "high"
observed = "SandboxSubmissionReceipt::verify requires evidence.tx to equal the bare sandbox payload. verify_tx hashes those bytes into the Comet transaction tree. The real precompile receives ABI arguments inside an EVM transaction and submit.go wraps the sandbox payload in an lxphost.Activity; that bare payload is not the chain transaction."
expected = "Requirement 13046 requires proof of the real included sandboxExecute transaction and a successful result, with its sandbox call bound to the requested lease and payload."
proposal = "In programs/crates/layerx-programs-sandbox/src/activity.rs, verify inclusion of the actual chain transaction, decode and authenticate its sandbox invocation and bind the result, signer, target, payload and native activity identifier. Exercise the precompile-produced transaction rather than treating payload bytes as a transaction."
owner_domain = 13
interface = "13.rs-sbx-activity-sandboxsubmissionreceipt-verify"

[finding.usage-state-shape]
file = "programs/crates/layerx-programs-sandbox/src/activity.rs"
line = 398
class = "interface-mismatch"
severity = "high"
observed = "Nonfunding receipt verification reads sandbox_state_key(1, lease) and authenticated_usage_receipt expects LXUR plus one receipt and digest. host_ffi.rs:927-929 stages lease at kind 0, escrow at kind 1 and UsageLedger at kind 2. The ledger uses the usage-ledger/v2 domain; sandbox.c:493 emits LXUR only as a chunked event with a 52-byte header."
expected = "The authenticated usage consumer must accept the exact committed ledger key and encoding emitted by the settlement producer; an event fragment is not a stored ledger value."
proposal = "Align programs/crates/layerx-programs-sandbox/src/activity.rs with the kind-2 UsageLedger writer and decode its bound latest receipt. If event verification is required, separately verify and assemble the native LXUR chunk framing. Prove both paths using captured native store and event bytes."
owner_domain = 13
interface = "13.rs-sbx-activity-sandboxsubmissionreceipt-authenticated-usage-receipt"

[finding.activation-receipt]
file = "programs/crates/layerx-programs-sandbox/src/activity.rs"
line = 398
class = "interface-mismatch"
severity = "high"
observed = "Only OP_FUND selects a lease-state proof; OP_ACTIVATE follows the usage receipt path. The activation producer in host_ffi.rs:1101-1140 advances Funded to Active and stages kind-0 lease state without creating a usage receipt, so activate_lease cannot accept the emitted activation state."
expected = "Requirement 13047 requires lifecycle consumers to authenticate the actual resulting lease transition, including Funded to Active, independently of execution usage."
proposal = "Give activation an explicit proven lease-state branch in programs/crates/layerx-programs-sandbox/src/activity.rs, validating the requested previous digest, next history entry, tenant, native activity binding and Active state. Drive it with a native funded-then-activated lease proof."
owner_domain = 13
interface = "13.rs-sbx-activity-activate-lease"

[finding.terminal-key]
file = "programs/crates/layerx-programs-sandbox/src/expiry.rs"
line = 72
class = "interface-mismatch"
severity = "high"
observed = "AuthenticatedTerminalRecord::verify reads sandbox_state_key(2, lease), but sandbox_expiry.c:296-298 deletes all three s-kind records and :312-314 writes LXSD1 at the separate ts||lease key. Before destruction kind 2 holds UsageLedger, and after destruction it is absent. ReadSandbox in modules/lxphost/read_program.go exposes only the s-kind family."
expected = "Requirement 13048 and the terminal verifier must name the same mounted key as the native terminal producer, preserving final destruction evidence across reopen."
proposal = "Coordinate programs/crates/layerx-programs-sandbox/src/expiry.rs, src/modules/programs/sandbox_expiry.c, modules/lxphost/read_program.go and requirement 13048 around one dedicated terminal key. Prove the exact native terminal after destruction and node-store reopen, and reject usage-ledger values as terminals."
owner_domain = 13
interface = "13.rs-sbx-expiry-authenticatedterminalrecord-verify"

[finding.restore-authority]
file = "programs/crates/layerx-programs-sandbox/src/snapshot.rs"
line = 617
class = "security"
severity = "high"
observed = "restore copies cells into the target lease execution-principal namespace, but passes the caller-supplied AuthorizationContext unchanged into Abi::new. validate_restore requires that principal to equal the tenant. Normal execute.rs:29-39 instead derives the lease principal with only StorageRead and StorageWrite; restore neither derives that principal nor restricts its grants."
