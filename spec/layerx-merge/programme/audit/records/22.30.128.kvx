interface = "13.rs-sbx-snapshot-restore"

[finding.snapshot-allocation-bounds]
file = "programs/crates/layerx-programs-sandbox/src/snapshot.rs"
line = 92
class = "runtime-risk"
severity = "medium"
observed = "SandboxState::from_canonical passes attacker-controlled globals_count, argument_count and cell_count to Vec::with_capacity before Self::new enforces MAX_SANDBOX_GLOBALS, MAX_SANDBOX_OPERAND_STACK and MAX_SANDBOX_NAMESPACE_CELLS. A short malformed record can request a capacity overflow or enormous allocation before decoding fails."
expected = "Snapshot decoding must reject declared counts and lengths outside lease and protocol bounds before allocating memory or iterating over them."
