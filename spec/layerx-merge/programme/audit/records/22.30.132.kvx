[interface_review.8.fmt-perf-db-checkpoint]
direction = "consumes"
producer = "services/platform/perf-db/src/relational/checkpoint.rs"
signature = "pub struct CheckpointStore {"
registry_status = "stable"
assessment = "lexical-only"
notes = "Checkpoint labels in UI copy and imported chain fixtures do not construct the performance database CheckpointStore or use its storage format. No perf-db transport or restart dependency exists in these members."

[interface_review.8.http-gateway-any-explorer]
direction = "consumes"
producer = "services/platform/hosted/gateway/src/explorer_proxy.rs"
signature = "rest == \"/explorer\" || rest.starts_with(\"/explorer/\") || rest.starts_with(\"/explorer?\")"
registry_status = "stable"
assessment = "finding"
notes = "Gateway owns /explorer prefix with explicit proxy route selection and bounded path segments. Catalogue is copy, not HTTP transport; apps/web renderers still display side balances and anchor settlement, recorded in split-balances-and-settlement-copy without conflating all explorer routes with archive endpoints."

[review.requirements]
requirements = ["22108.1", "14991.1", "14038.1", "14038.2", "14002.1", "14002.2", "14061.1", "14061.2", "14062.1", "14062.2", "14243.1", "14243.2", "14280.1", "14288.1", "14506.1", "14519.1", "18955.1", "18870.1", "18870.2", "18896.1", "181173.1"]
source_review = "22108.1/14991.1: frozen install and tsc remain entry points, not executed here. 14002.1-2: operation-retired copy and exact generated projection retained. 14038.1-2: receipt block/revert text retained. 14061.1-2/14062.1-2: retired binding/verification keys absent, payout wallet and unavailable/receipt-verified remain. 14243.1-2: retained capabilities and optional absent feed. 14280.1/14288.1/18955.1: status ladder, evm/pax/did order and total balances compared with producer; fixture disagreement recorded. 14506.1/14519.1: five-leg and app-env agreement cases present. 18870.1-2: typed native export exists but prohibited cast persists. 18896.1: same-block higher-index cases exist in applyPriceUpdates.spec.ts. 181173.1: accepted producer filtering compared with failed fixture and market queries."
acceptance = "22998.1 qualifies this record through the declared audit checker and graph checks in hf-done. No dependency upgrade, product suite success or unrelated failed-target repair is claimed."
