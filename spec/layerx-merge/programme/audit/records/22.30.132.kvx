signature = "{chain, chain_id, kind, configuration, genesis_hash, program_id, program_data_account, owner, threshold, commitment, vault_authority, vault_handle, attestors, assets}"
registry_status = "stable"
assessment = "aligned"
notes = "Fixture records/solana.json and deploy-solana-program.sh writer agree on chain id 91600046870081, base58 program/PDA keys, hex20 handle, finalized commitment, attestor array and decimal-string caps. Both additionally carry loader/ELF/signature/slot/publisher/upgrade-authority provenance. appenv.LoadRecord accepts extra JSON fields and intentionally reads the chain/kind/program_id subset; checklist/deploy tests read the remaining fields with jq. Registry signature summarizes core fields, not an exact-key decoder."

