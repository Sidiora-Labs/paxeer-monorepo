[interface_review.8.err-cli-32700]
direction = "consumes"
producer = "tools/platform/cli/src/a2a.rs"
signature = "return failure(Value::Null, -32700, \"the message is not valid JSON\");"
registry_status = "stable"
assessment = "lexical-only"
notes = "Dry-run HTTP facades emit standard JSON-RPC parse-error -32700 locally; they do not call CLI A2A parsing, hosted gateway or retired relay archive. Shared numeric error code is not a service dependency."

