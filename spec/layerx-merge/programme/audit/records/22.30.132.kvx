[finding.price-fixture-cast]
file = "apps/explorer/mocks/txs/tx.ts"
line = 503
class = "test-gap"
severity = "medium"
observed = "priceUpdate casts feedMock.priceUpdate through unknown to Transaction. TxsListItem.spec.tsx, TxsTableItem.spec.tsx and TxsContent.spec.tsx consume this export as a Transaction; the separate priceUpdateItem export does not remove the escape."
expected = "Requirement 18870.2 explicitly forbids this cast. FeedView.prepare_update emits a native type-127 PriceUpdateItem without the EVM-only required Transaction fields."
proposal = "Export the real PriceUpdateItem in apps/explorer/mocks/txs/tx.ts; update apps/explorer/ui/txs consumers and tests to narrow Transaction | PriceUpdateItem before reading EVM-only fields and drive them with backend-emitted items."
owner_domain = 14

[finding.rpc-receipt-status]
file = "apps/explorer/mocks/txs/tx.ts"
line = 496
class = "test-gap"
severity = "medium"
observed = "rpcTxReceipt sets status to 'success' with a RpcTransactionReceipt type assertion. Home.pw.tsx returns this object directly as eth_getTransactionReceipt when exercising the RPC fallback."
expected = "rpc/tx.go renders receipt.Status as hexutil.Uint: the JSON-RPC wire carries 0x1 or 0x0. The success string belongs to the decoded viem receipt, not its transport representation."
proposal = "Replace this value in apps/explorer/mocks/txs/tx.ts with the real RPC hex status and remove the assertion. Exercise Home.pw.tsx through the normal viem decoder with successful and reverted receipts emitted by rpc/tx.go."
owner_domain = 7

[finding.failed-observations-accepted]
file = "apps/explorer/mocks/paxeerX/feed.ts"
line = 60
class = "test-gap"
severity = "medium"
observed = "failedPriceUpdate changes only hash, status and result after spreading priceUpdate, retaining accepted: true on both observations. PaxeerXFeedUpdateDetails.spec.tsx uses this impossible combination for failed submissions."
expected = "Explorer.PaxeerX.CosmosRest.decode_price_updates sets accepted to code == 0 and not refused?, so failed submissions have no accepted observation. Requirement 181173.1 excludes failed and refused observations from live markets."
