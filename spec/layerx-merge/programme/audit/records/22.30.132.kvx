[interface_review.7.rpc-eth-call]
direction = "consumes"
producer = "rpc/simulate.go"
signature = "func (s *SimulationAPI) Call(ctx context.Context, args export.TransactionArgs, blockNrOrHash *rpc.BlockNumberOrHash, overrides *export.StateOverride, blockOverrides *export.BlockOverrides) (result hexutil.Bytes, returnErr error)"
registry_status = "stable"
assessment = "aligned"
notes = "Bridge scripts use JSON-RPC 2.0 matching ids, hex ABI calldata/results, hex chain/balance quantities and 0x code bytes. Anvil calls and recorded replies share that contract. Paxeer facade implements eth_call reads rather than normal signed transaction admission; receipt wire fixture drift is separately recorded."

