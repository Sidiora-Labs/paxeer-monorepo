[finding.occupancy-ledger-capacity]
file = "programs/crates/layerx-programs-runtime/src/occupancy.rs"
line = 1191
class = "interface-mismatch"
severity = "high"
observed = "import_activation_position admits up to 256 occupied namespaces without checking encoded bytes. canonical_state writes 260 bytes per principal-scoped position: 256 positions exceed 60000 bytes before the header. canonical_decode rejects that output at line 1445; prepare_positions and ffi_call.rs publish_occupancy also refuse it. Native batch finalization imports these activation positions."
expected = "The admitted occupancy ledger must round-trip through canonical-state and canonical-decode and remain settleable after activation and restart. The position-count and persisted-byte limits must describe the same supported state."
proposal = "In programs/crates/layerx-programs-runtime/src/occupancy.rs and ffi_call.rs, preflight the complete activation migration against actual canonical ledger and settlement byte budgets before admission. Derive limits from namespace encodings or design explicitly bounded persisted pages. Prove the maximum admitted migration, publication, reopen and next-block settlement without merely raising caps."
owner_domain = 13
interface = "13.rs-rt-occupancy-occupancyledger-canonical-state"

[finding.occupancy-unpaid-replay]
file = "programs/crates/layerx-programs-runtime/src/occupancy.rs"
line = 1397
class = "interface-mismatch"
severity = "high"
observed = "replay_evidence compares decoded current evidence directly with prepare_batch output. The ffi_call.rs native batch finalizer calls unavailable_occupancy_payers and defer_unpaid before publishing: Paid becomes InsufficientFunds, remaining mandate balance is restored, arrears accrue and the position freezes. replay_evidence has no authenticated payer-balance input and never applies that transformation, so valid published unpaid evidence is rejected as MalformedEvidence."
expected = "The declared replay interface must accept evidence emitted by the native settlement producer for funded and insufficient-funds payers and reproduce the same ledger transition after recovery."
proposal = "Extend occupancy.rs replay and its native caller to authenticate relevant payer balances or debit outcomes and derive the same all-or-nothing payer deferral before comparing settlements. Prove paid, unpaid and mixed-payer evidence from the actual producer through decode and replay across a persisted-ledger reopen, including altered outcomes."
owner_domain = 13
interface = "13.rs-rt-occupancy-occupancyledger-replay-evidence"

[finding.scan-copying-cost]
file = "programs/crates/layerx-programs-runtime/src/storage/scan.rs"
line = 318
class = "runtime-risk"
severity = "medium"
observed = "The scan loop clones each value and then clones all accumulated entries and serializes the growing page on every iteration to check max_bytes. A 64-entry page of one-MiB values copies roughly two GiB cumulatively before host output-capacity validation and final metering; an oversized first value is also copied before refusal."
expected = "Ordered-scan ceilings should bound host work as well as returned bytes. Resource checks must precede avoidable copying while preserving documented cursor, page encoding, charging and refusal behavior."
proposal = "In storage/scan.rs calculate checked encoded length incrementally from borrowed entries and cursor lengths, then allocate and encode the accepted page once. Carry host output/resource budgets into planning where necessary; cover maximum values, tiny byte ceilings and cursor overhead without weakening any wire or metering assertion."
owner_domain = 13
interface = "13.rs-rt-storage-ordered-scan-storagescan"

[finding.pre-entry-capabilities]
file = "programs/crates/layerx-programs-runtime/src/validate.rs"
line = 699
class = "security"
severity = "medium"
observed = "entry_capability_masks traverses each exported function independently. validate_original_module ignores Payload::StartSection although instantiate_inner executes pre.start. The layerx_reserve allocator invoked for nonempty input is also absent from the selected entry mask. A storage or event import reachable only during start or reservation is omitted from required_interface_capability_mask; runtime host capability checks still apply."
expected = "The capability mask consumed by interface admission should disclose every host capability needed by the selected invocation, including instantiation and input reservation, so descriptor admission agrees with real execution."
proposal = "In validate.rs union start-function and applicable layerx_reserve reachability into each callable entry mask, or explicitly reject effectful pre-entry execution under a documented rule. Test real descriptor binding, admission and execution where the only host effect occurs in start or reserve, including refusal under insufficient capabilities."
owner_domain = 13
interface = "13.rs-rt-validate-validatedmodule-required-interface-capability-mask"

[finding.linker-timing-assertion]
file = "programs/crates/layerx-programs-runtime/src/validate.rs"
line = 1413
class = "test-gap"
severity = "medium"
observed = "deep_composition_measures_the_avoided_per_frame_linker_rebuild asserts an ordering between independently sampled wall-clock medians. Scheduler noise can make rebuilt instantiation appear faster. per_call_rebuild is calculated from those samples rather than measuring a second complete composition. The neighboring test already counts actual linker constructions."
expected = "Functional qualification should deterministically prove linker reuse and equivalent results. Performance claims should compare measured execution strategies under a benchmark protocol without making correctness gates depend on host scheduling."
proposal = "Move the timing comparison in validate.rs into the runtime benchmark target and measure both complete composition strategies there. Preserve all functional output and linker-count assertions in deterministic tests; report benchmark distributions instead of a universal wall-clock ordering."
owner_domain = 13

