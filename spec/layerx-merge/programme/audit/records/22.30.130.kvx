[finding.routed-sealed-revocation]
file = "programs/crates/layerx-programs-ai-market/tests/f03_evaluator_host.rs"
line = 1445
class = "wiring-gap"
severity = "medium"
observed = "Market.revoke routes unsealed requests but calls authority::apply directly with aggregate_sealed=true after sealing. Real dispatch.rs always passes false in its 0x0301..=0x0303 arm. authority.rs therefore stores and emits excludes_frozen_epoch=true for a frozen evaluator revoked after sealing on the live route, unlike this test. f04_windows.rs, f05_aggregation_runtime.rs and reputation_lifecycle.rs also supply the flag themselves."
expected = "Routed RevokeEvaluator must derive seal status from committed F05 progress and emit the same revocation state/event as the declared authority operation. Existing sealed aggregation inputs remain immutable and the exclusion bit must describe the actual ordering."
proposal = "In programs/crates/layerx-programs-ai-market/src/dispatch.rs derive aggregate_sealed from persisted aggregation progress. Replace the four suites direct authority branches with registered calls before and after BeginAggregation; assert the stored revocation, emitted exclusion bit and unchanged sealed settlement."
owner_domain = 13
interface = "13.rs-aim-evaluators-authority-apply"

