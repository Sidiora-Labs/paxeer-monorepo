[finding.legacy-token-instance-topic]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/channels/token_instance_channel.ex"
line = 7
class = "interface-mismatch"
severity = "high"
observed = "UserSocket routes token_instances_old:* on /socket (channels/user_socket.ex:11), but TokenInstanceChannel.join/3 only matches token_instances:*. The legacy route therefore raises a join function-clause error; the same channel works on /socket/v2 with the unprefixed topic."
expected = "Registry rows 14.ws-explorer-channel-socket-token-instances-old and 14.ws-explorer-join-socket-token-instances-token-contract-address-hash must describe a route whose topic reaches its join handler and receives the metadata event."
proposal = "In services/explorer/backend/apps/block_scout_web/lib/block_scout_web/channels, align the legacy socket route, join pattern and notifier metadata topic. Preserve the working v2 topic, or explicitly retire the old route and document that decision. Prove join and delivery over each retained socket."
owner_domain = 14
interface = "14.ws-explorer-channel-socket-token-instances-old"

[finding.pricefeed-unsigned-sequence]
file = "services/explorer/backend/apps/explorer/lib/explorer/paxeer_x/cosmos_rest.ex"
line = 234
class = "interface-mismatch"
severity = "high"
observed = "CosmosRest.observation/1 bounds sequence and source_timestamp_ms to 9223372036854775807, and market_id to signed int32. api/pricefeed/tx.proto:20-24 declares uint64. modules/pricefeed/types/msgs.go:67 and keeper/observation.go:36 permit a fresh sequence of 9223372036854775808, which the REST decoder rejects. The price-observations migration also stores sequence as signed bigint, so retrying the block cannot repair it."
expected = "The explorer must retain the exact unsigned sequence emitted by MsgSubmitPrices, including valid values above signed int64, and show refused observations without rejecting the whole committed block. Brief check_1 requires identical numeric ranges through transport and storage."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/paxeer_x/cosmos_rest.ex and chain/paxeer_x schemas and migrations, represent uint64 observation fields losslessly, using decimal storage where needed. Add a producer-originated boundary case at 2^63 through node REST, indexer persistence, REST and socket presentation; do not narrow the node contract."
owner_domain = 14
interface = "3.proto-pricefeed-msgsubmitprices"

[finding.auth-session-optionality]
file = "services/explorer/services/libs/blockscout-auth/src/auth.rs"
line = 14
class = "interface-mismatch"
severity = "high"
observed = "AuthSuccess requires email: String and watchlist_id: i64. The GET and POST authenticate actions return current_user unchanged; account/session.ex:16 declares email nullable and does not require watchlist_id. Identity.session_info/2:277-285 omits watchlist_id for an unverified account, and wallet sessions can carry email=nil. A valid HTTP 200 session becomes BlockscoutApi invalid body."
expected = "Rows 14.http-get-api-account-v2-authenticate and 14.http-post-api-account-v2-authenticate must round-trip every supported backend session. Optional profile data must not turn an authenticated wallet or unverified account into an upstream protocol failure."
proposal = "In services/explorer/services/libs/blockscout-auth/src/auth.rs, model the producer session variants explicitly, preserving the distinction between authentication and email verification. Require a watchlist only for operations that need one. Exercise backend-created wallet, unverified-email and verified sessions over the real GET and POST endpoints into the Rust decoder."
owner_domain = 14
interface = "14.http-get-api-account-v2-authenticate"

[finding.phoenix-leave-reply-filtered]
file = "services/explorer/services/libs/actix-phoenix-channel/src/client.rs"
line = 84
class = "interface-mismatch"
severity = "high"
observed = "ChannelClient.allow_leave removes the topic before queueing reply_ok. ClientReceiver.poll_next applies SubscriptionRegistry.subscribes to individual replies as well as broadcasts. The queued phx_reply is neither on a subscribed topic nor a system event under event.rs:97-98, so the leave acknowledgement is discarded."
expected = "The declared Phoenix 2.0 websocket interface must acknowledge a phx_leave with the original topic, ref and join_ref even after removing its subscription. Protocol replies must not depend on continued broadcast membership."
proposal = "In services/explorer/services/libs/actix-phoenix-channel/src/client_receiver.rs, separate direct replies from topic-filtered broadcasts, or retain explicit reply eligibility after leave. Add a real websocket exchange that joins, leaves, receives the acknowledgement and observes no later broadcasts for that topic."
owner_domain = 14
interface = "14.ws-phoenix-channel-lib-socket-websocket"

[finding.phoenix-error-reply-shape]
file = "services/explorer/services/libs/actix-phoenix-channel/src/client.rs"
line = 66
class = "interface-mismatch"
severity = "high"
observed = "ChannelClient.reply_error sends phx_error with the raw error payload. Phoenix request and join failures are replies with event phx_reply and a {status: error, response: ...} payload. A rejected join is additionally filtered because no topic subscription exists, so a Phoenix client waits for a reply that never arrives."
expected = "The websocket route registered by configure_channel_websocket_route advertises Phoenix 2.0 framing; success and refusal must both resolve the matching client ref. phx_error is a channel lifecycle event rather than a substitute for a request refusal."
proposal = "In services/explorer/services/libs/actix-phoenix-channel/src/client.rs, emit the Phoenix error reply envelope with original refs, and deliver it independently of subscriptions. Prove a rejected join and a rejected request using an actual Phoenix client against the registered Actix websocket route."
owner_domain = 14
interface = "14.ws-phoenix-channel-lib-socket-websocket"

[finding.cache-cancellation-poisons-inflight]
file = "services/explorer/services/libs/recache/src/handler.rs"
line = 155
class = "runtime-risk"
severity = "medium"
observed = "CacheRequest.execute inserts a Shared computation into inflight, but cache.set and inflight.remove live only in the first caller wrapper at lines 158-165. Cancelling that caller leaves the entry resident. Later callers take the occupied branch, await the old computation, and neither persist its result nor remove it, so even an old error can be retained indefinitely."
expected = "A cancelled HTTP caller must not leave a cache key permanently attached to an obsolete computation or error. Shared work must have a bounded lifecycle and eventual cleanup independent of the first waiter."
proposal = "In services/explorer/services/libs/recache/src/handler.rs, give the computation and cleanup a cancellation-safe owner and ensure success, failure and cancellation release inflight ownership. Prove cancellation followed by a second request and TTL expiry against the Redis store; ensure a retry computes current data."
owner_domain = 14

[finding.recaptcha-expected-fields-optional]
file = "services/explorer/services/libs/recaptcha-verifier/src/client.rs"
line = 58
class = "security"
severity = "medium"
observed = "RecaptchaClient.verify only compares expected_hostname when the response includes hostname. Expected action and minimum score are enforced only inside if let Some(score); success=true with absent hostname, action or score can therefore satisfy a request that explicitly requires those checks."
expected = "An explicitly configured hostname, action or score requirement must be established before a captcha token is accepted. Missing evidence cannot satisfy the caller security policy, even when the verification response says success."
proposal = "In services/explorer/services/libs/recaptcha-verifier/src/client.rs and types.rs, distinguish v2 and v3 expectations and reject absent fields required by the selected mode. Cover missing hostname, missing action and a v2 response presented for a v3 requirement with the declared typed refusals."
owner_domain = 14

[finding.api-client-debug-credential]
file = "services/explorer/services/libs/api-client-framework/src/blockscout/config.rs"
line = 40
class = "security"
severity = "medium"
observed = "Config implements Debug through ConfigDebug, which derives Debug over api_key: [REDACTED_SECRET] deserialize_api_key creates ordinary HeaderValue values without marking them sensitive. Formatting the configuration with Debug can print the backend API credential."
expected = "Brief check_8 requires secrets never to be logged. Debug output used for service startup and configuration diagnostics must be safe regardless of the caller logging context."
proposal = "In services/explorer/services/libs/api-client-framework/src/blockscout/config.rs, redact api_key in Debug unconditionally and mark deserialized credential headers sensitive. Check that formatting a configuration containing a distinctive credential never includes its value."
owner_domain = 14

[finding.auth-http-unbounded-wait]
file = "services/explorer/services/libs/blockscout-auth/src/auth.rs"
line = 85
class = "runtime-risk"
severity = "medium"
observed = "auth_from_tokens constructs reqwest::Client::new and awaits send and text without an overall timeout. get_user_info_from_metadata in blockscout-auth/src/user.rs:45 does the same. A backend that accepts a connection but stalls can retain authentication requests indefinitely."
expected = "Authentication and user-info calls must finish or return a typed upstream failure within a configured request deadline. Backpressure must not depend on the remote peer closing the socket."
proposal = "In services/explorer/services/libs/blockscout-auth/src/auth.rs and user.rs, share an injected client with explicit connect and whole-response deadlines, and propagate timeout failures as upstream errors. Exercise a real HTTP server that stalls headers or the body and prove bounded completion."
owner_domain = 14

[finding.recaptcha-http-unbounded-wait]
file = "services/explorer/services/libs/recaptcha-verifier/src/client.rs"
line = 21
class = "runtime-risk"
severity = "medium"
observed = "RecaptchaClient.new uses Client::new; verify awaits both the HTTP request and JSON body without configuring a connect or whole-request deadline. The injected-client constructor allows callers to set a timeout, but the default constructor does not establish one."
expected = "A captcha provider outage must yield a bounded verification error and release the inbound request. The default public constructor must enforce the same availability policy as configured clients."
proposal = "In services/explorer/services/libs/recaptcha-verifier/src/client.rs, give the default client explicit connect and total deadlines and allow a documented override. Prove timeout propagation using a real local HTTP peer that holds a response open."
owner_domain = 14

[finding.domain-history-sort-reversed]
file = "apps/explorer/ui/nameDomain/history/utils.ts"
line = 16
class = "runtime-risk"
severity = "medium"
observed = "sortFn returns b.timestamp.localeCompare(a.timestamp) for timestamp-asc and a.timestamp.localeCompare(b.timestamp) for timestamp-desc. NameDomainHistoryTable and its list consumer apply that comparator directly, so the selected timestamp direction displays the opposite order."
expected = "The domain-history Timestamp control must place older events first for ascending and newer events first for descending, consistently on desktop and mobile."
proposal = "In apps/explorer/ui/nameDomain/history/utils.ts, align each comparator with the selected sort direction and cover two distinct event timestamps through the visible history controls."
owner_domain = 14

[finding.uptime-reconnect-timer-leak]
file = "apps/explorer/ui/megaEth/uptime/useUptimeSocketData.ts"
line = 59
class = "runtime-risk"
severity = "medium"
observed = "Each onopen creates an interval and overwrites heartbeatRef. onclose does not clear it, and onReconnect calls connect without closing an earlier socket or cancelling its timer. Unmount clears only the newest interval; old timers continue sending through the mutable websocketRef."
expected = "There must be one socket and one heartbeat per mounted uptime view. Reconnection and unmount must release every earlier timer and socket and ignore events from obsolete connections."
proposal = "In apps/explorer/ui/megaEth/uptime/useUptimeSocketData.ts, close and detach the previous connection, clear its heartbeat before replacement and on close, and ensure only the active connection updates state. Exercise repeated disconnect, reconnect and unmount lifecycles."
owner_domain = 14

[finding.uptime-history-unbounded]
file = "apps/explorer/ui/megaEth/uptime/useUptimeSocketData.ts"
line = 43
class = "runtime-risk"
severity = "medium"
observed = "Every history_delta appends to each history array without retention or deduplication. UptimeCharts filters by time only after smoothing and mapping the entire array, so a long-lived tab retains all received history and repeatedly processes an ever-growing collection."
expected = "The uptime view exposes bounded 3h, 24h and 7d windows. In-memory data and chart work must remain bounded by the displayed history horizon rather than the lifetime of the browser tab."
proposal = "In apps/explorer/ui/megaEth/uptime/useUptimeSocketData.ts, prune each series to its declared horizon and bound point counts while merging deltas; deduplicate reconnect history. Verify sustained deltas preserve the visible windows while memory and chart input counts stay bounded."
owner_domain = 14

[finding.playwright-affected-false]
file = "apps/explorer/tools/scripts/pw.sh"
line = 22
class = "test-gap"
severity = "medium"
observed = "check_affected_flag iterates arg but extracts the value from is_affected_arg, which is never assigned. Passing --affected=false therefore sets affected_flag=true. If the affected-tests file is empty, the script exits zero without running the suite the caller requested."
expected = "An explicit --affected=false must run the normal requested test selection. A test entry point must not silently change that request into an empty successful run."
proposal = "In apps/explorer/tools/scripts/pw.sh, parse the current arg and preserve argument boundaries when invoking Playwright. Cover absent, bare, true and false affected flags plus an empty selection, asserting the actual selected test invocation."
owner_domain = 14

[finding.redis-session-revocation-unchecked]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/plug/redis_cookie.ex"
line = 209
class = "security"
severity = "medium"
observed = "RedisCookie.delete calls remove_from_redis and then returns :ok regardless of the DEL result. SET errors in store_to_redis are likewise discarded. If DEL fails while Redis is unavailable and later recovers, the original signed cookie can still pass GET until its stored TTL expires."
expected = "Session invalidation must either be durably applied or explicitly reported as unsuccessful. An infrastructure error must not be reported as a successful revocation while an earlier credential remains usable after recovery."
proposal = "In services/explorer/backend/apps/block_scout_web/lib/block_scout_web/plug/redis_cookie.ex and its logout caller, propagate persistence failures and define a durable invalidation or retry policy. Prove failed deletion and Redis recovery cannot silently restore a supposedly revoked session."
owner_domain = 14

[finding.blacklist-outage-clears-cache]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/fetcher/addresses_blacklist/blockaid.ex"
line = 21
class = "security"
severity = "medium"
observed = "Blockaid.fetch_addresses_blacklist returns an empty MapSet on HTTP failure or JSON decode failure. AddressesBlacklist.run_fetch_task treats it as a successful snapshot, calls delete_all_objects and replaces the cache with that empty set; known malicious or OFAC entries disappear during a provider outage."
expected = "A failed blacklist refresh must preserve the last successful policy snapshot and expose stale or unavailable status. Network failure is distinct from a valid empty blacklist."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/fetcher/addresses_blacklist.ex and addresses_blacklist/blockaid.ex, use an explicit result for fetch failure, retain the last good snapshot and retry with observable status. Cover a successful snapshot followed by HTTP and malformed-body failures."
owner_domain = 14

[finding.state-changes-invents-zero-balances]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/models/transaction_state_helper.ex"
line = 165
class = "runtime-risk"
severity = "medium"
observed = "coin_balance and token_balance trigger asynchronous historical fetches when data is missing, then immediately return Wei.zero or Decimal.new(0). do_state_changes uses those fabricated starting balances and caches the resulting state-change list as if history had been available."
expected = "The transaction state-change display must distinguish an actual zero balance from history that has not yet been fetched. Missing archival data cannot substantiate before and after balances."
proposal = "In services/explorer/backend/apps/block_scout_web/lib/block_scout_web/models/transaction_state_helper.ex, propagate a pending or unavailable state instead of substituting zero, and invalidate or recompute affected cache entries when historic balances arrive. Prove missing history never appears as a confirmed zero balance."
owner_domain = 14

[finding.auth-fixtures-hide-session-variants]
file = "services/explorer/services/libs/blockscout-auth/src/mock.rs"
line = 61
class = "test-gap"
severity = "medium"
observed = "mock.rs auth_resp always emits email as a string, watchlist_id as user.id and email_verified=true. MockUser cannot express a wallet-only null email or an unverified session without a watchlist, although the backend emits those shapes. The auth tests therefore miss auth-session-optionality."
expected = "The account interface needs evidence from every actual producer session variant. A fixture that admits only the fully populated variant cannot prove the backend-to-Rust decoder path."
proposal = "In services/explorer/services/libs/blockscout-auth tests, obtain responses from the real account backend for wallet, unverified and verified users and decode them through the production client, including GET and POST authentication. Preserve the existing verified-session assertions."
owner_domain = 14

