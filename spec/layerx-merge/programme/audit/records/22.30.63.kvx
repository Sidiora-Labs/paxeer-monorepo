[finding.001]
file = "wasm/benchmarks/app_test.go"
line = 36
severity = "medium"
observed = "SetupWithGenesisAccounts accepts testing.TB but asserts b.(*testing.T). BenchmarkTxSending passes *testing.B through InitializeWasmApp, so initialization deterministically panics before measuring any transaction."
expected = "The actual benchmark caller must be able to initialize the real application and reach transaction delivery."
proposal = "Provide a benchmark-compatible application initializer accepting testing.TB, adapt the owning node helper as needed, and exercise initialization through the actual benchmark entrypoint without weakening assertions."
owner_domain = 6
class = "test-gap"

[finding.002]
file = "wasm/benchmarks/app_test.go"
line = 26
severity = "medium"
observed = "setup receives db, invCheckPeriod and WASM options but calls paxapp.Setup(t, false, false, false) without using them. The memdb and leveldb cases do not select the database they claim to measure."
expected = "The database selected by each benchmark case must back the application workload, and advertised setup options must be applied."
proposal = "Inject the selected database and supported options into the real application constructor in wasm/benchmarks/app_test.go and assert that its selected backend is used by delivered transactions."
owner_domain = 6
class = "test-gap"

[finding.003]
file = "wasm/benchmarks/bench_test.go"
line = 103
severity = "medium"
observed = "The measured loop uses b.N/blockSize full blocks, delivering no transaction when b.N is smaller than blockSize and dropping any remainder while reporting b.N operations."
expected = "Every benchmark calibration must execute exactly its reported transaction count, including a final partial block."
proposal = "Process all b.N generated transactions in bounded batches, handle the final partial block and assert the delivered count before accepting timing results."
owner_domain = 6
class = "test-gap"

[finding.004]
file = "wasm/benchmarks/bench_test.go"
line = 116
severity = "medium"
observed = "InitializeWasmApp ends and commits block 2; the measured loop delivers and ends block 3 and successive blocks without BeginBlock for those heights."
expected = "Measured transactions must follow the real begin, deliver, end and commit lifecycle, including keeper hooks and per-block context."
proposal = "Begin every measured block through the actual node lifecycle in wasm/benchmarks/bench_test.go, retain delivery success assertions, then end and commit it and check successive committed heights."
owner_domain = 6
class = "test-gap"

[finding.005]
file = "wasm/Makefile"
line = 81
severity = "medium"
observed = "The standalone build depends on absent wasm/go.mod and wasm/go.sum and targets absent ./cmd/wasmd. SDK_PACK and linker flags still name upstream cosmos-sdk and CosmWasm/wasmd instead of the root fork."
expected = "The embedded WASM module must build through the actual root module and supported paxd targets, using existing manifests and packages."
proposal = "Replace standalone wasmd recipes in wasm/Makefile with supported root-module paxd and module developer targets, or explicitly retire this build entrypoint and point developers to the maintained root commands."
owner_domain = 6
class = "config-drift"

[finding.006]
file = "services/platform/hosted/node/tests/sequencer-seed-test.py"
line = 107
severity = "medium"
observed = "bootstrap and supervisor_command start build/bin/layerxd as an independent sequencer and pass --settlement-document from checkpoint-settlement.json; assertions depend on separate sequencer.env and supervisor key propagation."
expected = "The finished network runs its kernel in paxd and has no independently bootstrapped layerxd sequencer or checkpoint settlement service."
proposal = "Migrate the hosted seed harness to integrated paxd key loading and restart, preserving secret-file permissions, no-copy assertions, invalid-key rejection and key propagation checks."
owner_domain = 8
class = "retired-reference"
interface = "8.cli-node-bootstrap-sh-layerxd"

[finding.007]
file = "services/platform/hosted/node/tests/signer-test.py"
line = 607
severity = "medium"
observed = "BootstrapTreasuryCase skips when layerxd or layerx-genesis-build is absent and otherwise invokes the retired daemon and settlement-document bootstrap. A merged-node checkout can omit treasury bootstrap coverage entirely."
expected = "Treasury signer bootstrap must be exercised against the supported merged node instead of disappearing when an intentionally retired daemon is absent."
proposal = "Move BootstrapTreasuryCase onto real paxd signer bootstrap and require its actual prerequisites explicitly; preserve peer-credential, key-binding, private-file and signature assertions in this suite."
owner_domain = 8
class = "test-gap"
interface = "8.cli-node-bootstrap-sh-layerxd"

