[review.method]
requirements = ["22998.1", "22012.1", "8348.1", "13083.1", "5093.1", "89817.1", "6015.1", "6063.1", "6009.1", "6271.1", "6272.1", "6273.1", "6274.1", "6275.1", "6276.1", "6484.1", "6484.2", "6484.3", "6484.4", "6487.1", "6487.2", "6487.3", "6488.1", "6488.2", "6488.3", "6489.1", "6489.2", "6489.3", "6489.4", "6489.5", "6489.6", "6490.1", "6490.2", "6490.3", "6491.1", "6491.2", "6491.3", "6491.4", "6492.1", "6492.2", "6493.1", "6493.2", "6493.3", "6493.4", "6494.1", "6494.2", "6494.3", "6494.4", "6494.5", "6494.6", "6494.7", "6494.8", "6494.9", "6494.10", "6494.11", "6494.12", "6494.13", "6494.14", "6494.15", "6494.16", "6494.17", "6494.18", "6494.19", "6495.1", "6495.2", "6495.3", "6495.4", "6496.1", "6496.2", "6496.3", "6496.4", "6497.1", "6497.2", "6497.3", "6497.4", "6497.5", "6805.1", "6841.1", "6841.2", "6841.3"]
produces_reviewed = 400
consumes_reviewed = 400
notes = "Every non-generated member was read in full. Review covered listed registry signatures, status and callers, producer/transport/consumer field shapes and encodings, registration, errors, authority, untrusted lengths, gas, state and recovery. Only generated setup helpers take generated verdicts. No daemon, benchmark or broad runtime test was executed; only declared record gates qualify this task."
retirement = "Decision 2231 disables custody proof verification even below merge. Decision 2316 keeps raw Ed25519, standalone receipt and state proof below merge; tagged domains, inclusion and discovery always refuse. Current tests honor these decisions and resolved findings were not reopened."
recovery = "Custody and bridge state is keeper-backed: claims, deposit indices, replay protection and module balances are not an in-memory daemon cache. Reviewed upgrade done-height lookup and refusal before mutation. Hosted seed tests need migration to the integrated node restart path."
extent = "Package produces and consumes lists are capped; every listed row was reviewed. Deleted C harness interfaces and absence tests were interpreted using lifecycle status instead of being mistaken for live callers."

[review.bridge]
notes = "Bridge signature arrays, bank units, topic/data indexing and attestation domains were traced through Go/Solidity, services/interop/crates/layerx-bridge-relayer/src/abi.rs, services/agent/sdk/python/layerx_sdk/bridge.py and ATTESTATION.md. Current hosted gateway asset reads use ledger 0x101a, not old custody joins. Retained platform core/probe custody helpers preserve historical tuple encoding; their declarations do not establish merged service availability."

[review.proto]
notes = "EVM and WASM protobuf names, scalar/bytes shapes, signer metadata and routes agree with generated native types. XWeb program IDs use base64 bytes over grpc-gateway with actual length-32 checks; request/result handlers distinguish InvalidArgument and NotFound. Params produces only params, making the registry paused-field claim documentary drift rather than an observed live decoder failure."
