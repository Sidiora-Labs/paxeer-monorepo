[finding.009]
file = "precompiles/layerxcustody/LayerXCustody.sol"
line = 8
severity = "medium"
observed = "NatSpec promises verified receipt withdrawals and forced exits without a retirement notice. Its gas table omits registerDepositRoot, which Signatures charges one signature and Writes charges two writes."
expected = "Integrators must distinguish historical ABI from availability: all twenty methods retire at merge and proof claim creation is already disabled; gas documentation must match registration."
proposal = "Label this Solidity ABI historical, document exact LXP_MODULE_DISABLED behavior and the merge boundary, explain the disabled proof paths and add registerDepositRoot gas terms without changing selectors."
owner_domain = 6
class = "doc-drift"

[finding.010]
file = "precompiles/layerxcustody/layerxcustody.go"
line = 1
severity = "medium"
observed = "The package comment says proofs are verified to create and pay claims although withdrawal and forced-exit validators unconditionally refuse retired operations. Its gas comment omits registerDepositRoot signature/write terms."
expected = "Package documentation must distinguish retained historical state from disabled proof creation and the merge-wide gate, and agree with Signatures and Writes."
proposal = "Rewrite the custody package comment around historical compatibility and the exact retirement boundary; document registerDepositRoot as one signature and two writes and identify the supported merged replacement flow."
owner_domain = 6
class = "doc-drift"

[finding.011]
file = "precompiles/layerxverify/LayerXVerify.sol"
line = 8
severity = "medium"
observed = "NatSpec says no chain state is read and advertises tagged Ed25519, inclusion and discovery proofs. Execute reads upgrade state, and all non-255 domains plus inclusion and discovery are unconditionally retired."
expected = "Interface prose must describe the historical method split and merge gate rather than suggesting every retained selector is an available proof service."
proposal = "Label the verifier ABI historical and document raw-domain, receipt and state-proof availability below merge, unconditional retirement of the other operations and exact disabled-module errors; preserve selector compatibility."
owner_domain = 6
class = "doc-drift"

[finding.012]
file = "precompiles/layerxverify/layerxverify.go"
line = 1
severity = "medium"
