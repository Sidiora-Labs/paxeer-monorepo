[finding.memory-monitor-worker-race]
file = "services/explorer/backend/apps/indexer/lib/indexer/memory/monitor.ex"
line = 195
class = "runtime-risk"
severity = "medium"
observed = "shrinkable_memory_pairs snapshots monitored worker PIDs, but shrink then makes unprotected GenServer.call operations through queued_entry_count and shrink. A worker that exits before or between those calls causes an exit in the monitor before it can consume DOWN. memory(pid) can also return zero for a dead worker before the later percentage division. Indexer.Application uses rest_for_one to restart dependent workers when this monitor dies."
expected = "Ordinary fetcher shutdown or restart during memory-pressure handling must not crash the memory monitor or trigger additional indexing restarts; actual memory pressure and worker faults must remain visible."
proposal = "In services/explorer/backend/apps/indexer/lib/indexer/memory/monitor.ex and memory/shrinkable.ex, handle the known dead-worker race around queue inspection and shrink, remove the stale PID and continue with remaining workers, and guard zero memory before division; add a real GenServer lifecycle test that exits a monitored worker during shrinking and verifies surviving workers are still serviced."
owner_domain = 14

