findings = []
notes = "Legacy exchange indexes bytes32 intentId/account and address owner; data is bytes32 assetId, uint256 amount, bytes32 depositId and uint64 nonce. Dedicated market tests agree and preserve precision above uint64."

[interface_review.3.pc-0x1015-exchange-evt-orderplaced]
registry = "3.pc-0x1015-exchange-evt-orderplaced"
producer = "precompiles/layerxexchange/abi.json"
signature = "OrderPlaced(bytes32 indexed,bytes32 indexed,address indexed,uint8,uint256,uint256,uint8,uint64)"
registry_status = "stable"
