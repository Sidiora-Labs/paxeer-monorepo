[requirement_review.14256.1]
requirement = "14256.1"
assessment = "application_test.exs exercises the ignored legacy relay environment against actual application children; the retired fetcher source is absent."

[requirement_review.14258.1]
requirement = "14258.1"
assessment = "paxeer_x_logs_retired_test.exs correctly rejects custody/anchor rows; paxeer_x_logs_test.exs still positively requires retired events and schemas."

[requirement_review.14259.1]
requirement = "14259.1"
assessment = "fetcher_paxeer_x_options_test.exs asserts exactly the two binding/market importer options produced by the live Fetcher.import_options path."

[requirement_review.14262.1]
requirement = "14262.1"
assessment = "Kept signatures and indexed layouts were compared with addr, perps, exchange, bridge and both launchpad ABIs; the ABI test maps 0x1015 only to legacy exchange."

[requirement_review.14262.2]
requirement = "14262.2"
assessment = "Retirement-specific tests exclude both addresses; general positive custody/anchor tests contradict that exclusion and must become explicit refusal coverage."

[requirement_review.14262.3]
requirement = "14262.3"
assessment = "Launchpad definitions retain twelve modern and ten legacy events; dedicated fixtures assert all modern parameter shapes and retain legacy topic/signature checks."

[requirement_review.14300.1]
requirement = "14300.1"
assessment = "binding_log_still_parses preserves indexed EVM address, DID key bytes and nonce through the retained binding projection."

[requirement_review.14300.2]
requirement = "14300.2"
assessment = "market_logs_still_parse preserves margin event identity, arbitrary precision amount and launchpad fee-claim recipient through the retained market projection."

[requirement_review.18865.1]
requirement = "18865.1"
assessment = "PriceUpdates.run compares stored hashes before transactional replacement; the rescan test expects one initial announcement and no duplicate announcement."

[requirement_review.18865.2]
requirement = "18865.2"
assessment = "Notifier consumes price update heights, broadcasts feed/market history, and limits transaction/block live notifications to block_height minus the configured ten-block window; tests here exercise the producer event."

[requirement_review.18772.1]
requirement = "18772.1"
assessment = "The modern CollateralDeposited fixture asserts address account and amount/newBalance alongside legacy MarginDeposited bytes32 account compatibility."

[requirement_review.181076.1]
requirement = "181076.1"
assessment = "Retained decoder returns binding rows, market rows and undecoded_log_count; general @empty/exact-key assertions still include removed tables and receipts."

[requirement_review.18921.1]
requirement = "18921.1"
assessment = "Gateway 503 test verifies repeated retry without increasing definitive failure count; source retries every HTTP 5xx transiently without an attempt cap."

[requirement_review.18922.1]
requirement = "18922.1"
assessment = "Both node orderings test definitive errors; CosmosRest selects a definitive error independently of transient ordering, and PriceUpdates schedules retries only after the batch completes."

[requirement_review.18922.2]
requirement = "18922.2"
assessment = "Tests cover backoff below and at 300000ms and warning suppression after the cap; the source warns only on the ceiling transition and bounds retry delay."

[coverage.security]
assessment = "No production credential is introduced in this test slice; API-key and IPFS strings are local fixtures. Metadata retry and URI handling are reviewed alongside actual helper configuration. The search success handlers do not assert authentication headers or receiver schemas, which is recorded as test coverage gaps rather than evidence of a deployed authorization bypass."

[coverage.evidence]
assessment = "Static observations refer to the audited revision and exact member lines. Audit record qualification is limited to the declared hf-build and hf-done wrappers; no explorer runtime gate, network probe or historical inventory command is claimed to have run."
