[interface_review.14.cfg-ethereum-jsonrpc-ethereumjsonrpc-geth]
registry = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-geth"
producer = "services/explorer/backend/config/runtime.exs"
signature = "config :ethereum_jsonrpc, EthereumJSONRPC.Geth [block_traceable?, allow_empty_traces?, debug_trace_timeout, tracer]"
