[interface_review.3.pc-0x1015-evt-orderplaced]
registry = "3.pc-0x1015-evt-orderplaced"
producer = "precompiles/perps/abi/abi.json"
signature = "OrderPlaced(uint256 indexed,address indexed,uint256 indexed,uint8,bool,uint256,uint256)"
registry_status = "stable"
transport = "EVM receipt logs with indexed topic words and ABI data, then native block import"
consumers = ["services/explorer/backend/apps/indexer/test/indexer/transform/paxeer_x_logs_test.exs"]
findings = ["025","029"]
notes = "Modern perps has three indexed values (uint256 orderId, address user, uint256 marketId) followed by uint8/bool/uint256/uint256. Decoder agrees with the ABI; the general fixture selector and ABI validation suite do not distinguish both generations correctly."

[interface_review.3.pc-0x1015-exchange-evt-margindeposited]
registry = "3.pc-0x1015-exchange-evt-margindeposited"
producer = "precompiles/layerxexchange/abi.json"
signature = "MarginDeposited(bytes32 indexed,bytes32 indexed,address indexed,bytes32,uint256,bytes32,uint64)"
registry_status = "stable"
transport = "EVM receipt logs with indexed topic words and ABI data, then native block import"
