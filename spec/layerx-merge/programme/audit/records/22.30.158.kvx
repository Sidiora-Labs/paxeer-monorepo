consumers = ["services/explorer/backend/apps/indexer/test/indexer/transform/paxeer_x_logs_test.exs"]
findings = []
notes = "Legacy OrderPlaced indexes bytes32 intentId/marketId and address owner, with side/price/quantity/timeInForce/nonce in data. It differs from modern perps despite the shared name and emitter; tests must select by signature."

[interface_review.3.pc-0x1015-getmarket]
registry = "3.pc-0x1015-getmarket"
producer = "precompiles/perps/abi/abi.json"
signature = "getMarket(uint256) view returns (string,string,uint256,uint256,uint256,bool)"
registry_status = "stable"
transport = "EVM receipt logs with indexed topic words and ABI data, then native block import"
consumers = ["services/explorer/backend/apps/indexer/test/indexer/fetcher/paxeer_x/price_updates_test.exs"]
findings = []
notes = "Registry includes this selector in the test slice, but PriceUpdates targets 0x1020, not 0x1015. Perps returns six independent values; no test path decodes those as the pricefeed tuple. The shared eb44fdd3 selector is not sufficient to identify a producer."

[interface_review.3.pc-0x1020-getmarket]
registry = "3.pc-0x1020-getmarket"
producer = "precompiles/pricefeed/abi/abi.json"
signature = "getMarket(uint256) view returns ((uint64,string,string,uint256,uint256,bool))"
registry_status = "stable"
transport = "EVM receipt logs with indexed topic words and ABI data, then native block import"
consumers = ["services/explorer/backend/apps/indexer/test/indexer/fetcher/paxeer_x/price_updates_test.exs"]
findings = []
notes = "PriceUpdates targets 0x1020 and encodes a uint256 id. ABI, inline decoder and response fixture agree on tuple(uint64 marketId,string symbol,string chainflowSymbol,uint256 minPrice,uint256 maxPrice,bool enabled), including ABI dynamic offsets."

[interface_review.3.pc-0x1020-getmarketcount]
registry = "3.pc-0x1020-getmarketcount"
producer = "precompiles/pricefeed/abi/abi.json"
signature = "getMarketCount() view returns (uint256)"
registry_status = "stable"
transport = "EVM receipt logs with indexed topic words and ABI data, then native block import"
consumers = ["services/explorer/backend/apps/indexer/test/indexer/fetcher/paxeer_x/price_updates_test.exs"]
findings = []
notes = "Count call uses fd69f3c2 at 0x1020 and decodes uint256; the consumer bounds enumeration to 1024 markets. Market refresh attempts are spaced and updates persist even when metadata must later be refreshed."

