[finding.archive-kdf-cost]
file = "services/wallet/ceremony/internal/archive/archive.go"
line = 165
class = "security"
severity = "medium"
observed = "Unseal accepts unauthenticated scrypt logN up to 22, r up to 32 and p up to 16 before checking the GCM tag. A tiny malformed header can request roughly 16 GiB of KDF memory and excessive CPU."
expected = "Archive loading must bound combined derivation memory and CPU before allocation and still accept every supported legitimate archive profile."
proposal = "In services/wallet/ceremony/internal/archive/archive.go validate combined scrypt cost against supported profiles before newGCM; cover extreme header combinations with refusal before expensive derivation."
