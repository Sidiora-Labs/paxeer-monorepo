observed = "The daemon omits MinRefreshInterval from jwt.Config, leaving zero. Repeated unknown kids can each fetch remote JWKS under lookupKey's global mutex and serialize valid authentication behind ten-second network waits."
expected = "Attacker-selected unknown key ids must not create unbounded refresh work or hold cached-key verification behind remote-network latency."
proposal = "Set an explicit bounded refresh policy in services/wallet/attestor/cmd/attestor/main.go and move remote refresh coordination outside cached-key lookup locking in internal/auth/jwt/jwt.go; cover unknown-kid floods alongside valid verification."
owner_domain = 12
interface = "12.go-att-jwt-new-token-verifier"

