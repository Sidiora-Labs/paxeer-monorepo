class = "runtime-risk"
severity = "medium"
observed = "getReceipt returns null for every exception, including RPC transport and decoding failures; isTxKnown also converts errors into false. routes/agent.ts:242 exposes an outage as 404 receipt not available, and the durable action orchestrator receives an apparent absent transaction instead of an unavailable observation."
expected = "Receipt absence and transaction absence must be distinguished from an unavailable or invalid node response so clients and recovery logic never use an outage as evidence that a transaction was not observed."
proposal = "In services/wallet/gateway/src/chainReads.ts return null only for the node client explicit not-found result, propagate typed unavailability for transport and decode failures, and update routes/agent.ts and action recovery to preserve uncertainty. Prove not-found, pending, unavailable and malformed real-node responses separately."
