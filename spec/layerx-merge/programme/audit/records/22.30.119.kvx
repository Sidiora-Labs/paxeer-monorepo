class = "runtime-risk"
severity = "medium"
observed = "The scheduler pending handler catches every failure as an empty job list and returns 200. The stream lookup at 347 similarly turns every failure into null and returns 404, so a failed RPC or ABI decode is presented as proof that the users jobs or stream do not exist."
