[finding.send-transport-uncertainty]
file = "services/wallet/gateway/src/rpc/pool.ts"
line = 428
class = "interface-mismatch"
severity = "high"
observed = "sendRawTransactionVia computes the local transaction hash, but rethrows any non-RpcResponseError immediately. A timeout, HTTP failure or lost JSON body after node acceptance becomes RpcTransportError without hash or nonce evidence. routes/sign.ts:728 maps it to send_failed with txHash null rather than the typed outcome_unknown response."
expected = "A write with no definitive node refusal must retain the canonical signed hash and nonce and tell consumers to poll that transaction rather than interpret a transport failure as permission to submit another payment."
proposal = "In services/wallet/gateway/src/rpc/pool.ts classify send transport failures as an uncertain broadcast carrying the local hash, nonce and member; preserve the nonce reservation and propagate a poll_receipt response through human and owner routes. Prove node acceptance followed by connection loss through the real transport."
