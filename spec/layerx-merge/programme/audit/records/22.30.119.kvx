[finding.virtual-network-disconnect]
file = "apps/wallet/src/wallet/WalletProvider.tsx"
line = 447
class = "interface-mismatch"
severity = "high"
observed = "WalletNetworkProvider restores and switches a saved virtual chain, but WalletProvider binds chainChanged to invalidate(), disposes the active wallet and signs out. connectEmbedded at 271 rejects the restored virtual chain against expectedChain, and requireWallet at 522 and refresh at 536 still require the root chain."
expected = "Requirements 8361.1 and 20007.1 require the same live provider to retain the selected namespace, route and identity after a switch and to restore that selection after restart."
proposal = "In apps/wallet/src/wallet/WalletProvider.tsx, update connection.chainId on an accepted network switch, retain the connected provider and identity, and validate sends against the active saved network. Prove switch, send refusal for another chain, reload and reconnect through the real provider."
owner_domain = 12
interface = "12.ts-app-wallet-provider"

[finding.evm-approval-recovery]
file = "services/wallet/gateway/src/routes/evmApprovals.ts"
line = 271
class = "restart-recovery"
severity = "high"
observed = "The sign handler commits signing_unknown before attestors.sign. Raw signed bytes and tx_hash are not saved before broadcast and sequencerReceipt; a crash or failure before the final evidence update leaves signing_unknown. Subsequent sign calls at 262 never attempt recovery and GET approvals only reads the row; no recovery worker consumes wallet_evm_approvals."
expected = "An approved EVM transaction must resolve to durable signature and submission evidence or an honest terminal refusal. Restart or a lost reply must preserve the ability to recover the exact authorized transaction without signing a different payment."
proposal = "In services/wallet/gateway/src/routes/evmApprovals.ts and its approval persistence migration, retain the signing session and verified raw bytes plus local hash before submission; add durable reconciliation for interrupted signing and receipt lookup. Distinguish definite pre-sign refusal from uncertain signing and prove restart at each boundary."
owner_domain = 12
interface = "12.http-gw-post-v1-wallet-evm-sign-j49"

[finding.lx-approval-recovery]
file = "services/wallet/gateway/src/routes/sign.ts"
line = 1270
class = "restart-recovery"
severity = "high"
observed = "The retained LX handler commits signing_unknown before attestors.sign and catches signing failures as 202. The repeat handler at 1263 refuses to attempt that state again; GET only reads it. No background consumer resumes wallet_lx_approvals, so even a definitive attestor refusal or a crash after signing can leave an approval pending forever without its signature evidence."
expected = "A retained activity approval must recover the original authorized session and evidence after interruption and present a definitive refusal when no signature could have been produced, rather than permanently consume an approval in an unresolved state."
proposal = "In services/wallet/gateway/src/routes/sign.ts and LX approval storage, persist recoverable session progress, reconcile the original attestor session on retry or restart, and store the verified signature atomically with completion. Add real attestor and database restart coverage for refusal, lost reply and evidence persistence."
owner_domain = 12
interface = "12.http-gw-post-v1-wallet-lx-sign"

[finding.human-daily-cap-fail-open]
file = "services/wallet/gateway/src/policy/index.ts"
line = 97
class = "security"
severity = "high"
observed = "evaluate catches a failed wallet_signatures aggregate and still returns allow. It also reads the daily total before routes/sign.ts:342 acquires its wallet transaction and nonce lock, so concurrent requests can all pass against the same old total. The legacy envelope signing path at sign.ts:365-370 remains reachable and has no independent attestor cap."
expected = "POLICY_MAX_DAILY_VALUE_WEI must bound the total value authorized for a human wallet even during database errors and concurrent requests; a lookup failure cannot grant additional signing authority."
proposal = "In services/wallet/gateway/src/policy/index.ts and routes/sign.ts, reserve daily value durably under the wallet or principal database lock before releasing signing authority, fail closed when the reservation cannot be read or written, and reconcile uncertain sends against that reservation. Prove parallel requests and database refusal on the legacy path."
owner_domain = 12
interface = "12.env-gw-policy-max-daily-value-wei"

[finding.human-unknown-spend-unaccounted]
file = "services/wallet/gateway/src/routes/sign.ts"
line = 714
class = "security"
severity = "high"
observed = "A BroadcastOutcomeUnknownError returns 202 with hash and nonce but no signatureLog. Other broadcast errors at 728 also omit it; only the successful branch at 746 constructs the row. A transaction that reached the node can therefore be missing from wallet_signatures, the source of the human daily value cap."
expected = "Possibly accepted human sends must count against the authorized spend window until a definite rejection or settlement resolves them, just as agent unknown outcomes retain their value under requirement 18818.1."
proposal = "In services/wallet/gateway/src/routes/sign.ts, durably reserve value and retain the signed transaction hash before the network write, keep the reservation on every uncertain result, and reconcile its final outcome without requiring the caller to resubmit. Prove an accepted send followed by a lost reply still consumes the daily cap."
owner_domain = 12
interface = "12.http-gw-post-v1-wallet-send"

[finding.signature-ledger-write-loss]
file = "services/wallet/gateway/src/db/wallets.ts"
line = 493
class = "runtime-risk"
severity = "high"
observed = "logSignature catches every insert failure and returns successfully without a retry record. wallet_signatures is consumed by policy/index.ts daily totals and db/agents.ts sumAgentDailyValue and signature counts, so a completed signing operation can lose the accounting row that later authorizations depend on."
expected = "Authoritative spend and signature accounting must survive a transient insert failure and restart; an operation cannot complete with only a console warning when later policy decisions treat the missing row as zero usage."
proposal = "In services/wallet/gateway/src/db/wallets.ts and signing callers, make the accounting reservation durable before signing or retain a transactional outbox with the signature evidence. Reconcile completion idempotently by request and transaction hash, and test a database write failure followed by restart without permitting additional spend."
owner_domain = 12
interface = "12.key-gw-table-wallet-signatures"

[finding.raw-precompile-policy-bypass]
file = "services/wallet/gateway/src/policy/agent.ts"
line = 341
class = "security"
severity = "high"
observed = "decodeMoverCounterparty knows token and multicall selectors but does not decode served scheduler and streams calls. Raw /v1/agent/send leaves tokenRecipient and tokenContract null, bypassing withdrawal and token-cap checks for the same calldata that agentPrecompiles.ts:169-174 and 275-282 annotates with eventual target, payee, token and cap. Attestor authority.go likewise only decodes the three ERC20 selectors here."
expected = "An agent must receive the same recipient and spend-policy decision for an identical signed precompile call through a helper or the raw sign/send route; encoding a payment manually must not bypass owner restrictions."
proposal = "In services/wallet/gateway/src/policy/agent.ts and services/wallet/attestor/internal/auth/agent/authority.go, decode scheduler and streams operands from the served ABIs for every transaction path, including nested scheduled calls; apply destination, token and withdrawal restrictions consistently and refuse undecodable movement. Prove raw and helper denials with the real precompiles."
owner_domain = 12
interface = "12.http-gw-post-v1-agent-precompiles-streams-open"

[finding.hosted-evm-routes-missing]
file = "services/wallet/gateway/src/routes/evmApprovals.ts"
line = 162
class = "interface-mismatch"
severity = "high"
observed = "The wallet gateway mounts /v1/wallet/evm/review, approve, sign and approvals/:id, and sdk/wallet/src/index.ts calls these routes. tools/paxeer-x/route-catalogue.json contains none of them; services/platform/hosted/gateway/src/lib.rs:786 only forwards a method and path that matches a proxy catalogue row, so the hosted transport cannot deliver these SDK requests."
expected = "The declared EVM review, approval, signing and status interfaces must be reachable from the wallet SDK through the hosted gateway with the same method, authorization, body and response contract as the wallet producer."
