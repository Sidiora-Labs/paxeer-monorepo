[finding.rpc-body-timeout]
file = "services/wallet/gateway/src/rpc/pool.ts"
line = 492
class = "runtime-risk"
severity = "medium"
observed = "postOnce clears its AbortController timer as soon as fetch returns response headers, before res.json at 498. A node that sends headers and then stalls or slowly streams an unbounded JSON body escapes RPC_TIMEOUT_MS and can keep wallet locks and action workers occupied."
expected = "The configured RPC deadline must cover response consumption as well as connection and headers, and a malformed or oversized answer must terminate within a bounded amount of work."
proposal = "In services/wallet/gateway/src/rpc/pool.ts keep the abort deadline active until the response body is fully consumed and decoded, apply a response byte limit appropriate to each method, and always release resources on timeout. Add a real HTTP server test that stalls after headers and one that exceeds the body limit."
owner_domain = 12
interface = "12.ts-gw-rpc-pool"

[finding.action-lease-fencing]
file = "services/wallet/gateway/src/db/actions.ts"
line = 266
class = "restart-recovery"
severity = "medium"
observed = "claimNextAction persists only worker_locked_until, not a lease identity. releaseLease unconditionally clears it by action id and updateAction does not fence mutations by owner. When an expired lease is reclaimed, the original worker can clear the new lease or overwrite progress from the replacement worker."
expected = "After a durable action lease expires and another worker claims it, the old owner must lose permission to release or mutate that action, so recovery cannot overwrite newer evidence."
proposal = "In services/wallet/gateway/src/db/actions.ts add an owner token or increasing lease epoch to claims, conditional progress updates and release; reject stale owners while retaining signed transaction integrity checks. Prove expiry, reclamation and a delayed original worker with two real database connections."
owner_domain = 12
interface = "12.key-gw-table-agent-actions"

[finding.action-lease-duration]
file = "services/wallet/gateway/src/agent/actions/worker.ts"
line = 35
class = "runtime-risk"
severity = "medium"
observed = "startActionWorker sets leaseMs to the receipt timeout or four worker intervals, but advanceAction performs signing, RPC work and a full receipt wait under that fixed lease. It does not renew the lease, so ordinary slow external work can exceed the claim duration before the original tick finishes."
expected = "A healthy action worker must retain ownership throughout its bounded external work or explicitly surrender it before another worker advances the same durable action."
proposal = "In services/wallet/gateway/src/agent/actions/worker.ts renew the fenced action lease while advanceAction is active and stop advancing if renewal fails; bound the complete operation and await in-flight work during shutdown. Exercise a signing delay followed by a receipt timeout with competing workers."
owner_domain = 12
interface = "12.key-gw-table-agent-actions"

[finding.budget-atomicity]
file = "services/wallet/gateway/src/db/agents.ts"
line = 416
class = "runtime-risk"
severity = "medium"
observed = "reserveBudget describes an atomic headroom reservation, but cap and active checks occur only in an unlocked scalar subquery. Concurrent invocations can select the same id from an old snapshot; after a row-lock wait the outer update has no spent_wei plus amount <= cap_wei predicate to recheck before incrementing."
expected = "The budget persistence operation must enforce its headroom, expiry and active conditions at the locked update even when two consumers reserve against the same principal; callers must not need undocumented external serialization to preserve the cap."
proposal = "In services/wallet/gateway/src/db/agents.ts lock the selected budget before checking and incrementing, or repeat all eligibility predicates on the outer atomic update and handle contention explicitly. Add a real PostgreSQL concurrent-reservation test whose combined requested amount exceeds the remaining cap."
owner_domain = 12
interface = "12.key-gw-table-agent-budgets"

