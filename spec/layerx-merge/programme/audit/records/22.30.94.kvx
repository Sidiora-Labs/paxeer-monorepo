[finding.receipt_rpc_roundtrip]
file = "services/agent/crates/layerx-agentd/src/human_receipt_frame.rs"
line = 74
class = "interface-mismatch"
severity = "high"
observed = "ReceiptLookupFrame::write emits canonical bytes, five AuthorizedBatch hashes, verification_level, tx_hash, receipt_hash, block_height, rung, signed_receipt and key/height bindings. human_runtime.rs:13188 returns this frame for found receipts. agent_rpc_dispatch.rs:892-915 still reads only canonical bytes, five hashes and one byte as a Rung. ProgramReceipt at line 1896 uses this old decoder and dispatched at line 1223 requires full consumption, so the real found receipt becomes owner.response_malformed. Human service agent_runtime.rs:4462 correctly shares the new decoder."
expected = "The RECEIPT_LOOKUP and program.receipt interfaces must round-trip the same verified receipt and explicit achieved rung from owner through Agent RPC/MCP, including transaction, receipt-key and inclusion-height bindings."
proposal = "Use ReceiptLookupFrame/ReceiptLookupAnswer in services/agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs for receipt decoding and project the explicit rung while preserving all binding checks. Prove an actual found receipt through owner, HTTP and SDK/MCP before and after store reopen, retaining absent/submitted and malformed-frame refusals."
owner_domain = 9
interface = "9.proto-human-peer-receipt-lookup"

[finding.human_node_key_fixture]
file = "services/agent/crates/layerx-agentd/tests/human_node.rs"
line = 94
class = "test-gap"
severity = "medium"
observed = "human_node_head_and_receipt_keys_come_from_json_rpc serves a bare array with string firstHeight/lastHeight and a firstHeight of zero. Gateway chain_reads.rs:290-303 emits an object containing keys and numeric heights. Client sequencer.rs:879-918 requires that object, integer heights and positive firstHeight, so the fixture cannot reach its success assertions."
expected = "Requirement 22105.1 requires the producer object shape in every fixture; requirement 5250.1 and the client also refuse a receipt-key interval starting at zero."
proposal = "Replace the positive fixture in services/agent/crates/layerx-agentd/tests/human_node.rs with gateway-produced keys and numeric positive ranges, retaining exact key/head assertions. Add malformed-array, string-height and zero-height refusals against the real NodeRpc decoder."
owner_domain = 9
interface = "8.rpc-gateway-px-getreceiptkeys"

[finding.readiness_empty_key_fixture]
file = "services/agent/crates/layerx-agentd/tests/readiness_node_rpc.rs"
line = 32
class = "test-gap"
severity = "medium"
observed = "The test imports empty_node_config from handshake_gate.rs:89-95, which serves a bare empty array, then unwraps node.receipt_keys() and expects an empty Vec and GateError::NoReceiptKeys. NodeRpc delegates to decode_receipt_keys, which rejects both the array and an empty keys object as Malformed before those assertions."
expected = "Requirement 22105.1 requires the empty fixture to contain an empty keys list and still prove refused startup through the actual decoder and gate."
proposal = "Update tests/handshake_gate.rs and services/agent/crates/layerx-agentd/tests/readiness_node_rpc.rs together to use the producer object and assert the actual typed refusal with writes closed. If NoReceiptKeys is a distinct contract, explicitly map the empty-list failure at readiness without bypassing receipt-key validation."
owner_domain = 9
interface = "8.rpc-gateway-px-getreceiptkeys"

