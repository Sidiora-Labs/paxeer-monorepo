# Pre-upgrade audit: programme apps/web slice. Source review; proposed repairs only.

[audit.22.30.185]
task = "22.30.185"
revision = "9d9e94b1751d89ba849d2d3d0f89b48fabce9756"
files_reviewed = 9
findings = 27
docs_reviewed = 17
upgrade_ready = false
blocking = ["receipt-deployment-wiring"]

[file.1]
path = "CONTRIBUTING.md"
lines = 92
verdict = "issues"
note = "Read all 92 lines. The contribution workflow preserves fail-closed execution, but the architecture still advertises the retired daemon."

[file.2]
path = "apps/web/next.config.mjs"
lines = 94
verdict = "issues"
note = "Read all 94 lines. HTTPS origin validation, Human /v1 and readiness rewrites, no-store readiness and webpack extension aliases are present. Build-time rewrites can disagree with runtime Human configuration."

[file.3]
path = "apps/web/src/api/gateway-actions.ts"
lines = 9
verdict = "issues"
note = "Read all 9 lines. The server action forwards the exact receipt hash and preserves bigint block numbers, null-as-undefined and success/reverted status through the Next server-action transport. The shipped deployment omits its gateway configuration."

[file.4]
path = "apps/web/src/app/exchange/actions.ts"
lines = 33
verdict = "issues"
note = "Read all 33 lines. Preflight checks address and word-aligned calldata, targets 0x1015, preserves revert detail and normalizes GatewayUnavailableError. The account resolver has no caller."

[file.5]
path = "apps/web/src/app/exchange/exchange-client.tsx"
lines = 503
verdict = "issues"
note = "Read all 503 lines. All thirteen write signatures match precompiles/perps/abi/abi.json via src/api/sdk.ts and the agent SDK. USD amounts and leverage use 18 decimals, collateral uses six; approve targets the token and venue, not retired custody. The wallet transaction builder pins type 2 and chainId 0x7d. Remaining findings concern lifecycle, selections, labels and real-path coverage."

[file.6]
path = "docker/web/Dockerfile"
lines = 21
verdict = "issues"
note = "Read all 21 lines. The image builds the agent SDK and web UI, copies standalone output and static assets and runs as UID 65532. The wallet source dependency tree is not provisioned for the Next TypeScript pass."

[file.7]
path = "scripts/gates/run_gate.py"
lines = 94
verdict = "issues"
note = "Read all 94 lines. Commands run from the repository root without a shell, with combined output, first-failure stopping and a bounded 200-line failure tail. Evidence retention and spawn failure handling have gaps."

[file.8]
path = "scripts/gates/test_run_gate.py"
lines = 231
verdict = "issues"
note = "Read all 231 lines. Tests exercise real subprocesses, CLI parsing, root-relative execution, command ordering, exit propagation and log tails. They do not cover repeated evidence paths, source changes during a run or executable launch failure."

[file.9]
path = "scripts/gates/wave-programme.sh"
lines = 28
verdict = "clean"
note = "Read all 28 lines. The four commands and --list match 16.cli-scripts-gates-wave-programme-j58; argument arrays preserve the fixed commands without eval, the runner receives programme and a durable logs/waves/programme directory, and no retired service is invoked. The --deleted scan checks absence of retired callers. Shared runner defects are recorded on run_gate.py."

[finding.contributor-daemon]
file = "CONTRIBUTING.md"
line = 18
class = "retired-reference"
severity = "medium"
observed = "The repository layout describes layerxd as the LayerX kernel alongside paxd; line 72 also directs readers to qualification material built around separate settlement."
expected = "Brief network facts 1 and 2 define one paxd network with the embedded kernel; layerxd is a retired running component."
proposal = "Update CONTRIBUTING.md to describe the embedded C kernel and paxd execution domain, retain library build boundaries, and point contributors at merged-network qualification."
owner_domain = 17

[finding.human-build-runtime-origin]
file = "apps/web/next.config.mjs"
line = 30
class = "config-drift"
severity = "medium"
observed = "rewrites() reads LAYERX_HUMAN_SERVICE_URL when next build creates the standalone routes. docker/web/Dockerfile:10-11 bakes the build argument, while src/api/server.ts:12 reads the deployment environment at runtime. Changing that environment can send browser /human/v1 and /v1 requests to a different Human service than server renders."
expected = "The Human service configuration must select the same authenticated backend for server reads, browser requests and readiness throughout an image deployment."
proposal = "In apps/web/next.config.mjs and the web deployment, make the effective Human origin a single validated configuration: either implement a runtime proxy or enforce and expose the immutable build origin so deployment cannot silently override only server reads."
owner_domain = 14
interface = "14.env-web-layerx-human-service-url"

[finding.receipt-deployment-wiring]
file = "apps/web/src/api/gateway-actions.ts"
line = 8
class = "wiring-gap"
severity = "high"
observed = "gatewayTransactionReceipt delegates to gateway.ts, whose gatewayEndpoint requires LAYERX_GATEWAY_URL. services/platform/hosted/human/web-deployment.yaml supplies no LAYERX_GATEWAY_URL and its egress policy admits node Human and registry destinations, not the hosted gateway. The Dockerfile supplies neither a runtime gateway origin nor this missing deployment edge. In that shipped configuration receipt reads and exchange preflight cannot reach their producer."
expected = "Requirement 14034.1 and registry row 14.ts-web-api-gateway-ethtransactionreceipt-j53 require eth_getTransactionReceipt through the hosted gateway to reach the wallet consumer; null means a pending transaction, not an unconfigured transport."
proposal = "Wire LAYERX_GATEWAY_URL to the hosted gateway HTTPS root in services/platform/hosted/human/web-deployment.yaml, admit the corresponding gateway egress and ingress, retain CA verification, and prove the deployed server action returns a real committed receipt to the market UI."
owner_domain = 8
interface = "14.ts-web-api-gateway-ethtransactionreceipt-j53"

[finding.unused-account-action]
file = "apps/web/src/app/exchange/actions.ts"
line = 15
class = "dead-code"
severity = "low"
observed = "resolvePerpsAccount exports a server action for pxResolveAccount, but the exchange page and client use the EVM account directly and no repository caller references resolvePerpsAccount."
expected = "The native perps UI identifies its trader by EVM address; an exposed server action should serve a current product flow with a real consumer."
proposal = "Remove resolvePerpsAccount and its unused imports from apps/web/src/app/exchange/actions.ts unless a current account-resolution flow is specified and wired to it."
owner_domain = 14
interface = "14.ts-web-api-gateway-pxresolveaccount"

[finding.exchange-selection-refresh]
file = "apps/web/src/app/exchange/exchange-client.tsx"
line = 261
class = "runtime-risk"
severity = "medium"
observed = "marketId, positionId, orderId and orderInputs.market are initialized from props once. router.refresh preserves component state after opening, closing or cancelling, and changing account props does not reconcile those IDs. Close and cancel validate only presence or numeric form rather than membership in the refreshed lists; an old market can also remain selectable for sending after it is removed."
expected = "The choices displayed for the current account must agree with the IDs used by each write after refreshed chain state or a wallet switch."
proposal = "In ExchangeActions, reconcile selections when account or available IDs change, clear outcomes belonging to another account, require current membership before every send, and cover open-refresh-close, cancel-refresh and account switching through the mounted UI."
owner_domain = 14
interface = "14.ts-web-app-exchange-exchange-client-exchangeactions"

[finding.exchange-native-recovery]
file = "apps/web/src/app/exchange/exchange-client.tsx"
line = 265
class = "restart-recovery"
severity = "medium"
observed = "Native write hashes and outcomes live only in openOutcome, closeOutcome, cancelOutcome, marginOutcome and orderOutcome. After receipt polling returns sent without a receipt or unconfirmed, no exchange reconciliation loop resumes that hash; reloading loses it and enables a new order or deposit with a new nonce."
expected = "Brief check 5 requires recovery of a submitted state-changing operation without losing its identity or inviting duplicate submission while its result is unknown."
proposal = "Retain native operation identity by chain, account and hash before leaving the submission flow in apps/web/src/api/wallet.ts and ExchangeActions; resume receipt lookup after reload and keep the affected action pending until its existing transaction is reconciled."
owner_domain = 14
interface = "14.ts-web-api-wallet-sendwalletprecompilecall"

[finding.approval-stage-outcome]
file = "apps/web/src/app/exchange/exchange-client.tsx"
line = 57
class = "runtime-risk"
severity = "medium"
observed = "sendPerpsWrite returns an unconfirmed approval as the requested operation outcome, and if an approval later times out in waitLaunchpadApproval its hash is discarded by walletSendFailure. The same SendOutcome panel can therefore describe an approval as the exchange action or say the transaction was not sent although an approval was broadcast."
expected = "Approval and perps submission are distinct transactions; the user must know which stage was submitted and retain its hash when confirmation is unavailable."
proposal = "Give sendPerpsWrite a retained approval stage in apps/web/src/app/exchange/exchange-client.tsx, display its hash and pending status separately, and resume that approval before offering to send the intended perps write."
owner_domain = 14
interface = "14.ts-web-app-exchange-exchange-client-sendperpswrite"

[finding.perps-real-path-proof]
file = "apps/web/src/app/exchange/exchange-client.tsx"
line = 39
class = "test-gap"
severity = "medium"
observed = "apps/web/e2e/exchange-perps.test.ts supplies a callback-based walletWindow and a createServer gateway with hand-built ANSWERS and encoded receipts. Its opening_a_position_sends_the_precompile_perps_write_without_an_approve case passes pull=0 although the production Open position path passes openCollateral. ABI encoding is covered, but this cannot prove the actual approval, committed receipt and browser server-action path."
expected = "Brief network fact 7 and requirements 21138.1 and 22095.1 require the real producer, transport and consumer; the default production collateral-pull branch must be exercised with real chain state."
proposal = "Extend the owning apps/web exchange integration suite to fund a real disposable chain account, drive the mounted Open position control through its approval and server action, verify emitted ABI calls and committed receipts, and reopen the page to prove recovery; retain the existing ABI checks."
owner_domain = 14
interface = "14.ts-web-app-exchange-exchange-client-sendperpswrite"

[finding.perps-size-units]
file = "apps/web/src/app/exchange/exchange-client.tsx"
line = 196
class = "runtime-risk"
severity = "medium"
observed = "The Order size and Close size fields omit their unit while the client encodes both as 18-decimal numbers. The ABI declares sizeUsd and closeSizeUsd, and the page separately presents USDL collateral; a trader can interpret size as a base-asset quantity."
expected = "The amount a trader authorizes must explicitly identify USD notional versus base quantity and USDL collateral before a wallet confirmation."
proposal = "Label these controls Order size (USD) and Close size (USD), explain USD notional in apps/web/src/app/exchange/exchange-client.tsx, and show the parsed notional in the review before signing."
owner_domain = 14

[finding.web-image-wallet-dependencies]
file = "docker/web/Dockerfile"
line = 8
class = "wiring-gap"
severity = "medium"
observed = "The Dockerfile copies sdk/wallet and installs apps/web but never provisions the services/wallet pnpm workspace or sdk/wallet dependencies. apps/web/tsconfig.json maps @paxeer/wallet to ../../sdk/wallet/src; that source imports viem and @supabase/supabase-js. Those dependencies are absent from the root package-lock.json, and apps/web/node_modules is outside the wallet source ancestor resolution path. The webpack rule in next.config.mjs does not configure TypeScript module resolution."
expected = "Requirement 17054.2 requires the production web build to resolve every imported wallet SDK package; a clean image must supply the same dependency graph as the source type check."
proposal = "Provision the pinned wallet workspace dependencies in docker/web/Dockerfile before the web build, or consume a correctly built and packaged wallet SDK with declarations; include the owning workspace manifests and lock in that repair and qualify the real image build."
owner_domain = 16
interface = "16.fmt-dock-web-dockerfile"

[finding.gate-log-overwrite]
file = "scripts/gates/run_gate.py"
line = 49
class = "runtime-risk"
severity = "medium"
observed = "Every invocation writes wave-<wave>-<index>.log with mode w. wave-programme.sh reuses logs/waves/programme, so a later invocation or concurrent process truncates the log named by an earlier evidence line, potentially replacing output from a different revision."
expected = "Recorded qualification evidence must remain attributable to its original revision and command after later qualification attempts."
proposal = "Keep the declared per-command names inside a unique immutable attempt directory under the requested evidence root in scripts/gates/run_gate.py, refuse collisions, and print each retained path in its evidence line."
owner_domain = 16
interface = "16.cli-scripts-gates-run-gate-j58"

[finding.gate-mutable-source]
file = "scripts/gates/run_gate.py"
line = 38
class = "runtime-risk"
severity = "medium"
observed = "run_gate captures HEAD once before all commands and prints that revision for every result without checking tracked changes or a changed HEAD. Commands execute directly against ROOT, so evidence can name one revision while the files being built or tested belong to another tree."
expected = "The programme qualification command and its evidence must identify the source tree actually exercised, rather than only the initial branch tip."
proposal = "In scripts/gates/run_gate.py, qualify an immutable checkout or refuse source changes before and after each command, including a dirty starting tree; distinguish permitted build outputs explicitly and retain evidence of a source-identity refusal."
owner_domain = 16
interface = "16.cli-scripts-gates-run-gate-j58"

[finding.gate-launch-error]
file = "scripts/gates/run_gate.py"
line = 51
class = "runtime-risk"
severity = "medium"
observed = "subprocess.run can raise FileNotFoundError or PermissionError when a required command is missing or cannot execute. That exception escapes before the evidence print, leaving an empty opened log and a Python traceback instead of the command-specific outcome the operator needs."
expected = "A qualification launch failure must stop the sequence and name the attempted command, source revision, failure code and retained cause without claiming that a child ran."
proposal = "Handle executable launch failures in scripts/gates/run_gate.py, retain the operating-system error in the command log and emit a distinct launch-failure record with a nonzero status; never fabricate child execution evidence."
owner_domain = 16
interface = "16.cli-scripts-gates-run-gate-j58"

[finding.gate-retention-tests]
file = "scripts/gates/test_run_gate.py"
line = 117
class = "test-gap"
severity = "medium"
observed = "Each subprocess test creates a fresh TemporaryDirectory and uses an executable that starts successfully. No test repeats a wave in the same directory, runs competing writers, changes the audited tree during execution or attempts an absent executable, so the suite misses the evidence defects on run_gate.py."
expected = "Qualification evidence needs tests that prove the original log remains intact and that failed launches and source-identity changes are reported without false revision attribution."
proposal = "Add real-subprocess cases in scripts/gates/test_run_gate.py for repeated and concurrent log paths, an isolated temporary git repository whose source changes, and an absent or non-executable command; assert preserved logs, exact failure records and no later command."
owner_domain = 16

