[finding.validation-order]
file = "sdk/tasks/scheduler.go"
line = 428
class = "runtime-risk"
severity = "medium"
observed = "ProcessAll starts len(tasks) validation workers at lines 297-298, and validateAll dispatches every task through DoValidate without waiting for the preceding index or stopping at the first invalid task. The ordered, fail-fast precondition stated at lines 363-366 is not enforced."
expected = "Requirement 15022.2 permits only ordered, fail-fast validation; the NewScheduler lifecycle must enforce the ordering on which shouldRerun relies."
proposal = "In sdk/tasks/scheduler.go, validate in transaction-index order and stop the validation pass on the first invalid predecessor; prove this through ProcessAll with delayed predecessors and conflicting reads and iterators."
owner_domain = 15
interface = "15.go-tasks-new-scheduler-j76"

[finding.scheduler-reuse]
file = "sdk/tasks/scheduler.go"
line = 227
class = "runtime-risk"
severity = "medium"
observed = "tryInitMultiVersionStore retains the first context stores forever. ProcessAll replaces task maps but retains versioned writes, read sets, metrics.retries, maxIncarnation and synchronous. A second call can read or flush writes from the previous batch into the first parent store and re-emit old retry counts. Current node/abci.go and sdk/baseapp/abci.go create a fresh scheduler for each batch."
expected = "A Scheduler must have an explicit single-batch lifecycle or isolate all state for each ProcessAll call; scheduler counters describe the current round and contexts must never share stale speculative writes."
proposal = "In sdk/tasks/scheduler.go, enforce and document single-use scheduling with a typed refusal on reuse, or initialize fresh stores and round state on every call; add a two-context, two-batch test that checks parent writes and metric deltas."
owner_domain = 15
interface = "15.go-store-multiversion-new-multi-version-store-j76"

[finding.cancelled-worker-hang]
file = "sdk/tasks/scheduler.go"
line = 149
class = "runtime-risk"
severity = "medium"
observed = "Worker goroutines return as soon as ctx.Done is selected, but executeAll and validateAll wait on WaitGroups whose remaining jobs are still queued. A cancelled context can leave ProcessAll waiting forever; the error return is never populated by these paths."
expected = "Cancellation of a batch must terminate execution and validation with an explicit error, leaving no waiter dependent on workers that have exited."
proposal = "In sdk/tasks/scheduler.go, propagate cancellation through job submission and completion accounting, join workers before returning, and prove cancellation before dispatch and during execution without publishing a partial batch."
owner_domain = 15
interface = "15.go-tasks-new-scheduler-j76"

[finding.rerun-driver-proof]
