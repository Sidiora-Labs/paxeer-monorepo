[finding.weighted-selection-boundary]
file = "sdk/x/simulation/operation.go"
line = 149
class = "runtime-risk"
severity = "medium"
observed = "getSelectOpFn draws x in [0,totalWeight) but selects an operation when x <= Weight(). With weights [1,1], the first operation is always selected; a leading zero-weight operation can also execute when x is zero. This private selector currently has no caller."
expected = "WeightedOperations must select each operation in proportion to its declared nonnegative weight, and a zero-weight operation must never execute."
proposal = "In sdk/x/simulation/operation.go, use half-open cumulative weight intervals and add deterministic boundary tests for equal weights and leading, middle and trailing zero weights before wiring the selector."
