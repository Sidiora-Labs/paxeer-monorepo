upgrade_ready = false
blocking = []
readiness_note = "No high finding is claimed: disconnected simulation defects and unproven scheduler lifecycle risks are medium or low. Readiness is withheld because requirement 15022.2 is not enforced and the simulation qualification path is disconnected. All findings are proposals; no source repairs or Go behavior gates were performed."
interfaces_reviewed = 52
interface_transport = "The 52 package rows are in-process Go APIs and process-local metric emissions, with no additional JSON transport in this slice. Source comparison covers request/checksum/response, store and abort shapes, tracer lifecycle, operation/future-operation JSON, parameter callbacks, signer inputs and ABCI key/vote/evidence types. OTel is volatile instrumentation; speculative scheduler state is reconstructed for each batch by current application callers and is committed by the parent application store, not persisted as a scheduler WAL."
security_note = "Production members expose no HTTP or RPC handler and contain no credential default or signature bypass. GenTx signs configured TxConfig bytes and Deliver reaches the real application decoder/runTx path. The local profiler started by a test is reported separately. Tenant state is selected by the supplied context and keepers; no fixed tenant or retired endpoint appears in the member sources."

