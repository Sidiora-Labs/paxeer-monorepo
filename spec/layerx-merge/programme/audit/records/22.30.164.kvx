class = "test-gap"
severity = "medium"
observed = "The two rerun tests invoke executeTask and shouldRerun directly in a chosen serial order. They prove invalidation and the unchanged-read case, but never exercise ProcessAll, its concurrent validation dispatch, or the ordered fail-fast condition required by 15022.2."
expected = "The declared rerun rule must be demonstrated through the scheduler entry point and its actual dispatch lifecycle as well as through the local state-transition helpers."
proposal = "Extend sdk/tasks/scheduler_rerun_test.go with a ProcessAll path that forces a lower-index retry after a later reader has executed, checks validation order and final committed state, and preserves the existing direct invalidation assertions."
owner_domain = 15
interface = "15.go-tasks-new-scheduler-j76"

