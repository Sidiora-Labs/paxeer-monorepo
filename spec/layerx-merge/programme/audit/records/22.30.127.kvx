[finding.1]
file = "programs/crates/layerx-programs-runtime/src/abi/codec.rs"
line = 388
class = "interface-mismatch"
severity = "high"
observed = "Calldata::check_capacity permits 1048576 payload bytes; as_bytes adds the convention byte, while from_bytes bounds the whole input to 1048576. On an empty LayerX buffer, encode_bytes of 1048571 bytes succeeds, serializes to 1048577 bytes and is refused by from_bytes with InputTooLarge."
expected = "The canonical builder, serialized transport and parser must share a complete-message ceiling so a successfully completed valid builder value decodes at the declared maximum."
proposal = "In programs/crates/layerx-programs-runtime/src/abi/codec.rs reserve the convention byte in builder accounting without increasing the transport bound. Add real encode_bytes -> as_bytes -> from_bytes tests at the maximum and one byte beyond, including accumulated multiple fields."
owner_domain = 13
interface = "13.rs-rt-abi-codec-calldata-encode-bytes"

[finding.2]
file = "programs/crates/layerx-programs-runtime/src/abi/host_state.rs"
line = 435
class = "interface-mismatch"
severity = "high"
observed = "abi_error_bytes emits tag 17 for AbiError::EffectLimit at line 71, but decode_replay_abi_error handles only 0 through 16. Abi::new caches verified_balance Result<BalanceView, AbiError> without narrowing errors; canonical state encoding writes those error bytes and restore at 628-633 rejects the emitted tag. Host composition authority refusal decoding shares this decoder. Disposition 13.7.1 covers encoder exhaustiveness, not the missing inverse."
expected = "Every supported AbiError serialized into canonical replay state must decode to the same typed refusal and re-encode identically; captured authorized host state must remain restorable when evidence reads refuse."
proposal = "Add the frozen EffectLimit tag 17 case in programs/crates/layerx-programs-runtime/src/abi/host_state.rs and exhaustive error-tag round-trip coverage. Exercise actual ABI capture, serialization and restore with a cached permitted refusal and unchanged authority/bytes; retain rejection of unknown codes."
owner_domain = 13
interface = "13.rs-rt-abi-abierror"

[finding.3]
file = "programs/crates/layerx-programs-runtime/src/abi/codec.rs"
line = 230
class = "runtime-risk"
severity = "medium"
observed = "from_bytes invokes validate_canonical once. LayerX validation consumes one top-level value then copies all remaining bytes without checking the cursor. Bytes 01 10 01 ff pass validation of the u8 prefix while retaining an invalid suffix tag; malformed or over-deep later fields likewise bypass validation."
expected = "The from_bytes contract promises malformed, non-canonical and excessive-depth refusal for every field in the multi-value streams its own encode methods produce."
proposal = "In programs/crates/layerx-programs-runtime/src/abi/codec.rs validate all top-level values to payload exhaustion with shared decoded accounting. Add real producer/parser tests for valid multiple fields, malformed/truncated suffixes and excessive nesting after a valid prefix."
owner_domain = 13
interface = "13.rs-rt-abi-codec-calldata-from-bytes"

[finding.4]
file = "programs/crates/layerx-programs-runtime/src/abi/codec.rs"
line = 733
class = "test-gap"
severity = "medium"
observed = "decoded_size_limit_is_enforced never calls the decoder. It allocates DECODED_SIZE_LIMIT + 1 bytes and checks encode_bytes(...).is_err(); the 1048576-byte encoder ceiling triggers before the 16777216-byte decoded budget. Removing decoder accounting leaves this assertion passing."
expected = "Decoded-budget coverage must assert decoder accounting or explicitly establish that the complete-input ceiling dominates the decoded budget for every supported encoding."
proposal = "Keep and correctly name the encoder/input bound assertion in programs/crates/layerx-programs-runtime/src/abi/codec.rs. Independently test Decoder budget accounting and establish the current encoded-to-decoded size bound; do not loosen limits or claim an unreachable oversized transport exercises this decoder branch."
owner_domain = 13
interface = "13.rs-rt-abi-codec-decoded-size-limit"

[finding.5]
file = "programs/crates/layerx-programs-runtime/tests/calldata_golden_vectors.rs"
line = 44
class = "test-gap"
severity = "medium"
observed = "run_vector returns false for every hex_generator without executing its expected assertion. The boundary directory explicitly expects one skip: depth_and_size.json publishes a deterministic valid 4096-byte bytes value, which is cheap to construct and decode."
expected = "Every published calldata conformance case must execute through the real parser; requirement 22998.1 does not permit a passing inventory target obtained by skipped or weakened coverage."
proposal = "Implement the declared bounded generator in programs/crates/layerx-programs-runtime/tests/calldata_golden_vectors.rs, decode its exact output and assert the published expectation. Require zero skipped vectors and fail explicitly on unknown generator syntax while preserving the fixture."
owner_domain = 13
interface = "13.rs-rt-abi-codec-calldata-from-bytes"

