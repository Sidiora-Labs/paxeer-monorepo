class = "runtime-risk"
severity = "medium"
observed = "register_impl deletes the previous owner's reverse mapping when an expired name is reassigned; transfer_impl:154 does the same for any transferred name. A DID can own A and then B, making B its reverse name; reclaiming or transferring A then deletes the still-valid reverse B mapping."
