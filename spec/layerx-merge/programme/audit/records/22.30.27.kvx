[finding.native-pool-identity]
file = "sdk/launchpad/shared/config/capabilities/preflight.go"
line = 738
class = "interface-mismatch"
severity = "high"
observed = "PreflightEngine.poolState unconditionally reads BeaconSlot and requires the PoolBeacon address, then reports the beacon implementation as the pool version. modules/launchpad/keeper/market.go:190-194 installs SurfaceRuntime and a generation-2 Pool surface record without a beacon slot; precompiles/launchpad/pool.go serves its views from that record. A genuine new native pool therefore fails identity_unverified even if its runtime hash is admitted."
expected = "The declared Preflight interface must accept the registered native pools produced by the merged chain and bind quote and trading reads to their actual generation, role and committed state. Historical beacon pools retain their own epoch identity checks."
proposal = "In sdk/launchpad/shared/config/capabilities/preflight.go select pool identity rules by the approved deployment generation; verify the reviewed surface runtime and native registry-bound role and pool views for generation 2, preserve historical beacon checks, and qualify quote and trade admission against a real paxd-created native pool."
owner_domain = 4
interface = "4.go-shared-config-capabilities-preflight-engine-preflight"

[finding.native-client-spender]
file = "apps/launchpad/web/src/widgets/create/creation-adapters.ts"
line = 89
class = "interface-mismatch"
severity = "high"
observed = "ChainCreationAdapter reads allowance, estimates approval, sends approve, verifies approvalProof and purchaseAllowance using deployment.router. The native producer modules/launchpad/keeper/custody.go:258-268 calls USDL.transferFrom as 0x1017; RunCaller.Call preserves that caller. An allowance to the Router surface cannot pay either creation or the first buy."
expected = "The client approval, receipt proof and allowance checks must all name the actual native USDL spender, independently of the Router address used as the transaction destination."
proposal = "Add the approved generation-specific USDL spender to launch deployment authority and use it throughout apps/launchpad/web/src/widgets/create/creation-adapters.ts for creation and first-buy approval and proof. Bind it to the native 0x1017 producer and qualify a zero-allowance creation and purchase on paxd; preserve exact amount, wallet, receipt and revision checks."
owner_domain = 4
interface = "4.pc-router-create-market"

[finding.native-domain-spender]
file = "apps/launchpad/web/src/widgets/create/creation-domain.ts"
line = 24
class = "interface-mismatch"
severity = "high"
observed = "verifyCost constructs approvalSpender from d.router, funding returns that Router spender, and verifyCreationApproval at line 191 rejects any other spender. The native USDL pull in modules/launchpad/keeper/custody.go uses 0x1017, so this domain contract rejects the correct native approval identity."
expected = "A reviewed creation cost and its approval context must carry the spender that actually executes USDL.transferFrom in the selected deployment, with the Router kept as the separate createMarket destination."
proposal = "Extend Deployment in apps/launchpad/web/src/widgets/create/creation-domain.ts with the reviewed native spender and bind verifyCost, funding and verifyCreationApproval to it. Update all owning callers and exercise approval against the native USDL transfer path while retaining the hostile-spender rejection cases."
owner_domain = 4
interface = "4.pc-router-create-market"

[finding.native-cost-spender]
file = "sdk/launchpad/shared/config/capabilities/preflight.go"
line = 537
class = "interface-mismatch"
severity = "high"
observed = "creationCost sets CreationCost.Spender to the selected Router or SidioraFactory transaction destination. Both native creation entries ultimately charge through Keeper.PullQuote as 0x1017, so the exported connected capability cost advertises an allowance that the producer cannot spend."
expected = "The connected capability creationCost.spender must round-trip to the actual USDL approval consumed by native creation; the creation destination and allowance spender are separate identities."
proposal = "In sdk/launchpad/shared/config/capabilities/preflight.go derive Spender from the approved native payment authority for the requested deployment generation and export that identity through connected capability consumers. Prove the returned spender by approving it and creating a market through each admitted entry on paxd."
owner_domain = 4
interface = "4.go-shared-config-capabilities-preflight-engine-preflight"

[finding.approval-admission-cycle]
file = "apps/launchpad/web/src/widgets/create/cap-admission.ts"
line = 20
class = "interface-mismatch"
severity = "high"
observed = "runtimeCreationAdmission requires supported and executionPermitted from creation preflight. CreationController.approve calls this admission before approving USDL; PreflightEngine.creationCost simulates createMarket, which charges USDL via PullQuote. A funded new wallet with zero allowance receives gas_estimate_unavailable and cannot reach its approval transaction even after capability qualification."
expected = "A first-time creator must be able to grant the exact fee allowance after current authority checks, and creation itself must still require a fresh successful funded simulation and capability admission."
proposal = "Introduce an explicit approval admission stage across apps/launchpad/web/src/widgets/create/cap-admission.ts, creation-controller.ts and sdk/launchpad/shared/config/capabilities/preflight.go. Keep deployment, account, capability and expiry checks for approval, simulate the approval at that stage, and require the full createMarket simulation after its canonical approval receipt; exercise the real controller path from zero allowance."
owner_domain = 4
interface = "4.go-shared-config-capabilities-preflight-engine-preflight"

[finding.purchase-hash-recovery]
file = "apps/launchpad/web/src/widgets/create/creation-controller.ts"
line = 201
class = "restart-recovery"
severity = "medium"
observed = "buy persists purchaseState signing_locked before wallet dispatch and changes it to outcome_unknown on an uncertain send; a crash or storage failure can leave purchaseTxHash absent. resumePurchase at line 210 requires that saved hash and there is no purchase equivalent of attachRecoveredHash, so the user cannot attach the transaction found in wallet history."
expected = "An uncertain first purchase must remain protected against duplicate submission and be recoverable using its exact wallet transaction, reviewed pool, amount, creator, deployment and receipt after restart."
proposal = "Add verified purchase-hash attachment in apps/launchpad/web/src/widgets/create/creation-controller.ts using the saved purchaseReview and the existing transaction and receipt verifier. Persist the recovered hash before reconciliation, retain the duplicate-send lock, and cover interruption after broadcast and before hash persistence."
owner_domain = 4

[finding.purchase-recovery-control]
file = "apps/launchpad/web/src/widgets/create/create-wizard.tsx"
line = 420
class = "wiring-gap"
severity = "medium"
observed = "The first-buy progress body shows Approve, Get quote and Skip whenever purchaseTxHash is absent. For a saved signing_locked or outcome_unknown purchase these actions cannot resolve the send; the UI has no field or action to attach its wallet-history hash, although creation has such recovery."
expected = "A creator returning after an uncertain buy needs a visible recovery action for the existing purchase and a way to verify its exact transaction before any new purchase can be considered."
proposal = "In apps/launchpad/web/src/widgets/create/create-wizard.tsx render an explicit uncertain-purchase recovery state with wallet-history instructions and a hash attachment action wired to the verified controller recovery. Preserve the existing lock and add a restart journey that resolves the same purchase without a second broadcast."
