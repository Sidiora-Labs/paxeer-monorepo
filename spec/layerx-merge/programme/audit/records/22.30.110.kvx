[finding.mirror_manifest_event]
line = 53
class = "interface-mismatch"
severity = "high"
observed = "ManifestOpened emits (bytes32,uint32,uint64,bytes32,uint64,uint32,bytes32), adding committed blockHash. services/interop/crates/layerx-mirror/src/ethereum.rs:765 still hashes the old six-field signature, so a successful begin receipt fails EthereumError::Event and publication cannot advance."
expected = "The archive event must round-trip from the deployed contract through receipt logs into the publisher, including recovery of a previously submitted manifest."
proposal = "Update services/interop/crates/layerx-mirror/src/ethereum.rs, sdk/platform/schema/mirror-v2.kvx and registry 11.sevt-mirror-archive-manifest-opened with the seven-field ABI. Feed a real contract begin receipt through publisher verification, stop/reopen its state, and resume chunk publication."
owner_domain = 11
interface = "11.sevt-mirror-archive-manifest-opened"
file = "services/interop/contracts/ethereum-mirror/LayerXMirrorArchive.sol"

[finding.relay_claim_before_send]
line = 262
class = "restart-recovery"
severity = "high"
observed = "ChainRelay durably claims raw bytes before send_raw_transaction. Existing claims only poll their hash; a crash or transport failure before node acceptance leaves pax_sequencerReceipt empty, and relay/recorded_evidence retries remain Unknown without rebroadcasting."
expected = "A durably accepted payment must recover across the claim/submission boundary, safely resending identical payer-signed bytes when acceptance is uncertain without creating another debit."
proposal = "In services/interop/crates/layerx-interop-service/src/relay.rs persist submission progress and recover unaccepted claims by rebroadcasting exactly their stored bytes. Prove process death before send and uncertain send completion through the real journal/node path, then assert one chain transaction."
owner_domain = 11
file = "services/interop/crates/layerx-interop-service/src/relay.rs"

[finding.private_endpoint_settlement]
line = 1254
class = "wiring-gap"
severity = "high"
observed = "config.rs:265 accepts http://<service>.railway.internal when LAYERX_INTEROP_ALLOW_RAILWAY_PRIVATE_NETWORK=1. chain_relay rebuilds SequencerEndpoint::new without that policy, so startup may succeed but every settling route fails settlement_unavailable."
expected = "The relay must use the same validated node endpoint and explicit private-network policy as startup and receipt-key discovery."
proposal = "Carry the validated SequencerEndpoint from services/interop/crates/layerx-interop-service/src/config.rs into server.rs rather than rereading environment credentials. Extend tests/private_network.rs through an authenticated mounted payment route and reopened receipt recovery using that permitted endpoint."
owner_domain = 11
interface = "11.env-svc-layerx-interop-sequencer-url-j47"
file = "services/interop/crates/layerx-interop-service/src/server.rs"

[finding.payment_expiry_units]
line = 1121
class = "runtime-risk"
severity = "medium"
observed = "now() at line 3160 returns Unix seconds; payment preflight compares it directly with payExact expires_at, whose ledger producer modules/layerxledger/keeper/payexact.go:21 uses UnixMilli. It also accepts equality while the ledger rejects expiresAt <= now; injected millisecond test values hide the real clock mismatch."
expected = "Preflight must reject at or after the ledger's millisecond expiry using the same boundary. Mandate and credential NumericDate checks continue using seconds."
proposal = "Use explicit payment-millisecond and mandate-second clocks in services/interop/crates/layerx-interop-service/src/server.rs, rejecting expires_at <= payment_now. Prove the mounted route with its real clock and ledger-produced transactions before, at and after expiry."
owner_domain = 11
file = "services/interop/crates/layerx-interop-service/src/server.rs"

[finding.payer_chain_id]
line = 119
class = "runtime-risk"
severity = "medium"
observed = "decode_pay_exact checks target/selector and recovers the signer but never checks transaction.chain_id. A correctly signed payExact for a different EVM chain can pass the hosted verify path before the Paxeer node rejects submission."
expected = "A payment accepted for eip155:125 must carry the expected chain id as well as the ledger address and authorized payer."
proposal = "Validate the configured expected chain id in services/interop/crates/layerx-interop-service/src/payer_tx.rs and return an explicit refusal before authorization/submission. Exercise correctly signed wrong-chain and chain-125 transactions through the actual verify handler."
owner_domain = 11
file = "services/interop/crates/layerx-interop-service/src/payer_tx.rs"

[finding.replayed_http_status]
line = 3099
class = "interface-mismatch"
severity = "medium"
observed = "stored_response reconstructs every non-pending operation as HTTP 200 without Retry-After. complete_operation stores response bodies/state but loses the initial 400/409 refusal status, so repeating an invalid AP2 POST changes its declared HTTP error contract after durable replay."
expected = "Idempotent POST replay must preserve the original refusal status and applicable retry metadata. Operation polling can have a separately documented status contract."
proposal = "Persist original HTTP metadata with completions in services/interop/crates/layerx-interop-service/src/server.rs and replay it on duplicate POSTs. Reopen the store and compare a 400 invalid_ap2_request and a 409 refusal in both body and HTTP status."
owner_domain = 11
interface = "11.err-svc-invalid-ap2-request"
file = "services/interop/crates/layerx-interop-service/src/server.rs"

[finding.ap2_replay_clock_digest]
line = 486
class = "restart-recovery"
severity = "medium"
observed = "authorize_payment includes execution_at in request_digest. verify.rs:729 defaults a missing signed execution_date to VerificationContext.now, so the same signed mandates reverified a second later keep their idempotency key but acquire another request digest and cause IdempotencyConflict."
expected = "Unchanged signed mandates must recover one authorized payment and result independently of verification time and process restart."
proposal = "In services/interop/crates/layerx-ap2/src/adapter.rs derive request identity from stable signed facts or persist/reuse the first authorized execution time. Verify identical mandates with fresh contexts at different seconds and after state reopen, asserting one submission and the same result."
owner_domain = 11
file = "services/interop/crates/layerx-ap2/src/adapter.rs"

[finding.hosted_ap2_signed_export]
line = 1749
class = "wiring-gap"
severity = "medium"
observed = "The hosted execute path uses its own ap2_executed response with transaction/receipt digests; it never calls Ap2Adapter::execute or ReceiptSigner. Library payment_receipt_jwt, checkout_receipt_jwt and PortableReceiptV2 exports are consequently unavailable to a hosted AP2 client."
expected = "AP2 callers need the signed protocol receipts and portable evidence implemented by the adapter, bound to their actual mandates and payment, with recoverable delivery."
proposal = "Wire the AP2 signed export into services/interop/crates/layerx-interop-service/src/server.rs through the library adapter and configured signers. Persist the exported result and prove hosted execution plus restarted replay through the real AP2/portable verifier."
owner_domain = 11
file = "services/interop/crates/layerx-interop-service/src/server.rs"

[finding.outer_jwt_time_types]
line = 346
class = "security"
severity = "medium"
observed = "check_claim_time uses Value::as_u64 for enclosing JWT iat/exp and converts present string, negative, fractional or null values into absent claims. A signed root or key-binding token therefore bypasses its enclosing lifetime check on malformed claim types; typed inner mandates still receive their own checks."
expected = "Present signed lifetime claims must either use the supported NumericDate representation or be refused, rather than silently becoming optional absent claims."
proposal = "In services/interop/crates/layerx-ap2/src/verify.rs distinguish missing from present-invalid claims and enforce the supported time representation and expiry boundary. Test signed root and key-binding payloads with malformed types and exact expiration times."
owner_domain = 11
file = "services/interop/crates/layerx-ap2/src/verify.rs"

[finding.relay_retention]
line = 179
class = "runtime-risk"
severity = "medium"
