[finding.collateral-account-binding]
file = "apps/perps/src/app/modals/DepositWithdrawModal.tsx"
line = 93
class = "interface-mismatch"
severity = "high"
observed = "deposit(address, amountUnits) and withdrawAll(address) read the displayed account, but useAccount.ts obtains a fresh current wallet client for each write through useContract.ts. Switching from wallet A to B during allowance lookup, approval receipt waiting or account lookup can execute the remaining transfer with B while the modal reports the operation started for A."
expected = "The account accepted by the account hook must identify the account whose allowance, withdrawable collateral and signed transfer belong to one operation, including asynchronous approval and deposit steps."
proposal = "Bind the expected address and chain through apps/perps/src/hooks/perps/useAccount.ts, useContract.ts and core/viem/clients.ts for every read, simulation and signature. Stop on a changed session before another write and show the bound identity in DepositWithdrawModal. Add a real delayed-approval/account-switch proof that never submits a step from another wallet."
owner_domain = 3
interface = "3.ts-perps-hooks-perps-useaccount-useaccount"

[finding.collateral-overlapping-submissions]
file = "apps/perps/src/app/modals/DepositWithdrawModal.tsx"
line = 52
class = "runtime-risk"
severity = "medium"
observed = "Closing resets isProcessing and txStep while handleSubmit continues chain work; reopening permits another submission. The primary button at line 288 also omits isWithdrawingAll although withdraw-all excludes isProcessing, allowing a transfer during withdraw-all."
expected = "Only one collateral mutation per account should be offered until its pending operation settles, including when the form closes and reopens."
proposal = "In apps/perps/src/app/modals/DepositWithdrawModal.tsx keep shared pending state outside form reset, enforce the same mutual exclusion in both handlers, and disable action and amount changes and both submission paths while pending."
owner_domain = 3
interface = "3.ts-perps-app-modals-depositwithdrawmodal-depositwithdrawmodal"

[finding.collateral-read-errors]
file = "apps/perps/src/app/modals/DepositWithdrawModal.tsx"
line = 64
class = "runtime-risk"
severity = "medium"
observed = "refreshBalances converts rejected wallet reads to 0n and rejected getAccount reads to null through Promise.allSettled, with no read error or retry; RPC failure looks like an empty wallet or missing collateral."
expected = "Unavailable balance information must remain distinguishable from a successfully observed zero before users decide how much collateral to transfer."
proposal = "In apps/perps/src/app/modals/DepositWithdrawModal.tsx track loading, available and failed states per balance, expose retry and prevent amount-dependent actions until their required read is available."
owner_domain = 3
interface = "3.ts-perps-app-modals-depositwithdrawmodal-depositwithdrawmodal"

[finding.collateral-session-staleness]
file = "apps/perps/src/app/modals/DepositWithdrawModal.tsx"
line = 71
class = "runtime-risk"
severity = "medium"
observed = "The balance effect returns on disconnect without clearing account or walletBalance. Post-transfer refreshBalances calls use the default non-cancelled callback and can publish an old address result after a wallet change; previous values also remain while the new address loads."
expected = "Balances, Max amounts and account statistics must belong to the current wallet, and responses from previous wallet sessions must not replace current state."
proposal = "In apps/perps/src/app/modals/DepositWithdrawModal.tsx key balances by chain and address, clear on disconnect or address change and apply session generation checks to effect reads and post-transfer refreshes."
owner_domain = 3
interface = "3.ts-perps-app-modals-depositwithdrawmodal-depositwithdrawmodal"

[finding.collateral-pending-recovery]
file = "apps/perps/src/app/modals/DepositWithdrawModal.tsx"
line = 93
class = "restart-recovery"
severity = "medium"
observed = "Transfer results are discarded and pending state is local to the component. useContract.waitForTx stops after 30 seconds and throws with the transaction hash; reload or timeout leaves no durable operation for this UI to reconcile before a retry."
expected = "A broadcast transfer must remain identifiable until its committed receipt or failure is known, and reopening or reloading must resume receipt reconciliation before offering an ambiguous repeat transfer."
proposal = "Expose the broadcast hash immediately from apps/perps/src/hooks/perps/useContract.ts, persist pending operations by chain/account/hash, and have DepositWithdrawModal resume read-only receipt reconciliation before permitting a new transfer."
owner_domain = 3
interface = "3.ts-perps-app-modals-depositwithdrawmodal-depositwithdrawmodal"

