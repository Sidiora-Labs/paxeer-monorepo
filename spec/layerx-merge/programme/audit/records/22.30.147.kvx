line = 501
class = "interface-mismatch"
severity = "medium"
observed = "publish/1 writes one endpoint counts into gauges labelled only by class. With multiple configured HTTP endpoints, the last endpoint published overwrites the others and an idle endpoint can display zero while another still has work."
expected = "The exported class gauge must have a defined value representing all work in its label set, so operators can observe explorer node pressure reliably."
proposal = "In http/throttle.ex, aggregate class counts over all endpoint state before setting the gauges, or introduce a bounded credential-free endpoint identity with a documented aggregation rule. Verify two simultaneously busy endpoints and one idle endpoint."
owner_domain = 14
