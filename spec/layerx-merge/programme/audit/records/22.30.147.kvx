[finding.ws-handle-after-failback]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket/web_socket_client.ex"
line = 487
class = "interface-mismatch"
severity = "high"
observed = "A new subscription captures the client PID in Options.web_socket. RetryWorker starts another client with the retained state; handle_connect stops the original fallback client, while the resubscribe branch replaces only server ID maps. WebSocket.unsubscribe therefore calls the terminated PID held by the original Subscription."
expected = "The subscription returned to the indexer must remain cancellable after primary failure, fallback use and primary recovery. The eth_unsubscribe request must reach the connection that owns the replacement server subscription ID."
proposal = "In services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket, route subscription handles through a stable owner or registry and resolve the current connection and server ID at cancellation. Prove subscribe, main outage, fallback, recovered main, notification delivery and unsubscribe through real node WebSockets."
owner_domain = 14
interface = "7.rpc-eth-unsubscribe"

[finding.ws-old-server-ids]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket/web_socket_client.ex"
line = 472
class = "runtime-risk"
severity = "medium"
observed = "The resubscribe branch adds the new server subscription ID without removing the previous ID for the same local reference. Repeated reconnects retain obsolete ID mappings until the subscription is removed."
expected = "One active local subscription should own only its current server ID, with bounded connection-local state over repeated reconnects."
proposal = "In web_socket/web_socket_client.ex, replace the old reverse mapping atomically when a resubscribe succeeds and clear connection-scoped IDs on disconnect; exercise repeated reconnects and assert that map sizes remain bounded."
owner_domain = 14
interface = "7.rpc-eth-subscribe"

[finding.ws-unbounded-pending]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket/web_socket_client.ex"
line = 160
class = "runtime-risk"
severity = "medium"
observed = "Disconnected requests are registered without a deadline or a caller monitor. GenServer callers can time out while their registrations remain in request_id_to_registration and rerequest later sends them again."
expected = "An expired or dead caller must not leave an indefinitely retained request or cause a timed-out request to be replayed after connection recovery."
proposal = "In web_socket/web_socket_client.ex and registration.ex, carry request deadlines and monitor callers, expire queued registrations, and define which idempotent requests may be replayed. Test a prolonged outage with timed-out and terminated callers."
owner_domain = 14
interface = "7.rpc-eth-subscribe"

[finding.ws-crash-recovery]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket/supervisor.ex"
line = 63
class = "restart-recovery"
severity = "medium"
observed = "Both initial and replacement WebSocket clients have restart: :temporary. RetryWorker is activated by handle_disconnect, so an unexpected client crash outside that callback can leave the supervisor with no active client and no retry."
expected = "The realtime indexer must regain a node connection after an unexpected client exit as well as after an orderly disconnect."
proposal = "In web_socket/supervisor.ex and retry_worker.ex, give a stable connection owner responsibility for unexpected exits and durable subscription intent. Test client process termination and eventual resubscription with the same public handles."
owner_domain = 14
interface = "7.ws-eth-subscribe-newheads"

[finding.ws-termination-envelope]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket/web_socket_client.ex"
line = 182
class = "runtime-risk"
severity = "medium"
observed = "terminate/2 broadcasts the raw reason to subscribers, whereas WebSocket documents subscription messages as {subscription, {:ok, result}} or {subscription, {:error, reason}}. The local test explicitly expects {subscription, :close}."
expected = "Subscription consumers should receive the documented tagged error shape for a terminal connection failure, including failback termination of the previous client."
proposal = "In web_socket/web_socket_client.ex, define and emit a tagged termination error or a documented nonterminal recovery signal, then update the realtime consumer and lifecycle tests to handle that same envelope."
owner_domain = 14
interface = "7.ws-eth-subscribe-newheads"

[finding.ws-url-logging]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/web_socket/web_socket_client.ex"
line = 129
class = "security"
severity = "medium"
observed = "Disconnect warnings interpolate state.url and state.fallback_url directly. A configured URL may include userinfo, an access token in a path or query, and those values enter the application logs."
expected = "Node endpoint diagnostics must identify the failing endpoint without exposing credentials or token-bearing URL components."
proposal = "In web_socket/web_socket_client.ex, use a common endpoint redactor for every primary, fallback and retry warning and test URL userinfo, query tokens and credential-bearing path segments without printing their original values."
owner_domain = 14

[finding.ws-reconnect-test-absent]
file = "services/explorer/backend/apps/ethereum_jsonrpc/test/ethereum_jsonrpc/web_socket/web_socket_client_test.exs"
line = 77
class = "test-gap"
severity = "medium"
observed = "The reconnect describe block contains setup only and no test. It starts a TLS Cowboy listener but constructs a ws URL and a three-element client argument list, so it provides no exercised reconnect or unsubscribe recovery proof."
expected = "Subscription lifecycle evidence must cover the actual producer, transport and indexer consumer across loss of the primary, fallback operation, primary recovery and cancellation."
proposal = "Replace the unused setup in test/ethereum_jsonrpc/web_socket/web_socket_client_test.exs with real lifecycle tests using valid client start arguments and matching TLS URLs. Include the stale-handle failure and verify cancellation on the recovered node."
owner_domain = 14
interface = "7.rpc-eth-unsubscribe"

[finding.sync-error-becomes-synced]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/paxeer_x.ex"
line = 310
class = "runtime-risk"
severity = "medium"
observed = "PaxeerX.fetch_syncing_status maps every transport or RPC error to {:ok, :synced}. Its comment assumes the node always refuses eth_syncing with -32000, but rpc/info.go Syncing now emits false or a hex progress object and propagates consensus Status errors."
expected = "Unavailable consensus state or a failed HTTP request must remain an error; only the node false result establishes that synchronization is complete."
proposal = "In lib/ethereum_jsonrpc/paxeer_x.ex, propagate operational errors and decode the current false/object producer contract. If legacy refusal compatibility is retained, bind it to an explicit supported version and never treat arbitrary failures as healthy."
owner_domain = 14
interface = "7.rpc-eth-syncing"

[finding.sync-legacy-test]
file = "services/explorer/backend/apps/ethereum_jsonrpc/test/ethereum_jsonrpc/paxeer_x_test.exs"
line = 309
class = "test-gap"
severity = "medium"
observed = "The eth_syncing test calls an unconditional -32000 refusal the node normal response and asserts synced. The current rpc/info.go producer returns false or SyncingResult and returns a real consensus Status error on failure."
expected = "Requirements 14271.1 and 14271.2 need evidence from the current node response shape, with operational failures preserved instead of reported as caught up."
proposal = "In test/ethereum_jsonrpc/paxeer_x_test.exs, capture current node false/progress/error responses through HTTP and assert the corresponding adapter states; keep any legacy compatibility case separately named and versioned."
owner_domain = 14
interface = "7.rpc-eth-syncing"

[finding.throttle-admission-unbounded]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/http/throttle.ex"
line = 256
class = "runtime-risk"
severity = "medium"
observed = "Throttle.acquire calls the guard with :infinity and recursively sleeps and retries every guard exit. Per-endpoint queues have no capacity or admission deadline and pump repeatedly scans the waiting entries during a sustained node outage."
expected = "A slow or unavailable node must not retain arbitrarily many explorer callers or keep them waiting beyond an explicit request budget."
proposal = "In http/throttle.ex, add a bounded admission queue and absolute deadline shared with HTTP execution, cancel expired waiters, and return a typed overload or unavailable result. Preserve existing rate and concurrency limits and exercise a sustained outage."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-http-throttle"

[finding.throttle-restart-cap]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/http/throttle.ex"
line = 510
class = "restart-recovery"
severity = "medium"
observed = "A restarted guard creates empty inflight and leader maps while already admitted HTTP work continues in caller tasks. New requests can be admitted on top of that surviving work; the restart test deliberately has requests A and B active under max_inflight: 1."
expected = "The per-endpoint node protection budget should still cap actual outstanding work during guard recovery. Requirement 18698.1 separately requires that an old completion cannot release a replacement ticket, which the generation checks already address."
proposal = "In http/throttle.ex and its supervision boundary, either recover outstanding admissions or cancel and drain old work before issuing new tickets. Extend throttle_test.exs to count actual concurrent work during restart while retaining the existing stale-completion assertion."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-http-throttle"

[finding.throttle-inflight-gauge]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/http/throttle.ex"
line = 502
class = "interface-mismatch"
severity = "medium"
observed = "publish/1 writes one endpoint counts into gauges labelled only by class. With multiple configured HTTP endpoints, the last endpoint published overwrites the others and an idle endpoint can display zero while another still has work."
expected = "The exported class gauge must have a defined value representing all work in its label set, so operators can observe explorer node pressure reliably."
proposal = "In http/throttle.ex, aggregate class counts over all endpoint state before setting the gauges, or introduce a bounded credential-free endpoint identity with a documented aggregation rule. Verify two simultaneously busy endpoints and one idle endpoint."
owner_domain = 14
interface = "14.met-explorer-json-rpc-throttle-inflight"

