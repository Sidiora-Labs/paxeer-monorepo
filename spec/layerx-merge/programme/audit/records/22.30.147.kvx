[interface_review.01]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-tracer"
direction = "produces"
notes = "config/config.exs defines service/adapter/trace_key/env/disabled? for EthereumJSONRPC.Tracer. tracer.ex uses Spandex.Tracer with otp_app :ethereum_jsonrpc and the HTTP and Geth paths open spans through that module; development/production overrides retain the same keys."
findings = []

[interface_review.02]
interface = "14.cfg-logger-ethereum-jsonrpc"
direction = "produces"
notes = "config/config.exs declares the ethereum_jsonrpc logger backend metadata filter, file path and rotation settings. Library errors carry application metadata and use that backend. DecodeError and WebSocket URL redaction gaps are recorded at the producing log calls."
findings = []

[interface_review.03]
interface = "14.met-explorer-json-rpc-requests-count"
direction = "produces"
notes = "The declared metric name, type and bounded method/class label set match Instrumenter or Throttle.Metrics. HTTP transports and throttle publish are the producers; the default Prometheus registry is the consumer. Counter attribution and gauge aggregation issues are recorded separately; no metric gate was executed."
findings = ["http-batch-metrics-40", "http-batch-metrics-41"]

[interface_review.04]
interface = "14.met-explorer-json-rpc-requests-errors-count"
direction = "produces"
notes = "The declared metric name, type and bounded method/class label set match Instrumenter or Throttle.Metrics. HTTP transports and throttle publish are the producers; the default Prometheus registry is the consumer. Counter attribution and gauge aggregation issues are recorded separately; no metric gate was executed."
findings = ["http-gzip-errors-40", "http-gzip-errors-41"]

[interface_review.05]
interface = "14.met-explorer-json-rpc-throttle-coalesced-count"
direction = "produces"
notes = "Throttle increments Metrics.coalesced(class) when a follower attaches to an existing identical in-flight leader. Metrics exports a counter under the default registry with only default/archive/trace class labels; leader completion returns the same result to followers. No endpoint URL or credentials are labels."
findings = []

[interface_review.06]
interface = "14.met-explorer-json-rpc-throttle-inflight"
direction = "produces"
notes = "The declared metric name, type and bounded method/class label set match Instrumenter or Throttle.Metrics. HTTP transports and throttle publish are the producers; the default Prometheus registry is the consumer. Counter attribution and gauge aggregation issues are recorded separately; no metric gate was executed."
findings = ["throttle-inflight-gauge"]

[interface_review.07]
interface = "14.met-explorer-json-rpc-throttle-queue-depth"
direction = "produces"
notes = "The declared metric name, type and bounded method/class label set match Instrumenter or Throttle.Metrics. HTTP transports and throttle publish are the producers; the default Prometheus registry is the consumer. Counter attribution and gauge aggregation issues are recorded separately; no metric gate was executed."
findings = ["throttle-queue-gauge"]

[interface_review.08]
interface = "14.met-explorer-json-rpc-throttle-wait-time-milliseconds"
direction = "produces"
notes = "Throttle records monotonic queue-to-admission elapsed milliseconds through Metrics.wait_time(class, milliseconds). The histogram declares duration_unit false and millisecond buckets, so producer units agree with the exported metric name and consumer interpretation."
findings = []

[interface_review.09]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-geth"
direction = "consumes"
notes = "runtime.exs produces block_traceable?, allow_empty_traces?, debug_trace_timeout and tracer under EthereumJSONRPC.Geth. geth.ex reads those keys to choose per-block tracing, empty-trace policy and call/custom/native tracers; debug_trace_timeout is sent to node TraceConfig and parsed for client timeout. The current default is call_tracer and 5s; malformed parser input is recorded separately."
findings = ["duration-parser-partial"]

[interface_review.10]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-http"
direction = "consumes"
notes = "runtime.exs supplies HTTP.headers as string pairs and gzip_enabled? as a boolean. HTTP.headers adds Accept-Encoding only when enabled and Helper.try_unzip reads the same key. HTTPoison/Tesla return inflated response bytes; compressed error instrumentation is recorded separately."
findings = []

[interface_review.11]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-http-throttle"
direction = "consumes"
notes = "runtime.exs supplies max_inflight 32, rps 200, trace_max_inflight 4, archive_max_inflight 8 and coalesce? true. Throttle merges those keys with test overrides, classifies each request and debits per-endpoint weighted tokens. Ticket generations reject stale completion; outage admission and restart cap gaps are recorded separately."
findings = ["throttle-admission-unbounded", "throttle-restart-cap"]

[interface_review.12]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-paxeerx"
direction = "consumes"
notes = "runtime.exs supplies cosmos_transaction_type 127 and native_coin_decimals 18. PaxeerX reads those module keys for Cosmos marker normalization and native display metadata; bank_denom_decimals remains 6 and wei scaling remains 10^12. The configured storage-type upper-bound gap is recorded separately."
findings = ["cosmos-type-storage-bound"]

[interface_review.13]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-pendingtransaction"
direction = "consumes"
notes = "runtime.exs supplies PendingTransaction.type from ETHEREUM_JSONRPC_PENDING_TRANSACTIONS_TYPE with default default. Nethermind chooses its Geth pending path only for string geth, otherwise its parity path. PaxeerX delegates to its Geth-compatible pending behavior; other-client source selection remains explicit."
findings = []

[interface_review.14]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-requestcoordinator"
direction = "consumes"
notes = "Application reads rolling_window_opts to start ETS windows, and RequestCoordinator reads wait_per_timeout/max_jitter for backoff. Optional top-level throttle_rate_limit starts the separate throttle window. The request path incorrectly checks the limit inside throttle_rolling_window_opts; see coordinator-rate-limit-key."
findings = ["coordinator-rate-limit-key"]

[interface_review.15]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-utility-endpointavailabilitychecker"
direction = "consumes"
notes = "runtime.exs enables EndpointAvailabilityChecker and the checker reads that same module key before scheduling a probe pass. Probe results feed EndpointAvailabilityObserver URL-type state rather than changing the declared node method payload."
findings = []

[interface_review.16]
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-websocket-retryworker"
direction = "consumes"
notes = "runtime.exs parses ETHEREUM_JSONRPC_WS_RETRY_INTERVAL into milliseconds under retry_interval, default one minute. RetryWorker reads retry_interval and uses Process.send_after. It retains one unavailable endpoint state; replacement client lifecycle defects are recorded in WebSocket findings."
findings = []

[interface_review.17]
interface = "14.cfg-ethereum-jsonrpc-ipc-path"
direction = "consumes"
notes = "runtime.exs takes IPC_PATH and Application passes it as the pool worker path when rpc_transport is :ipc. IPC.init opens a local gen_tcp socket at that path. Timeout coherence and node-restart recovery need the recorded IPC proposals."
findings = ["ipc-timeout-mismatch"]

[interface_review.18]
interface = "14.cfg-ethereum-jsonrpc-rpc-transport"
direction = "consumes"
notes = "ConfigHelper parses ETHEREUM_JSONRPC_TRANSPORT into the :http/:ipc choice used by Application.add_ipc_client; higher-level named arguments select the corresponding transport module. HTTP standardizes error code/message/data while single IPC errors currently do not."
findings = ["ipc-dead-socket", "ipc-error-shape"]

[interface_review.19]
interface = "14.cfg-explorer-chain-type"
direction = "consumes"
notes = "runtime.exs supplies :explorer chain_type and compile-time environment helpers use it for Block/Receipt/Transaction field branches. Variant.get_default_variant special-cases rsk/filecoin and otherwise geth; the deployment explicitly supplies paxeer_x variant. Chain-specific options are not inferred from arbitrary incoming JSON."
findings = []

[interface_review.20]
interface = "14.cfg-explorer-json-rpc-named-arguments"
direction = "consumes"
notes = "Explorer configuration supplies transport, transport_options and variant. CommonHelper reads its transport_options when no explicit options are passed, then selects healthy primary/fallback URL lists by request type. Caller-supplied named arguments override that fallback; README example drift is recorded."
findings = ["readme-config"]

[interface_review.21]
interface = "14.cfg-explorer-subscribe-named-arguments"
direction = "consumes"
notes = "The listed WebSocket supervisor caller actually reads :indexer realtime_overrides/subscribe_named_arguments, not :explorer subscribe_named_arguments. The registry association is an atom-name match across applications; the live replacement-client path uses indexer configuration as documented in the corresponding indexer row."
findings = []

[interface_review.22]
interface = "14.cfg-explorer-transport"
direction = "consumes"
notes = "The listed top-level library caller lines describe or destructure :transport in JSON-RPC named arguments, rather than reading Application.get_env(:explorer, :transport). Dispatch uses the transport module present in the passed keyword list. This registry edge conflates a field name with a global application setting."
findings = []

[interface_review.23]
interface = "14.cfg-indexer-block-ranges"
direction = "consumes"
notes = "runtime.exs supplies :indexer block_ranges as the configured range expression; RangesHelper reads the same key, parses limits and intersects requested block spans. No range state is persisted inside this library."
findings = []

[interface_review.24]
interface = "14.cfg-indexer-indexer-fetcher-tokeninstance-helper"
direction = "consumes"
notes = "NFT.fetch_token_instances reads base_uri_retry? under Indexer.Fetcher.TokenInstance.Helper before retrying the VM-refusal subset with a base-URI call. Other host filtering keys belong to later media retrieval; this slice only constructs and decodes contract calls."
findings = []

[interface_review.25]
interface = "14.cfg-indexer-subscribe-named-arguments"
direction = "consumes"
notes = "WebSocket.Supervisor.start_client first reads :indexer realtime_overrides[:subscribe_named_arguments] and otherwise :indexer subscribe_named_arguments. It extracts transport_options.web_socket to start the replacement client with retained state. Producer and reader key names match; stable public handle ownership does not survive failback."
findings = []

[interface_review.26]
interface = "14.cfg-indexer-trace-block-ranges"
direction = "consumes"
notes = "runtime.exs supplies :indexer trace_block_ranges and RangesHelper reads that exact application key, intersects with block_ranges and checks traceable ranges. The parser uses explicit configured range boundaries rather than an implicit tenant namespace."
findings = []

[interface_review.27]
interface = "14.cfg-logger-error"
direction = "consumes"
notes = "Registry callers in ethereum_jsonrpc.ex are error tuple atoms and callback specifications, not reads of the logger backend named :error. No producer/consumer relationship with that logger configuration can be inferred from those atom matches."
findings = []

[interface_review.28]
interface = "14.cfg-logger-explorer"
direction = "consumes"
notes = "Registry callers use the :explorer application atom for chain_type and json_rpc_named_arguments, not the logger backend named :explorer. These matches do not make the library consume that logger backend configuration."
findings = []

[interface_review.29]
interface = "14.cfg-logger-indexer"
direction = "consumes"
notes = "Registry callers read :indexer settings for subscriptions, ranges and token helper behavior, not the logger backend named :indexer. Backend metadata is handled by logging configuration; an application-name match is not a separate RPC interface."
findings = []

[interface_review.30]
interface = "14.cfg-nft-media-handler-standalone-media-worker"
direction = "consumes"
notes = "Application.start reads :nft_media_handler standalone_media_worker?. True starts only the HTTP Throttle child for this application; false starts HTTP pooling, rolling windows and endpoint monitoring plus optional IPC. The same boolean key is produced by runtime.exs."
findings = []

[interface_review.31]
interface = "14.cfg-spandex-phoenix-tracer"
direction = "consumes"
notes = "The listed Geth callers choose debug TraceConfig.tracer and have no read of :spandex_phoenix tracer configuration. This registry edge conflates the EVM tracer selector with the Phoenix tracing module; actual application spans use EthereumJSONRPC.Tracer."
findings = []

[interface_review.32]
interface = "14.env-ethereum-jsonrpc-disable-archive-balances"
direction = "consumes"
notes = "runtime.exs parses ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES and also disables archive balances when no trace URL is configured. Shared balance fetching consumes the resulting disable_archive_balances? and archive_balances_window keys. The listed test changes application settings to exercise fallback; it is not another environment parser."
findings = []

[interface_review.33]
interface = "14.env-ethereum-jsonrpc-http-url"
direction = "consumes"
notes = "ConfigHelper selects ETHEREUM_JSONRPC_HTTP_URLS or singular ETHEREUM_JSONRPC_HTTP_URL and produces HTTP URL lists in named arguments. CommonHelper selects a currently available URL, and HTTP passes it through the guard and selected adapter. Unit support uses the same explicit test environment; hardcoded other-client integration profiles are recorded separately."
findings = ["external-test-endpoint-140", "external-test-endpoint-142", "external-test-endpoint-146", "external-test-endpoint-148"]

[interface_review.34]
interface = "14.env-ethereum-jsonrpc-transport"
direction = "consumes"
notes = "ConfigHelper accepts the configured HTTP or IPC transport and runtime.exs publishes it. Test support uses the same environment selection to provide transport modules and options. WebSocket subscription configuration is separate and cannot replace HTTP calls with a wss URL."
findings = []

[interface_review.35]
interface = "14.env-ethereum-jsonrpc-variant"
direction = "consumes"
notes = "Variant.get reads ETHEREUM_JSONRPC_VARIANT, lowercases the module suffix and aliases parity to nethermind. The deployment supplies paxeer_x and shared dispatch resolves it to PaxeerX; this is independent of the rsk-specific runtime flag cited by the registry producer line."
findings = []

[interface_review.36]
interface = "4.sol-mocksidiorarouter-revertreason-61b5b636"
direction = "consumes"
notes = "Besu trace.ex reads the JSON trace revertReason field; it neither invokes MockSidioraRouter nor consumes its Solidity getter. This registry caller is a lexical field-name match, so no cross-domain ABI or lifecycle dependency is established."
findings = []

[interface_review.37]
interface = "6.pc-0x1005-params"
direction = "consumes"
notes = "FetchedCode, Nonce and SignedAuthorization define generic params conversion functions. None sends selector params() to staking address 0x1005; the inferred registry edge is a lexical match rather than an RPC invocation."
findings = []

[interface_review.38]
interface = "6.sol-cw721erc721pointer-tokenuri-c87b56dd"
direction = "consumes"
notes = "NFT sends tokenURI(uint256) selector c87b56dd through Contract eth_call with a uint256 token ID and decodes one ABI string; CW721ERC721Pointer.tokenURI emits that string shape. Target address comes from the requested token contract."
findings = []

[interface_review.39]
interface = "6.sol-evmcompatibilitytester-gaslimit-f68016b7"
direction = "consumes"
notes = "Block and Blocks read the JSON-RPC gasLimit field as a quantity. They do not call EVMCompatibilityTester.gasLimit(); the registry association is a lexical field-name match."
findings = []

[interface_review.40]
interface = "6.sol-mynft-tokenuri-c87b56dd"
direction = "consumes"
notes = "NFT uses the same tokenURI(uint256) selector and string return ABI as MyNFT.tokenURI. This is a fungible ERC721 selector dependency rather than a fixed MyNFT deployment dependency."
findings = []

[interface_review.41]
interface = "7.rpc-debug-traceblockbynumber"
direction = "consumes"
notes = "Node DebugAPI accepts hex block selectors or transaction hashes plus tracer configuration. Geth/PaxeerX select callTracer and decode call/create/selfdestruct trees with explicit transaction index and traceAddress; structLog native/custom alternatives remain conditional. Stored fixture tests do not establish current producer integration; see trace-real-path and native-create-stack."
findings = ["trace-real-path"]

[interface_review.42]
interface = "7.rpc-debug-tracetransaction"
direction = "consumes"
notes = "Node DebugAPI accepts hex block selectors or transaction hashes plus tracer configuration. Geth/PaxeerX select callTracer and decode call/create/selfdestruct trees with explicit transaction index and traceAddress; structLog native/custom alternatives remain conditional. Stored fixture tests do not establish current producer integration; see trace-real-path and native-create-stack."
findings = ["native-create-stack"]

[interface_review.43]
interface = "7.rpc-eth-blocknumber"
direction = "consumes"
notes = "InfoAPI.BlockNumber emits hexutil.Uint64 at the node committed/pending watermarks. The library block-number helper sends no params, decodes the hex quantity and preserves an RPC error through HTTP standardization. It does not infer finality from a transport acknowledgment."
findings = []

[interface_review.44]
interface = "7.rpc-eth-chainid"
direction = "consumes"
notes = "InfoAPI.ChainId emits hexutil.Big, so chain 125 is 0x7d. fetch_chain_id sends an empty parameter list and quantity_to_integer accepts that encoding. A decimal unit example is decoder compatibility rather than current-node wire evidence."
findings = []

[interface_review.45]
interface = "7.rpc-eth-getbalance"
direction = "consumes"
notes = "StateAPI.GetBalance accepts an address plus BlockNumberOrHash and emits a wei-denominated hexutil.Big. FetchedBalance(s) send address/block selectors, correlate batch IDs and convert quantity results to integer import values. Archive-balance fallback is configuration-controlled; bank uhpx precision is not applied to the RPC result a second time."
findings = []

[interface_review.46]
interface = "7.rpc-eth-getblockbyhash"
direction = "consumes"
notes = "BlockAPI.GetBlockByHash accepts a 32-byte hash and fullTx boolean and emits a map or null. Block.ByHash sends true for full indexing; Blocks correlates IDs and Block/Transactions convert quantities. PaxeerX compares hash/number/parentHash/receiptsRoot with newHeads and falls back to number refetch on inconsistency; missing real producer capture is recorded."
findings = []

[interface_review.47]
interface = "7.rpc-eth-getblockbynumber"
direction = "consumes"
notes = "BlockAPI.GetBlockByNumber accepts a quantity or committed tag and fullTx boolean. Block.ByNumber/ByTag and Blocks preserve IDs then decode block and transaction fields. The eth producer excludes Cosmos shell receipts whereas pax includes them; the mixed-count fixture violates that distinction. Finalized helper omission and invalid-tag error normalization are recorded separately."
findings = ["finalized-block-tag", "block-tag-error-keys", "mixed-count-fixture-shape"]

[interface_review.48]
interface = "7.rpc-eth-getblockreceipts"
direction = "consumes"
notes = "BlockAPI.GetBlockReceipts accepts BlockNumberOrHash and emits receipt maps with transaction positions, status, gas and logs. Receipts.ByBlockNumber sends a quantity and Receipts correlates the batch by expected height before Receipt/Logs conversion. Hex height IDs hit an integer-only assertion branch; see receipt-hex-id-crash."
findings = ["receipt-hex-id-crash"]

[interface_review.49]
interface = "7.rpc-eth-getblocktransactioncountbynumber"
direction = "consumes"
notes = "The node count API returns hexutil.Uint or null for an absent block and scopes counts through the same domain/block visibility as its block API. The package parity test never calls it and instead compares two constructed responses with an eth/pax shell mismatch; see both mixed-count findings."
findings = ["mixed-count-test-capture"]

[interface_review.50]
interface = "7.rpc-eth-getcode"
direction = "consumes"
notes = "StateAPI.GetCode accepts address and BlockNumberOrHash and returns bytecode as 0x-prefixed hexutil.Bytes. FetchedCode(s) preserve code bytes, requested address and block correlation in explorer import params; missing-code/error handling remains explicit."
findings = []

[interface_review.51]
interface = "7.rpc-eth-getlogs"
direction = "consumes"
notes = "FilterAPI.GetLogs accepts address/topic and block filters and returns FilterLog objects. Logs sends range quantities/tags and Log converts blockNumber/logIndex/transactionIndex to integers while preserving topics/data/hash bytes and removed. The finalized filter-builder omission is recorded separately; the configured HTTP path is the supported query transport."
findings = ["finalized-log-tag"]

[interface_review.52]
interface = "7.rpc-eth-getstorageat"
direction = "consumes"
notes = "StateAPI.GetStorageAt accepts address, slot key and BlockNumberOrHash and emits a 32-byte hexutil.Bytes word. The library helper passes the address/key/block selector and returns the hex word without converting it into a decimal amount; HTTP errors preserve their code and optional data."
findings = []

[interface_review.53]
interface = "7.rpc-eth-gettransactionbyblockhashandindex"
direction = "consumes"
notes = "TransactionAPI takes hash plus hexutil.Uint position and returns RPCTransaction or null. Shared transaction requests encode the index as a quantity and Transaction conversion preserves hash/block/index plus typed fields. No shell transaction from the pax namespace is assumed in an eth-only view."
findings = []

[interface_review.54]
interface = "7.rpc-eth-gettransactionbyblocknumberandindex"
direction = "consumes"
notes = "TransactionAPI takes BlockNumber plus hexutil.Uint position. The library encodes the numeric selector and position as quantities, then decodes the same RPCTransaction shape as hash lookup, keeping null separate from an error."
findings = []

[interface_review.55]
interface = "7.rpc-eth-gettransactionbyhash"
direction = "consumes"
notes = "TransactionAPI returns RPCTransaction or null from a transaction hash, including pending results. Transaction(s) converts quantity fields and nullable block context; the PaxeerX compatibility path normalizes a legacy 0xffffffff Cosmos type before database params. The replacement-type configuration bound is recorded separately."
findings = []

[interface_review.56]
interface = "7.rpc-eth-gettransactioncount"
direction = "consumes"
notes = "TransactionAPI returns the account nonce as hexutil.Uint64 for address and BlockNumberOrHash. Nonce/Nonces construct address/block requests, convert the quantity to an integer and correlate per-account failures. This is the EVM account nonce, not an LXP activity sequence."
findings = []

[interface_review.57]
interface = "7.rpc-eth-gettransactionreceipt"
direction = "consumes"
notes = "TransactionAPI emits receipt maps or null keyed by transaction hash. Receipts.ByTransactionHash constructs requests with independent correlation IDs; Receipt decodes status 0x0/0x1, gas, transaction positions and Logs. A committed receipt is final under the merged chain; the adapter does not manufacture an authorized-batch receipt."
findings = []

[interface_review.58]
interface = "7.rpc-eth-subscribe"
direction = "consumes"
notes = "Node SubscriptionAPI and built-in subscribe/unsubscribe emit string IDs and eth_subscription params.subscription/result; the gateway relays that envelope and WebSocketClient maps server IDs to local Subscription references. Header quantities go through PaxeerX body refetch and parity checks. Failback handle ownership and missing recovery evidence are recorded in ws-handle-after-failback and ws-reconnect-test-absent."
findings = ["ws-old-server-ids", "ws-unbounded-pending"]

[interface_review.59]
interface = "7.rpc-eth-syncing"
direction = "consumes"
notes = "Node InfoAPI.Syncing emits false or startingBlock/currentBlock/highestBlock hex quantities and propagates Status errors. HTTP standardizes the result and PaxeerX decodes the false/progress forms, but drops every error into synced; see sync-error-becomes-synced and syncing-real-path."
findings = ["sync-error-becomes-synced", "sync-legacy-test", "syncing-real-path"]

[interface_review.60]
interface = "7.rpc-eth-unsubscribe"
direction = "consumes"
notes = "Node SubscriptionAPI and built-in subscribe/unsubscribe emit string IDs and eth_subscription params.subscription/result; the gateway relays that envelope and WebSocketClient maps server IDs to local Subscription references. Header quantities go through PaxeerX body refetch and parity checks. Failback handle ownership and missing recovery evidence are recorded in ws-handle-after-failback and ws-reconnect-test-absent."
findings = ["ws-handle-after-failback", "ws-reconnect-test-absent"]

[interface_review.61]
interface = "7.rpc-txpool-content"
direction = "consumes"
notes = "TxPoolAPI.Content emits pending/queued maps grouped by sender then nonce containing RPCTransaction values. Geth PendingTransaction selects the content method and flattens actual pending transactions into params. Pending data remains node-local and no separate sequencer receipt is used to establish commitment."
findings = []

[interface_review.62]
interface = "7.ws-eth-subscribe-newheads"
direction = "consumes"
notes = "Node SubscriptionAPI and built-in subscribe/unsubscribe emit string IDs and eth_subscription params.subscription/result; the gateway relays that envelope and WebSocketClient maps server IDs to local Subscription references. Header quantities go through PaxeerX body refetch and parity checks. Failback handle ownership and missing recovery evidence are recorded in ws-handle-after-failback and ws-reconnect-test-absent."
findings = ["ws-crash-recovery", "ws-termination-envelope", "newhead-fields-real-path", "newhead-parity-real-path"]

