[requirement_review.parity]
requirements = ["14267.1", "14268.1", "14269.1", "14270.1", "14271.1", "14271.2"]
notes = "PaxeerX refetches full blocks, checks parentHash and receiptsRoot against newHeads and rejects changed fields; Geth callTracer flattens call/create positions; syncing decodes false/progress. Existing local mutation tests are useful but reconstructed fixtures do not establish producer parity. Count fixture namespace membership and synchronization failures require the proposals above."

[requirement_review.guard]
requirements = ["18698.1"]
notes = "Tickets include a guard-generation identity and completion/release refuses old tickets. The existing restart test asserts an old completion leaves the replacement slot occupied. Actual outstanding work can still exceed the cap across guard restart, recorded separately without weakening the stale-ticket criterion."

[audit_limits.22.30.147]
notes = "This record proposes source and documentation repairs only. Runtime integration tests were inspected, not executed; the declared qualification checks the record and graph. No chain state, remote endpoint or production configuration was changed. Arbitrum and zkSync batch/sequencer wording belongs to other-chain adapters. This library creates no tenant database namespace; tenant routing depends on configured node endpoints and headers plus downstream explorer scoping. Multi-domain explorer indexing isolation is not proven by this slice."
qualification = "Bounded build and hf-done evidence is produced by the task runner after this record is complete."
