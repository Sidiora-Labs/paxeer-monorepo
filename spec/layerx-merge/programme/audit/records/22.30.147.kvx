[finding.decode-error-secrets]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/decode_error.ex"
line = 68
class = "security"
severity = "medium"
observed = "DecodeError.message includes every request header, the full URL by default, and the complete response body. HTTP.decode_json logs this exception, so Authorization headers and URL credentials can be disclosed and oversized invalid bodies can flood logs."
expected = "RPC decoding diagnostics must redact credentials and bound untrusted request and response content before they enter any logger backend."
proposal = "In decode_error.ex and the HTTP decode logging path, redact Authorization and other sensitive headers, sanitize URL components and cap response bytes. Add focused redaction cases while keeping status and bounded diagnostic context."
owner_domain = 14

[finding.ipc-timeout-mismatch]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/ipc.ex"
line = 25
class = "runtime-risk"
severity = "medium"
observed = "IPC.post uses the default five-second GenServer.call deadline, while handle_call waits up to 500000 milliseconds on the socket and poolboy.transaction allows 600000 milliseconds. A slow valid node can exit the caller while the worker keeps waiting."
expected = "The public IPC request should return the documented result or error within one coherent deadline and leave its worker in a usable state after timeout."
proposal = "In ipc.ex, propagate one configured absolute deadline through pool acquisition, GenServer.call and socket reads, catch expected timeout exits as typed transport errors, and discard any response that belongs to an expired request."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-ipc-path"

[finding.ipc-dead-socket]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/ipc.ex"
line = 60
class = "restart-recovery"
severity = "medium"
observed = "After gen_tcp.send or recv reports a closed socket, handle_call replies with the error and retains the same socket in worker state. The connection is established only in init, so a surviving pooled worker never reconnects after the node restarts."
expected = "An explorer using the configured IPC transport must reconnect or replace its worker after the node closes and reopens the local socket."
proposal = "In ipc.ex, close and invalidate failed sockets and reconnect safely before the next request, or terminate the failed worker so pool supervision replaces it. Prove node socket close, restart and a subsequent successful request."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-rpc-transport"

[finding.ipc-error-shape]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/ipc.ex"
line = 69
class = "runtime-risk"
severity = "medium"
observed = "IPC.request returns a single JSON-RPC error as the original string-keyed map, while HTTP.standardize_response produces atom-keyed code/message/data maps. Callers selecting the configured transport therefore observe different error shapes."
expected = "The Transport callback error contract should be identical across HTTP and IPC for the same node JSON-RPC error, including code and data fields."
proposal = "In ipc.ex, pass single responses through the same response standardizer as HTTP and cover successful, error and batch messages against the same real response corpus. Update exact-key consumers to the documented common contract."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-rpc-transport"

[finding.coordinator-rate-limit-key]
