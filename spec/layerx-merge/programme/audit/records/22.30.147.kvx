[finding.http-batch-metrics-40]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/http/httpoison.ex"
line = 15
class = "interface-mismatch"
severity = "medium"
observed = "The HTTP adapter selects the first method from a JSON batch and increments one request counter under that method. Errors from a mixed batch are also attributed only to that first method rather than the request ID of the failed member."
expected = "The json_rpc_requests_count{method} and json_rpc_requests_errors_count{method} series should count and attribute the individual method calls that the explorer sends."
proposal = "In http/httpoison.ex and http/helper.ex, associate every request ID with its method and count each batch member and its error under the matching method. Preserve one clear rule for whole-transport failures and prove a mixed successful/failed batch."
owner_domain = 14
interface = "14.met-explorer-json-rpc-requests-count"

[finding.http-gzip-errors-40]
file = "services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/http/httpoison.ex"
line = 21
class = "interface-mismatch"
severity = "medium"
observed = "The HTTP adapter attempts Jason.decode(body) for error instrumentation before Helper.try_unzip runs. A gzip-compressed JSON-RPC error therefore reaches the caller after decompression but does not increment the RPC error counter."
expected = "Transport compression must not change error accounting for identical JSON-RPC responses or hide node refusals from explorer monitoring."
proposal = "In http/httpoison.ex, inflate the body once before both JSON error inspection and response delivery, and verify that compressed and plain versions of the same error produce the same method error count."
owner_domain = 14
interface = "14.met-explorer-json-rpc-requests-errors-count"

