line = 148
class = "config-drift"
severity = "medium"
observed = "throttle_request takes rate_limit from the top-level throttle_rate_limit configuration but checks opts[:throttle_rate_limit], where opts is throttle_rolling_window_opts. The normal nested window options contain duration/window_count, so this condition bypasses the configured limit."
expected = "A configured rolling-window rate limit must be applied using the same configuration layout that runtime.exs supplies, independently of the newer HTTP guard."
proposal = "In request_coordinator.ex, validate and read rate_limit from its declared top-level key and use window options only for window timing. Exercise the actual runtime configuration shape with enough requests to cross the limit."
owner_domain = 14
interface = "14.cfg-ethereum-jsonrpc-ethereumjsonrpc-requestcoordinator"

