[finding.001]
file = "programs/crates/layerx-programs-ai-market/tests/chain_domain.rs"
line = 17
class = "config-drift"
severity = "high"
observed = "MERGED_CHAIN_ID is 229 and the b69143b1...7f038d golden is asserted against Makefile:2903 PAXAI_CHAIN_DOMAIN, CI and deployment_chain_domain(). The default release guest binds market, state and request identities to chain 229."
expected = "The finished network is Paxeer chain 125. The build-time domain must identify that network consistently across deployed guests, request producers and state consumers; foreign domains must still refuse."
proposal = "Update Makefile, tests/ci/test_paxai_chain_domain.py and this test to derive the domain from chain 125 together with the deployment/request path in programs/crates/layerx-programs-ai-market/src/lib.rs; regenerate real host-boundary vectors and retain WRONG_DOMAIN refusal."
owner_domain = 13

[finding.002]
file = "programs/crates/layerx-programs-runtime/src/terminal.rs"
line = 630
class = "interface-mismatch"
severity = "high"
observed = "calls.rs:1123 emits CompositionRefusal::WrongVersion for admitted ABI mismatches. ffi_call.rs:740 encodes expected/actual with revision_tag values 1 through 5, but decode_composition accepts only 1 or 2. Valid refusal receipts involving ABI 3, 4 or 5 become Malformed in layerx-proof/src/program.rs:412 and other consumers."
expected = "The terminal producer, receipt transport and decode_terminal_payload consumer must round-trip every allocated revision tag, including failed cross-version calls, while refusing unallocated values."
proposal = "Unify ABI revision encoding/decoding in programs/crates/layerx-programs-runtime/src/ffi_call.rs and terminal.rs with abi_policy.rs; exercise real mixed ABI 3/4 and 4/5 nested-call refusal receipts through host and proof consumers without weakening unknown-tag refusal."
owner_domain = 13
interface = "13.rs-rt-terminal-decode-terminal-payload"

[finding.003]
file = "programs/crates/layerx-programs-runtime/src/qualification.rs"
line = 143
class = "restart-recovery"
severity = "medium"
observed = "DECLARED_REVISIONS contains only ExecutorRevision::v1() and v2(). Both replay_recorded_execution entry points dispatch through it and return UnknownAbiVersion for ABI 3 through 5, although engine.rs and abi_policy.rs admit these executions."
expected = "Qualification replay must recognize every admitted recorded ABI under its exact runtime, fee and metering history, while preserving strict refusal of unknown future revisions."
proposal = "Extend the historical revision catalog in programs/crates/layerx-programs-runtime/src/qualification.rs for ABI 3 through 5 with their correct policies; produce and replay real evidence for each with governed fee history and retain unknown-version refusal."
owner_domain = 13
interface = "13.rs-rt-qualification-replay-recorded-execution"

[finding.004]
file = "programs/crates/layerx-programs-runtime/src/qualification.rs"
line = 413
class = "runtime-risk"
severity = "medium"
observed = "TraceRunnerArtifact decoding accepts canonical evidence up to 128 MiB, but attestation_digest uses crypto/hash.rs hash_bytes, which refuses inputs above 1 MiB. programs_trace_runner_artifact:441 also applies that guest ceiling to the whole executable, rejecting larger real runner binaries before provenance is produced."
expected = "Host provenance and attestation must handle their declared artifact sizes consistently; bounded guest hashing must not accidentally impose a smaller incompatible host evidence limit."
proposal = "Use a separately bounded host provenance hashing path in programs/crates/layerx-programs-runtime/src/qualification.rs for runner bytes and unsigned attestations; align artifact bounds and exercise real signing/verification across the boundary while retaining guest MAX_HASH_INPUT_BYTES."
owner_domain = 13
interface = "13.rs-rt-qualification-tracerunnerartifact-attestation-digest"

[finding.005]
file = "programs/Cargo.toml"
line = 31
class = "config-drift"
severity = "medium"
observed = "The workspace release profile sets opt-level = 3. The AI package and programs/.cargo/config.toml supply no opt-level z override, and Makefile:2915 invokes --release without choosing z. The declared AI build therefore inherits optimization level 3."
expected = "Decision 2483 and requirement 13991.1 require release opt-level z for the AI guest and a deployment payload at most 524288 bytes including its 104-byte envelope. Static inspection alone does not establish the resulting artifact size."
proposal = "Add an AI-specific release opt-level z override in programs/Cargo.toml or one equivalent canonical deployment profile, and make the real guest build and payload-size assertion consume it with the 104-byte envelope included."
owner_domain = 13

