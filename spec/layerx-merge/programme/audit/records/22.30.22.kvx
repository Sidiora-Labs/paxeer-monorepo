[finding.mobile-live-cache-version]
file = "apps/launchpad/mobile/src/runtime/offline-cache.ts"
line = 6
class = "interface-mismatch"
severity = "high"
observed = "validatePublicSnapshot always uses the SDK v1 decodeContract, including StreamListResponse for live. activityRoutes.streams uses IF_STREAM_LIST /v2/streams. The live producer handlers.go stream view emits viewerCount:null with viewerQuality:unavailable when estimates are unavailable; v1 Stream requires an integer. App installs native publicSnapshotStorage, so put throws before persistence and disk read rejects that legitimate v2 response."
expected = "A v2 public stream response must survive the live producer, mobile transport, cache persistence and restart without losing the distinction between unavailable viewer evidence and a real zero count."
proposal = "Make public snapshot contracts version-aware in apps/launchpad/mobile/src/runtime/offline-cache.ts, validating live payloads with the same v2 contract used by Operations. Preserve viewerCount:null and viewerQuality, define stored-version migration/refusal, and prove real producer responses across native storage restart."
owner_domain = 4
interface = "4.ts-sdk-validate-decode-contract"
related_interfaces = ["4.ts-mobile-routes-activity-j30"]

[finding.mobile-live-restore-version]
file = "apps/launchpad/mobile/src/navigation.tsx"
line = 33
class = "interface-mismatch"
severity = "high"
observed = "useResource revalidates every recovered public snapshot with v1 decodeContract(publicContract(key),cached.value). For live this is StreamListResponse, whose v1 stream viewerCount must be integer. The v2 stream route legitimately returns viewerCount:null when the viewer estimator is unavailable, so even a corrected cache cannot restore that valid snapshot through navigation."
expected = "Navigation must accept the same versioned stream shape as the producer and cache, including unavailable viewer evidence, and restore it with explicit offline age after restart."
proposal = "Share the version-aware public snapshot decoder between apps/launchpad/mobile/src/navigation.tsx and runtime/offline-cache.ts. Exercise a real v2 live response with unavailable viewers through persistence, app restart and offline rendering; retain strict validation for malformed responses."
owner_domain = 4
interface = "4.ts-sdk-validate-decode-contract"

