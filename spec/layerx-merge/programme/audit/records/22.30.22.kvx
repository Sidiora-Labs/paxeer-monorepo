[finding.mobile-watch-write]
file = "apps/launchpad/mobile/src/runtime/service-client.ts"
line = 268
class = "interface-mismatch"
severity = "high"
observed = "MobileServices.watch sends an authenticated PUT with alertEnabled but no X-Kindle-Operation, X-Kindle-Operation-Signature or idempotency identity. SDK transport adds session/CSRF only. The live user GatewayHandler selects watchlist.update and calls OperationAuthorizer.AuthorizeRequest before the store mutation, so the request is denied."
expected = "The declared PUT /v1/me/watchlist/{poolAddress} must carry a wallet-signed operation bound to the current account/session, method, route, body and operation identity through the gateway to the user service."
proposal = "In apps/launchpad/mobile/src/runtime/service-client.ts and the owning SDK transport, wire the existing wallet authority to sign the exact watchlist operation and preserve its idempotency identity across an uncertain response. Prove a real authenticated mobile-to-gateway-to-user write and read-back."
owner_domain = 4
interface = "4.http-user-put-v1-me-watchlist-pool-address"

