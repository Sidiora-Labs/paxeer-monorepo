[finding.mobile-trade-unknown-recovery]
file = "apps/launchpad/mobile/src/runtime/lifecycle.ts"
line = 162
class = "restart-recovery"
severity = "medium"
observed = "executeExternalWallet persists a pending operation before handoff and marks it unknown when the wallet request times out or the process loses its response. If no transactionHash was recorded, ForegroundLifecycle.reconcile only leaves receiptReconciled false. Wallet callbacks carry requestId only; the trade flow has no verified hash/nonce recovery path, so this persisted state can block subsequent execution across restarts."
expected = "Requirement 21140.1 requires a real mobile recovery path. An uncertain wallet submission must remain safe while allowing authoritative reconciliation without discarding the pending operation or resubmitting a potentially executed trade."
proposal = "Add an explicit trade recovery journey in apps/launchpad/mobile/src/runtime/lifecycle.ts and its screens that recovers the wallet transaction identity and verifies account, chain, nonce and canonical receipt. Prove process death after wallet acceptance but before the response, followed by restart and reconciliation without a duplicate trade."
owner_domain = 4

