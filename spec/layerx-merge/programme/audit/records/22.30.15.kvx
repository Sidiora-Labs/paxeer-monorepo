[finding.listing-share-pointer]
file = "modules/spot/keeper/msg_server.go"
line = 129
class = "wiring-gap"
severity = "high"
observed = "MsgUpdateParams calls ListTokens and publishes a newly registered pool after RegisterToken writes its book, but neither path creates the share-denom metadata or ERC20 native pointer. CreateShareToken has a production caller only in opening activation. A later governance-listed pool appears in getRegisteredTokens while shareTokens returns zero and Deposit reaches MintShares/sharePointer and fails with TokenNotRegistered."
expected = "A governance-listed pool must be usable through the public vault. Registry 3.msg-spot-updateparams must lead to the share-token lifecycle consumed by 0x1025 deposits and withdrawals, with pointer balances and bank supply agreeing after restart."
proposal = "In modules/spot/keeper/msg_server.go and vault.go provision new-pool share metadata and its native pointer in the same cached governance transaction before publishing registration, and emit ShareTokenCreated. Reuse symbol/decimal validation from activation and shares.go. Prove listing, deposit, pointer balance/supply, withdrawal and restart without a manual CreateShareToken call."
owner_domain = 3
interface = "3.msg-spot-updateparams"

[finding.retained-token-decimals]
file = "modules/spot/keeper/vault.go"
line = 832
class = "runtime-risk"
severity = "high"
observed = "ListTokens skips every retained address without comparing physical metadata. MsgUpdateParams accepts a different Decimals value up to 36 without rereading tokenDecimals or reconciling the existing book/share pointer. For a funded six-decimal token changed to eighteen, fees.go Convert prices trades in eighteen-decimal units while the underlying token and existing shares still use six; public token-info views advertise the changed value."
expected = "Spot pricing, custody and share accounting must use the actual token units consistently. Routine governance parameter updates must not reinterpret funded balances or expose exchange rates that can exhaust the opposite pool."
proposal = "In modules/spot/keeper/vault.go reject changes to registered decimals and custody kind on retained addresses, and compare retained metadata with the existing book and actual token. Any supported metadata change needs an explicit liability-safe migration. Add a funded real-token governance regression checking quotes, swaps and share metadata remain in the original units."
owner_domain = 3
interface = "3.gen-spot-params-tokens-j26"

[finding.expiry-head-starvation]
file = "modules/spot/keeper/execute.go"
line = 169
class = "runtime-risk"
severity = "high"
observed = "restingExpiries takes the first MaxExpiriesPerBlock due index entries before checking FillBackoff. Failed refund transfers retain their expiry keys. If that leading window consists of persistently failing refunds, every later healthy expired order is excluded on every block, including blocks when all leading entries are in backoff; healthy users never receive automatic escrow refunds."
expected = "Bounded resting execution must progress for independent healthy orders when a different token or recipient cannot be refunded. Backoff must preserve work bounds without letting the same failing expiry window monopolize execution indefinitely."
proposal = "In modules/spot/keeper/execute.go and types/keys.go persist a fair expiry scan position or bounded retry schedule so failed entries do not always precede unexamined due entries. Preserve atomic refunds and the work budget. Prove a full leading window of failing refunds cannot starve a later healthy refund across repeated blocks and export/import."
owner_domain = 3
interface = "3.go-spot-keeper-executeresting-j64"

[finding.twap-genesis-logical-slots]
file = "modules/spot/types/genesis.go"
line = 392
class = "restart-recovery"
severity = "medium"
observed = "validatePools checks unique slots, ring bounds and sample count but not the slots implied by Head/Count or chronological times. Head 2, Count 2 and samples only at slots 7 and 8 pass these checks; keeper/twap.go reads slots 0 and 1 and fails after import. Out-of-order times also violate the binary-search assumption."
expected = "Accepted genesis TWAP history must be readable in logical chronological order immediately after recovery and preserve the live price window. Malformed imported state must be refused before becoming live state."
proposal = "In modules/spot/types/genesis.go require exactly the occupied logical slots derived from Head/Count, matching token/slot identities and nondecreasing times. Validate sample prices against the live producer domain. Add rejected sparse/out-of-order rings and a valid wrapped-ring export/import TWAP comparison."
owner_domain = 3
interface = "3.go-spot-keeper-initgenesis-j64"

[finding.aggregate-event-test-threshold]
file = "modules/pricefeed/module_test.go"
line = 116
class = "test-gap"
severity = "medium"
observed = "TestAppModule derives the required event attribute as len(operators)/2+1 for aggregate and skipped events. keeper/aggregate.go emits params.MinSources and separately requires strictly more than two thirds of bonded voting power. The fixture adds a validator to the application set, so the old majority-headcount expectation does not describe the producer."
expected = "Tests of pricefeed_aggregate and pricefeed_aggregate_skipped must assert the producer required attribute and distinguish configured minimum sources from the bonded-power quorum without weakening quorum assertions."
proposal = "In modules/pricefeed/module_test.go assert required from configured MinSources and prove success/refusal using explicit unequal-power validators at and above the two-thirds boundary. Keep event and state assertions and add a governed MinSources change demonstrating that source count and voting power are independent conditions."
owner_domain = 3
interface = "3.evt-pricefeed-pricefeed-aggregate"

[finding.listing-test-incomplete-lifecycle]
file = "modules/spot/keeper/msg_server_test.go"
line = 85
class = "test-gap"
severity = "medium"
observed = "TestUpdateParamsRegistersNewToken checks params, an empty book and registration logs but never deposits through the new pool or checks its share pointer. The wider precompiles/spot/listing_test.go path manually calls CreateShareToken after the proposal and before funding, adding state the governance producer does not create and hiding listing-share-pointer."
expected = "A new pool must be proven usable from the real governance registration output. A fixture must not add an unpublished share pointer between registration and public vault funding and claim that the registration-to-trade lifecycle works."
proposal = "Extend modules/spot/keeper/msg_server_test.go and precompiles/spot/listing_test.go to fund the production governance-created pool without manually provisioning its pointer. Assert ShareTokenCreated, live pointer code, deposit/withdrawal, pointer balances and supply, and recovery before claiming the full listing lifecycle."
owner_domain = 3
interface = "3.msg-spot-updateparams"

[finding.compose-app-service-absent]
file = "apps/perps/deploy/docker-compose.yml"
line = 21
class = "config-drift"
severity = "medium"
observed = "The production stack comments promise an app service on a private network, but the whole app definition including build inputs, runtime MARKET_PROXY_ORIGIN and container name is commented out. Only nginx is configured. The README instructs operators to start this stack, inspect hyperpax-app and proxy to app:3000, although this compose file cannot start that application."
expected = "The documented production deployment must start the frontend and supply its server proxy configuration. Operators need a consistent supported process model with reproducible health, upgrade and rollback commands."
proposal = "In apps/perps/deploy/docker-compose.yml and deploy/README.md implement the selected model: restore a complete app service with correct build context/runtime environment, or provision and document a host-managed app with matching nginx upstream. Align start, health and rollback commands and prove the running candle proxy receives MARKET_PROXY_ORIGIN."
owner_domain = 3

[finding.pm2-checkout-path]
file = "apps/perps/ecosystem.config.js"
line = 7
class = "config-drift"
severity = "medium"
observed = "PM2 fixes the frontend cwd to /root/Hyperpax-UI and resolves its Next.js entry point there. The monorepo app lives under apps/perps, while deploy/README.md uses a deployment-user checkout. Starting this configuration from either layout can target a nonexistent or stale unrelated application tree."
expected = "The process manager must start the app version selected by deployment. Relocating a checkout or deploying as a non-root user must not depend on a second hard-coded checkout."
proposal = "In apps/perps/ecosystem.config.js derive cwd from the configuration directory or an explicit validated deployment root, and resolve the Next.js entry point from the same app. Update apps/perps/deploy/README.md with the invocation and verify build identity and health from a deployment-user checkout."
owner_domain = 3

[finding.runtime-env-restart-instructions]
file = "apps/perps/deploy/README.md"
line = 238
class = "doc-drift"
severity = "medium"
observed = "The restart example runs docker compose --env-file .env.production restart and says this picks up server-only environment changes. Restart preserves a container existing environment; --env-file interpolation does not recreate it. The current compose file also comments out the app environment block."
expected = "Changing MARKET_PROXY_ORIGIN or MARKET_PROXY_HOST must update the actual frontend process environment. Operator instructions must distinguish container recreation from process restart and client-bundle rebuilds."
proposal = "Rewrite apps/perps/deploy/README.md lines 140 and 234-241 to recreate the configured app service with the changed environment, or provide the PM2 environment-update procedure for the chosen model. Include a proxy-origin health check and retain the separate rebuild requirement for NEXT_PUBLIC variables."
