[finding.mint-same-day-release-stalls]
file = "modules/mint/keeper/keeper.go"
line = 170
class = "runtime-risk"
severity = "high"
observed = "A valid schedule A starting and ending 2026-01-01 followed by B starting 2026-01-02 stalls after A is exhausted. GetNextScheduledTokenRelease selects A again because its start equals the stored minter end, and GetOrUpdateLatestMinter returns that exhausted minter because the start is unchanged. Every future epoch repeats this; the stored minter preserves the failure after restart."
expected = "The mint lifecycle must advance from every completed release to its successor, including equal start/end dates accepted by Params.Validate and ValidateMinter, and issue the approved remaining amount."
proposal = "In modules/mint/keeper/keeper.go exclude the completed release identity while preserving valid same-date successors. Add a real epoch/bank case that exhausts A, closes and reopens storage, then mints B exactly once without changing already minted supply."
owner_domain = 3
interface = "3.gen-mint-token-release-schedule-j26"

