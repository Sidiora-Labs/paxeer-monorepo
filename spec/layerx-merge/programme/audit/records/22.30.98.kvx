observed = "The translated overview at lines 14-20 describes signed Activity ingress, a separate LayerX execution network and periodic settlement on Paxeer, including the claim that an ordinary action needs no Paxeer transaction. The repository map at lines 98-104 also presents layerxd and guarantor/custody contracts as active components."
expected = "Brief facts 1-3 specify one Paxeer BFT network with integrated kernel, chain id 125, root node RPC and finality when the covering block commits; there is no separate running layerxd or checkpoint settlement network."
proposal = "Rewrite docs/site/docs/overview/i18n/fr.md to match the merged-network architecture and current directory map. Translate the same reviewed product facts across all seven locale overviews, remove the no-Paxeer-transaction claim and retired daemon/guarantor topology, and publish current root RPC endpoints."
owner_domain = 9

[finding.receipt-guide-old-finality]
file = "docs/site/docs/concepts/receipts.md"
line = 23
class = "doc-drift"
severity = "medium"
observed = "The receipt guide describes canonical activities at lines 7-10, guarantor certificates and settlement references at lines 23-26, then executed/batched/finalized and an L0-L4 ladder at lines 29-33. It directs consumers toward checkpoint settlement rather than committed block receipts."
expected = "The merged product uses submitted, receipted and committed rungs; committed finality comes from the single BFT chain, and pinned receipt keys establish Receipted without inventing a checkpoint settlement anchor."
proposal = "Rewrite docs/site/docs/concepts/receipts.md around transaction hashes, governed receipt key/height pins and BFT committed blocks. Document proof trust limits, how restart resolution queries the same transaction identity, and how existing receipt bytes remain immutable."
owner_domain = 9

[finding.lni-guide-retired-transport]
