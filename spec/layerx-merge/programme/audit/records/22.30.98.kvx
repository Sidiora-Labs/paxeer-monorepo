[finding.guarantor-evidence-reaches-committed]
file = "services/agent/crates/layerx-proof/src/checkpoint.rs"
line = 462
class = "interface-mismatch"
severity = "high"
observed = "verify_certificate and verify_declared_certificate accept guarantor signatures and supplied registration identifiers, then return Evidence::checkpoint. evidence.rs:66 calls Achieved::checkpoint_finalised; level.rs:38 creates CHECKPOINT_FINALISED, which layerx-types/src/verify.rs:89 maps to Rung::Committed. Neither path verifies a certified BFT header or commit. The public verifier therefore reports committed strength for a certificate that can precede any committed block."
expected = "Req.9310.1 removes this guarantor verifier and requires no layerx-proof evidence to reach Committed afterward. Brief network fact 1 makes commitment a property of the single BFT chain, not a separate guarantor settlement."
proposal = "In services/agent/crates/layerx-proof/src/checkpoint.rs retire both public certificate verifiers and their ThresholdReport evidence path, remove callers and registry retire rows, and keep proof output at Receipted until an independently authenticated certified-header verifier exists. Add a real guarantor-only success fixture asserting that it cannot yield Committed."
owner_domain = 9
interface = "9.rs-proof-checkpoint-verify-certificate"

[finding.checkpoint-evidence-constructor]
file = "services/agent/crates/layerx-proof/src/evidence.rs"
line = 57
class = "retired-reference"
severity = "medium"
observed = "Evidence::checkpoint retains checkpoint_id and optional settlement_reference and constructs CHECKPOINT_FINALISED evidence. Its comment denies settlement anchoring while the public rung() already maps this legacy level to Committed; this is the constructor used by the blocking certificate finding."
expected = "Req.9310 retires guarantor finality production; proof evidence must not acquire the merged-network Committed rung through historical checkpoint labels."
proposal = "Remove the checkpoint constructor and retired settlement-reference evidence in services/agent/crates/layerx-proof/src/evidence.rs with the certificate API retirement. Preserve receipt, inclusion and state evidence, and assert their maximum achieved rung."
owner_domain = 9
interface = "9.rs-proof-evidence-level-j70"

[finding.legacy-level-mints-commitment]
file = "services/agent/crates/layerx-proof/src/level.rs"
line = 38
class = "retired-reference"
severity = "medium"
observed = "Achieved::checkpoint_finalised remains callable from Evidence::checkpoint and achieved_rung delegates to the legacy VerificationLevel mapping. The private-constructor boundary therefore still allows a guarantor proof to mint Committed."
expected = "Req.9310.1 explicitly requires the proof crate to have no evidence path reaching Committed after removal of guarantor certificate verification."
proposal = "Remove checkpoint_finalised from services/agent/crates/layerx-proof/src/level.rs with the certificate path, then exhaustively test the remaining evidence constructors against Submitted and Receipted. Introduce any future committed constructor only beside a verified BFT commit."
owner_domain = 9

[finding.embedded-settlement-retained]
file = "services/agent/crates/layerx-proof/src/settlement.rs"
line = 11
