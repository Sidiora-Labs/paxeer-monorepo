line = 37
class = "doc-drift"
severity = "medium"
observed = "The LNI guide presents NodeInfo, Submit, GetBatchHeader, GetCheckpoint and FetchAvailability native socket methods as the supported node boundary, including guarantor signatures and settlement references. This is a retired separate LayerX interface."
expected = "Brief facts 1-3 require the integrated paxd node interface at root JSON-RPC, with supported node namespaces and a separately declared hosted px_ gateway contract rather than a native LayerX ingress."
proposal = "Replace docs/site/docs/agents/lni.md with the current node boundary: root endpoint discovery, EVM transaction submission, receipt/key queries, explicit tenant domain where applicable, typed errors and reconnection/resolution behavior. Remove native socket and guarantor-checkpoint instructions."
