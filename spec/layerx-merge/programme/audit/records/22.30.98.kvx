[finding.program-execution-fee-projection]
file = "services/agent/crates/layerx-crypto/src/disclosure/call.rs"
line = 631
class = "runtime-risk"
severity = "medium"
observed = "ConstructMethod::ProgramCall includes an ABI execution fee_limit, but fields() matches call with .. and discards that fee from the shared fields. Disclosure.fee_limit is instead gas_limit multiplied by max_fee_per_gas. A call with u128::MAX execution fee has a shared fee_limit of only 3000000 in the fixture, leaving common fee consumers without the second limit."
expected = "Program approval must distinguish and display the EVM gas cap and the native execution fee bound; byte rebinding prevents tampering but does not make an omitted monetary limit visible to a consumer."
proposal = "Add a separately named execution-fee bound to the program monetary disclosure in services/agent/crates/layerx-crypto/src/disclosure/call.rs, thread it through preparation/approval budgeting, and test a real encoded call with deliberately different gas and execution bounds. Keep both units and fee assets explicit."
owner_domain = 9

