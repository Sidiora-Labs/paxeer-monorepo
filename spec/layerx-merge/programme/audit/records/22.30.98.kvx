expected = "Brief facts 1-3 specify root node RPC on api1-api14.mainnet-beta.paxeer.network or api-mainnet-beta.paxeer.network, chain id 125 and committed-block finality, with no unified /rpc route."
proposal = "Rewrite docs/site/docs/agents/running.md examples and environment tables against the current daemon startup/read/send paths, root endpoints, chain 125, receipt-key trust and the three rungs. Give restart/unknown-transaction resolution steps using persisted txHash rather than checkpoint settlement tools."
