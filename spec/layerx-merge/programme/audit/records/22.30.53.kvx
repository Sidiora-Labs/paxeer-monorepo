[finding.flush-coordinator-shutdown]
file = "storage/db_engine/litt/util/error_monitor.go"
line = 94
class = "runtime-risk"
severity = "medium"
observed = "ErrorMonitor.Shutdown stores an error but never cancels its context, contrary to its signal comment. DiskTable.Close uses Shutdown for graceful draining, while the rate-limited flushCoordinator exits only on ImmediateShutdownRequired. A successful Close therefore leaves that coordinator waiting on its request channel."
expected = "Graceful table closure must drain accepted work and then terminate every background loop; the shutdown API must distinguish admission closure from final cancellation."
proposal = "In storage/db_engine/litt/util/error_monitor.go and disktable/flush_coordinator.go define separate drain and final-stop phases, cancel only after control-loop completion, and join the coordinator before Close returns; verify repeated open/close with flush batching enabled."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-util-error-monitor"

