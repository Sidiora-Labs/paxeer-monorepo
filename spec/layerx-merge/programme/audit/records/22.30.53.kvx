[finding.key-durability]
file = "storage/db_engine/litt/disktable/segment/key_file.go"
line = 241
class = "restart-recovery"
severity = "high"
observed = "keyFile.flush only calls bufio.Writer.Flush; createKeyFile retains no os.File and has no fsync setting. Segment.flush reports these key records durable and Seal persists metadata, while only value files are synced. A power loss can erase acknowledged keys, especially with the memory keymap or a rebuilt keymap."
expected = "Table.Flush and DB.Close guarantee crash durability, including the keys needed to recover values and secondary aliases from sealed segments."
proposal = "In storage/db_engine/litt/disktable/segment/key_file.go retain the file handle and the configured durability mode, sync key bytes before reporting flush completion or sealing metadata, and qualify recovery with durable keymap rebuild and power-loss fault coverage."
owner_domain = 5
interface = "5.fmt-litt-key-file-extension"

[finding.key-descriptor-lifecycle]
file = "storage/db_engine/litt/disktable/segment/key_file.go"
line = 254
class = "runtime-risk"
severity = "medium"
observed = "createKeyFile opens an os.File but stores only its buffered writer; seal drops that writer without closing the file. Every segment rotation leaves descriptor release to the Go finalizer rather than completing it during sealing."
expected = "Sealing and closing a table should deterministically release writable file descriptors, including in long-running nodes that continually rotate segments."
proposal = "In storage/db_engine/litt/disktable/segment/key_file.go retain and close the key file after a successful durable flush, and close it on constructor and seal error paths; verify repeated rotation keeps descriptor use bounded."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-disktable-segment-segment"

[finding.segment-capacity-rollover]
file = "storage/db_engine/litt/disktable/control_loop.go"
line = 491
class = "interface-mismatch"
severity = "high"
observed = "handleWriteRequest rotates only after Segment.Write succeeds and shardSize is greater than targetFileSize. Segment.Write rejects offset+valueLength above MaxUint32. With the default MaxUint32 target a shard can never exceed the target, so legal sustained writes eventually trigger ErrorMonitor.Panic instead of opening another segment."
expected = "Table.Put accepts legal values throughout the lifetime of a growing table; reaching the addressable limit of one shard must rotate storage without failing the database."
proposal = "In storage/db_engine/litt/disktable/control_loop.go preflight capacity for the selected shard and the whole primary/secondary group, seal and rotate before overflow, and retry the unchanged group once; exercise rollover near MaxUint32 without allocating a full shard."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-table"

[finding.push-destination-flag]
file = "storage/db_engine/litt/cli/push.go"
line = 37
class = "interface-mismatch"
severity = "high"
observed = "buildCLIParser registers the required StringSlice flag dst with alias d, but pushCommand reads StringSlice(\"dest\"). The documented --dst command therefore reaches no destinations provided before opening a transfer."
expected = "The registered push --dst value must arrive unchanged as the destination list consumed by pushCommand and pushTable."
proposal = "In storage/db_engine/litt/cli/push.go read the registered dst flag through a shared flag definition and add a real parser-to-command test that supplies --src, --dst and USER@HOST."
owner_domain = 5
interface = "5.cli-litt-push-flag-dst"

[finding.sync-destination-flag]
file = "storage/db_engine/litt/cli/sync.go"
line = 36
class = "interface-mismatch"
severity = "high"
observed = "syncCommand reads StringSlice(\"dest\"), whereas buildCLIParser registers only dst and d. Every invocation using the declared --dst spelling fails with no destinations provided."
expected = "The registered sync --dst paths must reach syncEngine.destinations and subsequently the remote transfer and pruning operations."
proposal = "In storage/db_engine/litt/cli/sync.go consume dst from the shared flag declaration and cover the registered command path with source and destination paths supplied by the parser."
owner_domain = 5
interface = "5.cli-litt-sync-flag-dst"

[finding.snapshot-reclaim-range]
file = "storage/db_engine/litt/cli/push.go"
line = 334
class = "restart-recovery"
severity = "high"
observed = "pushTable limits transfer to the published upper-bound.txt index, but passes the entire GatherSegmentFiles map to deleteLocalSegments, which releases every segment. A fully linked new segment observed before the publisher advances the upper bound is deleted although none of its files was transferred."
expected = "The snapshot consumer may reclaim only segments whose complete file set was acknowledged by the backup destination; unpublished segments remain owned by the publisher."
proposal = "In storage/db_engine/litt/cli/push.go build an explicit set of successfully transferred published segments, reclaim only that set, and advance the lower bound only through a contiguous acknowledged prefix; cover concurrent snapshot publication."
owner_domain = 5
interface = "5.fmt-litt-upper-bound-file-name"

[finding.initial-segment-recovery]
file = "storage/db_engine/litt/disktable/segment/segment_scanner.go"
line = 359
class = "restart-recovery"
severity = "high"
observed = "When the only metadata file belongs to damaged segment 0, GatherSegmentFiles decrements the uint32 highest index to MaxUint32 and increments the lowest to 1. It then attempts LoadSegment(1) and fails, rather than recovering the empty healthy set after an interrupted initial segment creation."
expected = "Restart after a crash while creating the first segment must either recover existing acknowledged data or initialize an empty table when no healthy segment was committed."
proposal = "In storage/db_engine/litt/disktable/segment/segment_scanner.go derive the range from surviving healthy indices before unsigned arithmetic, handle an empty survivor set explicitly, and add restart cases for each partially created segment-0 file set."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-disktable-segment-gather-segment-files"

[finding.cache-expiry-visibility]
file = "storage/db_engine/litt/dbcache/cached_table.go"
line = 138
class = "interface-mismatch"
severity = "high"
observed = "CacheAwareGet and Exists return from writeCache/readCache without checking the base table; RunGC only delegates. After disk GC removes an expired segment and its keymap entries, cached keys still return values and true, while KeyCount and iterators report them absent. An idle cache can preserve this disagreement indefinitely."
expected = "Table TTL and CacheAwareGet.exists describe one key set across cached reads, disk reads, aliases, iteration and restart, after garbage collection has removed a key."
proposal = "In storage/db_engine/litt/dbcache/cached_table.go connect cache liveness to segment/key removal or validate cached entries against authoritative liveness, including secondary aliases; test cached reads and Exists after forced GC and after restart."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-table"

[finding.stale-lock-takeover]
file = "storage/db_engine/litt/util/file_lock.go"
line = 95
class = "restart-recovery"
severity = "high"
observed = "Two contenders can both parse the same dead PID. After one removes the stale path and acquires a new lock, the other unconditionally removes that new path and acquires another lock. Release also unlinks by path without proving ownership. Two writers can consequently mutate the same table files."
expected = "Directory locks must exclude concurrent database and CLI writers through stale-lock recovery, acquisition, ownership changes and release."
proposal = "In storage/db_engine/litt/util/file_lock.go use an OS advisory lock on a stable inode with process-lifetime ownership, or an equivalently race-safe protocol; qualify concurrent stale takeover and ensure release cannot remove a successor lock."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-util-new-file-lock"

[finding.sync-period-bounds]
file = "storage/db_engine/litt/cli/sync.go"
line = 61
class = "runtime-risk"
severity = "medium"
observed = "sync declares period as Uint64Flag but retrieves it through ctx.Int64. The pinned CLI library parses ordinary values such as 300 successfully, while values beyond MaxInt64 decode to zero. Zero is also accepted explicitly, and seconds-to-duration multiplication is unchecked; syncLoop passes the result directly to time.NewTicker, which panics for nonpositive durations."
expected = "The unsigned period flag must be bounded to positive seconds representable as time.Duration before any background ticker is started."
proposal = "In storage/db_engine/litt/cli/sync.go read the unsigned value and reject zero or values above MaxInt64/time.Second before conversion; qualify the real parser with the default 300, zero, overflow and a valid nondefault period."
owner_domain = 5
interface = "5.cli-litt-sync-flag-period"

[finding.remote-prune-sources]
file = "storage/db_engine/litt/cli/sync.go"
line = 228
class = "interface-mismatch"
severity = "high"
observed = "sync builds the remote command as litt prune --max-age N without any --src values. The prune parser marks src required and pruneCommand rejects an empty source list, so configured remote retention never operates on the destination directories."
expected = "sync --max-age must invoke the declared prune command with the remote backup directories as its required source paths."
proposal = "In storage/db_engine/litt/cli/sync.go pass every sync destination as a safely quoted remote prune --src argument, preserve the configured age, and qualify the actual remote parser with more than one destination."
owner_domain = 5
interface = "5.cli-litt-prune-flag-src"

[finding.prune-unpublished-orphans]
file = "storage/db_engine/litt/cli/prune.go"
line = 104
class = "runtime-risk"
severity = "medium"
observed = "pruneTable calls GatherSegmentFiles with cleanOrphans=true before loading the snapshot upper bound. The live snapshot publisher creates metadata, key and value links sequentially, so pruning can remove links of an in-progress unpublished segment before it applies the publication boundary."
expected = "Offline pruning of a rolling snapshot must respect the live publisher ownership boundary before performing any destructive discovery or orphan cleanup."
proposal = "In storage/db_engine/litt/cli/prune.go discover snapshot boundaries without mutation, limit loading and cleanup to the published set, and leave newer partial links to the publisher; qualify publication interleavings for every link type."
owner_domain = 5
interface = "5.fmt-litt-upper-bound-file-name"

[finding.push-connection-close]
file = "storage/db_engine/litt/cli/push.go"
line = 119
class = "runtime-risk"
severity = "medium"
observed = "push creates an SSHSession and returns through success and error paths without calling connection.Close. sync calls push repeatedly, accumulating SSH connections and associated server resources across backup intervals."
expected = "Each backup attempt must release its SSH connection after all transfer workers finish, including when listing or transferring a table fails."
proposal = "In storage/db_engine/litt/cli/push.go defer SSHSession.Close immediately after successful creation, wait for transfer workers on all exits, and verify repeated sync attempts leave no live sessions."
owner_domain = 5
interface = "5.go-storage-db-engine-litt-util-new-ssh-session"

[finding.backup-durable-ack]
file = "storage/db_engine/litt/util/ssh.go"
line = 179
class = "restart-recovery"
severity = "high"
observed = "Rsync executes rsync -z and treats process success as completion without requesting receiver fsync or a durable destination acknowledgment. pushTable immediately deletes transferred snapshot symlinks and hard links. If live TTL GC has removed the original, a receiver power loss can erase the only remaining copy after a successful backup."
expected = "Reclaiming the local incremental backup must follow durable acceptance of the complete segment on the destination, so acknowledged backup data survives restart and power loss."
proposal = "In storage/db_engine/litt/util/ssh.go and cli/push.go establish a durable remote segment commit that syncs received files and directory entries before acknowledging reclamation; retain local snapshot files until that acknowledgment and qualify receiver-crash recovery."
