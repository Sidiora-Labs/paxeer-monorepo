[finding.export-handoff]
file = "services/human/crates/layerx-human-service/src/security.rs"
line = 574
class = "restart-recovery"
severity = "high"
observed = "KeyExportCeremony::finish calls export_primary_once before AuditChain::open/append and before constructing or returning ExportedKey. custody/mod.rs:875-912 atomically marks the identity self_custodied; production_components.rs:5040-5069 emits the secret only after finish succeeds. An audit error or process loss after the marker makes retry return SelfCustodied and disables service signing without delivering the key."
expected = "The one-time primary-key export must leave an authenticated recoverable handoff after a restart or audit/storage failure; custody must not be irreversibly disabled while the owner has no recoverable key delivery."
proposal = "Coordinate services/human/crates/layerx-human-service/src/security.rs and src/custody/mod.rs around a durable export handoff with principal-bound retry identity, audited state and explicit delivery acknowledgement. Preserve one-time authorization and service-signing refusal; exercise real keystore/store reopening and failure between marker, audit and response."
owner_domain = 10
interface = "10.rs-human-service-custody-keystore-export-primary-once"

[finding.export-challenge-wire]
file = "services/human/crates/layerx-human-service/src/security.rs"
line = 477
class = "interface-mismatch"
severity = "high"
observed = "KeyExportChallenge stores expires_at as u64 and production_components.rs:5030-5032 copies it directly into JSON as a number. identity.kvx:445 declares Timestamp, v1.kvx:50-52 requires an RFC3339 UTC string, and apps/web/src/api/generated/index.ts:2758-2764 calls expectString, so securityKeyExportBegin rejects the real successful response. That projection also emits base64url confirms while IdentityProjector and OperationDigest::to_schema use lowercase hex."
expected = "Registry row 10.fmt-human-api-type-key-export-challenge must round-trip from KeyExportCeremony through the production handler into the generated browser client with the declared Timestamp and one operation-digest encoding."
proposal = "Project the challenge in services/human/crates/layerx-human-service/src/server/production_components.rs using the shared timestamp and digest codecs; align step-up readers on that same encoding. Extend tests/key_export.rs through the authenticated production HTTP/component path and generated client decoder, including expiry and wrong-digest refusals."
owner_domain = 10
interface = "10.fmt-human-api-type-key-export-challenge"

[finding.frame-registry]
file = "services/human/crates/layerx-human-service/src/frame.rs"
line = 119
class = "doc-drift"
severity = "medium"
observed = "The implementation declares pub trait FrameTransport and read_frame/write_frame take maximum: usize. Registry rows 10.rs-human-service-frame-frame-transport-j45, 10.rs-human-service-frame-read-frame-j45 and 10.rs-human-service-frame-write-frame-j45 advertise an enum and &Limits parameters; live call sites use the actual trait and byte maximum."
expected = "The interface registry must describe the transport declaration and parameter types that its producers and consumers actually compile against."
proposal = "Update the three frame rows in spec/layerx-merge/interfaces.kvx from the declarations in services/human/crates/layerx-human-service/src/frame.rs, including current line anchors and real callers; retain the existing frame bounds and error behavior."
owner_domain = 10

[finding.support-unbounded-list]
file = "services/human/crates/layerx-human-service/src/support.rs"
line = 336
class = "runtime-risk"
severity = "medium"
observed = "Support::list loads and deserializes every principal Support conversation, sorts the complete collection, then truncates to MAX_CONVERSATIONS=100. create admits arbitrarily many distinct idempotency keys, so the output bound does not bound memory, disk growth or list work."
expected = "Authenticated support history must have bounded per-request work and an explicit retained-history/admission policy without losing retry identity."
proposal = "Add persisted pagination or a bounded recent-conversation index in services/human/crates/layerx-human-service/src/support.rs with an explicit retention/admission policy and durable retry tombstones; verify more than 100 conversations and reopening without scanning full message bodies."
owner_domain = 10

[finding.support-reply-replay]
file = "services/human/crates/layerx-human-service/src/support.rs"
line = 566
class = "restart-recovery"
severity = "medium"
observed = "append returns ConversationResolved for Author::You before looking up the deterministic message_id. A successful reply whose acknowledgement is lost cannot be retried after support resolves the conversation, even though the exact message and body remain durable."
expected = "A retry of an already accepted reply must converge to the recorded conversation independently of subsequent state transitions; only a new reply should be refused after resolution."
proposal = "In services/human/crates/layerx-human-service/src/support.rs resolve exact existing message identity and body before applying the resolved-state restriction to new messages. Cover reply, resolve, reopen and identical retry, and retain Conflict for changed content under the same key."
owner_domain = 10

