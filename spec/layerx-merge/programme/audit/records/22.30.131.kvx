[finding.directory-read-partial]
file = "apps/explorer/toolkit/components/forms/inputs/file/utils.ts"
line = 56
class = "runtime-risk"
severity = "medium"
observed = "readEntriesPromise catches directory read errors and returns undefined. readAllDirectoryEntries treats that as end-of-directory, so the drop can silently submit only an earlier subset of the selected directory tree."
expected = "A directory upload must either include all selected files or report which reads failed; a permission or I/O failure cannot be interpreted as a successful empty directory."
proposal = "Propagate typed read errors from file/utils.ts and have DragAndDropArea show an explicit incomplete-selection refusal or user-approved retry, preserving prior files; cover failure after the first directory page."
owner_domain = 14

[finding.chart-csv-date-alignment]
file = "apps/explorer/toolkit/components/charts/parts/ChartMenu.tsx"
line = 112
class = "runtime-risk"
severity = "medium"
observed = "CSV export iterates charts[0].items and reads chart.items[index].value for every other series. TimeChartData permits independently sized/date-indexed series, so missing points can throw and differently sampled dates can be exported under the wrong date."
expected = "Exported explorer statistics must align values by date and represent missing points explicitly, matching the date-aware display and tooltip instead of implying unrelated observations share a timestamp."
proposal = "Join all series by timestamp/date range in ChartMenu.tsx, use a documented empty value for missing points and preserve units/labels; cover unequal lengths and different sampling dates in a CSV export proof."
