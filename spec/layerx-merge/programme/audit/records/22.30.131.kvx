[finding.file-entry-error-pending]
file = "apps/explorer/toolkit/components/forms/inputs/file/utils.ts"
line = 60
class = "runtime-risk"
severity = "medium"
observed = "convertFileEntryToFile creates a Promise with resolve only and supplies no error callback to entry.file. If an entry becomes unreadable or disappears, the Promise never settles and DragAndDropArea awaits Promise.all forever."
expected = "An unreadable dropped file must produce a bounded, actionable error and release the upload interaction instead of leaving a permanent pending operation."
proposal = "Reject on the FileSystemFileEntry.file error callback in inputs/file/utils.ts and handle it explicitly in DragAndDropArea.tsx, restoring drag state and showing the affected path; cover a file removed or denied after enumeration."
