[finding.async-select-race]
file = "apps/explorer/toolkit/chakra/select.tsx"
line = 309
class = "runtime-risk"
severity = "medium"
observed = "SelectAsync applies every loadOptions promise with then(setCollection), without cancellation, generation checks or rejection handling. A slow response for an old query can replace a newer result collection and a rejected load becomes an unhandled promise."
expected = "Async explorer filters must display options for the current query/value and expose recoverable load failure without accepting a stale response after a newer request or unmount."
proposal = "Add request sequencing/cancellation and an explicit error/loading lifecycle to SelectAsync in chakra/select.tsx, retaining current options while appropriate; cover reversed response order, rejection and unmount."
owner_domain = 14

[finding.async-select-controlled-value]
file = "apps/explorer/toolkit/chakra/select.tsx"
line = 304
class = "wiring-gap"
severity = "medium"
observed = "SelectAsync keeps a private value=[] for loadOptions but passes a controlled props.value through rest to SelectRoot. A parent-provided default value or later form reset changes the selected value without changing the value sent to the option loader."
expected = "The async option producer must receive the current controlled selection, including form initialization and reset, so selected labels remain resolvable and the visible collection agrees with form state."
proposal = "Use props.value when controlled and internal state only when uncontrolled in chakra/select.tsx; pass that same effective selection to loadOptions and SelectRoot, and cover a preset value plus a later form reset."
owner_domain = 14

