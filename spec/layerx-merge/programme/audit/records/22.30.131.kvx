line = 42
class = "interface-mismatch"
severity = "high"
observed = "cardInputError passes vaultState.outstanding into amountLimitError for Solana withdrawals. useVaultState disables all reads without an EVM vault/viemChain and returns outstanding=0, so limits.ts:23 rejects every positive SOL or SID withdrawal even when the configured program and recipient PDA are valid."
expected = "A configured Solana route must admit a valid withdrawal using Solana custody and Paxeer pair limits, with the same safety checks as the actual destination producer instead of a permanently zero EVM-only state."
proposal = "Give card-state.ts and use-bridge-state.ts a route-specific custody state sourced from the deployed Solana program; preserve outstanding and cap bounds using that authoritative state and prove a positive registered-recipient withdrawal through the actual card."
owner_domain = 14
