[finding.withdrawal-vault]
file = "apps/bridge/src/lib/bridge/submitted.ts"
line = 43
class = "interface-mismatch"
severity = "high"
observed = "withdrawalRecord emits no vault; BridgeCard persists that row at bridge-card.tsx:229-232, enrichRecord adds only the burn nonce, and buildVerifiedRelease at transfer-actions.ts:262 refuses the resulting row. releaseCheckOf also cannot observe its release. Reimport keeps the existing row at import-transfer.tsx:27."
expected = "A submitted EVM withdrawal must survive storage and reload and reach verified release and nullifier observation. Requirement 14492.2 explicitly omits the vault, conflicting with these actual release consumers."
proposal = "Resolve the 14492.2 contract conflict in domain 14: derive the authoritative registered vault for release or persist a verified vault in submitted.ts; migrate existing rows and prove submission, reload, nonce enrichment and successful verified release without adding fields in a fixture."
owner_domain = 14
interface = "14.ts-bridge-lib-bridge-submitted-withdrawalrecord-j55"

[finding.settlement-broadcast]
file = "apps/bridge/src/lib/bridge/settlement.ts"
line = 9
class = "restart-recovery"
severity = "high"
observed = "phaseOf returns settled for any claimTxHash or releaseTxHash. transfers-panel.tsx:197-211 writes those hashes and completion timestamps when the wallet broadcasts, then lines 159-173 disable chain checks. A dropped, replaced or reverted settlement stays completed after reload and settledRefusal blocks another attempt."
expected = "Settlement completion must mean a successful committed claim or release, confirmed by receipt and nullifier state; pending broadcast is recoverable and cannot permanently suppress status checks or retry."
proposal = "In settlement.ts and transfers-panel.tsx persist broadcast as a pending attempt, observe receipts and authoritative nullifiers through reload, and reconcile replacement, revert and dropped transactions before setting completion timestamps; retain an explicit retry action."
owner_domain = 14
interface = "14.ts-bridge-lib-bridge-settlement-phaseof-j55"

