[finding.agent-request-version]
file = "sdk/platform/dotnet/Transport.cs"
line = 313
class = "interface-mismatch"
severity = "high"
interface = "8.go-sdkcs-internal-enveloperequest-803"
observed = "AgentEnvelopeTransport.EnvelopeVersion is 2 and EnvelopeRequest serializes it. The real producer boundary services/agent/crates/layerx-agentd/src/agent_rpc.rs:22,224 accepts exactly 1 and returns envelope.version before dispatch."
expected = "Decision 2198 and record.AgentHttpEnvelope in services/agent/schema/agent-api/v1.kvx require transport version 1 independently of contract major 2; registry row 8.go-sdkcs-internal-enveloperequest-803 also names version 1."
proposal = "In sdk/platform/dotnet/Transport.cs encode the daemon's transport version 1; prove a catalogue request reaches the real daemon through the gateway with a valid session and idempotency key."
owner_domain = 8

[finding.agent-response-envelope]
file = "sdk/platform/dotnet/Transport.cs"
line = 477
class = "interface-mismatch"
severity = "high"
interface = "8.go-sdkcs-agentenvelopetransport-sendenvelopeasync"
observed = "DecodeResponse requires a numeric version equal to 2 and includes version in both exact-field sets. agent_rpc.rs success_body and error_body emit the schema's unversioned success and error objects, so valid daemon replies are always refused."
expected = "Decision 2198 and AgentHttpSuccess/AgentHttpError require response validation by request_id, value, verification_status or error fields, with no response version field."
proposal = "Align .NET DecodeResponse with the producer's exact success and error field sets and use daemon-emitted response bytes over the real HTTP path for success and typed refusal tests."
owner_domain = 8

[finding.agent-verification-shapes]
file = "sdk/platform/dotnet/Transport.cs"
line = 502
class = "interface-mismatch"
severity = "high"
interface = "8.go-sdkcs-agentenveloperesult"
observed = "ValidVerification accepts achieved with level and the old Unverified/SequencerSigned/BatchIncluded/StateProven/CheckpointFinalised/SettlementAnchored ordering; it has no pending or absent arms. agent_rpc.rs:576 emits achieved with rung and the schema's chain rungs."
expected = "record.VerificationStatus declares achieved,rung; unverified with requested/achieved/reason; pending with requested/achieved; and absent with requested, using submitted, receipted, committed with strict lower-rung checks."
proposal = "Decode all four live verification states in Transport.cs using the chain rung ordering; round-trip daemon goldens and refuse unknown fields or pending states that meet or exceed the requested rung."
owner_domain = 8

[finding.agent-bootstrap-credential]
file = "sdk/platform/dotnet/Transport.cs"
line = 319
class = "interface-mismatch"
severity = "high"
interface = "8.go-sdkcs-agentenvelopetransport-sendenvelopeasync"
observed = "BootstrapOperations contains agent.register and session.open, and EnvelopeRequest writes credential:null for them even when a credential was supplied. The daemon's BOOTSTRAP_OPERATIONS is empty and its decode requires a session credential for both."
expected = "AgentHttpEnvelope.credential and decision 1844 require the owner session credential for every catalogue operation, including registration and session preparation."
proposal = "Remove the bootstrap credential bypass from the .NET envelope transport and exercise both operations with the actual owner-session authorization path and missing-session refusals."
owner_domain = 8

[finding.agent-envelope-tests]
file = "sdk/platform/dotnet/tests/LayerX.Sdk.Tests/AgentEnvelopeMajor2Tests.cs"
line = 15
class = "test-gap"
severity = "medium"
observed = "AgentEnvelopeEncodesVersionTwo demands 2, and AgentEnvelopeRefusesVersionOneResponse builds versioned replies with achieved,level:SequencerSigned. These tests preserve the incompatible transport and never consume the daemon's envelope."
expected = "The current daemon serves request envelope version 1 and unversioned replies with chain-rung verification; schema major 2 does not change the HTTP envelope version."
proposal = "Replace the invented envelope fixtures with the daemon's request and response goldens and prove the version-1 request, unversioned refusal and four verification states through the live transport."
owner_domain = 8

[finding.agent-probe-registration-gap]
file = "sdk/platform/dotnet/tests/LayerX.Sdk.Tests/AgentOperationEnvelopeTests.cs"
line = 158
class = "test-gap"
severity = "medium"
observed = "ProcessCasesReachTheDaemonThroughTheGateway covers only read.account, program.interface and approval.list; no positive registration or session.open path reaches the producer, leaving the SDK's credential:null bootstrap defect unexercised."
expected = "Brief check 7 requires tests along the real producer, transport and consumer path for exposed interfaces, including the actual owner-session binding."
proposal = "Extend the real daemon/gateway probe with owner-authorized agent.register and session.open and assert their returned preparation results plus refusal without the owner session."
owner_domain = 8

[finding.programs-legacy-constructor]
file = "sdk/platform/dotnet/Programs.cs"
line = 228
class = "wiring-gap"
severity = "medium"
observed = "The public ProgramsClient(PlatformClient, sequencerPublicKey, ...) constructor discards client and never initializes _rpc. All public discovery, receipt and submission methods now access Rpc and fail UnavailableCapability for every instance built this way."
expected = "A public client constructor must establish the transport used by its advertised operations or clearly expose an intentional retired-capability refusal; tests currently promise successful reads from this constructor."
proposal = "Resolve the public migration in Programs.cs: retire and document the obsolete constructor or connect an explicitly supplied native Programs transport, then exercise every supported constructor through its real backend."
owner_domain = 8

[finding.programs-contract-tests-stale]
file = "sdk/platform/dotnet/tests/LayerX.Sdk.Tests/ProgramsContractTests.cs"
line = 26
class = "test-gap"
severity = "medium"
observed = "PendingReceiptMayOmitRetainedBytesButMustBindExpectedActivity and DiscoveryClientReturnsBoundedTypedResponseWithHonestVerificationLevel create response values but never supply them to a producer, then expect success from an obsolete constructor whose Rpc always refuses. Line 162 also expects kernel signed_activity_hex to bind as an EIP-1559 transaction."
expected = "Programs reads and lifecycle submissions must be tested through native EVM JSON-RPC and real signed transactions; fixtures for retired kernel activity envelopes cannot stand in for those outputs."
proposal = "Port these scenarios to a real native Programs producer and transaction signer, retaining expected-activity, fee, discovery and refusal assertions; remove reliance on unreachable private legacy validation paths."
owner_domain = 8

[finding.programs-legacy-validation]
file = "sdk/platform/dotnet/Programs.cs"
line = 360
class = "dead-code"
severity = "low"
observed = "VerifyDiscovery, VerifyTerminal, DecodeSignedCall, UnknownSubmission and the old signed-Activity encoders remain private after the public methods switched to Rpc. Reflection tests reach several of them but the running client does not."
expected = "The merged client uses native Programs precompile calls, EIP-1559 transactions and sequencer receipts; maintained validation should protect an actual supported execution path."
proposal = "In Programs.cs retire the unused kernel discovery/terminal/activity implementation after preserving any shared codec utility required by real consumers, and move scenario coverage to the supported public native path."
owner_domain = 8

[finding.program-deployment-limit]
file = "sdk/platform/dotnet/NativeProgramLifecycle.cs"
line = 208
class = "config-drift"
severity = "medium"
observed = "LifecycleWire.Code accepts wasm.Length up to 1048576; NativeProgramDeploy adds 104 bytes or 108 plus interface bytes, so SDK construction accepts deployment payloads larger than the host's LXP_MAX_PAYLOAD_BYTES=524288."
