[finding.fuel_guest_build_profile]
file = "programs/crates/layerx-programs-ai-market/tests/fuel_budget.rs"
line = 574
class = "config-drift"
severity = "medium"
observed = "guest_module invokes cargo build --release without selecting opt-level z; programs/Cargo.toml sets profile.release.opt-level to 3 and programs/.cargo/config.toml supplies only target-feature/linker flags. It then measures that artifact. The helper therefore does not reproduce the size-optimized guest required by decision 2483. Its line-67 Makefile-default comment also names the old text chain domain while Makefile now uses a chain-derived hex domain."
expected = "The artifact used to qualify guest fuel must use the release opt-level z deployment configuration and an explicitly identified build-time chain domain. Deployment readiness must account for the 524288-byte payload ceiling including its 104-byte envelope; this audit has not measured an oversized artifact."
proposal = "In programs/crates/layerx-programs-ai-market/tests/fuel_budget.rs, select the same explicit opt-level z build configuration as the production AI-market artifact, identify its test versus deployment chain domain accurately, and check wasm length plus the 104-byte deployment envelope against 524288 before validating and executing the guest. Align the owning programs/Cargo.toml and Makefile release recipe in a Programs repair task."
owner_domain = 13

