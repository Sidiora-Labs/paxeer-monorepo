[finding.fuel_selector_coverage]
file = "programs/crates/layerx-programs-ai-market/tests/fuel_budget.rs"
line = 93
class = "test-gap"
severity = "medium"
observed = "ROUTED fixes coverage to 31 operations and every_routed_operation_fits_the_protocol_cpu_fuel_cap only checks that list at lines 1639-1644. dispatch::transition_inner also routes 0x010A/0x010B, F05 aggregation, F06 rewards, F07 history, F08 admission and 0x0A01/0x0A02 reads; prerequisites described as unrouted in lines 7-8 now have routed producers."
expected = "Every operation claimed by the fuel test must execute through the deployed ABI-5 guest within DEFAULT_CPU_FUEL; selector additions must cause missing coverage to fail rather than silently escape the inventory."
proposal = "Extend programs/crates/layerx-programs-ai-market/tests/fuel_budget.rs to all 55 dispatch selectors, including close/refund/claim, aggregation, history, admission and reads. Compare the covered set with dispatch metadata and exercise maximum bounded states with real required value-transfer authority."
owner_domain = 13

[finding.close_settlement_coverage]
file = "programs/crates/layerx-programs-ai-market/tests/market_protocol_boundary.rs"
line = 974
class = "test-gap"
severity = "medium"
observed = "World::close invokes closure::apply directly and commits returned state; a07_close_refunds_free_once_and_waits_for_live_claims checks RewardEffect and ledger counters. The actual dispatch::close additionally invokes value_adapter::settle in wasm, so this correct journal does not establish that the refund reaches its fixed recipient exactly once."
expected = "The close/refund lifecycle must preserve balances and retained receipts across the real guest, value adapter, transfer host and durable restart, including uncertain delivery and already-applied retries."
proposal = "Extend programs/crates/layerx-programs-ai-market/tests/market_protocol_boundary.rs with a compiled ABI-5 CREATE/fund/request-close/advance-close/claim/expiry journey using the real transfer host. Persist and restore its ledger/state, then assert recipient balances, conservation and no additional transfer on exact retries."
owner_domain = 13

[finding.trace_refusal_atomicity]
file = "programs/crates/layerx-programs-runtime/src/commit.rs"
line = 359
class = "runtime-risk"
severity = "medium"
observed = "ExecutionTrace::record_commitment increments total_commitment_fuel and total_state_bytes before testing MAX_TRACE_STATE_BYTES at line 367. TraceByteLimit returns without pushing the commitment, leaving a retained trace with totals that include a refused record; canonical_bytes still serializes those totals."
expected = "A refused trace append must leave the public trace usable with its prior ordered commitments and accounting unchanged, so subsequent receipt encoding and retry observe the same bounded state."
proposal = "In programs/crates/layerx-programs-runtime/src/commit.rs, calculate prospective totals and check all limits before changing any field, as record_arbitration_step already does. Add a boundary refusal test comparing canonical bytes, totals and commitments before/after and verifying a subsequent admissible append."
owner_domain = 13
interface = "13.rs-rt-commit-executiontrace-record"

[finding.sandbox_rollback_error]
file = "src/modules/programs/sandbox.c"
line = 435
class = "runtime-risk"
severity = "medium"
observed = "The ordinary guest-error branch discards lxp_module_savepoint_discard status. That helper can return LXP_FATAL_INVARIANT or an arena-reset error and leave the savepoint active. The success-only active-savepoint guard at lines 452-453 does not propagate rollback failure when the original ordinary error is returned without published usage."
expected = "A failed rollback must preserve fatal/error classification for enclosing kernel execution; callers must not treat a context whose state could not be restored as an ordinary recoverable guest refusal."
proposal = "In src/modules/programs/sandbox.c, propagate the discard result, retaining fatal rollback failure over the original guest refusal and preventing ordinary receipt completion. Extend tests/codec/lxp_test_sandbox_lifecycle.c with real savepoint-invariant failure conditions and verify fatal return and absence of committed guest effects."
owner_domain = 1

[finding.programs_site_abi]
file = "docs/site/docs/programs/index.md"
line = 307
class = "doc-drift"
severity = "medium"
observed = "The page says Rust admits only ABI 1 and 2 and C CALL caps guest ABI at 2; its frozen ABI inventory also stops at 2. programs/abi-frozen.sha256 pins versions 1 through 5, runtime policy accepts V5, sandbox lifecycle tests exercise ABI 3 and market_tests executes a compiled ABI-5 guest."
