[finding.34]
file = "sdk/launchpad/packages/sdk/src/transport.ts"
line = 151
class = "runtime-risk"
severity = "medium"
observed = "requestValue reads successful JSON with result.text() and error envelopes with result.clone().json() before schema validation, with no byte bound. The deadline limits elapsed time but does not bound bytes allocated; cloning an error response can also retain a second unread body branch."
expected = "The transport must bound memory consumption before parsing untrusted success and error responses, preserve its existing deadline and cancellation behavior, and release every body branch on refusal or retry."
proposal = "Implement endpoint-appropriate bounded body readers in sdk/launchpad/packages/sdk/src/transport.ts, cancel unused streams and parse the bounded error body once. Prove oversized success/error responses fail without buffering the entire body and retain current stable error codes and retry limits."
owner_domain = 4

