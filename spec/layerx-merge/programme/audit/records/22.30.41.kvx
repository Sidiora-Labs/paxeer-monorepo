proposal = "Extend sdk/launchpad/packages/sidiora-launchpad-v3/test/provenance.test.mjs to validate contained source paths, source digests and license markers, and compare every named exported ABI to its authoritative artifact ABI after the provenance repair. Preserve artifact containment and digest assertions."
owner_domain = 4

[finding.29]
file = "sdk/launchpad/packages/sidiora-launchpad-v3/test/abi-conformance.test.mjs"
line = 13
class = "test-gap"
severity = "medium"
observed = "abiIdentities compares only entry type, name and input types. It ignores function output types, event indexed flags and stateMutability, so the five-role conformance proof can accept different return decoding or log topic/data layouts. The separate ERC20 deep-equality test does not cover all other role ABIs."
expected = "Requirement 4522.1 requires one ABI truth across role, package and web consumers, including response encodings and event layouts as well as call selectors."
proposal = "In sdk/launchpad/packages/sidiora-launchpad-v3/test/abi-conformance.test.mjs, compare canonical complete wire-relevant ABI entries for all roles, including tuple components, outputs, indexed flags, anonymous and stateMutability. Retain the existing role/web comparisons and explicit selector coverage."
owner_domain = 4

[finding.30]
file = "sdk/launchpad/packages/indexer-sdk/src/index.ts"
line = 41
class = "runtime-risk"
severity = "medium"
observed = "HttpClient.get forwards only an optional caller AbortSignal to fetch and buffers JSON or error text without a byte cap. With the default options, a stalled service can hold a request indefinitely and an oversized response can allocate memory before any DTO validation."
expected = "The brief requires bounded runtime work: a client request must have a default deadline and bounded success/error body consumption even when the application omits its optional signal."
proposal = "Add a configurable bounded default deadline, combined caller cancellation and endpoint-appropriate streamed response byte caps in sdk/launchpad/packages/indexer-sdk/src/index.ts. Preserve typed errors and existing shape checks, and prove stalled headers/body, oversize refusal and listener cleanup through HTTP."
owner_domain = 4

