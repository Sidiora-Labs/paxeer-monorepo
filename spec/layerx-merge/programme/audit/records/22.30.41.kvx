[finding.1]
file = "sdk/launchpad/packages/candles-sdk/src/index.ts"
line = 118
class = "interface-mismatch"
severity = "high"
observed = "parseHistory rejects more than 2000 bars and getHistory rejects countback above 2000, while the declared Go /history vendor handler admits and emits up to MaxHistoryBars=5000. A valid vendor page selected with from/to can therefore fail in the SDK. The separate 2000-bar canonical endpoint does not establish the vendor bound."
expected = "Registry rows 4.ts-candles-sdk-parse-history, 4.ts-candles-sdk-get-history and 4.http-trading-charts-get-history-history must agree on the admitted page size; the Go history contract test deliberately distinguishes vendor 5000 from canonical 2000."
proposal = "In sdk/launchpad/packages/candles-sdk/src/index.ts, bind the vendor client to the declared vendor limit and preserve the separate canonical limit. Add a producer-to-SDK proof using the Go handler with 2001 and 5000 bars and explicit out-of-bound refusals."
owner_domain = 4
interface = "4.ts-candles-sdk-parse-history"

[finding.2]
file = "sdk/launchpad/packages/candles-sdk/src/index.ts"
line = 5
class = "interface-mismatch"
severity = "high"
observed = "HistoryRequest has no cursor field, HistoryBars has no nextCursor field, and parseHistory reconstructs only s/t/o/h/l/c/v. Go writeHistoryPage emits nextCursor for a truncated bounded page and the handler accepts cursor, so callers lose the continuation needed to retrieve the remaining history."
expected = "The declared /history transport must preserve the producer pagination token and provide a way to send it back, so a history range can be retrieved completely without inventing an offset or silently treating the first page as the whole range."
proposal = "Extend the request and response contract in sdk/launchpad/packages/candles-sdk/src/index.ts with the Go opaque cursor and validated nextCursor. Prove a multi-page Go history response can be consumed and resumed through the exported client with no missing or duplicate bars."
owner_domain = 4
interface = "4.http-trading-charts-get-history-history"

[finding.3]
file = "sdk/launchpad/packages/candles-sdk/test/client.test.mjs"
line = 34
class = "test-gap"
severity = "medium"
observed = "The loopback handler returns hand-written symbol and bar fixtures for SID and SID & USDL. The test labels these current Go wire shapes but never calls the Go handler, whose symbol parser requires a 20-byte pool address; the small two-bar fixture also hides the vendor bound and continuation disagreement."
expected = "The brief requires proof of the actual producer, transport and consumer contract; successful synthetic responses for symbols the real handler rejects cannot establish that client integration."
