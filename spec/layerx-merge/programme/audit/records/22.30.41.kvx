[finding.16]
file = "services/launchpad/trading-charts/internal/engine/builder.go"
line = 179
class = "runtime-risk"
severity = "medium"
observed = "The development Builder reads a candle without a row or pool lock, computes replacement totals, and writes them back. Concurrent distinct swaps can both claim processed_swaps and overwrite one another; concurrent first inserts use ON CONFLICT DO NOTHING, also losing one claimed fold. Production exact folding uses a separate fenced path."
expected = "Even the exposed development webhook and Redis ingestion paths must not commit deduplication claims for economic effects that were lost through concurrent read/modify/write processing."
proposal = "Serialize development pool folding within the same transaction in services/launchpad/trading-charts/internal/engine/builder.go, including first insertion and cursor updates, or route it through the admitted exact fold. Add concurrent distinct-swap proofs that preserve both volumes and trade counts."
owner_domain = 4

[finding.17]
file = "services/launchpad/trading-charts/internal/engine/builder.go"
line = 244
class = "restart-recovery"
severity = "medium"
observed = "The development Builder mutates Redis trader sets and publishes candle updates inside upsertCandleInTx before ProcessSwap commits SQL. A later timeframe or commit failure can leave a published candle and trader membership for rolled-back data; swallowed Redis errors or Redis loss can also change persisted unique-trader counts on retry."
expected = "Published state must represent committed folds and trader membership must survive retry and restart consistently with the candle transaction, even when one external system fails."
proposal = "Persist development trader membership and a committed delivery outbox transactionally in services/launchpad/trading-charts/internal/engine/builder.go and its store. Publish only committed records with idempotent retry, and prove rollback after an early timeframe plus Redis restart does not emit phantom state or alter counts."
owner_domain = 4

[finding.18]
file = "services/launchpad/trading-charts/internal/engine/builder.go"
line = 300
class = "runtime-risk"
severity = "medium"
observed = "When a late swap opens a previously absent old bucket, the development Builder seeds its open from the current cursor.LastClose and then unconditionally upserts last_candle_start. An out-of-order old bucket can inherit a future price and move the cursor backwards; existing bucket closes also follow arrival order."
expected = "Historical and current candles must follow source chain order, and late arrivals must not replace the latest cursor with an older bucket or introduce future information into an older open."
proposal = "In services/launchpad/trading-charts/internal/engine/builder.go, derive OHLC from persisted source ordering and fence cursor updates monotonically, preferably using the exact fold already owned by this service. Add an actual late-delivery sequence covering both an old missing bucket and an existing bucket."
owner_domain = 4

[finding.19]
file = "services/launchpad/trading-charts/internal/httpapi/webhook.go"
line = 123
class = "security"
severity = "medium"
observed = "webhookAuth performs an unbounded io.ReadAll before checking the HMAC, and webhookHandler reads the body again. An unauthenticated client of the mounted development webhook can force large allocations and decoding work without possessing the signing secret."
expected = "Request size and batch cardinality must be bounded before authentication-related body buffering and JSON decoding; invalid or oversized requests must not exhaust the service."
proposal = "Apply http.MaxBytesReader and a declared event-count bound in services/launchpad/trading-charts/internal/httpapi/webhook.go before reading or verifying the body. Return a stable oversized-request refusal and prove both forged and valid oversized batches are rejected within the bound."
owner_domain = 4

[finding.20]
file = "services/launchpad/trading-charts/internal/httpapi/webhook.go"
line = 95
class = "runtime-risk"
severity = "medium"
observed = "The development webhook logs ProcessSwap failures, increments errors, and still returns HTTP 200 with ok:true. A transient SQL or commit failure is therefore acknowledged like durable success, allowing a sender that retries failed HTTP deliveries to discard an unapplied swap."
expected = "A delivery acknowledgement must mean every accepted event was durably applied or has a durable retry owner; transient storage failure must remain distinguishable from successful or duplicate application."
proposal = "In services/launchpad/trading-charts/internal/httpapi/webhook.go, distinguish permanent validation failures from retryable apply failures and return a retryable non-2xx response unless the failed event is durably queued. Preserve idempotency for already committed batch members and prove partial failure followed by retry."
owner_domain = 4

[finding.21]
file = "services/launchpad/trading-charts/internal/engine/series.go"
line = 403
class = "restart-recovery"
severity = "high"
observed = "ReconstructArchive calculates ExpectedDigest from current chart_exact rows, then refuses promotion unless that digest equals the archive reconstruction. After guarded retention removes those rows, or when the projection is missing or corrupt, authentic nonempty archive output cannot match the damaged or empty current projection, so reconstruction cannot restore the requested history."
expected = "Archive recovery must restore lost or retained-away projection data from authenticated authoritative inputs using an independent parity commitment; the projection being repaired cannot be the only expected checksum authority."
proposal = "Persist an independent range economic digest/checkpoint before deletion in services/launchpad/trading-charts/internal/store, and make internal/engine/series.go verify reconstruction against that retained authority. Preserve manifest, source, epoch and parity checks; prove a delete-close-reopen-reconstruct journey restores bars without weakening checksum validation."
owner_domain = 4

[finding.22]
file = "services/launchpad/trading-charts/internal/store/rebuild.go"
line = 358
class = "wiring-gap"
severity = "high"
observed = "PromoteRebuild updates chart_exact, revisions and chart_outbox but never appends chart_stream_sources or an api_stream correction. Live ApplySeriesStreamTx uses appendCandleStreamTx for that proof and append. Rebuilt rows can thus be visible to history while canonical stream subscribers and their last materialized payload retain the older revision."
expected = "A promoted authoritative correction must become visible through the same canonical snapshot/replay lifecycle as live folds, with durable source proof and an atomic revision transition across projection and publication."
proposal = "Extend services/launchpad/trading-charts/internal/store/rebuild.go and the chart stream proof contract to append authenticated reconstruction corrections transactionally during promotion. Prove history, canonical snapshot and resumed event consumers converge on the promoted revision after restart; retain independent archive and source authorization."
owner_domain = 4

[finding.23]
file = "services/launchpad/trading-charts/cmd/charts-rebuild/main.go"
line = 28
class = "config-drift"
severity = "medium"
observed = "charts-rebuild defaults --schema to charts, while production chartsd requires the admitted candles schema and the canonical stream/read-model contracts refer to candles views. An operator using the documented default targets the wrong schema instead of the running service projection."
expected = "The reconstruction tool default must identify the same owned chart schema as production, or require an explicit validated deployment binding before any reconstruction operation."
proposal = "Change the deployment-bound schema selection in services/launchpad/trading-charts/cmd/charts-rebuild/main.go to the admitted candles configuration and validate it against the runtime profile before loading or promoting a run. Prove the default resolves the production chart tables and rejects mismatched bindings."
owner_domain = 4

[finding.24]
