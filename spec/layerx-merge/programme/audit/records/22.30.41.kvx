line = 7
class = "config-drift"
severity = "medium"
observed = "Artifact paths were repointed under contracts/launchpad/artifacts, but every source path still starts at contracts/core, contracts/periphery, contracts/protocol or contracts/base and does not resolve at the repository root. erc20Abi provenance also still names ERC20Base while the exported binding now follows the SidioraERC20 role ABI."
