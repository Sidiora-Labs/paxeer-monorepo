[finding.28]
file = "sdk/launchpad/packages/sidiora-launchpad-v3/test/provenance.test.mjs"
line = 16
class = "test-gap"
severity = "medium"
observed = "provenanceArtifactsResolveInRepository checks only artifact path containment, existence and artifact_sha256. It never validates source, source_sha256, license or that entry.export equals the ABI in the referenced artifact, allowing the stale source paths and ERC20 source identity to escape the provenance proof."
