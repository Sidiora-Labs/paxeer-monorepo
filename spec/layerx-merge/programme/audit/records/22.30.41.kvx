line = 93
class = "test-gap"
severity = "medium"
observed = "The live archive/retention proof uses ethclient.HeaderByNumber and compares header.Hash().Hex() to the archive block hash. On chain 125 the committed node-reported block hash is not the local geth header rehash, as internal/chainread/reader_test.go explicitly demonstrates; the application and rebuild CLI already use chainread.Reader."
expected = "The live proof must authenticate the same committed block identity as production and accept real chain-125 archive manifests, while still refusing a foreign or changed block hash."
proposal = "Use the production chainread.Reader adapter in services/launchpad/trading-charts/internal/engine/rollup_test.go for ArchiveReader.BlockTime. Retain the foreign-hash refusal and add a committed node-hash success case so recovery qualification follows the real chain identity."
