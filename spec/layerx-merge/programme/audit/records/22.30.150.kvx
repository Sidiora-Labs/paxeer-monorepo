[finding.001]
file = "apps/names/e2e/shell.test.ts"
line = 148
class = "test-gap"
severity = "medium"
observed = "fixture() replaces the proof-verified vector digest with published.digest while retaining verified: proven.verified; the successful serve path never resolves that newly published digest from its actual storage proof."
expected = "Requirement 19004.1 and brief check_7 require the successful published-site response to use the digest actually verified by the resolver on the producer-to-consumer path."
proposal = "In apps/names/e2e/shell.test.ts add a success case whose real publication is committed and proved through the real names resolver, then serve that exact verified digest; retain the corrupted-proof and digest refusal cases."
owner_domain = 14

[finding.002]
file = "apps/names/src/lib/serve.ts"
line = 83
class = "runtime-risk"
severity = "medium"
observed = "serve() fetches manifests and site objects without an AbortSignal or a response-size bound and materializes both complete response bodies before checking their digest and size."
expected = "Brief checks_4 and _8 require bounded network waits and input lengths before decoding untrusted manifests or allocating entire object responses."
proposal = "In apps/names/src/lib/serve.ts enforce a request deadline and stream byte limits for manifests and objects, using the parsed manifest size and a documented site-object ceiling, with typed bounded failures."
owner_domain = 14

[finding.003]
file = "services/bridge/deploy/appenv/proof_app_env_test.go"
line = 111
class = "test-gap"
severity = "medium"
observed = "TestProofAppEnv serializes minimal appenv.Record values and proves the EnvLines-to-Check/CLI path, but neither a record emitted by deploy-solana-program.sh nor the bridge application's readConfig participates; a deployed-but-uninitialized record is absent from its refusal cases."
expected = "Brief fact_7 and checks_1/_7 require deployment record lifecycle to be checked across the actual deployment producer, environment transport and bridge application consumer, including partial completion and restart."
proposal = "Extend the owning bridge deployment proof to capture the real scripts' record output and pass emitted environment values into apps/bridge/src/lib/bridge/config.ts readConfig, including restart and partial-deployment refusal."
owner_domain = 14

[finding.004]
file = "services/bridge/deploy/appenv/appenv.go"
line = 61
class = "interface-mismatch"
severity = "high"
observed = "LoadRecord accepts the record that deploy-solana-program.sh:474-496 writes before refusing the placeholder deployment's initialise step: chain identity and a 32-byte program_id suffice. EnvLines exports it and apps/bridge/src/lib/bridge/config.ts readConfig accepts it; with an attestation API URL set, chains.ts marks the uninitialized Solana route configured."
expected = "The declared Solana deployment record (14.fmt-bridge-solana-deployment-record-j55) includes owner, threshold, attestors and assets. Its LoadRecord-to-EnvLines-to-app path must preserve readiness, refusing a deployed-but-uninitialized checkpoint until custody configuration and assets are verified."
proposal = "Version Solana deployment records with an explicit deployment phase; write checkpoints atomically and have services/bridge/deploy/appenv/appenv.go refuse records until initialized configuration and registered assets are verified."
owner_domain = 14
interface = "14.go-bridge-appenv-loadrecord-j55"
interfaces = ["14.fmt-bridge-solana-deployment-record-j55", "14.go-bridge-appenv-envlines-j55", "14.go-bridge-appenv-loadrecord-j55"]

[finding.005]
file = "services/bridge/deploy/deploy-solana-program.sh"
line = 504
class = "restart-recovery"
severity = "medium"
observed = "The script always submits initialise and then register-asset for every mint, and writes the final record only after all succeed. The real program's admin.rs initialise creates the config PDA and rejects a second initialization with Conflict, as core.rs explicitly asserts, so a stop after the first confirmed initialization cannot resume this script."
expected = "Brief check_5 requires a deployment restart to reconcile confirmed config and asset state and finish pending work without repeating a confirmed instruction that the custody program refuses."
proposal = "In services/bridge/deploy/deploy-solana-program.sh persist phase and transaction intent before each write and reconcile existing config and asset accounts on resume before issuing further instructions."
owner_domain = 14

[finding.006]
file = "services/bridge/deploy/deploy-solana-program.sh"
line = 383
class = "security"
severity = "medium"
observed = "The program deploy transaction uses PAXEER_BRIDGE_SOLANA_PROGRAM_KEYPAIR_FILE immediately; the script compares the returned programId with configured_program_id only after the broadcast. A readable keypair for another program controlled by the same publisher can therefore upgrade that other program before this run refuses."
expected = "Deployment identity must be verified before issuing a foreign-chain write; a configured custody program and the supplied program keypair must identify the same target throughout preflight and execution."
proposal = "Derive the supplied program keypair's public key with the pinned solana-keygen before deployment in services/bridge/deploy/deploy-solana-program.sh, refuse a configured identity mismatch before any broadcast, and cover the wrong-keypair refusal."
owner_domain = 14
interface = "14.cli-bridge-deploy-solana-program-j55"

[finding.007]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/notifier.ex"
line = 573
class = "runtime-risk"
severity = "medium"
observed = "schedule_broadcasting sleeps and recursively retries until the ETS head equals exactly the predecessor of its block. If a later height advances the head beyond that predecessor, this linked task can never finish; repeated out-of-order imports accumulate waiting processes."
expected = "Brief checks_4/_5 require live block notification workers to terminate after bounded waiting and to handle a head that overtakes an outstanding notification."
proposal = "In notifier.ex bound sequence waiting, reconcile a head at or above the target predecessor without regressing the watermark, and exercise delayed, missing and overtaken predecessor events through the real broadcaster."
owner_domain = 14
interface = "14.ws-explorer-push-blocks-new-block-new-block"

[finding.008]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/internal_transaction.ex"
line = 303
class = "restart-recovery"
severity = "medium"
observed = "mark_not_traceable deletes old PendingBlockOperation/PendingTransactionOperation rows after the configured lookback expires and retains only a warning log. An outage longer than the trace window removes the durable identities of unfinished trace work, so reopening with an archive trace source cannot resume that work from the queue."
expected = "Brief check_5 requires unfinished indexing and recovery dispositions to remain durable across restart; limiting calls to a pruned node must preserve which historical transactions remain unindexed."
proposal = "Keep durable unavailable-trace records or a deferred archive backfill queue in the explorer schema, expose the missing trace coverage to operators and API consumers, and resume those records when an archive source becomes available without retrying the pruned node indefinitely."
owner_domain = 14
interface = "14.cfg-indexer-indexer-fetcher-internaltransaction"

[finding.009]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/transaction/history/historian.ex"
line = 204
class = "runtime-risk"
severity = "medium"
observed = "Before transaction denormalization finishes, the count and gas queries match transactions to consensus blocks by block_number only. A stored nonconsensus transaction at the same height is counted, whereas total_fee joins by block_hash and excludes it, so the daily statistics disagree during recovery of a database containing fork records."
expected = "The historian's documented consensus-only daily statistics must use the identity of the committed block consistently for transaction counts, gas and fees, including while denormalization is incomplete."
proposal = "Select block hashes in all_blocks_query and join transaction.block_hash to the consensus block hash in historian.ex; retain the separate native price-update count and add a real-database case with consensus and nonconsensus blocks sharing a height."
owner_domain = 14

[finding.010]
file = "services/explorer/backend/apps/nft_media_handler/README.md"
line = 31
class = "doc-drift"
severity = "medium"
observed = "The resizing example assigns Vix.Vips.Image.new_from_file directly to image and passes it to Resizer.resize/3. The non-bang Vix constructor returns an ok/error tuple; resize/3 expects a Vix image and immediately calls Image.width(image), so the documented successful example is invalid."
expected = "A maintainer following the media-handler usage page must obtain the actual image object and handle a failed open before calling the resizer's declared image-struct interface."
