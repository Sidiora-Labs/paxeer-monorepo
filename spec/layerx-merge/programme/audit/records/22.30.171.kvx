notes = "Rows include historical retirement declarations. Negative assertions and weak-null references intentionally mention removed symbols and do not make them live consumers. Decisions 910/921 preserve wire-crate receipt, budget, approval and maintenance encodings while retiring its kernel Activity envelope."

[boundary.harness]
interfaces = ["16.cli-lxp-test-harness-list-j59", "16.cli-lxp-test-harness-run-j59"]
producer = "tests/lxp_test_harness.c"
consumer = "tests/protocol/lxp_test_smoke.c"
notes = "Registered names reach lxp_test_run_one through lxp_test_main. --list lists registrations, --run selects one case, unknown cases return 2, and PASS/FAIL output and results agree with the declared helper contract."

[boundary.asset]
interfaces = ["1.c-lx-asset-runtime", "1.c-lx-asset-transfer-request"]
producer = "include/layerx/lx_asset.h"
consumer = "tests/modules/test_asset_registry.c; tests/modules/test_asset_deposit.c"
notes = "Current tests use the compiled runtime with binding_authority and transfer request without payer_grant. These producer and consumer types agree; historical registry and kernel contract declarations need the recorded updates. Removed receive/grant/deposit symbols are absence checks."

[boundary.kernel-state]
producer = "include/layerx/lxp_kernel.h; include/layerx/lxp_authority.h; src/state/lxp_identity.c"
consumer = "tests/protocol; tests/state; tests/modules/test_budget_delegate.c"
notes = "Reviewed registration and dispatch, scalar widths, canonical bytes, result enums, state journal commit/abort, sequence handling, scoped authorization, transfer savepoints and recovery helper assertions. Direct struct fixtures are unit evidence, not proof of external transport or restart qualification. Retained C codecs are distinct from retired agent envelope writes."

[boundary.wallet]
interfaces = ["8.rpc-gateway-px-getnetwork"]
producer = "services/platform/hosted/gateway/src/paxeer.rs; services/platform/hosted/gateway/openrpc.json"
consumer = "scripts/wallet/check-live.sh; tools/ci/tests/test_wallet_check_live.py; tests/wallet/check-live.test.sh"
notes = "network_result emits network_id, paxeer.chain_id/latest_block and consensus or null with consensus_unavailable. The shell checker consumes paxeer and consensus; the Python fixture supplies a third kernel-only shape. Both endpoint suites positively retain /rpc. Findings separate response-shape test drift from route retirement."

[boundary.deployment]
interfaces = ["16.cli-tdeploy-deploy-railway-apply-variables", "16.cli-tdeploy-deploy-railway-perps-project", "16.fmt-tdeploy-deploy-charting-library-dockerfile", "16.fmt-tdeploy-deploy-tests-fixtures-railway-apply-variables-replay-json"]
producer = "tools/deploy; deploy/railway-perps-project.kvx"
consumer = "tools/deploy/tests; tools/deploy/tests/fixtures/railway-apply-variables-replay.json"
notes = "Checked desired/live variables, service/environment IDs, GraphQL inputs and data envelopes, registry username/password nesting, health configuration, digest pins and waves. The chart Dockerfile copies the two validated directories. Variable reconciliation uses shared redaction; the project transport prints raw API errors."

[boundary.rollout]
interfaces = ["16.cli-rollout-rollout-box-apply", "16.cli-rollout-rollout-ledger", "16.cli-rollout-rollout-rollout", "16.cli-rollout-rollout-rollout-2", "16.fmt-rollout-rollout-tests-replay-json"]
producer = "tools/rollout/rollout.py; tools/rollout/box-apply.sh; tools/rollout/ledger.sh"
consumer = "tools/rollout/tests; tools/deploy/railway-perps-project.py"
notes = "Checked exact manifest keys and target enums, image/health reconciliation, polling statuses, shell quoting, token-file bytes on stdin, private evidence paths and ledger fields. Restart failure bypasses rollback; concurrent appends can collide; SLEEPING alone supplies no fresh readiness observation. Replay preserves crash/rerun and redaction but qualifies retired topology."

[boundary.qualification]
interfaces = ["16.cli-qual-qualification-paxeer-x-gas-station-contract", "16.cli-qual-qualification-paxeer-x-replay-authority", "16.env-qual-qualification-paxeer-x-replay-authority-layerx-replay-authority-evidence"]
producer = "tools/qualification/paxeer-x/gas-station-contract.py; tools/qualification/paxeer-x/replay-authority.py"
consumer = "qualification material readers and declared CLI callers"
notes = "Gas-station qualification reads the merge catalogue and checks producer material identities, fields, hashes, bounded loopback requests, authorization/refusals, recovery counters and evidence linkage. The replay CLI explicitly refuses retired qualification and does not produce the stable evidence environment row advertised by the registry."
