[finding.post-actions-dropped]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/types/verification_result.rs"
line = 97
class = "interface-mismatch"
severity = "high"
observed = "Both Solidity solo requests declare post_actions=['lookup-methods'] in proto/v2/smart-contract-verifier.proto:128-147. The library proto_conversions.rs drops that field, and the successful response here always sets PostActionResponses.lookup_methods=None. HTTP clients and gRPC callers receive no requested lookup result; the standalone LookupMethods route is wired but is never invoked by verification."
expected = "The multipart and standard-json verification interfaces must preserve the requested supported post-action and return its result for the selected verified contract, as VerifyResponse.PostActionResponses promises in the protobuf contract."
proposal = "Carry post_actions through smart-contract-verifier/src/proto_conversions.rs and the server Solidity handlers; run find_methods against the selected contract's actual bytecode, ABI, source map and file IDs, then populate lookup_methods. Add real compiler-to-HTTP and gRPC regression coverage for both request formats and reject unsupported actions explicitly."
owner_domain = 14
interface = "14.http-verifier-post-api-v2-verifier-solidity-sources-verify-multi-part"
related_interfaces = ["14.http-verifier-post-api-v2-verifier-solidity-sources-verify-standard-json","14.http-verifier-post-api-v2-verifier-solidity-methods-lookup"]

[finding.absolute-source-path-write]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/services/solidity_verifier.rs"
line = 77
class = "security"
severity = "high"
observed = "The public multipart conversion accepts arbitrary source_files names as PathBuf; standard-json and batch conversions also retain paths. For solc versions below 0.4.11, verify/solc_compiler.rs:77 calls solc_compiler_cli::InputFiles, which joins a temporary directory with each name, rejects only ParentDir components, and File::create writes it. An absolute name replaces the temporary prefix and can truncate or overwrite any file writable by the verifier before compilation succeeds."
expected = "Untrusted verification source names must remain inside a fresh compilation directory. Failed verification must not modify compiler caches, configuration or any other service state outside that directory."
proposal = "Fix smart-contract-verifier/src/verify/solc_compiler_cli.rs to reject rooted and parent paths before writes and enforce confinement during creation, including symlink handling. Apply consistent validation to all request formats and prove through real old-solc HTTP requests that absolute and traversal inputs cannot alter an external sentinel or cached compiler."
owner_domain = 14
interface = "14.http-verifier-post-api-v2-verifier-solidity-sources-verify-multi-part"
related_interfaces = ["14.http-verifier-post-api-v2-verifier-solidity-sources-verify-standard-json","14.http-verifier-post-api-v2-verifier-solidity-sources-batch-verify-multi-part","14.http-verifier-post-api-v2-verifier-solidity-sources-batch-verify-standard-json"]

[finding.health-unknown-service]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/services/health.rs"
line = 12
class = "interface-mismatch"
severity = "high"
observed = "HealthService::check ignores HealthCheckRequest.service and always returns SERVING. A gRPC request naming a nonexistent or disabled verifier therefore reports success even though run.rs omits that service from both routers."
expected = "The declared Health.Check protobuf explicitly requires NOT_FOUND for an unknown service at proto/v2/health.proto:43-45. Only the whole server and registered, available services may be reported as serving."
proposal = "Pass the registered service set from src/run.rs into HealthService, preserve the empty-name server probe, and return tonic::Status::not_found for unknown names. Exercise the real gRPC router with enabled, disabled and unknown service names and retain the HTTP /health probe."
owner_domain = 14
interface = "14.grpcs-verifier-health-check"

[finding.compiler-cache-trust-after-restart]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/services/solidity_verifier.rs"
line = 46
class = "restart-recovery"
severity = "medium"
observed = "Solidity and Vyper warm their pools with load_from_dir. The library compiler/download_cache.rs:add_versions trusts a parseable version directory whenever its solc path exists, without the download hash or FileValidator used for a fresh fetch. Defaults place these executables in predictable /tmp directories. A corrupt or replaced cached executable is accepted after restart and repeatedly executed instead of revalidated."
expected = "Compiler integrity must remain equivalent across a fresh download and a restart. An invalid on-disk cache entry must not bypass the list digest and compiler validation."
proposal = "Update smart-contract-verifier/src/compiler/download_cache.rs and the fetcher API to revalidate persisted executable digests and version identity before admission; use private compiler directories with safe ownership and permissions. Add a real restart case with an altered cache executable that is refused and replaced only by a verified download."
owner_domain = 14
interface = "14.cfg-verifier-solidity-compilers-dir"

[finding.startup-requires-live-compiler-catalogues]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/run.rs"
line = 85
class = "restart-recovery"
severity = "medium"
observed = "run initializes every enabled verifier before starting listeners. ListFetcher::new constructs VersionsRefresher with an immediate remote fetch; even Solidity/Vyper cache loading happens only after that fetch succeeds. A failed compiler catalogue, including any default-enabled Zksync provider, prevents all verifier endpoints and health from starting despite existing compiler files; catalogue state is only in memory."
expected = "Restart recovery should have a defined, bounded availability policy for cached verified compilers and each enabled provider. An unrelated catalogue outage should not silently make every verification route unavailable."
proposal = "Persist authenticated last-known catalogue metadata in smart-contract-verifier/src/compiler/fetcher_versions.rs, validate it on restart, and define explicit provider readiness and catalogue expiry. Add bounded fetch deadlines and a real warm-cache restart test with an unavailable catalogue; keep unavailable compiler versions visibly refused rather than inventing success."
owner_domain = 14
interface = "14.cfg-verifier-zksync-solidity-enabled"

[finding.compilation-admission-unbounded]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/run.rs"
line = 83
class = "runtime-risk"
severity = "medium"
observed = "The shared Semaphore limits simultaneous compiler calls but imposes no queue bound or wait deadline. The library EvmCompilersPool::compile awaits acquire and compiler execution without a task deadline; the old-solc process also awaits output without a timeout. HTTP max_body_size limits one body, not queued request memory or compiler duration, so expensive requests can occupy every slot and accumulate waiters across languages."
expected = "Verification must have explicit resource and admission bounds so a caller cannot indefinitely starve other verification requests with long compilations or an unbounded queue."
proposal = "Add bounded admission and queue deadlines at the server/compiler-pool boundary, enforce compiler wall time and output/resource limits, and terminate and reap timed-out child processes. Return a documented busy/deadline error and prove with real compiler processes that capacity recovers after cancellation and exhaustion."
owner_domain = 14
interface = "14.cfg-verifier-compilers-max-threads"

[finding.metric-chain-cardinality]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/metrics.rs"
line = 15
class = "runtime-risk"
severity = "medium"
observed = "count_verify_contract creates persistent IntCounterVec children using the raw caller-supplied chain_id. Solidity and Vyper copy metadata.chain_id before conversion, and Sourcify copies its chain string. No label vocabulary, length bound or normalization limits the set; repeated otherwise valid verification requests can create arbitrarily many permanent metric series."
expected = "The declared four-label verification counter must have bounded cardinality and remain scrapeable under untrusted request metadata; chain ID 125 must have a consistent canonical label."
proposal = "Normalize and bound chain labels in src/metrics.rs using an explicit configured chain set and a fixed unknown bucket, while retaining useful chain details in bounded logs. Exercise real handler requests with many distinct metadata chain values and assert a fixed maximum number of exported series."
owner_domain = 14
interface = "14.met-rs-smart-contract-verifier-server-smart-contract-verifier-verify-contract"

[finding.batch-selects-first-match]
file = "services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/src/types/batch_verification.rs"
line = 70
class = "runtime-risk"
severity = "medium"
observed = "Batch response conversion chooses value.into_iter().next() instead of ranking matches. The library emits successes in compilation-artifact order. Solo conversion in verification_result.rs:54-85 prefers full matches, and the both_partial_and_full_verification_sources fixture demonstrates inputs with multiple matching sources. Batch callers can receive a partial parent contract even when the same compilation contains a full match."
expected = "The same verified bytecode should yield the best available match and corresponding source identity in solo and batch APIs, rather than depend on artifact filename ordering."
proposal = "Share the match-ranking policy between src/types/batch_verification.rs and verification_result.rs. Extend the real batch HTTP integration cases with the existing partial/full proxy compilation and assert that both batch formats return the full FiatTokenProxy source and its match evidence."
owner_domain = 14
interface = "14.http-verifier-post-api-v2-verifier-solidity-sources-batch-verify-multi-part"
related_interfaces = ["14.http-verifier-post-api-v2-verifier-solidity-sources-batch-verify-standard-json"]

