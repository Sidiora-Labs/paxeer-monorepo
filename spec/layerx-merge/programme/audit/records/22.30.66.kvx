[finding.history-sequence]
file = "wasm/x/wasm/keeper/keeper.go"
line = 633
class = "interface-mismatch"
severity = "high"
observed = "appendToContractHistory reads the last position with sdk.BigEndianToUint64(iter.Value()), although that value is a protobuf ContractCodeHistoryEntry and the sequence is encoded in the iterator key. Subsequent separately appended migrations can move backwards, collide with existing keys or select the wrong last entry; short protobuf values can panic in the SDK decoder. The history also supplies migration index removal."
expected = "ContractHistory must preserve every instantiate and migration entry in sequence across commits and restarts, and migration must remove the secondary index for the actual previous code."
proposal = "In wasm/x/wasm/keeper/keeper.go decode and validate the sequence suffix of iter.Key(), reject exhaustion before incrementing, and define remediation for existing malformed history ordering. Prove instantiate, multiple separately committed migrations, reopen, ordered history and contracts-by-code index removal through the real keeper and query transport."
owner_domain = 6
interface = "6.qry-wasm-contracthistory"

[finding.compile-wall-clock]
file = "wasm/x/wasm/keeper/vm_wrapper.go"
line = 28
class = "runtime-risk"
severity = "high"
observed = "VMWrapper.Create races native compilation against CreateTimeout of 15 seconds. Upload and code import therefore accept or refuse identical code according to machine load. Timeout also releases mu while the compilation goroutine continues using the engine and writing the named checksum and err return variables."
expected = "Consensus code upload must produce the same result on every validator. An operation must finish or terminate before its serialization lock is released and its result storage becomes observable."
proposal = "Replace the consensus Create timeout in wasm/x/wasm/keeper/vm_wrapper.go with deterministic bounded synchronous compilation using the runtime limits. If a timeout remains on a nonconsensus path, cancellation must terminate and join the native operation before releasing ownership. Prove actual upload results and safe subsequent cache operations under delayed compilation."
owner_domain = 6
interface = "5.go-wasmvm-vm-create"

[finding.ibc-gas-units]
file = "wasm/x/wasm/keeper/relay.go"
line = 38
class = "interface-mismatch"
severity = "high"
observed = "All six VM IBC callback calls pass ctx.GasMeter() directly (lines 38, 73, 104, 134, 168 and 195), whereas ordinary VM calls pass k.gasMeter(ctx). The default WasmGasRegister multiplier is 140000000. Native storage callbacks forward GasConsumed differences unchanged, so these IBC callbacks report SDK storage gas as CosmWasm gas. The SDK storage meter still charges storage."
expected = "The wasm-runtime GasMeter boundary expects CosmWasm gas, consistently for execute, query and every IBC callback. SDK accounting and the native execution budget must agree on the conversion."
proposal = "Use the configured Wasm gas-meter adapter for all six calls in wasm/x/wasm/keeper/relay.go. Exercise real native IBC callbacks that read, write and iterate contract storage, assert SDK and CosmWasm deltas and budget refusal with default and nondefault gas multipliers, and retain acknowledgement and timeout behavior."
owner_domain = 6
interface = "5.go-wasmvm-gasmeter"

[finding.query-gas-units]
file = "wasm/x/wasm/keeper/query_plugins.go"
line = 73
class = "interface-mismatch"
severity = "high"
observed = "QueryHandler.Query converts its incoming Wasm gas limit to SDK units, but QueryHandler.GasConsumed returns raw SDK gas. wasm-runtime/types/queries.go requires CosmWasm gas and its native query callback forwards the GasConsumed delta unchanged. Nested queries therefore consume the wrong external gas units."
expected = "Querier.GasConsumed must return CosmWasm units while the parent SDK context receives its subquery charge exactly once, including on errors and out-of-gas paths."
proposal = "Convert QueryHandler.GasConsumed through its configured gasRegister in wasm/x/wasm/keeper/query_plugins.go and preserve the existing SDK parent charge. Prove actual contract-to-bank and contract-to-contract queries across the native callback boundary with default and nondefault multipliers, successful budgets, refusal and error accounting."
owner_domain = 6
interface = "5.go-wasmvmtypes-querier"

[finding.stream-contract-reimport]
file = "wasm/x/wasm/keeper/genesis.go"
line = 173
class = "interface-mismatch"
severity = "high"
observed = "ExportGenesisStream emits a contract after 50001 state entries and emits another record for its remaining state, even when empty, repeating its address and metadata. The SDK streaming importer invokes module InitGenesis per chunk; keeper.importContract rejects the second occurrence of that address as ErrDuplicate. A large exported contract cannot be imported through that transport."
expected = "The streamed genesis representation must round-trip all contract metadata and state through the actual SDK export and import lifecycle, including contracts larger than one chunk and recovery after reopening the store."
proposal = "Define a chunk-aware contract import lifecycle across wasm/x/wasm/keeper/genesis.go and the module streaming boundary: create metadata once, append validated state chunks, reject conflicting duplicates and finalize invariants. Test more than 50001 keys through actual exported-file transport, module import, commit, reopen and contract queries."
owner_domain = 6
interface = "6.gen-wasm-contracts"

[finding.cw721-json-strings]
file = "wasm/x/wasm/keeper/keeper.go"
line = 1151
class = "interface-mismatch"
severity = "high"
observed = "emitCW721OwnerBeforeTransferIfApplicable slices quotes from token_id and owner json.RawMessage without JSON string decoding. A Unicode-escaped numeric token ID executes as its decoded ID in the contract but the owner lookup uses the literal escape and its error is discarded. node/receipt.go requires the matching pretransfer owner event to translate CW721 transfers and returns a synthetic translation error when it is absent."
expected = "Equivalent JSON string encodings must identify the same token and owner from contract execution through the pretransfer event and EVM synthetic receipt. Required receipt metadata must not disappear silently."
proposal = "Decode token_id and owner into typed strings in wasm/x/wasm/keeper/keeper.go, and define explicit propagation of required owner-lookup failures with node/receipt.go. Prove escaped and unescaped numeric token IDs through a real CW721 contract, emitted owner event and synthetic transfer receipt, including send and burn where applicable."
