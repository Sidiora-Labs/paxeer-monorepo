[finding.flatkv-rejected-write]
file = "storage/state_db/sc/flatkv/store_apply.go"
line = 73
class = "runtime-risk"
severity = "high"
observed = "ApplyChangeSets copies newAccountValues into s.accountWrites before processStorageChanges validates storage values. A batch containing a valid nonce change and an invalid storage value returns an error after changing the account buffer, before updating perDBWorkingLtHash or pendingChangeSets. A later Commit can persist that rejected account mutation with an unchanged hash and no corresponding WAL pair."
expected = "A rejected mutation must leave working rows, per-database hashes and the pending recovery log in the same state. Committed rows and the recovery log must describe the same network state."
proposal = "In storage/state_db/sc/flatkv/store_apply.go stage and validate all account, storage, code and legacy results before publishing any buffers or hashes. Add a valid-account plus invalid-storage regression that commits subsequent valid work, reopens from WAL and compares rows and recomputed LtHash."
owner_domain = 5
interface = "5.go-storage-state-db-sc-flatkv-store"

[finding.flatkv-latest-export]
file = "storage/state_db/sc/flatkv/store_lifecycle.go"
line = 158
class = "interface-mismatch"
severity = "high"
observed = "Exporter(0) resolves the latest committed height H through LoadVersion(0,true), but constructs NewKVExporter(cs,0). exporter.go emits Version 0 for every physical leaf; importer.go AddNode silently drops any leaf whose Version differs from its target H. Exporting latest and restoring at its actual height therefore loses every row while Close can still finalize an empty store."
expected = "The SnapshotNode version transported from the resolved read-only store must agree with the target snapshot height accepted by the importer, including the supported zero-means-latest load path."
proposal = "In storage/state_db/sc/flatkv/store_lifecycle.go pass the loaded clone Version() to NewKVExporter. Extend import_export_test.go with Exporter(0), the real composite/state-sync transport, Importer(H), close and reopen, asserting nonempty logical rows and identical per-DB and global hashes."
owner_domain = 5
interface = "5.go-storage-state-db-sc-types-snapshot-node"

[finding.flatkv-import-validation]
file = "storage/state_db/sc/flatkv/importer.go"
line = 244
class = "runtime-risk"
severity = "medium"
observed = "KVImporter.AddNode silently ignores a wrong version or non-leaf height, and dispatch only checks routePhysicalKey before workers write raw values. For a valid storage physical key it accepts a 32-byte logical value although DeserializeStorageData requires the 41-byte serialized envelope. Close can publish a snapshot that logical readers cannot decode."
expected = "A FlatKV restore must accept the physical envelopes emitted by KVExporter and ImportTranslator, and must report a malformed snapshot instead of successfully finalizing missing or unreadable state."
proposal = "In storage/state_db/sc/flatkv/importer.go validate node presence, target version, leaf shape, canonical physical-key lengths and the routed vtype envelope before enqueueing; record the first validation error and prevent finalization. Cover actual exporter output and malformed envelopes through close and reopen."
owner_domain = 5
interface = "5.go-storage-state-db-sc-flatkv-kv-importer"

[finding.flatkv-import-duplicate-hash]
file = "storage/state_db/sc/flatkv/importer.go"
line = 83
