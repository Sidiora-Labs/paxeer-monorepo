[finding.receipt-committed-rung]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/verify/LocalVerifier.java"
line = 280
class = "interface-mismatch"
severity = "high"
observed = "verifySequencerView requires rung receipted. ProgramsClient.sequencerReceipt explicitly accepts committed and passes the unchanged node view to this check, so a previously readable transaction fails verification after its block commits."
expected = "Registry 7.rpc-pax-sequencerreceipt and rpc/sequencer_receipt.go:164-199 declare both signed receipt rungs, with blockNumber and blockHash on committed answers; receipt reads must remain usable after commitment."
proposal = "In sdk/platform/jvm verify/LocalVerifier.java and ProgramsClient.java, validate the receipt portion of both node shapes and keep consensus finality separately verified. Cover the real receipted-to-committed transition and a read after client restart without rewriting rung."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.receipt-payment-asset]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/verify/LocalVerifier.java"
line = 262
class = "interface-mismatch"
severity = "high"
observed = "verifySequencerEffectLayout hashes the summary fee denomination and requires equality with receipt.asset; verifySequencerView repeats that comparison using feeDenom at line 298 and never binds paymentDenom."
expected = "rpc/sequencer_receipt.go:553-570 binds receipt.asset to SHA-256(paymentDenom), while the summary independently carries feeDenom. The published sequencer-receipt-fee-token-v1.json deliberately uses paymentDenom usid and feeDenom uhpx."
proposal = "Update sdk/platform/jvm/verify/LocalVerifier.java to bind the payment asset to paymentDenom and verify fee denomination against the signed summary independently, preserving both checks. Consume the existing fee-token vector and a real node payment through the JVM path."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.portable-node-shape]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/verify/PortableReceipt.java"
line = 150
class = "interface-mismatch"
severity = "high"
observed = "verifyReceipt requires an exact field set that omits paymentDenom. rpc/sequencer_receipt.go:151 emits that mandatory field, so export and verify refuse the current producer receiptJson, including updated portable vectors, before checking its signature."
expected = "Requirements 8507.1, 8508.1 and 181184.1 require portable v2 to accept the published node-derived receiptJson and both published V5 bundles without changing the producer shape."
proposal = "Amend sdk/platform/jvm/verify/PortableReceipt.java exact fields to the current node contract and bind paymentDenom through LocalVerifier. Keep strict unknown-field refusal, and prove unmodified published bundles and node-to-export-to-offline-import round trips."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.portable-consensus-trust]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/verify/PortableReceipt.java"
line = 110
class = "security"
severity = "high"
observed = "verify accepts only ReceiptKeys as external trust. For committed bundles it takes blockHeader, commit, validatorSet and resultsValidators from the same bundle. Committed.verify checks internally consistent validator hashes and signatures but no independently trusted consensus set or chain checkpoint."
expected = "A committed result must establish commitment by this network, rather than merely a quorum of keys supplied by the evidence sender. A genuine sequencer-signed receipt and batch establish execution, not validator authority or canonical block inclusion."
proposal = "Add an explicit independently pinned chain identity and trusted consensus checkpoint or validator root to the portable verification API, and authenticate validator transitions to both proof heights. Reject a genuine signed batch wrapped in attacker-chosen headers and validator signatures."
owner_domain = 8
interface = "8.go-sdkjvm-committed"

[finding.lifecycle-abi-range]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/NativeProgramLifecycle.java"
line = 37
class = "interface-mismatch"
severity = "high"
observed = "NativeProgramLifecycle.code accepts only guest ABI 1 through 3 and is called by both deployment and upgrade constructors. NativeProgramCall and GeneratedReceiptContract accept ABI 4 and 5, and the runtime shared policy admits both versions."
expected = "The declared native lifecycle interface must round-trip every admitted guest ABI. programs/sdk/rust/src/abi_policy.rs admits versions 1 through 5 and the runtime FFI uses that policy for actual deployment and upgrade admission."
proposal = "Align the JVM lifecycle admission with the canonical programs SDK ABI policy through its generator or shared contract. Exercise real ABI 4 and ABI 5 deploy and monotonic upgrade transactions through 0x101D as well as unsupported-version refusals."
owner_domain = 8
interface = "8.go-sdkjvm-nativeprogramlifecycle-code"

[finding.deploy-total-bound]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/NativeProgramDeploy.java"
line = 23
class = "runtime-risk"
severity = "medium"
observed = "NativeProgramDeploy allocates 104 plus optional interface framing plus wasm.length without checking the complete payload limit. The shared code validator allows 1048576 wasm bytes, so the SDK can construct and sign a deployment exceeding the network admission bound."
expected = "Brief fact 6 and decision 2483 require a deployment payload of at most 524288 bytes including its 104-byte envelope; additional interface framing also consumes that same payload budget."
proposal = "Enforce the complete serialized deploy size in sdk/platform/jvm/NativeProgramDeploy.java before allocating or signing, including optional interface bytes. Test the exact allowed boundary and one byte above it against the real precompile admission path."
owner_domain = 8

[finding.upgrade-total-bound]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/NativeProgramUpgrade.java"
line = 25
class = "runtime-risk"
severity = "medium"
observed = "NativeProgramUpgrade independently accepts up to 1048576 wasm bytes, 65535 migration-hook bytes and 952 interface bytes, then concatenates them with a 106-byte or 110-byte frame without a complete payload-size check."
expected = "The protocol payload ceiling in include/layerx/lxp_protocol.h is 524288 bytes. An upgrade submitted through the native Programs payload must fit that ceiling after its hook and interface are included."
proposal = "In sdk/platform/jvm/NativeProgramUpgrade.java validate the encoded aggregate size before transaction construction, with overflow-safe arithmetic. Verify exact-limit upgrades and oversized hook-plus-code combinations through the real producer admission path."
owner_domain = 8

[finding.program-read-metadata]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/GeneratedSchema.java"
line = 3014
class = "config-drift"
severity = "medium"
observed = "Generated PROGRAM_RECEIPT_TRANSPORT and PROGRAM_ACTIVITY_TRANSPORT at line 2919 advertise eth_getLogs at 0x101D and ProgramCallOutcome, while ProgramsClient resolves retained transactions and reads pax_sequencerReceipt for receipts."
expected = "Requirement 1813082 and the running Programs client identify a receipt by its retained EVM transaction, with no resultByIdempotency lookup. Public transport metadata must describe the same lookup that the client performs."
proposal = "Repair sdk/platform/generators/generate_jvm.py and its canonical operation source, then regenerate GeneratedSchema.java and the pipeline lock so receipt and activity metadata describe the retained-transaction path. Preserve the current generated Human verification vocabulary."
owner_domain = 8

[finding.program-metadata-test]
file = "sdk/platform/jvm/src/test/java/com/sidiora/layerx/sdk/GeneratedCatalogueProgramsTest.java"
line = 34
class = "test-gap"
severity = "medium"
observed = "programOperationsNameLayerxprogramsCalls hard-codes eth_getLogs for program.activity and program.receipt and requires a Programs event target for every operation. It thereby approves the stale generated receipt metadata instead of the lookup the running client uses."
expected = "A transport contract test must derive its expected methods from the producer and operation contract, including retained transaction identity for receipt lookup, rather than perpetuating an earlier event-only interpretation."
proposal = "Update GeneratedCatalogueProgramsTest.java alongside the generator repair to compare metadata with the canonical retained-transaction contract and trace the corresponding ProgramsClient request sequence. Keep unrelated operation, retirement and immutability assertions."
