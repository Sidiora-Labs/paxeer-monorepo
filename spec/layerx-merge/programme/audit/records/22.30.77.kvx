[finding.program-memory-growth]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java"
line = 574
class = "runtime-risk"
severity = "medium"
observed = "broadcast permanently adds the signed transaction to submittedTransactions and its nonce to submittedNonces before sending. Neither map has a size limit or eviction path, even after committed receipt resolution, so a long-running client retains every transaction."
expected = "A production client must have bounded retained state while preserving the no-replacement rule and enough durable evidence to reconcile unknown outcomes and recover after restart."
proposal = "Provide a bounded, caller-owned submission journal and explicit finality-aware retention policy in ProgramsClient.java. Retain unresolved bytes durably and release eligible completed entries; qualify sustained submissions and reconciliation without unbounded heap growth."
owner_domain = 8

[finding.program-restart-lookup]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java"
line = 702
class = "restart-recovery"
severity = "medium"
observed = "receipt(IdempotencyKey, expectedTransactionHash, verificationLevel) obtains raw bytes only from submittedTransactions and refuses when they are absent. A fresh client after restart cannot use that public lookup overload for a previously submitted hash; only the explicit raw-transaction or ProgramSubmission paths can recover."
expected = "Receipt recovery must make retained transaction requirements explicit and preserve unresolved submissions across process restarts. A lookup by transaction hash must not silently depend on a prior call in the same client instance."
proposal = "Expose and document a durable submission-store or import/export contract in ProgramsClient.java and its JVM examples. Reconstruct a fresh client from retained signed bytes and prove both unknown-outcome reconciliation and committed receipt lookup without resubmission."
owner_domain = 8

[finding.program-response-bound]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java"
line = 97
class = "runtime-risk"
severity = "medium"
observed = "Programs.request uses HttpResponse.BodyHandlers.ofString and parses the entire response without a byte limit. A hostile or faulty RPC upstream can force an arbitrarily large allocation before any ABI length checks apply."
expected = "Brief runtime and security checks require bounding untrusted response input before decoding. Programs calls need a response limit that accommodates legitimate bounded payloads without exposing the client heap to the peer."
proposal = "Use a bounded streaming body subscriber for Programs.request in ProgramsClient.java, with cancellation on overflow and an end-to-end deadline. Exercise an oversized real HTTP response and confirm an explicit typed refusal with bounded memory."
owner_domain = 8

[finding.program-plaintext-origin]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java"
line = 85
class = "security"
severity = "medium"
observed = "Programs accepts both http and https for any hostname, whereas HttpProductionTransport confines plaintext HTTP to loopback. This lets non-local program discovery, simulation and transaction submission traverse an unauthenticated transport."
expected = "Production RPC origins outside loopback must use authenticated HTTPS, matching the SDK production transport policy and the public node origins declared by the audit brief."
proposal = "Apply the same loopback-only HTTP exception in ProgramsClient.Programs endpoint validation and document how development origins are selected. Verify rejection of a remote plaintext origin and successful HTTPS calls to an authenticated test endpoint."
owner_domain = 8

[finding.program-rpc-refusals]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProgramsClient.java"
line = 98
class = "runtime-risk"
severity = "medium"
observed = "Programs.request converts every non-200 response to TRANSPORT_FAILURE with Retry.SAFE and every JSON-RPC error to CAPABILITY_REFUSAL with Retry.NEVER, discarding code and data. Temporary node failure, unsupported method and execution refusal become indistinguishable."
expected = "RPC refusal codes and mutation outcome uncertainty must survive transport decoding. Callers must be able to distinguish a retryable read failure, an execution revert and an uncertain eth_sendRawTransaction outcome."
proposal = "Decode the actual JSON-RPC error contract in ProgramsClient.java and preserve bounded safe code/data details and method-aware retry semantics. Cover node unavailability, execution revert, unsupported method and a lost broadcast response using real HTTP framing."
owner_domain = 8

[finding.http-body-deadline]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/HttpProductionTransport.java"
line = 234
class = "runtime-risk"
severity = "medium"
observed = "Both call and callAgentReply use BodyHandlers.ofInputStream and synchronously readNBytes after the response future supplies headers. The request timeout does not impose a body-consumption deadline on that returned stream, so a peer can send headers and stall indefinitely."
expected = "Production calls need a bounded overall completion time, including response-body consumption. Existing byte limits protect size but do not bound the time spent waiting for the remaining bytes."
proposal = "Implement a deadline-aware bounded body subscriber or explicit body cancellation in HttpProductionTransport.java for both planes. Test a real server that sends valid headers and stalls the body, preserving mutation unknown-outcome semantics."
owner_domain = 8

[finding.telemetry-outcome]
file = "sdk/platform/jvm/src/main/java/com/sidiora/layerx/sdk/ProductionClient.java"
line = 115
class = "runtime-risk"
severity = "medium"
observed = "execute returns the stage produced by whenComplete, whose callback directly invokes user-supplied Telemetry.record. If telemetry throws after a successful mutation, the returned operation stage becomes exceptional despite the successful service outcome."
expected = "Observability must preserve the operation result and must not turn a completed payment or approval into an apparent transport failure that encourages another attempt."
proposal = "Isolate telemetry delivery from operation completion in ProductionClient.java with an explicit bounded telemetry-error reporting policy. Verify that a throwing telemetry sink preserves both successful mutation results and original service failures."
