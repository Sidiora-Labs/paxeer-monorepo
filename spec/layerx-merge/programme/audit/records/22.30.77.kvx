line = 65
class = "runtime-risk"
severity = "medium"
observed = "validate rejects every new event once the lifetime seen set reaches 65536 IDs. accept never forgets an ID, so a healthy continuous stream eventually terminates with DECODE_FAILURE even though every cursor and event is valid."
expected = "A resumable production stream must remain usable beyond a fixed lifetime event count while maintaining bounded replay protection and enforcing its cursor ordering contract."
proposal = "Replace lifetime deduplication in ResumableStream.java with a bounded cursor-associated replay window or durable deduplication contract. Verify more than 65536 legitimate events, boundary replay refusal and restart from a persisted cursor."
