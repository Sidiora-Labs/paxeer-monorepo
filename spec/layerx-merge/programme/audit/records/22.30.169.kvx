proposal = "Pass the requested question schema into response validation in tools/jev/client.py; reject missing/unknown answers, wrong kinds and undeclared choices with JevRequestError. Preserve response/request digests and make the CLI report the failed evaluation rather than a clean advisory."
owner_domain = 16

[finding.jev-answer-numeric-bounds]
file = "tools/jev/client.py"
line = 105
class = "runtime-risk"
severity = "medium"
observed = "_number accepts nonfinite floats and unbounded numeric values; parse_answer uses it for noul probabilities, confidence and scores, and _probabilities does not enforce probability bounds. These values flow into finding confidence and automatic/escalation routing."
expected = "A probability/confidence is finite and within zero through one, and a score is finite and within the requested scale; malformed service output must not affect routing or appear as valid evidence."
proposal = "Validate finite bounded probabilities/confidence and requested score domains in tools/jev/client.py before constructing Answer objects. Require declared choice keys and coherent probability distributions, and add NaN, infinity, negative and over-range rejection cases."
owner_domain = 16

[finding.jev-missing-answer-test]
file = "tools/jev/tests/test_pr.py"
line = 443
class = "test-gap"
severity = "medium"
observed = "test_missing_answers_produce_no_findings deliberately accepts a response containing only an unrelated answer as an empty PR advisory. That assertion institutionalizes the missing-response failure path instead of proving completion of the requested review questions."
expected = "The PR review check must fail an incomplete or unrelated evaluation before claiming a clean report, while a complete response that finds no issue remains valid."
proposal = "Replace this acceptance case in tools/jev/tests/test_pr.py with a request-boundary failure assertion for missing/unrelated answers, and add a complete valid no-issue response case. Keep all honesty, commit anchoring and production-certification checks."
owner_domain = 16

