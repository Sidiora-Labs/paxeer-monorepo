class = "doc-drift"
severity = "medium"
observed = "Deployment Details names SID as Governance Token and a network-owned multisig transitioning to SID-holder governance as Initial Admin. Line 116 instead documents administrator governance by default, no required SID_ADDRESS, explicit token-mode opt-in and deployer authority when GOVERNANCE_ADMIN_ADDRESS is unset."
