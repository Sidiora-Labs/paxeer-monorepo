[finding.native-block-refresh]
file = "apps/explorer/ui/blocks/BlocksContent.tsx"
line = 63
class = "interface-mismatch"
severity = "high"
observed = "The blocks:new_block handler returns prevData when any cached block has the incoming height. Notifier.broadcast_price_updates (notifier.ex:710-724) deliberately republishes an existing block after native submissions arrive. BlockView adds those submissions to transactions_count and price_update_count, but this consumer discards the refreshed payload; an already displayed zero-transaction block remains zero until another fetch."
expected = "The declared block event lifecycle includes refreshed native submission counts as well as new heights. Native activity must reach the visible explorer through the actual notifier, Phoenix channel and browser cache path, including when native indexing finishes after EVM indexing (requirements 181173.1 and 181219.1)."
proposal = "Update apps/explorer/ui/blocks/BlocksContent.tsx to replace the matching cached canonical block on a refresh and reconcile a changed hash at the same height according to list type. Preserve pagination and overload limits. Extend BlocksContent.spec.tsx with an initial EVM-only block followed by the actual notifier shape carrying native counts, and assert the displayed count changes without a refetch."
owner_domain = 14
interface = "14.ws-explorer-push-blocks-new-block-new-block-l720"
related_interfaces = ["14.ws-explorer-push-blocks-new-block-new-block", "14.ws-explorer-channel-socket-v2-blocks", "14.ws-explorer-join-socket-v2-blocks-common"]

