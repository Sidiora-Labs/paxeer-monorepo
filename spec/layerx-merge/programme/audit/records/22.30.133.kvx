[finding.flashblock-reconnect]
file = "apps/explorer/ui/blocks/flashblocks/useFlashblocksSocketData.ts"
line = 113
class = "restart-recovery"
severity = "medium"
observed = "onclose and onerror only set status. connect runs once at mount and resume merely clears the pause flag and notice count. Flashblocks.handleAlertLinkClick uses that resume path, so its error recovery action leaves a closed WebSocket closed and the feed disconnected."
expected = "An enabled feed must be able to establish a fresh subscription after a transient outage when the user invokes the offered recovery action."
proposal = "Expose a bounded reconnect action in useFlashblocksSocketData.ts that disposes the old socket and timer, reconnects and confirms subscription. Wire the error action to it and cover close, retry, resubscription and delivery of the next protocol-shaped item."
owner_domain = 14

[finding.flashblock-tail-flush]
file = "apps/explorer/ui/blocks/flashblocks/useFlashblocksSocketData.ts"
line = 66
class = "runtime-risk"
severity = "medium"
observed = "Messages received within QUEUE_TIME_THRESHOLD are queued, but the queue is flushed only when a later message arrives after the threshold. No timer flushes the tail; a final burst followed by silence can leave received items and transaction counts undisplayed indefinitely."
expected = "Every accepted message must be reflected within the batching interval even if it is the last message before the connection becomes idle."
proposal = "Schedule one bounded flush when the queue becomes nonempty, cancel it during cleanup and share flush logic with message processing. Cover a short burst followed by silence and assert all queued items and their transaction counts appear without another message."
owner_domain = 14

[finding.flashblock-text-frame]
file = "apps/explorer/ui/blocks/flashblocks/parseSocketEventData.tsx"
line = 7
class = "runtime-risk"
severity = "medium"
observed = "The Optimism parser calls event.data.text() before checking JSON content. Browser WebSocket text frames provide strings rather than Blobs, so a valid JSON text frame throws before parsing and returns undefined. The hook drops that item while its status can remain connected."
expected = "Supported JSON and compressed binary encodings must be decoded from the actual browser WebSocket data types, and malformed or unsupported frames must produce observable feed errors."
proposal = "Branch on string versus Blob/ArrayBuffer in parseSocketEventData.tsx, preserve compressed decoding and validate the item before formatting. Cover actual text and binary WebSocket frames and propagate parse failure to feed status."
owner_domain = 14

