[finding.1]
file = "services/launchpad/social/internal/app/app.go"
line = 295
class = "wiring-gap"
severity = "high"
observed = "The container/owned_local production branch registers connected chat, interaction and safety handlers but creates no devsocial.Runtime. Frozen comments, callouts, bounties and report routes are registered only when dev != nil. For example POST /v2/callouts is absent although registry 4.http-social-post-v2-callouts, gateway FrozenConnectedSurface and SDK createCallout advertise it. Production topology.py selects RUNTIME_PROFILE=container."
