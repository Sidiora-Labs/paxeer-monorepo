[interface_review.configuration]
rows = ["14.cfg-indexer-block-interval", "14.cfg-indexer-blocks-concurrency", "14.cfg-indexer-ecto-repos", "14.cfg-indexer-indexer-fetcher-ondemand-coinbalance-supervisor", "14.cfg-indexer-indexer-fetcher-ondemand-tokenbalance-supervisor", "14.cfg-indexer-indexer-tracer", "14.cfg-indexer-json-rpc-named-arguments", "14.cfg-indexer-subscribe-named-arguments", "14.cfg-logger-addresses-without-code", "14.cfg-logger-block-import-timings", "14.cfg-logger-empty-blocks-to-refetch", "14.cfg-logger-failed-contract-creations", "14.cfg-logger-indexer", "14.cfg-logger-indexer-token-balances", "14.cfg-logger-pending-transactions-to-refetch", "14.cfg-logger-withdrawal", "14.cfg-os-mon-start-cpu-sup", "14.cfg-os-mon-start-disksup", "14.cfg-os-mon-start-memsup", "14.env-indexer-catchup-block-interval", "14.cfg-explorer-celo", "14.cfg-explorer-chain-type", "14.cfg-explorer-explorer-account", "14.cfg-explorer-explorer-chain-tokentransfer", "14.cfg-explorer-explorer-chain-transaction", "14.cfg-explorer-explorer-migrator-backfillmetadataurl", "14.cfg-explorer-explorer-migrator-deletezerovalueinternaltransactions", "14.cfg-explorer-explorer-migrator-heavydbindexoperation", "14.cfg-explorer-explorer-migrator-reindexblockswithmissingtransactions", "14.cfg-explorer-explorer-migrator-sanitizeduplicatedlogindexlogs", "14.cfg-explorer-explorer-migrator-sanitizeincorrectwethtokentransfers", "14.cfg-explorer-explorer-migrator-shrinkinternaltransactions", "14.cfg-explorer-explorer-thirdpartyintegrations-dynamic", "14.cfg-explorer-explorer-thirdpartyintegrations-keycloak", "14.cfg-explorer-explorer-thirdpartyintegrations-novesfi", "14.cfg-explorer-explorer-thirdpartyintegrations-solidityscan", "14.cfg-explorer-explorer-thirdpartyintegrations-universalproxy", "14.cfg-explorer-explorer-thirdpartyintegrations-xname", "14.cfg-explorer-json-rpc-named-arguments", "14.cfg-explorer-supply", "14.cfg-fe-app-ispw", "14.cfg-fe-chain-hasmultiplegascurrencies", "14.cfg-fe-chain-name", "14.cfg-fe-feature-addressmetadata", "14.cfg-fe-feature-advancedfilter", "14.cfg-fe-feature-apidocs", "14.cfg-fe-feature-bridgedtokens", "14.cfg-fe-feature-dataavailability", "14.cfg-fe-feature-rollup", "14.cfg-fe-feature-stats", "14.cfg-fe-feature-txinterpretation", "14.cfg-fe-feature-verifiedtokens", "14.cfg-fe-ui-views", "14.cfg-fe-ui-views-nft", "14.cfg-fe-ui-views-tx", "14.cfg-indexer-block-ranges", "14.cfg-indexer-fetcher-init-limit", "14.cfg-indexer-indexer-block-catchup-missingrangescollector", "14.cfg-indexer-indexer-fetcher-beacon-blob", "14.cfg-indexer-indexer-fetcher-beacon-blob-supervisor", "14.cfg-indexer-indexer-fetcher-internaltransaction", "14.cfg-indexer-indexer-fetcher-internaltransaction-supervisor", "14.cfg-indexer-indexer-fetcher-optimism", "14.cfg-indexer-indexer-fetcher-optimism-interop-messagequeue", "14.cfg-indexer-indexer-fetcher-optimism-operatorfee", "14.cfg-indexer-indexer-fetcher-tokeninstance-helper", "14.cfg-indexer-indexer-migrator-recoverywethtokentransfers", "14.cfg-indexer-indexer-supervisor", "14.cfg-indexer-receipts-concurrency", "14.cfg-indexer-trace-first-block", "14.cfg-ueberauth-ueberauth-strategy-auth0-oauth", "14.cfg-web-web-chain", "14.env-ethereum-jsonrpc-fallback-ws-url", "14.env-ethereum-jsonrpc-transport", "14.env-ethereum-jsonrpc-ws-url", "14.env-fe-next-public-stats-api-host"]
agreement = "Indexer profiles supply named HTTP/IPC transports, URL pools and trace methods to the fetchers; PaxeerX uses debug_traceTransaction/debug_traceBlockByNumber. Runtime environment overrides supply worker limits and module flags. Logger backends and os_mon consume their own application settings. Optional chain configurations are selected by chain type. Auth0/Keycloak metadata and proxy configuration lifecycle defects are recorded separately."

[interface_review.http]
rows = ["14.http-get-api-v2-addresses", "14.http-get-api-v2-stats", "14.http-get-api-v2-transactions", "14.http-get-api-v2-transactions-stats", "14.http-get-api-v2-transactions-transaction-hash-param"]
agreement = "Transaction list/detail and stats route declarations feed the UI API resources with hashes, decimal amounts, nullable pending fields and next_page_params. Stats total_transactions is not a pending counter. Mixed transaction types fail at restrictive joins as recorded. Address entity hashes use checksum encoding. No typecheck or dependency upgrade is established by an audit record."

[interface_review.websocket]
rows = ["14.ws-explorer-channel-socket-v2-addresses", "14.ws-explorer-channel-socket-v2-tokens", "14.ws-explorer-channel-socket-v2-transactions", "14.ws-explorer-join-socket-v2-addresses-address-hash-string", "14.ws-explorer-join-socket-v2-tokens-transaction-hash", "14.ws-explorer-join-socket-v2-transactions-new-pending-transaction", "14.ws-explorer-join-socket-v2-transactions-new-transaction", "14.ws-explorer-join-socket-v2-transactions-transaction-hash", "14.ws-explorer-push-tokens-hash-token-transfer", "14.ws-explorer-push-transactions-new-transaction-transaction"]
agreement = "Phoenix /socket/v2 channels carry transaction count notifications on global topics, transaction arrays on address topics and token_transfer counts on token-contract topics. Topics use lowercase hex; rendered nested addresses use checksums. The token_channel variable named transaction_hash holds a token contract hash in this flow. Numeric notification guards in useTxsSocketTypeAll match notifier counters. Address case and sorted-cache disagreements are recorded; reconnect shows an error/reload notice rather than durable event replay."

[interface_review.external]
rows = ["4.sevt-ieventemitter-tokentransfer-d1630e8d", "6.sol-cw721erc721pointer-transferfrom-23b872dd", "6.sol-erc721-safetransferfrom-42842e0e", "6.sol-erc721-safetransferfrom-b88d4fde", "6.sol-erc721-transferfrom-23b872dd", "6.sol-ierc721-safetransferfrom-42842e0e", "6.sol-ierc721-safetransferfrom-b88d4fde", "6.sol-ierc721-transferfrom-23b872dd", "7.rpc-debug-traceblockbynumber", "7.rpc-debug-tracetransaction", "7.rpc-eth-getbalance", "7.rpc-eth-getblocktransactioncountbynumber", "8.err-gateway-insufficient-scope", "14.met-explorer-batch-average-time"]
agreement = "ERC721 transferFrom and both safeTransferFrom selectors and address/uint256 argument layouts match the chain ABI decoding declarations. eth_getBalance and transaction-count quantities use hex RPC encoding; debug tracing is routed over HTTP to the selected node variant. The launchpad TokenTransfer registry association to a generic UI fixture is not producer-path proof and is recorded as a test gap. Batch timing is a seconds-valued rollup metric. Gateway insufficient_scope is a hosted HTTP 403, distinct from node JSON-RPC errors."

[finding.doc-token-topic]
file = "spec/layerx-merge/contracts/explorer-ws.md"
line = 207
class = "doc-drift"
severity = "medium"
observed = "The topic contract labels tokens:<transaction_hash> on /socket/v2. TokenTransfer.tsx actually subscribes with the token contract address, and the notifier broadcasts token_transfer on that token address; a client following the documented transaction hash would join an accepted but silent topic."
expected = "The topic suffix must describe the token contract address used by producer and consumer, including lowercase hex encoding, rather than an individual transaction hash."
proposal = "Correct the topic terminology in spec/layerx-merge/interfaces.kvx row 14.ws-explorer-join-socket-v2-tokens-transaction-hash and regenerate spec/layerx-merge/contracts/explorer-ws.md; document the token address and assert a real token-transfer notification reaches that subscription."
owner_domain = 14
interface = "14.ws-explorer-join-socket-v2-tokens-transaction-hash"
