[finding.address-case]
file = "apps/explorer/ui/txs/socket/useTxsSocketTypeAddress.tsx"
line = 26
class = "interface-mismatch"
severity = "high"
observed = "matchFilter compares transaction.from.hash and transaction.to.hash to the raw router hash with ===. The notifier renders addresses with V2.Helper.address_with_info, whose hash uses Address.checksum, while the subscription lowercases the topic. An all-lowercase URL for a mixed-case checksum address joins successfully but drops new incoming or outgoing transactions."
expected = "The addresses channel must deliver the same address transactions regardless of valid EVM address letter casing; producer, Phoenix transport and filtered consumer must agree on address identity."
proposal = "In apps/explorer/ui/txs/socket/useTxsSocketTypeAddress.tsx normalize both sides of matchFilter and prove incoming, outgoing and self-transfer updates through the notifier and channel for lowercase and checksummed URLs."
owner_domain = 14
interface = "14.ws-explorer-join-socket-v2-addresses-address-hash-string"

[finding.address-sorted-cache]
file = "apps/explorer/ui/txs/socket/useTxsSocketTypeAddress.tsx"
line = 54
class = "wiring-gap"
severity = "medium"
observed = "handleNewSocketMessage constructs general:address_txs cache keys with hash, filter and chainId only. useAddressTxsQuery passes sort and order to useQueryWithPages, so a nondefault sorted list has a different key and receives no live update even though this hook reads the selected sort."
expected = "An enabled address subscription must update the active query, including its sorting parameters, or clearly require a reload instead of silently updating another cache entry."
proposal = "Use the active address query key in apps/explorer/ui/txs/socket/useTxsSocketTypeAddress.tsx and test a first-page value/fee sorted query receiving a real channel update."
owner_domain = 14

[finding.transaction-type-union]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/transaction.ex"
line = 2686
class = "interface-mismatch"
severity = "high"
observed = "apply_filter_by_type_to_transactions_inner accumulates OR predicates but adds INNER JOINs for contract_call and token_creation. A request including contract_creation and contract_call loses creations with NULL to_address; adding token_creation similarly excludes ordinary calls or coin transfers before the OR predicate can match."
expected = "GET /api/v2/transactions accepts a comma-separated type filter via PagingHelper.parse_filter. Multiple accepted types must return their union, including creation transactions with no destination address."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/transaction.ex use conditional EXISTS predicates or nonrestrictive joins for each type and exercise mixed type filters through TransactionController with real indexed transactions."
owner_domain = 14
interface = "14.http-get-api-v2-transactions"

[finding.last-nonce-order]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/transaction.ex"
line = 1467
class = "dead-code"
severity = "low"
observed = "last_nonce_by_address_query has no in-tree caller in the explorer applications. Its dormant implementation orders only by block_number DESC and limits to one, leaving same-block sender nonces without a tie breaker and pending NULL block numbers ahead of mined rows."
expected = "The explorer should expose a live, well-defined nonce query only when a caller needs it; a future last-nonce reader must distinguish same-block and pending transactions."
proposal = "Remove the unused helper in services/explorer/backend/apps/explorer/lib/explorer/chain/transaction.ex or wire a real caller with explicit confirmed/pending semantics and complete nonce ordering; cover same-block, pending and replacement cases if retained."
owner_domain = 14

[finding.rows-holders]
file = "apps/explorer/ui/token/TokenHolders/TokenHolders.tsx"
line = 40
class = "runtime-risk"
severity = "medium"
observed = "The holders view slices the fetched API page with rowsToShow, while ScanShowRows changes only local state. The shared selector offers 25, 50 and 100, but page navigation advances using the original server next_page_params. Selecting 25 from a 50-row page hides rows 26 through 50 and Next advances past them; selecting 100 cannot fetch a second page."
expected = "The visible row-count control must preserve access to every record and make its page size agree with the cursor that advances the server result."
proposal = "In apps/explorer/ui/token/TokenHolders/TokenHolders.tsx connect the selection to supported API paging or render local subpages before advancing the server cursor; exercise a 50-row response, select 25, and traverse every record without omission."
owner_domain = 14

