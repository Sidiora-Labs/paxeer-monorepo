line = 3
class = "doc-drift"
severity = "medium"
observed = "Lines 3-15 describe two separately executing network domains joined by proof verification; lines 17 onward advertise live LayerXVerify, custody and anchor precompiles, while line 11 names cmd/layerxd as the active core node."
expected = "There is one merged execution domain in paxd. Retired 0x1012-0x1014 methods refuse after upgrade, and committed headers and chain state replace the separate evidence connector."
proposal = "Rewrite docs/wiki/UnifiedNetwork.md around native kernel constructs in paxd, current precompile responsibilities and explicit retired-method refusals; replace the daemon and two-domain connector diagrams."
owner_domain = 6

[finding.doc-programs-daemon]
file = "docs/site/docs/programs/workspace.md"
line = 156
class = "doc-drift"
severity = "medium"
observed = "The programs-differential build recipe lists cmd/layerxd/lxp_daemon_batch_wal.c as a current prerequisite, embedding the retired daemon WAL in the documented program qualification workflow."
expected = "Program qualification for the merged runtime must describe the in-node host and current replay/recovery evidence without requiring a retired layerxd implementation."
proposal = "Update docs/site/docs/programs/workspace.md with the current merged-host differential and recovery recipe and its actual prerequisites; retain the frozen ABI rules and distinguish host libraries from guest deployment builds."
owner_domain = 2

[finding.doc-route-ws]
file = "docs/system/routes.md"
line = 908
class = "doc-drift"
severity = "medium"
observed = "The public route catalogue still lists GET /rpc/evm/ws as a developer WebSocket route with gateway-api-key authentication. This preserves a router-prefixed EVM endpoint in the inventory that integrators use to discover supported access."
expected = "The merged public node RPC is rooted at the mainnet-beta API hosts and must be distinguished from hosted gateway-only APIs; retired /rpc routes must not be advertised as the node transport."
proposal = "Regenerate docs/system/routes.md from the current route ownership and expose the supported node WebSocket location, keeping hosted gateway endpoints separate from public chain RPC."
owner_domain = 8

