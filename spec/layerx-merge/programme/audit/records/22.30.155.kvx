[finding.total-holder]
file = "apps/explorer/ui/token/TokenHolders/TokenHolders.tsx"
line = 70
class = "runtime-risk"
severity = "medium"
observed = "When the optional total is absent, the holder title treats hasNextPage=false as proof that itemsNum is the global total. A final page reached after earlier pages therefore labels its own short row count as the total, and local row slicing can understate even a single fetched page."
expected = "A page cursor ending the list does not establish the global count; titles must distinguish current-page rows from a verified total."
proposal = "In apps/explorer/ui/token/TokenHolders/TokenHolders.tsx show a page count when no authoritative total is supplied and add a final-page case after at least one earlier page."
owner_domain = 14

