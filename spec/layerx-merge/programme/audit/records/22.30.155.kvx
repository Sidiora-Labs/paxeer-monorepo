[finding.pending-stat-total]
file = "apps/explorer/ui/txs/TxsContent.tsx"
line = 163
class = "runtime-risk"
severity = "medium"
observed = "isChainWideList includes txs_pending, but countLine uses general:stats.total_transactions for both validated and pending views. StatsView supplies the chain transaction count rather than the number of pending transactions, so the pending heading can claim the mined-history total."
expected = "Pending transaction list counts must describe pending transactions, with unavailable totals shown as page counts rather than substituted chain-history totals."
proposal = "In apps/explorer/ui/txs/TxsContent.tsx select a matching pending counter when available or use current-page wording, and assert the pending title with distinct mined and pending counts."
owner_domain = 14

[finding.auth0-new-user-id]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/migrated.ex"
line = 115
class = "runtime-risk"
severity = "medium"
observed = "handle_not_found_just_created_email_user writes namespaced metadata with sub, name, nickname and picture, then calls create_auth. create_auth reads metadata.user_id and get_user_by_id_from_session searches that same field, so this just-created-user path emits a nil uid and cannot recover the user from the session."
expected = "An authenticated email user must receive one stable identity field that survives creation, session storage and later Auth0 lookup in the application namespace."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/migrated.ex map the verified sub to the canonical user_id metadata field and test the fresh-user fallback followed by session lookup and restart."
owner_domain = 14

[finding.auth0-link-envelope]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/migrated.ex"
line = 51
class = "runtime-risk"
severity = "medium"
observed = "link_email passes user_without_email_metadata directly as the PATCH body to Internal.update_user, which sends that map unchanged to the Auth0 Users API. Other migrated paths wrap this data in user_metadata and the application identifier; this path sends user_id and wallet/profile fields at the top level instead."
expected = "Linking an email must preserve the source application identity in the destination application metadata and return a user that create_auth and get_user_by_id_from_session can read."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/migrated.ex construct the namespaced user_metadata PATCH envelope and validate the destination readback before changing source metadata; test retry and interrupted linking."
owner_domain = 14

[finding.auth0-link-errors]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/legacy.ex"
line = 167
class = "restart-recovery"
severity = "medium"
observed = "maybe_link_email and merge_email_users discard the results of link_users and maybe_verify_email and return {:ok, user}. Account.merge can already have changed local identities before the remote link fails, leaving authentication reporting success without the external link and without a durable retry phase."
expected = "Local identity consolidation and remote provider linking must expose failure and support idempotent continuation after provider failure or process restart."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/legacy.ex propagate remote failures, persist linking progress where local state has changed, and cover remote refusal and restart after local merge."
owner_domain = 14

[finding.auth0-token-validation]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/internal.ex"
line = 256
class = "security"
severity = "medium"
observed = "get_user_from_token extracts identity claims using Joken.peek_claims and accepts any decoded map containing sub. It does not validate the ID-token signature, issuer, audience or expiry before the claims drive user metadata and authentication fallback paths."
expected = "Identity claims used to create or recover an explorer account must be verified for the configured provider and client; decoding a JWT is not signature or claim validation."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/internal.ex verify the ID token against the configured issuer and client before using sub, and cover wrong issuer/audience, expiry and tampered signatures."
owner_domain = 14

[finding.keycloak-otp-consumption]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/keycloak.ex"
line = 366
class = "security"
severity = "medium"
observed = "verify_otp performs GET/decrypt/compare and DEL as separate Redis operations, ignores the deletion result, and returns :ok. Concurrent requests can read and accept the same OTP; a failed DEL also leaves a successfully accepted code reusable."
expected = "A one-time code must be consumed atomically once, and failed consumption must not authorize another login or email-link operation."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/keycloak.ex atomically compare and consume the stored code with a Redis transaction or script and test concurrent confirmation and Redis failure."
owner_domain = 14

[finding.keycloak-cache-recovery]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/keycloak.ex"
line = 275
class = "restart-recovery"
severity = "medium"
observed = "get_admin_token returns decryption_failed for an unreadable cached token without invalidating it or obtaining a fresh provider token. After encryption-key change or a corrupt cache entry, every account-management operation keeps failing until the old TTL expires."
expected = "A cached administrative token is replaceable state; cache corruption after restart must permit authenticated token reacquisition without waiting for the stale entry to expire."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/keycloak.ex evict an undecryptable cached token and reacquire through the configured client-credentials flow with bounded errors; exercise a persisted unreadable cache entry after restart."
owner_domain = 14

[finding.proxy-binary-drop]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/universal_proxy/socket_handler.ex"
line = 46
class = "runtime-risk"
severity = "medium"
observed = "SocketHandler forwards client text frames but sends all other incoming frames to a catch-all returning {:ok, state}; binary messages are silently discarded. TargetClient.handle_frame explicitly relays binary messages in the opposite direction, so the advertised bidirectional WebSocket proxy is asymmetric."
expected = "A WebSocket relay must preserve supported frame kinds in both directions or explicitly reject unsupported client frames rather than silently dropping application data."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/universal_proxy/socket_handler.ex and target_client.ex preserve frame types through forward and add a real binary round trip plus upstream-disconnect cleanup coverage."
owner_domain = 14

[finding.proxy-config-shape]
file = "services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/universal_proxy.ex"
line = 376
class = "config-drift"
severity = "medium"
observed = "safe_parse_config_string accepts every successfully decoded JSON value and parse_proxy_params immediately indexes config[\"platforms\"]. Valid JSON such as null, a number, or an array can therefore crash the public proxy path instead of producing its configured validation error; a missing URI scheme also reaches String.to_atom(nil)."
expected = "A supplied proxy configuration must be checked as a typed platform/endpoint map with allowed protocols before routes use it, and invalid configuration must produce a bounded actionable failure."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/universal_proxy.ex validate the configuration schema and URI scheme before caching or route construction, and cover valid JSON with invalid shapes and malformed endpoint URLs."
owner_domain = 14

[finding.interop-empty-inclusion]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex"
line = 612
class = "runtime-risk"
severity = "medium"
observed = "filter_process_address_inclusion subtracts excluded addresses from included addresses and returns nil when the result is empty. filter_messages_by_address treats nil as no filter, so including an address and excluding that same address can expand the result to all senders or targets."
expected = "The intersection of an explicit inclusion set with its exclusion complement must yield no records when empty, never disable the filter."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex distinguish no filter from an empty inclusion set and assert that complete include/exclude overlap returns zero messages."
owner_domain = 14

[finding.interop-page-boundary]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex"
line = 329
class = "runtime-risk"
severity = "medium"
observed = "list orders by timestamp and init_transaction_hash and page_messages uses only those two fields as its exclusive cursor. Multiple messages with distinct nonces can originate in one transaction and share both fields, so a page ending partway through that transaction skips its remaining messages."
expected = "Paginated interop history must traverse every message exactly once, including multiple messages emitted by one transaction at one timestamp."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex add a stable unique message tie breaker to ordering, API cursor generation and decoding, and test a page boundary inside a multi-message transaction."
owner_domain = 14

[finding.interop-cursor-filter]
file = "services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex"
line = 671
class = "runtime-risk"
severity = "medium"
observed = "page_messages appends where(timestamp < cursor) then or_where(timestamp == cursor and hash < cursor_hash) to a query already constrained by filter_messages. The OR branch can satisfy the query without the earlier sender, target, status or chain-direction constraints."
expected = "Every page must retain all requested filters; the two cursor branches must form one grouped predicate ANDed with the existing query."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex group both cursor alternatives in one where expression and cover a tied timestamp containing matching and nonmatching senders/statuses."
owner_domain = 14

[finding.selfdestruct-rule]
file = "services/explorer/backend/apps/explorer/test/explorer/migrator/empty_bytecode_for_selfdestructed_smart_contracts_test.exs"
line = 35
class = "test-gap"
severity = "high"
observed = "The tests require emptying code for a pre-existing selfdestructed contract and preserving code for a contract created and destroyed in the same transaction. The migration implements that rule, but the Cancun SelfDestruct6780 path in modules/evm/state/state.go preserves existing contracts and deletes newly created ones; the tests endorse erasing live explorer contract code when the migration is invoked on current-chain history."
expected = "Explorer code must agree with eth_getCode and the chain fork rules. A repair migration must not delete code for a live post-Cancun contract, and its tests must prove the real trace/state relationship."
proposal = "In services/explorer/backend/apps/explorer/lib/explorer/migrator/empty_bytecode_for_selfdestructed_smart_contracts.ex scope historical repair to applicable fork semantics and verify code at the relevant committed height before updating; replace the asserted policy in the matching tests with real pre/post-fork execution, same-transaction creation and redeployment cases."
owner_domain = 14

[finding.launchpad-event-proof]
file = "apps/explorer/ui/token/TokenTransfer/TokenTransfer.spec.tsx"
line = 57
class = "test-gap"
severity = "medium"
observed = "The registry lists this UI test as a consumer of IEventEmitter.TokenTransfer(address,address,address,uint256,uint256,uint256), topic d1630e8d. The test supplies already-rendered generic token-transfer fixtures through mocked HTTP/socket endpoints; it never decodes that declared event or proves its value/timestamp/blockNumber fields reach the explorer response."
expected = "A declared launchpad event consumer needs proof from the actual emitted event through the indexer and explorer API to the token-transfer view; a generic API fixture alone cannot establish that agreement."
proposal = "Add a real launchpad emitter-to-indexer-to-explorer token-transfer case across contracts/launchpad, services/launchpad/indexer and the explorer API; correct the registry caller relationship if this generic UI test is not an event consumer."
owner_domain = 4
interface = "4.sevt-ieventemitter-tokentransfer-d1630e8d"

