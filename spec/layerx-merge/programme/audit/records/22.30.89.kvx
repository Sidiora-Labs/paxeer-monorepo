[finding.wallet_bind_rpc]
file = "tools/platform/cli/src/wallet_derive.rs"
line = 124
class = "interface-mismatch"
severity = "high"
observed = "bind calls eth_chainId and eth_call through the CLI RpcClient, but src/rpc.rs:80 rejects both names and its response decoder does not accept their string results. Its later eth_estimateGas request at line145 also omits pending and the required full EIP1559 object, so --bind cannot submit even after the first refusal is fixed."
expected = "The wallet derive --bind interface must resolve chain125 and binding nonce, recognize an existing DID binding, estimate the actual EVM call and submit the signed bind through one compatible transport."
proposal = "Update tools/platform/cli/src/rpc.rs and src/wallet_derive.rs together to admit and decode the required Ethereum reads and construct the complete pending estimate. Add a successful bind and already-bound integration path using the real binding precompile and unchanged RPC responses."
owner_domain = 8
interface = "8.cli-cli-layerx-wallet-derive-bind"

[finding.wallet_balance_shape]
file = "tools/platform/cli/src/wallet.rs"
line = 1511
class = "interface-mismatch"
severity = "high"
observed = "verified_account_snapshot forwards SDK get_balances into validated_account_records, which requires did, verification=state_proven and an accounts array containing proof and source-sequence fields. services/platform/hosted/gateway/src/paxeer.rs:811 instead emits account, height and balances of denom/amount; SDK rpc.rs:884 does not translate this result. Live wallet balance and debit selection refuse it."
expected = "The wallet balance command and gateway px_getBalances producer must agree on account identity, asset units, committed height and the evidence available to authorize source-account selection."
proposal = "Have tools/platform/cli/src/wallet.rs, services/agent/crates/layerx-sdk/src/rpc.rs and services/platform/hosted/gateway/src/paxeer.rs adopt one declared balances schema. Obtain real ledger account evidence where writes require it, and qualify an unchanged gateway response through the installed CLI; never invent state_proven labels."
owner_domain = 8
interface = "9.rs-sdk-rpc-rpcclient"

[finding.wallet_account_shape]
file = "tools/platform/cli/src/wallet.rs"
line = 1240
class = "interface-mismatch"
severity = "high"
observed = "prepare_send asks SDK get_account for a 32-byte ledger account id and demands top-level account_id, asset_id and next_sequence. The registered px_getAccount implementation in gateway paxeer.rs:584 resolves an account/DID into account and paxeer.address/balance/nonce/height instead; it does not emit the source-ledger fields the CLI reads."
expected = "The declared account query must round-trip the identity and independent source-ledger sequence used to authorize Send; an EVM transaction nonce cannot substitute for that source sequence."
proposal = "Align tools/platform/cli/src/wallet.rs and the SDK account API with a declared gateway or node ledger-account query carrying authenticated account_id, asset_id and source sequence. Keep EVM nonce separate and drive a real gateway Send preparation with independently changing source and EVM sequences."
owner_domain = 8
interface = "8.rpc-gateway-px-getaccount"

[finding.wallet_assets_shape]
file = "tools/platform/cli/src/wallet.rs"
line = 715
class = "interface-mismatch"
severity = "high"
observed = "Token list calls SDK list_assets_page, and token info reaches the same API through get_asset; its decoder requires next_cursor and authenticated_committed_snapshot/state_root/observed_head_sequence plus native AssetMetadata. Gateway paxeer.rs:755 accepts no pagination parameters and emits height/assets/joined_limit with custody metadata. Default pages fail decoding, and explicit cursor/limit requests return -32602."
expected = "The CLI token list/info commands, SDK page decoder and px_listAssets registry contract must agree on pagination, ordering, metadata units and available committed-state evidence."
proposal = "Unify the gateway OpenRPC contract, services/platform/hosted/gateway/src/paxeer.rs, services/agent/crates/layerx-sdk/src/rpc.rs and tools/platform/cli/src/wallet.rs around the current asset listing product. Define supported paging and proof fields explicitly and prove default and subsequent pages through the real producer."
owner_domain = 8
interface = "8.rpc-gateway-px-listassets"

[finding.credential_profile_key_loss]
file = "tools/platform/cli/src/credential.rs"
line = 86
class = "security"
severity = "high"
observed = "The OS backend stores every key under service dev.layerx.cli and identity key:<name>, independent of LAYERX_CONFIG. create/import checks only the current configuration map, then set_password replaces an existing same-name key from another configuration. A failed configuration save deletes that credential during rollback, potentially destroying the original seed."
expected = "Separate CLI configurations must not overwrite or delete each other's signing material; publishing a new wallet must preserve any previously stored key through both success and save failure."
proposal = "Give OS entries in tools/platform/cli/src/credential.rs a stable configuration namespace, refuse existing secret replacement during creation, and migrate old aliases explicitly with public-key checks. Exercise two real OS-backed configurations using the same key name and a failed metadata save without losing either seed."
owner_domain = 8

[finding.mcp_enrollment_shape]
file = "tools/platform/cli/src/install/mcp.rs"
line = 42
class = "interface-mismatch"
severity = "high"
observed = "platform_install_mcp opens the document written by BindingPublisher, but agentd enrolment.rs:807 publishes core_sequence and no agent.readiness. layerx-mcp binding.rs:618 explicitly rejects core_sequence, requires core_height at line664 and requires authenticated readiness for daemon clients. An unmodified genuine enrollment cannot be installed or served."
expected = "The enrolled daemon binding must be accepted unchanged by the MCP installation and serving consumers, with current height semantics and authenticated readiness configuration that survive reopening."
proposal = "Update services/agent/crates/layerx-agentd/src/enrolment.rs to publish the current layerx-mcp binding schema, including core_height and the declared readiness transport. Qualify tools/platform/cli installation and serving against that exact output before and after restart, without rewriting fixture documents."
owner_domain = 9
interface = "9.rs-agentd-enrolment-bindingpublisher"

[finding.a2a_task_recovery]
file = "tools/platform/cli/src/a2a.rs"
line = 305
class = "restart-recovery"
severity = "medium"
observed = "A2A executes activity.submit before inserting its task into a process-local BTreeMap. On reaching MAX_TRACKED_TASKS it removes the first lexicographic id without protecting submitted or unknown transactions. Restart, a crash after submission or capacity eviction loses the task and its reconciliation hash."
expected = "A client must be able to recover an accepted or indeterminate payment task after restart and must not lose unresolved tasks because another request fills a bounded cache."
proposal = "Persist task identity and signed-transaction hash in tools/platform/cli/src/a2a.rs before submission, journal the resulting status atomically, and reload/reconcile unresolved tasks on start. Refuse capacity safely or evict only terminal retained history; test restart after a lost response and at the task limit."
owner_domain = 8

[finding.wallet_submission_recovery]
file = "tools/platform/cli/src/wallet.rs"
line = 912
class = "restart-recovery"
severity = "medium"
observed = "execute_write has expected_hash from the exact signed bytes, but send_raw_transaction.map_err(rpc_error) returns an ordinary transport error before printing that hash. If the node accepted the bytes and its reply was lost, the command gives the operator no transaction identity to reconcile."
expected = "A wallet submission with an indeterminate reply must expose the local transaction hash and an unknown/pending outcome without suggesting that a retry is a new payment."
proposal = "Use the existing expected_hash in tools/platform/cli/src/wallet.rs to report and retain indeterminate submissions, then reconcile that hash through node receipts. Exercise an accepted transaction whose HTTP response is lost and prove recovery without issuing a second signed transaction."
owner_domain = 8

[finding.program_submission_recovery]
file = "tools/platform/cli/src/programs.rs"
line = 1603
class = "restart-recovery"
severity = "medium"
observed = "submit_program_transaction propagates rpc_call failure before submitted_program_result computes the local transaction hash. A lost response after a deploy, upgrade or call was accepted therefore produces only an error with no recoverable hash."
expected = "Program writes must retain the hash of the exact submitted bytes when transport failure leaves acceptance unknown, so operators can discover the eventual committed result."
proposal = "Compute and retain the local transaction hash before sending in tools/platform/cli/src/programs.rs, classify unsent/refused/indeterminate outcomes and include the hash in the latter. Qualify a lost-response deployment and subsequent receipt reconciliation without resubmitting different bytes."
owner_domain = 8

[finding.chain_submission_recovery]
file = "tools/platform/cli/src/chains.rs"
line = 336
class = "restart-recovery"
severity = "medium"
observed = "Chain creation computes hash before eth_sendRawTransaction but propagates rpc errors with ? before returning it. A successfully accepted tenant creation followed by a lost HTTP response leaves only an error, unlike the later pending-receipt timeout which includes hash."
expected = "Tenant creation must expose a stable reconciliation identity whenever acceptance is unknown, so a user can recover the tenant rather than paying for a second creation."
proposal = "Preserve hash in the indeterminate submission result in tools/platform/cli/src/chains.rs and provide receipt/domain reconciliation by that hash. Exercise node acceptance followed by response loss and resume discovery using the original transaction."
owner_domain = 8

[finding.tool_submit_recovery]
file = "tools/platform/cli/src/toolset.rs"
line = 291
class = "restart-recovery"
severity = "medium"
observed = "The generic submit wrapper discards tx_hash from SubmitFailure::Indeterminate and returns only detail; invoke_task correctly keeps txHash and rung unknown. Callers of the ordinary invoke entry point therefore lose the same recovery identity that A2A retains."
expected = "Every exposed raw-transaction submission path must retain the locally computed hash when the transport cannot determine whether the node accepted it."
proposal = "Align submit and invoke_task in tools/platform/cli/src/toolset.rs around one structured indeterminate result containing txHash and unknown status. Keep explicit unsent and rejected failures distinct and prove both public invocation paths against an accepted transaction with a dropped response."
owner_domain = 8

[finding.wallet_key_file_open]
file = "tools/platform/cli/src/wallet_signing.rs"
line = 44
class = "security"
severity = "medium"
observed = "EvmSigningKey::read calls File::open before checking file type and mode, follows symlinks, and never checks the owner uid. A FIFO blocks at open before the regular-file refusal, while a symlink or another user's readable owner-only export can pass metadata checks."
expected = "Private-key file loading must enforce a bounded, nonblocking read of the current user's regular file without following links, consistent with the protected EVM readers in programs.rs and chains.rs."
proposal = "Reuse the protected key-file opening policy in tools/platform/cli/src/wallet_signing.rs with O_NOFOLLOW, nonblocking open, uid/type/mode validation and the existing byte bound. Qualify FIFO, symlink, foreign-owner and valid derived-export inputs without exposing secret contents."
owner_domain = 8

[finding.wallet_finality_option]
file = "tools/platform/cli/src/wallet.rs"
line = 788
class = "config-drift"
severity = "medium"
observed = "The public wait/receipt options expose finalised, but execute_write and wait_transaction always reject it with MissingFinalityTrust. The supported batched choice maps to committed, retaining terminology from a separate checkpoint finality ladder."
expected = "On the merged BFT chain a committed block is final; wallet commitment choices and help must describe this actual lifecycle rather than require an unavailable guarantor checkpoint."
proposal = "Align commitment parsing, help and receipt outputs in tools/platform/cli/src/wallet.rs and the shared SDK with submitted/receipted/committed semantics. Treat verified committed evidence as final under the declared chain trust policy and qualify each supported wait option through a committed node receipt."
owner_domain = 8

[finding.wallet_snapshot_proof_label]
file = "tools/platform/cli/src/wallet.rs"
line = 1583
class = "security"
severity = "medium"
observed = "verified_account_snapshot only validates field formats through validated_account_records. canonical_value and proof_material are checked for canonical hex but are not cryptographically bound to balance, asset or next_sequence; the server-supplied state_proven string is accepted as the evidence claim."
expected = "An account described as state_proven must be verified against an independently trusted committed root before its balance or source sequence is used for payment authorization."
proposal = "Use the SDK account-proof verification boundary from tools/platform/cli/src/wallet.rs and bind decoded account fields to canonical evidence and a pinned chain root. Reject tampered balances/sequences even when the JSON still says state_proven; keep any unverified display explicitly labeled."
owner_domain = 8

[finding.program_lifecycle_evidence]
file = "tools/platform/cli/src/programs.rs"
line = 641
class = "security"
severity = "medium"
observed = "lifecycle_receipt_result accepts an object containing just matching txHash and any known rung, including submitted. It neither authenticates receipt evidence nor inspects execution result/revert data, although the lifecycle contract describes receipt-backed outcomes. The result is labeled an outcome before execution is established."
expected = "Program lifecycle output must distinguish submission from successful execution and surface authenticated terminal failure or revert information before describing a completed deployment, upgrade or wind-down."
proposal = "In tools/platform/cli/src/programs.rs verify the node receipt/result under the declared chain policy, expose submitted as pending, and report execution failure separately. Exercise successful and reverted lifecycle transactions using actual producer receipts rather than txHash/rung-only objects."
owner_domain = 8

[finding.program_legacy_helpers]
file = "tools/platform/cli/src/programs.rs"
line = 656
class = "dead-code"
severity = "low"
observed = "Old verify_lifecycle_result, discover_call_head and read_program_registry helpers retain a signed REST /v1/programs/registry verification model alongside the current EVM lifecycle and discovery paths. Their internal tests can remain green without qualifying the selected command path."
expected = "Program command implementation and proof coverage should have one clear current EVM path; unused former transport helpers should not imply that their verification protects live operations."
proposal = "Trace remaining callers of the legacy helper cluster in tools/platform/cli/src/programs.rs, remove unreachable former transport code in its owning repair, and move any still-required verification into the actual EVM result consumer with tests registered on that command path."
owner_domain = 8

[finding.scaffold_build_host_path]
file = "tools/platform/cli/src/scaffold.rs"
line = 65
class = "runtime-risk"
severity = "medium"
observed = "SDK_DEFAULT_PATH embeds CARGO_MANIFEST_DIR from the machine that compiled the CLI and writes that absolute path into every generated Cargo.toml. A binary installed or copied to another machine scaffolds a project whose SDK dependency points at a nonexistent build checkout."
expected = "The installed layerx new command must create a project whose SDK can be resolved on the user's machine, without requiring the original binary build directory to exist."
proposal = "Replace the build-host dependency default in tools/platform/cli/src/scaffold.rs with a released SDK dependency or a validated explicitly configured local SDK. Validate availability before creating files and qualify a built CLI relocated away from its source checkout."
owner_domain = 8

