expected = "The documented release recovery procedure must only claim completion after all intended archives and version registrations are durable and consistent."
proposal = "Update scripts/bump_version/README.md to state the partial-archive hazard and a concrete inspect/resume procedure; align the safety claim with a completion marker published after all module archives."
owner_domain = 16

[finding.archive-error-documentation]
file = "scripts/bump_version/README.md"
line = 93
class = "doc-drift"
severity = "medium"
observed = "The error-handling section says Git failures are fatal, while gitFindCommit in main.go suppresses content and iterator errors and may choose an incorrect historical baseline."
expected = "Release operators must be told which failures stop publication and must never rely on an unreadable history as a valid version baseline."
proposal = "Correct scripts/bump_version/README.md error guarantees alongside exact tag-line lookup and error propagation in scripts/bump_version/main.go; document refusal and safe recovery for missing history."
owner_domain = 16

[finding.pr-template-old-authority]
file = ".github/pull_request_template.md"
line = 22
class = "doc-drift"
severity = "medium"
observed = "The mandatory checklist asks every contributor to preserve 402LXP sole-writer invariants, presenting the retired separate ledger authority as a current contribution requirement."
expected = "Contribution guidance must preserve canonical encoding and deterministic replay under the single chain-125 paxd ledger and its committed-state authority."
proposal = "Update .github/pull_request_template.md to require merged-ledger and native bank invariants, retaining the current no-weakening, evidence and private-material requirements."
owner_domain = 17

