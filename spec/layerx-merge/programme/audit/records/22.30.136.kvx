[finding.feed-overview-rejoin]
file = "apps/explorer/ui/pages/PaxeerXFeed.tsx"
line = 22
class = "restart-recovery"
severity = "medium"
observed = "useFeedSocket is called without onJoin. The hook disables five-second REST polling as soon as a channel joins, and PaxeerXFeedChannel returns an empty join reply without replay. A submission committed after the last REST response but before initial join or rejoin is never reconciled unless that market later emits another update or the user reloads."
expected = "After reconnection, the overview must converge to the accepted prices exposed by market REST reads, including updates missed while disconnected; a successful channel join alone supplies no missing history."
proposal = "Add an overview join reconciliation in apps/explorer/ui/pages/PaxeerXFeed.tsx using the market query key, and reconcile unknown accepted market ids as well. Exercise a real REST snapshot, a submission during disconnection and a join without subsequent events in PaxeerXFeedLive.spec.tsx."
owner_domain = 14
interface = "14.ws-explorer-join-socket-v2-paxeer-x-feed-new-update"

[finding.history-unbounded-session]
file = "apps/explorer/ui/pages/PaxeerXFeedMarket.tsx"
line = 45
class = "runtime-risk"
severity = "medium"
observed = "handleFlush appends every fresh update to prevData.items and the page renders the entire array. FEED_HISTORY_BUFFER_LIMIT bounds only the held socket buffer, not the query cache or rendered history, so an open first-page session grows without bound and repeatedly sorts all accumulated rows."
expected = "Live history must retain rows displaced by new updates as req.18900.1 requires while keeping browser memory and rendered work bounded over long sessions; dropping old rows silently would violate reachability."
proposal = "In apps/explorer/ui/pages/PaxeerXFeedMarket.tsx and its history table/pagination, retain displaced history through stable backend cursors or paged storage with a bounded visible window. Preserve deduplication and reachable older rows, and add long-session coverage asserting both bounded rendering and cursor continuity."
owner_domain = 14

