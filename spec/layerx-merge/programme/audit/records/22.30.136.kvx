proposal = "In apps/explorer/ui/pages/Token.pw.tsx replace the synthetic numeric payloads with exact decimal strings emitted by the notifier and add a non-round value beyond 2^53 plus zero. Keep the visual assertions and verify displayed values against the original producer strings."
owner_domain = 14
interface = "14.ws-explorer-push-tokens-hash-total-supply"

