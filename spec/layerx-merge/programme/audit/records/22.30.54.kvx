[finding.autobahn-catching-up-stuck]
file = "consensus/internal/rpc/core/status.go"
line = 131
class = "runtime-risk"
severity = "medium"
observed = "Status initializes SyncInfo.CatchingUp to true and only overwrites it from ConsensusReactor.WaitSync. Under Autobahn that CometBFT reactor is absent, so a fully caught-up live node continues reporting catching_up=true to the consensus RPC client."
expected = "The declared status method must report synchronization state for the active consensus engine, including startup, steady state and recovery, rather than a permanently true placeholder."
proposal = "Provide the Autobahn synchronization state to consensus/internal/rpc/core/status.go and derive CatchingUp from it when the GigaRouter is active. Verify the real JSON-RPC client response during catch-up, after convergence and after restart without requiring a CometBFT reactor."
owner_domain = 15
interface = "15.rpc-consensus-status-j57"

[finding.autobahn-status-hidden-read-errors]
file = "consensus/internal/rpc/core/status.go"
line = 68
class = "runtime-risk"
severity = "medium"
observed = "The Autobahn latest-status branch ignores ABCIInfo failure and BlockByNumber failure, then returns a successful ResultStatus with the old zero height or missing latest hash/time. The earliest block path does propagate its error, so the same response can mix trustworthy committed height with silently absent executed-block metadata."
expected = "A status consumer must be able to distinguish a valid startup boundary from a failed lookup and must receive fields from a coherent readable executed-block snapshot."
proposal = "Propagate or explicitly classify app/latest-block lookup errors in consensus/internal/rpc/core/status.go, using a documented startup-only empty state if required. Prove the actual RPC response for valid startup, populated head, missing latest block and app-info failure."
owner_domain = 15
interface = "15.rpc-consensus-status-j57"

