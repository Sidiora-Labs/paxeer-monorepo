observed = "The Token Factory query list documents only authority metadata and creator denoms, and the message list stops at set metadata. It omits the implemented denom_paused query and set_denom_paused message, including the pause-related rejection behavior used by the merged node."
expected = "The binding guide must describe the pause controls required by 5029.1 and 5029.2 so contract authors can query and handle denom status correctly."
proposal = "Extend node/wasmbinding/README.md with the exact denom_paused and set_denom_paused JSON shapes, response types, authorization and paused-operation errors, using the real registered query/message tests as examples."
