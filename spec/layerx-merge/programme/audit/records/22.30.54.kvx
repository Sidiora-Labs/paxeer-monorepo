[finding.durable-head-regression]
file = "storage/db_engine/pebbledb/mvcc/batch.go"
line = 74
class = "restart-recovery"
severity = "high"
observed = "Batch.Write unconditionally stores its own version in s/_latest, while Database.ApplyChangesetSync only increases the in-memory latestVersion. Writing height 10 and then height 5 leaves GetLatestVersion at 10 until Close/OpenDB reloads 5. Recovery consumers consequently see a different committed boundary after restart."
expected = "The latest-version storage key must represent the same successful high-water mark consumed by StateStore callers before and after restart, including the explicitly supported out-of-order writes."
proposal = "In storage/db_engine/pebbledb/mvcc, serialize the normal data-and-head commit and atomically persist the maximum successful height; keep intentional rollback through its explicit setter. Prove writes at 10 then 5 through the real StateStore and receipt/composite recovery openers, checking head and data again after reopen."
owner_domain = 5
interface = "5.key-storage-db-engine-pebbledb-mvcc-latest-version-key"

[finding.legacy-reverse-visible-key]
file = "storage/db_engine/pebbledb/mvcc/iterator_ascending.go"
line = 98
class = "interface-mismatch"
severity = "high"
observed = "newAscendingIterator starts reverse traversal at src.Last(). If that physical entry is newer than the requested height it calls Next; nextReverse seeks below MVCCEncodeAscending(currKey, 0), skipping every version of the same logical key. A legacy key z written at heights 1 and 3 disappears from a reverse scan at height 2 even though Get returns its height-1 value."
expected = "The StateStore returned by OpenDB for an existing unmarked ascending database must yield the same visible key/value set for Get, Iterator and ReverseIterator at each retained height."
proposal = "In storage/db_engine/pebbledb/mvcc/iterator_ascending.go, seek the current logical key to its newest visible version before advancing to an earlier key. Add bounded and unbounded reverse scans on a real unmarked ascending database with future writes, tombstones and Close/OpenDB; compare complete results with Get and forward traversal."
owner_domain = 5
interface = "5.go-storage-db-engine-pebbledb-mvcc-open-db"

[finding.rollback-leaves-tombstones]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 962
class = "restart-recovery"
severity = "medium"
observed = "DeleteKeysAtVersion delegates enumeration to RawIterate, which skips valTombstoned entries. Setting a key at height 1 and deleting it at height 2, then deleting height 2, leaves the deletion marker in place. No live caller of this helper was found in storage, sdk or node, so this is a defective recovery helper rather than evidence of a currently wired rollback."
expected = "An operation described as physically deleting keys at one version must remove both values and deletion markers at that version, preserving the preceding visible state."
proposal = "Give DeleteKeysAtVersion in storage/db_engine/pebbledb/mvcc/db.go an internal physical iterator that includes tombstones and an explicit head-update policy. Verify set/delete/remove-version through the actual database and reopen, including batching boundaries and both on-disk encoding modes."
owner_domain = 5

[finding.rollback-discards-callback-errors]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 974
class = "runtime-risk"
severity = "medium"
observed = "The DeleteKeysAtVersion callback prints HardDelete or batch.Write errors and returns true; its caller discards RawIterate's stopped result and generally receives nil rather than the callback error. A failed intermediate batch can therefore terminate enumeration without an actionable deletion failure."
expected = "A failed recovery mutation must return its original error and must not report a partially traversed version as successfully removed."
proposal = "In storage/db_engine/pebbledb/mvcc/db.go, capture and propagate the callback error separately from the iterator error, stop committing after failure and describe partial completion. Exercise an actual failing storage operation at an intermediate deletion batch and assert a non-nil caller error."
owner_domain = 5

[finding.raw-export-module-identity]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 925
class = "runtime-risk"
severity = "medium"
observed = "RawIterate with an empty storeKey traverses all stores but strips len(storePrefix(\"\")) bytes from every key. That prefix is s/k:/, so s/k:bank/foo becomes ank/foo instead of foo or a qualified bank/foo. The callback has no module argument, and the all-store export cannot reliably reconstruct the original store and key."
expected = "Raw all-store export must preserve the complete store identity and key encoding so dump/import consumers can reproduce state without collisions or truncated names."
proposal = "Define a qualified-key convention for empty-store RawIterate in storage/db_engine/types and implement it in mvcc/db.go and storage/tools export consumers. Parse each actual module prefix instead of a fixed empty prefix; round-trip two modules of different name lengths with equal user keys."
owner_domain = 5
interface = "5.key-storage-db-engine-pebbledb-mvcc-store-prefix-tpl"

[finding.prune-dirty-map-restart]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 625
class = "restart-recovery"
severity = "medium"
observed = "pruneDescending skips an entire store when storeKeyDirty lacks an entry. OpenDB initializes an empty in-memory map and Import does not reconstruct the entries. A reopened database can advance its pruning boundary while retaining old versions of every store that has not received another write."
expected = "Pruning eligibility must survive restart and snapshot import; dormant module histories must obey the same retention policy as recently written modules."
proposal = "In storage/db_engine/pebbledb/mvcc/db.go, persist or reconstruct store pruning eligibility, or perform a full first scan after open/import before applying the optimization. Verify physical retained versions in populated, stopped/reopened and imported databases with one dormant module."
owner_domain = 5

[finding.ascending-prune-dirty-map]
file = "storage/db_engine/pebbledb/mvcc/db_ascending.go"
line = 151
class = "restart-recovery"
severity = "medium"
observed = "The legacy ascending pruner uses the same volatile storeKeyDirty optimization: an absent entry skips the module. Existing ascending databases opened after a node restart therefore retain dormant historical versions despite a successful Prune call."
expected = "Opening the legacy format must preserve its pruning and disk-retention guarantees while the node continues to serve that database."
proposal = "Apply the restart-safe eligibility strategy to storage/db_engine/pebbledb/mvcc/db_ascending.go as well as the descending path. Use a real unmarked legacy database, reopen without another write, prune and inspect the stored historical versions."
owner_domain = 5

[finding.metadata-short-version-panic]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 358
class = "runtime-risk"
severity = "medium"
observed = "retrieveVersionKey calls binary.LittleEndian.Uint64 on a nonempty stored value without requiring eight bytes. A metadata value of one through seven bytes panics during OpenDB instead of returning a corruption error; an empty present value also falls through as version zero with nil error."
expected = "Version metadata is exactly one little-endian uint64 within int64 range; malformed persisted metadata must produce a diagnosable open failure instead of a panic or a fresh-database head."
proposal = "Validate exact metadata length before decoding in storage/db_engine/pebbledb/mvcc/db.go, distinguishing ErrNotFound from a present malformed value. Reopen real databases with empty, short, oversized and overflowing version metadata and require explicit errors."
owner_domain = 5

[finding.mvcc-counter-double-count]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 1080
class = "runtime-risk"
severity = "medium"
observed = "collectAndRecordMetrics adds cumulative Pebble compaction, flush, cache-hit/cache-miss and level byte totals to OpenTelemetry counters on every ten-second poll. Two unchanged snapshots double exported totals. The raw Pebble collector instead converts cumulative snapshots with addDelta, so identical instrument names have different producer semantics."
expected = "A cumulative metric consumed through the paxdb_pebble meter must count each storage event or byte once, regardless of collection interval or number of exporter scrapes."
proposal = "Keep a per-database prior snapshot in storage/db_engine/pebbledb/mvcc and add only valid positive deltas, with explicit reset/reopen handling. Verify unchanged and incremented real Pebble snapshots through the Prometheus HTTP consumer and align semantics with pebble_metrics.go."
owner_domain = 5
interface = "5.met-paxdb-pebble-pebble-cache-hits-2"

[finding.batch-bytes-is-operation-count]
file = "storage/db_engine/pebbledb/mvcc/batch.go"
line = 145
class = "runtime-risk"
severity = "medium"
observed = "writeBatchOps sets batchSize to len(ops), then records it in the pebble_batch_size histogram whose descriptor in mvcc/metrics.go declares unit By and whose Prometheus consumer uses byte buckets. A batch containing large values is reported as only its operation count."
expected = "The declared byte-size histogram must carry actual encoded bytes consistently across raw Pebble and MVCC producers and the exported pebble_batch_size_bytes series."
proposal = "Measure the encoded committed batch byte length, including the documented metadata policy, in storage/db_engine/pebbledb/mvcc/batch.go. Keep the descriptor and consumer in agreement, or coordinate a separately named operation-count instrument; prove differently sized real values produce corresponding byte totals."
owner_domain = 5
interface = "5.met-paxdb-pebble-pebble-batch-size-2"

[finding.metrics-proof-accepts-wrong-units]
file = "storage/db_engine/pebbledb/mvcc/proof_node_metrics_test.go"
line = 146
class = "test-gap"
severity = "medium"
observed = "The HTTP/exporter proof explicitly expects 2*pairs as pebble_batch_size_bytes with the message current producer reports operations as bytes. It also expects twice the unchanged Pebble cache and compaction byte totals after two collections, freezing the producer defects into successful assertions."
expected = "Requirement 21059.1 and the brief require real producer/transport/consumer evidence with correct metric meanings; a proof must reject mislabeled units and repeated counting."
proposal = "Repair the producer semantics with the owning storage task, then change storage/db_engine/pebbledb/mvcc/proof_node_metrics_test.go to assert encoded byte sizes and unchanged counter totals after an unchanged collection. Preserve its real database, restart, HTTP scrape, bucket and failure-series assertions."
owner_domain = 5

[finding.mvcc-metrics-close-race]
file = "storage/db_engine/pebbledb/mvcc/db.go"
line = 212
class = "runtime-risk"
severity = "medium"
observed = "Close cancels the metrics context but does not join collectMetricsInBackground before closing and clearing db.storage. A ticker already selected can race collectAndRecordMetrics' unsynchronized storage check and Metrics call with Close, including dereferencing a cleared pointer."
expected = "Database shutdown must finish background storage access before closing the underlying database and must not race a periodic metrics poll."
proposal = "Track and join the metrics worker in storage/db_engine/pebbledb/mvcc/db.go before storage.Close, alongside the existing async-write join. Coordinate the lifecycle without holding a lock across worker shutdown; prove close overlapping a real metrics poll and repeated close."
owner_domain = 5

[finding.raw-metrics-close-race]
file = "storage/db_engine/pebbledb/db.go"
line = 207
class = "runtime-risk"
severity = "medium"
observed = "pebbleDB.Close cancels metrics collection and immediately closes the database without waiting for PebbleMetrics.collectLoop. The metrics object retains pm.db, so an in-flight or simultaneously selected tick can still call Metrics on the closed Pebble handle."
expected = "The raw database adapter must stop and join its owned collector before closing the handle, with the same safe lifecycle required of the MVCC adapter."
proposal = "Add a collector shutdown/join contract between storage/db_engine/pebbledb/db.go and pebble_metrics.go, await it before closing Pebble, and retain idempotent Close. Verify an actual collector tick overlapping close without access after handle shutdown."
owner_domain = 5

[finding.dump-db-ignores-source]
file = "storage/tools/cmd/paxdb/operations/dump_db.go"
line = 77
class = "config-drift"
severity = "medium"
observed = "DumpDbData accepts dbDir but opens ss.NewStateStore(outputDir, ssConfig). The source flag never reaches the backend; with default DBDirectory, NewStateStore treats the output as a home directory and opens or creates a nested state store there. The requested source can consequently produce a plausible empty dump."
expected = "The declared dump-db --db-dir argument must select the source database, while --output-dir selects only the destination export files."
proposal = "Set the explicit backend DBDirectory from dbDir in storage/tools/cmd/paxdb/operations/dump_db.go, use the correct home/path contract, require an existing source and close the backend. Verify distinct populated source and output directories with the real backend and assert exported contents."
owner_domain = 5
interface = "5.cli-paxdb-dump-db-flag-db-dir"

[finding.prune-db-dir-home-confusion]
file = "storage/tools/cmd/paxdb/operations/prune.go"
line = 56
class = "config-drift"
severity = "medium"
observed = "PruneDB passes the --db-dir value as NewStateStore's home argument while leaving ssConfig.DBDirectory unset. NewStateStore appends data/state_store/cosmos/backend, so a direct database directory can open a different nested empty database while the command announces pruning the supplied path."
expected = "The prune command must apply the requested retention operation to the exact database directory named by its declared flag and reject an absent source."
proposal = "Populate DBDirectory explicitly in storage/tools/cmd/paxdb/operations/prune.go, validate the source and height and close the backend. Verify a populated real source with a separate sentinel database and prove only the named database changes."
owner_domain = 5
interface = "5.cli-paxdb-prune-flag-db-dir"

[finding.replay-offset-flag-types]
file = "storage/tools/cmd/paxdb/operations/replay_changelog.go"
line = 35
class = "config-drift"
severity = "medium"
observed = "ReplayChangelogCmd registers start-offset and end-offset with Int64P, but executeReplayChangelog reads both with GetUint64 and ignores the type errors. Supplied offsets become zero, selecting FirstOffset and LastOffset and replaying a different range, including when no-dry-run applies data."
expected = "Operator-selected replay bounds must survive CLI parsing unchanged and every flag conversion error must prevent recovery mutation."
proposal = "Use the same checked offset type from flag registration to WAL Replay in storage/tools/cmd/paxdb/operations/replay_changelog.go; return errors through RunE, validate ordering and close resources. Replay a real WAL with nondefault bounds through Cobra and verify only the selected entries are visited."
owner_domain = 5
interface = "5.cli-paxdb-replay-changelog-flag-start-offset"

[finding.benchmark-step-bound-ignored]
file = "storage/tools/bench/benchmark.go"
line = 248
class = "runtime-risk"
severity = "medium"
observed = "Both forward and reverse iteration workers declare j := 0 and test j < numIterationSteps but only advance it.Next; j never increments. Every positive iteration-steps request scans to the iterator boundary, so reported latency and step counts describe a different workload."
expected = "The registered iteration-steps flag must cap each benchmark traversal at the requested number of visible entries in both directions."
proposal = "Increment and enforce the step bound in both loops of storage/tools/bench/benchmark.go, retaining iterator error/close handling. Exercise the real StateStore with more keys than the requested bound through forward and reverse benchmark commands and assert observed steps."
owner_domain = 5
interface = "5.cli-paxdb-iteration-flag-iteration-steps"

[finding.reverse-benchmark-retains-iterators]
file = "storage/tools/bench/benchmark.go"
line = 337
class = "runtime-risk"
severity = "medium"
observed = "The reverse benchmark defers iterator.Close inside the long-running worker's operation loop. All completed iterators remain open until that worker exhausts maxOps, retaining database iterator resources proportional to the whole workload."
expected = "Each completed benchmark operation must release its iterator before the next operation so memory and pinned storage do not distort the measurement or exhaust resources."
proposal = "Close each reverse iterator at operation completion in storage/tools/bench/benchmark.go, using a short per-operation helper if needed for error-safe cleanup. Verify a multi-operation real database run releases iterators throughout the workload rather than only at worker exit."
owner_domain = 5

[finding.benchmark-unchecked-dimensions]
file = "storage/tools/bench/benchmark.go"
line = 26
class = "runtime-risk"
severity = "medium"
observed = "writeToDBConcurrently divides by concurrency without requiring it to be positive and advances its batch loop by unchecked batchSize. The public read/iteration paths also call rand.Intn(numVersions) and rand.Intn(len(allKVs)); accepted zero dimensions or an empty data directory can panic or make a zero-sized write loop never advance."
expected = "Storage benchmark commands must reject invalid workload dimensions before starting workers and report an empty input as an explicit operator error."
proposal = "Validate positive concurrency, batch size, version count and applicable operation/step counts at storage/tools benchmark command boundaries and shared entry points. Reject empty loaded datasets and guard empty summaries; cover actual CLI invocations with zero/negative dimensions and an empty directory."
owner_domain = 5

[finding.input-allocation-unbounded]
file = "storage/tools/utils/utils.go"
line = 82
class = "security"
severity = "medium"
observed = "readByteSlice reads a uint32 from an operator-supplied binary file and allocates that length before checking available input or a record-size limit. A four-byte length can request nearly four GiB and exhaust the benchmark/import process before io.ReadFull detects truncation."
expected = "Binary key/value ingestion must validate declared lengths before allocation and bound per-record resource use, returning a clear error for oversized or truncated input."
proposal = "Define supported key/value record limits in storage/tools/utils/utils.go, validate lengths against those limits and remaining file size where available, and return typed errors before allocation. Exercise real encoded files with oversized lengths, truncated payloads and boundary-sized valid entries."
owner_domain = 5

[finding.dump-iavl-header-error-hidden]
file = "storage/tools/cmd/paxdb/operations/dump_iavl.go"
line = 77
class = "runtime-risk"
severity = "medium"
observed = "When Fprintf of a module dump header fails, DumpIAVLData closes the file and returns nil. The command can report success with incomplete output on an actual disk/write failure; scan writes also panic instead of returning a controlled export error."
expected = "An export is successful only after all selected tree headers and leaves are written and the output is closed successfully; I/O failure must reach the operator."
proposal = "Propagate header, scan and close failures in storage/tools/cmd/paxdb/operations/dump_iavl.go, stop scanning on the first error and publish output only after success. Verify the actual export path against a failing destination and ensure no incomplete file is represented as a successful backup."
owner_domain = 5

[finding.legacy-module-inventory]
file = "storage/tools/cmd/paxdb/operations/module.go"
line = 3
class = "wiring-gap"
severity = "medium"
observed = "AllModules is a fixed legacy module list that omits merged-network stores such as sequencer and lxphost. DumpIAVLData and StateSize use it for the default all-module operation, silently omitting live stores from operator exports and size reports."
expected = "An all-store inventory or export must include every mounted merged-network store and must not depend on a pre-merge hard-coded module list."
proposal = "Discover actual tree/store names from the opened database in storage/tools/cmd/paxdb/operations instead of filtering the default path through AllModules. Preserve explicit module filtering and verify a real database containing sequencer, lxphost and a custom store appears in both export and state-size output."
owner_domain = 5

[finding.state-exception-one-sided-pass]
file = "engine/tests/state_harness_test.go"
line = 260
class = "test-gap"
severity = "medium"
observed = "For ExpectException, RunComparisonTest fails only when neither executor failed. It returns Passed true when V2 fails and Giga succeeds or vice versa. The next branch also accepts any pair of executor errors without comparing their kinds, even when the fixture expects success."
expected = "The state differential proof must reject executor disagreement and unexpected execution failures; a named expected exception must be demonstrated on both real execution paths."
proposal = "Require both executors to fail with the expected classified exception in engine/tests/state_harness_test.go. Treat unexpected executor errors as failures and compare error kinds rather than logging common failure as success. Preserve real V2/Giga execution and add cases exercising one-sided and different-error outcomes."
owner_domain = 5

[finding.state-suite-zero-execution]
file = "engine/tests/state_harness_test.go"
line = 570
class = "test-gap"
severity = "medium"
observed = "runStateTestSuite skips when STATE_TEST_DIR is unset and when the selected directory has no loaded tests. A name filter or missing supported posts can also select no executed cases. The generic command documented as running all non-skipped tests can therefore finish without exercising the state comparison."
expected = "A qualification command for requirement 22998.1 must execute a declared nonempty inventory and fail clearly when configuration or filters select zero cases."
proposal = "Declare a bounded required state-test selection and executed-case count in engine/tests/state_harness_test.go and its qualification command. Fail an absent/empty required selection, report selected versus executed fixtures and prove the documented real command executes them without weakening assertions or using skips as repairs."
owner_domain = 5

[finding.state-skip-inventory-hides-failures]
file = "engine/tests/data/skip_list.json"
line = 3
class = "test-gap"
severity = "medium"
observed = "The active skip inventory excludes tests labeled gas_mismatch, result_code and other executor divergences, as well as whole categories. runStateTestSuite consumes these exclusions by default, so a green selected suite does not establish repaired behavior for those recorded failing targets."
expected = "Requirement 22998.1 requires a previously failing target to pass its recorded command without deleting, skipping, ignoring or weakening its tests."
proposal = "Turn each recorded divergence in engine/tests/data/skip_list.json into an owned repair with its original case and command. Qualify the repaired real executor paths against unchanged expectations and remove only resolved exclusions; publish the exact nonexcluded inventory and revision evidence."
owner_domain = 5

[finding.state-oracle-opt-in]
file = "engine/tests/state_test.go"
line = 196
class = "test-gap"
severity = "medium"
observed = "The default state comparison sets VerifyEthereumSpec only when VERIFY_ETHEREUM_SPEC is true. Equality between two local executors can therefore pass a shared incorrect outcome without checking the fixture's independent expected state and logs."
expected = "Qualification of supported EVM state behavior must include an independent expected-output oracle as well as agreement between the local execution paths."
proposal = "Define the supported fixture/spec comparison gate in engine/tests/state_test.go with explicit Paxeer fork and chain-ID adaptations, and require its oracle checks in qualification. Demonstrate a shared local error is rejected while preserving both real executors and the fixture expectations."
owner_domain = 5

[finding.state-runbook-recommends-exclusion]
file = "engine/tests/AGENTS.md"
line = 169
class = "doc-drift"
severity = "medium"
observed = "The state-test instructions tell maintainers to add failing tests to skipped_tests and then verify the category passes; the opening generic command also omits STATE_TEST_DIR even though the implementation skips without it. This workflow can convert a known failure into an excluded test rather than a verified repair."
expected = "Requirement 22998.1 permits qualification only with original failing tests active and unchanged; documented commands must execute a nonempty declared test selection."
proposal = "Rewrite engine/tests/AGENTS.md to separate diagnostic inventories from passing qualification, supply explicit selection/oracle variables and prohibit exclusions as a repair. Require the original failure command, executed count and verified revision for every resolved entry."
owner_domain = 5

[finding.wasm-message-ambiguous-variant]
file = "node/wasmbinding/encoder.go"
line = 30
class = "runtime-risk"
severity = "medium"
observed = "CustomEncoder unmarshals several optional message variants and executes the first non-nil switch branch. A JSON object containing both create_denom and mint_tokens is accepted as only create_denom, silently discarding part of the contract's requested operation."
expected = "A custom Wasm message must identify exactly one operation, with malformed multi-variant input rejected before state mutation and a stable typed error returned to the contract."
proposal = "Validate exactly one populated variant before dispatch in node/wasmbinding/encoder.go and preserve module authorization/error semantics. Exercise ambiguous and valid payloads through the registered custom message handler and real keeper mutation path."
owner_domain = 5
interface = "5.go-node-wasmbinding-custom-encoder"

[finding.wasm-oracle-ambiguous-query]
file = "node/wasmbinding/queries.go"
line = 49
class = "runtime-risk"
severity = "medium"
observed = "HandleOracleQuery accepts both exchange_rates and oracle_twaps fields and selects exchange_rates solely by switch order. Unlike the TokenFactory path, which already invokes Validate, the Oracle path does not reject multiple populated alternatives; its consumer can receive a different response shape from the requested TWAP operation."
expected = "The custom query envelope must select exactly one response type and reject ambiguous variants consistently before invoking a module handler."
proposal = "Add exactly-one validation for Oracle query alternatives in node/wasmbinding/queries.go, retaining the existing TokenFactory validation. Exercise the registered custom querier with multiple alternatives and verify a typed rejection, then prove each valid query returns its declared module response."
owner_domain = 5
interface = "5.go-node-wasmbinding-query-plugin-handle-oracle-query"

[finding.wasm-binding-doc-pause-omitted]
