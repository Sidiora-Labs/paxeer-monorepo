[finding.legacy-tx-result]
file = "consensus/types/events.go"
line = 302
class = "interface-mismatch"
severity = "high"
observed = "EventDataTx.ToLegacy builds LegacyResult with Log, GasWanted, GasUsed and Events only. ExecTxResult.Code, Data, Info, Codespace and EvmTxInfo disappear. pubsub.Message.LegacyData feeds rpc/core Subscribe and the local RPC client, so a nonzero execution failure has no code on that subscription wire."
expected = "A committed transaction event must preserve its execution outcome from the ABCI producer through subscription transport to the consumer. Legacy numeric string encoding must not erase the failure code or result payload."
proposal = "In consensus/types/events.go preserve the execution code, data and remaining declared result fields in LegacyResult and ToLegacy. Exercise an actual failed transaction through EventBus, Subscribe serialization and client decoding and assert its original nonzero code and data."
