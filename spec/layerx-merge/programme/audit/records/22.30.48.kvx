[finding.tx-hash-length]
file = "consensus/types/mempool.go"
line = 48
class = "security"
severity = "medium"
observed = "TxHashFromProto copies any TxKey byte slice into a 32-byte array and returns success. Short keys are zero-padded and long keys truncated; ProposalFromProto consumes this decoder for remote proposal transaction keys."
expected = "A transaction identity received from a peer must contain exactly the 32 SHA-256 bytes emitted by TxHash.ToProto, with invalid lengths refused before identity lookup or proposal processing."
proposal = "In consensus/types/mempool.go require len(dp.TxKey) == sha256.Size and return a descriptive error otherwise. Add proposal protobuf decoding cases for lengths 0, 31 and 33, and a valid 32-byte round trip."
owner_domain = 15
