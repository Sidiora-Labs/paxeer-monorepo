[finding.1]
file = "layerxproof/codec/state.go"
line = 206
class = "interface-mismatch"
severity = "high"
observed = "StateWitness.Root rejects LeafCountB above 10 and DecodeStateWitness rejects ModuleID above 9. The C lxp_state_module_root_count returns highest registered module plus one; lxphost registers spot 10 and service 11, so valid C witnesses have 12 composite leaves and are rejected even for module-zero account balances."
expected = "The retained StateProof and AccountProof consumers must accept every canonical witness emitted by lxp_state_proof_build for the currently registered native modules, preserving identical leaf hashes, paths and roots."
proposal = "Update layerxproof/codec/state.go to derive supported module IDs and composite widths from the current native contract, retain strict depth/index/root checks, and prove C-built account, spot and service witnesses through Go decoding and verification with the full lxphost module set."
owner_domain = 1
interface = "1.go-layerxproof-codec-state-witness-root"

[finding.2]
file = "layerxproof/codec/codec_test.go"
line = 273
class = "test-gap"
severity = "medium"
observed = "TestNativeStateProofsFromCore reads only the checked-in contracts/config/native-state-proofs.json, while the Rust fixture refusal table treats module-tree-width as invalid. Neither obtains a witness from the current host with spot and service registered, allowing the obsolete 10-leaf ceiling to remain green."
expected = "Producer/consumer coverage must include current native module registration and actual encoded proofs, not only a historical file that the producer no longer represents."
proposal = "Extend the producer fixture path and layerxproof/codec/codec_test.go to consume C-generated witnesses from the current registered host, assert 11/12-leaf positive cases and module 10/11 inclusion, and retain all malformed-width and root-mutation refusals."
owner_domain = 1
interface = "1.go-layerxproof-codec-decode-state-witness"

[finding.3]
file = "layerxproof/verify/verify_test.go"
line = 113
class = "test-gap"
severity = "medium"
observed = "TestStateProofMatchesRust and TestAccountProofBindsIdentityAndAsset read static vectors.json through Load; the tested account witness never traverses the current C producer or the complete native module registry."
expected = "The retained verifier must prove an account and its asset under the same root the current C host actually commits, including current module widths and restored state."
proposal = "Add a current C-host-to-Go StateProof/AccountProof case in layerxproof/verify tests, persist and restore the host state before regenerating the proof, and assert account identity, asset, balance and committed root against that real producer."
owner_domain = 1
interface = "1.go-layerxproof-verify-account-proof"

[finding.4]
file = "src/crypto/lxp_merkle.c"
line = 96
class = "runtime-risk"
severity = "medium"
observed = "proof_depth uses (count + 1U) / 2U in uint32 arithmetic, as does the verification fold. At UINT32_MAX the addition wraps to zero, yielding depth 1 instead of 32 and inconsistent canonical proof acceptance compared with Go ProofDepth."
expected = "Every representable uint32 leaf count must use overflow-safe ceiling division and the same positional depth semantics in C generation, encoding, verification and Go consumption."
proposal = "Replace the uint32 ceiling additions in src/crypto/lxp_merkle.c with count / 2U + count % 2U, and add boundary assertions for UINT32_MAX and adjacent counts to tests/crypto/lxp_test_merkle_proof.c without allocating an enormous tree."
owner_domain = 1
interface = "1.c-lxp-merkle-proof-verify"

[finding.5]
file = "src/crypto/lxp_merkle.c"
line = 188
class = "runtime-risk"
severity = "medium"
observed = "lxp_merkle_proof_encode checks depth only. A zero-count depth-zero proof, or a proof whose leaf_index equals leaf_count, can be emitted with LXP_OK even though native verification and Go MerkleProof.Validate refuse it."
expected = "A successful canonical proof encoder should reject an empty tree and out-of-range index before it writes a transport object that every verifier will refuse."
proposal = "Validate nonzero leaf_count and leaf_index < leaf_count before writing in src/crypto/lxp_merkle.c, preserve canonical depth checks, and cover both refused encodes and unchanged writer state in the native proof tests."
owner_domain = 1
interface = "1.c-lxp-merkle-proof-encode"

[finding.6]
file = "tests/crypto/lxp_test_ed25519.c"
line = 45
class = "test-gap"
severity = "medium"
observed = "The C suite signs one valid key with OpenSSL and tests wrong-domain and nonreduced-S refusals, but never exercises off-curve or small-order public keys and R. Go Ed25519 explicitly rejects both small-order points, while C delegates these point checks to its OpenSSL provider."
expected = "The native and Go strict signature boundary needs shared adversarial point vectors and pinned refusal evidence; use of the same signing backend for positive cases does not establish equivalent weak-point handling."
proposal = "Add independently sourced malformed and torsion point vectors to tests/crypto/lxp_test_ed25519.c and the Go verifier vectors, require matching BAD_SIGNATURE verdicts for public key and R variants, and make any demonstrated C refusal gap explicit in src/crypto/lxp_ed25519.c."
owner_domain = 1
interface = "1.c-lxp-ed25519-verify-raw"

[finding.7]
file = "tests/crypto/lxp_test_secp256k1.c"
line = 46
class = "test-gap"
severity = "medium"
observed = "The recovery loop sets found when any recovery ID returns LXP_OK, and tolerates every alternate address. It never compares the result with the known private-key-one signer address, so a consistently wrong address derivation can pass."
expected = "Address recovery must return the Ethereum Keccak-derived address of the actual signing public key for the correct recovery ID, and reject invalid IDs and scalar ranges."
proposal = "Add an independent known compact-signature/recovery-ID/address vector to tests/crypto/lxp_test_secp256k1.c, assert the exact recovered address and signer binding, and retain all current low-S and invalid-range checks."
owner_domain = 1
interface = "1.c-lxp-secp256k1-recover-address"

[finding.8]
file = "src/modules/escrow/lx_escrow_open.c"
line = 32
class = "runtime-risk"
severity = "medium"
observed = "validate_open checks uniqueness of escrow_id but not exclusive ownership or an empty balance of escrow_account. The retained non-v3 module path resolves a caller-selected existing account, so two different holds can lock funds into one account while recording separate locked_amount values."
expected = "Each supported escrow opening must preserve the declared invariant that its dedicated custody balance equals that hold locked_amount; protocol-3 derived custody already enforces a stronger identity boundary."
proposal = "Enforce dedicated empty custody and a unique hold-to-account binding in src/modules/escrow/lx_escrow_open.c for every supported execution version, or explicitly refuse the unsupported legacy route at admission, and cover two holds presenting one custody account."
owner_domain = 1
interface = "1.c-lx-escrow-open-execute"

[finding.9]
file = "src/modules/escrow/lx_escrow_capture.c"
line = 15
class = "runtime-risk"
severity = "medium"
observed = "lx_escrow_remaining returns the complete account balance without comparing record.locked_amount. If a legacy opening shares custody or the account receives an additional native credit, full capture can pay more than the agreed hold and partial capture rewrites the hold to include those extra funds."
expected = "Capture, release and resolution must refuse an inconsistent custody/hold pair before moving value, rather than treating unrelated balance as part of the commercial hold."
proposal = "Bind spendable remaining funds to the hold invariant in src/modules/escrow/lx_escrow_capture.c and the shared settlement entry path; handle excess custody through an explicit owner recovery rule, and test overfunding plus shared-account input without changing balances on refusal."
owner_domain = 1
interface = "1.c-lx-escrow-remaining"

[finding.10]
file = "src/modules/escrow/lx_escrow_invariants.c"
line = 32
class = "wiring-gap"
severity = "medium"
observed = "lx_escrow_invariant_check correctly compares locked_amount with custody balance and terminal emptiness, but production escrow open/capture/dispute/timeout paths never call it; only module tests invoke this checker."
expected = "The invariant that protects a hold from shared or inconsistent custody must run on the actual native transition path, including restored state, rather than exist only as a test helper."
proposal = "Wire lx_escrow_invariant_check into the shared production transition preparation and post-settlement validation in src/modules/escrow, with rollback on mismatch and a real kernel-path refusal case for an inconsistent restored hold."
owner_domain = 1
interface = "1.c-lx-escrow-remaining"

[finding.11]
file = "src/modules/escrow/lx_escrow_timeout.c"
line = 117
class = "runtime-risk"
severity = "medium"
observed = "sweep_collect returns LXP_ERR_ARENA_EXHAUSTED on the 25th expired active hold. lx_escrow_epoch_begin returns before settling any hold, and lxp_kernel_epoch_transition rolls the epoch back. Incremental batch maintenance exists but the declared epoch hook does not require it to drain first."
expected = "A bounded maintenance allocation must not indefinitely prevent an otherwise valid epoch transition when many customer holds share an expiry; processing must make deterministic progress."
proposal = "Rework the registered epoch path in src/modules/escrow/lx_escrow_timeout.c to drain deterministic bounded chunks through the same journal or explicitly drain before epoch activation, preserving atomicity and proving more than 24 simultaneous expiries through lxp_kernel_epoch_transition."
