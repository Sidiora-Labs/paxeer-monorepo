[finding.f001]
file = "cmd/layerxctl/tests/files.rs"
line = 551
class = "test-gap"
severity = "medium"
observed = "encoded_receipt writes zero effects and arbitrary previous/resulting roots; submit_reports_receipted_only_with_a_pinned_key_signature nevertheless expects success. main.rs verify_sequencer_signature requires the PAXEER/v1/sequence root and a module-12 summary effect."
expected = "Receipt success fixtures must have exactly the signed structure emitted by the current node producer; BRIEF check_7 forbids a third receipt shape."
proposal = "Replace the hand-encoded success receipts in cmd/layerxctl/tests/files.rs with the node-produced committed-fixture vectors, retaining all signature, boundary and result-code assertions."
owner_domain = 5
interface = "5.cli-layerxctl-submit"

[finding.f002]
file = "consensus/internal/protoutils/wireguard/wireguard.go"
line = 107
class = "security"
severity = "high"
observed = "scan creates a fresh counts map for each nested occurrence. Repeating singular Block.last_commit or SignedHeader.commit lets each occurrence stay within MaxCount while protobuf merges their repeated Commit.signatures into one over-cap Commit before semantic validation. The network path scans before gogo Unmarshal (consensus/internal/p2p/transport.go:85 and consensus/internal/consensus/state.go:2225); generated Block.Unmarshal reuses LastCommit, whose Unmarshal appends signatures. The byte limit remains, but the declared allocation cap is bypassed."
expected = "Untrusted consensus bytes must be bounded according to the decoded message, including protobuf merge semantics for duplicate singular message fields, before allocations occur."
proposal = "In consensus/internal/protoutils/wireguard preserve counters across occurrences that protobuf merges into the same singular message, distinguish repeated children in generated rules, and exercise duplicate last_commit/commit occurrences through the real channel decoder."
owner_domain = 15
interface = "15.go-consensus-internal-protoutils-wireguard-scan-j57"

[finding.f003]
file = "consensus/internal/protoutils/wireguard/wireguard_test.go"
line = 146
class = "test-gap"
severity = "medium"
observed = "TestScan_DuplicateOuterEachWithinCapPasses accepts two nested field occurrences with two inner entries each at cap 3. The synthetic schema does not distinguish singular and repeated parents; it never decodes the actual singular Commit that merges to four signatures."
expected = "The predecode guard tests must cover the decoded producer/transport/consumer shape and reject merged repeated collections above their bound."
proposal = "Add a real protobuf message with a singular nested Commit and split over-cap signatures across duplicate field occurrences; assert refusal through both Scan and the transport integration path."
owner_domain = 15
interface = "15.go-consensus-internal-protoutils-wireguard-scan-j57"

[finding.f004]
file = "consensus/internal/eventlog/eventlog.go"
line = 97
class = "runtime-risk"
severity = "medium"
observed = "WaitScan reads lg.state(), then separately calls waitStateChange which captures lg.ready under a later lock. An Add between those operations closes the old channel and installs a new one, so the waiter can miss an already-available event until another Add or cancellation."
expected = "WaitScan must return when the head differs from the supplied cursor, including when a producer updates the head between snapshot and subscription."
proposal = "Capture the head snapshot and ready channel together under the same mutex in consensus/internal/eventlog, and test the boundary with coordinated real Add/WaitScan calls."
owner_domain = 15
interface = "15.go-consensus-internal-eventlog-log-j57"

[finding.f005]
file = "consensus/abci/types/util.go"
line = 26
class = "runtime-risk"
severity = "medium"
observed = "ValidatorUpdates.Less returns PubKey.Compare(...) <= 0, so equal public keys compare less in both directions and Less(i,i) is true."
expected = "sort.Interface.Less must implement a strict ordering; equal validator keys cannot precede themselves or each other."
proposal = "Use a strict public-key comparison in consensus/abci/types/util.go and check equal and duplicate keys through the validator-update sorting callers."
