[finding.f034]
file = "spec/layerx-merge/contracts/consensus-fork.md"
line = 31
class = "doc-drift"
severity = "medium"
observed = "The contract pins revision 2a1033aa2 at :3, but its current-state claims at :40, :50, :243 and :248 say the router publishes nothing, reset leaves Autobahn state and offline tooling opens CometBFT stores; :230 still labels ErrAutobahnOfflineStore planned. At audit revision 6d2c32a65a1c7989a6a37abf5965929de9769ae4, consensus/internal/p2p/giga_router.go:365-387 already saves responses, pushes the app hash and publishes events, consensus/cmd/tendermint/commands/reset.go:143 removes data/autobahn, and reindex_event.go:151-154 refuses Autobahn stores. Follow-up revision 0f3fe6b8c5c1973c0e80408097cf66e06e40785f retains those behaviors at giga_router.go:369-391, reset.go:175-194 and reindex_event.go:158-161. The :31 invariant also requires publication before PushAppHash, whereas both source revisions publish afterward; consensus/internal/p2p/giga_router_events_test.go:121 and :154 check emitted block and transaction payloads, without asserting that invariant's ordering."
expected = "The audit must separate pinned planned work from behavior already implemented at its historical revision and explicitly retain the contract-versus-source event-order disagreement; source inspection does not qualify the frozen acceptance gates."
proposal = "In the owning consensus contract follow-up, distinguish historical planned/UNRUN entries from implemented event publication, reset and offline refusal, and reconcile the :31 event-order invariant with the actual SaveFinalizeBlockResponses, Commit, PushAppHash and publish sequence without claiming an unrun gate."
