[finding.f008]
file = "storage/db_engine/rocksdb/mvcc/db.go"
line = 114
class = "config-drift"
severity = "medium"
observed = "OpenDB allocates pendingChanges with config.AsyncWriteBuffer and always starts a worker. A negative buffer panics; buffer zero returns from enqueue when the worker receives, before ApplyChangesetSync completes. StateStoreConfig and the app.toml template promise persistence before return for every value <=0."
expected = "The ss-async-write-buffer setting must select synchronous persistence for zero and negative values on the supported RocksDB backend, as storage/config/ss_config.go:35 and toml.go:116 declare."
proposal = "In storage/db_engine/rocksdb/mvcc/db.go use a synchronous write path for buffers <=0 and allocate the async queue only for positive sizes; prove the configured path and persisted version through actual close and reopen."
owner_domain = 5
interface = "5.go-storage-db-engine-rocksdb-mvcc-open-db"

[finding.f009]
file = "storage/db_engine/rocksdb/mvcc/db.go"
line = 258
class = "restart-recovery"
severity = "medium"
observed = "ApplyChangesetAsync sends the changeset to pendingChanges before streamHandler.Write. The worker can apply and persist it while the WAL append is pending or fails, so a caller can receive an append error after its version already changed. The Pebble backend appends before enqueue; composite startup does perform WAL replay."
expected = "A rejected WAL append must not publish its state mutation to the database; persisted database versions and the replay log must describe the same accepted write sequence."
proposal = "In storage/db_engine/rocksdb/mvcc/db.go complete the WAL append before making the changes visible to the background writer, preserving ordering across callers, and prove append failure and restart consistency through the real store path."
owner_domain = 5
interface = "5.fmt-storage-changelog-wal"

[finding.f010]
file = "storage/db_engine/rocksdb/mvcc/db.go"
line = 204
class = "runtime-risk"
severity = "medium"
observed = "Has obtains an owned grocksdb.Slice from getSlice and returns slice.Exists() without Free. Get uses copyAndFreeSlice for the same allocation, so repeated existence checks retain native RocksDB value buffers outside Go garbage collection."
expected = "Every RocksDB value slice must be freed after its existence or contents have been consumed, including the boolean-only lookup path."
proposal = "In storage/db_engine/rocksdb/mvcc/db.go release the slice in Has on every successful allocation and inspect the other owned Slice reads for matching release; exercise repeated Has calls against the actual backend."
owner_domain = 5

[finding.f011]
file = "storage/db_engine/rocksdb/mvcc/db.go"
line = 278
class = "runtime-risk"
severity = "medium"
observed = "The async worker increments asyncWriteWG only after its goroutine starts. Close can close the queue and observe a zero WaitGroup before that increment, then clear streamHandler and close RocksDB while buffered work or the worker still exists."
expected = "Closing a state store must wait for all accepted queued writes and the background worker before releasing native database and WAL resources."
proposal = "In storage/db_engine/rocksdb/mvcc/db.go register the worker with the WaitGroup before launching it and synchronize shutdown with accepted writes; prove immediate close after open and after queued writes using the real RocksDB lifecycle."
owner_domain = 5

[finding.f012]
file = "storage/wal/utils.go"
line = 85
class = "restart-recovery"
severity = "medium"
observed = "truncateCorruptedTail advances pos while slicing data, then compares pos to the remaining len(data). A two-byte valid entry [01,61] followed by corrupt [80,80] leaves pos=2 and len(data)=2, so no truncation occurs and the subsequent WAL reopen still sees corruption."
expected = "Tail recovery must retain exactly the valid prefix and remove every malformed suffix, including when prefix and suffix have equal byte lengths."
proposal = "In storage/wal/utils.go track the original length or an explicit corrupt-tail condition and truncate to the validated prefix; add actual binary and JSON WAL reopen cases for equal-sized prefix and corrupt suffix."
owner_domain = 5
interface = "5.fmt-storage-changelog-wal"

