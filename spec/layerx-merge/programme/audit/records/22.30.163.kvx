[finding.001]
file = "sdk/integrations/agents/src/daemon-budget.ts"
line = 116
class = "restart-recovery"
severity = "medium"
observed = "DaemonPreparationBudget persists stage preparing before prepareNative and stage signing before signer.sign; reopening either interrupted stage returns admission-unknown or unknown indefinitely, without reconciliation or a retry of the same operation."
expected = "An interrupted payment preparation must be reconciled with its owning daemon and signer so the same admitted request can resume safely after a process restart."
proposal = "In sdk/integrations/agents/src/daemon-budget.ts add owner lookup and recovery transitions for preparing and signing, retaining the exact request and idempotency identity; prove crashes before and after each remote call resume without a second payment."
owner_domain = 15

[finding.002]
file = "sdk/integrations/agents/src/mcp.ts"
line = 640
class = "restart-recovery"
severity = "medium"
observed = "FileVerifiedEventQueue uses an exclusive .lock file removed only in finally; a killed process leaves the file behind, and acquireMcpFileLock retries EEXIST before refusing every subsequent push, count and drain."
expected = "The durable MCP event queue must become usable after its owning process crashes without an operator deleting a lock file or losing queued events."
proposal = "Replace the sentinel lock in sdk/integrations/agents/src/mcp.ts with process-released locking or the SQLite coordination used by FileWebhookDeliveryStore, and exercise kill/reopen with the same persisted queue."
owner_domain = 15

