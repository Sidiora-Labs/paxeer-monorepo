[finding.payout-dispatch-crash]
file = "services/launchpad/security/control/workers.go"
line = 69
class = "restart-recovery"
severity = "high"
observed = "SettlementWorker.Process commits payout_attempt.Submitted=true and State=unknown before PayoutProvider.Submit. A crash between commit and Submit leaves Lookup returning absent; later calls skip submission because Submitted remains true and rewrite the obligation as unknown."
expected = "Accepted payout obligations must resume after process loss without disappearing between durable intent and external submission, retaining one provider idempotency key and independent receipt verification."
proposal = "In services/launchpad/security/control/workers.go distinguish dispatch intent from confirmed provider acceptance and safely retry the same idempotency key when authoritative lookup reports absence. Prove actual-provider restart behavior at intent commit, send and response boundaries."
