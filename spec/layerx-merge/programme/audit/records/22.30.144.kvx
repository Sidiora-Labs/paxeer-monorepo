[finding.status-committed-inclusion]
file = "services/explorer/backend/apps/block_scout_web/test/block_scout_web/controllers/api/v2/paxeer_x/transaction_status_committed_test.exs"
line = 131
class = "security"
severity = "high"
observed = "gateway_batch re-signs an independently assembled 241-byte transaction with a one-leaf proof, while committed-ok imports a separate comet_commit.json header whose data_hash is 32 bytes of 04. Line 49 asserts committed without relating those evidence sets. TransactionStatusController.sequence_batch at lines 114-125 discards proof, four roots and the batch signature; SequencerReceipt.r7 at lines 765-783 checks a sequence range and unproven eth receipt fields. A valid commit at the height can therefore promote execution not proven in that block."
expected = "Brief checks 1, 7 and 8, req.14246.1 and the SDK terminal verification contract require batch/transaction inclusion against execution_header.data_hash, result inclusion against the linked successor last_results_hash, and authorization of the batch signature and receipt roots before reporting committed."
proposal = "In sequencer_receipt.ex and both domain-14 receipt controllers, verify batch, transaction and execution-result inclusion against authenticated linked headers and verify the batch signature and roots. Replace independent positive assembly in both committed suites with recorded daemon/committed-fixture/vectors/vector-v4-committed.json settlement evidence. Refuse missing/mutated proofs, roots, signatures and unrelated same-height headers."
owner_domain = 14
interface = "14.http-get-api-v2-transactions-transaction-hash-param-status"

[finding.signature-self-supplied-authority]
file = "services/explorer/backend/apps/block_scout_web/test/block_scout_web/controllers/api/v2/paxeer_x/transaction_signature_committed_test.exs"
line = 35
class = "security"
severity = "high"
observed = "committed_calls serves receipt keys, commit and validators from one fixture endpoint and the positive assertion trusts them. TransactionSignatureController.committed_options at lines 83-100 extracts chain_id from the returned header; SequencerReceipt.receipt_keys obtains its pins from the same endpoint. CometCommit.verify only matches returned validators to the returned header. Both receipt routes lack independently configured chain/validator authority and can accept an internally consistent unauthorized chain as the network."
expected = "Brief check 8 and docs/site/docs/agents/sdk-verification.md lines 25-29 require receipt pins and chain authority independent of the answer being verified. A correctly signed but unauthorized key or validator set cannot authorize receipted or committed network execution."
proposal = "Configure trusted chain identity, governed receipt-key pins and a validator checkpoint/history in the domain-14 receipt verifier and runtime configuration. Authenticate discovered keys and validator transitions against that authority. Extend both controller suites with correctly signed foreign-chain and unauthorized-validator evidence, key rotation and restart; require refusal rather than accepting the response as its own pin."
owner_domain = 14
interface = "8.rpc-gateway-px-getreceiptkeys"

[finding.pax-identity-not-imported]
file = "services/explorer/backend/apps/block_scout_web/test/block_scout_web/controllers/api/v2/paxeer_x/identity_search_test.exs"
line = 74
class = "interface-mismatch"
severity = "high"
observed = "insert_binding supplies pax_address and layerx_account directly. The actual PaxeerXLogs.row at lines 866-875 emits evm_address_hash, layerx_did, bound and nonce but no pax_address; block/fetcher.ex passes those rows to AccountBindings, whose importer inserts without enrichment. UnifiedAccount.resolve filters Pax lookups by binding.pax_address and identities returns that nullable column. A real imported binding therefore cannot reproduce the successful native Pax lookup or Pax identity fixture."
expected = "Registry rows 14.http-get-api-v2-search and 14.http-get-api-v2-addresses-address-hash-param-unified must round-trip the native identities of an associated/bound account through addr events, indexer transport, persisted bindings and HTTP. Tests cannot manufacture a field absent from the live path."
proposal = "In domain-14 binding ingestion/resolution, derive or query the Pax association at the indexed height and persist the searchable native identity, or resolve the spelling without requiring an unpopulated column. Backfill existing rows and make enrichment replay idempotent despite on_conflict: :nothing. Import real addr association/bind events, search every spelling, restart and replay, then verify unbind and reorg removal."
owner_domain = 14
interface = "14.http-get-api-v2-search"

[finding.capability-nonproducer-abi]
