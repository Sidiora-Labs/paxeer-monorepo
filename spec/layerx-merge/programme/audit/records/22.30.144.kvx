expected = "Brief checks 1 and 7 and req.181017.1 require the addr capability to describe the interface actually served by the node. Positive evidence must use producer ABI, and malformed dynamic offsets/tails or wrong selectors must not establish capability availability."
proposal = "Encode the positive answer from precompiles/addr/abi.json, assert selector 0x357feed6 with the zero address, and carry a real node response through the probe. Validate the four-word head and string tail in the capability decoder. Add wrong-selector, offset, truncation and refusal cases while retaining the exact exchange/bridge view-call assertions."
owner_domain = 14
interface = "14.http-get-api-v2-paxeer-x-capabilities"

