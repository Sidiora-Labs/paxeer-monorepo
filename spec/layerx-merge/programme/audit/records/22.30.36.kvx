[finding.metadata-token-identity]
file = "apps/launchpad/web/src/widgets/my-token/my-token-view.tsx"
line = 33
class = "interface-mismatch"
severity = "high"
observed = "Quoter.getPoolsByCreator returns PoolRegistry pool addresses, but MyTokenView sends each pool address to GET /metadata/{tokenAddress}. Both metadata handlers.go buildOne and production legacy_reads.go resolve metadata by token address; an unknown pool-as-token yields empty metadata rather than the coin name and symbol."
expected = "The metadata route and gateway proxy require a token address, while the holders and trade panels require the pool address. These two identities must remain distinct through the creator-pool listing."
proposal = "In apps/launchpad/web/src/widgets/my-token/my-token-view.tsx resolve each pool to its canonical token through the Quoter or pool read model, retain both identities, and request metadata by token. Prove creator discovery through the actual gateway metadata route into rendered names, including an unknown token refusal."
owner_domain = 4
interface = "4.http-metadata-get-metadata-token-address-handlers"

[finding.creator-wallet-lifecycle]
file = "apps/launchpad/web/src/widgets/my-token/my-token-view.tsx"
line = 40
class = "runtime-risk"
severity = "medium"
observed = "The metadata effect depends only on poolList.length and selectedPool is replaced only when it is falsy. Switching to another creator with the same number of pools does not load that creator metadata, and a previously selected pool survives a change to a disjoint pool list."
expected = "My coins must display and select pools belonging to the current wallet, and a wallet or pool-list change must prevent an earlier request from installing stale results."
proposal = "In apps/launchpad/web/src/widgets/my-token/my-token-view.tsx scope metadata requests to the wallet and actual pool identities, cancel obsolete requests, and reset selection whenever it is absent from the current list. Cover two wallets with equal-sized disjoint lists."
owner_domain = 4

[finding.dm-session-revocation]
file = "apps/launchpad/web/src/widgets/chat/conversation-list.tsx"
line = 36
class = "security"
severity = "medium"
observed = "ConversationList fetches bearer-authenticated getDmConversations but its effect observes only wagmi address, isConnected and attempt. It neither subscribes to account-session changes nor registers a private-view invalidator. clearAccountSession can therefore leave conversation peers and unread metadata visible while the wallet remains connected; a pending response can also repopulate them."
expected = "Private conversation metadata must belong to the current application session and be cleared on logout, expiry or session replacement independently of whether the wallet connection changes."
proposal = "In apps/launchpad/web/src/widgets/chat/conversation-list.tsx subscribe to the account-transport session epoch, register synchronous revocation cleanup, bind requests to the session AbortSignal and reject responses from older sessions. Verify logout, expiry and login with an unchanged wallet."
owner_domain = 4

[finding.dm-visible-read-marker]
file = "apps/launchpad/web/src/widgets/chat/dm-thread.tsx"
line = 18
class = "runtime-risk"
severity = "medium"
observed = "DmThread invokes markRead whenever chat.messages changes while the document is visible, even when offset selects Earlier messages. use-chat.ts markRead chooses the final message in the entire state and submits its sequence after two seconds, so a newly arrived message outside the displayed slice is marked read."
expected = "A direct-message read marker must advance only through messages the reader has actually reached; browsing older history must preserve unread status for newer undisplayed messages."
proposal = "In apps/launchpad/web/src/widgets/chat/dm-thread.tsx and apps/launchpad/web/src/hooks/chat/use-chat.ts pass the highest visible received sequence to markRead and cancel a pending mark when visibility or the viewed range changes. Verify an arrival while Earlier messages is selected."
owner_domain = 4

[finding.event-argument-collision]
file = "sdk/launchpad/protocol/events.go"
line = 58
class = "interface-mismatch"
severity = "high"
observed = "The topic-only eventRegistry retains the first ABI for duplicate topic0 values. SidioraNFT precedes FeesRouter and names the indexed FeeStrategyChanged(uint256,uint8,uint8) argument tokenId; FeesRouter names it nftId. indexer/internal/decode maps this FeesRouter log to tokenId, but processor.handleFeeStrategyChanged reads nftId and rejects it. The emitter-aware registry elsewhere does not repair this exported LookupEvent path."
expected = "Requirement 4531.1 and the declared LookupEvent consumer require role event arguments to survive ABI decoding into the names and types accepted by the indexer processor, including identical signatures declared by different roles."
proposal = "In sdk/launchpad/protocol/events.go and services/launchpad/indexer/internal/decode select event schemas by verified emitter role plus topic, or normalize both role variants into an explicit canonical event before processor dispatch. Drive actual encoded logs from each role through Decode and handleFeeStrategyChanged."
owner_domain = 4
interface = "4.go-protocol-lookup-event"

[finding.event-schema-path-test]
file = "sdk/launchpad/protocol/events_test.go"
line = 24
class = "test-gap"
severity = "medium"
observed = "These tests verify signature hashes, declaring-contract membership, unknown topics and deterministic ordering, but do not decode the colliding FeeStrategyChanged schemas into the processor. The broader bindings proof compares role ABIs and round-trips Initialized; its registry membership check still accepts the first schema for this collision."
expected = "Requirements 4531.1 and 21057.1 need the real producer ABI through LookupEvent and the indexer consumer to preserve indexed argument names as well as topic signatures, with a refusal for malformed input."
proposal = "Extend sdk/launchpad/protocol/events_test.go and the owning indexer path proof to encode FeeStrategyChanged using both real role ABIs, decode through the exported registry and assert processor-visible nft identity and strategy values. Include incorrect emitter or malformed topic refusal."
owner_domain = 4

[finding.abi-cli-output-contract]
file = "sdk/launchpad/protocol/bootstrap/abi_baseline.py"
line = 60
class = "config-drift"
severity = "low"
observed = "The CLI requires --output, whereas registry row 4.cli-protocol-abi-baseline-j30 declares python3 bootstrap/abi_baseline.py --contracts <root> [--abi-root <dir>] without that required argument. Invoking the declared command is rejected by argparse before comparison."
expected = "The published command signature must include every required argument and distinguish read-only ABI evidence generation from deployment or live-chain qualification."
proposal = "Update the owning CLI declaration in spec/layerx-merge/interfaces.kvx for sdk/launchpad/protocol/bootstrap/abi_baseline.py to include --output <file>, retain required explicit output selection, and document a complete invocation beside the baseline tooling."
owner_domain = 4
interface = "4.cli-protocol-abi-baseline-j30"

[finding.pnl-channel-description]
file = "sdk/launchpad/shared/constants/constants.go"
line = 23
class = "doc-drift"
severity = "low"
observed = "The derived-state channel comment promises every channel carries the fresh cached snapshot plus its routing key. position/consumer.go instead publishes only {userAddress} on pnl:update and the browser intentionally refetches; the existing consumer test asserts that signal shape."
expected = "The shared channel descriptions must distinguish snapshot payloads from invalidation signals so another consumer does not interpret a routing-only message as a complete portfolio."
proposal = "In sdk/launchpad/shared/constants/constants.go describe pnl:update explicitly as a user-scoped invalidation signal and point consumers to the portfolio read path. Keep the existing producer and broker forwarding contract aligned."
owner_domain = 4
interface = "4.go-shared-constants-channel-pnl-update"

[finding.mutation-commit-telemetry]
file = "sdk/launchpad/shared/telemetry/metrics.go"
line = 63
class = "wiring-gap"
severity = "medium"
observed = "RecordMutation and RecordCommit are exported but have no call sites in launchpad services, SDK or tools. New initializes their series to zero and WritePrometheus exports them, while running services instrument only reads; mutations and durable commits therefore remain unobserved by these counters."
expected = "The advertised sli_mutation_* and durable_transaction_* metrics must reflect actual validation, authoritative transaction, outbox and acknowledgement outcomes from the service handling the operation."
proposal = "Wire sdk/launchpad/shared/telemetry/metrics.go RecordMutation and RecordCommit at the real launchpad mutation/commit boundaries, preserving bounded service and route labels. Verify successful commit, rollback and missing-ack outcomes through actual operations and exported metrics."
owner_domain = 4
interface = "4.go-shared-telemetry-metrics-record-mutation"

[finding.canonical-consumer-adapter]
file = "services/launchpad/pnl-tracker/internal/position/canonical.go"
line = 14
class = "dead-code"
severity = "low"
observed = "NewCanonicalConsumer and ProcessDelivery have no call sites. The application runs l16.AccountingConsumer and PrepareAndConsume directly, so this adapter is not the running production delivery boundary even though it exposes that role."
expected = "A delivery adapter should either be the application-owned entry path or be absent; production accounting must continue to use its durable inbox and real broker acknowledgement lifecycle."
proposal = "In services/launchpad/pnl-tracker/internal/app/app.go and internal/position/canonical.go choose one broker-delivery entry path: wire the adapter with actual natsdriver messages or remove the redundant wrapper. Preserve the currently wired l16 durability and recovery path."
owner_domain = 4

[finding.inventory-rebuild-adapter]
file = "services/launchpad/pnl-tracker/internal/reconcile/rebuild.go"
line = 12
class = "dead-code"
severity = "low"
observed = "NewInventoryRebuilder and RebuildPartition have no callers. The running journey invokes live.RebuildOwned directly in internal/app/app.go, while this unused adapter exposes the lower-level Service.Rebuild API."
expected = "The supported rebuild entry point must be clear and remain subject to the ownership, epoch and committed-height checks used by the running inventory service."
proposal = "In services/launchpad/pnl-tracker/internal/reconcile/rebuild.go remove the unused lower-level adapter or wire an explicitly authorized application path to it with the same ownership and epoch guarantees as RebuildOwned. Keep one documented rebuild lifecycle."
owner_domain = 4

[finding.legacy-reconcile-cache-recovery]
file = "services/launchpad/pnl-tracker/internal/reconcile/reconcile.go"
line = 76
class = "restart-recovery"
severity = "medium"
observed = "RunOnce commits each FoldTrade before advancing the cursor and invalidating touched users. A later poison row returns after advancing over successful rows; an AdvanceCursor error also returns before invalidation. Retrying committed rows yields inserted=false, so their touched users are never invalidated. This worker is the nonproduction legacy path; TTL limits stale-cache duration."
expected = "A successfully folded trade must leave a recoverable cache invalidation obligation even when the batch stops, the cursor update fails or the process restarts between database commit and invalidation."
proposal = "In services/launchpad/pnl-tracker/internal/reconcile/reconcile.go persist invalidation intent with each fold or durably drain touched users before advancing; make replay restore outstanding invalidations. Verify partial success followed by a poison row, cursor failure and restart without modifying the active l16 accounting path."
owner_domain = 4

[finding.legacy-reconcile-push]
file = "services/launchpad/pnl-tracker/internal/reconcile/reconcile.go"
line = 96
class = "wiring-gap"
severity = "medium"
observed = "The legacy reconciler invalidates Redis caches after a completed batch but never emits pnl:update. In contrast position.Consumer emits the userAddress signal after a new fold, so push-first clients can remain on an old portfolio after backfill until another event or explicit refresh."
expected = "Where the legacy realtime and backfill paths are enabled, a newly folded portfolio change must reach the same client refresh contract regardless of which path recovered the trade."
proposal = "In services/launchpad/pnl-tracker/internal/reconcile/reconcile.go publish the same user-scoped pnl:update signal for durably changed users, with a recoverable notification obligation and deduplication. Prove a backfilled swap reaches the actual broker and portfolio refresh subscriber."
owner_domain = 4
interface = "4.go-shared-constants-channel-pnl-update"

[finding.legacy-reconcile-restart-test]
file = "services/launchpad/pnl-tracker/internal/reconcile/reconcile_test.go"
line = 75
class = "test-gap"
severity = "medium"
observed = "The overlap test seeds indexer rows directly and calls Store.FoldTrade to simulate the realtime consumer. All reconciliation tests run on one process lifetime; none stops after a committed prefix, reopens persisted state and checks cursor, portfolio, cache and notification convergence after a poison row."
expected = "Backfill recovery must be proven using the actual enabled producer and consumer path across reopening persistent state, including partial-batch failure and duplicate overlap, rather than only direct store insertion."
proposal = "Extend services/launchpad/pnl-tracker/internal/reconcile/reconcile_test.go with a real legacy producer-to-consumer/backfill flow using actual Postgres and Redis; stop after a committed prefix, reopen the worker and assert one trade, the correct cursor, refreshed cache and user notification."
owner_domain = 4

[finding.legacy-consumer-path-test]
file = "services/launchpad/pnl-tracker/internal/position/consumer_test.go"
line = 44
class = "test-gap"
severity = "medium"
observed = "Consumer tests use real Postgres and Redis but invoke ProcessEvent with hand-built SwapEvent values and synthetic addresses. The separate webhook tests also hand-build their event bodies; these checks do not prove actual indexer-produced bytes, transport decoding and consumer state survive stop and reopen."
expected = "The legacy swap interface needs one producer-through-transport consumer proof with real emitted event shape and persisted idempotence across restart. Existing canonical l16 recovery coverage does not establish this separate legacy interface."
proposal = "Extend services/launchpad/pnl-tracker/internal/position/consumer_test.go and the owning webhook path proof to obtain a swap from the real indexer producer, deliver its serialized bytes through the enabled transport, reopen the consumer store and redeliver. Assert one trade, buy/sell units, cache invalidation and pnl:update."
owner_domain = 4

[finding.make-package-discovery]
file = "services/launchpad/Makefile"
line = 47
class = "runtime-risk"
severity = "medium"
observed = "has_pkgs discards go list stderr and recipes test only whether its stdout is empty. A package discovery failure with no stdout is treated as an empty scaffold and skipped by build, vet, lint, test, race and cover instead of failing the gate."
expected = "A module in MODULES may be skipped only after successful discovery proves it has no packages; parse, dependency and module-resolution errors must make the requested verification command fail."
proposal = "In services/launchpad/Makefile capture and propagate go list exit status before checking its output, retaining empty-scaffold support only on successful discovery. Add a workspace-gate regression for a listed module with a real package discovery error."
owner_domain = 4
interface = "4.mk-launchpad-build-j29"

[finding.coverage-module-inventory]
file = "tools/launchpad/coverage-gate.sh"
line = 25
class = "wiring-gap"
severity = "medium"
observed = "The coverage gate iterates only profiles already present in COVER_DIR and requires merely one profile. It has no expected MODULES inventory or freshness check, so missing module profiles are invisible and retained profiles from an earlier cover run can substitute for modules skipped by failed discovery."
expected = "A gate described as enforcing every module coverage threshold must account for every current code-bearing module and use coverage generated for the current candidate, while explicitly identifying genuinely empty modules."
proposal = "In tools/launchpad/coverage-gate.sh and services/launchpad/Makefile pass the expected module inventory and a fresh run manifest, reject missing or stale profiles and record explicit empty-module results. Cover omission of one money module while another module has a passing profile."
owner_domain = 4
interface = "4.cli-lp-tools-coverage-gate"

