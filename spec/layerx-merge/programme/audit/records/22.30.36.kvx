[finding.launchpad-contract-guide]
file = "contracts/launchpad/README.md"
line = 124
class = "doc-drift"
severity = "medium"
observed = "The README says indexers need exactly one EventEmitter address and every event contains poolId, timestamp and block number. Actual role ABIs include directly emitted role events with different fields, including FeeStrategyChanged on FeesRouter and SidioraNFT. This one-address subscription misses role-specific emissions such as FeeStrategyChanged and AccountingMigrated."
expected = "Launchpad integration guidance must describe all deployed role event emitters and their exact payloads so indexers can subscribe to and interpret role-specific events correctly."
proposal = "Rewrite contracts/launchpad/README.md event subscription guidance from current role ABIs and the protocol registry, listing emitter identities and exact role payloads, including distinct fee-strategy schemas. Document which events are mirrored through EventEmitter and which require direct subscriptions."
