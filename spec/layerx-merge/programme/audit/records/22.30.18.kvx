owner_domain = 3

[finding.19]
file = "services/platform/perps-data/loadtest/load_test.go"
line = 203
class = "test-gap"
severity = "medium"
observed = "trader writes fills and projections with direct SQL and publishes an independently assembled envelope whose payload contains only block_time. The production facts writer publishes the full typed fill payload through the transactional delivery outbox. The scaled load test therefore bypasses fact serialization, atomic outbox enqueueing and normal projection writes under load."
expected = "The brief requires producer, transport and consumer agreement through the real path. A performance fixture with a third payload shape cannot establish production payload compatibility or the latency of the actual writer and publisher."
proposal = "Drive the workload in services/platform/perps-data/loadtest/load_test.go through real decode row types, store.WriteBlock and the production outbox publisher into the gateway. Retain the existing socket count, reconnect, checksum, latency and recovery bounds, and assert full production envelopes are consumed during the same profile."
owner_domain = 3

[finding.20]
file = "services/platform/perps-data/e2e_test.go"
line = 417
class = "test-gap"
severity = "medium"
observed = "TestEndToEnd calls t.Skip when the database, RPC and Comet variables are all absent. That can produce a green package run without exercising the venue trade, delivery, replay and restart journey; the other end-to-end cases use setupE2E and fail missing dependencies."
expected = "Data-services section 23 explicitly says a test needing an external dependency fails, never skips, when it is unset. Requirement 22998.1 also forbids skipped tests from serving as evidence that the recorded target passes."
proposal = "In services/platform/perps-data/e2e_test.go, require the same explicit setup validation as the other end-to-end cases. Ensure the owning qualification harness provisions the real database and node before selecting this test, and report absent inputs as failed setup without deleting or weakening the journey assertions."
owner_domain = 3
interface = "3.env-perps-data-perps-data-test-database-url-j27"

