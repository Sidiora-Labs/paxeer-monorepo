[finding.retired-program-routes]
file = "services/agent/sdk/python/layerx_sdk/agent_http.py"
line = 60
class = "retired-reference"
severity = "medium"
observed = "_ROUTES maps deploy, upgrade, wind-down and call mutations to /v1/programs/deploy, /upgrade, /wind-down and /call, and the lifecycle encoder binds the old signed_activity before transport."
expected = "The retired-component inventory replaces these program mutation ingress routes with signed EVM transactions to 0x101D; local review, session authentication and preparation must remain available."
