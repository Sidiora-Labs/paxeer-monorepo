[finding.graph-restore]
file = "services/agent/crates/layerx-agentd/src/capability/attenuate.rs"
line = 279
class = "restart-recovery"
severity = "medium"
observed = "decode_graph inserts persisted nodes directly, overwriting duplicate IDs and accepting foreign tenants, missing parents and cycles. chain and is_enabled follow parents without a visited set, so a self-parent in restored data loops indefinitely."
expected = "Restored capability graphs must retain the tenant, uniqueness and attenuation invariants enforced by insert_root and attenuate, and reject corrupt ancestry before serving authorization."
proposal = "In services/agent/crates/layerx-agentd/src/capability/attenuate.rs validate every restored node, parent and attenuation edge, reject duplicate IDs and cycles, and bound traversal; cover corrupt and valid restart cases."
owner_domain = 9
interface = "9.rs-agentd-capability-attenuate-capabilitygraph-j43"

[finding.native-send-envelope]
file = "services/agent/crates/layerx-agentd/src/capability/binding.rs"
line = 3490
class = "retired-reference"
severity = "medium"
observed = "verify_native_send_canonical reconstructs layerx_wire::activity::encode_unsigned_envelope and the ed25519 signing preimage from Prepared.envelope. Native send admission still depends on the retired economic activity framing."
expected = "Native send preparation and restoration must bind the raw EIP-1559 transaction, chain ID 125, sender, destination, calldata and nonce without the retired LayerX activity envelope (brief and requirement 22063.1)."
proposal = "Migrate services/agent/crates/layerx-agentd/src/capability/binding.rs native-send admission and restoration to the signed EVM transaction binding used by preparation; preserve replay consumption and exact retained bytes."
owner_domain = 9
interface = "9.rs-agentd-capability-binding-native-send-purpose-digest-j43"

[finding.registration-principal]
file = "services/agent/crates/layerx-agentd/src/capability/effects.rs"
line = 379
class = "retired-reference"
severity = "medium"
observed = "native_registration_terms derives the issuer with did_id_for_protocol(actor,3), and derive_native_registration derives the fee principal with AccountId::for_asset and account_id_for_protocol. The economic principal remains a DID-derived legacy account."
expected = "Merged economic authorization must follow the EVM address and its bound ledger owner/account, while DID ed25519 proof remains identity authority; registration and fee debit must identify the same live account."
proposal = "Update services/agent/crates/layerx-agentd/src/capability/effects.rs with the owning ledger domain to derive registration issuer and fee principal from the verified EVM preparation and ledger account lookup, retaining supply-cap checks."
owner_domain = 9
interface = "9.rs-agentd-capability-effects-derive-native-registration-j43"

[finding.ingest-producer-coverage]
