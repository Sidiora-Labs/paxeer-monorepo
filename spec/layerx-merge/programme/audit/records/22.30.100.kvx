[finding.unverified-market-finality]
file = "services/agent/sdk/python/layerx_sdk/ai_market.py"
line = 1714
class = "security"
severity = "high"
observed = "OperationJournal.finalize promotes an EXECUTED record to FINALIZED and COMMITTED using a caller-constructed CommitFinality after a height comparison. app_hash and store_proof_digest are never verified or used; a receipted transaction without landing evidence can be finalized with arbitrary nonzero digests."
expected = "A market operation is final only when its transaction is included in a BFT committed block. An unverified height/hash DTO must not turn a signed execution receipt into a committed operation."
proposal = "In services/agent/sdk/python/layerx_sdk/ai_market.py accept finality produced by commit/validator and transaction-inclusion verification, bind it to the retained transaction hash and landing block, and retain receipted state until that evidence succeeds."
owner_domain = 9

[finding.journal-short-write]
file = "services/agent/sdk/python/layerx_sdk/ai_market.py"
line = 1608
class = "restart-recovery"
severity = "medium"
observed = "OperationJournal.persist calls os.write once without checking its returned byte count, then fsyncs and replaces the durable record. A successful short write publishes a truncated journal in place of the last recoverable operation."
expected = "A durable signed-operation journal must publish the complete serialized record or leave its prior record intact, including under partial writes and storage failures."
proposal = "Use a complete-write loop or a checked buffered write in services/agent/sdk/python/layerx_sdk/ai_market.py before fsync/rename, and verify partial-write failure leaves restart recovery with an intact record."
owner_domain = 9

[finding.legacy-exchange-writes]
file = "services/agent/sdk/python/layerx_sdk/exchange.py"
line = 428
class = "retired-reference"
severity = "medium"
observed = "exchange_request_settlement_call still builds requestSettlement(bytes32) at 0x1015, and the module advertises legacy LayerXExchange methods at the address now selected for Perps. The registry marks these exchange signatures as pre-v6120."
expected = "After the version switch 0x1015 uses the current Perps ABI; retired exchange intents and requestSettlement must not be presented as current merged-network settlement operations."
proposal = "Retire the legacy public exchange builders in services/agent/sdk/python/layerx_sdk/exchange.py or place them behind explicit historical-version APIs; route current orders and positions through the canonical perps builders."
owner_domain = 9
interface = "3.pc-0x1015-exchange-requestsettlement"

[finding.mirror-request-shape]
file = "services/agent/sdk/python/layerx_sdk/mirror.py"
line = 58
class = "interface-mismatch"
severity = "high"
observed = "MirrorVerifier.receipt emits evidence={kind:receipt,canonical_hex:...} and state emits kind:state with canonical_hex/proof_hex. The real layerx-mirror-verify EvidenceRequest denies unknown fields and accepts only Receipt{index} or Committed, so both Python entry points are refused as malformed."
expected = "Python mirror requests must round-trip with services/interop/crates/layerx-mirror/src/bin/layerx-mirror-verify.rs using a mirrored receipt index or the committed-header query, with the same source policy."
proposal = "Change services/agent/sdk/python/layerx_sdk/mirror.py to expose receipt-by-index and committed-header verification matching the executable, retire the removed state-proof request, and qualify both against the real process."
owner_domain = 9
interface = "11.cli-mirror-verify"

[finding.mirror-response-shape]
file = "services/agent/sdk/python/layerx_sdk/mirror.py"
line = 100
class = "interface-mismatch"
severity = "high"
observed = "decode_mirror_process_result requires checkpointLevel=unavailable plus batchNumber and headerDigest. The current executable report emits committedHeight and committedBlockHash, omits those retired fields and permits null evidenceDigest for Committed; valid current output is rejected."
expected = "The mirror result must expose the committed block height/hash emitted by the actual verifier, with evidence digest optional for a committed-header request and no invented checkpoint field."
proposal = "Update MirrorVerification and decode_mirror_process_result in services/agent/sdk/python/layerx_sdk/mirror.py to the executable report schema, and verify a real receipt result and committed-header result through the subprocess boundary."
owner_domain = 9
interface = "11.cli-mirror-verify"

[finding.trading-id-whitespace]
file = "services/agent/sdk/python/layerx_sdk/perps.py"
line = 34
class = "runtime-risk"
severity = "medium"
observed = "_check_id validates text length and lowercase but bytes.fromhex ignores whitespace, and the decoded size is not checked. A 64-character identifier containing spaces can encode fewer than 32 bytes, shifting every following fixed-width field."
expected = "Every perps and spot identifier must contain exactly 64 lowercase hexadecimal digits and encode exactly 32 bytes before a fixed-width payload is built."
proposal = "Require an exact hexadecimal alphabet and a 32-byte result in services/agent/sdk/python/layerx_sdk/perps.py _check_id, and cover whitespace-containing IDs in both perps and spot payload construction."
owner_domain = 9

