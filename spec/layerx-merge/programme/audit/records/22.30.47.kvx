line = 35
class = "doc-drift"
severity = "medium"
observed = "The ABCI++ client/server draft says the repository supports socket and GRPC servers and abci-cli transport selection. The ABCI++ index already warns those transports are not implemented in this fork, leaving a contradictory linked integration recipe."
expected = "A linked client/server guide must carry the same supported-transport boundary as consensus/spec/abci++/README.md and the in-process Application implementation."
