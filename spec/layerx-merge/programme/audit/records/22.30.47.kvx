[finding.abci-framing-contradiction]
file = "consensus/spec/abci/client-server.md"
line = 70
class = "doc-drift"
severity = "medium"
observed = "The historical socket section calls its length prefix a signed protobuf Varint, then defines a length-of-length big-endian prefix and gives 0x0104DEADBEEF for four bytes. Line 91 explicitly says the latter framing was replaced by varint. The linked ABCI++ client/server draft repeats both incompatible descriptions at lines 71 and 79-87."
expected = "Even archived protocol material must distinguish incompatible framing versions so an implementer does not construct a third wire shape."
proposal = "Correct the framing example in consensus/spec/abci/client-server.md and the paired ABCI++ draft to the cited upstream version, explicitly naming signed or unsigned varint behavior and keeping the fork's in-process-only warning."
owner_domain = 5

[finding.proposal-sizing-legacy]
file = "consensus/spec/consensus/creating-proposal.md"
line = 16
class = "doc-drift"
severity = "medium"
observed = "The proposal guide budgets Amino overhead using MaxAminoOverheadForBlock and an evidence-count formula. consensus/types/block.go:332 instead implements MaxDataBytes(maxBytes, evidenceBytes, valsCount), using protobuf overhead and actual evidence byte size; Autobahn has its separate payload limits."
expected = "Proposal sizing guidance must use the actual encoding and byte limits enforced by the selected consensus mode."
proposal = "Update consensus/spec/consensus/creating-proposal.md to describe current protobuf and evidence-byte accounting and separately state Autobahn's transaction-count, payload-byte and certificate transport budgets."
owner_domain = 5

[finding.time-units-and-mode]
file = "consensus/spec/consensus/bft-time.md"
line = 18
class = "doc-drift"
severity = "medium"
observed = "BFT Time describes int64 Unix milliseconds and a classic weighted-median voting algorithm. core/data_structures.md and internal/autobahn/autobahn.proto encode seconds plus nanos, and Autobahn proposal.go assigns consensus time with one-microsecond offsets and a lower-bound check instead of that median."
expected = "Time documentation must state the actual wire units, precision and time-validation rule for each enabled consensus mode."
proposal = "Correct consensus/spec/consensus/bft-time.md's wire representation and mark the weighted-median algorithm's applicability; link the Autobahn timestamp and timeliness contract, including its treatment of certified reproposals."
owner_domain = 5

[finding.evidence-finalize-lifecycle]
file = "consensus/spec/consensus/evidence.md"
line = 143
class = "doc-drift"
severity = "medium"
observed = "The evidence guide says committed evidence is delivered to the application via EndBlock. consensus/internal/state/execution.go:390 sends Misbehavior in RequestFinalizeBlock, and the current Application interface has FinalizeBlock rather than an EndBlock method."
expected = "Application developers must receive the correct evidence-bearing request and understand when evidence becomes committed and actionable."
proposal = "Rewrite consensus/spec/consensus/evidence.md's commit lifecycle around RequestFinalizeBlock.Misbehavior and the current execution order, clearly distinguishing classic evidence handling from Autobahn's supported behavior."
owner_domain = 5

[finding.wal-mode-recovery-gap]
file = "consensus/spec/consensus/wal.md"
line = 3
class = "doc-drift"
severity = "medium"
observed = "The sole WAL guide describes autofile.Group, last-height message replay and private-validator LastSignBytes. It does not identify that Autobahn uses PersistedInner, indexed FullCommitQC/block WALs and an A/B availability prune anchor under persistent_state_dir."
expected = "Operators enabling Autobahn must have mode-specific recovery instructions that preserve vote safety, certified data and pruning boundaries after a crash."
proposal = "Extend consensus/spec/consensus/wal.md with Autobahn's persistence directory, startup invariants and supported recovery procedure; link the consensus/persist and data recovery paths and explicitly scope classic WAL replay guidance."
owner_domain = 5

[finding.state-finalize-apphash]
file = "consensus/spec/core/state.md"
line = 50
class = "doc-drift"
severity = "medium"
observed = "The state guide derives AppHash from ResponseCommit.Data and validators/parameters from ResponseEndBlock. consensus/internal/state/execution.go:571 uses ResponseFinalizeBlock.AppHash and lines 730-745 apply FinalizeBlock updates; Commit makes state durable and returns retention information."
expected = "The documented application-state transition must match the actual producer of AppHash and validator/consensus parameter updates and its durable commit ordering."
proposal = "Rewrite consensus/spec/core/state.md using ResponseFinalizeBlock and the in-process Commit lifecycle, showing which fields feed next-state and how saved responses and application state recover after restart."
owner_domain = 5

[finding.block-part-encoding-limit]
file = "consensus/spec/core/encoding.md"
line = 102
class = "doc-drift"
severity = "medium"
observed = "The encoding specification states a 65,536-byte part size and maximum 1,601 parts. consensus/types/params.go:20 sets BlockPartSizeBytes to 1,048,576 and derives MaxBlockPartsCount from MaxBlockSizeBytes; Part.ValidateBasic and the event-bus tests consume that current limit."
expected = "A peer implementation must use the block part sizes and derived count limit accepted by the running classic protocol, separately from Autobahn payload transport."
proposal = "Correct consensus/spec/core/encoding.md's part sizing from consensus/types/params.go and document the derived maximum count and current protobuf messages; identify which rules apply only to classic block gossip."
owner_domain = 5

[finding.part-and-round-shapes]
file = "consensus/spec/core/data_structures.md"
line = 172
class = "doc-drift"
severity = "medium"
observed = "The Part table describes index as a positive int32 and payload/proof as 32-byte Merkle roots. The producer uses a zero-based uint32 index, variable block bytes and a structured Merkle proof. The Proposal table at lines 295-297 also requires positive Round/POLRound, whereas types/proposal.go accepts round zero and POLRound -1 or an earlier round."
expected = "Core data-structure tables must accept the fields emitted by real part and proposal producers, including first-part index zero and an initial proposal with no proof-of-lock round."
proposal = "Rewrite consensus/spec/core/data_structures.md's Part and Proposal tables from the protobuf and ValidateBasic implementations, naming variable bytes, structured proof and the exact round/POLRound ranges."
owner_domain = 5

[finding.p2p-cli-spelling]
file = "consensus/spec/p2p/config.md"
line = 22
class = "doc-drift"
severity = "medium"
observed = "The peer configuration recipes use --p2p.persistent_peers and --p2p.private_peer_ids. consensus/cmd/tendermint/commands/run_node.go registers p2p.persistent-peers and p2p.private-peer-ids, so those documented flag names are not accepted by the command."
expected = "Operator recipes must use the registered CLI spelling and distinguish it from configuration-file key names."
proposal = "Correct consensus/spec/p2p/config.md to use the hyphenated registered flags through paxd's supported command and keep TOML key spelling in a separately identified configuration example."
owner_domain = 5

[finding.p2p-amino-packets]
file = "consensus/spec/p2p/connection.md"
line = 21
class = "doc-drift"
severity = "medium"
observed = "The connection guide defines raw 0x01/0x02 ping/pong packets and at line 64 says messages use go-amino WriteBinary. consensus/internal/p2p/conn/oldmux.go emits protobuf PacketPing/PacketPong inside pb.Packet and marshals the packet, while the current connection API is context-aware."
expected = "Peer wire guidance must match the current packet envelopes and serialization and distinguish the compatibility multiplexer from other supported transports."
proposal = "Rewrite consensus/spec/p2p/connection.md against conn/oldmux.go and the packet protobuf, identifying actual framing, packet variants, channel limits and context/error lifecycle for the fork."
owner_domain = 5

[finding.p2p-handshake-amino]
file = "consensus/spec/p2p/peer.md"
line = 59
class = "doc-drift"
severity = "medium"
observed = "The peer guide says persistent keys and challenge signatures are sent in an Amino message. The running fork negotiates an ephemeral protobuf Preface in conn/secret_connection.go and uses the node handshake messages in internal/p2p for authentication; the guide gives no mapping to that current wire path."
expected = "A third-party peer must know the actual ephemeral and authenticated handshake stages, encodings and key checks used by paxd."
proposal = "Update consensus/spec/p2p/peer.md from conn/secret_connection.go and internal/p2p handshake consumers, replacing the Amino description with current protobuf message shapes and exact authentication ordering."
owner_domain = 5

[finding.blocksync-base-field]
file = "consensus/spec/p2p/messages/block-sync.md"
line = 56
class = "doc-drift"
severity = "medium"
observed = "The StatusResponse table assigns both height and base protobuf field number 1. consensus/proto/tendermint/blocksync/types.proto assigns height=1 and base=2, which lets receivers distinguish the lowest retained block from the tip."
expected = "The documented block-sync wire shape must give base its actual field number and preserve pruning semantics in peer implementations."
proposal = "Correct consensus/spec/p2p/messages/block-sync.md to show StatusResponse.base as field 2, and derive the table from the current protobuf alongside its retained-height meaning."
owner_domain = 5

[finding.consensus-wire-tables]
file = "consensus/spec/p2p/messages/consensus.md"
line = 86
class = "doc-drift"
severity = "medium"
observed = "The consensus message table calls NewValidBlock.block_parts an int32, omits VoteSetMaj23.block_id, and calls oneof field 7 ReceivedVote. consensus/proto/tendermint/consensus/types.proto uses BitArray, block_id=4 and HasVote/has_vote respectively."
expected = "Classic gossip message documentation must preserve the exact field types and variant names accepted by its protobuf transport and consumers."
proposal = "Correct consensus/spec/p2p/messages/consensus.md from the current consensus protobuf and describe BitArray contents, VoteSetMaj23's certified block ID, and the HasVote variant; label this protocol separately from Autobahn RPC."
owner_domain = 5

[finding.snapshot-chunk-field]
file = "consensus/spec/p2p/messages/state-sync.md"
line = 63
class = "doc-drift"
severity = "medium"
observed = "The ChunkResponse table calls field 4 hash and describes field 5 missing as arbitrary application data. consensus/proto/tendermint/statesync/types.proto defines bytes chunk=4 and bool missing=5, which the consumer uses as snapshot contents and absence indication."
expected = "Snapshot transport documentation must identify chunk bytes and the absence boolean rather than instruct a peer to send a snapshot digest in place of recoverable data."
proposal = "Rewrite consensus/spec/p2p/messages/state-sync.md's ChunkResponse table to match the live protobuf and snapshot consumer, including empty-chunk versus missing behavior and application verification of actual bytes."
owner_domain = 5

[finding.rpc-invalid-examples]
file = "consensus/spec/rpc/README.md"
line = 1028
class = "doc-drift"
severity = "medium"
observed = "The unconfirmed_txs JSON-RPC curl example lacks a closing quote on the method. The ABCIQuery examples at lines 1321-1327 contain path=...=IHAVENOIDEA and params.bool as a string instead of prove; several POST examples also select HTTPS despite the ordinary HTTP local listener used elsewhere."
expected = "Copyable local RPC examples must be syntactically valid, use the registered route's parameter names and types, and match the listener scheme."
proposal = "Repair consensus/spec/rpc/README.md's local request examples using current routes.go and ABCIQuery signatures: correctly quote URLs and JSON, pass data separately and prove as the accepted boolean, and use the configured local scheme."
owner_domain = 5

[finding.proposer-selection-mode]
file = "consensus/spec/consensus/proposer-selection.md"
line = 10
class = "doc-drift"
severity = "medium"
observed = "The proposer-selection guide describes validator updates through ABCI EndBlock and presents weighted round-robin as the protocol's selection procedure. Current state execution uses FinalizeBlock updates, and Autobahn's Committee.Leader hashes the committee domain with road index and view before weighted selection."
expected = "Readers must know which proposer-election rule applies to classic versus Autobahn and which application response can update the classic validator set."
proposal = "Update consensus/spec/consensus/proposer-selection.md's lifecycle names and mode applicability, documenting Autobahn's committee-bound deterministic weighted selection and its supported committee-change lifecycle separately."
owner_domain = 5

[finding.ivy-exit-status-lost]
file = "consensus/spec/ivy-proofs/check_proofs.sh"
line = 11
class = "test-gap"
severity = "medium"
observed = "All three proof invocations pipe ivy_check through tee and tail and accept only a final stdout line equal to OK. Without pipefail or an explicit checker-status capture, a nonzero ivy_check exit accompanied by that line, or a tee output failure, can still lead to exit 0 and an apparent successful proof."
expected = "A proof helper that promises a nonzero result on failure must retain the checker's exit status and evidence-writing errors as well as its expected success marker."
proposal = "Repair consensus/spec/ivy-proofs/check_proofs.sh to capture every ivy_check and logging exit reliably and require both successful execution and the expected proof result; preserve all three proof invocations and complete private logs."
owner_domain = 5

[finding.accountability-local-harness]
file = "consensus/spec/light-client/accountability/run.sh"
line = 5
class = "config-drift"
severity = "medium"
observed = "The accountability experiment runner hardcodes both SCRIPTS_DIR and the makefile to ~/devl/apalache-tests and chooses BUILDS=unstable. Those files are not supplied by this repository, so the documented ./run.sh entry point depends on an author's private checkout and an unversioned external toolchain."
expected = "A published research runner must identify reproducible external prerequisites and allow their actual installed locations without depending on one author's home layout."
proposal = "Parameterize and document the pinned Apalache experiment harness path in consensus/spec/light-client/accountability/run.sh and Synopsis.md, validate prerequisites explicitly, and retain the full benchmark set with revision-tagged results."
owner_domain = 5

