[finding.carried-app-state]
file = "consensus/autobahn/types/proposal.go"
line = 467
class = "security"
severity = "high"
interface = "15.go-consensus-autobahn-types-full-proposal-j57"
observed = "FullProposal.Verify compares carried AppProposal values only through NextOpt (RoadIndex+1). When the road index equals the previous CommitQC's, it rejects an extra appQC but never compares GlobalNumber or AppHash. An elected faulty leader can sign a different carried application hash without an AppQC; consensus/inner.go:192 accepts it for prepare voting and data/state.go:550 exposes it as GlobalBlock.FinalAppState. That certified metadata is no longer backed by the earlier application quorum."
expected = "Carrying a previously certified application state forward must preserve the exact certified height, road index and state hash; a leader signature alone cannot replace application-quorum evidence."
proposal = "In consensus/autobahn/types/proposal.go require complete equality with the previous certified AppProposal in the equal-index branch. Add a real signed proposal through ConsensusReqConv and State.Push demonstrating rejection of same-index changes to AppHash and GlobalNumber and preservation after WAL recovery."
owner_domain = 5

[finding.full-commit-header-limit]
file = "consensus/autobahn/types/commit_qc.go"
line = 70
class = "interface-mismatch"
severity = "high"
interface = "15.go-consensus-autobahn-types-full-commit-qc-conv-j57"
observed = "NewFullCommitQC and FullCommitQC.Verify accept one header for every finalized block without a 100-header cap. WaitForLaneQCs in consensus/internal/autobahn/avail/state.go:550 may select ten blocks per lane; eleven lanes can yield 110 headers. FullCommitQCConv.Marshal emits them, but autobahn.proto:141 and pb/autobahn.wireguard.go:67 cap headers at 100. protoutils.Unmarshal applies that scanner both on peer sync and when FullCommitQCPersister reopens its WAL."
expected = "Every locally finalized FullCommitQC must be readable by peer synchronization and by the node's own WAL decoder after restart under the same protocol limits."
proposal = "Make proposal admission and lane selection in consensus/autobahn/types/proposal.go and internal/autobahn/avail/state.go enforce the existing total certificate header limit before signing, with fair progress across lanes. Prove a busy eleven-lane producer through FullCommitQCConv, the real sync stream and persisted WAL reopening; retain rejection of oversized certificates."
owner_domain = 5

[finding.committee-wire-limit]
file = "consensus/autobahn/types/committee.go"
line = 154
class = "interface-mismatch"
severity = "high"
interface = "15.go-consensus-autobahn-types-committee-j57"
observed = "NewCommittee validates nonempty chain ID, positive total weight and overflow but accepts more than 100 positive-weight replicas. NewProposal emits a lane range for every replica and QC constructors can collect more than 100 signatures, while autobahn.proto caps lane_ranges, lane_qcs, sigs and timeout votes at 100. A committee accepted in memory can therefore produce messages its peer and recovery decoders reject."
expected = "An admitted validator committee must be able to encode, transmit and recover its ordinary consensus artifacts within the declared wire limits."
proposal = "Validate the supported committee size against the existing protocol bounds in consensus/autobahn/types/committee.go and consensus/config/autobahn.go before startup. Add boundary coverage using a real committee producer, serialized proposal and QC transports and persisted replay; do not bypass the wire scanner."
owner_domain = 5

[finding.consensus-message-size]
file = "consensus/autobahn/types/proposal.go"
line = 303
class = "interface-mismatch"
severity = "high"
interface = "15.go-consensus-autobahn-types-new-proposal-j57"
observed = "NewProposal includes every supplied laneQC without budgeting the serialized ConsensusReq. With thirty-two equal-weight replicas, thirty-two nonempty lanes and the minimum eleven signatures per LaneQC, signature bytes alone occupy 22 KiB, before signer keys, proposal and timeout evidence. The producer accepts this structure, while the Consensus RPC in consensus/internal/p2p/giga/api.go:63 admits only 10 KiB messages."
expected = "A valid proposal produced for an admitted committee must traverse the registered Consensus RPC without exceeding its message budget, including all required justification."
proposal = "In consensus/autobahn/types/proposal.go and the consensus configuration, establish a supported committee and justification budget that fits the existing transport bound before signing. Select a bounded fair subset of lanes where sufficient, and explicitly reject unsupported configurations. Prove the largest admitted fresh and timeout proposals over the real Consensus stream."
owner_domain = 5

[finding.future-consensus-time]
file = "consensus/autobahn/types/proposal.go"
line = 402
class = "runtime-risk"
severity = "high"
interface = "15.go-consensus-autobahn-types-proposal-j57"
observed = "FullProposal.Verify checks that proposal.Timestamp is no earlier than the previous proposal or genesis, but imposes no timeliness upper bound. An elected Byzantine leader can choose a far-future timestamp, obtain honest prepare votes through consensus/inner.go:192 and force following proposals to remain beyond it. data/state.go:547 assigns that timestamp to blocks and giga_router.go passes it to application execution."
expected = "The BFT time-validity property described in consensus/spec/consensus/bft-time.md must prevent one faulty proposer from arbitrarily advancing application time and affecting expiry, unlocking or evidence age; proposer-based timestamp documentation likewise requires a timeliness check."
proposal = "Specify and implement an Autobahn timeliness rule using the consensus clock and synchrony assumptions in consensus/autobahn/types/proposal.go and consensus/internal/autobahn/consensus. Have validators decline far-future proposals before voting, while retaining justified reproposal safety. Prove a faulty-leader transition and recovery without allowing application time to jump."
owner_domain = 5

[finding.timestamp-canonical-range]
file = "consensus/autobahn/types/time.go"
line = 31
class = "runtime-risk"
severity = "medium"
observed = "TimeConv.Decode checks presence of Seconds and Nanos and then calls time.Unix, which normalizes negative or billion-plus nanos and accepts seconds outside years 0001..9999. consensus/internal/autobahn/autobahn.proto:18-25 explicitly specifies those bounds. Malformed wire timestamps are silently changed during decoding and can later fail JSON timestamp serialization or change on re-encoding."
expected = "Consensus timestamp decoders must reject values outside their declared canonical range instead of silently normalizing signed message fields."
proposal = "Validate seconds and nanos against the declared Timestamp bounds in consensus/autobahn/types/time.go before constructing time.Time, and apply the same supported range when encoding locally produced values. Cover malformed proposal and payload bytes through the real decoder and RPC serialization."
owner_domain = 5

[finding.mutable-hashed-payload]
file = "consensus/autobahn/types/block.go"
line = 188
class = "runtime-risk"
severity = "medium"
interface = "15.go-consensus-autobahn-types-payload-builder-j57"
observed = "PayloadBuilder.Build stores the caller's [][]byte directly; Payload.Txs and ToBuilder expose the same backing storage. NewBlock caches PayloadHash and NewHashed in msg.go:66 caches a signature hash. Mutating the builder or an accessor after hashing changes the serialized transactions without updating these cached commitments, despite the ReadOnly marker."
expected = "Published and signed consensus payloads must retain their transaction bytes and commitments for their entire transport and persistence lifetime."
proposal = "Make transaction ownership explicit in consensus/autobahn/types/block.go: copy transaction slices and bytes at the immutable boundary and avoid returning mutable backing storage. Prove that changes to the original builder and returned values cannot change a signed block's wire bytes or persisted replay."
owner_domain = 5

[finding.unused-alternate-block-hash]
file = "consensus/autobahn/types/block.go"
line = 295
class = "dead-code"
severity = "low"
interface = "15.go-consensus-autobahn-types-global-block-j57"
observed = "GlobalBlock.CalculateBlockHash has no Go caller in the repository. It hashes a synthetic Ethereum header containing only payload creation time, global number and gas, whereas the live GigaRouter uses b.Header.Hash for application execution and block identity. The unused helper also omits transactions and parent commitment from that synthetic identity."
expected = "The consensus types API should expose an unambiguous block identity matching the value consumed by execution and RPC."
proposal = "Remove the unused CalculateBlockHash helper from consensus/autobahn/types/block.go in an owning-domain repair, or give any required Ethereum-header projection an explicit distinct contract and real consumer. Keep Header.Hash as the documented live identity."
owner_domain = 5

[finding.app-qc-tests-wrong-branch]
file = "consensus/autobahn/types/proposal_test.go"
line = 594
class = "test-gap"
severity = "medium"
interface = "15.go-consensus-autobahn-types-new-proposal-j57"
observed = "TestProposalVerifyRejectsAppQCMismatch and TestProposalVerifyRejectsInvalidAppQCSignature construct an AppQC at committee.FirstBlock with an empty ViewSpec. NewProposal clears it as future at proposal.go:341. Attaching the replacement AppQC then produces 'unnecessary appQC', so require.Error succeeds without reaching the hash-mismatch or signature-validation branch named by either test."
expected = "Application-certificate negative tests must start from a valid producer-emitted committed history and demonstrate rejection for the intended mismatch or invalid signature."
proposal = "In consensus/autobahn/types/proposal_test.go first produce and commit a real block, certify that finalized application state, and assert the untampered proposal verifies. Then change only the certificate content or signer and assert the precise failure, driving its serialized transport into the verifier."
owner_domain = 5

[finding.codec-tests-miss-production-bounds]
file = "consensus/autobahn/types/types_test.go"
line = 32
class = "test-gap"
severity = "medium"
interface = "15.go-consensus-autobahn-types-full-commit-qc-conv-j57"
observed = "TestConv exercises converters with GenFullCommitQC and GenFullProposal assembled from independent random parts in testonly.go, with signatures bound to a private test domain. These fixtures do not exercise a verified committee-produced certificate at the real 100-header or 10-KiB transport boundaries, nor reopen that certificate from its production WAL."
expected = "The interface proof must use the actual committee, producer, bounded transport and persisted consumer rather than converter-only fixtures that cannot represent a valid finalized history."
proposal = "Keep the existing codec checks and add producer-to-sync and producer-to-WAL-recovery cases in consensus/autobahn/types/types_test.go and the owning internal/autobahn tests, using a real busy committee at each supported limit and asserting every finalized block remains readable."
owner_domain = 5

[finding.event-reserved-keys]
file = "consensus/internal/eventbus/event_bus.go"
line = 129
class = "interface-mismatch"
severity = "medium"
interface = "15.go-consensus-internal-eventbus-event-bus-j57"
observed = "PublishEventTx promises to overwrite reserved tm.event, tx.hash and tx.height keys, but appends reserved events to data.Result.Events without removing conflicting application attributes. pubsub.Server.send passes all values to query.Matches. A Tx can therefore match a supplied false tx.height or a different tm.event in addition to the actual reserved values."
expected = "Reserved event metadata delivered by EventBus must identify the actual event type, transaction hash and height unambiguously, as required by consumers of the registered event queries."
proposal = "Strip or reject reserved application attributes in consensus/internal/eventbus/event_bus.go before appending authoritative metadata, preserving unrelated duplicate application keys. Prove conflicting tm.event, tx.hash and tx.height values cannot route a real execution event to an incorrect subscriber."
owner_domain = 5

[finding.event-tests-no-reserved-collision]
file = "consensus/internal/eventbus/event_bus_test.go"
line = 126
class = "test-gap"
severity = "medium"
interface = "15.go-consensus-internal-eventbus-event-bus-j57"
observed = "TestEventBusPublishEventTxDuplicateKeys covers repeated transfer.sender values but never collisions with tm.event, tx.hash or tx.height, although PublishEventTx documents overwrite semantics. All payloads are constructed directly, so this suite also cannot establish that application-produced metadata is sanitized on its live path."
expected = "Event bus tests should prove the documented reserved-key behavior with actual producer output and subscriber matching, including application attributes that collide with reserved keys."
proposal = "Extend consensus/internal/eventbus/event_bus_test.go with a real application execution producer and event bus subscription asserting authoritative reserved values, no false-height matches and unchanged legitimate duplicate transfer attributes; retain the existing duplicate-application-key cases."
owner_domain = 5

[finding.mutable-app-hash]
file = "consensus/autobahn/types/app_proposal.go"
line = 24
class = "runtime-risk"
severity = "medium"
interface = "15.go-consensus-autobahn-types-app-proposal-j57"
observed = "NewAppProposal retains the caller's AppHash byte slice, AppHash returns it directly, and AppProposalConv also shares it. AppVote and its QC retain this proposal while NewHashed caches the signed commitment. A caller can therefore alter an application-state hash after certification and change subsequent encoded content without changing the cached signature preimage."
expected = "An application-state certificate must retain exactly the state hash that validators signed throughout transport, retention and recovery."
proposal = "Establish byte ownership in consensus/autobahn/types/app_proposal.go by copying AppHash at immutable construction and decode boundaries and returning independent bytes from accessors and encoders. Prove that mutation of input and returned buffers cannot change a signed application's serialized certificate or its persisted replay."
owner_domain = 5

[finding.retired-daemon-in-overview]
file = "consensus/README.md"
line = 16
class = "doc-drift"
severity = "medium"
observed = "The engine overview describes the LayerX kernel as a separate C17 layerxd execution domain. BRIEF.network.fact_2 retires that daemon and specifies the kernel as part of the single paxd network."
expected = "Operators must understand that the merged kernel runs within the network and that there is no separately running layerxd service."
proposal = "Rewrite consensus/README.md:16 to describe the kernel's integration into paxd and link to the merged-network architecture without a separate daemon or interface."
owner_domain = 5

[finding.missing-autobahn-spec-map]
file = "consensus/spec/README.md"
line = 17
class = "doc-drift"
severity = "medium"
observed = "The canonical specification table links classic Tendermint block, proposer, time and WAL descriptions but has no Autobahn mode applicability or protocol entry. consensus/README.md documents autobahn-config-file, and the audited types use lane certificates, committee-bound signatures and indexed persistence unlike these pages."
expected = "A reader enabling Autobahn must be able to identify its actual block identity, quorum, time, application-state and recovery contracts rather than infer classic Tendermint semantics."
proposal = "Add an Autobahn applicability map under consensus/spec/README.md and an owning protocol page covering the actual types, giga transport limits and durable restart path; label inherited classic and research material by mode."
owner_domain = 5

[finding.abci-transports-legacy]
