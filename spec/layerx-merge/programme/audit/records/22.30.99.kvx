expected = "Exactly-once recovery evidence must count the actual committed economic effect for retained signed bytes across producer/consumer restart, with budget reservations recovered consistently."
proposal = "Extend services/agent/tests/limits/exactly_once.rs to submit the same signed transaction through the real daemon/node, restart the relevant stores/processes, and assert actual receipt, balance and budget effects exactly once."
owner_domain = 9

