[finding.call-omitted-tag-reads-committed]
file = "rpc/simulate.go"
line = 173
class = "interface-mismatch"
severity = "high"
observed = "SimulationAPI.Call replaces an omitted blockNrOrHash with LatestBlockNumber. StateAndHeaderByNumberOrHash only enters pendingStateAndHeader for PendingBlockNumber, so a proposer with an open block answers an omitted-tag call from committed state."
expected = "Requirement 5104.1 requires eth_call with pending or no block tag on the node holding the open block to use that open state, and requirement 8373.1 requires committed identity only while idle."
proposal = "In rpc/simulate.go choose the same role-aware default used by defaultEstimateTag for Call. Add a consumer test whose contract result differs between committed and open state and assert omitted, pending and explicit latest before seal and after reopening."
owner_domain = 7
interface = "7.rpc-eth-call"

[finding.access-list-omitted-tag-full-node]
file = "rpc/simulate.go"
line = 91
class = "runtime-risk"
severity = "medium"
observed = "CreateAccessList unconditionally defaults an omitted tag to PendingBlockNumber, unlike EstimateGas. On a full node without a pending provider this reaches WatermarkManager.pendingSnapshot and returns ErrPendingServedBySequencer, even though committed-state access-list simulation is available."
expected = "The optional-tag RPC should choose open state on a node holding it and a usable committed default on ordinary nodes; callers should not need an explicit latest tag merely to use a normal full-node simulation endpoint."
proposal = "Use a shared role-aware simulation default in rpc/simulate.go for CreateAccessList and cover omitted-tag calls on both a full node and an open/idle proposer, preserving refusal for explicitly requested unavailable pending state."
owner_domain = 7
interface = "7.rpc-eth-createaccesslist"

[finding.cached-db-write-publication-order]
file = "storage/db_engine/dbcache/cached_key_value_db.go"
line = 72
class = "runtime-risk"
severity = "high"
observed = "Set and Delete publish to the backing DB and then the cache without shared serialization. Two same-key writers can interleave A-db, B-db, B-cache, A-cache, leaving Get returning A indefinitely while the DB and iterators contain B; cached batches have the same publication boundary."
expected = "NewCachedKeyValueDB, consumed by storage/db_engine/pebbledb/db.go, must preserve the underlying database ordering so node state reads, batch reads and iterators agree after completed writes."
proposal = "Serialize backing writes and cache publication across Set, Delete and cached-batch Commit in storage/db_engine/dbcache, or use generation-based invalidation with equivalent guarantees. Add controlled interleaving tests comparing cached reads with the underlying DB after both writers finish."
owner_domain = 5
interface = "5.go-storage-db-engine-dbcache-new-cached-key-value-db"

[finding.cached-db-value-ownership]
file = "storage/db_engine/dbcache/cached_key_value_db.go"
line = 44
class = "runtime-risk"
severity = "medium"
observed = "cachedKeyValueDB.Get returns the cache-owned byte slice and its comments forbid mutation. The KeyValueDB interface in storage/db_engine/types/types.go promises a value copy safe to use after the call, and the uncached pebbleDB.Get actually clones it. Enabling the cache therefore changes value ownership."
expected = "A storage engine wrapper must preserve KeyValueDB value-copy semantics; a consumer retaining or modifying its returned value must not modify later reads or share writable cache memory with another consumer."
proposal = "Clone values at the KeyValueDB wrapper boundary for Get and BatchGet while retaining the explicit immutable-slice contract inside Cache. Add parity tests that mutate returned buffers and verify subsequent cached and uncached reads remain identical."
owner_domain = 5
interface = "5.go-storage-db-engine-dbcache-new-cached-key-value-db"

[finding.cache-constructor-metrics-panic]
file = "storage/db_engine/dbcache/cache_impl.go"
line = 71
class = "config-drift"
severity = "medium"
observed = "NewStandardCache checks shard count and size but does not call CacheConfig.Validate. A nonempty MetricsName with a zero or negative MetricsScrapeInterval reaches newCacheMetrics and time.NewTicker in its background goroutine, causing an unrecoverable process panic."
expected = "CacheConfig.Validate explicitly rejects a nonpositive metrics interval. Every public construction path must apply that contract before allocating workers or starting metrics collection."
proposal = "Validate the complete CacheConfig at entry to NewStandardCache in storage/db_engine/dbcache/cache_impl.go and add constructor-level invalid-interval cases asserting a returned error without starting a scrape worker."
owner_domain = 5
interface = "5.go-storage-db-engine-dbcache-cache-config"

[finding.cached-batch-records-failed-mutations]
file = "storage/db_engine/dbcache/cached_batch.go"
line = 24
class = "runtime-risk"
severity = "medium"
observed = "cachedBatch.Set and Delete append a CacheUpdate before asking the inner batch to accept the operation. If the inner operation returns an error and the caller commits the remaining valid batch, the failed mutation is still published to the cache although it was not accepted by the DB batch."
expected = "The cache must publish precisely the mutations accepted and committed by the backing batch; a failed enqueue must neither alter the committed cache view nor be silently retained for a later Commit."
proposal = "In storage/db_engine/dbcache/cached_batch.go append each pending cache update only after the corresponding inner operation succeeds, retain original errors, and test a real backend error path followed by valid operations and commit."
owner_domain = 5
interface = "5.go-storage-db-engine-dbcache-new-cached-key-value-db"

[finding.reindex-discards-normalized-heights]
