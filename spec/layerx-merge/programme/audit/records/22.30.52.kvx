[finding.receipt-single-entry-recovery]
file = "storage/ledger_db/receipt/receipt_store.go"
line = 317
class = "restart-recovery"
severity = "high"
observed = "recoverReceiptStore sets targetStartOffset to firstOffset for an unapplied store but only replays when targetStartOffset < lastOffset. A WAL with exactly one unapplied receipt entry therefore returns success without applying that entry or advancing the receipt version."
expected = "Committed EVM receipts must remain readable after restart. storage/wal/wal.go Replay accepts an inclusive start/end range, including a singleton, so the receipt recovery consumer must process every unapplied version."
proposal = "In storage/ledger_db/receipt/receipt_store.go locate the first genuinely unapplied version and replay it inclusively through lastOffset; add real receipt-store restart cases for zero, one and multiple WAL entries and a fully applied tail."
owner_domain = 5
interface = "5.go-storage-ledger-db-receipt-receipt-store"

[finding.receipt-recovery-handle-lifecycle]
file = "storage/ledger_db/receipt/receipt_store.go"
line = 282
class = "restart-recovery"
severity = "medium"
observed = "newReceiptBackend opens mvcc.OpenDB, which already owns a changelog WAL and its background worker. recoverReceiptStore opens the same changelog a second time and never closes streamHandler on success, empty-log returns or errors; NewChangelogWAL starts another mainLoop."
expected = "Receipt recovery must have one controlled owner of the changelog and close every recovery resource before normal writes and pruning proceed; receiptStore.Close must terminate all WAL workers owned by construction."
proposal = "Move receipt replay onto the existing MVCC WAL owner, or finish a closed recovery phase before starting that owner. Ensure every opened recovery handle is closed on every return and test repeated open/recover/close with live resource accounting."
owner_domain = 5
interface = "5.fmt-storage-changelog-wal"

[finding.receipt-recovery-masks-io-errors]
file = "storage/ledger_db/receipt/receipt_store.go"
line = 287
class = "restart-recovery"
severity = "medium"
observed = "FirstOffset and LastOffset errors are treated identically to an empty changelog and recoverReceiptStore returns nil. The caller can finish opening a receipt store without establishing whether durable receipt entries need replay."
expected = "An empty WAL is a successful recovery case, but a failed WAL offset read must prevent the store from advertising successful recovery and preserve the underlying error for the operator."
proposal = "In storage/ledger_db/receipt/receipt_store.go distinguish a documented empty-log result from errFirst and errLast, propagate I/O errors, and add failure-path coverage that confirms construction refuses unreadable recovery metadata."
owner_domain = 5
interface = "5.fmt-storage-changelog-wal"

[finding.receipt-recovery-test-misses-singleton]
file = "storage/ledger_db/receipt/receipt_store_test.go"
line = 203
class = "test-gap"
severity = "medium"
observed = "TestRecoverReceiptStoreReplaysChangelog writes two WAL entries, marks version 1 applied, and checks version 2 through the exported helper. It never covers an unapplied singleton or the public constructor reopening a crashed receipt store."
expected = "Recovery evidence must exercise the real constructor and the smallest crash tail, since a two-entry helper fixture bypasses the targetStartOffset == lastOffset branch that loses an unapplied receipt."
proposal = "Extend storage/ledger_db/receipt/receipt_store_test.go with disk-backed public-constructor recovery scenarios for a singleton and multi-entry tail, asserting the exact receipt payload and version after close/reopen and repeated recovery."
owner_domain = 5
