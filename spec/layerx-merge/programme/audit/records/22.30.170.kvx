[finding.qualification_integer_roundtrip]
file = "tools/flyci/controller/qualification.go"
line = 72
class = "interface-mismatch"
severity = "high"
observed = "qCanonical marshals typed int64 fields, unmarshals into any using float64, then marshals again. An accepted threshold 9007199254740993 becomes 9007199254740992. Registry submit/advance, GitHub dispatch and completed evidence use these bytes, changing admitted thresholds after persistence and giving adjacent values the same logical hash."
expected = "Qualification submit/status must preserve all accepted int64 thresholds, measurements and run identities exactly across hashing, durable reopen, workflow dispatch and signed completion verification."
proposal = "Replace float64 normalization in tools/flyci/controller/qualification.go with exact-number canonicalization shared with tools/qualification/paxeer_x_release.py, and propagate serialization errors. Prove submit/reopen/dispatch/signature behavior for adjacent integers around 2^53 and int64 limits."
owner_domain = 16
interface = "16.cli-flyci-qualification-control-op-submit"

[finding.qualification_partial_record_recovery]
file = "tools/flyci/controller/qualification_registry.go"
line = 88
class = "restart-recovery"
severity = "medium"
observed = "qWrite creates the final sequence filename with O_EXCL before writing and syncing. A crash can expose an empty or partial JSON record. submit also syncs a new logical directory before its first record. read refuses these states, list aborts on that request, and no interrupted-publication recovery exists."
expected = "Restart must recover interrupted local record publication without losing durable dispatch intent or permanently preventing other qualification requests from reconciliation."
proposal = "In tools/flyci/controller/qualification_registry.go atomically publish complete fsynced records without replacement and sync the directory. Define recovery for pre-record directories and uncommitted tails while preserving ambiguous dispatch intent. Prove process interruption before writing, during writing and after publication."
owner_domain = 16

[finding.recovery_opaque_version_id]
file = "deploy/launchpad/production/recovery/recovery.py"
line = 129
class = "runtime-risk"
severity = "medium"
observed = "manifest validates version_id with the resource NAME expression [a-z][a-z0-9-]{1,62}. S3Archive.upload preserves provider VersionId and head accepts opaque identifiers up to 1024 characters. Normal versions with uppercase, digit-first, underscore or longer values cannot enter the restore manifest."
expected = "Verified immutable object versions must remain opaque identifiers and survive upload, inventory binding and restore planning with their exact bytes."
proposal = "Introduce a dedicated bounded opaque version-ID validator in deploy/launchpad/production/recovery/recovery.py aligned with phase2/providers.py. Bind original bytes in inventory hashes and cover producer-shaped S3 versions through manifest and restore_plan."
owner_domain = 16
interface = "16.cli-dep-launchpad-production-recovery-phase2-providers"

[finding.recovery_backup_format_contract]
file = "deploy/launchpad/production/recovery/resources.json"
line = 107
class = "config-drift"
severity = "medium"
observed = "resources.command_contracts.base_backup and recovery.resources require pg_basebackup --format=tar. PostgreSQL.physical_backup uses --format=plain, verifies a directory, and restore_physical copies that directory. Declared and implemented backup/restore layouts differ."
expected = "The declared command, physical artifact, verification and restore consumer must describe one supported layout, with any extraction or conversion explicitly verified."
proposal = "Reconcile deploy/launchpad/production/recovery/resources.json and recovery.py with the actual plain-directory path in phase2/providers.py, or implement verified tar conversion. Prove a native backup-to-restore round trip and publish its matching command/layout contract."
owner_domain = 16
interface = "16.cfg-dep-resources-command-contracts"

[finding.recovery_reconciliation_response_bound]
file = "deploy/launchpad/production/recovery/phase2/reconciliation.sql"
line = 20
class = "runtime-risk"
severity = "medium"
observed = "reconciliation.sql json_agg exports every raw-chain identity, inventory state and delivery inbox/outbox identity in one JSON row. phase4/release.py consumes it through PostgreSQL.document and BoundTools.run, which refuses stdout above 2 MiB after the process finishes. A retained 72-hour dataset readily exceeds that transport."
expected = "Recovery reconciliation must cover the complete retained authoritative dataset with exact counts, raw integer amounts and stable identities while respecting explicit query, disk, memory and transport bounds."
proposal = "Replace monolithic identity arrays in deploy/launchpad/production/recovery/phase2/reconciliation.sql with deterministic streamed or partitioned canonical digests and counts consumed by phase4/release.py. Preserve snapshot consistency and prove full reconciliation for a retained dataset exceeding 2 MiB without truncation or weakened checks."
owner_domain = 16

