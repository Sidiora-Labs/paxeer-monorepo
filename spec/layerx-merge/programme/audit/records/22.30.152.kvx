class = "test-gap"
severity = "low"
observed = "The macro documents reset_db as resetting the database, but the function only Sandbox.checkout. It neither checks in an existing owner nor rolls back prior inserts. A repeated call in one owner returns {:already, :owner} rather than :ok, so the documented utility cannot provide a fresh scenario. The current Explorer token benchmark performs its own checkout/delete and does not call this helper."
expected = "A benchmark reset utility must provide a fresh isolated database scenario on repeated calls and make ownership cleanup explicit; its documentation must not promise cleanup that checkout alone does not perform."
proposal = "Implement a real checkin/checkout scenario lifecycle in Explorer.BenchmarkCase and its web benchmark counterpart, or replace the misleading reset API with explicit ownership setup/cleanup. Demonstrate repeated scenarios with real inserts and prove no data or sandbox ownership leaks between them."
