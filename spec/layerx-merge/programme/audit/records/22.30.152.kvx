line = 15
class = "config-drift"
severity = "medium"
observed = "map_array_env_var_to_list parses with Poison keys: :atoms! and rescues every exception to []. Malformed NEW_TAGS silently removes all configured tags, while valid JSON objects/scalars return unchanged despite the list spec. Explorer.Tags.AddressTagCataloger.create_new_tags then enumerates entries matching %{tag: tag, title: title} and can fail on those accepted shapes."
