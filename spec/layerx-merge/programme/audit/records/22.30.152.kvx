[finding.rate-limit-doc]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/rate_limit/hammer.ex"
line = 13
class = "doc-drift"
severity = "low"
observed = "The Hammer module documentation tells maintainers that backend selection reads Application.get_env(:block_scout_web, :rate_limit_backend). The generated wrapper functions actually read Application.get_env(:block_scout_web, :api_rate_limit)[:rate_limit_backend], and runtime.exs sets that nested key. Following the documented top-level key has no effect."
expected = "The documented rate-limit configuration location must match the key both the dispatcher and its supervision setup consume, especially when selecting a shared Redis limiter for multiple replicas."
proposal = "Correct the module documentation in BlockScoutWeb.RateLimit.Hammer to show the nested api_rate_limit backend key and API_RATE_LIMIT_HAMMER_REDIS_URL selection. Retain the functioning dispatcher and child configuration and align any operator examples with that actual nested setting."
owner_domain = 14
interface = "14.cfg-web-api-rate-limit"

