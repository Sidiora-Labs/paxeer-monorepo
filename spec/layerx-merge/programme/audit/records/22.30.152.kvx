[finding.attestor-manifest]
file = "services/bridge/deploy/attestors.json"
line = 3
class = "interface-mismatch"
severity = "high"
observed = "The committed attestors.json carries repeated-byte placeholder addresses 0x11 through 0x55 and threshold 3. proposals.LoadAttestorManifest calls parseSignerList/liveAddress and rejects the first entry; the default proposals/checklist path cannot consume this declared stable manifest. proposals_test.go explicitly confirms this deliberate refusal."
expected = "The deployment attestor manifest must contain an approved public signer set and threshold that the real loader accepts and every chain configuration reproduces; a bridge opening cannot proceed with invented identities."
proposal = "Bridge governance owners must record the approved public attestor addresses and threshold in services/bridge/deploy/attestors.json and reconcile all chain configurations and proposal inputs. Preserve placeholder rejection and prove the actual approved manifest passes the loader and chain comparisons before enabling bridge deployment."
owner_domain = 14
interface = "14.fmt-bridge-attestor-manifest-j55"

[finding.health-shape]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/health_router.ex"
line = 9
class = "interface-mismatch"
severity = "high"
observed = "GET /api/health reaches API.HealthController.health, whose non-media response places healthy/latest_block/error inside metadata.blocks and includes latest_block.node. The Rust client models/health_check_response_metadata.rs accepts only metadata.latest_block, and models/latest_block.rs has db/cache only. Its serde decoder ignores blocks, returning latest_block=None while accepting healthy=true; unhealthy 500 bodies have only an untyped error model."
expected = "The same health response must round-trip through the real Phoenix HTTP route and typed Rust client without dropping block progress, node height or error information; standalone media-worker health must be distinguished intentionally."
proposal = "In services/explorer/services/libs/blockscout-client, update the source OpenAPI overrides and generated health models to the current Phoenix payload and status variants. Add a real Phoenix-to-HTTP-to-Rust contract check for healthy, unhealthy, readiness and standalone-media cases, and preserve all block and error fields."
owner_domain = 14
interface = "14.http-get-api-health"

[finding.migration-preview]
file = "services/explorer/backend/apps/explorer/lib/mix/tasks/auth0_to_keycloak_migrate.ex"
line = 40
class = "runtime-risk"
severity = "high"
observed = "The advertised --dry-run reaches Auth0ToKeycloakMigration.run(dry_run: true), but account/auth0_to_keycloak_migration.ex:119 calls build_migration_items before execute_or_dry_run checks the flag. That builder calls merge_duplicate_emails at line339, which calls Account.merge at line375. account.ex:67-80 moves related user records and deletes duplicate Identity rows in a committed transaction even during the preview."
expected = "Previewing an account migration must leave identities, API keys, tags, ABIs and watchlists unchanged, including accounts sharing an email address; users must not lose identity records through a dry-run command."
proposal = "Split planning from writes in Explorer.Account.Auth0ToKeycloakMigration. Compute proposed duplicate groups without Account.merge, and perform all merge/delete/import writes only in the explicitly selected execution phase. Prove the real CLI dry-run leaves database identities and associations unchanged for duplicate-email accounts and verify explicit execution separately."
owner_domain = 14

[finding.migration-options]
file = "services/explorer/backend/apps/explorer/lib/mix/tasks/auth0_to_keycloak_migrate.ex"
line = 32
class = "runtime-risk"
severity = "medium"
observed = "OptionParser.parse returns options, positional arguments and invalid switches, but the command discards the latter two. A misspelled --dryrun is ignored, leaving the migration service default dry_run=false; zero or negative batch_size is also accepted before app.start."
expected = "A migration command must reject unknown switches, unexpected positional arguments and invalid batch sizes before starting a write-capable operation; a preview typo must not select execution."
proposal = "In lib/mix/tasks/auth0_to_keycloak_migrate.ex, validate the complete parse result and require a positive bounded batch size before app.start, returning a nonzero diagnostic for any invalid argument. Add command-path coverage for misspelled preview switches, positional input and invalid batch sizes."
owner_domain = 14

[finding.migration-status]
file = "services/explorer/backend/apps/explorer/lib/mix/tasks/auth0_to_keycloak_migrate.ex"
line = 40
class = "runtime-risk"
severity = "medium"
observed = "The Mix command ignores the migration outcome. The service run/1 logs missing Auth0/Keycloak configuration and returns []; do_run/1 also logs a phase error and returns []. The command therefore finishes normally when no migration could be performed. Its option documentation additionally says batch-size defaults to 50 while the service defines 500."
