proposal = "Validate string-key JSON and the full list/entry schema in Explorer.EnvVarTranslator or its configuration boundary. Report NEW_TAGS validation errors explicitly before cataloger startup and test the actual configuration-to-cataloger path with valid tags, objects, scalars, unknown keys and malformed JSON."
owner_domain = 14

[finding.dead-worker-log]
file = "services/explorer/backend/apps/indexer/lib/indexer/logger.ex"
line = 26
class = "runtime-risk"
severity = "medium"
observed = "Indexer.Logger.process/1 destructures {:registered_name, name} from Process.info. It returns nil for a PID that has exited. Memory.Monitor and BufferedTask call this helper while inspecting workers, so normal worker termination between enumeration and logging raises MatchError in a diagnostic/recovery path."
expected = "Logging a worker that terminates during memory monitoring must still produce its PID and must not crash the monitor or interrupt cleanup and restart handling."
proposal = "Handle nil explicitly in Indexer.Logger.process/1 and return the PID-only diagnostic when the worker is gone. Exercise a real terminated PID and a registered live PID through the helper and a memory-monitor diagnostic path."
owner_domain = 14

[finding.consensus-scan]
file = "services/explorer/backend/apps/indexer/lib/indexer/token_transfer_block_consensus_sanitizer.ex"
line = 42
class = "runtime-risk"
severity = "medium"
observed = "The recurring sanitizer collects every distinct mismatching token-transfer block number with Repo.all(timeout: :infinity), then passes the entire list to Block.set_refetch_needed. A large inconsistent history can monopolize the worker/query and materialize an unbounded list; supervisor restart simply schedules the same whole-history work again."
expected = "Consensus repair discovery must have bounded memory, query duration and update size, and must resume idempotently from persisted refetch state after a restart."
proposal = "In Indexer.TokenTransferBlockConsensusSanitizer, scan mismatches in bounded keyset batches with finite query deadlines and bounded Block.set_refetch_needed calls. Preserve durable refetch markers and verify interruption/restart against actual PostgreSQL data larger than one batch."
owner_domain = 14
interface = "14.cfg-indexer-indexer-tokentransferblockconsensussanitizer"

[finding.notification-recovery]
file = "services/explorer/backend/apps/indexer/lib/indexer/utils/event_notifications_cleaner.ex"
line = 33
class = "restart-recovery"
severity = "medium"
observed = "Cleaner deletes all stored EventNotification rows older than max_age (runtime default five minutes) without consumer progress. DBSender commits a row then sends its id by pg_notify; Listener subscribes only to future notifications and fetches individual ids, with no restart cursor or startup replay. An API listener outage loses live explorer updates even when rows were initially persisted; expiry removes the remaining payloads."
expected = "Explorer event delivery must define recovery after listener disconnects and restarts. Persisting notification bodies alone must not imply replay, and clients need either acknowledged delivery or an explicit state reconciliation path."
proposal = "Define the event-delivery guarantee in the explorer event service. If replay is required, add durable consumer progress and retention tied to acknowledgement; if events are disposable, add explicit startup/reconnect state reconciliation. Prove the chosen real PostgreSQL sender/listener/cleaner path across an outage exceeding max_age without claiming loss of authoritative chain state."
owner_domain = 14
interface = "14.cfg-indexer-indexer-utils-eventnotificationscleaner"

[finding.validator-replacement]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/blackfort/validator.ex"
line = 37
class = "restart-recovery"
severity = "medium"
observed = "The optional Blackfort fetcher deletes validators absent from the remote snapshot, then calls insert_validators separately and ignores its result. An insert failure after deletion leaves a partially replaced explorer validator list until another trigger; a failed fetch is also silently ignored. This fetcher is chain-type gated and does not manage Paxeer BFT consensus."
expected = "When the optional Blackfort indexer is enabled, readers must observe the previous complete validator snapshot or the next complete snapshot, with failed replacement recoverable and visible to operators."
proposal = "In Indexer.Fetcher.Blackfort.Validator and Explorer.Chain.Blackfort.Validator, apply delete/upsert as one database transaction, propagate failure diagnostics and schedule a bounded retry. Exercise actual database failure and process restart without exposing a partially replaced snapshot."
owner_domain = 14

