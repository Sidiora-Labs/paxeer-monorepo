[finding.worker-startup-race]
file = "tools/benchmark/loadtest/main.go"
line = 197
class = "runtime-risk"
severity = "medium"
observed = "startLoadtestWorkers launches BuildTxs and SendTxs then waits without registering workers itself. loadtest_client.go:185 and :258 call wg.Add inside goroutines. With positive Ticks, Wait can observe zero and close queues while producers start; sender counter access also precedes its closed-channel check."
expected = "A timed benchmark must register each worker before waiting, close queues only after producers stop and begin query and summary phases only after workers and the statistics reporter finish."
proposal = "Give the launcher WaitGroup Add ownership before each go statement in tools/benchmark/loadtest/main.go and loadtest_client.go. Join workers and reporter before queue closure and check receive success before consuming a transaction, preserving all counters and explicit startup/shutdown failure reporting."
owner_domain = 16
interface = "16.cli-bench-benchmark-loadtest-main"

[finding.scrape-cancellation]
file = "tools/benchmark/loadtest/main.go"
line = 213
class = "runtime-risk"
severity = "medium"
observed = "The statistics goroutine returns on getTxBlockInfo error without closing done. Registered workers continue and wg.Wait cannot complete; positive Ticks also bypasses signal waiting. The reporter is not joined before post-load queries read its observations."
expected = "RPC scrape errors, termination signals and tick completion must stop the same benchmark run once, join all goroutines and preserve an explicit incomplete result instead of hanging or continuing submission."
proposal = "Use shared cancellation or a once-protected stop function in tools/benchmark/loadtest/main.go, wire scrape failure, both signals and tick completion to it, release signal/ticker resources, and join reporter and workers before returning the benchmark result."
owner_domain = 16
interface = "16.cli-bench-benchmark-loadtest-main"

[finding.unbounded-rpc-input]
file = "tools/benchmark/loadtest/main.go"
line = 528
class = "runtime-risk"
severity = "medium"
observed = "getLastHeight runs curl without timeout and type-asserts dat[last_height] as string. getTxBlockInfo uses default http.Get, unbounded io.ReadAll and no status or required-field validation. Stalled nodes can hang, malformed heights can panic and an error object can decode as an empty successful block."
expected = "Benchmark measurements must come from bounded validated node responses. Missing fields, invalid shapes and HTTP/RPC errors must produce explicit failed measurements rather than panics, indefinite waits or zero-filled statistics."
proposal = "Replace requests in tools/benchmark/loadtest/main.go with a shared client, cancellation deadlines, bounded response reads, typed mandatory fields and HTTP/RPC error validation. Propagate detailed scrape errors to the run result and shared cancellation."
owner_domain = 16
interface = "16.cli-bench-benchmark-loadtest-main"

[finding.post-query-observations]
file = "tools/benchmark/loadtest/main.go"
line = 575
class = "runtime-risk"
severity = "medium"
observed = "strings.Split on empty EvmRpcEndpoints yields one empty item, bypassing the length guard; failed Dial results remain in ethClients. Enabled block and receipt queries use modulo len(BlockHeightsWithTxs) and len(EvmTxHashes) without zero checks, so a run with no included transactions can panic."
expected = "Empty endpoints, connection failures and no observed EVM transactions must yield clear bounded incomplete query results. Only validated clients and actual observed block or transaction identifiers may be queried."
proposal = "Trim and validate endpoints in tools/benchmark/loadtest/main.go, reject failed connections, close successful clients and check each query family has its required observations. Bound concurrency and contexts and report failure or documented non-applicability without inventing measurements."
owner_domain = 16
interface = "16.cli-bench-benchmark-loadtest-main"

[finding.duplicate-statistics-height]
file = "tools/benchmark/loadtest/main.go"
line = 224
class = "runtime-risk"
severity = "medium"
observed = "The reporter iterates startHeight through currHeight inclusively then assigns startHeight=currHeight. The next interval counts the previous terminal block again and can duplicate its height in BlockHeightsWithTxs, skewing statistics and post-load sampling."
expected = "Each committed block belongs to one reporting interval. An interval without a new height must not remeasure the last block or bias the observed transaction-height set."
proposal = "Advance the next unprocessed height to currHeight+1 after successful scraping in tools/benchmark/loadtest/main.go, explicitly handle no-new-block intervals, retain failed-height reporting and derive post-load samples from uniquely observed committed heights."
owner_domain = 16
interface = "16.cli-bench-benchmark-loadtest-main"

