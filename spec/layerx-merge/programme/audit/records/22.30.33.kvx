line = 215
class = "restart-recovery"
severity = "medium"
observed = "The supported non-qualified compatibility path advances its database cursor before PublishBatch. PublishBatch reserves a Redis dedup key before scheduling delivery, and failed targets exist only in the bounded in-memory dead-letter queue. A crash after reservation or cursor advancement can lose delivery, and replay can be suppressed for 600 seconds. Production canonical publication uses a separate durable outbox and is not assigned this defect."
expected = "Any retained compatibility path described as durable must persist target work before advancing source progress and resume delivery after restart without interpreting reservation as delivery acknowledgement."
proposal = "Move compatibility target delivery in services/launchpad/indexer/internal/publisher/publisher.go onto transactionally staged durable work with per-target acknowledgement, or explicitly retire that delivery mode and its durability promise. Verify a crash between staging, cursor advancement and target acknowledgement with the real receiver."
