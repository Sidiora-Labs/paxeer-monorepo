interface = "4.go-shared-config-deployment-manifest"

[finding.lifetime-market-cap]
file = "services/launchpad/indexer/internal/app/anchor.go"
line = 21
class = "restart-recovery"
severity = "high"
observed = "persistedMarkets refuses more than 2040 lifetime canonical markets. Each discovered market permanently adds token/pool code epochs, and receipt/rpc.go:1509 and identity.go enforce a 4096-epoch total. Normal market growth therefore eventually stops live qualification; restart can fail earlier at the 2040-market guard despite valid persisted creations."
expected = "The launchpad must continue indexing an increasing durable market inventory with bounded per-operation memory and proof work. A transport admission bound must not become an undocumented lifetime limit on network market creation."
proposal = "Replace whole-history boot loading in services/launchpad/indexer/internal/app/anchor.go with durable paged or height-scoped authority recovery, and make receipt epoch lookup bounded per batch while retaining historical proof. Verify crossing the current 2040/4096 boundaries and restarting with all market identities preserved; do not merely widen the constants."
owner_domain = 4
interface = "4.go-shared-config-deployment-manifest"

[finding.tenant-transaction-qualification]
file = "services/launchpad/indexer/internal/receipt/qualified.go"
line = 153
class = "wiring-gap"
severity = "high"
observed = "coordinates rejects any signed transaction whose ChainId differs from 125 and recovers senders using a125-only signer. VirtualChains.md specifies shared EVM state and a full root transaction view, so a tenant-signed transaction (125000000 plus registry ID) can emit the same launchpad logs into a root block. The full-root qualified source then rejects that valid receipt and stalls its whole range."
expected = "Brief fact 5 requires tenant domains to be a parameter. Root block identity remains Paxeer125, while receipt sender qualification must honor a valid admitted signed tenant chain ID rather than assuming every root-visible transaction was signed for 125."
proposal = "In services/launchpad/indexer/internal/receipt/qualified.go validate the signed domain against the committed virtual-chain authority and recover the sender with that admitted chain ID. Preserve shared parent block identity and coordinate any signed-domain metadata with shared accounting/delivery consumers. Prove actual tenant launchpad execution through root RPC, qualification, publication and restart."
