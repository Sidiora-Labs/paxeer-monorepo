[finding.native-read-model-projection]
file = "services/launchpad/indexer/internal/processor/legacy.go"
line = 60
class = "wiring-gap"
severity = "high"
observed = "Production enables LegacyProjection in app.go:584, but stageQualifiedLegacy ignores every raw record whose emitter differs from the configured EventEmitterAddress. Shared configuration binds that address to the historical 0x622E1bb90E0E2B6E6e5e9e2DbE1555389E8A3EF6 identity; native Swap and PoolStateUpdated family logs originate at 0x1017. Native activity consequently omits existing swaps, pools and fee read models even after native qualification is repaired."
expected = "The service contract promises market/pool rows from committed native launchpad logs, and the existing API/SQL readers must observe qualified native economic changes atomically with canonical progress."
proposal = "In services/launchpad/indexer/internal/processor/legacy.go project qualified family envelopes using verified native or historical role identities rather than one configured historical address. Preserve immutable event keys and SQL transaction boundaries, and verify actual native events through the existing API and typed SQL consumers."
owner_domain = 4
interface = "4.env-sdk-shared-config-event-emitter-address"

[finding.ambiguous-commit-live-recovery]
file = "services/launchpad/indexer/internal/processor/processor.go"
line = 183
class = "restart-recovery"
severity = "high"
observed = "After PostgreSQL commits but its COMMIT response is lost, Run leaves local last unchanged and halves the candidate range. The next canonicalRuntimeHead.Head reloads the advanced durable watermark into LiveQualifiedSource.DurableHeight; the retry from the old last+1 is rejected by historical.go:355-358 before ProcessBatch reaches ReconcileCanonicalCommit at line260. Ingestion retries indefinitely until restart, and the reduced batch identity also differs from the original commit."
expected = "A lost commit acknowledgement must reconcile the original immutable batch or reload proven durable progress before choosing another live range, so committed delivery continues without operator restart or duplicate effects."
proposal = "In services/launchpad/indexer/internal/processor/processor.go preserve and reconcile an ambiguous original batch before refetch/reslicing, or advance the running loop from the verified durable checkpoint. Extend the real lost-COMMIT-response transport coverage through Run, canonicalRuntimeHead and LiveQualifiedSource, asserting continued exactly-once canonical effects."
owner_domain = 4
interface = "4.go-shared-delivery-store-enqueue"

[finding.approved-history-rehydration]
file = "services/launchpad/indexer/internal/receipt/identity.go"
line = 425
class = "restart-recovery"
severity = "high"
observed = "Boot calls persistedMarkets over all canonical creations and passes them to RPCQualification.Rehydrate. Rehydrate rejects market.Height below the selected manifest ActivationHeight. Current activation is 37220320, while the approved historical real market creation is at 33963716, so an existing database containing that qualified history cannot boot with current deployment documents."
expected = "An upgrade must retain approved historical market identity and resume its durable canonical state under the current deployment, without deleting earlier qualified creations or treating them as untrusted current-generation creations."
proposal = "In services/launchpad/indexer/internal/receipt/identity.go and internal/app/anchor.go restore generation-aware market/code epochs from approved deployment history and durable provenance, then attest their current binding. Verify reopening a real database containing pre-activation creations across the current activation and resuming trades without rewriting source identities."
