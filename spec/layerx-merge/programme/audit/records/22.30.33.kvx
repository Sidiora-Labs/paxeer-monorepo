[finding.native-swap-qualification]
file = "services/launchpad/indexer/internal/receipt/qualified.go"
line = 242
class = "interface-mismatch"
severity = "high"
observed = "The native producer precompiles/launchpad/pool.go emits Swap through emitFamily at 0x1017. Registry.Decode assigns LaunchpadPrecompile (or its co-bound SidioraPool origin) and primary economic authority, but Qualify rejects every economic fill whose EmitterRole is not EventEmitter. A real native swap therefore aborts canonical ingestion before accounting publication."
expected = "The approved LaunchpadPrecompile role and EventEmitter-compatible native ABI must round-trip through receipt qualification to accounting.FillV1; attested native economic events are valid merged-network traffic under brief facts 1 and 7."
proposal = "In services/launchpad/indexer/internal/receipt/qualified.go admit the approved primary economic Swap family for attested native and historical roles while retaining exact receipt, code and market proof. Prove actual native swap production through the receipt authority, durable accounting transport and real consumers, including restart."
owner_domain = 4
