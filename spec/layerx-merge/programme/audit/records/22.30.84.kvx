[finding.key-overwrite-loss]
file = "sdk/client/keys/add.go"
line = 137
class = "runtime-risk"
severity = "high"
observed = "runAddCmd calls kb.Delete(name) before validating the replacement multisig threshold and members, public key, HD path or recovery mnemonic. A later validation, storage or device error leaves the original named signing key deleted."
expected = "Replacing a signing identity must preserve the existing durable key on every unsuccessful replacement, including an invalid recovery phrase or unavailable Ledger device."
proposal = "In sdk/client/keys/add.go, validate and stage the replacement before modifying the original; use an atomic keyring replacement and persistent-backend tests that reopen after failed replacement and recover the original signing identity."
owner_domain = 15
interface = "15.cli-client-keys-add-j76"

[finding.confirmation-prefix]
file = "sdk/client/input/input.go"
line = 59
class = "security"
severity = "medium"
observed = "GetConfirmation accepts every nonempty answer beginning with y after lowercasing; an unrecognized answer such as yesterday authorizes callers that delete, overwrite or export a key."
expected = "The documented confirmation language accepts y and yes case-insensitively and returns false for unrecognized input; sensitive key actions require that exact affirmative choice."
proposal = "In sdk/client/input/input.go, compare the entire normalized response with y or yes; extend input_test.go with affirmative variants, prefix lookalikes, blank input and EOF cases."
owner_domain = 15
interface = "15.go-client-input-get-confirmation-j76"

[finding.raw-byte-signed-range]
file = "sdk/client/debug/main.go"
line = 121
class = "runtime-risk"
severity = "medium"
observed = "RawBytesCmd advertises byte arrays containing 255 but parses each element with strconv.ParseInt at bitSize 8. Values 128 through 255 fail, while a negative value such as -1 is accepted and cast to byte 255."
expected = "The raw-byte conversion command must accept unsigned bytes from 0 through 255 and refuse negative or out-of-range elements without changing their meaning."
proposal = "In sdk/client/debug/main.go, parse unsigned eight-bit values and add command cases for 0, 127, 128, 255, -1 and 256, asserting refusals and the emitted hexadecimal bytes."
owner_domain = 15
interface = "15.cli-client-debug-raw-bytes-j76"

[finding.config-string-roundtrip]
file = "sdk/client/config/toml.go"
line = 23
class = "config-drift"
severity = "medium"
observed = "defaultConfigTemplate inserts ChainID, Node and other strings directly inside TOML quotes through text/template. Quotes, backslashes or newlines can corrupt the next read or introduce other TOML keys."
expected = "A value accepted by SetClientConfig must round-trip through GetClientConfig unchanged or be rejected before replacing the existing usable configuration."
proposal = "In sdk/client/config/toml.go, use canonical TOML serialization or escaping, validate before writing and cover quotes, backslashes and newline-containing values with write/read round-trip tests."
owner_domain = 15
interface = "15.go-client-config-set-client-config-j76"

[finding.config-interrupted-write]
file = "sdk/client/config/toml.go"
line = 72
class = "restart-recovery"
severity = "medium"
observed = "writeConfigToFile overwrites client.toml directly with os.WriteFile. A short write, full disk or process interruption after truncation can destroy the previously usable node and keyring configuration."
expected = "A failed configuration update must leave either the complete old configuration or the complete new configuration available on the next CLI invocation."
proposal = "In sdk/client/config/toml.go, write a mode-0600 temporary sibling, sync contents, atomically rename it and sync the directory; test an interrupted or refused replacement without losing the prior configuration."
owner_domain = 15

[finding.query-cancellation-lost]
file = "sdk/client/query.go"
line = 93
class = "runtime-risk"
severity = "medium"
observed = "Context.Invoke receives grpcCtx, but its query branch calls QueryABCI and queryABCI invokes ABCIQueryWithOptions with context.Background. Caller cancellation and deadlines never reach the underlying node query."
expected = "A state query made through the gRPC ClientConn adapter must honor the caller deadline and cancellation throughout its underlying node request."
proposal = "Thread a context-aware query path through sdk/client/grpc_query.go and sdk/client/query.go, preserving convenience APIs where needed; assert that a cancelled Invoke cancels the underlying node request."
owner_domain = 15
interface = "15.go-client-context-j76"

[finding.query-proof-unverified]
file = "sdk/client/query.go"
line = 102
class = "security"
severity = "medium"
observed = "The canonical store/key branch with Prove=true returns result.Response unchanged, exactly like the trusted-node branch. No proof, response root or trusted header is checked before returning the value."
expected = "A caller relying on proof verification must receive a value authenticated against independently trusted committed state or an explicit refusal that verification is unavailable."
proposal = "In sdk/client/query.go, verify store proofs against a trusted header at the response height or explicitly refuse the unimplemented verification mode; add missing, forged and wrong-height proof refusal cases."
owner_domain = 15

[finding.query-proof-test-path]
file = "sdk/client/query_test.go"
line = 52
class = "test-gap"
severity = "medium"
observed = "TestQueryABCI constructs store/%s/key without the leading slash required by isQueryStoreWithProof. It sets Prove but checks only height, leaving the proof-verification branch unexercised."
