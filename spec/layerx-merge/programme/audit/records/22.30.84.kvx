[finding.block-negative-height-latest]
file = "sdk/client/rpc/block.go"
line = 37
class = "runtime-risk"
severity = "medium"
observed = "BlockCommand parses an explicit height but sets the height pointer only when h > 0. A supplied negative height therefore becomes nil and returns the latest block rather than refusing the invalid requested height."
expected = "An explicit invalid historical height must fail clearly; it must not silently return a different block that a caller could mistake for the requested one."
proposal = "In sdk/client/rpc/block.go, reject negative heights before calling getBlock and explicitly document the zero/latest convention; add command cases for a negative height, zero, an omitted height and a positive historical height."
owner_domain = 15
interface = "15.go-client-rpc-block-command-j76"

[finding.block-unverified-claim]
file = "sdk/client/rpc/block.go"
line = 18
class = "security"
severity = "medium"
observed = "BlockCommand promises verified block data in its comment and help text, but getBlock only calls node.Block and marshals the response. It verifies no header, commit, validator set or trusted checkpoint before presenting the node response."
expected = "Block data described as verified must be authenticated against independently trusted committed chain state, with unverified node retrieval clearly distinguished from that assurance."
proposal = "In sdk/client/rpc/block.go, authenticate the returned header and commit against a trusted validator-set path before reporting verified data; document the trust input and add altered-header, missing-commit and wrong-height refusals."
owner_domain = 15
interface = "15.go-client-rpc-block-command-j76"
