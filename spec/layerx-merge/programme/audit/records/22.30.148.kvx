[finding.proxy-upstream-trust]
file = "apps/explorer/pages/api/proxy.ts"
line = 23
class = "security"
severity = "medium"
observed = "When NEXT_PUBLIC_USE_NEXT_JS_PROXY is enabled, x-endpoint supplied by the requester selects any URL origin. nextjs/utils/fetchProxy.ts forwards the recognised account cookies, authorization and CSRF headers to that origin and node-fetch follows redirects; middleware does not restrict API destinations."
expected = "The explorer account proxy must send authenticated traffic only to the configured explorer services and approved tenant backends. A public request must not select arbitrary internal or external destinations."
proposal = "In apps/explorer/pages/api/proxy.ts and nextjs/utils/fetchProxy.ts, resolve a server-owned upstream identifier against an allowlist, reject arbitrary origins and unsafe redirect destinations, and exercise account-cookie forwarding against both approved and refused hosts."
owner_domain = 14
interface = "14.cfg-fe-apis-general"

[finding.nft-media-outbound-trust]
file = "apps/explorer/pages/api/tokens/[hash]/instances/[id]/media-type.ts"
line = 38
class = "security"
severity = "medium"
observed = "tokenInstanceMediaTypeHandler issues a server-side HEAD to apiData.image_url or animation_url, including redirects. NFT metadata controls those URLs; the ten-second abort bounds time but does not reject loopback, link-local or private destinations."
