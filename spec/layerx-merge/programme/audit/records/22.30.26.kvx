[finding.native_family_events]
file = "sdk/launchpad/protocol/bindings/eventemitter.go"
line = 33
class = "interface-mismatch"
severity = "high"
observed = "EventEmitterMetaData omits TokenDeployed, NftMint, NftTransfer, PoolRegistered, RouterTrade and FeeFlow with the native signatures in precompiles/launchpad/Launchpad.sol:126-135. emitFamily at precompiles/launchpad/events.go:56 appends timestamp and blockNumber and emits at 0x1017. shared/chain/contracts.go:54 binds the legacy EventEmitter ABI there; protocol/events.go:33 seeds LookupEvent from it and nine other bindings, none supplying those six signatures. decode.Decoder.Decode returns nil for those topics on this bindings-based path."
expected = "The exported metadata and bound Go consumer at 0x1017 must recognize all twelve native family events with their actual indexed fields, encodings, timestamp and blockNumber. A role PoolRegistered or ERC721 Transfer is not the corresponding native family signature. The separate catalog-based indexer Registry does not supply missing topics to protocol.LookupEvent."
proposal = "Generate a native launchpad-family binding in sdk/launchpad/protocol/bindings from precompiles/launchpad/abi.json, preserve historical Solidity decoding separately, and wire protocol/events.go plus shared/chain/contracts.go to native metadata at 0x1017. Prove actual native logs pass through the bindings-based decoder with every family field and unknown-topic refusal."
owner_domain = 4
interface = "4.go-protocol-bindings-event-emitter-meta-data"

[finding.retained_emitter_v2]
file = "sdk/launchpad/protocol/bindings/eventemitter.go"
line = 33
class = "interface-mismatch"
severity = "high"
observed = "The retained EventEmitter binding exposes the legacy 22-method ABI but omits EventLog, EventLog1, EventLog2, VERSION, reinitializeV2, EVENT_EMITTER_ROLE, setTypedEmitter and isTypedEmitter declared by contracts/launchpad/contracts/interfaces/IEventEmitter.sol and implemented by contracts/launchpad/contracts/data/EventEmitter.sol. Typed Go calls and Parse/Filter/Watch consumers cannot exercise that retained v2 interface, even though the catalog-based decoder has separate support."
expected = "The generation 2 manifest retains EventEmitter as an ERC1967 contract. Its current generic and typed emission interfaces and access-control lifecycle must be representable by the Go binding used at that contract. Authoritative native logs remain independent of optional retained-contract mirroring."
proposal = "Regenerate sdk/launchpad/protocol/bindings/eventemitter.go from the reviewed current retained EventEmitter artifact, with explicit historical ABI selection for older heights. Add real contract-to-Go coverage of EventLog tuple data, indexed topics, v2 initialization refusal and typed emitter grants; keep native-family metadata separate."
owner_domain = 4
interface = "4.sevt-ieventemitter-eventlog-3f5c3dc6"

[finding.beacon_ownership_handoff]
file = "sdk/launchpad/protocol/bindings/poolbeacon.go"
line = 33
class = "interface-mismatch"
severity = "high"
observed = "PoolBeaconMetaData exposes implementation, owner, transferOwnership and upgradeTo only. UpgradeableBeacon.sol:48 now sets pendingOwner and emits OwnershipTransferStarted; acceptOwnership at line 54 changes owner and clears pendingOwner. The binding has neither pendingOwner nor acceptOwnership nor the started event, so the exported ownership lifecycle cannot complete or observe the handoff."
expected = "The retained beacon interface must round-trip current and pending ownership, the start event, acceptance by the pending owner and Unauthorized refusal for another caller. Successful transferOwnership submission starts a handoff and must not be treated as completed ownership transfer."
proposal = "Regenerate sdk/launchpad/protocol/bindings/poolbeacon.go from the current contracts/launchpad/contracts/base/UpgradeableBeacon.sol artifact. Prove pendingOwner, OwnershipTransferStarted, unauthorized acceptance, successful two-owner acceptance and clearing of pendingOwner through the real contract and Go consumer, including reads from a reopened client."
owner_domain = 4
interface = "4.sol-upgradeablebeacon-transferownership-f2fde38b"

[finding.retained_binding_proof_gap]
file = "sdk/launchpad/protocol/bindings/proof_launchpad_sdk_protocol_go_test.go"
line = 42
class = "test-gap"
severity = "medium"
observed = "The TestProofLaunchpadSdkProtocolGo producer table lists eight role metadata objects and omits EventEmitterMetaData and PoolBeaconMetaData, although protocol/events.go and shared/chain/contracts.go expose both. Missing retained v2 methods/events and beacon ownership acceptance therefore have no comparison or round-trip assertion in this proof."
expected = "Brief checks 1 and 7 require every exposed interface in this slice to agree with its producer. The eight role comparisons satisfy their bounded inventory criteria but cannot qualify retained Solidity interfaces that have no matching precompile role ABI."
proposal = "Extend sdk/launchpad/protocol/bindings/proof_launchpad_sdk_protocol_go_test.go with reviewed artifact-backed retained EventEmitter and PoolBeacon coverage. Invoke real contracts and Go consumers for v2 tuples and two-step ownership, with malformed-data and unauthorized-operation refusals, while retaining all eight existing role producers."
owner_domain = 4

[finding.runtime_emission_proof_gap]
file = "sdk/launchpad/protocol/bindings/proof_launchpad_sdk_protocol_go_test.go"
line = 81
class = "test-gap"
severity = "medium"
observed = "The proof encodes Initialized versions 1 and 2 for every role from metadata and invokes a consumer which locally constructs logs, including Quoter.Initialized at services/launchpad/indexer/internal/processor/airdrop_test.go:228. Native emitAt rejects Initialized except for a new pool. These valid schema codec assertions cannot prove native emitter origins or lifecycle and do not detect the missing family signatures."
expected = "Brief fact 7 and checks 1 and 7 require runtime safety evidence through the actual producer and consumer. ABI codec inventory is a separate claim. Runtime observations must be logs the native producer can emit, with actual role surfaces or 0x1017 origins and current lifecycle restrictions."
proposal = "Add executor-to-Go decoder coverage alongside the metadata tests in sdk/launchpad/protocol/bindings/proof_launchpad_sdk_protocol_go_test.go and its owning consumer tests. Obtain logs from actual precompile execution, cover native family events and per-role origins, and assert non-pool Initialized emission is refused instead of treating it as runtime success evidence."
owner_domain = 4

