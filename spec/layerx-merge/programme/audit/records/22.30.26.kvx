lines = 220
verdict = "clean"
note = "Read the complete address catalogue. It distinguishes retired generation 1 history from v6.12.0 ActiveAddresses. Chain id 125 and all thirteen generation 2 roles agree with shared/config/deployment/current.json and modules/launchpad/keeper/keeper.go. Direct Router calls target 0x1017 while its role has a separate surface. EnvDefaults keys agree with shared/config; historical constants are explicitly retained for decoding."

