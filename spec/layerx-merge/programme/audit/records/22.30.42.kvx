[finding.device-token-rotation]
file = "services/launchpad/user/internal/account/devices_http.go"
line = 116
class = "interface-mismatch"
severity = "high"
observed = "devicePut conflicts only on account_endpoint.fingerprint. A new token for the same installation creates another live row, and the same-device cap exception permits accumulation. app.go:871 emits duplicate DeviceInstallationID values; notifications/consumers.go:199-207 rejects duplicates or more than 32 targets. The single-target query can select an old token."
expected = "An installation must have one current delivery endpoint, and token rotation must preserve a unique bounded target list accepted by the real notification consumer across restart."
proposal = "In services/launchpad/user/internal/account/devices_http.go and user/migrations atomically replace/revoke the previous installation endpoint and enforce unique current bindings; prove rotation and reopen through AccountClient.Targets and ResolveEndpoint."
owner_domain = 4
interface = "4.http-user-put-v2-me-devices-device-id-j29"

[finding.notification-session-revocation]
file = "services/launchpad/user/internal/app/app.go"
line = 778
class = "interface-mismatch"
severity = "high"
observed = "accountNotificationAuthority.target checks endpoint/installation revoked flags and endpoint age, but never joins identity_sessions, auth_epoch, access expiry or installation session binding. The :resolve handler uses this helper. notifications/worker.go relies on CurrentTarget before sending. EndpointEligible has identity checks but is not called by this authority."
expected = "Internal target status and resolution must reflect authoritative session revocation and binding, so logout or session replacement prevents delivery to that session endpoint."
proposal = "In services/launchpad/user/internal/app/app.go share the authoritative eligibility predicate from account/devices_http.go with target list/read/resolve; exercise actual notification delivery after logout, epoch change and service reopen."
owner_domain = 4
interface = "4.http-user-get-internal-v2-accounts-account-id-targets-device-id"

[finding.notification-channel-optout]
file = "services/launchpad/user/internal/app/app.go"
line = 837
class = "interface-mismatch"
severity = "high"
observed = "Delivery preferences build CategoryChannels solely from account_consent.enabled and ignore preferences.Channels. Both preference patch paths can disable global push without changing consent rows. notifications/model.go:139-142 uses CategoryChannels instead of the global channel check, so an enabled category still sends after global opt-out."
expected = "A saved global channel opt-out must suppress every category, and the HTTP delivery preference must carry the effective consent evaluated by the real worker."
proposal = "In services/launchpad/user/internal/app/app.go intersect global channels with persisted category consent and align notifications/model.go semantics; prove a real preferences PATCH causes worker refusal, including after reopen."
owner_domain = 4
interface = "4.http-user-get-internal-v2-accounts-account-id-delivery-preference"

[finding.notification-quiet-timezone]
file = "services/launchpad/user/internal/app/app.go"
line = 816
class = "interface-mismatch"
severity = "medium"
observed = "accountDeliveryPreference.Timezone is copied from preferences.Timezone but only Start/End are copied from QuietHours. Preferences allow a distinct QuietHours.Timezone; notifications/model.go:151-165 therefore computes quiet hours in the wrong zone when these values differ."
expected = "Quiet-hour times must be evaluated in their stored timezone, including when it differs from the display timezone and across daylight-saving changes."
proposal = "In services/launchpad/user/internal/app/app.go and services/launchpad/notifications/model.go carry and evaluate QuietHours.Timezone explicitly, or enforce one documented zone at writes; prove differing-zone settings through actual delivery."
owner_domain = 4
interface = "4.http-user-get-internal-v2-accounts-account-id-delivery-preference"

[finding.backfill-profile-fields]
file = "services/launchpad/user/internal/account/backfill.go"
line = 60
class = "restart-recovery"
severity = "high"
observed = "BackfillLegacyRange selects only wallet/name/bio and writes only these profile fields at line 190. PublicFromReadSwitch reads legacy website at line 256, so a valid visible website disappears after stable reads are enabled. Social/image references also have no explicit preservation or quarantine accounting."
expected = "Stable-read cutover must preserve valid user profile content or quarantine unresolved field/asset migrations before reporting a range verified."
proposal = "In services/launchpad/user/internal/account/backfill.go inventory all legacy fields, preserve valid website/social values and migrate assets through ownership approval; quarantine unresolved rows and compare full public projections before enabling stable reads."
owner_domain = 4

[finding.backfill-provisioning-order]
file = "services/launchpad/user/internal/account/backfill.go"
line = 192
class = "restart-recovery"
severity = "high"
observed = "Backfill inserts account_state with ON CONFLICT(account_id) DO NOTHING, then increments Linked/Verified and emits account.backfill.completed. ensureIdentityAccount can already have created a blank profile, causing valid legacy name/bio to be discarded while migration reports success."
expected = "Verification must establish that source content reached the stable account regardless of whether authentication provisioned the identity before backfill."
proposal = "In services/launchpad/user/internal/account/backfill.go reconcile legacy fields under the account lock without overwriting later user edits; quarantine conflicts and count verified only after durable comparison, testing both provisioning orders after reopen."
owner_domain = 4

[finding.export-sdk-authorization]
file = "services/launchpad/user/internal/account/jobs_http.go"
line = 156
class = "interface-mismatch"
severity = "high"
observed = "jobGet emits job.downloadAuthorization for ready exports, and DownloadHandler requires it in X-Export-Authorization at line 244. AdaptV2AccountJob preserves the field and the open schema permits it, but sdk/launchpad/shared/interfaces/v2/types.gen.go AccountJob and sdk-v2/src/types.gen.ts omit it. The generated Go decoder discards the credential needed to download."
expected = "A completed export must be downloadable through its declared typed SDK response and gateway transport without recovering undocumented raw JSON fields."
proposal = "Declare the authorization mechanism in the source API contracts, regenerate SDK types under sdk/launchpad and align user status/download plus gateway forwarding; retain private no-store handling and prove actual worker-to-typed-consumer-to-download behavior."
owner_domain = 4
interface = "4.http-user-get-v2-me-exports-job-id-j29"

[finding.export-failed-read-consumes-token]
file = "services/launchpad/user/internal/account/jobs_http.go"
line = 249
class = "restart-recovery"
severity = "medium"
observed = "DownloadHandler commits ConsumeExport before fetching the encrypted object at line 259 or decrypting it. A transient object-store failure returns an error after the durable one-use token was consumed, preventing retry of the same ready export."
expected = "Transient storage failure or restart before any download bytes are produced must leave a recoverable access path while enforcing the intended one-use policy."
proposal = "In services/launchpad/user/internal/account/jobs_http.go and privacy.go use a durable bounded download claim recoverable after failed retrieval; finalize consumption at a defined delivery boundary and test storage outage plus reopen without a second successful download."
owner_domain = 4

[finding.provisioned-privacy-default]
file = "services/launchpad/user/internal/account/preferences_http.go"
line = 703
class = "config-drift"
severity = "medium"
observed = "ensureIdentityAccount constructs preferences with omitted PrivateActivity=false and quiet hours 00:00-00:00. DefaultPreferences at models.go:240 instead sets PrivateActivity=true and 22:00-07:00. Gateway-provisioned accounts receive different privacy defaults from backfilled/store-created accounts."
expected = "New accounts must receive one documented privacy-preserving default set independent of provisioning path, while explicit later user choices remain authoritative."
proposal = "In services/launchpad/user/internal/account/preferences_http.go initialize from DefaultPreferences and set timestamps explicitly; reconcile untouched auto-provisioned defaults without overwriting choices and compare gateway/backfill provisioning outputs."
owner_domain = 4

[finding.legacy-wallet-replay]
file = "services/launchpad/user/internal/user/handlers.go"
line = 223
class = "security"
severity = "medium"
observed = "Legacy updateProfile, uploadImage and watchlistAuth accept any message/signature recovering the wallet. The message is not bound to action, body, nonce, expiry or chain; a previously obtained signature can authorize different writes repeatedly. app.go mounts these routes outside production."
expected = "Every exposed wallet-authorized mutation must bind consent to its exact action/content with replay and expiry protection, including shared development/preview deployments."
proposal = "In services/launchpad/user/internal/user/handlers.go use the shared signed-operation/identity path bound to chain 125, method, path, body digest, nonce and expiry; prove replay and cross-action reuse are rejected on actual routes."
owner_domain = 4

[finding.legacy-multipart-unbounded]
file = "services/launchpad/user/internal/user/handlers.go"
line = 261
class = "runtime-risk"
severity = "medium"
observed = "uploadImage parses the complete multipart form before authentication. multipartMaxMemory limits memory before disk spill, not total bytes; avatar/banner limits apply only to the selected file after parsing. Extra unauthenticated parts can consume disk and parsing resources."
expected = "Upload bytes and part counts must be bounded before multipart parsing/expensive allocation, with temporary resources released on refusal."
proposal = "In services/launchpad/user/internal/user/handlers.go apply a total MaxBytesReader budget before parsing and constrain parts; authenticate bounded headers where possible and prove oversized multipart requests stop before storage/scanner work."
owner_domain = 4

[finding.legacy-image-cache-stale]
file = "services/launchpad/user/internal/user/handlers.go"
line = 392
class = "runtime-risk"
severity = "medium"
observed = "serveImage marks /users/{wallet}/{avatar|banner} immutable for one year, but uploadImage overwrites a stable object key at line 331 and returns the same URL. Successful image replacement can remain invisible to clients/CDNs for a year despite Redis invalidation."
expected = "A successful image replacement must become visible through the profile URL; immutable cache headers require URLs identifying immutable bytes."
proposal = "In services/launchpad/user/internal/user/handlers.go use content-addressed/versioned image URLs with retained old objects, or require revalidation on stable URLs; prove replacement via public reads and cache headers."
owner_domain = 4

[finding.svg-normalized-active-content]
file = "services/launchpad/user/internal/image/image.go"
line = 52
class = "security"
severity = "medium"
observed = "IsSVGSafe checks raw bytes with a javascript: regex and a small tag denylist. An SVG href containing java&#x73;cript: passes lexical checks but XML decoding produces an active JavaScript URL. Legacy upload accepts and serves image/svg+xml on the service origin."
expected = "Accepted images must remain passive after XML/URL parsing and direct navigation; lexical checks must not claim an active-content safety boundary."
proposal = "In services/launchpad/user/internal/image/image.go use a maintained XML/namespace/URL allowlist or rasterization and restrict serving in user/handlers.go; cover character references, namespace variants and external active content."
owner_domain = 4

[finding.profile-host-cache-poisoning]
file = "services/launchpad/user/internal/user/helpers.go"
line = 23
class = "security"
severity = "medium"
observed = "baseURL trusts r.Host and X-Forwarded-Proto when PublicURL is empty. handlers.go:146-157 caches the resulting absolute-URL profile under a wallet-only Redis key, allowing one request origin to populate links returned to other callers."
expected = "Shared cached public profiles must contain canonical admitted-origin links independent of caller-controlled Host and forwarding headers."
proposal = "In services/launchpad/user/internal/user/helpers.go require canonical PublicURL or validate hosts/trusted proxies before generating links; cache relative/canonical URLs and test two different hosts sharing a wallet cache."
owner_domain = 4

[finding.sqlc-nullable-config]
