line = 24
class = "config-drift"
severity = "low"
observed = "sqlc.yaml requests nullable text/varchar as *string, while checked-in sqlcdb models/query bindings use pgtype.Text and helpers.go explicitly converts pgtype.Text. Regeneration would change caller-facing nullable types."
expected = "Checked-in generator configuration must reproduce generated database types consumed by handlers without manual post-generation edits."
proposal = "In services/launchpad/user/sqlc.yaml choose the existing pgtype.Text contract or migrate callers deliberately; regenerate with pinned sqlc and verify the resulting API builds reproducibly."
owner_domain = 4

