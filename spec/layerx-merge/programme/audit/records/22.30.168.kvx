[finding.unbonding-retry]
file = "sdk/x/staking/keeper/val_state_change.go"
line = 36
class = "restart-recovery"
severity = "high"
observed = "BlockValidatorUpdates calls DequeueAllMatureUBDQueue, which deletes the persisted timeslice in keeper/delegation.go:391, before CompleteUnbonding. A bank refusal returns ErrInvalidRecipient and the loop continues without requeuing. The balance and UBD object survive, but subsequent blocks and a restart have no durable work item to retry."
expected = "Requirement 22067.1 requires a refused mature unbonding to stay queued, preserve the pool and supply invariant, and let the block continue. Recovery must resume the payment exactly once after the recipient is permitted."
proposal = "In sdk/x/staking/keeper/val_state_change.go retain or reinsert each refused DVPair durably and isolate completion writes so failures cannot partially pay an entry. Extend delegation_test.go through a blocked block, an unblocked later block, committed-store restart and exactly one payout."
owner_domain = 15
interface = "15.go-x-staking-end-blocker-j76"

[finding.deny-list-grants]
file = "sdk/x/staking/types/authz.go"
line = 97
class = "interface-mismatch"
severity = "high"
observed = "NewStakeAuthorization accepts a deny-only list and the grant CLI serializes that oneof into authz storage. Accept initializes isValidatorExists from the empty allow list and unconditionally rejects it at line 97. A denied validator fails in the deny loop; every validator outside the deny list fails afterward as well."
expected = "A deny-list grant must authorize validators outside that list, subject to message type and token limit, when the stored Any is dispatched through authz.MsgExec. Allow-list and deny-list policies must preserve their distinct meanings."
proposal = "In sdk/x/staking/types/authz.go apply membership-required logic only for an allow-list oneof and exclusion logic for a deny-list oneof. Prove CLI grant, persisted Any decode and real MsgExec both for an excluded validator and a permitted validator after restart."
owner_domain = 15
interface = "15.go-x-staking-types-new-stake-authorization-j76"

[finding.stake-limit-panics]
file = "sdk/x/staking/types/authz.go"
line = 106
class = "security"
severity = "medium"
observed = "StakeAuthorization.Accept subtracts amount using a.MaxTokens.Sub without checking denomination or available allowance. sdk/types/coin.go:111 panics for a different denom or a negative result, so a grantee exceeding a grant limit gets a panic rather than an authorization error; current authz tests cover only exact and smaller limits."
expected = "An authorization must reject an overspend or denomination mismatch with a deterministic error and leave the saved allowance unchanged. User-controlled authorization limits must not reach a panic-only arithmetic path."
proposal = "In sdk/x/staking/types/authz.go validate the coin denomination and amount before subtraction and return an explicit SDK authorization or funds error. Add real grant/exec overspend and wrong-denom cases asserting unchanged stored allowance and balances."
owner_domain = 15
interface = "7.proto-cosmos-staking-v1beta1-stakeauthorization-j39"

