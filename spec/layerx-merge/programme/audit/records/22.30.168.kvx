[finding.redelegation-power-cap]
file = "sdk/x/staking/keeper/delegation.go"
line = 653
class = "runtime-risk"
severity = "high"
observed = "Delegate calculates newTotalPower as GetLastTotalPower plus bondAmt/PowerReduction even when BeginRedelegation calls it with subtractAccount=false and both validators bonded. At total bonded power 1050000 and target power 190000, transferring 21000 from another bonded validator is admitted as 211000/1071000 below the default 0.2 cap, while actual target power becomes 211000/1050000 above 0.2."
expected = "The configured MaxVotingPowerRatio must bound the destination share of the actual resulting bonded voting power once the enforcement threshold is reached. A transfer of already bonded stake must not invent additional network power in the denominator."
proposal = "In sdk/x/staking/keeper/delegation.go calculate the resulting bonded total from source and destination states and current transaction effects, without adding bonded-to-bonded transfers twice. Prove a near-cap redelegation and multiple operations in one block against the end-block validator powers."
