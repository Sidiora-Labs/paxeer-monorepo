line = 167
class = "runtime-risk"
severity = "medium"
observed = "EditValidator compares a raised MinSelfDelegation with validator.Tokens, which includes other delegators. An operator with little personal stake can advertise a higher self minimum backed only by unrelated delegators, and the validator is stored without checking the operator delegation."
