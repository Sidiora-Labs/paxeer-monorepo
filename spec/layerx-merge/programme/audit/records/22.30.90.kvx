[finding.native-send-owner]
file = "services/agent/crates/layerx-agent-api/src/identity.rs"
line = 416
class = "interface-mismatch"
severity = "high"
observed = "NativeSendPurposeV1::validate_fields derives owner_did from the current 32-byte owner_public_key and fixes protocol_version to 3. Canonical/wire formats retain hex32 keys and hex64 signatures. services/agent/schema/agent-api/v1.kvx:900-901 instead declares EIP-1559 type 2 and an actual 20-byte owner address, despite its incompatible field list. human_runtime.rs:6275 constructs and validates this record on the live EVM preparation path. A stable owner DID with a rotated primary key also fails the derived-DID equality."
expected = "Native-send consent must authenticate the actual current owner and bind the prepared type-2 transaction on chain 125 with one agreed representation across Human, daemon, SDK and custody. Stable principal identity must survive legitimate primary-key rotation."
proposal = "In services/agent/schema/agent-api/v1.kvx and layerx-agent-api/src/identity.rs define a versioned consent contract distinguishing stable owner DID, consent verification key and recovered 20-byte EVM sender. Update agent_rpc_wire.rs, human_runtime.rs and Human/custody consumers together; retain explicit legacy refusal and prove a rotated-owner Send through transport, signing and restart."
owner_domain = 9
interface = "9.rs-agent-api-nativesendpurposev1-validate-j70"

[finding.proof-rung]
file = "services/agent/crates/layerx-agent-api/src/read.rs"
line = 407
class = "interface-mismatch"
severity = "high"
observed = "ProofBundle::check_response requires achieved_rung == selector.required_rung(). Activity and Receipt selectors return Receipted, so a valid Committed bundle fails even when the caller requested Committed. The daemon agent_rpc_adapters.rs and SDK agent_envelope.rs call this shared check."
expected = "services/agent/schema/agent-api/v1.kvx:487 requires at least Receipted for Activity/Receipt and Committed for AccountState. Stronger authenticated evidence must satisfy both the selector minimum and the requested rung."
proposal = "In layerx-agent-api/src/read.rs compare achieved_rung against both selector minimum and requested_rung while retaining field-set and verification-level agreement. Prove a real committed transaction receipt through daemon RPC and SDK for Activity and Receipt selectors, plus downgrade refusals."
owner_domain = 9
interface = "9.rs-agent-api-proofbundle-check-response-j70"

[finding.proof-rung-test]
file = "services/agent/crates/layerx-agent-api/tests/read_heights.rs"
line = 224
class = "test-gap"
severity = "medium"
observed = "proof_bundle_mirror_requires_receipted_or_committed_rungs asserts success only when achieved == expected. This positively requires rejecting Committed evidence for Activity and Receipt, preserving the read.rs minimum-versus-equality defect."
expected = "The schema minimum permits Committed evidence for Activity and Receipt requests at Receipted or Committed. Insufficient and internally inconsistent evidence must remain refused."
proposal = "Replace the equality expectation in layerx-agent-api/tests/read_heights.rs with explicit committed success cases for both selectors and retain all lower-rung and inconsistent-field negative cases. Add the real producer-to-RPC regression with independently verified committed evidence."
owner_domain = 9

[finding.event-cursor]
file = "services/agent/crates/layerx-agentd/src/events/deliver.rs"
line = 244
class = "interface-mismatch"
severity = "high"
observed = "DeliveryEngine::open_inner interprets acknowledged_cursor.block_height as a local durable sequence. next_source_item:624-648 publishes sequence+1 as block_height and zeros tx_index/log_index although ingest retains the Ethereum log position. A node cursor therefore selects the wrong local rows and restart resumes from a fabricated position."
expected = "The public cursor is the ordered block_height/tx_index/log_index triple identifying node events; ingestion, delivery, acknowledgement and restart must retain that position separately from internal ordinals."
proposal = "In events/deliver.rs carry the retained node log cursor into EventDelivery and select resume/backfill boundaries using that cursor. Keep journal ordinals separate. Prove two logs per transaction and two transactions per block through delivery, acknowledgement, process reopen and live backfill seam."
owner_domain = 9
interface = "9.rs-agentd-deliveryengine-open-j70"

[finding.event-replay-identity]
file = "services/agent/crates/layerx-agentd/src/events/deliver.rs"
line = 796
class = "interface-mismatch"
severity = "high"
observed = "event_identity hashes local sequence and canonical_bytes. ingest.rs:1074-1094 promotes a receipted log by replacing bytes when blockHash becomes known, and durable_event overlays that committed representation. Delivery effects followed by promotion and reopen before acknowledgement change the deduplication_id for the same transaction log."
expected = "At-least-once delivery requires a stable consumer deduplication key across evidence promotion and process restart, even when block hashes or stronger evidence become available."
proposal = "In events/deliver.rs derive identity from immutable tenant/chain and transaction-log identity retained by events/ingest.rs, with an explicit rule for logs lacking transaction hashes. Prove send-without-ack, receipt promotion, process reopen and replay preserve one identity and one consumer effect."
owner_domain = 9
interface = "9.rs-agentd-events-deliver-deliveryengine"

[finding.outbound-peer]
file = "services/agent/crates/layerx-agentd/src/events/outbound.rs"
line = 629
class = "security"
severity = "medium"
observed = "peer_identity obtains uid/gid from /proc/self/fd metadata for the client socket inode. authenticate_peer treats local ownership as connected receiver identity, so a valid receiver under another UID is refused and the reported peer is not the remote process. Separate HMAC checks do not correct peer attribution."
expected = "The expected_peer setting must be checked against operating-system credentials of the connected Unix peer before frames or delivery receipts are trusted."
proposal = "Replace peer_identity in events/outbound.rs with Linux SO_PEERCRED or the supported platform peer-credential API. Keep HMAC binding, reject unavailable credentials explicitly and exercise real cross-UID and wrong-UID receiver processes."
owner_domain = 9
interface = "9.rs-agentd-events-outbound-peer-identity-j43"

[finding.outbound-connect-deadline]
file = "services/agent/crates/layerx-agentd/src/events/outbound.rs"
line = 544
class = "runtime-risk"
severity = "medium"
observed = "exchange calls blocking UnixStream::connect before setting nonblocking mode and constructing WaitBudget. A full Unix listener backlog can block delivery before endpoint.deadline or cancellation_poll applies, retaining the worker beyond its configured bound."
expected = "The endpoint deadline and cancellation must bound connection establishment as well as frame writes and acknowledgement reads."
proposal = "In events/outbound.rs establish a nonblocking Unix connection under the same end-to-end wait budget, poll completion and cancellation, and map timeout to the existing retry state. Exercise a real saturated listener backlog and revocation during connection establishment."
owner_domain = 9

[finding.approval-replay-bounds]
file = "services/agent/crates/layerx-agentd/src/policy/approval.rs"
line = 1220
class = "interface-mismatch"
severity = "high"
observed = "encode_legacy_hold writes u32 counts for budget_reservations, counterparties and amounts without MAX_DISCLOSURE_ITEMS checks. validate_reservation has no 64-item ceiling, while decode_reservations:1489 and decode_legacy_hold:1399/1408 reject counts above 64. A successful small hold covering 65 limits fits MAX_HOLD_RECORD_BYTES but cannot reopen, preventing approval restoration and retaining reservations."
expected = "Every successfully published durable approval must be accepted by its restart decoder. Cardinalities must be checked consistently before publication or leaving budget reserved."
proposal = "In policy/approval.rs share validated cardinality limits between admission, encoder and decoder and reject oversized holds before durable publication with reservation rollback. Preserve decoder safety checks; prove 64-item success/reopen and 65-item named refusal without leaked reservations using the real persistent registry."
owner_domain = 9
interface = "9.rs-agentd-policy-approval-hold-reserved-at-j43"

[finding.approval-time-units]
file = "services/agent/crates/layerx-agentd/src/policy/approval.rs"
line = 758
class = "runtime-risk"
severity = "medium"
observed = "hold_inner compares expires_at_sequence with prepared.expiry.0 although Prepared.expiry is TimestampSeconds. Public hold/hold_reserved retain this path and ApprovalService calls hold_reserved; hold_reserved_at already accepts a distinct protocol-time presentation."
expected = "A block-sequence approval window and an unsigned transaction Unix expiry use different units. Admission and release must check each against its corresponding current source."
proposal = "Route ApprovalService and remaining callers through the timed entry in policy/approval.rs, introduce distinct sequence/time argument types and explicitly retire ambiguous legacy entries. Prove realistic chain heights and Unix seconds, including time expiry without a sequence change."
owner_domain = 9
interface = "9.rs-agentd-policy-approval-hold-reserved-j43"

[finding.paused-delivery]
file = "services/agent/crates/layerx-agentd/src/events/deliver.rs"
line = 737
class = "runtime-risk"
severity = "medium"
observed = "delivery_attempt and eligible_sequences check stops and continuity but never subscription.paused. outbound::exchange can send a buffered frame and receive acceptance; only finish_delivery reaches SubscriptionStore::mark_delivered_inner:524 and returns Paused. Receiver effects can occur without recorded delivery, followed by retries."
expected = "A paused subscription must stop dispatching new frames, including buffered frames, and resume from an unambiguous durable boundary."
proposal = "In events/deliver.rs and events/outbound.rs check current durable paused state at dequeue and immediately before dispatch, coordinated with pause transitions. Define in-flight acknowledgement semantics and prove pause after buffering, no receiver effect while paused and one delivery after resume."
owner_domain = 9

[finding.unacknowledged-window]
file = "services/agent/crates/layerx-agentd/src/events/subscription.rs"
line = 539
class = "runtime-risk"
severity = "medium"
observed = "mark_delivered_inner inserts each cursor in delivered_unacknowledged and encode_record serializes the entire set per delivery. No outstanding window is enforced; DeliveryEngine capacity bounds only its queue. A receiver accepting frames without acknowledging grows durable state and repeated write work indefinitely."
expected = "Subscription quotas must bound delivered-but-unacknowledged history while preserving ordered acknowledgement checks and restart replay."
proposal = "Add a configured per-subscription outstanding-delivery window in events/subscription.rs and propagate backpressure through delivery/outbound before further effects. Resume after acknowledgement and prove the limit, durable reopen and ordered replay with a real slow-ack receiver."
owner_domain = 9

[finding.subscription-upgrade-recovery]
file = "services/agent/crates/layerx-agentd/src/events/subscription.rs"
line = 1400
class = "restart-recovery"
severity = "medium"
observed = "decode_record returns CursorResetRequired for PREVIOUS_RECORD_MAGIC or LEGACY_RECORD_MAGIC. load_records:281 propagates the first such error from open/open_shared, preventing all subscriptions in the tenant from loading. This API exposes no identified per-subscription migration/reset operation."
expected = "Refusing incompatible cursor encodings is appropriate, but upgrade recovery must identify affected subscriptions and provide an explicit operator action with an auditable replay boundary."
proposal = "Provide a backed-up migration or authenticated reset operation owned by events/subscription.rs, with subscription identity in the refusal and documented replay consequences. Exercise a mixed old/current tenant store through refusal, operator recovery and reopen without silently discarding records."
owner_domain = 9

[finding.policy-history-durability]
file = "services/agent/crates/layerx-agentd/src/policy/version.rs"
line = 94
class = "restart-recovery"
severity = "medium"
observed = "PolicyRegistry retains versions and decision audit entries only in BTreeMaps; initial resets generation to 1 and record_decision overwrites by request_id. operation::load_tenant_registries reloads current source files at boot. Historical sources and decisions advertised as retained for reconstruction disappear on restart."
expected = "Decisions explaining approval or refusal must remain attributable to the exact tenant policy generation and source after restart, under an explicit bounded retention lifecycle."
proposal = "In policy/version.rs and policy/operation.rs persist tenant activation/source digests and decision references before publishing them, reconstruct generation on boot and define retention quotas. Prove a decision under one version followed by activation, reopen and reconstruction of the original decision."
owner_domain = 9

[finding.mcp-history-scan]
file = "services/agent/crates/layerx-agentd/src/session_control.rs"
line = 4004
class = "runtime-risk"
severity = "medium"
observed = "mcp_transition_updates scans all retained MCP invocations under every tenant Idempotency namespace during store transitions and restores tenant session registries. mcp_store_evidence_for_tool also scans all invocation IDs. No terminal-record retention or indexed lookup bounds accumulated history, so session/store work grows with lifetime invocation count."
expected = "Durable MCP evidence must retain unknown/effect-started outcomes while bounding lookup and transition work for long-lived tenants, including timely session revocation."
proposal = "In session_control.rs index invocations by session/generation and idempotency/tool, define bounded retention or archival for terminal records and pin unresolved effects. Prove revocation and lookup with accumulated history, archive/reopen and unresolved invocations intact."
owner_domain = 9

