[finding.push-payload-shape]
file = "apps/wallet/src/pwa/sw.ts"
line = 161
class = "runtime-risk"
severity = "medium"
observed = "The push listener casts event.data.json() to PushPayload without validating it. Valid JSON null passes the parse try block, then payload.title throws outside that block and the notification is dropped; non-string fields are also forwarded without type or size checks."
expected = "A malformed push payload must be refused or produce a bounded generic notification without crashing the worker, and only validated presentation fields should reach showNotification."
proposal = "Validate the object and field types in apps/wallet/src/pwa/sw.ts before using it, apply length limits and safe defaults, and exercise null, arrays, scalar JSON and oversized fields through the worker push handler."
owner_domain = 12

[finding.push-renewal-delivery]
file = "apps/wallet/src/pwa/sw.ts"
line = 192
class = "restart-recovery"
severity = "medium"
observed = "pushsubscriptionchange subscribes a new endpoint and sends it only to currently open clients. With no windows the update disappears. The PWAProvider message handler only rereads the subscription into UI state; this path does not update the push server, leaving delivery aimed at the expired endpoint."
expected = "Renewed subscriptions must reach the authenticated push registration service and survive a worker-only renewal or temporary server unavailability."
proposal = "Persist pending renewal in apps/wallet/src/pwa/sw.ts, synchronize it through the authenticated push client when an eligible session opens, and clear it only after server acknowledgement; prove windowless renewal and retry against the real registration route."
owner_domain = 12

[finding.auth-callback-cleanup]
file = "services/wallet/demo/src/app/auth/callback/page.tsx"
line = 35
class = "runtime-risk"
severity = "medium"
observed = "The callback effect installs an auth listener and an eight-second timer inside the async branch, but cleanup only sets cancelled. The listener does not check cancelled, so after navigation/unmount it can still call router.replace; it also remains registered if cleanup happened before the timeout fires."
expected = "Sign-in completion must stop listeners and timers when its page unmounts or completes so an old callback cannot redirect a later wallet session."
proposal = "In services/wallet/demo/src/app/auth/callback/page.tsx retain the unsubscribe and timeout handles in the effect, clear both on success and cleanup, check cancellation in callbacks, and cover delayed authentication after unmount."
