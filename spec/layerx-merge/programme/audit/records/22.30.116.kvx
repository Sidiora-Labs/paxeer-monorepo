class = "runtime-risk"
severity = "medium"
observed = "StorageRepository.write catches persistence failures and returns void; update returns next even when write did not save it. For fail-closed definitions writeTo can throw StorageCorruptionError on quota/validation, but write converts that to a background notification and callers still receive an apparent successful update."
expected = "Security-relevant choices and settings must expose whether a write persisted; fail-closed records must propagate refusal so the UI cannot present an unsaved value as durable."
