[finding.snapshot-state]
file = "services/wallet/attestor/internal/store/backup.go"
line = 74
class = "restart-recovery"
severity = "high"
observed = "Store.Snapshot serializes only bucketShares and Restore repopulates only that bucket. The records, staged and replay buckets are absent. RecordLedger holds rolling spend/rate history; policy.SpendLedger.load treats a missing record as empty usage. Ceremony import receipts, verification/refresh decisions and native-purpose/agent authority records also disappear after restoring the same keys."
expected = "A recovered signing node must retain its policy limits, replay decisions and key ceremony state as well as its secret shares. The backup transport must preserve the state consumed by production policies() in cmd/attestor/main.go and the store lifecycle methods."
proposal = "In services/wallet/attestor/internal/store/backup.go introduce a versioned authenticated snapshot of every durable lifecycle bucket, restore it transactionally, validate key/ceremony relationships before admitting signing, and prove spend limits, replay refusals and interrupted ceremony recovery through the production backup writer and restored server."
owner_domain = 12
interface = "12.go-att-store-store-snapshot"

[finding.account-names]
file = "services/wallet/attestor/internal/lxwire/ids.go"
line = 136
class = "interface-mismatch"
severity = "high"
observed = "parseAgentAccount accepts budget, escrow and margin markers but omits stream. Thus AccountID rejects agent:did:layerx:alice:stream:s1 although layerxproof/codec.AccountKind accepts it as kind 4 and DeriveAccountID derives its identifier. The attestor also lacks the chain funding and module:value namespaces, including the latter direct-identifier rule."
expected = "The registered native AccountID interface must agree with the chain identifier producer on supported canonical names and identifier bytes. checkProtocolThreeName already includes stream, but its earlier parser prevents this canonical name reaching the hash."
proposal = "Align services/wallet/attestor/internal/lxwire/ids.go with the canonical grammar in layerxproof/codec/state.go and src/ledger/lx_account_id.c, including stream, funding and module-value semantics; share valid and invalid vectors across all implementations and prove the exact names and bytes through policy consumers."
owner_domain = 12
interface = "12.go-att-lxwire-account-id"

[finding.account-parity-test]
file = "services/wallet/attestor/internal/lxwire/lxwire_test.go"
line = 537
class = "test-gap"
severity = "medium"
observed = "TestAccountIDsMatchRustAndChain places agent:did:layerx:alice:stream:s1 in the rejected-name table. The positive subset is compared with codec.DeriveAccountID, but rejected names are checked only against the attestor, so a chain-valid account is codified as invalid."
expected = "Parity coverage must compare acceptance, refusal and derived bytes against the real chain codec for every canonical namespace, including streams and special module-value identifiers."
proposal = "In services/wallet/attestor/internal/lxwire/lxwire_test.go use a shared all-kind vector table and compare both successful derivation and rejected inputs with the chain codec; include policy-consumer cases for stream accounts instead of preserving this contradictory refusal."
owner_domain = 12
interface = "12.go-att-lxwire-account-id"

