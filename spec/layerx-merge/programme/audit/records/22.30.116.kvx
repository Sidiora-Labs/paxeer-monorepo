[finding.replica-timeout]
file = "services/wallet/attestor/internal/replica/shipper.go"
line = 284
class = "runtime-risk"
severity = "medium"
observed = "connect clears the raw socket deadline after SSH handshake. sftp.NewClient, Stat, upload, remoteDigest and rename then have no deadline or context-driven socket closure. A peer that accepts SSH but stops servicing SFTP can block Ship and its background loop indefinitely despite context cancellation."
expected = "Replica shipping must bound stalled remote operations and let cancellation terminate a shipment so backup health and shutdown remain responsive."
proposal = "In services/wallet/attestor/internal/replica/shipper.go close the underlying connection on context cancellation and enforce a configured operation deadline through subsystem negotiation, upload and read-back; exercise a real SSH/SFTP peer that stalls after handshake."
owner_domain = 12
interface = "12.go-att-replica-new"

[finding.replica-ledger-growth]
file = "services/wallet/attestor/internal/replica/ledger.go"
line = 121
class = "runtime-risk"
severity = "medium"
observed = "Ledger.Record retains every shipped snapshot forever, copies the entire map, sorts it and atomically rewrites the whole JSON file for each new snapshot. Local snapshot retention does not prune ledger entries, so memory, startup and write cost grow with node lifetime."
expected = "A long-running backup service must have a bounded active shipping index while retaining the evidence needed to distinguish acknowledged snapshots from unshipped local files."
proposal = "Define retention and archival for services/wallet/attestor/internal/replica/ledger.go, prune entries only after acknowledged local snapshot retirement, and prove restart, duplicate detection and retention behavior with a long history."
owner_domain = 12
interface = "12.go-att-replica-open-ledger"

