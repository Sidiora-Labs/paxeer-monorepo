class = "config-drift"
severity = "medium"
observed = "Both serial reconstruction paths insert root/tools/production before importing dispatcher, then require root/spec/production-system/spec.kvx, execution-plan.json and tools/production/bootstrap/check-registry.json. Those tools and spec directories are absent in this checkout; dispatcher and its registry live under tools/launchpad/production. qualify.py uses a different missing launchpad/spec path."
expected = "Serial qualification must reconstruct the same reviewed graph and control plane as its caller using real current paths, while keeping the exact lane inventory, ownership, source digests and accepted evidence bindings intact."
proposal = "Migrate tools/launchpad/production/serial_gate.py together with qualify.py canonical control-plane bindings to the split layout and a reviewed retained graph. Resolve dispatcher from tools/launchpad/production and update all source and ownership bindings explicitly, preserving the fifty-lane and exact-patch checks."
owner_domain = 4
interface = "4.cli-lp-tools-production-serial-gate"

[finding.error-beacon-byte-limit]
file = "apps/launchpad/web/src/app/api/errors/route.ts"
line = 44
class = "runtime-risk"
severity = "medium"
observed = "POST /api/errors awaits request.text() before checking MAX_BODY_BYTES, so the entire unauthenticated request is buffered first. The check uses JavaScript string length rather than UTF-8 byte length, allowing multibyte bodies larger than the stated 64 KiB hard cap and allocating arbitrarily large bodies before rejection."
expected = "The client telemetry sink must enforce its 64 KiB byte budget while reading the body and before JSON decoding or telemetry forwarding, without allowing an unauthenticated upload to consume an unbounded buffer."
proposal = "In apps/launchpad/web/src/app/api/errors/route.ts read the request stream with an accumulated byte count, cancel and return 413 once the existing byte cap is crossed, and decode only bounded bytes. Cover chunked and multibyte input while preserving valid beacon delivery and existing response behavior."
owner_domain = 4
interface = "4.http-web-api-errors-j30"

[finding.forwarded-ip-validation]
file = "sdk/launchpad/shared/http/server.go"
line = 99
class = "security"
severity = "medium"
observed = "resolveClientIP treats any nonempty X-Forwarded-For hop outside trusted prefixes as the client, including strings that netip.ParseAddr rejects; X-Real-IP is returned without parsing at all. A trusted proxy that forwards a malformed value gives rate and connection accounting an arbitrary string identity instead of an IP address."
expected = "TrustedClientIP and NewRouter must resolve a canonical valid client IP through trusted hops. A malformed forwarded header must not become a new rate-limit or connection-cap identity, even when the immediate peer is trusted."
proposal = "In sdk/launchpad/shared/http/server.go parse and canonicalize each forwarded candidate with netip, and apply a documented fail-closed policy for invalid chains and X-Real-IP values. Extend the existing real router and outer-limiter tests to malformed hops, equivalent IP encodings and trusted-proxy chains."
owner_domain = 4
interface = "4.go-shared-http-trusted-client-ip"

[finding.configuration-secret-errors]
file = "services/launchpad/api/internal/config/config.go"
line = 234
class = "security"
severity = "medium"
observed = "requireRedisURL and requireURL include the complete raw connection string using %q in validation errors. A malformed credentialed Redis URL or database URL is therefore returned through config.Load and app.Run to apid main, which logs the error with log.Fatalf, exposing embedded passwords in startup logs."
expected = "Invalid secret-bearing configuration must identify the failing variable and validation rule without printing the DSN, password or credential bytes. The brief requires secrets never to be logged, including failure paths."
proposal = "Replace raw DSN interpolation in services/launchpad/api/internal/config/config.go with variable-name and rule-only errors. Exercise malformed credentialed database and Redis URLs and assert that neither the password nor full DSN appears in the error propagated to startup logging."
owner_domain = 4

[finding.reconciler-interval-validation]
file = "services/launchpad/pnl-tracker/internal/config/config.go"
line = 128
class = "config-drift"
severity = "medium"
observed = "Load calls the embedded BaseEnv.Validate but never bounds ReconcileIntervalMS. ReconcileInterval converts any supplied integer directly to time.Duration; the non-accounting runtime passes it into App.loop and time.NewTicker. PNL_RECONCILE_INTERVAL_MS=0 or a negative value panics in that background goroutine, and extreme values can overflow the duration."
expected = "Configuration accepted by Load must produce a positive, representable scan interval in every supported runtime path, including the non-accounting reconciler, and invalid operator input must fail before background jobs are started."
proposal = "Add service-owned interval validation in services/launchpad/pnl-tracker/internal/config/config.go before returning Config, with a documented positive maximum that fits time.Duration. Keep valid defaults and overrides and add boundary cases for zero, negative and overflow values."
owner_domain = 4
interface = "4.env-pnl-tracker-pnl-reconcile-interval-ms"

[finding.legacy-websocket-bounds]
file = "services/launchpad/api/internal/ws/ws.go"
line = 260
class = "runtime-risk"
severity = "medium"
observed = "The legacy wsConn.run calls ReadMessage without SetReadLimit. applySubscribe accepts any nonempty pool string and retains every new value in c.pools without a count bound. app.New mounts these handlers in non-production mode; production uses the separately bounded HandleV2 path, so this finding is limited to the supported legacy/development listener."
expected = "A mounted development websocket must still bound inbound frame bytes and subscription cardinality so one connection cannot exhaust the server used for real local integration and qualification."
proposal = "In services/launchpad/api/internal/ws/ws.go apply an explicit read limit before reading frames, validate canonical pool addresses, and enforce an explicit per-connection pool subscription budget. Add real websocket cases for oversized frames and incremental subscription accumulation without changing the authenticated v2 protocol."
owner_domain = 4

[finding.legacy-webhook-body-bound]
file = "services/launchpad/pnl-tracker/internal/httpapi/webhook.go"
line = 125
class = "runtime-risk"
severity = "medium"
observed = "webhookAuth reads all of r.Body before checking the signature and restores it for a second full read in webhookHandler. No MaxBytesReader bounds this route in RegisterWebhook or the shared router. app.New mounts it only outside production, where an unauthenticated oversized request can allocate the complete payload before failing HMAC verification."
expected = "The development webhook receiver must enforce a byte and event-count budget before authentication parsing and event decoding. HMAC authentication does not provide a memory bound for requests that have not yet been verified."
proposal = "Bound the request body in services/launchpad/pnl-tracker/internal/httpapi/webhook.go before the first read, reject oversized input explicitly, and cap the decoded event batch. Preserve the authentic raw bytes for HMAC verification and downstream folding, and cover chunked oversized unauthenticated requests."
owner_domain = 4

[finding.legacy-card-publication-policy]
file = "services/launchpad/pnl-tracker/internal/httpapi/cards.go"
line = 45
class = "security"
severity = "medium"
observed = "POST /pnl/cards accepts an arbitrary body.OwnerAddress and persists a public card without authenticating the caller or confirming ownership. app.New mounts it in production alongside the v3 SharesV3 routes, whose preview and publish handlers authenticate the owner and bind selected disclosure fields and expiry. Legacy snapshots include the wallet and the complete position by default."
expected = "An owner-controlled PnL publication flow must not have a second mounted mint endpoint that can publish a different wallet snapshot without that owner authorization, field selection and lifecycle policy."
proposal = "Reconcile services/launchpad/pnl-tracker/internal/httpapi/cards.go registration with the v3 publication policy: retire the unauthenticated mutation or require the same authenticated owner, preview intent and disclosure controls. Preserve intentional public reads only through an explicit reviewed compatibility contract."
owner_domain = 4
interface = "4.http-pnl-tracker-post-pnl-cards"

[finding.card-unavailable-as-zero]
file = "services/launchpad/pnl-tracker/internal/card/card.go"
line = 313
class = "runtime-risk"
severity = "medium"
observed = "Mint allows a missing market price, and formatSignedUsdl returns $0.00 with a positive sign when pnlmath.TotalPnl fails; formatMultiple likewise replaces a HoldingValue error with zero. BuildRenderInput therefore renders an apparently numeric result for a persisted snapshot whose current valuation is unavailable or malformed."
expected = "The service contract states that a service never reports a state it did not read: an unavailable source must produce a named refusal or an explicitly unavailable figure rather than a zero presented as a calculated financial result."
proposal = "In services/launchpad/pnl-tracker/internal/card/card.go preserve pricing and basis quality through snapshot and render input. Refuse mint/render when required evidence is absent or render a distinct unavailable state; retain exact integer calculations and exercise missing and malformed marks instead of accepting numeric zero fallbacks."
owner_domain = 4

[finding.storage-buffer-bound]
file = "sdk/launchpad/shared/storage/r2.go"
line = 190
class = "runtime-risk"
severity = "medium"
observed = "Client.GetBytes uses io.ReadAll on the object body without checking Object.Size or enforcing any maximum, despite being documented for small images. It is also called by the account export download path in services/launchpad/user/internal/account/jobs_http.go, so object size is not constrained by this helper to the image budget."
expected = "A buffered object download must have an explicit caller-approved byte budget and reject oversize data before allocating the entire object, including missing or incorrect object Content-Length values."
proposal = "Introduce an explicit maximum-size buffered read contract in sdk/launchpad/shared/storage/r2.go, checking known size and enforcing maximum-plus-one while streaming. Migrate image and account-export callers with their own documented budgets, and use the streaming Get API for intentionally larger objects."
owner_domain = 4
interface = "4.go-shared-storage-client-get-bytes"

