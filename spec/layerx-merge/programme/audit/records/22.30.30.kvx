[finding.swap-quote-amount]
file = "apps/launchpad/web/src/widgets/swap/swap-panel.tsx"
line = 515
class = "runtime-risk"
severity = "high"
observed = "The quote at lines 425-431 uses debouncedParsedAmountIn, while executeSwap sends parsedAmountIn with minAmountOut from that quote. During the 250 ms debounce, changing an already quoted input from 1 to 10 leaves Swap enabled and applies the smaller input quote protection to the larger trade. core/network/contracts.ts forwards both amounts unchanged to swapTokenForToken."
expected = "A user-approved swap must bind its input tokens, exact raw input amount, minimum output and price-impact disclosure to the same successful quote. The router can only enforce the minAmountOut actually supplied by the client."
proposal = "In apps/launchpad/web/src/widgets/swap/swap-panel.tsx retain a quote identity containing chain, token pair and exact raw amount; invalidate execution immediately on an input change and require that identity to match at wallet invocation. Cover amount edits during debounce and high-impact confirmation with the real quote and transaction hooks."
owner_domain = 4
interface = "4.sol-router-swaptokenfortoken-8ef5184b"

[finding.reward-claim-route]
file = "apps/launchpad/web/src/widgets/rewards/rewards-view.tsx"
line = 30
class = "interface-mismatch"
severity = "high"
observed = "RewardsView.prepare posts to /v2/me/rewards/claim. pnlApiUrl joins this path to the PNL service origin without rewriting it. app.registerRewardRoutes instead mounts POST /v2/me/rewards:prepare-claim, and reward_routes_test.go explicitly requires the slash claim path to return 404. A claimable reward therefore never reaches PrepareClaim from this screen."
expected = "Frozen IF_REWARD_CLAIM and the served registry row require POST /v2/me/rewards:prepare-claim with the frozen rewardIds and recipient request, authenticated owner and Idempotency-Key. The web consumer must reach this exact registered operation."
proposal = "Change the owning rewards-view.tsx consumer to use IF_REWARD_CLAIM through the generated operation client or its exact canonical path, preserving owner checks, request validation and idempotency. Add a web-to-registered-handler proof so a legacy slash path cannot replace the served operation."
owner_domain = 4
interface = "4.http-pnl-tracker-post-v2-me-rewards-prepare-claim-j29"

[finding.legacy-card-link]
file = "services/launchpad/pnl-tracker/internal/card/card.go"
line = 86
class = "interface-mismatch"
severity = "high"
observed = "Service.shareURL returns shareOrigin + /pnl/ + a seven-character base62 shortCode for POST /pnl/cards, which remains mounted by app.New. The current app/pnl/[cardId]/page.tsx reads that segment through readPublicShare; share-transport.ts accepts only UUID share IDs and reads /v3/portfolio/shares/{id}. Every newly issued legacy short-code share URL is rejected before a request reaches its legacy card producer."
expected = "A share URL returned by a mounted card producer must identify an object the public landing page can resolve and render under the same publication lifecycle. Legacy card IDs and short codes are not v3 publication UUIDs."
proposal = "Reconcile services/launchpad/pnl-tracker/internal/card/card.go and the public web landing path: explicitly retire legacy minting in favor of owner-approved v3 publications, or supply a reviewed legacy resolver and landing contract for authentic existing cards. Prove that a URL emitted by the live mint handler loads its exact persisted disclosure, including expiry and revocation policy."
owner_domain = 4
interface = "4.http-pnl-tracker-post-pnl-cards"

[finding.reward-claim-recovery]
file = "apps/launchpad/web/src/widgets/rewards/rewards-view.tsx"
line = 27
class = "restart-recovery"
severity = "medium"
observed = "Prepared claim identity and the broadcast transaction hash exist only in component useState. A reload or unmount discards both. reconcile at line 33 requires current.prepared, so even a user who knows the transaction hash cannot use Check transaction after reopening the page; pending and uncertain action blocking also disappears."
expected = "A wallet-invoked claim must remain recoverable after navigation or browser restart, with its exact chain, owner, target, calldata and transaction identity checked before a final result or another attempt is offered."
proposal = "In the rewards widget persist an account-scoped recovery record before invoking the wallet, append the returned hash, and restore it only after revalidating the current account and deployment authority. Offer explicit hash reconciliation for an unknown broadcast outcome; verify transaction and committed receipt against the saved request and never automatically rebroadcast."
owner_domain = 4

[finding.metadata-browser-selectors]
file = "apps/launchpad/web/src/features/metadata-media/measure.browser.mjs"
line = 75
class = "test-gap"
severity = "medium"
observed = "The browser measurement waits for region Creator image and button Upload or retry, then Approved at revision and Active revision text. editor.tsx renders Coin image, Upload and Image updated. The viewer selectors at lines 133-150 likewise expect Token metadata, Creator approved token image and outage text that viewer.tsx does not render. The real journey cannot reach its declared assertions."
expected = "Metadata qualification must exercise the actual editor and viewer while proving retry operation identity, cancellation, committed approval, accessible labels and trading availability during an outage. Assertions must describe the real producer UI."
proposal = "Update apps/launchpad/web/src/features/metadata-media/measure.browser.mjs to the current accessible labels and capture approval/revision identity from the actual committed operation and viewer response. Preserve every retry, cancellation, identity, accessibility and outage assertion rather than dropping checks when presentation wording changes."
owner_domain = 4

[finding.generator-machine-path]
file = "sdk/launchpad/protocol/generator-inputs/test_export.py"
line = 97
class = "test-gap"
severity = "medium"
observed = "test_signature_hashes_are_verified_against_real_current_artifacts hardcodes /root/mk-falcon/contracts while neighboring tests use repository-derived CONTRACTS_ROOT. On a normal checkout its m.export calls cannot reach the current artifacts and fail for a missing machine-specific directory before the expected signature validation."
expected = "The protocol generator must verify real current contract artifacts in this repository and remain independent of a previous workstation path, as required by the hermetic real-artifact checks of requirement 4534."
proposal = "In sdk/launchpad/protocol/generator-inputs/test_export.py use the same repository-derived CONTRACTS_ROOT as the neighboring real-artifact tests. Retain the malformed topic, selector and duplicate-contract assertions against authentic current compiler artifacts; do not substitute synthetic ABI data."
owner_domain = 4

[finding.chart-controller-timeout]
file = "tools/launchpad/production/charts-engine/phase4.py"
line = 83
class = "runtime-risk"
severity = "medium"
observed = "validate_binding calls type(command[timeoutSeconds], plan[maximumCommandLogBytes]) with two arguments. Python type accepts one argument or three arguments, so every otherwise valid release controller entry raises TypeError before its bounded timeout can be validated."
expected = "The declared chart phase4 release command must validate authentic controller plans and proceed to the workload, replica-loss and checkpoint-replay measurements while enforcing the integer timeout range of 1 through 86400 seconds."
proposal = "In tools/launchpad/production/charts-engine/phase4.py validate type(command[timeoutSeconds]) with the existing strict integer and range conditions. Add a controller-plan regression that reaches execution with a valid real binding and continues to reject booleans, zero and out-of-range timeouts."
owner_domain = 4
interface = "4.cfg-lp-tools-production-charts-engine-phase4-release"

[finding.chart-controller-log-budget]
file = "tools/launchpad/production/charts-engine/phase4.py"
line = 242
class = "wiring-gap"
severity = "medium"
observed = "The release controller coroutine calls run_command with argv, environment, output and timeout only, but run_command at line 93 requires a fifth maximum_bytes argument. Once plan validation is repaired, every release controller still raises a missing-argument TypeError instead of launching the actual experiment."
expected = "The workload, replica-loss and restore/replay controller processes must receive the same explicit bounded log budget as the measurement executable, so release qualification executes and preserves bounded private evidence."
proposal = "Pass plan[maximumCommandLogBytes] to each controller run_command call in charts-engine/phase4.py. Prove the real subprocess path honors both timeout and log limits for controllers as it does for the measurement process; retain source, executable and input digest checks."
owner_domain = 4
interface = "4.cli-lp-tools-production-charts-engine-phase4"

