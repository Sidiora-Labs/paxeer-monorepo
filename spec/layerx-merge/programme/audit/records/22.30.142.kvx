[finding.56]
file = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/optimism/withdrawal_event.ex"
line = 335
class = "runtime-risk"
severity = "medium"
observed = "Super Root prove input parses its address word by repeatedly trimming a 24-zero prefix and then String.pad_leading(42, 0x). A valid address whose leading 12 bytes are zero loses actual address bytes too and gains repeated 0x text rather than zero padding. This is an optional Optimism withdrawal proof path."
expected = "An ABI address word must decode to exactly its final 20 bytes with one 0x prefix regardless of leading zeros in the address."
proposal = "In optimism/withdrawal_event.ex decode the ABI address as fixed-width bytes instead of trimming textual prefixes; exercise ordinary and leading-zero addresses through real Super Root prove calldata."
owner_domain = 14

[finding.57]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/v2/address_controller.ex"
line = 1554
class = "interface-mismatch"
severity = "high"
observed = "The address detail and its address-owned lists path accepts OpenAPI base_params with key, uses CastAndValidate and atom-keyed action parameters, then forwards that map to AccessHelper.restricted_access?. Explorer.AccessHelper recognizes the authorization override only via Map.has_key?(params, \"key\") and params[\"key\"], so a valid query key becomes :key and is ignored."
expected = "A correctly authorized request to a restricted resource must round-trip the declared key query parameter through casting into the policy check; requests with an absent or wrong key must remain forbidden."
proposal = "In Explorer.AccessHelper and the V2 controller boundary normalize the declared key parameter without changing the restriction policy, while preserving legacy string-keyed callers. Add routed correct-key, wrong-key and absent-key cases for address detail and its address-owned lists through real OpenAPI casting."
owner_domain = 14
interface = "14.http-get-api-v2-addresses-address-hash-param"

