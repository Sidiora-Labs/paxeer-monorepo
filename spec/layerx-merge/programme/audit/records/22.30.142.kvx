files_reviewed = 149
findings = 61
docs_reviewed = 14
upgrade_ready = false
blocking = ["32", "57", "58", "59", "60", "61"]
review_basis = "Full source review of all 149 members; package requirements, 41 produced and 235 consumed registry rows, route wiring, gateway/native receipt encodings, persistence/recovery and listed documentation. Optional Optimism defects are identified by profile and do not assert that Paxeer uses an external sequencer."
native_contracts = "Native receipt keys {keys:[...]}, signedHeader normalization, validator entries, decimal heights and MsgSequenceBatch binary fields agree across gateway, verifier and status/signature callers. Archive receipt_id schema maps its query name to id; frozen data is intentional."
severity_basis = "High findings identify the public verified-contract cursor round-trip and the documented restricted-resource key failing across OpenAPI casting in five endpoint families. Optional Optimism profile failures, invalid-input handling, policy omissions and stale guidance are medium; the unmounted component controller is low."

