[finding.1]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/account/auth_controller.ex"
line = 69
class = "runtime-risk"
severity = "medium"
observed = "authenticate! returns current_user(conn) or redirect(conn, to: root()); its unauthenticated branch is a Plug.Conn, not a user, and neither halts callers nor propagates the updated connection. AccountRouter checks feature enablement but does not authenticate these legacy actions."
expected = "An unauthenticated or expired account session must end with a usable login redirect before any user-owned query, mutation or rendering continues."
proposal = "In controllers/account/auth_controller.ex, introduce a connection authentication plug that assigns the verified user and halts after redirect on denial; migrate all legacy account actions and add expired-session route tests."
owner_domain = 14

[finding.2]
file = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/account/api_key_controller.ex"
line = 33
class = "runtime-risk"
severity = "medium"
observed = "API-key listing/editing/mutations uses the result of authenticate! as a user and later dereferences id; with an expired or missing session that value is a redirect Plug.Conn, so the mounted request raises instead of finishing the redirect."
expected = "Every account action must stop on authentication denial and perform user-scoped work only with a verified account identity."
proposal = "Update services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/account/api_key_controller.ex to use the halted authentication plug and its assigned identity; exercise missing and expired sessions on both reads and mutations without entering the account model."
owner_domain = 14

