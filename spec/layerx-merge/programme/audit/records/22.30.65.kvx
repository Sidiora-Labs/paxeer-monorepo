[finding.program-event-semantics]
file = "precompiles/xweb/xweb.go"
line = 428
class = "interface-mismatch"
severity = "high"
observed = "RequestFromProgram emits XWebProgramRequested(programId, requestId, OriginProgram=2, input, 0). The served Rust decoder in services/interop/crates/x-websearch/src/watch.rs:321-386 reads the same ABI words as kind, payload and sequence. Every fetch (kind=1) becomes a search (kind=2), and a nonzero call sequence becomes zero. ProgramRequest::attestation in src/program.rs:126-143 signs the decoded kind; modules/xweb/keeper/program_fulfil.go:140 refuses a different kind with LXP_CONTEXT_MISMATCH. The paid fetch therefore cannot complete through the real watcher path."
expected = "A program web request must retain its program id, request id, fetch/search kind, payload and call sequence from the committed keeper record through the EVM log, durable watcher journal, observation and fulfilProgram acceptance. ABI type equality alone must not permit a semantic reinterpretation."
proposal = "Domain 6 must agree one program-request log contract with domain 11 and publish the actual request kind and call sequence, or provide a committed-record lookup that resolves those fields before any work or signing. Update precompiles/xweb, the Solidity consumers, the interface registry and services/interop/crates/x-websearch together. Prove real Go-emitted fetch and search logs with nonzero sequence survive Rust decoding, restart, signing and fulfilProgram without changing meaning."
owner_domain = 6
interface = "11.rs-xws-decode-program-requested"
related_interfaces = ["6.go-xweb-keeper-requestfromprogram-j37"]
related_files = ["precompiles/xweb/abi.json", "precompiles/xweb/XWeb.sol", "services/interop/crates/x-websearch/src/watch.rs", "services/interop/crates/x-websearch/src/program.rs", "modules/xweb/keeper/program_fulfil.go"]

[finding.program-evm-journal-collision]
file = "precompiles/xweb/xweb.go"
line = 424
class = "interface-mismatch"
severity = "high"
observed = "Every program request also emits XWebRequested with its program-local id, principal address, zero callback gas, zero timeout and wei(request.Amount), although its fee may be USDL rather than PAX. The Rust watcher accepts both topics in one poll (watch.rs:917-986), and stores XWebRequested in the origin-one pending map keyed only by u64 request_id. Two programs sharing an id, or an EVM request sharing it, produce conflicting entries. The watcher returns Malformed at :966-970 before storing the next cursor at :988-994, so replay encounters the same block again. A noncolliding program log instead enters the EVM work queue for a request that the origin-one keeper never recorded."
expected = "Origin-one work must identify an EVM request with the origin-one fee and timeout semantics; program work must retain its program namespace and recorded fee asset. Valid requests in distinct namespaces must coexist, advance the watcher cursor and resume after restart without poisoning each other."
proposal = "Domain 6 and domain 11 must remove the ambiguous cross-origin log contract. Prefer publishing program work only through its program-specific event while retaining XWebRequested for EVM requests. If compatibility requires both logs, give the consumer an explicit origin discriminator and a durable composite identity before queueing or deduplication. Verify an EVM request and two programs using the same numeric id in one block, repeated delivery and restart, with each fulfilled once in its own fee denomination."
owner_domain = 6
interface = "6.pc-0x1019-evt-xwebrequested"
related_files = ["services/interop/crates/x-websearch/src/watch.rs", "modules/xweb/keeper/program.go"]

[finding.solidity-program-event-fields]
file = "precompiles/xweb/XWeb.sol"
line = 82
class = "interface-mismatch"
severity = "medium"
observed = "The local IXWeb declaration calls the program event fields method, payload and deadline, whereas abi.json:15 declares origin, input and deadline. RequestFromProgram supplies the origin constant, not the requested method. Solidity-generated bindings and JSON-ABI-generated bindings therefore assign different names and meanings to the same topic and data. contracts/src/precompiles/IXWeb.sol carries the same Solidity declaration."
expected = "Consumers of the program event must receive identical field names and meanings regardless of which published IXWeb or ABI they use; the fetch/search discriminator must be distinguishable from the program origin."
proposal = "As part of the program-event repair, domain 6 must publish one canonical named schema in precompiles/xweb/XWeb.sol, contracts/src/precompiles/IXWeb.sol and abi.json, and domain 11 must consume that schema. Include field names, enum meaning and lifecycle values in the compatibility proof, while keeping any required historical decoder explicitly versioned."
owner_domain = 6
interface = "11.rs-xws-decode-program-requested"

[finding.abi-program-event-context]
file = "precompiles/xweb/abi.json"
line = 15
class = "interface-mismatch"
severity = "medium"
observed = "XWebProgramRequested declares origin/input/deadline and has no request-kind or call-sequence field. That is the producer schema behind the blocking program-event-semantics finding, while the served registered decoder expects kind/payload/sequence. The event topic is identical because these different meanings use the same uint8, bytes and uint64 types."
expected = "The published JSON ABI must describe all context that the served program watcher requires, with field meanings that match the persisted request and the Solidity interface."
proposal = "Domain 6 must reconcile abi.json with the agreed program-request event and record its named fields and enum semantics in spec/layerx-merge/interfaces.kvx. Coordinate the consumer migration in domain 11 so an old journal or decoder cannot silently interpret a new event with the same topic under different meanings."
owner_domain = 6
interface = "11.rs-xws-decode-program-requested"

[finding.program-event-test-third-shape]
file = "precompiles/xweb/program_requested_event_test.go"
line = 79
class = "test-gap"
severity = "medium"
observed = "TestProgramRequestEmitsXWebProgramRequested constructs a fetch request with call.Sequence=23 at :46-53 but expects OriginProgram and zero at :79, and requires the extra XWebRequested at :81-90. It proves the Go producer shape in isolation and freezes both blocking disagreements rather than exercising the Rust watcher and fulfilment path."
expected = "A program-event regression must demonstrate that the actual producer bytes preserve fetch/search and sequence through the deployed decoder, signing and fulfilment, and that origin namespaces cannot collide across delivery or restart."
proposal = "Domain 6 must replace the isolated semantic assumptions with a shared real-log compatibility case coordinated with domain 11. Keep checks for topics, static-call refusal and rollback, and add fetch/search with nonzero sequences, same numeric ids across programs and EVM, replay and restart through the actual watcher and fulfilProgram acceptance."
owner_domain = 6

[finding.event-parity-ignores-names]
file = "precompiles/xweb/xweb_test.go"
line = 1036
class = "test-gap"
severity = "medium"
observed = "The Solidity event parity check takes only strings.Fields(field)[0] from each parameter and compares the resulting type-only signature and indexed flags. It accepts method/payload in XWeb.sol alongside origin/input in abi.json, so the test named as parity permits the published binding-name disagreement."
expected = "Compatibility checks for an event consumed by named bindings must compare names and meanings as well as topic hashes, types and indexed positions."
proposal = "Domain 6 must extend the existing event compatibility coverage to compare the complete named parameter schema of both Solidity interfaces and the JSON ABI, and prove the agreed fetch/search and call-sequence values using emitted logs passed to the domain-11 decoder."
owner_domain = 6

[finding.pointer-untrusted-metadata]
file = "precompiles/pointer/pointer.go"
line = 154
class = "runtime-risk"
severity = "medium"
observed = "AddCW20 directly asserts formattedRes[\"name\"].(string) and [\"symbol\"].(string) after decoding arbitrary contract JSON. AddCW721 repeats it at :186-187 and AddCW1155 at :218-219. QuerySmartSafe can return valid JSON with missing, null, numeric or object-valued metadata; json.Unmarshal then succeeds and these assertions panic instead of returning a controlled pointer-registration refusal."
expected = "A contract that does not implement the expected token metadata must be refused as invalid metadata without allowing its JSON shape to trigger a Go type-assertion panic in the EVM precompile."
proposal = "Domain 6 must validate required metadata presence, string types and permitted sizes before pointer deployment in precompiles/pointer/pointer.go, returning a documented invalid-metadata error. Exercise real smart-query responses with absent and wrongly typed fields for CW20, CW721 and CW1155 and confirm no pointer state is committed."
owner_domain = 6

[finding.pointer-payability-contract]
file = "precompiles/pointer/abi.json"
line = 1
class = "interface-mismatch"
severity = "medium"
observed = "All four current pointer ABI methods are declared payable, and registry rows 6.pc-0x100b-addcw1155pointer, addcw20pointer, addcw721pointer and addnativepointer repeat that promise. Every corresponding Go handler calls ValidateNonPayable, while Pointer.sol declares nonpayable functions. A client generated from the JSON ABI can offer value-bearing registration that the real handler refuses."
expected = "The current pointer ABI, registry, Solidity bindings and execution path must agree that pointer creation accepts zero native value, or consistently define a deliberate payable product contract."
proposal = "Domain 6 must settle and publish the zero-value registration contract consistently in the current ABI, Solidity and registry without rewriting historical snapshots used for replay. Cover value-bearing calls through the real EVM path as explicit refusals and zero-value calls as successful pointer registration."
owner_domain = 6
interface = "6.pc-0x100b-addcw20pointer"
related_interfaces = ["6.pc-0x100b-addcw1155pointer", "6.pc-0x100b-addcw721pointer", "6.pc-0x100b-addnativepointer"]

[finding.pointer-freeze-misses-mutability]
file = "precompiles/pointer/abi_freeze_test.go"
line = 28
class = "test-gap"
severity = "medium"
observed = "TestPointerABIFrozen compares embedded ABI to itself and pins method signatures/selectors and event count. It never compares Solidity state mutability or a value-bearing call to the handler, so the payable JSON ABI and nonpayable implementation pass its asserted contract."
expected = "A frozen pointer interface must include its value-acceptance semantics and agree with the actual EVM registration path and Solidity consumers."
proposal = "Domain 6 must retain selector and event checks and add current ABI/Solidity mutability agreement plus real zero-value success and nonzero-value refusal for the four pointer methods. Keep historical ABI expectations separately tied to their replay versions."
owner_domain = 6

[finding.solo-nft-pagination-progress]
file = "precompiles/solo/solo.go"
line = 203
class = "runtime-risk"
severity = "medium"
observed = "The CW721 claim-all path repeatedly queries tokens, appends each nonempty page to allTokens and advances startAfter to the last returned id, without checking cursor progress or duplicates and without a page or accumulated-token bound. A valid JSON contract that repeats a nonempty page makes the claim consume transaction gas and grow the temporary list until failure before any NFT transfer. Gas metering limits execution, but does not provide a useful bounded claim refusal."
expected = "Claim-all must either enumerate a finite, advancing set within an explicit transaction bound or refuse malformed pagination predictably so a contract response cannot trap the entire asset claim in repeated work."
proposal = "Domain 6 must define a bounded CW721 claim enumeration policy in precompiles/solo/solo.go, reject repeated/nonadvancing cursors and duplicate token ids, and retain the specific-token route for larger sets. Exercise a real contract returning a repeated page and verify deterministic refusal and atomic preservation of all claimed assets."
owner_domain = 6

[finding.anchor-module-description]
file = "modules/layerxanchor/module.go"
line = 1
class = "doc-drift"
severity = "low"
observed = "The package header still describes layerxanchor as the checkpoint registry and finality authority exposed by the precompile, without saying that checkpoint mutation and reads are retired after the merge. The retained implementation now enforces retirement and supports archival state and bounded bond return."
expected = "Source documentation must distinguish historical anchor state and retirement handling from the merged network finality supplied by committed paxd blocks."
proposal = "Domain 6 must rewrite the package header to identify the retained archival/retirement role, point to refusal and bond-return behavior, and state that the module is no longer the network finality authority."
owner_domain = 6

[finding.anchor-solidity-finality-description]
file = "precompiles/layerxanchor/LayerXAnchor.sol"
line = 8
class = "doc-drift"
severity = "medium"
observed = "The public ILayerXAnchor NatSpec says anyone may submit certificates and defines finality by guarantor threshold and challenge-window expiry. It provides no retirement warning even though the current wrapper refuses the historical checkpoint surface after the merge."
expected = "An integrator reading the retained Solidity interface must know it is historical compatibility material and that committed network blocks determine receipt finality in the merged network."
proposal = "Domain 6 must label the retained interface and affected selectors as historical and refused after merge, describe any permitted retirement operations separately, and direct new integrations to the merged node receipt/finality contract without presenting checkpoint submission as a current workflow."
owner_domain = 6

[finding.custody-proto-anchor-future]
file = "api/layerxcustody/params.proto"
line = 36
class = "doc-drift"
severity = "low"
observed = "The sequencer_authorizations field comment says it backs AnchorReader until the anchor module lands. The anchor module has long existed and its finality role is now retired; this is a preserved legacy custody schema rather than a future activation path."
expected = "The retained protobuf field must be documented as historical state with its compatibility purpose, without implying that a new anchor module will make the sequencer settlement flow active."
proposal = "Domain 6 must update this schema comment to explain historical import/replay retention and the retired settlement lifecycle while preserving field numbers and wire compatibility."
owner_domain = 6

[finding.readme-separated-network]
file = "README.md"
line = 44
class = "doc-drift"
severity = "medium"
observed = "Lines 44-47 describe a separate layerxd C17 daemon whose checkpoints settle through layerxAnchor; :56 routes users to a local kernel cluster, :79 calls the merge a proposed draft, and :83 lists retired 0x1012/0x1013/0x1014 endpoints as normal native modules. This describes the pre-merge architecture as current."
expected = "The public introduction must describe one paxd BFT network with its kernel integrated, committed-block receipt finality, root-path node JSON-RPC and explicitly retired historical checkpoint/custody surfaces."
proposal = "Domain 17 must rewrite the architecture and onboarding passages at README.md:44-56 and :79-83 for the merged network, publish the current served/retired precompile distinction and remove separate-daemon and checkpoint-settlement instructions."
owner_domain = 17

[finding.network-guide-settlement-faucet]
file = "docs/paxeer-network.md"
line = 3
class = "doc-drift"
severity = "medium"
observed = "Lines 3-20 describe Paxeer as a custody/settlement layer beside LayerX, periodic checkpoints, an independent sequencer and 402LXP as sole balance writer. Line 9 advertises a public faucet, contrary to the mainnet real-value and allocated-funding guidance in README.md:59. Lines 15 and 38 also present old top-level service paths and settlement modules as current architecture."
expected = "Network guidance must describe the integrated paxd network, committed-block finality, current service locations and current funding access; historical custody and checkpoint modules must not be offered as the active settlement path."
proposal = "Domain 17 must rewrite docs/paxeer-network.md:3-20 and the layout/funding sections to reflect the merged network, distinguish historical modules from served interfaces, and align funding instructions with approved allocations rather than a general public faucet."
owner_domain = 17

[finding.catalog-retired-surfaces]
