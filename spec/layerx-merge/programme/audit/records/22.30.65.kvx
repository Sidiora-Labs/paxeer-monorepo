line = 32
class = "doc-drift"
severity = "medium"
observed = "The generated ABI catalog lists layerxanchor, layerxcustody and layerxverify as ordinary fixed endpoints in the summary (:32, :36, :41), then lists checkpoint submission, custody deposits/withdrawals and evidence verification at :1170-1217, :1285-1324, :1552-1564 and the Solidity catalog :2430-2506 without activation or retirement status. An ABI inventory alone does not tell a new caller these historical operations are refused after merge."
expected = "A public current precompile catalog must distinguish served operations, historical ABI retention and post-merge refusals so operators and contract authors do not build workflows around retired settlement and finality endpoints."
proposal = "Domain 17 must update tools/docs/gen-system-docs.sh to consume the endpoint lifecycle/retirement information maintained with domain 6 and regenerate docs/system/precompiles.md with clear current-versus-historical status for the retired surfaces, preserving historical selectors for reference."
owner_domain = 17

[finding.catalog-missing-merged-addresses]
