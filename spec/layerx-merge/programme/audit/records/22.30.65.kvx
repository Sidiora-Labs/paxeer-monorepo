registration = "Compared precompiles/setup.go and generated dispatch with current constructors and live node application registration. Plan activation and reserved addresses retain the declared v7.0 boundary; legacy types and selectors remain replay artifacts."
anchor = "Compared protobuf/type encodings, keeper genesis/retirement state, fail-closed wrappers, proof and merge tests, and bounded bond-return migration. Current refusal semantics supersede historical finality prose; source/documentation findings name that drift."
pointers = "Compared creation and lookup method signatures, fixed addresses, version/exists tuples, query response metadata and wrapper deployments. Nonpayable runtime versus payable advertised ABI, unchecked metadata and incomplete freeze coverage are findings."
solo = "Compared claim message encoding, signer/caller binding, chain/account sequence, gas accounting and native/CW20/CW721 transport. Claim-all pagination has an explicit runtime finding; finite transfers and replay authentication retain their declared contract."
web = "Compared canonical origin-one request/result ABI, errors, fees, callbacks, gas/activation, program record and fulfilment paths with actual EVM log decoder, durable Rust pending/cursor state, attestation and observation transport. Two blocking findings describe program-event semantics and cross-origin journal identity."
programs = "Compared the member view-height proof and registration/parity coverage with declared host ABI and committed-view behavior. The broad programme interface rows are context for this slice; they do not enlarge the allowed edit scope."
wasm = "Compared standalone WasmApp initialization, codec/ante/module wiring and genesis/export/support fixture types with consumed SDK/consensus interfaces. Deliberate test application names are not treated as a retired layerxd runtime."
security = "Reviewed static/delegatecall/payability guards, caller/signer checks, size/gas/fee boundaries and fail-closed retirement behavior on exposed paths. No bypass or data-loss claim is inferred from tests that were only read."
recovery = "Reviewed retained genesis/migration and bond-return state and real watcher journal/cursor ordering. The high collision finding includes repeated delivery and restart consequences; no live restart rehearsal was run during this record-only task."
