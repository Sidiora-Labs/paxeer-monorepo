[finding.1]
file = "services/launchpad/api/internal/rest/rest.go"
line = 40
severity = "high"
observed = "RegisterV2SearchProxy.ErrorHandler emits only code, message and retryable. TimeoutHandler at line 43 emits plain text. The required Error fields requestId, retryAfterMs, fieldErrors and details are absent; sdk/launchpad/packages/sdk/src/transport.ts:136 cannot decode these responses and loses the typed error metadata."
expected = "GET /v2/search must round-trip failure responses through the frozen Error decoder, with request identity, schema version and retry metadata matching other v2 routes and requirement 4259.1."
proposal = "In services/launchpad/api/internal/rest/rest.go, route transport and timeout failures through WriteV2APIError; drive unavailable and slow actual upstreams through HTTP and the generated SDK decoder and assert the complete Error envelope."
owner_domain = 4
class = "interface-mismatch"
interface = "4.http-api-get-v2-search-rest"

[finding.2]
file = "services/launchpad/api/internal/rest/dev_stream.go"
line = 427
severity = "high"
observed = "DevelopmentStream.complete skips a swap when BatchElem.Error is nonnil or the receipt is nil. projectTrades passes the last input swap to appendTrades, which commits projector_cursor beyond that skipped swap at line 665. Subsequent queries use a strictly greater position, so a transient per-item RPC failure permanently removes the trade from the stream, including after restart."
expected = "Every committed indexed swap must reach the stream once or remain durably recoverable. An individual temporary receipt failure cannot establish permanent invalidity or advance recovery beyond unresolved data."
proposal = "In services/launchpad/api/internal/rest/dev_stream.go, stop cursor advancement at unresolved receipts or persist an ordered retry/quarantine ledger in the same transaction. Exercise per-item RPC failure, recovery and projector restart and assert the trade arrives exactly once."
owner_domain = 4
class = "restart-recovery"

[finding.3]
file = "services/launchpad/metadata/internal/metadata/legacy_reads.go"
line = 178
severity = "high"
observed = "ProductionLegacyReads.build and logo use read-only snapshots and Store.readV2 moderation from local documents only; neither calls ConnectedMedia.syncModeration. Maintenance refreshes pending assets rather than quiet approved tokens, so removal at the visibility authority can leave creator metadata and logo bytes publicly readable indefinitely without a connected request for that pool."
expected = "Legacy public metadata and logo reads must honor the same current visibility authority as connected media reads, including revocation for already approved content and after restart; canonical token identity may remain while creator content is withheld."
proposal = "In services/launchpad/metadata/internal/metadata/legacy_reads.go and internal/app/app.go, refresh authority state before serving creator content or durably deliver revocations for every published pool. Define cache invalidation and prove removal reaches legacy single, batch and logo routes without connected reads."
owner_domain = 4
class = "security"
interface = "4.http-metadata-get-metadata-token-address-legacy-reads"

[finding.4]
file = "services/launchpad/metadata/internal/app/app.go"
line = 930
severity = "medium"
observed = "scanPendingMedia selects the earliest ten pending assets and returns at the first error. Integrity and decode failures at lines 877-882 do not reject or defer the row. runMediaMaintenance then returns before account maintenance, publication and retention, allowing one permanently corrupt oldest object to repeatedly block healthy work."
expected = "Terminally invalid media must be durably rejected and temporary failures must have bounded backoff. A single pending asset must not starve unrelated uploads, accepted creator publications or expiry work."
proposal = "In services/launchpad/metadata/internal/app/app.go, persist terminal rejection and per-item retry times and schedule independent bounded work classes. Prove a corrupt oldest object cannot block a valid upload, account maintenance or an accepted publication."
owner_domain = 4
class = "runtime-risk"

[finding.5]
file = "services/launchpad/metadata/internal/metadata/dev_connected.go"
line = 147
severity = "medium"
observed = "persistToken ignores marshal and insert errors and calls Exec with context.WithoutCancel without a fresh deadline. chainToken still caches and returns success. After a write outage, cache eviction or restart can lose the only decoded identity once the development RPC prunes its creation receipt."
expected = "Canonical identity retained for a pruned RPC must survive restart and persistence must be bounded and observable; process memory cannot silently substitute for failed durable retention."
proposal = "In services/launchpad/metadata/internal/metadata/dev_connected.go, bound persistence, return write failures and require durable retention or a durable retry before reporting reusable success. Prove recovery after a failed insert followed by process restart and receipt pruning."
owner_domain = 4
class = "restart-recovery"

[finding.6]
file = "services/launchpad/metadata/internal/app/development_connected.go"
line = 112
severity = "medium"
observed = "Development wiring defaults quarantine and approved storage to S3_BUCKET and warns when they coincide. DevelopmentObjectsReadiness performs only authenticated HeadBucket calls. A bucket permitting anonymous object reads can pass readiness and expose quarantine originals directly despite the media router exposing only approved keys."
expected = "Quarantine originals must remain inaccessible to anonymous callers in every publicly reachable profile. Authenticated bucket access and an application route allowlist do not prove object-store privacy."
proposal = "In services/launchpad/metadata/internal/app/development_connected.go and metadata/dev_connected.go, require private quarantine storage or verified equivalent key policy and probe anonymous denial separately from the router. Test refusal against a real anonymously readable quarantine bucket."
owner_domain = 4
class = "security"
interface = "4.env-metadata-s3-quarantine-bucket"

[finding.7]
file = "services/launchpad/api/internal/rest/compatibility.go"
line = 247
severity = "medium"
observed = "rankingsRequest accepts any nonempty cursor, but projectionRankings and writeRankingsProjection never consume it and always return the first bounded snapshot with nextCursor null. The development handler rejects nonempty cursors instead, making identical requests behave differently across profiles."
expected = "A supplied cursor must select a real continuation or receive a stable invalid-cursor response; replacement snapshots cannot silently accept a cursor while returning the initial result again."
proposal = "In services/launchpad/api/internal/rest/compatibility.go, reject nonempty cursors consistently with the development handler unless real snapshot continuation is implemented. Assert the same invalid-cursor HTTP result in both profiles."
owner_domain = 4
class = "runtime-risk"
interface = "4.http-api-get-v2-rankings-category-compatibility"

[finding.8]
file = "services/launchpad/metadata/internal/image/inprocess.go"
line = 26
severity = "medium"
observed = "InProcessWorker.Decode advertises the same five-second wall deadline as ProcessWorker, but ReencodeSupported invokes image.Decode and png.Encode synchronously without cancellation. Context checks before decode and during resize cannot interrupt either codec phase, which can exceed the deadline in the serving process."
expected = "The advertised processing deadline must bound the entire codec operation, or admission must accurately expose and constrain the weaker development execution model so slow input cannot occupy a request without that bound."
proposal = "In services/launchpad/metadata/internal/image/inprocess.go and internal/app/development_connected.go, use a killable bounded worker suitable for the deployment or enforceably cancellable codec execution and admission. Prove slow decoding and encoding cannot exceed the advertised wall bound."
owner_domain = 4
class = "runtime-risk"

