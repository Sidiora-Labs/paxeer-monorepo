requirements_review = ["22108.1: dependency declarations/provenance reviewed; advisory/frozen-install qualification is outside the audit-only gate.", "14991.1 and 22998.1: source compatibility reviewed; no frontend typecheck, failed-target repair or product build is claimed by record validation.", "14243.1/2, 14280.1, 14288.1, 18955.1: capabilities, three native rungs/identities and asset/total balances agree; historical archive names remain frozen evidence.", "14282.1: archive controller/route reviewed; archive-receipt-nullability records kernel-origin type drift.", "14294.1, 14295.1/2, 14296.1: signature resource/types and row wiring agree; two tests lack the real canonical receipt/controller producer path.", "18875.1: tuned feed migration includes invalid-index recovery, constraint validation and pinned lock timeout; older BRIN/hot-table findings are separate.", "18770.1/2 and 181173.1: new accepted/status filters and boolean transport agree; historical-price-acceptance blocks upgrade of an existing database.", "18701.1 and 18896.1: bounded native rungs and explicit block-local index support status presentation and deterministic same-block ordering."]
interface_review = ["10.rs-intents-lib-compiler-l19-j46: Solidity metadata compiler field is not a Rust layerx-intents import/call. See registry-spurious-intents-edge.", "14.cfg-explorer-celo: runtime.exs parses optional integer l2_migration_block; both Celo migrations read the exact key and guard nil. Optional upstream chain behavior does not enable Celo on chain 125.", "14.cfg-fe-chain-currency: chain.ts reads the declared NEXT_PUBLIC names; TxInfo/fee/testnet consumers use the same currency units/id/boolean. Chain 125 and 18 native decimals agree.", "14.cfg-fe-feature-apidocs: Compared feature/navigation declaration with transaction caller: API docs tabs/visibility, cross/external links, metasuites and navigation use the same names and optional flags.", "14.cfg-fe-feature-crosschaintxs: Compared feature/navigation declaration with transaction caller: API docs tabs/visibility, cross/external links, metasuites and navigation use the same names and optional flags.", "14.cfg-fe-feature-externaltxs: Compared feature/navigation declaration with transaction caller: API docs tabs/visibility, cross/external links, metasuites and navigation use the same names and optional flags.", "14.cfg-fe-feature-metasuites: Compared feature/navigation declaration with transaction caller: API docs tabs/visibility, cross/external links, metasuites and navigation use the same names and optional flags.", "14.cfg-fe-feature-txinterpretation: txInterpretation.ts exports isEnabled/provider; interpretation component gates requests and renders loading/error using those exact keys.", "14.cfg-fe-ui-navigation: Compared feature/navigation declaration with transaction caller: API docs tabs/visibility, cross/external links, metasuites and navigation use the same names and optional flags.", "14.cfg-fe-ui-views-tx: ui/views/tx.ts parses hidden/additional field arrays and groupedFees boolean; TxInfo and fee/action components consume matching field ids/grouping.", "14.env-fe-next-public-is-testnet: chain.ts reads the declared NEXT_PUBLIC names; TxInfo/fee/testnet consumers use the same currency units/id/boolean. Chain 125 and 18 native decimals agree.", "14.env-fe-next-public-network-currency-decimals: chain.ts reads the declared NEXT_PUBLIC names; TxInfo/fee/testnet consumers use the same currency units/id/boolean. Chain 125 and 18 native decimals agree.", "14.env-fe-next-public-network-currency-symbol: chain.ts reads the declared NEXT_PUBLIC names; TxInfo/fee/testnet consumers use the same currency units/id/boolean. Chain 125 and 18 native decimals agree.", "14.env-fe-next-public-network-id: chain.ts reads the declared NEXT_PUBLIC names; TxInfo/fee/testnet consumers use the same currency units/id/boolean. Chain 125 and 18 native decimals agree.", "14.env-fe-next-public-rollup-l2-withdrawal-url: Optional withdrawal URL is read in rollup.ts and used only inside enabled rollup UI; a disabled feature creates no endpoint.", "14.env-fe-next-public-transaction-interpretation-provider: txInterpretation.ts exports isEnabled/provider; interpretation component gates requests and renders loading/error using those exact keys.", "14.env-fe-next-public-views-address-native-token-address: ui/views/address.ts optional nativeTokenAddress has the same name/address encoding used by transaction token-transfer filtering.", "14.env-fe-next-public-views-tx-additional-fields: ui/views/tx.ts parses hidden/additional field arrays and groupedFees boolean; TxInfo and fee/action components consume matching field ids/grouping.", "14.env-fe-next-public-views-tx-grouped-fees: ui/views/tx.ts parses hidden/additional field arrays and groupedFees boolean; TxInfo and fee/action components consume matching field ids/grouping.", "14.env-fe-next-public-views-tx-hidden-fields: ui/views/tx.ts parses hidden/additional field arrays and groupedFees boolean; TxInfo and fee/action components consume matching field ids/grouping.", "14.met-verifier-smart-contract-verifier-verify-contract: contract.ts verify_contract is JSON data, not a Prometheus read. See registry-spurious-metric-edge.", "14.ws-explorer-channel-socket-v2-transactions: Actual /socket/v2 route and per-hash join exist and forward without conversion; raw-trace-roundtrip and pending-transaction-collation record data/lifecycle failures, including reconnect reconciliation.", "14.ws-explorer-join-socket-v2-transactions-transaction-hash: Actual /socket/v2 route and per-hash join exist and forward without conversion; raw-trace-roundtrip and pending-transaction-collation record data/lifecycle failures, including reconnect reconciliation.", "14.ws-explorer-push-transactions-hash-raw-trace: Actual /socket/v2 route and per-hash join exist and forward without conversion; raw-trace-roundtrip and pending-transaction-collation record data/lifecycle failures, including reconnect reconciliation.", "8.cfg-ai-evaluator-config-chain: No private hosted configuration reader in this slice; matching API/fixture field spelling is a false inventory edge. See registry-spurious-hosted-config-edges.", "8.cfg-ai-evaluator-config-gas-limit: No private hosted configuration reader in this slice; matching API/fixture field spelling is a false inventory edge. See registry-spurious-hosted-config-edges.", "8.cfg-authority-principalpolicy-identities: No private hosted configuration reader in this slice; matching API/fixture field spelling is a false inventory edge. See registry-spurious-hosted-config-edges.", "8.cfg-cli-keymetadata-did: No private hosted configuration reader in this slice; matching API/fixture field spelling is a false inventory edge. See registry-spurious-hosted-config-edges.", "8.cfg-feeder-chainflowconfig-base-url: No private hosted configuration reader in this slice; matching API/fixture field spelling is a false inventory edge. See registry-spurious-hosted-config-edges.", "8.cfg-feeder-config-gas-limit: No private hosted configuration reader in this slice; matching API/fixture field spelling is a false inventory edge. See