[finding.raw-trace-roundtrip]
file = "apps/explorer/ui/tx/TxRawTrace.tsx"
line = 39
class = "interface-mismatch"
severity = "high"
observed = "The frontend stores the entire raw_trace payload as RawTracesResponse. notifier.ex:258 calls the v2 TransactionView with internal_transactions although transaction_view.ex:122 requires raw_traces, then wraps its result in a raw_trace object. The v2 channel forwards unchanged: rendering fails before broadcast, and correcting only the assigns still leaves an object where the frontend expects an array."
expected = "Registry 14.ws-explorer-push-transactions-hash-raw-trace must transport one agreed trace shape from the actual trace producer through Phoenix to the raw-trace panel, including on-demand completion."
proposal = "In services/explorer/backend/apps/block_scout_web/lib/block_scout_web/notifier.ex obtain actual raw traces and use supported TransactionView assigns. Choose one envelope, align apps/explorer/lib/socket/types.ts and ui/tx/TxRawTrace.tsx, and test an on-demand trace through the real v2 channel."
owner_domain = 14
interface = "14.ws-explorer-push-transactions-hash-raw-trace"

[finding.pending-transaction-collation]
file = "apps/explorer/ui/tx/useTxQuery.tsx"
line = 83
class = "interface-mismatch"
severity = "high"
observed = "useTxQuery waits for collated on transactions:<hash> and normally disables interval refetch. notifier.ex:819 broadcasts collated only on transactions_old:<hash>; the v2 broadcaster emits global counters and address transaction lists. A connected pending detail page therefore has no event to refresh it after commitment."
expected = "Registry 14.ws-explorer-join-socket-v2-transactions-transaction-hash must let pending transactions reach their committed receipt without manual reload; rejoining must reconcile commits missed during disconnection."
proposal = "Publish collation on the v2 per-hash topic in services/explorer/backend/apps/block_scout_web/lib/block_scout_web/notifier.ex and reconcile REST state on rejoin in apps/explorer/ui/tx/useTxQuery.tsx. Test pending, committed, disconnect and reconnect along the producer-to-panel path."
owner_domain = 14
interface = "14.ws-explorer-join-socket-v2-transactions-transaction-hash"

[finding.historical-price-acceptance]
file = "services/explorer/backend/apps/explorer/priv/repo/migrations/20261028000000_add_paxeer_x_price_observation_accepted.exs"
line = 6
class = "restart-recovery"
severity = "high"
observed = "Adding accepted NOT NULL DEFAULT true labels every existing observation accepted. CosmosRest.decode_price_updates derives acceptance from pricefeed_observation_refused events even for code-zero transactions. PriceFeed latest/history queries trust accepted=true, while its persisted scanned watermark excludes old heights from catch-up; this migration schedules no replay."
expected = "Requirements 18770.1, 18770.2 and 181173.1 require market projections to contain only successful accepted observations, including data indexed before upgrade and after restart."
proposal = "Replace blanket historical acceptance with an unknown state excluded from market reads. Replay retained block results through Explorer.PaxeerX.CosmosRest with a durable backfill cursor independent of the scan watermark. Test a successful transaction with a refused market before upgrade and restart halfway through replay."
owner_domain = 14

[finding.archive-receipt-nullability]
file = "apps/explorer/types/api/paxeerXArchive.ts"
line = 26
class = "interface-mismatch"
severity = "medium"
observed = "The list type requires block_number:number and the detail requires transaction_hash:string and timestamp:string. ArchiveView emits null for all three on kernel receipts, as AddKernelReceiptProvenance requires; timestamp is also nullable when an EVM block is missing. The types omit origin, verification and provenance. Existing UI null guards limit immediate runtime impact."
expected = "The frozen archive contract must describe both EVM and kernel receipt shapes without casts that discard nullability or hide the provenance fields emitted by the producer."
proposal = "Define an origin-discriminated EVM/kernel union in apps/explorer/types/api/paxeerXArchive.ts with nullable timestamps and the emitted provenance/verification fields. Derive frontend contract cases from real ArchiveView output for both receipt origins."
owner_domain = 14
interface = "14.http-get-api-v2-paxeer-x-archive-receipts-id-j54"

[finding.brin-invalid-index-resume]
file = "services/explorer/backend/apps/explorer/priv/repo/migrations/20260301000100_internal_transactions_block_number_brin_index.exs"
line = 10
class = "restart-recovery"
severity = "medium"
observed = "This nontransactional migration uses CREATE INDEX CONCURRENTLY IF NOT EXISTS. A cancelled concurrent build can retain an invalid same-name index; retry skips creation and may mark the migration applied without a usable internal_transactions block-number BRIN index."
expected = "An interrupted index deployment must resume to a valid index before completion; the later TunePaxeerXPriceFeedTables migration already checks pg_index.indisvalid for that situation."
proposal = "Inspect pg_index for the table and index name in InternalTransactionsBlockNumberBrinIndex.up, drop an invalid index concurrently, rebuild and check validity. Add a recovery scenario starting with an invalid same-name index."
owner_domain = 14

[finding.hot-table-lock-budget]
file = "services/explorer/backend/apps/explorer/priv/repo/migrations/20260301000000_hot_tables_storage_parameters.exs"
line = 104
class = "runtime-risk"
severity = "medium"
observed = "The migration issues ALTER TABLE across live explorer tables in the default migration transaction without setting PostgreSQL lock_timeout. A long reader or writer can delay acquisition while earlier table locks remain held, blocking indexing and explorer requests during upgrade."
expected = "Online explorer maintenance must bound lock acquisition and release held transaction locks on refusal so one busy table cannot stall other indexing work."
proposal = "Set an explicit short transaction-local lock_timeout in 20260301000000_hot_tables_storage_parameters.exs and document retry on contention; use pinned checkout for session settings as in TunePaxeerXPriceFeedTables. Verify a busy-table refusal leaves no partially applied migration."
owner_domain = 14

