[finding.sourcify-base-url-panic]
file = "services/explorer/services/libs/sourcify/src/client.rs"
line = 66
class = "runtime-risk"
severity = "medium"
observed = "ClientBuilder.try_base_url accepts every URL parsed by Url::from_str, including opaque mailto/data URLs. generate_url subsequently calls base_url.join(route).unwrap, which panics for a non-base URL. A missing trailing slash also replaces the final configured path component."
expected = "Invalid Sourcify endpoint configuration must be rejected at configuration time, and a valid configured prefix must survive route construction without a runtime panic."
proposal = "Validate HTTP(S), host and cannot_be_a_base in services/explorer/services/libs/sourcify/src/client.rs, normalize the base path trailing slash and make joining fallible. Cover opaque URLs, unsupported schemes and endpoints with a path prefix."
owner_domain = 14

[finding.sourcify-operation-deadline]
file = "services/explorer/services/libs/sourcify/src/client.rs"
line = 212
class = "runtime-risk"
severity = "medium"
observed = "The documented total duration of 60 seconds is a per-request reqwest timeout and retry middleware may repeat requests. The separate polling timeout starts after the initial POST and ends before source/chains retrieval, allowing a single verification to occupy a worker for several request budgets."
expected = "Verification needs a finite end-to-end deadline covering submission, retries, polling and source lookup, with a timeout result that describes the operation actually bounded."
proposal = "Wrap the full verify_from_etherscan and source lookup workflow in a configurable total deadline in services/explorer/services/libs/sourcify/src/client.rs. Pass remaining time through every leg and test slow submission, polling and retrieval against a real delayed HTTP service."
