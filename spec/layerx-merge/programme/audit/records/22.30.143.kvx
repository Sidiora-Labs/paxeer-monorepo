[finding.bridge-all-rejected]
file = "services/bridge/deploy/deploy-evm-chain.sh"
line = 79
class = "interface-mismatch"
severity = "high"
observed = "The initial -*) argument case rejects deploy-evm-chain.sh --all with usage exit 2 before the --all dispatch at line 84. Only --preflight --all reaches run_all, so the declared eight-chain deployment command cannot execute."
expected = "Registry 14.cli-bridge-deploy-evm-chain-flag-all-j55 declares --all as the deployment entry point for eight ordered EVM chains, with one deployment record per chain and a stop at the first failure."
proposal = "In services/bridge/deploy/deploy-evm-chain.sh accept --all in the initial parser and pass it to run_all. Add a regression through the actual CLI dispatcher for both --all and --preflight --all."
owner_domain = 14
interface = "14.cli-bridge-deploy-evm-chain-flag-all-j55"

[finding.bridge-broadcast-recovery]
