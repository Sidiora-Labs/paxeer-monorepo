class = "security"
severity = "high"
observed = "MintTransfers selects every fetched log solely by first_topic and calls parse_params, which has no clause for absent second or third topics. truncate_address_hash also requires zero address padding. An arbitrary EVM contract can LOG1 the matching topic or emit malformed address words. Indexer.Block.Fetcher invokes MintTransfers.parse(logs) unconditionally at line 199 before import, causing FunctionClauseError and repeated failure to index that valid block."
expected = "An unrelated or malformed log must not abort indexing a committed block; mint extraction must validate the supported emitter and complete log shape before decoding."
proposal = "In services/explorer/backend/apps/indexer/lib/indexer/transform/mint_transfers.ex constrain supported mint emitters and validate topic count, word length and address padding. Report unsupported logs without aborting the block and cover an adversarial LOG1 through the real block-fetch transform path."
owner_domain = 14

