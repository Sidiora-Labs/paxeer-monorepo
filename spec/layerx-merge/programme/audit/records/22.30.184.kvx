[finding.negative-fuzz-count]
file = "tests/test_fuzz_smoke.c"
line = 271
class = "runtime-risk"
severity = "medium"
observed = "The optional iteration count is parsed with strtoull and checks zero, errno and trailing bytes but not a leading minus sign. On a 64-bit host, -1 is accepted as UINT64_MAX and drives an effectively unbounded qualification loop."
expected = "A bounded smoke-test input must reject signed-negative counts and invalid numeric syntax before entering its iteration loop, so operator mistakes cannot turn the smoke gate into a multi-year run."
proposal = "Validate an unsigned decimal digit grammar and an explicit smoke-test iteration limit before conversion in tests/test_fuzz_smoke.c; preserve the requested positive workload and assert that -1, overflow and malformed values exit 2 without seeding or executing the corpus."
