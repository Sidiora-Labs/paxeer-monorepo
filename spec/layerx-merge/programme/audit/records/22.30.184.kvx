line = 18
class = "doc-drift"
severity = "low"
observed = "The c-harness section at lines 18, 21 and 50 still marks lxp_test_main and lxp_test_run_one planned and says HEAD can only run all or list cases. Both functions are implemented in tests/lxp_test_harness.c at the audited revision. The page is explicitly frozen at 2a1033aa2, but current API navigation still leads to this historical status."
