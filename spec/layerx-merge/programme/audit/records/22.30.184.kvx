[finding.validator-signing-rewind]
file = "tools/release/rollback.sh"
line = 383
class = "restart-recovery"
severity = "high"
observed = "restore() replaces the current data directory with the halt snapshot, including priv_validator_state.json, clears halt-height and restarts the previous binary with the same validator keys and chain identity. There is no check against the current signing height. A candidate that signed beyond the halt can sign conflicting blocks after the restore; committed post-halt history is also discarded."
expected = "A mainnet rollback must preserve validator anti-double-sign state and committed history. A disposable rehearsal fork with fresh consensus keys is not evidence that rewinding the same production validator is safe."
proposal = "In tools/release/rollback.sh compare the live and snapshot signing high-water marks before any move, refuse a same-chain rewind after post-halt signing, and implement a supported forward recovery procedure. Permit destructive rewind only on an explicitly isolated fork with new consensus identities; exercise both refusal and restart recovery."
owner_domain = 16

[finding.rehearsal-receipt-cycle]
file = "tools/release/rehearse-v6120.sh"
line = 950
class = "interface-mismatch"
severity = "high"
observed = "The generated rehearsal.env sets RECEIPT_DIR but no POOL_COUNT. The first markets call invokes fleet_check.py without --rehearsal or --no-rehearsal. load_config at fleet_check.py:883-906 requires RECEIPT_DIR/rehearsal.json with result=pass and rollback_rehearsed=true. write_receipt pass runs only at rehearse-v6120.sh:1053 after these checks and rollback, so a fresh rehearsal cannot produce its prerequisite."
expected = "The rehearsal producer and fleet-check consumer must complete from an empty work directory. Completed rollback evidence is required for rollout, but cannot be an input required before the rehearsal that creates it."
proposal = "Give tools/release/rehearse-v6120.sh and fleet_check.py an explicit internal rehearsal handoff containing the measured pool count and candidate identity before markets runs; keep completed rollback evidence mandatory for production rollout. Add a real fresh-directory driver-to-consumer check that reaches final receipt publication without pre-seeding success evidence."
owner_domain = 16
interface = "16.cli-release-release-fleet-check-opt-rehearsal"

[finding.binding-core-coordinate]
file = "tools/qualification/paxeer-x/mcp_binding_listener.py"
line = 28
class = "interface-mismatch"
severity = "high"
observed = "TOP_KEYS and producer_schema require core_sequence, matching BindingPublisher.document in services/agent/crates/layerx-agentd/src/enrolment.rs:807. The actual consumer Binding::parse in services/agent/crates/layerx-mcp/src/binding.rs:618 rejects that key with mcp.binding_retired_key and requires core_height at line 664. The real published binding cannot initialize this consumer."
expected = "The binding.json producer, its file transport and the MCP reader must agree on the merged height coordinate and its numeric encoding, including loading the same binding after restart."
proposal = "Change the domain-9 binding publisher in services/agent/crates/layerx-agentd/src/enrolment.rs to emit the consumer contract core_height from the verified chain height, update this harness TOP_KEYS and assertions, and prove enroll-to-file-to-MCP initialization plus restart with the actual publisher output."
owner_domain = 9
interface = "9.rs-agentd-enrolment-bindingpublisher"

[finding.binding-web-authority]
file = "tools/qualification/paxeer-x/mcp_binding_listener.py"
line = 33
class = "interface-mismatch"
severity = "high"
observed = "WEB_KEYS and web_reference_emitted accept the six-field WebDeclaration document emitted by agentd enrolment.rs:399-407, including sequencer_public_key. MCP binding.rs:1190 rejects that retired field and its closed WEB_KEYS also requires payer_address, receiver_address, receipt_key_index, sequencer_id and first_batch_number/last_batch_number. Even with the top-level height fixed, the paid web binding is refused."
expected = "Paid MCP web requests must carry the same payer, receiver and governed receipt-key/range authority that the MCP consumer validates; the harness must assert the actual supported producer-to-consumer document."
proposal = "Replace WebDeclaration publication and its configuration in services/agent/crates/layerx-agentd/src/enrolment.rs with the declared MCP web schema, preserving authority checks and bounded key ranges. Update this harness and run an actual paid-tool initialization and restart using that emitted file, including refusal of a changed authority."
owner_domain = 9
interface = "9.rs-agentd-enrolment-webdeclaration"

[finding.rollback-test-endorses-rewind]
file = "tools/release/tests/rollback.test.sh"
line = 230
class = "test-gap"
severity = "medium"
observed = "advance_candidate signs through height 25, then restored_state_is_pre_h1 asserts the active validator signer state is back at 20 and keeps the height-25 watermark only in the set-aside directory. Subsequent cases restart the old binary. This test treats reuse of a rewound validator identity as the expected production result."
expected = "A production rollback regression must reject signing-state rewind after the halt and must prove that safe recovery preserves the signer watermark. Fork-only destructive exercises must clearly use distinct chain and consensus identities."
proposal = "In tools/release/tests/rollback.test.sh make the post-halt signed candidate exercise the rollback refusal, assert that no data or signer files changed, then test supported forward recovery. Keep any rewind experiment on an isolated fork with freshly generated keys and a separate explicit contract."
owner_domain = 16

[finding.retired-daemon-release-asset]
file = "tools/release/build-paxd.sh"
line = 116
class = "retired-reference"
severity = "medium"
observed = "PAXD_RELEASE_LAYERXD=1 still invokes make layerxd and copies a layerxd release binary into the checksummed paxeer-network asset set. Release CI and build tests still set this option, so this is a reachable release path rather than a historical string."
expected = "The merged release distributes the paxd node with its embedded kernel and required native libraries; the separate layerxd daemon is retired by brief network facts 1 and 2."
proposal = "Remove the layerxd asset branch from tools/release/build-paxd.sh and retire PAXD_RELEASE_LAYERXD in its release workflow callers, tests and operations registry. Preserve reproducibility checks for paxd, sidecar and linked native dependencies."
owner_domain = 16
interface = "16.env-release-release-build-paxd-paxd-release-layerxd"

[finding.release-source-provenance]
file = "tools/release/build-paxd.sh"
line = 58
class = "security"
severity = "medium"
observed = "PAXD_COMMIT is accepted as the stamped version.Commit and epoch source, while make and go build compile the current working tree with -buildvcs=false. The script neither requires that commit to be HEAD nor rejects tracked modifications, so an artifact can claim a revision that did not supply its source."
expected = "An operator must be able to map a published node binary and its native libraries to the exact reviewed source revision. A caller-supplied label cannot substitute for source provenance."
proposal = "In tools/release/build-paxd.sh resolve the build revision to the actual checkout, reject mismatched PAXD_COMMIT and tracked source changes for a release, or build from an isolated checkout of the requested revision. Include the resolved revision in release evidence and test refusal with a deliberately changed source file."
owner_domain = 16
interface = "16.env-release-release-build-paxd-paxd-commit"

[finding.compiler-pin-selects-other-driver]
file = "tools/release/build-paxd.sh"
line = 47
class = "config-drift"
severity = "medium"
observed = "cc_pin validates cc -dumpfullversion, but the build later exports CC=gcc and CXX=g++. On a machine whose cc alternative differs from gcc, the check can pass while a different compiler builds CGO and native objects."
expected = "The pinned release compiler must be the same executable used for every native build, so toolchain identity and reproducibility evidence refer to the compiled artifact."
proposal = "Make tools/release/build-paxd.sh select a single explicit compiler command before validation and validate that exact driver and its C++ companion; pass those commands consistently to make and CGO. Cover a differing cc/gcc installation without weakening the version pin."
owner_domain = 16

