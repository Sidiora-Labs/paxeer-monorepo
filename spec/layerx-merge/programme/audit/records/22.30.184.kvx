[finding.swap-unidentified-home-process]
file = "tools/release/swap.sh"
line = 131
class = "runtime-risk"
severity = "medium"
observed = "node_process recognizes a paxd process only when its argv has --home or --home=. A node started with its default home or PAX_HOME is invisible, although daemon/paxd/cmd/root.go uses WithHomeDir and WithViper(PAX). The script can treat a live target home as stopped while replacing its binary/configuration."
expected = "A release swap must identify every process that can own the target home or fail closed when home ownership is ambiguous. snapshot.sh already checks environment/default-home ambiguity rather than assuming no match means no process."
proposal = "Use one shared fail-closed process/home resolver for tools/release/swap.sh, snapshot.sh and rollback.sh, including canonical paths, process environment and default-home ambiguity. Exercise the actual paxd process with explicit, relative, environment and default home selection before allowing a swap."
owner_domain = 16

[finding.rollback-unidentified-home-process]
file = "tools/release/rollback.sh"
line = 280
class = "runtime-risk"
severity = "medium"
observed = "matching_pids compares only the literal explicit --home argument to the configured home. It ignores equivalent relative paths, PAX_HOME and the default home. In manager=none mode check_stopped can therefore pass while the data directory being restored is still in use."
expected = "Rollback must prove that all processes owning the target data are stopped before any directory move or archive extraction; alternate supported home selection must not bypass that proof."
proposal = "Replace tools/release/rollback.sh matching_pids with the shared canonical, fail-closed home ownership resolver and require an unambiguous stopped result before prepare/restore. Test a running node with a relative home and an environment-selected home, asserting refusal without filesystem changes."
owner_domain = 16

[finding.release-tools-disjoint-locks]
file = "tools/release/stage.sh"
line = 116
class = "restart-recovery"
severity = "medium"
observed = "stage holds BIN_DIR/.stage.lock, swap holds .paxd-swap.lock and rollback holds .rollback.lock. These operations mutate the same paxd/paxd.new/previous binaries and release material, but their locks do not exclude one another, so concurrent operator invocations can interleave staged and restored identities."
expected = "Release staging, activation and recovery on one BIN_DIR must be serialized across commands, and the binary selected at the end must match the evidence checked before mutation."
proposal = "Use a single shared release-operation lock in tools/release/stage.sh, swap.sh and rollback.sh before any shared binary/material mutation, with consistent acquisition order for any home locks. Exercise concurrent real commands and assert only one mutator proceeds and evidence matches the final binary."
owner_domain = 16

