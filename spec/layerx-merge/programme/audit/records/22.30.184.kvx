severity = "medium"
observed = "The release-cli table declares --home on rollback.sh, snapshot.sh and swap.sh at lines 12348, 12359 and 12374. Those snippets inspect paxd process argv inside embedded Python; they are not flags accepted by those shell scripts. Similar qual-cli argv1/2/3 rows describe embedded client arguments rather than the top-level harness CLI."
expected = "An interface registry and its rendered operations contract must distinguish an executable public command parser from arguments of child processes; operators must not be given flags that the advertised command rejects."
proposal = "Correct the registry extraction ownership rules for nested shell/Python programs, reconcile 16.cli-release-release-rollback-opt-home, snapshot-opt-home, swap-opt-home and the MCP listener argv rows, then regenerate spec/layerx-merge/contracts/operations.md. Keep the real paxd --home interface under its producer."
owner_domain = 17

[finding.linker-origin-registry]
file = "tools/release/extld.sh"
line = 18
class = "config-drift"
severity = "low"
observed = "The registry declares 16.env-release-release-extld-origin as an environment variable, but line 18 passes a single-quoted literal $ORIGIN to the linker. No shell ORIGIN value is read; an operator cannot configure the release rpath by setting that purported environment key."
expected = "The environment registry must list values actually consumed by the executable and distinguish ELF dynamic-linker tokens from shell configuration variables."
proposal = "Correct the env-variable extractor for quoted linker tokens, retire the spurious ORIGIN env row for tools/release/extld.sh and regenerate its operations contract. Preserve the literal relocatable $ORIGIN rpath and the real CC driver configuration."
owner_domain = 16
interface = "16.env-release-release-extld-origin"

[finding.harness-result-contract-drift]
file = "tests/lxp_test_harness.c"
line = 63
class = "config-drift"
severity = "low"
observed = "lxp_test_run_one returns the callback result verbatim, whereas lxp_test_run_all normalizes any nonzero callback result to 1. Registry row 16.c-lxp-test-run-one-j59 notes promise 1 for failure, while requirement 16242.1 says returns its result. A callback returning 7 exposes the conflicting declarations."
expected = "The callback, named-case API, CLI exit status and registry must share one explicit result contract, including whether failure statuses are preserved or normalized. The existing requirement and explanatory registry notes must not disagree."
proposal = "Reconcile the harness result contract in the owning specification and registry with tests/lxp_test_harness.c and lxp_test_harness.h. Document the permitted callback result domain and verify a nonstandard nonzero callback through run-one and the CLI; retain named-case failure and unknown-name distinctions."
owner_domain = 16
interface = "16.c-lxp-test-run-one-j59"

