expected = "AND range queries must intersect all conditions independently of order and preserve the strictness of the strongest bound."
proposal = "In consensus/internal/state/indexer/query_range.go combine lower bounds by maximum and upper bounds by minimum with strictness on ties; cover reordered, duplicate, contradictory and mixed inclusive conditions through both KV consumers."
owner_domain = 5
interface = "15.go-consensus-internal-state-indexer-look-for-ranges-j57"

