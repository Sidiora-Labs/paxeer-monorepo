[finding.2]
file = "consensus/internal/state/execution.go"
line = 174
class = "restart-recovery"
severity = "medium"
observed = "AsyncPruner.pruneStores advances blockStore.Base with PruneBlocks before PruneStates; a state prune failure followed by the same retain height returns early because the block base already advanced, and prune records success."
expected = "A retain height is completed only when both stores have been pruned; retry and restart must resume an interrupted state-store prune."
proposal = "In consensus/internal/state/execution.go track the state pruning watermark independently and retry unfinished PruneStates even when blockStore.Base equals retainHeight; persist or reconstruct the pending watermark on reopen."
owner_domain = 5
interface = "15.go-consensus-internal-state-block-store-j57"

