line = 37
class = "runtime-risk"
severity = "medium"
observed = "NewHumanHTTPTransport uses an http.Client with Timeout zero when no client is supplied. The agent envelope transport reuses it, so calls made with a background context can wait indefinitely for a server that accepts a connection and never sends a response."
expected = "The default SDK transport must have a finite request budget so unresponsive dependencies cannot indefinitely block normal Human or Agent calls."
proposal = "Set a documented finite default timeout in sdk/platform/go/http.go while honoring shorter caller deadlines and explicit client configuration. Exercise a stalled response for both shared transport entry points."
