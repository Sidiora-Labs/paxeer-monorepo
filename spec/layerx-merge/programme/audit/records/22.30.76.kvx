[finding.committed-rpc-rung]
file = "sdk/platform/go/verify.go"
line = 783
class = "interface-mismatch"
severity = "high"
observed = "verifySequencerFields accepts only rung receipted. rpc/sequencer_receipt.go:325 emits the same signed receipt with rung committed and blockNumber/blockHash after block inclusion. Programs.Activity passes that response to VerifySequencerReceipt, so a finalized activity becomes a verification error."
expected = "The pax_sequencerReceipt producer and SDK must round-trip both declared transport rungs; independently verified block evidence must determine whether the SDK promotes its authenticated result to committed."
proposal = "Update sdk/platform/go/verify.go and programs.go to accept the node committed transport view while verifying the signed receipt, retain its block coordinate, and require trusted inclusion evidence for commitment. Exercise unchanged real RPC responses through Activity and portable export."
owner_domain = 8
interface = "7.rpc-pax-sequencerreceipt"

[finding.rewritten-committed-fixture]
file = "sdk/platform/go/committed_inclusion_test.go"
line = 174
class = "test-gap"
severity = "medium"
observed = "TestCommittedInclusionBindsTheWrappedTransaction checks the recorded RPC rung is committed, then rewrites receiptEnvelope[rung] to receipted before calling VerifySequencerReceipt. The fixture no longer exercises the response the node actually emits."
expected = "A real-producer conformance test must preserve transport fields and prove the consumer accepts the producer response without changing the recorded rung."
proposal = "In sdk/platform/go/committed_inclusion_test.go preserve the recorded response byte shape, pass it through the public receipt and Activity paths, and assert that trusted inclusion evidence controls the committed result."
owner_domain = 8

[finding.mirror-request-shape]
file = "sdk/platform/go/mirror.go"
line = 179
class = "interface-mismatch"
severity = "high"
observed = "VerifyReceipt sends evidence kind receipt with canonical_hex; VerifyState sends kind state with canonical_hex and proof_hex. layerx-mirror-verify.rs:63 defines a deny_unknown_fields enum accepting receipt with index or committed, so both Go requests are rejected before verification."
expected = "The SDK subprocess request must match the actual mirror CLI evidence variants, coordinates, field names and bounds, including the receipt index required by the producer."
proposal = "Align sdk/platform/go/mirror.go and sdk/platform/schema/mirror-v2.kvx with services/interop/crates/layerx-mirror/src/bin/layerx-mirror-verify.rs. Expose the required receipt index or committed coordinate and prove both operations against the real executable."
owner_domain = 8
interface = "11.cli-mirror-verify"

[finding.mirror-response-shape]
file = "sdk/platform/go/mirror.go"
line = 279
class = "interface-mismatch"
severity = "high"
observed = "The Go mirror response requires decimal batchNumber, headerDigest and checkpointLevel unavailable. The CLI report at layerx-mirror-verify.rs:228 emits committedHeight, committedBlockHash and level Committed, omits those required Go fields, and allows null evidenceDigest for committed evidence."
expected = "A successful real CLI response must decode into the SDK result with the same committed coordinate, optional evidence digest and verification level, without inventing absent fields."
proposal = "Change sdk/platform/go/mirror.go and the mirror schema result model to the current CLI report, validate height/hash against the requested evidence, and add real subprocess round-trips for receipt and committed responses."
owner_domain = 8
interface = "11.cli-mirror-verify"

[finding.wind-down-native-route]
file = "sdk/platform/go/native_program_lifecycle.go"
line = 416
class = "interface-mismatch"
severity = "high"
observed = "Programs.WindDown still sends program.wind-down through client.Agent with signed_activity and payload. ProgramRPCTransport rejects that operation; lifecycle EVMCalldata supports deploy and upgrade only. evm_metadata.go instead advertises an eth_sendRawTransaction deprecate operation at precompile 0x101d."
expected = "The declared Go wind-down operation must reach the native program lifecycle precompile through a signed EIP-1559 transaction, with its operation-specific authorization and receipt lifecycle."
proposal = "Implement native transaction preparation for wind-down in sdk/platform/go/native_program_lifecycle.go and programs.go, mapping supported route/deprecate/tombstone/exit actions to precompiles/layerxprograms. Verify native selectors, authorization errors and committed activity without restoring REST or kernel submission."
owner_domain = 8
interface = "8.go-sdkgo-programs-winddown"

[finding.wind-down-test-expects-refusal]
file = "sdk/platform/go/program_transport_retired_test.go"
line = 134
class = "test-gap"
severity = "medium"
observed = "The RPC transport test explicitly expects ErrorInvalidArgument and zero requests for program.wind-down while the operation catalogue advertises a native deprecate transaction. This treats the missing native implementation as the expected successful retirement outcome."
expected = "Retirement coverage must reject old ingress while proving every advertised native operation reaches the correct root RPC method and precompile selector."
proposal = "Extend sdk/platform/go/program_transport_retired_test.go to assert wind-down prepares and broadcasts the native deprecate transaction and observes its activity, retaining the existing assertions that no retired REST request is sent."
owner_domain = 8

[finding.stream-checkpoint-before-consumption]
file = "sdk/platform/go/stream.go"
line = 131
class = "restart-recovery"
severity = "high"
observed = "Next records every event cursor and advances stream.cursor to the end of the page before Run invokes consume. If the first callback fails and the caller persists Cursor(), reopening starts after the failed event and all unconsumed events in that page."
expected = "A resumable consumer checkpoint must describe successfully acknowledged consumption; callback failure and restart must preserve all events that were not successfully consumed."
proposal = "Separate fetched and acknowledged positions in sdk/platform/go/stream.go. Advance the resumable checkpoint only after each successful callback or explicit acknowledgment, and cover a multi-event page with callback failure followed by reconstruction from the saved cursor."
owner_domain = 8
interface = "8.go-sdkgo-resumablestream-run"

[finding.stream-unbounded-history]
file = "sdk/platform/go/stream.go"
line = 129
class = "runtime-risk"
severity = "medium"
observed = "Every page adds all accepted cursor strings to stream.seen and no cursor is ever removed. A healthy long-running subscription retains its complete delivery history and grows memory in proportion to lifetime traffic."
expected = "An indefinitely running resumable stream must keep bounded in-memory deduplication state while maintaining the server cursor ordering and replay guarantees."
proposal = "Bound duplicate tracking in sdk/platform/go/stream.go to the pending page or an explicitly bounded replay window tied to acknowledged checkpoints, and exercise many pages while asserting the retained state bound."
owner_domain = 8

[finding.portable-unanchored-finality]
file = "sdk/platform/go/portable_receipt.go"
line = 140
class = "security"
severity = "high"
observed = "PortableReceipt.verify authenticates the receipt key but takes BlockHeader, Commit, ValidatorSet and the next validator set from the untrusted portable document. VerifyCommittedReceipt proves their mutual consistency only. A holder of a valid receipted transaction can supply a private validator chain and obtain a committed result without Paxeer consensus."
expected = "Portable committed verification must anchor the validator chain and network identity to independently trusted genesis/checkpoint data; a self-consistent validator set supplied by the proof cannot establish network finality."
proposal = "Add a trusted chain/checkpoint or light-client state input to sdk/platform/go/portable_receipt.go and committed.go, authenticate validator evolution from that anchor, and refuse a proof signed by a fabricated validator set even when its receipt signature and all Merkle proofs are valid."
owner_domain = 8

[finding.portable-tests-no-external-anchor]
file = "sdk/platform/go/portable_receipt_test.go"
line = 69
class = "test-gap"
severity = "medium"
observed = "Committed portable tests use locally constructed committed fixtures and the receipt-key pins as the entire trusted input. They test internal proof mutations but do not distinguish a genuine network validator set from a coherent attacker-generated replacement."
expected = "Portable finality tests must demonstrate that committed evidence belongs to the configured Paxeer network and trusted validator history rather than merely agreeing with its own embedded keys."
proposal = "Add independently anchored committed fixtures and adversarial replacement-validator-chain cases in sdk/platform/go/portable_receipt_test.go, with explicit trusted genesis/checkpoint input and validator rotation coverage."
owner_domain = 8

[finding.deployment-payload-bound]
file = "sdk/platform/go/native_program_lifecycle.go"
line = 47
class = "runtime-risk"
severity = "medium"
observed = "lifecycleCodeValid admits up to 1048576 Wasm bytes. EncodeNativeProgramDeploy adds a 104-byte envelope, or 108 bytes plus interface data, without enforcing the merged-network total deployment payload ceiling of 524288 bytes."
expected = "Decision 2483 and brief network fact 6 limit the entire encoded deployment payload to 524288 bytes, including the 104-byte envelope and any additional interface framing."
proposal = "Enforce the full encoded payload bound in sdk/platform/go/native_program_lifecycle.go for deploy and the corresponding native upgrade path, account for interface framing, and test the exact accepted boundary and first rejected byte against the precompile decoder."
owner_domain = 8

[finding.program-root-chain-hardcoded]
file = "sdk/platform/go/programs.go"
line = 2731
class = "config-drift"
severity = "medium"
observed = "buildTransaction always sets ChainID to 0x7d and never reads eth_chainId. ProgramRPCTransport can target /chain/id, while chains.go and rpc/domain_scope_test.go declare virtual chain IDs such as 0x7735941 for /chain/1. Tenant program preparation consequently uses the root signing domain."
expected = "A program transaction must use the chain ID of its selected tenant endpoint; root chain 125 and tenant database domains must remain distinct signing domains."
proposal = "Resolve and validate eth_chainId or require a checked endpoint chain configuration in sdk/platform/go/programs.go. Bind prepared transactions to that endpoint and add root and /chain/1 preparation cases using the domain RPC producer."
owner_domain = 8

[finding.program-verification-claims]
file = "sdk/platform/go/programs.go"
line = 479
class = "security"
severity = "medium"
observed = "VerifyProgramReceiptWithPayers promises occupancy-payer proofs but ignores payers and selectedProtocol. It verifies only the signed EVM receipt and transaction hash, leaving ProgramID, GuestABIVersion, Outcome, TerminalPayload and CallGraph fields of ProgramExecutionDocument unauthenticated."
expected = "The public verification contract must identify exactly which program facts are authenticated. Integrators must not interpret a verified transaction receipt as verification of supplied program outcome or payer statements."
