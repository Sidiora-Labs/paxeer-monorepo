[finding.secret-callback-deadlock]
file = "sdk/platform/go/secret.go"
line = 28
class = "runtime-risk"
severity = "medium"
observed = "SecretBytes.Expose holds secret.mu while invoking arbitrary consumer code. A consumer that calls Destroy on the same secret, or re-enters Expose, deadlocks because both methods attempt to acquire the same non-reentrant mutex."
expected = "The secret callback lifecycle must allow predictable cleanup and must not block forever when a consumer destroys the exposed secret during error handling."
proposal = "Define safe borrow and destruction semantics in sdk/platform/go/secret.go and avoid calling the consumer while holding a mutex it can re-enter, preserving zeroization and concurrency protection. Cover callback-triggered destruction and concurrent cleanup."
owner_domain = 8

