[finding.payer_payment_asset]
file = "services/agent/crates/layerx-agentd-host/src/payer.rs"
line = 484
class = "interface-mismatch"
severity = "high"
observed = "verify_execution compares protocol.asset() to SHA256(execution.fee_denom). node/sequencer/receipt.go:234 emits SHA256(PaymentDenom), and layerx-client/src/rpc/receipt.rs:289 verifies payment_denom. A valid payment with a different gas denomination is refused after submission."
expected = "Requirement 22082.1 binds the payment asset to paymentDenom independently of feeDenom; the node producer, authenticated client and MCP payer must accept the same signed receipt."
proposal = "Change services/agent/crates/layerx-agentd-host/src/payer.rs to bind protocol.asset to execution.payment_denom while retaining the separate fee summary checks. Cover successful and reverted receipts with unequal payment and fee denominations through the actual node receipt codec."
owner_domain = 9
interface = "9.rs-agentd-host-payer-productionwebpayer-j43"

[finding.payer_equal_denom_fixture]
file = "services/agent/crates/layerx-agentd-host/tests/payer.rs"
line = 238
class = "test-gap"
severity = "medium"
observed = "The ExecutedReceipt fixture sets fee_denom and payment_denom to upax. encode_execution correctly hashes payment_denom at line 161, but equal fixture values hide the production payer check against fee_denom at payer.rs:484."
expected = "The payer tests must distinguish the payment asset from the fee currency and expose a consumer that hashes the wrong denomination, as required by 22082.1 and brief check_7."
proposal = "Extend services/agent/crates/layerx-agentd-host/tests/payer.rs with independently produced receipts whose payment_denom differs from fee_denom; require acceptance of the valid payment and rejection of either independently altered denomination."
owner_domain = 9

[finding.payer_binding_bypass]
file = "services/agent/crates/layerx-agentd-host/tests/payer_evm.rs"
line = 446
class = "test-gap"
severity = "medium"
observed = "web_pay_exact_submits_a_signed_layerxpay_call constructs WebConfig directly with eip155:125. It never consumes BindingPublisher output; its RPC fixture at line 357 supplies a hand-encoded receipt. This bypasses the incompatible web declaration emitted by enrolment.rs."
expected = "The production paid-tool proof must carry the daemon-published binding through layerx-mcp binding::web_binding before invoking the payer; successful direct WebConfig construction does not establish the boot-to-tool path."
proposal = "Add a producer-to-consumer case in services/agent/crates/layerx-agentd-host/tests/payer_evm.rs that enrols with BindingPublisher, loads the published binding through the real MCP loader, and performs payExact and draw with the node receipt producer."
owner_domain = 9

[finding.operator_audit_payload]
file = "services/agent/crates/layerx-agentd/src/admin.rs"
line = 375
class = "interface-mismatch"
severity = "high"
observed = "Surface::open uses audit::Log::open(root, tenant), then dispatch appends audit_payload beginning LXOA version 1 at line 639. audit/record.rs::read_entries and audit/export.rs::decode_owned_entries decode every frame as LXAR. A successful operator action therefore produces a chain that those declared readers cannot export."
expected = "Operator attempts and ordinary tenant audit entries sharing the same Log path must have a common decodable record grammar. Registry 9.fmt-audit-record and the admin dispatch contract must round-trip through audit readers."
proposal = "Represent operator attempts as a versioned variant of the common audit record in services/agent/crates/layerx-agentd/src/admin.rs and src/audit/record.rs, or give operator logs a distinct declared path and reader. Prove mixed operator and ordinary events export and review after restart."
owner_domain = 9
interface = "9.rs-agentd-surface-dispatch-j70"

[finding.redacted_audit_entry_binding]
file = "services/agent/crates/layerx-agentd/src/audit/export.rs"
line = 475
class = "security"
severity = "high"
observed = "chain_links drops canonical_entry_bytes when retention changes a selected entry (lines 375-384). verify_chain_material accepts None even for selected links at line 439, and review accepts any entry with submitted_bytes=Redacted at line 477. Its decision, reason, actor and observation time are consequently not authenticated against payload_digest or entry_hash."
expected = "review promises to reject an altered export. Redacting a payload digest must preserve authentication of every remaining audit field against the original tenant chain, including entries without protocol receipts."
proposal = "Introduce independently verifiable field commitments or authenticated redaction proofs in services/agent/crates/layerx-agentd/src/audit/export.rs and the record format. Require mutation of each retained field in a redacted export to fail review without disclosing expired payload evidence."
owner_domain = 9
interface = "9.rs-agentd-audit-export-review-j43"

[finding.audit_append_crash_window]
file = "services/agent/crates/layerx-agentd/src/audit/log.rs"
line = 231
class = "restart-recovery"
severity = "medium"
observed = "append_durable writes and syncs a frame before replacing its separate tail anchor at lines 233-239. A process or host crash between those steps leaves a complete new frame with the old anchor; verify_chain and Log::open reject the store as AnchorMismatch. An interrupted partial frame is also permanently refused."
expected = "A crash before before_operation invokes its operation must have an explicit recovery outcome that preserves committed history and distinguishes an incomplete append from corruption; normal restart must not strand an otherwise intact tenant audit chain."
proposal = "Add a durable append intent and commit protocol in services/agent/crates/layerx-agentd/src/audit/log.rs with bounded recovery of a provably incomplete tail. Exercise crash boundaries before frame sync, before anchor replacement and after anchor directory sync without weakening tamper checks."
owner_domain = 9
interface = "9.rs-agentd-log-open-j70"

[finding.audit_concurrent_writers]
file = "services/agent/crates/layerx-agentd/src/audit/log.rs"
line = 202
class = "runtime-risk"
severity = "medium"
observed = "append_durable verifies the current tail and later appends without a lock spanning verification, frame write and anchor publication. Two handles opened at the same tail can both pass the StaleWriter check, append the same sequence and race the fixed audit.anchor.tmp path. MCP servers open separate Logs and operator routes also open tenant Logs."
expected = "Concurrent users of a tenant audit chain must serialize the entire append transaction, or an exclusive writer must be enforced before more than one handle can acknowledge an append."
proposal = "Enforce a tenant-scoped process lock in services/agent/crates/layerx-agentd/src/audit/log.rs around tail verification through anchor sync, and refresh the tail under that lock. Cover simultaneous MCP and operator handles with no duplicate sequence or chain corruption."
owner_domain = 9
interface = "9.rs-agentd-log-before-operation-j70"

[finding.audit_record_tenant_binding]
file = "services/agent/crates/layerx-agentd/src/audit/record.rs"
line = 249
class = "security"
severity = "medium"
observed = "record encodes entry and invokes Log::before_operation without checking Log::owns_tenant(&entry.tenant). A well-formed entry for another tenant is durably appended and its operation executes; export later rejects the chain when decode_owned_entries detects that foreign tenant."
expected = "The tenant embedded in every audit entry must match the tenant cryptographically bound to its Log before an entry is appended or an operation runs."
proposal = "Check log.owns_tenant in services/agent/crates/layerx-agentd/src/audit/record.rs::record and return a typed tenant mismatch before mutation. Verify that a foreign entry leaves the log, coverage counters and operation side effects unchanged."
owner_domain = 9
interface = "9.fmt-audit-record"

[finding.audit_record_registry_version]
file = "services/agent/crates/layerx-agentd/src/audit/record.rs"
line = 18
class = "doc-drift"
severity = "low"
observed = "ENTRY_VERSION is 3 and LEGACY_ENTRY_VERSION is 2, while registry row 9.fmt-audit-record declares LXAR version 2 with legacy version 1 readable. The declared persistence grammar therefore gives integrations the wrong current and accepted versions."
expected = "The audit format registry must name the bytes the encoder emits and the versions the decoder actually accepts so retained history and offline tools share the same upgrade contract."
proposal = "Update the owning audit-format declaration in spec/layerx-merge/interfaces.kvx and its generated contract documentation from the encoder and decoder in services/agent/crates/layerx-agentd/src/audit/record.rs; explicitly describe migration or refusal of version 1."
owner_domain = 9
interface = "9.fmt-audit-record"

[finding.web_binding_schema]
file = "services/agent/crates/layerx-agentd/src/enrolment.rs"
line = 399
class = "interface-mismatch"
severity = "high"
observed = "WebDeclaration::document emits endpoint, network, sequencer_public_key, timeout_ms, pending_attempts and approval_threshold. layerx-mcp/src/binding.rs:1190 rejects sequencer_public_key as retired and requires payer_address, receiver_address, receipt_key_index and a key range. WebDeclaration::new also accepts only layerx: networks at line 359 whereas the consumer requires eip155: at binding.rs:1244."
expected = "The daemon-published closed-key MCP web binding must load unchanged in the real MCP consumer, with the actual payer and receiver addresses, governed receipt key ranges and eip155:125 network identifier."
proposal = "Replace WebDeclaration in services/agent/crates/layerx-agentd/src/enrolment.rs with the current binding schema and wire the actual payer, receiver and receipt key entries from src/main.rs. Prove enrolment output loads through layerx-mcp/src/binding.rs and remains usable after daemon restart."
owner_domain = 9
interface = "9.fmt-mcp-binding-document"

[finding.enrolment_publication_recovery]
file = "services/agent/crates/layerx-agentd/src/enrolment.rs"
line = 959
class = "restart-recovery"
severity = "medium"
observed = "open_and_publish persists session::open before publisher.publish creates the session token, daemon bearer and binding as three separate files at lines 680-684. Synchronous errors close the session, but a crash can leave an open durable session and only part of the publication; a later publish refuses pre-existing secrets."
expected = "MCP enrolment must recover one consistent session and binding generation after a crash, including crashes between durable session creation and each published secret or document."
proposal = "Journal the enrolment generation in services/agent/crates/layerx-agentd/src/enrolment.rs and publish a staged directory atomically, or reconcile its recorded file set on boot before admitting the session. Add restart cases for every publication boundary and preserve fail-closed secret validation."
owner_domain = 9
interface = "9.rs-agentd-enrolment-enrol"

[finding.receipt_legacy_evidence_roundtrip]
file = "services/agent/crates/layerx-agentd/src/receipt.rs"
line = 426
class = "interface-mismatch"
severity = "high"
observed = "persist_evidence writes encode_evidence with LXRE byte 4 equal to 1 at line 499. evidence_inventory calls serve_kernel_evidence, which first calls check_evidence_version requiring 2, then decode_evidence requiring 1. Evidence produced by persist_evidence can never return through this recovery inventory and instead yields receipt.evidence_version."
expected = "The registered persist_evidence and evidence_inventory pair must round-trip evidence retained for recovery. Requirement 9018.2 still requires the public v2 serve_evidence API to refuse v1, so silently relaxing that check is not a repair."
proposal = "Separate the legacy recovery reader from the public v2 reader in services/agent/crates/layerx-agentd/src/receipt.rs and provide an explicit migration to authenticated transaction evidence where supported. Prove persist, close, reopen and inventory on real receipts while public serve_evidence still refuses stale v1."
owner_domain = 9
interface = "9.rs-agentd-receipt-evidence-inventory-j43"

[finding.receipt_v2_producer_not_wired]
file = "services/agent/crates/layerx-agentd/src/receipt.rs"
line = 398
class = "wiring-gap"
severity = "high"
observed = "serve_evidence requires LXRE v2 plus receipt:transaction:<hash>. The live AuthenticatedReceipt ingress in human_runtime.rs:1067 writes only receipt:activity, receipt:idempotency and receipt:sequence indexes with legacy metadata; TransactionReceiptEvidence construction and storage occur in tests, not that ingress. session_control.rs:1427 calls serve_evidence for receipts retained by the live path."
expected = "Requirement 9018.1 requires node receipt observations to populate the transaction-keyed v2 evidence that public readers and restart consumers request; successful live receipt observation must not leave the v2 serving path empty."
proposal = "Wire an authenticated node-receipt-to-TransactionReceiptEvidence conversion into services/agent/crates/layerx-agentd/src/receipt.rs and human_runtime.rs, atomically persisting the transaction index and v2 evidence. Verify live observation, serve_evidence, MCP reconciliation and reopened-store reads without fixture injection."
