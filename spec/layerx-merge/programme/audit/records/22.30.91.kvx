[finding.store_private_file_modes]
file = "services/agent/crates/layerx-agentd/src/store/mod.rs"
line = 1155
class = "security"
severity = "medium"
observed = "Store::open uses create_dir_all without owner-only permissions, and persist creates store.bin.tmp with default OpenOptions permissions and follows an existing path. With a normal 022 umask a newly created root and store can be 0755/0644; session.rs:908 serializes bearer token_id into those bytes. The live main.rs path only requires an absolute store path."
expected = "The daemon store containing bearer credentials must enforce owner-only directories and files independently of umask, and reject symlinks or unexpected ownership before reading or replacing state."
proposal = "Harden services/agent/crates/layerx-agentd/src/store/mod.rs to validate canonical owned roots, create directories as 0700 and unique regular temporary files as 0600 with no-follow protection, and retain those modes through replacement. Cover permissive umasks and pre-existing unsafe paths."
owner_domain = 9

