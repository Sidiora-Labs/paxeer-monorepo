class = "interface-mismatch"
severity = "high"
observed = "transition_at appends a transition and encode_record persists its u32 count without a 1024 limit. legal_transition permits Submitted to Submitted repeatedly. decode_record rejects transition_count greater than 1024, so a successfully persisted legal record becomes Corrupt when Outbox::restore or restart recovery reads it."
