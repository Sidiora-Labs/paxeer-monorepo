[finding.f01]
file = "modules/launchpad/keeper/genesis.go"
line = 178
class = "restart-recovery"
severity = "high"
observed = "ExportGenesis exports markets, metadata and contract ledgers but omits factoryNoncePrefix (0x50), and InitGenesis never restores it. FactoryNonce then returns zero for a creator whose deployPoolToken already advanced it. Repeating the original name and symbol reuses the original CREATE2 salt and can collide with the preserved ERC20. This also loses nonces imported by readFactoryNonces during migration."
expected = "Factory getNonce and subsequent token creation must preserve the per-creator nonce across genesis export/import, together with the existing EVM code and market records."
proposal = "Add validated per-creator factory nonces to modules/launchpad/types/genesis.go, export every nonce and restore it in keeper/genesis.go. In keeper/genesis_test.go create several markets, export/import with EVM state and prove getNonce and another creation with repeated metadata continue correctly."
owner_domain = 4
interface = "4.go-launchpad-keeper-keeper-export-genesis"

[finding.f02]
file = "modules/launchpad/keeper/genesis.go"
line = 159
class = "restart-recovery"
severity = "high"
observed = "initFeeRights rebuilds owner enumeration from c.Tokens in global tokenByIndex order, and exportFeeRights exports only that global order. TransferFeeRight removes an owned token by moving the last token into its slot. Minting 1, 2, 3 to A then transferring 1 away leaves A with [3,2]; export/import reconstructs [2,3]."
expected = "FeeRightOfOwnerByIndex and SidioraNFT.tokenOfOwnerByIndex must round-trip through genesis recovery after transfers, as well as preserving ownership, approvals and total supply."
proposal = "Extend FeeRightCollection in modules/launchpad/types/genesis.go with validated per-owner token order or equivalent owner indexes, export the owner enumeration and restore it in keeper/genesis.go. Prove every owner index through the NFT surface before and after export/import following swap-last removals and incoming transfers."
owner_domain = 4
interface = "4.go-launchpad-keeper-keeper-fee-right-of-owner-by-index"

[finding.f03]
file = "modules/launchpad/client/cli/query_price.go"
line = 63
class = "interface-mismatch"
severity = "high"
observed = "CmdQueryQuote parses amount-in as uint64 before sending QueryQuoteRequest.AmountIn. Querier.Quote accepts positive decimal sdk.Int values and swap math supports uint256. The CLI rejects 18446744073709551616 before sending the request even though the service accepts that decimal encoding."
expected = "The quote CLI and Query/Quote must accept the same positive decimal amount domain and preserve uint256 token amounts as decimal strings without narrowing them to uint64."
proposal = "Replace the amount parser in modules/launchpad/client/cli/query_price.go with positive decimal validation matching keeper/grpc_query_quote.go and the uint256 math limit. Add a funded live CLI-to-query comparison above MaxUint64 and matching malformed, zero and overflow refusals."
owner_domain = 4
interface = "4.cli-launchpad-query-quote-j28"

[finding.f04]
file = "modules/launchpad/keeper/keeper.go"
line = 116
class = "runtime-risk"
severity = "high"
observed = "UpdateParams can replace Params.QuoteToken while markets, HeldQuote, FeeHeld and fee liabilities remain populated. custody.go reads the new quoteToken, but HeldQuoteKey(pool) and FeeHeldKey(accumulator) contain no token. Existing reserves and fees become liabilities in a different asset while their original ERC20 backing stays in custody."
expected = "A governance parameter update must preserve the asset backing of every funded market and fee claim; existing liquidity cannot silently change denomination or be paid from another token balance."
proposal = "In modules/launchpad/keeper/keeper.go reject QuoteToken changes once a market or quote liability exists, unless a separately specified atomic migration moves every reserve, fee ledger and backing balance. Add native governance-message tests with funded pools and pending fees proving refusal preserves params and both token balances."
owner_domain = 4
interface = "4.go-launchpad-keeper-keeper-update-params"

[finding.f05]
file = "modules/launchpad/keeper/keeper.go"
line = 114
class = "interface-mismatch"
severity = "high"
observed = "UpdateParams wraps ErrUnauthorized with fmt.Errorf and msgServer.UpdateParams returns it unchanged. sdk/types/errors/abci.go follows Cause(), not Unwrap(), so the native message refusal becomes codespace undefined / code 1 instead of launchpad / 23. Local errors.Is succeeds while the declared code cannot round-trip through ABCI."
expected = "The registered unauthorized error must retain codespace launchpad and code 23 through the keeper, Msg handler, ABCI response and client decoder while still preventing all unauthorized state changes."
proposal = "Use SDK Wrap/Wrapf in modules/launchpad/keeper/keeper.go and audit active launchpad producers for the same wrapper incompatibility. Extend keeper/msg_server_test.go and types/proof_launchpad_errors_test.go to serialize the exact unauthorized UpdateParams result through ABCI and require the registered client error without manual unwrapping."
owner_domain = 4
interface = "4.err-sdk-launchpad-23-unauthorized"

[finding.f06]
file = "modules/launchpad/keeper/feerights.go"
line = 304
class = "runtime-risk"
severity = "medium"
observed = "TransferFeeRight updates only right.Owner, and SetFeeRightStrategy updates only right.Strategy. The NFT precompile invokes these directly. Market.FeeRightsHolder and Market.FeeStrategy retain old values, which MarketInfoOf exposes through market queries while FeeRight and fee execution use the updated NFT record."
expected = "Operator market views must identify the current fee-right holder and strategy consistently with NFT views and with the authority used for claiming or distributing that market's fees."
proposal = "Synchronize linked market copies on every mutation in modules/launchpad/keeper/feerights.go, or derive current owner and strategy in a shared keeper query projection. Add real NFT transfer and setFeeStrategy calls followed by Market and FeeRight queries, including export/import."
owner_domain = 4
interface = "4.go-launchpad-keeper-keeper-set-fee-right-strategy"

[finding.f07]
file = "modules/launchpad/keeper/grpc_query_fee_accounting.go"
line = 21
class = "runtime-risk"
severity = "medium"
observed = "FeeAccounting passes a synthetic FeeAccounting containing only PendingProtocolFees and TotalLiabilities to FeeAccountingInfoOf. PoolCount, EpochCount and ClaimCount consequently remain zero even when exportFeeAccounting can enumerate persisted pools, epochs and claims. Operators see empty accounting collections alongside populated liabilities and history."
expected = "The public FeeAccountingInfo collection counts must describe the persisted accounting collections; the required zero pending protocol fees must not erase unrelated metadata."
proposal = "Populate accounting metadata in modules/launchpad/keeper/grpc_query_fee_accounting.go using maintained counts or an agreed bounded query design. Add a network query after pool creation, epoch trigger and claim that checks real collection counts alongside exact liabilities and zero pending protocol fees."
owner_domain = 4
interface = "4.qry-launchpad-fee-accounting-j28"

[finding.f08]
file = "modules/launchpad/keeper/locks_test.go"
line = 115
class = "test-gap"
severity = "medium"
observed = "TestViewsAnswerUnderLock derives PoolLock from market.Pointer. createMarket populates PoolAddress and TokenAddress but leaves the retired Pointer field empty. The test therefore holds the zero-address pool lock rather than the lock belonging to the market whose views it exercises."
expected = "The lock-view proof must hold the actual created pool's write lock and show that views of that same pool continue answering while its lock is held."
proposal = "Use market.PoolAddress in modules/launchpad/keeper/locks_test.go, assert it is nonzero and matches the registered pool surface, then exercise matching EVM views under that lock. Retain the separate-context lock reset checks."
owner_domain = 4

[finding.f09]
file = "modules/launchpad/client/cli/query_price_test.go"
line = 75
class = "test-gap"
severity = "medium"
observed = "The quote amount test requires a strconv.NumError for 18446744073709551616, making the CLI uint64 restriction an expected result. That decimal is inside the service and uint256 math domain, so this test preserves the producer/consumer discrepancy in f03."
expected = "CLI tests must distinguish uint64 height limits from uint256 amount limits and prove valid large decimal amounts reach the real query service unchanged."
proposal = "In modules/launchpad/client/cli/query_price_test.go retain height overflow coverage, replace the large-amount refusal with a funded network quote comparison above MaxUint64, and retain malformed, nonpositive and actual uint256 overflow refusals."
owner_domain = 4
interface = "4.cli-launchpad-query-quote-j28"

[finding.f10]
file = "modules/launchpad/types/proof_launchpad_errors_test.go"
line = 283
class = "test-gap"
severity = "medium"
observed = "TestProofLaunchpadErrorsKeeper transports real GenesisState.Validate, GetQuoteLedger, MoveQuote, PullQuote and PayQuote errors but asserts undefined / 1 and NotErrorIs for their registered sentinels. It also expects undefined / 1 for RecordFee's ErrInvalidHookResponse. This proves the current transport loss rather than registered error identity."
expected = "A registered-error proof must assert declared codes through the actual producer, ABCI encoding and remote decoder. Local errors.Is and a separate correct EVM custom selector do not establish ABCI agreement."
proposal = "After correcting active wrappers or SDK unwrapping, strengthen modules/launchpad/types/proof_launchpad_errors_test.go to require the actual launchpad codes for these producers and add the native UpdateParams refusal from f05. Retain exact EVM selector checks as an independent assertion."
owner_domain = 4
interface = "4.err-sdk-launchpad-42-invalid-configuration"

[finding.f11]
