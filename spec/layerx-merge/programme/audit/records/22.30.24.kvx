line = 16
class = "retired-reference"
severity = "medium"
observed = "The airdrop-epoch and airdrop-claimed help examples at lines 16 and 45 invoke layerxd query launchpad. layerxd is retired; an operator copying the public examples is directed to a daemon the merged network does not run."
