[finding.001]
file = "services/launchpad/livestream/internal/streams/connected_routes.go"
line = 660
class = "wiring-gap"
severity = "high"
observed = "NewConnectedRuntime supplies IngestKeys: keys but omits Deps.Credentials. No service implementation of CredentialAuthority.Credential exists. The mounted connectedCredential route reaches ingestCredential, which rejects nil credentials even after successful provisioning; the real browser getIngestCredential consumer cannot receive a credential."
expected = "The registered ingest-credential operation must deliver an authorized bounded credential for a ready/live stream through the provider-backed runtime. EncryptedCredentials.LoadKey implements a different interface and cannot satisfy this contract by assignment."
proposal = "Implement and wire a provider-backed CredentialAuthority in services/launchpad/livestream/internal/streams with bounded expiry, creator authorization and provider/operation binding. If that provider product is unsupported, explicitly retire this contract and migrate SDK/browser consumers to the reviewed encrypted-key flow. Prove the chosen real runtime through HTTP and its consumer."
owner_domain = 4
interface = "4.http-livestream-post-v2-streams-id-ingest-credential"

[finding.002]
file = "services/launchpad/livestream/internal/streams/connected_routes.go"
line = 54
class = "interface-mismatch"
severity = "high"
observed = "connectedCreate calls operationMutation, which persists and returns only a top-level operation object. The actual v2 StreamCreateResponse schema requires requestId, data.operation, watermark, revision, quality, nextCursor and generatedAt. The tolerant browser parser hides rejection by the generic SDK response decoder."
expected = "The registered POST /v2/streams producer must emit StreamCreateResponse accepted by sdk/launchpad/packages/sdk/src/transport.ts decodeV2Contract and the shared v2 schema, while signed ledger replay preserves exactly the original response bytes."
proposal = "Add a typed frozen create-response adapter in services/launchpad/livestream/internal/streams, validate StreamCreateResponse and serialize it inside the ledger transaction with its request ID. Prove connected create through HTTP into the real SDK decoder and assert byte-identical replay after restart."
owner_domain = 4
interface = "4.http-livestream-post-v2-streams"

[finding.003]
file = "services/launchpad/livestream/internal/streams/handlers.go"
line = 329
class = "interface-mismatch"
severity = "high"
observed = "operationStatus emits a top-level operation object. The actual v2 StreamOperationGetResponse requires data.operation and the seven envelope fields, so the SDK decoder rejects a successful polling response although the browser compatibility parser accepts it."
expected = "GET /v2/streams/operations/{id} must round-trip StreamOperationGetResponse through the declared SDK consumer while retaining creator authorization and no-store handling."
proposal = "Add a typed operation-status response adapter in services/launchpad/livestream/internal/streams with requestId, data, watermark, revision, quality, nextCursor and generatedAt. Validate the emitted response and drive operation polling through real HTTP into decodeV2Contract, including worker/restart recovery."
owner_domain = 4
interface = "4.http-livestream-get-v2-streams-operations-id"

