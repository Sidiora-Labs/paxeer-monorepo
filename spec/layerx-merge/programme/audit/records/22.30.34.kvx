class = "interface-mismatch"
severity = "high"
observed = "IF_STREAM_INGEST_CREDENTIAL in the SDK declares body:null, but connectedCredential requires application/json and a parsed empty object before authorization and rejects the declared bodyless call. Even with credentials wired, handlers.go:370 emits streamId/ingestCredential at top level rather than StreamIngestCredentialResponse data inside its required envelope."
