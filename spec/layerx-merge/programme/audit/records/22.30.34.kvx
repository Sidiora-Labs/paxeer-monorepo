[finding.011]
file = "apps/launchpad/web/src/widgets/trading/use-live-balances.ts"
line = 64
class = "runtime-risk"
severity = "medium"
observed = "Each polling tick cleans up the previous read by setting live=false and starts a new Promise.all. At default four-second polling with sustained five-second balance RPC latency every completion is discarded and no balance appears. ChainTradeProvider.readBalance has no cancellation/coalescing parameter, so underlying reads also overlap."
expected = "An authenticated wallet must eventually show a successful current-identity balance under slow but functioning RPC, with bounded reads and immediate invalidation for account/session/pool changes."
proposal = "Change apps/launchpad/web/src/widgets/trading/use-live-balances.ts to single-flight polling per identity, schedule the next poll after settlement and bound/cancel the actual transport. Accept current-generation completions despite intervening refreshes. Prove slow real RPC, identity changes and visibility recovery."
owner_domain = 4

[finding.012]
file = "apps/launchpad/web/src/widgets/trading/udf-datafeed.ts"
line = 98
class = "runtime-risk"
severity = "medium"
observed = "CanonicalCandleRevisionMerge rejects the 2049th unique candle, but readHistory accepts up to 5000 and visibleCandles independently caps at 2048. Merge keys persist across history windows without eviction/reset on retry, so valid history or normal panning eventually yields a permanent visible-history conflict for the feed."
expected = "Allowed history size, accessible view retention and revision provenance must share a bounded window policy that supports valid history and streaming corrections throughout the chart session."
proposal = "Define a common explicit window in apps/launchpad/web/src/widgets/trading/udf-datafeed.ts and evict candles/provenance together without permitting stale overwrite. Support the declared 5000 input or revise every public caller consistently. Prove pagination, repeated pans, corrections and recovery beyond 2048 unique candles."
owner_domain = 4

[finding.013]
file = "apps/launchpad/web/src/widgets/trading/udf-datafeed.ts"
line = 201
class = "runtime-risk"
severity = "medium"
observed = "createChartMetadataFeed catches and discards failures from onReady and getServerTime; invalid server-time values also invoke no callback. A config/time outage can leave TradingView initialization waiting while the separate candle fetch succeeds, without entering the chart error/retry path."
expected = "Metadata failures and invalid declared responses must settle into an observable bounded failure state so the chart can explain unavailability and allow retry."
proposal = "Wire metadata failures in apps/launchpad/web/src/widgets/trading/udf-datafeed.ts into tv-chart.tsx freshness/error handling with bounded deadlines and cancellation. Preserve strict validation and avoid invented config/time values. Prove config/time rejection, stalled transport and successful retry through the metadata client."
owner_domain = 4

[finding.014]
file = "apps/launchpad/web/src/widgets/trading/transaction-controls/recovery.ts"
line = 162
class = "runtime-risk"
severity = "medium"
observed = "The ten-second receipt deadline aborts the supplied signal and notifies the user, but check still awaits read before releasing global activeReaders. ChainTradeProvider.readReceipt only checks the signal between viem awaits without passing it to RPC transport. Four slow/hung lookups can hold all scheduler slots past deadline, including after close."
expected = "Receipt recovery must bound actual request lifecycle while preserving the global four-reader limit and allowing other attempts to progress after timeout or session disposal."
proposal = "Coordinate recovery.ts and transaction-controls/providers.ts with genuinely cancellable, deadline-bounded transport for every receipt/provenance read. Settle jobs and release slots exactly once after transport termination; do not release capacity while requests remain live. Prove four slow real RPC reads, timeout, close and recovery of a later attempt."
owner_domain = 4

[finding.015]
file = "apps/launchpad/web/src/widgets/trading/trade-panel.tsx"
line = 79
class = "runtime-risk"
severity = "medium"
observed = "When alternate-unit conversion returns null, onAmountChange passes the original display text to t.setAmount as a native amount. convertByPrice rejects outDecimals above 36 while ChainTradeProvider accepts token decimals up to 77. Selling such a token in displayed USDL can quote the same digits as token units instead of rejecting conversion."
expected = "Input in the displayed unit must either convert exactly for the accepted asset metadata or remain invalid; conversion failure must never silently reinterpret that unit."
proposal = "In apps/launchpad/web/src/widgets/trading/trade-panel.tsx retain failed alternate conversion as explicit invalid input and disable review/submission. Align supported scales with trade-panel-parts.tsx and provider metadata, preserve exact arithmetic and prove high-decimal sell inputs and malformed decimal text in the real surface."
owner_domain = 4

[finding.016]
file = "services/launchpad/livestream/internal/streams/usage.go"
line = 128
class = "config-drift"
severity = "medium"
observed = "BudgetPolicy.Validate and RecordUsage accept nonnegative big.Rat strings such as 1/2. MonthlyUnits is passed unchanged into $1::numeric in EmitBudgetAlerts and usage strings enter numeric columns. PostgreSQL rejects rational notation, so accepted configuration can break budget alerts or usage ingestion."
expected = "Accepted persisted budget/usage strings must round-trip PostgreSQL numeric and retain exact monetary units without floating-point conversion."
proposal = "In services/launchpad/livestream/internal/streams/usage.go require bounded canonical decimal strings or exact normalization to an explicit supported numeric scale before storage. Share the representation across policy and ingestion, then prove decimals and rejected rational/exponent edge cases using actual PostgreSQL writes and alert generation."
