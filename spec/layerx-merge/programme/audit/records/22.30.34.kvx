[finding.008]
file = "services/launchpad/livestream/internal/streams/provision_worker.go"
line = 89
class = "restart-recovery"
severity = "medium"
observed = "The worker durably sets create_sent=true before CreateCorrelated. A crash in that gap, or a definite provider rejection leaving no correlated allocation, prevents future attempts from changing create_sent from false. The operation keeps returning provider_create_ambiguous and holds its active admission reservation."
expected = "Duplicate allocation must remain forbidden, but durable provisioning needs an authorized recovery path when allocation is proven absent after a crash or rejection."
proposal = "Add a durable ambiguity-resolution operation in services/launchpad/livestream/internal/streams that records provider-confirmed nonallocation or verified adoption with revision/lease checks, safely resuming or releasing admission. Expose an actionable owner/operator state and prove crash-before-send, rejection, adoption and restart without blind create retries."
owner_domain = 4

[finding.009]
file = "services/launchpad/livestream/internal/app/app.go"
line = 89
class = "runtime-risk"
severity = "medium"
observed = "decodeStudioWebhook maps stream.idle to terminal ENDED, while ReconcileWorker maps an inactive provider to READY unless termination is intended. LifecycleStore ignores later events for ENDED and the poller excludes ENDED, so a temporary broadcaster disconnect has different permanent outcomes depending on the observation path."
expected = "Webhook and polling observations of the same provider inactivity must share a lifecycle policy; temporary inactive playback must remain resumable if reconciliation treats it as a ready stream."
proposal = "Define one inactivity/termination mapping shared by services/launchpad/livestream/internal/app/app.go and internal/streams/reconcile_worker.go. Reserve ENDED for explicit termination evidence and expose reconnect semantics to creators. Prove idle then started, reordered poll/webhook observations and restart using real provider-state payloads."
owner_domain = 4

