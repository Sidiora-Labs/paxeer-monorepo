blocking = ["upgrade-query-forwarding", "latest-consensus-proof", "misbehaviour-file-decode", "upgrade-cli-proof-encoding", "genesis-receipt-loss", "consensus-states-pagination", "consensus-heights-pagination", "header-validator-pagination", "self-consensus-validator-pagination"]
requirements = ["15272.1", "6865.1", "6865.2", "6866.1", "6866.2", "6867.1", "6867.2"]
produces_reviewed = 617
consumes_reviewed = 233
distinct_interfaces_reviewed = 633
interface_coverage = "Reviewed 439 Go exports, 68 error codes, 36 CLI commands, 36 IBC callbacks, 27 REST routes, 20 metrics and 7 protobuf rows. Optional ICA callbacks are marked unreachable in the registry; active node routes are transfer and Wasm."
requirement_review = "Core Params preserve snake_case JSON names, InboundEnabled/OutboundEnabled keys, optional genesis field four, enabled defaults and actual flag export/import. Registration source assertions are present; no undeclared Go gate was run."
recovery_review = "Persistent host-keyed state, client metadata and capability owner recovery were traced through import/export and capability InitMemStore before IBC block handling. Constructor receipt loss and allocation/decoder issues are findings. Ack/timeout settlement stays enabled when new outbound work is blocked."
security_review = "Reviewed signer validation, scoped capability ownership, concrete membership/nonmembership proofs, packet/ack commitments, ordered counters, unordered receipts, replay/no-op handling and cached callback writes. Transfer consumes canonical ICS20 JSON; Wasm uses opaque packet/ack bytes through matching interfaces."
retired_review = "Executable members have no retired LayerX daemon or public-router dependency. The port Router is an in-process IBC callback map; v100 types are intentional migration inputs. Root documentation still describes the retired split deployment."
qualification_limit = "Static pre-upgrade audit only. The declared build records source revision and the declared verification checks record/graph consistency; neither is an interchain runtime test campaign."

