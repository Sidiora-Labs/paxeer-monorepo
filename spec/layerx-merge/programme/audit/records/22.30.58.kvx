[finding.upgrade-query-forwarding]
file = "interchain/modules/core/keeper/grpc_query.go"
line = 0
class = "interface-mismatch"
severity = "high"
observed = "The aggregate Keeper has no UpgradedConsensusState forwarder. AppModule.RegisterServices registers that Keeper for the generated client Query service, so dispatch reaches its nil embedded types.QueryServer instead of ClientKeeper.UpgradedConsensusState. The generated gateway advertises GET /ibc/core/client/v1/upgraded_consensus_states on this broken path."
expected = "The registered upgraded-consensus gRPC and REST methods must reach the concrete client keeper and return a declared response or typed missing-state error without a nil-interface panic."
proposal = "Add an explicit UpgradedConsensusState method in interchain/modules/core/keeper/grpc_query.go forwarding to ClientKeeper; exercise the real AppModule registration through gRPC and the generated gateway with stored and missing upgrade consensus state."
owner_domain = 6
interface = "6.rest-ibc-client-upgradedconsensusstate"

[finding.nil-query-embedding]
file = "interchain/modules/core/keeper/keeper.go"
line = 27
class = "runtime-risk"
severity = "medium"
observed = "Keeper embeds types.QueryServer but NewKeeper never initializes that interface. The compile-time QueryServer assertion succeeds through promoted methods even when generated handlers are missing, as with UpgradedConsensusState, allowing a runtime nil-interface panic instead of a compile-time failure."
expected = "The production server must implement every generated query explicitly so an added or omitted handler cannot silently inherit an uninitialized implementation."
proposal = "Remove the embedded QueryServer fallback from interchain/modules/core/keeper/keeper.go after adding the missing forwarder, retain the compile-time assertion and add a real aggregate service registration regression."
owner_domain = 6

[finding.latest-consensus-proof]
file = "interchain/modules/core/02-client/client/utils/utils.go"
line = 73
class = "interface-mismatch"
severity = "high"
observed = "QueryConsensusState ignores latestHeight when prove is true and passes the supplied height directly to QueryConsensusStateABCI. The CLI leaves that height at 0-0 for --latest-height and defaults prove to true, so a valid latest query targets consensusStates/0-0 instead of the current state."
expected = "The latest-height option must select the same current consensus state on both transports, with a proof authenticating that exact state at the reported query revision."
proposal = "Resolve latest client height at a pinned snapshot before constructing the consensus proof key in interchain/modules/core/02-client/client/utils/utils.go; test the real CLI with latest-height and both prove modes against a client containing several consensus heights."
owner_domain = 6
interface = "15.go-interchain-modules-core-02-client-client-utils-query-consensus-state-j57"

[finding.misbehaviour-file-decode]
file = "interchain/modules/core/02-client/client/cli/tx.go"
line = 155
class = "interface-mismatch"
severity = "high"
observed = "The misbehaviour command passes misbehaviour rather than &misbehaviour to UnmarshalInterfaceJSON after reading the advertised file argument. Parsing the filename as inline JSON already failed, leaving a nil interface, so the file decoder has no destination for the produced concrete misbehaviour."
expected = "Registered misbehaviour JSON supplied in the documented file argument must yield the same exported.Misbehaviour and transaction as equivalent inline JSON."
proposal = "Pass the interface destination pointer in interchain/modules/core/02-client/client/cli/tx.go and test concrete registered misbehaviour JSON through an actual file, CLI decoding and MsgSubmitMisbehaviour construction, including malformed-file rejection."
owner_domain = 6
interface = "6.cli-ibc-02-client-misbehaviour-j37"

[finding.upgrade-cli-proof-encoding]
file = "interchain/modules/core/02-client/client/cli/tx.go"
line = 224
class = "interface-mismatch"
severity = "high"
observed = "NewUpgradeClientCmd converts proof arguments directly with []byte(args[3]) and []byte(args[4]). QueryTendermintProof emits protobuf MerkleProof bytes, byte fields in JSON are base64, and Tendermint VerifyUpgradeAndUpdateState consumes binary protobuf with cdc.Unmarshal. Normal textual proof output is submitted as the wrong bytes and arbitrary binary proofs cannot reliably travel through argv."
expected = "Operators must be able to transfer real query-produced upgrade proofs into the command through a documented reversible encoding yielding the exact binary bytes accepted by the upgrade verifier."
proposal = "Define strict base64 proof decoding or explicit binary proof-file inputs in interchain/modules/core/02-client/client/cli/tx.go, update help and test real produced proofs through CLI transaction construction and the Tendermint upgrade verifier, rejecting malformed encodings."
owner_domain = 6
interface = "6.cli-ibc-02-client-upgrade-j37"

[finding.genesis-receipt-loss]
file = "interchain/modules/core/04-channel/types/genesis.go"
line = 50
class = "interface-mismatch"
severity = "high"
observed = "NewGenesisState accepts receipts []PacketState but omits Receipts from its returned struct. Recovery genesis constructed through this public API silently loses unordered-channel replay receipts, which InitGenesis then cannot import. Ordinary channel ExportGenesis uses a direct struct and is not this lossy constructor path."
expected = "Every supplied receipt must survive constructor, serialization and import so already-received unordered packets remain rejected after recovery."
proposal = "Assign Receipts: receipts in interchain/modules/core/04-channel/types/genesis.go and test a real unordered receive through constructor, JSON serialization and a fresh keeper import, asserting retained receipt and replay rejection."
owner_domain = 6
interface = "15.go-interchain-modules-core-04-channel-types-new-genesis-state-j57"

[finding.consensus-states-pagination]
file = "interchain/modules/core/02-client/keeper/grpc_query.go"
line = 178
class = "interface-mismatch"
severity = "high"
observed = "ConsensusStates appends every eligible callback result without checking accumulate. The consumed SDK FilteredPaginate calls onResult with accumulate=false for offset-skipped records and records scanned beyond the limit, so the response contains states outside its declared page and may exceed the requested limit."
expected = "ConsensusStates must return only selected page members while Pagination.Total and NextKey describe the filtered collection; metadata keys must stay excluded."
proposal = "Honor accumulate before appending in interchain/modules/core/02-client/keeper/grpc_query.go and query real stored consensus states with offset, key continuation, reverse ordering and count_total, asserting exact membership, bounds and no cross-page duplication."
owner_domain = 6
interface = "6.rest-ibc-client-consensusstates"

[finding.consensus-heights-pagination]
file = "interchain/modules/core/02-client/keeper/grpc_query.go"
line = 217
