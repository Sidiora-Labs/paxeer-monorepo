[task]
id = "22.31.374"
audit = "22.30.129"
finding = "002"
proof = "test_repair_374_import_selection; test_repair_374_host_status_classification; test_repair_374_signature_status; test_repair_374_signature_terminal"
proof_status = "Authored, not qualified: finding 002 remains open until the declared gate executes and passes the signature cases."
path = "Published RFC 8032 and Wycheproof signatures -> SDK guests -> signature_verify host -> kernel call -> signed receipt -> canonical guest-refusal evidence; valid, wrong-message and malformed-key cases for Ed25519 and secp256k1 in C, Rust and AssemblyScript."
baseline = "No pristine-tree verify was run: the ordered task rules prohibit gates before implementation, and the previous attempt is already applied; its recorded build failed source lint before any test executed."
qualification = "The runner records the candidate revision, command, exit and private log for hf-build and hf-done."
toolchain = "C wasm clang/lld, Rust wasm32-unknown-unknown, AssemblyScript asc 0.27.31, and the existing native kernel harness dependencies."
wiring_c = "programs/sdk/c/include/layerx/program.h, owning domain 13: publish LXP_PROGRAM_ERR_VERIFY_FAILED = -6 in LXP_PROGRAM_STATUS_LIST; this task declares it in src/abi.c because include/ is outside scope."
wiring_as = "programs/sdk/assemblyscript/assembly/error.ts, owning domain 13: preserve -6 in abiStatus; the versioned signature helpers already return the exact host status used by this cross-language proof."
import_selection = "src/host.h defaults to ABI 1 and includes src/host_versioned.h only for newer selections; versioned.c explicitly selects ABI 4, and the versioned header guards each import group at its introduction version. The existing source and binary lint checks remain enabled."
wiring_harness = "Makefile programs-sdk-c, owning domain 13: build and link the existing kernel harness and the C, Rust and AssemblyScript signature guests before test execution so the signature proof needs no runtime subprocess toolchain or pre-existing native artifact."
constraint = "The carried-over signature_status.py invokes subprocess toolchains; its real kernel proof cannot satisfy step 7 until wiring_harness is supplied, and it is retained without deleting or skipping its assertions."

