new_settlement_section_cap = 131072
new_settlement_payload_cap = 131064
former_state_cap = 196608
new_state_cap = 245760
headroom_bytes = 2544
capacities = "ROOM_CAPACITY=16, ASK_CAPACITY=64, BID_CAPACITY=128, DEAL_CAPACITY=16 and every record encoding are unchanged"

[section_owners]
write = "state::encode_room_market_parts frames prefix/book; rooms::apply writes the book; rewards::apply_fund/apply/Call::commit and apply_split_payout write fixed F06 and carry its tail; aggregation::apply writes F05 current/history; epoch::reserve/open/history and closure carry or change F06/F05; bonds::apply writes F06 and the book; roster carries settlement"
read = "state::room_market and settlement_rewards; rewards::FundingView/View and EpochRows; aggregation::view/captured_aggregation; epoch, closure, roster; bonds, rooms, placement and canary read RoomBook; laps reads RoomBook and carries settlement (lap records live in Control); queries reads F06/F05 and the room book"
assertion = "rooms::SETTLEMENT_MAX_BYTES <= Section::SettlementClaims.payload_cap() is checked at compile time; REWARD_STATE_BYTES already includes the bounded payout overlay"

[consumers]
section = "STATE_SECTION_CAPS[3]=131072; Section::payload_cap subtracts its unchanged 8-byte header"
state = "MAX_STATE_BYTES=245760; all six charged caps sum to it; reputation::COMMON_CAP derives from MAX_STATE_BYTES"
scratch = "Section-derived caps propagate to aggregation, rewards, rooms, bonds, epoch, closure, reputation_transition and dispatch; MAX_STATE_BYTES propagates to the guest current/next Arena, codec PREIMAGE, epoch state workspaces and dispatch rebind buffers"
guest = "The guest Arena declares current and next buffers using MAX_STATE_BYTES and scratch using dispatch::SCRATCH_BYTES; codec PREIMAGE declares a third MAX_STATE_BYTES buffer. No independent numeric memory declaration needs widening. The generated Wasm memory declaration is checked by real metered instantiation"
capture = "queries::FULL_CAPTURE_CHUNKS derives ceil(MAX_STATE_BYTES/MAX_CHUNK_BYTES)=30; full capture, maximum chunk offsets, framing and one-past-limit refusals follow the new bound"
cases = "canonical_contract, aggregation_contract, state_contract, f04_canonical, market_policy_codec, view_binding, f11_rooms_and_deals, reputation_lifecycle, reputation_vectors and the lib packaging-domain assertion retain their boundary assertions using the new bound or constants"
runtime = "activity_budget.rs: 196608 means three simultaneously live 65536-byte Wasm pages in unrelated call graphs, not the market state bound; all declarations and assertions retain their original values, with the distinction recorded beside the depth-three test"

[protocol]
program_state_bound_name = "layerx_program_sdk::MAX_STORAGE_VALUE_BYTES / layerx_programs_runtime::storage::MAX_STORAGE_VALUE_BYTES"
program_state_bound_bytes = 1048576
program_state = "245760 <= 1048576; a compile-time assertion in src/lib.rs and the settlement_capacity test enforce this storage-value protocol bound"
activity_memory_bound_name = "layerx_programs_runtime::meter::DEFAULT_MEMORY_BYTES / DeclaredBudget::protocol_maximum().memory_bytes()"
activity_memory_bound_bytes = 16777216
memory = "settlement_capacity asserts the total of current/next/PREIMAGE, dispatch scratch, event and result buffers fits 16777216 and instantiates the rebuilt full guest under ResourceBudget::declared(), checking actual compiler memory including SDK statics and stack"

[deployment]
