payout_max_bytes = 8009
payout_derivation = "9-byte tag + 64*99 credit bytes + 16*104 cursor bytes; this region overlays 11 trailing epoch rows INSIDE REWARD_STATE_BYTES, so it is not added twice"
payout_owner = "src/rewards.rs PAYOUT_REGION_MAX_BYTES, PAYOUT_REGION_AT, PAYOUT_END, EpochRows::has_payouts, rewards::enable_payouts and RewardState::check"
f05_current_max_bytes = 2200
f05_history_max_bytes = 3586
f05_joint_max_bytes = 5786
