handler = "node/upgrades.go: mergeStoreUpgrades adds LayerXProgramsStoreKey and LayerXHostStoreKey; mergePrecompileGate enables 0x101D only at MergeUpgrade; continueMergeUpgradePlan installs hosted guest ABI 5"
upgrade_name = "precompiles/common/precompiles.go defines MergeUpgrade=v7.0, the repository name of the requested 7.0.0 upgrade"
conclusion = "The recorded deployment precedes the merge, which introduces both program storage and its precompile; no market program state exists on that pre-merge network, so changing these section offsets needs no stored-state migration. This is source/deployment-record evidence, not a new live-chain observation"

