room_book_max_bytes = 79460
book_derivation = "20 + ROOM_CAPACITY*ROOM_RECORD_BYTES + ASK_CAPACITY*193 + BID_CAPACITY*162 + DEAL_CAPACITY*(146+36*32) + BID_CAPACITY*169; the existing bound also covers compressed posted-bond identities and sparse adjustments"
room_joint_framing_bytes = 13
framing_derivation = "u32 book length + 9-byte PAXAI/F11 suffix; the reward prefix and F05 tail have no additional outer framing"
settlement_max_bytes = 128520
sum = "43261 (including payouts) + 5786 + 79460 + 13 = 128520"
former_settlement_payload_cap = 81912
shortfall_bytes = 46608
growth_bytes = 49152
rounding = "ceil(46608/4096)*4096 = 49152"
