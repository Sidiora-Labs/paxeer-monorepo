[repair.22.31.262]
audit = "22.30.128"
qualification = "hf-build followed by hf-done; gate ledger holds revision, command, exit and private evidence"
baseline = "Carried attempt 2: five native-path tests failed because required committed recordings were absent; two restore/ABI tests passed. The supplied prior qualification is the unchanged baseline; it was not rerun."
live-registration = "live_registration_native_funding_activation_execution"
included-transaction = "included_transaction_binds_signer_target_payload_result_and_native_id"
usage-state-shape = "usage_state_shape_native_kind_two_ledger_and_chunked_events"
activation-receipt = "activation_receipt_authenticates_native_funded_to_active_history"
terminal-key = "terminal_key_native_destruction_survives_node_store_reopen"
restore-authority = "restore_case::restore_authority_reopens_storage_and_restricts_resumed_abi"
wiring-client = "Programs client owner, precompiles/layerxprograms/submit.go: transport AuthenticatedSandboxReceiptEvidence from native submission, signed Ethereum transaction, signer-binding and pre-lease proofs; contract-mediated invocations need authenticated execution traces and are refused by the direct-call verifier."
wiring-requirement = "Programs/spec owner: update spec/layerx-merge requirement 13048 to name mounted Programs terminal key ts||lease; spec edits are outside this task scope."
producer-evidence = "Committed hex transcripts were captured through actual Programs-v4 native registration and precompile EVM calls after make paxd-native-libs: canonical native activity and IDs, signed Ethereum/node transaction, response, store values and LXUR event frames. Real storev2 MemIAVL stores were closed, reopened and queried for membership proofs. The Cargo gate only reads these recordings."
recording-provenance = "Generation used temporary Go overlays outside the candidate to observe precompile submissions and receipts, and invoke the production expiry finalizer. The primary fixture funds, activates and successfully executes guest ABI 3; the terminal fixture spends its 66234-unit escrow through real execution before native destruction at batch 201 and host/store reopen. No helper project or native artifact is carried."
gotcha-truncation = "SandboxSubmission::decode must reject payload lengths below 36 before reading the lease ID, including a valid four-byte operation header."
gotcha-guest-abi = "Module registration ABI and guest ABI are distinct: use the runtime ABI policy with the native registration bound rather than the obsolete guest-ABI-2 ceiling."
gotcha-recordings = "Attempt 1 dynamically generated all native recordings in a target directory and carried none; a continuation cannot qualify five native-path assertions without those real recordings or authority to regenerate them."

terminal-archive = "Native destruction must preserve complete canonical history beyond the 1024-byte module value limit: d||kind||lease stores LXDA1, u32 length and SHA-256 blob address. The terminal test verifies both reopened membership proofs, full Destroyed lease decoding and the terminal-bound archive digest."
wiring-refund = "Programs/native owner: src/modules/programs/sandbox_expiry.c refund handling receives a tenant principal from host_ffi.rs while account lookup uses account IDs; validate tenant-to-asset-account resolution for positive refunds. This terminal fixture uses a legitimately exhausted escrow and proves no positive-refund behavior."
gotcha-native-archive = "A native active lease has 857 canonical bytes; expire plus destroy history reaches 1071, so archiving it directly as a 1024-byte module value refuses terminal production. Use an authenticated content-addressed blob descriptor without widening the native bound."

gotcha-native-usage-frame = "Native publish_settlement appends the receipt digest before emitting LXUR chunks: event verification binds canonical receipt plus digest, including its total framed length, to the authenticated kind-2 ledger."
qualification-first = "Revision 35abfe87d80e077cd591a18d3948073abe8908f5 built successfully; hf-done exited 1 in /out/logs/verify-1.log with six tests passing and usage_state_shape_native_kind_two_ledger_and_chunked_events refusing native receipt-plus-digest event framing. The decoder was repaired without changing the test assertions."
