[repair.22.31.259]
audit = "22.30.126"
base_revision = "4299cb15eced23eb9a839162acd11e9a937edd05"
mode = "BUILD"
baseline = "The integration test was absent on the starting tree; no baseline run is claimed because the explicit implementation-first, hf-build then hf-done order and bounded gate budget prohibit an initial verify run."
evidence = "The runner records the exact candidate revision, command, exit and private evidence location in /out/run/gates.jsonl and the final response."
receipt-abi = "receipt_abi_real_guests_persist_and_decode: actual admitted ABI 2-5 guests, public projection, canonical storage/reopen and strict public decode; unallocated revisions, truncation and trailing bytes refuse."
trace-encoding = "trace_encoding_public_and_native_writers_are_identical: actual traced ABI 1-5 guests, allocating/native reserved writer byte equality, durable reopen, public terminal decode and arbitration-chain verification."
continuation-state = "continuation_state_refuses_tables_and_dropped_segments_before_capture and continuation_supported_memory_and_globals_survive_fresh_instantiation: execute table mutation and segment drops, refuse lossy capture before/after reopening, preserve supported memory/globals across fresh instantiation."
pinned-dispute-versions = "pinned_dispute_versions_replay_after_fee_update_upgrade_and_archive_restart: real sandbox replay capture, SDK profile/billing encoding, retained immutable artifacts and historical fees, durable archive reopen after current code/fee replacement, real opening/transition/terminal adjudication."
profiled-call-scheduler = "profiled_call_scheduler_binds_complete_activity_and_executes: canonical CALL producer, shared C ABI wrapper decoder, capability access planner, real profiled guest execution and full-activity binding; malformed wrappers, foreign programs and detached capabilities refuse."
sandbox-storage-alias = "sandbox_storage_alias_leases_and_ordinary_call_survive_store_restart: native namespace C ABI agrees with Rust; actual guest writes the same key in two leases and an ordinary namespace, durable store closes/reopens and each actual guest read remains independent."
sandbox-event-principal = "sandbox_event_principal_and_guest_log_bytes_survive_receipt_replay: actual event-emitting guest, native C ABI envelope/principal validator, canonical receipt evidence persists/reopens with the derived principal."
guest-log-unwired = "sandbox_event_principal_and_guest_log_bytes_survive_receipt_replay: actual guest event producer, durable canonical envelope transport and production log codec preserve exact topics, kind and payload after replay; Go consumes the already committed ProgramOutcome.Events and checks native envelope digests."
sandbox-terminal-decoder = "sandbox_terminal_decoder_persists_usage_and_authenticates_receipt_and_transfer: real guest execution and escrow transfer root, production shared native settlement/usage codecs, durable close/reopen, public decoder and receipt-binding authentication; mismatched receipt/root/usage and malformed wrappers refuse."
coverage = "The declared Rust gate exercises production runtime, codecs, stores and shared C ABI exports without subprocesses or native artifacts; it does not compile or execute the C controller, Go precompile, market guest or separate proof-client workspace."
wiring_abi = "precompiles/layerxprograms/abi.json (owning domain EVM precompiles): replace the legacy digest-only guest event schema with ProgramGuestEvent(bytes32,bytes32,bytes), indexed program id, and align Go precompile end-to-end/replay expectations with committed payloads."
wiring_proof = "services/agent/crates/layerx-proof/src/program.rs (owning domain agent/proof): authenticate DecodedTerminal::sandbox_settlement against included receipt activity/program/kind/usage/usage-digest/transfer-root and qualify native receipt publication through proof verification."
wiring_retention = "src/modules/programs/deploy.c and src/kernel/blob.c (owning domains Programs deployment and kernel storage): retain profile-pinned immutable code blobs until all dependent disputes close; the historical native resolver authenticates each requested hash but cannot own out-of-scope garbage collection."
wiring_native = "tests/programs/call.c and precompiles/layerxprograms/events_call_test.go (owning domains Programs native and EVM precompiles): qualify profiled scheduling, two-lease occupancy/recovery and actual event-emitting sandbox settlement through the 0x101D consumer and receipt replay using the shared contracts."
wiring_market = "programs/crates/layerx-programs-market/tests (owning domain Programs market): extend compiled market claim/reveal/timeout recovery qualification across code and fee governance changes; the bounded runtime gate qualifies its real host adjudicator rather than invoking a subprocess Wasm toolchain."
gotcha_1 = "Sandbox usage receipt production is in a dependent crate whose manifest and usage module are outside scope; settlement tests use the production bridge codec and real execution/transfer root with structured host receipt bindings, without claiming a full lease ledger or native controller run."
gotcha_2 = "Failed native calls retain their frozen empty LXP/programs/events/v1 envelope; Go accepts only that exact empty shape alongside the canonical LayerX guest-event domain."
gotcha_3 = "The shared reserved evidence writer also needs ProgramFailure::append_canonical in ordinary Rust builds; its historical host-ffi gate is removed without changing encoding."
gotcha_4 = "Integration tests must use Storage::protocol_namespace_entries, the existing public persistence reader, rather than the private native bridge namespace_entries helper; the exact namespace contents assertion is preserved."

continuation_baseline = "Attempt 1 verify ran all nine cases: six passed; continuation_state_refuses_tables_and_dropped_segments_before_capture, profiled_call_scheduler_binds_complete_activity_and_executes and sandbox_terminal_decoder_persists_usage_and_authenticates_receipt_and_transfer failed; the supplied runner seed records the exact prior failure output."
gotcha_5 = "The engine trace translator admits integer operands only; use admitted table.copy to mutate indirect-call targets rather than a ref.func/table.set fixture that admission rejects before continuation capture."
gotcha_6 = "Sandbox escrow charges require the account derived from host program and sandbox-lease-escrow/v1 plus lease; arbitrary nonzero account fixtures correctly fail program authority validation."

wiring_profile_allocator = "programs/vendor/wasmi-0.31.2/src/store.rs and src/engine/executor.rs (owning domain Programs engine): clear boundary_authorized after finalizing a returned export so the next root export preflights its own frame and locals; preserve prior observations and cumulative budgets."
profiled_fixture = "The scheduler test binds wrappers with empty and nonempty calldata through the shared native decoder and planner, executes the empty-calldata profile against initialized guest memory and asserts its real replay record and storage/response, and independently executes nonempty ordinary calldata; it does not claim allocator-to-entry profiling is repaired."

