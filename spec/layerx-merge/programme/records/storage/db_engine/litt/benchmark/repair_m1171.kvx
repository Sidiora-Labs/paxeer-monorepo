baseline = "No baseline verification was run: the explicit gate order forbids verification before implementation and forbids running verify_cmd by hand; no prior gate ledger or in-scope changes existed. No pre-change test result is claimed."
evidence = "The runner records the exact candidate revision, command, exit and private log in the hf-build/hf-done ledger and cg spec done record."
