[task.22.33.1129]
findings = ["22.30.49/018", "22.30.49/021"]
proof_018 = ["TestRepairM_1129_StreamImport", "TestRepairM_1129_StreamMissingParams", "TestRepairM_1129_StreamMalformedAddress"]
proof_021 = ["TestRepairM_1129_GasTargetGovernance", "TestRepairM_1129_GenesisFeeBounds", "TestRepairM_1129_DynamicFee"]
repair_018 = "A stream must contain at least one chunk; every chunk must carry complete valid Params, including repeated-parameter and state chunks. Nil, empty, missing, partial and invalid parameter streams are refused; a valid chunk never clears an earlier error. Validation drains the input so an unbuffered sender finishes even on failure. Every address association must be present and carry a valid bech32 Pax address and hexadecimal Ethereum address; malformed input returns an error through GenesisState.Validate and ValidateStream without must-parse calls."
repair_021 = "Validate uint64 gas targets in the inclusive range 0..MaxInt64 through Params.Validate and current and legacy parameter key tables; preserve zero's existing disabled-adjustment semantics. Reject uninitialized decimals and a minimum fee greater than the maximum in full parameter validation."
path_018 = "DefaultGenesis and real keeper parameter/address exports -> production JSON codec -> unbuffered ValidateStream -> production JSON codec -> real xevm Keeper.InitGenesis with real auth keeper and separate in-memory SDK stores for xevm, auth and params. Mixed invalid orderings are refused at the validation boundary; accepted chunks preserve imported parameters and addresses."
path_021 = "LegacyAmino governance value encoding -> real parameter Subspace.Validate/Update -> keeper parameter reads; GenesisState JSON round trip -> Params.Validate -> real Keeper.InitGenesis -> AdjustDynamicBaseFeePerGas -> stored next base fee. Tests cover zero, one and MaxInt64 targets, signed overflow, wrong types, equal and inverted fee bounds, exact upward/downward clamps and accepted fee bounds."
baseline = "Not run: the explicit ordered gate instructions require implementation before build/verify and forbid running verify_cmd by hand first. Initial gate.json reports zero build and verification runs and no gate ledger exists; no pre-change test failures are claimed."
wiring_018 = "engine/deps/xevm/keeper/genesis.go, owning domain 5 (node runtime): before exposing Giga streaming recovery, add a streaming importer that validates all chunks with xevm/types.ValidateStream before mutating state; no xevm stream importer or caller of this helper exists in this tree. modules/evm/module.go uses its own distinct types, outside this task."
wiring_021 = "sdk/x/params/proposal_handler.go and engine/deps/xevm/keeper/params.go, owning domain 5 (governance/node runtime): validate the combined candidate with xevm/types.Params.Validate atomically after all governance key updates and before SetParams; single-key ValidatorFn has no context or access to the other stored fee bound, so it cannot enforce the cross-field invariant."
gotcha = "Uninitialized sdk.Dec values panic in arithmetic comparisons; malformed stream Params must return errors before those comparisons. The required baseline run conflicts with the explicit gate order, so it is not run. Root GOTCHA.kvx and spec records are outside the authorized scope; task-local notes are retained here."
qualification_repair = "The first hf-done run at 74b3613459626b51eed11b2e5f6509fdbf00fdb4 failed compilation (exit 1, /out/logs/verify-1.log): SDK ProtoCodec JSON methods are MarshalAsJSON/UnmarshalAsJSON. Correct the test calls; retain every assertion. Use a nonempty stored whitelist fixture so full parameter equality also proves whitelist transport without nil/empty JSON representation ambiguity."
evidence = "The runner gate ledger records the exact candidate revision, commands, exit codes and private logs. Qualification requires hf-done passing on the same candidate as hf-build."

continuation_repair = "Attempt 1 candidate 22495e0ea8585a7e5597a22ec49b79ade8ea5e53 failed TestRepairM_1129_StreamImport/repeated_params_and_state: the shared auth/xevm test store let account records appear in exported address mappings. Give auth, params and xevm distinct real stores, assert exported addresses parse, and validate associations in production before keeper import. TestRepairM_1129_StreamMalformedAddress refuses the 105-byte bech32 case, empty and malformed addresses, and nil associations, including mixed valid/invalid stream orderings."
