[meta]
title = "Explorer dimensions"
task = "22.44.105"
surface = "Paxscan explorer"
earlier_revision = "3b53e67a9ca454825ae852bd0dcb0cb7c9ae9821"
present_revision = "c9a555a1dd0161e022779ec4ebf3ba632b09c167"
first_series_explorer_change = "020e8cd1f23101b0db485f6bb79cce1863cb8829"

[measurement]
widths = [390, 1280, 1440, 1920, 2560]
height = 900
scheme = "dark"
mode = "default"
units = "CSS pixels for geometry; token values retain computed CSS units."
part_fields = ["left", "top", "width", "height", "fontSize", "lineHeight"]
difference_threshold = 1
views = 89
token_widths = [390, 1440, 1920]
token_reference = "Global tokens resolve against the home body typography and the probe containing block; sizes-full gives its width at each viewport. Local tokens use the sampled element font and parent width."
absent_value = "absent"
local_token_views = "Local tokens sample each rendered content template; /404 represents the shared not-found template."
control_reference = "Control metrics sample the home header, hero, recent activity and footer."
local_scope = "CONTENT identifies the page content region; tag, component scope, part and nearest data-label identify each group; semicolons separate distinct values within a group."
difference_rule = "A numeric field differs by more than one CSS pixel; changes between a line-height keyword and a number also count."

[parts]
home_main = "The home content container contains the ticker, hero, statistics and recent activity."
navigation = "The desktop navigation landmark and the closed mobile menu button represent the responsive navigation boundary."
first_heading = "The first visible heading in the page content represents the heading part."
primary_control = "The first visible page control represents the primary control; the home view uses the hero search field or search button."

[availability.chains]
routes = ["/chains", "/chains/[id]"]
earlier_content = ["Loading chains…", "Loading chain…"]
configuration = "Virtual-chain reads require an API configuration that this surface does not provide."

[coverage]
initial_states = "Each measured view uses its initial state."
block_details = "The additional block details view selects tab=index."
token_metadata = "The additional token metadata view selects tab=metadata."
empty_lists = ["Verified contracts", "Advanced filter transactions"]
token_markets = "The token route opens on its markets view."
block_transactions = "The block route opens on its transactions view."
unavailable_template = "Configured unavailable routes use the not-found template and retain their individual route measurements."
not_found_routes = ["/404", "/account/api-key", "/account/custom-abi", "/account/merits", "/account/tag-address", "/account/verified-addresses", "/account/watchlist", "/accounts/label/[slug]", "/apps/[id]", "/apps", "/auth/profile", "/batches/[number]", "/batches/celestia/[height]/[commitment]", "/batches", "/blobs/[hash]", "/chain/[chain_slug]/accounts/label/[slug]", "/chain/[chain_slug]/advanced-filter", "/chain/[chain_slug]/block/[height_or_hash]", "/chain/[chain_slug]/block/countdown/[height]", "/chain/[chain_slug]/block/countdown", "/chain/[chain_slug]/csv-export", "/chain/[chain_slug]/op/[hash]", "/chain/[chain_slug]/token/[hash]", "/chain/[chain_slug]/token/[hash]/instance/[id]", "/chain/[chain_slug]/tx/[hash]", "/chain/[chain_slug]/visualize/sol2uml", "/cross-chain-tx/[id]", "/csv-export", "/deposits", "/dispute-games", "/epochs/[number]", "/epochs", "/essential-dapps/[id]", "/hot-contracts", "/interop-messages", "/mud-worlds", "/name-services/clusters/[name]", "/name-services/domains/[name]", "/name-services", "/op/[hash]", "/operation/[id]", "/operations", "/ops", "/output-roots", "/pools/[hash]", "/pools", "/public-tags/submit", "/txn-withdrawals", "/txs/kettle/[hash]", "/uptime", "/validators/[id]", "/validators", "/withdrawals"]
clock = "Age labels and the countdown follow the runtime clock."
not_found_route_data_status = 404

[earlier_configuration]
server_output = "Non-standalone"
transpiled_packages = ["react-syntax-highlighter", "@ark-ui/react"]
application_sources = "The earlier application sources retain the named revision."
optimized_package_imports = ["@chakra-ui/react", "@ark-ui/react"]
theme_initialization_script_sha256 = "PbrzcDgamFVCwFbb0hKpXUmeKK7b36Wr/22Kv+urCfU="
theme_initialization = "The script-src policy includes the theme initialization script hash."

[availability.home-main-landmark]
view = "/"
earlier = "main"
present = "absent"
present_content_container = "div"
content_selector = "[data-label=\"hero\"] >> xpath=.."

[token.aspect-ratios-golden]
