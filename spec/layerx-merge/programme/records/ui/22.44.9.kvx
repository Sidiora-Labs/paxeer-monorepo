[view.tokens]
route = "/tokens"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
modes = ["standard", "reduced motion", "doubled text", "keyboard"]
mode_widths = [360]
mode_schemes = ["light"]
observations = ["At 360px with doubled text in the light scheme the document measures 532px wide.", "At 360px in the light and dark schemes, some icon or select triggers have no accessible name.", "At 360px these controls have a dimension below 44px: All (49 by 32px), Fungible (85 by 32px), NFT (57 by 32px), Bridged (80 by 32px), Filter (32 by 32px), icon or input (313 by 32px), Clear (20 by 20px), copy (20 by 20px), 50 (80 by 32px)."]

