[geometry_cause.labels]
description = "Visible statistics filter labels retain their text lines and spacing above the controls."

[geometry_cause.home_control]
description = "The native home anchor measures the visible 16px / 24px control with a 32px top margin; the earlier selected wrapper includes that margin around a nested button with the same visible text size."

