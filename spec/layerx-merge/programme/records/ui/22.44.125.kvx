full_mode_views = ["/api-docs", "/gas-tracker", "/stats/[id]", "/stats"]
default_mode_views = ["/uptime", "/validators/[id]", "/validators"]

[presentation]
statistics = "The sidebar measures 200px on desktop. Chart grids use two desktop columns and reflow with enlarged text; plots retain a 230px minimum and default cards measure 324px."
recent_blocks = "The section heading precedes a separate right-aligned View all line. The table retains a 480px minimum inside its focusable scrolling region and keeps its sticky first column."
intervals = "Desktop interval buttons retain 26px default and 34px large heights; mobile selectors retain 44px touch areas."
gas = "Price cards use one column below the desktop breakpoint and three above it. The chart link centers its mobile touch area on the existing text line."
chart_detail = "The plot uses its 50dvh track, including landscape viewports."
retained = "Focus marks, labels, roles, landmarks, loading and empty states, reduced motion, contrast colors, scrollbar space and current statistics content remain."

