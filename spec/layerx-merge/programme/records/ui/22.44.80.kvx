[meta]
title = "Developer dashboard shell and dimensions"
geometry_widths = [390, 1280, 1440, 1920, 2560]
viewport_height = 900
scheme = "dark"
unit = "CSS px"
tolerance = 1

[shell]
desktop_sidebar_width = 248
desktop_header_height = 64
phone_header_height = 69
phone_bottom_navigation_height = 105
navigation = ["Overview", "Keys", "Logs", "Webhooks"]
sections = ["Overview", "Keys", "Logs", "Webhooks", "Payments"]
reserved_controls = ["Search", "Notifications", "Explorer", "Settings", "New action"]
reserved_controls_description = "Controls without a destination or action are hidden and retain their space in the shared shell."
account = "The shared sidebar displays the principal and account caption."
phone_title = "The phone header exposes the page title to assistive technology."

[content]
session = "Sign-in uses the runtime gateway tenant and offers the token form and the browser-key action available on the device."
keys = "Key issuance, rotation and revocation retain their fields, confirmation and secret dialogs."
loading = "Loading uses separate usage, statistics and activity cards."
empty = "An overview without an active key displays the quota explanation and Open Keys action; empty activity displays its named state."
accessibility = "Focus indicators, labels, landmarks, control states, contrast colours and reduced motion remain available."

