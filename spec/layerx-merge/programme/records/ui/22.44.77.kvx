[meta]
title = "Developer dashboard dimensions"
earlier_revision = "0a12288ba4379bdb504a1c037807b1f6be2b95e6"
present_revision = "2242f0365ffa1ffee00893c4030e79ab67fb8f52"
first_series_change = "532d7e93583f7a0d9076fcd42efa7f30fdda2e04"
geometry_widths = [390, 1280, 1440, 1920, 2560]
style_widths = [390, 1440, 1920]
viewport_height = 900
scheme = "dark"
unit = "CSS px"
tolerance = 1

[dimensions]
geometry_columns = ["left", "top", "width", "height", "fontSize", "lineHeight"]
styles = "Text sizes and line heights, non-text spacing, control border-box heights and corner radii are computed from visible elements."
tokens = "Size tokens use computed document values and inline theme aliases at each listed width; line-height tokens retain their unitless ratios."
initial_views = ["dashboard", "empty", "loading", "unavailable", "sign-in", "sign-in-copy-refused", "sign-in-unconfigured", "sign-in-unsupported", "sign-in-storage", "sign-in-key-loading", "sign-in-token-busy", "sign-in-key-busy", "sign-in-held-busy", "sign-out", "sign-out-busy", "sign-out-refused", "receipt-loading", "receipt-unavailable", "requests-long", "payments-long", "health", "keys-secret", "keys-revoked"]
additional_templates = ["dashboard/keys", "dashboard/requests", "dashboard/webhooks", "dashboard/payments", "dashboard/receipt"]
first_heading = "The first visible heading in the main region is selected by heading level."
footer = "Neither document has a footer or contentinfo landmark. The earlier desktop sidebar has a settings and account region at its lower edge."

[parts.earlier_only]
names = ["desktop-sidebar", "desktop-sidebar-settings-account", "mobile-bottom-navigation", "mobile-new-action", "header-search", "header-notifications", "gateway-tenant-field", "separate-create-key-and-held-key-controls"]
description = "The desktop sidebar is visible at 1440 and 1920; the bottom navigation is visible at 390. The sign-in card contains a gateway tenant field and separate key creation and held-key controls."

[parts.present_only]
names = ["mobile-page-title", "tab-strip-continuation", "header-principal", "empty-usage-manage-keys", "loading-usage-card", "loading-stat-cards", "loading-activity-card", "loading-heading", "key-issuance-card", "key-quota-fields", "key-scope-options", "key-rotate-control", "key-revoke-control", "key-secret-dialog", "key-secret-dialog-footer", "key-revocation-dialog", "key-revocation-dialog-footer"]
description = "The present dashboard has a title in its mobile header, a principal beside the session control, separate loading cards, key issuance fields, row actions and dialogs with footer controls."

[parts.absent]
health = ["header", "navigation", "main", "heading", "primary-control", "card", "table-or-list-row", "footer"]
sign_in_navigation = "The earlier shell navigation is present; the present sign-in views have no navigation region."
loading_heading = "The earlier loading card has skeleton rows and no content heading."
empty_activity = "Both initial empty views have no activity row."
tables = "Both dashboards use list roles for their data rows."

