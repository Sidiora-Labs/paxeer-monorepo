[surface]
name = "Explorer token and search views"
views = 5
named_states = 7
view_state_combinations = 12
geometry_views = 6
geometry_widths = [390, 1280, 1440, 1920, 2560]

[dimensions]
transfer_table_minimum_width = 950
transfer_chain_column_width = 38
token_transfer_transaction_column_width = 280
token_transfer_method_column_width = 200
token_transfer_address_column_widths = [220, 380]
transfer_address_maximum_widths = [220, 320]
transfer_token_id_maximum_width = 140
instance_media_maximum_width = 250
method_block_margin = 3
transfer_value_top_margin = 7
filter_input_start_space = 36
filter_input_end_space = 32
filter_input_touch_end_space = 44
touch_width_limit = 834

[presentation]
integration = "Token and search dimensions coexist with the shared explorer surface configuration and lifecycle."
typography = "Text retains the fixed sizes and line heights of the explorer."
controls = "Controls retain their desktop dimensions and a 44px minimum touch area through 834px."
filter_input = "The search field reserves its adornment space before hydration."
inline_controls = "The token ID copy target extends around its mark without a clipping wrapper."
enlarged_text = "Transfer entities wrap their controls when their text and touch areas need another line."
routes = "Token, token instance, token transfer, token list and search routes retain their content and navigation."
accessibility = "Focus marks, labels, roles, landmarks, control states, loading and empty states, reduced motion and the reserved scrollbar track remain present."
shared_layouts = "Token titles and detail cards use local dimensions while address and contract views retain their shared dimensions."

[coverage]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = [844, 390]
schemes = ["light", "dark"]
modes = ["default", "reduced-motion", "double-text", "keyboard"]
device_renders = 408
render_result = "pass"
findings = 0

[geometry_capture]
views = 6
renders = 30
result = "pass"
findings = 0

[geometry_comparison]
