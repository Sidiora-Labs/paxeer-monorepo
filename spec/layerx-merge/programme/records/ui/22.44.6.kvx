[manifest]
task = "22.44.6"
surface = "Paxscan explorer home, statistics, blocks, validators, epochs, gas and Paxeer X views"
paths = ["apps/explorer/ui/block", "apps/explorer/ui/blockCountdown", "apps/explorer/ui/blocks", "apps/explorer/ui/epochs", "apps/explorer/ui/gasTracker", "apps/explorer/ui/home", "apps/explorer/ui/paxeerX", "apps/explorer/ui/stats", "apps/explorer/ui/validators"]

