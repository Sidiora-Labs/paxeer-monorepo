[guide.respect_os_text_scale]
id = "respect-os-text-scale"
directories = ["apps/explorer/ui/block", "apps/explorer/ui/blockCountdown", "apps/explorer/ui/blocks", "apps/explorer/ui/epochs", "apps/explorer/ui/gasTracker", "apps/explorer/ui/home", "apps/explorer/ui/paxeerX", "apps/explorer/ui/stats", "apps/explorer/ui/validators"]

[patterns]
layout = "Intrinsic grids and wrapping rows follow the content container."
tables = "Named keyboard scroll regions preserve table headers and local horizontal navigation."
controls = "Chart selectors use native buttons; filters expose visible labels; reward controls expose expansion state."
disclosures = "Gas questions use details and summary; quorum certificates use the shared accordion."
media = "Chart descriptions include dated values; promotional images reserve their dimensions."
schemes = "Surface, text, focus and status roles serve light and dark schemes."

[guide.dialog]
id = "dialog"
directories = ["apps/explorer/ui/block", "apps/explorer/ui/home"]

[guide.menu]
id = "menu"
directories = ["apps/explorer/ui/stats", "apps/explorer/ui/blocks"]

[guide.spinner]
id = "spinner"
directories = ["apps/explorer/ui/block", "apps/explorer/ui/epochs", "apps/explorer/ui/stats"]

[guide.interest_triggered_tooltips]
id = "interest-triggered-tooltips"
directories = ["apps/explorer/ui/block", "apps/explorer/ui/home", "apps/explorer/ui/gasTracker", "apps/explorer/ui/stats"]

[guide.select_menu_interaction]
id = "select-menu-interaction"
directories = ["apps/explorer/ui/stats", "apps/explorer/ui/paxeerX/account"]

[guide.form_factor_adaptation]
id = "form-factor-adaptation"
directories = ["apps/explorer/ui/blockCountdown", "apps/explorer/ui/blocks", "apps/explorer/ui/epochs", "apps/explorer/ui/validators", "apps/explorer/ui/home", "apps/explorer/ui/stats", "apps/explorer/ui/paxeerX"]

[guide.defer_rendering_heavy_content]
id = "defer-rendering-heavy-content"
directories = ["apps/explorer/ui/epochs", "apps/explorer/ui/paxeerX"]

[guide.visually_stable_font_fallbacks]
id = "visually-stable-font-fallbacks"
directories = ["apps/explorer/ui/home", "apps/explorer/ui/stats"]

[view.home]
route = "/"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
text_scale = 2
reduced_motion = true
keyboard = true

[view.statistics]
content = "Chart search, section menu, keyboard interval controls, chart grid and recent blocks"
route = "/stats"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
text_scale = 2
reduced_motion = true
keyboard = true

[view.statistic]
route = "/stats/averageGasPrice"
