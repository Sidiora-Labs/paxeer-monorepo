[shell]
sections = ["1", "2", "4", "5", "6", "9"]
bars = "Canvas top bar and activity strip, a hairline rail, labelled phone destinations and a quiet legal and activity footer retain their positions."
actions = "Create uses the accent; sign in and deposit use the inverse surface. Current destinations use neutral surfaces and text."
colour_mode = "Dark, Light and Device are available in the account menu and lower rail, signed in or signed out. The chosen mode applies immediately and persists on the device."
layers = "Search, sign in and account content use sheets on phones and centred dialogs above phone widths. Menus use translucent surfaces and blur."
cookies = "A compact card sits at the lower left above phone destinations and floating actions, with two lines of text and side-by-side choices."

[coverage]
part = "community"
views = 14
named_states = 1
render_cases = 510
schemes = ["light", "dark"]
modes = ["default", "reduced-motion", "double-text", "keyboard"]

