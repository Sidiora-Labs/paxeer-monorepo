form = "Failed reads keep their section, unknown values and recovery action."

[view.coin_loading]
sections = [1, 5, 7]
form = "Waiting blocks retain the market sections while the coin resolves."

[view.token]
sections = [1, 2, 4, 5, 7]
form = "Creator coins use neutral selection and aligned identity rows; signed-out viewers receive the application empty form."

[view.token_pool]
sections = [1, 2, 4, 5, 7]
form = "The token route shares the coin market layout and chart controls."

[view.token_metadata]
