[screenshots]
count = 142
widths = [360, 768, 1440, 2560]
landscape = [844, 390]
schemes = ["light", "dark"]
additional_modes = ["double-text", "keyboard"]
wrapping = "Verification explanations keep the final phrase together. Percentage suffixes wrap within their value column."
alignment = "Verification information icons align with their headings. Numeric columns align to the right."
layout = "Content, controls and columns fit their containers in both schemes."

[presentation]
verification = "Contract verification retains its form for unverified contracts. Floating labels keep the required marker visible and selects show keyboard focus."
layout = "The verification form fits its available grid track. Inference displays the shared content loader while its page loads."
fixtures = "Contract bytecode uses the explorer unverified contract fixture."
accounts = "Account supply is expressed in token units. Long mobile balances use numeric ellipsis with the full rounded value in a tooltip."
loading = "Account placeholders include the percentage field, and pagination retains its layout box when there is no following page. Row controls become available with account data."
headers = "Account counts wrap beside the download control. Account and verified-contract content loads with the page."
contracts = "Contract counters use the statistics service where it is configured and the explorer API otherwise. Filters and pagination retain their layout boxes in loading, empty and error states."
wrapping = "Percentages wrap within their available width. Verification headings balance their lines and explanatory text wraps without isolated final words."
paxeer_x = "The canonical activity cursor retains the returned account page while new pages display their loading state."

[guidance]
ids = ["css", "html", "forms", "accessibility", "color", "typography", "dark-mode", "responsive-design", "motion", "performance"]
