[manifest]
task = "22.44.16"
surface = "Trading workspace markets, portfolio, transfers and vaults"
patterns = ["container layouts", "tables and lists", "dialogs", "popovers", "menus", "tooltips", "tabs", "forms and validation", "selects and account lookup", "notifications", "skeletons and spinners", "scroll regions and sticky filters", "theme selection", "icons and images", "typography", "reduced motion"]

