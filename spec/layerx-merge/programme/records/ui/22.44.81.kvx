[surface]
name = "LayerX human web application"
geometry_widths = [390, 1280, 1440, 1920, 2560]
units = "CSS pixels"

[typography]
standard_steps = [12, 14, 16, 18, 20, 24]
standard_line_heights = [16, 20, 24, 28, 28, 32]
component_labels = [9, 10, 11, 13, 15, 17, 32]
scaling = "Text sizes stay fixed across viewport widths."

[layout]
shell = "Desktop navigation occupies 248 pixels and the header occupies 64 pixels. The mobile header and bottom navigation retain their earlier tracks."
touch = "Interactive controls occupy at least 44 pixels at touch widths."
content = "The activity table, empty activity message and closed technical disclosures remain available."
calendar = "Calendar days occupy 36 pixels on desktop and at least 44 pixels at touch widths."
keypad = "Numeric keypad rows occupy 56 pixels; letter labels use 0.18em spacing."
search = "The search screen uses the earlier field padding; the clear control occupies 16 pixels on desktop and at least 44 pixels at touch widths."

[tokens]
shared_size_differences = ["--text-2xl", "--text-2xl--line-height", "--text-base", "--text-lg", "--text-lg--line-height", "--text-sm", "--text-sm--line-height", "--text-xl", "--text-xl--line-height", "--text-xs", "--text-xs--line-height"]
present_only_size_names = ["--drawer-width", "--focus-ring-offset", "--focus-ring-width", "--font-size-body", "--font-size-body-sm", "--font-size-display", "--font-size-label", "--font-size-micro", "--font-size-nano", "--font-size-title", "--font-size-title-sm", "--line-height-body", "--line-height-relaxed", "--line-height-snug", "--line-height-tight", "--lx-radius-lg", "--lx-radius-md", "--lx-radius-sheet", "--lx-radius-sm", "--lx-radius-xl", "--modal-content-max-width", "--notification-list-max-height", "--scrollbar-radius", "--search-content-max-width", "--search-list-max-height", "--space-0", "--space-1", "--space-10", "--space-12", "--space-14", "--space-16", "--space-2", "--space-20", "--space-3", "--space-4", "--space-5", "--space-6", "--space-7", "--space-8", "--space-button-lg", "--space-dialog-max", "--space-dialog-search", "--space-filter", "--space-icon-md", "--space-icon-sm", "--space-notification", "--space-notification-wide", "--space-popover", "--space-sidebar", "--space-summary", "--space-switch", "--space-switch-thumb", "--spacing-button-lg", "--spacing-dialog-max", "--spacing-dialog-search", "--spacing-filter", "--spacing-icon-md", "--spacing-icon-sm", "--spacing-notification", "--spacing-notification-wide", "--spacing-popover", "--spacing-sidebar", "--spacing-summary", "--spacing-switch", "--spacing-switch-thumb", "--table-activity-min-width", "--table-header-height", "--text-body", "--text-body--line-height", "--text-body-sm", "--text-body-sm--line-height", "--text-display", "--text-display--line-height", "--text-label", "--text-label--line-height", "--text-micro", "--text-micro--line-height", "--text-nano", "--text-nano--line-height", "--text-title", "--text-title--line-height", "--text-title-sm", "--text-title-sm--line-height", "--touch-target", "--tracking-wider", "--tracking-widest"]

