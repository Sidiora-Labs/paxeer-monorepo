[surface]
task = "22.44.39"
name = "Trading workspace"
router_page_files = 4
router_page_views = 4
route_paths = 16
views = 20
named_states = 4
routes = ["/", "/auth/callback", "/trade", "/trade/grid", "/trade?symbol=PERP_BTC_USDC", "/markets", "/markets?renderState=empty", "/markets?renderState=loading", "/markets?renderState=error", "/portfolio", "/portfolio/positions", "/portfolio/orders", "/portfolio/assets", "/portfolio/history", "/portfolio/setting", "/portfolio/feeTier", "/portfolio/apiKey", "/privacy", "/terms", "/cookies"]
states = ["wallet-dialog", "language-menu", "funding", "search-empty"]

[coverage]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = [844, 390]
schemes = ["light", "dark"]
modes = ["default", "reduced-motion", "double-text", "keyboard"]
mode_coverage = "Every view and named state uses every mode."

[reference]
