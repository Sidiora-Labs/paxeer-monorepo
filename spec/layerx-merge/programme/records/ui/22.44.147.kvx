[meta]
task = "22.44.147"
product = "Sidiora launchpad"
brief = "spec/layerx-merge/programme/docs/launchpad-ui/design-brief.md"

[presentation]
shared_forms = "Option rows, trading capability states, market table presentation and paired-bar placeholders use shared primitives."
money = "Market values use the dollar sign; quote-token amounts paid, received, held or claimed retain USDL, their scale, precision and compact form."
holders = "Named and unnamed holder rows keep whole column headings, middle-shortened one-line addresses and one-line figures; the table scrolls within its region at phone widths."
stats = "The buyers and sellers frame is absent. The daily buy and sell count placeholder appears only while daily statistics load; known counts retain their bar, aggregate trades retain their line, and volume retains its waiting form."
profile = "Profile tab controls and data placeholders arrive together after the route waiting state; an empty replies list uses the neutral form."
swap_settings = "The device-storage notice uses the primary text colour on the floating settings surface."
tokens = "Intrinsic image dimensions, badge sizes, chart strokes and view proportions use presentation roles."
brief_values = "Dark faint text uses #9f9faa and control edges use #81818e; text-link labels may wrap."
floating_actions = "Opaque phone creation actions remain above navigation, with room for focused form controls and footer links to scroll into view."

[availability]
explore = "Historical all-time-high progress where no source supplies it."
coin = "Holder profit, average entry, amount bought and profit filters; all-time-high market value for pools without complete daily history."
home = "Screener fee, sniper and bundle figures."
terminal = "Historical all-time-high market value, accumulated fees and graduation progress where no source supplies them."

[views.home]
home = "home; sections 1, 2, 3, 4, 5 and 7; default; search-dialog, sign-in-dialog, paste-address-dialog, search-filled, callouts-tab, top-tab. Coins first at phone widths; flush board columns on wide screens, direction washes and neutral first states."
