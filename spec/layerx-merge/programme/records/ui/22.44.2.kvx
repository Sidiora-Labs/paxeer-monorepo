[manifest]
task = "22.44.2"
surface = "Paxscan explorer shell, navigation, search and page entry points"
paths = ["apps/explorer/pages", "apps/explorer/ui/snippets"]

[patterns]
layout = "Headers wrap their controls; footer groups form an intrinsic grid."
search = "Suggestion rows follow the search container; result sections scroll independently."
navigation = "Desktop groups use popovers; mobile groups use exclusive disclosure elements."
forms = "Email and confirmation code fields expose labels, autofill hints and validation feedback."
settings = "Labeled buttons expose the selected theme and address icon."
media = "Network images reserve their dimensions; decorative icons stay outside accessible names."
motion = "Scrolling and shell transitions honor reduced motion."

[guide.css]
id = "css"
directories = ["apps/explorer/pages", "apps/explorer/ui/snippets"]

[guide.html]
id = "html"
directories = ["apps/explorer/pages", "apps/explorer/ui/snippets"]

[guide.forms]
id = "forms"
directories = ["apps/explorer/ui/snippets/auth", "apps/explorer/ui/snippets/searchBar"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/explorer/ui/snippets"]

[guide.color]
id = "color"
directories = ["apps/explorer/ui/snippets"]

[guide.typography]
id = "typography"
directories = ["apps/explorer/pages", "apps/explorer/ui/snippets"]

[guide.dark_mode]
id = "dark-mode"
directories = ["apps/explorer/ui/snippets"]

[guide.responsive_design]
id = "responsive-design"
directories = ["apps/explorer/pages", "apps/explorer/ui/snippets"]

[guide.motion]
id = "motion"
directories = ["apps/explorer/ui/snippets"]

[guide.performance]
id = "performance"
directories = ["apps/explorer/pages", "apps/explorer/ui/snippets/searchBar"]

[guide.css_layout]
id = "css-layout"
directories = ["apps/explorer/ui/snippets/header", "apps/explorer/ui/snippets/footer", "apps/explorer/ui/snippets/searchBar"]

[guide.size_aware_styling]
id = "size-aware-styling"
directories = ["apps/explorer/ui/snippets/searchBar/SearchBarSuggest", "apps/explorer/ui/snippets/navigation"]

[guide.dialog]
id = "dialog"
directories = ["apps/explorer/ui/snippets/searchBar", "apps/explorer/ui/snippets/user/wallet"]

[guide.menu]
id = "menu"
directories = ["apps/explorer/ui/snippets/navigation", "apps/explorer/ui/snippets/topBar"]

[guide.navbar]
id = "navbar"
directories = ["apps/explorer/ui/snippets/header", "apps/explorer/ui/snippets/navigation"]

[guide.navigation_drawer]
id = "navigation-drawer"
directories = ["apps/explorer/ui/snippets/header", "apps/explorer/ui/snippets/navigation/mobile"]

[guide.accordion]
id = "accordion"
directories = ["apps/explorer/ui/snippets/navigation/mobile"]

[guide.tabs]
id = "tabs"
directories = ["apps/explorer/ui/snippets/searchBar/SearchBarSuggest"]

[guide.validate_input_after_interaction]
id = "validate-input-after-interaction"
directories = ["apps/explorer/ui/snippets/auth"]

[guide.autofill_sign_in_form]
id = "autofill-sign-in-form"
directories = ["apps/explorer/ui/snippets/auth"]

[guide.sms_otp_form]
id = "sms-otp-form"
directories = ["apps/explorer/ui/snippets/auth/fields"]

[guide.scrollability_affordance_hints]
id = "scrollability-affordance-hints"
directories = ["apps/explorer/ui/snippets/searchBar", "apps/explorer/ui/snippets/topBar/settings"]

[guide.dark_mode_toggle]
id = "dark-mode-toggle"
directories = ["apps/explorer/ui/snippets/topBar"]

[guide.icons]
id = "icons"
directories = ["apps/explorer/ui/snippets"]

[guide.respect_os_text_scale]
id = "respect-os-text-scale"
directories = ["apps/explorer/pages", "apps/explorer/ui/snippets"]

[guide.visually_stable_font_fallbacks]
id = "visually-stable-font-fallbacks"
directories = ["apps/explorer/pages"]

[guide.interest_triggered_tooltips]
id = "interest-triggered-tooltips"
directories = ["apps/explorer/ui/snippets/topBar/settings", "apps/explorer/ui/snippets/footer"]

