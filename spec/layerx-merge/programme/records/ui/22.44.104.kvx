[meta]
title = "Launchpad dimensions"
task = "22.44.104"
surface = "Sidiora Launchpad"
earlier_revision = "653fb0e7b6bb7e5281b80ca330530f01f5287e5c"
present_revision = "53d8d80d72af332a6adb7f4cf3bc54cdf0ce3b72"
first_series_web_change = "c4e253c2b8e26cb6ff1dfb9dcadc7c539b5b2356"

[measurement]
widths = [390, 1280, 1440, 1920, 2560]
height = 900
scheme = "dark"
mode = "default"
units = "CSS pixels"
part_fields = ["left", "top", "width", "height", "fontSize", "lineHeight"]
difference_threshold = 1
views = 34
token_widths = [390, 1440, 1920]
token_reference = "Home view, default body typography and no named query container."
token_values = "Computed CSS property strings; font-size-adjust is unitless and shadows retain their CSS color and length components."
absent_value = "absent"
difference_rule = "Numeric fields differ by more than one CSS pixel; a changed line-height keyword or part presence is listed separately."
part_count_scope = "Difference counts cover shared and responsive parts present in both states; presence changes have separate counts."

[parts]
shared = 450
footer = "The terminal views have no footer landmark; other measured templates include the shell footer."
first_heading = "The first visible heading in the main region is selected by heading level."
responsive_parts = "Presence arrays follow the five measurement widths."

[availability.new]
path = "/new"
earlier_content = "No visible page content"
present_destination = "/explore?preset=new"

[availability.referral]
path = "/r/science"
earlier_content = "No visible page content"
present_destination = "/"

[availability.create-chain]
path = "/create/chain"
earlier_content = "Page not found"
present_content = "Launch a chain and token"

