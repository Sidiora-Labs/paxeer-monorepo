[manifest]
task = "22.44.15"
surface = "The perps order entry, orders, positions, take profit and stop loss, and leverage workspace"

[guide.forms]
id = "forms"
directories = ["apps/perps/packages/ui-order-entry", "apps/perps/packages/ui-orders", "apps/perps/packages/ui-positions", "apps/perps/packages/ui-tpsl", "apps/perps/packages/ui-leverage"]

