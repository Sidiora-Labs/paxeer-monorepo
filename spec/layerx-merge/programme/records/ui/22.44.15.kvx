[view.orders]
route = "/trade/orders"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]

[view.positions]
route = "/trade/positions"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]

[view.leverage]
route = "/trade/leverage"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
