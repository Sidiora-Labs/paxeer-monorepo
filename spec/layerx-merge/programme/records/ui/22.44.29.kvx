[manifest]
task = "22.44.29"
surface = "apps/web/src/kit, apps/web/src/shell, apps/web/src/states, apps/web/src/app/globals.css"
status = "served"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
