[manifest]
task = "22.44.22"
surface = "Sidiora Launchpad"
paths = ["apps/launchpad/web/src"]
patterns = ["page layouts and grids", "tables and lists", "dialogs", "popovers and menus", "tooltips", "tabs", "accordions", "forms and validation", "selects and comboboxes", "toasts", "skeletons and spinners", "scroll areas and sticky content", "color schemes", "icons", "images", "fonts", "motion", "carousels"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/launchpad/web/src/app", "apps/launchpad/web/src/core/app-foundation", "apps/launchpad/web/src/ui", "apps/launchpad/web/src/shell", "apps/launchpad/web/src/page-modules", "apps/launchpad/web/src/widgets", "apps/launchpad/web/src/features"]

