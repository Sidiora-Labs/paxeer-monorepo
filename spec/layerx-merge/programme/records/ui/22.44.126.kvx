[meta]
task = "22.44.126"
title = "Explorer chain and cross-chain dimensions"
references = ["22.44.120", "22.44.105", "22.44.90"]

[coverage]
views = 15
named_states = 0
chain_specific_views = 11
virtual_chain_views = 2
cross_chain_views = 2
schemes = ["light", "dark"]
modes = ["default"]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
height = 900
landscape = [844, 390]

[layout]
entity_links = "Entity links center their mobile touch area on the text line without adding that area to the row height."
timestamps = "The time-format control centers its mobile touch area on its 20px mark; date text wraps within its available width."
lifecycle = "Lifecycle headings retain their 20px line box and existing text size, spacing and status colours."
virtual_chain_identifiers = "Invalid virtual-chain identifiers use the body text style and wrap within the available width."
desktop = "Controls above 834px retain their intrinsic and size-variant dimensions."
scrollbar = "The page reserves the scrollbar track."
copy_target = "The cross-chain hash row lets its copy target extend around the text line while the hash content handles truncation."

[geometry]
measured_views = 13
widths = [390, 1280, 1440, 1920, 2560]
measured_parts = 655
differing_parts = 627
equal_parts = 28
scrollbar = "The reserved 15px scrollbar track reduces fluid widths and moves centered content by 7.5px."
touch = "Controls through 834px retain 44px minimum touch areas; footer links increase their tracks, and the timestamp wraps within the narrower value track."
native_home_link = "One native home link carries a 40px desktop control, a 44px touch control and a separate 32px top margin. Its 16px text and 24px line box match the visible button inside the earlier 14px / 20px link wrapper, whose 72px box includes the margin."

