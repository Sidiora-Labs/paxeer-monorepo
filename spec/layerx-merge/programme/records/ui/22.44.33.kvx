[manifest]
task = "22.44.33"
surface = "apps/bridge/src"
route = "/"
description = "Paxeer Bridge transfers assets between Paxeer and registered source chains."

[guide.1]
id = "responsive-design"
directories = ["apps/bridge/src/app", "apps/bridge/src/components/bridge"]

[guide.2]
id = "css-layout"
directories = ["apps/bridge/src/app", "apps/bridge/src/components/bridge", "apps/bridge/src/components/trading"]

