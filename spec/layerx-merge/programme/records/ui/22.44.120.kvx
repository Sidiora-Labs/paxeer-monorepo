[token_sites]
foundation = "toolkit/theme/foundations/sizes.ts defines touchTarget as 2.75rem."
global = "toolkit/theme/globalCss.ts applies 44px minimum block and inline sizes through 834px and compensates inline control margins at those widths."
filter_clear = "toolkit/components/filters/FilterInput.tsx keeps its 44px clear-control width through 834px."
search_results = "ui/searchResults/SearchResultListItem.tsx keeps its 44px row minimum through 834px and its text line minimum above."
gas_chart = "ui/gasTracker/GasTrackerChart.tsx keeps its 44px period-control minimums through 834px."
editor_offsets = "ui/shared/monaco/CodeEditorSearch.tsx uses a 44px overlay offset through 834px and 35px above; CodeEditorSideBar.tsx uses the 44px drawer-control edge through 834px and 24px above."
hint_spacing = "ui/shared/DetailedInfo/DetailedInfo.tsx reserves space around its 20px hint mark through 834px."
inline_margins = "ui/home/HomeTableSection.tsx and ui/home/TickerStrip.tsx center 44px links on their text lines through 834px."
sizing_cases = "toolkit/theme/visualSystem.spec.ts, toolkit/theme/recipes/recipes.spec.ts, ui/stats/RecentBlocks.spec.tsx and ui/shared/DetailedInfo/DetailedInfo.spec.tsx assert the viewport rule, desktop dimensions and inline spacing."

