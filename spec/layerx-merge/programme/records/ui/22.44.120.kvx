[meta]
task = "22.44.120"
title = "Explorer shell and home dimensions"
reference = "22.44.105"

[touch]
token = "touchTarget"
value = "2.75rem"
maximum_width = 834
minimum_pixels = 44
policy = "The global control rule supplies the touch minimum through 834px; controls above 834px use their intrinsic or size-variant dimensions."
inline_controls = "Copy and transaction information controls center their touch area on the visible mark with compensating block margins. Home row links and ticker links center their touch area on the text line."
footer_links = "Footer column links measure 28px above 834px and 44px through 834px."

[typography]
display = "40px / 44px"
h1 = "28px / 32px"
h2 = "20px / 24px"
body = "14px / 20px"
small = "13px / 18px"
label = "11px / 16px"
number = "13px / 18px"
stat_value = "24px / 28px"
heading_xl = "32px / 36px"
heading_lg = "24px / 28px"
heading_md = "18px / 24px"
heading_sm = "16px / 24px"
heading_xs = "14px / 20px"
text_xl = "20px / 28px"
text_md = "16px / 24px"
text_sm = "14px / 20px"
text_xs = "12px / 16px"
font_adjustment = "Text uses the typeface metrics without an inherited font-size adjustment."
font_loading = "InterFallback matches Inter with a 107.4% local Arial or Liberation Sans face and fixed ascent, descent and line-gap metrics, preserving statistic-label wrapping while Inter loads."
heading_tokens = "fluidDisplay, fluidH1 and fluidH2 retain their names and carry fixed values at every width."

[shell]
desktop_header = "56px content height with a 1px border, 24px horizontal padding, 12px between groups and 8px from search to utility controls."
navigation = "32px navigation items above 834px."
header_utilities = "20px icon controls above 834px."
search = "52px hero and 36px compact fields, 36px start padding and 87px desktop end padding."
network_marks = "30px icon and 120px by 24px logo, with touch minimums through 834px."
footer = "One column below 768px and three columns from 768px; column links have a 28px desktop minimum."
not_found = "The not-found view uses the 32px / 36px heading, a 200px by 100px icon and one native home link with a 40px desktop height and 32px top margin."
scrollbar = "The reserved scrollbar track remains."
mobile_utilities = "Market prices and utility controls wrap within the navigation drawer; desktop prices and utility controls retain their unbroken groups."

[recipes]
button = "Desktop sizes are 20px, 24px, 32px and 40px for 2xs, xs, sm and md."
input = "Desktop sizes are 32px, 40px and 60px for sm, md and lg."
select = "The trigger uses its 32px or 60px size variable; menu entries use their text and padding."
tabs = "The strip uses 32px and 40px sizes; a pill grows from its strip minimum with its label."
icon_button = "The compact mark uses 20px and the md control uses 32px above 834px."
menu = "Entries use their text and variant padding above 834px."

[home]
hero_search_width = "640px maximum"
statistics_columns = "Two below 1000px and five from 1000px."
history_columns = "One below 1000px and two from 1000px."
history_chart_track = "160px below 1000px and 200px from 1000px."
activity_columns = "One below 1000px and two from 1000px, with a 24px desktop column gap."
statistic_values = "Statistic values keep their 28px line height and complete text and separator nodes, fit prefixes and units at 24, 20, 18, 16 or 14px steps that follow the root size, and wrap at 14px without ellipsis or hidden overflow."
statistics_loading = "Linked tiles retain the same block wrapper while loading; the wrapper becomes a native link when the count is available."
block_copy_mark = "16px"
transaction_copy_mark = "20px"
transaction_information_mark = "24px"
ticker = "The 18px text line retains its 12px block padding."

[showcases]
icon_cards = "100px width, no inner padding and 100px icon marks."
accordion = "400px width bounded by the available width; compact labels stay beside their samples in a 60px track, with a 32px column gap."
sample_labels = "Dialog and popover button labels wrap within the sample column at increased text sizes."
sample_controls = "Dialog and popover sample buttons size to their wrapped content above 32px and 40px minima; home surface coverage is 340 renders."
icon_search = "The visible search label remains above the icon filter."

[desktop_controls]
account_menu_placeholder = "36px by 32px above 834px; 44px minimum through 834px."
previous_next = "24px, including loading placeholders."
scan_pagination = "32px."
editor_search_marks = "20px."
editor_sidebar_toggle = "24px."
editor_tab_close = "20px."
editor_collapse = "20px."
wallet_add = "The requested icon size, including its loading placeholder."
settings_switches = "34px minimum height."
defi_entries = "34px minimum height."
nft_actions = "30px height."
suggestion_categories = "52px minimum height."
suggestion_links = "44px minimum height from their existing content and padding."
assistant_question = "44px minimum height."

