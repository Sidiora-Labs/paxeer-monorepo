[visible_text.w390]
width = 390
scope = "Every distinct computed font-size and line-height pair on text elements with layout boxes in the shared initial template."
columns = ["state", "font size", "line height", "example"]
rows = [
  "earlier | 16px | 24px | Skip to the bridge",
  "earlier | 15px | 22.5px | Paxeer Bridge",
  "earlier | 13px | 19.5px | Connect wallet",
  "earlier | 12px | 16px | Routes open as vaults deploy",
  "earlier | 30px | 36px | Move assets to Paxeer — and back",
  "earlier | 16px | 26px | One bridge for Ethereum, Base, Arbitrum, Optimism, BNB Chain, Polygon, Avalanche, HyperEVM, Solana. Deposits lock in the chain's vault, attestors sign, and the bridged asset lands on Paxeer at 1:1.",
  "earlier | 17px | 21.25px | Bridge",
  "earlier | 14px | 20px | Lock on one chain, mint or release on the other — every crossing is attested by the bridge attestor set.",
  "earlier | 11px | 16.5px | 1 ETH = 1 bridged ETH",
  "earlier | 9px | 12.8571px | ETH",
  "earlier | 20px | 28px | 0.0",
  "earlier | 13px | 17.875px | Destination address",
  "earlier | 18px | 28px | Your transfers",
  "earlier | 14px | 22.75px | A deposit locks the asset in PaxeerXVault on the source chain. A withdrawal burns the bridged denom on Paxeer. Nothing moves on the other side yet.",
  "earlier | 11px | 15.7143px | 0x00000000…001016",
  "earlier | 12px | 19.5px | A note on custody: this is an attested bridge, not a light-client bridge. Funds are held by the vaults and move only against a threshold of attestor signatures, with per-asset caps bounding what can be in flight. Caps and pause state above are read from chain, live.",
  "present | 16px | 24.8px | Skip to the bridge",
  "present | 15px | 18.75px | Paxeer Bridge",
  "present | 14px | 21px | Connect wallet",
  "present | 13px | 18.2px | Routes open as vaults deploy",
  "present | 30.24px | 32.6592px | Move assets to Paxeer — and back",
  "present | 16px | 26px | One bridge for Ethereum, Base, Arbitrum, Optimism, BNB Chain, Polygon, Avalanche, HyperEVM, Solana. Deposits lock in the chain's vault, attestors sign, and the bridged asset lands on Paxeer at 1:1.",
  "present | 12px | 16.2px | 1 ETH = 1 bridged ETH",
  "present | 11px | 17.05px | BA",
  "present | 9px | 13.95px | ETH",
  "present | 18px | 21.6px | 0.0",
  "present | 14px | 19.25px | Destination address",
  "present | 13px | 21.125px | A note on custody: this is an attested bridge, not a light-client bridge. Funds are held by the vaults and move only against a threshold of attestor signatures, with per-asset caps bounding what can be in flight. Caps and pause state above are read from chain, live.",
]

