[comparison]
surface = "Paxeer Bridge"
earlier_revision = "09d3a371ab296780ab63520ca7e26ff242db7837"
present_revision = "2242f0365ffa1ffee00893c4030e79ab67fb8f52"
first_series_change = "44079b53f336dc5f61d156fb9577f88158973313"
geometry_widths = [390, 1280, 1440, 1920, 2560]
token_widths = [390, 1440, 1920]
height = 900
scheme = "dark"
state = "default"
units = "CSS pixels; values retain browser precision."
template = "All five views show the initial deposit page at /. The wallet is disconnected and the browser has no transfer records."
navigation = "At width 390 the navigation part is the home link in the header. At widths 1280, 1440, 1920 and 2560 it is the Bridge navigation landmark."
present_parts = ["import form", "import primary control", "import route select", "import hash input"]
part_availability = "The import form and its controls are visible in the signed-out present state. The earlier signed-out state has no import form. The first route row and the first definition-list item are visible in both states. Transfer-history table rows require a connected wallet and are absent in both initial states."
additional_part = "The skip link is absent from the earlier state and present in the present state."
geometry_values = ["left", "top", "width", "height", "fontSize", "lineHeight"]
difference = "Each geometry row has a difference greater than one pixel in at least one numeric field, a changed normal line-height keyword, or an absent earlier part."

[size_tokens]
scope = "Dimension tokens in dx-theme.css and the inherited Tailwind theme; absent means that state declares no such token."
