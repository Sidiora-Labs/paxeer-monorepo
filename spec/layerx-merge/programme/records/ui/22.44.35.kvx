[manifest]
task = "22.44.35"
surface = "Inference peer, WebAssembly playground and codebase map"
paths = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.css]
id = "css"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.html]
id = "html"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.forms]
id = "forms"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.color]
id = "color"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.typography]
id = "typography"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.dark-mode]
id = "dark-mode"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.responsive-design]
id = "responsive-design"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.motion]
id = "motion"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.performance]
id = "performance"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.css-layout]
id = "css-layout"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.browser-ui-theming]
id = "browser-ui-theming"
directories = ["apps/inference-peer", "tools/wasm-tools/playground/pages", "tools/codebase-map"]

[guide.accordion]
id = "accordion"
directories = ["apps/inference-peer"]

[guide.validate-input-after-interaction]
id = "validate-input-after-interaction"
directories = ["apps/inference-peer"]

[guide.accessible-error-announcement]
id = "accessible-error-announcement"
directories = ["apps/inference-peer"]

[guide.dialog]
id = "dialog"
directories = ["tools/codebase-map"]

[guide.size-aware-styling]
id = "size-aware-styling"
directories = ["apps/inference-peer", "tools/codebase-map"]

[guide.icons]
id = "icons"
directories = ["tools/codebase-map"]

[guide.component-specific-light-dark-theme]
id = "component-specific-light-dark-theme"
directories = ["tools/codebase-map"]

[view.peer-ready]
route = "/apps/inference-peer/index.html"
state = "Device identity and room controls"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = "844x390"
schemes = ["light", "dark"]
text_scales = [100, 200]
motion = ["reduce"]

[view.peer-validation]
route = "/apps/inference-peer/index.html"
state = "Field validation feedback"
