[meta]
title = "Launchpad size tokens and shell"
task = "22.44.106"
units = "CSS pixels"
widths = [390, 1280, 1440, 1920, 2560]

[typography]
text_2xs = [11, 14]
text_xs = [12, 16]
text_sm = [13, 18]
text_base = [14, 20]
text_md = [16, 24]
text_lg = [20, 28]
text_xl = [24, 32]
text_2xl = [32, 40]
text_display = [48, 52]
text_num_sm = [13, 18]
text_num_md = [14, 20]
body = [16, 24]
values = "Each pair gives font size and line height at every viewport width."

[shell]
control_small = 28
control_medium = 36
control_large = 44
header = 48
ticker = 32
navigation_row = 40
column_collapsed = 24
column_gutter = 4
footer = "Copyright, legal links and activity figures share a row at desktop widths, with 11px text and a 14px line height."
touch = "Controls have minimum dimensions of 44px at widths up to 834px."
scrollbar = "The document reserves a stable scrollbar gutter."

[derived_typography]
card_title = [16, 24]
page_title_size = 24
prize_placeholder = [24, 32]
leaderboard_title = "22px below 640px and 24px from 640px."

[home]
layout = "The home region fills the viewport between the header and footer; the feed body scrolls within its available space."

[loading]
layout = "New and explore reserve the coin table while the route loads, with 50 rows before the ranking arrives and the received row count while its details load; each waiting row reserves the coin name and symbol height. Pending footer figures reserve the width of formatted values. Loaded boxes retain their dimensions."

[page_typography]
bounties_title = "24/32px below 768px and 28/36px from 768px."
holder_rewards_title = "28/34px below 640px and 40/46px from 640px."
leaderboard_title_line_height = 56
legal_title = [22, 33]
legal_updated = [11, 14]
legal_paragraph_size = 13
legal_paragraph_line_height = 1.7
pnl_title = [16, 24]
search_input = [14, 20]

[page_controls]
documentation_back_link_height = 16
bounties_back_link_height = 18
compact = "The touch minimum applies to both links up to 834px."
terminal = "The terminal content shares the main region without an additional viewport-height minimum."
column_controls = "Collapsed-column controls stay mounted as column sizes change and remain hidden while their column is open."

[geometry]
widths = [390, 1280, 1440, 1920, 2560]
differing_parts = [441, 362, 367, 373, 369]
comparison = "Parts differ when a position, box dimension, font size or line height differs by more than one CSS pixel from the earlier geometry."
scrollbar = "A stable scrollbar track reserves 15px of inline space at these widths."
touch = "Links and controls reserve at least 44px in each dimension through 834px."
fonts = "Manrope retains its fallback face and optional font loading."

[view.home]
differing_parts = [8, 5, 6, 5, 5]

[part.home.first-heading]
widths = [390, 1280, 1440, 1920, 2560]
selector = "#main-content :is(h1,h2,h3):not(.sr-only):visible >> nth=0"
cause = "The home feed and board keep their current content and responsive placement within the stable scrollbar track."

[part.home.footer]
widths = [390, 1280, 1440, 1920, 2560]
selector = "footer:visible >> nth=0"
cause = "The footer follows the home content layout, shares the inline space after the scrollbar track and reserves 44px legal links through 834px."

[part.home.footer-activity-first-row]
widths = [1280, 1440, 1920, 2560]
selector = "footer dl > div >> nth=0"
cause = "The current six activity figures wrap within the footer after the reserved scrollbar track; their positions follow the page content."

[part.home.footer-navigation-first-link]
widths = [390, 1440]
selector = "footer nav a >> nth=0"
cause = "Legal links use 11/14px Manrope with its fallback face and reserve 44px touch targets through 834px."

[part.home.header]
widths = [390, 1280, 1440, 1920, 2560]
selector = "header:visible >> nth=0"
cause = "The stable scrollbar track reduces available inline space; mobile navigation shares that space among its destinations."

[part.home.main]
widths = [390, 1280, 1440, 1920, 2560]
selector = "#main-content"
cause = "The main region contains the current home content layout within the stable scrollbar track and the mobile touch clearance."

[part.home.navigation]
widths = [390]
selector = "nav:is([aria-label=\"Primary\"],[aria-label=\"Mobile navigation\"]):visible"
cause = "The stable scrollbar track reduces available inline space; mobile navigation shares that space among its destinations."

[part.home.navigation-first-row]
widths = [390]
selector = "nav:is([aria-label=\"Primary\"],[aria-label=\"Mobile navigation\"]):visible li:visible >> nth=0"
cause = "The stable scrollbar track reduces available inline space; mobile navigation shares that space among its destinations."

[part.home.primary-control]
widths = [390]
selector = "#main-content :is(button,a,input,select):not(footer *):visible >> nth=0"
cause = "The home feed and board keep their current content and responsive placement within the stable scrollbar track."

