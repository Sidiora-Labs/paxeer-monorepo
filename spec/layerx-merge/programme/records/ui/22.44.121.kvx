[retained_geometry.1]
view = "/block/[height_or_hash]"
width = 390
parts = ["footer", "footer-column-1-first-link", "footer-column-2-first-link", "footer-column-3-first-link", "main", "primary-control", "transactions-card", "transactions-first-row"]
causes = ["entity content", "scrollbar track", "touch rule"]
description = "The block view retains its identifier, status tags, grouped transaction tabs, count note and focusable transaction scroll region. The reserved scrollbar track reduces available width by 15px and shifts centered content by 7.5px. Through 834px, controls retain 44px touch areas; footer links and calendar controls reserve their touch height."

