[meta]
task = "22.44.121"
title = "Explorer block view dimensions"
reference = "22.44.105"
shared_layout = "Block, token, search and transaction views share entity-link touch geometry and horizontal address pairs."
shared_composition = "Block dimensions compose with shared entity links, transaction rows, asset responses and address responses."

[coverage]
views = 4
named_states = 3
combinations = 7
routes = ["/block/[height_or_hash]", "/block/countdown/[height]", "/block/countdown", "/blocks"]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = [844, 390]
schemes = ["light", "dark"]
modes = ["default", "reduced-motion", "double-text", "keyboard"]
matrix_renders = 238

[dimensions]
entity_links = "Through 834px, entity links center their 44px touch area on the inherited text line without expanding the containing row."
block_transaction_count = "The transaction-count link centers its touch area on the 18px number line."
transaction_addresses = "From and to addresses share one row with their existing truncation, copy controls and labels."
countdown_search = "The block countdown route uses a 360px desktop search width and a 240px illustration."
countdown_heading = "The heading keeps its inline text box beside the block illustration."
countdown_illustration = "The block illustration measures 65 by 75px on mobile and 125 by 140px on desktop."
countdown_timer = "Days, hours, minutes and seconds share one row with 8px gaps around separators and 12px mobile or 16px desktop padding."
countdown_values = "Timer values use 40px mobile and 48px desktop text with a 48px line height; captions use 14px text with a 20px line height."
countdown_statistics = "Remaining blocks and current block share two equal columns separated by 8px."
accessibility = "Focus marks, labels, roles, landmarks, loading and empty states, control states and reduced motion remain available."
scrollbar = "The page retains its reserved scrollbar track."

