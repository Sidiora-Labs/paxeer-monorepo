[layout]
block_identifier = "The block identifier and its copy and QR controls wrap into their earlier rows."
transaction_scroll = "The block transaction table retains its viewport-height scroll region with 96px reserved for surrounding controls."
transaction_loading_space = "The one-row transaction placeholder expands to the returned list; overflow at the page viewport leaves the footer available for browser scroll anchoring."
transaction_loading = "When block transaction loading finishes, a visible footer retains its screen position while the returned rows replace the loading row."
countdown_heading = "The title box retains its 30px mobile and 43px desktop height; the Apple calendar border occupies its existing horizontal padding."

