[view.overview]
route = "/"
state = "Requests used, remaining quota, live keys, endpoints, verified test payments and recent protocol activity."
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]

[view.overview_empty]
route = "/"
state = "Zero quota counters and empty protocol activity."
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]

[view.overview_loading]
route = "/"
state = "Quota and statistics placeholders with loading progress."
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]

[view.overview_unavailable]
route = "/"
