[manifest]
task = "22.44.32"
surface = "services/platform/hosted/dashboard/web"
status = "served"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]
reduced_motion = true
text_scales = [1, 2]
keyboard = true
patterns = ["page layout", "cards", "statistics", "lists", "tabs", "sign-in forms", "field validation", "loading states", "scroll areas", "fonts", "motion", "system colour scheme"]

