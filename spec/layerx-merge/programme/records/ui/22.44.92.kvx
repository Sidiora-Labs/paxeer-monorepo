numeric_alignment = "Primary metrics share a right edge in tablet cards and desktop columns; percentage changes sit alongside them with tabular figures."
phone_layout = "Narrow cards retain stacked labels and values."
presentation = "Headings, text, icons, columns and footer content remain aligned within the light and dark schemes."

[presentation]
ecosystems = "Numeric columns align to the right and retain tabular figures; the desktop table scrolls within its labelled region."
ecosystems_loading = "Initial metrics arrive with the page data; sorting retains the current rows while the next order loads."
diagram = "The contract address selects the Solidity source and its UML diagram."
diagram_loading = "Loading reserves the diagram's existing width and aspect ratio."
missing_address = "A diagram request without a contract address returns the explorer's not-found view."
unavailable = "Unavailable features return the explorer's not-found view and its corresponding data response."

[guidance]
ids = ["css", "html", "forms", "accessibility", "color", "typography", "dark-mode", "responsive-design", "motion", "performance", "css-layout", "responsive-table"]
