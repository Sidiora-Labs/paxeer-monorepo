[landmarks]
authenticated = "The application has a header, primary navigation and a scrolling main region. The footer part is the mobile bottom navigation at 390 pixels and the sidebar settings area at desktop widths."
public = "Welcome, market and explorer views have a main region and navigation. They have no separate header or footer landmark."
wallet_heading = "The wallet fee view uses its fieldset legend as the first content label."
activity = "The activity collection uses its first list row at 390 pixels and its first transaction row in the desktop table. The earlier desktop activity presentation occupies the alert landmark."
wizard = "At 390 pixels the wizard has a Back control and a step body. Desktop widths have a progress list and a summary card with definition rows. The step body provides the summary landmark at 390 pixels."

[presence.activity]
widths = [1280, 1440, 1920, 2560]
earlier = "The activity and empty activity views contain an alert landmark."
present = "The activity view contains a transaction table and its first transaction row. The empty activity view contains an empty-state message."

[presence.activity-error]
widths = [1440, 1920]
earlier = "Technical error details contain a visible definition list with Machine code and Trace identifier rows."
present = "The Technical error details disclosure is closed; its definition list is not visible."

[presence.activity-detail]
widths = [1440, 1920]
earlier = "Technical details contain a visible definition list and an Evidence list with a receipt row."
present = "The Technical details disclosure is closed; its definition list and Evidence list are not visible."

