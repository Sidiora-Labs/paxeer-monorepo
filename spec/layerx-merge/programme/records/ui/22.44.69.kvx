corrections = [
  "Terminal navigation preserves the width of its links and shows keyboard focus.",
  "Discovery, recent pairs, statistics and trades retain their layout while data arrives.",
  "Trade settings remain fixed within the viewport while the document scrolls.",
  "Search and slippage fields use the control edge role in both schemes.",
  "The chart provides one page focus stop and returns focus when Escape is pressed.",
  "Numeric columns align at the right and use tabular figures.",
  "Trenches market-cap and change values stay centered within the existing row."
]

[presentation]
navigation = "Terminal links retain their width within the scrollable navigation and the track accommodates their touch targets."
search = "Coin search and custom slippage fields use the control edge role in both schemes."
settings = "Trade settings use the shared viewport placement and scroll within the available height."
menus = "Swap and terminal menu states include their visible contents."

