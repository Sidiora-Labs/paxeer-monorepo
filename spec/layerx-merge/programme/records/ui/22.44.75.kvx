[surface]
name = "Paxeer Wallet"
earlier_revision = "28aa2fff6fe780d74184a2c755610a8e02de63c9"
present_revision = "fc05f628856fdc263f0ab967742b8822dcc0b8c2"
first_series_change = "148ef0ba97b070367b43561597d6c047dc20b653"
geometry_widths = [390, 1280, 1440, 1920, 2560]
token_widths = [390, 1440, 1920]
height = 900
scheme = "dark"
mode = "default"
unit = "CSS pixels; unitless tokens use ratios."
tolerance = 1

[templates]
initial = "The initial wallet and wallet-shell views show onboarding. Present account pages show sign-in links; earlier account pages show sign-in text. Module pages show navigation, a title and connection status."
present_only = ["inference route", "account sign-in links"]
present_geometry_only = ["auth-callback main region, status message and retry control"]
footer = "The initial pages contain no footer or contentinfo landmark."
onboarding = "Onboarding contains a heading, wallet choice card and brand card. It has no separate header or navigation landmark."
privacy = "The privacy page contains seven lists and a contact link. It has no separate header or navigation."
auth_callback = "The present callback page contains a status message and retry control without a heading, header or navigation."
account = "Account pages contain the Account header and main region. The present main region contains a sign-in link. The header contains the first heading."
module = "Each initial module page contains a main region, navigation, a heading and connection status. The Wallet link is its first enabled control. Connected controls and data rows occur after sign-in."

