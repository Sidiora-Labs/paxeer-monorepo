[cause.scrollbar_track]
description = "The reserved 15px scrollbar track reduces the available width and moves centered content 7.5px left. At 1280px the footer column origins follow the reduced three-column track."

[cause.touch_target]
description = "Controls through 834px measure at least 44px. The menu expands around its mark, the home action adds 4px to the main region, and footer links and utilities retain their touch areas. Above 834px their desktop dimensions apply."

[cause.native_home_action]
description = "The primary-control selector measures the single native home link. Its earlier outer link includes a nested 40px control and its 32px top margin in a 72px box, with outer 14px / 20px text metrics. The visible control retains 16px / 24px text and 155px width; the native link measures 40px high above 834px and 44px through 834px."

