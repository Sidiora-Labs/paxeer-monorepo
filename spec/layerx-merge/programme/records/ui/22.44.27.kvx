[manifest]
task = "22.44.27"
surface = "Wallet demonstration pages"
paths = ["services/wallet/demo/src"]
patterns = ["page layout", "feature cards", "modal dialog", "forms and validation", "provider icons", "progress indicators", "scrollable results", "system colour scheme", "fonts", "motion"]

[guide.1]
id = "css"
directories = ["services/wallet/demo/src/app", "services/wallet/demo/src/components"]

[guide.2]
id = "html"
directories = ["services/wallet/demo/src/app", "services/wallet/demo/src/components"]

