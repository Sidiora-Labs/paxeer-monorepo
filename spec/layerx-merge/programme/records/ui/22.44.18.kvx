[manifest]
task = "22.44.18"
surface = "Trading workspace routes, shared controls and responsive presentation"

[guide.css]
id = "css"
directories = ["apps/perps/packages/ui/src/tailwind", "apps/perps/apps/web/src/styles"]

[guide.html]
id = "html"
directories = ["apps/perps/apps/web/src", "apps/perps/packages/ui"]

[guide.forms]
id = "forms"
directories = ["apps/perps/packages/ui", "apps/perps/packages/ui-order-entry", "apps/perps/packages/ui-transfer", "apps/perps/packages/portfolio"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/perps/apps/web/src", "apps/perps/packages"]

[guide.color]
id = "color"
directories = ["apps/perps/packages/ui/src/tailwind", "apps/perps/apps/web/src/styles", "apps/perps/apps/web/src/theme"]

[guide.typography]
id = "typography"
directories = ["apps/perps/packages/ui/src/tailwind", "apps/perps/apps/web/src/styles", "apps/perps/packages"]

[guide.dark-mode]
id = "dark-mode"
directories = ["apps/perps/apps/web/src/theme", "apps/perps/apps/web/src/styles", "apps/perps/packages/ui/src/tailwind/theme"]

[guide.responsive-design]
id = "responsive-design"
directories = ["apps/perps/apps/web/src", "apps/perps/packages"]

[guide.motion]
id = "motion"
directories = ["apps/perps/packages/ui/src/tailwind", "apps/perps/apps/web/src/styles", "apps/perps/packages"]

[guide.performance]
id = "performance"
directories = ["apps/perps/apps/web/src", "apps/perps/packages"]

[guide.css-layout]
id = "css-layout"
directories = ["apps/perps/packages/ui/src/tailwind", "apps/perps/packages/layout-core", "apps/perps/packages/layout-grid", "apps/perps/packages/layout-split"]

[guide.responsive-table]
id = "responsive-table"
directories = ["apps/perps/packages/markets", "apps/perps/packages/portfolio", "apps/perps/packages/ui-orders", "apps/perps/packages/ui-positions"]

[guide.dialog]
id = "dialog"
directories = ["apps/perps/packages/ui", "apps/perps/packages/ui-connector", "apps/perps/packages/portfolio", "apps/perps/packages/ui-transfer"]

[guide.menu]
id = "menu"
directories = ["apps/perps/packages/ui", "apps/perps/packages/ui-scaffold", "apps/perps/packages/markets", "apps/perps/packages/portfolio"]

[guide.tabs]
id = "tabs"
directories = ["apps/perps/packages/ui", "apps/perps/packages/markets", "apps/perps/packages/portfolio"]

[guide.scrollability]
id = "customize-scrollbar-color-and-thickness"
directories = ["apps/perps/packages/ui/src/tailwind", "apps/perps/apps/web/src/styles"]


