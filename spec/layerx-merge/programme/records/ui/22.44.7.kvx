directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.responsive_table]
id = "responsive-table"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.dialog]
