[manifest]
task = "22.44.7"
surface = "Paxscan explorer account, address, verification and name-service views"
paths = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]
widths = [360, 768, 1440]
schemes = ["light", "dark"]
reduced_motion = true
text_scales = [1, 2]
keyboard = true
patterns = ["page layout and grids", "tables and lists", "dialogs", "popovers", "menus", "tooltips", "tabs", "accordions", "forms and validation", "selects and comboboxes", "skeletons and spinners", "scroll areas and sticky parts", "theme selection", "icons and images", "fonts", "motion"]

[guide.css]
id = "css"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.css_layout]
id = "css-layout"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addresses", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.html]
id = "html"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.forms]
id = "forms"
directories = ["apps/explorer/ui/addressVerification", "apps/explorer/ui/nameServices"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.color]
id = "color"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

