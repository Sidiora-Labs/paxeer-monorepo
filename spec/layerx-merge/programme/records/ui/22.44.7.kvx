[guide.icons]
id = "icons"
directories = ["apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[view.accounts]
route = "/accounts"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address]
route = "/address/[hash]"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-verification]
route = "/account/verified-addresses"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.addresses]
route = "/accounts"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-label-search]
route = "/accounts/label/[slug]"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.name-domain]
route = "/name-services/domains/[name]"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.name-services]
route = "/name-services"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.verified-addresses]
route = "/account/verified-addresses"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-txs]
route = "/address/[hash]?tab=txs"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-internal_txns]
route = "/address/[hash]?tab=internal_txns"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-token_transfers_local]
route = "/address/[hash]?tab=token_transfers_local"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-tokens_erc20]
route = "/address/[hash]?tab=tokens_erc20"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-tokens_nfts_list]
route = "/address/[hash]?tab=tokens_nfts_list"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-tokens_nfts_collection]
route = "/address/[hash]?tab=tokens_nfts_collection"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-analytics]
route = "/address/[hash]?tab=analytics"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-contract_code]
route = "/address/[hash]?tab=contract_code"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-coin_balance_history]
route = "/address/[hash]?tab=coin_balance_history"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-blocks_validated]
route = "/address/[hash]?tab=blocks_validated"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-logs]
route = "/address/[hash]?tab=logs"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.name-directory]
route = "/name-services?tab=directories"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.name-leaderboard]
route = "/name-services?tab=directories&view=leaderboard"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.name-domain-history]
route = "/name-services/domains/[name]?tab=history"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address-verification-signature]
route = "/account/verified-addresses"
