content = "Token holdings dialog and popover"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.name-filters]
route = "/name-services"
content = "Domain protocol, address and status filters"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
