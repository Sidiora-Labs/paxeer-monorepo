directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.dark_mode]
id = "dark-mode"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.responsive_design]
id = "responsive-design"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addressVerification", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.form_factor_adaptation]
id = "form-factor-adaptation"
directories = ["apps/explorer/ui/accounts", "apps/explorer/ui/address", "apps/explorer/ui/addresses", "apps/explorer/ui/addressesLabelSearch", "apps/explorer/ui/nameDomain", "apps/explorer/ui/nameServices", "apps/explorer/ui/verifiedAddresses"]

[guide.motion]
