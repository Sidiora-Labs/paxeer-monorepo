[meta]
title = "Developer dashboard fixed text and compact rows"
geometry_widths = [390, 1280, 1440, 1920, 2560]
viewport_height = 900
scheme = "dark"
unit = "CSS px"
tolerance = 1
touch_width_limit = 834
touch_minimum = 44

[typography]
heading_size = 17
heading_line_height = 22.1
statistic_size = 28
statistic_line_height = 32.2
statistic_label_size = 13
statistic_label_line_height = 19.5
statistic_card_height = 89.6875
desktop_input_minimum = 21
row_title_size = 15
row_title_line_height = 22.5
row_subtitle_size = 13
row_subtitle_line_height = 19.5
row_caption_size = 11
row_caption_line_height = 14.3
content = "Text sizes stay fixed across viewport widths. Headings, statistic values, labels, controls and list tracks use dashboard measures."

[identifiers]
content = "Identifiers that exceed their track through width 834 display their beginning and ending with a middle ellipsis. Assistive technology receives the complete value. Copy actions use the complete value. Longer tracks remain horizontally scrollable."

[shell]
content = "The sidebar, header, main track and section strip retain their dimensions. Controls without an action or destination reserve their space. The section panel displays its keyboard focus outline inside its box."

[content]
session = "Sign-in presents the session token form first and the browser-key action available on the device."
keys = "Key issuance, rotation and revocation retain their fields, confirmation and secret dialogs."
loading = "Loading presents separate usage, statistics and activity cards."
empty = "An overview without an active key displays its quota explanation and Open Keys action, followed by statistics and the activity empty state."
accessibility = "Labels, roles, landmarks, control states, focus indicators, contrast colours and reduced motion remain available."

[comparison]
measures = ["left", "top", "width", "height", "fontSize", "lineHeight"]
content = "At width 390, shared content matches the earlier measures within one pixel. At wider widths the fixed text retains its width-390 size while the earlier text increases with the window. Separate loading cards, the quota explanation and activity empty message, and the token-first sign-in form keep their content."

[width.w390]
part_count = 187
differing_part_count = 33
record_22_44_82_differing_part_count = 117

