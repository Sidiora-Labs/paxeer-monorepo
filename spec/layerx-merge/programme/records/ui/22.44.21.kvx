[manifest]
task = "22.44.21"
surface = "Sidiora Launchpad home, explore, create, profile, bounty, leaderboard and community views"
paths = ["apps/launchpad/web/src/app/auth", "apps/launchpad/web/src/app/bounties", "apps/launchpad/web/src/app/chat", "apps/launchpad/web/src/app/create", "apps/launchpad/web/src/app/docs", "apps/launchpad/web/src/app/explore", "apps/launchpad/web/src/app/holder-rewards", "apps/launchpad/web/src/app/leaderboard", "apps/launchpad/web/src/app/new", "apps/launchpad/web/src/app/profile", "apps/launchpad/web/src/app/r", "apps/launchpad/web/src/app/rewards", "apps/launchpad/web/src/app/search", "apps/launchpad/web/src/app/watchlist", "apps/launchpad/web/src/page-modules/bounties", "apps/launchpad/web/src/page-modules/chat", "apps/launchpad/web/src/page-modules/create", "apps/launchpad/web/src/page-modules/create-chain", "apps/launchpad/web/src/page-modules/explore", "apps/launchpad/web/src/page-modules/holder-rewards", "apps/launchpad/web/src/page-modules/home", "apps/launchpad/web/src/page-modules/leaderboard", "apps/launchpad/web/src/page-modules/new", "apps/launchpad/web/src/page-modules/profile", "apps/launchpad/web/src/page-modules/rewards", "apps/launchpad/web/src/page-modules/search", "apps/launchpad/web/src/page-modules/watchlist", "apps/launchpad/web/src/widgets/bounties", "apps/launchpad/web/src/widgets/chat", "apps/launchpad/web/src/widgets/community-interactions", "apps/launchpad/web/src/widgets/community-safety", "apps/launchpad/web/src/widgets/create", "apps/launchpad/web/src/widgets/create-chain", "apps/launchpad/web/src/widgets/explore", "apps/launchpad/web/src/widgets/holder-rewards", "apps/launchpad/web/src/widgets/home", "apps/launchpad/web/src/widgets/leaderboard", "apps/launchpad/web/src/widgets/profile", "apps/launchpad/web/src/widgets/rewards", "apps/launchpad/web/src/widgets/social", "apps/launchpad/web/src/widgets/wallet-recovery"]

