[manifest]
task = "22.44.5"
surface = "Paxscan explorer page frames"
paths = ["apps/explorer/ui/pages"]
patterns = ["page layouts and grids", "tables and lists", "shared dialogs, popovers, menus and tooltips", "shared tabs and accordions", "labelled forms and validation", "shared selects and comboboxes", "shared notifications and loading states", "scroll regions and sticky toolbars", "shared scheme selection", "icons and images", "typography and motion"]

[guide.css]
id = "css"
directories = ["apps/explorer/ui/pages"]

[guide.html]
id = "html"
directories = ["apps/explorer/ui/pages"]

[guide.forms]
id = "forms"
directories = ["apps/explorer/ui/pages"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/explorer/ui/pages"]

[guide.color]
id = "color"
directories = ["apps/explorer/ui/pages"]

[guide.typography]
id = "typography"
directories = ["apps/explorer/ui/pages"]

[guide.dark_mode]
id = "dark-mode"
directories = ["apps/explorer/ui/pages"]

[guide.responsive_design]
id = "responsive-design"
directories = ["apps/explorer/ui/pages"]

[guide.motion]
id = "motion"
directories = ["apps/explorer/ui/pages"]

[guide.performance]
id = "performance"
directories = ["apps/explorer/ui/pages"]

[guide.css_layout]
id = "css-layout"
directories = ["apps/explorer/ui/pages"]

[guide.responsive_table]
id = "responsive-table"
directories = ["apps/explorer/ui/pages"]

[guide.icons]
id = "icons"
directories = ["apps/explorer/ui/pages"]

[guide.form_factor_adaptation]
id = "form-factor-adaptation"
directories = ["apps/explorer/ui/pages"]

[guide.respect_os_text_scale]
id = "respect-os-text-scale"
directories = ["apps/explorer/ui/pages"]

[guide.menu]
id = "menu"
directories = ["apps/explorer/ui/pages"]

[guide.validate_input_after_interaction]
id = "validate-input-after-interaction"
directories = ["apps/explorer/ui/pages"]

[guide.accessible_error_announcement]
id = "accessible-error-announcement"
directories = ["apps/explorer/ui/pages"]

[guide.scrollspy]
id = "scrollspy"
directories = ["apps/explorer/ui/pages"]

[presentation]
layout = "Grids follow the available space and controls wrap within their page frame."
forms = "Search fields have persistent labels. Deal and withdrawal errors follow interaction and return focus to the invalid field on submission."
tables = "Page-owned scroll regions have names and keyboard access. Filtered table headings follow the toolbar height."
media = "Countdown illustrations retain their proportions and images have dimensions."
motion = "Statistics navigation respects reduced motion and focuses the destination heading."

[view.accounts]
name = "Accounts"
route = "/explorer/accounts"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
additional_widths = [360]
additional_settings = ["reduced motion", "200% text", "keyboard navigation"]

[view.contract_verification_for_address]
heading = "The heading wraps within the page frame at 360 pixels."
additional_widths = [360]
additional_settings = ["reduced motion", "200% text", "keyboard navigation"]
name = "ContractVerificationForAddress"
route = "/explorer/address/0xd789a607CEac2f0E14867de4EB15b15C9FFB5859/contract-verification"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.address]
name = "Address"
route = "/explorer/address/0xd789a607CEac2f0E14867de4EB15b15C9FFB5859"
widths = [360, 768, 1440]
schemes = ["light", "dark"]

[view.advanced_filter]
name = "AdvancedFilter"
route = "/explorer/advanced-filter"
