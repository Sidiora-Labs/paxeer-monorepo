widths = [360, 768, 1440]
schemes = ["light", "dark"]
additional_widths = [360]
additional_settings = ["reduced motion", "200% text", "keyboard navigation"]
states = ["empty chart"]

[view.stats]
name = "Stats"
route = "/explorer/stats"
widths = [360, 768, 1440]
