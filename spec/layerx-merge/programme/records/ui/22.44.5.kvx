widths = [360, 768, 1440]
schemes = ["light", "dark"]

[component.page_title]
path = "apps/explorer/ui/shared/Page/PageTitle.tsx"
views = ["ContractVerification", "ContractVerificationForAddress"]
widths = [360, 768, 1440]
schemes = ["light", "dark"]
presentation = "Page headings wrap within their containers, including at doubled text size."

[component.scan_table_card]
path = "apps/explorer/ui/shared/scan/ScanTableCard.tsx"
views = ["PaxeerXInference"]
widths = [360, 768, 1440]
schemes = ["light", "dark"]
presentation = "Header identifiers wrap within the card while tables scroll in their named regions."

[observation.contract_address_label]
view = "ContractVerification"
route = "/explorer/contract-verification"
widths = [360]
schemes = ["light", "dark"]
settings = ["200% text"]
component = "apps/explorer/toolkit/chakra/field.tsx"
presentation = "The floating address label clips its required marker at doubled text size."

[observation.verification_select_focus]
views = ["ContractVerification", "ContractVerificationForAddress"]
widths = [360]
schemes = ["light", "dark"]
settings = ["200% text", "keyboard navigation"]
component = "apps/explorer/toolkit/theme/recipes/select.recipe.ts"
presentation = "The unselected license and verification method triggers retain their resting border and have no outline under keyboard focus."
