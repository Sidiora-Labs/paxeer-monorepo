trade = "Preset and accordion controls use compact surface spacing and retain their states and focus marks."
swap = "The classic swap card has a 460px maximum width; the best-route heading and details have a 480px maximum width."
orders = "The orders region has a 1100px maximum width and a 420px desktop form column."
touch = "Interactive controls reserve at least 44px through viewport width 834px."
