[meta]
title = "Developer dashboard geometry and content"
geometry_widths = [390, 1280, 1440, 1920, 2560]
viewport_height = 900
scheme = "dark"
unit = "CSS px"
tolerance = 1
measures = ["left", "top", "width", "height", "fontSize", "lineHeight"]
touch_width_limit = 834
touch_minimum = 44

[shell]
reserved_controls = ["Search", "Notifications", "Explorer", "Settings", "New action"]
content = "Controls without an action or destination retain their space and are hidden from interaction. The account caption and principal remain visible in the desktop sidebar."
focus = "The active section panel displays its keyboard focus outline inside its box. A panel that fits the window scrolls into view when the panel itself receives focus."

[width.w390]
part_count = 187
differing_part_count = 117
additional_content_part_count = 33
touch_rule_part_count = 2
shared_ui_part_count = 82

