[manifest]
task = "22.44.11"
surface = "Paxscan explorer routes, shared toolkit and view components"
paths = ["apps/explorer/pages", "apps/explorer/toolkit", "apps/explorer/ui"]
patterns = ["page layout and grids", "tables and lists", "dialogs", "popovers", "menus", "tooltips", "tabs", "accordions", "forms and validation", "selects and comboboxes", "toasts", "skeletons and spinners", "scroll areas and sticky parts", "theme switch", "icons", "images", "fonts", "motion"]
tokens = "Every surface dimension, colour, type value, radius, shadow and duration resolves through the explorer theme roles in both schemes."
layout = "Routes keep their content within the viewport, allow long identifiers to wrap, and preserve readable table scroll regions at narrow widths."
controls = "Interactive controls retain names and state styling and use the touchTarget size role for pointer and keyboard use."
modes = ["standard", "reduced motion", "doubled text", "keyboard"]

[sizing.pill_tabs]
minimum = "Pill tabs use the 2.75rem touchTarget minimum and grow with their labels."
small = "The sm tab height is 2rem; the touchTarget minimum is 2.75rem."
medium = "The md tab height is 2.5rem; the touchTarget minimum is 2.75rem."
free = "The free size declares no tab height and retains the touchTarget minimum."

[guide.css]
id = "web-platform/css"
directories = ["apps/explorer/pages", "apps/explorer/toolkit", "apps/explorer/ui"]

[guide.css_layout]
id = "web-platform/css-layout"
directories = ["apps/explorer/pages", "apps/explorer/toolkit", "apps/explorer/ui"]

