[manifest]
task = "22.44.10"
surface = "Paxscan marketplace, rewards and chain views"
patterns = ["intrinsic grids", "responsive tables and lists", "dialogs", "popovers", "menus", "tooltips", "tabs", "accordions", "forms and validation", "selects and comboboxes", "notifications", "loading states", "scroll areas", "sticky headers", "colour schemes", "theme switch", "icons", "images", "typography", "motion"]
