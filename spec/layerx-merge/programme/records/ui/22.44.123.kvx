[manifest]
task = "22.44.123"
title = "Explorer address and contract dimensions"
views = 10
named_states = 3
combinations = 13
routes = ["/accounts", "/accounts/label/[slug]", "/address/[hash]/contract-verification", "/address/[hash]", "/contract-verification", "/hot-contracts", "/paxeer-x/account/[hash]", "/paxeer-x/inference", "/public-tags/submit", "/verified-contracts"]
states = ["accounts empty", "accounts loading", "accounts error"]

[coverage]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = [844, 390]
schemes = ["light", "dark"]
modes = ["default", "reduced-motion", "double-text", "keyboard"]
geometry_widths = [390, 1280, 1440, 1920, 2560]
geometry_fields = ["left", "top", "width", "height", "fontSize", "lineHeight"]

[dimensions]
verification_columns_pixels = [680, 340]
verification_column_gap_pixels = 30
verification = "The form and its method sections share bounded tracks built from existing tokens."
verification_hints = "Heading hints center the touch area around their visible mark without enlarging the text line."
account_columns = "The account summary uses one column below 1000px and three columns from 1000px."
account_rows = "Stacked desktop values retain their hairline dividers; hinted labels reserve a 30px line below 1000px and a 32px line from 1000px."
inference = "Loading content stays within the page width."
touch = "Enabled controls retain a 44px minimum touch area through 834px and their intrinsic dimensions above 834px."
mobile_account_row_pixels = 182
verification_select_pixels = 60
qr_line_pixels = 32
inline_links = "Entity links and detail values center their touch area around the text line. Statistic hints retain their 20px line footprint."
loading_heading = "The title placeholder occupies one line beside its icon; the loaded title wraps to its content."

