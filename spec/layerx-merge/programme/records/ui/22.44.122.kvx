[coverage]
surface = "Explorer transactions and price feed"
views = 10
named_states = 6
view_state_combinations = 16
full_part_renders = 508
default_only_views = ["/cc/tx/[hash]", "/cross-chain-tx/[id]", "/txs/kettle/[hash]"]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = [844, 390]
schemes = ["light", "dark"]
modes = ["default", "reduced-motion", "double-text", "keyboard"]

[presentation]
statistics = "Transaction statistics use one column below 768px, two below 1000px and one track per statistic from 1000px."
details = "Detail labels use a 220px desktop track; values retain the 14px mobile and 16px desktop text styles."
feed_tables = "Market and update tables retain 900px minimum tracks; observation tables retain an 800px minimum track within a keyboard-accessible scroll region."
rows = "Transaction counterparties retain their side-by-side layout; inline controls center their touch area on the text line."
identifiers = "Summary transaction hashes retain one line with their full text and copy control available."
headings = "Transaction hash headings retain one line with ellipsis; shared page headings wrap within the available width and entity loading headings retain one line."
touch = "Controls retain 44px minimum touch areas through 834px and their intrinsic dimensions above 834px."
scrollbar = "The reserved scrollbar track remains."
retained = "Focus marks, labels, roles, landmarks, control states, loading and empty states, reduced motion and contrast colours remain."

[render_review]
first_scope = "Full part"
last_scope = "Full part"
first_renders = 508
last_renders = 508
last_result = "pass"
last_named_states = 6
last_views = ["/advanced-filter", "/cc/tx/[hash]", "/cross-chain-tx/[id]", "/feed", "/feed/market/[id]", "/feed/update/[hash]", "/internal-txs", "/tx/[hash]", "/txs", "/txs/kettle/[hash]"]
last_modes = ["default", "reduced-motion", "double-text", "keyboard"]
last_widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
last_landscape = [844, 390]
last_schemes = ["light", "dark"]

[findings.load]
first = 0
last = 0

[findings.sideways]
first = 0
last = 0

[findings.cut]
first = 40
last = 0

[findings.contrast]
first = 0
last = 0

[findings.touch]
first = 0
last = 0

[findings.focus]
first = 0
last = 0

[findings.shift]
first = 2
last = 0

[findings.motion]
first = 0
last = 0

[findings.scale]
first = 0
last = 0

