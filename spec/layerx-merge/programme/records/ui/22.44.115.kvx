[select_views]
home = "At width 1440 the period pill measures 69 by 28. At width 1024 the compact change-window pill measures 42 by 28 and the period pill measures 69 by 28. At width 390 the callouts feed replaces the board and its selects."
rewards = "At widths 1440 and 390 the labelled sort pill measures 206 pixels wide, with respective heights of 28 and 46 pixels and select heights of 24 and 44 pixels. Label and value middles differ by less than 0.01 pixel."
profile = "At width 1440 the metric and period pills measure 83 by 28 and 61 by 28. The activity filter measures 114 by 38 at width 1440 and 114 by 46 at width 390, with respective select heights of 36 and 44 pixels."
marker = "Each visible picker shows one text-colored chevron. The compact value-only picker keeps its marker hidden. Native menus, labels and control states retain their behavior."

