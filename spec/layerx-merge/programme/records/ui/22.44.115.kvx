[layout]
strip = "Above width 834 the ticker holds one 32-pixel row, a 132-by-28 mode group with 2-pixel inner padding, and a centered feed with a 16-pixel open link. Long feed content shortens inside its own block."
touch = "Through width 834 the ticker retains its layout and its 44-pixel controls; below width 768 it remains hidden."
cookie = "The decline edge sits inside the button's 28-pixel desktop box. Both cookie actions retain 44-pixel touch targets, and the notice uses an 18-pixel line height."
select = "The native select centers label and value and draws the surface chevron in the text color. The compact value-only form retains its hidden marker."
edges = "Outlined chips, filled tabs and buttons include their edge inside their padding. Fixed-size icon buttons, segmented controls, toggles and fields retain their size tokens."

[measurements]
units = "CSS pixels at device scale 1"
method = "Real browser bounding rectangles and computed line heights"

