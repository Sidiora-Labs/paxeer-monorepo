[patterns]
layout = "Detail grids follow their container; editor columns use intrinsic flex sizing; linked statistics cards fill their grid cells, and labels and values wrap within their cards."
tables = "Token transfers retain column headers and numeric alignment inside a named keyboard-accessible scroll region; headers remain sticky when the container fits the table. Scan cards delegate horizontal scrolling to the transfer region, and embedded filter bars follow the count without overlapping it."
controls = "Editor file selection, closing, collapsing and search options use buttons with focus and disabled or pressed states. The sidebar toggle precedes its panel in keyboard order; Escape closes the panel and restores focus."
selects = "Chart intervals and row counts expose named combobox triggers; chart intervals follow the selected value. Desktop intervals use keyboard-accessible buttons with a pressed state and semantic text colours."
media = "NFT media reserves a square area and provides a named preview button and dialog; HTML media has a frame title. Advertising images reserve their aspect ratio and link to their destination."
theme = "Shared components read the explorer spacing, typography, border, radius and semantic colour roles. Verification states use positive and warning roles in both schemes."

[guide.select_menu_interaction]
id = "select-menu-interaction"
directories = ["apps/explorer/ui/shared/chart", "apps/explorer/ui/shared/scan"]

[patterns.overlays]
security_score = "The security score opens an interactive popover with Escape dismissal and focus restoration."
token_filters = "Token transfer filters use a named trigger and popover, a labeled transfer-direction group, and focus moves into the open popover."
editor = "The editor tab list contains its tabs; folder actions sit beside the list."
wallet = "The token wallet action uses a named button with a visible focus indicator."

[view.home]
route = "/explorer"
content = "Network statistics and transaction lists"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
accessibility_widths = [360]
motion = "reduced"
text_scale = 2
interaction = "keyboard"

[view.detailed-info]
route = "/explorer/address/[hash]"
content = "Address information"
widths = [360, 768, 1440]
schemes = ["light", "dark"]
accessibility_widths = [360]
motion = "reduced"
text_scale = 2
interaction = "keyboard"

