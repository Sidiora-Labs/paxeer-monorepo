[manifest]
task = "22.44.36"
surface = "Paxeer X documentation and documentation assistant"
paths = ["docs/site/paxeer-docs/src", "docs/site/docs-assistant/src"]
patterns = ["page layout and grids", "tables and lists", "native dialogs and navigation menus", "language tabs", "native accordion disclosures", "labelled fields and validation", "native selects", "search combobox", "inline copy status and loading indicators", "native title hints", "scroll areas and sticky navigation", "theme switch", "icons and dimensioned images", "system font fallbacks", "reduced motion"]
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560]
landscape = "844x390"
schemes = ["light", "dark"]
text_sizes = ["100%", "200%"]
motion = ["reduced"]
input = ["keyboard"]
status = "Static pages, native disclosures and asynchronous search and assistant states share the documentation tokens."

[guide.accessibility]
id = "accessibility"
directories = ["docs/site/paxeer-docs/src", "docs/site/docs-assistant/src"]

