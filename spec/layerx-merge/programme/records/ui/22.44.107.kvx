cause = "The revenue section displays the unavailable-epochs message instead of epoch rows; its position follows the resolved rail content."

[part.coin-address.coin-details-card]
widths = [390, 1280, 1440, 1920, 2560]
selector = "#main-content section[aria-label=\"Coin details\"]"
cause = "The section displays the resolved address, name, onchain name and description with the trade panel; the reference also contains a pending metadata capture."

[part.coin-address.creator-card-card]
widths = [390, 1280, 1440, 1920, 2560]
