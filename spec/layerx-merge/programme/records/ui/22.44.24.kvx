[manifest]
task = "22.44.24"
surface = "apps/wallet"
theme = "apps/wallet/src/theme and apps/wallet/src/app/globals.css"
components = "apps/wallet/src/components and apps/wallet/src/providers"
pwa = "apps/wallet/src/pwa"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]
text_scales = [100, 200]
motion = "reduced"
interaction = "keyboard"

[guide.css]
id = "css"
directories = ["apps/wallet/src/theme", "apps/wallet/src/app/globals.css", "apps/wallet/tailwind.config.ts"]

[guide.html]
id = "html"
directories = ["apps/wallet/src/components/ui", "apps/wallet/src/components/nav"]

[guide.forms]
id = "forms"
directories = ["apps/wallet/src/components/ui", "apps/wallet/src/components/onboarding"]

[guide.accessibility]
id = "accessibility"
directories = ["apps/wallet/src/components", "apps/wallet/src/pwa"]

[guide.color]
id = "color"
directories = ["apps/wallet/src/theme", "apps/wallet/src/app/globals.css"]

[guide.typography]
id = "typography"
directories = ["apps/wallet/src/theme", "apps/wallet/src/app/globals.css"]

[guide.dark_mode]
id = "dark-mode"
directories = ["apps/wallet/src/theme", "apps/wallet/src/app/globals.css"]

[guide.responsive_design]
id = "responsive-design"
directories = ["apps/wallet/src/theme", "apps/wallet/src/components", "apps/wallet/src/app"]

[guide.motion]
id = "motion"
directories = ["apps/wallet/src/app/globals.css", "apps/wallet/src/components/ui", "apps/wallet/src/components/pwa"]

[guide.performance]
id = "performance"
directories = ["apps/wallet/src/app/layout.tsx", "apps/wallet/src/pwa"]

[guide.icons]
id = "icons"
directories = ["apps/wallet/src/components/ui/SvgIcon.tsx", "apps/wallet/src/components"]

[guide.dialog]
id = "dialog"
directories = ["apps/wallet/src/components/ui/primitives.tsx"]

[guide.menu]
id = "menu"
directories = ["apps/wallet/src/components/ui/primitives.tsx"]

[guide.tabs]
id = "tabs"
directories = ["apps/wallet/src/components/nav"]

[guide.accordion]
id = "accordion"
directories = ["apps/wallet/src/components/ui"]

[guide.spinner]
id = "spinner"
directories = ["apps/wallet/src/components/ui", "apps/wallet/src/components/pwa"]

[guide.toast]
id = "persistent-toast-notifications"
directories = ["apps/wallet/src/components/ui/toast.tsx", "apps/wallet/src/components/ui/toaster.tsx"]

[guide.scrollbar]
id = "customize-scrollbar-color-and-thickness"
directories = ["apps/wallet/src/app/globals.css"]

[guide.browser_ui]
id = "browser-ui-theming"
directories = ["apps/wallet/src/app/globals.css"]

[guide.layout]
id = "css-layout"
directories = ["apps/wallet/src/app", "apps/wallet/src/components"]

[guide.responsive_table]
id = "responsive-table"
directories = ["apps/wallet/src/components/ui/primitives.tsx"]

[guide.theme_switch]
id = "dark-mode-toggle"
directories = ["apps/wallet/src/theme"]

[guide.switch]
id = "switch"
directories = ["apps/wallet/src/components/ui/primitives.tsx"]

[guide.font_fallbacks]
id = "visually-stable-font-fallbacks"
directories = ["apps/wallet/src/app/layout.tsx", "apps/wallet/src/app/globals.css"]

[guide.install]
id = "install-web-app"
directories = ["apps/wallet/src/app/layout.tsx", "apps/wallet/src/pwa", "apps/wallet/src/components/pwa"]

[view.welcome]
route = "/wallet/"
state = "Welcome"
widths = [360, 390, 430, 768, 834, 1024, 1280, 1440, 1920, 2560, "844x390"]
schemes = ["light", "dark"]

