[presentation]
bounties = "Bounty cards, totals and forms retain compact desktop dimensions. The mobile creation action sits above the bottom navigation."
chat = "Messages and conversations use content-sized columns with the earlier maximum width. The messages loading region retains the short-page footer placement."
conversation = "Conversation pages reserve their content height while the route loads, keeping the footer at its loaded position."
documents = "Documentation uses a 1024px maximum region, a 208px desktop sidebar and the earlier legal list layout. Narrow text columns allow long words to wrap."
text = "Line heights retain their normal-size measures and scale with enlarged text."
font_fallback = "Chat uses the fixed surface font-adjustment ratio while fonts load, retaining the content and footer positions."
touch = "Interactive controls reserve at least 44px through 834px."
scrollbar = "A stable scrollbar gutter reserves 15px of inline space."
readiness = "Bounty, chat and documentation views wait for their displayed content, footer figures and ticker state before presentation modes begin."

