[repair.22.33.213]
audit = "22.30.121"
base_revision = "8c4a3e7e0bd8b236f61b0f9e0dd18f3cfc360fce"
qualification = "The runner records the exact candidate revision, command, exit and private log in the hf-build/hf-done ledger; no qualification is claimed before those gates pass."
baseline = "Not run: the explicit gate order prohibits testing before full implementation or invoking verify_cmd by hand; no TestRepairM_213_* existed at the base and no earlier gate ledger was present."
prior_failures = "No baseline failures are claimed. Inspection found custody injection and response equality without an independent guest oracle; prerequisite 22.31.251 already corrected frozen semantics and feeAsset."

[finding.storage-environment-response-coverage]
audit_id = "storage environment-response-coverage (the audit record spells this sandbox-response-coverage)"
test = "TestRepairM_213_StorageEnvironmentResponse"
repair = "Decode real ordinary and sandbox ABI-v3 execution terminal frames with the production Go consumer and independently known empty guest output; retain funded escrow, fee-limit refusals, snapshot rollback, payer sequence advancement and usage receipt assertions."
recorded_consumer_test = "TestRepairM_213_StorageEnvironmentRecordedConsumer decodes the committed native EVM result through sdk.TxMsgData and MsgEVMTransactionResponse, authenticates its sandbox receipt digest and transfer context against the independently committed kind-2 ledger, and refuses malformed receipt/root attachments."

[finding.simulation-test-response-oracle]
test = "TestRepairM_213_SimulationResponseOracle"
repair = "Execute a Wasm responder publishing the independently specified bytes 0 through 63 and a real seven-unit transfer, decode static simulation and execution with trusted cached-receipt transfer context, and retain the original equality and all-store/event/sequence no-write assertions."

[finding.public-proof-pins-defects]
test = "TestRepairM_213_PublicProof"
repair = "Use the production Go execution consumer on real EVM returns with receipt-bound transfer roots, independent guest bytes, malformed-frame refusals, independent cached state comparison, schedule-asset equality and host reopen."
python_wiring = "Domain 9 agent SDK: services/agent/sdk/python/layerx_sdk/ai_market.py and tests/agent/sdk/python/test_evm_transaction.py must decode terminal/execution/authority wrappers at guest-only capacity with verified transfer context and change the observer to successful SDK decoding."
typescript_wiring = "Domain 9 agent SDK: services/agent/sdk/typescript/src/ai_market.ts and test/ai-market.test.ts must decode transfer-authority wrappers with independently verified transfer context and assert successful SDK decoding of the real producer frames."
scope_boundary = "The no-subprocess Go gate exercises the existing production Go consumer; Python/TypeScript SDK closure remains an external wiring request. The historical external SDK/evaluator proof retains its checks and is not claimed to pass."

[finding.simulation-parity-common-defect]
test = "TestRepairM_213_SimulationParity"
repair = "Retain the original entrypoint/calldata parity matrix and no-write checks, decode both terminal frames using independent local receipt evidence and known empty ABI-1 guest output, and add a nonempty independently specified guest-response matrix with verified transfer roots."

[finding.frozen-test-exists]
test = "TestRepairM_213_Frozen"
repair = "Compare each decoded boolean with the actual host ReadValueAccount Frozen field for zero, funded, uint128 and frozen records, retaining absence, wrong-program, closed-host and snapshot immutability refusals."

[finding.retired-custody-denom-fallback]
test = "TestRepairM_213_NativeAssetResolver"
repair = "Remove assetDenoms, custody constructor injection and the fallback; resolve a real host asset through validated xweb genesis denomination bindings and the current governed allowlist, refuse unknown/unmapped/disallowed assets, and prove the same bank denom and balances after host and committed-store reopen."
native_mapping_wiring = "Domain 14 xweb and domain 17 node genesis: modules/xweb/types/genesis.go ProgramFeeDenoms must carry each supported host asset and native bank denomination at merge genesis; new assets require an owning-domain governed binding interface, never custody registration."

[finding.custody-fixture-dependency]
test = "TestRepairM_213_NativeWebFixture"
repair = "Remove the custody store/keeper from the harness, load native fee mappings through real validated xweb genesis, retain applied fee-leg and atomic pause-refusal checks, and prove signed two-attestor fee distribution and answer persistence through committed-store reopen with an insufficient-signature rollback refusal."

[gotcha.scoped-consumer]
observed = "The only installed Python terminal consumer still applies responseCapacity to the entire frame; invoking it requires a subprocess forbidden by this task gate."
action = "Keep the scoped Go consumer proof and explicit owning-domain SDK wiring requests; never claim actual Python/TypeScript consumer closure from a Go-only gate."

[qualification.build]
revision = "fcd3b8bf278dc055ccff613fc8d34e08c9119414"
command = "make -s paxd-native-libs && CGO_ENABLED=1 go build ./precompiles/layerxprograms/..."
exit = 1
log = "/out/logs/build-1.log"
observed = "Pre-existing sdk/x/staking/client/cli/tx.go:62 and sdk/x/auth/client/cli/tx_multisign.go:84,260, tx_sign.go:69, validate_sigs.go:216 expect one value from tx.NewFactoryCLI, which returns two; the task implementation is not qualified and verification never ran."
assumption = "SDK owning domain must reconcile sdk/client/tx.NewFactoryCLI callers outside this scope; hf-done refuses verification without a passing hf-build, and the unrelated build failure must not be rerun or repaired here."

[qualification.continuation]
revision = "5a0945b48fe00bb708f9354bba20b0654feab676"
command = "cg spec done 22.33.213 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The prerequisite caller repair allows hf-build to pass; test compilation exposed the restart helper calling Commit without the required version-advance boolean."
assumption = "Use Commit(true), matching the production store API and existing package persistence tests, then rebuild and verify the same candidate."

[gotcha.commit-version]
observed = "CommitMultiStore.Commit requires a boolean controlling version advancement."
action = "Restart-recovery fixtures call Commit(true) before reopening the store from its database."

[qualification.attempt3-input]
