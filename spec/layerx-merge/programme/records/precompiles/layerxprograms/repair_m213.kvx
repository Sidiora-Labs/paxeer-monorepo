observed = "The supplied attempt-2 verification failed StorageEnvironmentResponse, SimulationResponseOracle and SimulationParity; this continuation uses that recorded baseline and does not rerun it."
repair = "Compare decoded calldata by byte content; encode requested leases with the production Go v3 lease codec and drive funding and activation through native handlers; preserve the current host-asset mirror resolver alongside governed xweb fee bindings."
lease_codec_wiring = "Programs runtime owner: programs/crates/layerx-programs-sandbox/src/lease.rs exposes the Rust v3 encoder only as a Rust API; the scoped Go request encoder supplies its wire format to the real native Rust decoder through sandboxFund."

[qualification.attempt3-repair]
