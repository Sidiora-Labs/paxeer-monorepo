[qualification.continued-tree]
base_revision = "b664b08b724ec5b190920b99ba70b283c8a796c9"
baseline = "The supplied earlier attempt reported StorageEnvironmentResponse, SimulationResponseOracle and SimulationParity failures; this continuation preserves that evidence instead of running an extra baseline gate."
repair = "Preserve byte-content comparisons for decoded ABI byte arguments and the v3 request encoder; derive transcript lease and program offsets from the full 39-byte domain before funding and activation through production handlers."

[gotcha.lease-domain-length]
observed = "The carried transcript reader sliced a 39-byte lease-state domain at byte 37, misreading the lease and program IDs before its native codec round trip."
action = "Use len(sandboxLeaseStateDomain) for the domain assertion and both identity offsets; retain exact transcript equality and every execution assertion."

[qualification.continued-first-verify]
revision = "bc8b7b6013d68a03ea9aa19b822b21cfe4244610"
command = "cg spec done 22.33.213 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Six repair cases pass; the live sandbox case still refuses execution after native funding, activation and successful ordinary ABI-v3 execution."
native_wiring = "Programs runtime domain 13: reconcile programs/crates/layerx-programs-sandbox/src/host_ffi.rs publish_settlement, which appends the receipt digest, with programs/crates/layerx-programs-runtime/src/ffi_call.rs execution_with_sandbox_receipt and terminal/sandbox.rs SandboxSettlement::read, which currently passes the full framed receipt to a canonical-only decoder; preserve digest authentication and the LXUR contract."

[gotcha.native-sandbox-receipt-frame]
observed = "The committed native result and usage ledger both carry canonical usage bytes followed by their SHA-256 digest; the Go terminal consumer did not unwrap sandbox settlements."
action = "Decode and authenticate the exact native receipt-plus-digest frame, bind it to the independent transfer root, applied fee leg and inner execution fields, and keep the failing live producer assertion until the out-of-scope runtime framing mismatch is repaired."

[qualification.attempt5-input]
revision = "017145b3ae3bcb590ac53f5577802a6d5cd4394d"
baseline = "The supplied attempt-4 evidence reports six passing cases and failures in StorageEnvironmentResponse and StorageEnvironmentRecordedConsumer; no extra baseline gate is run."
repair = "Round-trip the recorded native return through the production ABI output encoder; authenticate an empty occupancy attachment only with a sandbox receipt proving zero occupancy units and fees. Compare the native submission byte for byte with ABI-decoded handler arguments and with the active reference-context lease digest, escrow, asset, destination and fee schedule."

[gotcha.empty-sandbox-occupancy]
observed = "The production runtime wraps sandbox execution in occupancy evidence even when the attachment is empty; the recorded canonical ABI tuple and native receipt independently show zero occupancy units and fees."
action = "Retain bounds, framing, accounting and digest validation; accept that empty attachment only when the authenticated sandbox receipt proves zero occupancy, and refuse rehashed mutations of both occupancy accounting fields."

[qualification.attempt6-input]
base_revision = "f54f0086e13b348e236ca71fe67cf82d702d3951"
baseline = "The supplied attempt-5 result reports seven passing repair cases and StorageEnvironmentResponse refusing its independent native Submit; this continuation retains the recorded-consumer repair and does not repeat a baseline gate."
repair = "Obtain the native reference through the real Precompile.Prepare path, apply registered dispatch event/delegate context, retain the transaction hash and mounted EVM transient store, and assert the exact ordinal assigned by production Submit before checking its result; keep the handler payload and all existing assertions unchanged."

[gotcha.native-reference-context]
observed = "Programs Submit assigns its ordinal through layerxprograms/ordinal/v1/ and calls the native host directly; layerxpay budget keeper ordinals are a separate path."
action = "Prove the actual registered precompile context and the production Submit ordinal rather than writing a pay-keeper counter or changing the accepted payload."

