[qualification.attempt8-input]
base_revision = "0c9ea2c53e7997cef4beea00fb2fe79e1f915465"
baseline = "The supplied attempt-7 gate failed StorageEnvironmentResponse in the terminal consumer; preserve all eight cases and the fee-limit subtest without repeating the full baseline gate."
repair = "Match 22.31.488 attach_sandbox_settlement: the terminal carries the canonical receipt body after native digest authentication, while LXUR and the usage ledger retain body plus digest; parse authority before settlement as terminal.rs unwrap does, and preserve accounting, program, usage and transfer-root checks."
recording = "Re-record execute_result and usage_ledger from TestRepairM_213_StorageEnvironmentResponse: actual native Submit and registered EVM sandboxExecute, production ABI tuple packing, MsgEVMTransactionResponse.Marshal and TxMsgData.Marshal; the focused continuation command requested by do_21 captures the bytes before final hf-build/hf-done."

[gotcha.canonical-terminal-settlement]
observed = "Native LXUR events and kind-2 ledger retain the receipt digest, but 22.31.488 attaches only the authenticated canonical body to the terminal, and an authority wrapper precedes a settlement wrapper."
action = "Decode the production wrapper order and canonical body strictly; reconstruct the LXUR frame only for comparison with independent ledger and event evidence, never accept a redundant digest inside the terminal attachment."

