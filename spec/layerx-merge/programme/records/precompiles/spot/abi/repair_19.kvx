[finding.share-administration-unserved]
implementation = "share.json now describes the native deployment; share-solidity.json preserves the original snapshot byte-for-byte; share-deployment.kvx reconciles all five registry IDs with exact empty-revert behavior."
tests = ["TestRepair_19_NativeShareDeploymentInterface", "TestRepair_19_ShareAdministrationUnserved"]
path = "CreateShareToken -> native deployment -> bank-backed ERC20 calls and keeper mint/burn -> Share ABI consumer; historical selectors are called by holder, vault and governance."
status = "In-scope repair implemented; central registry wiring remains outside scope."

[finding.share-balance-revert]
tests = ["TestRepair_19_ShareBalanceRevert", "TestRepair_19_ShareBalanceRevertFullWidth", "TestRepair_19_ShareBalanceErrorPrecedence", "TestVaultShareTransfer", "TestVaultShareTransferFrom"]
implementation = "CreateShareToken installs an immutable EVM delegate boundary over the production native runtime; real native calls and bank authorization retain the share pointer address/storage. After a native transfer-failed revert, the boundary reads real bank-backed balanceOf and emits the frozen custom error if insufficient; original address/allowance failures are preserved byte-for-byte."
path = "CreateShareToken -> deployed native pointer transfer/transferFrom -> bank precompile -> actual revert bytes decoded against share.json; failed calls preserve balances, supply and allowance."
status = "In-scope runtime repair and strict regression tests implemented; qualification requires passing hf-done. Coverage includes transfer/transferFrom rollback, max uint256, zero balance, exact-balance success and native address/allowance error precedence."

[wiring.native-balance-error]
request = "Domain 6: apply the frozen error contract to contracts/src/NativePaxTokensERC20.sol and precompiles/bank/bank.go and regenerate modules/evm/artifacts/native; preserve the share-specific boundary when modules/evm/keeper/pointer_upgrade.go upgrades existing share pointers, or replace it with an equivalent corrected native runtime."

[wiring.share-registry]
request = "Domain 3: reconcile spec/layerx-merge/interfaces.kvx rows 3.pc-spotshare-mint, 3.pc-spotshare-burn, 3.pc-spotshare-owner, 3.pc-spotshare-renounceownership and 3.pc-spotshare-transferownership with precompiles/spot/abi/share-deployment.kvx; keep their selectors historical/unsupported on native pointers."

