[finding.historical-rewards-value-v605]
tests = ["TestRepairM_1255_HistoricalRawCALL", "TestRepairM_1255_LiveRoutingActivation", "TestRepairM_1255_ZeroValueQueries"]
repair = "Preserve distribution.go and abi.json unchanged; pin paid raw EVM CALL acceptance, decoded nonempty keeper rewards, exact sender debit and precompile credit (whole bank units and wei remainders), and finalized balances through a fresh state DB at the v605 activation and following height."
routing = "The production keeper selects the frozen v605 wrapper/executor for historical tracing even with later done markers present, and the current distribution wrapper/executor for live execution; the current executor accepts the historical payment before merge activation and without the plan, and rejects payment with full balance rollback at and after the recorded merge height."
activation = "Fixture heights 10 (v6.0.5), 20 (v6.4.0), and 30 (v7.0 merge, the latest registered implementation) are deterministic test heights, not a claim about a deployed network; production activation remains the applied plan's recorded done height."
client_documentation = "README.md documents the historical value hazard, zero-value queries, and activation semantics."
wiring = "precompiles/distribution tests and docs/site/docs protocol/client guides — owner domain 6: carry the historical raw CALL and live-routing regression coverage into the parent suite and link legacy/v605/README.md from the public distribution client documentation; no out-of-scope file is changed here."

[qualification.notes]
workflow = "Root GOTCHA.kvx, spec records, commits and pushes are outside the task's writable scope; this in-scope record carries the finding mapping and wiring request, and the runner owns publication."
gotcha = "node.LatestUpgrade is the merge plan itself; use a distinct historical marker below the merge instead of marking LatestUpgrade done in an unapplied-plan fixture. Distribution queries also require a height after delegation creation to expose nonzero rewards."
qualification_repair = "Source review during the first successful build found the test decoder reused legacy output structs whose field order differs from the ABI; use ABI-ordered consumer structs because abi.ConvertType copies by position, keeping every reward and balance assertion. Rebuild the corrected candidate before verification."

