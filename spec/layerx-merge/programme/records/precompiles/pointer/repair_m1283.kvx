[finding.pointer-payability-contract]
tests = ["TestRepairM_1283_CurrentABIAndSolidity", "TestRepairM_1283_ZeroValueRegistrationAndValueRefusal", "TestRepairM_1283_HistoricalReplayABI"]
repair = "Current ABI nonpayable matches Pointer.sol and the four handlers. Real EVM CALL registers and deploys at zero value; nonzero value reverts with explicit non-payable precompile error, no value transfer or pointer state. Historical replay snapshots stay payable and unchanged."
wiring_request = "Domain 6: update spec/layerx-merge/interfaces.kvx rows 6.pc-0x100b-addcw1155pointer, 6.pc-0x100b-addcw20pointer, 6.pc-0x100b-addcw721pointer and 6.pc-0x100b-addnativepointer to publish nonpayable/zero-value registration; this registry is outside task scope."

[finding.pointer-freeze-misses-mutability]
tests = ["TestRepairM_1283_CurrentABIAndSolidity", "TestRepairM_1283_ZeroValueRegistrationAndValueRefusal", "TestRepairM_1283_HistoricalReplayABI"]
repair = "Freeze retains all selectors and the empty event set, compares current Solidity and served ABI mutability, and is exercised alongside real value refusal and registration for all four methods. Historical expectations are separately keyed by replay version."

[finding.pointer-untrusted-metadata]
tests = ["TestRepairM_1283_UntrustedMetadata", "TestRepairM_1283_MetadataSizeBoundaries"]
repair = "CW20/CW721/CW1155 smart-query metadata must be a JSON object with string name and symbol, respectively 1..256 and 1..128 UTF-8 bytes. Invalid JSON, absent/null/wrong-type/empty/oversized fields wrap ErrInvalidMetadata (invalid pointer metadata) before deployment. Real hostile CosmWasm guest responses traverse QuerySmartSafe and EVM CALL; refusals leave the deployment nonce, events and committed pointer stores unchanged. Accepted endpoints round-trip through deployed EVM wrapper name/symbol consumers."

