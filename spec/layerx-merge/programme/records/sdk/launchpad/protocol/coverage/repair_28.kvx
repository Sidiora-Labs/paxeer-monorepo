[repair.22.31.28]
finding = "emitter-caller-evidence"
proof = "TestRepair_28_EmitterCallerEvidence (PoolSwap, RouterSwap, ForgedCaller, TraceRefusals, VerifiedNativeReceiptEvidence)"
implementation = "Block-hash callTracer evidence binds the signed root, effective frame caller and selector, ordered receipt logs and consumer payload; native Swap uses committed receipt and transaction roots plus pinned pool registration. The measure command wires both providers."
baseline = "The supplied attempt-1 evidence at revision 79bfde1be0b575e3f4e95969b3ecf914ee39bbb1 already reports failing PoolSwap, RouterSwap, ForgedCaller and TraceRefusals cases because debug_traceBlockByHash was unavailable; its aggregate gate also reports the unchanged historical-input failure. No unchanged gate is repeated here."
wiring_request = "precompiles/launchpad and modules/launchpad (owning domain: native launchpad): add the native keeper/router receipt integration proof against coverage's RPCNativeReceiptSource; this task cannot import the root fork's keeper/geth types into the isolated upstream-geth protocol module."
gotcha = "The native producer emits Swap at reserved 0x1017 without an emitSwap EVM frame; signed transaction sender and Swap.sender are not its logical pool caller."

[qualification.unrelated_historical_inputs]
revision = "8d4c22f730d4ab3231364f7aab66d502486c04de"
command = "cg spec done 22.31.28 -f layerx-merge --root /work/paxeer-monorepo"
