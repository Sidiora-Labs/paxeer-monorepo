[gotcha.test_receipts]
symptom = "Receipt JSON with a null logs field is rejected by geth's required-field decoder."
repair = "The supplemental root comparison corpus serializes empty log arrays explicitly; the pool and router receipts come from the real local node."

[gotcha.trace_service]
symptom = "The simulated backend exposes eth RPC but debug_traceBlockByHash is unavailable even with debug in HTTPModules."
repair = "Assemble the real geth node and simulated beacon with tracers.APIs registered before node start and the native callTracer registered by its package import."
