[repair.22.33.957]
audit = "22.30.28"
base_revision = "e3d7e5828b39e4182e9559fb6bc28d74c2f37e0f"
baseline = "No extra unchanged-tree verification was run: the explicit Order requires complete implementation, hf-build, then hf-done as the sole initial verification. The supplied previous-attempt evidence below already records TestRepairM_957_CompatibilityFixture failing on the missing canonical examples.json."
qualification = "The exact candidate revision, command, exit and private log are recorded by hf-build and hf-done in /out/run/gates.jsonl and copied into the final evidence line; no passing gate is claimed in this record."

[finding.compatibility-fixture-missing]
proof = "TestRepairM_957_CompatibilityFixture; TestRepairM_957_FrozenFixtureProvenance"
change = "Restore examples.json through the existing protocol example generator using the committed, hash-pinned v1 schema and SDK selection. TestPhase2ReaderCompatibility and the offline regression share the protocol v1 fixture loader; the database test retains both independent reader binaries, expansion, backfill, raw serialization and distinct binary checksum assertions."
path = "Canonical frozen examples.json -> shared compatibility fixture loader and real v1 validator -> legacy typed JSON reader and generated DecodePool consumer -> identical representations and exact raw decimal strings."
status = "Implemented in the expanded scope; qualification is recorded by hf-build and hf-done."

[wiring.protocol]
resolution = "The continuation ruling adds sdk/launchpad/protocol/contracts/v1 to scope and requires generator output. The fixture is now restored there; no out-of-path implementation is required."

