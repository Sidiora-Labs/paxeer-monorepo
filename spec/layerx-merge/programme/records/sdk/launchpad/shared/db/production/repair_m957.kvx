scope = "These are schema-only examples emitted by the real generator from the frozen v1 schema, retaining the synthetic label. The committed SDK selection is not the missing production semantic catalogue; this repair proves reader compatibility, not handler, receipt or live database qualification."

[gotcha.canonical_fixture]
observed = "Both the retired integration fixture and the canonical protocol examples.json are absent on the supplied base; repointing alone cannot qualify compatibility."
resolution = "The continuation ruling authorizes restoring the canonical fixture through the existing generator. The focused gate reads committed generator output in-process without a fallback, external service or subprocess."

