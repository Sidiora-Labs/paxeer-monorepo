[finding.export-error-loss]
test = "TestRepairM_690_ExportErrorRecovery"
repair = "Propagate both public-key conversion errors and return a nil validator list; persist a valid prefix followed by an unsupported secp256k1 key or empty Any, close and reopen the node, assert the recovered error, and reject both production node export results for the unsupported key. Replacing the bad stored key restores both validators and powers."

[finding.staking-state-doc]
test = "TestRepairM_690_StateLayoutAndHistory"
repair = "Document the validator queue's eight-byte time-length and height framing, decimal-ASCII historical key, consensus-power/address ordering and delegation retention across validator status changes; real delegation messages, BeginBlock and EndBlock produce stored queue/history bytes and preserve shares through bonded, unbonding and unbonded states."

[finding.staking-unbond-transition-doc]
test = "TestRepairM_690_TransitionsAndDurableRetry; TestRepairM_690_MessageWaitingPeriod"
repair = "Distinguish full-period undelegation from all getBeginInfo redelegation branches, including a removed empty source; retain refused payout state and queue across a committed store restart, then prove one transfer, unchanged supply, entry/index/queue cleanup and no duplicate payment at later EndBlock."

[finding.staking-message-wait-doc]
test = "TestRepairM_690_MessageWaitingPeriod; TestRepairM_690_MessageRestrictions"
repair = "Real codec-transported MsgUndelegate responses and queried pending entries prove a fresh full wait for bonded, unbonding and unbonded validators, no premature payout and payment at maturity. Real messages prove minimum commission, default power-cap rejection and the operator's own current-token backing for a raised minimum; document recipient refusal and durable retry."

[finding.staking-params-doc]
test = "TestRepairM_690_RegisteredParameters; TestRepairM_690_ClientExamples"
repair = "Verify all eight registered parameter keys, their actual Go types and validators, uint32 counts, both power controls and minimum commission against the reference; store governed values and retrieve them through the generated query client. Compare the complete default gateway JSON with the documentation and distinguish application power reduction from on-chain parameters."

[finding.staking-client-doc]
test = "TestRepairM_690_ClientExamples"
repair = "Complete Params and redelegation-filter request/response examples use valid Paxeer addresses and real message-produced entries. Loopback gateway and CLI JSON-RPC transports exercise the production protobuf router and keeper; compare every documented JSON field for both CLI commands and REST, stored identity and entry balance, filter total and exact CLI result. Assert the direct keeper and protobuf query responses agree. Both clients preserve null nested entries and numeric creation height through RedelegationResponse.MarshalJSON; the exact-triplet CLI requests no count and returns total zero."

[wiring.node-export]
request = "node/export.go — owning domain 15 (cosmos-fork/node): validate WriteValidators before writing any module data in ExportAppToFileStateAndValidators, or stage the output atomically, so a returned export error also leaves no partial output file."

[gotcha.gate-order]
observed = "The audit step requests an unchanged-tree verify, but the explicit gate order forbids pre-implementation tests and manual verify execution."
action = "Use only hf-build then hf-done after complete implementation; record the absent baseline instead of claiming pre-change failures."

[gotcha.response-shape]
observed = "RedelegationsToRedelegationResponses leaves nested redelegation.entries nil and transports stored entries in top-level entry responses; RedelegationResponse.MarshalJSON preserves null entries and numeric creation_height even inside CLI protobuf JSON."
action = "Retain strict identity and entry equality with the producer's nil nested entries, compare complete documented CLI and REST JSON, and record actual CLI output in the private verify log; no client normalization is needed when both transports agree."

[gotcha.test-power-reduction]
observed = "The existing staking common_test.go initializes sdk.DefaultPowerReduction to 10^18, whereas production sdk/types/staking.go defaults to 10^6."
action = "Use the live keeper conversion for power-based behavior tests and fixed raw coin amounts for reproducible documented client examples; do not change the global or production defaults."

[gotcha.restart-commit]
observed = "The supplied previous-attempt verification at revision 0d86541a2b1ed2f132f22ca77ca7af213b1ac556 failed in TestRepairM_690_ExportErrorRecovery/unsupported before testing export: direct multistore commits omitted the node's committed block identity."
action = "Commit initialized genesis and stored validators through SetSealedStateToCommit and App.Commit, preserving the production pre-commit hook before closing and reopening the node."

[gotcha.zero-internals]
observed = "A deep equality assertion on a zero Coin compared math/big internal empty and nil limbs after store decoding, despite identical monetary values."
action = "Retain every exact assertion and include a real jailed validator's delegation in the retry fixture, proving payout preserves unrelated pool backing across restart as well as transferring the exact mature amount."

