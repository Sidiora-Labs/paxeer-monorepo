[gotcha.codec_interface]
observed = "sdk.Msg and proto.Message do not expose the concrete ProtoMarshaler methods required by ProtoCodec.MustMarshal and Unmarshal."
resolution = "Transport message interfaces through MarshalInterface and UnmarshalInterface; assert the decoded real message before BaseApp dispatch."

