[repair.22.33.1461]
audit = "22.30.84"
base_revision = "5f6b5f0aad35a415da93671f70183d5e5688bda0"
findings = ["invoke-nil-panic", "grpc-suite-constructor", "query-cancellation-lost", "query-proof-unverified", "query-proof-test-path", "pagination-overflow"]
baseline = "No baseline test run: the explicit ordered gates prohibit running verify_cmd by hand or before implementation is complete; no pre-change failures are claimed."
evidence = "The final response and private hf gate ledger record the exact candidate revision, command, exit and log; no gates are claimed before execution."
wiring_request = "SDK domain 15: qualify sdk/client/grpc_query_test.go with go test -tags norace -run '^TestIntegrationTestSuite$' ./sdk/client/ in the owning integration gate; this task permits only hf-build and hf-done."
gotcha = "The legacy rootmulti DB adapter cannot produce authentic store proofs; the offline client proof tests use the committed chain_proof_v1.hex transcript generated by the production v2 store and verify its root before transporting it."

[finding.invoke-nil-panic]
test = "TestRepairM_1461_InvokeValidation"
repair = "Reject nil interfaces, non-message/non-pointer values and typed nil messages before marshaling; a generated protobuf query client reaches the real Echo handler through JSON-RPC."

[finding.grpc-suite-constructor]
test = "TestRepairM_1461_GRPCSuiteConstructor"
repair = "Pass s.T() to network.DefaultConfig; retain every existing integration assertion. The default-tag gate checks the actual constructor expression and exercises the retained Echo/height contract over loopback RPC. Full norace qualification remains the wiring request above."

[finding.query-cancellation-lost]
test = "TestRepairM_1461_QueryCancellation"
repair = "QueryABCIWithContext forwards the caller context to the node; Invoke uses it. Existing QueryABCI and convenience APIs preserve background-context behavior. Cancellation and deadline tests observe both caller error and server-side HTTP cancellation."

[finding.query-proof-unverified]
test = "TestRepairM_1461_ProofRefusal"
repair = "Canonical store/key queries with Prove=true explicitly return Unimplemented and an empty response until independently trusted header verification exists. Authentic, missing, empty, forged-value, forged-proof and wrong-height node responses are refused."

[finding.query-proof-test-path]
test = "TestRepairM_1461_QueryProofPath"
repair = "Use /store/<name>/key in the integration source and retain height assertions on ordinary queries; assert proof-mode refusal separately. Focused tests use QueryStore's real path, independently authenticate the committed node proof and refuse altered/missing evidence."

[finding.pagination-overflow]
test = "TestRepairM_1461_Pagination"
repair = "Reject overflowing int products and sums before arithmetic; reject uint64 offset multiplication overflow and use the consumer's default limit for page offsets when limit is zero. Assert maximum integers, zero defaults, conflicting flags and partial final pages."
