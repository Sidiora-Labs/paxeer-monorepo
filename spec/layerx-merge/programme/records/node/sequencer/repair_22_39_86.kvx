[failure.flags]
test = "TestAddStartFlagsRegistersSequencerFlags"
disposition = "Stale inventory against mandatory authenticated replication."
moved_by = "26d76c12362b7507da8e1635453268de152cfd6a (22.31.103) added the five replication TLS flags and their ReadConfig fields."
repair = "Enumerate all nineteen flags with exact types, defaults and help, and parse all five TLS values into the exact expected Config. AddStartFlags obtains TLS defaults from DefaultConfig, like the other options."

[failure.seal-batch-retry]
test = "TestConsensusSourceRetriesSealBatchFailure"
disposition = "Stale final assertion against idempotent consensus proposal retries; signature-failure checks remain required."
moved_by = "881d9c90ebe6817e56b41a9c27d39719b13b6f38 (22.31.89) made ConsensusSource.Seal return owned copies of the already sealed height."
repair = "After repairing the signature, assert two byte-identical seal retries, stable SealedLayer identity and isolation from mutated retry bytes. The executor stays closed and another height still fails."

[failure.decode-retry]
test = "TestConsensusSourceDecodeFailureKeepsBatch"
disposition = "Stale final assertion against idempotent consensus proposal retries; undecodable-transaction checks remain required."
moved_by = "881d9c90ebe6817e56b41a9c27d39719b13b6f38 (22.31.89) cached successful consensus seals for proposal retry."
repair = "Keep both decode failures and the original repaired-batch assertions; then prove exact, independently owned retries of the successful block without reopening the executor."

[failure.tx-zero]
test = "TestConsensusSourceTxZeroBatch"
disposition = "Stale final assertion against idempotent consensus proposal retries."
moved_by = "881d9c90ebe6817e56b41a9c27d39719b13b6f38 (22.31.89) retained the encoded tx-zero batch for repeated proposals."
repair = "Keep the signed batch, ordered WAL transactions and stored sequence/hash assertions; repeated seals must preserve the exact batch, transaction bytes and open time, with isolated returned buffers."

[failure.crash-replay]
test = "TestCrashAfterReceiptReplaysIdenticalReceipt"
disposition = "Stale WAL inventory against durable startup leases; receipt replay itself remains byte-identical."
moved_by = "fe12e73e857d44b1a98c3cf16c02b3a692f858e7 (22.33.1144) wired Node.startLease into startup and advances its durable epoch on restart."
repair = "In both executor modes require COMMITTED, OPEN, the exact epoch-one LEASE and every ACCEPT. Replay changes no records, preserves the lease and reproduces every signed receipt; Node.Start preserves that entire prefix and appends exactly the epoch-two LEASE. Driver documentation identifies leases as independent of its COMMITTED/OPEN sequence."

[failure.transport-recovery]
test = "TestProofSequencerExecutorTransportRecovery"
disposition = "Stale harness configuration against mandatory replication identity, plus unsafe cleanup after a failed NewNode. Its later WAL assertions also predate startup leases."
moved_by = "26d76c12362b7507da8e1635453268de152cfd6a (22.31.103) requires CA-verified mutual TLS, peer DNS identity and SPKI pin; fe12e73e857d44b1a98c3cf16c02b3a692f858e7 (22.33.1144) adds startup leases."
repair = "Carry the real generated CA-signed replication certificate, private key paths, roots, DNS name and peer SPKI through ReadConfig and validate the loaded identity. Retain real authenticated TCP replication, RPC consumption and restart recovery. Assert exact startup/restart leases and unchanged receipt records. Use nil-safe Node.Stop for cleanup and stop the old renewal worker before reopening its WAL."

[gotcha.scope]
observed = "The task forbids changes to the root gotcha ledger and spec files."
resolution = "Record task findings here and leave pre-existing workflow bookkeeping untouched."

[gotcha.tooling]
observed = "Codify text queries did not return the executor and startup symbols present in the source; two guessed lease filenames were absent and one multi-file patch failed its final context check without applying edits."
resolution = "Read the actual source paths with ripgrep, locate lease startup in node.go and submit the corrected patch before qualification."

