[continuation.receipt-latency]
test = "TestReceiptLatencyP99UnderBound"
disposition = "Separate functional histogram assertions from the environment-dependent wall-clock performance bound, as decision 2908 permits."
producer = "node/sequencer/accepter.go:162,173,179,193 and standby.go:293,298 measure wall time before calling the three Metrics observation methods; metrics.go records supplied durations without changing them."
repair = "Keep the 500 real executed transfers, authenticated TCP replication, signed receipts, histogram shape, counts, boundaries and bucket assertions in the package test. Move the unchanged strictly-below-50-ms assertion to BenchmarkReceiptLatencyP99UnderBound in the same file. The benchmark runs the real test in an isolated child, requires exactly one full-precision p99 report and asserts its bound; no benchmark result is claimed by the declared package gate."

[continuation.standby-commit-renewal]
test = "TestDriverReleasesNextOpenAcrossStandbyCommit"
disposition = "The comparison raced a replicated renewal; LEASE entries belong in both logs."
producer = "node/sequencer/lease_renew.go:31 calls replicator.Release(ctx, lease); standby.go:273 appends locally before its concurrent sync/replication completes. Driver.OnCommitContext releases COMMITTED and OPEN independently of renewals."
repair = "Drain through the real replicator to wait behind any in-flight release and require complete primary/standby WAL equality within the existing replication timeout, retaining every LEASE. Assert the next OPEN after traversing only trailing LEASE entries already included in that equality. Stop the node's renewal worker before closing its WAL during cleanup."

[continuation.wal-proof-renewal]
test = "TestProofSequencerWal/signed_receipt_survives_restart_and_failover"
disposition = "The test renewed at the fenced expiry instant; the live lease rule is unchanged."
producer = "node/sequencer/lease_renew.go:26 rejects an instant at or after expiry; line 29 allows renewal only within the final half-duration."
repair = "First require expiry-instant renewal to return ErrLeaseFenced without changing the standby log. Renew one minute before the three-minute lease expires, explicitly assert it is before expiry and in the half-duration window, and require the exact new expiry. Preserve duplicate-delivery, restart, signature and failover assertions."

[continuation.giga-vm]
test = "TestSealBatchEqualsGigaProcessBlock"
disposition = "The fixture requires the real VM supplied by prerequisite 22.39.165; no comparison is bypassed."
producer = "node/app.go:1086 loads engine/executor/lib/evmlib.go:15 InitEvmoneVM best-effort. NewGigaTestWrapper now requires its VM immediately, and the comparison requires it on both applications."
repair = "The declared build first runs make -s evmone-lib. Preserve all 101 results, exact gas, receipts, nonces and final state-hash comparisons; any further sequencer-side discrepancy must be repaired within the bounded qualification budget."

[gotcha.continuation-ledger]
