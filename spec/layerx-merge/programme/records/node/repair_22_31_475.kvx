repair = "Supply version.BlockProtocol and the production consensus proposer's address on every test header, preserving header validation and all hash assertions."

[continuation]
review = "The inherited test helper already supplies the required block protocol and proposer. Retain that repair and all producer, restart, corruption and crash-recovery assertions; qualify the inherited implementation through the declared gates."
identity = "Each successful Commit must publish the block identity used by FinalizeBlock, and every restarted application must restore that exact identity alongside its own-height application hash."
