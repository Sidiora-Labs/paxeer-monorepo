build = "hf-build: go build ./modules/oracle/..."
verify = "hf-done: cg spec done 22.33.252 -f layerx-merge --root /work/paxeer-monorepo"
evidence = "The runner's private /out/run/gates.jsonl records the candidate revision, exact command, exit code and log location. The final response copies the last gate evidence."
