[repair.22.33.1118]
audit = "22.30.48"
base_revision = "72c91077cb966f1c4c640ded61b4b259f41cad90"
invalid-header-vector = "TestRepairM_1118_InvalidHeaderVector; TestHeaderHashVectorV2; the original TestHeaderHashVector remains explicitly malformed-input history with decoder refusals."
legacy-event-test-gap = "TestRepairM_1118_LegacyEventTestGap; TestTryUnmarshalForEvent; real failed kvstore execution and populated successful/failed ExecTxResult protobufs pass EventBus, Message.LegacyData, RPC Subscribe, loopback WebSocket and ResultEvent decoding, preserving code, data, gas and events. The prerequisite repair already preserves Code."
attack-evidence-digest = "TestRepairM_1118_AttackEvidenceDigest; full 32-byte conflicting header digest plus signed-varint common height is pinned with an independently computed exact preimage and SHA-256; valid signature subsets keep one identity."
invalid-attack-vector = "TestRepairM_1118_InvalidAttackVector; TestEvidenceVectorsV2; deterministic real votes and signed commits validate before hashing, then pass protobuf EvidenceFromProto and signature verification. The original TestEvidenceVectors remains malformed-input history and asserts decoder refusal."
tx-hash-length = "TestRepairM_1118_TxHashLength; a signed production proposal and protobuf transport round-trip preserve a real transaction identity, while peer keys of lengths 0, 31 and 33 are refused."
node-key-atomic-save = "TestRepairM_1118_NodeKeyAtomicSave; mode-0600 staging, file sync, atomic rename and directory sync replace a complete inode; interrupted partial staging and a real rename refusal leave the previous identity readable on reopen. A hard-linked previous inode proves no truncating overwrite."
node-public-key-retry = "TestRepairM_1118_NodePublicKeyRetry; an initial companion rename failure is repaired on the next load from the durably saved private identity; missing, stale and symlink companions are atomically replaced without changing private bytes or peer ID. Corrupt private identities remain refused."
vote-extension-enable = "TestRepairM_1118_VoteExtensionEnable; disabled-to-future scheduling succeeds through the real state.State.Update in execution.go and state protobuf recovery; current/past scheduling, active changes and disabling are refused."
baseline = "Not run: the explicit gate order requires complete implementation before hf-build and hf-done, prohibits running verify_cmd by hand, and allows only one initial verification. No pre-change test failure is claimed; the initial gate ledger was absent."
wiring_task_record = "spec/layerx-merge/spec.kvx (programme domain 17): mirror these finding-to-test mappings, wiring requests and the runner's qualified revision; direct spec edits are outside task scope."
wiring_rpc = "consensus/internal/rpc/core/events_test.go (consensus domain 15): add the populated success/failure subscription regression to the RPC-owned suite; this task exercises the actual Subscribe handler and ResultEvent consumer from its scoped Go test through existing loopback helpers."
wiring_activation = "consensus/internal/evidence/{pool.go,store.go} and spec/layerx-merge upgrade activation record (consensus domain 15 / programme domain 17): agree and rehearse one coordinated activation boundary for the corrected evidence identity, reindex persisted light-client evidence under the full-digest scheme at that boundary, and prevent old-scheme peers/persisted identities from mixing with the corrected pool; do not deploy the identity change independently."
evidence = "The runner records exact candidate revision, command, exit code and private log location in /out/run/gates.jsonl; the final response copies the last bounded gate evidence."
