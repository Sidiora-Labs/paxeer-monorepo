[repair.22.31.107]
finding = "evidence-committed-transition-not-durable"
proving_tests = ["TestRepair_107_CommittedEvidenceSurvivesRestart", "TestRepair_107_FailedMarkerStopsLifecycleAndReplays", "TestRepair_107_ReadErrorsRejectDuplicates", "TestRepair_107_BufferCannotReadmitCommittedEvidence"]
implementation = "Commit markers and pending deletions use one checked WriteSync batch, including offenses never pending locally; publish in-memory deletion only after success. Serialize admission and commits. Fail the existing void Update lifecycle with the wrapped storage error and refuse proposals/admission after failure. Check committed reads before cached pending evidence on all ingress paths."
baseline = "Not run: the explicit gate order prohibits verification before complete implementation and allows only hf-build followed by hf-done; no baseline failures are claimed."
verification = "hf-done records the exact candidate revision, command, exit code and private log in the gate ledger; its final evidence line is reported verbatim."
wiring_request = "consensus/internal/state/services.go and consensus/internal/state/execution.go; owner fm-cosmos-fork (consensus/state): evolve EvidencePool.Update to return an error and propagate it from ApplyBlock; preserve fatal handling and replay of the saved block before proposal or validation resumes. The scoped repair currently propagates via panic through the existing void interface."

