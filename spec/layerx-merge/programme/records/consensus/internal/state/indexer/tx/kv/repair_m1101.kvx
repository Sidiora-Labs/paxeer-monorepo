reason = "The explicit gate order requires complete implementation before any build or test, and forbids invoking verify_cmd by hand before hf-done; it takes precedence over step 6's unchanged-tree verification request."

[gotcha]
observed = "The deprecated test's nested loops accepted empty results, hiding incompatible raw-hash primary keys and slash-delimited secondary keys."
