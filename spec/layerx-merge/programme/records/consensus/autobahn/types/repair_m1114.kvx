[repair.22.33.1114]
audit = "22.30.47"
baseline = "No unchanged-tree verification was run: the task's ordered instructions require complete implementation before testing and allow verification only through hf-done; no baseline failing test is claimed."
evidence = "The hf-build and hf-done ledger retains the exact candidate revision, command, exit code and private evidence location; qualification requires hf-done passing on the build candidate."
mutable-app-hash = "TestRepairM_1114_MutableAppHash: constructor and protobuf decode own application hashes; accessor and encoder mutations preserve signed certificate bytes across Consensus RPC, data synchronization and reopened producer and consumer WALs."
mutable-hashed-payload = "TestRepairM_1114_MutableHashedPayload: builder, decode input, accessor, ToBuilder and encoder mutations preserve payload commitments and signed block bytes; GetBlock RPC, data insertion and reopened WAL replay retain the exact block."
app-qc-tests-wrong-branch = "TestRepairM_1114_AppQCBranches: a verified block commit precedes application certification; the valid proposal passes Consensus RPC, certificate-content replacement yields the exact mismatch error and a sole outsider signer yields the exact non-replica error; both original proposal tests now exercise serialized committed histories."
timestamp-canonical-range = "TestRepairM_1114_TimestampCanonicalRange: malformed proposal and payload bytes reject seconds outside years 0001..9999 and nanos outside 0..999999999 through the real decoders and registered Consensus/GetBlock RPCs; supported endpoints re-encode exactly and serialize to JSON; local unsupported producers and encoding reject."
codec-tests-miss-production-bounds = "TestRepairM_1114_ProductionBounds and TestConvProductionBounds: real busy committees exercise the 100-header cap, maximum committee and consensus byte admission, maximum transaction count and bytes; production sync sends every finalized certificate and block into a second data State; both WALs are closed and reopened and every finalized block remains readable."
wiring_internal = "consensus/internal/autobahn/data/state_test.go and consensus/internal/autobahn/consensus/persist/fullcommitqcs_test.go — domain 5 node-runtime owner: retain producer-to-sync and producer-to-reopened-WAL boundary regressions in the owning suites; this task drives those production components from its scoped repair test."
gotcha_scope = "The task's explicit scope forbids spec and root GOTCHA edits; repair mappings and this baseline-order conflict are recorded here rather than modifying those files."
gotcha_full_proposal = "FullProposal has no public AppQC accessor; external tests obtain the transported certificate through FullProposalConv, while same-package proposal tests use the existing appQC field."
