[finding.sdk_wire_contract]
revision = "3c536a7f5ecaa1705b40be29ee43c3bff1ce9e30"
command = "python3 -m pytest -q services/platform/middleware/conformance/pay6 services/platform/middleware/examples"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Python x402_http accepts layerx networks, unprefixed identifiers and sequencer-signed receipt payloads, while real TypeScript peers produce eip155:125 and portable receipt-proof-v2 payloads; x402_agent likewise rejects the peer's prefixed assets."
assumption = "Repair requires services/agent/sdk/python/layerx_sdk/x402_http.py and x402_agent.py outside scope; retain interoperability assertions and request SDK owner alignment."

[finding.commitment_and_payer]
revision = "3c536a7f5ecaa1705b40be29ee43c3bff1ce9e30"
