[meta]
task = "22.39.78"
starting_revision = "5989465ed996eff127b982c0150f80533bbc9c34"
decision = "2804"
gotcha = "3438"

[repair.workflow]
observed = "platform-test-middleware built packages but omitted their tests, the Python suites, framework suites and marketplace tests."
change = "Run each workspace's npm test with its dependency-building pretest hook, retain conformance and existing platform checks, and run Python suites with the provisioned platform interpreter. Conformance also runs pay6 and public RPC example Node tests."
proof = "tests/ci/test_platform_middleware_suites_wired.py::test_platform_middleware_runs_package_tests; tests/ci/test_platform_middleware_suites_wired.py::test_platform_integrations_tests_wired"

[repair.fastapi]
observed = "The inventory recorded FastAPI collection failures from undeclared test dependencies."
change = "Declare pytest, fastapi, httpx and cryptography as test extras and provision the matching existing tests/requirements.txt in platform-sample-install."
constraint = "The existing deterministic wheel backend hardcodes runtime metadata; install the test requirements directly rather than relying on it to emit extra metadata."
proof = "tests/ci/test_platform_middleware_suites_wired.py::test_fastapi_integration_declares_test_deps"

[repair.python_collection]
observed = "pay6/test_asset.py imports layerx_sdk without setting its path; collection previously depended on another test importing it first."
change = "Each Python suite's conftest adds the real local Python SDK before collection, so both roots collect independently."
proof = "python3 -m pytest -q services/platform/middleware/conformance/pay6 services/platform/middleware/examples"

[qualification]
revision = "The candidate revision named by hf-done's final JSON evidence and cg spec done's task record."
build = "python3 -m py_compile tests/ci/test_platform_middleware_suites_wired.py && make -n platform-test-middleware > /dev/null"
verify = "python3 -m pytest -q tests/ci/test_platform_middleware_suites_wired.py && python3 -m pytest -q services/platform/middleware/conformance/pay6 services/platform/middleware/examples"
evidence = "Private runner gate ledger and build/verify logs; the final task response copies the exact revision, command, exit and log."
limits = "Only the declared build and verify gates qualify this task. Workspace npm tests and the FastAPI suite are wired for the platform workflow; they are not additional sandbox qualification gates."

[repair.receipt_digest]
observed = "The pay6 TypeScript and Python peer fixtures recomputed receiptDigest as keccak256 of signed bytes; seller verification requires the producer's signed receipt digest, causing verification-failure and a teardown error."
change = "Retain the current TypeScript verifySequencerReceipt and Python verify_sequencer_receipt derivations landed by tasks 22.39.146 and 22.39.136: receiptDigest is the verifier's SHA-256 domain digest of the unsigned receipt encoding. The seed's direct vector-field assignment is superseded; all assertions remain intact."
proof = "services/platform/middleware/conformance/pay6/test_agent.py::AgentBudgetTests::test_budget_receipt_commit_and_replay"

[continuation]
starting_revision = "1dc3d5dca894a9db8002e0144c5e148a8731e19d"
prerequisites = "22.39.136 at 0a5febebdd6e70cdef77b327d9c5815bdc472d0b and 22.39.137 at 13c3f20ce4f04a7e316546dd59b68926659c3bb2 are merged into the checked-out continuation."
change = "Resolve both seeded fixture conflicts in favor of the current verifier-derived receipt digest while retaining the attempt-1 workflow wiring, three wiring tests, FastAPI extras and suite-local SDK paths. No Python SDK module is edited by this task."

