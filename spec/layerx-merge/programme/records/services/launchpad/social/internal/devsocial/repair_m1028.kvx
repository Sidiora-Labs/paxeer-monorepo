evidence = "/out/run/gates.jsonl records hf-build and hf-done for the unchanged final candidate; no agent commit or push is performed."

[gotcha.4]
observed = "HTTPStreamAuthority.call accepts HTTP 200 for session:check; an HTTP 204 response makes principal revalidation fail and frozen-report writes return AUTH_EXPIRED even after request authentication succeeds."

