log = "/out/logs/verify-1.log; compiler detail: /tmp/repair-m1028.log"
observed = "The new pgwire peer supplied an integer cancellation key, but pgx v5.10 requires a byte slice; corrected without changing assertions."

[gotcha.3]
observed = "pgx v5.10 BackendKeyData.SecretKey is a byte slice; the fixture also declares JSONB byte-slice parameters to match production prepared-query inference when using extended execution without preparation."

[continuation.2]
