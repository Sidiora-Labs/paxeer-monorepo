[note.test-registration]
observed = "Vitest 4 interprets test(functionName) without a second handler argument as a todo, so attempt 1's named proofs did not execute assertions."
resolution = "Register each declared proof function as both its test title and handler, retaining every assertion and making every declared repair test executable."

[note.receipt-runtime]
observed = "The production SDK package exports build artifacts that are not present in the task environment."
resolution = "The test helper loads the committed production verifier and wallet codec sources through the Node LTS in-process TypeScript loader and source aliases, with no SDK build, subprocess or substituted implementation."

[note.scope]
observed = "The repository workflow asks for GOTCHA/spec updates and publication outside this task's authorized paths."
resolution = "This task-local record retains the findings and wiring requests; spec files and GOTCHA are not edited, and the runner owns publication."

[note.database-interface]
observed = "The installed PGlite socket QueryQueueManager.processQueue services only lastHandlerId while db.isInTransaction(). signRoutes.runWalletOperation holds a transaction while awaiting limiter.consume, then holds another while awaiting NonceStore.withLock and signature accounting on other clients. Their independent commits cannot be represented by nested savepoints or copied tables without changing the real route semantics."
resolution = "Historical finding answered by prerequisite 22.31.517; the task consumes the repaired production signing-session path and retains every route and receipt assertion."

[note.daemon-corpus]
observed = "The committed vector-v1 collection contains the same five ordinary EIP-1559 cases plus one ordinary node recording; the V2, V3, V4 and tests/daemon/fixtures/programs-commit-reopen.json recordings also have zero sponsor."
resolution = "Historical corpus assessment was incomplete: 22.31.509 already supplied V6. The lookup now loads V1 and the V6 deployment, sponsored positive and ordinary-transfer refusal cases by complete raw transaction, preserving the int64 key-height bound without JSON rounding and checking the producer receipt digest."

