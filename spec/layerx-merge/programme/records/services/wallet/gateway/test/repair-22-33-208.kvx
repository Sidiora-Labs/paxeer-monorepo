[note.v6-key-height]
observed = "V6 pins encode last_height as the int64 maximum, which ordinary JSON number parsing rounds."
resolution = "Preserve the numeric token as a decimal string before parsing and convert it to bigint for the production codec and verifier; never enlarge the governed height range."

