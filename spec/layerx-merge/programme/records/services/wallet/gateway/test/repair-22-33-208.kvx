[finding.station-port-reservation]
implementation = "Both provisioning harnesses reserve all ten listeners together and release each distinct API/peer pair immediately before spawning its daemon."
test = "stationPortReservationRetainsAllTenListeners"
qualification = "Pending the declared gates."

[finding.provisioning-empty-receipt]
implementation = "Empty receipt construction and the station handler's direct applyBind call are removed; receipt evidence must match the complete submitted transaction and authenticate with the production codecs. Existing recovery and two-authorization-challenge scenarios remain registered."
test = "provisioningRequiresNodeExecutedSponsoredBind"
recovery_test = "provisioningReceiptTransportRecoversWithoutResubmission"
qualification = "Pending the declared gates. V6 positive execution is authenticated, including the bind signature, LayerXBound and Sponsored events, delegation designator and measured balances; the transport recovery case now reopens RpcPool and its loopback node with that same sponsored envelope and proves no second broadcast. V6 refusal authenticates as a plain transfer but is rejected as sponsored binding evidence."

[finding.sponsor-json-receipt-assertion]
implementation = "The station retains the signed EIP-7702 envelope, forwards only its matching recorded node receipt, and uses production canonical verification. Exact response, fee, status and nonce assertions remain; duplicate submission must retain the hash and consume no additional sponsor nonce."
test = "sponsoredSubmitReceiptRequiresCanonicalSponsoredExecution"
qualification = "Pending the declared gates. The real walletSponsorRoutes and GasStationClient replay the recorded V6 calldata and authorization through loopback station and RpcPool transports; successful, disconnected-status, disconnected-submit and unavailable-sequencer cases retain their status, fee, nonce and duplicate-submit assertions. The authenticated plain-transfer recording cannot satisfy sponsorship."

[finding.hash-only-wallet-receipt]
implementation = "The node vector's public conformance key is encrypted with the production wallet codec and loaded by the real wallet/send route; JWT verification, SQL nonce allocation and production signing reproduce the recorded raw transaction exactly. The unchanged canonical node receipt is authenticated after passing through RpcPool and the gateway response, and signed-field and pinned-key mutations are rejected. All four receipt-rung scenarios and both server-assigned and caller-supplied nonces remain covered using an in-process PostgreSQL engine."
test = "walletSendReceiptAuthenticatesCanonicalNodeEvidence"
qualification = "Pending the declared gates. The production pool is closed before selecting the in-process engine, DATABASE_POOL_MAX is set to 1 before migrations open it, and prerequisite 22.31.517 supplies the production signing-session fix. All four rungs and both nonce choices still run the real wallet/send route."

[wiring.node-execution-evidence]
request = "daemon/committed-fixture/vectors/vector-v6-sponsored-bind.json — node/runtime owning domain 5: supply canonical sponsored bind and plain-transfer refusal recordings, measured fee-payer balances and governed receipt pins."
resolution = "Answered by 22.31.509: the mirrored sdk/platform/conformance/fixtures/vector-v6-sponsored-bind.json is loaded beside V1 and indexed by the entire raw transaction; no producer files are modified."

[wiring.wallet-transcript-inputs]
request = "services/wallet/attestor — wallet owning domain 12: supply deterministic inventory-authorized attestor inputs for the full external-daemon provisioning scenarios; retain their recovery and two-challenge assertions."
resolution = "The declared portable gate uses the committed V6 sponsored envelope directly, including its original account, relayer and delegation signatures; the sponsored-submit test shares that real gateway-route proof. External-daemon scenarios are retained and are outside the declared gate."

[note.database-install]
observed = "Attempt 1 failed typecheck because the existing services/wallet/gateway/src/db/package.json dependencies had not been installed."
resolution = "Superseded by prerequisite 22.31.447: the gateway manifest and wallet lockfile now declare the in-process database packages. No nested manifest or test-time installation is added here."

[wiring.portable-wallet-route-store]
request = "services/wallet/gateway/src/routes/sign.ts, src/db/pool.ts and src/db/signatureAccounting.ts — wallet owning domain 12: remove pool acquisition while the send route already owns its transaction client."
resolution = "Answered by 22.31.517, merged in prerequisite revision 8270ce4fa7074f075328b080cc3f33217ade6052: production signing sessions reuse the checked-out client across short transactions; this task sets DATABASE_POOL_MAX to 1 before opening the pool."

