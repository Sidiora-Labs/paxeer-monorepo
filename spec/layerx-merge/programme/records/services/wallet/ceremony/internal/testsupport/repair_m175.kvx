[repair.22.33.175]
finding = "ceremony-simulated-protocol"
proof = "TestRepairM_175_RealProtocolRefreshAndDescribe; TestRepairM_175_PartialCommitAndReopen; TestRepairM_175_ExternalConfigProductionClient; TestRepairM_175_ExternalConfigIndependentMembers"
status = "Implemented; closure is conditional on the bounded hf-build and hf-done evidence for this candidate."
baseline = "Attempt 2 revision 828207dd2138049cbca9e99004eeb3d35803e6e9 and the supplied attempt 3 evidence failed TestRepairM_175_RealProtocolRefreshAndDescribe: distributed-refresh reported unchanged shares and durable-description received 404; no extra unchanged baseline gate was run."
producer = "StartCeremonyNodes constructs the actual attestor Server via CeremonyNodeConfig.Open, retains its authority-checked describe and refresh routes, and starts the production pinned mTLS peer transport with independent encrypted bbolt stores and audit logs."
bridge = "The existing public dealer.ShareBundle alias exposes only the embedded constructor configuration; dealer primitives move unchanged into dealershare behind forwarding compatibility methods to avoid a server/dealer import cycle, with internal protocol imports following that primitive package."
transport = "ExternalAttestorConfig validates independent endpoints, member IDs, certificate pins and production TLS material before creating the production ceremony client; fixtures supply real signed custody inventory and distinct gateway/operator authorities."
refresh = "The secp256k1 proof keeps the existing changed-share and complete durable-description assertions, replacing the simulator with real production HTTP servers and reopening all five encrypted stores before describing."
recovery = "The Ed25519 proof closes one real store after the durable coordinator commit decision, observes four committed epochs and one retained stage through the production HTTP recovery interface, reopens and replays the original refresh session, then reopens every participant and obtains a genuine three-party verification signature for the original public identity."
secrets = "All disposable dealer shares are wiped before refreshing or recovering; the fixture compares hashes of individually held scalars and never interpolates production secrets."
evidence = "The private hf-build/hf-done gate ledger is authoritative for the exact verified candidate revision, command, exit code and log path; no unexecuted gate is claimed here."
module = "Attempt 5 runs go mod tidy in services/wallet/ceremony to declare the root module and transitive production attestor dependencies required by the embedded Server constructor, and retains the resulting go.mod and go.sum without upgrading existing dependency versions."
wiring_request = "services/wallet/ceremony/cmd/ceremony/main_test.go (wallet domain 12): migrate the out-of-scope legacy simulator consumers to StartCeremonyNodes with signed inventory and durable ceremony identities."
gotcha = "Go's internal boundary also applies to sibling modules; expose the constructor through an existing public type alias and remove the dependency cycle rather than importing attestor/internal from ceremony or copying production handlers."
module_gotcha = "Importing the production Server through the public share alias expands the ceremony module dependency graph; its own go.mod and go.sum must record that graph before a readonly build can qualify the fixture."
