[repair.22.33.174]
findings = ["rehearsal-stale-options", "migration-ledger-atomicity"]
finding_rehearsal_stale_options = "TestRepairM_174_RehearsalStaleOptions, TestRepairM_174_IsolationRefusals, TestRepairM_174_TLSIdentityPins, TestRepairM_174_CopyDigests"
finding_migration_ledger_atomicity = "TestRepairM_174_MigrationLedgerAtomicity, TestRepairM_174_MigrationFailuresRollback, TestRepairM_174_TransactionControlSQL, TestRepairM_174_RejectsEnclosingTransaction"
implementation = "Each supported migration executes in one explicit transaction with its ledger lookup and insertion; extended-protocol single-statement execution prevents an ambiguous split from running multiple commands, and transaction-control SQL is rejected before execution."
isolation = "The legacy options helper starts two real daemon groups with identical pinned member identities, independent encrypted stores, protected separate journals and explicit RPC evidence; the service-free gate drives the real options loader and pinned mTLS client through loopback transcript peers and verifies real COPY stream digests."
postgres_proof = "TestMigrationLedgerAtomicityPostgresAfterInterruption installs a real PostgreSQL trigger that terminates the migration connection during ledger insertion, reopens, asserts both effects and ledger rolled back, retries and reopens again to prove exactly one effect and ledger row; this companion is outside the mandated service-free filter and has not been run."
baseline = "No unchanged-tree verify was run: the explicit implementation-first order and exclusive hf-build/hf-done gates supersede the contradictory baseline instruction; there were no pre-existing repair tests or gate ledger entries, and no baseline failure is claimed."
continuation_baseline = "The supplied attempt-1 qualification failed TestRepairM_174_MigrationLedgerAtomicity and TestRepairM_174_MigrationFailuresRollback/execute, /record and /commit before this continuation; the transcript expected unpadded literals but pgx emits padded simple-protocol substitutions. No redundant unchanged-tree gate was run."
continuation_repair = "Match the exact pgx wire SQL for ledger lookup and insertion, retaining all transaction, error, rollback, reconnect and no-replay assertions."
wiring_request = "Domain 12, services/wallet/ceremony/internal/testsupport/postgres.go: populate source wallet fixtures with retained DID/provisioning/binding evidence and publish approved original-identity and secp256k1 inventories to both real daemon groups; InsertWallet currently creates only the legacy address/envelope row, so full protocol integration cannot succeed against the current migration identity contract."
postgres_wiring_request = "Domain 12, services/wallet/ceremony/internal/testsupport/postgres.go and the wallet integration gate: qualify TestMigrationLedgerAtomicityPostgresAfterInterruption with supported PostgreSQL binaries; this task's required gate explicitly forbids a PostgreSQL dependency."
gotcha = "Go's internal-package boundary prevents ceremony from importing the attestor server harness; the repair gate uses production ceremony components with bounded loopback protocol fixtures, and the unselected legacy integration suite starts actual daemons rather than the testsupport threshold simulator."
evidence = "The final hf-done receipt records the exact candidate revision, command, exit code and private evidence location; no unrun service-bound companion result is claimed."
