[qualification.continuation_first_pass]
revision = "e2526455202adb5cc6409b80f7ee759e251dee0b"
command = "cg spec done 22.31.513 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "After merging 22.31.520, policy, loadtest, ceremony attestor and move passed; rehearsal and command fixtures failed with ERR_MODULE_NOT_FOUND for @noble/hashes in the agent SDK sequencer-log.ts."
cause = "The gateway TestChain imports the real agent SDK sequencer log codec outside the wallet pnpm workspace; installing the wallet workspace does not install the SDK's dependencies."
