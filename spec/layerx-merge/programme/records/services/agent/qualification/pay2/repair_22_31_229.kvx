cause = "The funded lifecycle imports were absent and LocalSigner::new supplies only an Ed25519 key."
do = "Compile the registered target, load explicit provisioned inputs with real dual-key account derivation, and exercise shared signing/codec helpers in the self-contained repair gate."

[gotcha.offline_resolution]
