repair = "Decode recorded event data with the shared SDK ABI decoder as well, and attach the mismatching recorded event field to the existing verification failure; preserve the success assertion and signed digest check. The previously recorded producer context inconsistency still requires the owning web-search domain."

[continuation5]
implementation = "Reviewed and retained the inherited repairs and all 18 parametrized cases; preserved the signed event digest check and recorded draw success assertion."
producer = "services/interop/crates/x-websearch/tests/payment.rs::recorded_draw hashes the serialized payment into draw calldata but hard-codes a zero event context at line 2639; the current producer still reproduces the recorded inconsistency."
scope_conflict = "services/platform/hosted/registry/src/routes.rs contains registry deployment/interface routes and no PaymentDrawn producer; changing that file cannot repair the named draw producer."
wiring_request = "services/interop/crates/x-websearch/tests/payment.rs and its gateway recording — web-search domain: retain the computed payment context and use it in both draw_calldata and PaymentDrawn event data, then regenerate the transcript into the allowed SDK directory."
recording = "Re-recording was not run: the current source still emits the inconsistent event, and the only allowed build/verify gates do not invoke its Rust recording harness. No receipt was fabricated or re-signed to bypass the producer defect."
qualification = "Run only hf-build and hf-done; their private ledger records exact revision, command, exit and log. The pending scope clarification is required to repair the actual producer."
gotcha = "The continuation ruling names hosted registry routes as the PaymentDrawn producer, but the actual draw fixture producer is the web-search payment test outside this task's scope."

[continuation6]
baseline = "The inherited attempt 5 evidence records 17 passed and test_grant_receipt_kind_from_recorded_server_producer failed at event.data_digest; no extra baseline gate is run."
producer = "The current authoritative path is precompiles/layerxledger/payments.go::draw -> modules/layerxledger/keeper/draw.go::Keeper.Draw -> paymentLogs -> modules/layerxledger/keeper/events.go::LedgerEvents; the earlier registry and web-search producer instructions are withdrawn."
context = "payments.go forwards input.ContextHash unchanged to DrawArgs and EventArgs; events.go copies args.ContextHash unchanged into PaymentDrawn. The SDK already binds that exact calldata field in the signed event digest, so substituting zero or accepting the mismatching recording would weaken verification."
blocker = "Keeper.Draw unconditionally returns ErrNoPayerGrant after pause and authority checks. TestPrecompileDraw asserts LXP_NO_PAYER_GRANT, unchanged balances and no logs for every draw; proof_layerxledger_0x101a_test.go additionally asserts that a refused draw must not invent PaymentDrawn or Transfer."
recording = "No successful draw/event/receipt can be recorded from this producer's current Go harness. No recording run, fabricated receipt, re-signing, helper toolchain project, test weakening or out-of-scope ledger edit is used to hide that missing producer path."
wiring_request = "modules/layerxledger/keeper/draw.go and precompiles/layerxledger/payments_test.go — ledger domain: provide an authorized successful draw path and its Go-harness recording of signed calldata, emitted events and receipt, or supply an existing authoritative recording, before the SDK success test can qualify."
retained = "All inherited SDK repairs, all 18 parametrized cases, the failing recorded draw success assertion and its binding diagnostics remain intact; only this in-scope repair record changes in continuation 6."
qualification = "Only hf-build followed by hf-done runs qualification; the runner ledger supplies the exact final candidate revision, command, exit and private log. The runner owns publication; no source changes follow the final verification."
gotcha = "A declared ABI event and an event projection unit test do not establish successful execution: the real precompile exits before paymentLogs when the keeper refuses the retired payer-grant path."

