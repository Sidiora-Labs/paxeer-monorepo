[continuation7]
baseline = "Inherited attempt 6: 17 passed, 1 failed at event.data_digest; the final ruling withdraws every successful-draw recording instruction, so no unchanged baseline gate is repeated."
authority = "Decision 2340 and precompiles/common/lxp_errors.go register LXP_NO_PAYER_GRANT, no payer grant, kernel code -214, nonretryable; modules/layerxledger/keeper/draw.go refuses before any payment event is emitted."
implementation = "verify_payment_receipt and verify_rpc_payment refuse any grant binding, metered scheme or subscription scheme before verification, including submitted RPC results. PreparedGrantDraws registration, resolution and calls refuse before any persistence or send. AgentGrantMiddleware refuses before reserving budget, and PaymentBudget refuses grant evidence before committing it. Only payExact and PaymentExact remain accepted payment method/event kinds."
recording = "Removed recorded_web_draw and all consumption of the withdrawn signed draw receipt. No stale successful-draw recording exists inside the task paths; deletion of the shared external gateway recording is requested in wiring.draw-context."
tests = "Retained every test function and every unrelated case. The recorded-server-producer case now proves the registered refusal through production verifiers, RPC, web-search and agent middleware while payExact still succeeds. Two grant-dependent cases adopt retirement: ABI bounds and individual transaction binding refusals remain asserted; RPC send preserves typed refusal, registration never sends, and reopening retains refusal without durable draws."
gotcha = "The earlier instruction to keep all other cases unchanged conflicts with two cases that require grant verification or submission to succeed. Their positive retired-path assertions are replaced by the explicitly required refusal behavior; all codec, binding and exact-payment assertions remain enforced."
qualification = "Only hf-build then hf-done qualify the final tree. The runner owns exact candidate revision and private evidence logs, spec status and publication; no source changes follow the final passing gate."

[continuation8]
baseline = "Attempt 7 qualified all 18 cases at 2ef5e454b1a5ffebe625b81b9b6636b97be94584; publication conflicted with later domain changes, so this continuation integrates onto base 76c050242a1edcad6212aa52fac15670ecb5612d without repeating an unchanged baseline gate."
implementation = "Resolved all six seed/current conflict hunks. Preserve the published EIP-155/type-2 decoder in x402 and x402_rpc and the published web-search payer-address owner binding; integrate ledger accountId lookup for non-native assets while native PAX keeps the published compatibility alias."
tests = "All inherited assertions remain. The four-currency loopback test now also resolves a registered DID distinct from the padded EVM owner, proving that payer accounts continue to bind the address owner on both native and non-native branches."
gotcha = "The resolved address precompile DID may differ from the padded EVM owner used by the ledger producer; merging the seed's DID-based payer derivation verbatim would regress the published owner binding. The runner-provided .cgignore and spec status changes are bookkeeping outside the candidate sources and are left untouched."
qualification = "Only hf-build and hf-done qualify the final unchanged source tree; their ledger records the exact candidate revision, command, exit and private log. Publication belongs to the runner."
