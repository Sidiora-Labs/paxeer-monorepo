[boundaries]
committed = "Independently pinned Comet validator set at one explicit landing height; Comet header, vote, signature and transaction-inclusion codecs checked against the committed node transcript; no height/hash DTO authority."
mirror = "Production MirrorVerifier request construction and result decoding traverse loopback HTTP via its explicit process-wire exchange boundary; the default subprocess implementation remains available. The peer uses the executable report schema and the committed block/receipt recording; no external executable runs in pytest."
registry = "The registry serializer field contract is checked in source; its response schema traverses a loopback route, AgentHttpTransport and the actual ProgramOperations client with numeric freshness and deployment_receipt_digest intact."
web-search = "Existing Rust server and gateway recordings preserve offer, header and account shapes; native PAX aliases remain separate from ledger accountId lookup. No recorded draw receipt is consumed."
draw = "Decision 2340 retires payer grants. Registration, resolution, middleware and receipt consumers refuse LXP_NO_PAYER_GRANT before submission, reservation or verification; reopen preserves refusal and an empty durable draw store."

[wiring]
ledger = "precompiles/layerxledger/payments.go — ledger domain: preserve the decision 2340 refusal; prior requests to restore grant execution or record successful draws are withdrawn by continuation 7."
consensus = "services/evm/rpc — EVM/consensus domain: expose committed Comet header, validator trust anchor and transaction proof; for wrapped Cosmos EVM transactions expose authenticated extraction/inclusion binding to the raw EVM transaction."
raw-payment = "services/evm/rpc — EVM RPC domain: expose authenticated raw transaction retrieval for supported exact payments; the earlier server-submitted draw request is withdrawn."
draw-context = "services/interop/crates/x-websearch/tests/payment.rs and tests/fixtures/gateway/metered.json — web-search domain: remove the retired successful-draw receipt recording; this out-of-scope file remains used only for offer/account/ABI metadata here, never as receipt evidence."

[qualification_observation]
first_verify = "ab959f40b0f64e87f808fe0b4fd271ff311a84a4; cg spec done 22.31.147 -f layerx-merge --root /work/paxeer-monorepo; exit 1; /out/logs/verify-1.log; new test collection bracket typo repaired."
bytecode = "py_compile wrote bytecode inside the task directory; subsequent gates redirect Python bytecode to a temporary cache to preserve candidate identity."
landing = "A transaction landing hash is retained at the receipted rung across reopen; only pinned validator signatures and inclusion evidence permit the committed rung, finalized state and matching checkpoint."
draw_transport = "Recorded gateway draw transactions use EIP-155 legacy signatures; the RPC payment consumer uses the same validated payment decoder as its receipt verifier."

[qualification.draw_context]
revision = "318afa643439b041e7f51918eba4715be52614dc"
command = "cg spec done 22.31.147 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The recorded gateway draw's signed PaymentDrawn event contains a zero contextHash while the signed draw calldata carries a nonzero contextHash; the success assertion fails because verification refuses this mismatch."

[continuation]
implementation = "Retained the inherited SDK repairs and all 17 test cases; replaced external Go, C and Rust test producers with in-process signing peers and loopback HTTP, removed the Go helper, and used the validated EVM payment decoder for both buyer and draw transaction binding."
known_blocker = "The inherited grant receipt success assertion remains intact: the out-of-scope Rust recording signs a PaymentDrawn event with zero contextHash although its signed calldata contains a nonzero contextHash; weakening event verification or changing that assertion is prohibited."
qualification = "Only hf-build and hf-done run the declared commands; the final gate ledger supplies the verified revision and private evidence location. The runner owns spec status and publishing."

[gotchas]
process_peers = "A Python gate must not compile Go/C/Rust fixture producers or require the mirror binary; production SDK entry points use in-process protocol peers and a real loopback HTTP boundary."
candidate = "Set PYTHONPYCACHEPREFIX outside the repository for py_compile and verification so the build and verify candidate revisions stay equal; do not edit any source after the final verification."

[continuation4]
implementation = "Decode signed draw calldata using the SDK canonical static ABI decoder for both production verification and the recorded-producer test; derive grant ID, recipient, amount, idempotency key, sequence, purpose and context from its typed fields."
diagnostics = "PaymentBindingError retains verification-failure and retry never, and identifies draw binding fields, receive/grant fields or the signed event data digest without exposing field values. The signed event digest check and recorded draw success assertion remain intact."
tests = "test_draw_abi_decoder_and_binding_fields proves canonical draw vectors, malformed lengths/selectors, integer width bounds and individual grant binding diagnostics through the real signed receipt verifier."
evidence = "The final hf-build/hf-done runner ledger records the exact candidate revision and private evidence location; this record makes no prospective passing claim."

