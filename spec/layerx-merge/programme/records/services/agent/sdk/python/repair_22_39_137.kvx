reference = "services/platform/middleware/seller/src/rpc.ts:151-155 catches every verifySequencerReceipt failure and throws MiddlewareError verification-failure."
mapping = "verify_rpc_payment maps every PlatformSdkError from verify_payment_receipt, including SequencerReceiptVerificationError, to ValueError payment-binding-mismatch with the original failure as its cause; the subclass re-raise exemption is removed."
preserved = "The prior hosted gateway client, pre-request transaction decoding and committed evidence authentication stand unchanged; the local suite retains exact ValueError names for both commitment paths."
evidence = "The continuation hf-build and hf-done rows in /out/run/gates.jsonl record the exact final candidate revision, commands, exits and private logs by reference; both must qualify the same candidate."

[qualification.continuation_verify]
