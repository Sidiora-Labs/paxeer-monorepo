[repair.22.39.171]
acceptance = "22998.1"
base_revision = "6eeea3b0755ea285d12cdb7556cbd536e3a912d9"
continued_tree = "af91dcafa5a4a349dcbda0d02e8e1fc3682e878b"
qualified_revision = "The candidate revision in the final passing build and verify rows of /out/run/gates.jsonl; both rows must match. This record does not claim a gate result before execution."
baseline_execution = "The supplied attempt-1 evidence is the before inventory. No reproduction was rerun: the continuation permits only hf-build and hf-done after complete implementation."
identity = "Local identity already hashes global sequence and canonical bytes independently of the cursor. Chain identity, receipt evidence, deduplication, strict subscription refusal, LXS3 encoding and acknowledgement rules stay unchanged."

[derivation]
decision = "2985 amends 2984; 2986 updates the two legacy subscription consumer assertions."
anchor_source = "The durable ingestion watermark supplies last_position.block_height, or zero before any journaled chain log. Pending logs never change that watermark. Each local event captures that height and its own counter in its evidence metadata in the same atomic record_event or record_local_event write as the bytes and watermark. Delivery reads that immutable metadata, never the latest watermark."
local_cursor = "(captured block height, u32::MAX, per-anchor counter). The first local event under an anchor uses counter zero. The previous journaled event's durable metadata supplies the counter for checked increment; a preceding chain log or no previous anchored event starts a new counter at zero. Counter overflow refuses ingestion with SequenceExhausted before any write; it never carries into transaction or block height."
chain_cursor = "Every chain log uses its exact block height, transaction index and log index with no insertion offset, including mixed streams and recovered logs."
ordering = "new_head journals all pending logs of a closed block in position order. Local events occupy the suffix of the last journaled block, before any later block, and consecutive locals follow journal sequence order. The attempt-1 flush_pending_through admission function is removed; new_head retains its original block journaling path."
recovery = "The last local counter survives ingestion restart without needing retained event bytes; delivery restart retains the exact cursor, event identity and replay bytes even after newer chain blocks have been journaled. Legacy metadata without an anchor keeps the original (global_sequence + 1, 0, 0) local delivery cursor by explicit decision 2985."

[encoding]
format = "LXEM evidence and attributes remain unchanged. A local event has an optional 16-byte LXA2 trailer: magic (4), anchor block height (8), counter (4), all integers big-endian. Chain and pending log metadata need no trailer. The unpublished attempt-1 37-byte LXA1 insertion-offset encoding is replaced because decision 2985 removes that derivation; the deployed LXEM-only encoding remains readable."
atomicity = "The existing store EventIngestion transaction persists bytes, metadata (including both anchor and counter), and watermark atomically, restoring the map on persist failure. Metadata is LocalOnly. Receipt promotion preserves an existing anchor. Malformed, truncated or trailing metadata is refused; absence alone selects the explicitly required legacy ordinal contract."

[literal.delivery]
case = "loaded_seam_is_ordered_observable_and_has_no_duplicate"
change = "Attempt-1 (0, 0, global_sequence + 1) becomes (0, MAX, global_sequence) for the genesis fixture; an adjacent comment records it. The shared start remains zero before all locals, with a nonzero ordinal N represented by (0, MAX, N - 1)."

[literal.delivery_filtered]
case = "start_before_filter_subject_genesis_transitions_before_first_live_match"
change = "Original (6, 0, 0), attempt-1 (0, 0, 6), becomes (0, MAX, 5); recorded beside the assertion."

[literal.delivery_large_sequence]
case = "genesis_anchor_counter_starts_at_zero_for_large_sequences_and_survives_reopen"
change = "The high global sequences MAX-1, MAX, MAX+1 now produce (0, MAX, 0), (0, MAX, 1), (0, MAX, 2), replacing attempt-1 transaction carry. The case keeps ordered delivery and identical replay across reopen, and explicitly proves counter zero is independent of initial journal sequence."

[literal.delivery_legacy]
case = "legacy_local_event_without_a_durable_anchor_keeps_its_ordinal_cursor"
change = "The attempt-1 CursorAnchorUnavailable refusal is replaced by the decision-2985 legacy contract: exact original bytes at (1, 0, 0) for sequence zero, accepted and acknowledged. The persisted fixture removes only the new trailer to represent deployed LXEM-only metadata."

[literal.subscription]
case = "anchored_local_cursors_keep_strict_delivery_and_exact_acknowledgements"
change = "Attempt-1 (0, 0, 1) and (0, 0, 2) become (0, MAX, 0) and (0, MAX, 1); adjacent comments record both changes. Duplicate delivery refusal, never-delivered acknowledgement refusal and exact durable acknowledgement survive unchanged."

[literal.subscription_cursor_v3]
case = "anchored_local_counters_use_the_same_lxs3_record"
change = "Attempt-1 (0, 0, MAX) and (0, 1, 0) become (0, MAX, MAX-1) and (0, MAX, MAX), with adjacent comments, exercising the top of the counter space without a transaction carry. The full LXS3 restart and exact outstanding acknowledgement assertions remain."

[literal.history_block_cursor]
case = "history_cursor_is_the_block_position_triple"
change = "Attempt-1 local carry triples become (0, MAX, 0) and (0, MAX, MAX), with unchanged sixteen-byte round trips and all original raw-position checks. The ordering assertion proves the greatest local counter precedes (1, 0, 0)."

[literal.legacy_upgrade]
cases = ["legacy_subscription_without_a_session_generation_requires_cursor_reset", "lxs2_subscription_record_requires_cursor_reset"]
change = "Per 2986, CursorResetRequired becomes UpgradeRequired with exact tenant and subscription identifier plus the full display text directing Store::recover_legacy. Every legacy-byte preservation assertion remains; no production mapping changes."

[proof.approval_events]
replaced = "The unadmitted same-block prefix case is replaced by local_approval_between_closed_blocks_keeps_journal_order_after_restart and local_approval_while_next_block_is_pending_keeps_journal_order_after_restart."
assertions = "Both cases use real EventIngestor log ingestion, new_head block journaling, ApprovalEvents emission and DeliveryEngine delivery/accept/ack. They prove a two-log block stays together; pending next-block logs leave the anchor unchanged; the counter increments across ingestor restart; seven journaled events have exact, strictly increasing cursors; unacknowledged approval replay after delivery restart preserves identity and bytes; a later anchor resets its local counter to zero."
restore = "approval_lifecycle_stream_resumes_after_gap_and_exports_digest_evidence keeps every finding-18.1150.1.1 assertion: four approval bytes then the recovered log exactly once, strictly increasing cursors, digest-only evidence export and all lifecycle decisions. Store::open still creates the private root from the carried attempt."

