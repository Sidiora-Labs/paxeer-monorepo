[repair.22.31.495]
gotcha = 3028
acceptance = "22998.1"
implementation = "ApprovalService list/get and DecisionRequest carry explicit TimestampSeconds beside the current sequence; scoped reads and claims use the timed policy APIs. decide_at and timed reads share the same window validation. Untimed policy APIs retain ClockRequired."
baseline = "The initial working tree contained runner bookkeeping only and no gate ledger entries. No pre-change test execution is claimed."
qualification = "The runner's private hf-build/hf-done ledger records the exact verified candidate revision, command, exit and evidence location; cg spec done retains the verified revision without force."

[tests]
path = "services/agent/crates/layerx-agentd/tests/repair_22_31_495.rs"
proving = ["durable_awaiting_hold_lists_gets_and_approves_with_explicit_time", "durable_awaiting_hold_rejects_with_explicit_time", "reopened_awaiting_hold_decides_with_explicit_time", "time_before_reservation_is_refused_without_deciding"]
proof = "Real durable Store, BudgetLimiter reserve_and_hold_at, ApprovalRegistry, ApprovalExpiry and ApprovalService paths prove visibility, exact preparation release, rejection and reservation release, full store reopen and recovered decision, and backwards-time refusal without changing the pending hold."

[callers]
path = "services/agent/crates/layerx-agentd/src/human_runtime.rs"
changed = ["UnifiedAgentOwner::approval_decide (approve and reject plus the prerequisite scoped read)", "UnifiedAgentOwner::approval_list_facts", "UnifiedAgentOwner::approval_get_facts", "UnifiedAgentOwner::approval_budget_after", "UnifiedAgentOwner::approval_list", "UnifiedAgentOwner::approval_get"]
clock = "Each entry samples the existing authenticated runtime clock and refuses unavailable or zero-generation readings; that explicit time accompanies the current sequence to the service."
source_tests = "Six DecisionRequest constructors in src/approval/mod.rs receive explicit test time; focused approval and approval_ops tests use timed policy entries and preserve their assertions."

[finding.scope]
observed = "The declared --tests build includes tests/approval_ordering/mod.rs, tests/approval_semantics.rs, tests/human_projection_facts.rs and tests/human_approval_budget_actor.rs, whose ApprovalService or DecisionRequest callers also require migration but are outside the original allowed paths."

[finding.build_1]
