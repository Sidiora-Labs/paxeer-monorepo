wiring_mcp_consumer = "Domain 9: services/agent/crates/layerx-agentd/Cargo.toml needs a layerx-mcp dev-dependency, or services/agent/crates/layerx-mcp/tests needs the publisher harness, to execute Binding::open on the published web document; neither path is writable here, and the existing one-way dependency is preserved."
wiring_host_gate = "Domain 9: services/agent/crates/layerx-agentd-host/Cargo.toml owns src/main.rs; its host build must qualify the new payer/receiver configuration and complete receipt key index, since the declared agentd gate does not compile that entry point."
wiring_mcp_reconciliation = "Domain 9: services/agent/crates/layerx-mcp/tests must prove terminal native-effect reconciliation with authenticated state evidence; session_control.rs retains its STATE_PROVEN requirement and the current node history-evidence interface in human_runtime.rs is unavailable, so a signature-only observation is not promoted to state proof."
wiring_proof_bundle = "Domains 9 and 16: services/agent/crates/layerx-agentd/src/read/proof_bundle.rs and node receipt-proof producers must agree on a declared authenticated protocol-receipt proof variant before Ed25519 protocol receipts can enter the EVM RLP/secp256k1 proof API; its checks remain intact."
