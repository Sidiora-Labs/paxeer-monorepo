[diagnosis.approval_records]
file = "services/agent/crates/layerx-agentd/src/approval/mod.rs"
cases = ["lock_order_tests::reject_and_receipt_settlement_under_one_limit_complete_concurrently", "reject_persist_tests::reject_under_an_unknown_limit_leaves_every_record_identical_and_retry_is_fresh", "defective_persist_tests::defective_approval_releases_every_held_limit_once_and_leaves_only_the_decision", "defective_persist_tests::defective_approval_under_an_unknown_limit_leaves_every_record_identical_and_retry_is_fresh"]
cause = "The three hold_records test helpers classify every PreparedActivity object as a live hold. The real registry now durably replaces rejected and defective holds with approval-terminal-v1 replay records in the same object namespace."
repair = "Select actual approval-hold-v1 records in those helpers. Preserve every empty-hold, byte-identical rollback, retry, queue, concurrent completion, budget and decision assertion. At each of the four affected success assertions additionally require the complete PreparedActivity key list to equal the exact expected terminal key, replay it through a fresh ApprovalRegistry, and require its exact terminal state, zero recovered reservation ids and zero held reservations."

[diagnosis.session_audit_roots]
file = "services/agent/crates/layerx-agentd/src/session_control.rs"
cases = ["tests::admit_write_with_a_failed_durable_write_releases_its_hold", "tests::submit_rewrite_with_a_failed_durable_write_leaves_the_limiter_as_it_was"]
cause = "The failed-write fixture deletes the store root to provoke real persistence failure, but the real authorization audit sink shares that root and recreates it during admission. The store still refuses the detached inode; only the fixture's unrelated directory assumption fails."
repair = "Give these two fixtures a separate nonce-qualified sibling directory for real durable observability before authorizing. Retain deletion of the store root, the exact Unavailable result, every lifecycle and accounting assertion and both original root-nonexistence assertions. Also assert that authorization audits were delivered, then remove their separate directory."

[diagnosis.budget_generator]
file = "services/agent/crates/layerx-agentd/src/budget/budget_proof.rs"
case = "tests::budget_proof_v2_node_answers_fixture_is_current"
cause = "The committed transcript already contains three ownership queries, but generated_answers ends before getEvmAddrByLayerX, getUnifiedAccount and accountOwner. The byte-equality assertion detects those omitted rows."
repair = "Extend generated_answers with the exact address and ledger calls, including the dynamic empty Pax address tail and the protocol-three DID identity computed through did_id_for_protocol. Keep the committed transcript outside this task unchanged and retain full byte equality and all DID-format checks."

[diagnosis.program_account]
files = ["services/agent/crates/layerx-agentd/src/read/committed.rs", "services/agent/crates/layerx-agentd/src/read/program_account_fixture.rs"]
case = "tests::program_views_decode_one_program_and_one_account_and_refuse_changed_settlement"
cause = "The old getValueAccount reply encodes balance 50 with exists=false, which decode_program_value_observation correctly refuses. The old reader entry also supplies no independently authenticated account status, which is now mandatory for populated accounts."
repair = "Encode exists=true and call read_program_records_with_account_proofs with a genuinely verified nested account proof. Produce the canonical account and all state-root commitments through the production Programs registry types, construct and sign the account snapshot receipt and batch header with the existing account-proof fixture encoding, and verify through verify_nested_account. Bind and re-sign the Comet checkpoint to that same root. Preserve all program, account, asset, registration, balance, unfrozen and changed-settlement refusal assertions."

[gotcha.fixture_namespaces]
observed = "PreparedActivity contains both live approval holds and terminal replay evidence; authorization audit delivery can recreate its directory independently of the Store's inode-anchored writer."
repair = "Assert exact record kinds and durable replay state, and isolate intentional store-root failure from the real audit sink."
