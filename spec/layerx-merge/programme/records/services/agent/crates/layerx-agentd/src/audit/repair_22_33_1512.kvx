[repair.22.33.1512]
audit_record = "22.30.91"
acceptance = "22998.1"
revision = "The bounded hf-build/hf-done ledger records the exact candidate revision and evidence; no unrun gate is claimed here."
baseline = "Not run: the explicit implementation-first order and bounded gates prohibit verification before implementation; the declared test target did not exist in the starting tree. No baseline failure is claimed."
wiring_requests = []

[finding.audit_concurrent_writers]
tests = ["audit_concurrent_writers_mcp_record_and_operator_handles_share_one_chain", "concurrent_first_open_serializes_initialization_and_appends"]
repair = "Tenant OS file lock covers initialization, recovery, tail refresh, append, anchor sync and intent removal. Readers take the same lock across verification and frame reads. The integration test drives the MCP record entry point and real operator Surface into the shared log and decodes both paths after reopen."

[finding.audit_append_crash_window]
tests = ["committed_record_recovers_after_real_anchor_publication_io_failure", "audit_append_crash_window_before_frame_write_recovers_old_tail", "audit_append_crash_window_before_frame_sync_recovers_only_exact_partial_tails", "audit_append_crash_window_complete_unsynced_frame_rolls_forward", "audit_append_crash_window_before_anchor_replacement_rolls_forward", "audit_append_crash_window_after_anchor_directory_sync_is_idempotent", "recovery_refuses_corruption_of_committed_prefix_or_pending_frame", "recovery_refuses_missing_committed_bytes_or_extra_tail", "recovery_never_rolls_back_a_published_anchor", "recovery_requires_intact_intent_and_an_expected_anchor", "absent_intent_never_authorizes_tail_repair", "successful_append_clears_intent_before_side_effects_and_detects_later_tampering"]
repair = "Sync and atomically publish a bounded checksummed intent containing the old anchor, byte offset and exact intended frame before touching the chain. Recover only an unchanged verified prefix and exact surviving frame prefix under an old anchor, or finish an intact complete frame under the old/new anchor. Clear and directory-sync the intent before the operation. Durability observers interrupt the production writer; partial-tail cases model lost unsynced bytes from its actual emitted frame."

[finding.audit_record_tenant_binding]
tests = ["audit_record_tenant_binding_refuses_before_all_mutation"]
repair = "Check owns_tenant before encoding or appending; return RecordError::Audit(AuditError::TenantMismatch) without changing chain, anchor, coverage or operation effects."

[gotcha.implementation_first]
observed = "The inherited baseline-test step conflicts with the explicit task order and there is no starting integration test target."
resolution = "Follow the explicit order; do not run an extra gate or claim a pre-change failure, and retain this explanation inside the authorized scope."
