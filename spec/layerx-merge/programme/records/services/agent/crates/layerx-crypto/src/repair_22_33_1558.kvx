[wiring.agentd_identity]
request = "services/agent/crates/layerx-agentd/src/{human_runtime.rs,human_runtime/subject.rs,human_runtime/subject/tests.rs} and tests/repair_22_31_366.rs — domain 9: replace SponsoredRegistration/OnboardingConsent nested activities with addr bindLayerX transaction and DID-consent fixtures using binding::BindAuthorization."

[wiring.client_binding]
request = "services/agent/crates/layerx-client/src/{paxeer_binding.rs,account_binding.rs} — domain 9: consume the shared binding::BindMessage/BindAuthorization codec and SigningRequest::bind for external DID key custody; preserve the already published raw-message vectors and chain nonce checks."

[wiring.sdk]
request = "services/agent/crates/layerx-sdk/src/agent_envelope.rs and services/agent/crates/layerx-agentd/tests — domain 9: migrate remaining activity disclosures and signing fixtures to canonical EVM transactions with explicit/recovered senders."

[wiring.human]
