[wiring.registry_contract]
request = "spec/layerx-merge/interfaces.kvx and maintained registry contract links under spec/layerx-merge/docs — domain 9/spec ownership: redirect contracts/agent-rust-api.md#crypto and #proof to services/agent/crates/layerx-crypto/src/api-contract.md#crypto and #proof; edit generated registry mirrors only through their owners."

[wiring.remote_bind]
request = "services/human/crates/layerx-human-kms/src/wire.rs and services/agent/crates/layerx-crypto/src/remote.rs — domains 10 and 9: version the remote producer/consumer together to authenticate raw bind signing purpose; protocol v1 currently explicitly refuses raw bind requests and continues scoped payer signing."

