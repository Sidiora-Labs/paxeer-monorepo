[finding.activity-disclosure-still-public]
implementation = "The continuation ruling retains and deprecates live bind and bind_budget_mutation with their original validation/decoders; canonical call disclosure uses explicit senders and reencode/validate_canonical now also consume type-2 bytes."
test = "activity_disclosure_still_public_is_closed_by_transaction_round_trip"

[finding.api-contract-document-absent]
implementation = "src/api-contract.md is the domain-9-owned current crypto/proof contract and is included directly by lib.rs; it documents raw bind/EVM/payer signing, governed receipt-key height pins, three rungs, typed refusals and committed-proof limits."
test = "api_contract_document_absent_is_closed_by_owned_contract_and_raw_bind_vector"

[finding.crypto-retired-exports]
implementation = "lib.rs removes the unused settlement-recipient export and deprecates live onboarding module/types/re-exports; call signing, typed bind consent, encrypted key storage and kernel payload codecs remain."
test = "crypto_retired_exports_are_closed_while_key_storage_and_signing_reopen"

[finding.nested-activity-onboarding]
implementation = "Live onboarding.rs types and their public module/re-exports are retained and deprecated under the continuation ruling; binding.rs produces and consumes canonical addr bindLayerX registration transactions with raw DID consent and recovered EVM sender."
test = "nested_activity_onboarding_is_closed_by_registration_transaction_and_consent"

[finding.old-send-envelope-constructor]
implementation = "Live EnvelopeOptions, DisclosedEnvelope and encode_send_envelope are retained and deprecated under the continuation ruling; CallOptions and ledger_payment_call retain identical native payment bytes inside canonical EIP-1559 calldata."
test = "old_send_envelope_constructor_is_closed_with_native_payload_compatibility"

[finding.recipient-binding-not-signed]
implementation = "No merged-network consumer of RecipientAuthorization exists in the Rust source inventory; settlement_recipient.rs and its public export are removed, so there is no unauthenticated replaceable binding_digest field."
test = "recipient_binding_not_signed_is_closed_by_surface_retirement"

[finding.keystore-accepts-activity-preimage]
implementation = "Unused SigningRequest::new is removed. Live sign_disclosed is deprecated and retains validated local signing; a distinct activity purpose is always refused by KeystoreSigner and RemoteSigner before I/O. Private constructors distinguish it from typed raw bind consent and canonical payer authorization, whose exact returned signatures are verified."
test = "keystore_accepts_activity_preimage_is_closed_before_and_after_reopening"
fixture = "A committed-key loopback OpenSSH protocol peer returns real Ed25519 signatures over the production signer's framed requests; no external binary, credential, live endpoint or environment variable is required. Both peer and signer stop/reopen, and exact request transcripts prove activity refusal occurs before I/O."

[migration.crypto_tests]
implementation = "The continuation ruling includes the crate tests in scope. Existing disclosure, disclosure_call, signer, remote, send_call, authority_grant, native_fee_grant and proof_crypto tests now use real type-2 payment calls, typed native payer requests, raw bind consent or the retained kernel payload codecs. Every existing test function remains; original archive bytes and signatures, immutable-field mutation loops, explicit refusal checks and source/transaction sequence independence remain asserted. payments.rs already uses the current call API on this continuation base."
retired_fixtures = "Archived bridge/withdrawal/grant evidence keeps its wire/codec checks but is refused by current transaction consumers; successful signing is exercised only with permitted current calls or payer/bind authorizations. Live compatibility APIs remain deprecated as required by attempt 3; external custody still refuses their activity signing purpose."

[wiring.agentd_disclosure]
