build = "The build row for this candidate records the verified revision, exact command, exit code and private log; expected command: cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-sdk --tests."
verify = "The verify row for the same candidate records the verified revision, exact command, exit code and private log; hf-done invokes cg spec done 22.39.233 -f layerx-merge --root /work/paxeer-monorepo, which executes the declared native_programs verify_cmd. Only a zero-exit verify row qualifies the repair."
reference_policy = "Evidence is referenced before gates run so recording their results does not change the built candidate. No gate result is claimed in advance."

[gotcha.scope]
