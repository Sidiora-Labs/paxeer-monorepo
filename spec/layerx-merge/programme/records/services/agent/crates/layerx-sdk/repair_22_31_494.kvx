[proof.wallet_send_retains_the_exact_submitted_pax_transaction]
criterion = "The Send authorization and EIP-1559 signature cross real HTTP submission; independently fetched raw bytes equal canonical_activity byte for byte, recover the wallet sender and contain the original native Send payload."

[proof.inclusion_material_is_retained_exactly_and_independent_lookup_has_no_transaction]
criterion = "SendDebit binds the exact transaction; every retained proof field, header byte and signature byte equals the served material and re-verifies independently. A separate lookup has no transaction; removing served inclusion leaves both evidence options absent."

[proof.payment_and_issue_bind_the_submitted_bytes_without_inventing_inclusion]
criterion = "Open account, mint, burn, signed grant issue and revoke retain the exact submitted transaction through payment; summary-only receipts do not invent inclusion evidence."

[proof.invalid_inclusion_material_is_refused_without_dropping_to_summary_verification]
criterion = "Invalid header signature, sibling, receipt identity, canonical leaf, proof index, validly signed foreign-network header and null inclusion all refuse without falling back to summary verification."

[proof.committed_lookup_keeps_its_verified_block_and_does_not_invent_batch_evidence]
criterion = "The existing real-node committed transcript crosses loopback HTTP and verifies under pinned validator and receipt authorities; committed_block is retained while canonical_activity and batch_evidence remain absent."

