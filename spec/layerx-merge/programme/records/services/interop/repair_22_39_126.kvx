action = "Temporary fixtures clean the journal key, lock, head and replay index as a unit; production retention and corruption checks remain unchanged."

[gotcha.task_receipts]
observed = "The recorded payment deadline is in milliseconds and has expired; adjusting the HTTP credential alone cannot make the payer transaction valid."
action = "Reuse the existing real signer and receipt Encoder to produce bounded current evidence and derive every dependent identity, leaving expiry enforcement intact."

