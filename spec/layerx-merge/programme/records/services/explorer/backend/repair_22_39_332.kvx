cause = "These suites already configure the distinct v4 settlement authority through Evidence.serve_rpc, including governed receipt keys, chain_id and execution checkpoint."
repair = "Retain Evidence.authority and original configuration restoration. configure_committed is for committed_vectors.json, whose different signing key must not replace the v4 fixture authority. Keep the valid committed answers and assert refusal for malformed inclusion batches."

[gotcha.generated_sequence]
cause = "invalid_sequence signs with a newly generated key; the recorded public-key pin would stop it at R3 before the asserted R6 sequence refusal."
repair = "Independently configure the explicit generated key through GovernedReceiptFixtures.configure_keys before verifying this negative, and reinstall recorded authority for each other rejection. Preserve every refusal, response, rung and RPC-call assertion."

