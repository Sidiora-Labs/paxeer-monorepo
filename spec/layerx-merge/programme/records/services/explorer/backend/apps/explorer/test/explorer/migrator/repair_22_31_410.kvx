[repair.22.31.410]
finding = "selfdestruct-rule"
status = "production fork selection and canonical-state repair implemented; bounded qualification recorded by runner"
proof = "Explorer.Repair.Repair2231410Test and Explorer.Migrator.EmptyBytecodeForSelfdestructedSmartContractsTest replay real Shanghai/Cancun JSON-RPC requests and responses over loopback HTTP through EthereumJSONRPC.HTTP, EthereumJSONRPC.Geth and Explorer.Chain.InternalTransaction.changeset, then run the actual migration and compare persisted code with recorded eth_getCode fetched through the same transport at a committed height."
proving_tests = ["selfdestruct-rule: shanghai_same_transaction_create agrees with committed eth_getCode", "selfdestruct-rule: shanghai_same_transaction_create2 agrees with committed eth_getCode", "selfdestruct-rule: cancun_same_transaction_create agrees with committed eth_getCode", "selfdestruct-rule: cancun_same_transaction_create2 agrees with committed eth_getCode", "selfdestruct-rule: historical destruction must not erase a redeployed CREATE2 contract", "selfdestruct-rule: the same opcode deletes pre-Cancun code and preserves post-Cancun code"]
qualification_evidence = "The runner retains candidate revision, exact command, exit code and private log location in /out/run/gates.jsonl; no passing verification is claimed by this record."
baseline = "Attempt 2 candidate d6a1ac7af2d3e35f39088a98b1e36be2b4667bcc ran services/explorer/deploy/tools/mix-in-builder.sh test apps/explorer/test/repair/repair_22_31_410_test.exs: 23 tests, 10 failures, exit 2, as supplied in the continuation ruling and /out/run/gate.json seed revision; its private log path was not supplied. Same-transaction CREATE/CREATE2, live Cancun and redeployment regressions already failed. No additional unchanged-tree verification is claimed."
wiring = "None: the production migrator is now in scope and directly reuses the existing canonical reconciliation interface without changing another domain's module."
implementation = "update_batch reads Cancun activation from Explorer.ChainSpec.GenesisData.chain_spec_path (Geth config.cancunTime or Paxeer app_state.evm.params.chain_config.cancun_time), joins internal traces through their transaction to the consensus block instead of the retired internal_transactions.block_hash column, selects successful consensus destructions before activation and same-transaction CREATE/CREATE2 after activation, and reconciles nonempty code at the newest imported requireCanonical block inside Repo.transaction. An explicit per-migrator cancun_block setting (nonnegative height or :never) takes precedence; a missing fork schedule raises, and failed state fetches raise and prevent migration checkpoint advancement."
existing_production_path = "Explorer.Chain.Import.Runner.InternalTransactions.reconcile_selfdestructed_contracts_bytecode/3 is reused unchanged to validate all response IDs and code values before writing, preserve later CREATE2 incarnations, and atomically reject unavailable canonical state."
producer = "The seven carried-over Anvil 1.7.1 recordings remain unchanged. geth_history.json captures Geth 1.14.13 canonical execution through Engine API V2/V3 across its configured Cancun timestamp, with same-block destructions, multiple blocks, repeated CREATE2 destruction, retained post-Cancun code and real missing-header errors. Replay uses only committed JSON and loopback HTTP; the recorder and its optional dependencies never run in the gate."
limit = "The recordings prove standard EVM fork semantics; Paxeer state implementation integration remains owned by the chain domain."
gotcha = "The npm Anvil executable is in @foundry-rs/anvil-linux-amd64/bin/anvil, not @foundry-rs/anvil/anvil."
gotcha_receipt = "Anvil automining is asynchronous to eth_sendTransaction; the recorder must poll for a non-null committed receipt before fetching traces and code."
gotcha_factory = "Explorer.Factory imports data/1; the replay helper uses contract_data/1 to avoid an ExUnit compilation conflict."

continuation_baseline = "Attempt 3 candidate 4568037681a67c5c639535497bce5c1302b07de1 already ran the declared verify command with 23 tests, 10 failures and exit 2, per /out/run/gate.json seed. The unchanged-tree baseline is inherited; it is not rerun outside hf-done."
additional_proof = "Explorer.Repair.Repair2231410Test cases unavailable canonical state aborts the batch without clearing code, a noncanonical destruction cannot clear current code, and without a fork schedule the migration refuses to run and preserves committed code prove failure safety and consensus selection."
gotcha_geth = "Geth 1.14 dev sealing always requests Engine V3 and dev mode omits the external Engine RPC service; record mixed history with a funded disposable genesis and the real authenticated Engine V2/V3 APIs, using a temporary local signing key that is never stored in the fixture."

gotcha_test_http = "Explorer test configuration defaults Tesla to a Mox adapter. The replay helper selects the real HTTPoison client for Explorer.HttpClient and restores the original client on exit, so chain-spec GET requests reach the loopback transcript server without a mock."
qualification_first = "Candidate 4a2602c03f6bf16690e5f2fdc653a5f1f6d7c230: cg spec done 22.31.410 -f layerx-merge --root /work/paxeer-monorepo exited 1; /out/logs/verify-1.log records 26 tests and 17 Tesla mock-adapter failures before the fork lookup reached the loopback peer. All assertions are retained for the bounded repair rerun."

continuation_attempt_5 = "Inherited candidate f94c7ec11e321bd5f27aeab64e85eac84e2a1b0d failed the declared verification with 26 tests, 13 failures and exit 2 according to the supplied continuation ruling; its private log path was not supplied. The unchanged baseline is retained rather than rerun outside hf-done."
selection_gotcha = "The current InternalTransaction.changeset stores block_number as its primary key and no longer casts the legacy block_hash field; joining destructions or creations through that nullable field silently selects no recorded history. Join through the canonical parent transaction and verify block_number instead."
explicit_schedule_proof = "Each recording sets the migrator cancun_block application setting from its fork and recorded block timestamps; synthetic no-op cases explicitly configure :never. The repair tests also exercise the existing chain-spec timestamp path and refuse a missing schedule without writing."
reconciliation_proof = "selfdestruct-rule: the migration reaches canonical reconciliation before updating code asserts one persisted update and observes the actual eth_getCode request with requireCanonical=true and the imported head hash at the loopback HTTP peer; no production component is replaced."
