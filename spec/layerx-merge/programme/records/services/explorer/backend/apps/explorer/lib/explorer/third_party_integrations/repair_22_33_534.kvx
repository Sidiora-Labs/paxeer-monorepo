keycloak-cache-recovery = "Repair2233534Test: keycloak-cache-recovery: unreadable persisted token is evicted after reopen and refreshed once; keycloak-cache-recovery: provider and cache refusals and malformed token envelopes are bounded."
keycloak-otp-consumption = "Repair2233534Test: keycloak-otp-consumption: concurrent confirmations consume once and produce one persisted identity; keycloak-otp-consumption: Redis consumption failure authorises neither login nor email linking; keycloak-otp-consumption: replacement code survives a stale comparison and wrong attempts retain their limit."
proxy-config-shape = "Repair2233534Test: proxy-config-shape: decoded values and nested invalid shapes fail before routing or caching; proxy-config-shape: malformed URLs fail and a corrected config reaches the real upstream."
producer_transport_consumer = "Production OTP generation, Vault encryption, Redis RESP transport, atomic ciphertext comparison and consumption, Keycloak client-credentials and admin HTTP requests, Ueberauth identity and the real Identity schema; proxy config HTTP producer, JSON validation, route construction and upstream HTTP consumer."
peers = "Committed recorded Keycloak request/response shapes over loopback HTTP, a serial in-memory RESP store implementing the recorded compare-and-delete script and Redis error replies, and Bamboo's in-memory email mailbox. The store releases all concurrent GET responses together before consumption. No production component is replaced."
restart = "Stop the account caller and Redis connection while the unreadable ciphertext remains in the peer store; reopen both and prove one client-credentials refresh, encrypted cache replacement and successful subsequent admin reads."
