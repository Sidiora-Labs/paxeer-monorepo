gotcha = "Cloak AES-GCM authentication failure can return {:ok, :error}; cache recovery must require a nonempty binary plaintext rather than treating every {:ok, value} as a token."
evidence = "Qualification is claimed only when hf-done passes on the hf-build candidate; exact revision, command, exit and private log are supplied by the runner's gate ledger and final response."
fixture_gotcha = "Explorer.HttpClient.request receives headers before body; use the production Explorer.HttpClient.HTTPoison wrapper rather than raw HTTPoison, whose argument order differs."
qualification_repair = "First hf-done: revision 324362602f2f83db60eb971c815aa5aea1ec92c2, command cg spec done 22.33.534 -f layerx-merge --root /work/paxeer-monorepo, exit 1, log /out/logs/verify-1.log. Six tests passed; the remaining fixture emitted JSON null with HTTP 204, which Cowboy rejected. The fixture now emits an empty 204 body as Keycloak does; no assertion changed."
