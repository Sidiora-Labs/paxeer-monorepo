[finding.tag-config]
implementation = "Decode JSON with string keys, validate the entire list and exact tag/title entry schema, then convert only the two known fields to atom keys. Reject malformed JSON, non-list values, unknown/missing keys, non-string and blank fields with an explicit NEW_TAGS error. Validate synchronously before starting the cataloger, whose state retains the validated snapshot for import."
proving_tests = ["tag-config valid configuration reaches cataloger storage and recorded address consumer", "tag-config absent setting and explicit empty list are empty successful cataloger inputs", "tag-config objects and scalars fail explicitly before cataloger startup", "tag-config every entry must have exactly two non-empty string fields", "tag-config unknown string keys are rejected without creating atoms", "tag-config malformed JSON and non-string configuration never silently erase tags"]
path = "Runtime NEW_TAGS application configuration -> real EnvVarTranslator -> Cataloger.init and its emitted fetch message -> real Cataloger.handle_info -> AddressTag schema and Repo -> AddressToTag binding of a miner decoded from the committed Paxeer X consecutive-block RPC recording. Invalid configuration drives real Cataloger.start_link and proves no process starts, no prefix imports and existing stored tags remain intact. Validator discovery and unrelated address-binding RPC are not invoked by the focused import callback proof."

