[repair.22.31.472]
finding = "historical-price-acceptance-requalification-and-runner"
implementation = "Migration 20261104000000 only installs and fills the durable replay queue; observation resets remain block-scoped inside the first replay transaction and commit with its cursor. The 406 proof now asserts the migration preserves legacy acceptance before the first batch; schema upgrade, retained mismatch rollback, retry and failed-transaction cases remain covered."
wiring = "PriceUpdates loads the explorer priv replay script through Application.app_dir; PriceUpdates.Supervisor starts PriceAcceptanceReplay alongside the existing Task.Supervisor and buffered fetcher. The transient replay runner passes configured cosmos_rest_urls and cometbft_rpc_urls to PriceAcceptanceBackfill, schedules bounded step/2 batches and retries errors without changing the durable cursor, and exits normally at :complete without restart."
retention_wiring = "PriceFeedMaintenance checks PriceAcceptanceBackfill.pending?/0 before each retention batch and defers deletion while any durable replay job is incomplete; scanned-height compaction continues. Retention resumes after all jobs complete."
tests = ["migration installs the queue without writing observation rows", "one block resets only its observations and a restarted batch preserves prior decisions", "supervisor runs configured endpoints, retries durably and stops replay at complete", "retention waits for incomplete replay jobs and resumes after completion"]
fixtures = "Recorded Cosmos REST block_txs.json and CometBFT block_results.json pass through real loopback HTTP endpoints, CosmosRest, PriceFeed, PostgreSQL replay transactions and the indexer supervisor. Row snapshots include xmin to detect repeated writes across restart."
verification = "hf-done records the verified candidate revision, exact declared command, exit code and private evidence path in its gate ledger; no baseline gate was run before implementation."
rollback = "Revert this task's commit while retaining the queue-only migration and block-scoped reset from c80e00c2c2."
