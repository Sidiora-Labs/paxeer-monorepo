audit = "22.30.150"
finding = "008"
test_file = "services/explorer/backend/apps/indexer/test/repair/repair_22_33_487_test.exs"
proving_tests = ["008 block backlog survives pruned restarts and archive import recovers coverage", "008 transaction identity survives restart and recorded archive traces reach the importer"]
repair = "Retain both pending-operation schema rows below the trace lookback as a durable archive backlog; omit them from startup scheduling and pruned-source requests; expose trace_coverage/0 counts without treating unavailable traces as indexed."
recovery = "When an archive endpoint is available, configure the fetcher's existing json_rpc_named_arguments for that endpoint, disable lookback_blocks with nil or zero, and reopen the fetcher; startup streams the retained identities and only successful production imports clear them. Archive errors retain the pending work."
fixtures = "Committed paxeer_x/consecutive_blocks.json is fetched over loopback HTTP into Chain.import and its pending-block producer; committed paxeer_x/call_tracer_block.json traverses real Geth JSON-RPC decoding into the internal-transaction importer. Tests stop and reopen the production BufferedTask for both queue formats, assert boundary work still executes, recovery rows and values, and no repeated trace requests after completion."
baseline = "Not run: the mandatory implementation-first order and exclusive hf-done verification prohibit the contradictory unchanged-tree verify step; this test file did not exist on the base. No baseline failure is claimed."
qualification = "The hf-done runner evidence ledger records the exact verified candidate revision, command, exit code and private log; this source record makes no qualification claim."
wiring_request_api = "Domain 14 (fm-web-explorer-bridge): wire services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/v2/stats_controller.ex to Indexer.Fetcher.InternalTransaction.trace_coverage/0 so API consumers see pending and deferred coverage; the durable pending schemas and operator warning already retain and expose the missing work."
wiring_request_tests = "Domain 14 (fm-web-explorer-bridge): update services/explorer/backend/apps/indexer/test/indexer/fetcher/internal_transaction_test.exs lookback-window case to assert retained pending identities and archive deferral; its legacy deletion expectation contradicts finding 008 and is outside this task's scope."
repair_cycle = "First hf-done at deeecafc54d144aa982909bd2698adfdafb45862 exited 1 (verify_cmd exit 2), /out/logs/verify-1.log: transaction recovery imported both rows, but the new test incorrectly expected persistence of trace_address, which the production importer deliberately clears; retain the exact [0] assertion on production JSON-RPC decoder output and also assert the storage contract, transaction identity and index without changing recovery bounds."
