[repair.22.31.401]
audit = "22.30.151"
finding = "retired-router-wiring"
status = "configuration-implemented-consumer-wiring-required"
gateway_default = "runtime.exs explicitly supplies the current production consumer's router_url key from PAXEER_X_GATEWAY_URL in every environment, alongside the separate node_rpc_url and gateway_url; PAXEER_X_ROUTER_URL is never read and no endpoint borrows the other producer."
configuration_test = "Explorer.Repair2231401Test: runtime configuration separates node-root and hosted-gateway endpoints"
retirement_test = "Explorer.Repair2231401Test: the retired router setting supplies neither endpoint"
independence_test = "Explorer.Repair2231401Test: missing or invalid endpoints do not borrow the other producer"
committed_test = "Explorer.Repair2231401Test: recorded chain evidence reaches the committed status consumer"
transport_tests = "Explorer.Repair2231401Test: default receipt keys use the configured hosted gateway; default commits use the configured hosted gateway; default validators use the configured hosted gateway"
baseline = "Not run: the ordered gate instructions prohibit verification before implementation and verification outside hf-done; no pre-change failures are claimed."
prior_attempt = "The supplied attempt-1 result reports seven tests and three failures: default receipt keys, commits and validators returned :disabled; no unchanged-tree verification is repeated."
committed_recording = "The committed test replays the existing receipt_commit_inclusion.json recording through independent loopback node-root and hosted-gateway HTTP servers, retaining the complete batch proof and configured validator trust required by the production verifier."
unavailable_recording = "Each default test requires HTTP 503 from the explicit and default gateway calls and observes both JSON-RPC requests at the gateway /rpc path; no request may reach the node."
environment_proof = "The endpoint configuration is read with Config.Reader for dev, test and prod; transport tests install exactly the runtime-computed SequencerReceipt application configuration."
evidence = "The runner records the verified candidate revision, exact command, exit and private log in its hf-build/hf-done ledger; full transaction-status controller namespace qualification requires the consumer wiring below."
wiring_request_receipts = "Domain 14: services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/sequencer_receipt.ex must read gateway_url for px_getReceiptKeys, px_getCommit and px_getValidators instead of router_url."
wiring_request_status = "Domain 14: services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/v2/paxeer_x/transaction_status_controller.ex must send pax_sequencerReceipt and eth_getTransactionReceipt to node_rpc_url and px_getSequenceBatch plus receipt-key/commit/validator reads to gateway_url; qualify committed and unavailable responses through both actual producers."

[gotcha.runtime-default-key]
area = "config"
symptom = "Configured hosted-gateway default calls return :disabled without attempting HTTP."
cause = "The production receipt consumer reads only the router_url application key while the prior runtime configuration declares only gateway_url."
do = "Preserve endpoint independence and the retired environment variable refusal while explicitly aligning the runtime-produced application configuration with its consumer; do not remap keys only inside tests."
