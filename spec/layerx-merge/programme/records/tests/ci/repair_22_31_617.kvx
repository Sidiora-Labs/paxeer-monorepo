[repair.22.31.617]
base_revision = "20f1f239c8bf8fa18b019bb5bc4b89bb11d76fb0"
decision = "2790"
gotcha = "3414"
summary = "One unlocked metadata resolution per sub-project, without cargo update or manifest edits. Seven lock graphs needed changes; pay2 was already current and receives only a provenance comment."
verified_revision_evidence = "/out/run/gates.jsonl records the exact candidate revision, command, exit code and private log for hf-build and hf-done; the final response copies the last gate receipt. The candidate includes this record, so its own revision is retained externally rather than embedded in the content it hashes."
build_command = "for d in fuzz qualification/pay2 tests/boundary tests/isolation tests/parity tests/qualify tools/audit-verify tools/policy-harness; do cargo metadata --locked --format-version 1 --manifest-path services/agent/$d/Cargo.toml > /dev/null || exit 1; done"
verify_command = "python3 -m pytest -q tests/ci/test_agent_subproject_lockfiles_current.py"

[lock.fuzz]
path = "services/agent/fuzz/Cargo.lock"
resolution_command = "cargo metadata --format-version 1 --manifest-path services/agent/fuzz/Cargo.toml"
resolution_runs = 1
resolution_exit = 0
resolution_log = "/out/logs/resolve-22-31-617-fuzz.log"
added_entries = []
removed_entries = []
version_changes = []
changed_entries = ["layerx-sdk"]

[lock.fuzz.layerx-sdk]
version_before = "0.1.0"
version_after = "0.1.0"
added_dependencies = ["ed25519-dalek", "layerx-programs-registry"]
removed_dependencies = []
manifest = "services/agent/crates/layerx-sdk/Cargo.toml"
manifest_commit = "c59eebe59b00e0fb5979c34c767379276680606f"
reason = "Promotes ed25519-dalek and layerx_programs_registry from dev-dependencies to normal dependencies, so path consumers require both edges. Both packages were already locked; no package version or checksum changes."

