[coverage.workflow_pins]
test = "test_workflow_pnpm_matches_package_manager"
criterion = "Discover literal npm global pnpm installs and --package=pnpm activations in every public workflow YAML file, plus the explicitly recorded repaired manifest-driven matrix install. Each activation is a separate parameter identified by workflow line and job."
resolution = "Expand job matrices, workflow and job defaults and step working directories; account for pnpm --dir and -C; walk to the nearest ancestor package.json declaring packageManager. Every pnpm consumer in each job instance must agree with its installed release, including every member when a single pnpm serves multiple directories."
retained = "Retain the full bridge workflow assertion, Dockerfile activation checks, workspace lockfile checks and shared-lockfile release checks."
additional_manifests = ["sdk/wallet/package.json", "apps/wallet/package.json", "services/wallet/package.json", "services/wallet/gateway/package.json", "services/wallet/ceremony/legacy-import/package.json", "services/wallet/demo/package.json"]

[implementation_notes]
line_numbers = "The task inventory predates four lines added earlier in ci.yml; actual install lines are 271 and 302. Both inventory and actual line numbers are recorded above."
manifest_resolution = "services/wallet/gateway/package.json now declares packageManager itself, so nearest-manifest resolution stops there; services/wallet/package.json additionally confirms the workspace's matching release and supplies its integrity suffix."
