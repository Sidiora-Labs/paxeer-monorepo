[repair.22.31.619]
base_revision = "20f1f239c8bf8fa18b019bb5bc4b89bb11d76fb0"
decision = "2790"
gotcha = "3414"
requirement = "22998.1"
summary = "Each lockfile was refreshed by exactly one cargo metadata resolution without --locked; no manifest was changed and cargo update was not run."
verified_revision_evidence = "/out/run/gates.jsonl records the exact candidate revision, command, exit code and private log for hf-build and hf-done; the final response copies the last gate receipt. The candidate includes this repair record, so its verified revision is retained externally rather than embedded in the content it hashes."
build_command = "for m in services/platform/examples/samples/verify-receipt-rust services/platform/hosted/node/tests/probe tools/platform; do cargo metadata --locked --format-version 1 --manifest-path $m/Cargo.toml > /dev/null || exit 1; done"
verify_command = "python3 -m pytest -q tests/ci/test_platform_subproject_lockfiles_current.py"

[lock.verify_receipt_sample]
path = "services/platform/examples/samples/verify-receipt-rust/Cargo.lock"
previous_lock_revision = "0295d413498432f069f0ce9eda7bcbffd5c20e3d"
resolution_command = "cargo metadata --format-version 1 --manifest-path services/platform/examples/samples/verify-receipt-rust/Cargo.toml"
resolution_runs = 1
resolution_exit = 0
resolution_log = "/out/logs/22-31-619-verify-receipt-sample-resolution.log"
added_entries = []
removed_entries = []
version_changes = ["rustls 0.23.45 -> 0.23.46"]
dependency_changes = ["layerx-sdk 0.1.0 adds ed25519-dalek and layerx-programs-registry", "layerx-programs-ai-market 0.1.0 removes spin"]
unchanged = "All other package entries, versions, checksums and dependency lists are preserved. The spin package remains locked for its other consumers."

