repair = "Assert the producer's namespace import of node:worker_threads and const locks: unknown = Reflect.get(workerThreads, 'locks'); retain the beforeAll navigator.locks defineProperty and identity and request assertions. Both widget test files stay unchanged."
evidence = "The final candidate's build and verification are recorded by reference in build_evidence and verify_evidence above, with the verified revision copied into the final handoff."

[qualification.corepack_dispatch]
revision = "c0551b69ec9272b81eee5adbf6ed0d770db49463"
command = "corepack enable && cd services/wallet && pnpm install --frozen-lockfile --ignore-scripts && cd ../.. && pnpm --dir sdk/wallet --ignore-workspace install --frozen-lockfile --ignore-scripts && cd apps/wallet && pnpm install --frozen-lockfile --ignore-scripts && cd ../.. && python3 -m py_compile tests/ci/test_wallet_lockfiles_current.py tests/ci/test_wallet_test_workflow.py"
exit = 1
log = "/out/logs/build-1.log"
observed = "The services frozen install passes, then Corepack dispatch rejects the root npm packageManager before pnpm receives --dir sdk/wallet."
resolution = "Install pnpm@10.34.9 directly in a private temporary prefix and prepend its bin directory to the gate PATH, matching the public workflow's direct pnpm installation without changing the declared commands or disabling package-manager validation."
