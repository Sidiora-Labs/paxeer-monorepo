[job.wallet_tests]
workflow = ".github/workflows/wallet-test.yml"
job = "Vitest (sdk/wallet)"
repair = "Install services/wallet frozen after the isolated SDK install so imports of gateway support resolve jose and other declared gateway packages; install Go, PostgreSQL and OpenSSL for the real attestor and database fixtures. Keep the SDK install and matrix suite command unchanged."
sdk_agent_build = "Keep the linked agent SDK install and build outside the repository npm workspace using --workspaces=false, matching the public job and verification gate."
tests = ["tests/ci/test_wallet_test_workflow.py", "tests/ci/test_pnpm_workspace_roots.py"]

[job.wallet_go_tests]
workflow = ".github/workflows/wallet-go-test.yml"
repair = "Refresh services/wallet/pnpm-lock.yaml with the pinned pnpm release so its ../../sdk/wallet importer includes react-dom and jsdom; the workflow needs no edit."
tests = ["tests/ci/test_wallet_lockfiles_current.py"]

[lockfile_inventory]
wallet_workspaces = ["sdk/wallet (isolated with --ignore-workspace)", "services/wallet", "apps/wallet"]
other_sdk_importer = "apps/perps/pnpm-lock.yaml also imports ../../sdk/wallet and was refreshed as a generated side effect with pnpm 10.34.9."
linked_sdk_consumers = "services/wallet and apps/perps link the SDK from their members; apps/wallet links it directly. apps/web has a file dependency whose snapshot follows runtime and peer dependencies, which producer 5577807085 did not change."
criterion = "Each wallet workspace test executes its real pnpm frozen install with --ignore-scripts and asserts exit zero; no test or baseline is weakened."

[implementation_note.package_manager_root]
observed = "Running pnpm --version at the repository root refuses with ERR_PNPM_OTHER_PM_EXPECTED because that manifest pins npm."
resolution = "Run pnpm from the wallet workspace directory; root --dir invocations need the directly installed pnpm CLI so it processes --dir before package-manager validation."

[consumer.web_locks_setup]
producer_task = "22.39.55"
producer_revision = "cda4e5f2e2"
