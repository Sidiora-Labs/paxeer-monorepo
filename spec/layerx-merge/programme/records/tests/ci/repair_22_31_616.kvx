[repair.22.31.616]
base_revision = "20f1f239c8bf8fa18b019bb5bc4b89bb11d76fb0"
decision = "2790"
gotcha = "3414"
summary = "Each lock was refreshed with exactly one cargo metadata resolution without --locked. Both preserve every package version and checksum and gain only the two normal dependency edges of layerx-sdk. No manifest was changed and cargo update was not run."
verified_revision_evidence = "/out/run/gates.jsonl records the exact candidate revision, command, exit code and private log for hf-build and hf-done; the final response copies the last hf-done receipt. The candidate includes this repair record, so its revision is retained externally rather than embedded in the content it hashes."
build_command = "cargo metadata --locked --format-version 1 --manifest-path services/human/Cargo.toml > /dev/null && cargo metadata --locked --format-version 1 --manifest-path services/human/crates/layerx-intents/fuzz/Cargo.toml > /dev/null"
verify_command = "cargo test --locked --manifest-path services/human/Cargo.toml -p layerx-human-kms --test attestor_native_profile --no-run && python3 -m pytest -q tests/ci/test_human_lockfiles_current.py"

