[repair.22.33.286]
finding = "history-env-isolation"
source_revision = "f945549b95baf4ec2b0d6bb05148010091c762a2"
implementation = "HistoryLocalNode reserves a private unique environment file beneath TMPDIR/lx-localnode, reads only that file, and retains its bytes in the run's private evidence directory. The existing setup, RPC, stop and restart paths share this node identity."
proving_tests = ["test_history_env_isolation_concurrent_stop_restart", "test_history_env_isolation_missing_own_file_is_not_shared_fallback", "test_history_env_isolation_preserves_rpc_boundary"]
proof = "The production client runs against committed in-process node-helper and JSON-RPC peers. A barrier holds concurrent setups until both publish their real environment shapes; each client probes its own persisted block, stops only that endpoint, and reopens the same home and endpoint with the same recovered block. Private evidence bytes and permissions and the loopback URL boundary are asserted."
baseline = "Not run: the explicit gate order requires complete implementation before qualification and prohibits running verify_cmd by hand. No pre-change failures are claimed."
wiring_requests = []
qualification = "The bounded runner's private /out/run/gates.jsonl records the verified candidate revision, exact commands, exit codes and /out/logs evidence locations; the final response copies its last gate result."

[qualification_note.bytecode_candidate_drift]
observed = "The previous attempt passed all six tests but failed same_candidate and build_on_verified; generated bytecode under the allowed directory is included by the runner candidate walk and changes during compilation and pytest imports."
resolution = "Remove only generated __pycache__ files and direct Python bytecode to a private cache outside the source tree during both bounded gates; preserve the production implementation and every test assertion."
