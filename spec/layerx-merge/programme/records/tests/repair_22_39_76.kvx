[repair.workflow]
path = ".github/workflows/ci.yml"
change = "Run make core-test-all after make build test scan-consensus in the existing gcc/clang C17 matrix, with the same compiler selection and normal failure propagation. Install Foundry beforehand in that same job using the solidity job's pinned foundry-toolchain action and v1.7.1 toolchain. Install cbmc, z3 and clang with sudo apt-get update && sudo apt-get install --yes cbmc z3 clang before the core suites."

[repair.makefile]
path = "Makefile"
change = "Keep every existing core-test-all prerequisite and add the phony test-core-ports target, using the existing kernel C build rule to compile the four sources and execute every registered case. Track the included program-call fixture as a prerequisite for the two consumers."

[repair.handover]
path = "tests/codec/lxp_test_handover_retired.c"
observed = "The kernel handover member and LXP_GOVERNANCE_HANDOVER enum were retired; governance_authority is the live genesis key and network record (requirements 1061 and 1062)."
change = "Probe the five retired handover entry points as null weak references, and use the recorded retired wire ordinal 0x00070009 to prove module registration and governance classification refuse it. Preserve both registered cases, enabled/disabled genesis key checks and fee/migration proposal authorization, signature, staging and epoch assertions against governance_authority."

[repair.state_feed]
path = "tests/codec/lxp_test_state_feed_unbound.c"
observed = "The included call fixture no longer provides the complete genesis manifest type transitively."
change = "Include layerx/lxp_genesis.h directly. Preserve all three cases, the seven retired-feed symbol probes, durable receipt publication, snapshot restart and exact root, balance, sequence and receipt-byte comparisons."

[repair.payer_grant]
path = "tests/fuzz/lxp_prop_payer_grant.c"
observed = "The payer-grant type and its encode/decode and authorization surfaces were retired with RECEIVE; there is no current grant codec to round-trip or mutate."
change = "Retain the source and both registered case names as absence probes: encode and decode must resolve to null weak references, as must the authorization message and signature verifier. Do not restore a retired type, invent a replacement codec or claim seeded grant executions."

[repair.prepare_workers]
path = "tests/fuzz/lxp_prop_prepare_workers.c"
observed = "The included call fixture no longer provides the complete genesis manifest type transitively; the sample still used the legacy protocol, a fixed account sequence, hand-built owner authority and an 88-byte batch identity preimage (gotcha 3519)."
change = "Include layerx/lxp_genesis.h and layerx/lxp_batch_identity.h directly. Port deployment and sampled call executions to the test_metered_call.c contract: state-commitment protocol, identity next_sequence, signed fee limit, resolved owner authority, bound allowance, current payer balance and explicit execution versions, timestamps, sequence and arena. Derive the shared batch identity from the first encoded activity through lxp_batch_identity_activity and retain the aggregate activity root. Preserve 50 batches of 16 calls, one-versus-four worker execution, exact encoded receipt/event/terminal/root comparisons and unchanged input kernels. Assert every payer and shared treasury write and the exact canonical dependency chain required by the current occupancy scheduler."

