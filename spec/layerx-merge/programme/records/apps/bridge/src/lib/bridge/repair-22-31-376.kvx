resolution = "Attempt 2 supplies next typegen before tsc in both prescribed gates; retain the repair and qualify it with hf-build followed by hf-done."

[qualification.test-registration]
revision = "b8f86f16e11191bd3fe8239984d792c605affced"
command = "cg spec done 22.31.376 -f layerx-merge --root /work/paxeer-monorepo"
