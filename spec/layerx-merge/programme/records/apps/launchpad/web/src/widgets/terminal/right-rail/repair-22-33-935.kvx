[finding.accordion-storage-fallback]
tests = ["accordionStorageFallbackSurvivesBlockedReadsAndRemount", "accordionStorageFallbackPreservesObservedStorageBaseline"]
proof = "Real accordion interactions and snapshots under native jsdom SecurityError and storage-quota refusal, including unmount and reopen during the current visit."

[finding.position-pagination]
tests = ["positionPaginationFindsPageTwoAndStops", "positionPaginationStopsOnPageOne", "positionPaginationReportsAbsenceAfterLastPage", "positionPaginationResetsOnSnapshotChangeAndIgnoresLatePages", "positionPaginationRejectsMismatchedSnapshotAndRefreshes", "positionPaginationSurfacesContinuationFailureAndRetries", "positionPaginationClearsAmountsOnSignOut", "positionPaginationDiscardsPendingPageOnSignOut"]
proof = "Real PositionSummary, account session store, account HTTP transport and snapshot-bound accumulator; loopback v3 pages and the committed swap-chain wallet recording, with no live endpoint or external process."

[finding.window-snapshot-test-gap]
tests = ["windowSnapshotExcludesNewerLiveFills", "windowSnapshotDeduplicatesEvents", "windowSnapshotMissingInRangeHistoryStaysPartial"]
proof = "The repair gate imports window-stats.test.ts so all existing complete, empty, partial-history and partial-candle assertions execute with the new regressions."

[finding.window-snapshot-boundary]
tests = ["windowSnapshotExcludesNewerLiveFills", "windowSnapshotDeduplicatesEvents", "windowSnapshotMissingInRangeHistoryStaysPartial", "windowSnapshotExcludesGapsAndPartialCoverage"]
proof = "Production deriveWindowStats fences each candle at both position boundaries and deduplicates event identities; exact per-bucket trade counts establish completeness while candle USDL and trade totals stay unchanged."

[qualification_notes]
status = "Continued implementation: all fourteen named regression functions are registered with test(function.name, function), with real component interactions and production derivation assertions; final qualification is recorded by hf-build and hf-done in the private evidence ledger."
continuation = "Preserved the prior production repairs and regression bodies, checked the real account transport and snapshot accumulator, added reopen assertions after quota refusal and exact transaction/log-position boundary assertions. No prior TODO result is claimed as regression proof."
verification_repair = "Vitest 4 registers test(function) as TODO: the initial verify returned zero with 7 existing tests passed and all 14 named regressions TODO. Register each declared function as test(function.name, function) so its assertions execute; the initial zero exit is not behavioral qualification. Evidence: revision 38a17b97bd542339c55d9f0ce9f0c5478015f256, command cg spec done 22.33.935 -f layerx-merge --root /work/paxeer-monorepo, exit 0, /out/logs/verify-1.log."
