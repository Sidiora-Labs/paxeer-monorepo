evidence = "/out/run/gates.jsonl records the exact candidate revision, command, exit and private log for both gates; the final response copies the last gate evidence."
baseline = "Not executed: the ordered gate instructions require full implementation before testing and prohibit running verify_cmd by hand; no pre-change failure or gate pass is claimed."
