[repair.22.33.920]
finding = "cup-standings-pagination"
tests = ["cup_standings_pagination_appends_beyond_one_hundred_and_exhausts_cursor", "cup_standings_pagination_retries_failed_continuation_without_losing_rows", "cup_standings_pagination_rejects_conflicting_rank_wallet_order_and_cursor", "cup_standings_pagination_preserves_real_unavailable_initial_response", "cup_standings_pagination_preserves_rows_when_continuation_is_unavailable", "cup_standings_pagination_isolates_cup_changes_during_pending_continuation", "cup_standings_pagination_keeps_continuation_after_an_empty_page"]
proof = "An in-process loopback HTTP fixture serializes SDK-validated cup standings envelopes; the real SdkClient, Operations, contract decoder, infinite query hook and CupResultsList consume them. Tests assert rendered rows and controls as well as HTTP cup identity, opaque cursor, limit and retry requests. Identity/social peers use real in-memory query caches."
behavior = "Live standings append beyond 100 rows, keep accepted rows during continuation failures, retry the failed cursor, reject rank/wallet/order conflicts and cursor loops, isolate cup identity changes, and preserve actual unavailable responses. Final results retain their existing non-paged endpoint."
baseline = "Not executed: the explicit implementation-first and hf-build/hf-done-only order takes precedence over the contradictory pre-change verify instruction. No pre-change failures are claimed; the original component has no load-more control, so pagination tests cannot pass against it."
wiring_requests = []
evidence = "The final hf-done ledger row records the qualified candidate revision, exact command, exit code and private log; this record does not claim an unexecuted gate."
runner_gotcha = "Vitest 4 needs test(namedFunction.name, namedFunction); test(namedFunction) registers a TODO without executing assertions. Named functions are declared and registered with their names and callbacks."
fixture_gotcha = "A 503 fixture must include retryAfterMs, fieldErrors and details and pass decodeV2Contract('Error', body); an incomplete envelope loses retryable:false and the SDK correctly retries it instead of displaying unavailability."
