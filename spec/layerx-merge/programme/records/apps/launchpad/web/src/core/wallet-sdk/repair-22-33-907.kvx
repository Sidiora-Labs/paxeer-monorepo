[repair.22.33.907]
audit = "22.30.19"
metadata_measurement_budget = "metadata_measurement_budget proves concurrent and repeated approved-asset balance reads share one verified decimals operation across client/asset recreation while every chain, code and committed-block balance read remains current; metadata_identity_invalidation proves reviewed deployment/runtime changes, missing code, wrong chain and rejected precision cannot reuse approval."
session_burst_budget = "session_burst_budget proves synchronous account/chain epochs and aborts, inaccessible old/intermediate private reads until the production query cleanup completes, and one raw wallet.cache_clear plus one wallet.refresh_batch; session_disconnect_burst proves a disconnect still clears once without refreshing or leaking timers/listeners; session_cleanup_failure proves failed cleanup leaves private work blocked."
baseline = "Not executed: the explicit implementation-first order and hf-build/hf-done-only gate restriction prohibit unchanged-tree verification; no pre-change test failure is claimed. The original implementations reread decimals on each balance read and synchronously clear on both provider events, contradicting the regression assertions."
wiring_requests = "None: reviewed deployment identity is propagated by backend.ts and private-access quarantine is consumed by runtime.tsx inside the permitted wallet-sdk scope."
qualification = "The runner's hf-build/hf-done ledger retains the exact verified candidate revision, command, exit code and private log; no success is claimed before execution."
test_runtime = "Real approvedWalletAssets, HTTP viem client, ERC20 codec, assertAssetOnChain/readAssetBalance, PaxeerWallet provider transport, WalletSessionController and runtime query cleanup; committed in-memory chain/authorization stores and QueryClient over internally started loopback HTTP, without credentials or external tooling."
registration_gotcha = "Vitest treats test(function) as a todo without executing it; declared named functions are registered with test(function.name, function). The first hf-done exited zero with five todo tests and is not accepted as behavioral evidence; the corrected candidate must build and execute all five tests. No assertion was changed."
