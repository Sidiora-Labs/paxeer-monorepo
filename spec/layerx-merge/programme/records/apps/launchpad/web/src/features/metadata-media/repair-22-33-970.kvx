[repair.22.33.970]
finding = "metadata-browser-selectors"
proving_test = "apps/launchpad/web/test/repair-22-33-970.test.mjs:metadata_browser_selectors_real_editor_transport_viewer"
base_revision = "0e1d5eb94cabe89e2260279a849b7154911ef8ee"
change = "Use current accessible editor/viewer labels; derive approved revision and both operation identities from the committed metadata request/response, then correlate the viewer metadata/media response and rendered image."
preserved = "Retry identity, cancellation and late-approval suppression, no optimistic approval, keyboard label/focus, responsive image dimensions and variants, axe WCAG violations, layout shift bound, token identity and trading during outage."
proof = "Production editor and image transport upload a real PNG to an in-process HTTP fixture, interrupt the connection, cancel a held retry, retry the same operation, sign and commit metadata, then render the production query-backed viewer and its outage state; the browser measurement validators consume the actual wire observations and reject identity/revision substitutions."
baseline = "No earlier gate ledger exists; the declared test file was absent at the base revision. Baseline verification was not run because the ordered bounded gates require complete implementation, hf-build, then hf-done and prohibit running verify_cmd by hand. No baseline test failure is claimed."
evidence = "The runner's private gate ledger /out/run/gates.jsonl records the exact built and verified candidate revisions, commands, exits and private log paths; hf-done is authoritative for the final qualification result."
wiring_requests = "The proposed browser repair is within scope; the unrelated dependency-gate wiring request is recorded in qualification.22.33.970."

