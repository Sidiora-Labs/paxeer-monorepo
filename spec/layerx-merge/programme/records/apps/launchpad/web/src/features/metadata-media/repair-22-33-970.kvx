observed = "The pre-existing web package manifest uses workspace:* dependencies; the declared npm install exits EUNSUPPORTEDPROTOCOL before node --check runs. hf-done and the proving test did not run."
wiring_request = "apps/launchpad/web/package.json and the owning launchpad dependency/gate configuration (domain 4): align the declared npm install gate with the existing pnpm workspace dependencies; the manifest and gate configuration are outside this task's scope."

[continuation.22.33.970]
