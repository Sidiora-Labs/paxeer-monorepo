[repair.22.39.346]
decision = "3183, 3210, 3217, 3220, 3226, 3231"
gotcha = "4132, 4140, 4145, 4153, 4158, 4164"
defect = "WalletProvider.tsx:389 appended every discovery result to injectedRef, which survived discovery effect cleanup at :414; Onboarding.tsx:126 rendered the duplicate UUID entries as duplicate wallet buttons. The SDK only deduplicates within one discovery lifetime."
change = "Discovery replaces a known UUID at its existing position, appends only a new UUID, ignores callbacks after cleanup, and clears both the reference and published list when discovery stops. connectInjected still resolves the current detail by UUID; discoverInjectedWallets in session.ts still excludes PaxeerProvider."
case = "wallet_provider_lists_an_announced_wallet_once_when_discovery_restarts uses the real EIP-6963 announcer and EventTarget with the existing injected-provider harness: mount, unmount, remount on the same target, then StrictMode effect replay. Every mount asserts exactly the announced UUID and provider, requests rediscovery, connects by UUID, and checks the actual provider account request and connected address."
regression = "Before the change StrictMode effect replay appended the same announced UUID twice, so the exact singleton assertion fails. No baseline test run is claimed: implementation precedes the only allowed gates."
helper_defect = "rpcAt in e2e/send.spec.ts:52 decoded every response with response.json(), rounding the receipt key lastHeight 9223372036854775807 before SDK pinHeight authenticated it."
helper_change = "rpcAt reads the response as text and uses the SDK-exported parseReceiptKeyResponse for px_getReceiptKeys; other methods retain plain JSON parsing. The saved-observation assertions compare the complete JSON-stored receipt form; page assertions and locators are unchanged."
send_case = "At revision dfa9076deae7f91f722656fcf2fe1cdd405914f8 all six provider cases passed, including wallet_provider_lists_an_announced_wallet_once_when_discovery_restarts. The send case passed singleton onboarding, connection and helper receipt authentication, then failed its first page truth assertion at e2e/send.spec.ts:1106: included was expected, unknown was received. Reload assertions were not reached."
reader_defect = "TransferSuccess.tsx:109 rpcRequest sent node methods and parsed their replies with response.json() at :122, rounding lastHeight 9223372036854775807. observeTransfer at :181 passed that result to the SDK receipt reader, which refused the rounded key height and left the page unknown."
reader_change = "createTransferObservationClient builds the SDK JsonRpcClient for the transfer's retained rpcUrl with a ten-second request timeout and no-store fetches. useTransferObservation passes its call to observeTransfer, preserving the original network, status URL, persistence, polling and page states. The SDK lossless receipt-key parser retains the full end height."
reader_case = "transfer_observation_keeps_the_full_range_heights_of_the_receipt_keys starts an HTTP endpoint returning a raw px_getReceiptKeys body with firstHeight 7 and lastHeight 9223372036854775807. The page's client returns 7 and the exact decimal end height; readReceiptKeyPins accepts a second read and returns 7n and 9223372036854775807n. The previous response.json() reader rounds the end height, failing both checks; no baseline gate run is claimed."
observation_routing = "The send helper's OBSERVED_METHODS omitted px_getReceiptKeys and eth_getRawTransactionByHash, sending governed key and signed-transaction reads to the gateway instead of the controlled observation node. It now routes both authentication inputs alongside the receipt and canonical-block reads. No assertion, locator or send-case body changes."
other_readers = "The non-test wallet source search found two further node JSON-RPC response.json() sites outside scope: apps/wallet/src/components/NetworkSwitcher.tsx:108-119 addNetwork sends eth_chainId and parses at :119; apps/wallet/src/lib/constants.ts:65-92 validateRpcEndpoint sends eth_chainId at :84 and parses at :92. Both currently read hexadecimal string chain IDs, rather than receipt-key height numbers; they are recorded without changes."
send_result = "At revision ef74de13ae7b5b46d34b08e9803db411b9c4df4e both unit files and all eight cases passed. The send case passed singleton onboarding, connection, SDK receipt authentication and the Receipted page assertions, then failed its first persisted-evidence assertion at e2e/send.spec.ts:1117: saved truth remained submitted with empty steps instead of included with authenticated sequencer evidence. Reload assertions were not reached. This is the inherited attempt-3 result, before the storage repair of decision 3226."
test_registration = "Vitest 4 treats test(function) as a todo declaration. Both named functions in TransferSuccess.test.tsx are registered with test(function.name, function), ensuring the height regression and existing page-state assertions execute. No assertion is changed or removed."
storage_defect = "saveTransferObservation at apps/wallet/src/components/transferOrigin.ts:76 copied observations with plain JSON.stringify, which throws for the bigint authentication.height attached by the SDK; the previous submitted observation remained in storage although the page showed Receipted."
storage_change = "The JSON replacer writes every bigint as its base-ten decimal string and returns every other value unchanged, preserving the full observation, lastVerified receipt, authentication metadata and retained origin. The in-memory authenticated receipt remains unchanged."
storage_case = "transfer_observation_with_an_authenticated_receipt_is_saved verifies the node-produced V1-pax-transfer vector, encodes and signs its receipt at height 9223372036854775807 using the real SDK encoder and public conformance signing seed, and reads it through the page HTTP client and SDK authenticator. It saves an included observation, compares the entire stored record with both receipt heights as decimal strings, checks the original bigint is unchanged, and asserts the SDK recovery result. Before the replacer this save throws."
recovery_result = "recoverTransferObservation(identity, stored) returns the submitted observation without lastVerified: sdk/wallet/src/ladder.ts:273 decodes the saved sequencer receipt with its default empty pins, sdk/wallet/src/receipt.ts:245 refuses the missing governed key pin, and ladder.ts:282 returns submitted. The page calls recovery without pins at apps/wallet/src/components/TransferSuccess.tsx:103 and polls the retained node to authenticate again. This SDK recovery limitation is recorded without changing sdk/wallet."
stored_receipt_expectations = "Before and after reload, send_shows_receipted_from_the_sequencer_receipt_and_keeps_it_on_reload compares sequencer and lastVerified.sequencer with the helper receipt serialized using bigint decimal strings. Every receipt member remains in the comparison and every page assertion and locator remains unchanged."
current_send_qualification = "The declared hf-done gate executes the named send case through its final saved-observation assertion after reload. Its exact candidate revision, command, exit and private evidence path are recorded by hf-done in /out/run/gates.jsonl and the verify log named by its last entry; no passing result is claimed before that gate."
fixture_path_repair = "At candidate 7bd5768af8c9f44d5acf614ca3711ad9ecc6cc12 the first hf-done exited 1 in the new storage case before the browser case ran: jsdom resolves import.meta.url to HTTP, so readFileSync refused its URL at TransferSuccess.test.tsx:29. The other eight unit cases passed. The case now resolves the existing producer fixture from __dirname, matching the repository's Node fixture readers; every assertion is retained."
fixture_parent_repair = "At inherited candidate 7729d7911128 the storage case stopped before assertions because five parent segments from apps/wallet/src/components resolved the fixture above the repository. The case now uses four parent segments to read sdk/platform/conformance/fixtures/sequencer-receipt-v1.json; no other setup, assertion, locator or page assertion changes in this continuation. The declared gate records the send result at the exact tested candidate, including its first failing assertion if it fails."
storage_case_signature_failure = "At candidate 484cefd00e7cd051fb354082c42cbd8bd30b1035 hf-build passed and hf-done exited 1 (private log /out/logs/verify-1.log): eight unit cases passed, but transfer_observation_with_an_authenticated_receipt_is_saved stopped at TransferSuccess.test.tsx:88 before its first assertion with malformed or unauthenticated sequencer receipt signature. The inherited setup at :59 passes two arguments to viem.concatBytes, whose declared interface at node_modules/viem/utils/data/concat.ts:23 accepts one array of byte arrays, so the encoded receipt is not concatenated into the signing digest. The browser send case did not execute."
storage_case_signature_repair = "The storage case now passes concatBytes one list containing the LXP/v1/receipt domain text with its terminating zero byte and the unsigned encoded receipt. Before signing it compares these bytes with the verifier's domain, signed receipt prefix up to the signature presence byte and one zero byte. It checks that the retained public conformance seed derives the fixture's pinned public key, then signs the SHA-256 digest of those exact bytes. All storage and recovery assertions remain intact; sdk/wallet is unchanged."
