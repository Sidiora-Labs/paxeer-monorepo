repair = "Query each settlement position by ID and join collateralToken to collateralTokens.decimals; format exact native units with token identity, without assigning a USD valuation."
proof = "The real producer emits 119000000, 119000001 and zero USDL base units; GraphQL preserves them and the position token, and rows display 119 USDL, 119.000001 USDL and 0 USDL with the full address. Missing metadata remains explicit."
wiring = "No out-of-scope wiring required for the current USDL contract: existing position and collateralTokens GraphQL fields supply identity and native decimals; the producer exposes no separate payout USD valuation."

[test_runtime]
