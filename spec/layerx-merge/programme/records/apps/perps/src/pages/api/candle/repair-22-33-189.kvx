[finding.f003]
tests = ["candleDirectPeersCannotRotateForwardedHeaders", "candleTrustedProxyUsesVerifiedSocketIdentity", "candleTrustedProxyRejectsInvalidIdentity", "candleBucketCapacityRejectsExcessWithoutEviction", "candleExpiredBucketsReleaseCapacityAndResetBudgets"]
repair = "Ignore caller forwarding headers on direct sockets; accept one canonical X-Real-IP only from exact configured CANDLE_TRUSTED_PROXY_IPS peers; reject invalid trusted identities; cap admission at 5000 active buckets, preserve existing budgets and reclaim expired entries."
proof = "Real HTTP clients with distinct loopback source addresses traverse a committed header-overwriting ingress fixture and the production candle handler through Next apiResolver; direct spoofing, proxy spoofing, canonical address aliases, malformed identities, capacity refusal and real one-minute expiry are asserted."

[wiring.deployment-proxy]
request = "Domain 3 markets deployment owner: in apps/perps/railway.json and the ingress proxy configuration (the route's referenced proxy/nginx.conf.template is absent from this checkout), restrict origin access to the ingress, overwrite X-Real-IP from a verified connection identity after stripping caller input, and configure CANDLE_TRUSTED_PROXY_IPS with the ingress socket peer addresses; shared untrusted ingress peers otherwise share the direct-socket budget."

