[repair.22.33.291]
finding = "tx_page_csv"
implementation = "The transaction header labels its existing action Export CSV by date range; the address and direction still flow through the real CSV link into the date-range export page."
continuation = "AddressCsvExportLink omits undefined query parameters before route encoding, so an unfiltered export has no filterValue key while selected directions remain intact."
inherited_failure = "Attempt 1 executed the three second-page tests: outgoing and incoming passed; txPageCsvDoesNotInventAFilterOnSecondPage failed because the production link serialized an undefined filterValue. The continuation preserves every assertion and repairs that producer."
continuation_setup = "ESLint was initially unavailable before dependency installation; frozen installation evidence is private at /out/logs/format-deps-22-33-291.log and continuation formatter evidence is private at /out/logs/format-22-33-291-continuation.log."
tests = ["txPageCsvRetainsOutgoingFilterOnSecondPage", "txPageCsvRetainsIncomingFilterOnSecondPage", "txPageCsvDoesNotInventAFilterOnSecondPage"]
proof = "The production AddressTxs, query hook, AddressCsvExportLink, route codec, CsvExport page and CsvExportForm run with committed API fixtures in the real query store and the committed router context fixture; second-page cursors remain on the list, direction reaches the export, and the destination presents a 24-hour date range."
baseline = "Not run: the explicit gate order forbids testing before implementation or running verify_cmd outside hf-done; no before-change failures are claimed. The new exact action-label assertions fail with the former Download Page Data wording."
wiring_request = "Domain 14: token-type and token-address filter support requires a supported export contract in services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/v2/csv_export_controller.ex plus propagation through apps/explorer/types/client/address.ts, apps/explorer/ui/pages/CsvExport.tsx and apps/explorer/ui/csvExport/CsvExportForm.tsx; token_page_csv is a separate audit finding."
qualification = "The final hf-build/hf-done ledger supplies the exact candidate revision, command, exit code and private evidence path; qualification is not claimed in advance."
formatter = "Repository ESLint --fix formats the touched TypeScript files; its title/assertion lint rules do not resolve function.name titles or assertions in named functions, and the checks remain enabled (private logs /out/logs/format-22-33-291.log and /out/logs/format-22-33-291-repair-1.log)."
repair_cycle_1 = "The initial hf-done returned zero at b8290fa93d6d29e6c9fd68e13304c059986f1871 but /out/logs/verify-1.log reported all three tests as todo: Vitest 4 treats test(namedFunction) as a title without a callback. Registration now passes each declared function's name and callback explicitly; no execution success is claimed for that first run."
