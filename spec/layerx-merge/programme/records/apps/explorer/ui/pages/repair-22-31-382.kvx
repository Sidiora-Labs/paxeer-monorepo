[repair.fetch_lifecycle]
observed = "The previous attempt executed all four tests successfully but failed suite teardown with normalizeRequest reading undefined.toString."
cause = "vitest-fetch-mock enableMocks and disableMocks return the callable fetch mock; returning that value from beforeAll registers it as a Vitest cleanup callback, which calls fetch without a request."
repair = "Use block-bodied lifecycle callbacks with no return value so the real loopback transport is restored without registering fetch as cleanup; every test and assertion remains intact."
gotcha = "Vitest lifecycle callbacks may return cleanup functions; never implicitly return fluent API results from setup hooks."
