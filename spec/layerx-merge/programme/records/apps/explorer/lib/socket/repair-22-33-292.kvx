[repair.22.33.292]
scope = "apps/explorer/lib/socket"
implementation = "The shared registry owns release and leave, retains per-subscriber join/error listeners across Phoenix rejoin, and distinguishes socket instances. Collection defaults to 1000 entries, validates finite positive limits, bounds each push and limit reduction, and reports overflow. An overflow callback replaces partial row flushing with first-page reconciliation when resumed. useSocketCountBuffer accumulates safe transaction counts in one retained value."
baseline = "No baseline gate was run: the governing ordered implementation-first instructions require hf-build then hf-done and prohibit invoking verify_cmd by hand. No pre-change test failure is claimed; the old implementation has no default bound, recovery callback or count accumulator and leaves a positive-owner shared channel when one subscriber disables."
qualification = "Exact candidate revision, command, exit and private evidence location are recorded by the runner hf-build/hf-done ledger; no result is claimed in advance."

[finding.socket_buffer_unbounded]
tests = ["socketBufferBoundsTheEntireHiddenBurst", "socketCountBufferAccumulatesWithoutGrowingWhileHeld", "socketBufferHonorsReducedLimitsAndCurrentRecoveryCallbacks", "socketRowsRefetchTheFirstPageAfterAPausedOverflow"]
proof = "The production buffer retains at most its configured bound throughout 100000 hidden pushes; the count hook retains one value throughout 100000 held pushes and preserves the exact sum. The production provider/channel/message/buffer path receives a paused WebSocket burst, suppresses partial row flushing, invalidates a real QueryClient and refetches the first page over loopback HTTP on resume."
wiring_request_count = "Domain 14: apps/explorer/ui/home/LatestTxs.tsx must replace its count-array useSocketBuffer call and reduce callback with useSocketCountBuffer and a scalar count callback; the existing call is now bounded but cannot preserve all dropped counts until this out-of-scope call-site change lands."
wiring_request_rows = "Domain 14: apps/explorer/ui/home/LatestBlocks.tsx, apps/explorer/ui/pages/PaxeerXFeed.tsx and apps/explorer/ui/pages/PaxeerXFeedMarket.tsx must supply onOverflow callbacks that invalidate and refetch their first-page resource keys on resume; do not merge the incomplete overflow batch."

[finding.shared_channel_leave]
tests = ["sharedChannelReleasesOneOwnerAndRejoinsEveryRemainingSubscriber", "socketStreamReconcilesMissedRowsAfterPeerAndConsumerRestart"]
proof = "Two real React subscribers share one joined Phoenix channel; disabling one removes only its listener/ownership while the other keeps receiving. Stopping and reopening the peer proves automatic rejoin and delivery with one and then both owners, rejoin callbacks fan out to all owners, and the final disabled owner alone sends leave and removes the registry entry. Closing and reopening the consumer fetches authoritative missed rows rather than pretending that notifications replay."

[finding.socket_producer_proof_gap]
tests = ["socketRowsRefetchTheFirstPageAfterAPausedOverflow", "socketStreamReconcilesMissedRowsAfterPeerAndConsumerRestart", "socketReplayContractsMatchTheCommittedNotifierAndGateway"]
proof_boundary = "The original socketFlush.spec.tsx cadence test is unchanged. The new proof executes the production TypeScript provider, Phoenix client, channel/message hooks, buffer and QueryClient over loopback WebSocket/HTTP with committed backend API recordings. It asserts the notifier/channel conformance contract and admitted gateway path from committed source. It stops/reopens the protocol peer and consumer and recovers missed rows from the first page. It does not execute the Elixir notifier or Rust gateway and does not claim to close that cross-runtime producer proof."
wiring_request_backend = "Domain 14: services/explorer/backend/apps/block_scout_web/test/block_scout_web/channels/v2/transaction_channel_test.exs must capture notifier-emitted frames and prove real BlockScoutWeb.Notifier restart/rejoin and first-page reconciliation through services/platform/hosted/gateway/src/explorer_proxy.rs with domain 8; the TypeScript-only gate may not start an external toolchain or require a native artifact."
wiring_request_gateway = "Domain 8: services/platform/hosted/gateway/src/explorer_proxy.rs must provide the admitted cross-runtime notifier-to-browser restart/recovery proof with domain 14, retaining GET /explorer/backend/socket/v2/websocket and first-page HTTP admission; a loopback Phoenix peer is not proof that the Rust gateway executed."
wiring_request_consumers = "Domain 14: the out-of-scope live-list consumers must use useSocketChannel.onJoin to invalidate their first-page queries after every rejoin, because the backend notification contract has no replay cursor."

[gotcha.socket_repair]
scope = "The task's explicit path restriction forbids GOTCHA.kvx and spec/ edits; task notes and wiring requests are retained in this in-scope repair record."
ordering = "The task contains both an unchanged-tree verify request and a governing ordered implementation-first gate policy; follow the latter and report the baseline as not run."
fixtures = "The existing createTestSocket cadence fixture does not process phx_leave and cannot detect shared-channel ownership loss; this test uses a leave-aware loopback protocol peer without altering the cadence fixture."
recordings = "Committed blockscout-client transaction recordings contain a JSON string response body; both envelopes are schema-checked before replay and no live endpoint is consulted."
formatting = "The repository ESLint fixer formatted the four touched TypeScript files. Its initial diagnostics were vitest/expect-expect and vitest/valid-title on the seven test(namedFunction) registrations prescribed by the task; no lint rule or assertion was disabled. Private formatter output: /out/logs/format-22-33-292.log."
repair_cycle_1 = "The first hf-done returned zero at candidate 29276ac74ac0eaade450552e0015549ac7e3c2c7, but /out/logs/verify-1.log shows seven todo tests and zero executed bodies. Vitest 4 requires an explicit callback: register each declared function with test(function.name, function) so the exact function names remain test titles and all existing assertions execute. The apparent pass is not behavioral qualification; rerun hf-build and hf-done on the repaired candidate within the bounded budget."
