log = "/out/logs/build-1.log"
observed = "Besides the scoped test repair, compilation reports missing ganache in ui/marketplace/essentialDapps/revoke/hooks/repair-22-31-381.spec.ts and native PriceUpdateItem incompatibilities in ui/txs/TxsContent.spec.tsx:169, TxsListItem.spec.tsx:66 and TxsTableItem.spec.tsx:110."
assumption = "The missing dependency is pre-existing; domain 14 must narrow the UI interface and test helpers outside scope, while this task retains the native fixture type without an escape cast."
