[repair.22.33.352]
finding = "large-move-amount-render"
test = "apps/web/e2e/repair-22-33-352.test.ts:largeMoveAmountsRenderThroughInputAndReview"
formatting_test = "apps/web/e2e/repair-22-33-352.test.ts:exactMoveMoneyFormattingKeepsBaseUnitsAndCurrency"
path = "Mounted MoveMoney input -> parseMoveAmount -> live moveSummary -> requestMoveQuote -> production request encoder -> loopback HTTP peer and request decoder -> production quote encoder -> HTTP client quote decoder -> mounted ReviewPane and summary."
units = "The Human API declares Money.amount as integer base units and supplies no asset decimals in Money or MoveQuote. The input already says Amount in base units of LXP; bigint formatting preserves those units without guessing asset precision or applying ISO currency fraction defaults. The existing positive, 38-digit input bound is unchanged."
coverage = "Safe-integer boundary minus one, boundary, boundary plus one, boundary plus two, maximum 38-digit input, exact large review fees, currency and locale output, leading zeros and whitespace, invalid input with an associated field alert and a disabled Continue control."
baseline = "No baseline gate ran: the ordered task instructions require complete implementation before hf-build/hf-done and prohibit manual verify_cmd execution; the declared regression file did not exist in the starting tree and the supplied gate ledger has zero build and verify runs. The previous moneyWords calls moneyAmountNumber and throws for the boundary-plus-one and maximum-input cases."
wiring_activity = "Owning domain fm-web-explorer-bridge: replace the Number conversion in apps/web/src/journeys/activity/model.ts signedBaseUnits/unsignedBaseUnits and their apps/web/src/journeys/activity/activity.tsx and facts.tsx displays with exact integer base-unit rendering; apply registered asset decimals only when authoritative asset metadata is transported."
wiring_approval = "Owning domain fm-web-explorer-bridge: replace the safe-integer conversion in apps/web/src/journeys/approvals/model.ts protocolMoney/moneyLabel and their numeric display consumers with exact integer rendering using declared units."
wiring_home = "Owning domain fm-web-explorer-bridge: migrate apps/web/src/journeys/home/model.ts moneyAmountNumber consumers and numeric UI amounts to exact integer rendering; the exported checked conversion remains unchanged for these out-of-scope consumers."
wiring_copy = "Owning domain fm-web-explorer-bridge: move MOVE_AMOUNT_VALIDATION_MESSAGE into apps/web/copy/catalog.ts and regenerate its runtime catalogue in the copy domain's scope."
evidence = "The private hf-build/hf-done ledger supplies the exact candidate revision, command, exit code and log location; qualification is not claimed in advance."
qualification_repair = "At 91ffdbb5d9bdec5f450a082b20a43110b660d312, hf-done exited 1 (private log /out/logs/verify-1.log): the mounted Radix radio group required HTMLFormElement. Expose happy-dom's real form and event constructors globally, matching the existing mounted component fixture; all assertions remain unchanged."
