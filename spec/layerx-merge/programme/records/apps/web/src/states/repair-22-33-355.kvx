[task.22.33.355]
findings = ["state-matrix-stale-inventory", "support-report-principal-replay"]
test_file = "apps/web/e2e/repair-22-33-355.test.ts"
state-matrix-stale-inventory = ["state_matrix_stale_inventory_matches_live_routes", "state_matrix_real_surfaces_both_shells"]
support-report-principal-replay = ["support_report_principal_replay_offline_switch_reopen", "support_report_principal_replay_session_guard_and_authorization", "support_report_principal_replay_authenticated_boundary_logout", "support_report_principal_replay_in_flight_logout"]
repair = "One route manifest produces matrix entries, inventory and canonical report routes; completeness rejects retired and duplicate registrations. MatrixStateSurface drives the existing production surfaces in both shells, and the proof checks every real Next page and inherited loading/error boundary. Private outbox v2 partitions immutable redacted attempts by verified principal, rejects replay into another principal or changed session, drops unowned v1 data, and preserves owner-only retries across reopen. Explicit logout clears every private outbox partition and revokes live reporters without deleting unrelated preferences."
baseline = "No earlier gate ledger or in-scope implementation existed at task entry. No unchanged-tree verify was run: ordered instructions require complete implementation before the sole verification through hf-done. The regression assertions differ from the original stale route inventory, global unowned queue, and absence of origin/session binding; no baseline execution is claimed."
wiring_requests = ["apps/web/src/app/app/layout.tsx — web authenticated-shell owner: wrap authenticated children with SupportReportSessionBoundary using verifiedWebSession identity and a principal/session key; logout must render an undefined session or call outbox.logout before redirect, including session revocation paths in apps/web/src/settings/security/security-screen.tsx.", "apps/web/src/app/api/support/reports/route.ts — web report API owner: after verifiedWebSession and validRequestCsrf, requireSupportReportPrincipal(request, session) and return 403 on SupportReportPrincipalError before persistence; the expected-principal header never supplies server authorization.", "apps/web/src/app — web route owners: use exported MatrixStateSurface for route state transitions with real error, age, reference and outcome callbacks; existing inherited loading/error boundaries are exercised separately by the proof."]
integration = "The authenticated provider and POST guard are implemented and tested here; the out-of-scope layout, logout handlers and POST handler are intentionally unchanged. The default reporter is unbound and refuses submission until authenticated layout wiring is applied. The loopback proof composes the production guard at that declared integration boundary with the unchanged authenticated POST handler and real durable repository; it does not claim that the owning POST file already invokes the guard."
qualification = "The hf-build/hf-done ledger records exact candidate revision, command, exit code and private evidence path. Completion requires hf-done passing on the same candidate as hf-build."
gotcha = "React StrictMode replays effect setup/cleanup: connect reactivates only a non-logged-out session instance, cleanup closes stale reporters, and an explicit logout epoch permanently revokes all pre-logout instances. No external credential, endpoint, binary or preconfigured environment is needed: the test uses committed TLS fixtures, recorded authenticated-session transcripts, an in-process loopback peer and temporary repository storage."
