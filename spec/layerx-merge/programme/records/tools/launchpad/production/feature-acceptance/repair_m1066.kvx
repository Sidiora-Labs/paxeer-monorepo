[meta]
task = "22.33.1066"
audit = "22.30.42"
status = "implemented; qualification is recorded only by hf-done"
authority = "spec/layerx-merge/spec.kvx"
qualification_evidence = "/out/run/gates.jsonl: runner records the exact verified candidate revision, command, exit code and private log; no post-gate source edit or commit is made by this task"
baseline = "The inherited attempt failed all six named finding tests (InventorySpec, Phase2ManifestSpec, Phase3ManifestSpec, Phase4ManifestSpec, FinalManifestSpec, ReadinessSpec); its build passed. No additional unchanged-tree gate was run, per the ordered continuation protocol."
ruling = "Attempt 2: absent legacy identities are retired references with reasons, not mapping requests to another domain. All existing scenario, ownership, prerequisite and evidence assertions are retained."
implementation = "The tracked flat KVX parser and source feed inventory and readiness materialization. Historical declarations retain lineage and current-source commands; every absent section has an explicit retired-reference report based on decision.1803. Retirement cannot establish readiness or final qualification."
inventory = "Regenerated byte-identically from the committed historical declaration fixture, checked against the current graph; inventory-spec-references.json records every retired coverage and requirement reference. No numeric alias or qualification is inferred."
producer = "python3 tools/launchpad/production/feature-acceptance/materialize_references.py reproduces the inventory and all four repaired manifest reports using the production generator and policy."
consumer = "cmd/reference-audit consumes those materialized JSON declarations and validates each classification/reason and command against the real tracked graph. Go regressions exercise this production reader and qualification guard with the committed real-path graph excerpt and actual generated producer output; no interpreter subprocess is needed in the gate."
fixture = "Specification references resolve through spec/layerx-merge/spec.kvx; decision.1803 identifies retired launchpad declarations."
wiring = "None: the retired production-system identities and runner are historical references, not interfaces another domain must restore."

[finding.inventory-spec-missing]
test = "TestRepairM_1066_InventorySpec"
repair = "Reproducible historical inventory with explicit current-graph reference reporting, all 55 identities, owners, requirements, four scenarios and inherited dependencies preserved."

[finding.final-manifest-spec]
test = "TestRepairM_1066_FinalManifestSpec"
repair = "All 208 historical command records, final_gate 9.1 and current-source checks preserved with explicit retired-reference classifications and reasons."

[finding.phase2-manifest-spec]
test = "TestRepairM_1066_Phase2ManifestSpec"
repair = "Current graph command and retired task.2.50 report; complete native scenario coverage retained."

[finding.phase3-manifest-spec]
test = "TestRepairM_1066_Phase3ManifestSpec"
repair = "Current graph command and retired task.3.50 report; complete adversarial scenario coverage retained."

[finding.phase4-manifest-spec]
test = "TestRepairM_1066_Phase4ManifestSpec"
repair = "Current graph command and retired task.4.50 report; native scenarios and final_gate 9.1 retained."

[finding.readiness-spec-missing]
test = "TestRepairM_1066_ReadinessSpec"
repair = "Root authority binds the tracked merged graph; all lane/serial lineage is reported explicitly as retired, with no mapping request and no promotion to current mandatory gates or release qualification."

[regression.reference-integrity]
test = "TestRepairM_1066_ReferenceIntegrity"
repair = "Real consumer rejects stale spec paths, missing current-source checking, false-current classification, altered retirement reasons and declaration qualification; a genuinely current identity remains current."

[gotcha.retired-identities]
observed = "Replacing the spec path does not recreate removed production-system task and requirement identities."
resolution = "Report retirement under decision.1803, retain historical obligations and refuse qualification; never request 208 fabricated mappings or alias unrelated merged tasks."

[gotcha.gate-language]
observed = "The bounded gate is Go and cannot invoke an external Python interpreter."
resolution = "The real Go reporting consumer reads committed output of the Python production materializer and validates it against the graph fixture and real source; the gate does not claim Python runtime suite coverage."

[gotcha.readiness-parent-reference]
observed = "The first bounded verification exposed that the readiness declaration has its own task.4.50 identity as well as 208 gate records; its parent reference was missing from materialization."
resolution = "Materialize and validate the parent command/reference too; report one classification per identity while checking every occurrence. Evidence of the failed candidate is /out/run/gates.jsonl and /out/logs/verify-1.log."
