baseline = "No earlier gate ledger or task test module existed. No unchanged-tree test was run: the explicit Order forbids early testing and direct verify_cmd execution. No baseline failures are claimed."
proof_boundary = "The production CLI parser, Cargo argv/environment construction, publish_service_record/publish_clock_record JSON producers, private filesystem transport, protected_record and source/artifact/predecessor consumers run in-process. Verbatim committed source files are executable-permission fixtures for file identity checks; no fixture is executed or claimed as a native compiler output. Native builds and the existing six-case boundary verification remain production operations, outside this focused gate."

[finding.f033]
tests = ["test_f033_operator_options_cover_every_mode", "test_f033_configured_toolchain_and_target_are_preserved", "test_f033_unset_environment_uses_path_and_cargo_configuration", "test_f033_cli_documents_bindings_and_requires_evidence", "test_f033_real_record_producer_transport_consumer_reopens_selected_directory", "test_f033_rejects_nonprivate_evidence_directory", "test_f033_preserves_protected_record_checks", "test_f033_preserves_source_compiler_digest_and_closed_profile_checks", "test_f033_predecessor_digest_still_binds_selected_service_record", "test_f033_legacy_gate_digest_does_not_exempt_other_service_sources"]
repair = "All three CLI modes require --evidence-dir for the same retained v1/v2 record filenames. Evidence directories must be private and owned. --cargo overrides CARGO; otherwise cargo is resolved on PATH. --target-dir overrides CARGO_TARGET_DIR; otherwise the existing environment and Cargo configuration are preserved. Compiler target profiles, locked builds, timeouts, owner/regular-file/size/mode checks, O_NOFOLLOW writes, exact source and executable digests, predecessor binding and all six required boundary cases remain intact."
wiring = "None: f033 requests changes only within tools/qualification/paxeer-x."

