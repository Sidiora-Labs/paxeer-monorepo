[meta]
task = "22.33.1239"
acceptance = "22998.1"
audit_record = "spec/layerx-merge/programme/audit/records/22.30.6.kvx"
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
initial_head = "4c4aed87e8572e4ae1d9cf0d59ec94345ab2944a"
repair = "Add an independent offline regression proof of the root README rewrite owned by task 22.31.470, closing the documentation evidence gap for readme-retired-daemon without changing README.md."

[finding.readme-retired-daemon]
path = "README.md"
severity = "medium"
class = "doc-drift"
owner_task = "22.31.470"
owner_domain = 16
resolution = "The inherited README describes one chain-125 paxd BFT network with embedded kernel execution, root node RPC, native funding and committed-block finality. It supplies paxd build/start commands, distinguishes activated/replacement precompiles from upgrade-gated custody/checkpoint refusal surfaces, and removes the separate daemon/deployment guidance."
tests = ["test_readme_merged_paxd_execution_and_committed_finality", "test_readme_root_rpc_range_and_chain_125_request", "test_readme_transaction_transport_and_committed_receipt_consumer", "test_readme_paxd_build_and_deployment_commands_match_producers", "test_readme_active_and_replacement_precompiles_match_address_table", "test_readme_post_plan_refusals_and_supported_replacements"]

[baseline]
inspection = "Initial git status and diff showed only pre-existing runner changes to .cgignore and spec/layerx-merge/spec.kvx. Both scoped task files were absent. /out/run/gates.jsonl was absent and gate.json recorded zero builds, zero verifies and two repair cycles available. README.md already contains the 22.31.470 rewrite."
verification = "Pre-change verification was not run: the explicit bounded gate order requires the entire implementation first and permits verification only through hf-done. Therefore no pre-change test failure is claimed; the new test module did not exist on the initial tree."

[proof]
source_facts = "Tests read the actual README and assert the merged architecture, chain 125, api1 through api14 root HTTPS JSON-RPC range, no separate daemon/checkpoint deployment, transaction submission and committed receipts. The curl recipe is parsed with shlex and json; URLs with urllib.parse; merge addresses from the production Go table; ledger methods from the real ABI JSON; and the repair record from TOML-compatible KVX."
producer_transport_consumer = "Source assertions trace node/app.go and modules/lxphost/host.go to the embedded host and consensus source; rpc/send.go through Sequencer.Accept and node/sequencer/accepter.go WAL release to rpc/sequencer_receipt.go committed block coverage. Build commands are tokenized and traced through Makefile native prerequisites and chain.mk to daemon/paxd; executor refusals are checked against the real precompile guards and upgrade names."
review_only = "Native compilation, runtime execution, consensus commitment, retirement behavior at live upgrade heights, endpoint availability and operational deployment are not executed by this documentation gate. Source assertions prove documented facts and code connections, not runtime certification. No stateful component or interface changes, so restart-recovery and interface-driving tests are inapplicable. The finding names only Markdown; no shell script or unit file is repaired, and no external bash/toolchain gate is needed."
anchor_boundary = "The merge retires anchor writes; historical views remain archive-only until v7.0-anchor-store-delete. Tests preserve this distinction and the separate native bridge instead of overstating retirement or treating old checkpoints as current finality."

[wiring]
requests = []
assessment = "No required README fact is missing on this checkout. README.md is outside scope and remains owned by task 22.31.470, domain 16; any future missing architecture/build/retirement fact requires a one-line wiring request to that task for README.md. No out-of-path change was made."

[qualification]
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1239.py"
build_gate = "hf-build"
verify_gate = "hf-done"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The final hf-done JSON and its private evidence ledger entry identify the exact content-derived verified revision, command, exit code and log path; build and verify must name the same candidate revision."
evidence_policy = "Finalize these files before the gates. Embedding their candidate hash in their own content changes that hash; retain exact evidence in the runner ledger and final response. Claim qualification only on hf-done exit zero. The runner commits; no manual commit or push."

[format]
policy = "No Python or KVX formatter is configured for these paths. Apply .editorconfig UTF-8, LF, final newline and trailing-whitespace conventions only after the full implementation."

[gotcha.context]
observed = "Broad context and ledger reads can exceed output limits; cg brief/survey can report unrelated cached tasks and apparent changes."
resolution = "Use the actual Git status/diff, bounded task/source reads and /out/run/gates.jsonl. Notes stay in this scoped record because GOTCHA.kvx and spec files are outside the user's allowed paths."

[gotcha.retirement_source]
observed = "The guessed precompiles/common/retired.go path does not exist."
resolution = "Discover and use the committed precompiles/common/retire.go implementation, which encodes LXP_MODULE_DISABLED, rather than guessing source names."
