[task.22.31.425]
audit = "22.30.174"
base_revision = "264615cba89456c37eeb19535cb16b81846f6a68"
repair = "Fail closed on unsuccessful, malformed or ambiguous source enumeration; accept an empty keyring only after successful JSON-list enumeration. Before deletion, reopen the destination file backend, export each source key's private armor, import into a fresh private file backend and reopen its address. Decrypt the newest checksum/time-validated backup into private scratch, safely extract only its source keyring after comparing every file size and SHA-256 with the original source snapshot, then enumerate and privately export/import/reopen every recovered key using paxd. Re-enumerate and rehash the live source immediately before deletion; any failed prerequisite retains it."
runtime_proof = "The production backup/checkpoint.py producer captures a real closed SQLite persistent peer fixture with two committed names, addresses and private byte strings after rollback of an uncommitted update. Transport the producer image through a filesystem store, delete the original home and reload the actual migration recovery module. Its production restore_keyring consumer checks the original manifest, restores into a private home, and the test repeatedly reopens the restored SQLite store read-only to check integrity, addresses, private contents, exact bytes and permissions. Reject altered contents with identical filenames, absent and extra keys, truncation, duplicate/traversal/absolute/link/special members, changed live sources and existing recovery destinations. Positively empty keyrings use the same actual backup producer and recovery consumer. SQLite is a persistent peer fixture, not the paxd keyring format."
source_proof = "hf-build performs the single declared bash -n tools/ops/keyring-migrate.sh syntax parse. Pytest checks the production shell's guarded command arguments and ordering: pipefail enumeration, private scratch, explicit export/import failures, destination recovery through separate paxd processes, checksum/time/decrypt/content/backend prerequisites, final source enumeration/content checks, in-use guard and the unique source deletion. Lex the real Python restore invocation and assert its exact consumer arguments. Invalid JSON-list types and ambiguous key records execute the production enumeration parser without subprocesses."
review_only = "Bash, paxd, age, sha256sum, SSH/store transport and application backend commands are not executed by this Python-only gate. The guarded actual-backend recovery commands are source-proven and reviewed: successful private export and import into a fresh backend must recover the same address for every source key. This establishes private signing material recovery through the node's own key APIs; no transaction is signed or broadcast. Actual paxd armor semantics and address derivation remain review-only here. Non-list output (including null), whitespace/control-bearing names or addresses, leading-option names, duplicate names, symlink/special-file keyrings and noncanonical or linked archive members fail closed. Migration requires source writers to remain stopped, as required by the existing in-use prerequisite; final enumeration/digests detect changes but are not a writer lock."
baseline = "No pre-change verification was run: the explicit order requires complete implementation before formatting/build/testing, hf-build before hf-done, and forbids running verify_cmd by hand. No baseline test failure is claimed. Initial working tree contained runner-prepared .cgignore and spec task-start bookkeeping only; the private ledger had no prior gates. Preserve those setup changes. No Python or shell formatter is configured for these paths; follow existing conventions and repository whitespace/end-of-file rules."
evidence = "The final hf-done JSON and private runner ledger name the exact content-derived verified candidate revision, command, exit and log. hf-build and hf-done must qualify the same revision. The record is complete before gating; no source edit after verification to embed its own derived revision. The runner handles publication; no manual commit or push."
wiring_requests = []

[finding.key-enumeration]
tests = ["test_key_enumeration_distinguishes_empty_and_recovers_addresses", "test_key_enumeration_rejects_unreadable_or_ambiguous_results", "test_key_enumeration_shell_preserves_source_on_every_failed_prerequisite", "test_key_enumeration_destination_reopens_private_material_and_address", "test_key_backup_content_positively_empty_keyring", "test_key_backup_content_restarts_and_recovers_original_keys"]

[finding.key-backup-content]
tests = ["test_key_backup_content_restarts_and_recovers_original_keys", "test_key_backup_content_rejects_damaged_archive_preserving_source", "test_key_backup_content_detects_source_changes", "test_key_backup_content_refuses_existing_home", "test_key_backup_content_positively_empty_keyring", "test_key_backup_content_shell_restores_bytes_then_actual_backend"]

[gotcha.1]
symptom = "The task step requests an unchanged-tree baseline verify but the explicit order and allowed gates prohibit it."
resolution = "Follow the explicit order, claim no pre-change failure and record the conflict here; root GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
symptom = "Initial combined workflow, gotcha and audit reads exceeded the output limit."
resolution = "Read exact workflow rules, task, findings and applicable gotchas separately; keep subsequent code reads bounded."

[gotcha.3]
symptom = "A function invoked as an OR-list prerequisite cannot rely on Bash errexit to abort its internal commands."
resolution = "Guard every backend export/import/show, restored-content check and backup transport/decrypt prerequisite explicitly; preserve the source on failure."
