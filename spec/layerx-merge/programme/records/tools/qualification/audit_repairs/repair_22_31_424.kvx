[task.22.31.424]
audit = "22.30.174"
finding = "backup-consistency"
base_revision = "081dc08ced37d64df4d676e4b2a2d07ef444115a"
repair = "Require an exclusive quiesce/capture/resume lifecycle and an offline restored-state validator. Capture the complete node home, kernel root, validator/node private keys, signing state and declared additional keys. The production Python checkpoint producer rejects source changes, missing roots, missing or empty keys, symlinks, special files and incomplete images. Read back and decrypt the actual transported encrypted candidate, restore to a new private directory, check every member against the quiesced manifest and require semantic committed-state/key validation before publishing and pruning. Resume and remove pending artifacts on failure; never accept a nonzero capture status."
proofs = ["test_backup_consistency_restarts_and_recovers_committed_state", "test_backup_consistency_rejects_incomplete_capture", "test_backup_consistency_rejects_symlink_sources", "test_backup_consistency_bad_candidate_preserves_recoverable_checkpoint", "test_backup_consistency_dump_is_in_same_verified_image", "test_backup_consistency_refuses_existing_restore_destination", "test_backup_consistency_shell_lifecycle_and_retention_guards", "test_backup_consistency_public_restore_uses_verified_consumer", "test_backup_consistency_record_names_proofs_and_limits"]
runtime_proof = "Execute the production checkpoint capture and restore functions with real filesystem transport and SQLite persistent peer fixtures. Commit and close both databases after rolling back uncommitted writes, capture using the real producer, remove all original state, load a fresh consumer namespace, reopen the stored recovery image, then reopen both restored SQLite databases read-only and check integrity, committed height/root/balance, signing state and exact key bytes/modes/ownership. Reject truncated, missing-key, changed-state, wrong-manifest, duplicate, traversal and symlink images while preserving and reopening the last recoverable checkpoint. Check complete state roots, nonempty private keys, an optional database dump and refusal to overwrite existing state. SQLite is a storage peer fixture, not the paxd/kernel database schema or a substitute semantic validator."
source_proof = "Check the actual shell entry points: mandatory lifecycle/identity/root/key inputs, lock, strict capture/decrypt/checksum/restore/validator guards, remapped isolated roots, failure resume/cleanup and publication/retention ordering. Both backup validation and public restore use the same production checkpoint consumer. Check full-home example coverage and intentionally unset mandatory site hooks. hf-build runs the declared bash -n tools/ops/backup/backup.sh syntax check; pytest lexes consumer commands and checks guarded source facts without external binaries."
review_only = "Bash lifecycle execution, flock, age encryption/decryption, SSH/store commands, shell retention execution and actual paxd/kernel backend recovery/key loading are not executed by this Python-only gate. Their command guards and ordering are source-proven, while deployment hooks must establish a durable writer stop/flush hold and reopen recovered application stores to compare committed height/root and load all required key material offline, without signing or network access. Exact byte preservation is necessary but alone does not establish application-level consistency; missing or failing semantic validation always blocks publication and retention. The public restore consumer now requires a manifest-bearing recovery image and a nonexistent destination; historical unmanifested archives need an explicitly reviewed legacy recovery procedure."
baseline = "No pre-change verification was run: the explicit order requires complete implementation before testing, hf-build before hf-done and forbids running verify_cmd by hand. No baseline test failure is claimed. No Python or shell formatter is configured for these paths; retain their existing conventions and apply the repository whitespace/end-of-file rules only. Initial working tree contained runner-prepared .cgignore and spec task-start bookkeeping only; the private gate ledger had no earlier runs. Those setup changes are preserved untouched."
evidence = "The final hf-done JSON and private runner gate ledger name the exact verified candidate revision, command, exit and log path. The build and verify must name the same candidate revision. The runner records/publishes the qualified task; no source changes after verification to insert its own content-derived revision, and no manual commit or push is performed."
wiring_requests = ["Deployment configuration at /etc/paxeer/backup.env and its site-owned lifecycle/validator executables, owning domain 16: wire BACKUP_QUIESCE_CMD/BACKUP_RESUME_CMD to flush and hold every source writer stopped, enumerate all required key paths and wire BACKUP_VALIDATE_CMD to reopen isolated recovered node/kernel state and keys, comparing committed height/root offline; do not enable retention until this mandatory contract is implemented.", "tools/ops/backup/test.sh, owning domain 16 and finding backup-test-contract: migrate the legacy shell test to the mandatory quiesce/validator interface and replace its unsafe tar-exit-1 success expectation in the separately owned test-gap repair; it is not run or weakened here."]

[gotcha.1]
symptom = "The requested baseline verify conflicts with the explicit implementation-first gate order and single-run budget."
resolution = "Follow the explicit order, claim no pre-change result and record task observations here because root GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
symptom = "Large initial workflow, gotcha and graph outputs were truncated, and cg grep positional paths did not narrow the result."
resolution = "Read the applicable workflow sections, exact audit finding/task and bounded backup files directly; no extra qualification commands or out-of-scope edits were made."

[gotcha.3]
symptom = "The old default sources omit the full node state and the old shell test expressly accepts an incomplete capture."
resolution = "Require full node/kernel roots and private material, update the deployment example, and record the separately owned shell-test contract wiring instead of loosening its assertions or claiming it ran."
