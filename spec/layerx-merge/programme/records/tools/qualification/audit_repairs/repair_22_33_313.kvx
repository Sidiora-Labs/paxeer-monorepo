[task.22.33.313]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
checkout_revision = "cc422fb1ae1a4dc5edbf3a25a2b380e0cf520650"
repair = "Qualify audit 22.30.135/root-readme-network-model against the production README inherited from task 22.31.470. Preserve its merged paxd architecture, root JSON-RPC chain-125 guidance, transaction and committed receipt flows, tenant namespaces, retired executors and current node/explorer operations. Only this repair record and its focused pytest module are changed."
readme_owner = "domain 17; task 22.31.470"
source_proof = "The module asserts README source facts and traces their production references: embedded cgo host and consensus block source, root-path RPC dispatch, signed transaction acceptance/forwarding, WAL release before receipt publication, submitted/receipted/committed RPC rungs and committed coverage, receipt signing and verification consumers, retirement guards, Makefile native prerequisites and node output target. It parses the documented curl arguments and JSON payload in-process, checks root HTTPS host/range guidance, separates active address rows from historical refusal prose, resolves node/explorer operations links and rejects obsolete separate-daemon instructions and draft status."
review_only = "Native Go/C/Rust builds, node startup, actual transaction execution, signature validation, BFT commitment, endpoint availability and WAL restart/recovery are not executed. The production producer/transport/consumer connections are checked as source facts for documentation drift; no interface or stateful runtime component is changed and no runtime recovery proof is claimed. The finding names only README.md: no shell script, unit file or manifest is repaired. Its shell example is parsed without execution. The pytest gate needs no environment variable, credential, live endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit implementation-first order requires the complete implementation before formatting/build/testing, hf-build before hf-done, and no manual verify_cmd run. Therefore no pre-change failing tests are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task-start/dependency bookkeeping; neither scoped file existed. No /out/run/gates.jsonl existed. README already contained the expected facts from 22.31.470 and remains unchanged."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_313.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger record the exact verified content-derived candidate revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification because embedding its own content-derived candidate hash would change that hash. No gate success is claimed before execution; the runner retains evidence and commits the result."
wiring_requests = []

