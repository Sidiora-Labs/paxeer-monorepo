tests = ["test_f004_safe_identifiers_reach_contained_directory", "test_f004_rejects_traversal_and_nonstring_names", "test_f004_rejects_malformed_configs", "test_f004_rejects_symlinked_directories", "test_f004_resolved_containment_rejects_prefix_siblings", "test_f004_publish_replaces_only_generated_files", "test_f004_rerender_removes_unemitted_optional_proposal", "test_f004_publish_preflights_all_paths_before_replacement", "test_f004_publish_rejects_unselected_destinations_and_stages", "test_f004_top_level_replaces_names_without_following_hardlinks", "test_f004_top_level_preflights_all_generated_targets", "test_f004_output_guard_cli_uses_real_operations", "test_f004_shell_wires_guarded_producer_transport_and_consumer", "test_f004_record_maps_finding_to_executed_tests"]

