resolution = "Follow the explicit order and record no pre-change test result; do not edit out-of-scope GOTCHA.kvx or spec files."

[gotcha.2]
symptom = "Combined workflow and audit reads exceeded output limits."
resolution = "Read the exact task, finding, workflow rules and relevant gotcha sections separately with bounded outputs."

[gotcha.3]
symptom = "The bridge producer requires empty output directories and rejects unrelated files in them."
resolution = "Generate in a fresh output-contained staging directory and publish only known files, preserving operator contents in the existing destination."

[gotcha.4]
