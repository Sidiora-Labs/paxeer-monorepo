[task]
id = "22.33.706"
audit = "22.30.169"
base_revision = "4299cb15eced23eb9a839162acd11e9a937edd05"
qualification = "The exact verified candidate revision, command, exit code and private evidence location are recorded by hf-build/hf-done in the gate ledger and the final evidence line. No qualification is claimed before those gates run."
baseline = "Not run: the mandatory implementation-first order and hf-done-only verification conflict with step 6's unchanged-tree verification. The test module did not exist on the base revision and no baseline test failures are claimed."
proof = "The real JevClient sends canonical JSON with the production authorization and content headers to an in-process loopback HTTP server. The server returns the committed captured decision response and deliberately malformed variations. The real docs consumer feeds the CLI's shared evaluation/report boundary; no external service, credential, binary or environment setting is needed."

[finding.jev-answer-numeric-bounds]
tests = ["test_jev_answer_numeric_bounds", "test_jev_requested_score_domain", "test_jev_coherent_declared_probability_distribution", "test_jev_score_uses_requested_scale_not_response_legend", "test_jev_score_rejects_value_above_shorter_requested_scale", "test_jev_accepts_probability_and_score_boundaries", "test_jev_valid_recorded_roundtrip_preserves_evidence"]
repair = "Reject nonnumeric, boolean, nonfinite, overflowing and out-of-range numbers before constructing answers. Enforce complete declared probability keys and unit probability mass, and bound continuous scores to the requested zero-based level scale."

[finding.jev-incomplete-response]
tests = ["test_jev_incomplete_response", "test_jev_incomplete_response_cli_failure", "test_jev_valid_response_reaches_cli_report", "test_jev_invalid_document_preserves_error_digests", "test_jev_valid_recorded_roundtrip_preserves_evidence"]
repair = "Validate exact answer names, requested kinds and declared choices against the serialized question schema. Preserve request/response digests on validation errors as well as successful evaluations. Share the existing CLI error/report boundary so malformed evaluations fail before advisory output is written."

[wiring]
request_1 = "spec/layerx-merge/spec.kvx task.22.33.706 — domain 16/task runner: carry these finding-to-test mappings and the exact hf-done evidence into the central task record; direct spec edits are forbidden by the task scope."
request_2 = "GOTCHA.kvx — workflow owner: record the baseline-verification/order conflict and the need to direct Python bytecode outside the candidate directory; the task scope forbids editing the root ledger."

[gotcha.gate-order]
observed = "Step 6 asks for an unchanged-tree verification, while the mandatory order prohibits testing before complete implementation and prohibits invoking verify_cmd manually."
resolution = "Run only hf-build then hf-done after implementation and explicitly retain the baseline limitation."

[gotcha.candidate-bytecode]
observed = "The gate candidate collector includes ignored bytecode below allowed directory paths, so an ordinary compile or test may change the candidate revision."
resolution = "Direct Python bytecode to a private temporary cache for both gates and keep generated bytecode outside tools/jev."
