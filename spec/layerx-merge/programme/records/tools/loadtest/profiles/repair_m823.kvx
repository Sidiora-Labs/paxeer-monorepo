[gotcha.scope]
observed = "Root GOTCHA.kvx, spec task records and tools/loadtest/README.md are outside this task's scope; record mappings, wiring and gotchas here without modifying them."

[gotcha.command-location]
observed = "Prerequisite repairs moved the real CLI into config/cli outside this task's scope; an importable profiles.NewCommand adds the executable preflight without duplicating the CLI implementation or using a subprocess toolchain in proofs."

[gotcha.inspection]
observed = "Large repository ledgers and graph survey output truncate; inspect the task, workflow rules, pertinent gotcha sections and named code paths separately. The service helper is utils/service/start.go rather than service.go."

[qualification.attempt1]
revision = "22900b72aca06679a6c8ff76de244b34f9295395"
command = "cg spec done 22.33.823 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "All preflight tests passed; ProfileOutputPath and ReportParentError failed the assertion that signed transfers reach both shards, because the two-account pool selects the same sender every time."
repair = "Use an odd 129-account pool and require observed traffic on both real loopback peers before cancellation; preserve all assertions and profile bounds."

[gotcha.account-pool]
observed = "A transaction advances the round-robin account pool for both sender and receiver, so a two-account CLI fixture uses only one sender and one shard; an odd pool and endpoint-aware completion exercise all senders and both shards."
