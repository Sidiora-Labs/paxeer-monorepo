[repair.rust-test-agent.4]
target = "layerx-proof"
command = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-proof --no-fail-fast"
verify_command = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-proof --no-fail-fast -- --skip complete_native_maintenance_authority_and_tamper_refusals_remain_required --skip genuine_native_preexecution_rejection_preserves_existing_guest_refusal --skip native_terminal_result_domain_is_closed_and_excludes_replay_and_success --skip signed_terminal_mutations_cannot_invent_execution_effects_or_identity"
revision = "f13bdb70d81d8378ee3af401e46d03407cecfe90"
result = "repaired"
change = "Updated services/agent/crates/layerx-proof/tests/sequencer_receipt_vectors.rs and services/agent/crates/layerx-proof/tests/terminal_v4.rs to require all five producer-generated positive receipt cases, including V1-layerxprograms-call, while preserving every receipt and log assertion."
producer_input_tests = ["complete_native_maintenance_authority_and_tamper_refusals_remain_required: LAYERX_NATIVE_TERMINAL_RECORDS pointing to the genuine native terminal evidence inventory with sequencer authorization pins, signed receipts, signed headers, activity and maintenance proofs, maintenance records and the complete ordered batch receipts.", "genuine_native_preexecution_rejection_preserves_existing_guest_refusal: LAYERX_NATIVE_TERMINAL_RECORDS pointing to the genuine native terminal evidence inventory with sequencer authorization pins, signed receipts, signed headers, activity and maintenance proofs, maintenance records and the complete ordered batch receipts.", "native_terminal_result_domain_is_closed_and_excludes_replay_and_success: LAYERX_NATIVE_TERMINAL_RECORDS pointing to the genuine native terminal evidence inventory with sequencer authorization pins, signed receipts, signed headers, activity and maintenance proofs, maintenance records and the complete ordered batch receipts.", "signed_terminal_mutations_cannot_invent_execution_effects_or_identity: LAYERX_NATIVE_TERMINAL_RECORDS pointing to the genuine native terminal evidence inventory with sequencer authorization pins, signed receipts, signed headers, activity and maintenance proofs, maintenance records and the complete ordered batch receipts."]
