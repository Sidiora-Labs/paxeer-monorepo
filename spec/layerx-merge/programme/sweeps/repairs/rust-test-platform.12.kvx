[repair.rust-test-platform.12]
target = "layerx-indexer"
command = "cargo test --locked --manifest-path services/platform/Cargo.toml -p layerx-indexer --no-fail-fast -- --skip proof_layerxledger_0x101a --skip proof_layerxpay_0x101b"
revision = "8f73f5f516b7cfe3002b5378429f00aab8fb74d8"
result = "repaired"
change = "tests/vectors/names/indexer_api_v1.json records NewOwner as transfer under task 18.1394.1; services/platform/hosted/indexer/fixtures/names_blocks.json supplies transaction chainId; tests/ai_reputation_finality.rs, tests/ai_snapshot_minimal.rs and tests/support/repair_22_33_1446.rs use canonical native membership proofs under the verification contract of task 22.33.1446 and retain eviction, replay and reopen checks; tests/repair_22_33_1444.rs explicitly constructs missing database domain hints; src/ai_market.rs and src/ai_reputation.rs authenticate foreign-chain commits before returning their typed domain refusals; tests/ai_snapshot_minimal.rs follows the reward availability rule changed by repair 22.30.122, which returns NotYetProduced before first funding (decision 2997); tests/repair_22_33_1445.rs bounds the sixteen-megabyte request at two seconds below the three-second peer hold because the former one-second bound sat inside its write latency under the parallel suite, preserving the 250 ms lower bound and Source error assertion (decision 2998)."
producer_input_tests = ["proof_layerxledger_0x101a: application-produced JSON on stdin from precompiles/layerxledger/proof_layerxledger_0x101a_test.go TestProofLayerxledger0x101a, including its live SQLite store path", "proof_layerxpay_0x101b: application-produced JSON on stdin from precompiles/layerxpay/proof_layerxpay_0x101b_test.go TestProofLayerxpay0x101b, including its live SQLite store path"]
