[repair.rust-test-platform.11]
target = "layerx-platform-gateway"
command = "cargo test --locked --manifest-path services/platform/Cargo.toml -p layerx-platform-gateway --no-fail-fast -- --skip real_core_and_identity_readiness_contract --skip real_gateway_readiness_capabilities_contract --skip payment_facts_cross_real_tls_and_refuse_foreign_principals_without_losing_the_outbox"
revision = "9eee6f88d459c1ec873c5cebb24f01396c45834b"
result = "repaired"
change = "services/platform/Cargo.lock, gateway Cargo.toml, src/main.rs, src/authority_readiness.rs, src/backend_availability.rs, src/rpc_faucet.rs, src/settlement.rs, src/paxeer.rs and tests/authority_readiness_contract.rs, tests/chain_only_readiness.rs, tests/completion_gate.rs, tests/degraded.rs and tests/support/payment_events.rs repair authority probing, consensus reporting, closed module validation, digest refusals, network-probe failure classification and retired-surface assertions and tools/paxeer-x/route-catalogue.json, tests/hpx_ingress.rs, tests/support/hpx_ingress_test.go and tests/unified_service_paths.rs and tests/router_surface.rs enforce configured-only readiness, self-contained HPX transport and retired custody absence under decisions 803, 808, 1228, 1229, 1884 and 2508 and requirement 12038, while tests/chain_reads.rs isolates each real Redis fixture in a tempfile directory and tests/paxeer_failover.rs reserves distinct non-listening TCP endpoints and preserves startup diagnostics."
producer_input_tests = ["real_core_and_identity_readiness_contract: PAXEER_X_ROUTER_READINESS_CASE with real core and identity TLS endpoints, client identity, CA and tokens", "real_gateway_readiness_capabilities_contract: PAXEER_X_GATEWAY_READINESS_CASE with gateway environment, real configured backends and producer readiness", "payment_facts_cross_real_tls_and_refuse_foreign_principals_without_losing_the_outbox: real payment source, TLS identities, principal enrollment and durable Redis outbox"]
verified_tests = ["px_getReceiptKeys: passing"]
