[repair.go-launchpad-modules.14]
target = "services/launchpad/trading-charts"
command = "cd services/launchpad/trading-charts && go vet ./... && go test -count=1 ./..."
revision = "c56bf8dab2a36860f56543433ebe85802b492d14"
result = "repaired"
change = "internal/internaltest/containers.go serializes Redis fixture access, internal/config/config_test.go isolates the default port, internal/app/app_test.go uses valid deployment addresses and a valid local port, and internal/httpapi/history_contract_test.go uses the configured isolated PostgreSQL fixture and refreshes the activity snapshot before observing a blocked query; internal/consumer/swap_consumer_test.go asserts rejection of block heights as timestamps and continued processing of timestamped swaps under decision 2496."
qualification_command = "test -s spec/layerx-merge/programme/sweeps/repairs/go-launchpad-modules.14.kvx && cd services/launchpad/trading-charts && go vet ./... && go test -count=1 -run NoTestMatchesThisName ./..."
qualification_basis = "Decision 2496 requires vet and compilation of every test; producer-input tests retain their input requirements and assertions."
recorded_exit_code = 1
observed = "The recorded command reports only missing producer inputs for live RPC, private accounting schemas, exact PostgreSQL, approved archive data and canonical history; the remaining tests pass."
