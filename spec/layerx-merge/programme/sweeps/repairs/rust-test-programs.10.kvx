evaluator_joint_membership_repair = "evidence.rs:check_frozen_evaluator validates the canonical joint reputation/admission section before decoding its admission suffix, repairing the shared SealEvidence and CommitScore authority reader without changing any application refusal code."
evaluator_role_conflict_repair = "evaluators/authority.rs:open_epoch rejects an active approved-rubric grant whose principal is the market owner or a frozen worker before the membership filter; nonmember records remain retained and eligible evaluator uniqueness checks remain unchanged."
state_copy_fuel_repair = "types.rs:GuestIndex::guest_copy_from_slice retains the exact equal-length guest guard and uses the checked bulk copy instead of a per-element guest loop for reward sections and other retained state; the protocol CPU limit remains 1000000."
native_refusal_finding = "At 3588221d01e20c5be36c3f363eb1bf96b4783742, hf-done exited 1 in /out/logs/verify-1.log; native CALLs at heights 1000 and 1001 returned kernel status 0 and receipt/runtime status -736 with replay field, site and stage none, while the reader expected CandidateV4; the three native readers now include the decoded terminal in that diagnostic, and the native binding mapping is unchanged."
manifest_refusal_contradiction = "At 3588221d01e20c5be36c3f363eb1bf96b4783742, hf-done exited 1 in /out/logs/verify-1.log: manifest_v2_capabilities.rs:manifest_cap_version_and_exact_framing_are_enforced requires NON_CANONICAL for a v2 body truncated exactly before its capabilities, while workers_lifecycle.rs:a13_manifest_grammar_refusals_before_mutation requires BAD_VERSION for a capability-free body tagged v2; both assertions and the decision-2900 refusal are preserved."
remaining_qualification = "The last build and verify ledger rows determine qualification; the first verification failures above are not claimed repaired without a successful verification at the same final candidate."

source_restoration = "Decision 2935 restores every crate source to 95c2388776a4a808c48dc982c289e54146399516 except evidence.rs:check_frozen_evaluator, which splits the canonical joint section for frozen membership, and evaluators/authority.rs:open_epoch, which refuses owner and worker role conflicts before filtering membership; types.rs retains the merged exact-length guard and element copy."
restored_baseline_evidence = "/out/run/gates.jsonl: first verify row identifies the restored-tree suite command, revision, exit and private log; its log records failing target and test names before any qualification repair."
restoration_supersedes = "The earlier joint table wrapper, manifest BAD_VERSION branch, rollover scratch change, bulk copies, request-digest cache and added never-inline attributes are removed; the earlier manifest contradiction is withdrawn because the merged decoder supplies the unchanged refusal order."
restoration_tests = "The retained reputation vectors use test-local projections of the canonical decoders; no guest wrapper or alternate section decoder is added."
final_qualification_reference = "/out/run/gates.jsonl: matching final successful build and verify rows are the authority for the repaired result and verified 40-hex revision; absent those rows the repair remains unqualified."

