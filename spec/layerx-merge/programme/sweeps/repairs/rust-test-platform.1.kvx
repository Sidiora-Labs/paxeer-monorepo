[repair.rust-test-platform.1]
target = "layerx-ramp-toolkit"
command = "cargo test --locked --manifest-path services/platform/Cargo.toml -p layerx-ramp-toolkit --no-fail-fast"
revision = "c56bf8dab2a36860f56543433ebe85802b492d14"
result = "repaired"
change = "Updated services/platform/ramps/toolkit/tests/recovery_settlement.rs to use the consensus head required by decision 805 and include the required block receiptsRoot, and services/platform/ramps/toolkit/tests/contracts.rs to prove unmatched torn tails are rejected before settlement verification without loading protected recovery credentials."
producer_input_tests = ["failed_callback_apply_retains_no_event_and_retry_is_idempotent: LAYERX_RAMP_RECOVERY_CONTRACT_CONFIG, LAYERX_RAMP_RECOVERY_CONTRACT_ORDER and LAYERX_RAMP_RECOVERY_CONTRACT_CALLBACK with protected mutual TLS credentials and matching real provider, sequencer and custody settlement services", "genuine_source_finality_binds_orders_and_claims_before_any_funded_transition: LAYERX_RAMP_SOURCE_CONTRACT_FILE containing genuine finalized Ethereum and Solana sources and matching custody configuration", "interrupted_callback_write_recovers_on_restart_without_repair: LAYERX_RAMP_RECOVERY_CONTRACT_CONFIG, LAYERX_RAMP_RECOVERY_CONTRACT_ORDER and LAYERX_RAMP_RECOVERY_CONTRACT_CALLBACK with protected mutual TLS credentials and matching real provider, sequencer and custody settlement services", "mismatched_pending_append_prefix_preserves_history_and_refuses_recovery: LAYERX_RAMP_RECOVERY_CONTRACT_CONFIG, LAYERX_RAMP_RECOVERY_CONTRACT_ORDER and LAYERX_RAMP_RECOVERY_CONTRACT_CALLBACK with protected mutual TLS credentials and matching real provider, sequencer and custody settlement services", "recovery_refuses_chain_id_mismatch: protected recovery configuration and genuine finalized Ethereum and Solana sources as classified by decision 2496"]
