[repair.go-sdk-modules.1]
target = "sdk/platform/go"
command = "cd sdk/platform/go && go vet ./... && go test -count=1 ./..."
revision = "cea04b0a20fed9621b2f2580398024b38b76ff2e"
result = "repaired"
change = "sdk/platform/go/verify.go binds paymentDenom to the payment asset separately from the signed fee denomination; sequencer_receipt_test.go and portable_receipt_test.go cover all twelve cases and the unchanged fee-token fixture; committed_receipt_test.go places transaction and result proofs at the signed receipt index; native_program_lifecycle_test.go asserts externally authorized unsigned deploy/upgrade behavior; programs_http_test.go asserts decision 808 REST refusal and head-cache safety; sdk/platform/conformance/fixtures/refresh_receipt_vectors.py refreshes vector-v4-committed.json and vector-v5-portable.json from their provenance sources using portable-v2 field conversions while preserving recorded signatures (decision 2502)."
generator = "python3 sdk/platform/conformance/fixtures/refresh_receipt_vectors.py"
kernel_authority = "src/modules/programs/deploy.c:440-462 decodes deploy/upgrade payloads without a signature; src/protocol/lxp_kernel.c:218-220 accepts an unsigned Programs activity with binding_authority and signature_valid, while src/protocol/lxp_activity_signature.c:10-12 rejects missing native signatures otherwise."
producer_input_tests = ["TestAgentOperationEnvelopeProcessCases requires PAXEER_X_AGENT_ENVELOPE_CASE naming an absolute producer case file with real HTTPS gateway endpoint, trusted CA and server name, gateway API key, program bearer, session credential, request catalogue and response directory, plus daemon TLS inputs for daemon_read (decision 2496).", "TestProgramTerminalV5NativeCorpus requires PAXEER_X_PROGRAM_TERMINAL_V5_CORPUS naming the ten genuine ABI3/4 signed native cases produced by scripts/qualification/paxeer-x/program-terminal-v5.py (decision 2325); both tests are excluded by name from the declared verification command."]
