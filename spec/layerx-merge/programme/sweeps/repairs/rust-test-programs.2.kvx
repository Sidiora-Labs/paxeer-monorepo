[repair.rust-test-programs.2]
target = "layerx-program-sdk"
command = "cargo test --locked --manifest-path programs/Cargo.toml -p layerx-program-sdk --no-fail-fast -- --skip canonical_fixture_generates_digest_bound_self_contained_artifacts --skip frozen_vectors_are_exact_and_shared_by_both_clients --skip generated_sources_expose_every_roundtrip_and_failure_path --skip infallible_and_difficult_names_have_stable_collision_free_symbols --skip generated_client_guest_and_typescript_are_compiler_inputs --skip canonical_domain_abi_and_dynamic_capability_matrix_is_exact --skip immutable_published_interfaces_generate_all_language_families"
revision = "c56bf8dab2a36860f56543433ebe85802b492d14"
result = "repaired"
change = "programs/sdk/rust/tests/bindgen_conformance.rs gives consumer emission an isolated test output directory, validates every planned source and generated language binding, and preserves explicit producer exports."
producer_input_tests = ["canonical_fixture_generates_digest_bound_self_contained_artifacts: canonical exhaustive interface and digest-bound generated artifacts from tools/qualification/paxeer-x/program-bindings-producer.py", "frozen_vectors_are_exact_and_shared_by_both_clients: canonical exhaustive interface and shared frozen codec vectors from tools/qualification/paxeer-x/program-bindings-producer.py", "generated_sources_expose_every_roundtrip_and_failure_path: exhaustive canonical schemas and generated Rust, guest and TypeScript sources from tools/qualification/paxeer-x/program-bindings-producer.py", "infallible_and_difficult_names_have_stable_collision_free_symbols: canonical difficult-name interface and generated language symbols from tools/qualification/paxeer-x/program-bindings-producer.py", "generated_client_guest_and_typescript_are_compiler_inputs: PAXEER_X_BINDINGS_ARTIFACTS with consumer-plan.json, compile-results.json and hashed compiler artifacts from tools/qualification/paxeer-x/program-bindings-producer.py", "canonical_domain_abi_and_dynamic_capability_matrix_is_exact: canonical ABI version and dynamic capability interface matrix qualified by tools/qualification/paxeer-x/program-bindings-producer.py", "immutable_published_interfaces_generate_all_language_families: PAXEER_X_BINDINGS_FIXTURES with immutable abi1, abi2, abi2-dynamic, abi3, abi3-dynamic, abi4 and abi4-dynamic interface.bin files from tools/qualification/paxeer-x/program-bindings-producer.py"]
