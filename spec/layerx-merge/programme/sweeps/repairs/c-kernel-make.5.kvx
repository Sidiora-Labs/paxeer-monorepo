[repair.c-kernel-make.5]
target = "test-tests-python"
command = "make -s test-tests-python"
revision = "a38a74058ad57ad5889e462dbe7677f93460c779"
result = "repaired"
change = "Decisions 2498 and 2504: retain every test and its retirement assertions, align surviving callers with retired kernel interfaces, preserve the merged-chain domain golden, and derive the public bootstrap module count from the registry configuration reconciled by task 22.1.9."
producer_input_tests = "test_no_bridge_credit_apply_caller remains deselected by the declared verify command: decision 2438 reserves bridge-credit retirement for the owner decision of issue #1540. test_public_bootstrap_and_real_builder_bind_v3_and_native_authority is also deselected by that command because it requires the retired build/bin/layerxd binary, removed with cmd/layerxd by tasks 5.50.1-5.50.7 and 16.9.4; services/platform/hosted/node/bootstrap.sh:82 documents that binary and :444 still resolves it. test_explicit_price_preserves_records_and_existing_fee_components remains running with every assertion intact."
queue_disposition = "test_no_queue_disposition_codec_case: retain the prior repair asserting the retired terminal-rejection source absent (task 16.32.10, requirement 16279.1) and scanning every surviving protocol C source with the original forbidden-name pattern."
claim_callers = "test_no_claim_or_deposit_root_callers: express weak absence probes as typed function declarations in the codec and bridge proof suites; no retired function is called and every null-symbol assertion remains."
kernel_recipe = "test_kernel_rule_builds_and_runs_codec_primitives: clear inherited recursive make flags for the explicit child build, retaining the forced rebuild, compiler recipe assertion and real binary execution."
chain_domain = "test_makefile_chain_domain_is_merged_chain_golden: keep b69143b1aa0c360367c299a2a47bbbfe3546ecbdc0a78c640770d49d977f038d and validate the selected domain before building the host-boundary artifact."
replay_crossarch = "test_replay_crossarch_retired: exclude tests/vectors alongside tests/codec because its codec generator uses the replay fixture producer. Keep tests/vectors/codec/generate.py at its original path with its original content and the agent-prepare-codec-corpus recipe calling that path; services/agent/crates/layerx-types/tests/vectors.rs:19-31 copies it into clean checkout fixtures. Producer output and undeclared-activity checks are unchanged."
checkpoint_library = "test_checkpoint_and_library_suites_retired: move the six existing retirement tests into test_retired_requested_retirements_absent.py, the shared scanner's existing retirement-guard allowance, without changing any assertion."
state_withdraw_web = "test_state_withdraw_web_retired: remove the deleted web header and module registration (decision 2426, task 1.18.2); inspect real program request-event bytes and retain payment, account-creation and event-digest checks while asserting the retired pending store stays absent."
bootstrap_source = "Load the default modules from genesis-modules.conf, reject an empty configuration, validate every module and reject duplicates through enable_genesis_module, and require the enabled count to equal the configured list length instead of a literal seven."
bootstrap_genesis_test = "test_public_bootstrap_and_real_builder_bind_v3_and_native_authority asserts the exact encoded parameter count from the complete expected mapping: the registry's six enabled modules plus parameter-version and native-fee-authority-version; every parameter byte, withdrawal fee variant and real rebuilt artifact comparison remains checked."
qualification_observed = "Public bootstrap still requires build/bin/layerxd, but cmd/layerxd and its build target have been retired; the real executable is unavailable and the bootstrap check remains enforced."
