[row.r4-14.1]
interface = "interface.4.go-launchpad-keeper-keeper-init-genesis"
verdict = "served"
path = "modules/launchpad/keeper/genesis.go"
line = 15
symbol = "InitGenesis"
evidence = "Signature unchanged: func (k *Keeper) InitGenesis(ctx sdk.Context, gs types.GenesisState). The implementation now validates gs before writes, imports generation 2 surfaces, roles, fee accounting, fee rights and custody through initContracts, and installs role surfaces; generation 1 state is refused by Validate, implementing decision.409 and override.J28.15."

[row.r4-14.2]
interface = "interface.4.go-launchpad-keeper-keeper-export-genesis"
verdict = "served"
path = "modules/launchpad/keeper/genesis.go"
line = 178
symbol = "ExportGenesis"
evidence = "Signature unchanged: func (k *Keeper) ExportGenesis(ctx sdk.Context) *types.GenesisState. The implementation now uses exportContracts to export generation 2 role, fee-right, fee-accounting, custody and retired-address records and validates the export; it no longer exports generation 1 key-space records, implementing decision.409 and override.J28.16."

[row.r4-14.3]
interface = "interface.4.go-launchpad-app-module-basic-register-grpc-gateway-routes-j28"
verdict = "served"
path = "modules/launchpad/module.go"
line = 78
symbol = "RegisterGRPCGatewayRoutes"
evidence = "Now func (AppModuleBasic) RegisterGRPCGatewayRoutes(clientCtx client.Context, mux *runtime.ServeMux): the formerly ignored arguments are named and used by RegisterQueryHandlerClient(context.Background(), mux, types.NewQueryClient(clientCtx)), with registration errors causing panic. This replaces the registered empty body as specified by decision.405."

[row.r4-14.4]
interface = "interface.4.go-launchpad-app-module-basic-get-query-cmd-j28"
verdict = "served"
path = "modules/launchpad/module.go"
line = 86
symbol = "GetQueryCmd"
evidence = "Current declaration: func (AppModuleBasic) GetQueryCmd() *cobra.Command { return cli.GetQueryCmd() }. The method signature is unchanged; its return expression changed from nil to the launchpad CLI query command tree, implementing decision.405."

[row.r4-14.5]
interface = "interface.4.go-launchpad-app-module-register-services"
verdict = "served"
path = "modules/launchpad/module.go"
line = 105
symbol = "RegisterServices"
evidence = "Signature unchanged: func (am AppModule) RegisterServices(cfg module.Configurator). The body now registers both the Msg server via NewMsgServerImpl and the Query server via NewQuerier instead of Msg only, implementing decision.405 and override.J28.14."

[row.r4-14.6]
interface = "interface.4.go-launchpad-app-module-register-store-decoder-j28"
verdict = "served"
path = "modules/launchpad/module.go"
line = 148
symbol = "RegisterStoreDecoder"
evidence = "Now func (am AppModule) RegisterStoreDecoder(sdr sdk.StoreDecoderRegistry): the formerly ignored registry argument is named sdr and the former empty body now assigns simulation.NewDecodeStore() to sdr[types.StoreKey]."

