[row.r3-9.1]
interface = "interface.3.go-perps-keeper-withdrawable-j64"
verdict = "served"
path = "modules/perps/keeper/account.go"
line = 203
symbol = "Withdrawable"
evidence = "Signature unchanged: func (k *Keeper) Withdrawable(ctx sdk.Context, address common.Address) (uint256.Int, error). The implementation now reads params.WithdrawFloorPpm at modules/perps/keeper/account.go:231 and rounds the required USD up with accountCeilDiv, replacing the registered fixed-divisor behavior."

[row.r3-9.2]
interface = "interface.3.go-perps-appmodulebasic-registerinterfaces-j25"
verdict = "served"
path = "modules/perps/module.go"
line = 38
symbol = "RegisterInterfaces"
evidence = "Declaration changed from func (AppModuleBasic) RegisterInterfaces(_ cdctypes.InterfaceRegistry) {} to func (AppModuleBasic) RegisterInterfaces(registry cdctypes.InterfaceRegistry). The formerly ignored argument is passed to types.RegisterInterfaces(registry)."

[row.r3-9.3]
interface = "interface.3.go-perps-appmodulebasic-validategenesis-j25"
verdict = "served"
path = "modules/perps/module.go"
line = 54
symbol = "ValidateGenesis"
evidence = "Signature unchanged: func (AppModuleBasic) ValidateGenesis(_ codec.JSONCodec, _ client.TxEncodingConfig, bz json.RawMessage) error. After JSON decoding it now returns keeper.ValidateGenesis(genState), replacing the registered types.ValidateGenesis-only behavior."

[row.r3-9.4]
interface = "interface.3.go-perps-appmodule-registerservices-j25"
verdict = "served"
path = "modules/perps/module.go"
line = 99
symbol = "RegisterServices"
evidence = "Declaration changed from func (AppModule) RegisterServices(_ module.Configurator) {} to func (am AppModule) RegisterServices(cfg module.Configurator). The named receiver and configurator now register types.RegisterMsgServer(cfg.MsgServer(), keeper.NewMsgServerImpl(am.keeper))."

[row.r3-9.5]
interface = "interface.3.go-perps-types-perpscode-j25"
verdict = "served"
path = "modules/perps/types/errors.go"
line = 9
symbol = "PerpsCode"
evidence = "The exact declaration is func PerpsCode(name string) string at line 9; it returns the LXP_PERPS_ prefix plus name. This is a function generating error reasons, while ModuleName declares the perps codespace."

[row.r3-9.6]
interface = "interface.3.err-sdk-perps-2-invalid-params"
verdict = "served"
path = "modules/perps/types/errors.go"
line = 17
symbol = "ErrInvalidParams"
evidence = "Declaration changed from ErrInvalidParams = Register(\"perps\", 2, \"LXP_PERPS_INVALID_PARAMS\") to ErrInvalidParams = sdkerrors.Register(ModuleName, 2, PerpsCode(\"INVALID_PARAMS\")). Registration now uses sdkerrors.Register, ModuleName and PerpsCode instead of literal codespace and reason arguments; the perps codespace, numeric code and LXP_PERPS_ reason remain unchanged."

