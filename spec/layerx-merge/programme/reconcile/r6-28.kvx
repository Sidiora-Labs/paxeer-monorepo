[row.r6-28.17]
interface = "interface.6.wasm-std-msg-gov-vote-weighted"
verdict = "served"
path = "wasm/x/wasm/keeper/handler_plugin_encoders.go"
line = 296
symbol = "EncodeGovMsg"
evidence = "The declaration remains func EncodeGovMsg(sender sdk.AccAddress, msg *wasmvmtypes.GovMsg) ([]sdk.Msg, error). The registered signature description of an unconditional msg.Vote dereference has changed: lines 297-298 guard a nil Vote and return wrapped ErrUnknownMsg (Unknown variant of Gov), so a vote_weighted-only message is refused rather than panicking. Weighted-vote encoding remains unsupported; VoteWeighted is still declared at wasm-runtime/types/msg.go:139."

