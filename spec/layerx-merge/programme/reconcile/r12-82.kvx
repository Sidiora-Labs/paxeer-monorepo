[row.r12-82.16]
interface = "interface.12.fmt-sch-op-sign"
verdict = "served"
path = "services/wallet/schema/attestor-api/v1.kvx"
line = 165
symbol = "[op.sign]"
evidence = "[op.sign] retains POST /v1/sign and now lists kinds ['evm_tx', 'eip712', 'personal_message', 'eth_sign_digest', 'lx_bind', 'lx_grant', 'lx_send_authorization'] at line 171. lx_activity has been removed and custody remains unsupported; these seven kinds match SignKinds() in attestor/internal/server/sign.go."

[row.r12-82.17]
interface = "interface.12.fmt-sch-op-sign-request"
verdict = "served"
path = "services/wallet/schema/attestor-api/v1.kvx"
line = 175
symbol = "[op.sign.request]"
evidence = "[op.sign.request] now explicitly marks custody unsupported, constrains eth_sign_digest with a required recomputable construction, and describes activity as an unsigned asset-send envelope for lx_send_authorization. disclosure and approval are required for that kind and refused on others, replacing the registry's lx_activity field description; lx_grant has its own grant object."

[row.r12-82.18]
interface = "interface.12.fmt-sch-op-sign-kind"
verdict = "served"
path = "services/wallet/schema/attestor-api/v1.kvx"
line = 190
symbol = "[op.sign.kind]"
evidence = "[op.sign.kind] no longer defines lx_activity. It now defines lx_grant as signing the grant preimage and lx_send_authorization as signing the 32-byte asset-send owner authorization digest under send policy and authority rules without counting a spend; eth_sign_digest is restricted to reconstructed EIP-7702 authorization or sponsored-batch digests."
