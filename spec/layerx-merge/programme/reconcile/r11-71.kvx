[row.r11-71.36]
interface = "interface.11.cfg-mirror-native-checkpoint-policy-genesis-hash-hex"
verdict = "retired"
path = "services/interop/crates/layerx-mirror/src/node.rs"
line = 508
symbol = "genesis_hash_hex"
