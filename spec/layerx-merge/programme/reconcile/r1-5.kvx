symbol = "Close"
evidence = "func (h *Host) Close() retains its signature; under the exclusive RWMutex lock it now drains and frees cap(h.nodes) nodes, closes the pool channel and clears h.node, with a nil guard for repeated closure."

[row.r1-5.11]
interface = "interface.1.go-lxphost-host-execute-j22"
verdict = "served"
path = "modules/lxphost/host.go"
line = 1125
symbol = "HostExecute"
evidence = "func (h *Host) HostExecute(ctx sdk.Context, activity Activity, authority KernelAuthority) (Receipt, error) retains its signature with the expanded Activity, KernelAuthority and Receipt types. It borrows a pooled node, checks binding authority and payment replay, loads activity module state and blobs, and commits the receipt and payment reference; it no longer serializes every execution on one node."

