[row.r5-19.1]
interface = "interface.5.go-node-app-begin-block"
verdict = "served"
path = "node/abci.go"
line = 30
symbol = "BeginBlock"
evidence = "Signature now spelled out as func (app *App) BeginBlock(ctx sdk.Context, height int64, votes []abci.VoteInfo, byzantineValidators []abci.Misbehavior, checkHeight bool) (res abci.ResponseBeginBlock); the registry recorded only its opening line. Stores current votes and reads StoredVotes(height-1) at sequenced heights before legacyabci.BeginBlock, serving override.J31.18."

[row.r5-19.2]
interface = "interface.5.go-node-app-check-tx"
verdict = "served"
path = "node/abci.go"
line = 113
symbol = "CheckTx"
evidence = "Signature unchanged: func (app *App) CheckTx(ctx context.Context, req *abci.RequestCheckTxV2) *abci.ResponseCheckTxV2. The body now rejects nil requests and refuses the SequenceBatchDomain prefix through seqkeeper.RefuseCheckTx before transaction decoding, serving override.J31.19."

[row.r5-19.3]
interface = "interface.5.go-node-app-commit"
verdict = "served"
path = "node/abci.go"
line = 284
symbol = "Commit"
evidence = "Signature unchanged: func (app *App) Commit(ctx context.Context) (res *abci.ResponseCommit, err error). After successful BaseApp.Commit the body publishes stashed headers and invokes commitListener with LastBlockHeight and LastCommitID().Hash, serving override.J31.20."

[row.r5-19.4]
interface = "interface.5.go-node-app-process-proposal-handler"
verdict = "served"
path = "node/app.go"
line = 1687
symbol = "ProcessProposalHandler"
evidence = "Signature unchanged: func (app *App) ProcessProposalHandler(ctx sdk.Context, req *abci.RequestProcessProposal) (resp *abci.ResponseProcessProposal, err error). It decodes sequenced tx 0 separately and rejects mismatched batch transactions, sequence order or proposer before optimistic processing."

[row.r5-19.5]
interface = "interface.5.go-node-app-finalize-blocker"
verdict = "served"
path = "node/app.go"
line = 1821
symbol = "FinalizeBlocker"
evidence = "Signature unchanged: func (app *App) FinalizeBlocker(ctx sdk.Context, req *abci.RequestFinalizeBlock) (*abci.ResponseFinalizeBlock, error). It seals through SealForFinalize, installs a matching sealed sequencer state with SetSealedStateToCommit, and propagates ProcessBlock errors on the execution path."

[row.r5-19.6]
interface = "interface.5.go-node-app-process-block"
verdict = "served"
path = "node/app.go"
line = 2435
symbol = "ProcessBlock"
evidence = "Signature unchanged: func (app *App) ProcessBlock(ctx sdk.Context, txs [][]byte, req *BlockProcessRequest, lastCommit abci.CommitInfo, simulate bool, preDecoded []sdk.Tx) (events []abci.Event, txResults []*abci.ExecTxResult, endBlockResp abci.ResponseEndBlock, err error). It applies tx 0 after BeginBlock and wraps batch verification or delivery failures through sequencedHalt, serving override.J31.22."

[row.r5-19.7]
interface = "interface.5.go-node-open-block"
verdict = "served"
path = "node/app.go"
line = 3317
symbol = "OpenBlock"
evidence = "The registry recorded only type OpenBlock interface; its current member signature is Snapshot() (sdk.Context, error), providing a read-only point-in-time view under the executor lock. The type remains in node/app.go and is installed by production sequencer startup."

[row.r5-19.8]
interface = "interface.5.go-node-app-set-open-block"
verdict = "served"
path = "node/app.go"
line = 3324
symbol = "SetOpenBlock"
evidence = "Signature unchanged: func (app *App) SetOpenBlock(ob OpenBlock). It assigns app.openBlock; production callers now exist in node/sequencer/node_start.go and node/sequencer/standby_role.go, replacing the registry note that wiring was absent."

[row.r5-19.9]
interface = "interface.5.go-node-app-sequenced"
verdict = "served"
path = "node/app.go"
line = 3489
symbol = "Sequenced"
evidence = "Signature unchanged: func (app *App) Sequenced(ctx sdk.Context, height int64) bool. Its implementation now delegates to SequencerKeeper.Sequenced(ctx, height) and panics on error, using the persisted activation boundary instead of the registry-noted height > done rule."

[row.r5-19.10]
interface = "interface.5.fmt-tx0-sequence-batch-domain"
