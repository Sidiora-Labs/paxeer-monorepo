line = 3498
symbol = "sequenceBatchDomain"
evidence = "Declaration changed from a duplicate private string literal to const sequenceBatchDomain = seqtypes.SequenceBatchDomain. The shared constant is declared in modules/sequencer/types/msgs.go:14; the node encoder and decoder now delegate to the shared sequence-batch codec."

[row.r5-19.11]
