source_1 = "record 22.30.167 [doc.26] (stale): feegrant-events-doc at line 15: The feegrant event tables advertise message.action=set_feegrant/revoke_feegrant/use_feegrant. Keeper code emits those names as event types with granter and grantee attributes, while transaction message.action comes from BaseApp."

[page.3]
path = "sdk/x/gov/spec/01_concepts.md"
status = "stale"
bytes = 10755
source_1 = "record 22.30.167 [doc.28] (stale): gov-lifecycle-doc at line 195: The concepts page describes software switching after proposal-ID precommit signals; the actual software-upgrade handler schedules a named height plan. It also promises a strictly positive initial deposit and a veto exception to expedited conversion, which current handlers do not enforce."

[page.4]
path = "sdk/x/gov/spec/02_state.md"
status = "stale"
