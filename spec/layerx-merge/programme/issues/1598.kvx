[issue.1598]
number = 1598
title = "[Coherence] The ABI-5 switch tasks change Programs receipts to module_version 5, but the Rust proof verifier and the Go lifecycle verifier still accept only 4"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The ABI-5 producer is implemented by commits 4fc7db65734db30d0f63c8bdce6b2a5b86367751 and b408a0bf7297f2ddbefb8a495b131cb254ba822c and asserted at modules/lxphost/programs_registration_test.go:157, but services/agent/crates/layerx-proof/src/receipt.rs:355 dispatches Programs receipts through the four-only check at :69 and preexecution rejection separately requires four at :940, while services/agent/crates/layerx-types/build.rs:293 omits the version-five enumerator at include/layerx/programs.h:109 and :331 requires four to remain the maximum; the Go claim is superseded by sdk/platform/go/verify.go:194 and sdk/platform/go/native_program_lifecycle.go:491, which retire kernel lifecycle verification in favour of sequencer receipts, with deliberate refusal asserted at sdk/platform/go/native_program_lifecycle_test.go:235."
close_comment = "The Rust proof verifier still rejects Programs module-version-5 receipts emitted after the merge upgrade, so a repair must support versions 4 and 5 while preserving protocol, signature and state-root checks. Go lifecycle verification already uses authenticated sequencer receipts, and its retired kernel receipt verifier deliberately refuses that format."

[task.18.1598.1]
title = "Issue #1598: Verify Programs receipts from both hosted module registrations"
status = "pending"
mode = "BUILD"
wave = 1
