do_2 = "Use the generated registration constants in services/agent/crates/layerx-proof/src/receipt.rs:69 so protocol-three Programs call and lifecycle receipts accept exactly module versions four and five, and apply the same policy to the independent preexecution-rejection check at :940; preserve protocol-one historical handling, protocol-two module bounds, guest ABI validation and every canonical encoding, authority, signature, batch and root-chain check."
do_3 = "Add programs_module_versions_header_matches_hosted_registrations to services/agent/crates/layerx-types/src/programs_module_abi.rs and programs_module_versions_verify_signed_receipts to services/agent/crates/layerx-proof/tests/receipt.rs:51, using real canonical encoders and Ed25519 signing to verify protocol-three version-four and version-five call, lifecycle and preexecution-rejection vectors and reject unsupported module versions, tampered signatures and mismatched roots; update the obsolete four-only version-policy assertion at services/agent/crates/layerx-proof/src/receipt.rs:1247 to an exact two-registration matrix that also preserves historical protocol bounds."
symbols = ["programs_module_abi", "programs_module_abi_body", "programs_version_for_protocol", "verify_program_preexecution_rejection", "programs_module_versions_header_matches_hosted_registrations", "programs_module_versions_verify_signed_receipts"]
touches = ["services/agent/crates/layerx-types/build.rs", "services/agent/crates/layerx-types/src/programs_module_abi.rs", "services/agent/crates/layerx-proof/src/receipt.rs", "services/agent/crates/layerx-proof/tests/receipt.rs"]
