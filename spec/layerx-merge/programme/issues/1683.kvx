[issue.1683]
number = 1683
title = "[Coherence] The v5.7.5 addr precompile still calls the context-free GetAddresses, so the new historical address-conversion route is never reached"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "precompiles/addr/legacy/v575/addr.go:173 still calls GetAddresses, which supplies an empty context at utils/helpers/legacy/v575/address.go:18 and therefore fails the tracing guard at utils/helpers/legacy/v575/associate.go:17, leaving the wiring request at utils/helpers/legacy/v575/repair_m784.kvx:7 unresolved even after commit b7f95c2d3a771a9e54803fb4e4a310e12f5aa4b0 added replay tests without changing addr.go."
close_comment = "The v5.7.5 address precompile still discards the tracing context during signature-based address recovery. A follow-up task will forward that context to GetAddressesForContext and add a regression check for the handoff while preserving the existing historical association results."

