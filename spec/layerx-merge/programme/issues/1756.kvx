[issue.1756]
number = 1756
title = "[Coherence] The capability-install evidence digest that agentd now computes still cannot match the digest the Human service checks, so every capability narrowing is refused"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The rung repair in commit 2c7ff104282ab5e1e67afeb2576086a482d8a366 remains at services/agent/crates/layerx-agentd/src/human_runtime.rs:12128, but its capability response at services/agent/crates/layerx-agentd/src/human_runtime.rs:12136 still uses the length-prefixed digest at services/agent/crates/layerx-agentd/src/human_runtime.rs:12263 rather than the concatenated preimage required by services/human/crates/layerx-human-service/src/agents/create.rs:841 and services/human/crates/layerx-human-service/src/agents/create.rs:1810, causing the rejection at services/human/crates/layerx-human-service/src/server/agent_creation.rs:951 despite the stated compatibility at services/agent/crates/layerx-agentd/tests/repair_22_31_562.kvx:29 and the budget-only regressions at services/agent/crates/layerx-agentd/tests/repair_22_31_562.rs:1112 and services/agent/crates/layerx-agentd/tests/repair_22_31_562.rs:1117."
close_comment = "Capability installation still returns an evidence digest with framing that Human rejects, blocking capability narrowing during agent creation. A focused repair must align the response digest with Human and prove that a real capability-install response is accepted."

