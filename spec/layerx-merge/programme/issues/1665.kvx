[req.181665]
title = "Node asset pages conform to the declared cursor schema"
ac_1 = "For the schema at services/platform/hosted/gateway/openrpc.json:1291,1309,1397 adopted at spec/layerx-merge/contracts/evm-rpc.md:3597, node HTTP and WebSocket calls accept an omitted cursor or one canonical positive signed-64-bit decimal cursor, reject invalid arguments with -32602 before upstream access, select at most sixteen assets in producer registration order with one indexer page per call, return next_cursor and order, retain local metadata at the returned committed height and explicit unavailable errors, and traverse first, subsequent, final and empty pages without duplicates or omissions across a node restart."

[acceptance.18.1665.1]
feature = "18"
req = "181665.1"
scenario = "Given more than 32 assets registered by the production indexer in nonlexical order and a node reading committed metadata, when HTTP and WebSocket clients traverse px_listAssets using each returned cursor and continue after a node restart, then every asset appears once in registration order, each response matches OpenRPC with at most sixteen assets and a terminal null cursor, each valid request reads one indexer page, and invalid cursors and unavailable upstreams produce their declared errors."
contract = "contracts/evm-rpc.md#px-node-root-account"
test = "rpc/px_node_root_account_test.go::TestPxNodeRoot_Assets_CursorSchema (planned)"
qualification = "UNRUN"
