[req.181732]
title = "A2A journey verification rejects receipts inconsistent with independent payment and sequence facts"
ac_1 = "The authority consumed at tools/platform/cli/tests/install-journey.sh:453 comes from independently checked batch and transaction evidence rather than the receipt fields currently copied at tools/platform/cli/tests/install-journey.sh:448, and the regression at tools/platform/cli/tests/repair_22_33_1495.rs:1691 accepts matching evidence and rejects mismatched batch, native asset, previous root, resulting root and ledger payment asset while retaining signature and transaction checks."

[acceptance.18.1732.1]
feature = "18"
req = "181732.1"
scenario = "Given a producer-issued A2A payment receipt and independent payment and sequence evidence, when the install journey reconciles and verifies the receipt, then matching evidence succeeds and a different batch, native asset, previous root, resulting root or ledger payment asset is refused."
contract = "contracts/platform-cli.md#cli-cli-commands"
test = "tools/platform/cli/tests/repair_22_33_1495.rs::install_journey_a2a_contract (planned)"
