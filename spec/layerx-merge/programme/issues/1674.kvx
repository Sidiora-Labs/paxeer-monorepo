[req.181674]
title = "Interop HTTP cursors traverse every message exactly once and reject invalid continuation requests"
ac_1 = "The endpoint at services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/api/v2/optimism_controller.ex:523 emits timestamp, init_transaction_hash, init_chain_id and nonce using the encoder at services/explorer/backend/apps/explorer/lib/explorer/chain/optimism/interop_message.ex:344 and decodes continuation requests with its strict decoder at :358, preserving filters and visiting each message exactly once across a page boundary inside one transaction, while cursor-free requests start normally and malformed or incomplete cursors return HTTP 400."

[acceptance.18.1674.1]
