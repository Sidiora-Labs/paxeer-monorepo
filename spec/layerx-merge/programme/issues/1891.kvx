[issue.1891]
number = 1891
title = "[Coherence] The apps/perps workspace lockfile was not refreshed for the new wallet SDK devDependencies, although the repair record says it was"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "sdk/wallet/package.json:61 and sdk/wallet/package.json:63 declare jsdom ^26.1.0 and react-dom ^19.3.1, but the SDK importer at apps/perps/pnpm-lock.yaml:264 omits both from its devDependencies at apps/perps/pnpm-lock.yaml:281 despite membership at apps/perps/pnpm-workspace.yaml:3; tests/ci/test_perps_workspace_lockfile_current.py:96, tests/ci/test_perps_workspace_lockfile_current.py:124 and tests/ci/test_perps_workspace_lockfile_current.py:144 reject that mismatch, while services/wallet/pnpm-lock.yaml:250 and services/wallet/pnpm-lock.yaml:256 contain both and commit 661007bc729b355a7d2eb1d843c691aa23715e3c omits the perps lockfile despite tests/ci/repair_22_39_178.kvx:29 claiming its refresh."
close_comment = "The perps workspace lockfile still omits the wallet SDK's jsdom and react-dom development dependencies, so it does not match the SDK manifest. A follow-up task will refresh that lockfile with the pinned pnpm version and check the frozen install and both existing perps importer checks."

