[req.181680]
title = "Legacy REST body overflow responses identify the limit that rejected the request"
ac_1 = "Given the API's configured MaxBytesHandler at consensus/rpc/jsonrpc/server/http_server.go:246 around a registered legacy bank route using ReadRESTReq at sdk/types/rest/rest.go:150, valid transaction bodies at the smaller of the positive API limit and the 1000000-byte REST cap succeed, bodies one byte over receive HTTP 413 JSON naming that effective limit, and known-length and chunked requests remain bounded with the existing default-cap assertions at sdk/types/rest/repair_m650_test.go:210 and sdk/types/rest/repair_m650_test.go:237 preserved."

[acceptance.18.1680.1]
feature = "18"
req = "181680.1"
scenario = "Given a real Amino bank transaction request and a registered legacy REST route under the production MaxBytesHandler with limits below, equal to and above 1000000 or zero, when known-length and chunked requests reach the effective cap or exceed it by one byte, then the boundary request yields the expected StdTx and the oversized request returns HTTP 413 with the actual rejecting limit, preserving the 1000000-byte local cap."
