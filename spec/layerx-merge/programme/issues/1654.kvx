[req.181654]
title = "The subscription over-delivery assertion rejects any extra matching notification"
ac_1 = "After the expected logs are consumed at tests/integration/rpc_tests/eth/eth_subscribe.spec.ts:261, the guard at lines 262-270 rejects the first additional notification for that subscription within the existing observation interval, passes exactly N deliveries and unrelated-subscription traffic, and propagates transport failures while preserving ordered consuming waitFor semantics at tests/integration/rpc_tests/utils/subscribeUtils.ts:138-152."

[acceptance.18.1654.1]
