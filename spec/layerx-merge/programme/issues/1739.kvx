[issue.1739]
number = 1739
title = "[Coherence] Two of the five refusal cases check nothing in production code; each asserts a value the test set itself one line earlier"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The test introduced by commit 8510976ba57895ae6df45c220ca73d4d9732c1d7 remains unchanged: programs/crates/layerx-programs-ai-market/tests/repair_22_33_233.rs:547 mutates proof bytes but :580 only compares digests, :549 assigns read verification but :588 only asserts that assignment, and :591 compares recorded errors, while programs/crates/layerx-programs-ai-market/tests/repair_22_33_233.kvx:15 claims five refusal checks; the actual membership and read-verification rejection paths are services/platform/hosted/indexer/src/ai_market.rs:452 and :1613."
close_comment = "Confirmed a regression coverage gap: altered membership proofs and insufficient read verification are compared with recorded outcomes without exercising their production refusal paths. The follow-up adds live consumer rejection and restart checks and identifies that coverage in the repair record."

