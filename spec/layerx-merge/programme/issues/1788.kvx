[issue.1788]
number = 1788
title = "[Coherence] Three pages still say px_ methods are not public node methods, which contradicts the namespace this commit documents"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The blanket hosted-only claims remain at docs/wiki/Programs.md:182, docs/site/docs/platform/faucet.md:22 and docs/site/docs/platform/gateway-rpc.md:37 after commit 98bbdd48e370399f65a2f838b8962efe380e74ba, contradicting the HTTP and WebSocket registrations at rpc/server.go:329 and rpc/server.go:598, the balance and capability implementations at rpc/px_account.go:250 and rpc/px_discovery.go:28, the node-root contract at docs/system/rpc.md:224 and the read and hosted-refusal assertions at rpc/px_node_root_account_test.go:238, rpc/px_node_root_account_test.go:261 and rpc/px_node_root_account_test.go:361."
close_comment = "The node serves px balance and capability reads at its root; registration and funding remain hosted operations, with valid node calls returning -32004 and hosted_gateway_service_required. A documentation correction is tracked for the Programs, faucet and gateway RPC pages so their node and gateway guidance agrees."

[task.18.1788.1]
title = "Issue #1788: Align the Programs, faucet and gateway RPC pages with the node px namespace"
