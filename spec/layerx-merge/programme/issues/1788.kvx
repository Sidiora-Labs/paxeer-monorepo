interfaces = []
do_1 = "Replace the blanket hosted-only statements at docs/wiki/Programs.md:182, docs/site/docs/platform/faucet.md:22 and docs/site/docs/platform/gateway-rpc.md:37 with the node-root boundary implemented at rpc/server.go:329 and rpc/server.go:598 and documented at docs/system/rpc.md:224; explain that px_getBalances and px_getCapabilities are node reads, while only px_register and px_requestFunds are hosted operations whose valid node calls return -32004 with hosted_gateway_service_required, as implemented at rpc/px_account.go:43, rpc/px_account.go:317 and rpc/px_account.go:327."
do_2 = "Include these exact sentences on each corrected page: The node serves the `px` namespace at its root and answers from node state. Only `px_register` and `px_requestFunds` are hosted operations. Include the -32004 error and hosted_gateway_service_required data code, qualify the refusal as applying after parameter validation, and retain the gateway-specific schemas, Programs availability checks and private faucet restrictions without implying that shared reads require a gateway."
do_3 = "Use the focused node_gateway_boundary documentation check on all three pages to require both boundary sentences, px_getBalances, px_getCapabilities, -32004 and hosted_gateway_service_required, and reject both obsolete blanket claims even when wrapped across lines; the existing node transport and refusal assertions at rpc/px_node_root_account_test.go:215, rpc/px_node_root_account_test.go:238, rpc/px_node_root_account_test.go:261 and rpc/px_node_root_account_test.go:361 remain the source of truth."
