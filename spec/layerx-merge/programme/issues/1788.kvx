verify_cmd = "for page in docs/wiki/Programs.md docs/site/docs/platform/faucet.md docs/site/docs/platform/gateway-rpc.md; do grep -Fq 'The node serves the `px` namespace at its root and answers from node state.' $page && grep -Fq 'Only `px_register` and `px_requestFunds` are hosted operations.' $page && grep -Fq 'px_getBalances' $page && grep -Fq 'px_getCapabilities' $page && grep -Fq -- '-32004' $page && grep -Fq 'hosted_gateway_service_required' $page && ! grep -Ezq 'not public node[[:space:]]+methods|contracts,[[:space:]]+not additional methods promised on every public node' $page || exit 1; done"
