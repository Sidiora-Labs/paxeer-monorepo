capabilities = []
interfaces = []
do_1 = "Replace the duplicate nonce-helper calls in services/human/crates/layerx-human-service/tests/repair_22_33_63.rs:21 and :26 with distinct regressions: native_approval_clock_units must start a real JourneyEngine, reach AwaitingApproval, reopen the retained journey and drive the production approval decision and resume paths; native_producer_clock_units must obtain signed owner consent through the production producer and call preview_send_v2 before and after reopening the principal store. Follow the behavior exercised by services/human/crates/layerx-human-service/tests/native_journey_approval.rs:651, :665, :839 and :882 and services/human/crates/layerx-human-service/tests/native_send_producer.rs:598, :642 and :790."
do_2 = "Use distinct approval and producer scenarios with seconds passed to session and Journey APIs and milliseconds to consent and purpose expiry comparisons; assert acceptance before the actual signed expiry and refusal at and after it, stable consent and action bindings after reopen, the approval outcome, and the preview canonical bytes and purpose. Exercise production encoders, daemon handlers, transport clients and stores with deterministic public test keys and committed producer-generated recordings where needed; do not fabricate approval facts, substitute the nonce round trip, edit persisted journey state to manufacture approval, or require protected fixtures or a live endpoint. Preserve the existing genuine approval and producer tests and their assertions."
do_3 = "Update only the two clock-unit finding blocks at services/human/crates/layerx-human-service/tests/repair_22_33_63.kvx:27 and :32 to identify the actual proving cases and their distinct approval and V2 preview paths; retain unrelated findings and qualification limitations and claim no qualification that did not run. Run only the two clock_units regressions in the repair_22_33_63 integration target."
symbols = ["native_approval_clock_units", "native_producer_clock_units"]
touches = ["services/human/crates/layerx-human-service/tests/repair_22_33_63.rs", "services/human/crates/layerx-human-service/tests/repair_22_33_63.kvx"]
tests = ["services/human/crates/layerx-human-service/tests/repair_22_33_63.rs::native_approval_clock_units", "services/human/crates/layerx-human-service/tests/repair_22_33_63.rs::native_producer_clock_units"]
