[issue.1747]
number = 1747
title = "[Coherence] native_approval_clock_units and native_producer_clock_units run the same nonce-test helper and never touch the approval or producer paths they claim to prove"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "services/human/crates/layerx-human-service/tests/repair_22_33_63.rs:21 and :26 still call the same nonce helper at services/human/crates/layerx-human-service/tests/native_send_nonces.rs:486, which only validates and reloads consent using the constants at :42 and :44, whereas the claimed source tests exercise JourneyEngine::start_native and approval decisions at services/human/crates/layerx-human-service/tests/native_journey_approval.rs:665 and :882 and preview_send_v2 at services/human/crates/layerx-human-service/tests/native_send_producer.rs:642; services/human/crates/layerx-human-service/tests/repair_22_33_63.kvx:29 and :34 therefore map these regressions to paths they do not execute."
close_comment = "The clock-unit regressions currently exercise session access without reaching native Journey approval or V2 send preview. A follow-up task will give each path its own consent-expiry and reopen regression and align the evidence record with those tests."

[task.18.1747.1]
title = "Issue #1747: Exercise native approval and V2 preview in their clock-unit regressions"
status = "pending"
mode = "BUILD"
wave = 1
requires = []
