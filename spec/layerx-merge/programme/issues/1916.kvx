[issue.1916]
number = 1916
title = "[Coherence] Moving the candidate gate task 17.0.9 to the go-cgo profile drops the forge and Node toolchains that its wave-gate reruns need"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The change in commit 203da869b3c2ca1eeb4b0c5e5436ef568eb405af remains at spec/layerx-merge/spec.kvx:321578 despite the wave reruns required at :321568: scripts/gates/wave-5.sh:5, scripts/gates/wave-6.sh:5 and scripts/gates/wave-programme.sh:5 reach Makefile:2713 and Makefile:2717, which require Forge and the Node suites (Makefile:1747), while spec/layerx-merge/programme/data/sandbox-profiles.kvx:10 provides neither and its mixed union at :55 has no archive prebuild at :57."
close_comment = "The programme candidate gate still requires Forge and Node alongside the kernel-linked Go tooling. The follow-up restores its complete toolchain declaration and preserves the archive prebuilds while keeping every wave-gate check."

