[req.181695]
title = "Indexer status reflects its selected progress mode and authorized durable operations"
ac_1 = "Given the production application registration at services/launchpad/indexer/internal/app/app.go:610, healthy canonical storage and delivery with an explicitly configured positive lag budget produce HTTP 200 and the actual canonical watermark, quarantine or excessive lag produces degraded/503, and unavailable dependencies produce unavailable/503 under the unchanged handler rules at services/launchpad/indexer/internal/httpapi/status.go:63 and :94; compatibility mode is selected explicitly and reads its legacy cursor."
ac_2 = "Given configured durable dead-letter operations, the application supplies the audited policy defined at services/launchpad/indexer/internal/httpapi/deadletter.go:24 so authenticated scoped inspection returns redacted metadata and records authorization decisions, unauthorized requests are refused, missing policy remains unavailable under status.go:135, and drain never bypasses the separate retention approval required by deadletter.go:103."

[acceptance.18.1695.1]
feature = "18"
req = "181695.1"
scenario = "Given a configured indexer application with canonical commits, durable delivery state and authorized operational policy, when its mounted status and dead-letter routes are requested, then healthy canonical status reports the real height and delivery health, unhealthy or unavailable dependencies return 503, authorized inspection is audited and redacted, and unauthorized inspection or unapproved deletion is refused."
contract = "contracts/services.md#launchpad-indexer"
test = "services/launchpad/indexer/internal/app/status_1695_test.go::TestIndexerStatus1695 (planned)"
