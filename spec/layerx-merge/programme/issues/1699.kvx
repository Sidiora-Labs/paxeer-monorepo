path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to an existing module before implementation; a planned path never authorizes a duplicate implementation tree. A task touches only the paths it declares."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[req.181699]
title = "Advanced actions remain retryable after confirmed signature failures and recoverable after uncertain submission"
ac_1 = "Given the signing reservation persisted before send at apps/launchpad/web/src/widgets/meta-ag/action-recovery.ts:134, when a wallet rejection or another confirmed failure before broadcast occurs for order placement or either route action, then the original failure is reported, no economic transaction is broadcast, pendingAction returns null after reopening and a freshly reviewed retry submits exactly one transaction; an uncertain outcome remains fenced until a supplied hash matches the saved intent and passes the transaction and settlement checks at apps/launchpad/web/src/widgets/meta-ag/advanced-provider.ts:320, with recovery never broadcasting another transaction or discarding a known hash."

[acceptance.18.1699.1]
feature = "18"
req = "181699.1"
scenario = "Given an advanced order or route signing attempt, when the wallet rejects or definitively fails before broadcast, then reopening permits a fresh review and one successful retry; when submission is uncertain, then reopening permits recovery only through a validated matching transaction hash and never submits a second economic action."
contract = "contracts/clients.md#launchpad-web-app"
test = "apps/launchpad/web/src/widgets/meta-ag/repair-22-33-987.test.ts::advanced_signature_failure_recovery (planned)"
qualification = "UNRUN"
