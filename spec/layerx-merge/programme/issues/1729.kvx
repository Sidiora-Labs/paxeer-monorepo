[issue.1729]
number = 1729
title = "[Coherence] The lifecycle and registry retired-endpoint proofs are aliases of the receipt proof and never run lifecycle or registry commands"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "tools/platform/cli/tests/repair_22_33_1496.rs:471 and tools/platform/cli/tests/repair_22_33_1496.rs:559 still delegate both command-family proofs to root_receipt at tools/platform/cli/tests/repair_22_33_1496.rs:342, whose authentication and retired-method checks cover receipt and wallet requests rather than lifecycle submission or registry queries, while commit a08a60044bf3f1a66189338037862089c11b31f0 updates lifecycle policy and dropped-reply expectations without replacing these aliases."
close_comment = "The lifecycle and registry endpoint proofs still exercise receipt and wallet requests without testing their own commands. A follow-up task will add separate lifecycle submission and registry query proofs covering root routing, authentication and retired-method refusal."

