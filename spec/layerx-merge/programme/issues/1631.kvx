[issue.1631]
number = 1631
title = "Accepted-genesis test invokes deliberately disabled Giga InitGenesis"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "engine/deps/xbank/types/repair_m1126_test.go:78 still invokes Giga InitGenesis before the accepted-fixture assertions at engine/deps/xbank/types/repair_m1126_test.go:161, but engine/deps/xbank/keeper/genesis.go:13 unconditionally panics as introduced by commit 0b29495c6969f606047ebb88870ab870817d4775; canonical initialization remains supported at sdk/x/bank/keeper/genesis.go:11 and registered at node/app.go:1176, with canonical initialization and Giga refusal independently asserted at engine/deps/xbank/keeper/repair_m1125_test.go:115 and engine/deps/xbank/keeper/repair_m1125_test.go:150."
close_comment = "The accepted-genesis proof still calls the deliberately unsupported Giga initialization entry point and cannot reach its balance and supply assertions. The repair task routes validated fixtures through canonical bank initialization while retaining Giga balance and supply checks and rejection of malformed wei entries without state changes."

