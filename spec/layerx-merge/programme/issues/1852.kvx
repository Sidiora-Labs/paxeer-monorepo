[issue.1852]
number = 1852
title = "[Coherence] The interface registry still says pax_sequencerReceipt is HTTP only, while the updated proof test now requires it over WebSocket too"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit 561806a6529dcbcf892d71a309c73ca4bc3ea5d0 added WebSocket receipt registration, still present at rpc/server.go:587 and rpc/server.go:596 alongside HTTP registration at rpc/server.go:367, and commit ff8d7069053cd89df1af3a73d6444b106a5a0d26 made node/proof_node_go_api_test.go:13, node/proof_node_go_api_test.go:217 and node/proof_node_go_api_test.go:224-244 require both transports for unknown hashes and signed receipt reads, but spec/layerx-merge/interfaces.kvx:313195 and spec/layerx-merge/contracts/evm-rpc.md:2723 still describe pax_sequencerReceipt as HTTP only."
close_comment = "pax_sequencerReceipt supports HTTP and WebSocket, including null responses for unknown hashes and signed receipt reads. A follow-up documentation task corrects the interface registry and EVM RPC contract to describe both transports."

