[issue.1887]
number = 1887
title = "[Coherence] The commit message says it repaired the quarantine read-back, refreshed the lockfiles, settled the release documents and completed the ledger, but the commit only plans that work"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit 246829c4964ad6d5400b13084f9b4b74711f35e6 changes only GOTCHA.kvx, spec/layerx-merge/qualification.kvx and spec/layerx-merge/spec.kvx, recording decisions and pending repairs plus the arbiter verification exclusion; wallet lockfiles, release documents and ledger rows arrive separately in 661007bc729b355a7d2eb1d843c691aa23715e3c, cc3d81fa233eff7273b4b57faf7f6fe0391569fd and cb176160bdd2bf13e1a2837ce271d50d5868d882, while sdk/launchpad/shared/delivery/store.go:663 still compares pools with reflect.DeepEqual and spec/layerx-merge/spec.kvx:216479 and spec/layerx-merge/spec.kvx:216068 keep the quarantine repair and candidate report pending, so the original implementation claim still needs a published correction."
close_comment = "Commit 246829c4964ad6d5400b13084f9b4b74711f35e6 records repair decisions and follow-up tasks and corrects the arbiter verification; its subject overstates the changes it contains. The wallet lockfiles, release documents and consensus ledger changed in later commits, while the quarantine read-back repair and candidate release report remain outstanding at the reviewed revision."

