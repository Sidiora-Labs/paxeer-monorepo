[issue.1671]
number = 1671
title = "PR #1645 selects bincode 3, which cannot build perf-db"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "already-fixed"
evidence = "Main retains bincode 1 at services/platform/perf-db/Cargo.toml:31 and locks 1.3.3 at services/platform/perf-db/Cargo.lock:84, matching the WAL serializer and fixed-integer decoder at services/platform/perf-db/src/storage/wal.rs:171 and :310 and snapshot equivalents at services/platform/perf-db/src/storage/snapshot.rs:275 and :297, with recovery assertions at services/platform/perf-db/tests/recovery.rs:116 and snapshot roundtrip assertions at services/platform/perf-db/src/storage/snapshot.rs:559; the incompatible bincode 3 selection in commit ab5f517099188c17eafd246cdc4e2f9a83c44078 is absent from this revision's ancestry."
close_comment = "Perf-db on main retains bincode 1.3.3 and its existing WAL and snapshot serialization APIs, so the bincode 3 build failure is absent from main. The warning applies to PR #1645 at ab5f517099188c17eafd246cdc4e2f9a83c44078, whose incompatible dependency change is not included in main."
