[issue.1578]
number = 1578
title = "[P2] Isolate inherited live-node tests from the MCP native-read proof"
revision = "53150198caf59defafffab36d79dbc66d921ae57"
verdict = "task"
evidence = "services/agent/crates/layerx-mcp/tests/proof_native_reads.rs:23-25 includes services/agent/crates/layerx-agentd/tests/proof_native_reads.rs:11-13, which includes proof_serve_errors.rs whose proof module (lines 543-900) registers seven tests, five of which call Service::start and read LOCAL_NODE_RPC at :642 and :708 without the disposable node the consumer proof starts."
close_comment = "The MCP native-read proof target no longer inherits the daemon's live-node tests: the shared harness is separated from the tests that need an externally configured node, so the unfiltered target runs with the disposable node the proof starts."

[task.18.1578.1]
title = "Issue #1578: Isolate the inherited live-node tests from the MCP native-read proof"
status = "pending"
