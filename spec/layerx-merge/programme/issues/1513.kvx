[issue.1513]
number = 1513
title = "[P2] Invalidate native archives when their source membership shrinks"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit 84502fe9152dcf794ce55bbef2916dd29ead3803 deletes the DA service source without changing the Makefile or remaining C inputs, and at this revision Makefile:46 derives only current objects, Makefile:185 and Makefile:194 depend only on those objects, Makefile:2617 omits deleted objects' dependency files and Makefile:2416 adds no archive invalidation edge, so shrinking membership can skip the existing remove-and-recreate recipes at Makefile:187 and Makefile:196 despite the compiled retirement assertion in modules/lxphost/retired_da_service_test.go:7 and the actual archive reader in modules/lxphost/archive_symbols_test.go:17, contrary to the retirement guarantee in spec/layerx-merge/spec.kvx:892."
close_comment = "Both native archives can retain a deleted source's member and symbols when the remaining objects are older than the archive. The follow-up task makes source membership an archive input and adds a retained-output deletion regression for production and testing archives while preserving reuse for unchanged inputs."

