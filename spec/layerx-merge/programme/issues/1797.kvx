[issue.1797]
number = 1797
title = "[Coherence] The middleware conformance service and its tests still build HostedGatewayRpc with the retired /rpc path, which the constructor now refuses"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit 6cfc7652ced4aa7499c9d02fcc6a23653a642a47 changed HostedGatewayRpc to root-only routing, retained at services/platform/middleware/seller/src/rpc.ts:61 and services/platform/middleware/seller/src/rpc.ts:91, but services/platform/middleware/conformance/service.mjs:293 still serves /rpc and services/platform/middleware/conformance/service.mjs:357 configures it for the constructor at services/platform/middleware/conformance/service.mjs:403, while services/platform/middleware/conformance/pay6/rpc.test.mjs:43 and services/platform/middleware/conformance/pay6/rpc.test.mjs:50 still expect and construct /rpc and services/platform/middleware/conformance/test/repair-22-33-1480.test.mjs:66, services/platform/middleware/conformance/test/repair-22-33-1480.test.mjs:70 and services/platform/middleware/conformance/test/repair-22-33-1480.test.mjs:119 retain the opposite path contract."
close_comment = "The middleware conformance service and its RPC transcript checks still use the retired /rpc path, preventing merchant identity resolution before checkout. The follow-up task moves their configuration, route handling and assertions to / while preserving authentication, method restrictions and payment replay checks."

