[issue.1711]
number = 1711
title = "Migrate retained middleware conformance fixtures to the verified receipt digest"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "Although commit 908d90b5c529e8464d9a6b5f3cf852a8d03b47eb corrected services/platform/middleware/conformance/pay6/node-fixtures.mjs:15 and :19, services/platform/middleware/conformance/pay6/walkthrough.mjs:17 still expects Keccak of the signed receipt and services/platform/middleware/conformance/service.mjs:529 still constructs it for the agent and budget assertions at :688 and :698, whereas services/platform/middleware/seller/src/rpc.ts:158 returns the authenticated digest from services/agent/sdk/typescript/src/verifier.ts:558 and services/platform/middleware/seller/src/index.ts:1049 rejects a different digest."
close_comment = "The PAY6 fixture now uses the authenticated receipt digest, but the walkthrough assertion and service agent fixture still use the earlier signed-receipt hash. The remaining correction is tracked as task 18.1711.1, including settlement, budget recovery and incorrect-digest rejection checks."

