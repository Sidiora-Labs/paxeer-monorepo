[issue.1717]
number = 1717
title = "Search results render two desktop headers after shell migration"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The shell migration in commit 6affbc654e0ec0d794b9c85b56ae5b69de33abcf remains in apps/explorer/pages/search-results.tsx:12 and :28, which wrap either results page in LayoutSearchResults whose apps/explorer/ui/shared/layout/LayoutSearchResults.tsx:12 mounts the full HeaderDesktop through apps/explorer/ui/shared/layout/components/NavBar.tsx:5 and apps/explorer/ui/snippets/header/HeaderDesktop.tsx:19, while apps/explorer/ui/pages/SearchResults.tsx:297 and apps/explorer/ui/multichain/searchResults/SearchResults.tsx:152 each mount another results-bound HeaderDesktop, contrary to spec/layerx-merge/programme/docs/explorer-ui/design-brief.md:84, and apps/explorer/ui/snippets/header/repair-22-35-2.spec.tsx:128 tests only a generic child."
close_comment = "Confirmed: ordinary and multichain search results show duplicate desktop navigation bars. The correction will keep one header with results-bound search controls in both modes and preserve mobile search and navigation."

