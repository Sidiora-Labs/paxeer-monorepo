[issue.1692]
number = 1692
title = "[Coherence] The new generated-output allowlist misses the dist output of nine of the eleven launchpad SDK packages, so routine SDK builds now enter provenance and fail ownership checks"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "Commit e7cdf8d59e311401abd24579c93092a4b0f48da1 introduced the still-current root-relative exclusions at tools/launchpad/production/bootstrap/snapshot/snapshot.py:12 and :28, which omit ten package dist directories despite sdk/launchpad/packages/sdk/tsconfig.json:1, sdk/launchpad/packages/sdk-v2/package.json:26 and sdk/launchpad/packages/production-contracts-v2/package.json:26 declaring dist outputs, and omit nested web build/dist/logs directories ignored at apps/launchpad/web/.gitignore:2, :11 and :13; these outputs enter inventory at snapshot.py:54 and trigger source drift at :165 or ownership refusal at :125, while tools/launchpad/production/bootstrap/snapshot/test_repair_22_33_941.py:21 covers only the two listed SDK output paths."
close_comment = "Generated output from ten launchpad SDK packages and nested web build directories still enters source provenance and can fail drift and ownership checks. A focused repair is required to exclude those outputs while retaining bootstrap build sources, protocol coverage sources and the existing security checks."

