[req.181652]
title = "Multichain export failures preserve valid retry work without crashing queue workers"
ac_1 = "Given persisted main and balance export work dispatched by the real BufferedTask supervisor, when the upstream returns HTTP 503 or malformed HTTP 200, then the worker consumes scheduler-compatible retry results, survives with the same PID, retains failed durable work and exports it successfully after recovery, draining the corresponding rows while preserving partial-success behavior and every existing request and persistence assertion; the callback contract is services/explorer/backend/apps/indexer/lib/indexer/buffered_task.ex:122 and the row preparation contracts are services/explorer/backend/apps/indexer/lib/indexer/fetcher/multichain_search_db/main_export_queue.ex:196 and services/explorer/backend/apps/indexer/lib/indexer/fetcher/multichain_search_db/balances_export_queue.ex:167."

[acceptance.18.1652.1]
feature = "18"
req = "181652.1"
scenario = "Given persisted main and balance export rows and running queue supervisors with nonzero concurrency, when HTTP 503 and malformed HTTP 200 responses are consumed and the upstream later succeeds, then each original worker survives, retries valid entries, preserves failed work and drains its durable queue after successful replay without changing partial-success behavior."
contract = "contracts/explorer-indexer.md#paxeer-x-ingestion"
test = "services/explorer/backend/apps/indexer/test/indexer/fetcher/multichain_search_db/main_export_queue_test.exs::running main export retries HTTP 503 without worker restart; services/explorer/backend/apps/indexer/test/indexer/fetcher/multichain_search_db/main_export_queue_test.exs::running main export retries malformed HTTP 200 without worker restart; services/explorer/backend/apps/indexer/test/indexer/fetcher/multichain_search_db/balances_export_queue_test.exs::running balances export retries HTTP 503 without worker restart; services/explorer/backend/apps/indexer/test/indexer/fetcher/multichain_search_db/balances_export_queue_test.exs::running balances export retries malformed HTTP 200 without worker restart (planned)"
qualification = "UNRUN"
