[req.181702]
title = "Healthy large and throttled segment transfers survive sustained progress"
ac_1 = "Given the legacy push and sync transfer path at storage/db_engine/litt/cli/push.go:119 and :309 and storage/db_engine/litt/cli/sync.go:219, a file that keeps making progress must complete with identical receiver bytes and durable acknowledgement even when its total duration exceeds the configured inactivity interval; a stalled transfer, explicit caller deadline, cancellation, Close or failed acknowledgement must terminate without success or source reclamation, preserving the guarantees exercised in storage/db_engine/litt/util/ssh_test.go:63 and :118."

[acceptance.18.1702.1]
feature = "18"
req = "181702.1"
scenario = "Given a real authenticated SSH receiver and a throttled segment transfer whose duration exceeds the configured inactivity interval, when legacy Rsync or RsyncContext transfers the file with sustained progress, then the receiver bytes match and durable acknowledgement precedes success, while stalled progress, caller deadlines, cancellation, Close and acknowledgement failures remain bounded failures with the source retained."
contract = "contracts/sequencer.md#storage"
test = "storage/db_engine/litt/util/ssh_test.go::TestSSHSession_TransferProgressTimeout (planned)"
