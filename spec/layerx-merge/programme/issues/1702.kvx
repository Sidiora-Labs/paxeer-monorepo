[issue.1702]
number = 1702
title = "[Coherence] Legacy Rsync now kills any segment transfer that takes longer than five minutes, and the push path has no way to raise that limit"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The deadline introduced by commit f9696ba0518ad4dc69d79cebfeff5eac72a5ad18 remains unchanged: storage/db_engine/litt/util/ssh.go:39 defaults Transfer to five minutes, :63 exposes no legacy constructor options, :216 creates a whole-operation deadline, :275 delegates legacy Rsync to RsyncContext, :279 applies that deadline through the durable acknowledgement at :298, and :346 kills the process group on expiry; storage/db_engine/litt/cli/push.go:108 divides the throttle among workers, :119 selects the default constructor and :309 calls Rsync, storage/db_engine/litt/cli/sync.go:219 reuses push, and storage/db_engine/litt/littdb_config.go:139 defaults segment size to math.MaxUint32, so transfers needing over five minutes fail even while progressing, whereas storage/db_engine/litt/util/ssh_test.go:70 and :80 only exercise a small throttled file."
close_comment = "Push and sync can fail on healthy large or throttled segment transfers because the five-minute limit covers the entire transfer and its durability acknowledgement. A follow-up repair will bound stalled transfers by progress while preserving cancellation, destination verification and durable acknowledgement before success."

[task.18.1702.1]
title = "Issue #1702: Bound segment transfers by progress instead of total elapsed time"
status = "pending"
mode = "BUILD"
wave = 1
requires = []
