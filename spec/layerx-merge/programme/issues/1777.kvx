[issue.1777]
number = 1777
title = "[Coherence] The inference profile reads market availability from the node endpoint, but only the hosted gateway serves that route"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The wiring introduced by commit a53cf5f3d530e257b2aa20e41d035107216ec8e8 remains unchanged: services/agent/crates/layerx-agentd/src/main.rs:1895 passes the node endpoint and bearer to the snapshot GET at services/agent/crates/layerx-agentd/src/inference_market/mod.rs:63 for boot at main.rs:1925 and supervision at main.rs:2061, whereas services/platform/hosted/gateway/src/main.rs:1915 mounts that route and services/platform/hosted/gateway/src/ai_views.rs:134 authenticates a gateway key before reading the indexer projection, with no corresponding route in node/, rpc/ or api/."
close_comment = "Inference availability still queries the node with the node credential, although market snapshots are served by the authenticated gateway. Startup and supervision need separate gateway endpoint, API key and certificate trust settings while chain RPC and program reads retain the node settings."

