[issue.1845]
number = 1845
title = "[Coherence] Task 22.39.151 guards the wrong step: the registry variables are read by the middleware step, and the plan explicitly leaves that step without a condition or the variables"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The change in commit a14bfc1c75708d0f9fc5328c995115ca9e9bd63c remains at .github/workflows/platform.yml:92, scoping both registry variables to artifact construction through services/platform/Makefile.inc:329, while the unguarded middleware step at .github/workflows/platform.yml:105 reaches services/platform/Makefile.inc:363 and the verification prerequisite at tools/paxeer-x/gates/104.16.5.sh:241 without either variable, and tests/ci/test_workflow_live_inputs_guarded.py:136 checks the guards without checking this invocation path."
close_comment = "Middleware still invokes published-package verification without its required registry configuration because the variables belong only to the benchmark build step. The repair will separate registry verification into its own guarded step so middleware runs without registry configuration and configured verification produces the retained line counts."

