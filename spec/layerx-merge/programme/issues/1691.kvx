[issue.1691]
number = 1691
title = "[Coherence] Two tests in this commit assert opposite FeesRouter log origins for direct precompile calls"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "At this revision precompiles/launchpad/events.go:42 selects calledAt for FeesRouter business events and sdk/launchpad/protocol/bindings/repair_m948_test.go:704 requires both emitter addresses, whereas precompiles/launchpad/fees.go:99 fixes the production role address and precompiles/launchpad/fees.go:325 emits there, matching the surface-only assertion at sdk/launchpad/protocol/bindings/repair_m948_test.go:471 and contradicting the direct-call FeesClaimed address in sdk/launchpad/protocol/bindings/testdata/repair_m948/native-execution.json:606."
close_comment = "Confirmed: FeesRouter role logs use the FeesRouter surface for both direct precompile and surface calls, but the emitter helper and transcript require a different origin for direct calls. A follow-up task will align the helper and both tests with the production origin rule and retain explicit coverage of both entry points."

