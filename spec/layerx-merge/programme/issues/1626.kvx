[issue.1626]
number = 1626
title = "Staking redelegation query erases sparse-page continuation after scan cap"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "sdk/x/staking/keeper/grpc_query.go:400 routes destination-only queries to queryAllRedelegations, which records only observed matches at sdk/x/staking/keeper/grpc_query.go:567 and unconditionally replaces the keyless continuation at sdk/x/staking/keeper/grpc_query.go:578, discarding the unprocessed raw key returned before the callback by sdk/types/query/filtered_pagination.go:113 when the post-page scan exceeds MaxScanLimit, while the existing eight-record coverage at sdk/x/staking/keeper/grpc_query_test.go:868 never reaches that boundary."
close_comment = "Destination-filtered redelegation queries can still hide later matches by clearing the continuation when the scan cap is reached. A focused fix must preserve the paginator continuation and prove that following it returns every matching redelegation exactly once."

