[issue.1893]
number = 1893
title = "[Coherence] The ledger is declared complete while it leaves out the commits that change the upgrade plan handlers in node/upgrades.go"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "tools/ci/consensus_commit_gate.py:11 omits node/upgrades.go and its filter at tools/ci/consensus_commit_gate.py:77 therefore excludes upgrade-handler-only changes; ten of the seventeen commits touching that file in 68c8887a..8c5a7acd are absent from docs/release/consensus-commits.md:32, including 74b284ed2b0901e49e0a1a7f0b860a552ebb48c0 and 1db0093cc683d93618cbeb19420276d8f43948cf whose changes remain at node/upgrades.go:222 and node/upgrades.go:506, while docs/release/7.0.0-readiness-checklist.md:24 is checked despite the completeness requirement at spec/layerx-merge/spec.kvx:11222 and tools/ci/tests/test_consensus_commit_gate.py:204 derives coverage from the same incomplete filter."
close_comment = "The 7.0.0 consensus ledger still omits changes to the upgrade plan handlers, including the anchor deletion ordering guard and merge plan information changes. The repair must include node/upgrades.go in consensus discovery, regenerate the affected ledger rows and add regression coverage for handler-only commits."

