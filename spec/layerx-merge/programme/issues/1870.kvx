evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[req.181870]
title = "Commit release tests prove caller cancellation after release begins"
ac_1 = "For each of COMMITTED and OPEN at node/sequencer/driver.go:103,147, a regression test enters OnCommitContext with a live context, observes the selected real release before cancelling or expiring the context while its acknowledgement is pending, asserts the caller's error and persistent ErrDriverHalted state from node/sequencer/driver.go:71-73,97-101, and detects replacing the caller context with context.Background() in either release path."

[acceptance.18.1870.1]
feature = "18"
req = "181870.1"
scenario = "Given a live caller context and a real driver, WAL and standby, when cancellation or deadline expiry occurs during COMMITTED or OPEN release before its acknowledgement completes, then the commit returns the caller's context error before the replication timeout, the driver stays halted without further WAL writes, and a failed COMMITTED release never releases OPEN."
contract = "contracts/sequencer.md#sequencer-wal"
test = "node/sequencer/driver_test.go::TestDriverCommitContextCancellationDuringRelease (planned)"
qualification = "UNRUN"
