do_2 = "Document ProtocolSnapshotRecord.tvlUsd at apps/perps/src/types/perps.ts:119 as the raw six-decimal USDL custody inflow-minus-outflow sum from services/platform/perps-data/internal/store/projections.go:858, passed unchanged by services/platform/perps-data/internal/graphql/perps.go:1727, and correct the 18-decimal source statement at apps/perps/src/widgets/analytics/repair-22-33-192.kvx:7; preserve the producer, stored snapshots, GraphQL wire value and unrelated WAD fields."
do_3 = "Update snapshot at apps/perps/tests/repair-22-33-192.test.ts:97 to encode six-decimal amounts and add a named protocolSnapshotsSixDecimalTvl test using the existing GraphQL client-to-component path at apps/perps/tests/repair-22-33-192.test.ts:200 with the producer regression's 5000000 inflow minus 1500000 outflow and raw tvlUsd 3500000 from services/platform/perps-data/internal/store/projections_test.go:526, :528 and :556; assert the card displays $3.50 and the chart plots 3.5 for desktop and mobile from that same GraphQL result."
do_4 = "Keep the aggregate-custody assertions in f008AggregateTvlIncludesCollateralAbsentFromRecentEvents at apps/perps/tests/repair-22-33-192.test.ts:227 and the empty, missing, mistimed, zero-baseline and malformed-history assertions in f008MissingDailyHistoryNeverInventsAPercentage at apps/perps/tests/repair-22-33-192.test.ts:264; add a six-decimal fractional daily baseline and assert the correct percentage while retaining the exact 24-hour endpoint requirement at apps/perps/src/widgets/analytics/AnalyticsLiquidStat.tsx:100."
