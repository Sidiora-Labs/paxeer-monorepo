[issue.1656]
number = 1656
title = "[P2] Align protocol TVL card with six-decimal snapshot amounts"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "USDL has six decimals at modules/perps/types/market.go:12 and apps/perps/src/core/perps/config.ts:35, its raw transfer value survives decoding and storage at services/platform/perps-data/internal/decode/usdl.go:24 and services/platform/perps-data/internal/store/facts.go:192, the custody sum at services/platform/perps-data/internal/store/projections.go:858 reaches GraphQL unchanged at services/platform/perps-data/internal/graphql/perps.go:1727 and is asserted as 3500000 at services/platform/perps-data/internal/store/projections_test.go:556, but the mounted card at apps/perps/src/page-modules/analytics/index.tsx:87 divides by 1e18 at apps/perps/src/widgets/analytics/AnalyticsLiquidStat.tsx:54, as does the chart at apps/perps/src/widgets/analytics/ProtocolTvlChart.tsx:31, while apps/perps/tests/repair-22-33-192.test.ts:103 and apps/perps/src/widgets/analytics/repair-22-33-192.kvx:7 perpetuate the incorrect 18-decimal assumption introduced by commit 20a040577ed00d9cbb331e06d8212543bb679837 and left present after commit 1afd957303a399499f63282e15ecc79148b57863 marked task 22.33.192 done."
close_comment = "The protocol TVL card and chart still interpret six-decimal USDL snapshots as 18-decimal amounts, understating TVL by a factor of one trillion. A focused repair is specified to align both displays and their regression coverage with raw custody snapshots while preserving aggregate balances and unavailable daily-change labels."

