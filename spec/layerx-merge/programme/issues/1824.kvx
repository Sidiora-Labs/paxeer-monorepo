[issue.1824]
number = 1824
title = "[P3] Emit the declared license in both Python wheel metadata generators"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit 51fdcd5919fc922ce1ea7080a310a0d1f7a29289 changed the declarations now at sdk/integrations/fastapi/pyproject.toml:11 and services/agent/sdk/python/pyproject.toml:11 to Apache-2.0, but sdk/integrations/fastapi/build_backend.py:21 and :27 and services/agent/sdk/python/build_backend.py:19 and :24 still emit metadata 2.3 with the generic License text, which their _source_files functions place in wheel METADATA at sdk/integrations/fastapi/build_backend.py:50 and services/agent/sdk/python/build_backend.py:49, while tests/ci/test_manifest_license_fields.py:145 and :215 check manifests and tests/agent/sdk/python/test_integration.py:462 checks reproducibility without asserting the wheel license."
close_comment = "The Python SDK and FastAPI wheels still publish generic license text instead of the Apache-2.0 declaration in their project metadata. A focused repair will derive each wheel's license expression from its manifest, use compatible core metadata, and check the built wheels while preserving reproducibility and existing dependencies."

