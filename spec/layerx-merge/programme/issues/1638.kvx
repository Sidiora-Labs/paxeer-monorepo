[issue.1638]
number = 1638
title = "Preserve completed registry job results across cleanup reload"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "tools/bringup/registry-artifacts.py:357 appends the completed result without persisting it, tools/bringup/registry_lifecycle.go:100 and :292 reload and persist the older state during cleanup, and tools/bringup/registry-artifacts.py:364 and :372 replace and write that state before inspect reads it at :253, so completed job history is lost."
close_comment = "Completed registry job results can be lost when cleanup reloads lifecycle state. Persist each completed result before cleanup so later inspection retains its exit code, output, command and observations alongside reconciled cleanup metadata."

