[req.181628]
title = "Installed pending transaction filters retain virtual-chain transaction membership"
ac_1 = "Given the installed-filter contract at spec/layerx-merge/contracts/virtual-chains.md:107 and the global pending receipt stream at rpc/filter.go:324, HTTP and WebSocket pending hash filters installed at root return all receipted hashes in order, while filters installed on a chain return only that chain's hashes; successful polling consumes each batch once, membership agrees with scoped transaction lookups, and scope persists across WebSocket reconnect and transaction commit."
ac_2 = "Pending filters follow the stored-scope ownership behavior at rpc/filter.go:959: a different chain cannot poll the filter or consume its changes, and root access to a chain-installed filter remains restricted to its installation chain; explicit unsupported and full-transaction refusals at rpc/filter.go:893, overflow at rpc/filter.go:455, expiry cancellation at rpc/filter.go:747 and unsubscribe cleanup at rpc/filter.go:910 remain intact."

[acceptance.18.1628.1]
feature = "18"
req = "181628.1"
scenario = "Given root, chain-1 and chain-2 HTTP and WebSocket pending filters installed before real mixed-domain execution, when clients poll before and after reconnect and commit, then root receives every hash in receipt order, each chain receives only its hashes once, cross-chain polling is refused without consuming changes, root polling of a chain filter preserves its scope, and repeated successful polls return empty arrays."
contract = "contracts/virtual-chains.md#rpc"
test = "rpc/repair_339_test.go::TestRepair_339_TenantPendingRaw (planned)"
qualification = "UNRUN"
