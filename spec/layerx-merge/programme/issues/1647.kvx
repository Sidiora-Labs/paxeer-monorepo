[req.181647]
title = "Cancellable subscription establishment retains handshake progress until cancellation or its total deadline"
ac_1 = "Given the 50 ms cancellation polling adapter at services/agent/crates/layerx-client/src/subscription.rs:111 and the handshake at services/agent/crates/layerx-client/src/subscription.rs:225, an unset cancellation flag permits a real handshake delayed at least 150 ms to establish newHeads and deliver a notification within a 2-second budget without duplicate requests; cancellation during establishment and a 300 ms absolute deadline each return Unavailable within one second, expiry does not return before 250 ms, and the existing total-deadline and cancellation assertions at services/agent/crates/layerx-client/tests/repair_22_33_1541.rs:500 remain intact and pass."

[acceptance.18.1647.1]
feature = "18"
req = "181647.1"
scenario = "Given a newHeads subscription with an unset cancellation flag and a 2-second total budget, when a real peer delays its WebSocket handshake beyond multiple 50 ms polls, then subscription establishment, notification delivery and unsubscribe succeed without restarting the handshake, while actual establishment cancellation and deadline expiry remain bounded and existing subscription deadline tests pass."
contract = "contracts/clients.md#a-operations"
test = "services/agent/crates/layerx-client/tests/repair_22_33_1541.rs::subscription_handshake_survives_cancellation_polls; services/agent/crates/layerx-client/tests/repair_22_33_1541.rs::subscription_handshake_can_be_cancelled; services/agent/crates/layerx-client/tests/repair_22_33_1541.rs::subscription_handshake_honors_absolute_deadline (planned)"
qualification = "UNRUN"
