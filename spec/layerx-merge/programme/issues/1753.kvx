[issue.1753]
number = 1753
title = "[Coherence] evidence_inventory now refuses every version-1 evidence record, so the legacy with_evidence branch can never be filled and tenants with old evidence fail recovery outright"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The public-key pre-check introduced by dbd4e68ed94769c51ad1368826824595ec17b6f3 remains at services/agent/crates/layerx-agentd/src/receipt.rs:531 and accepts only version 2 at receipt.rs:941, rejecting the version-1 records written by persist_evidence at receipt.rs:436 and receipt.rs:817 before serve_kernel_evidence can accept them at receipt.rs:486 and populate with_evidence at receipt.rs:579, contrary to spec/layerx-merge/spec.kvx:190031 and the reopened-store assertions at services/agent/crates/layerx-agentd/tests/repair_22_31_559.rs:520 and services/agent/crates/layerx-agentd/tests/budget_schema.rs:138, with failures propagated by services/agent/crates/layerx-agentd/src/managed_agent.rs:1338 and services/agent/crates/layerx-agentd/src/human_runtime.rs:14795."
close_comment = "Version-1 public receipt evidence is incorrectly rejected during inventory, preventing recovery of tenants with retained evidence. The repair will restore mixed-format recovery while preserving refusals for unsupported versions, corrupt evidence and legacy archive records."

