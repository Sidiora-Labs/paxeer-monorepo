[issue.1794]
number = 1794
title = "[Coherence] The inference market guides call the daemon profile and the 0x0907 peer binding unavailable, but both have already landed at this revision"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "docs/agent/inference-market/README.md:11, docs/agent/inference-market/operator.md:17, docs/agent/inference-market/threats.md:5 and docs/agent/COMPATIBILITY.md:43 still describe the daemon profile or peer binding as planned despite the parser at services/agent/crates/layerx-agentd/src/human_owner_mode.rs:15, configuration at services/agent/crates/layerx-agentd/src/config.rs:79 and binding methods at precompiles/layerxagent/teeattestor/teeattestor.go:273 and precompiles/layerxagent/teeattestor/teeattestor.go:307, introduced by ancestor commits a53cf5f3d530e257b2aa20e41d035107216ec8e8 and 6e64aa6ffb45918b2936a2c2c92b248687a88287 and covered by services/agent/crates/layerx-agentd/tests/inference_profile_boot.rs:90 and precompiles/layerxagent/teeattestor/peer_binding_test.go:43; commit b101bde32d44626d933c4cf2073fb0b1ee0f225f removed the README base revision without correcting its availability claim."
close_comment = "The inference-market mode, its configuration and the 0x0907 peer-binding methods are implemented, while the guides still describe them as planned or unavailable. The documentation needs to reflect these implemented surfaces while retaining the development-attestation limits and the requirement to check F11 availability on the target network."

