[issue.1672]
number = 1672
title = "[Coherence] The new ABI v5 branch in the linter's engine check is a no-op, and it edits a source path outside the task's declared scope"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "spec-edit"
evidence = "The explicit dispatch at programs/sdk/rust/lint/src/lib.rs:778 is behavior-preserving because programs/crates/layerx-programs-runtime/src/engine.rs:161 and programs/crates/layerx-programs-runtime/src/engine.rs:175 converge through programs/crates/layerx-programs-runtime/src/abi_policy.rs:25 and programs/crates/layerx-programs-runtime/src/validate.rs:521 on V5 with WASMI_0_31_2; commit 75bc96125ad9b0fc29f64f91aaf2c69467f575dc already supplied shared admission, v5 import wiring and versioned validation, while commit 6a6db948277ace7b306ed3a4d008bdad914d5850 added the coverage at programs/sdk/rust/lint/tests/abi_versions.rs:172 and programs/sdk/rust/lint/tests/repair_22_33_248.rs:11, so the done task's text at spec/layerx-merge/spec.kvx:198066 and its repair description at programs/sdk/rust/lint/tests/repair_22_33_248.kvx:7 must describe regression coverage of existing v5 support and an equivalent dispatch rather than a new engine capability, with the alleged scope omission already contradicted by spec/layerx-merge/spec.kvx:198050 listing both lint/tests and lint/src."
close_comment = "ABI v5 already reaches the same runtime validator and fuel schedule through both dispatch paths, and the declared scope includes the linter source. The completed task description and repair record should credit regression coverage of existing v5 support and describe the explicit dispatch as behavior-preserving."
