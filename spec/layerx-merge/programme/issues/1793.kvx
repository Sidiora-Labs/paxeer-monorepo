[issue.1793]
number = 1793
title = "[Coherence] tools/release/tests/workflows.test.sh still expects v6.12.0 and the old V6120Upgrade grep, so the release test suite fails"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit 84e41c7e32f7707dac1f3ce246de4e381cabe6fb changed the release identity, now v7.0.0 / v7.0 at tools/release/version.json:2, and the declaring-line pipeline at .github/workflows/paxeer-release-check.yml:66, but tools/release/tests/workflows.test.sh:212 still requires v6.12.0, :214 tests the old publish tag, :278 cannot match the multiline pipeline, and :280 still requires v6.12.0 with the obsolete V6120Upgrade command at :284, while tools/release/tests/run-all.sh:22 retains the script."
close_comment = "The release workflow regression checks still enforce the former v6.12.0 identity instead of v7.0.0 and the v7.0 upgrade plan. Task 18.1793.1 tracks updating the publish-tag and upgrade-declaration checks while preserving their rejection cases."

