[issue.1660]
number = 1660
title = "Receipt-key tests still expect forwarding after node-local authority change"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The local keeper discovery and governed read introduced by commit 561806a6529dcbcf892d71a309c73ca4bc3ea5d0 remain at rpc/sequencer_receipt.go:267 and rpc/sequencer_receipt.go:338, but the fixture pins committed at rpc/sequencer_receipt_test.go:130 still lead to obsolete refusal assertions at rpc/sequencer_receipt_test.go:430 and rpc/sequencer_receipt_test.go:448, and the explicitly empty local list at rpc/sequencer_receipt_test.go:688 is still asserted equal to the proposer's nonempty response at rpc/sequencer_receipt_test.go:719, contradicting the local authority contract at spec/layerx-merge/contracts/evm-rpc.md:3715."
close_comment = "The receipt-key tests still expect sequencer forwarding even though each node reads its own governed pins. Task 18.1660.1 updates the tests to distinguish valid, explicitly empty and missing local authority while preserving SDK interoperability and error propagation."

