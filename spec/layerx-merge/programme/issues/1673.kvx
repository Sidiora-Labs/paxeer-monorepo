[issue.1673]
number = 1673
title = "[Coherence] Signed ID-token verification breaks the existing confirm-OTP controller test, which still feeds an unsigned HS256 token and mocks no key-set request"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "Commit d45bbbfcacac1bf668cd502591423c3b2ada0196 introduced RS256, kid, JWKS and claim validation still present at services/explorer/backend/apps/explorer/lib/explorer/third_party_integrations/auth0/internal.ex:260 and internal.ex:291, but services/explorer/backend/apps/block_scout_web/test/block_scout_web/controllers/account/api/v2/authenticate_controller_test.exs:299 still supplies only sub/email, authenticate_controller_test.exs:663 constructs HS256 with a junk signature, and authenticate_controller_test.exs:319 expects three calls without JWKS before asserting HTTP 200 at authenticate_controller_test.exs:373."
close_comment = "The confirm-OTP success test still supplies a token rejected by signed Auth0 ID-token verification and omits the signing-key request. Update its token and key-set response so the existing HTTP 200 and user-details assertions continue to protect OTP confirmation from request-body regressions."

[task.18.1673.1]
