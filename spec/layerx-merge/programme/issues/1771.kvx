[issue.1771]
number = 1771
title = "[Coherence] Explorer docs relocation leaves the image builder reading the deleted environment catalogue"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commits 68bc33ddbdfd44bbc0031aba83991d218933da72 and c3434a1ae48f33ea5c452993b87d080d0fc5bf87 repaired the catalogue copy and build-context allowlist (docker/explorer-frontend/Dockerfile:89 and docker/explorer-frontend/Dockerfile.dockerignore:3), but .github/workflows/explorer-images.yml:7 and .github/workflows/explorer-images.yml:16 still omit catalogue-only changes, while apps/explorer/deploy/scripts/collect_envs.sh:10 checks existence alone and its pipeline at apps/explorer/deploy/scripts/collect_envs.sh:28 can mask an unreadable-input error."
close_comment = "The frontend image now includes the relocated environment catalogue and rejects missing input. Catalogue-only changes still need to trigger image regeneration, and unreadable catalogue input must stop collection before environment files are written."

