[req.181720]
title = "Home transaction history respects its stated calendar-day window"
ac_1 = "Given dated daily samples for January 1-30 with January 29 missing, the 14-day home history labelled at apps/explorer/ui/home/Stats.tsx:27 displays only January 17-28 and January 30, with no January 16 sample admitted by the observation-count slicing at apps/explorer/ui/home/indicators/ChainIndicatorsChart.tsx:30."
ac_2 = "The preparation path at apps/explorer/ui/home/indicators/utils/chart.ts:34 bounds dates before excluding missing values, uses the latest raw UTC calendar date even when its value is null, preserves real zeroes, never fills missing dates with zeroes, and leaves callers without a requested window unbounded."
ac_3 = "The regression extending apps/explorer/ui/home/repair-22-35-4.spec.tsx:179 asserts dates and values through the home chart data path for sparse and unsorted history, leading and trailing nulls, empty and all-null responses, inclusive date bounds, UTC boundaries, month and year rollover, and leap day."

