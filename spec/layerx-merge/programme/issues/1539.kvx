[issue.1539]
number = 1539
title = "[Coherence] eth_sendRawTransaction over WebSocket on the sequencer still re-accepts an identical resubmission and refuses it with the sequence error"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit 2afc320138ea731339cb14f5d626413d421650b7 installs the recorded-hash source only on HTTP (rpc/server.go:235), while WebSocket rejects SequencerReceiptOption (rpc/server.go:425-441), builds a source-less send config (rpc/server.go:444) and registers it (rpc/server.go:553), and node/app.go:3652-3664 supplies the receipt option only to HTTP, so rpc/send.go:200-210 calls Accept again through rpc/send.go:320 despite decision 2346 and req.22038 (spec/layerx-merge/spec.kvx:7190 and spec/layerx-merge/spec.kvx:21611); the existing identical-resubmission regression uses HTTP only (rpc/send_sequencer_test.go:309-312)."
close_comment = "Identical raw transaction resubmissions still fail on the sequencer WebSocket endpoint because its send API cannot look up recorded hashes. The follow-up task shares the receipt source with WebSocket and verifies unchanged receipts and state on replay while preserving refusal of a different transaction reusing the nonce."

