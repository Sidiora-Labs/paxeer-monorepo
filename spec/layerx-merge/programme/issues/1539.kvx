[req.181539]
title = "Identical sequencer transaction resubmissions return the recorded hash on HTTP and WebSocket"
ac_1 = "Given a transaction accepted by the real sequencer through the node's HTTP or WebSocket server (node/sequencer_rpc_option_test.go:195-210), resubmitting its identical raw bytes through either transport returns its recorded hash without another Accept or a change to its receipt, pending nonce or balances; a different signed transaction reusing its nonce still receives the wrong-sequence refusal, as required by spec/layerx-merge/spec.kvx:21611 and implemented for HTTP in rpc/send_sequencer_test.go:338-364."

[acceptance.18.1539.1]
feature = "18"
req = "181539.1"
scenario = "Given the node's HTTP and WebSocket servers sharing a real sequencer and receipt source, when accepted raw bytes are resubmitted over either transport, then each response carries the recorded hash with unchanged receipt and pending state and no new acceptance, while a different transaction reusing the nonce is refused with the sequence reason."
contract = "contracts/evm-rpc.md#eth-sendrawtransaction"
test = "node/sequencer_rpc_option_test.go::TestEVMServerServesSequencerReceiptOption (planned)"
qualification = "UNRUN"
