[issue.1627]
number = 1627
title = "Layerxpay genesis export drops canonical escrow receipt history"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "modules/layerxpay/keeper/escrow_receipt.go:45 defines the canonical receipt namespace written at :66 and read at :73, but modules/layerxpay/keeper/genesis.go:55 and :188 export only kernel family prefixes, modules/layerxpay/types/params.go:21 has no receipt collection, and modules/lxphost/genesis.go:123 excludes the receipt namespace, so neither supported pay genesis round trip can restore these receipts."
close_comment = "Canonical escrow receipt history is omitted from both supported genesis recovery paths even when escrow state is restored. Both paths need to preserve and validate the canonical receipt bytes, including receipts for replayed operations."

[task.18.1627.1]
title = "Issue #1627: Preserve canonical escrow receipts across both genesis recovery paths"
