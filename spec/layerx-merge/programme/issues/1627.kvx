[req.181627]
title = "Genesis recovery preserves canonical escrow receipt history"
ac_1 = "Given successful escrow operations and replays whose canonical receipts are persisted by modules/layerxpay/keeper/escrow_receipt.go:66, when either export/import pair at modules/layerxpay/keeper/genesis.go:15, :52, :173 and :204 is transported through JSON with the host genesis and restored into fresh stores, then GetEscrowReceipt at modules/layerxpay/keeper/escrow_receipt.go:72 returns identical canonical bytes and economic roots for every original sequence after a destination database close/reopen, escrow state remains equal, multi-chunk history is retained, and malformed or altered receipt envelopes are rejected before any writes."

