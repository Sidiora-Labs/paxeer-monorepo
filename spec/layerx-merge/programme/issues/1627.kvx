do_1 = "Extend GenesisState and its validation in modules/layerxpay/types/params.go:21 and :31 with a distinct escrow receipt collection, leaving kernel record key and value bounds intact; update ExportGenesis, InitGenesis, RecoveryGenesis, RecoveryChunk, ExportRecoveryGenesis and InitRecoveryGenesis in modules/layerxpay/keeper/genesis.go:15, :52, :79, :88, :173 and :204 to export detached receipt pairs from the namespace defined at modules/layerxpay/keeper/escrow_receipt.go:45 and restore them into the shared host store atomically with the owned state; include receipt counts, ordering and bytes in recovery chunk bounds and checksum validation, retain all receipt history without an aggregate history cap, and reject malformed, duplicate, foreign or sequence-mismatched receipt entries before writing either store."
do_2 = "Add TestPayGenesisKeepsEscrowReceipts in modules/layerxpay/keeper/genesis_test.go alongside TestPayGenesisRoundTrip at :127, using real successful escrow operations and a replay as in modules/layerxpay/keeper/repair_131_test.go:183; assert GetEscrowReceipt returns the produced canonical bytes before export, JSON-serialize each supported pay envelope together with ExportStoreGenesis output, import into fresh on-disk host and pay stores, close and reopen the destination, and assert the same sequences, exact receipt bytes, economic roots and escrow state survive; cover receipt history spanning recovery chunks and reject corrupted receipt keys, bodies, duplicate entries and altered recovery counts or checksums without changing either destination store."
symbols = ["GenesisState", "ValidateOwnedGenesis", "ExportGenesis", "InitGenesis", "RecoveryGenesis", "RecoveryChunk", "ExportRecoveryGenesis", "InitRecoveryGenesis", "TestPayGenesisKeepsEscrowReceipts"]
