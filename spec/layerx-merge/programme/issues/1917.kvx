[issue.1917]
number = 1917
title = "[Coherence] The new qualification record for attempt 7 of 22.39.117 names an unrelated chain test as its file and symbol instead of the production test cases that failed"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit 564eae1972e8f0de2a2cfe4db230b52c29ca529b introduced finding.22.39.117.7 with the chain attribution still present at spec/layerx-merge/qualification.kvx:36544 and spec/layerx-merge/qualification.kvx:36545, identical to attempt 6 at spec/layerx-merge/qualification.kvx:36480 and spec/layerx-merge/qualification.kvx:36481, although its observed collisions at spec/layerx-merge/qualification.kvx:36546 originate in sdk/launchpad/shared/db/production/production_test.go:153, sdk/launchpad/shared/db/production/production_test.go:266 and sdk/launchpad/shared/db/production/production_test.go:363 under the three cases named by task 22.39.117 do_9 at spec/layerx-merge/spec.kvx:216511 and decision 3048 at spec/layerx-merge/spec.kvx:11401, whereas sdk/launchpad/shared/chain/client_test.go:569 declares the unrelated chain read-adapter test."
close_comment = "The attempt-7 qualification finding misidentifies three production database failures as a chain read-adapter failure. A focused correction will identify production_test.go and TestPostgresRoleAndNumericBoundaries as the first failing case, preserving the recorded failure details."

