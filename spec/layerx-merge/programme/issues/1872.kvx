[issue.1872]
number = 1872
title = "[Coherence] The verification of task 22.39.163 runs an agent SDK test target that never reads the restored ca.pem, so the build of the actual ca.pem consumer is never exercised"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit d122f710b511777382d9b4592577822593fe327b restores the PEM and spec/layerx-merge/spec.kvx:187972 builds all SDK tests, so the consumers do compile, but the verification at spec/layerx-merge/spec.kvx:187973 runs only repair_22_33_1564, whose CA at services/agent/crates/layerx-sdk/tests/repair_22_33_1564.rs:33 is a separate DER fixture, while the PEM-loading authenticated bootstrap assertions at services/agent/crates/layerx-sdk/tests/support/audit_22_30_99.rs:2032 and services/agent/crates/layerx-sdk/tests/support/audit_22_30_99.rs:2055 are reached by services/agent/crates/layerx-sdk/tests/agent_operation_envelope.rs:1487 outside that verification and the inventory check at tests/ci/test_key_material_only_in_fixtures.py:58 checks presence rather than certificate usability."
close_comment = "The restored CA certificate is tracked and its consumers compile, but the certificate-restoration regression target does not exercise it through the authenticated transport. A follow-up regression will reuse the existing bootstrap transport assertions to verify registration and session responses with the restored PEM."

