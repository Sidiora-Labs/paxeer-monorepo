interfaces = []
do_1 = "Change rowFrom at src/modules/history/indexer.go:152-194 to accept only canonical positive decimal IDs and explorer:<positive decimal> IDs whose numeric component fits uint64, retaining Row.ID verbatim; change Merge at src/modules/history/indexer.go:309-322 to order by position, ordinal, indexed-before-imported discriminator and numeric ID, matching services/platform/hosted/indexer/src/store.rs:575-585 and services/platform/hosted/gateway/src/history.rs:203-205 without changing position cursors, deduplication, page bounds or other row validation."
do_2 = "Extend rpc/testdata/px-history/responses.json with separate mixed-history recordings emitted by the real indexer Store::commit and Store::import_explorer at services/platform/hosted/indexer/src/store.rs:1961-2013 through GET /v1/history/{account} at services/platform/hosted/indexer/src/api.rs:667-693; record their producer revision and generation procedure in rpc/testdata/px-history/README.md, retaining the existing recordings and never constructing successful response rows by hand."
do_3 = "Add TestPxNodeRoot_History_ExplorerImportedRows in rpc/px_node_root_history_test.go using the real node harness and producer recordings alongside the existing replay transport at rpc/px_node_root_history_test.go:51-85; call px_getHistory and px_getUnifiedHistory on HTTP and WebSocket, include committed native-account merging, decimal and explorer IDs sharing numeric suffixes, equal-position ties with numeric IDs 2 and 10, and self-transfer legs, and assert exact unchanged IDs, indexed-before-imported and numeric ordering, distinct namespaced rows, cursor advancement and traversal to null without omissions or repeats, including after restarting the RPC consumer."
do_4 = "In the same regression add malformed-ID subtests for empty IDs, zero, leading zeros, missing explorer suffixes, signs, whitespace, unknown or repeated prefixes, and uint64 overflow in either form; assert both node-root methods on HTTP and WebSocket return -32001, History unavailable, data.code=invalid_indexer_response, retaining all existing positive and negative checks."
