[req.181632]
title = "Node-root history accepts explorer-imported transfers without changing ordering or pagination"
ac_1 = "Given indexer-produced pages containing canonical positive decimal and explorer-prefixed uint64 IDs from services/platform/hosted/indexer/src/store.rs:2208 and services/platform/hosted/indexer/src/store.rs:2237, both node-root history methods preserve the exact ID strings and return the complete pages over HTTP and WebSocket instead of the rejection at src/modules/history/indexer.go:176-187."
ac_2 = "For rows tied on position and ordinal, Merge at src/modules/history/indexer.go:309-322 orders indexed rows before imported rows and then compares numeric IDs within each source, retains distinct decimal and explorer IDs with the same suffix, and preserves position-boundary pagination at src/modules/history/indexer.go:323-337 so traversal through a null cursor has no missing or repeated rows before and after consumer restart."
ac_3 = "Malformed IDs, zero, noncanonical decimal strings, unsupported prefixes and numeric components exceeding uint64 continue to fail the whole page with the typed invalid_indexer_response unavailable error defined at rpc/px_history.go:18-33 on both history methods and both transports."

[acceptance.18.1632.1]
feature = "18"
req = "181632.1"
scenario = "Given real indexer pages containing indexed and explorer-imported transfers and a node with committed account state, when either history method is traversed over HTTP and WebSocket and reread after restart, then IDs remain unchanged, tied rows follow indexer source and numeric ordering, every row is returned exactly once through the final cursor, and malformed IDs return the documented unavailable error."
