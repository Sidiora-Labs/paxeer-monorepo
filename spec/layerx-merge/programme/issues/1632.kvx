[issue.1632]
number = 1632
title = "[P2] Accept explorer-imported row IDs in node-root history"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The indexer history route at services/platform/hosted/indexer/src/api.rs:667-693 reads merged history whose serializer emits explorer-prefixed IDs at services/platform/hosted/indexer/src/store.rs:2237, but rowFrom at src/modules/history/indexer.go:176-187 still requires decimal-only IDs and Client.Page propagates the rejection at src/modules/history/indexer.go:259-261 into the unavailable response at rpc/px_history.go:18-33, while Merge at src/modules/history/indexer.go:319-321 also lacks the source discriminator required by services/platform/hosted/gateway/src/history.rs:203-205; these Go paths remain unchanged from commit 745659e6d62d69b4f1aa8b2afd12d6b2bf7982f2 and the existing paging regression at rpc/px_node_root_history_test.go:189-208 covers only decimal IDs."
close_comment = "Node-root history rejects valid pages containing explorer-imported transfers. The repair is specified in task 18.1632.1 to preserve both ID forms, indexed-before-imported ordering, and complete pagination through both history methods on HTTP and WebSocket while continuing to reject malformed IDs."

[task.18.1632.1]
title = "Issue #1632: Accept explorer-imported IDs in node-root history"
status = "pending"
