[issue.1823]
number = 1823
title = "[P2] Include shared chart declarations in the launchpad Docker build"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "apps/launchpad/web/public/charting_library/charting_library.d.ts:1 forwards to the canonical perps declaration introduced by commit 637c9c63da15d53eae493665591a26bcb2799d6c, but deploy/launchpad/Dockerfile.web:6-10 omits that input before the Next build at :49, while apps/launchpad/web/src/widgets/trading/tv-chart.tsx:4 and apps/launchpad/web/src/widgets/trading/udf-datafeed.ts:6 require its named exports and tests/ci/test_frontend_asset_names.py:140-147 checks only the full checkout."
close_comment = "The launchpad image builder is missing the shared chart declarations required by the chart component and datafeed. A follow-up task will include the canonical declaration in the builder, preserve the named exports and TradingView namespace, and verify the production build and isolated packaging inputs."

