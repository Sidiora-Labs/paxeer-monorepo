[issue.1833]
number = 1833
title = "[P2] Accept the seller's committed settlement metadata in the Python buyer"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Decision 2570 at spec/layerx-merge/spec.kvx:8535 requires the landing references emitted at services/platform/middleware/seller/src/index.ts:390 and asserted at services/platform/middleware/seller/test/settlement-response.test.mjs:280, but services/agent/sdk/python/layerx_sdk/x402_http.py:609 routes fetch into capture_settlement, whose line 642 passes the full extension to the strict key check at line 228 introduced by commit 18880543d1bd1922597879bf76de981183d71b7f, rejecting either landing field before receipt verification at line 649."
close_comment = "The Python buyer rejects the landing block metadata in ordinary committed seller responses before verifying their receipts. Task 18.1833.1 tracks accepting that settlement metadata while preserving receipt authentication, independently trusted commitment evidence and downgrade refusals."

[task.18.1833.1]
title = "Issue #1833: Accept committed settlement metadata in the Python buyer"
