[issue.1851]
number = 1851
title = "[Coherence] The new FastAPI `test` extra is declared in pyproject.toml but the package's own build backend never emits it, so `layerx-fastapi[test]` installs no test dependencies"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "sdk/integrations/fastapi/pyproject.toml:3 selects the local backend and sdk/integrations/fastapi/pyproject.toml:23 declares the test extra added by commit 9a0d2df69abcfea124d631f5915f803a19013fd1, but sdk/integrations/fastapi/build_backend.py:18 emits only the runtime REQUIRES tuple at sdk/integrations/fastapi/build_backend.py:15 into the wheel through sdk/integrations/fastapi/build_backend.py:50, while tests/ci/test_platform_middleware_suites_wired.py:108 checks only the declaration and requirements wiring, leaving the wheel without Provides-Extra or extra-conditional Requires-Dist headers."
close_comment = "The FastAPI package declares a test extra that its wheel metadata omits, so installing layerx-fastapi[test] does not request pytest, httpx or cryptography. Repair task 18.1851.1 covers emitting the declared extra and checking the metadata of the resulting wheel."

[task.18.1851.1]
