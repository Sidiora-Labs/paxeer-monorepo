[req.181675]
title = "Portfolio balance errors have an explicit retryable header state"
ac_1 = "Given a connected Portfolio with an account or wallet read failure, the header at apps/perps/src/widgets/portfolio/PortfolioTopBar.tsx:64 shows a balance-error alert and Retry balances rather than Resolving vault, the retry invokes the reader exposed at apps/perps/src/page-modules/portfolio/balances.ts:95, and successful retry restores Deposit and Withdraw while pending and disconnected states retain their appropriate controls."

[acceptance.18.1675.1]
feature = "18"
req = "181675.1"
scenario = "Given a connected Portfolio whose account read, wallet read or both fail, when the reads settle and the header retry is invoked, then an explicit balance error replaces the resolving message, retry refreshes both sources, another failure remains retryable, and success restores Deposit and Withdraw without fabricated balance values."
contract = "contracts/perps-client.md#widgets"
test = "apps/perps/tests/repair-22-33-578.test.ts::portfolioTopBarBalanceFailureAndRetry (planned)"
qualification = "UNRUN"
