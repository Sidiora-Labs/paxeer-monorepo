[issue.1686]
number = 1686
title = "[Coherence] GraphQL tickers now take the latest index from mark events and successful aggregates, but the REST tickers and market records still read it only from mark events"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "services/platform/perps-data/internal/rest/venue.go:212 and services/platform/perps-data/internal/rest/venue.go:220 still source ticker index_price only from mark events, unlike the successful-aggregate union at services/platform/perps-data/internal/graphql/perps.go:1171, while commit 95c0c0e727d38a85f484609f56c852ae4ed5afa2 already repaired market-record index and basis selection at services/platform/perps-data/internal/rest/markets.go:138 and services/platform/perps-data/internal/rest/markets.go:147."
close_comment = "Market records already use the latest index observation from mark events and successful aggregates, but venue tickers still return stale or missing index prices after aggregate updates. The remaining fix aligns ticker index selection with GraphQL and market records while retaining mark prices from mark events."

