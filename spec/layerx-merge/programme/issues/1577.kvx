[issue.1577]
number = 1577
title = "Wallet Open skips the token approval required by the current perps openPosition call"
revision = "53150198caf59defafffab36d79dbc66d921ae57"
verdict = "task"
evidence = "apps/wallet/src/surfaces/ExchangeView.tsx:74-84 builds the openPosition call with pull 0n and :115-121 skips the approval callback when pull is zero, while precompiles/perps/positions.go:264-271 routes open through depositLeg, which checks the allowance and transfers the collateral at precompiles/perps/account.go:297-336; ExchangeView.test.tsx:122-124 asserts no allowance lookup."
close_comment = "The wallet exchange Open action now requests the exact collateral approval the perps open call pulls, the same way deposit does, and the surface test asserts the allowance lookup and approval before the open transaction."

[task.18.1577.1]
title = "Issue #1577: Approve the collateral pull before the wallet exchange open"
status = "pending"
mode = "BUILD"
