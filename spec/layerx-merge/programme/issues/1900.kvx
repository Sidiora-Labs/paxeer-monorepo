evidence = ".github/workflows/wallet-test.yml:74-117 installs Anvil and runs Gateway Vitest without a Paxeer node or fixture URLs, services/wallet/gateway/test/setup.ts:18 supplies localhost port zero, and agent-precompiles-eip712.test.ts:220-224 and agent-precompiles-streams.test.ts:121-126 under services/wallet/gateway/test reject that prerequisite despite the ready, merge-activated fixture available at tools/qualification/localnode/v6120-node.sh:788-806 and prescribed by spec/layerx-merge/spec.kvx:5299-5303."
close_comment = "Gateway Vitest still lacks the disposable Paxeer node required by its EIP-712 and streams integration checks. The follow-up task connects the existing merge-enabled local node fixture, supplies both RPC URLs, and verifies readiness and cleanup while retaining all four real-node assertions."

[task.18.1900.1]
title = "Issue #1900: Supply the disposable Paxeer node for Gateway Vitest"
