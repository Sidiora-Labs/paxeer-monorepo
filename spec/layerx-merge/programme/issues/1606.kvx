[issue.1606]
number = 1606
title = "[Coherence] The audit record declares the hosted and CLI platform contracts missing although both exist at the path the interface registry uses"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The unchanged audit from commit 060ba3d1fd928b3069b01db6eab99c3f5b21a882 still declares the pages absent at spec/layerx-merge/programme/audit/records/22.30.80.kvx:545 and marks them missing at :747 and :752, although spec/layerx-merge/interfaces.kvx:313536 and :376733 resolve to the existing anchors at spec/layerx-merge/contracts/platform-hosted.md:329 (including retention_mark and revocation_mark at :337 and :338) and spec/layerx-merge/contracts/platform-cli.md:1141, whose stable activities and settlement rows at :1163 and :1170 contradict the 404 and 410 assertions in tools/platform/emulator/tests/gateway.rs:373 and :320 and the settlement refusal at tools/platform/emulator/src/main.rs:1254."
close_comment = "The hosted and CLI platform contracts exist under spec/layerx-merge/contracts/; the audit incorrectly reports them as missing. A documentation correction is needed to review the existing pages and identify their actual drift, including the CLI contract's stable activities and settlement rows for retired emulator routes."

