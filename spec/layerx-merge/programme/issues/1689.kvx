[req.181689]
title = "Invalid wallet and RPC configuration remains rejected while the configuration error page stays available"
ac_1 = "Given invalid wallet origins or any malformed RPC override, including values present before module import, when an ordinary launchpad request traverses the middleware at apps/launchpad/web/src/middleware.ts:44 and the configuration guard at apps/launchpad/web/src/app/layout.tsx:38, then it receives restrictive CSP and SAMEORIGIN framing protection and renders the configuration error while backendConfigurationProblems reports the offending variables, without trusting invalid origins or substituting a default RPC; valid configuration retains the origins and security headers currently asserted at apps/launchpad/web/src/core/backend-origins.test.ts:208."

[acceptance.18.1689.1]
feature = "18"
req = "181689.1"
scenario = "Given invalid wallet origins, invalid RPC overrides or both before module import, when an ordinary launchpad request is handled, then the middleware serves a restrictive policy and the layout renders its configuration error without external wallet framing or backend client initialization, while valid settings retain their validated origins."
