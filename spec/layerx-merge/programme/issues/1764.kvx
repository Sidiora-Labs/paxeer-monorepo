stop_condition = "Stop on the bounded gate result; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to an existing module before implementation; a planned path never authorizes a duplicate implementation tree. A task touches only the paths it declares."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[req.181764]
title = "Committed receipt coverage uses the complete consensus batch independently of Ethereum visibility"
ac_1 = "Given a signed mixed-transaction sequence batch as constructed by node/app.go:2735 and node/app.go:3706, when GetSequenceBatch serves coverage and the SDK verifies a committed receipt through services/agent/crates/layerx-sdk/src/rpc_verification.rs:360, then every post-batch activity ID is preserved in consensus order, a target at a nonzero sequence offset verifies even when rpc/utils.go:456 or rpc/block.go:311 omits other transactions, and missing, truncated, reordered or altered IDs are refused with signature, root, proof and sequence-state checks intact."

[acceptance.18.1764.1]
feature = "18"
req = "181764.1"
scenario = "Given a real committed mixed-transaction batch and independently pinned trust, when the SDK waits for its target through the node's production RPC while Ethereum and domain views omit other batch transactions, then the target verifies as Committed using the complete batch activityIds and corrupted lists are refused."
contract = "contracts/sequencer.md#sequencer-msg"
test = "rpc/px_node_root_kernel_test.go::TestCommittedWaitUsesBatchActivityIDs (planned)"
qualification = "UNRUN"
