[req.181693]
title = "Coin routes expose the image editor and approved metadata viewer"
ac_1 = "Given an authenticated creator on Paxeer, the metadata route at apps/launchpad/web/src/app/tokens/[tokenAddress]/metadata/page.tsx:11 exposes the Coin image chooser and commits an approved image through the real image transport, while disconnected or wrong-chain sessions cannot upload."
ac_2 = "Given that committed image, the coin route at apps/launchpad/web/src/app/coin/[address]/page.tsx:9 reaches MetadataViewer through TokenMarketLayout at apps/launchpad/web/src/widgets/trading/token-market-layout.tsx:88, exposes one Coin details region with the matching Coin image and revision, and retains token identity and usable Trading controls when metadata becomes unavailable."

[acceptance.18.1693.1]
feature = "18"
req = "181693.1"
scenario = "Given the actual creator and coin routes with an authenticated creator and approved image, when the creator uploads and commits the image and the coin route reads it before and during a metadata outage, then the image editor and viewer are reachable through the journey's accessible labels, the viewer displays the committed image, unauthorized uploads are blocked, and trading remains available."
contract = "contracts/clients.md#launchpad-web-app"
test = "apps/launchpad/web/src/features/metadata-media/route-wiring.test.tsx::metadata_routes_connect_editor_and_viewer (planned)"
