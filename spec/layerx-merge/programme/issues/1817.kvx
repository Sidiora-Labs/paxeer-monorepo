[issue.1817]
number = 1817
title = "Fix sparse-workspace qualification's explicit-profile IPC mismatch"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The mismatch introduced by commit fdb5915e70bf2b61955af6f5d3bf1fa5363ddafc remains: tools/hyperfide/tests/hyperfide/cases/source_control/2_2.py:247-255 launches explicit profiles without IPC, setup writes source objects before revocation at :77, serverControl rejects absent process.send at :39, and the unconditional case at :142-158 requires revocation_token and SCOPE_DENIED, while tools/hyperfide/tests/hyperfide/support/native_source_sparse_fixture.mjs:50-96 alone supplies the separate token, IPC channel and revocation handler."
close_comment = "Explicit source profiles cannot complete sparse-workspace qualification because they lack the required revocation control channel. Task 18.1817.1 will reject that unsupported mode before source writes, direct callers to the owned fixture, and preserve the full revocation, checkpoint and scope-widening proofs."

