[req.181758]
title = "Capability-install retries retain valid evidence and idempotency across reply upgrades"
ac_1 = "Given a completed capability-install record emitted before or after the rung repair, including a store already at schema 4, reopening and retrying the identical request through services/agent/crates/layerx-agentd/src/human_runtime.rs:12100 returns Committed evidence accepted by services/human/crates/layerx-human-service/src/server/agent_creation.rs:951, preserves the installed capability and action binding, and returns identical converted evidence after a second restart without duplicate application."
ac_2 = "Newly versioned completed records replay identically, pending records remain unavailable, and malformed records, unknown versions, invalid rungs, corrupt digests, changed request bytes and cross-tenant requests never gain successful replay or mutate the existing capability, preserving the checks at services/agent/crates/layerx-agentd/src/human_runtime.rs:12096 and :12231 and completed-grant discovery at :18775."

