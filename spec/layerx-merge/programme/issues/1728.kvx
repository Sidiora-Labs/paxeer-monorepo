[issue.1728]
number = 1728
title = "[Coherence] program_lifecycle_third_shape treats a plain Programs call receipt as proof that a lifecycle operation completed"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "tools/platform/cli/tests/repair_22_33_1496.rs:527 renders the ordinary call identified at :50 and :405 as completed at :530 despite the missing lifecycle transcript recorded at :20, because tools/platform/cli/src/programs.rs:704 checks only Programs scope and :709 emits completed without the lifecycle-event check at :749, while rpc/sequencer_receipt_vectors_test.go:860 and :1086 confirm that the authentic vector emits ProgramCallOutcome."
close_comment = "The lifecycle proof currently accepts an ordinary program-call receipt as completed lifecycle execution. The repair will require authenticated lifecycle-event evidence before reporting completion, reject the existing call receipt in the regression test, and retain the outstanding requirement for real lifecycle execution transcripts."

