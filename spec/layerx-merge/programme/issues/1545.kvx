build_cmd = "python3 -m py_compile tools/deps/tests/test_go_root_checksums.py && (cd tools/paxctl && GOWORK=off GOFLAGS=-mod=readonly go build ./...) && (cd tools/loadtest && GOWORK=off GOFLAGS=-mod=readonly go build ./...) && (cd services/wallet/ceremony && GOWORK=off GOFLAGS=-mod=readonly go build ./...) && (cd sdk/cosmovisor && GOWORK=off GOFLAGS=-mod=readonly go build ./...)"
