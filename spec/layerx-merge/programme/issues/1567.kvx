[issue.1567]
number = 1567
title = "[P2] Populate Autobahn committed header roots before publishing newHeads"
revision = "53150198caf59defafffab36d79dbc66d921ae57"
verdict = "task"
evidence = "consensus/internal/p2p/giga_router.go:331-351 forwards Autobahn committed headers whose receipts, state and transactions roots node/app.go:1952-1957 and node/abci.go:318-326 fill only afterwards, while rpc/subscribe.go:129-161 and 520-553 publish newHeads from the forwarded header."
close_comment = "newHeads notifications for Autobahn-committed blocks now carry populated header roots: the roots are filled before the header is published and the subscription test asserts them."

