[issue.1670]
number = 1670
title = "[Coherence] The existing EmptyBlocksSanitizer tests still send block numbers and hashes the new validator rejects, so both cases now hang and fail"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "services/explorer/backend/apps/indexer/lib/indexer/fetcher/empty_blocks_sanitizer.ex:139 requires a hexadecimal number string and :142 requires a binary hash matching the candidate at :145, but services/explorer/backend/apps/indexer/test/indexer/fetcher/empty_blocks_sanitizer_test.exs:80 supplies an integer number and a hash struct and :122 supplies a hash struct, which the response helper forwards unchanged at :181 and :185, so neither response can reach classification."
close_comment = "Task 18.1670.1 tracks encoding the block numbers and hashes in both sanitizer test responses as JSON-RPC hex strings so the tests reach their empty-block and refetch assertions. The strict response validation remains required."

