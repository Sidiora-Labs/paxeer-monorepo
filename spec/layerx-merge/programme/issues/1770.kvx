[issue.1770]
number = 1770
title = "Explorer Ask flag is rejected by the startup environment validator"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The assistantSchema added by commit 18fc77a542d2c20d4e27e3d06f2f03252367e29c declares NEXT_PUBLIC_ASSISTANT_ENABLED at apps/explorer/deploy/tools/envs-validator/schemas/features/assistant.ts:6 and is exported at schemas/features/index.ts:5, but apps/explorer/deploy/tools/envs-validator/schema.ts:152 omits it from the feature concatenations while schema.ts:34 rejects unknown keys, index.ts:22 collects every public variable and index.ts:63 validates without stripping unknown keys, so the documented flag at docs/explorer/ENVS.md:1116 and the false value at apps/explorer/configs/envs/paxeer-x.env:69 cause rejection and a fatal exit at apps/explorer/deploy/scripts/entrypoint.sh:49 before Next starts at entrypoint.sh:99 through the validator and entrypoint installed by docker/explorer-frontend/Dockerfile:170 and Dockerfile:209."
close_comment = "The startup validator still rejects the documented Ask flag, including the disabled value in the Paxeer preset. Tracked in task 18.1770.1 to register the assistant schema and cover both boolean values while preserving rejection of invalid values and unknown public variables."

