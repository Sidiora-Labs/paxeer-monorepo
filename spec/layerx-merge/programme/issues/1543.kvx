[req.181543]
title = "Android sample dependency declarations and verification metadata cover the binding's patched dependencies"
ac_1 = "The direct dependencies at sdk/integrations/android/sample-app/app/build.gradle.kts:71 match the binding floors at sdk/integrations/android/pom.xml:25, and sdk/integrations/android/sample-app/gradle/verification-metadata.xml:541 contains SHA-256 checksums for the selected Jackson and BouncyCastle artifacts and required Jackson metadata, allowing the sample to assemble with strict dependency verification while preserving sdk/integrations/android/sample-app/gradle/verification-metadata.xml:4."

