[issue.1681]
number = 1681
title = "[Coherence] The clean-checkout corpus test no longer checks that the generated corpus excludes the retired budget pull, even though the repair claims to keep that check"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "Commit f34ce7bfd97be36f64f682ffed910f83b0d8141f removed the registry invocation whose exclusion assertion remains at services/agent/crates/layerx-wire/src/activity.rs:472; tests/ci/test_agent_codec_corpus.py:168 checks the fixed summary from tests/vectors/codec/generate.py:39 and substitutes unrelated EIP-1559 coverage at tests/ci/test_agent_codec_corpus.py:183, tests/ci/test_repair_22_33_727.py:36 checks only that summary string, and the invoked corpus consumer at services/agent/crates/layerx-types/tests/vectors.rs:75 checks counts and coverage without excluding budget ordinal 11, leaving the preservation requirement at spec/layerx-merge/spec.kvx:362790 unmet."
close_comment = "The generated codec corpus still lacks a consumer assertion that excludes retired budget pull activity 0x0003000B. A focused follow-up will check the decoded activity types in the existing corpus conformance test, preserving the EIP-1559 coverage and corpus rejection checks."

