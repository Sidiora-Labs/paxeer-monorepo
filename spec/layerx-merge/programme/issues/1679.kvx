[req.181679]
title = "Token transfer live updates follow the displayed page"
ac_1 = "Given at least two 25-row display pages in server page 1, advancing through apps/explorer/ui/token/TokenTransfer/useTokenTransferPages.ts:31 disables the token channel and hides both new-transfer notices controlled by apps/explorer/ui/token/TokenTransfer/TokenTransfer.tsx:62, :82 and :92 on display pages greater than 1; returning or resetting to display page 1 restores live updates and both notices, while placeholder/error states still disable the channel."

[acceptance.18.1679.1]
feature = "18"
req = "181679.1"
scenario = "Given a token transfer list split into 25-row display pages within the first server response, when the user leaves display page 1 and then returns or resets the row selection, then the token channel stops delivering live counts and both notices disappear on later display pages, and live updates and notices resume only on display page 1 when the query is neither placeholder nor errored."
contract = "contracts/explorer-ws.md#topics"
test = "apps/explorer/ui/token/TokenTransfer/TokenTransfer.spec.tsx::tokenTransferLiveUpdatesFollowDisplayPage (planned)"
