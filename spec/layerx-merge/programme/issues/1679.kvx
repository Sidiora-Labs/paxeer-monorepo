[issue.1679]
number = 1679
title = "[Coherence] The live-transfer socket and the new-items notice still follow the server page, not the page the user is looking at"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "apps/explorer/ui/token/TokenTransfer/useTokenTransferPages.ts:31 advances the display page without advancing the server page and :68 exposes that display page, while apps/explorer/ui/token/TokenTransfer/TokenTransfer.tsx:62, :82 and :92 still gate the socket and desktop/mobile notices on the server page; apps/explorer/ui/token/TokenTransfer/TokenTransfer.spec.tsx:28 starts existing component tests on server page 2, leaving this regression introduced by commit e6ec195e2e4ea4116ef675442e490c99c2893ab8 uncovered."
close_comment = "Confirmed: live transfer updates and new-transfer notices remain active on later display pages backed by the first server response. The follow-up fix will restrict the subscription and both notices to the first display page and add coverage for leaving and returning to that page."

