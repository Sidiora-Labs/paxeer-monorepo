[req.181655]
title = "Collateral removal admits withdrawals supported by post-settlement account limits"
ac_1 = "The maximum and admission decision in apps/perps/src/widgets/trading/modals/collateralRemoval.ts:59 match the keeper's post-settlement constraints at modules/perps/keeper/account.go:90 and modules/perps/keeper/account.go:382, including profit, losses, funding, USDL rounding, account-wide initial margin, governed withdrawal floors and tiered maintenance, without using stored pre-settlement collateral to reject an otherwise valid amount."
ac_2 = "With 250 USDL stored collateral, a 10-base long costing 1000 USD marked at 125 USD with 10x leverage and the default withdrawal floor has a 375 USDL maximum and accepts a 300 USDL withdrawal; the real precompile and UI agree at valid boundaries and reject one unit above the applicable limit."
ac_3 = "Settlement and refreshed account reads retain the correct maximum, withdrawals reduce it by the actual debited amount, and fresh submission reads continue to reject amounts made unsafe by changed prices or funding and refuse unavailable risk."

[acceptance.18.1655.1]
