[issue.1806]
number = 1806
title = "[Coherence] The receipt verifier still drops every pinned key whose id is not the SHA-256 digest of its public key, so the configuration change accepts keys that verification then ignores"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit e2b5e835fcd75d0802f039733dd67ca637879504 introduced ReceiptKeysConfig.parse/1, called at services/explorer/backend/config/runtime.exs:315, which accepts non-digest IDs at services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/receipt_keys_config.ex:16, but services/explorer/backend/apps/explorer/lib/explorer/chain/paxeer_x/sequencer_receipt.ex:581 still filters them out and returns untrusted_receipt_keys at line 592 through discovery at line 206 and verification step R3 at line 178, contradicting the chain validation at modules/sequencer/keeper/receipt_keys.go:50 and decision 2754 at spec/layerx-merge/spec.kvx:9639."
close_comment = "The explorer accepts governed receipt keys in configuration but still rejects them during discovery and receipt verification when their IDs differ from their public-key digests. The follow-up repair makes those paths accept the configured non-zero IDs while preserving key matching, signature verification and validity ranges."

