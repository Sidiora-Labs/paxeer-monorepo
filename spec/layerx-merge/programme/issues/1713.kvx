[issue.1713]
number = 1713
title = "Web-search exact-payment adapter rejects valid two-log receipts"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "services/agent/sdk/typescript/src/web-search.ts:406 still requires one total log before header preparation at :599, whereas modules/layerxledger/keeper/events.go:74 and :89 emit Transfer then PaymentExact, precompiles/layerxledger/payments_test.go:239 asserts both, rpc/sequencer_receipt.go:606 retains every log, and services/agent/sdk/typescript/test/web-search.test.ts:178 forwards the historical single-log recording unchanged, confirming the incompatibility introduced by commit cb50180548c81a93044fcc5883195a0670f127f4."
close_comment = "Valid exact-payment receipts contain both Transfer and PaymentExact, but the web-search log adapter currently rejects that receipt shape. A focused fix is required to accept one matching PaymentExact event while preserving receipt authentication and payment validation."

