[req.181713]
title = "Web-search exact-payment validation accepts complete Ledger receipt logs"
ac_1 = "Given an authenticated payExact receipt with the producer's Transfer and PaymentExact logs asserted at precompiles/layerxledger/payments_test.go:239, when WebSearchClient prepares an exact payment through services/agent/sdk/typescript/src/web-search.ts:595, then exactly one matching PaymentExact event permits header delivery with payer, payee, asset, amount and reference bound to the verified transaction; missing, duplicate, malformed or mismatched payment events and invalid receipt authentication are refused before header delivery."

