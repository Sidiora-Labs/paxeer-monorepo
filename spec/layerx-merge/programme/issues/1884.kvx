capabilities = []
interfaces = []
do_1 = "Update services/agent/crates/layerx-crypto/src/api-contract.md:28 and :50 to identify disclosure::bind, bind_budget_mutation, send::EnvelopeOptions, DisclosedEnvelope, encode_send_envelope and signer::sign_disclosed as removed APIs rather than available deprecated compatibility; describe disclosure::call::bind_call, send::CallOptions, send::DisclosedCall, send::ledger_payment_call and signer::sign_disclosed_call using their current signatures at src/disclosure.rs:69, src/send.rs:158, src/send.rs:167, src/send.rs:185 and src/signer.rs:331."
do_2 = "Describe SigningRequest::new at services/agent/crates/layerx-crypto/src/signer.rs:55 as a retained domain-checked, canonical-disclosure-validated compatibility constructor whose Activity purpose is refused by signing_bytes at :96 and external_signing_bytes at :118; distinguish it from SigningRequest::bind and SendDebit::signing_request, and remove the claim that local consumers can use sign_disclosed."
do_3 = "Document the genuinely retained deprecated onboarding module and OnboardingConsent/SponsoredRegistration re-exports at services/agent/crates/layerx-crypto/src/lib.rs:21 and src/payments.rs:21, with binding::BindAuthorization for current EVM registration, following decisions 2237 and 2356 at spec/layerx-merge/spec.kvx:6535 and :7249; retain the raw bind-consent, native payer-authorization and proof-rung guarantees already documented at src/api-contract.md:10 and :67."
do_4 = "Add an executable Rust documentation example named supported_call_example in services/agent/crates/layerx-crypto/src/api-contract.md, declare and invoke that function in the example, and use the real native payer producer, ledger_payment_call with CallOptions, DisclosedCall, bind_call and sign_disclosed_call with an explicit sender matching the selected EVM key; assert canonical-byte round trip, disclosure equality and recovered transaction sender, following the existing producer-to-consumer checks at tests/repair_22_33_1558.rs:98 and tests/send_call.rs:32 without importing their private support modules."
do_5 = "Build and inspect the rendered layerx_crypto crate documentation with custody enabled, then run its Rust documentation tests so the supported-call example compiles and executes; preserve runtime behavior, retired API absence and all existing validation assertions, including tests/repair_22_33_1558.rs:142, :186, :292 and :342 and tests/signer.rs:258."
