[issue.1884]
number = 1884
title = "[P3] Refresh the published crypto API contract after legacy codec removal"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "services/agent/crates/layerx-crypto/src/lib.rs:1 publishes api-contract.md, whose lines 32-36 and 53-58 still advertise removed activity helpers and deny the retained constructor, although commit f2ca9f35edf084513f34954793456128c87b45b7 deleted those helpers without updating that document, src/signer.rs:55 retains the validated compatibility constructor, src/signer.rs:96 refuses its signing purpose, src/disclosure.rs:69 and src/send.rs:158 expose supported call preparation, src/signer.rs:331 exposes call signing, and src/lib.rs:21 and src/payments.rs:21 retain deprecated onboarding as decisions 2237 and 2356 require (spec/layerx-merge/spec.kvx:6535 and spec/layerx-merge/spec.kvx:7249)."
close_comment = "The published crypto contract still lists deleted activity APIs and misstates the retained request constructor. The follow-up documentation task will describe supported EIP-1559 call preparation and signing, distinguish retained onboarding compatibility, and add a checked call example."

[task.18.1884.1]
title = "Issue #1884: Refresh the published crypto contract for supported call APIs"
status = "pending"
mode = "BUILD"
wave = 1
requires = []
