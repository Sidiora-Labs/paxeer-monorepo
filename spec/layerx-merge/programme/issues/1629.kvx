[issue.1629]
number = 1629
title = "[P2] Restore retention eligibility for reappearing archived snapshots"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The archival change in commit 63cb383086ee54b00ac957e9819834b407a3215b remains in services/wallet/attestor/internal/replica/ledger.go:180 and ledger.go:233, Lookup at services/wallet/attestor/internal/replica/ledger.go:89 reads only active entries, services/wallet/attestor/internal/replica/shipper.go:236 validates archived bytes then skips upload at shipper.go:248, and production passes that ledger at services/wallet/attestor/cmd/attestor/main.go:250 and main.go:272 to retention which skips missing active acknowledgments at services/wallet/attestor/internal/backup/writer.go:268, contradicting matching-shipment retention eligibility in services/wallet/deploy/env:105 while services/wallet/attestor/internal/replica/repair_m148_test.go:68 manually removes snapshots and repair_m148_test.go:133 checks duplicate shipping without Writer.Retain."
close_comment = "Identical reappearing snapshots with archived shipping acknowledgments remain ineligible for retention deletion because retention checks only active acknowledgments. A follow-up task will let retention use validated archived acknowledgments while preserving protection for changed and unshipped snapshots and keeping the active ledger bounded."

