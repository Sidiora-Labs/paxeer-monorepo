[issue.1840]
number = 1840
title = "[Coherence] The new root-path check makes the account-derivation transport-loss test fail when it constructs its client"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The root-path validation introduced by commit a7d39f7f680edfb7e6e92a49468618bd1341cb30 remains at services/agent/sdk/python/layerx_sdk/x402_rpc.py:189 and :249, while tests/agent/sdk/python/test_account_derivation.py:601 still constructs PaymentRpc on /rpc before its outcome assertions at :602 and :613, preventing coverage of the submission/read distinction in services/agent/sdk/python/layerx_sdk/account_derivation.py:814 even after commit 06d9fa865e929be081a8bddc1836c9ac8e384d48 repaired other assertions in the test file."
close_comment = "The account-binding transport-loss test still uses /rpc, which the node client rejects before the outcome checks run. A focused test correction must use the node root endpoint and retain the unknown submission outcome and safe read retry assertions."

