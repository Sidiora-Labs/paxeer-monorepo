[issue.1799]
number = 1799
title = "[Coherence] The SDK and middleware documentation still describe the old hosted routing and the /rpc adapter"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "sdk/wallet/README.md:180 and docs/system/sdk.md:60 still require hostedUrl for px_ reads and contracts/platform-middleware.md:40 still requires /rpc, although sdk/wallet/src/endpoint.ts:82 selects only px_register and px_requestFunds for hosted transport, sdk/wallet/src/endpoint.ts:86 sends account reads to the node, services/platform/middleware/seller/src/rpc.ts:91 requires the gateway root, and sdk/wallet/test/repair-22-31-591.test.ts:139 and services/platform/middleware/seller/test/repair-22-31-591.test.mjs:48 assert the routing introduced by commit 6cfc7652ced4aa7499c9d02fcc6a23653a642a47."
close_comment = "The SDK and middleware documentation needs to describe the current routing: px_ reads use the node root, only px_register and px_requestFunds require hostedUrl, and HostedGatewayRpc posts to the gateway root. A documentation repair is specified to correct all three references."

