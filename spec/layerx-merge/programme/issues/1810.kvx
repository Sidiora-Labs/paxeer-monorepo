[issue.1810]
number = 1810
title = "[P2] Decode the node catalogue in the wallet SDK after routing discovery to the node"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "sdk/wallet/src/endpoint.ts:97 sends node discovery into decodeRouteCatalogue, whose hosted identity, inventory, private-field and nested-readiness requirements at sdk/wallet/src/endpoint.ts:464 reject the public projection from rpc/generate_px_catalogue.py:20 and its node-native routes at rpc/generate_px_catalogue.py:30, while rpc/px_discovery.go:69 supplies flat readiness with unknown hosted dependencies and sdk/wallet/test/repair-22-31-591.test.ts:144 covers only raw batch routing."
close_comment = "The wallet SDK still rejects valid node discovery responses because it expects the hosted catalogue contract. The repair will decode the public node catalogue through the typed discovery method, preserving unknown hosted readiness and excluding private upstream details."

