[issue.1812]
number = 1812
title = "[Coherence] The hand-edited activation runbook no longer matches its generator, so the byte-equality runbook test now fails and regeneration would revert the edit"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "spec/layerx-merge/programme/tests/test_activation_runbook.py:19 requires byte equality, but spec/layerx-merge/programme/activation.py:18 and spec/layerx-merge/programme/activation.py:236 still render four plans and the removed generated header from stale stores at spec/layerx-merge/programme/data/activation-plan.kvx:25, whereas spec/layerx-merge/docs/activation-runbook.md:23 lists eight merge stores and a fifth plan matching node/upgrades.go:450 and node/upgrades.go:647; the requested inline handler is superseded by the guarded registered runAnchorStoreDeleteUpgrade at node/upgrades.go:219 and node/upgrades.go:222, introduced by commit 74b284ed2b0901e49e0a1a7f0b860a552ebb48c0."
close_comment = "The activation data and renderer still disagree with the runbook's five plans and eight merge stores, so regeneration cannot preserve the current inventory. Synchronize the data, renderer and tests with the node, retain the guarded runAnchorStoreDeleteUpgrade handler, and regenerate the runbook with byte-equality coverage."

