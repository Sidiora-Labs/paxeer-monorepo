[issue.1914]
number = 1914
title = "[Coherence] The market sandbox evidence producer still writes raw boundary leaves, but the market leaf verifier now accepts only the record-header envelope"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The capture producer still writes raw proof leaves at programs/crates/layerx-programs-arbiter/examples/market_sandbox_capture.rs:149 and decodes raw execution leaves as envelopes at :286 and :302, whereas programs/crates/layerx-programs-arbiter/src/market.rs:47 requires a record-header envelope and :699 maps its absence to Encoding, and programs/crates/layerx-programs-arbiter/tests/market_sandbox_profile.rs:330 loads those files unchanged for the verdict assertions at :649."
close_comment = "Market sandbox captures still omit the record header required by boundary verification and decode raw leaves as envelopes. A repair is required to emit header-wrapped proof files and decode captured leaves with their record header while preserving raw-leaf Merkle roots."

