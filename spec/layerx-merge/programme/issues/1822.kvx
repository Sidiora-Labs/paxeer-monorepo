[issue.1822]
number = 1822
title = "[P2] Preserve the shared Swagger contract in regeneration paths"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit a2bf776a9fbdd7265c4a1dfcc89cb2fe8e755d13 introduced the shared archive and SDK shim still present at docs/swagger/statik.go:12 and sdk/client/docs/statik/statik.go:4, but the documented root entrypoint at docs/paxeer-chain-docs.md:75 invokes scripts/update-swagger-ui-statik.sh:13 whose transform at scripts/swagger_assets.py:20 replaces the default registration with only the named registration, breaking the default consumers at wasm/app/app.go:836 and interchain/testing/simapp/app.go:693 while node/app.go:3873 uses the named namespace, and sdk/Makefile:166 and sdk/scripts/update-swagger-ui-statik.sh:2 still overwrite the shim, contrary to the single-archive, dual-namespace and schema-alias assertions at tests/ci/test_copied_artifacts_in_sync.py:180."
close_comment = "Swagger regeneration still drops the default namespace or replaces the shared SDK import with a duplicate archive. The repair must preserve one bundle, both namespaces and both schema filenames through the root and SDK generation entrypoints, with a generation round-trip regression."

