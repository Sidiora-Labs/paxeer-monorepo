[issue.1861]
number = 1861
title = "[Coherence] The chainflow SDK docs still give the old Python 3.9 and Go 1.22 minimums after the manifests were raised"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit 6c8d638041f76e9383f70fb57e0736fa7f10b494 raised the floors still declared at sdk/chainflow/python/pyproject.toml:10 and sdk/chainflow/go/go.mod:3 to Python 3.11 and Go 1.25, consistent with spec/layerx-merge/spec.kvx:9999, but sdk/chainflow/python/README.md:260, sdk/chainflow/python/SKILL.md:127 and sdk/chainflow/python/.claude/skills/chainflow-data-gateway-python-sdk/SKILL.md:142 still require Python 3.9, while sdk/chainflow/go/README.md:237, sdk/chainflow/go/SKILL.md:127 and sdk/chainflow/go/.claude/skills/chainflow-data-gateway-go-sdk/SKILL.md:127 still require Go 1.22."
close_comment = "The Chainflow Python and Go documentation still advertises older runtimes than the SDK manifests support. The follow-up task updates all six README and skill requirement lines to Python 3.11 or newer and Go 1.25 or newer."

