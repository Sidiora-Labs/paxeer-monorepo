[issue.1858]
number = 1858
title = "[Coherence] The rewritten launchpad and sdk/wallet test steps are no longer recognised by the JavaScript suite-runner guard in ci.yml, so 12 packages read as having no runner"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The parser introduced by commit b05c9aead54f8b9a822d9020097add4f53f60adb remains unchanged at tests/ci/test_js_suites_have_runner.py:123 and :156, rejecting Python commands and treating --filter as the script at :188, while the eleven-package launchpad matrix still uses --filter at .github/workflows/launchpad-test.yml:76 and the wallet matrix still invokes its Python wrapper at .github/workflows/wallet-test.yml:29, whose real Vitest command is tools/ci/run_wallet_vitest.py:51, leaving those twelve test packages unrecognised by the inventory enforced at .github/workflows/ci.yml:241."
close_comment = "The JavaScript suite inventory still misses the eleven launchpad test packages and the wallet SDK despite their configured test runners. A focused parser repair will recognise the launchpad selectors and wallet wrapper while preserving rejection of commands that do not run tests."

