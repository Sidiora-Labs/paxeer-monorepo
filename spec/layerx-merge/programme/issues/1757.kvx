[issue.1757]
number = 1757
title = "[Coherence] Two targets with observed assertion failures are counted as not_run instead of failed, so the header undercounts failures"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "spec/layerx-merge/programme/sweeps/rust-test-agent.kvx:7 reports four failures and four unknowns under the policy at :10, although the layerx-agentd and layerx-sdk blocks at :84 and :96 retain assertion failures at :91 and :105, contradicting decision 2509 at spec/layerx-merge/spec.kvx:8169 and the closure requirements at :205837 and :205838."
close_comment = "The agent test inventory counts two targets with recorded assertion failures as unknown. Both targets must be counted as failed, giving six failed targets and two unknown targets while retaining the timeout evidence."

