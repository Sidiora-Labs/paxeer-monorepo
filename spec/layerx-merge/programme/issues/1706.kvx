[issue.1706]
number = 1706
title = "[Coherence] Four replay commands in state_repairs.json select more than one case and always fail the count check"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "engine/tests/state_harness_test.go:646 constructs indexed names, :648 matches them by substring and :655 rejects count mismatches, so the count-one commands at engine/tests/data/state_repairs.json:96, :108, :996 and :1008 select 11, 11, 11 and 7 posts respectively from the committed archive's 132-post Opcodes_TransactionInit and 36-post variedContext fixtures, while engine/tests/repair_m1180_test.go:197 checks flags without validating those selections."
close_comment = "Four recorded state replay commands select additional posts because indexed case names are matched by substring, so their required count of one fails before comparison. The repair task makes indexed replay selection exact and checks the recorded commands against the fixture inventory."

