[issue.1889]
number = 1889
title = "[Coherence] Task 22.39.183 leaves three arbiter callers outside its touches that decode raw runtime boundary leaves with decode_untrusted, so decision 3029's 'no consumer calls decode_untrusted on a raw leaf' cannot be met"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit dd3a58600392bfe151306e605f4dddc12d6fce97 repairs the scoped arbiter consumers, but spec/layerx-merge/spec.kvx:187681 and :187685 still omit the three callers and terminal_trap gate, programs/crates/layerx-programs-runtime/src/execute.rs:6169 returns raw record leaves and portable_replay.rs:325 requires an envelope, while programs/crates/layerx-programs-arbiter/tests/terminal_trap.rs:70, tests/market_sandbox_profile.rs:816 and examples/market_sandbox_capture.rs:286 still decode those raw leaves with decode_untrusted."
close_comment = "Accepted for a focused repair: the terminal-trap test, market profile test and capture decoder must decode raw boundary leaves with their record header. The repair will cover integer and terminal-trap replay while preserving the committed raw boundary bytes."

[task.18.1889.1]
