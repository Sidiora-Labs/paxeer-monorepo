[req.181515]
title = "Submitted chain history survives editable-draft expiry"
ac_1 = "An otherwise valid persisted confirm or reverted journal at apps/launchpad/web/src/widgets/create-chain/chain-storage.ts:40 remains readable, updatable to a confirmed revert and clearable by its matching owner/hash beyond the editable-draft age boundary at chain-domain.ts:51 without changing the reviewed snapshot or weakening structural validation, so the recovery consumer at chain-wizard.tsx:59 receives the identity instead of entering recoveryBlocked, while unsent drafts retain their 30-day expiry."

