[issue.1515]
number = 1515
title = "[P2] Keep persisted chain submissions outside editable-draft expiry"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "The journal introduced by commit 29f3b3d9380bff9b4e45ea4ad7cff91545918d4a still applies the editable-draft age check at apps/launchpad/web/src/widgets/create-chain/chain-domain.ts:51 through chain-storage.ts:19, chain-storage.ts:61 and chain-storage.ts:72 to both confirm and reverted records, so after 30 days plus 1 ms chain-wizard.tsx:75 sets recoveryBlocked before exposing the hash at chain-wizard.tsx:233 and blocks launches at chain-wizard.tsx:120 and fresh drafts at chain-wizard.tsx:252, while chain-wizard.test.tsx:251 and chain-wizard.test.tsx:310 cover immediate recovery and reverts without advancing through expiry."
close_comment = "Confirmed: a saved chain submission older than 30 days can hide its transaction hash and block confirmation and new launches, including after a known revert. The follow-up separates submitted transaction history from editable-draft expiry while preserving identity checks and the 30-day limit for unsent drafts."

[task.18.1515.1]
title = "Issue #1515: Preserve submitted chain history beyond editable-draft expiry"
status = "pending"
