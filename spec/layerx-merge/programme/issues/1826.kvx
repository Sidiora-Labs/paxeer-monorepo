[req.181826]
title = "Public SDK consumers can identify typed install-status errors"
ac_1 = "The root, node, browser and core entries declared in tools/hyperfide/sdk/client/package.json:5 export SystemInstallError as a runtime value usable against errors returned by that entry's system.installStatus, and an instanceof guard narrows code to SystemInstallErrorCode as declared at tools/hyperfide/sdk/client/src/areas/system.ts:77; the real-service regression at tools/hyperfide/sdk/client/test/install-status.test.ts:28 imports through @hyperfide/sdk, @hyperfide/sdk/node, @hyperfide/sdk/browser and @hyperfide/sdk/core and retains the NOT_FOUND, SUPERSEDED and SCOPE error-code and body assertions at tools/hyperfide/sdk/client/test/install-status.test.ts:159."

[acceptance.18.1826.1]
feature = "18"
req = "181826.1"
scenario = "Given a consumer importing the SDK and SystemInstallError through each supported client package entry, when the real install-status service returns NOT_FOUND, SUPERSEDED or SCOPE, then the thrown error is an instance of that entry's public constructor, its guarded code has type SystemInstallErrorCode, and the response body and original error code are preserved."
contract = "contracts/tools-ops.md#wiring-integration"
