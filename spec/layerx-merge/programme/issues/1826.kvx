[issue.1826]
number = 1826
title = "[P3] Export SystemInstallError from the public Hyperfide SDK entries"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The constructor added by commit e84868db5bb047e23c1e8c0dc7be2dcdf3dc3705 remains declared at tools/hyperfide/sdk/client/src/areas/system.ts:79 and thrown at tools/hyperfide/sdk/client/src/areas/system.ts:210, but tools/hyperfide/sdk/client/src/public-types.ts:38 forwards only its type, the public exports at tools/hyperfide/sdk/client/src/node.ts:91, tools/hyperfide/sdk/client/src/browser.ts:48 and tools/hyperfide/sdk/client/src/core.ts:37 omit its runtime value, tools/hyperfide/sdk/client/package.json:5 permits no internal system import, and tools/hyperfide/sdk/client/test/install-status.test.ts:14 bypasses that boundary."
close_comment = "The install-status SDK still omits SystemInstallError from its public runtime exports, preventing consumers from using its specialized instanceof guard. Task 18.1826.1 tracks the public constructor exports and a package-entry regression preserving the existing install-status error assertions."

