tests = ["services/wallet/gateway/test/typed-data-records.test.ts::gatewayTypedDataRecordsZod4"]
planned_paths = ["services/wallet/gateway/test/typed-data-records.test.ts"]
build_cmd = "pnpm --dir services/wallet/gateway exec tsc --noEmit"
