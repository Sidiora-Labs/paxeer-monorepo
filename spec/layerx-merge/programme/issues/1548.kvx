do_1 = "Replace the three one-argument z.record calls at services/wallet/gateway/src/schemas/agent.ts:63 and the three at services/wallet/gateway/src/routes/sign.ts:60 with z.record(z.string(), valueSchema), retaining each existing value schema, optional agent domain, agent typed-data passthrough, wallet typedData and typed_data aliases, strict envelopes, field bounds and 256-field array limit; retain the Zod 4 dependency at services/wallet/gateway/package.json:30 and its resolution at services/wallet/pnpm-lock.yaml:126."
do_2 = "Add services/wallet/gateway/test/typed-data-records.test.ts (planned) with one declared test function gatewayTypedDataRecordsZod4 exercising the exported AgentSignTypedDataBody and SignTypedDataBody directly without replacing either schema: assert parsed valid named records retain their values through all six records and both wallet aliases; accept an omitted agent domain and agent typed-data extra properties; reject null, array and scalar record containers, unknown outer keys, unknown wallet document keys, malformed wallet TypedDataField values and 257-field arrays, while accepting 256 fields and retaining existing string bounds at services/wallet/gateway/src/routes/sign.ts:56; follow the focused Vitest runner in services/wallet/gateway/vitest.config.ts:6 and the existing schema safeParse assertion pattern at services/wallet/gateway/test/schemas.injection.test.ts:154."
symbols = ["AgentSignTypedDataBody", "TypedDataDocument", "gatewayTypedDataRecordsZod4"]
