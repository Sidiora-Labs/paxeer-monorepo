[issue.1548]
number = 1548
title = "[P2] Port gateway record schemas to the Zod 4 TypeScript signature"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit 8dc0d37ce04f002d216ab533a297389e013f15d5 raised Zod to ^4.6.6 at services/wallet/gateway/package.json:30, resolved to 4.6.7 at services/wallet/pnpm-lock.yaml:126, but services/wallet/gateway/src/schemas/agent.ts:63 and services/wallet/gateway/src/routes/sign.ts:60 still begin three one-argument record calls each in the sources included by services/wallet/gateway/tsconfig.json:10, incompatible with the required keyType and valueType parameters at https://github.com/colinhacks/zod/blob/v4.6.7/packages/zod/src/v4/classic/schemas.ts#L1969-L1973 despite the runtime compatibility fallback at that source's lines 1974-1981."
close_comment = "The gateway's typed-data schemas still use the Zod 3 record signature with the Zod 4 dependency. A wallet repair task will supply explicit string key schemas for all six records and preserve typed-data validation with focused acceptance and refusal coverage."

[task.18.1548.1]
title = "Issue #1548: Migrate gateway typed-data records to the Zod 4 signature"
status = "pending"
