[issue.1522]
number = 1522
title = "[Coherence] The dashboard's next floor is checked against a new standalone lockfile that the dashboard build never uses, so the shipped dashboard still resolves next 16.3.5"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Although commit 82f46b5807b164a0fd9c1690c01c2ded3de3ac4a raised the shared Next resolution to 16.4.1 (apps/web/package-lock.json:4753), matching services/platform/hosted/dashboard/web/package.json:14, tools/deps/floors/platform-node.json:25 still selects the dashboard manifest and tools/deps/lockfloor.py:262 therefore reads its unused standalone lock (services/platform/hosted/dashboard/web/package-lock.json:1607), whereas docker/platform-dashboard-web/Dockerfile:8 and Makefile:2528 use apps/web dependencies; scripts/ci/developer-dashboard-lock.mjs:5 checks that shared lock but retains the separate stale UI path assertion at :10, and spec/layerx-merge/spec.kvx:119146 still requires lock consistency."
close_comment = "The shared web dependencies now resolve Next 16.4.1, but the dashboard dependency floor still checks an unused lockfile. The follow-up task checks the shared install lock directly, removes the unused dashboard lock and adds a regression check that rejects a shared Next resolution below the floor."

