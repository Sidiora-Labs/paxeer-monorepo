[issue.1658]
number = 1658
title = "Markets stream drops valid snapshots with nullable feed metrics"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The validation introduced by commit 34996678dbe2feb1b2e5866e0f08d91879088fc4 still rejects null at apps/perps/src/hooks/perps/useMarketsStream.ts:290 and drops the snapshot at :359, although services/platform/perps-data/internal/records/records.go:71, :72 and :80 declare nullable price, change_24h and last_updated, services/platform/perps-data/internal/feeds/topics.go:1137 and :1177 preserve unavailable opening-fill change independently of price, volume and open interest populated at :1221, spec/release-v6-12-0/contracts/data-services.md:471 and :473 require that nullability, and apps/perps/src/widgets/markets/useMarketsRows.ts:43 and :55 discard or replace the available metrics while apps/perps/tests/proof_widgets.test.ts:275 incorrectly groups allowed nulls with malformed values."
close_comment = "Market snapshots with unavailable feed metrics are currently discarded, hiding otherwise available live data. The follow-up task preserves those snapshots, displays unavailable metrics explicitly, and retains malformed-value validation."

[task.18.1658.1]
title = "Issue #1658: Preserve markets snapshots with unavailable feed metrics"
status = "pending"
mode = "BUILD"
wave = 1
requires = []
reqs = ["181658.1"]
