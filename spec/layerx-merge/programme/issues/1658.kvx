interfaces = []
do_1 = "Align MarketSnapshot and normalizeMarket at apps/perps/src/hooks/perps/useMarketsStream.ts:35 and :330 with services/platform/perps-data/internal/records/records.go:67: represent the producer's price, change_24h and last_updated nulls explicitly, retain each available metric and the snapshot, and preserve exact funding null handling at apps/perps/src/hooks/perps/useMarketsStream.ts:302; reject malformed non-null numeric values and nulls in non-nullable numeric fields with the existing finite-value and sign rules instead of coercing them to zero."
do_2 = "Carry nullable price and change through MarketRow at apps/perps/src/widgets/markets/types.ts:10 and buildMarketsRows at apps/perps/src/widgets/markets/useMarketsRows.ts:35 without the zero substitution at :55; retain hasLiveData for accepted snapshots, make filterAndSort at :87 handle unavailable values deterministically, and update apps/perps/src/widgets/markets/MarketsTable.tsx:237, apps/perps/src/widgets/markets/MarketsHighlights.tsx:44 and :180 and apps/perps/src/page-modules/markets/index.tsx:365 to show unavailable values neutrally, exclude unavailable change from gainers and losers, and preserve available volume, open interest and funding when some or all rows contain allowed nulls."
do_3 = "Update the price-only projections at apps/perps/src/hooks/perps/useRealtimePrices.ts:35 and :83 and freshness scheduling at apps/perps/src/hooks/perps/usePriceFreshness.ts:16 to explicitly exclude unavailable prices without inventing zero or altering valid ticker prices, funding precision or expiry behavior; keep numeric-only PriceFlash inputs behind availability checks in the markets widgets."
do_4 = "Add TestMarketsNullableSnapshotsReachMountedView in services/platform/perps-data/internal/feeds/proof_websocket_test.go using the real migrated database, broker and gateway setup at :67 and the real socket crossing at :267; seed no-opening-fill, no-price and no-update-time states so the unchanged producer emits every documented nullable field individually and together, assert the raw frame nulls, and drive those frames through the actual markets stream into a mounted React markets table and highlights with the existing real DOM setup pattern at apps/perps/tests/repair-22-33-710.test.ts:154, without replacing the producer, transport, hooks or components."
do_5 = "Declare and register marketsNullableSnapshotsReachMountedView in apps/perps/tests/proof_widgets.test.ts, have the focused Go test invoke that consumer test and marketsRowsCrossExportsIntoTheRealTableWithoutStaleResults, and assert retained metrics, null-as-unavailable display, live readiness with some or all rows nullable, sorting and filtering, transitions to available values, and exact funding; separate the allowed-null cases from the malformed matrix at apps/perps/tests/proof_widgets.test.ts:272 while preserving every malformed non-null refusal, non-nullable-field null refusal, negative-value check, zero-value check and sibling-row isolation assertion."
symbols = ["MarketSnapshot", "normalizeMarket", "MarketRow", "buildMarketsRows", "filterAndSort", "MarketsTable", "selectRows", "HighlightList", "FundingTabPanel", "tickerFromSnapshot", "useRealtimePrices", "usePriceFreshness", "TestMarketsNullableSnapshotsReachMountedView", "marketsNullableSnapshotsReachMountedView", "marketsRowsCrossExportsIntoTheRealTableWithoutStaleResults"]
