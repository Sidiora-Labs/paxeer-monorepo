[issue.1809]
number = 1809
title = "[Coherence] The SDK manifest promotes ed25519-dalek and layerx-programs-registry to normal dependencies without refreshing the three independent lockfiles that build layerx-sdk by path, so their --locked gates now refuse to resolve"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit 9047673955751d4432b10880ed5e98b6e52b2c5c repaired the missing SDK dependency edges now present at services/agent/tests/parity/Cargo.lock:918, services/agent/tests/qualify/Cargo.lock:805 and services/agent/qualification/pay2/Cargo.lock:1045, but services/agent/crates/layerx-sdk/Cargo.toml:35 still declares the test-only registry as a normal dependency contrary to services/agent/crates/layerx-sdk/tests/repair_22_31_563.kvx:11 and its use at services/agent/crates/layerx-sdk/tests/repair_22_31_563.rs:461, while services/agent/crates/layerx-sdk/src/native_effect.rs:143 requires Ed25519 signing at runtime."
close_comment = "The parity, qualify and pay2 lockfiles now contain both SDK dependency edges. A follow-up will restore the registry to test dependencies while retaining Ed25519 signing support and keeping SDK consumer lockfiles consistent."

