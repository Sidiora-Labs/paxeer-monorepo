[issue.1599]
number = 1599
title = "[Coherence] Task 5.99.1 traces to an acceptance scenario about sequencer proposer checks, not the programs ABI switch"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "spec-edit"
evidence = "The done task 5.99.1 and its capability still reference 5004.1 (spec/layerx-merge/spec.kvx:302473, spec/layerx-merge/spec.kvx:302477, spec/layerx-merge/spec.kvx:67861), whose acceptance checks proposer membership (spec/layerx-merge/spec.kvx:108413), although node/upgrades.go:499 persists ABI 5, node/app.go:664 restores the selection, and node/upgrades_merge_programs_abi_test.go:209 and node/upgrades_merge_programs_abi_test.go:248 assert the switch and restart behaviour, while done task 9.98.4 references 9998.1 (spec/layerx-merge/spec.kvx:205559, spec/layerx-merge/spec.kvx:205563) without any acceptance block for that requirement despite implemented paymentDenom fixtures (services/agent/crates/layerx-agentd/src/ops/program.rs:2567); the spec must link both 5.99.1 blocks to a dedicated acceptance criterion covering ABI-4 defaults, the merge switch to ABI 5 and restart persistence, retain 5004.1 for proposer membership, and add the missing 9998.1 acceptance scenario for daemon receipt fixtures carrying paymentDenom."
close_comment = "The ABI switch and restart persistence are implemented, but their acceptance links still point to the proposer membership scenario. This is a specification correction: give task 5.99.1 and its capability a dedicated ABI acceptance criterion, and add the missing acceptance scenario for the paymentDenom receipt fixtures of task 9.98.4."
