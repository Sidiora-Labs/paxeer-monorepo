[issue.1662]
number = 1662
title = "[P2] Register the nine wallet repair callbacks with Vitest"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "services/wallet/gateway/test/repair-22-33-181.test.ts:8 and services/wallet/gateway/test/repair-22-33-209.test.ts:12 import Vitest, but their registrations at services/wallet/gateway/test/repair-22-33-181.test.ts:920 and services/wallet/gateway/test/repair-22-33-209.test.ts:601 supply names without handlers, which Vitest 4.1.12 pinned at services/wallet/pnpm-lock.yaml:377 collects as TODO, leaving the done claims introduced by commits c77f39374a80245d57198e0697af704e8656c32e and 1f3cc634eaff47f0db04eddf4f18c1652fd19dbe without executed proofs from these nine tests."
close_comment = "The nine wallet repair proofs still collect as TODO because their callbacks are not registered. Register each callback with its existing timeout and require nine passing tests with zero TODO or skipped entries before treating these suites as repair evidence."

[task.18.1662.1]
title = "Issue #1662: Register and execute all nine wallet repair proofs"
