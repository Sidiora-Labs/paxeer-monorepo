[issue.1634]
number = 1634
title = "[P2] Keep state-size scanning after the memiavl true-to-stop change"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "Commit 7776fa009cdb31ed4b6a5f9c085a8d03574a658a remains effective at storage/state_db/sc/memiavl/tree.go:269, where a true callback stops scanning, but storage/tools/cmd/paxdb/operations/state_size.go:196 still returns true after the first leaf, truncating the totals accumulated at state_size.go:159, prefix counts at state_size.go:176 and contract totals at state_size.go:185 before console output at state_size.go:323 or DynamoDB analysis at state_size.go:375, contrary to the unchanged two-key assertions at storage/tools/cmd/paxdb/operations/repair_m1177_test.go:155 and repair_m1177_test.go:169."
close_comment = "The state-size visitor still stops after the first leaf, undercounting module bytes, prefixes and contracts. A focused repair is tracked to scan every leaf while preserving exporter cancellation and the existing module inventory assertions."

