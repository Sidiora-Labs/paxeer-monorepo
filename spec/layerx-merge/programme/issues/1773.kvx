[issue.1773]
number = 1773
title = "[Coherence] The new delta charge lets the execution observer hold far more than its 64 MiB bound, because every boundary still keeps a full copy of linear memory"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The delta substitution introduced by commit 41f31ec2fc56cb9c9b2939d5b7013037f6c8f63d remains at programs/vendor/wasmi-0.31.2/src/store.rs:233 and :247, whereas src/engine/executor.rs:710 and :743 under the same crate capture complete linear memory and instance states retained by store.rs:291 and :1092 until programs/crates/layerx-programs-runtime/src/execute.rs:1483 or :1692, so the 64 MiB byte/work ceilings configured at execute.rs:1474 and :1659 undercount retained allocations before the post-call peak check at execute.rs:891."
close_comment = "Trace and boundary-witness capture can retain full memory snapshots while charging only changed pages, allowing retained allocations to exceed the 64 MiB limit. The repair will enforce allocation and work bounds before retaining each full snapshot while preserving compact replay records and their existing limits."

[task.18.1773.1]
