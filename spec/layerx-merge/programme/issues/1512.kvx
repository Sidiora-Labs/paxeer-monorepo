[issue.1512]
number = 1512
title = "[P2] Update retained test-log after retired log append kinds are refused"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Makefile:1400 and Makefile:1404 retain the log test whose loop at tests/storage/lxp_test_log.c:32 requires successful appends for kinds 1..9, so kind 3 returns 1 before the checks at tests/storage/lxp_test_log.c:39, while src/storage/lxp_log.c:34 and src/storage/lxp_log.c:420 intentionally refuse kinds 3, 6, 8 and 9 before writing under spec/layerx-merge/spec.kvx:812 (decision.124); commit b46c2a694a019fe8dc72c1e8ac6f7b3b183db301 changed the append contract without changing this test, task.16.32.12 at spec/layerx-merge/spec.kvx:205116 covers other suites, and tests/codec/lxp_test_log_kinds.c:97 already produces historical bytes for the read regression at tests/codec/lxp_test_log_kinds.c:171."
close_comment = "The retained log test still expects retired record kinds to append successfully and exits before its sequence-exhaustion and corruption checks. A focused test repair will cover admitted appends and retired-kind refusals while preserving the existing safety checks and historical-record readability."

