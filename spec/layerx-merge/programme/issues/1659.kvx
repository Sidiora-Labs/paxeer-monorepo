[req.181659]
title = "Held-job diagnostics preserve database outage recovery for price acceptance replay"
ac_1 = "Given the replay callback at services/explorer/backend/apps/indexer/lib/indexer/fetcher/paxeer_x/price_acceptance_replay.ex:34 and the database diagnostic at services/explorer/backend/apps/explorer/priv/repo/migrations/scripts/price_acceptance_backfill.exs:25, a diagnostic query failure during startup or a subsequent replay leaves the original runner and backfill worker alive, preserves durable progress and the configured retry interval, and allows timer-driven replay to finish after database recovery while successful diagnostics retain the warning details and one-minute throttle at price_acceptance_replay.ex:55."

[acceptance.18.1659.1]
feature = "18"
req = "181659.1"
scenario = "Given real durable price acceptance jobs and a running replay worker, when database queries temporarily fail on initial replay with a nil warning timestamp or during a later due diagnostic and then recover, then the same worker survives, retries on its configured interval, preserves durable progress during the outage, completes replay after recovery and retains useful throttled held-job warnings."
contract = "contracts/explorer-indexer.md#paxeer-x-ingestion"
test = "services/explorer/backend/apps/explorer/test/repair/repair_22_31_490_test.exs::replay_database_outage_recovers and replay_held_warnings_survive_database_outage (planned)"
