[issue.1659]
number = 1659
title = "Replay held-job diagnostic bypasses retry handling during database outages"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The diagnostic introduced by commit bbfe819c82aa62bccf0821cf2232131f78821327 remains unprotected: services/explorer/backend/apps/indexer/lib/indexer/fetcher/paxeer_x/price_acceptance_replay.ex:36 invokes log_held_jobs before the retry timer at line 47, its held_jobs call at line 56 reaches Repo.query! at services/explorer/backend/apps/explorer/priv/repo/migrations/scripts/price_acceptance_backfill.exs:26 outside the run_step rescue at line 69, and immediate replay at price_acceptance_replay.ex:20 plus transient restart at line 6 under services/explorer/backend/apps/indexer/lib/indexer/fetcher/paxeer_x/price_updates_supervisor.ex:29 can repeat the failure; services/explorer/backend/apps/explorer/test/repair/repair_22_31_490_test.exs:119 covers node failures and warning throttling but no database outage."
close_comment = "A failed held-job query can terminate price acceptance replay before its retry timer is scheduled. A repair is required to keep diagnostics non-fatal during database outages, preserve useful held-job warnings and verify recovery on the scheduled retry."

[task.18.1659.1]
title = "Issue #1659: Preserve price acceptance replay retries when held-job diagnostics fail"
status = "pending"
mode = "BUILD"
wave = 1
