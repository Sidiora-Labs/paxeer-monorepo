[issue.1923]
number = 1923
title = "[Coherence] No per-crate task covers the layerx-agentd example target, so the final whole-workspace task still meets its lints"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The split introduced by commit 016028d4d52f5a21537f09c55c2f765d34bed486 still omits the example at services/agent/crates/layerx-agentd/examples/review_audit_export.rs:6, auto-discovered by services/agent/crates/layerx-agentd/Cargo.toml:1: task 22.39.222 is pending at spec/layerx-merge/spec.kvx:187361, owns only src at spec/layerx-merge/spec.kvx:187372 and lints only --lib at spec/layerx-merge/spec.kvx:187376, the four groups select only tests at spec/layerx-merge/spec.kvx:187163, spec/layerx-merge/spec.kvx:187193, spec/layerx-merge/spec.kvx:187223 and spec/layerx-merge/spec.kvx:187253, and the later decision 3057 at spec/layerx-merge/spec.kvx:11457 leaves this omission intact, so Makefile:1997 still first includes the example in the final lint task whose cross-member repair restriction remains at spec/layerx-merge/spec.kvx:187634; Makefile:2380 checks the example without Clippy and does not settle the lint coverage gap."
close_comment = "The audit reviewer example is still missing from the daemon's per-crate lint coverage. The correction will include examples in the daemon library task's build, lint command and owned paths, with a regression check that preserves coverage before the final lint target."

