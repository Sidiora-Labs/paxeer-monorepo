[issue.1929]
number = 1929
title = "[P2] Reconcile contradictory empty-config requirements in perps repair plans"
revision = "86ae60188357c8c436f0f6e5deac9888cdfd2160"
verdict = "task"
evidence = "spec/layerx-merge/programme/issues/1802.kvx:18 and :40 require null for an absent key and endpoint while spec/layerx-merge/programme/issues/1803.kvx:19 and :41 require rejection for the same environment cleared by apps/perps/tests/embedded-wallet.test.ts:30, and the conflict persists in spec/layerx-merge/spec.kvx:160015 and :159985 despite both tasks now being pending in wave 2 with the type-resolution dependency at :160011 and :159980; apps/perps/tests/repair-22-31-603.test.ts:24 supplies a nonempty key for its endpoint-refusal assertions at :43, so the plans can preserve that refusal and the disabled-wallet contract documented at apps/perps/src/core/wallet/embedded/client.ts:49 without restoring the default endpoint prohibited by decision 2755 at spec/layerx-merge/spec.kvx:9645."
close_comment = "The repair plans still prescribe different results for an entirely unconfigured embedded wallet. Task 18.1929.1 reconciles their configuration matrix and final regression coverage: disabled and server wallets return null, injected wallets remain available, and enabled wallets require an explicit endpoint."

