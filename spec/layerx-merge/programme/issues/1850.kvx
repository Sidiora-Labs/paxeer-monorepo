[req.181850]
title = "Autobahn integration has Docker before cluster setup and indirect consumers cannot bypass routing checks"
ac_1 = "The Autobahn job at .github/workflows/paxeer-go-test.yml:185 uses Docker-capable hosted ubuntu-24.04 for internal and fork events, has a docker-command routing exclusion and matching hosted-job assertions instead of the incompatible routed-job assertion at tests/ci/test_workflow_runs_on_routed.py:110, and preserves the Make entrypoint at .github/workflows/paxeer-go-test.yml:201 and all existing TestAutobahn assertions."
ac_2 = "The checker at scripts/ci/runner-routing-check.sh:120 identifies the real Make to Go to Docker dependency at chain.mk:530, tests/integration/autobahn/autobahn_test.go:215 and chain.mk:426, rejects that command on a routed Dockerless job, and accepts the explicitly excluded hosted Autobahn job without weakening any existing runtime check."

