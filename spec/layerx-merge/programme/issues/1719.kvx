[issue.1719]
number = 1719
title = "Restore token category filters on browser history navigation"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "apps/explorer/ui/pages/Tokens.tsx:44 initializes tokenTypes only on mount, :52 and :93-107 use that state for the API filter and selected category, and :201-203 keys TokensContent only by bridged/all, so the category handler at :77-80 and :109-125 pushes history through apps/explorer/ui/shared/pagination/useQueryWithPages.ts:227-257 but Back from NFT to Fungible leaves the NFT selection and API filter active; apps/explorer/ui/tokens/repair-22-35-5.spec.tsx:71-89 tests forward clicks using the router at apps/explorer/ui/shared/layout/testWrapper.tsx:75-96, whose push and history methods never navigate."
close_comment = "Browser Back and Forward can restore a token category URL while leaving a different category selected and queried. The follow-up repair will restore the selected chip and API filter together, preserve search, sorting and bridged views, and avoid extra requests or history entries."

