[issue.1749]
number = 1749
title = "[Coherence] The reopen test proves 'no second transfer' with a payout effect it builds itself, not the effect the replay produced"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "programs/crates/layerx-programs-ai-market/tests/repair_22_33_261.rs:1487 still constructs AlreadyApplied rather than observing the replay effect and :1493 only rereads records written at :1353, while programs/crates/layerx-programs-ai-market/src/value_adapter.rs:230 maps that variant to None (although :249-283 validates the supplied ledgers), and programs/crates/layerx-programs-ai-market/tests/rewards_native.rs:2652 delegates Claim/Refund restart coverage to this test before checking only Fund replay at :2687-2713."
close_comment = "The restart check does not yet prove that Claim and RefundFree leave recipient balances unchanged on replay. A focused repair will check production reward replay outcomes and native persisted balances to prove that each payout occurs once."

[task.18.1749.1]
title = "Issue #1749: Prove Claim and RefundFree replay preserves recipient balances after reopen"
status = "pending"
mode = "BUILD"
wave = 1
requires = []
reqs = ["181749.1"]
capabilities = []
interfaces = []
do_1 = "In programs/crates/layerx-programs-ai-market/tests/repair_22_33_261.rs:1407-1498 replace the constructed AlreadyApplied effect at :1487 with assertions on the production reward replay outcomes for the stored Claim and RefundFree requests against reopened state; derive any effect passed to value_adapter::plan from RewardState::claim or RewardState::refund_free, preserving their distinct AlreadyApplied and RepeatedRefund variants, and compare with rewards::apply through epoch::carry_reputation and dispatch rather than inventing an effect from a result digest. Preserve the joint F07 region, existing ledger, result, event and row assertions, and the BAD_VERSION check at :1280; rewards::Outcome::AlreadyApplied carries only a subject at src/rewards.rs:2520, so do not assume it exposes an effect."
do_2 = "Add reward_reopen_preserves_recipient_balances in programs/crates/layerx-programs-ai-market/tests/rewards_native.rs beside native_recovery_and_capacity at :2651, invoking the repaired reward_native_reopen and using routed lifecycle and settlement producers to commit a Claim of 100 and RefundFree of 400 through the deployed guest; extend tests/programs/test_ai_host_boundary.c:829 and its command handling at :961 with a focused prove_reward_replay operation that snapshots the actual kernel store, destroys and reopens it, and replays the identical request after discarding the original reply. Assert the first payouts increase the actual recipients' bank balances by exactly 100 and 400, then assert unchanged recipient and rewards-account balances, retained result identities, reward rows and no new payout events after reopen and replay; observe production receipts and bank state, never test-written plan keys or a simulated balance counter. Keep transaction fees separate from recipient payout deltas and retain the existing Fund recovery assertions."
symbols = ["reopen_recovery_store", "reward_native_reopen", "reward_reopen_preserves_recipient_balances", "reopen_store", "prove_reward_replay"]
touches = ["programs/crates/layerx-programs-ai-market/tests/repair_22_33_261.rs", "programs/crates/layerx-programs-ai-market/tests/rewards_native.rs", "tests/programs/test_ai_host_boundary.c"]
