number = 1921
title = "[Coherence] New selectors point at manifest lines, Makefile targets and doc tokens, the same kind of label this commit retires as not a test"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "not-relevant"
evidence = "The demand to replace or retire all non-test references contradicts decision 2194's document-check rule and decision 3045's ownership-and-path coverage rule (spec/layerx-merge/spec.kvx:6279, spec/layerx-merge/spec.kvx:11385), with command-to-document replacements explicitly required at spec/layerx-merge/spec.kvx:350606 and implemented by spec/layerx-merge/programme/parity.py:357 and spec/layerx-merge/programme/parity.py:373; the cited references remain at spec/layerx-merge/spec.kvx:334212, spec/layerx-merge/spec.kvx:334220, spec/layerx-merge/spec.kvx:334276, spec/layerx-merge/spec.kvx:334292, spec/layerx-merge/spec.kvx:396440, spec/layerx-merge/spec.kvx:396536 and spec/layerx-merge/spec.kvx:409466, while the full KMS and identity-provider scan/compilation and seventeen-workspace metadata obligations remain at spec/layerx-merge/spec.kvx:214098 and spec/layerx-merge/spec.kvx:214383, and the seventeen-workspace acceptance is 13.8.3 rather than 13.8.4 (spec/layerx-merge/spec.kvx:334287)."
close_comment = "The current specification permits manifest, Makefile and documentation references as document checks; their presence does not assert that they are executable tests. The full clock-scan, compilation and workspace-metadata obligations remain in the associated verification commands, so these references require no replacement or retirement under the current coverage rules."
