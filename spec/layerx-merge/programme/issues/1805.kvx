[issue.1805]
number = 1805
title = "[Coherence] Removing the two reconcile paragraphs leaves the interface rows for usePerpsMarkets and useSpotTokenState stale with nothing in the spec still tracking the fix"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "spec-edit"
evidence = "Tasks 22.33.711 and 22.33.712 are done at spec/layerx-merge/spec.kvx:162800 and spec/layerx-merge/spec.kvx:162761 despite reconciliation proposals at spec/layerx-merge/spec.kvx:162812 and spec/layerx-merge/spec.kvx:162774 and stale served signatures at spec/layerx-merge/interfaces.kvx:69455 and spec/layerx-merge/interfaces.kvx:69465 mirrored at spec/layerx-merge/contracts/perps-client.md:1347 and spec/layerx-merge/contracts/perps-client.md:1348; commit 96a60cd23e106e010c8a54d0bc0bc7924e5cfa59 removed the contract requests but apps/perps/src/hooks/perps/repair-22-33-711.kvx:23 still records one, so the spec must distinguish completed hook documentation from outstanding registry reconciliation and describe usePerpsMarkets() returning catalog/tradeable/isLoading/error/refetch and useSpotTokenState(token: Address, native?: boolean): SpotTokenStateResult returning nullable state/error as implemented at apps/perps/src/hooks/perps/usePerpsMarkets.ts:67 and apps/perps/src/hooks/spot/useSpotTokenState.ts:45, documented at contracts/perps-client.md:126 and contracts/perps-client.md:218, and asserted at apps/perps/tests/repair-22-33-711.test.ts:698 and apps/perps/tests/repair-22-33-712.test.ts:879."
close_comment = "This is specification drift: the interface registry and generated contract table must describe usePerpsMarkets() returning catalog, tradeable, isLoading, error and refetch, and useSpotTokenState(token: Address, native?: boolean) returning nullable state and error fields. The completed repair records must distinguish the corrected hook documentation from outstanding registry reconciliation; a reconciliation request still exists in the perps repair record."
