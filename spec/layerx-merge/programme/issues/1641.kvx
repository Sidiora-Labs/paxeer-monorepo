[issue.1641]
number = 1641
title = "[P3] Rebind transfer metric instruments when repeating MetricContract"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The test introduced by commit 044c26f529733b3073e685c1d3e4ed16a014e9e4 still installs and shuts down a fresh provider at interchain/modules/apps/transfer/keeper/repair_m1205_test.go:153 and collects its reader at :216 before requiring all four instruments at :270, but interchain/modules/apps/transfer/keeper/metrics.go:9 creates the keeper meter and instruments only at initialization, so the one-time delegation in OpenTelemetry v1.45.0 (pinned at go.mod:94; upstream internal/global/state.go:145 and internal/global/meter.go:36) leaves subsequent readers without those instruments."
close_comment = "The transfer metric contract still uses instruments bound to the first provider, so a repeated invocation cannot collect its own transfer metrics. A focused repair must bind the keeper instruments to each invocation's provider, restore the replaced state during cleanup, and retain every existing transfer and metric assertion."

