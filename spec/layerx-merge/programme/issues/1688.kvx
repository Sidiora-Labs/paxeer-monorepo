[issue.1688]
number = 1688
title = "[Coherence] An invalid RPC override now throws while rpc.ts loads, so the new RpcConfigurationError never reaches backendConfigurationProblems or the configuration error page"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "apps/launchpad/web/src/core/rpc.ts:54 eagerly calls the rejecting resolver at rpc.ts:39 through rpc.ts:47, so the import at apps/launchpad/web/src/core/backend-origins.ts:23 throws before its catch at backend-origins.ts:157 can supply the configuration error branch at apps/launchpad/web/src/app/layout.tsx:38, while apps/launchpad/web/src/core/repair-22-33-900.test.ts:9 imports the resolver before invalid overrides are set at repair-22-33-900.test.ts:426."
close_comment = "Invalid RPC overrides still abort startup before the configuration error page can explain the problem. The repair task defers RPC-dependent initialization and adds regression coverage with invalid overrides present before the first import, while retaining strict endpoint validation."

[task.18.1688.1]
title = "Issue #1688: Report invalid RPC overrides before initializing wallet transports"
status = "pending"
mode = "BUILD"
wave = 1
