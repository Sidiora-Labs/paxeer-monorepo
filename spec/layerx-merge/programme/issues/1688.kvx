touches = ["apps/launchpad/web/src/core/rpc.ts", "apps/launchpad/web/src/core/wagmi-config.ts", "apps/launchpad/web/src/core/wallet-sdk/client.ts", "apps/launchpad/web/src/core/rpc-configuration.test.tsx"]
