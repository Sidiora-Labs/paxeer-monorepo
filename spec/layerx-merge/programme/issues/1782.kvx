verdict = "task"
evidence = "Commit 2f9f630e948446e646f997ba55cc8bbb8652ac35 deleted apps/wallet/public/Untitled design.svg, but services/platform/hosted/gateway/src/ui_proxy.rs:875 still allows its path through asset at :236 and admitted at :297, tools/paxeer-x/route-catalogue.json:20264 and :20287 still advertise its GET and HEAD routes with the upstream health contract at :20273 and :20296, and rpc/px_route_catalogue.json:17253 and :17273 still publish those routes through the catalogue embedded at rpc/px_discovery.go:58 and returned at :66."
close_comment = "The deleted wallet image still has public GET and HEAD routes in the gateway and discovery catalogues. The follow-up fix removes those stale entries, regenerates the node catalogue and adds regression coverage while preserving supported wallet assets."

