[req.181562]
title = "AI market receipts accept supported authority-bearing terminals with all receipt and transfer bindings preserved"
ac_1 = "Given ordinary and authority-bearing results produced by the Programs runtime, including the authority-before-occupancy order at programs/crates/layerx-programs-runtime/src/ffi_call.rs:3409, the AI market decoder at services/agent/sdk/typescript/src/ai_market.ts:3265 accepts canonical supported results and refuses malformed, reordered, oversized or mismatched authority data while retaining applied-leg, signature, transaction, log, terminal-kind and guest-capacity validation; a real ABI5 reward receipt resolves through OperationJournal.resolve at :3069 and remains executed after reopen, while refused receipts remain unresolved."

[acceptance.18.1562.1]
feature = "18"
req = "181562.1"
scenario = "Given a real ABI5 AI reward operation with a transfer-authority terminal and an ordinary no-transfer operation, when their signed sequencer receipts pass through the AI market decoder and journal, then both valid operations resolve and survive journal reopen, while malformed wrappers or mismatched authority, applied legs, signatures, transactions, logs, terminal kinds or guest response capacities are refused without resolving the journal."
contract = "contracts/agent-ts-sdk.md#ai-market"
