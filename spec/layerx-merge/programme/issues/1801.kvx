[issue.1801]
number = 1801
title = "[Coherence] The SSH test image fixtures in litt/util/testdata are orphaned now that the only code that read them is deleted, and the container scope list still records the Dockerfile as a reviewed fixture"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit 0f1630509434f756929cb1168951cd248e5a6757 deleted the commented BuildSSHTestImage consumer, and current SSH tests use the local receiver at storage/db_engine/litt/util/ssh_test.go:19 and storage/db_engine/litt/util/repair_114_test.go:321, but the obsolete image still copies its startup script at storage/db_engine/litt/util/testdata/ssh-test.Dockerfile:39, that script still starts sshd at storage/db_engine/litt/util/testdata/start.sh:4, and the Dockerfile remains in the container exclusion list at tools/containers/check.sh:132 and its exact-list assertion at tools/containers/test_out_of_scope_list.py:54."
close_comment = "The obsolete Docker-based SSH fixtures have no remaining consumer; the current SSH tests use a local OpenSSH receiver. The follow-up task removes both fixtures and the stale container exclusion while retaining the scope-list checks."

