[issue.1803]
number = 1803
title = "[Coherence] The existing embedded-wallet test still expects the removed default endpoint and a null result when nothing is configured"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "apps/perps/tests/embedded-wallet.test.ts:72 and :90 omit the endpoint, :81 and :108 require the removed default origin, and :100 expects null for empty browser configuration, contradicting the endpoint refusal at apps/perps/src/core/wallet/embedded/client.ts:29 and the existing refusal assertions at apps/perps/tests/repair-22-31-603.test.ts:43 introduced by commit 8a2e6447fb97f400ce1f6e8252587d5fa4a23f46."
close_comment = "The embedded-wallet regression still assumes a default endpoint and a null result for missing browser configuration. Update its assertions to the explicit-endpoint contract while preserving coverage for disabled and server-side configurations."

