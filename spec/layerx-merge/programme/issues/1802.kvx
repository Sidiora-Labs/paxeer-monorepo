[req.181802]
title = "A disabled embedded wallet leaves injected wallets available"
ac_1 = "Given a browser with no publishable key or an empty publishable key, when the endpoint is absent, empty, whitespace-only or configured, resolvePaxeerConfig and getPaxeerWallet at apps/perps/src/core/wallet/embedded/client.ts:26 and :62 return null and the real wagmiConfig at apps/perps/src/core/wagmi.ts:50 initializes with the injected connector and no embedded connector; server resolution remains null, while an enabled embedded wallet with an absent, empty or whitespace-only endpoint still throws an error naming NEXT_PUBLIC_PAXEER_WALLET_API and a configured enabled wallet still uses its explicit endpoint."

