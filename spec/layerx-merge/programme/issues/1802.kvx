[issue.1802]
number = 1802
title = "[Coherence] The perps app now crashes at startup in the browser when the embedded-wallet endpoint is unset, which also takes down injected wallets"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The endpoint throw introduced by commit 8a2e6447fb97f400ce1f6e8252587d5fa4a23f46 remains at apps/perps/src/core/wallet/embedded/client.ts:30 before the disabled-feature return at :51, so getPaxeerWallet at :63 aborts browser connector construction at apps/perps/src/core/wagmi.ts:36 before injected at :47 and module-level configuration at :50, while apps/perps/src/core/wallet/embedded/PaxeerProvider.tsx:227 also evaluates the throwing resolver, apps/perps/Dockerfile:33 and apps/perps/deploy/docker-compose.yml:33 default the endpoint to empty, and apps/perps/tests/repair-22-31-603.test.ts:24 supplies a publishable key in the existing refusal coverage at :37."
close_comment = "The missing endpoint currently prevents wallet startup even when the embedded wallet is disabled, blocking injected wallets as well. The fix is tracked in task 18.1802.1: return the disabled state before validating the endpoint, while retaining the named configuration error when the embedded wallet is enabled without an endpoint."

