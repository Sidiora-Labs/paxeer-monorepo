[issue.1890]
number = 1890
title = "[Coherence] RELEASE.md still says the rehearsal script only rehearses the v6.12.0 plan, which contradicts the newly closed D6"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "RELEASE.md:136 still names only v6.12.0 and RELEASE.md:149 excludes other plans, contradicting the D6 support recorded by commit cc3d81fa233eff7273b4b57faf7f6fe0391569fd at docs/release/7.0.0-upgrade-plan.md:253, the v7.0 identity at tools/release/version.json:2, the plan selection and required --plan-info at tools/release/rehearse-v6120.sh:185 and tools/release/rehearse-v6120.sh:189, the validated forwarding at tools/release/rehearse-v6120.sh:240 and tools/release/rehearse-v6120.sh:259, and the corresponding assertions at tests/ci/test_release_merge_rehearsal.py:117, tests/ci/test_release_merge_rehearsal.py:151 and tests/ci/test_release_docs_gap_markers.py:91."
close_comment = "The rehearsal script reads its upgrade plan from tools/release/version.json and requires validated --plan-info for v7.0, but RELEASE.md still describes a v6.12.0-only rehearsal. The follow-up documentation task aligns the rehearsal instructions with that behavior and removes the obsolete plan restriction."

