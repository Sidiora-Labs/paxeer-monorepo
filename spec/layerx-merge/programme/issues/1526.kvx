[issue.1526]
number = 1526
title = "[Coherence] OpenTelemetry core is pinned below the exact version the raised Jaeger propagator requires"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "apps/explorer/package.json:219 still forces core 2.8.0 and apps/explorer/package.json:227 forces Jaeger 2.9.0, whose exact core 2.9.0 dependency at apps/explorer/yarn.lock:6821 is resolved together with incompatible 1.x and ^2.9.0 selectors to 2.8.0 at apps/explorer/yarn.lock:6328, while tools/deps/floors/explorer-web.json:12 sets only a 2.8.0 minimum and tools/deps/lockfloor.py:293 checks that minimum without checking dependent ranges."
close_comment = "Confirmed: the explorer forces OpenTelemetry core 2.8.0 onto Jaeger 2.9.0 and older consumers with incompatible dependency ranges. A follow-up task will align the telemetry dependencies and add a compatibility regression test while preserving the security minimums."

