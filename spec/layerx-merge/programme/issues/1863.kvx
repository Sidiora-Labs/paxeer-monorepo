[issue.1863]
number = 1863
title = "[Coherence] The routed-runner test still requires runs-on on the three Platform release gate jobs, which are now reusable-workflow calls without one"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The reusable calls introduced by commit 775a34c6ff79efe75976ba3dba4d1ea2376f7802 remain at .github/workflows/platform.yml:417, .github/workflows/platform.yml:423 and .github/workflows/platform.yml:429 without runs-on, while tests/ci/test_workflow_runs_on_routed.py:21 still lists all three and tests/ci/test_workflow_runs_on_routed.py:113 directly indexes their missing runs-on key, causing KeyError instead of checking the concrete jobs whose routed runners are at .github/workflows/programs-conformance.yml:68, .github/workflows/agent.yml:160 and .github/workflows/agent.yml:222."
close_comment = "The routing regression test still reads runs-on from three reusable-workflow callers, so those cases fail before checking their concrete jobs. Follow each caller to its owning job and preserve the exact routed-runner and exclusion checks."

