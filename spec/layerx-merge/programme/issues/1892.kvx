[issue.1892]
number = 1892
title = "[Coherence] The new qualification finding for task 22.39.117 names the chain read-adapter test as its file and symbol, but the failure it records is in the shared/redis package"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Commit e418f06937b55373d7365307e91ae0c0687e7c55 introduced finding 22.39.117.4, whose file and symbol still name the chain test at spec/layerx-merge/qualification.kvx:36400 and spec/layerx-merge/qualification.kvx:36401 despite its Redis-only failure description at spec/layerx-merge/qualification.kvx:36402; the same chain identifiers appear in the earlier finding at spec/layerx-merge/qualification.kvx:36296 and spec/layerx-merge/qualification.kvx:36297, while the actual namespace checks belong to TestRealRedisPrimitives at sdk/launchpad/shared/redis/primitives_test.go:37 and sdk/launchpad/shared/redis/primitives_test.go:44, TestRealRedisAbsentFloorAndEncodedBound at sdk/launchpad/shared/redis/primitives_test.go:141 and sdk/launchpad/shared/redis/primitives_test.go:148, and TestRealPolicySnapshotOrdering at sdk/launchpad/shared/redis/snapshot_policy_test.go:31 and sdk/launchpad/shared/redis/snapshot_policy_test.go:38, rather than TestPhase2ReadAdapterRealRegisteredPool at sdk/launchpad/shared/chain/client_test.go:569."
close_comment = "Finding 22.39.117.4 incorrectly attributes the Redis namespace failures to the chain read-adapter test. Task 18.1892.1 corrects the file and symbol to the Redis primitives test and identifies the other affected Redis cases while preserving the recorded result."

