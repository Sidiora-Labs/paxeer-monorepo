number = 1540
title = "[Coherence] The new absence test names lxp_ledger_apply_bridge_credit, so the kernel-suite retired-uses CI check now fails"
revision = "0f3fe6b8c5c1973c0e80408097cf66e06e40785f"
verdict = "already-fixed"
evidence = "Commit 55809ad556ff91001640a687861acd09351c811e removes the bridge-credit implementation, but spec/layerx-merge/spec.kvx:14581 requires the weak-reference absence proof at tests/codec/lxp_test_ledger_bridge_credit_absent.c:4, :8 and :21, while spec/layerx-merge/spec.kvx:27198 forbids every kernel-test mention and tests/ci/test_kernel_suite_retired_uses.py:6-23 and :76-77 reject those references plus the retirement inventory at tests/codec/lxp_test_kernel_complete.c:941; the owner must choose between these incompatible retirement contracts before either check can change without weakening its requirement."
close_comment = "The owner ruled that the weak-reference absence proof governs the bridge-credit retirement; the retired-uses check excludes the two absence proofs as named product literals since 22.31.501 and passes on the current main line, so no further change is needed."
