[issue.1550]
number = 1550
title = "[Coherence] The added recipient, spending limit and expiry on version-1 budgetCreate disclosures break two existing tests that still assert the old shape"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "The version-1 binder discloses Transfer, Recipient, SpendingLimit and expiry at services/agent/crates/layerx-crypto/src/disclosure/call.rs:770-790 and its constructor test asserts them at services/agent/crates/layerx-crypto/tests/disclosure_call.rs:758-766, while commit 9b9f71f043fd795a16f6d408368c9103d1e64c59 corrected the crypto amount assertions retained at services/agent/crates/layerx-crypto/tests/budget_call.rs:108-112, but services/human/crates/layerx-intents/tests/budget_payloads.rs:245-248 still expects one amount and no counterparties, leaving a defect distinct from the corrected crypto-only claim in issue #1559 (spec/layerx-merge/programme/issues/input/1559.md:40)."
close_comment = "The crypto payload-rule test already checks both disclosed amounts. Task 18.1550.1 tracks the remaining correction to the intents budget-create test so it checks the recipient, transfer, spending limit and expiry while preserving its rejection checks."

