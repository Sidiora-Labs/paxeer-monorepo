[issue.1697]
number = 1697
title = "[Coherence] The services contract still describes the old unauthenticated publisher-backed dead-letter routes and status that is always ok"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "contracts/services.md:68 still promises publisher-only, unauthenticated, destructive dead-letter routes and healthy status after read failures, contradicting canonical/legacy reads and HTTP 503 handling at services/launchpad/indexer/internal/httpapi/status.go:63 and services/launchpad/indexer/internal/httpapi/status.go:128, unconditional policy-backed routes at services/launchpad/indexer/internal/httpapi/status.go:135, authentication, durable audit and drain refusal at services/launchpad/indexer/internal/httpapi/deadletter.go:61, services/launchpad/indexer/internal/httpapi/deadletter.go:90 and services/launchpad/indexer/internal/httpapi/deadletter.go:103, and the assertions at services/launchpad/indexer/internal/httpapi/repair_m996_test.go:264, services/launchpad/indexer/internal/httpapi/repair_m996_test.go:319 and services/launchpad/indexer/internal/httpapi/repair_m996_test.go:368."
close_comment = "The services contract still describes the former publisher queue behavior. It needs to document canonical and legacy status, HTTP 503 failures and degradation, and authenticated, audited durable inspection with drain refused and no deletions."

