[issue.1527]
number = 1527
title = "[Coherence] Resolutions pin phoenix and js-cookie to one version, but the app ships another"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "apps/explorer/package.json:107 and :117 request caret ranges while :248 and :259 pin js-cookie 3.0.7 and phoenix 1.6.17, tools/deps/floors/explorer-web.json:41 and :52 record those floors, and apps/explorer/yarn.lock:18649 and :20406 resolve the direct selectors to 3.0.8 and 1.8.16 alongside the pinned entries at :18644 and :20401 consumed through apps/explorer/lib/cookies.ts:1 and apps/explorer/lib/socket/context.tsx:3."
close_comment = "The explorer still locks its direct Phoenix and cookie dependencies to different versions from its resolution pins. A follow-up task will align the direct dependencies and lockfile with those pins and add a regression check for the versions the app resolves."

