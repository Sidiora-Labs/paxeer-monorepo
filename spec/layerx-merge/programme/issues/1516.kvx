[issue.1516]
number = 1516
title = "[Coherence] The shipped example fulfilment repository still enforces the request digest on read, so a reused receipt gets fulfillment-conflict instead of settled_receipt_reuse"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit 3d517afabec833b670fabf5be0da787338703945 keys fulfilments by verified receipt in sdk/integrations/fastapi/layerx_fastapi/seller.py:232 and checks request reuse at :254, but sdk/integrations/fastapi/examples/paid_api.py:70 rejects a changed digest before that check and :74 returns the proposed digest, sdk/integrations/fastapi/layerx_fastapi/integration.py:213 maps that conflict to HTTP 409 via :279, and sdk/integrations/fastapi/tests/test_seller_receipts.py:245 exercises the separate FileFulfillments implementation at :45 rather than the shipped example."
close_comment = "The shipped FastAPI example still reports fulfillment-conflict when a settled receipt is reused for a different request. The follow-up fix will preserve the stored request digest and let the seller return settled_receipt_reuse, with regression coverage for the example repository and replay after reopening it."

