[issue.1714]
number = 1714
title = "[P2] Resolve committed journey receipt references through evidence.get"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The producer retains verified bank commitment evidence at services/human/crates/layerx-human-service/src/journeys/engine.rs:1842 and :1856, the journey projection emits its verified receipt reference at services/human/crates/layerx-human-service/src/server/production_reads.rs:1221, and receipt_label_with_keys validates its digest, signature and retained commitment at :1316, :1324 and :1333 before returning committed at :1336, but evidence_get rejects that result at :916 before the Committed-capable exporter at :800; commit ba761d6c5d67fad74ebeeff0ef036e52fa2bb99b renamed the label introduced by f83425c2a8b990d50d884e286f59800c7de91252 without repairing this guard, and services/human/crates/layerx-human-service/tests/projection_rungs.rs:475 checks labels without dereferencing the evidence IDs."
close_comment = "Committed bank journeys still advertise receipt references that evidence.get rejects after successful verification. The required repair makes both receipted and committed references retrievable while preserving receipt authentication, retained commitment checks and accurate proof metadata."

