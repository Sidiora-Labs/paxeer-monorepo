[issue.1549]
number = 1549
title = "[Coherence] The node merge-import test still builds the merge table from keepers without the chains keeper, so it now fails on the chains error this commit asserts"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "node/precompiles_agent_merge_imports_test.go:15 passes bare NewPrecompileKeepers(a) and expects success at line 16, but node/app.go:3893 returns no chains keeper for that value, precompiles/setup_test.go:443 explicitly asserts its chains-keeper refusal, and node/app.go:3900 supplies the missing keeper through GetPrecompileKeepers(), leaving the harness requirement at spec/layerx-merge/spec.kvx:21747 unmet."
close_comment = "The node merge-table test needs the application's complete precompile keepers to reach its oracle aggregator, scheduler and streams constructor checks. The repair will use GetPrecompileKeepers() and preserve every existing constructor assertion and the missing-keeper refusal checks."

