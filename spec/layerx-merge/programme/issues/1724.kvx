[issue.1724]
number = 1724
title = "[P2] Use node-consistent amounts in the current-receipt restart fixture"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The fixture introduced by dbd4e68ed94769c51ad1368826824595ec17b6f3 still supplies 25 at services/agent/crates/layerx-agentd/tests/support/current_node.rs:126 for signed_transaction at services/agent/crates/layerx-agentd/tests/support/mod.rs:109 whose encoder writes zero value at services/agent/crates/layerx-crypto/src/evm_transaction.rs:187, independently encodes and signs that amount at services/agent/crates/layerx-agentd/tests/support/mod.rs:861 and :923, whereas node/sequencer/receipt.go:426 derives Amount from transaction value and :266 encodes it, leaving the nonzero recovery assertions at services/agent/crates/layerx-agentd/tests/outbox_recover.rs:248 and :392 inconsistent with the producer and decision 2648 at spec/layerx-merge/spec.kvx:9001."
close_comment = "The current restart fixture signs a receipt for 25 against a transaction whose value is zero, so it does not establish node-consistent nonzero recovery. The repair must use node-produced receipt bytes and matching budget evidence while preserving restart recovery, write admission and refusal coverage."

[task.18.1724.1]
title = "Issue #1724: Prove nonzero restart accounting with node-produced transaction receipts"
