do_1 = "Add TestCurrentReceiptRestartFixture to node/sequencer/receipt_equality_test.go using the real newReceiptHarness at :233 and Receipter.Accept path at :278 to capture a successful transaction with explicit nonzero value, its exact signed transaction bytes, node-signed receipt, governed key and producer-derived budget state with matching committed evidence into services/agent/crates/layerx-agentd/tests/fixtures/current-receipt-restart.json; assert the raw transaction hash, decoded transaction value and receipt amount agree, and replay those captured bytes through authenticated_receipt and committed_budget in services/agent/crates/layerx-agentd/tests/support/current_node.rs:123 and :159 instead of supplying independent amount and spent fields at :126 and :169. Preserve the zero-value restriction of services/agent/crates/layerx-crypto/src/evm_transaction.rs:315; the existing shared corpus generator at rpc/sequencer_receipt_vectors_test.go:248 supplies execution results directly and is not a substitute for the real execution and budget producer; if the actual producer-consumer interfaces cannot represent matching nonzero spend, report the exact blocking interface without inventing fields, weakening checks or changing the positive scenario to zero."
do_2 = "Update seed_startup_recovery and startup_recovery_reconciles_evidenced_tenant_and_holds_tenant_without_evidence in services/agent/crates/layerx-agentd/tests/outbox_recover.rs:184 and :361 to consume the captured transaction, receipt and budget evidence, retain the transaction bytes across store close/reopen, and assert transaction hash/value/receipt amount consistency, identical retained receipt bytes at :374, current-evidence inventory at :378, governed-key re-verification at :387, matching explicit nonzero protocol_consumed and receipt_consumed at :248, reconciliation and write admission at :252; preserve both legacy-evidence refusal tests at :79 and :141, missing-evidence reservation holds at :264, unreconciled-budget write refusal at :295 and invalid-budget refusals at :332, and have TestCurrentReceiptRestartFixture compare its producer output with the committed capture before the focused outbox_recover consumer tests run."
symbols = ["TestCurrentReceiptRestartFixture", "authenticated_receipt", "committed_budget", "seed_startup_recovery", "startup_recovery_reconciles_evidenced_tenant_and_holds_tenant_without_evidence"]
touches = ["node/sequencer/receipt_equality_test.go", "services/agent/crates/layerx-agentd/tests/fixtures/current-receipt-restart.json", "services/agent/crates/layerx-agentd/tests/support/current_node.rs", "services/agent/crates/layerx-agentd/tests/outbox_recover.rs"]
tests = ["node/sequencer/receipt_equality_test.go::TestCurrentReceiptRestartFixture", "services/agent/crates/layerx-agentd/tests/outbox_recover.rs::startup_recovery_reconciles_evidenced_tenant_and_holds_tenant_without_evidence", "services/agent/crates/layerx-agentd/tests/outbox_recover.rs::legacy_receipt_evidence_is_refused_after_restart", "services/agent/crates/layerx-agentd/tests/outbox_recover.rs::archived_legacy_receipt_evidence_is_refused_after_restart"]
