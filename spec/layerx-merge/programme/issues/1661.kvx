[issue.1661]
number = 1661
title = "Load-test deploy-wasm still invokes retired DEX commands"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "tools/benchmark/loadtest/operations/deployment.go:281 delegates before instantiation and retired DEX calls at :293 and :311 return before unbonding at :321 or address output at :325, while daemon/paxd/cmd/root.go:222 builds transactions from node/app.go:281 module basics without DEX and modules/layerxexchange/module.go:69 and modules/spot/module.go:77 return no transaction commands; commit fb15c3ca096875a1f434b56a365660fba7aa20a7 retained this sequence, tools/benchmark/loadtest/operations/repair_22_31_500_test.go:33 stops after stores, and tools/benchmark/loadtest/repair_m879_test.go:188 supplies synthetic DEX success."
close_comment = "The WASM deployment still reaches retired DEX commands after creating contracts and delegating stake, so it can leave partial state without returning contract addresses. A repair is specified to complete CW20 deployment through supported commands, remove the unnecessary delegation, retain partial-deployment recovery details, and prove the behavior against the current command tree and chain."

