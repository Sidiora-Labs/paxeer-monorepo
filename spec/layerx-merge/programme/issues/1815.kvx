[issue.1815]
number = 1815
title = "[P2] Handle ancestor type changes in path-filtered source diff and history"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The path filters introduced by commit 987381c3c8492c34af137dcd98b7243d87aae99c remain accepted at tools/hyperfide/core/control-plane/src/source_control/api.ts:1063 and :1136, but tools/hyperfide/core/control-plane/src/source_control/queries.ts:90 lets a selected descendant intersect its excluded ancestor while :610 skips directory/non-directory descent, :630 suppresses that ancestor record and :657 declares the empty frontier complete, and history at :324 calls the unguarded lookup at tools/hyperfide/core/control-plane/src/source_control/api.ts:528 which still raises PATH_CONFLICT for a non-directory ancestor at tools/hyperfide/core/control-plane/src/source_control/trees.ts:19."
close_comment = "Path-filtered diff still omits descendant removals and additions when an ancestor changes between a directory and a file or symlink, and path-filtered history can fail with PATH_CONFLICT. A repair is specified to report these changes and treat the descendant as absent in the affected revision while preserving authorization, pagination and coverage."

