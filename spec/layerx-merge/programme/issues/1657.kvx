[req.181657]
title = "Assets and Performance use the same UTC calendar windows"
ac_1 = "Given sparse or entirely stale daily PnL history, Assets at apps/perps/src/widgets/portfolio/PortfolioAssetsChart.tsx:205 selects 7D, 30D and 90D by the same inclusive UTC start day as Performance at apps/perps/src/widgets/portfolio/PortfolioPerformanceGrid.tsx:399-410, advances that boundary when the reference date crosses UTC midnight, returns no points when no rows qualify, and preserves ALL rows, exact-wei anchor reconstruction and the capped-history disclosures at apps/perps/src/widgets/portfolio/PortfolioAssetsChart.tsx:75-82 and :182."

