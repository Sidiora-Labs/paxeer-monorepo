[issue.1657]
number = 1657
title = "Portfolio Assets chart treats sparse active days as calendar-day windows"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "apps/perps/src/widgets/portfolio/PortfolioAssetsChart.tsx:215 selects the last N records despite services/platform/perps-data/internal/pnl/pnl.go:407 deleting days without trades, whereas apps/perps/src/widgets/portfolio/PortfolioPerformanceGrid.tsx:399 and :410 apply the N-day inclusive UTC cutoff required by spec/release-v6-12-0/qualification.kvx:2605; apps/perps/src/page-modules/portfolio/index.tsx:160 and apps/perps/src/widgets/portfolio/PortfolioOverviewPanel.tsx:105 pass that sparse history to Assets, and commits a542a9898afcb093682d0f1df6a77a82ec83f73d and b2b5792f96f9ff7b121c8ea88e3045129229c97e preserve cap and estimate disclosures without repairing this selection."
close_comment = "Assets still counts active history rows for 7D, 30D and 90D, so those views can include dates outside the selected calendar window. The follow-up repair will align Assets with Performance on UTC day boundaries and preserve the capped-history disclosures."

