[issue.1613]
number = 1613
title = "[Coherence] The audit record marks the legacy importer integration test clean although its own note describes a stub that hides the blocking conflict defect"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The clean verdict at spec/layerx-merge/programme/audit/records/22.30.118.kvx:783 contradicts its wallet-id-only producer note at line 784 and the test-fidelity rule at spec/layerx-merge/programme/audit/BRIEF.kvx:25: services/wallet/ceremony/legacy-import/test/import.test.ts:61 still substitutes a server returning unverified insertion and wallet-id-only conflict responses at lines 69-71, although commit d3c77120fae702c13dee3fc3f658de38651b9edd repaired the original conflict defect with material comparisons at services/wallet/gateway/src/routes/admin.ts:106 and receipt verification at services/wallet/ceremony/legacy-import/src/importer.ts:312 and added real-gateway collision coverage at services/wallet/ceremony/legacy-import/test/repair-22-31-369.test.ts:171, leaving the original test and its classification unrepaired."
close_comment = "The conflict-handling repair includes real-gateway regression coverage, but the original integration test still uses incompatible responses from a wallet-id-only server and its audit entry still says clean. A follow-up will replace that server with the real gateway and explicitly record the test gap."

