[issue.1633]
number = 1633
title = "[P2] Preserve tx_hash in node-root history responses"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "At bb8caac8b3e73e3e2f4b330805574f0bcb540641, src/modules/history/indexer.go:106 and :163 retain only tx_id when decoding rows returned by rpc/px_history.go:120, whereas services/platform/hosted/gateway/src/history.rs:263 copies tx_id into tx_hash and services/agent/sdk/typescript/src/history.ts:192 requires tx_hash, leaving the node response incompatible with the SDK despite the subset assertions in rpc/px_node_root_history_test.go:155."
close_comment = "Node-root history still omits the transaction hash required by existing SDK history decoding. The repair will retain tx_id, add the matching tx_hash, and verify that both history methods preserve the exact hash through HTTP, WebSocket and SDK decoding."

