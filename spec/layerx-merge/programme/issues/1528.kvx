interfaces = []
do_1 = "Regenerate the 17 module go.sum files deleted by b6101fd075736c857ad85fd9d2eeeb6690239032 from each module's current manifest using Go's module download commands with GOWORK=off, including discovery and notifications whose manifests were unchanged; services/launchpad/api/go.mod:14 retains chi v5.4.0, services/launchpad/discovery/go.mod:19 and services/launchpad/notifications/go.mod:19 retain their local SDK replacements, and no go.mod, dependency floor, source file or Dockerfile changes."
do_2 = "Restore services/launchpad/go.work.sum for the current workspace graph, retaining the workspace's use entries at services/launchpad/go.work:8 and the current module versions; regenerate checksums rather than copying only the obsolete pre-raise module sums, and preserve the dependency-integrity requirements of deploy/launchpad/Dockerfile.svc:12 and deploy/launchpad/Dockerfile.native:12."
do_3 = "Add services/launchpad/security/supplychain/test_go_checksums.py with one test_go_checksums_support_readonly_resolution that enumerates exactly the 17 affected modules, asserts their go.sum and the restored go.work.sum are nonempty valid checksum records, snapshots all their manifests and checksum files, and runs real go list -mod=readonly -deps -test ./... followed by go mod verify per affected module with GOWORK=off and a fresh shared temporary module cache; assert every command succeeds and every snapshot is unchanged, without prepopulating checksums by a writable download command, skipping modules, mocking Go or weakening the Dockerfile checks."
