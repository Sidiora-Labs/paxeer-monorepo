[issue.1528]
number = 1528
title = "[Coherence] The commit deletes every go.sum in the launchpad Go modules and the workspace go.work.sum, so none of the modules can verify or build"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit b6101fd075736c857ad85fd9d2eeeb6690239032 raised 15 launchpad manifests and deleted 17 go.sum files plus services/launchpad/go.work.sum, all still absent at this revision, while deploy/launchpad/Dockerfile.svc:10 and :12 and deploy/launchpad/Dockerfile.native:10 and :12 require immutable standalone checksum files before downloading dependencies; spec/layerx-merge/spec.kvx:137889 and :137897 still require raised locks and per-module builds, but tools/deps/lockfloor.py:129 and :232 inspect go.mod rather than checksum completeness, as reflected by tools/deps/tests/test_lockfloor.py:109."
close_comment = "The launchpad module checksum files are still missing, which blocks the service images at their dependency-integrity step. Follow-up task 18.1528.1 restores checksums for the current dependency versions and adds a regression check for standalone read-only dependency resolution."

[task.18.1528.1]
title = "Issue #1528: Restore launchpad dependency checksums without lowering dependency floors"
