[issue.1518]
number = 1518
title = "[Coherence] The Python and TypeScript web search clients now disagree on which receipt settles a metered search"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit 4ec44a52afd44ba118a52f5f980650f1d256ab1b enforces sequencer module 12/operation 2 in services/agent/sdk/python/layerx_sdk/web_search.py:453-456, with fixture acceptance at services/agent/sdk/python/tests/test_web_search_sequencer.py:188-201, but services/agent/sdk/typescript/src/web-search.ts:511 still requires module 1/operation 6 and :322-325 retains the kernel balance arm, while services/agent/sdk/typescript/test/web-search-sequencer.test.ts:98 signs that obsolete shape instead of the producer shape established by node/app.go:3481-3485 and node/sequencer/receipt.go:400."
close_comment = "Confirmed: TypeScript metered web search rejects the module 12/operation 2 sequencer receipts accepted by Python and still accepts the obsolete module 1/operation 6 shape. The follow-up aligns both TypeScript payment schemes with Python and adds coverage using the sequencer conformance receipt."

