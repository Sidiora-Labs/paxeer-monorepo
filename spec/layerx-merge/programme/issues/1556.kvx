[req.181556]
title = "Agent event ingestion accepts sequencer receipt logs and reconciles verified commitment"
ac_1 = "Given receipted logs emitted with seq and blockHash:null by rpc/filter.go:487, when EventIngestor::read_log at services/agent/crates/layerx-agentd/src/events/ingest.rs:702 consumes them and committed backfill overlaps them across restart, then ingestion preserves the actual Receipted rung, uses only verified committed evidence for promotion, maintains block/transaction/log cursor order, delivers each event once and refuses malformed or conflicting logs without advancing durable progress."

[acceptance.18.1556.1]
feature = "18"
req = "181556.1"
scenario = "Given producer-emitted receipted logs without a block hash and matching committed copies, when the supported Logs subscription, ingestion, backfill and checkpoint verification run across a store reopen, then valid logs retain their actual rung, committed promotion uses the real hash, cursors stay ordered, delivery has no duplicates and malformed or conflicting evidence is refused."
contract = "contracts/agent-api.md#subscription-create"
