[issue.1791]
number = 1791
title = "[Coherence] The gateway ingress rule now admits a control pod label, layerx-mainnet-beta-control, that no workload carries"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "services/platform/hosted/gateway/deployment.yaml:185 and services/platform/hosted/gateway/deployment.yaml:190 still select the nonexistent layerx-mainnet-beta-control pod in layerx-mainnet-beta without a namespaceSelector, while services/platform/hosted/testnet/deployment.yaml:70 and services/platform/hosted/testnet/deployment.yaml:75 declare layerx-testnet-control in layerx-testnet with layerx-plane: control, services/platform/hosted/interop/deployment.yaml:69 admits the existing app label, and docker/platform-testnet/Dockerfile:13 retains the control executable."
close_comment = "The gateway ingress policy still selects an unused control label and omits the namespace selector needed for the existing control pods. A targeted repair will admit those pods on TCP 9443 while preserving the gateway's namespace and other peer restrictions."

