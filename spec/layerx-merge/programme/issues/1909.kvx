[issue.1909]
number = 1909
title = "[Coherence] The new qualification record for 22.39.117 attempt 6 names the wrong file and symbol, and uses a severity value the workflow does not allow"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The record added by commit d7fa22fa809f826d0468c317c01947a68375629a still names the unrelated chain test and severity high at spec/layerx-merge/qualification.kvx:36480, spec/layerx-merge/qualification.kvx:36481 and spec/layerx-merge/qualification.kvx:36484, although its observation at spec/layerx-merge/qualification.kvx:36482 names TestPhase2ConcurrentIndexesAndRecovery, declared at sdk/launchpad/shared/db/production/online_indexes_test.go:70 with the failing cleanup at sdk/launchpad/shared/db/production/online_indexes_test.go:39, while the chain test is declared separately at sdk/launchpad/shared/chain/client_test.go:569 and spec/workflow.kvx:66 excludes high from the allowed severities."
close_comment = "Attempt 6's finding identifies an unrelated chain test and uses an unsupported severity. The follow-up will identify the production database test and use the allowed blocker severity, preserving the recorded failure and its evidence."

