revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "task"
evidence = "Commit e0b4d6cbfc695f2351c61353aab24be12f725a79 deleted core/deps/db-backend/go.sum and core/deps/tm-db/go.sum and neither module has changed since that commit at this revision, while core/deps/db-backend/go.mod:14 still requires grpc v1.83.1, core/deps/tm-db/go.mod:27 still requires compress v1.18.7, and spec/layerx-merge/spec.kvx:137859 requires regenerated lock files with module verification and builds at spec/layerx-merge/spec.kvx:137867."
close_comment = "Both vendored database modules still need their generated checksum files restored for builds with dependency changes disabled. The follow-up task restores those files and adds a regression check covering dependency resolution in both modules."

