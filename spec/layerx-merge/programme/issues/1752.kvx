[req.181752]
title = "Authenticated state exports acquire and retain real ICS23 storage evidence"
ac_1 = "Given an owned transaction with authenticated committed receipt material and configured slots for the caller's bound account, an authenticated ExportOffline request through services/agent/crates/layerx-agentd/src/human_runtime.rs:16825 acquires and retains the state bundle through retain_state_export at :22016 and returns evidence accepted by services/agent/crates/layerx-agentd/src/export.rs:765 without a directly seeded export record."
ac_2 = "After reopening the store, the same state fact exports with identical verified evidence without fetching its witnesses again; another tenant, another account, an unowned transaction, invalid slot configuration or a tampered witness is refused without retaining a state bundle, preserving the ownership and proof checks at services/agent/crates/layerx-agentd/src/export.rs:361 and :768."

[acceptance.18.1752.1]
