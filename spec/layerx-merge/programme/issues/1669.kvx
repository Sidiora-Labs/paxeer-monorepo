[req.181669]
title = "Refresh recovery survives a restart after abort-session rotation"
ac_1 = "Given the previous aborted attempt and its replacement saved by services/wallet/ceremony/internal/migrate/migrate.go:1121, both resume paths at services/wallet/ceremony/internal/migrate/migrate.go:735 and services/wallet/ceremony/internal/migrate/migrate.go:1009 accept only the journal-bound previous aborted/base-epoch records alongside valid replacement records, replay the same replacement after restart, and require every member complete at baseEpoch+1 before recording completion, while unrelated identities, sessions, epochs and incompatible decisions remain refused by the inspection at services/wallet/ceremony/internal/attestor/client.go:1129."

[acceptance.18.1669.1]
feature = "18"
req = "181669.1"
scenario = "Given an imported key or held identity key with an aborted refresh and a saved replacement session, when recovery stops before all members adopt the replacement and resumes from the sealed journal after client and member restart, then it replays that same replacement to all-member completion at baseEpoch+1 without re-import or identity replacement, and rejects unrelated recovery records without discarding shares or recording completion."
contract = "contracts/services.md#s28-wallet-attestors-tss"
test = "services/wallet/ceremony/internal/migrate/repair_m160_test.go::TestRefreshRecoveryAfterRotation (planned)"
