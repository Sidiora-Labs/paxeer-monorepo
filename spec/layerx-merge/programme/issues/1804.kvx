[issue.1804]
number = 1804
title = "[Coherence] The new programs-reference-fixtures job rebuilds the committed fixtures in place but never compares the result with the committed files, so fixture drift cannot fail CI"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "The job introduced by commit 20b07243e3ea98c0398ab1c417c081ad4e593644 still ends at .github/workflows/ci.yml:130 with make programs-reference-fixtures (Makefile:3146 invokes the generator), scripts/programs/program-fixtures.sh:54 overwrites the wasm and :73, :76 and :80 regenerate the interfaces and registry values before :89 merely prints hashes, and tools/qualification/audit_repairs/test_repair_22_31_605.py:91 checks invocation without asserting any comparison against committed fixtures."
close_comment = "The reference fixture job rebuilds the committed artifacts without checking for changes, so stale fixtures can pass. A follow-up task will require a comparison after rebuilding and regression coverage for drift in all eight generated files."

