capabilities = []
interfaces = []
do_1 = "Remove the overview-wide PortfolioBalanceBoundary at apps/perps/src/page-modules/portfolio/index.tsx:149 and pass the current balance snapshot and retry handler through required, typed PortfolioOverviewPanel and TotalValueCard props; render the existing boundary around only the balances strip at apps/perps/src/widgets/portfolio/PortfolioOverviewPanel.tsx:217, outside the refresh control at line 205, statistics grid at line 237 and account actions at line 253, leaving the independently loaded charts and performance grid mounted."
do_2 = "Preserve PortfolioBalanceBoundary's source-specific loading, error and retry behavior at apps/perps/src/page-modules/portfolio/PortfolioBalanceBoundary.tsx:13 and the reader's empty unresolved balances, account isolation and generation checks in balances.ts:45 and balances.ts:75; retain all existing safety assertions in apps/perps/tests/repair-22-33-578.test.ts:134 and replace its overview-wide wiring assertion at line 264 with assertions proving the boundary encloses only the balance strip."
do_3 = "Add and register the declared test function portfolioBalanceIsolationKeepsOverviewVisible in apps/perps/tests/repair-22-33-578.test.ts using the real PortfolioBalanceReader, production overview components and existing transport fixture: assert initial loading, successful values, a delayed refresh, each individual source failure, both failures and retry recovery retain independent PnL, trade and position statistics, daily performance, Refresh, privacy and account controls while only balance content shows loading or error, and an account change never reveals the prior account's balances."
do_4 = "Update the overviewProps fixtures in apps/perps/tests/exact-money.test.ts:14 and apps/perps/tests/repair-22-33-198.test.ts:165 to provide the required balance snapshot and retry props, retaining every daily-history, precision and privacy assertion; run the focused overview and balance tests together."
