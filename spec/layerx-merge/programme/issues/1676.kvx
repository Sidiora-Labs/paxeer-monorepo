[issue.1676]
number = 1676
title = "[Coherence] The balance boundary wraps the whole overview panel, so every refresh and every balance failure hides unrelated stats and controls"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "apps/perps/src/page-modules/portfolio/balances.ts:47 resets both sources to loading on every refresh, apps/perps/src/page-modules/portfolio/PortfolioBalanceBoundary.tsx:13 hides its children until both sources are ready, and apps/perps/src/page-modules/portfolio/index.tsx:149 wraps the whole overview despite its independent statistics hooks at apps/perps/src/page-modules/portfolio/index.tsx:81 and apps/perps/src/page-modules/portfolio/index.tsx:82, so the refresh handler at apps/perps/src/page-modules/portfolio/index.tsx:118 hides unrelated statistics and controls; apps/perps/tests/repair-22-33-578.test.ts:143 tests only the isolated balance boundary and does not cover overview visibility."
close_comment = "Balance loading and failures still hide the entire portfolio overview, including independently loaded statistics and controls. A focused follow-up will limit the balance boundary to the balances strip and keep the overview visible during refresh, failure and retry."

[task.18.1676.1]
title = "Issue #1676: Keep portfolio statistics and controls visible during balance refresh and failure"
status = "pending"
mode = "BUILD"
wave = 1
requires = []
