[issue.1871]
number = 1871
title = "[P2] Follow the composite release toolchain in the compiler-pin test"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "The composite extraction in commit 775a34c6ff79efe75976ba3dba4d1ea2376f7802 remains at .github/workflows/paxeer-release-check.yml:94 and .github/workflows/paxeer-release-publish.yml:52, but tools/release/tests/workflows.test.sh:41 unconditionally reads the absent run field when check_pins_cc calls it at tools/release/tests/workflows.test.sh:88, so the retained suite at tools/release/tests/run-all.sh:22 cannot reach the real compiler pin and refusal at .github/actions/release-toolchain/action.yml:33."
close_comment = "The compiler-pin regression test still expects inline setup commands even though both release workflows use the shared composite action. A follow-up task tracks resolving that action while preserving compiler-version, refusal and installation-order coverage; the separate release-identity assertions belong to issue #1793."

