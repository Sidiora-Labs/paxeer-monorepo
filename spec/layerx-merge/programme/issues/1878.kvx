stop_condition = "Stop on the bounded gate result; record exact revision, command, exit code and private evidence location. Do not mark complete without the declared evidence."
path_policy = "Existing paths are modified in place. Planned paths must be created or explicitly mapped to an existing module before implementation; a planned path never authorizes a duplicate implementation tree. A task touches only the paths it declares."
evidence_policy = "Retain credentials, operational inventories and raw qualification records in access-controlled storage; publish only reviewed technical product material."

[req.181878]
title = "Live campaign PASS requires exact complete independently checked full-case evidence"
ac_1 = "Given full-case registrations selected by tools/hyperfide/tests/hyperfide/support/source_control_live_campaign.py:118, each supplied manifest SHALL match its expected registration, exact canonical case and complete assertion inventory before launch, and the case status at :254 SHALL become PASS only after every distinct required variant has a matching independently checked receipt with current source identity, complete successful assertions and full_case_status PASS; component manifests, reused variants, incomplete or unverified receipts SHALL never produce case PASS."

