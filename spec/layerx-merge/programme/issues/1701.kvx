[issue.1701]
number = 1701
title = "[Coherence] A failed segment construction still leaks the value file handles of shards that opened before the failing shard"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "task"
evidence = "The cleanup added by commit 939d1b436048917caccc406cad1541b1774cb2b0 still closes only keys at storage/db_engine/litt/disktable/segment/segment.go:130, while the shard loop returns without closing earlier shards at segment.go:149-153 despite their retained descriptors and writers at storage/db_engine/litt/disktable/segment/value_file.go:84-90; storage/db_engine/litt/disktable/segment/repair_m1162.kvx:10 promises zero descriptors after constructor failure, but repair_m1162_test.go:141-146 tests only shard 0 with sharding factor 1."
close_comment = "Segment construction can leave earlier value shards open when a later shard fails to open. The repair must close every acquired key and value handle before returning the constructor error and cover failures after earlier shards have opened."

[task.18.1701.1]
title = "Issue #1701: Close earlier value shards when segment construction fails"
