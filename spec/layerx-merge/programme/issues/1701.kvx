[req.181701]
title = "Failed segment construction releases every acquired descriptor"
ac_1 = "Given real value-file conflicts at the first, middle or final shard of a four-shard segment, when CreateSegment reaches the failure path at storage/db_engine/litt/disktable/segment/segment.go:149-153, then it returns nil and the original error, immediately releases every acquired key and value descriptor across all segment paths without relying on garbage collection, and preserves pre-existing contents in both durability modes; successful construction retains the writable ownership transferred at segment.go:169-197 until normal sealing closes it."

[acceptance.18.1701.1]
feature = "18"
req = "181701.1"
