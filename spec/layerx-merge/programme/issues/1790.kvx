[req.181790]
title = "The gateway and hosted peers admit their intended cross-namespace connections"
ac_1 = "The gateway registry, trusted-boundary and faucet peers at services/platform/hosted/gateway/deployment.yaml:204-209 and their receiving policies at services/platform/hosted/registry/deployment.yaml:182, services/platform/hosted/testnet/deployment.yaml:294, services/platform/hosted/identity/deployment.yaml:71 and services/platform/hosted/paxeer/deployment.yaml:148 admit the actual workloads across namespaces on their declared ports, and the web URL and policies at services/platform/hosted/human/web-deployment.yaml:29 and services/platform/hosted/human/web-deployment.yaml:187-213 target and admit the existing gateway Service; each changed cross-namespace peer combines a namespaceSelector with its podSelector, with negative assertions for wrong namespaces, pods and ports and all existing gateway configuration assertions preserved."

[acceptance.18.1790.1]
feature = "18"
req = "181790.1"
scenario = "Given the gateway in layerx-mainnet-beta and its registry, faucet, identity, Paxeer boundary and web peers in the labelled peer namespace, when their actual manifests are evaluated under namespace-aware NetworkPolicy semantics, then both sides admit the declared gateway-to-peer and web-to-gateway connections, the web URL targets the gateway Service, and the changed selector branches reject unrelated namespaces, pods and ports while the gateway configuration checks remain intact."
contract = "contracts/platform-gateway.md#gateway-env-vars"
