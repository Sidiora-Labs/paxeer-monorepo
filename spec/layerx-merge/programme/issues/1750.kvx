[issue.1750]
number = 1750
title = "[Coherence] The 'exact signed' Claim and RefundFree requests carry Native authentication; their signature is never checked by the program"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "At this revision, programs/crates/layerx-programs-ai-market/tests/repair_22_33_261.rs:209 sets Native authentication, :1240 signs the envelope separately, and :1460 checks corruption only with test-side verify_strict before :1468 routes the original request, while programs/crates/layerx-programs-ai-market/src/rewards.rs:2586 authenticates only the native principal and domain and src/dispatch.rs:651 and :675 disallow Delegate for these operations, so authenticated replay needs coverage through the production activity signature and authority checks at tests/programs/test_ai_host_boundary.c:301."
close_comment = "Claim and RefundFree recovery coverage still checks a detached signature that the program never receives. A follow-up will prove intact and tampered requests through native activity authentication while retaining the existing recovery assertions."

[task.18.1750.1]
