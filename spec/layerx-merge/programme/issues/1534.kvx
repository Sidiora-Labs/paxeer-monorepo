[issue.1534]
number = 1534
title = "[Coherence] The new build_cmd of task 22.9.33 asks for a serve_routes test target on a package that does not have one, so the build fails before it compiles anything"
revision = "210639d0360c53f5c2fdd81c9c7c5e84b24b8c84"
verdict = "already-fixed"
evidence = "Commit e977612784d4e4e9a02ef21a2bae47ff8367046d corrected both commands, and spec/layerx-merge/spec.kvx:131501 and spec/layerx-merge/spec.kvx:131502 now select proof_serve_errors under layerx-agentd and serve_routes under layerx-agentd-host, matching the target declaration at services/agent/crates/layerx-agentd-host/Cargo.toml:26 and its source path at services/agent/crates/layerx-agentd-host/Cargo.toml:27."
close_comment = "Task 22.9.33 now selects serve_routes from its owning package, layerx-agentd-host, in both build_cmd and verify_cmd, while proof_serve_errors remains under layerx-agentd. The incorrect package selection reported here is fixed."
