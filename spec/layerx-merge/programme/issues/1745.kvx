[issue.1745]
number = 1745
title = "[Coherence] The old committed_budget_rank helper is now reached only from its own unit tests, so the repair_22_31_538 tests no longer cover the production approval path"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "Commit 4e8983196e702a58e69e18b3804242ec1bca2271 switched the production guard to budget_state_is_committed (services/agent/crates/layerx-agentd/src/human_runtime.rs:10158), but committed_budget_rank remains at services/agent/crates/layerx-agentd/src/human_runtime.rs:11688 with only the test callers at lines 22571 and 22580, while services/agent/crates/layerx-agentd/tests/repair_22_31_538.kvx:10 still describes the private helper as the production guard."
close_comment = "The approval budget guard uses the shared committed-state predicate, but the repair tests still exercise an unused private helper. The follow-up removes that helper, directs both tests to the production predicate, and corrects the repair record."

