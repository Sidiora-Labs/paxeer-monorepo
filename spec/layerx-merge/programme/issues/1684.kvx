[req.181684]
title = "Native receipt recovery uses one canonical reference without replacing producer evidence"
ac_1 = "For an authenticated receipt, native tracking and terminal or spend evidence expose SHA-256 of the LXP/v1/receipt domain including its terminating zero byte followed by the canonical unsigned receipt, as services/agent/schema/agent-api/read.kvx:103 requires; signed-byte hashes remain distinct receipt_hash metadata."
ac_2 = "The source transcript at services/agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs:2483 and recovery recording preserve the native reference byte for byte; the generator at tools/qualification/paxeer-x/fixtures/mcp_recovery_recording.py:60 refuses a mismatch instead of replacing it with the SDK result."
ac_3 = "The real native writer and decoders feed unchanged reference values to the Python recovery validators at tools/qualification/paxeer-x/mcp_daemon_revocation.py:157 and :185, which accept the canonical reference and refuse both signed-byte hash variants; durable outbox recovery preserves that reference across reopen and the existing recovery suite retains its one-transmission and malformed-evidence assertions."

[acceptance.18.1684.1]
feature = "18"
req = "181684.1"
scenario = "Given a native submission with an authenticated signed receipt, when its native tracking response is decoded and consumed by receipt recovery and its durable outbox is reopened, then the unchanged receipt reference equals the unsigned receipt domain digest, remains stable across reopen and is never replaced by the recording generator."
contract = "contracts/agent-api.md#program-receipt"
test = "services/agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs::receipt_reference_reaches_recovery_consumer (planned)"
qualification = "UNRUN"
