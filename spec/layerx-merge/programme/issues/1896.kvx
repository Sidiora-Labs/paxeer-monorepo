[issue.1896]
number = 1896
title = "[Coherence] The new qualification finding for 22.39.117 attempt 5 names a shared-module chain test as its file and symbol, while the failures it records are three cases in the launchpad API module"
revision = "3520b1428059af90261432778c008a9ce362a0b1"
verdict = "task"
evidence = "Finding 22.39.117.5 introduced by commit 47b44760f7955e5b9267a3b34a05fab3e02d0296 still names the unrelated chain test at spec/layerx-merge/qualification.kvx:36448 and spec/layerx-merge/qualification.kvx:36449 and uses high at spec/layerx-merge/qualification.kvx:36452, contradicting its API failure observation at spec/layerx-merge/qualification.kvx:36450, the three test sites at services/launchpad/api/internal/app/dev_authority_cache_test.go:100, services/launchpad/api/internal/app/dev_authority_test.go:53 and services/launchpad/api/internal/app/dev_market_reads_test.go:24, and the allowed severities at spec/workflow.kvx:66."
close_comment = "The attempt-5 finding still points to a chain test that passed instead of the failing launchpad API tests, and high is not an allowed severity. A focused record correction is planned to identify the API test site and use blocker while preserving the historical failure evidence."

