[issue.1740]
number = 1740
title = "[Coherence] The test reads the consumer and membership source hashes but only checks that each is 32 bytes long, so the recorded transcript can drift from ProjectionStore without failing"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "programs/crates/layerx-programs-ai-market/tests/repair_22_33_233.rs:381 checks only hash lengths at lines 393 and 397 and retains consumer hash 2e387f6033b6985960035c9d38646074a70549de51f4ba58283e9f11703eab96 at line 624, while commit 6bae59f682542da4cdc3b1091c22fe095f02b1d2 changed services/platform/hosted/indexer/src/ai_market.rs:1616 and its current SHA-256 is ea9d74fffbd8142a5e729dff6b500e6c905df536338bb6d4a58195b7ff78709f, so the recorded consumer provenance has already drifted."
close_comment = "The recorded consumer hash is stale, and the existing transcript checks accept any 32-byte source hash. The repair task adds a check against both current consumer sources and refreshes the recording through real promotion, refusal and recovery operations."

