[issue.1582]
number = 1582
title = "[P2] Align Python ProgramOperations input with EVM receipt verification"
revision = "bb8caac8b3e73e3e2f4b330805574f0bcb540641"
verdict = "already-fixed"
evidence = "Commit 5fe9f32adbe9fc7deaa1fd90c81d71f423420cdc replaced the legacy submission decoder with EIP-1559 binding: services/agent/sdk/python/layerx_sdk/program_wire.py:81 decodes signed transactions and derives their Keccak identity, program_wire.py:263 binds the native call and retains the exact bytes, services/agent/sdk/python/layerx_sdk/programs.py:394 submits that binding and programs.py:473 authenticates receipts against those bytes, services/agent/sdk/python/layerx_sdk/agent_http.py:218 sends the retained transaction through eth_sendRawTransaction consistently with services/agent/crates/layerx-agentd/src/ops/program.rs:1708, tests/agent/sdk/python/test_repair_22_33_16.py:306 covers public submit and authenticated receipt recovery after reopening with a tampered receipt refusal, services/agent/sdk/python/tests/test_retired_kernel_receipts.py:154 rejects altered receipt signatures and transaction bytes, and tests/agent/sdk/python/test_repair_22_33_17.py:159 covers public lifecycle receipt recovery, rotated receipt keys and authentication refusals."
close_comment = "Python program submission now accepts signed EIP-1559 transactions, preserves their exact bytes and transaction hash, and verifies sequencer receipts against the retained transaction. Public submission and receipt recovery coverage includes reopening and tampered receipt refusal; lifecycle recovery retains receipt authentication and receipt-key rotation checks."
