[issue.1834]
number = 1834
title = "[P3] Make retired-symbol absence tests inspect the linked archive"
revision = "a910fdedd579e63379ae6c2e4d4971990d28f8ad"
verdict = "task"
evidence = "At this revision tests/fuzz/lxp_prop_payer_grant.c:15-32 checks only null weak references, its header-local dispatcher at tests/codec/lxp_kernel_case.h:22-48 adds no strong kernel reference, and Makefile:1201-1205 links build/liblayerx.a normally, so the symbol-absence contract recorded at tests/repair_22_39_76.kvx:30-33 cannot detect an unreferenced archive member defining a retired API."
close_comment = "The payer-grant absence checks can pass even when the library defines a retired API, because weak references do not pull otherwise unreferenced members from a static archive. The repair task adds direct inspection of the built archive and regression controls that reject each forbidden definition while accepting their absence."

