[req.181678]
title = "ABCI query conversion cannot promote unknown internal details into public error messages"
ac_1 = "Given unknown internal failures from a real gRPC query path or the legacy versioned store query at sdk/baseapp/abci.go:618 and sdk/store/rootmulti/store.go:607, non-debug ResponseQuery values carry undefined codespace, code 1 and exactly internal error with no raw diagnostics, debug gRPC responses retain diagnostic details, registered module errors and mapped client statuses retain their codes, and successful queries retain their values."

