[card]
role = "fm-ledger-auth-pay"
domain = 2
sandbox_profile = "go-cgo"
anchors = ["2.0.1", "2.0.2", "2.0.3", "2.0.4", "2.0.9"]
wave_gate = ["scripts/gates/wave-0.sh", "scripts/gates/wave-1.sh", "scripts/gates/wave-2.sh", "scripts/gates/wave-4.sh", "scripts/gates/wave-6.sh", "scripts/gates/wave-7.sh", "scripts/gates/wave-8.sh", "scripts/gates/wave-9.sh", "scripts/gates/wave-10.sh", "scripts/gates/wave-11.sh", "scripts/gates/wave-12.sh", "scripts/gates/wave-13.sh", "scripts/gates/wave-14.sh", "scripts/gates/wave-15.sh", "scripts/gates/wave-16.sh", "scripts/gates/wave-17.sh", "scripts/gates/wave-18.sh", "scripts/gates/wave-19.sh", "scripts/gates/wave-22.sh", "scripts/gates/wave-24.sh", "scripts/gates/wave-25.sh", "scripts/gates/wave-26.sh", "scripts/gates/wave-27.sh", "scripts/gates/wave-28.sh", "scripts/gates/wave-29.sh", "scripts/gates/wave-30.sh", "scripts/gates/wave-31.sh"]
max_parallel = 38
escalation = "stop the wave and file a qualification finding"
limits = ["max_task_minutes = 30", "max_gate_runs_per_task = 1", "source = spec/workflow.kvx:32-36"]
no_false_success = "A task remains in_progress through implementation and task qualification. Mark it done only after its verify_cmd genuinely passes. Aggregate suites, sanitizers, workspace-wide lint, cluster and browser matrices are release-candidate gates, run once per wave or once at release, never per task. Surface honest partials and external blockers; 'implemented, not qualified' is an acceptable reported outcome."
