[meta]
format_version = 1
name = "Programme decisions"

[decision.1]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D1.md"
binds = ["17.8.2", "17.8.1", "17.0.4"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "modules/lxphost/ctx.go:1 enables cgo and modules/lxphost/ctx.go:50 imports C. programs_execute accepts lxp_module_ctx (src/modules/programs/registration.c:155). PerpsAddress is the pure-Go venue at 0x1015 (precompiles/perps/perps.go:25), matching ExchangeAddress (modules/layerxexchange/types/ids.go:15)."

[decision.2]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D2.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "Kernel accounts carry subaccount_kind (include/layerx/lxp_genesis.h:148) and parent_account_id (include/layerx/lxp_genesis.h:149). GetAccount takes an EVM address (modules/perps/keeper/account.go:20), and Deposit credits that account (modules/perps/keeper/account.go:51)."

[decision.3]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D3.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "The kernel defines eight authority kinds, from LXP_AUTHORITY_OWNER (include/layerx/lxp_authority.h:12) through LXP_AUTHORITY_KIND_TIMELOCK (include/layerx/lxp_authority.h:19), including LXP_AUTHORITY_SESSION_KEY (include/layerx/lxp_authority.h:13)."

[decision.4]
carry = "superseded"
record = "spec/layerx-merge/docs/decisions/D4.md"
binds = ["17.8.2", "17.8.1", "17.1.8"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "modules/layerxcustody holds the custodied balances the release moves (decision.642); the merge plan handler is mergeUpgradePlan (node/upgrades.go:457)."

[decision.5]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D5.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "Activation remains a bring-up at a height with no account-state migration: activationStoreUpgrades (node/upgrades.go:419) returns Added stores (node/upgrades.go:421)."

[decision.6]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D6.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "WithLXPReasons opts into registry reasons (precompiles/common/precompiles.go:108), and RevertReason encodes Error(string) (precompiles/common/precompiles.go:131)."

[decision.7]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D7.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "The kernel batch carries one timestamp_ms (include/layerx/lxp_batch.h:32), and GetMaxFeeTokenRateAge reads the governance parameter (modules/evm/keeper/params.go:310)."

[decision.8]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D8.md"
binds = ["17.8.2", "17.8.1", "17.0.4"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "Kernel caps are LX_PERPS_BOOK_CAPACITY = 256 (include/layerx/lx_perps.h:27) and LX_PERPS_DISPATCH_MAX_FILLS = 8 (include/layerx/lx_perps.h:34). Spot addresses run from PECORAddress (modules/spot/types/keys.go:14) to PECORVaultAddress (modules/spot/types/keys.go:26); the launchpad swap records FeeRecorded (modules/launchpad/keeper/swap.go:32)."

[decision.9]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D9.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "Program fees remain metering times prices on top of gas. Deployment admits the current lxp_programs_metering_schedule_current (src/modules/programs/deploy.c:239) through the lxp_module_ctx accepted by validate_wasm (src/modules/programs/deploy.c:223)."

[decision.10]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D10.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "The x402 conformance suite includes PaymentPayload requests (services/interop/specs/conformance/x402/README.md:9)."

[decision.11]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D11.md"
binds = ["17.8.2", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "splitProgramFee pays equal shares and the remainder to the first signer (modules/xweb/keeper/program_fulfil.go:191). ProgramFeeDenom resolves the per-asset denomination (modules/xweb/keeper/program_denom.go:16); origin-1 payment uses SendCoins to the module account (modules/xweb/keeper/request.go:59)."

[decision.12]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D12.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "e1a14bbe6e479ebbe72b82cf405a554ade565455"
basis = "Origin-2 observations admit at most ObservationMaxSignatures = 16 signatures (modules/xweb/types/observation.go:11), which verifyProgramSignatures applies to the attestor set and to the signature list (modules/xweb/keeper/program_fulfil.go:41, :47); the attestor set is capped at MaxAttestorSetSize = 16 (modules/xweb/types/state.go:213), while MaxAttestors = 64 (modules/xweb/types/keys.go:21) bounds only origin-1 fulfil signatures (modules/xweb/keeper/fulfil.go:21). The observation's NetworkID must equal the KernelNetworkId xweb param (modules/xweb/keeper/program_fulfil.go:124, modules/xweb/types/state.go:106)."

[decision.13]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D13.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "The reference guest crates are declared in programs/crates/layerx-programs-interpreter/Cargo.toml:2, programs/crates/layerx-programs-market/Cargo.toml:2 and programs/crates/layerx-programs-ai-market/Cargo.toml:2."

[decision.14]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D14.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "executeSponsored is defined at contracts/src/BatchCallAndSponsor.sol:135; the gas station encodes that batch at services/interop/crates/layerx-gas-station/src/tx.rs:245."

[decision.15]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D15.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "ReceiptKeys is the governed list of pinned receipt keys; primary and standby host key ranges may overlap (modules/sequencer/keeper/receipt_keys.go:77)."

[decision.16]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D16.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "The addr binding refusal registry includes LXP_ADDR_PANIC (precompiles/common/lxp_errors.go:303); the carried application-level rotation decision is spec/layerx-merge/spec.kvx:147."

[decision.17]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D17.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "services/agent/schema/agent-api/v1.kvx:3 declares major = 2."

[decision.18]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D18.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "SetLeaderPin is at consensus/internal/consensus/types/round_state.go:201 and LeaderPin.Leader at consensus/internal/consensus/types/round_state.go:451; BeginBlock passes votes to slashing at node/legacyabci/begin_block.go:61."

[decision.19]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D19.md"
binds = ["17.8.3", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "DeliverTx is at node/abci.go:190 and DeliverTxBatch at node/abci.go:251. The carried rollout policy is spec/layerx-merge/spec.kvx:168."

[decision.20]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D20.md"
binds = ["17.8.3", "17.8.1", "17.1.4"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "MergeAddressTable lists all eight agent addresses at precompiles/setup.go:66; node/precompiles.go:20 imports all eight constructor packages. newMergePrecompiles builds registered constructors at precompiles/setup.go:134 and mergePrecompileGate applies the v7.0 module gates at node/upgrades.go:553. The gateway's orob route is services/wallet/gateway/src/precompiles.ts:18."
value = "layerxctl stays an operator EVM client and the program registry service a read cache. All eight agent functions 0x0901-0x0908 have constructors registered through production node imports and are built from MergeAddressTable. Serving them remains subject to the v7.0 activation and module gates (decision.1706; task.17.1.4)."

[decision.21]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D21.md"
binds = ["17.8.3", "17.8.1", "17.1.8"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "layerxAnchor stays registered at precompiles/setup.go:212. Its executor refuses every method after StoreDeleteUpgrade, and refuses writes at the merge upgrade (precompiles/layerxanchor/layerxanchor.go:184)."

[decision.22]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D22.md"
binds = ["17.8.3", "17.8.1", "17.1.4"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "MergeAddressTable lists the four addresses at precompiles/setup.go:66. Their constructors register in precompiles/layerxagent/orob/merge.go:16, precompiles/layerxagent/clearing/merge.go:16, precompiles/layerxagent/oracle/merge.go:19 and precompiles/layerxagent/pofq/merge.go:16, imported by node/precompiles.go:20. computeClearing is declared at precompiles/layerxagent/clearing/clearing.go:22; activation gates are at node/upgrades.go:561."
value = "orob (0x0901), clearing (0x0902), oracle aggregator (0x0903) and pofq (0x0904) are implemented under precompiles/layerxagent, and their merge constructors are registered through production node imports. The v7.0 gate requires layerxagent for all four and also layerxexchange for oracle (decision.1706; task.17.1.4)."

[decision.23]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D23.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "DynamicGasPrecompile is at precompiles/common/precompiles.go:308 and WithLXPReasons at precompiles/common/precompiles.go:108."

[decision.24]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D24.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "lx_service_dispute_resolve_execute (src/modules/service/lx_service_dispute.c:87) already refuses every caller other than the linked escrow's arbiter with LXP_ERR_UNAUTHORIZED_ARBITER (src/modules/service/lx_service_dispute.c:114-116). The arbiter-only ruling is in force, and the linked escrow settles on the ruling in the same call; it is not a future target."

[decision.25]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D25.md"
binds = ["17.8.4", "17.8.1", "17.2.3"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "WithdrawMarginMethod remains declared for legacy replay (precompiles/layerxexchange/layerxexchange.go:52); live perps GetAccount takes an EVM address (modules/perps/keeper/account.go:20) and Withdraw implements margin withdrawal (modules/perps/keeper/account.go:81)."

[decision.26]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D26.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "The xweb attestor set verifies observations through verifySignatures (modules/xweb/keeper/fulfil.go:17)."

[decision.27]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D27.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "x402 conformance stays unchanged, including PaymentPayload requests (services/interop/specs/conformance/x402/README.md:9)."

[decision.28]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D28.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "Go-origin xweb errors use registry names such as LXP_XWEB_UNAUTHORIZED (modules/xweb/types/errors.go:43)."

[decision.29]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D29.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "0x0906 streams is listed at precompiles/setup.go:76, and LX_STREAM_ID_PAYLOAD_BYTES declares the stream id layout (include/layerx/lx_stream.h:26)."

[decision.30]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D30.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "DefaultGasCost is at precompiles/common/precompiles.go:467; perps states that every method is charged from the fixed gas table (precompiles/perps/perps.go:2)."

[decision.31]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D31.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "computeClearing is declared once at precompiles/layerxagent/clearing/clearing.go:22."

[decision.32]
carry = "rewritten"
record = "spec/layerx-merge/docs/decisions/D32.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "PriceFeedAddress is at precompiles/pricefeed/pricefeed.go:23; the pushOracle refusal is exercised at precompiles/perps/switch_test.go:711."

[decision.33]
carry = "kept"
record = "spec/layerx-merge/docs/decisions/D33.md"
binds = ["17.8.4", "17.8.1"]
basis_revision = "d90e6b8263ef3c6c4976fc5d0ee16ba20666b7db"
basis = "One xweb attestor set is checked by verifySignatures (modules/xweb/keeper/fulfil.go:17)."

