refusal = "LXP_MODULE_DISABLED"
deleted_trees = []
replacement = "drop the layerxVerify reference; after the plan height every method returns Error(string) LXP_MODULE_DISABLED, so the caller reads the committed header and an ICS23 proof through abci_query prove=true or eth_getProof instead"
address = "0x1012"

