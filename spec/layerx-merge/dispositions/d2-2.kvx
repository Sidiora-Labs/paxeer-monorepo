[disposition.2.22.4.3]
finding = "2.22.4.3"
status = "resolved"
evidence = "Commit 2c48362b3 makes Submit use the unchanged identity sequence, NotBefore equal to block time and NotAfter equal to block time plus the window at modules/layerxpay/keeper/execute.go:49, with no stored-receipt lookup."

[disposition.2.22.4.4]
