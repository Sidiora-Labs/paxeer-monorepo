[disposition.22.16.4.2]
finding = "22.16.4.2"
status = "resolved"
evidence = "Commit ff75a3d8a00ba84d6a93aa26e979d3d747cef368 changed tests/codec/lxp_test_receipt_authority_v2.c:138 to read the V2 authority record through begin_authority and assert its version, network, protocol, module, operation, result and block height directly from the 151-byte record. The byte-for-byte record comparison remains at tests/codec/lxp_test_receipt_authority_v2.c:152."

[disposition.22.8.10.1]
finding = "22.8.10.1"
status = "environment"
evidence = "On main, tools/platform/cli/src/credential.rs:17 selects operating-system credential storage by default and an encrypted file store when explicitly requested, while tools/platform/cli/src/credential.rs:48 reports an unavailable operating-system store as an error. The credential prerequisite check at tools/platform/cli/tests/common/credential_environment.rs:26 preserves mandatory D-Bus coverage when LAYERX_CLI_TESTS_REQUIRE_DBUS is set."

[disposition.22.7.3.1]
finding = "22.7.3.1"
status = "resolved"
evidence = "Commit 0aea0c30078d51279d6db6e229d2c3d290e50600 gives the receipt-root chain its consensus parameters at rpc/header_receipts_root_test.go:70 and checks both event-bus and committed-notifier heads against the same block's results at rpc/header_receipts_root_test.go:197. The tracer transaction uses the sender's current nonce at rpc/debug_tracer_shape_test.go:63, and rpc/notifier.go:121 publishes a copied header with the finalized block's state root."

[disposition.22.9.23.1]
finding = "22.9.23.1"
status = "resolved"
evidence = "Commit 8c8479abd94bc9750297a3fca4d828dc38a069de selects the ledger payExact vector and derives amount, asset and recipient from its PaymentExact log and payer from its padded transaction sender at services/agent/sdk/python/tests/test_sequencer_receipt.py:28. Grant draws bind the receiver controller and signed context, carry integer network_id 125, and sign the authorization at services/agent/sdk/python/tests/test_x402_draw_sequencer.py:235."

[disposition.22.16.4.4]
finding = "22.16.4.4"
