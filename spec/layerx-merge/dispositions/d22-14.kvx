evidence = "Commit ea039363eee9b135bcc504e4c82802cd930c0c8a replaces the deleted keeper reader with the getPayerGrant precompile call at precompiles/layerxledger/payments_test.go:161 and precompiles/layerxledger/views_test.go:174. Both assert the current LXP_NO_PAYER_GRANT retirement refusal, and payments_test.go:164 also checks that the refusal preserves the stores and logs."

[disposition.22.7.3.2]
finding = "22.7.3.2"
status = "resolved"
evidence = "Commit 0aea0c30078d51279d6db6e229d2c3d290e50600 reads the live nonce at rpc/debug_tracer_shape_test.go:63, falls back to committed state when no block is open at rpc/simulate.go:339, supplies the header chain's consensus parameters at rpc/header_receipts_root_test.go:70 and publishes the finalized state root at rpc/notifier.go:121. Commit 054988c9f53ec52ac1f21d54dfcdb58d6e0f9ffa installs the merge precompile dependencies through precompiletest.Install at rpc/tests/utils.go:83."

[disposition.22.2.5.5]
finding = "22.2.5.5"
status = "resolved"
evidence = "Commit ea039363eee9b135bcc504e4c82802cd930c0c8a removes the module-store revoke replay marker: modules/layerxauth/keeper/revoke.go:16 checks actor binding first, then modules/layerxauth/keeper/revoke.go:30 executes revocation through the kernel on a cached context. Kernel revocation refusals propagate without a module replay marker, and the cache is committed only after a matching GrantRevoked event."

[disposition.22.2.6.4]
finding = "22.2.6.4"
status = "resolved"
evidence = "Commit 0ecd6928d77b72510067eff4f37843c52504a77a identifies DA missing as a service-delivery refusal at spec/layerx-merge/contracts/address-table.md:337, derives the below-merge address set from MergeAddressTable at precompiles/common/retire_test.go:105 and gives getDispute a readGas(1000) row at precompiles/layerxpay/gas.go:75. The corresponding registry entry at precompiles/common/lxp_errors.go:164 has no kernel value, and the service-view gas cases remain explicit at precompiles/layerxpay/service_views_test.go:161."

