evidence = "Commit ccd3b0d9d2af7c9b24f51389fa3343cc13d2fa25 makes ValidateGenesis accept an absent anchor state at modules/layerxanchor/module.go:48 because anchor exports have no genesis lifecycle. Nonempty state still goes through json.Unmarshal at modules/layerxanchor/module.go:55, preserving the malformed-state refusal."

[disposition.22.11.7.4]
finding = "22.11.7.4"
