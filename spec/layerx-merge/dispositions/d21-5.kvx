status = "resolved"
evidence = "Commit 07e2996df makes produce_transaction use latest_nonce at services/agent/crates/layerx-mcp/tests/proof_native_reads.rs:187 on main. services/agent/crates/layerx-client/src/sequencer.rs:369 implements that read with eth_getTransactionCount at latest, so this transaction producer does not request a proposer-only pending nonce."

[disposition.21.95.1.3]
finding = "21.95.1.3"
status = "resolved"
evidence = "Commit 07e2996df binds the native-read producer's configuration to the generated configuration file at services/agent/crates/layerx-mcp/tests/proof_native_reads.rs:107 on main. Lines 120 and 121 select the sequencer endpoint and signing key from that file, and line 279 passes that key to produce_transaction instead of reading either value from the process environment."

[disposition.21.92.1.4]
finding = "21.92.1.4"
status = "resolved"
evidence = "Commit 2afc32013 adds the recorded-hash lookup at rpc/send.go:201 on main: SendRawTransaction returns a known transaction's hash before a second Accept, preserving its original receipt and nonce. rpc/server.go:235 supplies the same send-record source used by the receipt API; an unknown hash still reaches sequencer admission."

[disposition.21.95.1.4]
finding = "21.95.1.4"
status = "resolved"
evidence = "Commit b333bce4c serves px_getReceiptKeys through GetReceiptKeys at rpc/sequencer_receipt.go:362 and registers its px service at rpc/server.go:326 on main. The method returns the latest governed receipt pins in the keys object with keyId, publicKey, firstHeight and lastHeight, forwarding to the proposer when its receipt source is remote."

[disposition.21.78.1.1]
finding = "21.78.1.1"
