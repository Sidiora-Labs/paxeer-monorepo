[disposition.21.95.1.1]
finding = "21.95.1.1"
status = "resolved"
evidence = "Commit 07e2996df places the native-read consumer proof in services/agent/crates/layerx-mcp/tests/proof_native_reads.rs:40, where it imports layerx_mcp through the consumer crate's own target on main. services/agent/crates/layerx-mcp/Cargo.toml:17 keeps the dependency on layerx-agentd one-way, and services/agent/crates/layerx-agentd/Cargo.toml:41 names the shared producer target native-reads-http."

[disposition.21.92.1.2]
finding = "21.92.1.2"
status = "resolved"
evidence = "Commit f7d25df24 preserves a single pending snapshot's open-versus-idle identity at rpc/watermark_manager.go:110 on main. rpc/tx.go:483 reads the open snapshot's nonce directly and selects committed state only when that snapshot reports idle, so an executed transfer's pending nonce comes from its open state."

[disposition.21.142.1.2]
finding = "21.142.1.2"
status = "resolved"
evidence = "Commit 6c70c0a3e changes sdk/wallet/src/index.ts:230 on main to omit chainId from the assertSendTxResponse options when tx.chainId is undefined. A defined chainId still reaches the response validator, preserving chain-mismatch refusal while satisfying exactOptionalPropertyTypes."

[disposition.21.95.1.2]
