[gotcha.1601]
area = "consensus rpc tests"
symptom = "a test that commits through BroadcastTxCommit times out at the 10 s default on a loaded host"
fix = "raise conf.RPC.TimeoutBroadcastTxCommit in the test node config; never relax the assertion"

[gotcha.1602]
area = "go test filters"
symptom = "go test -run is case-sensitive, so a filter like TestXweb skips TestXWebUpgradeKeepsExistingXWebState"
