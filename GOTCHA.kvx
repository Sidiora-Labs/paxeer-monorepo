[gotcha.1629]
area = "agent workspace lock"
symptom = "a dependency added to an interop crate makes --locked commands in the agent workspace fail too, because the interop crates are path dependencies of agent/Cargo.toml"
fix = "refresh agent/Cargo.lock offline in the same task; git treats it as binary, so review with git diff --text"

[gotcha.1630]
area = "wallet app typecheck"
symptom = "human/apps/wallet typecheck fails inside the linked wallet SDK source (ExtendedPoint) although the SDK builds on its own"
fix = "the app tsconfig paths map @noble/curves and @noble/hashes to the app node_modules, so the app pins must equal the SDK pins (task 0.148)"

[gotcha.1631]
area = "cargo test crate gates"
symptom = "a crate-wide cargo test stops at the first failing integration test binary, so later test binaries never run and their counts are missing from the log"
fix = "read the log for the first failing binary before assuming later tests were reached; name test binaries with --test when a gate must report each one"

[gotcha.1632]
area = "ai-market errors"
symptom = "ApplicationError of the ai-market crate does not implement std::error::Error, so ? in a test returning Box<dyn Error> does not compile"
fix = "convert with ServiceError::from before using ?"

[gotcha.1633]
area = "gas station tests"
symptom = "GasStation::new reads GAS_STATION_DID_GAS_LIMIT from the process environment, so tests in one binary that set different values race"
fix = "set one value per test binary"

[gotcha.1634]
area = "python gates"
symptom = "python3 -m py_compile writes __pycache__ next to the module even when the module sets sys.dont_write_bytecode"
fix = "delete the __pycache__ directory before staging"

[gotcha.1635]
area = "json fixture writers"
symptom = "serde_json key order depends on the preserve_order feature, so a fixture written once may differ byte-for-byte from the next writer"
fix = "insert keys in sorted order in the writer so both orderings produce the same bytes"

[gotcha.1636]
area = "xweb keeper tests"
symptom = "xwebtestutil.NewKeeper creates its store key internally, so an external test that needs raw store access cannot reach it"
fix = "Create the store key in the test and pass it through xwebtestutil.WithXWebStore"

[gotcha.1637]
area = "go test filters"
symptom = "go test -run TestProgramOrigin also matches the existing TestProgramOriginUsesTheXWebSet in msg_server_test.go, so pass counts include it"
fix = "Anchor the pattern (^TestProgramOrigin[A-Z]) or count the extra case when reading the verify output"

[gotcha.1638]
area = "shell chains"
symptom = "mkdir -p on a path that already exists as a file fails and stops the following && chain, so a heredoc write after it silently never happens"
fix = "Check the path with test -d first or write to a fresh directory"

[gotcha.1639]
area = "evm fee tokens"
symptom = "Reading a coinbase fee-token balance after ProcessBlock always gives zero, because EndBlock sweeps coinbase(idx) to the fee collector and ProcessBlock routes the collector to the fee-token holding account"
fix = "Assert the fee-token holding account after the block; assert the coinbase only inside the same block before EndBlock"

[gotcha.1640]
area = "pnpm lockfiles"
symptom = "pnpm install --lockfile-only re-resolves the whole wallet app lockfile (about 380 lines change: peer suffixes and libc fields)"
fix = "Edit the two importer entries by hand when only named packages change"

[gotcha.1641]
area = "pnpm offline"
symptom = "pnpm --offline lockfile resolution fails when the metadata cache has no entry for a package (for example @playwright/test), while the frozen offline install works"
fix = "Use pnpm install --frozen-lockfile --offline for the build; do not resolve offline"

[gotcha.1642]
area = "explorer formatting"
symptom = "mix format on the host fails in a worktree without deps because the formatter imports open_api_spex"
fix = "Format explorer backend files with explorer/deploy/tools/mix-in-builder.sh format <files>"

[gotcha.1643]
area = "cargo clippy"
symptom = "cargo clippy --keep-going still stops at the first test target that fails a lint, so one run hides the other targets"
fix = "Loop over --lib and each --test target to see every finding before the single verify"

[gotcha.1644]
area = "cargo locks"
symptom = "agent/Cargo.lock and platform/Cargo.lock are -diff in .gitattributes, so git diff only says Binary files differ"
fix = "Review lock changes with git diff --text or diff -a against a saved copy"

[gotcha.1645]
area = "cargo clippy"
symptom = "Pedantic clippy errors in path dependencies stop clippy from compiling the dependent crate, hiding findings in the crate under review"
fix = "Run clippy with --no-deps -- --cap-lints warn to see the crate's own findings"

[gotcha.1646]
area = "cargo locks"
symptom = "--locked platform and agent gates fail before compiling while a lock lacks a new dependency edge (sha3 for the interop gateway)"
fix = "Refresh offline with cargo metadata --offline, review with git diff --text, and land the lock refresh with the task"

[gotcha.1647]
area = "paxai runner"
symptom = "Separate runner processes need a per-job lock to stay idempotent; std File::lock (MSRV 1.91) does this without a new dependency"
fix = "Hold the lock only while reading or writing the job journal, not while the engine runs, so a cancel can still be recorded"

[gotcha.1648]
area = "node transactions"
symptom = "The node's transactionsRoot is the Comet DataHash (rpc/block.go:479), a merkle over Cosmos tx bytes, so EVM raw transactions cannot be checked against it directly"
fix = "Verify EVM transactions through the sequencer receipt and committed proof, not the header transactionsRoot"

[gotcha.1649]
area = "layerx-client"
symptom = "RPCTransaction from the node has no raw field; raw bytes must be rebuilt by RLP from the full transaction object fields (types 0-4)"
fix = "Rebuild the raw bytes with the existing RLP encoder; re-derive the hash only where a keccak dependency exists"

[gotcha.1650]
area = "sdk-gen formatting"
symptom = "Mandatory Prettier/Black formatting of generated clients differs from the raw bytes sdk-gen emits, so the byte-exact drift check and the formatting rule conflict"
fix = "The generator emits formatted output (or the drift check compares formatted bytes); never hand-edit generated clients"

[gotcha.1651]
area = "kernel tests"
symptom = "make build does not compile tests/test_replica_ingest.c, so retiring an acknowledgement API passes the build while the test target is left calling the removed function"
fix = "Build and run the replica ingest test target in the verify when the ingest API changes"

[gotcha.1652]
area = "rust"
symptom = "cargo exits 101 in the rustc target probe with unterminated character literal errors on shell text"
fix = "check stat -c %F /dev/null; when it is a regular file the probe reads its contents as stdin, so redirect cargo stdin from an empty file until the device node is restored with mknod -m 666 /dev/null c 1 3"

[gotcha.1653]
area = "git"
symptom = "NOADD=1 fleet commit records an empty commit because nothing was staged"
fix = "git add the owned paths explicitly before the NOADD=1 commit"

[gotcha.1654]
area = "rust"
symptom = "gas station crate tests under clippy pedantic -D flag similar_names on signer/signed and unnecessary_wraps on helpers that only return Ok"
fix = "rename the pair and expose the helper through a Result type alias such as Read<'a> = Result<&'a K, E>"

[gotcha.1655]
area = "programs"
symptom = "ai-market dispatch arm refuses CAPACITY or NON_CANONICAL for a newly routed producer"
fix = "TRANSITION_SCRATCH_BYTES must include the producer's scratch size and the arm's Payload must be the bytes the producer hashed, not the digest, because applied_frame compares result_digest(payload) with common.result"

[gotcha.1656]
area = "kernel"
symptom = "stack overflow or several MB of stack per thread after raising LXP_KERNEL_MAX_MODULE_KV"
fix = "lxp_kernel embeds the module KV table by value (about 2.4 MB at 2048 rows); allocate kernels on the heap in threads and tests that hold two of them"

[gotcha.1657]
area = "programs"
symptom = "ai-market wasm32 release guest exceeds the deploy payload bound; per-package opt-level z is larger than s under the workspace lto profile"
fix = "post-process with binaryen wasm-opt -Oz --strip-debug --strip-producers (538102 to 448162 bytes); apt-get install binaryen on the build host"

[gotcha.1658]
area = "go"
symptom = "go build ./node/... passes in a fresh worktree but go test ./node/ or ./modules/xweb/keeper/ fails at link"
fix = "run make build/liblayerx.a programs/target/debug/liblayerx_programs_sandbox.a first"

[gotcha.1659]
area = "rust"
symptom = "test engines written as executables fail exec with text file busy under parallel tests"
fix = "create every engine file in one OnceLock fixture before any test thread spawns a process"

[gotcha.1660]
area = "fleet"
symptom = "parallel lanes that each edit CI path lists (workflows, labeler, CODEOWNERS, 22 dockerignores) conflict on every file at rebase"
fix = "resolve by keeping the main side verbatim and re-applying only the lane's own additions/removals; never resurrect a path main already renamed"

[gotcha.1661]
area = "codify"
symptom = "cg spec lint -f layerx-merge runs past 30 minutes at 99% CPU and gets killed when several worktrees run it at once"
fix = "run the lint once on main after the wave lands, in the background with a long timeout; lanes that do not touch spec/ skip it"

[gotcha.1662]
area = "fleet"
symptom = "fleet-commit.sh with NOADD=1 still commits when a preceding git add pathspec fails, leaving a commit with only part of the change"
fix = "check git status --short before the commit and amend or soft-reset if the staged set is incomplete"

[gotcha.1663]
area = "codify"
symptom = "cg spec lint on one lane part of a multi-part spec reports requires-unknown-task errors for every cross-part task id"
fix = "lint all parts together through the assembler before judging a part; a part-only lint is for syntax only"

[gotcha.1664]
area = "codify"
symptom = "a part-check that pipes cg spec lint through grep and tail returns the pipeline's exit code, so a killed or silent lint still shows exit 0 and PASS"
fix = "read the lint summary line itself (N error(s), M warning(s)); treat a missing summary as not linted, never as passed"

[gotcha.1665]
area = "codify"
symptom = "cg spec lint on a 31k-line spec is single-threaded and runs 30 minutes or more even on a quiet box"
fix = "run it once per spec revision in the background with no timeout and continue other work; never run it per lane"

[gotcha.v612-batch-script-edit]
observed = "Editing a queued bash batch script in place with sed -i while it waits in its until loop has no effect: bash keeps reading the old inode, so the additions never run although the files the script reads at run time (findings) are picked up."
rule = "Never edit a running batch script; queue a new script that waits on the previous sentinel."

[gotcha.1667]
area = "fleet"
symptom = "a Codex lane launcher that redirects a prompt file into stdin inside a backgrounded nohup exits 0 even when the prompt file name is wrong, so lanes uploaded under another extension silently never run"
fix = "name prompt files exactly as the launcher reads them and check the lane log exists and grows before counting the lane as running"

[gotcha.1668]
area = "fleet"
symptom = "the shared Go build cache grew to 150G and every lane worktree kept a 2G programs/target, which filled the root filesystem and turned every build into no space left on device"
fix = "clear the Go cache and delete programs/target and build/ in finished worktrees before the disk passes 90 percent; workers use a private GOCACHE when the shared one is being trimmed"

[gotcha.1669]
area = "spec"
symptom = "a verify_cmd of the shape go test ... | tail -60 reports the exit code of tail, so a node build failure shows as exit 0"
fix = "read the test summary in the log, never the pipeline exit code, when the verify_cmd ends in a pipe"

[gotcha.1670]
area = "fleet"
symptom = "a landed lane's commit message carries the spec task id, not the lane name, so polling main for a fix lane name never matches"
fix = "poll for the files or symbols the lane adds, or for the task id in the commit subject"

[gotcha.1671]
area = "node"
symptom = "RunMigrations runs InitGenesis(DefaultGenesis) for any module absent from the from-version map, so an upgrade hook that owns a module's initial state hits ErrAlreadyInitialised on a live chain"
fix = "record new modules in the version map at their consensus version before RunMigrations and let the upgrade hook write the state"

[gotcha.1672]
area = "launchpad"
symptom = "sdk.ValidateDenom refuses 0x addresses because a denom must start with a letter, so a field moved from a bank denom to an ERC20 address fails genesis validation"
fix = "change the validator to the address canonicaliser together with the field"

[gotcha.1673]
area = "hyperpax"
symptom = "tsx runs .tsx test renders with the classic JSX runtime, so a component rendered from a node test throws React is not defined although next build is fine"
fix = "import React in any .tsx module a node test renders"

[gotcha.1674]
area = "go"
symptom = "a lane that exports GOFLAGS=-mod=mod rewrites go.mod and go.sum on every build and the diff lands as noise"
fix = "never set GOFLAGS=-mod=mod; vendor state is authoritative"

[gotcha.1675]
area = "perps-data"
symptom = "hub.Listen called while the hub lock is held deadlocks the gateway on the first subscriber"
fix = "release the hub lock before calling Listen"

[gotcha.1676]
area = "perps-data"
symptom = "store tests on the shared lane Postgres interfere when two lanes run them at once"
fix = "each lane uses its own database name on the lane Postgres"

[gotcha.1677]
area = "go"
symptom = "fmt.Errorf with %v around a TransferHelper error drops the wrapped sentinel so errors.Is never matches"
fix = "wrap with %w"

[gotcha.1678]
area = "go"
symptom = "packing a nil *big.Int into an ABI argument panics inside go-ethereum instead of returning an error"
fix = "guard nil before abi.Pack and use a zero big.Int"

[gotcha.1679]
area = "go"
symptom = "go vet stops after ten errors so a package with more looks like it has exactly ten"
fix = "fix the first ten and rerun until vet prints nothing"

[gotcha.1680]
area = "sprites"
symptom = "sprite file push into a subdirectory of the sprite home refuses with directory does not exist although the directory exists"
fix = "push to the home directory and mv with sprite exec"

[gotcha.1681]
area = "native"
symptom = "a cargo build per worktree fills the disk with target directories"
fix = "build the native libs once and hard-link liblayerx.a and the sandbox lib into each worktree"

[gotcha.1682]
area = "shell"
symptom = "pgrep -f in an until-loop matches the loop's own shell command line and never exits"
fix = "match on a bracketed pattern or use pgrep -x on the process name"

[gotcha.1683]
area = "node"
symptom = "SetupWithGenesisValSet funds the bonded pool with one bond amount whatever the validator count, so any multi-validator test app panics in staking InitGenesis"
fix = "fund the bonded pool and total supply per validator"

[gotcha.1684]
area = "node"
symptom = "allowedReceivingModAcc only feeds BlacklistedAccAddrs; the bank keepers built from ModuleAccountAddrs still refuse sends to a module listed there"
fix = "build the bank keepers from BlacklistedAccAddrs"

[gotcha.1685]
area = "evm"
symptom = "CallEVM merging into a transaction receipt puts the current call's logs ahead of the earlier logs, so the newest log sits at index 0"
fix = "read the log order from the keeper merge before asserting on an index"

[gotcha.1686]
area = "spot"
symptom = "inside an EVM run pullTokens returns the resumed stateDB ctx, so a record written to it is invisible to reads on the caller's ctx and stopRead returns a zero record with a nil error"
fix = "write through the caller's ctx and surface a miss as an error"

[gotcha.1687]
area = "node"
symptom = "a non-minor upgrade plan at height N with its handler registered panics in every BeginBlock below N, and a plan written between RunBlock calls through NewUncachedContext is not applied by the next BeginBlock"
fix = "schedule the plan inside the block flow just before its height"

[gotcha.1688]
area = "perps"
symptom = "the perps solvency invariant fails on any block whose collateral token has no deployed code"
fix = "name a deployed token as collateral before the first block of a test app"

[gotcha.1689]
area = "launchpad"
symptom = "launchpadtest keepers run on an overlay store the app's own 0x1017 precompile cannot see, so a keeper write that triggers a nested surface call reverts with LXP_LAUNCHPAD_TRANSFER_FAILED"
fix = "drive such writes through the harness EVM whose 0x1017 is the test precompile"

[gotcha.1690]
area = "launchpad"
symptom = "swap subtests sharing one env carry USDL left by refusal cases forward as prepaid input, so a later buy that transfers again prepays twice"
fix = "swap the already prepaid input instead of transferring again"

[gotcha.1691]
area = "node"
symptom = "require.Equal on keeper structs holding an authkeeper.AccountKeeper never passes because of its func field, and testify's diff panics in spew on unexported map keys"
fix = "compare the %#v rendering of the two keepers"

[gotcha.1692]
area = "node"
symptom = "a module listed in allowedReceivingModAcc whose genesis never creates its module account gets a BaseAccount on the first send and its MintCoins panics"
fix = "create the module account in genesis and in the upgrade handler"

[gotcha.1693]
area = "build"
symptom = "make paxd-build depends on paxd-native-libs which runs cargo even when the libs are already linked"
fix = "run the recipe body directly when the native libs are present"

[gotcha.1694]
area = "hyperfide"
symptom = "install-service.mjs refuses RELEASE_INVALID when manifest.sig sits inside the release root, because the detached signature is an unpinned file in the tree"
fix = "keep manifest.sig beside the tarball and pass it with --signature-file from outside the release root"

[gotcha.1695]
area = "hyperfide"
symptom = "install-service.mjs rejects --service-gid below 1000; useradd -r allocates a system gid"
fix = "groupmod -g 1900 hyperfide (uid and gid both need four digits) before installing"

[gotcha.1696]
area = "hyperfide"
symptom = "the three service units run as three different users (hyperfide, hyperfide-provisioner, hyperfide-dispatch) in group hyperfide, and the authority journal directory must be owned by the running user with mode 0700"
fix = "create all three users and one journal directory per role under /var/lib/hyperfide before writing the env files"

[gotcha.1697]
area = "hyperfide"
symptom = "an ordinary control/provisioner/dispatch service refuses at start with DURABILITY_POLICY_REQUIRED unless HYPERFIDE_REQUIRE_SYNC_REPLICA is 0 or 1, and with EXTERNAL_JOURNAL_REQUIRED unless HYPERFIDE_DEPLOYMENT_ID and HYPERFIDE_AUTHORITY_JOURNAL_DIR are set and an ACTIVE authority epoch exists"
fix = "set both variables explicitly and activate the first authority epoch before the first service start"

[gotcha.1698]
area = "hyperfide"
symptom = "the Railway 9.3 process actions, 9.1 capture and checkpoint lookup, and 9.4 inventory and quota actions all refuse in mode live; only the runtime adapter the provisioner installs executes against Railway"
fix = "do not drive live Railway work through those component actions; treat them as fixture diagnostics"

[gotcha.1699]
area = "fleet gateway"
symptom = "Claude Code through the Centra gateway fails every request with 400 reasoning_effort: Extra inputs are not permitted; the body carries no such field, the gateway adds it when the User-Agent is claude-cli or the x-app header is cli"
fix = "send the request with ANTHROPIC_CUSTOM_HEADERS overriding User-Agent and x-app until the gateway stops keying on the client name"

[gotcha.1700]
area = "fleet gateway"
symptom = "with the client headers overridden the gateway renames every tool with an _ide suffix on the way up and returns tool_use names such as Bash_ide, so Claude Code reports No such tool available for every call; non-stream JSON responses also end with a stray data: [DONE] line"
fix = "the gateway must preserve tool names on the Anthropic path; until then the Claude attempt yields nothing and the Codex retry does the work"

[gotcha.1701]
area = "fleet runtime"
symptom = "parallel runners started in the same second all try to create the same base-<tip>.bundle and die on the git bundle lock; the first owner dispatch worked only because the base equalled the checkpoint commit"
fix = "the dispatcher builds the base bundle once before spawning runners and claims each worker in its pool record at spawn time, with a short stagger"

[gotcha.1702]
area = "fleet runtime"
symptom = "a sandbox bash -lc command that contains pkill -f <name> kills its own shell, because the shell's command line also matches <name>, and the whole exec returns nothing"
fix = "start helpers in the background, keep their pid, and kill by pid"

[gotcha.1703]
area = "fleet runtime"
symptom = "the perps-data gates fail with PERPS_DATA_TEST_DATABASE_URL unset; the sandbox image ships a Postgres 18 cluster that is down by default and no packet starts it"
fix = "the runner's prepare phase starts the cluster, creates perps_test and exports the URL from /etc/profile.d so every login shell and tool inherits it"

[gotcha.1704]
area = "fleet runtime"
symptom = "a run whose verify passes with no code change produces an empty bundle, is never merged, is never counted done by the dispatcher, and so never unblocks its dependents"
fix = "flip the task status to done in the integration spec with one commit per task once its verify passed on the integration base, then regenerate the packet index"

[gotcha.1705]
area = "fleet runtime"
symptom = "Claude Code runs through the Centra gateway exit cleanly but every tool call fails with No such tool available: the gateway appends _ide to every tool name upstream and returns tool_use blocks named Bash_ide, Read_ide; 62 runs, zero commits, while the gateway dashboard shows them as successful requests"
fix = "run a stdlib reverse proxy inside the sandbox between Claude Code and the gateway that strips the _ide suffix from tool_use names (streamed content_block_start events line by line, non-stream JSON bodies whole) and drops the stray data: [DONE]; validate with a probe that requires a real Bash call, not a text-only reply"

[gotcha.1706]
area = "fleet runtime"
symptom = "a sandbox background process started as python3 … & survives kill $!: the mise python3 shim forks, and a && b & backgrounds the whole list as a subshell so $! names the wrong pid"
fix = "start the real interpreter from sys.executable as a simple command after a ; and kill that saved pid; in bash -lc exec shells use a bracketed pgrep pattern ([c]laude-proxy) and check PPID before acting on a pid"

[gotcha.1707]
area = "fleet runtime"
symptom = "dispatch.mjs accepts --dry, not --dry-run; an unknown flag is ignored and the call dispatches for real"
fix = "use --dry for a plan; read the usage line of every fleet script before trusting a flag name"

[gotcha.1708]
area = "fleet packets"
symptom = "workers told to record pre-existing failures and to leave code and check intact when they disagree repair nothing: nearly every verify failure on an already-implemented tree is pre-existing, so 17 tasks came back fail with zero repair cycles"
fix = "packet rule: a failing build or verify is the task's work whether or not it pre-existed; fix the root cause in the task's files, test setup and same-package helpers with every assertion kept as strong; the spec acceptance text decides a code-versus-test disagreement; only an out-of-scope root cause or a dependency's missing code is a blocker"

[gotcha.1709]
area = "fleet runtime"
symptom = "a task attempt whose verify passes with no code change (commits=0) is scored failed and triggers the retry harness, which then invents a change to have something to commit"
fix = "score an attempt done when it has commits or its evidence index says result pass with verify_exit 0; collect records the empty bundle and the leader flips the spec status"

[gotcha.1710]
area = "release toolchain"
symptom = "sandbox images on Ubuntu 26.04 ship gcc 15 while tools/release/toolchain.env pins CC_VERSION=13.3.0 and build-paxd.sh refuses"
fix = "install the nine Ubuntu 24.04 gcc-13 debs (13.3.0-6ubuntu2~24.04.1: gcc-13-base, libgcc-13-dev, libstdc++-13-dev, cpp-13, cpp-13-x86-64-linux-gnu, gcc-13, gcc-13-x86-64-linux-gnu, g++-13, g++-13-x86-64-linux-gnu) and point cc/gcc/g++/c++ at them with update-alternatives; do not register cpp, its alternative loops with Too many levels of symbolic links"

[gotcha.1711]
area = "fleet runtime"
symptom = "a fix-mode evidence index carries a commands list and no verify_exit, so outcome scoring sees result without verify_exit and scores the attempt by commits alone; a fix that confirms the tree already passes ends FAILED with zero commits"
fix = "read the fix ledger before reacting: commands all exit 0 plus defects fixed means nothing to land; only a task or requal run flips the spec status"

[gotcha.1712]
area = "fleet runtime"
symptom = "requal dispatch skips a task as not-integrated when its task ledger is done but the bundle merged empty, and gen-requalify.py silently writes zero packets when ids are comma-joined"
fix = "pass ids space-separated to gen-requalify.py; rerun a not-integrated task in task mode with --only, or accept the fix-run gate evidence when the task is already done"

[gotcha.1713]
area = "mainnet rpc"
symptom = "https://api-mainnet-beta.paxeer.network/rpc answers 502 while every node is synced: the edge nginx proxies to paxeer-shared-endpoint.fly.dev, which no longer resolves"
fix = "read chain state over ssh from a full node (curl 127.0.0.1:8645) or a local ssh -L tunnel; the edge manifest line for api-mainnet-beta needs a new upstream, an operator host write"

[gotcha.1714]
area = "mainnet rpc"
symptom = "every full node prunes with min-retain-blocks 100000 and refuses state at the v6.12.0 halt height 34742400, except the single archive node (min-retain-blocks 0), whose debug_traceCall still refuses with beyond max lookback of 10000"
fix = "eth_call, eth_getStorageAt and eth_getCode at H work on the archive node; debug_traceCall at H needs max_trace_lookback_blocks = -1 in its app.toml [json-rpc] section and a restart"

[gotcha.1715]
area = "shell"
symptom = "pgrep -f <pattern> run from a bash -c command whose own text contains the pattern matches the running shell and reports the process as present"
fix = "check listeners with ss -ltn or use pgrep -x on the binary name; never grep for a string that appears in the invoking command line"

[gotcha.1716]
area = "fleet runtime"
symptom = "dispatch --mode fix --only <id> happily runs a stale packets-fix/<id>.md from an earlier round when the new triage file carries the same id and assemble-fix-plan.py stopped at the duplicate without rewriting fix-plan.json"
fix = "later triage files now override earlier entries for the same id; always confirm gen-fix.py wrote the packet count you expect before dispatching, and close an aborted ledger (state FAILED, finishedAt) before redispatching"

[gotcha.1717]
area = "edge / public RPC"
symptom = "api-mainnet-beta.paxeer.network/rpc returns 502 after the Fly exit: the edge manifest still lists the paxeer-shared-endpoint.fly.dev upstream, which no longer resolves"
do = "point the manifest line for api-mainnet-beta.paxeer.network at a live upstream and re-render with tools/bringup/edge.sh; until then use the api1..api16 node names or the archive tunnel for reads"

[gotcha.1718]
area = "fleet-6120 assemble-fix-plan"
symptom = "a fix id present in two triage files was assembled from the alphabetically later file (spot-perps.json beat round5.json), so the worker ran a stale round-1 packet and recorded nothing to fix"
do = "assemble-fix-plan.py now orders triage files by mtime so the latest written entry wins; touch the file you mean to win and check fix-plan.json title before gen-fix"

[gotcha.1719]
area = "launchpad migration fixture"
symptom = "MigrateV6120 on the halt-height export aborts with holder balances differ from total supply: holders.json lists only the holders the recording lane knew, and the archive node serves logs only from 30252301 while paxscan never indexed some pool tokens"
do = "enumerate holders exhaustively (layout contracts, retained-range Transfer logs, explorer APIs, balanceOf probes) and require sum == totalSupply at H for every token before writing holders.json"

[gotcha.1720]
area = "modules/spot genesis tests"
symptom = "Keeper.InitGenesis calls EnsureModuleAccount, which needs a real EVM/account keeper; the old launchpad citations genesis.go:11/:53 are now spot genesis.go:55/:177"
do = "build the keeper over testkeeper.EVMTestApp with pricefeedtestutil.NewKeeper and WithPriceFeedStore, as msg_server_test newSpotEnv does"

[gotcha.1721]
area = "repo hygiene"
symptom = "a stray codec.go at the repository root (package types, duplicating modules/layerxauth/types/codec.go) turns the module root into a Go package that cannot compile, and scripts/specgen.sh was rewritten with a hard-coded checkout path and a wrong relative tool path"
fix = "keep generated or copied files out of the module root; specgen.sh derives the root from BASH_SOURCE and runs ./tools/specgen; delete the stray file instead of committing it"

[gotcha.1722]
area = "git history rewrite"
symptom = "a filter-branch --index-filter with a brace pattern such as tasks/{a,b}/file.tar.gz inside quotes removed only the literal paths outside the braces: the filter runs under sh, which never expands braces, so four of five blobs stayed reachable"
fix = "spell every path out in the index filter, then prove the result with git rev-list --objects <range> | grep -c <name> before trusting the rewrite"

[gotcha.1723]
area = "edge proxy"
symptom = "tools/bringup/edge.sh set stops with 'manifest line of <name> has no upstream mode this script renders' on an edge host whose manifest was written by the September script: those lines carry four fields (name mode fly-app port) while the current script reads six (name mode upstream port kind sni), and the script copy at EDGE_NGINX_DIR/edge/edge.sh only exists after a successful set"
fix = "convert each old http line to '<name> http <app>.fly.dev:<port> <port> railway -' (awk over a saved copy), confirm with awk 'NF!=6' that nothing is left, then rerun set; a balanced RPC name needs only an env file with EDGE_APP pointing at a comment-only map plus EDGE_RPC_NAME and EDGE_RPC_POOL"

[gotcha.1724]
area = "release rehearsal tests"
symptom = "a worker's 29 GB disk fills after a handful of tools/release/tests/swap.test.sh or rollback.test.sh runs: each run keeps its node homes and the previous-binary source under <repo>/.logs/swap.* (about 2 GB per run, gitignored, so git clean -fd leaves them) until git checkout fails with 'No space left on device'"
fix = "remove <repo>/.logs before a fresh checkout on a reused machine (the fleet runner now does so in its prepare step), and keep only the run under investigation while triaging"

[gotcha.1725]
area = "launchpad precompile tests"
symptom = "go test ./precompiles/launchpad/ -run 'TestNft|TestFee|TestEvent' runs none of the NFT collection tests, which are named TestCollection… and TestFeeRight…, so a gate on that pattern can pass while the NFT logs are wrong"
fix = "name the tests (TestCollectionServesEverySelector, TestFeeRightReceiverHook, TestFeeRolesServeEverySelector) or run the package with -skip 'Parity' while the golden fixture is absent"

[gotcha.1726]
area = "git"
symptom = "git stash followed by git stash pop on a checkout that has no local changes pops an unrelated older stash entry (git stash saves nothing when the tree is clean, so pop takes the previous stash@{0}) and leaves modify/delete and content conflicts in the working tree"
fix = "check git stash list before any stash/pop pair, or use git stash push -q || true only when git diff --quiet reports changes; recover with git reset --hard HEAD, the popped entry is kept in the stash list on a failed pop"

[gotcha.1727]
area = "vendored trees"
symptom = "scripts/ci/vendor-verify.sh reports two upstream files as different although they were copied byte for byte: the root .gitattributes rule '* text=auto eol=lf' converts upstream CRLF files to LF at git add, so the tracked blob no longer equals upstream's"
fix = "stage the raw upstream blobs with git hash-object --no-filters -w and git update-index --cacheinfo 100644 <blob> <path>, then commit; the working copy is written with LF on checkout while the tracked bytes stay upstream's"

[gotcha.1728]
area = "git ignore gates"
symptom = "git check-ignore -q <dir> passes or fails depending on whether the path exists: a directory-only pattern such as /.pytest_cache/ never matches a missing path, and a negated directory rule (!/core/) flips the result once the directory holds tracked files"
fix = "test ignore rules with a path that never exists and has the intended shape, for example .pytest_cache/CACHEDIR.TAG for a directory rule and core.1 for a file rule"

[gotcha.1729]
area = "spec tooling"
symptom = "cg spec done <id> reports 'touched <file> — no matching change in the worktree or in commits tagged [spec:<feature>/<id>]' and refuses to mark the task done although the files are committed on the branch"
fix = "put the tag [spec:<feature>/<id>] inside the commit summary of every task commit (lx-commit ... \"<summary> [spec:<feature>/<id>]\"); the tool matches touched paths against commits carrying that tag"

[gotcha.1730]
area = "vendored trees"
symptom = "a vendored Rust tree that carries Go files but no go.mod lands under the root module, and go build ./... fails on its Go fixtures (expected 'package', found 'type')"
fix = "fence the tree with a boundary go.mod holding only a module line and a go line, which vendor-verify accepts when upstream tracks no go.mod"

[gotcha.1731]
area = "go workspaces"
symptom = "a leaf directory left out of a nested go.work and without a go.mod of its own silently joins the root module, so go build ./... at the root tries to resolve its imports there and fails"
fix = "give the leaf its own go.mod in the shape of its siblings and add it to the use list of the nested go.work"

[gotcha.1732]
area = "go builds"
symptom = "go build ./... inside a single main-package directory writes the binary next to the sources, and the public-repo audit then reports it as an untracked publication file (binary file matches)"
fix = "build a standalone leaf with go build -o /dev/null ./... or delete the binary before running the audit"

[gotcha.1733]
area = "worktree builds"
symptom = "go build ./... in a fresh worktree compiles but fails to link paxd and three tools with cannot find -llayerx and -llayerx_programs_sandbox, because build/ and programs/target/ are ignored native outputs that a new worktree does not hold"
fix = "build the native libraries in the worktree first, or point CGO_LDFLAGS -L at an existing build of them for a link-only check"

[gotcha.1734]
area = "public audit"
symptom = "private host and workspace references in gate scripts and ledgers (hard-coded checkout paths as defaults, an infrastructure address in agent instructions, absolute paths in gotcha entries) reach the public-repo audit and fail its private-reference check"
fix = "gate scripts read hosts and paths from environment variables and fail with a message naming the variable when it is unset; ledgers name the role of a file or host, never its path or address"

[gotcha.1735]
area = "public audit"
symptom = "rg -i on a secret pattern makes AKIA[0-9A-Z]{16} match any 20 alphanumeric characters of base64, so embedded PNG data and state exports read as AWS keys, and a bare PEM header string used by code to build or recognise keys reads as a private key"
fix = "scan case-sensitively with non-alphanumeric boundaries around key shapes, decode a JWT header before reporting it, require a base64 body after a PEM header, and keep positive and negative self-test cases beside the scanner"

[gotcha.1736]
area = "spec editing"
symptom = "a sed range that ends at a section header which does not exist runs to the end of the file, so a status flip addressed to one task flipped every later task"
fix = "end ranges at the next header pattern, never at a guessed id, and read the diff stat before committing"

[gotcha.1737]
area = "layout moves"
symptom = "a moved directory still carried its own old path inside a source file (a fuzz harness opening its seed corpus by a hard-coded relative path), and the reference search ran only over the rest of the tree"
fix = "after git mv, grep the moved tree itself for its former path before the first gate"

[gotcha.1738]
area = "layout moves"
symptom = "rewriting a Go import path from example/... to tests/fixtures/example/... left the import block unsorted, so gofmt -l reported four test files although only the path text changed"
fix = "run gofmt -w on every Go file whose imports a move rewrites, before the build gate"

[gotcha.1739]
area = "layout moves"
symptom = "moving a root-level directory one level deeper left its scripts and modules pointing one level short of the repository root (cd \"$(dirname \"$0\")/../..\", require(\"../../../contracts/test/lib.js\")), although no line named the old directory"
fix = "after git mv, grep the moved tree for ../ chains that climb to the root and add one ../ per added depth level"

[gotcha.1740]
area = "layout moves"
symptom = "a path rewrite bounded by a no-word-or-hyphen lookbehind skipped a reference written as a shell default, ${VAR:-integration_test/...}, because the hyphen of :- counted as part of a name"
fix = "after a bulk rewrite, grep again for the old path and handle each remaining hit by hand"

[gotcha.1741]
area = "layout moves"
symptom = "the directory name testutil also names nested packages (sdk/testutil, engine/deps/testutil, modules/*/testutil, storage/common/testutil), so a bare testutil/ rewrite would have moved references to trees that stay in place"
fix = "anchor the rewrite to the module path (Paxeer-X-Network/testutil) for Go imports and to a root position (line start, quote, space or list separator) for paths, then check each remaining hit by hand"

[gotcha.1742]
area = "node test wrapper"
symptom = "a ProcessProposal test failed only in cleanup with TempDir RemoveAll: directory not empty, on a different subtest each run, because the optimistic ProcessBlock goroutine it started still wrote into the home while the temporary directories were removed"
fix = "the test wrapper registers a cleanup after the app is built that waits on an unconsumed OptimisticProcessingInfo.Completion; cleanups run last in first out, so it runs before TempDir removal"

[gotcha.1743]
area = "launchpad"
symptom = "createMarket on a fresh test chain refuses LXP_LAUNCHPAD_TRANSFER_FAILED: execution reverted on the pool-token transfer although every surface is installed"
fix = "SidioraERC20 calls pool.opticalAddress() on each transfer once bound and the pool surface forwards to 0x1017, which serves the v6.10 launchpad on a fresh chain until the v6.12.0 plan is done; read a surface-routed failure against the precompile set InitChainer selects before suspecting the surface records"

[gotcha.1744]
area = "layout moves"
symptom = "layout-check.sh reads text lexically, so a path that resolves from another directory (a corpus path after cd programs, an unanchored ignore pattern, a $name/ shell expansion) reads as a root-anchored reference to a moved directory and fails the gate although nothing was left behind"
fix = "write each such line so it says what it means: a root-anchored $(CURDIR)/... path, a leading-slash ignore pattern at the new location, ${name}/ for a variable; never relax the script"

[gotcha.1745]
area = "api alignment"
symptom = "a crate downstream of an API type change kept reading a removed field (layerx-mcp read TrackedSubmission.verification_level after it became rung) and nothing in the per-task gate built it, so make agent-build failed on main"
fix = "the workspace build is the gate for API type changes: build every crate that depends on the changed type, not only the crate that owns it"

[gotcha.1746]
area = "layout moves"
symptom = "relative paths in a moved tree resolve from different bases (the file directory for include_str! and #[path], the crate for CARGO_MANIFEST_DIR joins, dist/test for compiled TypeScript tests, src/ for include_str! text a build.rs generates), so a depth rewrite keyed on the file's own directory misjudges some"
fix = "resolve each ../ chain against every plausible base in the pre-move tree and review by hand any that disagree"

[gotcha.1747]
area = "layout moves"
symptom = "a root path built from a variable ($REPO_ROOT/interop, root + \"/interop, a fixture tree $fx/interop that mirrors the repository) and a Path join of separate segments (ROOT / \"interop\") are preceded by a letter or are slash-less, so neither the root-anchored search nor layout-check.sh sees them and they keep the old path after a move"
fix = "after the lexical rewrite, search for variable-prefixed and segment-joined forms of the moved name, rewrite those whose variable is the repository root or a fixture copy of it, and leave runtime directories that only share the name"

[gotcha.1748]
area = "layout moves"
symptom = "moving crates out of a Cargo workspace into their own leaves every caller that selects them by package name against the old manifest (-p layerx-platform-cli, --features layerx-platform-cli/test-credential-store, a manifest variable built from segments) and every default binary path under the old workspace target (platform/target/release/layerx) pointing at the old workspace, and none of them names the moved directory, so neither a path search nor layout-check.sh finds them"
fix = "after the path rewrite, search for the moved package names and for the old workspace target paths of their binaries, point each at the new manifest and target, and fetch and lint the new workspace wherever the old one is fetched and linted"

[gotcha.1749]
area = "layout moves"
symptom = "moving a subdirectory out of a parent tree leaves the sibling files of that parent reaching it by a relative climb that stops inside the parent (../../../sdk/conformance from platform/middleware/agent/test), so the climb names neither the old nor the new root-anchored path and a lexical rewrite misses it, and the parent ignore file (/**/target/ in platform/.gitignore) stops covering the build output of the moved tree"
fix = "after the lexical rewrite, resolve every ../ chain in the old parent against each base that lands on the parent directory and point it at the new home, and give the moved tree the ignore rules its old parent supplied"

[gotcha.1750]
area = "layout moves"
symptom = "a moved tree also reaches the repository root through index climbs that carry no ../ and no old path, Python Path(__file__).parents[N], HERE.parents[N] and Rust CARGO_MANIFEST_DIR ancestors().nth(N), and through symlink targets written as strings in Makefile and Dockerfile recipes (ln -s and readlink of ../../../../human/apps/web/node_modules), and a Go package of the root module moved with the tree changes its import path, so a lexical and ../ rewrite leaves all three pointing one level short and gofmt reorders the rewritten import blocks"
fix = "after the ../ rewrite, raise every parents and ancestors index that landed on the root by the added depth, deepen every link target that climbs out of the moved tree, rewrite the import path of the moved packages and run gofmt on the files that carry it"

[gotcha.1751]
area = "perps fill path"
symptom = "a PositionModified event built before the fill's maker or taker fee is booked carries the pre-fee collateral for every caller, and a keeper test of the post-fee event fails only for callers that book the fee after the event"
fix = "book the fee inside ApplyFill before the event is built so every caller emits the post-fee collateral"

[gotcha.1752]
area = "golden recording"
symptom = "an archive node answers an empty-data revert with JSON-RPC error -32000 and no data field, so a recorder that keys reverts on the data field treats it as a transport error and stops"
fix = "record a -32000 error without data as a revert with empty data"

[gotcha.1753]
area = "ABI packing"
symptom = "packing a uint256 argument whose Go value is a nil *big.Int panics inside reflect in the ABI encoder"
fix = "allocate zero uint256 values before packing"

[gotcha.1754]
area = "long recording runs"
symptom = "a recorder that runs longer than the shell the lane holds is killed with the shell, losing hours of archive reads"
fix = "run it detached with nohup and a pid file, poll its log, and verify the output when the pid exits"

[gotcha.1755]
area = "lane worktrees"
symptom = "a lane that finishes with no changes has its worktree removed automatically, so resuming it later fails with a missing working directory"
fix = "start a fresh lane on the current base instead of resuming one that ended without changes"

[gotcha.1756]
area = "external application repositories"
symptom = "a task whose paths start with the application name points at the external application repository on its release branch, not at the monorepo port of the same application, which lacks the release work"
fix = "clone the external repository at its release branch before dispatching the task and land on that branch"

[gotcha.1757]
area = "environment at module load"
symptom = "a module that reads an environment variable at load time keeps the value from the first import, so a test that sets the variable after importing sees the stale value"
fix = "set the variable first and import the module dynamically inside the test"

[gotcha.1758]
area = "exact caller lists"
symptom = "a test that asserts the exact set of callers of a shared base fails when a new caller is added for a legitimate reason and the test is not updated with it"
fix = "add the new caller to the asserted list in the same change that adds it"

[gotcha.1759]
area = "perps margin"
symptom = "a perps order that only reduces a position still has to clear the full margin check for its notional and fee reserve unless it is marked reduce-only, so a closing bid from a thin account reverts with insufficient margin"
fix = "mark a closing order reduce-only"

[gotcha.1760]
area = "halt export fixtures"
symptom = "a halt export built from the keys an upgrade run reads carries only those keys, so token getters a parity test replays, allowance, nonces, checkpoints and the USDL total supply, read zero where the chain at the halt height holds real values"
fix = "extend the export fixpoint to every key the golden getter replay reads before regenerating"

[gotcha.1761]
area = "test node JSON-RPC"
symptom = "a test node with the API and gRPC servers disabled never starts the EVM JSON-RPC servers, so a readiness probe on eth_chainId is refused forever"
fix = "enable gRPC on a loopback port in the test home"

[gotcha.1762]
area = "Hyperfide fixtures"
symptom = "the identity fixture gives all its migrations one 30 second budget and is fsync-bound, so under host load it times out at an arbitrary migration regardless of the tree, and a release-layout copy without the migrations directory fails the epoch import as database unavailable"
fix = "host the disposable PostgreSQL under /dev/shm with fsync, synchronous commit and full page writes off, and include the migrations directory in release copies"

[gotcha.1763]
area = "v6.12.0 migration tests"
symptom = "a seeded halt-height test context under the test app chain id makes every chain-bound getter such as the EIP-712 DOMAIN_SEPARATOR differ from golden eth_call records, which looks like a missing storage slot"
fix = "run the seeded branch under the mainnet chain id hyperpax_125-1 so block.chainid matches the recorded calls"

[gotcha.1764]
area = "surface parity tests"
symptom = "a trace comparison that uses require stops the whole test at the first divergent trace, so every later trace of that contract goes unchecked and a verify log says nothing about them"
fix = "compare traces with assert-style checks that record every divergence and fail once at the end"

[gotcha.1765]
area = "perps-data gates"
symptom = "the public order book feed answers 401 authentication_required without a bearer key, and a loopback test node that keeps only 100 blocks of state at 200 ms blocks prunes the heights a 20 second replay test still reads"
fix = "serve a recorded order set on loopback and say so in the evidence, and keep at least 100000 blocks of state on a throwaway gate chain"

[gotcha.1766]
area = "perps-data source"
symptom = "eth_getLogs over a 500-block window exceeds a 2 second deadline because the receipt store answers block by block, and the v6.12.0 activation block carries ShareTokenCreated without a share Transfer"
fix = "route catch-up windows through the bulk-read path with its longer deadline, and land a deposit in the activation block when a test needs the same-block pointer pair"

[gotcha.1767]
area = "lane tooling"
symptom = "the worktree command guard refuses any shell command naming a path that contains the word source, so commands touching internal/source are rejected"
fix = "put such commands in a script file and run it with bash and the file path"

[gotcha.1768]
area = "perps-data gates"
symptom = "a test address given SID by writing the legacy SID ERC-20 storage reads zero after the upgrade, because the migration converts that token only for the holders in its embedded snapshot, and a genesis built by the test helper panics at the second block with missing signing info for the validator"
fix = "seed a usid bank balance with its supply entry in the throwaway genesis, and add a signing info entry for the validator"

[gotcha.1769]
symptom = "a Go test binary that links modules/lxphost fails at link time in a fresh worktree with liblayerx_programs_sandbox.a missing, before any test runs"
fix = "build the sandbox library the way the Makefile does, cargo build --locked --release -p layerx-programs-sandbox --features layerx-programs-sandbox/host-ffi, and point CGO_LDFLAGS at its target directory; a link failure is not a repair cycle"

[gotcha.1770]
area = "services/platform/perps-data"
summary = "The follower two_pass_pointers subtest needs a chain that already has a ShareTokenCreated log with a Transfer in the same block"
detail = "On a fresh single-node chain the subtest fails in its precondition search before exercising any follower code. Seed a share token through the launchpad surfaces before running TestFollower, or expect that one subtest to fail on an unseeded chain."

[gotcha.1771]
area = "modules/launchpad/launchpadtest"
summary = "Iterating the launchpad store through a state DB context after many EVM calls does not finish until the state DB is finalized"
detail = "The custody and solvency invariants walk the store through every cachekv snapshot layer the EVM calls left behind and a ten-minute timeout is not enough after a migration plus trades. Call Finalize on the state DB first so the layers are written through, then run the invariants on the context the state DB was opened on; the package then completes in about twenty seconds."

[gotcha.1772]
area = "modules/launchpad/launchpadtest"
summary = "The halt export holds USDL storage only for launchpad-held balances"
detail = "After MigrateV6120 on the exported state no outside account holds USDL and the quote token is the real USDL contract, so a trade flow cannot run on the migrated store without fabricated state. Run trade flows on a fresh keeper with a USDL ERC20 deployed in the test EVM and keep the migrated store for reads."

[gotcha.1773]
area = "precompiles/launchpad"
summary = "TestOpticalHooksSeeTheContractCallers needs LAUNCHPAD_CONTRACTS_DIR and SOLC set"
detail = "Point LAUNCHPAD_CONTRACTS_DIR at launchpad/contracts/contracts and SOLC at a solc binary that satisfies the ^0.8.24 pragma before running go test ./precompiles/launchpad/...; without them the optical hooks test fails as if the hooks were broken."

[gotcha.1774]
area = "modules/launchpad/keeper"
summary = "Airdrop keeper fixtures must fund fee held exactly once"
detail = "InitGenesis writes gs.FeeHeld into the fee held ledger and validation requires FeeHeld >= FeeAccounting.TotalLiabilities, so set both in the genesis and move the backing USDL with a plain ERC20 transfer to the module EVM address; PullQuote credits the ledger a second time and doubles fee held."

[gotcha.1775]
area = "launchpad/core/trading-charts"
summary = "A hanging httptest server must also stop on test end"
detail = "A test server whose handler waits only for the request context leaves one connection open after the geth RPC client's context ends, so Close blocks until the package's test timeout; make the handler also select on a channel the test closes at cleanup."

[gotcha.1776]
area = "services/agent/crates/layerx-mcp"
summary = "layerx-mcp source and tests are not rustfmt-clean"
detail = "Running rustfmt over layerx-mcp files reformats unrelated lines; format only the hunks you touch or leave formatting as found so the diff stays task-scoped."

[gotcha.1777]
area = "services/interop"
summary = "Some interop tests still produce layerx:beta networks"
detail = "The x402 buyer and seller accept only eip155:<chain id> networks, but layerx-x402 tests e2e, buyer and transports, layerx-interop-service server.rs and the gateway render.py assertion still spell layerx:beta; align them when touching those files."

[gotcha.1778]
area = "services/interop/crates/layerx-x402"
summary = "layerx_facts and is_layerx_network refuse every eip155 offer"
detail = "PaymentRequirements::layerx_facts() and is_layerx_network() in model.rs still key on the layerx network namespace, so a caller that reads asset or payee through them fails silently on the eip155 offers the seller now writes; parse the fields directly after layerx_terms() has checked them."

[gotcha.1779]
area = "services/interop/crates/x-websearch"
summary = "DeliveryRecord::validate still expects the retired settlement form"
detail = "payment.rs validate checks for lxp:<digest> and sequencer-signed while the seller writes verificationLevel receipted with a 0x transaction; the do_19 step of the x-websearch task in spec/layerx-merge is still open, so a sidecar delivery recorded from a live seller fails validation."

[gotcha.1780]
area = "sdk/platform/generators"
summary = "make platform-sdk-generate needs gofmt on PATH"
detail = "generate_lifecycle.py shells out to gofmt and stops with FileNotFoundError when /usr/local/go/bin is not on PATH; export it before running the generator targets."

[gotcha.1781]
area = "scripts/ci"
summary = "xweb-workflow-check mutations anchor on literal workflow text"
detail = "The mutation step of scripts/ci/xweb-workflow-check.sh finds its edit points by literal lines in the workflow, so an unrelated workflow edit such as a runs-on expression stops the check with 'mutation does not apply'; re-anchor the mutation and leave the assertion intact."

[gotcha.1782]
area = "node/rpc"
summary = "GET /status on the consensus RPC returns the bare result"
detail = "A GET of /status on the consensus RPC answers the bare result object without a JSON-RPC envelope, so read sync_info directly; a JSON-RPC POST still returns the jsonrpc/id/result envelope."

[gotcha.1783]
area = "node/paxdb"
summary = "node.New from a bare viper panics in SetupPaxDB"
detail = "Unset keys parse as zero, so a test that builds the node from an empty viper runs with state commit disabled and the node refuses to start; load the home config/app.toml first or set state-commit.sc-enable and its sibling keys."

[gotcha.1784]
area = "node/sequencer"
summary = "sequencer gasless checks only testable through antedecorators from package app"
detail = "node/sequencer imports node, so a test in package app cannot call couldBeGasless, blockGas or CheckNodeFloor; exercise the same check through antedecorators.IsTxGasless with the app keepers."

[gotcha.1785]
area = "tools/release"
summary = "py_compile leaves tools/release/__pycache__ behind"
detail = "Compiling a release script with python3 -m py_compile writes an ignored __pycache__ directory next to it; remove it before reading git status so it is not mistaken for lane output."

[gotcha.1786]
area = "spec/release-v6-12-0"
summary = "a planned-path task can already be landed by an earlier lane"
detail = "Check git log on the task's touches before writing; when the gates pass with no diff there is nothing to commit, and an empty commit would claim work that did not happen."

[gotcha.1787]
area = "launchpad/client"
summary = "offline pnpm install misses @tanstack/react-virtual 3.13.24"
detail = "The local package store lacks that version, so an offline install from the lockfile fails; a prefer-offline install fetches it from the public registry without changing the lockfile."

[gotcha.1788]
area = "launchpad/client/apps/web"
summary = "jsdom cannot prove media playback"
detail = "The stream player test can show that a retry issues a second viewer-session request and leaves the unavailable state, but jsdom has no media support, so actual playback is not observable in unit tests."

[gotcha.1789]
area = "human/crates/layerx-paxeer-client"
summary = "custody profiles still carry the kernel's paxeer-reserve hash"
detail = "The kernel writes the old system:paxeer-reserve namespace hash at bytes 129 to 161 of the custody profile, so test profiles must use that id and not system:treasury until the kernel adopts the treasury namespace."

[gotcha.1790]
area = "human/crates/layerx-human-service"
summary = "agent daemon wire format predates the API 2 states and rungs"
detail = "Tracked submissions still arrive with the acknowledged state code and the old 0 to 5 levels, which human code maps onto Submitted and the Receipted rung; the daemon's SubmitRequest refuses any signature that is not 65 bytes, which the journey engine does not yet produce."

[gotcha.1791]
area = "tooling/worktrees"
summary = "worktree command guard refuses su, inline URL env vars and heredocs"
detail = "Write the command into a script file and run it with bash so the guard sees a plain invocation."

[gotcha.1792]
area = "tools/release/snapshot"
summary = "paxd opens no application.db"
detail = "The app store lives at data/state_commit/memiavl, or data/committer.db on older homes, so a snapshot check for data/application.db never succeeds."

[gotcha.1793]
area = "tools/release/tests"
summary = "two-node loopback chain with a shared halt height strands the full node in block sync"
detail = "The full node stays a few blocks behind the validator in block sync and stalls once the validator halts, so it never reaches the halt height; get it into consensus before the halt or turn block sync off."

[gotcha.1794]
area = "node/rpc"
summary = "GET /abci_info returns a bare response without the JSON-RPC envelope"
detail = "Only a JSON-RPC POST of abci_info returns .result.response.version; probes that read .result must POST."

[gotcha.1795]
area = "tooling/worktrees"
summary = "worktree guard refuses compound gate commands"
detail = "bash <script> combined with redirects, && chains, time or an absolute path from outside the worktree is refused; run gates as a plain single command from inside the worktree or through a scratch script."

[gotcha.1796]
area = "tooling/scratchpad"
summary = "shared scratchpad scripts collide between lanes"
detail = "The scratchpad is shared across concurrent lanes, so a gate script with a generic name is overwritten by another lane and runs the wrong worktree; give gate scripts a task-unique directory and name."

[gotcha.1797]
area = "node/sequencer"
summary = "receipt tests hard-code the pre-move agent wire crate path"
detail = "The sequencer receipt tests read ../../agent/crates/layerx-wire/src/receipt.rs, which moved to services/agent, so the four receipt tests fail on a missing file."

[gotcha.1798]
area = "services/platform/perps-data"
summary = "the perps indexer cannot start mid-chain once a position exists"
detail = "A follower started above the height where a position was opened fails on the next hourly funding settlement with 'store: projection row missing: position N'; start it from activation."

[gotcha.1799]
area = "services/platform/perps-data"
summary = "loopback chain quirks for the perps end-to-end test"
detail = "PendingNonceAt fails because pending is served by the sequencer, so use NonceAt at latest; self-trade prevention cancels a resting maker owned by the taker, so a fill needs two accounts; the order enums are LIMIT 0 and GTC 0."

[gotcha.1800]
area = "tools/release/rollback"
summary = "memiavl stores carry a current symlink"
detail = "data/state_commit/memiavl/current is a symlink to the latest snapshot directory, so an archive check that allows only regular files and directories refuses every real snapshot; allow a relative symlink inside the store directory only."

[gotcha.1801]
area = "tools/release/init-chain"
summary = "init-chain genesis lacks the uhpx exponent 6 unit"
detail = "The v6.12.0 upgrade pointer check panics with 'uhpx exponent 0, want 6' on a chain seeded by init-chain.sh, because the seeded denom metadata has only the exponent 0 unit."

[gotcha.1802]
area = "tools/release/tests"
summary = "reproducible.test.sh runs three full release builds"
detail = "The reproducibility test takes well over thirty minutes and deletes its release directories on exit, so the SHA256SUMS listings printed in the log are the only record of which artifacts differed."

[gotcha.1803]
area = "modules/evm/keeper"
summary = "plan-keyed precompile versions gate an address whichever activation entry names it"
detail = "An address whose versions are keyed to an activation plan, such as the exchange and launchpad addresses through the v6.12.0 version switches, is withheld below that plan's done height even when a test's synthetic split lists it under another entry."

[gotcha.1804]
area = "Makefile"
summary = "make paxd-native-libs needs cargo on PATH"
detail = "Without ~/.cargo/bin on PATH the liblayerx.a step builds but the programs sandbox step exits 127, and every Go test that links liblayerx_programs_sandbox then fails at link time."

[gotcha.1805]
area = "tools/release/tests"
summary = "a genesis composed from a halt export must carry the evm nonces"
detail = "Copying the export's evm codes and states without its nonces resets the evm module account to nonce 0, so the next pointer CREATE in the v6.12.0 upgrade collides with the contract that account created at nonce 0."

[gotcha.1806]
area = "tools/release/tests"
summary = "the previous binary expects a top-level launchpad protocol_fees_pending"
detail = "The pre-upgrade binary refuses a genesis whose launchpad state only carries fee_accounting.pending_protocol_fees; fill the top-level field from it when seeding a chain the previous binary must validate."

[gotcha.1807]
area = "tooling/worktrees"
summary = "worktree guard refuses lx-commit with a long inline message"
detail = "Run the commit from a scratch script when the message is long."

[gotcha.1808]
area = "modules/testkeeper"
summary = "the shared EVM test app records v6.12.0 as done at height 1"
detail = "A test that schedules or applies the v6.12.0 plan, or expects custody governance to be inactive, needs its own app from SetupWithDefaultHome instead of testkeeper.EVMTestApp."

[gotcha.1809]
area = "node/upgrades"
summary = "applying v6.12.0 on a clean test app panics in the launchpad step"
detail = "The full v6.12.0 migration needs seeded release state and fails with LXP_LAUNCHPAD_INVALID_PARAMS quote token is the zero address; a module test outside package node can only record the done height through the upgrade keeper."

[gotcha.1810]
area = "node/tests"
summary = "the optimistic ProcessBlock goroutine outlives a test unless cleanup waits on it"
detail = "ProcessProposalHandler starts ProcessBlock in the background writing under the app home, so a test app torn down before FinalizeBlock consumes it hits 'directory not empty'; SetupWithDB now registers a cleanup that waits on the completion channel."

[gotcha.1811]
area = "daemon/cli"
summary = "cobra prints errors and usage from the command Execute was called on"
detail = "A test that executes a subcommand directly needs SilenceUsage and SilenceErrors on that command, not only on the root; paxd root and the custody proposal command carry both and main prints the error once."

[gotcha.1812]
area = "modules/tests"
summary = "applying v6.12.0 on a fresh test app outside package node panics in the launchpad step"
detail = "Only package node can bind the nil launchpad hooks, so tests elsewhere record the done height through the upgrade keeper's SetDone instead of running the migration."

[gotcha.1813]
area = "go/tests"
summary = "a panic in one Go test hides every test after it in the package"
detail = "A failure list taken from a panicking package is incomplete; fix the panic first, then rerun to see the rest."

[gotcha.1814]
area = "rpc/tests"
summary = "rpc/tests cosmos transactions carry hard-coded account numbers that shift when module accounts are added"
detail = "A wrong account number fails signature verification silently and shows up later as a missing synthetic receipt or a nil result; measure the number from the harness instead of guessing."

[gotcha.1815]
area = "rpc/tests"
summary = "the debug-trace mock in rpc/setup_test.go overwrites tx1's receipt with a gas-price-0 stub"
detail = "tx1 therefore never has a standard receipt and is filtered as an ante failure; other tests depend on the stub, so committed-receipt checks use the multi-tx block instead."

[gotcha.1816]
area = "node/tests"
summary = "a blanket cleanup wait on the optimistic completion channel hangs the package; gotcha 1810 was wrong"
detail = "Some tests install a completion channel nothing closes, so waiting in SetupWithDB stalls until the package timeout. Only TestProcessProposalHandler_NewOptimisticProcessing starts a real ProcessBlock and it now waits on its own channel."

[gotcha.1817]
area = "node/tests"
summary = "node test logs can end without FAIL lines and still be a timeout"
detail = "Search the log for 'test timed out' before reading a clean tail as a pass."

[gotcha.1818]
area = "node/tests"
summary = "node tests that need post-upgrade launchpad behaviour must record the v6.12.0 done height"
detail = "A fresh chain without it serves the v6.10 launchpad at 0x1017 and createMarket fails with LXP_LAUNCHPAD_TRANSFER_FAILED; recordV6120Done in node/test_helpers.go sets the done height through the upgrade keeper and refreshes the precompile set."

[gotcha.1819]
area = "tools/release"
summary = "paxd export panics without --chain-id and without the home's wasm/ directory beside data/"
detail = "The rehearsal export step passes --chain-id and copies wasm/ next to the data copy."

[gotcha.1820]
area = "tools/release"
summary = "rollback.sh without --local sshes to VALIDATOR_HOSTS"
detail = "Local rehearsal legs must pass --local or they try to reach the validator hosts."

[gotcha.1821]
area = "tools/release"
summary = "associate-address exits 0 even when the RPC returns an error"
detail = "Parse the Response: JSON for an error field instead of trusting the exit code."

[gotcha.1822]
area = "tools/release"
summary = "rewrite_genesis needs exactly four validators of equal power"
detail = "A one-validator test chain cannot pass the export step; the rehearsal test chain now runs four."

[gotcha.1823]
area = "systemd"
summary = "systemd runtime units have no HOME and paxd panics with '$HOME is not defined'"
detail = "Transient node units set Environment=HOME=<node home>."

[gotcha.1824]
area = "bash"
summary = "under pipefail, grep -c pattern | grep -qx 0 fails on a clean file"
detail = "grep -c exits 1 when it counts zero matches; use ! grep -q pattern for an absence check."

[gotcha.1825]
area = "tools/release"
summary = "with --halt-height on four validators one node can be stuck at the halt height"
detail = "Peers may stop before their votes for the halt height reach the last node; the driver restarts one halted node to pass the commit along, then stops it again."

[gotcha.1826]
area = "rpc/tests"
summary = "the internal rpc test package cannot import the node or the test keeper"
detail = "Import cycle; a test that needs a real keeper lives in the external evmrpc_test package and uses app.Setup."

[gotcha.1827]
area = "rpc/tests"
summary = "read account numbers from the harness keeper, never hard-code them"
detail = "accountNumberAfterInit in rpc/tests reads the number after the test's setup steps; the numbers shift whenever a module account is added."

[gotcha.1828]
area = "spec/workflow"
summary = "check git log on a task's touched files before dispatching it"
detail = "8.4.20 had landed days earlier with its spec status never advanced, so it was claimed twice; a look at the log of its files would have shown the work done."

[gotcha.1829]
area = "go/tests"
summary = "Go runs test files in alphabetical order, so a panicking regression_test.go hides every file sorting after it"
detail = "Use go test -skip on the panicking names to see the rest of the package before judging it green."

[gotcha.1830]
area = "rpc"
summary = "the pending block tag is resolved only through the watermark manager's resolvePending"
detail = "getBlockNumber takes the manager and refuses with ErrPendingServedBySequencer on nodes without a pending snapshot; never map pending to nil/latest again (layerx-merge req.9003 ac_2/ac_3)."

[gotcha.1831]
area = "rpc"
summary = "a cosmos query at height 0 silently serves latest state"
detail = "An off-by-one that reaches height 0 returns post-block state instead of an error; check the computed height before querying."

[gotcha.1832]
area = "rpc/tests"
summary = "every regression_test.go case replays upstream-chain transactions that carry a removed oracle message type"
detail = "Skip them with -skip '^Test(0x[0-9a-f]+|[0-9]+)$' to see the rest of rpc/tests; they cannot pass on this chain until re-recorded or retired."

[gotcha.1833]
area = "rpc"
summary = "StateAtBlock returns the state after its argument, per the vendored geth tracer contract"
detail = "The tracer callers pass the parent block and expect the state the block's transactions start from; the backend runs initializeBlock on x+1 when it exists and otherwise snapshots the tip, never the state before x."

[gotcha.1834]
area = "release/build"
summary = "cargo hashes the absolute path of a path dependency outside the workspace into crate names"
detail = "--remap-path-prefix cannot reach it; the release build reaches the tree through a fixed symlink so every checkout hashes the same path."

[gotcha.1835]
area = "release/build"
summary = "the cgo ${SRCDIR} rpath lands in the ELF RUNPATH even under -trimpath"
detail = "tools/release/extld.sh drops absolute rpath arguments, also inside Go's @response file used once linker arguments pass 30 KiB, and sets $ORIGIN."

[gotcha.1836]
area = "release/build"
summary = "release builds are serialised per host by the build lock"
detail = "A second build-paxd.sh on the same host waits for the lock on the shared source symlink."

[gotcha.1837]
area = "apps/launchpad"
summary = "pnpm on PATH is 12.x under corepack and refuses the launchpad workspace pinned to pnpm 9.15.0"
detail = "pnpm -C apps/launchpad install fails with ERR_PNPM_BAD_PM_VERSION; run the cached 9.15.0 with node ~/.cache/node/corepack/v1/pnpm/9.15.0/bin/pnpm.cjs through a scratch pnpm wrapper first on PATH."

[gotcha.1838]
area = "apps/launchpad"
summary = "a pnpm workspace can list packages outside its root"
detail = "pnpm-workspace.yaml accepts ../../sdk/launchpad/packages/* and the lockfile importer keys take the same relative form, so a path-only key rewrite keeps install --frozen-lockfile passing with no resolved version change; --filter takes the same relative path selector."

[gotcha.1839]
area = "layout/human"
summary = "a fresh worktree cannot run make human-build until human/wallet/sdk/dist is built"
detail = "The web app links @paxeer/wallet to human/wallet/sdk, whose exports point at the untracked dist; run pnpm install and pnpm --filter @paxeer/wallet build in human/wallet first, and a fresh dist exposes the GasQuoteRequest did field the web app does not send yet."

[gotcha.1840]
area = "services/wallet"
summary = "the services/wallet demo typecheck reports four extra errors in a fresh worktree because @paxeer/wallet resolves to the untracked sdk/wallet/dist"
detail = "The sdk/wallet typecheck runs tsc --noEmit and never writes dist; run pnpm -C sdk/wallet run build before pnpm -C services/wallet -r typecheck, then delete the sdk/wallet/pnpm-lock.yaml that pnpm writes beside it."

[gotcha.1841]
area = "shell"
summary = "pkill -f with a pattern from the same command line kills the calling shell"
detail = "A Bash call that runs pkill -f 'proc/loadavg' and then the gate matches its own bash -c command line and exits 144 before the gate runs; stop the earlier job by its id or pid instead."

[gotcha.1842]
area = "services/platform/hosted/gateway"
summary = "rustfmt over gateway paxeer.rs rewrites about a hundred unrelated lines because that file is not rustfmt clean on main"
detail = "Format only the files whose main revision is already clean (rustfmt --check first) and add new code to paxeer.rs in its existing style; cargo and rustfmt live in ~/.cargo/bin, which a fresh shell may not have on PATH."

[gotcha.1843]
area = "services/platform/hosted/gateway"
summary = "The gateway binary cannot answer JSON-RPC in a test without a reachable TLS Redis"
detail = "Config construction requires LAYERX_GATEWAY_REDIS_URL with username and password files, so integration tests that post JSON-RPC to the real binary start a redis-server with tls-port and an openssl localhost certificate, as tests/paxeer_failover.rs and tests/unified_service_paths.rs do."

[gotcha.1844]
area = "test"
symptom = "A programme gate passes with ok and no test output even though no test ran"
cause = "The go test -run selector matches no test, and Go still returns a successful exit status"
do = "Run go test -json and count the run actions, as the zero-test detector of task 17.4.3 does"

[gotcha.1845]
area = "build"
symptom = "go test of any package importing precompiles/setup.go (precompiles/setup.go:117) fails at link time"
cause = "A clean checkout lacks build/liblayerx.a, which the kernel cgo link requires"
do = "Use the go-cgo sandbox prebuild of task 17.6.1 to create build/liblayerx.a before running go test"

[gotcha.1846]
area = "tooling"
symptom = "cg spec done refuses a task with ✗ symbol — not defined in the graph for a Go const or var, a Rust const, static or enum variant, a TypeScript const, or a qualified name such as module::Item or Type.Method, although the declaration exists"
cause = "Hyperfide revisions before 3762f1c43 extracted functions, types, methods and enums only and matched a qualified name's last segment without its container"
do = "Use Hyperfide at 3762f1c43 or later (CG_EXTRACTION_VERSION 4) and rebuild the index; do not remove the symbol from the task"

[gotcha.1847]
area = "spec"
symptom = "a Go package stops compiling with `TransferLeg redeclared in this block` after two sibling tasks land"
cause = "two tasks' do-lines named the same type, one declaring it and one only using it, with no requires between them, so both wrote the declaration"
do = "a type belongs to the task whose do-line declares it; a task that only uses it requires that task and never declares it; delete the duplicate from the user's file and record the finding"

[gotcha.1848]
area = "build"
symptom = "a kernel task's verify_cmd fails with make: No rule to make target 'build/tests/kernel/...'"
cause = "the $(BUILD_DIR)/tests/kernel/% pattern rule is added by task 16.2.1 (req.16982) and a kernel task that does not require it builds on a tree without the rule"
do = "every task whose verify_cmd builds build/tests/kernel/... requires 16.2.1; add the missing requires and re-qualify the finished implementation instead of rewriting it"

[gotcha.1849]
area = "tooling"
symptom = "verify_cmd fails with `No module named pytest` after the task's unittest or build passed"
cause = "the base python of the build environment carries pip only; pytest-based verify_cmds assume pytest is installed"
do = "install pytest once before the gates when build_cmd or verify_cmd mentions pytest, record the install in the run log, and re-qualify the result"

[gotcha.1850]
area = "tooling"
symptom = "cg spec done refuses a task with `not defined in the graph` although the symbol is declared in a touched file and the verify_cmd passed"
cause = "the gate resolves only the symbol kinds its extractors emit; an interface method, a struct field, a module-level binding, a Solidity interface or constant, an exported object key, a named function expression or a shell function outside the extraction version is invisible, and a Rust type can tie with its own impl block"
do = "check the symbol's kind and language against the gate's extraction version before touching the work; keep the symbol list naming declared symbols and re-qualify the unchanged result once the gate indexes that kind"

[gotcha.1851]
area = "spec"
symptom = "a Go symbol qualified by an import alias (alias.Name) is never found by the gate even when the bare name resolves"
cause = "the code graph stores a whole-module import without its alias, so the qualifier matches no file path, receiver or parent"
do = "list the bare symbol, or a receiver- or path-qualified form, in symbols; never an import alias"

[gotcha.1852]
area = "spec"
symptom = "a task's own kvx reader rejects spec.kvx with `invalid value` at a line the gate reads without complaint"
cause = "the gate's reader keeps every byte between the quotes of a value, so a backslash escape such as \0 is plain text to it while a JSON-based reader refuses it"
do = "treat the gate's reader as the reference for kvx strings; make a new reader accept everything the gate accepts before pointing its verify_cmd at spec.kvx"

[gotcha.1853]
area = "build"
symptom = "`pnpm --dir apps/launchpad/web exec tsc --noEmit -p tsconfig.json` aborts with `FATAL ERROR: Ineffective mark-compacts near heap limit` after about two minutes"
cause = "Node's default old-space cap of about 2 GB is below what the type check of apps/launchpad/web allocates, so every unconfigured machine fails it regardless of the change under test"
do = "run the gates with NODE_OPTIONS=--max-old-space-size sized to the machine (three quarters of its memory, at least 6 GB) and judge the work only after the check has memory to finish"

[gotcha.1854]
area = "build"
symptom = "a type check in apps/web, apps/wallet or a services/platform/middleware package fails with `Cannot find module '@noble/hashes/sha3.js'`, an implicit-any error inside services/agent/sdk/typescript/src, or `tsc: not found` after `npm error 404 @sidiora/layerx-sdk`"
cause = "the repository root is an npm workspace whose members include the agent SDK; apps import the SDK sources by relative path and the middleware packages import `@sidiora/layerx-sdk`, whose exports point at an untracked dist/, so a tree without the root install and the SDK build cannot resolve them"
do = "run `npm ci` at the repository root, then `npm run build --workspace services/agent/sdk/typescript`, before any package-level type check; a per-package install inside a workspace member reaches the registry for the SDK and fails"

[gotcha.1855]
area = "build"
symptom = "`pnpm install --frozen-lockfile` inside apps/launchpad/web, apps/launchpad/mobile, sdk/launchpad/packages/sdk or sdk/wallet fails with ERR_PNPM_NO_LOCKFILE, and a type check or vitest run there reports `Cannot find module '@kindle/sdk'`, `'@kindle/sdk-v2/types'`, `'stats-sdk'` or `'./validators-v1.gen.js'` even after an install"
cause = "the lockfile lives at the pnpm workspace root named by pnpm-workspace.yaml (apps/launchpad for web, mobile and sdk/launchpad/packages/*; services/wallet for gateway, demo and sdk/wallet), and the members whose package exports point at an untracked dist/ (@kindle/sdk-v2, @kindle/sdk, stats-sdk, @kindle/production-contracts) ship no build output; @kindle/sdk depends on @kindle/sdk-v2 and generates src/validators-v1.gen.js in its build"
do = "install at the workspace root, then build the dist-exporting members the package depends on in dependency order (sdk-v2 before sdk) before running the member's type check or tests"

[gotcha.1856]
area = "spec"
symptom = "a test that opens a tracked repository file through a relative path fails with `no such file or directory`, and the failing path begins with exactly the `..` segments the task step prescribed"
cause = "go test runs each test binary with the package directory as its working directory, so a relative path counts from the package, not from the module root or the repository root; a step written against the module root is one segment short"
do = "count parent segments from the package directory the test runs in (sdk/launchpad/protocol/catalog needs four to reach the repository root) and resolve the path with ls from that directory before writing the step"

[gotcha.1857]
area = "spec"
symptom = "a parity test between a Go name table and the kernel's lxp_result_name fails for every value outside the registry, Go answering LXP_UNKNOWN_RESULT and the kernel LXP_ERR_UNKNOWN"
cause = "the step quoted the kernel's fallback string from memory; the default branch of lxp_result_name returns \"LXP_ERR_UNKNOWN\" and the registry defines no LXP_UNKNOWN_RESULT row"
do = "read the default branch of the C function a step quotes before writing the literal, and name the function rather than repeating its string"

[gotcha.1858]
area = "spec"
symptom = "cg spec done refuses a result whose verify_cmd passed with `symbol X — not defined in the graph`"
cause = "the symbols list names something the graph never holds: a name the task deletes, an imported package's function or type, a Makefile variable, an X-macro enumerator or a C struct field"
do = "list only declarations the finished tree contains in its own source (functions, methods, types, Go consts and vars, Rust items and fields) plus the task's tests, and check each against the tree before writing the task"

[gotcha.1859]
area = "tooling"
symptom = "a symbol the tree declares is refused as not defined in the graph"
cause = "the graph index covered only spec/ and the touched directories; a symbol the task uses or extends is declared elsewhere"
do = "index the directories declaring every listed symbol before cg spec done, found by grepping the final name segment outside docs and data files; a gate over a partial graph judges the index, not the work"

[gotcha.1860]
area = "tooling"
symptom = "a deleted touched path is refused as `no matching change` although the tree no longer has the file"
cause = "the graph snapshot was first taken after the prepared result was already applied, so no snapshot ever held the file"
do = "take the first snapshot on the base tree before applying a prepared result, so the deletion appears in the worktree diff"

[gotcha.1861]
area = "spec"
symptom = "a Go test package fails with `requires PERPS_DATA_TEST_DATABASE_URL` wherever no PostgreSQL runs"
cause = "the verify_cmd depends on a database the test code demands through an environment variable the task never declares"
do = "read the test package's setup for required services before writing verify_cmd, and declare them so the environment can supply them or the task is held"

[gotcha.1862]
area = "spec"
symptom = "a task that regenerates a gRPC QueryServer interface fails its own build_cmd on every attempt with a keeper not implementing the interface"
cause = "the package asserts `var _ types.QueryServer = Keeper{}` at compile time, and the new method was assigned to a later task"
do = "when a task widens an interface, give the same task every compile-time implementer of it, and leave the dependent task its tests only"

[gotcha.1863]
area = "spec"
symptom = "a symbol check passes on a name the task deletes, and the ✓ line names a file outside the touched paths"
cause = "an unqualified symbol lookup takes the first declaration of that name in the tree, and the Python and TypeScript SDKs under services/agent/sdk declare the same names (PX_METHODS, PxAnchorHead)"
do = "read the path on every ✓ line of the graph check; a check that passed on another package's declaration proves nothing about the touched file, so name only symbols unique to the touched package"

[gotcha.1864]
area = "tooling"
symptom = "cg init exits 139 within a second on a tree that vendors C++ sources, before any symbol is written"
cause = "the systems-language extractor handed null tree-sitter nodes to ts_node_child_by_field_name: a C++ declarator with no function_declarator (abstract and operator declarators in programs/vendor/binaryen-sys) left is_c_parameter's declarator null, and tree-sitter dereferences the node's subtree"
do = "build cg at f93cce7254edb1fd7fbdd0b1cde2901c29e46ec8 or later, where field() and named() in src/ast_systems.c answer null for a null node; on an older cg keep vendored C++ trees out of the index scope, since they declare nothing a task names"

[gotcha.1865]
area = "spec"
symptom = "cg spec done refuses a result with `<name> — not defined in the graph` for a name the touched file plainly declares: an enumerator, a shell variable, or an Elixir module or test"
cause = "the graph indexes C functions, types, enums (the type, not its enumerators) and #define macros; it indexes nothing in shell scripts or Elixir sources, and an ExUnit `test \"name\"` is a string, not a declaration"
do = "name enumerators (named or anonymous enum, X-macro lists included), shell variables and Elixir modules or tests in do_* text only; a task whose touched files are only .sh, .exs or .json carries symbols = [] and is proven by its verify_cmd alone"

[gotcha.1866]
area = "tooling"
symptom = "cg spec done refuses a deleted touched path as `no matching change` although the tree no longer has the file and the commit records the deletion"
cause = "cg spec done credits a deleted touched path only from a commit carrying the task's tag that exists before the check runs or from a snapshot taken before the deletion; the worktree diff alone never shows a deleted file"
do = "keep the deleted path in touches, and put the tagged commit on the branch or take the snapshot of the base tree before cg spec done runs (gotcha.1860)"

[gotcha.1867]
area = "cargo"
symptom = "every `cargo build --locked` in a workspace refuses to start after several branches that change the workspace manifests are merged"
cause = "the merge takes each branch's manifest edits but Cargo.lock stays behind them, so --locked sees a lockfile that needs updating"
do = "re-resolve with `cargo metadata --manifest-path <workspace>/Cargo.toml` (a minimal update) and commit the lockfiles with the merge"

[gotcha.1868]
area = "spec"
symptom = "a task that renames fields of types exported by a shared crate passes its own build and verify gate while every dependent crate in the workspace stops compiling on main"
cause = "the task's touches and build_cmd cover only the exporting crate, so neither the touched-path check nor the per-crate gate sees the dependents' call sites"
do = "a task that changes exported types either carries its dependents' port in its touches or is followed by an explicit port task that every dependent owner requires; run cargo check --workspace --all-targets on the workspace before publishing"

[gotcha.1869]
area = "spec"
symptom = "a task passes its build and verify gate and the verifier still refuses it with `not defined in the graph` for a name in its symbols"
cause = "the symbol check indexes declarations only (functions, types, Go, Rust, TypeScript and Python declarations, #define macros); an enumerator, an X-macro result code, a Makefile target, a struct field or a type the task consumes but does not define is never in the graph"
do = "list in symbols only names the task itself declares; move consumed types, enumerators, result codes, Makefile targets and struct fields out of the list before the task is re-qualified"

[gotcha.1870]
area = "spec"
symptom = "every open task of one package parks on the same build failure although none of them touches the files the errors name"
cause = "the tasks share a package-wide typecheck as their per-task build gate, so pre-existing errors elsewhere in the package fail each task's build before its own files are compiled"
do = "make the per-task build the test runner's list of the task's own spec file (vitest list <spec>) and keep the package typecheck as a wave-level gate"

[gotcha.1871]
area = "spec"
symptom = "a Go test keeps failing with <MODULE>_TEST_POSTGRES_URL or <MODULE>_TEST_REDIS_URL unset although the gate provisions database fixtures for tests that name them"
cause = "Go test fixtures often read their database and cache URLs in a module-level test-support package (internal/internaltest) rather than in the package under test, so a gate that provisions fixtures by scanning only the task's own paths never sees the variable names"
do = "scan the enclosing Go module (the directory of the nearest go.mod, including its internal test-support packages) for fixture variable names before deciding what to provision"

[gotcha.1872]
area = "build"
symptom = "every `cargo build --locked` in several workspaces fails at the base with `Cargo.lock needs to be updated but --locked was passed` after one task changed a shared crate's dependencies"
cause = "the task refreshed only its own workspace lockfile while other Cargo.lock files also resolve that crate through path dependencies"
do = "a task that changes a crate's dependencies must refresh every Cargo.lock that resolves that crate (`cargo update -w --offline` per lockfile, verified with `cargo metadata --locked`); otherwise every `--locked` build in those workspaces fails at the base for everyone"

[gotcha.1873]
area = "build"
symptom = "programs-build fails its vendored checksum step (`failed to calculate checksum of: programs/vendor/cc-1.4.4/src/target/apple.rs`) after a vendor refresh that built cleanly in the tree where it was made"
cause = "a broad ignore pattern such as programs/.gitignore `/**/target/` also hides vendored crate sources (cc src/target/*.rs) and test fixtures (*.pem, *.key), so the refresh commit silently omits files the crates' .cargo-checksum.json lists"
do = "a vendor refresh must `git add -f` those paths or carry negation patterns, and must be verified with `cargo build --offline` from a fresh clone, not from the tree that still holds the ignored files"

[gotcha.1874]
area = "spec"
symptom = "two tasks that edit one crate both stay blocked: one cannot build because the crate does not compile, and the task that must repair the compile break waits on it (9.23.5/9.23.7 after 13.29.1 removed the FinalityEvidence checkpoint and settlement fields)"
cause = "the requires edge pointed from the repairer to the other task, while the other task's build compiles the broken crate"
do = "when two tasks edit one crate and one of them must repair that crate's compile break, point the requires edge from the other task to the repairer; the opposite direction deadlocks both"

[gotcha.1875]
area = "spec/layerx-merge/contracts"
summary = "Regenerating a specification document can overwrite a file that code parses at build time"
detail = "services/agent/crates/layerx-types/build.rs, scripts/ci/result-codes-gen.py and the Go, Rust and TypeScript registry tests read contracts/address-table.md sections (a), (a2), (b) and (c) by heading text and column count; a generated inventory written under the same name made cargo build exit 101 for every crate depending on layerx-types and every cgo-linked Go package. Before replacing a contract file, grep the code for its path and keep generated inventories under their own names."

[gotcha.1876]
area = "spec"
symptom = "cg spec done reports ✗ symbol <name> — not defined in the graph for a crate name or a harness test-case id listed in a task's symbols"
cause = "The graph check resolves declared code symbols only; crate names, package names and case ids registered as strings are not symbols"
do = "List the declared function, type, constant or test function that implements the behaviour (for a harness case, the C test function it registers); cover crates and packages with touched paths and the build"

[gotcha.1877]
area = "spec"
symptom = "Retiring or re-signing a public item (a constant, a function parameter, a struct) builds in the task's crate and fails `cargo build --all-targets` on integration tests or sibling crates outside touches"
cause = "--all-targets compiles every tests/*.rs of the crate and the dependents check compiles consumer crates, none of which the task owns"
do = "Before retiring an item, `git grep` its name under the workspace and put every consumer file in touches, or add a requires edge to the task that owns it (11.29.4: PORTABLE_RECEIPT_FORMAT_V2 / trusted_batch)"

[gotcha.1878]
area = "rust"
symptom = "adding an enum variant builds and tests clean, then the next task that builds the crate with a cargo feature fails E0004 on a match over that enum in a cfg(feature) file"
cause = "the task's build_cmd ran without the feature, so rustc never compiled the gated match"
do = "when adding a variant, grep the enum's match sites under every cfg feature and build once with each feature that compiles them, or put the arm in the task that owns the gated file (13.7.4: AbiError::EffectLimit in abi_payload)"

[gotcha.1879]
area = "go"
symptom = "a requalified candidate's own tests fail on a refusal from a check that landed in the package after the candidate was written (`gas wanted N exceeds Block.MaxGasWanted 0`)"
cause = "a requalify replays the result unchanged, so a fixture written before the check cannot set what the check now needs"
do = "when the package gained an admission or validation check since the candidate's base, reseed as a continue with a do line naming the fixture call (5.17.2: resolutionBlockGas in the newSourceHarness setup)"

[gotcha.1880]
area = "tooling"
symptom = "a do line moves a call site to a helper whose input type (Eip1559Call) does not exist on that path yet, and the implementer reports the mismatch instead of inventing the input"
cause = "the migration was assigned to the task that touches the file rather than the task that produces the new input"
do = "assign a signing or encoding migration to the task that changes the transport (9.23.7 -> 9.23.6) and give the task that deletes the old helper (9.35.1) a requires edge to it"

[gotcha.1881]
area = "go"
symptom = "a precompile test fixture that embeds the utils.Keepers interface panics in GetCustomPrecompiles with `keepers do not provide the <module> keeper` after a new registry entry lands"
cause = "newer entries type-assert concrete keeper accessors (LaunchpadV610Keepers) that the interface embedding hides"
do = "embed *node.PrecompileKeepers from testApp.GetPrecompileKeepers() in the fixture, as precompiles/layerxledger/harness_test.go does (2.11.1)"

[gotcha.1882]
area = "go"
symptom = "a keeper test asserting Host.Execute's receipt bytes equal the stored idempotency record fails with the stored value 68 bytes longer (0x01, 0x00000040, 64 zero bytes)"
cause = "Host.Execute returns the receipt without the sequencer signature while the kernel stores the signed canonical form"
do = "assert the signed-form relation explicitly or compare decoded fields; never equate the two encodings (2.6.4)"

[gotcha.1883]
area = "tooling"
symptom = "an attempt adds test-only helpers or types named after the declared symbols so the graph check passes"
cause = "the symbol list named an item a do line deletes, or a method the graph already indexes under its bare name"
do = "fix the symbol list (drop deleted names) and requalify the candidate without the helpers; a name added only to satisfy a check is a fake (9.33.13, 3.5.3, 3.10.2)"

[gotcha.1884]
area = "go"
symptom = "a perps governance test fails `market N max leverage X differs from its tier 0 leverage 1000` after MsgSetMarket"
cause = "Market.Validate pins MaxLeverage to the tier 0 leverage of the market's class (modules/perps/types/market.go:67); it is never a governed field"
do = "govern OiCapUsd or TierClass instead and assert MaxLeverage unchanged (3.1.5, 3.10.1, 3.6.21)"

[gotcha.1885]
area = "typescript"
symptom = "wallet gateway tests skip or exit in beforeAll with `... are required when ATTESTOR_ENDPOINTS is set`"
cause = "loadEnv (services/wallet/gateway/src/env.ts:253) requires WALLET_IDENTITY_BINDING_PRIVATE_KEY_FILE, WALLET_IDENTITY_BINDING_TENANT, WALLET_CUSTODY_INVENTORY_FILE and WALLET_CUSTODY_INVENTORY_PUBLIC_KEY_FILE alongside ATTESTOR_ENDPOINTS"
do = "set all four in the test harness before importing src/env.ts, as test/evm-approvals.test.ts does (12.6.2)"

[gotcha.1886]
area = "go"
symptom = "a gRPC query test reads codespace `undefined` although the keeper returned a registered sdkerrors error"
cause = "the error was wrapped with fmt.Errorf(\"%w\") and sdkerrors.ABCIInfo follows only Cause() (gotcha.1251)"
do = "re-wrap with sdkerrors.Wrap on the registered root error at the handler boundary (4.4.3)"

[gotcha.1887]
area = "go"
symptom = "a served-method golden test of rpc/ counts eth_gasPriceHelperForTest and eth_calculateGasUsedRatioForTest that production does not serve"
cause = "every exported method of a registered service is served by go-ethereum's rpc reflection, so a *_test.go shim written as a method of InfoAPI (rpc/export_info_test.go) becomes an eth_* method of the test binary"
do = "write test shims as package-level functions (rpc/export_filter_test.go:3) so served-method goldens hold (7.0.2)"

[gotcha.1888]
area = "spec"
symptom = "`cg spec done` refuses a task symbol as not defined in the graph although the method exists (layerx-gas-station Service::report)"
cause = "symbols of a task list declarations the graph indexes; a method of a generic `impl<...>` block was refused while methods of concrete impls in the same crate pass"
do = "name the task's test function or a concrete declaration instead (11.23.3)"

[gotcha.1889]
area = "kernel / Makefile"
symptom = "a kernel test links a duplicate lxp_batch_verify_signature (or an lxp_batch_sign) although the sources define it once and lxp_batch_seal.c is no longer in LIB_SOURCES"
cause = "a reused build/liblayerx.a still carries members of object files dropped from LIB_SOURCES (lxp_batch_seal.o supplied lxp_batch_sign and an old lxp_batch_verify_signature)"
do = "treat a clean archive as the authority: a duplicate-symbol link error after a Makefile source change means a stale member, not a second definition in the sources (1.15.1)"

[gotcha.1890]
area = "kernel tests"
symptom = "a test encoding several activities into one arena fails lxp_activity_encode(...) == LXP_OK after a few encodes"
cause = "lxp_activity_encode takes a full LXP_MAX_ACTIVITY_BYTES (1 MiB) writer from the arena it is given on every call and does not return it (src/protocol/lxp_activity.c:36)"
do = "give a test encoding N activities N MiB of arena or a scratch arena reset per activity (1.4.3)"

[gotcha.1891]
area = "Rust gate tests"
symptom = "a kept gate test that reads its input file from an environment variable (tests/committed_caps.rs:9, LAYERX_CAPS_VECTORS) fails under its declared verify_cmd although it passed when the input was prepared by hand"
cause = "neither the build_cmd nor the verify_cmd produced the file or exported the variable, so the test only passed in a hand-prepared environment"
do = "declare the producer in the gate: the build_cmd produces the file and the verify_cmd exports the variable, instead of relying on a hand-prepared environment (9.24.1)"

[gotcha.1892]
area = "spec / task dependencies"
symptom = "every build of a package fails after a landed deletion task removed types it still imports (9.34.2 removed SDK types still imported by seller/src/checkpoint.ts), and the task that deletes the importer never becomes eligible"
cause = "the importer is deleted only by a late task (8.22.6 at wave 29) that requires the very package tasks whose builds fail on it, so a requires edge to it deadlocks"
do = "split the deletion into a dependency-free early task (8.22.7) and make the package tasks require it"

[gotcha.1893]
area = "Rust gate tests"
symptom = "a Rust task whose library builds clean fails its verify_cmd `cargo test -p <crate> --no-run` on integration tests outside touches (9.1.7: tests/sdk.rs and tests/offline_export.rs)"
cause = "`cargo test -p <crate> --no-run` compiles every integration test target of the crate, and those tests/ files still build the public shapes the task renamed"
do = "a task that renames a crate's public shapes owns and ports the tests/ files that build them and lists them in touches (9.1.7)"

[gotcha.1894]
area = "kernel / C structs"
symptom = "binaries and test fixtures stop compiling under -Werror=missing-field-initializers after a trailing struct member is added (1.11.1: lx_asset_runtime.binding_authority, lxp_send_environment.binding_authority)"
cause = "every positional compound literal of the struct, in the binaries and in 44 test fixtures, lacks an initializer for the new member"
do = "the task that adds the member greps `(<struct>){` across cmd/, src/ and tests/ and lists every file in touches, or a repair task follows (1.11.4)"

[gotcha.1895]
area = "Go tests / go generate"
symptom = "a Go test that depends on a shared object fetched by `go generate` (engine/executor/lib) fails with a nil engine (GigaEvmKeeper.EvmoneVM)"
cause = "the shared object is untracked and absent, and neither the build_cmd nor the verify_cmd ran the go generate step that downloads it"
do = "put the go generate step in build_cmd so the gate produces its own input (5.16.4)"

[gotcha.1896]
area = "spec / task dependencies"
symptom = "a removal task and the test task whose build links the removed call site both stay ineligible (5.49.2 required 16.23.1)"
cause = "a requires edge from the task that removes a call site to the test task whose build links that call site deadlocks when the test task also waits on the removal"
do = "the removal task comes first and the test task requires it (5.49.2 before 16.23.1)"

[gotcha.1897]
area = "Rust / Cargo.lock"
symptom = "every later `--locked` cargo build that resolves a crate stops before compiling after a dependency was added to the crate's Cargo.toml (11.2.6: serde_json.workspace = true in services/interop/crates/layerx-committed-proof)"
cause = "the dependency landed without the Cargo.lock of every workspace that contains the crate (services/interop, services/agent, services/agent/fuzz, services/agent/tests/isolation, tools/platform)"
do = "land the manifest edit with every containing workspace's Cargo.lock and list those lock files in the task's touches"

[gotcha.1898]
area = "C build / static archive"
symptom = "the link of build/liblayerx.a duplicates a symbol (1.4.3: lxp_batch_verify_signature between lxp_batch_seal.o and lxp_batch_header.o)"
cause = "the archive rule `ar rcsD` (Makefile:203) adds and replaces members but never removes a member whose source left LIB_SOURCES (lxp_batch_seal.o after f2a8c304f)"
do = "delete build/liblayerx.a before rebuilding when LIB_SOURCES shrinks"

[gotcha.1899]
area = "code graph / symbols"
symptom = "a qualified geth name (ethclient.Client) in a symbols list is always `not defined in the graph`"
cause = ".cgignore:45 (`/core`) excludes core/deps/geth from the code graph"
do = "bind rpc client tasks by their test function names under rpc/"

[gotcha.1900]
area = "spec / done evidence"
symptom = "`cg spec done` refuses a candidate whose build and verify evidence sits at an earlier revision (1.23.3: the fixture repair committed as 041f841c2 after verifying 89b201c0b)"
cause = "the repair commit was never built or verified at its own revision"
do = "give a repair commit its own build and verify run within the task's budget"

[gotcha.1901]
area = "Go modules / error codes"
symptom = "a registered error wrapped with fmt.Errorf(\"%w: ...\") keeps errors.Is but reaches the gRPC caller as codespace undefined, code 1 (4.4.6: modules/launchpad/keeper/price_history.go:13)"
cause = "in the Cosmos SDK fork sdkerrors.ABCIInfo follows only the causer interface (sdk/types/errors/abci.go:142-158), which fmt.Errorf %w does not implement"
do = "wrap a registered error with sdkerrors.Wrap so its codespace and code survive"

[gotcha.1902]
area = "spec / symbols"
symptom = "`cg spec done` fails `symbol startLayerxSync — not defined in the graph` although build and tests pass (12.0.3)"
cause = "the task deletes the symbol, and the gate resolves every listed symbol in the code graph after the change"
do = "never list a symbol the task deletes in its symbols"

[gotcha.1903]
area = "rpc / JSON-RPC dispatch"
symptom = "a retired <namespace>_unsubscribe name (lx_unsubscribe, 7.16.1) answers -32000 instead of -32601 over HTTP and WebSocket"
cause = "the JSON-RPC library routes every <namespace>_unsubscribe method name to its built-in unsubscribe callback whether or not the namespace is registered"
do = "refuse retired *_unsubscribe names through the pre-dispatch DenyList of rpc/server.go:336 and :517"

[gotcha.1904]
area = "rpc / metrics tests"
symptom = "a test that installs a global meter provider sees no evmrpc_request_latency_seconds point for any method, and about 50 methods called with empty parameters never reach their handler (7.14.6)"
cause = "the rpc package's metric instruments (rpc/metrics.go:42-43) are bound at package init, before an external test package can install a provider; argument decoding refuses empty parameters before any handler runs"
do = "swap metrics.requestLatencySeconds through an internal test hook (rpc/info_metric_labels_test.go:22-28) and call each method with minimal valid arguments"

[gotcha.1905]
area = "Rust / cross-crate shapes"
symptom = "layerx-indexer and layerx-platform-gateway stop compiling after a change confined to programs/crates/layerx-programs-ai-market/src/queries.rs (13.29.1)"
cause = "those crates construct the changed query shapes, and the task's touches stayed inside the programs crate"
do = "pair a query-shape change with a port task for its dependents and a requires edge to it (13.29.1 -> 8.1.5)"

[gotcha.1906]
area = "C build / static archive"
symptom = "a freshly built build/liblayerx.a lacks link closure (25 undefined references at 1.4.3 a8) while a pre-existing build directory links, then collides with moved definitions (lxp_batch_verify_signature, 1.11.4 a2)"
cause = "a source filtered out of LIB_SOURCES (Makefile:41-50) is still referenced by kept members, and `ar rcsD` (Makefile:203) never prunes the stale member that masks it"
do = "keep LIB_SOURCES link-closed when filtering a source and build the archive from an empty build directory"

[gotcha.1907]
area = "C build / Makefile tests"
symptom = "a Makefile verify passes while the library it shapes no longer links"
cause = "a verify that runs only `make -n` (tools/ci/tests/test_makefile_wave1.py, test_makefile_wave2.py) proves that rules exist or are gone, never that the library links"
do = "a task that removes sources from LIB_SOURCES links layerxd or another consumer in its gate (16.2.2, 16.0.2 vs 1.4.3 a8, 9.24.1 a6)"

[gotcha.1908]
area = "C build / archive symbol tests"
symptom = "modules/lxphost/archive_symbols_test.go passes against an archive that cannot link"
cause = "it reads whatever build/liblayerx.a is on disk; an archive is a set of members, so it holds unresolved references silently and never detects a missing definition or a stale member (1.21.1 passed with the stale lxp_batch_seal.o still inside)"
do = "pair an archive symbol check with a link of a consumer built from an empty build directory"

[gotcha.1909]
area = "sdk/baseapp"
symptom = "A module query error reaches the CLI with codespace sdk and code 18 although the keeper returned a registered module error."
cause = "gRPCErrorToSDKError (sdk/baseapp/abci.go:646) rewraps every handler error that is not a gRPC status as ErrInvalidRequest before QueryResultWithDebug reads the ABCI info."
do = "Return an error that already carries a registered codespace (sdkerrors.ABCIInfo codespace other than undefined) unchanged, before the gRPC status mapping (task 15.0.5)."

[gotcha.1910]
area = "apps/launchpad/mobile"
symptom = "tsc over the mobile app reports dozens of errors inside react-native globals.d.ts, lib.dom.d.ts and @types/node, or, without the DOM lib, in the launchpad SDK sources."
cause = "react-native's global declarations overlap the DOM lib the DOM-typed SDK sources need; the conflict sits only in declaration files."
do = "Keep the default lib and set skipLibCheck true in tsconfig.json as @react-native/typescript-config does; never drop DOM or add a second tsconfig for the tests."

[gotcha.1911]
area = "spec task symbols"
symptom = "cg spec done reports N graph check(s) failed — symbol X not defined in the graph — although verify_cmd passed"
cause = "symbols named things the code graph never indexes (Elixir modules and functions, ExUnit test names, env vars, Makefile variables, Python Class.method paths, script or file names, metric strings) or definitions the task itself deletes"
do = "list in symbols only functions, methods, types, macros and test functions, by bare name, that exist after the change in a language the graph parses (C, Go, Rust, TypeScript, Python, Solidity); Elixir tasks use symbols = []; test names belong in tests; a deletion task lists only what it keeps or rewrites"

[gotcha.1912]
area = "kernel C structs"
symptom = "-Werror=missing-field-initializers refuses the lx_asset_runtime literals in cmd/layerxd and cmd/layerx-guarantor after the struct gained a member"
cause = "positional compound literals stop at the old last member; the task that appended the member built only its own test"
do = "a task that appends a struct member updates every positional literal of that struct in the same change (grep for `(type){`) or names the task that will"

[gotcha.1913]
area = "launchpad gRPC queries"
symptom = "a Query handler test panics `invalid Go type types.Int for field ...Response.<field>` although the handler returns the right value"
cause = "sdk/baseapp/grpcrouter.go:100 marshals query responses with the grpc default proto codec, which cannot reflect a top-level non-pointer gogoproto customtype Int field; nested messages go through the gogo Marshal method and pass"
do = "declare top-level amounts in query responses as plain decimal strings (wire and JSON unchanged) or nest them in a message"

[gotcha.1914]
area = "launchpad mobile tests"
symptom = "vitest fails `Cannot find module './validators-v1.gen.js'` from sdk/launchpad/packages/sdk/src/validate.ts even after the SDK build"
cause = "compile-validators.mjs emits the generated validator modules only into dist/; the repository tracks only their .d.ts declarations, so importing the SDK from src finds no runtime module"
do = "alias the three ./validators-*.gen.js specifiers to the built dist files in the consumer's vitest config and build sdk-v2 then sdk before the test"

[gotcha.1915]
area = "kernel activity envelope"
symptom = "every HostExecute from a keeper is refused LXP_ERR_MALFORMED_ENVELOPE and the refusal receipt carries code 0"
cause = "the activity's NotBefore/NotAfter bound was wider than the admission window (src/sequencer/lxp_admission.c:13-15), or AccountSequence was set to identity sequence + 1 although the host already stores the next admitted sequence"
do = "set NotBefore = block time, NotAfter = block time + TimestampWindowMs and AccountSequence = ReadIdentitySequence unchanged"

[gotcha.1916]
area = "kernel module custody"
symptom = "an unsigned bound escrow, budget or stream activity is refused LXP_ERR_BAD_SIGNATURE at execution although admission accepted it"
cause = "lxp_ctx_account_stage_module_custody (src/protocol/lxp_module_ctx.c:895) verifies the activity signature unconditionally; only the asset issuance and account staging calls honour the asset runtime's binding_authority"
do = "read ctx->kernel->module_runtime[LXP_MODULE_ASSET] and skip only the signature check when binding_authority is set (task 1.11.6)"

[gotcha.1917]
area = "kernel authority grants"
symptom = "every fee-bearing session or capability grant is refused LXP_ERR_AUTH_SCOPE although its fee asset is the governed occupancy asset"
cause = "grant_scope_validate (src/modules/governance/lxp_governance.c:480) compares the fee asset with the static runtime->occupancy_asset_id, which no node fills; the charge path resolves the asset through resolve_occupancy_parameters instead"
do = "resolve the governed asset through the runtime resolver (version 0 is the active record) as src/state/lxp_authority.c:1041-1047 does (task 1.14.6)"

[gotcha.1918]
area = "kernel budget module"
symptom = "after a budget defund the per-period limit read back is lower than the limit the budget was created with"
cause = "lx_budget_defund_limit (src/modules/budget/lx_budget_close.c:62-82) lowers per_period_limit to spent_this_period plus the resulting balance whenever the remaining allowance exceeds the post-defund balance"
do = "expect limit = spent + balance after a defund that leaves less than the remaining allowance; do not assert the creation limit"

[gotcha.1919]
area = "Makefile CI tests"
symptom = "test_aggregates_dry_run_clean reports a retired member in a compile or archive line under build-repro-a/, build-repro-b/ or build/<sanitizer>/"
cause = "the aggregate dry run recurses into the reproducible (Makefile:220-225) and sanitizer (Makefile:1588-1596) build directories, which relink the same members"
do = "classify library lines with a pattern that accepts the build, build-repro-[ab] and build/(crypto-)?(a|t|ub)san prefixes before asserting retired substrings"

[gotcha.1920]
area = "cosmos module errors"
symptom = "a gRPC query that returns a registered module error reaches the client as code 3 InvalidArgument instead of the module code"
cause = "sdkerrors.ABCIInfo (sdk/types/errors/abci.go:117-160) unwraps through Cause() only; an fmt.Errorf %w wrap has no Cause(), so gRPCErrorToSDKError (sdk/baseapp/abci.go:645-652) rewraps the error as ErrInvalidRequest"
do = "wrap registered errors with a type that implements both Unwrap() and Cause(), or return the registered error itself"

[gotcha.1921]
area = "TypeScript workspace typecheck"
symptom = "apps/web typecheck fails TS2412 inside sdk/wallet/src/index.ts although sdk/wallet's own typecheck passes"
cause = "apps/web compiles the wallet SDK source with exactOptionalPropertyTypes (apps/web/tsconfig.json:16), which refuses assigning a possibly undefined value to an optional field, and sdk/wallet's tsconfig does not set it"
do = "assign optional fields only inside a presence check in SDK sources that apps/web compiles, and typecheck through apps/web before qualifying a wallet SDK change"

[gotcha.1922]
area = "explorer indexer ABI conformance"
symptom = "kept_topics_match_precompile_abis reports a launchpad topic absent from precompiles/launchpad/abi.json although the indexer decodes it from chain logs"
cause = "precompiles/launchpad/abi.json is the v6.12.0 surface; the indexer's launchpad definitions are the v6.10 events of precompiles/launchpad/legacy/v610/abi.json, and precompiles/launchpad/setup.go:11-18 serves both versions at 0x…1017"
do = "compare launchpad topics against the union of the two served ABI files, and add v6.12.0 definitions in their own task"

[gotcha.1923]
area = "agent crates settlement document"
symptom = "a layerx-sdk or layerx-client test that verifies a checkpoint certificate fails Verification although the vector is unchanged"
cause = "layerx-proof embeds contracts/config/checkpoint-settlement.json via include_str! and b284707f6 replaced that document with an unrelated offline_export map, so every certificate verification returns Configuration; the whole path is retired (req.6496 ac_3, 9.27.4)"
do = "do not restore the document; retire the certificate callers top-down (client and SDK before layerx-proof) and gate SDK tasks on that retirement"

[gotcha.1924]
area = "spec retirement ordering"
symptom = "a module deletion task is scheduled in an earlier wave than the tasks that remove its callers, so the wave would not compile"
cause = "the deletion task's requires list names the tasks that produced the replacement, not the tasks that remove the remaining consumers"
do = "before scheduling a deletion, grep every consumer of the deleted symbols and add a requires edge to each consumer's remover; a consumer with no remover is a finding"

[gotcha.1925]
area = "explorer indexer market events"
symptom = "adding a launchpad definition to PaxeerXLogs makes market_event_test.exs fail although the new rows parse"
cause = "services/explorer/backend/apps/explorer/test/explorer/chain/paxeer_x/market_event_test.exs:138-145 asserts that @market_signatures equals the launchpad definitions' signatures exactly"
do = "extend the @market_signatures launchpad list in the same change as the definitions"

[gotcha.1926]
area = "rust-crates"
symptom = "a dependant crate fails E0432 on `use <crate>::<module>` for a module the crate just added"
cause = "the module was declared inside a private parent module and never re-exported from lib.rs, and the crate's own tests reach it through the parent"
do = "when a task adds a module under a private parent, also add it to the crate root's `pub use` line, and list lib.rs in touches"

[gotcha.1927]
area = "kernel-programs"
symptom = "a scheduler-width test over LX_PROGRAMS_CALL items never sees maximum_level 0 (every item lands in one chain)"
cause = "under the OCCUPANCY and STATE_COMMITMENT protocol versions lxp_programs_call_schedule_item_prepare adds a write on the shared occupancy fee treasury to every CALL item (src/modules/programs/call.c:2569-2585)"
do = "build width tests with LXP_PROTOCOL_VERSION_LEGACY items, or assert equality without a level-0 precondition when occupancy semantics are the subject"

[gotcha.1928]
area = "spec/layerx-merge/programme"
symptom = "test_wave_<n>_gate fails with run-wave exit=2 and only the pytest assertion in the verify log"
cause = "run_gate.py writes its stage logs to a mktemp directory and the test's wave-<n>.log under logs/waves/<n>/, neither of which the verify output quotes"
do = "Read logs/waves/<n>/wave-<n>.log from the tree that ran the gate before classing the failure; the dry-run stage passing means a workspace-build, lint or test stage failed"

[gotcha.1929]
area = "spec-tooling"
symptom = "A verify_cmd that quotes an environment value with escaped double quotes passes by hand and fails under cg spec done with a NotFound or is_file panic on the quoted path."
cause = "The kvx reader keeps the backslash escapes (gotcha.111), so the quote characters become part of the value."
do = "Write verify_cmd environment assignments without quotes; the repository paths contain no spaces, and $PWD and ${VAR:-default} expand unquoted."

[gotcha.1930]
area = "sig-provider"
symptom = "cargo check --all-targets -p sig-provider-server fails with missing field precompiles in the SourcesSettings initializer in tests/mock.rs"
cause = "a settings field added with a Default impl is not picked up by a struct literal in a test; the crate's own unit tests compile without --all-targets"
do = "when adding a field to SourcesSettings, update tests/mock.rs and run cargo check --all-targets for sig-provider-server"

[gotcha.1931]
area = "precompiles/layerxpay"
symptom = "a 0x101B family handler file compiles and its unit tests pass, yet the precompile emits no family event and constant views revert LXP_NON_CANONICAL"
cause = "Executor.Execute and Executor.view in layerxpay.go dispatch by family only where a hook exists; a new family file is dead code until its methods are routed there"
do = "every family task owns the hook lines in layerxpay.go as well as its family file, and the edits to layerxpay.go are serialised through requires"

[gotcha.1932]
area = "local node"
symptom = "tests reading LOCAL_NODE_RPC or PERPS_DATA_TEST_RPC fail with connection refused in a clean environment"
cause = "the perps and spot precompiles, the 18 markets and the 3 spot tokens exist only after the v6.12.0 upgrade handler; a fresh genesis cannot run it"
do = "start tools/qualification/localnode/v6120-node.sh (task 5.98.1) first and source its env file"

[gotcha.1933]
area = "layerxpay keeper tests"
symptom = "budget activities submitted through paySubmitExecute fail with LXP_ERR_UNKNOWN_ACCOUNT_NAMESPACE"
cause = "payActor.authority() (modules/layerxpay/keeper/harness_test.go:39) binds the DID id as principal and budget_authorized_signer (src/modules/budget/lx_budget_module.c:292) resolves principals through lxp_ctx_account_find"
do = "submit budget activities through Keeper.Submit, which binds the main account as principal"

[gotcha.1934]
area = "terminal v5 corpus"
symptom = "program-terminal-v5.py refuses with `native signed corpus was not emitted` although the native build passed"
cause = "test_terminal_v5 --dump-corpus exited non-zero on a V5_CHECK; the producer parses its truncated stdout and raises before printing the case names"
do = "read native-result.json next to the producer output: stderr names the failing fixture line and the receipt codes of the completed cases"

[gotcha.1935]
area = "lxphost receipts"
symptom = "a keeper or precompile test reads a write's receipt back with Host.ReadIdempotentReceipt and fails with LXP_ERR_UNKNOWN_FIELD although the write itself succeeded"
cause = "since task 1.2.1 the kernel records no idempotency entry, so lxphost_read_receipt (modules/lxphost/read.go:164) finds no row for the key"
do = "assert the write through the receipt the call returns, the stored record and the emitted event; do not read receipts back by key"

[gotcha.1936]
area = "spec verify_cmd"
symptom = "a verify_cmd fails before running anything: the shell reports a path such as /work/repo/\"\"\"\" or the first word is export CARGO_TARGET_DIR=\\\"..."
cause = "cg hands the kvx string to the shell as written, so an escaped double quote in verify_cmd reaches the shell as a literal backslash and quote"
do = "write verify_cmd without double quotes: single quotes for test patterns, bare $(...) and ${VAR:-default} expansions, and paths without spaces"

[gotcha.1937]
area = "spec wave order"
symptom = "Adding a later-wave task to one task's requires and bumping only that task's wave left a dependent task in an earlier wave than its requirement; the plan check reported a later-wave reference after the commit was already pushed."
cause = "A wave bump cascades: every task that requires the moved task must move with it, and the chain that committed did not stop on the check's result."
do = "After any requires or wave edit, recompute waves over the whole task graph until no task sits before a requirement, and gate the commit on the plan check's empty bad_refs and cycles."

[gotcha.1938]
title = "A Cargo.lock that lacks one dependency line fails every --locked build of its workspace"
observed = "After a crate manifest gained a workspace dependency without a lock refresh, cargo build --locked refused all 39 pending interop targets with 'the lock file needs to be updated'; the whole difference was one missing line in one dependency list."
lesson = "When a task adds or removes a dependency in a Cargo.toml, its touches must include the workspace Cargo.lock and its implementation must regenerate it (cargo metadata --offline suffices for path and already-cached crates); check cargo metadata --locked --offline on main whenever a --locked gate fails before any task change."

[gotcha.1939]
area = "spec"
symptom = "a task reshapes a public struct of a library crate and its tests pass, then the dependents gate fails in a binary of another crate that reads the removed fields (VerifiedLayerxLeg in the reference ramp)"
cause = "the dependents gate compiles every crate that depends on a touched crate; a field rename is a break for each use site outside the task's touches"
do = "before reshaping a public type, grep its field names across services/ and give the task the use-site files, or order the dependent's port task before it"

[gotcha.1940]
area = "node"
symptom = "a precompile merge constructor panics 'keeper is unavailable' in every node.New although the keeper is wired"
cause = "the keepers interface the constructor asserts declares the accessor returning the keeper by value while node/precompiles.go exposes it as a pointer; a type assertion on a mismatched method signature never matches"
do = "declare the accessor exactly as node/precompiles.go exposes it (pointer or value), nil-check a pointer, and dereference for constructors that take a value"

[gotcha.1941]
area = "modules/launchpad"
symptom = "a REST test asserts the registered error code (12) on the body of a gRPC-gateway response and reads 2"
cause = "sdkerrors.Register codes are ABCI codes; the REST body carries the gRPC status code (codes.Unknown = 2 for an ABCI error); the two registries never agree"
do = "assert ABCI codes on abciResponse.Response.Code with the codespace, and compare REST body codes only with status.Convert(err).Code() of the same query"

[gotcha.1942]
area = "modules/layerxauth"
symptom = "a MsgExec after the grantor revokes the kernel grant on 0x101C fails with authz 'authorization not found' instead of ErrAuthRevoked"
cause = "the kernel revoke deletes every authz grant bound to the kernel grant (keeper/revoke.go:41-74) before LayerXScopeAuthorization.Accept can report the stale revocation epoch"
do = "prove the post-revoke refusal as ErrUnauthorized with GetAuthorization nil, and prove ErrAuthRevoked separately on a saved authorization whose RevocationEpoch is stale"

[gotcha.1943]
area = "apps/web e2e"
symptom = "a test that mints a TLS certificate with 'openssl req' at runtime exits 1 with no output in the qualification environment"
cause = "openssl is not on the test image; a shell-out at test time binds the test to the host toolchain"
do = "commit a long-lived self-signed localhost certificate and key under e2e/fixtures/ and read them with fs, or serve the fixture over http"

[gotcha.1944]
area = "precompiles/spot"
symptom = "a test asserting gas left == supplied - cost - executionGas measured on its own context fails by a few thousand gas"
cause = "RunAndCalculateGas charges cost up front, meters the keeper execution under a fresh Cosmos meter sized from supplied-charge and converts the remainder back through GetEVMGasLimitFromCtx, so the inner reads' Cosmos gas is not the EVM gas a caller measures on another context"
do = "assert supplied-left >= cost and the out-of-gas boundary at cost-1 instead of equality"

[gotcha.1945]
area = "node tests"
symptom = "a sequencer RPC test refuses every request with gas wanted above the block limit although the limit was never set"
cause = "InitChain with default consensus params leaves Block.MaxGasWanted 0 and node/sequencer/limits.go:43 compares literally"
do = "set Block.MaxGas and Block.MaxGasWanted in the test app's InitChain consensus params (node/genesis_sequenced_test.go:52 shows the shape)"

[gotcha.1946]
area = "layerx-crypto"
symptom = "sign_disclosed_call of an 0x101A ABI call fails with InvalidDisclosure although the call is well formed"
cause = "bind_call only discloses send(bytes), issueGrant(bytes), draw and revokeGrant (disclosure/call.rs:81 decode_method); every other selector is MalformedPayload, which the SDK maps to InvalidDisclosure"
do = "extend ConstructMethod, decode_method and fields for the new method before calling it from the SDK; compute the selector from the Go ABI in precompiles/layerxledger"

[gotcha.1947]
area = "services/platform/hosted/gateway/tests/local"
symptom = "cargo build of the local qualification package fails in its build script: 'parent-built core binary required' or 'fixture path contract changed'"
cause = "the package adapts the core boundary fixture at build time: it needs LAYERX_TEST_CORE_BIN set to a built layerx-core-boundary and asserts three needles in core/tests/boundary.rs, one of which moved when platform moved"
do = "do not give a task a build or verify command against that manifest; put stand-alone tests in the gateway crate's tests directory (include_str! the scanned file) and leave the package to the task that deletes its lifecycle target"

[gotcha.1948]
area = "precompiles/layerxprograms"
symptom = "go test of a precompile package fails with 'import cycle not allowed in test' as soon as a test imports node or another package that imports the package under test"
cause = "an in-package _test.go file is compiled into the package, so any import that reaches back to the package closes a cycle; Go only allows that from an external test package"
do = "move the tests that need node or the app to package <name>_test and re-export the unexported identifiers they use through an export_test.go (precedent precompiles/spot/export_test.go)"

[gotcha.1949]
area = "node/sequencer"
symptom = "starting a sequencer primary in a test or fixture recorder fails with ErrConfigStandbyAddress, or Replicator.Release returns a dial error before the first block"
cause = "a primary requires a host:port standby address (node/sequencer/node.go:62) and a reachable standby; Release dials it on every accept (node/sequencer/node_start.go:111)"
do = "start a standby with sequencer.StartStandby on a free loopback port first and point the primary's standby-address at it, as node/sequencer/tcp_ack_test.go:70-90 does"

[gotcha.1950]
area = "node/upgrades"
symptom = "applying the v7.0 upgrade handler through the app in a test panics 'missing merge constructors or activation precompiles: 0x0903, 0x0905, 0x0906'"
cause = "validateMergePrecompiles (node/upgrades.go:584) requires the oracle, scheduler and streams precompiles to be registered, which only happens once node imports them"
do = "order any test that applies the v7.0 handler after the task that wires those precompiles into node; do not register constructors from the test and do not relax the check"

[gotcha.1951]
area = "services/interop"
symptom = "cargo build --tests of layerx-interop-gateway fails in tests/workspace_lock.rs with a missing Cargo.toml for a crate that no longer exists"
cause = "workspace_lock.rs include_str!s every member crate's manifest; deleting a crate without removing its entry breaks every test target of the gateway"
do = "when a crate is deleted, drop its entry from services/interop/crates/layerx-interop-gateway/tests/workspace_lock.rs in the same change"

[gotcha.1952]
area = "daemon/paxd/cmd"
symptom = "validate-genesis reports 'receipt key list is empty' right after add-genesis-receipt-key succeeded"
cause = "the command re-marshals the untagged sequencertypes.GenesisState (key ReceiptKeys) while the module decodes its wire object with receipt_keys and byte-string leaders (modules/sequencer/module.go:38-45)"
do = "edit the module state as map[string]json.RawMessage in the module's wire encoding, as add-genesis-sequencer-leader (daemon/paxd/cmd/genseqleader.go) does"

[gotcha.1953]
area = "node/sequencer, rpc"
symptom = "a test expects transactionIndex 0x0 or receipt Index 0 for the first accepted transaction and gets 1"
cause = "the sequencer numbers accepted transactions from 1 within the open block (node/sequencer/accept.go:40, microbatch.go:333) and the receipt RPC reads that index verbatim; 0 marks an invalid receipt (rpc/sequencer_receipt_test.go:515)"
do = "assert Index 1 and transactionIndex 0x1 for the first accepted transaction"

[gotcha.1954]
area = "services/platform/perps-data"
symptom = "a go test in perps-data fails with 'TestMarkets requires PERPS_DATA_TEST_RPC' (or the e2e equivalent) in an environment without a node"
cause = "the package test clients dial the node named by PERPS_DATA_TEST_RPC and fail rather than skip when it is unset"
do = "run the test behind tools/qualification/localnode/v6120-node.sh --env-out <file> and source that file (set -a; . <file>; set +a) before go test, as the done markets tasks do"

[gotcha.1955]
area = "tools/qualification/localnode"
symptom = "perps-gateway.sh stops with 'nats-server is required' although nats-server was installed with go install"
cause = "the script checks command -v for nats-server and reads PERPS_DATA_TEST_DATABASE_URL from the environment; a GOPATH/bin binary is not on PATH by default"
do = "put $(go env GOPATH)/bin on PATH and export PERPS_DATA_TEST_DATABASE_URL before running the script"

[gotcha.1956]
area = "tokenfactory"
symptom = "CreateDenom returns \"subdenom too long, max length is 44 bytes\" when a layerxledger asset is bound"
cause = "hex of a 32-byte asset id is 64 characters; MaxSubdenomLength is 44 (modules/tokenfactory/types/denoms.go:17) and sdk.ValidateDenom allows only [a-zA-Z0-9/-], so base64 is out too"
do = "encode the asset id as the base-62 text of its big-endian integer zero-padded to 43 digits (big.Int.Text(62)); test against the real keeper, a recording IssuerKeeper never sees the cap"

[gotcha.1957]
area = "ramps toolkit"
symptom = "cargo test -p layerx-ramp-toolkit fails compiling src/bin/ramp-verify-receipt.rs after a change to LayerxConfig"
cause = "the crate's binaries compile together with its tests, and the reference ramp crate depends on the toolkit types"
do = "when changing a shared config or client type, port the crate's bins and every dependent crate in the same task; a type change that leaves dependents uncompilable cannot be qualified alone"

[gotcha.1958]
area = "precompiles"
symptom = "TestMergeServes0x0903/0x0905/0x0906 fail with \"node must register the ... constructor\""
cause = "node/precompiles.go imports the agent oracle, scheduler and streams precompile packages only through task 5.94.4, so MissingMergeConstructors still lists them"
do = "order activation tests for 0x0903, 0x0905 and 0x0906 after 5.94.4"

[gotcha.1959]
area = "committed-fixture recorder"
symptom = "paxd panics \"validator ... not in committee\" (consensus/internal/consensus/state.go:2622) when a standby node is started next to the primary"
cause = "the standby home was initialised with --mode validator and a fresh priv_validator_key that no gentx put in the validator set"
do = "initialise the standby with --mode full, copy the primary genesis.json, set sequencer.role = standby and start it before the primary"

[gotcha.1960]
area = "interop gateway AP2"
symptom = "Ap2Adapter::execute returns EvidenceMismatch for a recorded payExact receipt"
cause = "settle_with_sequencer_evidence (gateway.rs:613-622) needs exactly one PaymentExact log whose reference topic equals the payment idempotency key; a recorded receipt carries a recorded reference"
do = "rewrite topics[3] and the same 32 bytes of signed_receipt to payment.idempotency_key(), re-sign under a fresh Ed25519 key pinned to the recorded key id and heights (tests/sequencer_settlement.rs sign_payment_reference)"

[gotcha.1961]
area = "node store upgrades"
symptom = "node/app.go:1553: undefined: storekeys.LayerXAnchorStoreKey; every Go test importing node fails at build"
cause = "one task retired the store key constant while the store deletion upgrade and its tests from another task still named the store through it"
do = "a deletion upgrade names a retired store by a literal of its historical name; when retiring a store key constant, grep node/ and storage/ tests for the constant and port them in the same change"

[gotcha.1962]
area = "cargo workspaces"
symptom = "cargo --locked: the lock file <ws>/Cargo.lock needs to be updated, in workspaces the change never touched"
cause = "a crate manifest changed its dependency list and only its own workspace lock was refreshed; other workspace locks pin that crate as a path dependency and record its dependency list"
do = "after editing any crate manifest, run cargo metadata without --locked in every workspace whose Cargo.lock names the crate (grep -l 'name = \"<crate>\"' $(git ls-files '*Cargo.lock')) and commit those locks with the change"

[gotcha.1963]
area = "x-websearch"
symptom = "error[E0432]: unresolved imports crate::payment::GatewayRpc, crate::payment::RpcAnswer after deleting them as a do item asked"
cause = "the do item listed only the payment.rs sites; kernel.rs and watch.rs import the same items and neither is in the task"
do = "before deleting a pub item, git grep its name across the crate and either add every importer to the task or keep the item and hand its deletion to the task that removes the last importer"

[gotcha.1964]
area = "sequencer-receipt vectors"
symptom = "a vector test expects every expected.refusedAt case to be refused by decode or verify and fails on V3-activity-id-not-raw-hash and V3-seq-hash-mismatch"
cause = "expected.verifier is the signature verifier's verdict; R4 and R6 are client rules over rawTransaction and prevSeqHash that a receipt verifier without those inputs cannot apply, so their verifier value is accepts"
do = "classify by expected.verifier first (Decode, SequencerSignature, accepts) and apply R4 (keccak of rawTransaction) and R6 (sequence chain) in the test from the case inputs, as services/agent/crates/layerx-proof/tests/sequencer_receipt_vectors.rs does"

[gotcha.1965]
area = "node tests"
symptom = "a task written to restore one retired symbol in node/store_delete_test.go fails because the same file references a second retired keeper method"
cause = "the task was scoped from the first compile error only; go reports errors per package and stops at the first file set, hiding later dead references"
do = "before publishing a compile-repair task, list every a.<Keeper>.<Method> reference in the test file and confirm each method still exists on the live keeper (git grep 'func (k *Keeper) <Method>('), then cover all of them in one task"

[gotcha.1966]
area = "cargo workspaces"
symptom = "a lock-refresh task fails its build with E0432/E0599 inside a path dependency, not in the lock"
cause = "a crate in another workspace deleted public items (SignedHeaderTrust, MirrorVerifier::from_source) that a shared library crate still uses, so every workspace depending on that library stops building"
do = "before deleting a pub item from a crate other workspaces depend on, git grep the item across services/ and tools/ and put the dependents' port in the same task or a required follow-up; gate lock-only tasks with cargo metadata --locked rather than a compile"

[gotcha.1967]
area = "conformance vectors"
symptom = "a vector-driven test fails on cases whose expected.verifier is accepts or Decode even though the component under test behaves per the vector"
cause = "expected.verifier is the signature verifier's verdict over the signed bytes: Decode is raised by verify_sequencer_signature, not by a JSON view decoder, and accepts means the refusal (R4, R5, R6) is a client rule that a bytes-only verifier such as the mirror cannot and must not raise"
do = "classify cases by expected.verifier; for accepts cases assert the verifier accepts and apply the client rule in the test from rawTransaction, prevSeqHash and the JSON view; for Decode cases call the verifier and assert ReceiptCheck::Decode"

[gotcha.1968]
area = "x402 payment plane"
symptom = "a settled metered draw answers receipt_consumed on its first receipted retry although the record was released once"
cause = "the plane saved leaf_hash of the signed receipt (LXP/v1/merkle-leaf domain) as the record digest while the seller compares the canonical_receipt_digest the gateway recorded at settlement, so PaymentStore::release saw two different digests for one receipt"
do = "when a digest is stored by one component and compared by another, grep the comparer first and use its exact function (canonical_receipt_digest for sequencer receipts); never derive the stored digest with a different hash domain"

[gotcha.1969]
area = "spec"
symptom = "A done task's late do item said a planned dispatch table was unnecessary because an existing Execute already dispatched; it dispatched one method, and 21 dependant tasks that add handlers in their own files found no seam and failed with LXP_PRECOMPILE_UNKNOWN_METHOD."
cause = "The reading that excused the table checked the task's own tests, not the touches of its dependants."
do = "Before excusing a planned registration or dispatch seam, list the dependants' touches; if they add handlers in separate files the seam is required, so add it as a small task in the dependants' wave and make them require it."

[gotcha.1970]
area = "spec"
symptom = "A delete-the-module task listed the module, its tests and the files its do items named; the build failed because three other files imported the module's re-exports and one enum."
cause = "The do items were written from the module's own callers, not from a grep of crate::<module> across the crate."
do = "Before writing a module-deletion task, grep crate::<module>:: and <module>:: across the crate and every test, and give each surviving symbol a destination file in a do item and in touches."

[gotcha.1971]
area = "spec"
symptom = "An acceptance criterion generalised a refusal reason to every negative case of a shared vector file, and three cases returned a different reason that another criterion in the same feature requires."
cause = "The criterion was written from the three cases its parenthesis names and did not read the vector file's verifier column, which separates signature failures from content mismatches."
do = "When a criterion ranges over the cases of a shared vector file, derive the expected outcome per case from the file's own classification fields and cite the sibling criterion that governs each class."

[gotcha.1972]
area = "precompiles/layerxprograms"
symptom = "View tests that seeded kernel state by submitting a module activity were refused LXP_ERR_UNKNOWN_ACTIVITY, and versioned schedule views had no host reader for the history rows."
cause = "The hosted programs registration does not route every module activity, and the host read wiring named only the active-row readers."
do = "Seed module state in view tests with kv.Set under the kernel key layout, and when a view takes a version argument check modules/lxphost/read.go for a reader over the history prefix before writing the handler."

[gotcha.1973]
area = "node/abci"
symptom = "A merged chain refused every proposal at height 2 with proposer ... is outside the pinned leader list although the validator key was pinned as a leader."
cause = "Header.ProposerAddress is the 20-byte crypto.AddressHash of the validator key while the leader list stores 32-byte keys, and the check compared the two directly."
do = "Compare the proposer with crypto.AddressHash(leader) for each pinned key, and drive ProcessProposal tests with the derived address, never the raw key."

[gotcha.1974]
area = "apps/perps"
symptom = "Removing a field from the static PerpsMarket seed type broke tsc in widgets and tests that never read the seed list."
cause = "MarketRow and the mobile market props extend PerpsMarket, so the gateway-fed consumers inherit every seed field."
do = "Keep live-only fields on a type that extends the seed type (TradeableMarket) and point the gateway-fed consumers at it before deleting the seed field."

[gotcha.1975]
area = "services/interop/x-websearch"
symptom = "Deleting a crate module that only re-exported symbols still broke the integration tests, which imported the symbols through the deleted path."
cause = "tests/ reach crate items through x_websearch::<module>:: paths, so re-export removal is a public API change that git grep over src/ alone does not show."
do = "Before deleting a module, grep the whole crate directory (tests, benches, examples) for its path and repoint or delete every importer in the same change."

[gotcha.1976]
area = "modules/layerxauth"
symptom = "go test of the auth keeper package fails at setup with import cycle not allowed in test, before any test runs."
cause = "In-package test files import tests/testutil/keeper, which imports node, which imports the keeper under test."
do = "Tests that need the node test harness live in package <pkg>_test with an export_test.go bridge, as the ledger keeper tests do."

[gotcha.1977]
area = "services/interop/x-websearch"
symptom = "Every V3 conformance case was refused invalid_payment_payload instead of a receipt refusal."
cause = "The V3 vectors carry no txHash and the exact payload parser now requires one before fetching the receipt."
do = "Derive the payload txHash as keccak of the case rawTransaction and script the gateway receipt answer for it; the receipt refusals come only after the payload parses."

[gotcha.1978]
area = "services/platform/perps-data"
symptom = "A test that expects a chain-backed refresh to land and the refreshed height to advance within a few hundred milliseconds fails with the column still NULL."
cause = "One refresh against the started node takes longer than the bound and two consecutive refreshes can read the same height."
do = "Prove a second refresh by clearing the rows after the first one lands and waiting for them to be refilled, with bounds in seconds."

[gotcha.1979]
area = "kernel-host"
symptom = "Programs account, wind-down, sandbox or storage-retirement activities submitted through the hosted kernel revert LXP_ERR_UNKNOWN_ACTIVITY while deploy, call and transfer work."
cause = "modules/lxphost/host.go:159 and read.go:216 register programs_module_registration(), whose activity list (src/modules/programs/registration.c:18-24) is the five original types."
do = "Check the list lxp_kernel_module_for_activity consults before suspecting the payload codec; register the variant that lists the activity (task 1.23.5)."

[gotcha.1980]
area = "kernel-host"
symptom = "Every non-zero fee limit through Host.Execute or Host.Simulate is LXP_ERR_FEE_UNPAYABLE, and Host.Simulate of an unsigned host-bound activity is LXP_ERR_BAD_SIGNATURE."
cause = "lxphost_execute and lxphost_simulate never fill execution->fee_balance, and lxphost_simulate never sets execution->binding_authority."
do = "Fill fee_balance from the payer's agent main account as cmd/layerxd/lxp_daemon_lni.c:2300-2346 does and mirror host.go:536-537 in simulate (task 1.23.6); tests need a funded main account."

[gotcha.1981]
area = "precompiles"
symptom = "Asserting a revert reason equal to a bare LXP_ code fails with actual 'LXP_CODE: detail'."
cause = "pcommon.RevertReason joins code and detail with ': ' (precompiles/layerxprograms/errors_test.go:68)."
do = "Compare with pcommon.LXPRevert(code, detail) as gate_test.go:102 does, or ErrorContains \"LXP_CODE:\"."

[gotcha.1982]
area = "spec"
symptom = "Spec lines citing include/layerx/programs.h:171-179 for Programs activity types point two lines early."
cause = "LX_PROGRAMS_FEE_GOVERNANCE was inserted into the enum, shifting ACCOUNT to :176, WIND_DOWN to :177, SANDBOX to :179 and STORAGE_RETIREMENT to :181."
do = "Cite the enum by value (0x0009000N) and re-read the header before trusting a line number."

[gotcha.1983]
area = "ramps"
symptom = "Removing the reference ramp's PaxeerConfig RPC fields or State tracker fields fails to build with E0609, E0061 and E0063."
cause = "rebalance, rebalance_presentation, verify_recovery_settlement's sixth argument and RampEngine.registry still read them until later tasks remove those readers."
do = "Remove the fields in the task that removes the last reader (8.31.2), not in the configuration task."

[gotcha.1984]
area = "programs"
symptom = "A hosted Programs transfer from a ledger account is refused LXP_ERR_AUTH_SCOPE, or LXP_ERR_NON_CANONICAL when the authority hash is zero."
cause = "src/modules/programs/transfer.c:107-108 and :51-52 accept only a leg whose from id equals authority->principal, which under decision.1329 is the DID id and never an account id; :133-136 refuse a zero authority_hash."
do = "Debit the DID's main or asset account under task 13.25.4 and fill Kind and AuthorityHash through principalOf (13.25.5)."

[gotcha.1985]
area = "lxphost"
symptom = "Host.Execute of ACCOUNT 0x00090006 or WIND_DOWN 0x00090007 returns the Go error LXP_ERR_MODULE_DISABLED although the Programs module is registered."
cause = "src/protocol/lxp_kernel.c:6752-6762 gates Programs state activities on kernel->observe_commit, which only lxp_programs_bind_state_feed (src/modules/programs/feed.c:114) sets."
do = "Bind a Programs state feed before expecting a receipt; the error is not a registration failure."

[gotcha.1986]
area = "layerxauth"
symptom = "A test expecting ErrIdempotentReplay for a reused idempotency key never sees it and finds nothing under host prefix 0x04."
cause = "req.1010 (task 1.2.1) removed kernel idempotency recording; only the account sequence refuses replay, with ErrSequenceReused."
do = "Assert ErrSequenceReused on a consumed sequence and an empty 0x04 prefix."

[gotcha.1987]
area = "sequencer"
symptom = "A paxd standby refuses every replicated group after the first commit ('standby holds seq 1') and the primary halts in its commit listener."
cause = "AppReplayer.Apply treats wal.Committed as a no-op and sequential.Open requires LastBlockHeight+1, so an unpeered standby stays at height 1 and Open(3) fails with a sticky refusal (node/sequencer/standby.go:323, :695-700)."
do = "Peer the standby to the primary and, under task 5.55.6, wait for the app commit before applying Open(H+1)."

[gotcha.1988]
area = "rpc"
symptom = "eth_gasPrice on a sequencer fails with 'pending block does not fix a base fee'."
cause = "rpcPendingSnapshot (node/app.go:3288) forwards only Snapshot and PendingTx, so evmrpc.PendingBaseFee (rpc/info.go:376) is unsatisfied at rpc/info.go:387."
do = "Read baseFeePerGas of eth_getBlockByNumber latest, or forward BaseFeePerGas (task 5.55.6)."

[gotcha.1989]
area = "spec"
symptom = "cg spec done refuses 'symbol Type::method -- not defined in the graph' for a method declared in a lifetime or generic impl."
cause = "The symbol graph does not link methods of impl Type<'_> back to Type::method (finding.11.23.3.1, finding.8.29.1.1)."
do = "List the test functions or free symbols in symbols instead of the impl methods."

[gotcha.1990]
area = "x-websearch tests"
symptom = "cargo test -p x-websearch fails in tests/api.rs at under_the_single_level_only_the_named_attestor_signs_and_fulfil_carries_one_signature with Error: Evm(Malformed) while the lib and payment suites pass."
cause = "decode_request_view (src/submit.rs:291-327) accepts only the eleven-word request view, but tests/fixtures/api/evm.json still records the nine-word getRequest answer from before the view grew."
do = "Re-record the fixture's getRequest answer as the eleven-field view (task 18.1037.1, issue #1037); never widen the decoder to accept the short answer."

[gotcha.1991]
text = "Requirement references can identify numbered clauses under a parent section; read-only scheduling helpers must not assume every reference names a standalone req section. Preserve unresolved references rather than dropping them."

[gotcha.1992]
text = "Operational filename globs such as *publish* may also match entire generated specification snapshots; search explicit helper files when locating guard or publication code to avoid unrelated truncated output."

[gotcha.1993]
text = "bash -n accepts one script path; later path arguments are positional parameters, not additional scripts to parse. Record syntax coverage per actual invocation and use an explicit loop when checking multiple files."

[gotcha.1994]
text = "Intake scope checks must honor declared directory paths and preserve owner bytes exactly, including missing trailing newlines. Legacy cg rendering can overwrite newly qualified workflow adapters; compare source blobs before publication and retain canonical generated pointers."

[gotcha.1995]
summary = "Normalize appended spec EOF before staged whitespace checks; do not launch dependent publication after a failed check."

[gotcha.1996]
text = "A source-only diff reader cannot discard everything after the first cfg(test): test modules can appear before production functions, and inserted test blocks can make unchanged production definitions look deleted. Inspect actual Git diff hunks and surrounding definitions before drawing source conclusions."

[gotcha.1997]
area = "paxd native builds"
symptom = "go build -o reuses an existing paxd binary after only its native archives change; make -n stops at the native archives missing error on a fresh checkout."
cause = "Go's link action ID ignores the contents of -l native archives; chain.mk:90 refuses to compute their digest until both archives exist, including during make -n."
do = "Build paxd-native-libs before a dry run and stamp NativeArchiveDigest into the link flags so native archive changes force relinking."

[gotcha.1998]
area = "spec task symbols"
symptom = "cg spec done refuses with symbol ... not defined in the graph although verify_cmd passed."
cause = "The graph check resolves only indexed code identifiers (functions, types, constants, Type::method). Test descriptions with spaces, Elixir Mod.fun/arity references, Make targets and document headings are never indexed."
do = "List only code identifiers under symbols; name tests under tests."

[gotcha.1999]
area = "spec gate strings"
symptom = "A verify_cmd that nests an escaped double quote fails in sh with colon not found and backticks executing."
cause = "Escaped double quotes inside a kvx gate string reach the shell with their backslashes intact."
do = "Use single quotes inside build_cmd and verify_cmd; never nest double quotes."

[gotcha.2000]
area = "layerx-agentd lib tests"
symptom = "Two tls_boundary tests panic with build the real Paxeer TLS boundary first under cargo test -p layerx-agentd --lib."
cause = "tls_boundary.rs:187 spawns the layerx-paxeer-boundary binary from LAYERX_PAXEER_BOUNDARY_BIN or services/platform/target/debug."
do = "Gates that run the agentd lib suite build -p layerx-platform-paxeer-boundary first and export LAYERX_PAXEER_BOUNDARY_BIN, as task 9.1.7 does."

[gotcha.2001]
area = "main gates"
symptom = "Tasks fail their build or verify on code they did not touch: apps/perps tsc (esbuild types), apps/wallet typecheck (Balances.account), publish-images.test.sh, explorer backend warnings-as-errors (ReceiptController routes), layerx-ai-evaluator (ReadProof.batch_id), the agentd custody fixture."
cause = "Six cross-component changes landed on main without their dependents; tracked as issues #1052-#1057."
do = "Tasks on those gates require 18.1052.1-18.1057.1; record a new instance as an issue plus a task instead of fixing it inside an unrelated task."

[gotcha.2002]
area = "explorer test gates"
symptom = "mix-in-builder.sh test reports FATAL 3D000 database explorer_test does not exist and runs no test."
cause = "The test path was given relative to the repository root (services/explorer/backend/apps/...) while the builder resolves paths from the backend directory and only sets up the database for paths it recognises (apps/*, test/*, *_test.exs)."
do = "Write explorer test paths as apps/<app>/test/... in build_cmd and verify_cmd."

[gotcha.2003]
area = "explorer compile warnings"
symptom = "Only tests under apps/ethereum_jsonrpc fail with Compilation failed due to warnings while block_scout_web and explorer tests run with the same warnings."
cause = "apps/ethereum_jsonrpc/mix.exs:52 aliases compile to compile --warnings-as-errors in every environment, so a stale router reference in block_scout_web (issue #1055) fails that app's tests."
do = "Tasks whose gate runs apps/ethereum_jsonrpc tests require 18.1055.1 until the router is clean."

[gotcha.2004]
area = "paxeer-x attestation"
symptom = "program_market_attestation.py --begin-build exits because PAXEER_X_BUILDER_ID is unset."
cause = "begin_build() (tools/qualification/paxeer-x/program_market_attestation.py:178) requires the variable and --build (:205) re-checks the manifest builder against it."
do = "Export PAXEER_X_BUILDER_ID=$(hostname) for the whole gate; it is recorded as the builder identity only."

[gotcha.2005]
area = "launchpad stats-workers tests"
symptom = "stats-workers tests cannot connect: STATS_TEST_POSTGRES_DSN names a server, not a database."
cause = "internaltest.NewPostgres (services/launchpad/stats-workers/internal/internaltest/containers.go:44) creates a throwaway database on the server the DSN names, so the role needs CREATEDB."
do = "Point *_TEST_POSTGRES_DSN at a server whose role may create databases."

[gotcha.2006]
area = "agent daemon dependents"
symptom = "cargo build of layerx-human-service, layerx-human-test-support, layerx-explorer-index, layerx-mcp, layerx-platform-cli, layerx-agentd-host and the human providers fails at main with E0560 on ReadRequest and HistorySelector."
cause = "71550012a reshaped layerx-agent-api; the callers in layerx-agentd (agent_rpc_adapters.rs, human_runtime.rs, export.rs, read/proof_bundle.rs) were not ported and these crates depend on layerx-agentd. layerx-intents, layerx-human-kms, layerx-platform-authority and layerx-platform-agent-boundary fail only under cargo test (dev-dependency)."
do = "Tasks whose gate compiles one of those crates require 9.1.8; never patch the daemon callers inside a dependent task."

[gotcha.2007]
area = "code graph symbols"
symptom = "cg spec done reports a Rust method as not defined in the graph although it exists, when its impl header elides a lifetime (impl Foo<'_>)."
cause = "At f93cce7 the graph records such an impl under the name _ (ast_systems.c:510-516 takes the name leaf of the generic type), so Type::method cannot find its container."
do = "Name the symbol bare, or write the impl header with a named lifetime, until the graph fix lands."

[gotcha.2008]
area = "code graph symbols"
symptom = "cg spec done reports Type::method as not defined in the graph when a type and method with the same names exist in two crates."
cause = "qualified_path_score (spec.c:3787-3862) refuses a tie at the best score instead of preferring the task's touched files."
do = "Use a symbol that is unique in the repository, or the bare method name when it is unique, until the graph fix lands."

[gotcha.2009]
area = "code graph symbols"
symptom = "Every Elixir symbol of an explorer task fails cg spec done with not defined in the graph even when verify passes."
cause = "cg at f93cce7 has no Elixir extractor (lang.c:146-182 lists no .ex or .exs), so no Elixir module or function is in the graph."
do = "Elixir tasks cannot carry graph-checked symbols until an extractor exists; keep the identifiers in the do steps and tests."

[gotcha.2010]
area = "programs module"
symptom = "Programs registerAccount, setExitRoute, deprecate and transfer calls fail with LXP_ERR_MODULE_DISABLED (-103) on the hosted kernel while sandbox and storage-retirement activities pass."
cause = "lxp_kernel.c:6757-6762 and :4985-4988 gate LX_PROGRAMS_ACCOUNT and LX_PROGRAMS_WIND_DOWN on kernel->observe_commit, whose only installer lost its caller when 1.15.1 made the state feed optional."
do = "Tasks that exercise those activities require 18.1073.1; do not map -103 onto an expected error."

[gotcha.2011]
area = "custody fixture"
symptom = "Four layerx-agentd lib tests fail with Decode(MalformedPayload) or Activity on tests/fixtures/custody/daemon-light-credit-receipt."
cause = "modules/layerxledger/types/payload_transfer.go:84-85 appends network id and protocol version to every send payload since 0991c9602; the fixture from 5ff0d17cd predates that layout and decode_activity_send demands the suffix."
do = "Re-capture the fixture from the current encoder; never relax the decoder's suffix check."

[gotcha.2012]
area = "cargo lock"
symptom = "Every --locked cargo command in services/platform exits 101 'the lock file needs to be updated' although no manifest changed in the task."
cause = "eb194b27c removed layerx-paxeer-client and layerx-intents from two ramp manifests without running cargo update, so Cargo.lock still lists them under those packages; removing a dependency changes the lock as much as adding one."
do = "Run cargo update --workspace in the same change as any manifest dependency removal and commit the lock; 18.1083.1 repairs the platform lock."

[gotcha.2013]
area = "node --test"
symptom = "A script-style test file reports every registered test ok and then fails with 'A resource generated asynchronous activity after the test ended' and no line number."
cause = "Top-level assertions after an await run once the registered tests have finished; node --test attributes the throw to the file, not the line."
do = "Run the compiled file directly with node and an uncaughtException handler that prints the stack to find the failing top-level line; keep the whole-file gate."

[gotcha.2014]
area = "system docs generator"
symptom = "tools/docs/gen-system-docs.sh exits 'rpc: cannot resolve service sequencerReceiptAPI'."
cause = "gen_system_docs.py:67 CTOR and :81 match only New\w+ constructors while rpc/server.go:199 builds the service with newSequencerReceiptAPI."
do = "Widen both patterns to [Nn]ew\w+ (18.1071.1); do not hand-edit docs/system pages."

[gotcha.2015]
area = "search-front bring-up test"
symptom = "search-front.test.sh fails config_exit with JSONDecodeError on empty output, config_matches_template and config_refuses_unset."
cause = "Since 288a967c2 the x-websearch config example renders receipt_keys and payment.payer_address from X_WEBSEARCH_RECEIPT_KEY_ID, X_WEBSEARCH_RECEIPT_PUBLIC_KEY and X_WEBSEARCH_PAYER_ADDRESS and has no note key; fixture_env predates both."
do = "Set the three variables in fixture_env and assert only that the rendered config has no note key (18.1070.1)."

[gotcha.2016]
area = "spec acceptance contracts"
symptom = "An acceptance cites a contract anchor that does not exist (contracts/sequencer.md#receipt-key-pin-and-rotation) or a section unrelated to the task (contracts/agent-ts-sdk.md#history for a Rust receipt-vector proof)."
cause = "Contract strings were copied from a sibling acceptance of the same owner instead of the section heading; sequencer.md anchors the section as <a id='receipt-key-pin'>."
do = "Resolve the anchor against the contract file (<a id> or heading) before writing it and cite the section that defines the behaviour under test (18.997.1, 18.1088.1)."

[gotcha.2017]
area = "bring-up test harness"
symptom = "tools/bringup/check-live.test.sh reports no stand-in case after check_live_kernel_app_volumeless and prints a kernel-readiness evidence line with exit_code 1."
cause = "The real kernel-node stage at :1471 needs root, unshare and the PAXEER_X_RUNTIME_* artifact variables and exits the harness when they are absent, so the cases after :1520 never run (#1100)."
do = "Run the harness where the kernel artifacts exist, or move the stage after the stand-in cases (18.776.1 do_5); never give the readiness script a fallback."

[gotcha.2018]
area = "explorer test wrapper"
symptom = "mix-in-builder.sh test with paths from two umbrella apps fails 'Background migrations failed' (DBConnection.OwnershipError) in the second app's test helper."
cause = "One sidecar database serves one mix test run; the second app's test helper re-runs the background migrations against the already-migrated database (#1098)."
do = "Run the wrapper once per app until 18.1098.1 lands; never put paths of two apps in one invocation."

[gotcha.2019]
area = "paxeer-x attestation gate"
symptom = "program_market_attestation.py --begin-build exits 'producer source closure is dirty or contains untracked inputs' although git status shows only the task's own edits."
cause = "source_identity() (:147) runs git status over SOURCE_PATHS and treats any modified tracked file, including the implementation under qualification, as a dirty closure."
do = "Commit the implementation so HEAD carries it before running the attestation build or verify; the gate accepts only a clean tree at HEAD."

[gotcha.2020]
area = "cg spec done symbol resolution"
symptom = "cg spec done reports a declared symbol as 'not defined in the graph' although the identifier exists: a type reached through a use alias, a nested module path, or an Elixir module function."
cause = "The resolver before hyperfide 4f3a3094b matched only bare top-level identifiers; aliases, nested paths and Elixir modules were never looked up."
do = "Use cg built from hyperfide 4f3a3094b or later (branch cg/spec-symbol-resolver-2026-10-28); keep task symbols as code identifiers (GOTCHA 1998) and re-run the done gate on the unchanged candidate."

[gotcha.2021]
area = "docker build context"
symptom = "make programs-release-build inside docker/paxeer/Dockerfile.paxd-node or docker/layerx/Dockerfile fails 'failed to calculate checksum of: /src/programs/vendor/ed25519-dalek-2.2.0/tests/examples/pubkey.der'."
cause = "The programs/vendor/**/*.der rule (docker/layerx/Dockerfile.dockerignore:161, docker/paxeer/Dockerfile.paxd-node.dockerignore:72) drops the public .der files of every vendored crate, both the checksummed test fixtures and the files ring, rustls-pki-types and rustls-webpki compile in with include_bytes!."
do = "Re-include every public .der file of vendored crates in the programs build graph, file by file, after the programs/vendor/**/*.der rule, as docker/layerx/Dockerfile.dockerignore:173-284 and docker/paxeer/Dockerfile.paxd-node.dockerignore:84-195 do (der, ed25519, ed25519-dalek, elliptic-curve, openssl, pkcs8, ring, rustls-pki-types, rustls-webpki, sec1, spki); never edit a vendored .cargo-checksum.json and never re-include .der files outside programs/vendor (18.849.1, 18.869.1)."

[gotcha.2022]
area = "wallet gateway e2e environment"
symptom = "gateway.e2e.test.ts dies in startPostgres with '[env] Invalid environment configuration' naming WALLET_IDENTITY_BINDING_PRIVATE_KEY_FILE, WALLET_IDENTITY_BINDING_TENANT, WALLET_CUSTODY_INVENTORY_FILE and WALLET_CUSTODY_INVENTORY_PUBLIC_KEY_FILE."
cause = "src/env.ts:258-261 requires the four wallet identity and custody inventory inputs whenever ATTESTOR_ENDPOINTS is set (since 281e812be); the e2e harness sets the attestor endpoints but not them."
do = "Set the four variables from the attestor harness before any import of src/env.ts, with the tenant equal to the attestors' ATTESTOR_AUTHORITY_TENANT and the inventory JWT tenant (18.1065.1)."

[gotcha.2023]
area = "paxeer-x qualification drivers"
symptom = "program_market_attestation.py --build reports BUILD_RESULT native 1 with 'layerx/programs.h: No such file or directory'."
cause = "The driver defaults --cppflags to the empty string, so the native test compiles with a bare cc; every tests/programs file includes 'layerx/...' relative to include/."
do = "Pass or default --cppflags -Iinclude (arbiter_prestate.py:355 does); do not rewrite the includes in the test (18.911.1, issue #1105)."

[gotcha.2024]
area = "shell test harness stand-in processes"
symptom = "A harness that copies sleep under a daemon name reports process=none; stderr shows 'coreutils: unknown program <name>'."
cause = "Where coreutils is a multicall binary (uutils, busybox) the copy dispatches on its own file name and refuses to run."
do = "Copy a standalone interpreter (command -v bash) under the daemon name and start it with -c 'sleep N' and no exec; /proc/<pid>/exe and environ then still belong to the named copy (check-live.test.sh, 18.776.1)."

[gotcha.2025]
area = "explorer read-only archive schemas"
symptom = "Explorer tests fail with 'function Explorer.Chain.PaxeerX.Anchor.changeset/2 is undefined or private' (same for Receipt)."
cause = "b14589838 made Anchor and Receipt read-only archive records without changesets; archive_readonly_test.exs guards that."
do = "Seed rows in tests with Ecto.Changeset.cast(%Anchor{}, attrs, Map.keys(attrs)) |> Repo.insert!() or through the import runner; never add the changeset back (18.1010.1, 18.1006.1, 18.1104.1)."

[gotcha.2026]
area = "explorer migrations"
symptom = "Postgrex raises DBConnection.EncodeError when a migration binds a generated index name as a name parameter."
cause = "Postgres identifiers hold 63 bytes; Ecto's default index name for several columns with directions exceeds that and the name type refuses it."
do = "Select indexes by i.indexrelid::regclass::text (and NOT i.indisvalid) or name the index explicitly under 63 bytes (18.875.1)."

[gotcha.2027]
area = "programs precompile call fee"
symptom = "A call with a fee limit below the fee reverts LXP_UNAUTHORIZED_DEBIT, not LXP_NON_CANONICAL."
cause = "Under occupancy protocol versions call.c:2620-2622 runs lxp_programs_occupancy_bind_call, which refuses at occupancy.c:318-319 before the call runtime's check at ffi_call.rs:2909-2910."
do = "Expect LXP_ERR_UNAUTHORIZED_DEBIT for the occupancy path; the NON_CANONICAL check is reached only with occupancy off (13.24.1)."

[gotcha.2028]
area = "programs account register"
symptom = "A second identical registerAccount does not revert."
cause = "lxp_programs_account_register answers LXP_OK with created=false for an identical binding (accounts.c:961-976); another asset under the same seed is LXP_ERR_ASSET_MISMATCH."
do = "Test the idempotent read-back and the asset-mismatch refusal; accounts.c:530 is a lookup and refuses nothing (13.25.2)."

[gotcha.2029]
area = "paxeer-x qualification drivers"
symptom = "program_market_attestation.py exits 1 with 'PAXEER_X_EVIDENCE_DIR is required' after both build stages pass."
cause = "The attestation run writes under a caller-owned 0700 directory that must lie outside the checkout (evidence_directory at :276-285); the build modes do not need it."
do = "Prefix the run with d=$(mktemp -d) && PAXEER_X_EVIDENCE_DIR=$d (18.911.1)."

[gotcha.2030]
area = "wallet gateway custody inventory"
symptom = "Provisioning answers 503 custody_inventory_pending although every WALLET_* variable is set."
cause = "requireInventoryKey(keyId, 'generate', owner) needs an inventory entry for wallet:<userId>:standard:secp256k1:0 with public_key '', epoch 0 and operations ['generate']; review and sign later need the entry republished with the generated public key and 'sign', at a higher sequence."
do = "Have the test write the generation admission before provisioning and republish the key after it (18.1065.1)."

[gotcha.2031]
area = "node merge gate tests"
symptom = "A test cannot require the NewTestWrapper app's version map to lack layerxagent."
cause = "node/app.go:313 registers layerxagent in every test app."
do = "Rewrite the map with a.UpgradeKeeper.SetModuleVersionMap before the assertions, as node/upgrades_test.go:240 does (18.944.1)."

[gotcha.2032]
area = "layerx-crypto disclosure"
symptom = "bind answers MalformedPayload for every real custody credit (Bridge activity 1), including the recorded fixture."
cause = "disclosure.rs decoded Bridge/1 as a 0x4801 seven-field payload of at most 512 bytes that nothing produces; the kernel, custodyproof/light.go and the daemon reader define the credit as a 363-byte LXDC3 head plus an LXLB1 bundle."
do = "LXDC3 is canonical (ruling 2026-10-28, issue #1111); task 18.1111.1 teaches the crate to disclose it. Never re-capture the custody fixture to fit a decoder."

[gotcha.2033]
area = "explorer paxeer_x controller tests"
symptom = "Status and signature controller routes answer 404 for a receipt the app-level tests verify."
cause = "Since 584ad3c41 receipt_keys/1 accepts only a map whose keys entry holds the list; a Bypass server answering px_getReceiptKeys with a bare list is malformed and both controllers turn that into 404."
do = "Serve the keyed answer in controller tests and keep one bare-list case asserting 404 (issue #1112, 18.1089.1)."

[gotcha.2034]
area = "wallet gateway precompiles"
symptom = "An address-book test expects orob, clearing, pofq, teeAttestor and eip712 to be unserved."
cause = "9aef930a7 reduced UNSERVED_PRECOMPILES to oracle, scheduler and streams."
do = "Compute expectations from the exported set, never from a hand-written list (18.801.1, 18.804.1)."

[gotcha.2035]
area = "paxeer-x market attestation driver"
symptom = "The driver reports every native case missing and the gate record holds no reason."
cause = "The driver counts only lines starting with {'case': in native.log under PAXEER_X_EVIDENCE_DIR; the C test prints through a fully buffered stdout, so an early return before native-deploy or a crash before exit leaves no line, and a temporary evidence directory is discarded with the run."
do = "Print native.log on gate failure and make stdout line-buffered in main (18.911.1 do_7)."

[gotcha.2036]
area = "wallet gateway provisioning"
symptom = "Provisioning answers 503 sponsor_unconfigured for a fresh account although a sponsor key file is configured."
cause = "5f5f66995 retired SPONSOR_PRIVATE_KEY_FILE and provisionDepsFromEnv sets sponsor null; the top-up step at provision/state.ts:510-523 still needs one, and gateway.e2e.test.ts:161 asserts the top-up came from the sponsor."
do = "Do not restore the key or drop the assertion inside a test task; issue #1113 holds the owner's decision (18.1065.1 waits)."

[gotcha.2037]
area = "node upgrade keeper tests"
symptom = "GetModuleVersionMap still lists a module after it was deleted from the map and SetModuleVersionMap was called."
cause = "SetModuleVersionMap stores the entries it receives and removes none; a Delete on ctx.KVStore(a.GetKey(upgradetypes.StoreKey)) does not reach the keeper's store service."
do = "Remove the entry through the keeper's store service or test on an app built without the module (18.944.1)."

[gotcha.2038]
area = "spec gates"
symptom = "A task whose build_cmd runs cargo build -p <crate> --tests fails on a test target it never touches (layerx-crypto tests/disclosure_call.rs, E0277 at main)."
cause = "--tests compiles every test target of the crate, so one stale target outside the task's touches turns the task's build step red."
do = "Name the targets the task owns (--lib --test <name>); give the stale target its own task and let crate-wide builds require it."

[gotcha.2039]
area = "image contexts"
symptom = "docker build fails in the native stage with 'failed to calculate checksum of /src/programs/vendor/<crate>/<file>' for a file that is tracked and present on disk."
cause = "A suffix-based secret exclusion (programs/vendor/**/*.der, *.pem, *.crt, *.p12, *.key) drops fixtures that the crate's .cargo-checksum.json lists, and cargo verifies vendored sources against that manifest."
do = "Keep the exclusions; re-include the checksum-listed files by explicit path after the block (the last matching line decides) and test both directions against the manifests."


[gotcha.2040]
area = "spec tasks"
symptom = "A migration task worded as 'change only import paths and call names' fails on every attempt with unresolved paths or invented modules."
cause = "The source uses an API family with no counterpart in the target module (LNI FrameTransport, read::ReadContext, evidence verifiers, batch::lookup -> SignedBatchHeader versus layerx_client::rpc), so no rename satisfies the step."
do = "Before writing a rename task, check that every called item has a same-shaped twin in the target; otherwise specify a real port, a deletion, or supersede the task by the one that deletes the file."

[gotcha.2041]
area = "agent evidence"
symptom = "A custody evidence authenticator answers Activity for a well-formed record while the same activity decodes with an explicit registry in a test."
cause = "The daemon derived the activity ordinal from receipt.operation(), the ledger operation byte of lxp_receipt (0 for module receipts), so ActivityType::new rejected it as ZeroOrdinal."
do = "Take the activity kind from the activity encoding (field 3, module << 16 | ordinal) and check its module against receipt.module_id(); never treat receipt.operation as an ordinal."

[gotcha.2042]
area = "programs kernel"
symptom = "A test of the programs transfer (0x00090005) expects a Kind-2 monetary transfer effect in the receipt and finds none."
cause = "src/modules/programs/transfer.c:239-243 calls lxp_ctx_emit_transfer_set, which appends no effect (only lxp_ctx_emit_monetary_transfer_set does), then lxp_ctx_emit_event(LX_PROGRAMS_EVENT_TRANSFERRED, transfer_set_root, 32)."
do = "Read the transfer set root from the Kind-3 event with code 5 (Receipt.Events) and assert that no Kind-2 effect is present."

[gotcha.2043]
area = "evm keeper"
symptom = "A test expects a merge precompile to be withheld after the merge plan is done because one of its gate modules is missing from the version map, but the keeper serves it."
cause = "customPrecompileActivationLookup (modules/evm/keeper/keeper.go) answers true for any address whose plan is active at the height before consulting the module list; the list gates only a store where the plan was never done."
do = "Assert every gated address served at and above the done height and withheld below it; prove the module rule with no done height."

[gotcha.2044]
area = "qualification"
symptom = "A crate that could not compile for one recorded reason starts compiling after the fix and immediately fails on different errors that several done tasks introduced."
cause = "Tasks whose gates could not compile the crate were landed while it was broken (layerx-human-service after 71550012a: 10.2.1 removed rung_level, 10.2.5 added a caller, the agent API renamed the ReceiptReference::Verified field); their gates never met the merged code."
do = "When an unblocking fix lands, build the family crates once at the merged revision before its tasks start again, and keep them waiting until that build is green."

[gotcha.2045]
area = "agent sdk"
symptom = "A caller of Wallet::execute expects a VerifiedRpcReceipt and gets a 32-byte array."
cause = "Since 0a296da5e Wallet::execute submits the prepared payment and returns the activity hash; the receipt comes from Wallet::wait_for(hash, commitment, wait_timeout), which the SDK high-level methods (send, create, open_account) call themselves."
do = "After execute, call wait_for with the options commitment and wait_timeout to obtain the VerifiedRpcReceipt; do not change the caller contract to the hash."

[gotcha.2046]
area = "agent api"
symptom = "A consumer of layerx_agent_api::subscription::Cursor fails to compile with no field 0 on type Cursor."
cause = "051d11e3a (task 9.11.1) reshaped Cursor from a newtype over Sequence into { block_height: u64, tx_index: u32, log_index: u32 }; consumers outside the daemon, such as layerx-human-service src/activity/mod.rs:602 and :672, still read .0 .0."
do = "Derive the scalar a consumer stores from block_height and commit all three fields in big-endian order to any digest; the daemon's human_runtime.rs shows the pattern."

[gotcha.2047]
area = "kernel programs"
symptom = "A programs sandbox EXECUTE reverts with LXP_FATAL_INVARIANT although nothing in the kernel is broken."
cause = "src/modules/programs/sandbox.c:427 rewrites any status to LXP_FATAL_INVARIANT while the guest savepoint is active, and the Rust runtime seals the savepoint only on the success and terminal-failure paths, so every refusal between admission and the seal (host_ffi.rs admit_host, ffi_call.rs:2905) is reported as fatal (issue #1122)."
do = "Treat LXP_FATAL_INVARIANT from sandboxExecute as a masked pre-seal refusal; unmask it by instrumenting admit_host and the sandbox branch of ffi_call.rs until 18.1122.1 lands."

[gotcha.2048]
area = "programs precompile"
symptom = "A 0x101D view that is in abi.json, gas.go and LayerXPrograms.sol reverts with LXP_PRECOMPILE_UNKNOWN_METHOD."
cause = "Handlers only reach the method table through register() in an init block (submit.go:43); view_accounts.go defined getProgramAccountById, getAccountProfile and getValueAccount without one, and its tests called the handler functions directly instead of dispatching (issue #1123)."
do = "Register every handler of a new view file in its init and test it through the precompile call path (ABI pack, Submit or evm call, unpack); compare `func ...Handler(` definitions against register() calls before claiming a view is served."

[gotcha.2049]
area = "programs host"
symptom = "Every exitValue through the precompile refuses with LXP_CONTEXT_MISMATCH from lxp_ctx_ledger_execution_sequence while the same flow passes in the kernel suites."
cause = "The ledger admission binds the caller's payment account by runtime->occupancy_asset_id (lxp_kernel.c:497); kernel fixtures and snapshot nodes set that field, the host node in modules/lxphost/host.go never does, so the WIND_DOWN admission can never bind through the host (issue #1124)."
do = "When a kernel check passes in tests/ but fails through the precompile, diff the host node construction in host.go against the kernel fixture that passes; fields the fixture sets by hand are the suspects."

[gotcha.2050]
area = "kernel programs"
symptom = "Sandbox EXECUTE host admission refuses with LXP_ERR_NON_CANONICAL (seen as LXP_FATAL_INVARIANT before 18.1122.1) although lease, escrow and fee schedule are all consistent."
cause = "layerx_programs_sandbox_lifecycle_length/_byte (src/modules/programs/sandbox.c:509-530) compare the raw token with the outer sandbox pointer, while admit_host (host_ffi.rs:538) legitimately holds the inner CALL token that every other sandbox accessor resolves through sandbox_for_call (issue #1125)."
do = "Any new kernel accessor that takes a sandbox token must resolve it with sandbox_for_call so both the outer and the call token identify the active sandbox; the FUND/ACTIVATE lifecycle tests never exercise the call-token path, so add an EXECUTE-side case when touching these accessors."

[gotcha.2051]
area = "node sequencer"
symptom = "A standby refuses the group at the first replicated ledger activity that reads kernel state written by an earlier block ('replayed receipt differs from stored receipt'), while plain transfers replay fine."
cause = "node/sequencer/standby_role.go:135 installs no sequencer source, so the standby commits every block through the consensus re-execution path (node/app.go:2375-2420) while the primary commits the sealed layer it executed (node/app.go:1784-1818); the two paths can leave different kernel rows behind (issue #1126)."
do = "Treat the standby's commit path as part of the replication contract: a standby test must commit through the real path and replicate a kernel activity that depends on a prior block, as 18.1126.1 adds."

[gotcha.2052]
area = "agent api"
symptom = "A qualification's dependency check fails with E0423 in layerx-agent-api/tests/stream.rs although the task touched nothing in that crate."
cause = "The 051d11e3a Cursor reshape ported the library and its downstream callers but not the crate's own tests/stream.rs, so the crate's test target has been dead since (issue #1127)."
do = "When a pub type of a crate is reshaped, the reshaping task's gate must compile that crate's own test targets (cargo build -p <crate> --tests), not only its library."

[gotcha.2053]
area = "human service"
symptom = "record_agent_event refuses a simulated receipted delivery with UnverifiedReceipt, or a level assertion expects Level::SequencerSigned for receipted evidence."
cause = "Decision 907 and Level::rung (agent-api error.rs:153-160) map SequencerSigned to Submitted and BatchIncluded to Receipted; the human-service tests still carry the pre-2f3a411de mapping Receipted = SequencerSigned (issue #1128)."
do = "Receipted evidence is Level::BatchIncluded; a verified fixture carries VerificationLevel::BATCH_INCLUDED. Never reintroduce a Receipted-to-SequencerSigned mapping."

[gotcha.2054]
area = "agent daemon tests"
symptom = "A layerx-agentd test using tests/support/real_authority.rs panics 'build/bin/layerxd is not built' (or layerx-genesis-build)."
cause = "The real-node harness (real_authority.rs:1003-1008) needs the node binaries from build/bin (or LAYERX_TEST_NATIVE_BIN_DIR) and must run as root; a crate-only cargo build never produces them."
do = "A task whose gate drives real_authority must put 'make -C . layerxd layerx-genesis-build' in its build_cmd before the crate build."

[gotcha.2055]
area = "interop x402"
symptom = "layerx-mcp or x-websearch buyer tests fail every settlement with SettlementMismatch / EvidenceMismatch against a recorded exchange."
cause = "LayerXEvidence (layerx-x402 buyer.rs:61-74) is deny_unknown_fields and requires logs; the recorded tests/fixtures/client-exchange.json predates that shape and carries no logs or sequencer id (issue #1129)."
do = "When the buyer evidence shape changes, re-record client-exchange.json with X_WEBSEARCH_RECORD_EXCHANGE (payment.rs:3082, :3214) and publish the sequencer id, public key and batch window in gateway/buyer.json in the same change."

[gotcha.2056]
area = "programs host"
symptom = "A programs deploy or call through the precompile harness or an lxphost test chain is refused LXP_ERR_VERSION_UNSUPPORTED before the activity runs."
cause = "Since e1c81cc5a (#1124) modules/lxphost/host.go:545-558 resolves the fee schedule's occupancy asset for every programs activity and refuses when the store carries no progfee/active/v1 record; the kernel's own path (lxp_kernel.c:393) tolerates the absence, so fixtures written before never seeded one (issue #1130)."
do = "Every fixture that executes a programs activity seeds a version-1 LXFR1 record at progfee/active/v1 and progfee/history/v1/1 (shape: method_call_test.go:103-114). A host-side rule change must run the precompile and lxphost program suites once at the merged revision."

[gotcha.2057]
area = "programs transfer"
symptom = "A 0x101D transfer leg whose source is a program account reverts LXP_AUTH_SCOPE whoever calls it."
cause = "transfer.c:41-54 principal_authorizes_from admits only the principal's own id or an agent account whose owner DID is the principal (lx_account_read.c:11-13); program accounts are neither."
do = "Do not write tests that debit program accounts through the transfer method until req.13292 ac_2 is ruled; fund program accounts from the caller's accounts and move program value through program-executed paths."

[gotcha.2058]
area = "agent daemon tests"
symptom = "Every layerx-agentd integration test target and every layerx-human-service test target fails to compile with E0432 unresolved import layerx_agentd::boot::handshake_gate."
cause = "70ce262d3 (9.12.2) replaced the LNI handshake gate with Gate::readiness_gate(&NodeRpc) (eth_chainId + px_getReceiptKeys) and ported only its own tests; the shared test support of both workspaces and the pay2 harness still import the old function (issue #1131)."
do = "Readiness in fixtures comes from a local JSON-RPC responder (tests/handshake_gate.rs:36-88 pattern) plus gate.readiness_gate; LNI status and capability assertions use layerx_client::lni::handshake::perform directly. A task that removes or renames a pub fn compiles every dependent test target (cargo test -p <crate> --no-run for each workspace that imports it) inside its gate."

[gotcha.2059]
area = "interop x402 fixtures"
symptom = "After re-recording client-exchange.json most x-websearch payment tests fail with grant_payer_mismatch, receipt_mismatch or invalid_payment_payload."
cause = "The recorder's sequencer metadata (sequencerId, firstBatchNumber, lastBatchNumber in gateway/buyer.json) was fed into configure_with as the server's accepted receipt-key window, narrowing it to one batch."
do = "The server fixture keeps key_id hex(&receipt_key_id()), first_height 0, last_height u64::MAX; buyer.json metadata builds only the buyer-side SequencerAuthorization in tests."

[gotcha.2060]
area = "task graph"
symptom = "Two tasks on one crate required each other and neither could build: the crate's lib fix needed the test-support crate to compile its tests, and the test-support port's gate built every test target of the crate (18.1119.1 and 18.1132.1)."
cause = "cargo build -p <crate> --tests compiles every integration test target, so a gate on the whole crate cannot pass while any one test target is broken by another task."
do = "Put a test-support port in the touches of the task that fixes the crate, and gate a follow-up test task on its single --test target; never let two pending tasks require each other."

[gotcha.2061]
area = "agent test support"
symptom = "Every layerx-agentd test target fails to build with E0560 on StartupConfig fields expected_protocol_version and sequencer_authority_source."
cause = "5609ec802 (9.12.3) replaced those fields with expected_chain_id and receipt_key_source and ported only src and its own tests; tests/support/mod.rs:431-446 still builds the old literal."
do = "A task that changes a pub struct compiles cargo build -p <crate> --tests in its gate; until then, port tests/support/mod.rs in the task that first needs the test targets (18.1131.1)."

[gotcha.2062]
area = "agent native routes"
symptom = "native_routes_rpc.rs panics with MissingVariable(LAYERX_AGENT_NODE_RPC_URL) in an isolated qualification run."
cause = "The planned test reads a live node URL and a real receipt hash from the environment instead of serving a local responder."
do = "Planned agent tests serve their own 127.0.0.1 JSON-RPC responder (tests/handshake_gate.rs:36-88) and sign their own fixtures; no gate reads a live node from the environment."

[gotcha.2063]
area = "x402 evidence"
symptom = "The x-websearch payment suite fails 22 of 35 tests at main with EvidenceMismatch and SettlementMismatch whatever the recorded fixtures contain."
cause = "layerx-x402 buyer.rs:403 unhex requires a 0x prefix while model.rs:322-335 validates bare 64-hex assets, and seller.rs:353-357 emits evidence without the logs LayerXEvidence requires (issue #1133)."
do = "Fix the crate (18.1133.1) before re-recording any exchange; a fixture re-recording cannot pass while the buyer refuses the seller's own format."

[gotcha.2064]
area = "container images"
symptom = "docker build of docker/layerx/Dockerfile fails in the builder stage with curl 502 on every retry, whatever the Dockerfile change under test."
cause = "The stage downloads three libwasmvm libraries from an external host that is down (issue #1106) although the same libraries, with matching pinned digests, are in the tree and docker/paxeer/Dockerfile.paxd-node already copies them from the context."
do = "Never fetch at image build time what the checkout carries; copy from the context and verify against the pinned digest file. A gate that reaches an external host is blocked by that host, so file the host as an issue and gate the image tasks on the context fix."

[gotcha.2065]
area = "gateway e2e"
symptom = "Every test of test/e2e/gateway.e2e.test.ts fails in beforeAll with 503 sponsor_unconfigured at the provisioning call."
cause = "5f5f66995 retired the gateway sponsor key (decision.1206) and the fixture still writes SPONSOR_PRIVATE_KEY_FILE, a variable nothing reads; the top-up branch stays until 12.6.3 replaces it with the station-sponsored bind."
do = "When a task retires an input, grep the test fixtures for the variable in the same task; an e2e that provisions needs the replacement path on main, so gate it on that task instead of relaunching."

[gotcha.2066]
area = "kernel host"
symptom = "With a programs fee record seeded, consecutive receipts stop linking (ResultingStateRoot != next PreviousStateRoot) although two identical runs give identical hashes."
cause = "The host loaded two keys of a module it did not load in full; the kernel computes a module's subtree root from the entries loaded into it, so a partially loaded module has a different root than the fully loaded one the next activity sees."
do = "A module is either fully loaded or not loaded for an activity; never load stray keys of another module into the kernel branch. When a fixture change makes a continuity assertion fail, suspect the loaded set before suspecting nondeterminism."

[gotcha.2067]
area = "task gates"
symptom = "The build fails with ERR_PNPM_OTHER_PM_EXPECTED or a wall of type errors that the task never touched."
cause = "The gate used a package manager the app does not pin (apps/explorer pins yarn, apps/bridge pins pnpm), or gated on a type-check that already fails at main."
do = "Copy the gate prefix from a done task of the same app, and before gating a task on an app's type-check confirm that the check passes at main; if it does not, cut the repair task first and make the others require it."

[gotcha.2068]
area = "spec tasks"
symptom = "cg spec done fails with 'symbol <name> not defined in the graph' after build and tests passed."
cause = "The task's symbols list named a shell script, a file or a test title; the done check resolves every symbol against the code graph, which indexes functions and types only."
do = "Put only graph identifiers (functions, types, methods) in symbols; use [] for shell-only or test-only tasks and name tests in the tests key."

[gotcha.2069]
area = "task gates"
symptom = "A type-check that passes for every other task of the same app fails with hundreds of errors in files the task never touched, or with missing workspace modules."
cause = "Each app resolves dependencies through its own manager (apps/explorer yarn, apps/bridge pnpm, apps/web npm, the wallet gateway pnpm) and apps/explorer generates its Chakra recipe types in a postinstall step that a reinstall without scripts loses."
do = "Copy the gate prefix from a done task of the same app; never reinstall dependencies inside an attempt; for apps/explorer run yarn chakra:typegen before tsc when node_modules changed."

[gotcha.2070]
title = "x-websearch payment harness: the payer address and the grant issuer must derive the same ledger account"
detail = "tests/payment.rs offers an EVM payer address and answers accountId for it from payer_account_rules, but the recorder issued grants and receipts from the ed25519 payer DID's account, so every metered step returned grant_payer_mismatch and re-recording was impossible. When the harness payer changes form, every issuer of recorded grants and receipts changes with it, and the recorder regenerates all gateway recordings together."

[gotcha.2071]
title = "go.sum can lack a go.mod hash that only read-only module mode notices"
detail = "GOFLAGS=-mod=mod builds (the sandboxed gates) add missing go.sum lines silently; the chain image's builder stage runs read-only and fails on the missing golang.org/x/net go.mod hash the replaced keyring still pulls in. Gate a go.sum repair with GOFLAGS=-mod=readonly."

[gotcha.2072]
title = "A task that adds fields to one struct must not pre-empt the dependent task that adds them to the next"
detail = "10.2.7 adds receipt fields to ReceiptMaterial; its consumers copy into ProtocolEvidence, which gains the fields only in 10.13.1 (requires 10.2.7). The first task keeps the existing fields and consumers and adds beside them; the dependent task moves the consumers. Do-lines that say 'switch the consumers to the new fields' in the earlier task cannot compile."

[gotcha.2073]
title = "Field renames and type reshapes leave sibling test files behind; build the crate's --tests before marking done"
detail = "10.13.7 renamed ReclaimAgentContext.account_sequence to nonce and added tests/reclaim_nonces.rs while tests/reclaim.rs kept the old field (#1142); 9.11.1 reshaped the event Cursor and left four layerx-agentd test files on the tuple form (#1143). Each gate ran only its own new test target. A rename or reshape task's build must be cargo build -p <crate> --tests."

[gotcha.2074]
title = "A done task whose test passes can still leave its second step unimplemented"
detail = "18.1126.1 added a replay mutex and a test but not the sealed-layer source it named; the in-process test could not reproduce the divergence that the committed-fixture recorder hits at the first prior-block kernel read (#1144). When a do-line names a structural change, the acceptance test must fail without it."

[gotcha.2075]
title = "A spec edit that leaves a key without a value stops every task start while the dependency validator still passes"
detail = "Four task blocks carried bare max_builds, stop_condition, path_policy and evidence_policy lines; cg spec start refused every task with 'cannot parse spec.kvx' for twenty minutes while plan validation passed. Lint every line of spec.kvx for key = value form, and each task block for exactly one of every bounded-gate key, before committing a spec edit."

[gotcha.2076]
title = "A test module included by #[path] compiles inside the including crate, so its dependencies must be declared there too"
detail = "layerx-human-kms tests/support/attestor_cluster.rs gained ureq calls (6a5587897); layerx-human-service's wallet_identity_e2e includes it by #[path] and declares no ureq dev-dependency, so that target no longer builds (#1147). When a shared test support module gains a crate, add it to every crate that includes the module and record the lock edge."

[gotcha.2077]
title = "symbols must name only what the task defines, uniquely within the indexed workspace"
detail = "cg spec done resolves every symbols entry after the gate passes: Operation::retired matched two definitions (api-gen lib.rs:33 and the service) and Rung lives in another crate the index does not resolve from the task's crate; 10.0.2 attempt 5 and 10.2.2 attempt 7 lost a passed gate to it. Leave shared method names and foreign types out of symbols."

[gotcha.2078]
title = "Two repairs inside one crate's test targets must not both build --tests"
detail = "18.1143.1 (four agentd test files' cursor fixtures) built -p layerx-agentd --tests, which also compiles the seventeen targets whose shared support module 18.1131.1 is porting, while 18.1131.1 requires 18.1143.1; neither could pass. A repair task builds only the test targets it touches; the task that owns the shared module is the one that builds --tests."

[gotcha.2079]
title = "A task gate must not name a test whose fixture a dependent task repairs"
detail = "18.1135.1's verify_cmd ran TestResolutionExecuteEntry, which fails at main until 18.1130.1 seeds the fee record, and 18.1130.1 requires 18.1135.1: neither could pass and 641 pending tasks sat behind the pair. A task's gate names the tests it adds or whose fixtures it owns; a test another task repairs belongs to that task's gate."

[gotcha.2080]
title = "A core backfill restores only chain-positioned durable events"
detail = "Since 646c4f96c apply_backfill matches each RecoveredEvent position against durable events decoded as Ethereum logs; local-only stream events (approval emissions) have no log, so position() is None and the backfill returns GapError::DurableEvent. Restore-after-gap fixtures must ingest a positioned chain log as tests/gaps.rs:349-392 does. 18.1143.1's gate kept running the stale approval_events fixture; narrowed, repaired by 18.1150.1."


[gotcha.2081]
title = "Attestor cluster fixtures pass only the asset send type"
detail = "Since eec0db612 the attestor daemon admits ATTESTOR_ACTIVITY_TYPES equal to 0x10005 alone and 027b07111 refuses a wider list at startup. wallet_identity_e2e flattened its whole module registry (governance 0x70004, bridge 0x80001) into the cluster env and both nodes exited before signing. Pass the asset send alone; the registry stays the service's own. 18.1147.1's gate narrowed to the attestor-independent test; repaired by 18.1151.1."

[gotcha.2082]
title = "Mutually dependent deletions are one task"
detail = "layerx-intents vocabulary.rs variants wrap crate::precompile types and precompile.rs constructs those variants; deleting either side alone (10.21.1 attempts 1-2) fails the crate build. When two files reference each other, their deletions belong to one task with both paths in touches."


[gotcha.2083]
title = "Raising the go directive outruns an installed older Go under GOTOOLCHAIN=local"
detail = "09f9d9239 raised go.mod to go 1.25.8; every go command on an installed go1.25.6 with GOTOOLCHAIN=local refuses with 'go.mod requires go >= 1.25.8'. A gate that runs go must allow GOTOOLCHAIN=go<pin> (or install the pinned release) before any go command; the error is the toolchain, not the task."


[gotcha.2084]
title = "go mod download needs a go.mod hash for every version in the module graph"
detail = "go mod download (and go list -m all) read the go.mod of every module version in the graph and refuse any whose /go.mod hash is missing from go.sum, even versions that provide no package to the build (golang.org/x/net for #1141, golang.org/x/term v0.15.0 for #1152). go build alone never notices; add the lines with go mod download <module>@<version>."

[gotcha.2085]
title = "go list -m all reports one missing go.sum hash at a time"
detail = "Read-only module mode stops at the first module version whose /go.mod hash is absent from go.sum; after adding it the next gap appears (x/term v0.15.0, then x/net 20211112 in the chain repository). Iterate go mod download <module>@<version> until go list -m all exits 0 before declaring the graph complete."


[gotcha.2086]
title = "An all-targets daemon test build compiles every stale test file"
detail = "cargo build -p layerx-agentd --tests and cargo test --no-run compile tests/checkpoint.rs, which still built the pre-9.5.5 ProofBundleRequest after 2666a01d5; a task whose gate needs the all-targets build (#1131) fails on a test file it does not own. Open the test port as its own task and gate on it."

[gotcha.2087]
title = "A single-target gate still compiles every stale builder in its own file"
detail = "85c5b32c5 (10.2.7) added tx_hash, receipt_hash, block_height and rung to ReceiptMaterial and ported the crate's sources and intent_submit.rs, but wallet_identity_e2e.rs was not in its gate; the next task touching that file (#1151) failed its build on the builder it did not change. When a task's touched file has other initializers of a reshaped type, the port belongs in the same task."


[gotcha.2088]
title = "A restored gap delivers the recovered event"
detail = "When a subscription test recovers a real chain event through backfill instead of a duplicate of an already-delivered local event, the delivery drain afterwards carries it as an extra event; assert the recovered bytes in the delivered sequence rather than filtering the event out of the subscription or keeping the old count."

[gotcha.2089]
title = "The dependents check compiles a library it declared broken at the base"
detail = "cg spec done leaves out a dependent whose all-targets check already fails at the base, but another dependent pulls that library in as a normal dependency, so a deleted pub fn with one remaining caller still fails the check (10.11.5 attempt 1, sign_send). A deletion and its last caller must be one task even when the caller's file belongs to a later wave."

[gotcha.2090]
title = "A standby cannot seal before consensus hands it the primary's batch"
detail = "The WAL Seal record carries height and sequence bounds only; the primary's signed sequence batch (tx 0) reaches the standby first as FinalizeBlock's Txs[0]. A standby sealed-layer source therefore needs a FinalizeBlock hook that receives the decided transactions before sealedBlockForFinalize reads Sealed(); installing a source alone leaves Sealed() nil and the standby on the re-execution path."

[gotcha.2091]
title = "A test may assert a refusal its module never produces"
detail = "layerx-agentd tests/checkpoint.rs asserted CheckpointReadError::UnavailableCapability with the reason the RPC adapter renders; src/read has no producer for that variant, so porting the request shape could never make the assertion pass. Before porting a test to a new request shape, grep the module for the asserted variant and reason; if nothing produces it, the spec must name the refusals the module does produce (18.1154.1)."


[gotcha.2092]
title = "Buyer and seller verified different payment logs for the same scheme"
detail = "layerx-x402's seller accepts PaymentExact or PaymentDrawn while the buyer accepted PaymentExact only, so every genuine metered settlement failed buyer capture and only a fabricated log could pass. When one side of a protocol gains a scheme, grep the counterpart for the same topic constant before writing a cross-side fixture test (#1157, 18.1129.1)."


[gotcha.2093]
title = "The layerx full image build needs more disk than its native stage"
detail = "docker build of layerx-chain fails in the paxd Go compile with ENOSPC after the native target built; free the build host's warm caches and dangling images before the full build, or build on a larger disk (18.849.1)."

[gotcha.2094]
title = "Two tasks that build the same image must be sequenced, not run side by side"
detail = "18.849.1 repairs the layerx image build context and 18.869.1 verifies by building the same image; every 18.869.1 attempt failed in a step 18.849.1 owns (the builder's Go step cannot find tests/testutil/sample, which modules/epoch/module_simulation.go:15 imports) and spent its limit there. When a verify_cmd builds an artefact another pending task is repairing, add that task to requires before relaunching."

[gotcha.2095]
title = "A task that touches a test file must compile that target in its gate"
detail = "9.6.2 added tx_hash, nonce and rung as None to the fixture of layerx-agentd tests/audit_coverage.rs and verified only audit_record_v3; the file's reconstruction test still passed IdempotencyKey and asserted two removed fields, so every all-targets build of the daemon failed afterwards (#1158). A touched test file belongs in the task's build_cmd as --test <target>."

[gotcha.2096]
title = "A task gated on a whole test target inherits that target's pre-existing failures"
detail = "18.1156.1 (--test provider) and 18.1157.1 (--test buyer --test seller) both failed their first attempt on failures older than the issue they fix: native_setup.rs E0004 (recorded since gotcha.906) and 19 buyer tests still offering layerx:beta networks. Before gating an issue task on a whole target, check the target's last recorded result at head (qualification.kvx, GOTCHA.kvx, the last attempt that built it) and either fold the repair into the task or narrow the gate to the task's tests while another task owns the rest (#1159, #1160)."

[gotcha.2097]
title = "A shared test support file that gains a mandatory precondition breaks every test that includes it"
detail = "6a5587897 (10.11.2) made the attestor test cluster publish a wallet inventory and route every key generation through its own generate_key helper, verifying only attestor_evm_signer; wallet_identity_e2e, which includes the same support by #[path] and lets the service create the key, has been refused with key_invalid_share ever since (18.1151.1 a2/a7). When a support file under tests/support changes what a cluster or fixture requires, every test target that includes it belongs in the gate, and the service-driven path needs its own approval helper."


[gotcha.2098]
title = "symbols must be code symbols the graph indexes"
detail = "18.849.1 listed the Dockerfile stage 'native' in symbols; after a full passing image build the done record was refused with 'symbol native — not defined in the graph' (a11). Docker stages, make targets and file names are not graph symbols; leave symbols empty for container, script and fixture tasks."

[gotcha.2099]
title = "A step must not assume a signature change another task did not deliver"
detail = "10.4.3 told its tests to pass the frame Limits to AgentRuntime::connect because 10.13.3 'changes' that parameter; 10.13.3 changed the peer codec and left connect on the LNI Limits (agent_runtime.rs:1975-1988), so the migrated tests failed E0308 after a passing build (a3). When a step names a signature another task changes, read the signature at head when the prerequisite lands, and give the change an explicit owner (now 10.3.1 do_9)."


[gotcha.2100]
title = "A reshaped pub constructor must build every test target that calls it"
detail = "9.6.1 (fbb5df6bb) changed ExportTrustSource::new to (receipt_keys, validator_set) and removed settlement(), verifying only --test export_v2; tests/export_offline_bounds.rs:192 still builds the old form, so every all-targets layerx-agentd test build fails (18.1131.1 a7). Repeat of the pattern of gotchas 2044/2046/2095: grep tests/ for the constructor before publishing and put each caller target in build_cmd."


[gotcha.2101]
title = "Test targets that read the runtime clock need the clock service in their gate"
detail = "layerx-human-kms tests/provider.rs starts every test with RuntimeClock::from_environment, which needs LAYERX_RUNTIME_CLOCK_SOCKET; without the layerx-runtime-clock service all 14 tests return Unavailable (18.1156.1 a3/a4). The service images run their binaries under `layerx-runtime-clock --runtime-dir /tmp -- <command>` (services/platform/hosted/runtime-clock/src/main.rs:35-63); a verify of such a target must do the same."


[gotcha.2102]
title = "Renaming a network namespace can silently disable a validation branch"
detail = "decision.822 moved every x402 network to eip155:<id>, but model.rs:19/:189-193 kept is_layerx_network on the 'layerx' namespace, so validate() skipped layerx_terms for every LayerX offer and the payee redirect refusal vanished; tests/seller.rs:494/:598 caught it only because 18.1157.1's gate ran the whole seller target (11.3.3 ran one test with --exact). When a decision renames identifiers, grep every constant and predicate that keyed on the old name, and run whole targets, not single tests, in the gate of the task that moves the fixtures."


[gotcha.2103]
title = "A kernel fallback added to one lookup must be mirrored in its sibling lookups"
detail = "13.25.4 (0981a1dd3) taught transfer.c:188-209 to resolve an unbound principal to its owned main account; the same raw-principal lookup at call.c:2276-2280, reached by the sandbox escrow charge whose activity never binds ledger admission (lxp_kernel.c:485-486, :6880-6886), kept refusing with -208, which two Rust layers collapse to NON_CANONICAL (ffi_call.rs:2003, host_ffi.rs:774). 13.27.1 burned attempts 17-21 on it. When a fallback lands in one path, grep for the sibling account_by_id(…, principal) lookups and the activities that reach them unbound."

[gotcha.2104]
title = "A gate must not name a test that reads a live fixture from the environment"
detail = "10.11.9's verify listed native_provider_and_sdk_real_cluster, which returns NotPresent without PAXEER_X_NATIVE_CUSTODY_LIVE_FIXTURE (a running attestor cluster, its TLS material and an owner assertion); no qualification run has it, so the task could never pass. Tests that read a *_LIVE_FIXTURE or *_TEST_RPC variable (native_send_purpose.rs, attestor_native_profile.rs, the perps tests of the test_services_env holds) are release gates: build their targets in build_cmd, run them where the fixture exists, and keep them out of verify_cmd."


[gotcha.2105]
title = "A planned test must name its in-process harness, or the implementer invents an environment fixture"
detail = "10.5.2 a4 and 10.14.1 a1 both created their planned test and, finding no harness named, read an environment variable (PAXEER_X_NATIVE_ONBOARDING_FIXTURE, a 'real component fixture') that nothing defines, then failed NotPresent. The human service already has the harnesses: tests/agent_runtime_nonces.rs:41-147 (in-process agent runtime peer answering opcodes) and tests/projection_rungs.rs:60-150 (SystemClock + PrivilegedHumanComponents + HumanComponentServer + UnixComponents + Router). A do item that says 'create tests/x.rs (planned)' must cite the harness file and lines."


[gotcha.2106]
title = "A decoder's accepted byte set moves with the task that changes the writer"
detail = "10.14.1 asked the human service to write the balance rung byte (0, 1, 2) while AgentRuntime::balance (agent_runtime.rs:1913) still refuses every byte but the retired levels 4 and 5, and the daemon's BALANCE answer changes only in a later wave; the task was unqualifiable at its wave. When a do item reads a field from a peer answer, find the task that changes the writer, require it, and give the decoder port an explicit step."


[gotcha.2107]
title = "The identity provider admits a wallet DID only through a producer-signed binding token"
detail = "open_or_create_by_assertion(token, binding, now) takes a producer-signed binding (three dot-separated parts), never DID text, and verify_binding refuses Unavailable when the verifier has no with_binding_producer_key or the state has no pinned binding tenant; wallet_identity_e2e.rs:982 passed Some(&did) and burned 18.1151.1 a8 on 'assertion principal unavailable'. Follow tests/principal_store.rs of layerx-human-identity-provider (:140-200, :470-500) for the producer key, the tenant and the binding mint."

[gotcha.2108]
title = "Conformance vectors are copied from the recorder's output, never assembled"
detail = "11.14.3 a1 built its committed vector's receipt bytes and the verifier refused an effect of kind 0; the recorder's receipt in daemon/committed-fixture/vectors/vector-v4-committed.json decodes to kinds 1, 3, 3 (layout: 6-byte prefix, u32-length-prefixed 32-byte arrays, raw u64/u32 scalars, per effect a 6-byte header, kind, monetary, root, u32 length and body). A vector task names the recorded file and fields as its source; an InvalidReceipt on bytes nobody recorded means the bytes were invented."


[gotcha.2109]
title = "The SDK committed verifier needs two commits; a vector with one cannot pass it"
detail = "sdk/platform/go VerifyCommittedReceipt takes the execution block (header H, its commit, the transaction and batch proofs against H.data_hash) and the following block (NextHeader H+1 with LastBlockID == hash(H), its commit and validators, the result proof against H+1.last_results_hash). The recorder wrote only the commit of H+1 and its own test (chain types, no SDK call) could not notice; 8.47.7 a1 paired the H+1 commit with header H and failed. Issue #1164 / 18.1164.1. A recorder's test must call the consumer's verifier, or the consumer's verifier inputs must be listed in the vector's contract."


[gotcha.2110]
title = "A refusal test that outlives the rule it refuses is a contradiction to rule on, not a failure to chase"
detail = "After is_layerx_network admitted eip155 again, two layerx-x402 seller tests contradicted the model's own documented contract (per-asset payee accepted when its asset matches; any payTo not derived from extra.layerx.account refused); the implementer stopped as told. The orchestrator rules by the documented contract (model.rs doc comments plus the decision that renamed the network), lists each flipped assertion in a do item, and records the ruling as a finding for the owner. Never let the implementer pick which side of a contradiction to keep."

[gotcha.2111]
title = "A changed pub fn signature must compile every test target that calls it"
detail = "compat::verify took the node client version as &str at 70ce262d3 while tests/migration.rs still passed an LNI Version; every all-targets daemon test build failed until #1166 (18.1166.1). Grep the crate's tests for the old call shape before relaunching dependents."


[gotcha.2112]
title = "The receipt operation byte has three values in the tree"
detail = "Node-written module-12 receipts carry 0, the conformance fixtures carry 2, and layerx-committed-proof required 1..=3 with no documented source; the codec carries the byte and constrains only supply and withdrawal receipts. Ruled: carry it (#1167, 18.1167.1)."


[gotcha.2113]
title = "A handler field the public schema does not declare is unreachable"
detail = "a5edae038 made execute_agent_create require body.activity_types while AgentCreateRequest declares three fields and the route refuses undeclared ones; the same change renamed the preset key to call_selectors and left tests/agent_create.rs on the old key. Reported as #1165; 18.1165.1 derives the types from the preset."


[gotcha.2114]
title = "A KMS refusal with no quorum code is local"
detail = "CustodySigner returns Kms(Refused) from require_record_binding, seal_refusal and the secret-maximum guard without touching last_refusal; a test that prints last_refusal_code() None must name the branch, not retry the quorum."


[gotcha.2115]
title = "eip155 syntax is not LayerX identity"
detail = "validate_network accepts every eip155:<decimal> network; is_layerx_network must match the LayerX network eip155:125 (decision.822) exactly, or external chains such as eip155:8453 are treated as LayerX offers (18.1162.1 attempt 3)."

[gotcha.2116]
title = "An EVM transaction's chain_id is a network word too"
detail = "send::digest refuses a transaction whose chain_id is not the configured network; fixtures written for a local chain (31337) fail with status byte 1 exactly like a wrong native network word. And since 10.11.3 the KMS needs LAYERX_HUMAN_KMS_ATTESTOR_CONFIG_FILE and LAYERX_HUMAN_KMS_EVM_ASSERTION_FILE for any EVM operation, or it answers Unavailable (#1168)."


[gotcha.2117]
title = "A sandbox fixture that pre-seeds the settlement sequence trips a kernel invariant"
detail = "The fee account is seeded at the identity sequence the host reads; the kernel reads expected_sequence from the payload (sandbox.c:236-241) and checks it at :686-690. Seeding the global sequence instead turned a -208 escrow refusal into LXP_FATAL_INVARIANT (13.27.1 attempt 22)."

[gotcha.2118]
title = "A shared fixture gaining a key breaks every exact-view verifier"
detail = "18.997.1 added signingKey to the sequencer receipt conformance fixture under a Go-only gate; layerx-committed-proof compares the receipt view with ==, so its receipted test went red at head for twelve hours (#1170). A task that edits a fixture under sdk/platform/conformance must run every consumer's test, Go and Rust."


[gotcha.2119]
title = "Retiring a signer on the KMS side leaves its service callers refusing at parse"
detail = "10.11.5 made both KMS providers parse operation 11 as an EIP-1559 send authorization; Keystore::authorize_send, authorize_kernel_send and the send route's attestor branch still send a SendPlanAuthorization, so every kernel send is Kms(Refused) with no quorum code (#1169, 10.0.3 do_6). A task that changes what a KMS operation accepts must port or delete the service callers of that operation in its gate."

[gotcha.2120]
title = "A test target that includes tests/support cannot be gated alone while support is broken"
detail = "18.1166.1 gated --test migration, which pulls tests/support/mod.rs and real_authority.rs; those failed on ports 18.1131.1 owns, and 18.1131.1 required 18.1166.1. Fold the file into the task that owns the support module instead of adding a task per test file."


[gotcha.2121]
title = "Reshaping an evidence struct must port every test fixture that builds it"
detail = "10.13.1 removed authorized_batch and verification_level from ProtocolEvidence and AgentEvidence and gated two targets; eleven human-service test files kept the old fields and every pending human-service task started failing its build (#1172). Grep tests/ for the removed field names before publishing."


[gotcha.2122]
title = "A Tendermint transaction leaf is the Cosmos wrapper, never the raw EVM transaction"
detail = "sdk/platform/go/committed.go hashed one inclusion transaction both as the EVM activity id and as the sha256 block leaf; no recording can satisfy both on a node whose blocks wrap MsgEthereumTx (#1171). Bind through the wrapper."


[gotcha.2123]
title = "A LayerX profile on an external network is a mismatch, not a valid offer"
detail = "After keying is_layerx_network on eip155:125, the non-LayerX branch of validate accepted an eip155:8453 offer carrying a bound extra.layerx profile; the seller test expects ProfileMismatch there (18.1162.1 attempt 5)."

[gotcha.2124]
title = "A sandbox execute is admitted against the stored Active lease, not against the payload alone"
detail = "The kernel's sandboxExecute refuses LXP_ERR_NON_CANONICAL without a site when the host's admit_host cannot decode an Active lease and escrow from sandbox state kinds 0 and 1 or the payload's expected_lease_digest and fee_destination differ from that lease (13.27.1 attempt 23). Drive the real sandboxFund and sandboxActivate handlers first and derive the execute payload from the activated lease; a NON_CANONICAL from the kernel is a contract mismatch, not a sequence problem."

[gotcha.2125]
title = "A KMS test fixture must outlive host.stop()/host.start()"
detail = "layerx-human-kms provider tests restart the KMS mid-test; a fixture that starts the attestor cluster or writes config files inside host.start() or drops them with the first host leaves the restarted KMS refusing (status 1) or exiting at startup (18.1156.1 attempt 7). Start the cluster once per test and hand the restarted KMS the same file paths."

[gotcha.2126]
title = "A fixture-port task must own every test target its build compiles"
detail = "cargo build --tests (and cargo test --no-run) compiles every test file of the crate, so a task that ports test fixtures after a type reshape fails at build on any test file outside its touches that still uses the old shape (18.1172.1 attempt 1: render.rs, journey_faults.rs). Grep the whole tests/ directory for the retired fields when writing the touches list."

[gotcha.2127]
title = "verify_receipted only verifies receipted-rung views"
detail = "layerx-committed-proof's verify_receipted hardcodes rung receipted and no block fields in its expected view (src/lib.rs:210-223) and compares exactly (:376); a pax_sequencerReceipt view recorded after commitment (rung committed, blockNumber, blockHash) is refused with ReceiptViewMismatch. Use verify_committed (task 18.1176.1) with the verified header hash for such views."

[gotcha.2128]
title = "schema-check names only the first missing compatibility minor"
detail = "check_compatibility (services/human/tools/schema-check/src/lib.rs:2398) emits one compatibility-row-missing violation for the first missing minor and a separate unrecorded-schema-version violation for the schema's own minor (:2409-2414); a test expecting one violation per missing minor contradicts task 10.16.3 and fails (18.987.1 attempts 1-5)."

[gotcha.2129]
title = "A grant with a skewed expiry is InvalidEvidence, never StepUpMismatch"
detail = "validate_native_local_grant (services/human/crates/layerx-human-kms/src/attestor.rs:1912) binds expires_at_ms to the capability not-after and refuses before any digest exists, so a step-up mismatch fixture must mutate a field the validator admits but the signing bytes cover (owner_public_key, attestor.rs:1824); moving the expiry yields InvalidEvidence at signer.rs:976 (18.1110.1 attempt 5; task 18.1177.1)."

[gotcha.2130]
title = "A guest terminal -3 is STATUS_BOUNDS, not NON_CANONICAL"
detail = "When a programs guest ends in terminal failure the receipt result_code is the guest status band (programs/sdk/rust/src/error.rs:19-29): -3 is STATUS_BOUNDS, produced by the host for AbiError::Storage (layerx-programs-runtime host/mod.rs) or a context read over capacity (host/context.rs:42-43); market decode and register() refusals are -2 STATUS_INVALID, so a -3 on register-offer means the fixture's first storage or context host call failed before the guest logic ran (18.911.1 attempts 14-15)."

[gotcha.2131]
title = "Portable committed bundles carry two transaction encodings"
detail = "In a committed portable receipt rawTransaction is the signed EVM transaction (keccak256 == activity id, sdk/platform/go/verify.go:1091) and receiptInclusion.transaction is the Cosmos block transaction wrapping it (sha256 leaf under data_hash, committed.go:131); a check that compares the two for byte equality (portable_receipt.go:137 before task 18.1178.1) can never pass, and a synthetic fixture must wrap its EVM bytes before using them as the block transaction."

[gotcha.2132]
title = "A sandboxed program call must carry guest ABI 2 or later"
detail = "layerx_programs_call_begin (programs/crates/layerx-programs-runtime/src/ffi_call.rs:2796-2803) refuses an inner call whose abi_version is outside ABI_V2..ABI_V5 with NON_CANONICAL when a sandbox context is active, before any admission runs; a Go test that reuses programsCallFixture's ABI-v1 program and payload (method_call_test.go:145,153) inside sandboxExecute fails there (13.27.1 attempt 24). Deploy an ABI-v2 program (bank_parity_test.go:23-39) and encode the call with abiVersion 2."

[gotcha.2133]
title = "Integration harnesses on chain 1337 fail the x402 network binding"
detail = "layerx-x402 model.rs:19 binds LayerX offers to eip155:125 and refuses extra.layerx on any other eip155 network (:180-193, e556c8b04); a gateway harness whose evm.chain_id is 1337 (x-websearch tests/fixtures/config/valid.json:52) gets 503 payment_unavailable from Seller::new on every request, so the harness must override chain_id to 125 in its config helper and answer eth_chainId with 0x7d (18.1129.1 attempt 12)."

[gotcha.2134]
title = "The KMS no longer signs kernel activity envelopes"
detail = "Since 843ee0252 (10.11.7) layerx-human-kms sign (src/server.rs:158-184) admits only an unsigned EIP-1559 type-2 call whose bind_call disclosure and Keccak256 digest match call.signing_hash(), and refuses the kernel envelope with its SHA-256 LXP/v1/signature-preimage digest (status 1); provider tests that still build unsigned_envelope_bytes must port to evm_signing_request (tests/provider.rs:716-730). Keystore::authorize_send in layerx-human-service still sends the retired operation-11 SendPlanAuthorization until 10.0.3 lands (#1169)."

[gotcha.2135]
title = "Shell variables cannot be task symbols"
detail = "cg spec done runs a graph check over every entry of a task's symbols list and refuses a name the symbol graph has not indexed; shell variables such as FILE_VARIABLES in docker/platform-gateway/entrypoint.sh are never indexed (18.1174.1 attempt 1 passed its tests and was refused on that check alone). Name shell-script identifiers in do steps and touches only, and keep symbols to indexed functions and types."

[gotcha.2136]
area = "programs sandbox"
symptom = "sandboxExecute is refused LXP_ERR_NON_CANONICAL although admission, the stored lease, the funded escrow and the ABI and fee-schedule gates all pass."
cause = "The fee debit from the lease escrow is a program-source leg; transfer_source_validate (src/modules/programs/call.c:2203-2219) needs a registerAccount binding for the seed sandbox-lease-escrow/v1 NUL || lease_id, and settle_call (host_ffi.rs:762-764) reports the AUTH_SCOPE refusal as NON_CANONICAL."
do = "Open the escrow through registerAccount before sandboxFund; a hand-seeded module value account is not a bound program account."

[gotcha.2137]
area = "x402 gateway"
symptom = "x-websearch metered and exact draws answer payment_invalid for every request after a refused one that reused the idempotency key."
cause = "The x402 seller keys the gateway translation by the payload idempotencyKey (layerx-x402/src/seller.rs:180-195) and GatewayCore refuses a repeated key with different content (layerx-interop-gateway/src/gateway.rs:462-469); x-websearch kept one GatewayCore for the gate lifetime."
do = "Build a GatewayCore per settlement as layerx-interop-service does per request; durable idempotency belongs to PaymentStore."

[gotcha.2138]
area = "sdk portable receipt"
symptom = "The JVM and .NET portable receipt verifiers refuse the published V5 vector that the Go verifier accepts."
cause = "The vector's wire layout is the Go encoding (receiptJson present; PascalCase, base64, integer-array and RFC3339 committed evidence); contracts/clients.md no longer lists the portable v2 fields, so the other SDKs followed older field lists."
do = "Treat sdk/platform/go/portable_receipt.go and sdk/platform/go/committed.go as the wire reference for portable v2 bundles until the contract states it."

[gotcha.2139]
area = "explorer openapi"
symptom = "Explorer controller tests fail schema validation after a view starts emitting a new field."
cause = "OpenApiSpex schemas declare additionalProperties: false and BlockScoutWeb.TestApiSchemaAssertions validates every json_response against them; services/explorer/swagger.yaml is a generated copy of the same schemas."
do = "Add the field to the schema module and to swagger.yaml in the same change as the view."

[gotcha.2140]
area = "launchpad fixtures"
symptom = "Go, Node and shell tests fail opening launchpad/spec/production-system/integration/contracts/v1/*.json."
cause = "384f41641 removed the whole launchpad/ tree; the six frozen v1 fixtures live under sdk/launchpad/protocol/contracts/v1/ (decision.1803)."
do = "Read the fixtures from sdk/launchpad/protocol/contracts/v1/; readers of files already absent before the removal stay under decision.421."

[gotcha.2141]
area = "programs call terminal"
symptom = "A refused LX_PROGRAMS_CALL reports result_code -736 whatever the guest returned, and a test matching LXP/program-execution/v5 at the start of the terminal payload fails."
cause = "-736 is LXP_ERR_PROGRAM_REFUSED (include/layerx/lxp_result.h:142) and under protocol v3 the terminal payload is wrapped as LXP/programs/terminal-applied-legs/v1 NUL + u32 detail length + detail + u32 legs (src/modules/programs/call.c:1531-1570)."
do = "Unwrap the terminal-applied-legs prefix before matching the guest output, as tests/programs/test_call_activity.c:72-83 does."

[gotcha.2142]
area = "agentd prepare"
symptom = "A directory listing of services/agent/crates/layerx-agentd/src/prepare/ shows no evm.rs, and layerx_agentd::prepare::evm::prepare_bound looks absent."
cause = "prepare/mod.rs declares pub mod evm inline at :3 (EvmPreparationState :12, PrecompileTarget :20, prepare_bound :325) and re-exports it at :396."
do = "Grep for the symbol before concluding a module path is wrong; an inline module has no file of its own."

[gotcha.2143]
area = "budget defund"
symptom = "A compiled budget defund is refused at the agent boundary as an unsupported activity."
cause = "layerx-intents compiles and discloses the defund as Budget ordinal 7 (compile.rs:532, disclosure.rs:745) while lx_budget.h:23 defines LX_BUDGET_DEFUND = 0x00030008 and layerx-crypto disclosure.rs:962 admits Budget 2, 8, 9 only."
do = "Use ordinal 8 for the kernel defund (18.1188.1); under decision.1805 the reclaim leg is the Pay budgetDefund call, not a kernel envelope."

[gotcha.2144]
area = "human kms signing"
symptom = "A journey leg signed through custody is refused by the live submit contract with Malformed('signature')."
cause = "The production KMS sign (layerx-human-kms/src/server.rs:158-184) admits only an unsigned EIP-1559 call with its bind_call disclosure and the submit contract requires a 65-byte signature (layerx-agent-api/src/write.rs:78); the engine (engine.rs:964-990) and the local envelope signer still produce 64-byte kernel-envelope signatures."
do = "Carry type-2 transactions end to end (decision.1805); do not widen or truncate the signature to make a kernel envelope pass."

[gotcha.2145]
area = "agentd tests"
symptom = "An agentd test that verifies a receipt or state leaf panics at tests/support/real_authority.rs:46 'real isolated Paxeer chain id is required: NotPresent'."
cause = "support::evidence_verifier() (tests/support/mod.rs:466) is chain-bound: evidence_authority -> try_evidence_authority_mode -> ReadinessNode::new (:1432) reads LAYERX_TEST_PAXEER_CHAIN_ID and binds a responder; only tools/qualification/paxeer-x/caps-codecs.py exports that environment."
do = "Build the verifier with EvidenceAuthority::pinned_to_handshake(layerx_wire::limits::PROTOCOL_VERSION, 42, SigningKey::from_bytes(&[0x3a; 32]).verifying_key().to_bytes()) (src/protocol_evidence.rs:606), the key and network id support::raw_receipt and raw_state_leaf use; never export chain variables without a chain."

[gotcha.2146]
area = "agentd human peer"
symptom = "A test that calls serve_one needs a HumanOperations and every implementation requires a connected layerx_client::Client over a live LNI socket."
cause = "SharedAgentOwner, UnifiedAgentOwner and ProductionHumanOperations (src/human_runtime.rs:2338, :8525, :13223) all take the Client and dispatch_request (src/human.rs:2050) consults operations for every request; there is no node-free constructor."
do = "Verify serve_one only through the PAXEER_X_NATIVE_PROGRAM_HUMAN_PEER_FIXTURE release gate (tools/qualification/paxeer-x/native-program-human-peer.py); task gates cover the codec; write no HumanOperations test double (decision.1806)."

[gotcha.2147]
area = "spec waves"
symptom = "A spec edit that moves a task to a later wave, or adds a requires edge, parses cleanly yet no task is admitted afterwards."
cause = "Parsing the plan does not validate it; the admission step also refuses any task whose requirement sits in a later wave and any requires cycle, and then runs without admitting anything."
do = "Before committing a wave or requires change, check that no dependant sits in an earlier wave than its requirement and that the requires graph has no cycle; when a task must wait for another, move the dependants too or drop the edge."

[gotcha.2148]
area = "rust crates"
symptom = "A task passes its own test and the wider build of the crate's dependents fails with E0063 missing field on a struct literal."
cause = "A library struct gained a field (SequencerBlock.receipts_root, layerx-client src/sequencer.rs:200) and the sibling test binaries of the same crate still spell the old literal; cargo test -p crate --test name builds only the named binary."
do = "When a struct gains a field, port every struct literal in the crate's tests in the same task; build the crate with --tests before qualifying."

[gotcha.2149]
area = "sdk verifiers"
symptom = "A portable receipt vector verifies in Go and .NET and the JVM verifier refuses it."
cause = "The JVM FIELDS rule carried a term the other verifiers do not (operation != 2, LocalVerifier.java:185-190), over-fitted to the asset transfer receipt it was written against."
do = "Mirror the Go and .NET field rules term by term; a committed settlement receipt has moduleId 12 and operation 0 (decision.1807)."

[gotcha.2150]
area = "spec authoring"
symptom = "A task step names a diagnostic facility or helper that is not in the tree and attempts stall looking for it."
cause = "The step was written from a design, not from the code; readers then search for the facility instead of narrowing the fault."
do = "Replace the step with an assertion ladder over the real reads and handlers (ReadAccount, ReadProgramAccount, the registered call handler) that stops at the first failing assertion and records it."

[gotcha.2151]
area = "budget payloads"
symptom = "A budget fund vector or compiler emits a 0x4202 six-field 180-byte payload and the kernel or layerx-crypto refuses it."
cause = "The tagged 0x42xx layout is stale; the kernel canonical fund payload is type 0x00030002 with v1 50 bytes or v2 58 bytes (lx_budget_codec.c:173-196), as layerx-crypto and modules/layerxpay/types/payload_budget.go encode; binding a budget mutation needs bind_budget_mutation with a BudgetStateContext."
do = "Encode the kernel layout (decision.1811) and bind with the budget state context; the wallet policy, its vectors and the intent compiler must agree with the kernel codec."

[gotcha.2152]
area = "launchpad replay fixtures"
symptom = "A recorded chain-125 market replay fails receipt qualification although the recording is byte-exact."
cause = "deployment.Current() moved to a new contract generation (16ee6fd09, v6.12.0) and validateCode compares runtime hashes at the qualified block, so the current manifest can never qualify blocks recorded under the previous generation."
do = "Qualify with the history entry whose activation height covers the anchor (deployment.Approved, decision.1814); never pin Current() in a replay test."

[gotcha.2153]
area = "flatkv config"
symptom = "ParseFlatKVConfig returns 'data dir is required' for every call and a parse-time panic would stop every node."
cause = "Validation ran at parse while DataDir is assigned later at store construction (composite/store.go:133, flatkv/store.go:230)."
do = "Validate where the full config exists; parse functions return cast errors only (decision.1819)."

[gotcha.2154]
area = "release workflow"
symptom = "committed_pipeline() panics on the platform workflow and release_pipeline_has_no_replay_gate cannot run."
cause = "A verification step carried if: always(), which the release validator admits only as the sdk-v tag condition."
do = "Delete the condition on the workflow step; never widen the validator (No Weakening)."

[gotcha.2155]
area = "launchpad tests"
symptom = "A launchpad Postgres test reads handoffs/L35/schema.sql or integration/migrations and fails before any assertion."
cause = "Those paths were never committed to any ref; the tracked schema is each service's embedded goose migration set."
do = "Apply services/launchpad/<service>/migrations through the service's migrate package under <SERVICE>_TEST_DATABASE_URL (decision.1817); task gates stay network-free."

[gotcha.2156]
area = "x402 recordings"
symptom = "Replaying a seller recording in a buyer crate fails on every paid exchange although the payload port is complete."
cause = "The seller moved from LAYERX-PAYER-DID to LAYERX-PAYER-ADDRESS and recorded on eip155:125; the buyer still sent the DID header over the test chain id 1337."
do = "Read the payer header name and the chain reference from the recording and configure the buyer with them; never edit the recording (decision.1820)."

[gotcha.2157]
area = "agent daemon tests"
symptom = "A gate test panics 'owned real sequencer fixture required' and the task can never qualify."
cause = "The test took its evidence from a PAXEER_X_*_FIXTURE environment variable that only a release environment provides."
do = "Serve the sequencer answers from a loopback TcpListener and sign receipts in-process (tests/node_rpc.rs pattern); keep the real-fixture variant as a release gate not named in verify_cmd (decisions 1806, 1821)."

[gotcha.2158]
area = "programs precompile tests"
symptom = "A program deploy or call returns LXP_ERR_CONTEXT_MISMATCH (-213) although the handler passes the payload through unchanged."
cause = "The interface bytes' ABI u16 (right after the 32-byte code hash) differs from the deploy or call abiVersion; the runtime's interface check (ffi_interface.rs:469-474, :549-552) rejects it at deploy and at call."
do = "Write the same ABI in the interface field and in EncodeDeployPayload/EncodeCallPayload; the capability-11 entry needs ABI 3 or 4. The kernel's sandbox code never returns -213."

[gotcha.2159]
area = "lxphost replay tests"
symptom = "A replay test cannot make the precompile refuse a reused actor sequence."
cause = "submit of precompiles/layerxprograms/submit.go reads ReadIdentitySequence and ReadLastSequence itself and always advances the sequence."
do = "Drive both calls through lxphost.ExecuteActivity at an explicit account sequence under fresh WithSequence(ctx, last+1) contexts and assert LXP_ERR_SEQUENCE_REUSED (-301), as execute_test.go:73-100 does (decision.1822)."

[gotcha.2160]
area = "programs arbiter"
symptom = "Changing the derive signatures of layerx-programs-arbiter breaks the crate build with 'missing epoch/batch' and 'old caller' errors."
cause = "VerifiedAdmissionPrestate has no epoch, batch or fee-history accessor, and step.rs and market.rs call derive with header and receipt_proof."
do = "Keep header: &VerifiedBatchHeader, replace only the receipt proof, and update step.rs and market.rs in the same task (decision.1823)."

[gotcha.2161]
area = "human-service tests"
symptom = "The node-fixture tests of layerx-human-service cannot drop layerx_client::lni although the src files are off it."
cause = "AgentRuntime::connect still takes lni::transport::Limits until 10.3.1; the rpc replacement has no frame transport or Acknowledged variant."
do = "Scan the src files only in the J44.21 task and rewrite the fixtures against a loopback sequencer RPC in the task that follows the runtime change (decision.1824, 10.98.15)."

[gotcha.2162]
area = "J44.25 ports"
symptom = "A 'rename-only' port from bind or sign_disclosed to bind_call or sign_disclosed_call stalls for attempts on 'cannot preserve behaviour'."
cause = "The replacement is the EVM call API: Eip1559Call plus a 20-byte from, 65-byte signatures, SigningPreparation instead of Prepared; behaviour changes by design."
do = "Write the task so the tests assert the new API's behaviour and drop the 'behaviour unchanged' clause (decision.1825)."

[gotcha.2163]
area = "program drivers"
symptom = "A program call at the next height fails with -736 and a callback-failure terminal (stage 05, status -3) although the guest never ran."
cause = "The driver incremented the fixture height without finalising the occupancy batch; prepare_positions requires batch == last_finalized_batch + 1."
do = "Call lxp_programs_finalize_occupancy_batch_selected and refresh current_state_root before every height increment (decision.1826)."

[gotcha.2164]
area = "x402 buyers"
symptom = "Every metered web test fails with OfferMismatch(payer) after the payer header moved to LAYERX-PAYER-ADDRESS."
cause = "The buyer still derived its payer accounts from the DID naming while the seller's offers carry the ledger accountId of the address."
do = "Derive the accounts through eth_call accountId(owner, asset) with the address left-padded to 32 bytes, plus the PAX naming special case (decision.1827)."

[gotcha.2165]
area = "spec touches"
symptom = "A task changes a signature, an error type or struct field names and the crate build fails in files the task may not edit."
cause = "The callers were left out of touches; attempts repeat the same compile errors (9.2.4, 9.5.9, 9.13.2, 10.3.1)."
do = "Before changing a public signature, grep its callers and add them to the task's touches with one do line; record the finding once, not per attempt."

[gotcha.2166]
area = "agentd tests"
symptom = "A test suite that includes layerx-agentd tests/support/mod.rs by path fails with E0308 on attach_external_signature and verify_before_submit."
cause = "The shared support helpers still use the retired Prepared and 64-byte signature API."
do = "Port the helper sites to SigningPreparation, 65-byte signatures and the 20-byte signer address; add the support file to the task's touches."

[gotcha.2167]
area = "completion gates"
symptom = "A domain completion gate reports a retired pub item present although the replacing task is done."
cause = "The replacing task added the new item and kept the old constant for its single test caller."
do = "Add a small retiring task that deletes the item and ports the test caller, and make the gate task require it; never relax the gate (decision.1828)."

[gotcha.2168]
area = "lxphost tests"
symptom = "A programs call (0x00090003) driven through lxphost.ExecuteActivity returns LXP_ERR_UNAUTHORIZED_DEBIT (-207) although the payer is funded."
cause = "ExecuteActivity builds the Activity without FeeLimit; occupancy.c refuses a signed fee limit below the execution ceiling."
do = "Build the Activity with FeeLimit (the call tests use 100000000) and call Host.Execute directly; use the same AccountSequence to prove the -301 replay refusal (decision.1829)."

[gotcha.2169]
area = "rebased candidates"
symptom = "A rebased candidate fails compiling a file that no longer exists at main."
cause = "The carried candidate restored a file a later task deleted."
do = "After the rebase, diff the tree against main for files outside the task's touches and drop any that main deleted before running the gate."

[gotcha.2170]
area = "module deletions"
symptom = "Deleting a Rust module file yields E0583 in a file the task may not edit."
cause = "The `mod x;` declaration lives in main.rs or lib.rs outside the deleting task's touches."
do = "Give the deleting task the declaring file (for those lines) and make the task owning the rest of that file require it."

[gotcha.2171]
area = "spec do lines"
symptom = "Two do lines of one task disagree on where an input lives and the attempt edits a file outside touches."
cause = "do_1 forbade a testdata copy while do_2 said 'that testdata file'."
do = "Resolve the contradiction with a decision and a do line naming the exact path; check new tasks for do lines that name different paths for the same input."

[gotcha.2172]
area = "programs precompile tests"
symptom = "registerAccount reverts LXP_VERSION_UNSUPPORTED for a program deployed at ABI 3 although the payload is well formed."
cause = "ABI 3 account registration reads the program-account-profile record (and through it the program-owner record); production code never writes them and a missing record is reported as VERSION_UNSUPPORTED."
do = "Seed program-owner NUL || id = {1} || principal and program-account-profile NUL || id = {2} || principal under module prefix {1, 0, 9} before registerAccount, as view_accounts_test.go does."

[gotcha.2173]
area = "layerx-mcp web tool"
symptom = "Every metered offer is refused with 'the web offer does not bind the purpose'."
cause = "The tool hashes the receiver DID key into the purpose while x-websearch has hashed the 20-byte receiver EVM address since 11.34.3."
do = "Hash PURPOSE_DOMAIN || receiver_address; pin the receiver address in the web config because the offer does not carry it."

[gotcha.2174]
area = "layerx-mcp web tool"
symptom = "Exact-scheme receipts are refused as PaymentArtifact(receipt) although the recording is genuine."
cause = "The receipt is a 0x101A payExact program receipt; payer, payee, asset and amount live in its PaymentExact log, not in asset-module protocol facts."
do = "Verify the logs with layerx_proof::sequencer_logs::verify_logs and read exactly one PaymentExact log, as the seller's verify_receipt does."

[gotcha.2175]
area = "agentd StartupConfig"
symptom = "A test-support change to Rung::Committed fails E0308 against verification_defaults."
cause = "StartupConfig.verification_defaults is keyed by VerificationLevel, not Rung; only its rung() maps onto the three rungs."
do = "Pick the VerificationLevel whose rung() is the wanted rung (CHECKPOINT_FINALISED for Committed) and assert the mapping in the test."

[gotcha.2176]
area = "arbiter authority tests"
symptom = "A gate test that must run from an in-tree vector demands native_admission and native_replay captures."
cause = "Deriving a VerifiedReplayAuthority needs a Programs-module receipt and a v3 admission prestate that only the native corpus provides."
do = "Keep corpus-bound derivations as release gates (decision.1806) and give the task gate a proof-level test the vector can satisfy."

[gotcha.2177]
area = "wallet gateway e2e"
symptom = "After the station-sponsored bind landed, the e2e finds no bind transaction from the provisioned address."
cause = "The bind is an executeSponsored transaction from the station relayer to the paymaster with the address inside the batch."
do = "Assert the relayer transaction and its decoded batch, not a transaction from the address."

[gotcha.2178]
area = "agentd program reads"
symptom = "Replacing a protocol-adapter read with eth_call breaks a caller that cross-checks state roots and bindings."
cause = "The adapter wraps the kernel's C account-state decode and builds a proof-verified read; eth_call returns bare values."
do = "Use eth_call only for plain operation reads; build proof-verified reads from the registry's VerifiedAccountSnapshot."

[gotcha.2179]
area = "spec symbols"
symptom = "the gate passes and the task is still refused by the declared-symbol check"
cause = "symbols named an enum variant path (Rung::Committed) or a deleted identifier"
do = "symbols name plain identifiers that exist after the task: functions, types, test names"

[gotcha.2180]
area = "EIP-7702 sponsored transactions"
symptom = "a filter on to === PAYMASTER finds no bind transaction while a from-or-to-account filter finds one"
cause = "under EIP-7702 the sponsor sends executeSponsored to the delegated account; PAYMASTER appears only in the authorization list"
do = "assert from === sponsor, to === account and the authorization address, never to === PAYMASTER"

[gotcha.2181]
area = "launchpad catalog selection"
symptom = "a user-service catalog test answers 404 on follower routes"
cause = "a /v2/profiles prefix also selects the follow operations the social service serves"
do = "select the catalog operations by exact path per owning service and assert the selected count"

[gotcha.2182]
area = "protocol adapter codec"
symptom = "a task assumes the account-state record decoder is C and stops for a missing Rust decoder"
cause = "the LXPS1/LXPS2 codec is pure Rust in the adapter's ffi.rs; only read_* and read_program_state cross the FFI"
do = "read the whole ffi.rs before ruling on what is C; move pure code rather than rewrite it"

[gotcha.2183]
area = "spec touches"
symptom = "a type-retirement task fails to compile in a file it may not edit"
cause = "the referencing file's only owner is already done or runs later and requires this task"
do = "before dispatching a deletion task, grep every retired symbol across the module and add each referencing file to touches or a requires on its pending owner"

[gotcha.2184]
area = "dotnet and mvn gates"
symptom = "verify_cmd with a test filter still fails on compile errors in tests the filter never selects"
cause = "dotnet test and mvn test compile the whole test project before filtering"
do = "treat every test file in the project as a compile dependency of a deletion task"

[gotcha.2185]
area = "sdkgen retired variants"
symptom = "generated Go constants re-emit variants the schema retired"
cause = "variants() ignores retired_variants of errors.kvx"
do = "when a schema lists retired_variants, the generator must skip them and the generated file must carry every live variant"

[gotcha.2186]
area = "workspace --tests build_cmd"
symptom = "a planned-test task fails its build in another crate's integration tests"
cause = "cargo build --manifest-path <workspace> --tests compiles every member's test targets, including literals stale since a type change"
do = "scope build_cmd to -p <crate> and the task's --test targets, and route stale literals to their file owner"

[gotcha.2187]
area = "layerxctl receipt vectors"
symptom = "submit prints 'transaction must contain binary signed EIP-1559 (type 2) bytes' or receipt_error Malformed against a recorded vector while the test decodes correctly"
cause = "vector_v1.go records a LegacyTx and layerx-client Fields::exact refuses the daemon's signingKey field"
do = "check the first byte of rawTransaction and diff receiptJson keys against RECEIPTED_FIELDS before blaming the test"

[gotcha.2188]
area = "layerx-sdk streaming conformance"
symptom = "positional-cursor tests fail while the chain checks pass"
cause = "ResumableStream::accept has no position ordering, only chain linkage, and the task's touches held only the test file"
do = "when a conformance task re-targets a test to new semantics, give it the implementation file and a do line mirroring the sibling SDK"

[gotcha.2189]
area = "sdk-gen schema validation"
symptom = "major_two tests panic with 'missing type.<Request>.precompile'"
cause = "the generator requirement was added ahead of the schema key, which a later-wave task owns"
do = "confirm a required schema key exists at main or add requires on the schema-owning task"

[gotcha.2190]
area = "Rust module retirement"
symptom = "removing mod x; and its re-exports per the do line leaves dozens of unresolved imports in files the task does not own"
cause = "the do line enumerated the module's tests but not its crate::<mod>:: importers"
do = "list every importer before writing a remove-module do line and put each in touches or a required task"

[gotcha.2191]
area = "kernel fee accounting in precompile tests"
symptom = "a fee-balance assertion through the x/bank mirror never changes"
cause = "the programs fee settles in kernel rows; the ledger mirror follows 0x0001xxxx legs only"
do = "read fee balances through host.ReadBalance(ctx, payer, asset)"

[gotcha.2192]
area = "recorded x402 exchanges"
symptom = "a routed tools/call web.fetch gets sidecar status 400 while direct fetch tests pass"
cause = "since the re-recording the exact payload carries idempotencyKey, so the replaying seller's payload equality binds the test's key to the recorded one"
do = "every paid call replayed against client-exchange.json takes its idempotency key from the recording; arbitrary keys only for calls refused before they are sent"

[gotcha.2193]
area = "layerxprograms call output"
symptom = "a test expecting empty response bytes from a settled call fails with a 516-byte 'LXP/programs/terminal-applied-legs/v1' blob"
cause = "callHandler packs outcome.Response, which for the market guest is the terminal receipt envelope"
do = "assert status and kind; decode the response as the guest's answer, never as empty"

[gotcha.2194]
area = "precompile addresses"
symptom = "a bootstrap test pins bindLayerX at 0x101C and the client prepares 0x1004"
cause = "bindLayerX belongs to the addr precompile (0x1004); layerxauth (0x101C) serves grantSession"
do = "check precompiles/<name>/*.go for the method before pinning an address in a spec line or test"

[gotcha.2195]
area = "agentd operation classes"
symptom = "require_session_credential answers InvalidRequest for an operation that carries a credential"
cause = "OperationClass::for_operation returns None for operations the bootstrap refusal list used to cover"
do = "when a task lifts a bootstrap refusal, classify the operation in tenant.rs in the same task"

[gotcha.2196]
area = "arbiter ICS23 tests"
symptom = "cargo test panics with NotPresent on LAYERX_*_INPUTS"
cause = "the tests load a corpus the qualification tools generate from evidence outside the repository"
do = "give the gate a keeper-generated vector under programs/tests/vectors/, as 13.30.3 did; never a fabricated corpus"

[gotcha.2197]
area = "98-family ports"
symptom = "a worker stops on 'change only import paths' when the rpc twin has another shape"
cause = "the import-only do line predates decision.1813's rewrite-or-delete rule"
do = "decision.1843: rewrite over the twin or delete; port files a later task deletes no further than build and scan need"

[gotcha.2198]
area = "Swift gate environment"
symptom = "swift-build exits 127: libicuuc.so.74 cannot open"
cause = "the Swift 6.0.3 Ubuntu 24.04 toolchain needs ICU 74 while the gate image carries a newer ICU"
do = "the runner's compat step installs libicu74 from the noble pool beside libxml2; rebuild the image after editing the runner"

[gotcha.2199]
area = "spec authoring"
symptom = "A cargo test gate exits at once with 'Option exact given more than once' and no test runs."
cause = "The verify_cmd listed --exact before each test name; libtest takes --exact once followed by every name."
do = "Write `-- --exact name_a name_b`; lint gates for a repeated --exact before committing."

[gotcha.2200]
area = "task scoping"
symptom = "A task that deletes or retypes a definition passes its own test and fails the dependents build on callers another, later task owns; the two tasks block each other."
cause = "Ownership split a definition from its callers across crates (10.98.13/10.98.10, 10.98.7, 10.20.3 and the movement provider, 10.98.1 and its binary, 8.48.1/8.48.2 on wallet.rs)."
do = "The deleting or retyping task carries every caller in dependent crates; the former owner requires it and keeps the new shape (decision.1849). Check dependents when writing touches."

[gotcha.2201]
area = "rust formatting"
symptom = "The scope check flags a file the task never edited after rustfmt ran on a declared file."
cause = "rustfmt follows #[path] child modules (production_components.rs -> production_owner.rs -> production_owner_tests.rs) and reformatted a child that is not rustfmt-clean at main."
do = "Format only files whose child modules are declared too, or restore undeclared children before committing; name the child module in the do line when a declared file has one."

[gotcha.2202]
area = "conformance vectors"
symptom = "A conformance command fails at main because a human golden's method and path disagree with generated metadata."
cause = "An operation was re-routed to per-leg EVM calls (no HTTP path) while its HTTP golden still documents the request shape."
do = "Compare EVM-routed operations against their generated EVM method and per-leg flag, not against the golden method and path (decision.1848)."

[gotcha.2203]
area = "wave planning"
symptom = "A programme gate task that runs make workspace-build fails on compile breaks owned by much later tasks."
cause = "The gate task sat at wave 6 while the binaries it builds are ported at waves 10 to 21."
do = "Give workspace-build gate tasks requires on every compile-port task and a wave after them (decision.1847)."

[gotcha.2204]
area = "spec authoring"
symptom = "An interface note that was wrong in one block was wrong in 61 opcode blocks of the same protocol family and in two contract tables."
cause = "The opcode blocks of a protocol family copy the family note verbatim and the contract tables reproduce interfaces.kvx by hand, so a stale cite multiplies."
do = "When an interface note changes, replace it in every block of the family and in both contract tables in one edit, asserting the copy count before writing."

[gotcha.2205]
area = "agent refusal vocabulary"
symptom = "Deleting a refusal variant from one enum broke the build in a file the task did not own, although nothing ever constructed the matching error."
cause = "A never-constructed error variant still anchors a match arm in the runtime, an entry in a test list in the dispatcher and reason and class assertions in an integration test."
do = "Before retiring a variant, grep the whole crate and its tests for the identifier, list every arm, list entry and assertion as caller sites in the task, and delete the dead producer variant with them."

[gotcha.2206]
area = "spec authoring"
symptom = "A task's do line asserted a wire layout (a rung byte in the BALANCE answer) that the landed writer never emits, and four attempts stopped on it without a gate run."
cause = "The do line was written from another task's promise instead of the landed writer, and the interface block pins only the opcode, not the layout."
do = "Before writing a do line that names a wire layout, read the landed writer and the requirement that governs it, and cite the writer's lines; where the interface pins no layout, say so and name the writer as the authority."

[gotcha.2207]
area = "spec authoring"
symptom = "A verify_cmd written with escaped double quotes reached sh with the backslashes intact and failed with a syntax error before any check ran; a build_cmd of another task carried the same shape."
cause = "The gate runner hands the kvx command string to sh verbatim; kvx escaping is not undone for build_cmd and verify_cmd."
do = "Write build_cmd and verify_cmd with single quotes only, use grep -F for literal patterns, and pass file names to python3 -c through sys.argv instead of quoting them inside the program."

[gotcha.2208]
area = "qualification"
symptom = "A task that touched only runtime and host crates was stopped three times before its verify ran because a dependent crate's test target did not compile; the errors were in a test file the task never touched."
cause = "A retyping commit ported one test file of the dependent crate and left another behind, so the test target was already broken at the base revision; the dependents check attributed the break to the next task that touched anything upstream."
do = "Before attributing a dependents failure to a task, check the same target at the base revision; a break present at the base is recorded once against the owning task in qualification.kvx and the target is left out of the dependents check until that owner lands."

[gotcha.2209]
title = "A crate left out of the dependents check lets a retype land with its test targets broken"
symptom = "Three retypes landed on main in one day without compiling the test targets of crates excluded from the dependents check: 9.1.4 removed layerx_agent_api::verify::Level (15 errors in the layerx-human-service library, 12 test files), 9.21.8 added ExecutedReceipt.signing_key (agentd tests/budget_create.rs), 18.1027.1 added CreateOrder.payer_grant_purpose (ramp toolkit tests/engine_legs.rs). Every task that builds those crates then failed at cargo build on a break it did not cause (18.1172.2 a1, 18.1206.1 a4, 18.1230.1 a4, 18.1221.1 a3, 8.29.4 a1-a3)."
fix = "Before landing a task that changes a public type or signature, grep the whole repository for the symbol (including tests/ directories and crates on the excluded list) and either carry every caller in the same task or open a wave-1 repair task that the callers' tasks require (decision.1871: 10.2.8, 8.29.5, 18.1206.1). When a build log shows an error in a file the task does not touch, check git log -S for the retyping commit before blaming the attempt."

[gotcha.2210]
title = "A doubled backslash in a kvx verify command reaches the test runner as a literal backslash"
symptom = "A Swift verify filter written with a doubled backslash before the dot of LayerXSDKTests.SequencerReceiptTests in spec.kvx reached swift test unchanged, so the regex demanded a literal backslash, matched no test identifier and the run executed 0 tests (8.44.1 attempt 10, and the five sibling 8.44.x commands carried the same text)."
fix = "Write regex filters in kvx commands without backslashes: a bare dot matches the dot in a test identifier, and the kvx reader does not unescape command strings."

[gotcha.2211]
title = "cg spec done accepts a run that executed zero tests"
symptom = "8.44.1 attempt 10 ran swift test with a filter matching nothing; the log said Executed 0 tests, with 0 failures and cg spec done exited 0, so only the scope check stopped a false success."
fix = "Treat Executed 0 tests, 0 passed or running 0 tests in a verify log as a failure of the gate: fix the filter or target and rerun once before any done record."

[gotcha.2212]
title = "The cg graph check counts a field and its same-named accessor as two symbol definitions"
symptom = "10.2.8 attempt 4 passed build and verify, and cg spec done refused the record with symbol ReceiptEvidence::rung ambiguous: 2 definitions, because the struct has a field rung and a method fn rung(&self), the ordinary Rust accessor idiom."
fix = "Name the struct, or a method whose name differs from every field, in a task's symbols list; never name a getter that shares its field's name."

[gotcha.2213]
title = "Dropping an out-of-scope Cargo.lock change from a candidate makes the --locked gates fail"
symptom = "9.98.1 attempt 6 added a test target and four dependencies, left Cargo.lock untouched because it was not in the touches, and the gate failed with Cargo.lock needs to be updated but --locked was passed."
fix = "A task that adds a dependency or a [[test]] target lists the workspace Cargo.lock in its touches and regenerates only the missing entries with one unlocked build before the locked gates."

[gotcha.2214]
title = "A closure gate with a roll-up requires list hides one failing task behind hundreds"
symptom = "13.0.2 required all twenty-seven wave-16 programs tasks although its own steps touch only the registry crate; with twenty-six done, the thirty-three attempts of 13.27.1 kept 638 pending tasks ineligible."
fix = "A requires edge needs a code basis (a symbol, a file or an interface the dependent consumes); gates roll up only what they read. Drop the edge and record the decision when the basis is absent."

[gotcha.2215]
title = "A build_cmd that compiles sibling test targets inherits their API drift"
symptom = "18.1206.1 attempt 6 fixed its own call sites and failed because its build_cmd also compiled tests/unknown.rs and tests/budget_durable_limits.rs, which had drifted from ReceiptLookup and BudgetCreateIdentity for reasons outside the task."
fix = "Build only the gate's own targets; give each drifting sibling target to the task that owns it and add that task to requires where the gate needs it."

[gotcha.2216]
title = "Two CI checks can constrain the same workflow line in opposite directions"
symptom = "16.5.6 asserted runner-routing-check.sh exits 0, which demands the routed runner expression on publish-images.yml jobs, while publish-images.test.sh forbids CI_LINUX_RUNNER anywhere in that file; the workflow failed one check whatever it carried."
fix = "Pick the check that encodes the product rule (the test that owns the workflow) and list the jobs as excluded in the other; record the decision."

[gotcha.2217]
title = "Deleting an enum variant or adding a struct field leaves test targets outside the task's build red at main"
symptom = "10.98.13 deleted IntentKind::NativeOwnerRotation and the kms provider test still built it; 8.8.2 added Config.chain_receipts and the head attestation bin test still built the old initializer; four later attempts of two other tasks failed on those two lines."
fix = "Before deleting a variant or adding a required field, grep the workspace tests for its users and put every user in the task's touches or in a sibling task the gate requires; a task's done record must name the targets its symbol change compiles."

[gotcha.2218]
title = "A test that reads an operator fixture through an environment variable cannot qualify"
symptom = "18.1242.1 attempts 1 and 2 panicked at bootstrap_bind_layerx.rs:89 expecting PAXEER_X_AGENT_OWNER_FIXTURE, a document schema the attempt invented; nothing provisions such files where the gates run."
fix = "Tests serve their peers in-process on loopback from real types (anvil, served SequencerEndpoint), generate their keys and read nothing from the environment; a fixture-file test is rewritten, not supplied."

[gotcha.2219]
title = "Changing a shared struct in one crate breaks the binaries of every consumer crate"
symptom = "1e3b37aee (18.1243.1) removed current_height and prepare_budget from GrantTerms in layerx-mcp; layerx-agentd-host/src/payer.rs still used them, so the agentd binary stopped compiling and 9.94.1 failed two attempts on lines it never touched."
fix = "When a task changes a public struct or trait, grep every crate that names it and either add those files to touches or open the consumer port as its own task before the change lands."

[gotcha.2220]
title = "Kernel C tests build with -Werror=conversion"
symptom = "13.27.6 attempt 1 built the kernel but the test binary failed at lxp_test_sandbox_lifecycle.c:385 on an implicit unsigned int to uint8_t conversion, treated as an error."
fix = "Cast narrowing conversions explicitly in kernel tests; a warning in a test file is a verify failure."

[gotcha.2221]
title = "A build_cmd with --tests inherits every drifted sibling test target"
symptom = "18.1200.1, 18.1230.1 and 18.1159.1 implemented their steps and failed only because the crate's --tests build compiled revocation.rs, unknown.rs, migration.rs and owner_bootstrap.rs, which other tasks own."
fix = "Name the gate's own targets (--lib --test a --test b); record the drifted sibling once and leave it to its owner, unless the task's single gate binary includes the drifted module, in which case the task ports it."

[gotcha.2222]
title = "symbols must be code identifiers the graph indexes, never test titles"
symptom = "18.1113.1 attempt 7 passed its vitest gate and failed the completion check because symbols held the two flow test titles; the check resolves each entry in the code graph and the graph indexes functions and types, not test names in strings."
fix = "Name the exported functions or types the task changes or drives (provisionAccount, provisionDepsFromEnv); list test titles only under tests."

[gotcha.2223]
title = "--lib in a verify_cmd runs every unit test of the crate"
symptom = "18.1200.1 attempt 5 passed its five integration test targets and failed on six crate unit tests outside its files that fail on main (retired level names, activity submission index, TLS boundary binary, native terminal evidence)."
fix = "Name only the test targets the task owns in verify_cmd; keep --lib in build_cmd when the library must compile; record the crate's pre-existing unit failures once for their owners."

[gotcha.2224]
title = "A kernel case that hand-sets state does not prove the path a host call takes"
symptom = "13.27.6 drove terminal_begin and terminal_publish with a hand-set published usage result and passed, while the real sandboxed execute through lxp_programs_sandbox_execute still returned LXP_FATAL_INVARIANT for 13.27.1 attempt 34."
fix = "When a Go or host test reverts on a kernel status, the kernel task's case must enter through the same kernel entry point the host uses and run to the same terminal; a hand-set state proves only the step it sets."

[gotcha.2225]
title = "A test that opens a repository directory fails before any assertion when the directory is absent"
symptom = "4.24.3 attempts 6 to 8 failed on launchpad/spec/production-system/integration/migrations/150002.sql, a directory the launchpad tests read five levels up that was never imported; the readers in ranking-algo, security, social and indexer share it."
fix = "When a test resolves a path from the repository root, confirm the directory exists on main before the task is attempted; import the reviewed source set as its own commit (01d2bf319) rather than per task."

[gotcha.2226]
title = "go test -run with a pattern no test matches passes with no tests to run"
symptom = "4.24.3 attempt 9 declared TestFrozenV2OperationLooksUpCatalog in verify_cmd before writing it; go test printed no tests to run, exited 0, and only the completion check caught the missing symbol."
fix = "A verify that names a test must report it as run; treat testing: warning: no tests to run as a failure of the task, and check the test exists before the verify."

[gotcha.2227]
title = "A test that includes a source file by #[path] passes while the library never compiles it"
symptom = "13.3.1, 13.3.2, 13.3.4 and 13.3.5 landed modules under src/chain_evidence/ whose tests include the file by #[path]; chain_evidence.rs kept empty inline placeholders, the library shipped none of the types, and 13.3.7 and 13.6.4 failed to find them."
fix = "A task that adds a module file owns the parent file's mod line too: put the parent in touches, declare the file module, and have the test import from the crate so the gate exercises the shipped code."

[gotcha.2228]
title = "Aggregate gate scripts that log to a mktemp directory lose the cause"
symptom = "17.5.3 and 17.5.4 failed in make workspace-build and the record held only the evidence line, because run_gate.py wrote the step log under a temporary or .logs directory the qualification record does not keep."
fix = "Write per-step logs under the evidence_dir the manifest names (logs/waves/<n>) and echo the failing step's tail into the wave log (task 17.5.9); an evidence line without its log is not actionable."

[gotcha.2229]
title = "cargo build --tests compiles every test target of the crate"
symptom = "18.1172.2 owned two test files and its build failed in tests/agent_controls.rs, a target another task ports, because --tests builds all of them."
fix = "Name the owned targets in build_cmd (--lib --test a --test b) and keep --tests for crate-wide gates run once per wave."

[gotcha.2230]
title = "An acceptance clause owned by another task's retirement cannot be met early"
symptom = "16.0.3 ac_2 forbade lxp_daemon_lni in the make -n test dry run while the daemon still compiles cmd/layerxd/lxp_daemon_lni.c, retired by 5.50.1, which transitively requires 16.0.3; requiring it would have made a cycle."
fix = "Place a dry-run absence clause on the task that deletes the source, and check the requires graph for a cycle before adding a dependency to satisfy an acceptance clause."

[gotcha.2231]
title = "A task that changes a public signature owns every in-crate caller"
symptom = "13.6.3 rewrote verify_call to six arguments; cargo build --tests then failed in tests/lease.rs and tests/snapshot.rs, five callers outside the task's files, on attempts 3 and 4."
fix = "Grep the crate for the symbol before writing the task and put every caller file in touches with a do that ports it."

[gotcha.2232]
title = "Landing one half of a two-task API change breaks every dependent build"
symptom = "18.1243.1 changed GrantTerms and landed; the host payer port 18.1243.2 stayed held, and 9.12.4 (200 transitive dependents) failed twice in payer.rs before anything of its own compiled."
fix = "When an API change is split across tasks, the dependents require the consumer-side port, and a held consumer task is a frontier emergency, not a parking lot."

[gotcha.2233]
title = "A chain scan on an exported-state node must respect its earliest block"
symptom = "18.670.1 walked FundingSettled logs down to block 1 against a node whose genesis starts at an exported height, and eth_getLogs failed on ranges the node never held."
fix = "Read the earliest served block once and clamp every historical scan and indexer start to it; a fresh node also has no hourly settlement yet, so wait for the first one."

[gotcha.2234]
title = "A gate test must not read a file a later-wave task creates"
symptom = "16.0.3's chain-domain test read the golden file of 13.31.1, which requires 16.0.3; the gate could never pass before its own dependent landed."
fix = "Derive the expected value inside the test from the recorded decision and let the later task assert equality from its side."

[gotcha.2235]
title = "Compiling the gateway local qualification crate needs the parent-built core binary"
symptom = "8.94.6's build compiled services/platform/hosted/gateway/tests/local, whose build.rs panics without LAYERX_TEST_CORE_BIN, before any owned source compiled; another task had already hit the same panic."
fix = "Build layerx-core-boundary in the same build command and pass its path in LAYERX_TEST_CORE_BIN, or keep that crate out of the task build."

[gotcha.2236]
title = "Raising an executable version constant moves the published row and the test literal"
symptom = "9.12.2 set CONTRACT_VERSION to 2; the COMPATIBILITY.md row still said 1 and the drift test's unsupported-contract literal was 2, so 18.1200.1's migration target failed on a test it did not touch."
fix = "A version-constant bump owns the publication row and every test literal that was chosen relative to the old value (write CONTRACT_VERSION + 1, not a number)."

[gotcha.2237]
title = "Tests that set process environment variables race across test threads"
symptom = "10.20.3's startup tests each rewrote LAYERX_HUMAN_* through env::set_var and failed at startup in different components on different runs."
fix = "Hold a static Mutex for the lifetime of each test's environment fixture, give every test its own canonical root, and keep one opener per store root."

[gotcha.2238]
title = "Attempts that stop at implemented-not-qualified four times relaunch only when seeded by hand"
symptom = "A task with four or more such attempts never relaunched after its blocker landed on main; the automatic re-seed skips that class."
fix = "Seed the task explicitly with the finished attempt number and continue or requalify once the blocker is on main."

[gotcha.2239]
title = "A task packet built before a spec batch lands runs the old build_cmd"
symptom = "8.94.6 attempt 3 ran without LAYERX_TEST_CORE_BIN although the spec on main already exported it: the packet was assembled before the batch landed."
fix = "After landing a spec batch that changes a command, re-seed the affected task so the next attempt is assembled from the new spec."

[gotcha.2240]
title = "attach_external_signature takes the EVM SigningPreparation, not the kernel Prepared"
symptom = "services/human custody.rs:342 passes a kernel Prepared and a 65-byte custody grant; sign.rs:334 wants &SigningPreparation and the kernel pair wants 64 bytes, so neither compiles since 9.2.2."
fix = "Wrap the Prepared in a SigningPreparation (evm_signing.rs:145-180) and sign its signing_hash through the custody EVM action path (decision.1897)."

[gotcha.2241]
title = "MinIO no longer serves server binaries from dl.min.io or GitHub releases"
symptom = "curl of dl.min.io/server/minio/release/linux-amd64/minio answers 410 Gone and the GitHub release RELEASE.2025-10-15T17-29-55Z carries no assets, so a fixture that downloads minio fails."
fix = "Build it from source: GOFLAGS= go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z (several minutes, cache the binary)."

[gotcha.2242]
title = "A second node home with its own consensus key panics the primary with validator not in committee"
symptom = "Starting a standby node of the in-tree chain as a validator (the default mode) makes consensus/internal/consensus/state.go:2622 panic because its key is not in the genesis validator set."
fix = "Run the extra node home with mode full (consensus/config/toml.go:104); only the primary's key is in the committee."

[gotcha.2243]
title = "The v6120 halt export carries no perps, pricefeed or spot state"
symptom = "node/testdata/v6120-halt-export.json has null app_state.perps, pricefeed and spot, so the local node starts with the perps DefaultGenesis (no markets) and getMarkPriceDetails(11) reverts; the del(...) in v6120-node.sh:245 is a no-op."
fix = "Seed the dev genesis with the market, pricefeed and collateral state a test reads (task 5.98.3) instead of expecting it from the export."

[gotcha.2244]
title = "The gateway local fixture adapter's path needles changed when platform moved under services/"
symptom = "services/platform/hosted/gateway/tests/local/build.rs:57 panics with fixture path contract changed because boundary.rs:4 now climbs five levels to tests/support/lxgb_metadata.rs and build.rs still searches the four-level needle."
fix = "Update the needle and the repository climb together whenever a crate moves; the adapter asserts each needle exactly once."

[gotcha.2245]
title = "The bridge workflow check reads spec/paxeer-x-bridge/spec.kvx, which no longer exists"
symptom = "services/bridge/deploy/tests/workflow-check.sh fails at read(root, SPEC_PATH) before any check runs because 0209f71cc consolidated the bridge spec into spec/layerx-merge/spec.kvx."
fix = "Point SPEC_PATH at the consolidated spec; a check that reads a spec file must follow the spec consolidation."

[gotcha.2246]
title = "A monetary transfer effect without a ledger receipt is refused silently by the kernel"
symptom = "A sandbox execution ends LXP_FATAL_INVARIANT from the kernel receipt path with nothing on stderr although the module-context test of the same path passes."
fix = "receipt_bind_ledger_projection (src/protocol/lxp_kernel.c:2372-2395) refuses any monetary TRANSFER effect while ledger_receipt_present is false, which only the asset module sets; the programs escrow charge needs the binding of decision.1898, and module-context tests (lxp_programs_sandbox_execute) never reach that projection, so test the kernel path with lxp_kernel_execute_activity."

[gotcha.2247]
title = "Cargo builds a package's binaries for every integration test target"
symptom = "cargo test -p <crate> --test <name> fails with compile errors in src/main.rs or a module only the binary includes, although the test file touches neither."
fix = "Integration tests get CARGO_BIN_EXE_<name>, so every binary of the package is compiled first; a break in the binary blocks every --test gate of the package, and two tasks that each fix one break of the same binary deadlock unless one of them ports both."

[gotcha.2248]
title = "The wallet DID of a provisioned agent is did:layerx:<public key>, not the agent's registry identifier"
symptom = "A provisioning assertion expects the did:matrix:provisioning identifier of the test agent and the state returns did:layerx:<64 hex>."
fix = "services/wallet/gateway/src/provision/bind.ts:29 DID_PREFIX and state.ts:582 admit only did:layerx:<64 hex>; assert did:layerx:${agent.publicKeyHex} for provisioning states and wallet rows."

[gotcha.2249]
title = "A test target that stopped compiling hides its runtime failures until someone ports it"
symptom = "The first attempt that makes an old test target compile again fails tests that nobody changed."
fix = "When a shared test helper changes shape (raw_receipt_evidence, 351e3da14), targets that call the old shape stay unbuilt; expect the first compiling attempt to surface runtime contract drift and budget the repair for it."

[gotcha.2250]
title = "A task that edits a file another task deletes must land first or be superseded"
symptom = "A candidate passes its gate, and the merge onto the domain branch stops on a modify/delete conflict because a later-wave deletion landed first."
fix = "When the deleting task is already done, supersede the editing task (status superseded, dependents require the deleting task instead) rather than resurrecting the file through a continue seed; the seed step takes a path absent from the tree from the seed outright."

[gotcha.2251]
title = "A pinned sequencer leader outside the validator set panics the proposer"
symptom = "A local node with a primary and a sequencer standby stops at the first round above zero with validator ... not in committee (round_state.go:515/:537): the leader pin L[round mod len(L)] names the standby's consensus key, which is not a genesis validator."
fix = "Every key in app_state.sequencer.leaders must be a bonded validator; give the standby a third of the primary's power so the primary alone still commits."

[gotcha.2252]
title = "ledger_payment_call and bind_call disclose ledger, budget and bank EVM calls only"
symptom = "Wrapping a governance activity payload in ledger_payment_call returns MalformedPayload: decode_method decodes the 0x2bb1ae7c send(bytes) form with decode_send and knows no EVM form for other modules."
fix = "Submit non-ledger activities through the kernel signing pair (sign_disclosed, attach_kernel_signature, verify_kernel_before_submit) on the Prepared envelope."

[gotcha.2253]
title = "The agent daemon's authority fixture needs layerx-genesis-build beside layerxd"
symptom = "A real-authority test panics at tests/support/real_authority.rs:1011 with layerx-genesis-build is not built although layerxd is present in LAYERX_TEST_NATIVE_BIN_DIR."
fix = "Build both Makefile targets (layerxd layerx-genesis-build) and stage both binaries in the directory."

[gotcha.2254]
title = "A coverage test must read the real admission surface, not the tables named for it"
symptom = "A test counting frozen catalog operations in the four connected route tables reports seven missing although the gateway admits them: they live in a map local to allowedConnectedRoute."
fix = "Hoist the map into a package-level function the product reads and the test counts; name documented beyond-catalog templates explicitly rather than widening the catalog."

[gotcha.2255]
title = "Changing a crate's dependency list leaves every other workspace's Cargo.lock stale"
symptom = "After a path dependency is removed from one crate's Cargo.toml and only that workspace's Cargo.lock is refreshed, --locked builds in the eight other workspaces that pin the crate by path are refused with the lock file needs to be updated."
fix = "List every Cargo.lock whose layerx-agentd (or changed crate) entry exists (grep -l 'name = <crate>' over git ls-files '*Cargo.lock') and regenerate each in the same task."

[gotcha.2256]
title = "A kernel refusal still advances the host sequence"
symptom = "A keeper test asserting that a refused activity leaves the lxphost store byte-identical fails: NextSequence and the actor's identity sequence advance by one because HostExecute commits the branch after every kernel outcome, refusal included."
fix = "Compare the store excluding the global-sequence and identity-sequence keys and assert both advanced by one; only a request refused before the kernel runs leaves the store unchanged (decision.1907)."

[gotcha.2257]
title = "The sequencer replication log refuses the seal of an empty layer"
symptom = "With a standby configured the primary stalls at its first height: malformed wal entry: SEAL fromSeq 1 above toSeq 0, and the standby reports sequencer: no sealed layer."
fix = "An empty layer is FromSeq = ToSeq + 1; wal.go must refuse only FromSeq > ToSeq + 1 (issue #1299, task 18.1299.1). Single-node runs never log the seal, which hides the defect."

[gotcha.2258]
title = "The real-authority test fixture resolves the repository root one level short"
symptom = "migrations listing: NotFound at tests/support/real_authority.rs:46 although migrations/ exists; build/bin is searched under services/."
fix = "repository_root() takes ancestors().nth(3) of CARGO_MANIFEST_DIR, correct before the agent moved to services/agent; nth(4) is the repository root (issue #1298, task 18.1298.1)."

[gotcha.2259]
title = "A package-wide --tests build is gated by every stale test file of the package"
symptom = "A task whose build_cmd is cargo build -p <crate> --tests fails on a test file it does not touch (archive.rs: FundsDispositionEvidence has no field verification_level)."
fix = "Find the pending task that owns the stale file and add it to requires; do not widen the failing task's touches."

[gotcha.2260]
title = "Deleting a kernel definition file passes the archive gate and breaks the binary link"
symptom = "After src/guarantor/lxp_dissent.c was deleted, make paxd-native-libs and the Go module gate passed, yet make build/bin/layerx-guarantor fails with undefined reference to lxp_guarantor_withhold and every Rust build script that builds the core panics."
fix = "A retirement task that deletes definitions must grep src, include and cmd for every deleted symbol (not only tests) and its build_cmd must link a binary that pulls the object, e.g. make build/bin/layerx-guarantor (issue #1300, task 18.1300.1)."

[gotcha.2261]
title = "lxp_receive_environment is a live kernel type, not a retired symbol"
symptom = "A retired-uses scan over tests/ for lxp_receive_environment fails on tests/codec and tests/ledger suites that legitimately use the receive environment of include/layerx/lxp_ledger.h."
fix = "Scan for the retired path (tests/test_gateway_receive.c) and the lxp_grant_store symbols only; exclude the codec, crypto, fuzz, chain, daemon, bridge and explorer suites as test_retired_guarantor_duties.py does."

[gotcha.2262]
title = "A second task for one issue reuses the issue's req block"
symptom = "check-draft.py accepts only task.18.<issue>.1 ids, so a follow-on task for the same issue cannot pass it and an invented req id (req.1812912) does not match the spec convention."
fix = "Follow the 18.1172.2 pattern: task.18.<issue>.k with reqs ['18<issue>.k'], ac_k appended to [req.18<issue>] and [acceptance.18.<issue>.k] with req = '18<issue>.k'; normalise at assembly time."

[gotcha.2263]
title = "An enum variant rename must be grepped across every crate's tests, not only the crate's own"
symptom = "InvalidationReason::CapabilityGrantRevoked became GrantRevokedOnChain in layerx-agentd; the layerx-mcp scope test kept the old name and every layerx-mcp --tests build fails (issue #1301)."
fix = "grep -rn the old variant across services/ before publishing a rename; a package-wide --tests build of a dependent crate is where the leftover surfaces."

[gotcha.2264]
title = "Check src/ before scoping a retired-symbol scan to a symbol"
symptom = "16.97.1 do_6 scoped the kernel scan to lxp_grant_store on the assumption it was retired; it is live (src/ledger/lxp_grant_store.c) until 1.12.1, so attempt 4 failed on seven live uses."
fix = "grep include/ and src/ for the symbol's definition first; if it is live, the scan may only cover the files the task edits (decision.1911)."

[gotcha.2265]
title = "A task that changes a struct's fields must own, or hand off, the shared test support that fills them"
symptom = "13.4.5 removed the kernel-batch fields from DeploymentProof and ProgramStateProof; tests/support/mod.rs, shared by seven test targets, stopped compiling and the package-wide --tests build failed every attempt."
fix = "Build only the task's own --test target (decision.1910) and make the task that rebuilds the shared support require the type change; record the interval in which the other targets do not compile."

[gotcha.2266]
title = "Symbols a task removes, and documentation headings, fail the graph check as not defined"
symptom = "cg spec done refuses a task after a passing verify with 'symbol X not defined in the graph' (14.29.3 named the three functions it deleted; 18.1259.1, a documentation task, named two headings)."
fix = "A task's symbols list names code definitions that exist after the task. Removed names are described in do_ lines only; a documentation-only task declares symbols = []."

[gotcha.2267]
title = "A symbol defined twice in one file fails the graph check as ambiguous"
symptom = "cg spec done reports 'symbol ProgramOperations::simulate ambiguous: 2 definitions (ops/program.rs)' when the generic impl and the SequencerEndpoint impl both define the method (18.1286.1)."
fix = "Declare only names with one definition; the touched file carries the change. Check with grep -n 'fn <name>' before listing a method of a type that has several impl blocks."

[gotcha.2268]
title = "An explorer type change must port every caller because the build is the app-wide type check"
symptom = "cd apps/explorer && yarn lint:tsc fails in spec, mock and page files outside touches as soon as a shared union or interface is narrowed (14.31.1 nine errors in seven files; 14.33.1 five errors in three files)."
fix = "Before narrowing a shared TS type, grep its literals and members across apps/explorer and add every caller to touches with a do_ line that ports them; the graph check refuses touched files that are not declared."

[gotcha.2269]
title = "A reproducibility test over generated code fails until the checked-in files come from the pinned toolchain"
symptom = "TestBufGenerateMatchesCheckedInGo reports 104 .pb.go files differing in gzipped FileDescriptorProto size and import blocks although no .proto changed (7.29.2 attempts 1-3)."
fix = "Generated code is regenerated with the pinned plugin in the same task that adds the comparison; the comparison is never normalised. List the regenerated files in touches and build their packages."

[gotcha.2270]
area = "spec/layerx-merge/qualification.kvx"
symptom = "The qualification log on main at d028bd92b and 5b9b60520 held one character per line (2.1 MB then 4.3 MB) and every finding appended after it inherited the interleave."
cause = "The batch wrote the log with '\\n'.join(qual) although qual is one string, so every character was followed by a newline; the next batch read the interleaved text as its base and doubled it."
do = "Write the log with open(QUAL, 'w').write(qual) exactly as spec-batch-105 does, and have spec-lint refuse a qualification.kvx whose line count exceeds three times its finding count. Restore an interleaved file with text[0::2] after checking set(text[1::2]) == {'\\n'}."

[gotcha.2271]
title = "Two merged tasks can contradict each other and surface as an unrelated failure in a third task's gate"
symptom = "18.1279.1's recorded challenge (18.1129.1) is refused by the 20-byte offer contract 9.16.1 wrote; 3.93.1's 137-byte oracle transport is refused by the abi-1 perps interface 1.24.1 registered; 2.26.4's dispute path answers LXP_ERR_MODULE_DISABLED because no task bound the service runtime."
fix = "Record one cross-task finding naming producer and consumer with their commits, open an issue task that owns the producer file, add it to the blocked task's requires, and re-qualify the blocked candidate unchanged once it lands; never patch the consumer's test around it."

[gotcha.2272]
title = "A recovered panic inside a commit listener leaves a validator that keeps proposing with a fenced sequencer"
symptom = "12.35.4 attempt 8: Driver.OnCommit failed at the first sequenced commit, the listener fenced the executor and panicked, node/abci.go recovered it into a log line, and every Seal afterwards answered 'executor fenced by a later lease' with no lease involved."
fix = "A commit listener returns an error that Commit propagates so consensus halts the node with the cause (task 18.1307.1); a diagnosis keeps whole node logs and greps for 'panic recovered in commit listener' and 'fenced' before suspecting the topology."

[gotcha.2273]
title = "A library compile break in a shared crate fails every dependent task's build until the port task lands"
symptom = "After 42c1fea30 (13.4.5) changed the registry verifier API, layerx-agentd stopped compiling and 18.1302.1, 18.1286.1, 18.1275.1, 10.20.3 and 18.1172.2 each failed their build on the same 13 errors across repeated attempts."
fix = "Open the port task first (18.1304.1), add it to requires of every open task whose build or verify names the broken crate, and hold their attempts until it is on main; an attempt against a broken crate is wasted."

[gotcha.2274]
title = "Re-recording a shared fixture with many consumers: land the consumers first in a form that is invariant to the change"
symptom = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json has about 35 consumers in eight crates that rotate or permute the recorded PaymentExact topics; re-recording it first would leave about 25 test targets red until every consumer task lands."
fix = "Make each consumer derive its expected values from the recorded inputs (here the payExact calldata words) so it passes on the old and the new recording, land those in wave 0, then re-record the fixture together with its byte-equal copies and pinned literals in one revision."

[gotcha.2275]
title = "A requirement on a done task that sits in a later wave is a bad_ref for the plan validator"
symptom = "18.1304.1 (wave 0) requiring 13.4.5 (wave 23, done) and 18.1305.1 requiring 1.24.1 (wave 23, done) raised bad_refs 2 although both requirements were satisfied."
fix = "Do not list a done task from a later wave in requires; cite its commit in a do line and give the new task an empty requires or requires in its own or earlier waves."

[gotcha.2276]
title = "Retiring a host read must retire its keeper caller in the same revision"
symptom = "a0a08d298 (1.25.2) deleted Host.ReadIdempotentReceipt while Keeper.ResultByIdempotency (modules/layerxauth/keeper/views.go:167) still called it, so every Go build that links the layerxauth keeper, including go build ./node/..., failed for four tasks' attempts (issue #1308)."
fix = "When a task deletes an exported method, grep the whole module tree for callers before its verify; a caller outside the touches is a stop condition that needs its own task (18.1308.1) and a requires edge, not a silent omission."

[gotcha.2277]
title = "A test that asserts the retired idempotency replay cannot pass after the kernel stopped the lookup"
symptom = "modules/layerxauth/keeper tests assert types.ErrIdempotentReplay on a second submission of the same payload, but 787dd93be (1.2.1) stopped kernel idempotency lookups, so the replay is a reused account sequence (-301) and the stored-receipt comparison has no store to read."
fix = "Follow decision.1718: migrate the consumer to the sequence guard and the returned receipt under an explicit decision (decision.1932); never flip the expected code to whatever the kernel answers without that ruling."

[gotcha.2278]
title = "Hand edits inside generated protobuf or gateway files are reverted by the reproducibility task"
symptom = "7.29.2 regenerated 104 files and the build failed because modules/xweb/types/query.pb.go carried 13 hand-written adapters (4d1f8830d) and sdk/x/bank/types/query.pb.gw.go a hand-reordered registration (5b9c0e997)."
fix = "Put adapters in codec.go and binding order in the .proto; a generated file is committed only as unedited generator output (6.68.2, 7.26.5)."

[gotcha.2279]
title = "A renamed constant in a shared crate breaks test files of other crates that pin the old name"
symptom = "18.1211.3 attempt 1 failed to compile layerx-ap2/tests/sequencer_settlement.rs:21 on PORTABLE_RECEIPT_FORMAT_V2, renamed to PORTABLE_RECEIPT_FORMAT by 2c4ecdb63 (11.29.4)."
fix = "When a task's touches include a test file of another crate, build the test target first and fix pinned imports from the current crate exports before any behaviour change."

[gotcha.2280]
title = "A layerxauth replay through the keeper never reaches the identity-sequence refusal"
symptom = "A replay test expected LXP_ERR_SEQUENCE_REUSED (-301) for every second submission and received LXP_ERR_AUTH_SCOPE (-204) for a refused flow and for a second revoke."
fix = "Keeper.execute reads the actor's sequence anew per call (execute.go:22) and the kernel consumes it only on LXP_OK; -301 comes from the duplicate grant_id in lxp_grant_store_put, so assert the code the kernel answers for the flow (decision.1933)."

[gotcha.2281]
title = "An attempt that fails on a defect in the task text is relaunched with the same text"
symptom = "Four attempts of one task failed identically within an hour because each continuation reproduced the payload the task text prescribed."
fix = "When the failure needs a spec change, set the task aside before the next attempt starts, land the do line, then continue the latest candidate with a note that names the do line."

[gotcha.2282]
title = "A candidate bundle is thin and cannot be cloned on its own"
symptom = "git clone of a task bundle fails with 'remote transport reported error' because the bundle assumes the base commit."
fix = "Clone the repository once with --shared --no-checkout and fetch the bundle into refs/bundles/<task>-<attempt>/*, then read files with git show <ref>:<path>."

[gotcha.2283]
title = "tests/protocol/lxp_test_kernel reports only through its exit code"
symptom = "The suite exited 1 with an empty stderr tail and the failing case could not be read from the log."
fix = "Every check is a bare return 1 (tests/protocol/lxp_test_kernel.c:422-426); read the cases in main's order against the header constants they hard-code, as decision.1934 did for capacity_checks."

[gotcha.2284]
title = "A build with --tests compiles every stale test target of the package"
symptom = "A task whose files were complete failed its build in a test file owned by another task because cargo build --tests compiled it."
fix = "Build only the test targets the verify runs (--test <name> per target); record the stale file against its owner."

[gotcha.2285]
title = "An attempt that started before a dependency's fix reached main fails on the fixed line again"
symptom = "18.1309.1 attempt 4 and the four 17.5.x gate attempts re-failed on views.go:167 / main.rs:1768 although 18.1308.1 and 18.1310.1 were on main by the time they were read; their bases (53d78901c, 710592c26) predate the fix commits (510b28cc7, 57f057042)."
fix = "Before reading an attempt's failure, compare its base_revision with the fix commit (git merge-base --is-ancestor <fix> <base>); when the base predates it, the answer is a re-qualification on a newer base and no further reading."

[gotcha.2286]
title = "A first-time compile of a target exposes the older breaks beneath the blocker"
symptom = "After a narrowed build or a cleared blocker lets a test target compile for the first time in several attempts, the attempt fails on an older, unrelated break in the same target (session_keys.rs:248 once the layerx-agentd half of 18.1228.1 passed; migration.rs and revocation.rs once --tests reached them in 18.1308.3; expiry.rs:68 once the registry dependents were checked in 13.4.6)."
fix = "Before writing a re-qualify-unchanged note, run git log -S on every symbol the target calls that changed since its fixture was written, expect one new break per cleared blocker, and narrow build_cmd to the targets the verify runs."

[gotcha.2287]
title = "A candidate whose only extra file is its declared planned test is held as out of scope"
symptom = "12.35.5 attempt 2 (6805e8616) passed its build and verify, yet the merge step held it because node/sequencer/commit_release_test.go, the task's planned_paths entry, is not in touches; the gate had admitted the file because its allowed set is touches plus planned_paths."
fix = "The merge-scope check compares the candidate's changed files with touches plus planned_paths, the same set the gate admits; a held candidate whose only extra files are planned paths is re-collected, not re-run."

[gotcha.2288]
title = "A task reopened in the same minute as the batch that added its prerequisite was admitted against the previous plan"
symptom = "10.20.3, 17.5.1-4 and 18.1200.1 were reopened right after 9f8c07033 added 5.7.3 and 10.16.4 to their requires; the scheduler re-reads the plan every four minutes and admitted them against the plan it held, and each attempt stopped at cg spec start because the prerequisite was not done"
fix = "After a spec batch that adds requires, reopen the affected tasks only once the plan digest on the board matches the new spec digest; a task admitted against a stale plan costs one attempt and returns to pending by itself"

[gotcha.2289]
title = "Calling the gate build helper with --help runs the whole build"
symptom = "18.1211.2 attempt 6 and 18.1308.2 attempt 5 each spent one of their builds on hf-build --help, which ignores its arguments and runs the build of the untouched tree, leaving one build for the real tree"
fix = "The build helper answers --help and -h with its usage and exits 0 without building; read the task section for the build and verify commands instead of probing the helper"

[gotcha.2290]
title = "The scheduler loads the task plan once per process, so a spec batch took effect only after a restart"
symptom = "The plan digest on the board stayed at the value of the last restart while three batches landed; gotcha.2288 assumed a four-minute re-read that does not exist, and a task whose touches grew in a batch would have been held for changing files outside its scope until the next restart"
fix = "The scheduler now re-parses the plan when the spec file has changed and been still for five seconds, re-syncs the board and logs plan_reloaded; after a batch, wait for that line (or for the board digest to equal the plan digest) before reopening the affected tasks"

[gotcha.2291]
title = "The in-tree node starts only when a file under the task's paths already names LAYERX_TEST_PAXEER_CHAIN_ID before implementation"
symptom = "9.0.3 attempt 5 wrote the first reader of LAYERX_TEST_PAXEER_CHAIN_ID inside its own paths, so the environment, which scans those paths once before implementation, started no node and the chain-id test failed by name"
fix = "A task whose own test is the first reader of the variable gets the node on a re-qualify of the unchanged candidate, where the paths are applied before the scan; record the attempt and re-qualify instead of changing the test"

[gotcha.2292]
title = "A touches entry naming a directory did not cover the files inside it"
symptom = "13.8.1 attempt 6 (efa450e95) passed its build and verify and was then refused because the 28 re-recorded fixture files under programs/fixtures/pay5/native-token and native-merchant were compared against the touches entries as exact file names."
fix = "The scope check covers a changed path when it equals a touches or planned_paths entry or lies under an entry that names a directory; the attempt 6 candidate is re-qualified unchanged."

[gotcha.2293]
title = "A pom under sdk/integrations resolves com.sidiora.layerx:layerx-sdk only after sdk/platform/jvm/pom.xml is installed"
symptom = "mvn -f sdk/integrations/android/pom.xml (or spring) fails with 'Could not resolve dependencies ... com.sidiora.layerx:layerx-sdk:jar:0.1.0' before compiling anything, because the integration poms declare the SDK as a plain dependency and no reactor builds it."
fix = "Run mvn -q -f sdk/platform/jvm/pom.xml -DskipTests install first; the environment that runs the gates does this once for every com.sidiora.layerx dependency whose pom is in the tree, and the task's build and verify commands stay as declared."

[gotcha.2294]
title = "yarn install in apps/explorer exits 1 from the husky prepare hook where the tree is not a repository root"
symptom = "yarn install under apps/explorer ends after 700 to 1100 s with rc=1 and 'husky - .git can't be found' although every package was installed."
fix = "Set HUSKY=0 for dependency installs; the gates never need git hooks, and the duration is the install itself, not the hook."

[gotcha.2295]
title = "A touches entry that names a directory covers every file under it, and a cargo target directory beside a Cargo.toml is build output"
symptom = "A task whose touches list a directory (a receipts folder) or whose verify compiles a test crate in place was refused with 'files changed outside scope' naming files under that directory or under <crate>/target/ although its verify passed."
fix = "Declare a directory deliberately when a task owns a whole folder; never list a target directory in touches; a verify that compiles a crate in place leaves <crate>/target, which is generated output, not a change."

[gotcha.2296]
title = "A keeper removed from the application left its upgrade handler calling a zero value"
symptom = "5.7.1 removed the LayerXAnchorKeeper construction and 5.41.3 its store key while 5.6.5's v7.0 handler kept RetireAtMerge (node/upgrades.go:490); 5.16.3, 5.6.9 and 6.47.1 then panicked with a nil pointer dereference at modules/layerxanchor/keeper/keeper.go:31 on every v7.0 application, five attempts spent on one wiring gap."
fix = "Removing a keeper, a store key or a mount is complete only when every upgrade handler and test that calls the keeper is changed in the same task or ruled by a decision; decision.1954 and task 5.7.5 keep the anchor keeper and store until the store-delete step."

[gotcha.2297]
title = "A Maven profile that adds sample sources compiles files owned by a later task"
symptom = "15.4.7's build and verify run with -Psample, which test-compiles src/sample/java; RelayReceiptResolver.java there still used the retired AuthorizedReceiptBatch and belonged to 15.4.8, which required 15.4.7, so the gate could not pass in either order (attempts 3 and 4)."
fix = "Every source a gate compiles belongs to the task that runs the gate or to a task it requires; the resolver port moved into 15.4.7 as do_6 and 15.4.8 kept only its test."

[gotcha.2298]
title = "go test does not run the copylocks analyzer, so a by-value copy of the application struct passes go test and fails a sibling's go vet"
symptom = "A done task's test copied *testkeeper.EVMTestApp by value to swap one keeper; its go build and go test gates passed. A later task whose build_cmd is go vet over the same package exits 1 with 'assignment copies lock value to application: node.App contains sync.RWMutex' before its own test compiles, in a file outside its touches."
fix = "Build the precompile's keepers from a test-local type that embeds utils.Keepers from EVMTestApp.GetPrecompileKeepers() and adds the module keeper method; put the fix in the touches of the first vet-gated task of the package and make its siblings require it (decision.1956)."

[gotcha.2299]
title = "A source file compiled into a test binary that no task owns breaks every task whose gate builds that binary"
symptom = "Three retyping tasks ported their named callers but not services/agent/tests/qualify/fabrication.rs, which is mod fabrication of the agent-qualification-gates bin; every qualify gate test builds that bin through CARGO_BIN_EXE or --bin, so three sibling tasks failed the same cargo build four times each with E0432 on an import none of them touches."
fix = "Give the orphan file its own small port task that requires the retyping tasks, make the gate-sharing siblings require it, and re-qualify their candidates unchanged; narrowing build_cmd does not help when the verify builds the same binary (decision.1955)."

[gotcha.2300]
title = "paxd init --mode validator writes grpc.enable false, so the node never registers local services and its EVM HTTP server is never built"
symptom = "A standby node created with paxd init --mode validator committed blocks but refused every EVM RPC connection; its halt log lacked 'Stopping EVM HTTP Server'. app.toml from that init has api.enable, grpc.enable and state-store.enable false, and sdk/server/start.go:369-376 calls RegisterLocalServices, the only place that builds the EVM server, only when grpc or api is enabled."
fix = "Set grpc enable true in the node's app.toml beside the grpc address; evm http_enabled alone is not enough."

[gotcha.2301]
title = "A whole-application tsc as a task build gate fails on sibling-owned consumers of the types the task deletes"
symptom = "An explorer task deleted five exported type names and repointed stubs; yarn lint:tsc then reported 20 errors in 17 files, none in the task's touches, because the pages, tables and specs that import those names belong to later sibling tasks."
fix = "Narrow the task's build to tsc over its touched files and their imports with the tsconfig flags written out, give each sibling the same narrowed build, and keep the whole-application check on the last task of the family, which requires every consumer task."

[gotcha.2302]
title = "A schema validator that requires type names by string survives the deletion of those types and fails on a schema that is correct"
symptom = "A code generator's lifecycle check required five type names that a later schema task deleted and replaced with one variant; the generator never read the names into any output, so the schema change passed its own gate and the generator's gate failed with 'missing type.X.required' on a correct schema."
fix = "When a schema task deletes or renames types, grep every tool that validates the schema by name (sdk-gen validate_* functions) and port the check in the same decision; do not re-add the deleted types to the schema."

[gotcha.2303]
title = "An address-uniqueness loop over the precompile name table refuses the documented alias handoff"
symptom = "The name table records three names (a camel-case name, its lower-case alias and the successor name) at one address under a recorded decision, and a sibling test requires exactly that; a registration test's loop over the same table asserted every address unique, so the two tests could never pass together."
fix = "Teach the uniqueness loop the one documented shared address and the exact set of names allowed there; keep every other shared address a failure and leave the alias assertions as written."

[gotcha.2304]
title = "A do line that asserts two differently-typed ABI events share a topic cannot be implemented without changing a frozen contract table"
symptom = "Two precompiles declare StreamRateUpdated with different parameter lists, so their topic0 values differ by construction and both are frozen by done gates; a later task's do line said to assert they match, and the literal implementation failed with expected one hash, actual the other."
fix = "Assert each event's topic0 against its own canonical signature and that the two differ; supersede the do line with a decision instead of touching either ABI or contract table."

[gotcha.2305]
title = "A deleted generated file that one hand-written file still reads breaks every gate that compiles the package, including gates of unrelated tasks"
symptom = "A retyping task deleted a generated Go file; another file in the same package kept reading a symbol from it, so the package has not compiled since, and four attempts of a task whose verify runs one test in that package all stopped at the same undefined symbol without reaching their own test."
fix = "Give the dangling read to the task that owns the hand-written file, order the dependent task behind it by requires and a decision, and re-qualify the dependent candidate unchanged once the package compiles."

[gotcha.2306]
title = "Comparing a recovered secp256k1 transaction sender with an Ed25519 custody descriptor key refuses every valid request"
symptom = "A creation path compared the left-padded sender recovered from a signed EIP-1559 transaction with KeyDescriptor.public_key, which is the Ed25519 verification key of the same custody secret; the two are points on different curves, so the check refused deterministically even when the fixture derived both from one secret."
fix = "Compare the sender with the custody signer's EVM wallet (CustodySigner::evm_wallet) and carry the left-padded wallet as the evidence owner key; never compare across key classes."

[gotcha.2307]
title = "swift build compiles no test target, so a test that reaches a fileprivate library helper first fails at swift test"
symptom = "A Swift SDK test used a Data.hex helper that is fileprivate in one library file and private in another; every build leg passed because swift build never compiles the test target, and the error waits for swift test, which only the verify runs."
fix = "Format bytes inline in the test (map over the bytes with %02x and join) or add a test-target helper; do not widen the library helper's access to satisfy a test."

[gotcha.2308]
title = "A name lookup that re-runs the keeper-free dry run after a real-keeper dry run panics on a constructor that needs keepers"
symptom = "GetPrecompileInfoE ran InitializePrecompiles(true, EmptyKeepers) whenever Initialized was false, even though a completed dry run with real keepers had already filled the name table; a merge precompile constructor that requires its keeper set refused the empty set and every lookup after that dry run panicked."
fix = "Serve the recorded table entry first and run the keeper-free dry run only for an unrecorded name when nothing has been recorded; keep the unknown-name error path intact."

[gotcha.2309]
title = "Re-running a task before the base carries its spec amendment repeats the recorded failure"
symptom = "Three tasks were re-run minutes after their spec amendments were written; each run started from a base revision that predated the amending commit, saw the old do lines and touches, and failed exactly as recorded, adding nothing."
fix = "Before re-running a task whose spec was just amended, confirm the base revision is at or after the amending commit (and after the owner task's commit when the amendment adds a requires); otherwise wait for the base to advance."

[gotcha.2310]
title = "A static precompile's store gas lands in the transaction's infinite meter and is never billed"
symptom = "A precompile that implemented only RequiredGas and Run charged its flat row while its body did state-proportional host work; inside a transaction the context meter is an infinite meter whose consumption nobody reads, so the extra KV gas was unpaid and grew with the store on every call."
fix = "When a precompile body does work proportional to state, serve it as a DynamicGasPrecompiledContract: deduct the row, run under a meter limited to the remainder and return what the meter leaves; keep the rows as the base charge."

[gotcha.2311]
title = "Porting a signer to an approval surface that submits the transaction itself cannot answer a detached signature"
symptom = "A do line asked to bind an agent signer to a wallet EVM approval, but the approval route signs, serialises and submits the raw transaction and answers tx_hash and receipt; the middleware consuming the signer needed a detached signature string, so the port could not compile without a stand-in across four attempts."
fix = "Before writing a port, check that the target API answers the artifact the consumer submits; if the flow already completes inside the other service, remove the provider path instead of inventing a signature."

[gotcha.2312]
title = "A receipt gate whose key list defaults to empty refuses every receipt while its unit test passes"
symptom = "A mobile receipt gate took receiptKeys with a default of [] and the integration entry point passed none, so every gate built through the public API refused every receipt; the gate's own test loaded fixture keys itself and passed."
fix = "Every constructor path of a gate needs a configuration-held key source and a refusal when none is declared; the test that loads keys itself does not cover the public entry point."

[gotcha.2313]
title = "A daemon that admits a call and then stops its executor without exiting answers empty lookups until the client times out"
symptom = "layerxd --serve admitted a program call and the executor stopped inside the batch apply; the process stayed alive, the serve loop kept polling only the network server, and every receipt lookup returned an empty envelope for 30 s until the test panicked without printing the daemon's stderr."
fix = "Keep the daemon's stderr next to the verify log and read its 'execution failed at sequence ... with result ...' line first; a stalled executor with a live process looks like a missing receipt."

[gotcha.2314]
title = "Comparing RequiredGas with metered KV gas measures the row, not the charge"
symptom = "A gas-bound test compared a precompile's static RequiredGas with the KV gas the call metered and failed for every method, because RequiredGas is only the fixed row of a dynamic charge."
fix = "Measure the charge as supplied gas minus the gas the EVM call leaves, convert through GetCosmosGasLimitFromEVMGas, and compare that with the metered store gas."

[gotcha.2315]
title = "A -p lib or test build never compiles a binary declared in another crate with autobins = false"
symptom = "A one-line change to an agent daemon's main.rs passed its task gate on -p <crate> --test <name>, because the crate sets autobins = false and the binary is declared in a sibling host crate pointing at that main.rs; two later tasks whose gates build the binary failed with E0277 at that line."
fix = "A task whose touches include a file that only a binary target compiles names that binary in its build_cmd; check Cargo.toml for autobins = false and [[bin]] path declarations in sibling crates before trusting a lib gate."

[gotcha.2316]
title = "tsc with files on the command line ignores tsconfig.json, so generated declaration files must be listed as roots"
symptom = "A narrowed type check listing the touched files plus the global declaration roots failed with TS2724 on a type that only a generated declaration file declares; the whole-application check picked that file up through tsconfig include, the narrowed one did not."
fix = "When narrowing a tsc build to explicit files, copy every declaration root the sibling tasks list, including generated ones, and follow the import closure from the first root for module augmentations."

[gotcha.2317]
title = "A registration test's hard-coded ABI counts go stale when later tasks grow the ABI without running it"
symptom = "A precompile registration test asserted 9 methods and 3 events; three later commits grew the ABI to 12 and 4 with gates that never ran the test, so the first task to add it to a verify found a failure on main unrelated to its own change."
fix = "A task that changes an abi.json runs the registration test that counts it; when a count assertion disagrees with a declared ABI grown by completed tasks, rule which is the authority in a decision and set the test to it rather than leaving a known-red test on main."

[gotcha.2318]
title = "A pending-tag read on the sequencer errors between every proposal and its commit by design"
symptom = "A local-node receipt test read the sender's pending nonce once and failed with 'pending block unavailable: sequencer: no block is open'; the primary had sealed the open block for the next proposal and had not yet committed it, a window that exists for every block."
fix = "Pending-tag reads and raw sends against the sequencer repeat on exactly that error text until a block is open, as the committed fixture does; any other error fails at once and no asserted value changes."

[gotcha.2319]
title = "Deleting a file another crate include_str!s passes a gate that builds only a tool crate"
symptom = "A cleanup task deleted a schema file and qualified with the build of a small boundary-check tool crate; a library crate in the same tree still include_str!'d the file at its first lines, so every crate depending on that library failed to compile from the merge on, and the next attempts of unrelated tasks in three workspaces died in their build step."
fix = "Before deleting any non-source file, grep the tree for include_str!, include_bytes!, include! and path-literal references to it, and let the deleting task build the crate that holds the reference, not only the crate that asserts the absence."

[gotcha.2320]
title = "A task that deletes a symbol must not list it under symbols"
symptom = "A two-line deletion task built and passed its test, then the done gate refused because the task block named the deleted constant under symbols and the graph check requires every listed symbol to be defined after the change."
fix = "For a deletion, leave symbols empty or name a symbol that remains defined (a test function the verify runs); the interfaces list may still cite the retired item because it is an index entry, not a graph check."

[gotcha.2321]
title = "A task that commits regenerated files must require the template task and name the real generator"
symptom = "Three attempts of a regenerate-the-client task failed with the same twelve type errors: the task required a generator task that never changed the template literal, and its do line named a different generator that does not write those files."
fix = "Before writing a regenerate task, grep the generator template for the old literal and the Makefile for the target that writes the output paths; require the task that changes the template and name that generator and target in the do line."

[gotcha.2322]
title = "View-method revert expectations go stale when keeper missing-record semantics change"
symptom = "A precompile gas-table test expected budgetRemaining of a zero id to revert; the keeper had been changed to answer zero for a missing budget, three other tests and an acceptance criterion froze that, and the subtest failed on every base."
fix = "When a view's missing-record behaviour changes in the keeper, grep the precompile tests for revert expectations on that view and realign them in the same wave; assert the succeeding view like the existing progressHighWater branch does."

[gotcha.2323]
title = "A re-recorded fixture hash has literal copies in sibling crate tests"
symptom = "A fixture re-record task passed its Go legs and failed a Rust unit test whose const held the old txHash by value, in a file outside the task's touches."
fix = "Before re-recording a fixture, grep services/ and sdk/ for the old hash bytes and add each literal copy to touches; the literal is updated, not read from the fixture."

[gotcha.2324]
title = "Block-view receipt validation decodes every consensus transaction as a TxRaw"
symptom = "A local-node receipt test passed its pending nonce read and then failed every committed block view with 'decode consensus transaction 0 ... expected 2 wire type, got 0': transaction 0 of a sequenced block is the MsgSequenceBatch, which the rpc receipt validation fed to the sdk TxDecoder."
fix = "A path that decodes block.Block.Txs must treat index 0 the way ProcessProposal does (DecodeSequenceBatchTx first); before trusting an rpc test suite on sequenced blocks, grep it for EncodeSequenceBatchTx and add a batch-headed block case."

[gotcha.2325]
title = "A validator that reads a table a prior task emptied fails every commit on the path"
symptom = "Every maintenance batch failed with LXP_FATAL_INVARIANT because the settled snapshot validator required a latest receipt from the state idempotency table, whose only writer was removed two months earlier; no verify_cmd ran the two tests that commit maintenance batches, so the breakage was found by a daemon test in another domain."
fix = "When a task removes the last writer of a store table, grep src/ for every reader of that table (including static validators) in the same task and name the authority the reader uses instead; schedule the tests that exercise the path in some verify_cmd."

[gotcha.2326]
title = "A verify leg that selects --lib on a binary-only package fails after every other leg passed"
symptom = "A fixture re-record task passed nine verify legs and failed the tenth with 'no library targets found' because the service package declares only a [[bin]] and the verify_cmd asked for --lib; the leg had never run because earlier attempts stopped at earlier legs."
fix = "When writing a cargo test leg for a package, read its Cargo.toml: a package with only [[bin]] takes --bin <name>, a package with [lib] takes --lib; check every leg of a chained verify_cmd against its target list before the first attempt."

[gotcha.2327]
title = "A vector consumer task that its producer lists as a requirement never finds the vector"
symptom = "A decoder task failed three times with 'No such file or directory' on a shared test vector because the task that writes the vector listed the decoder as a requirement, so the file could only appear after the test that reads it had passed."
fix = "When a task reads a planned file, the task that creates it must be in that task's requires and in an earlier or equal wave; check the producer's planned_paths against the touches and do lines of every consumer before landing the requires lists."

[gotcha.2328]
title = "A task that deletes or reshapes a public type leaves unlisted callers red on main"
symptom = "Tasks 13.4.5 and 13.4.6 replaced the ProtocolDeploymentVerifier head model and completed on their own gates; layerx-platform-registry (31 errors) and layerx-human-security-provider (2 errors) stayed red on main, every gateway task then failed the build of its dependents, and the aggregate gate failed in human-build; attempts of three tasks repeated the same failure."
fix = "Before a task deletes or changes a pub item, grep every workspace (programs, services/agent, services/platform, services/human, tools) for its callers; add each caller crate to the touches of that task or create the port tasks in the same batch, ordered before the gates that build those crates, and make the aggregate gate require every port its workspace build needs."

[gotcha.2329]
title = "Explorer spec files are linted by the production build, not by vitest or yarn lint:tsc"
symptom = "The frontend image build runs next build, which runs ESLint over lib/ with @typescript-eslint/naming-convention, vitest/valid-title and vitest/expect-expect; spec files that passed snake_case functions as test titles (test(fn, fn)) or declared a snake_case const resource passed vitest and the type check and failed the image build, so paxscan.io kept serving a stale frontend (openapi.yaml 404, home block rows at 0 transactions) until f038ebb3f."
fix = "Write test titles as string literals, keep the assertions inline in the test callback, name identifiers camelCase or inline them into the typed map; an explorer task gate does not run the production lint, so the author checks these three rules before the gate."

[gotcha.2330]
title = "The agent daemon's human socket directory must carry no other-user bits"
symptom = "layerx-agentd exits 2 with 'human listener is invalid: Unauthenticated' when LAYERX_AGENT_HUMAN_SOCKET sits in a directory whose mode has any bit in 0o007 (0o711 for example), whose uid or gid differ from LAYERX_AGENT_HUMAN_SOCKET_UID and _GID, or that is a symlink (services/agent/crates/layerx-agentd/src/human.rs:1725-1742)."
fix = "Bind the socket inside a dedicated directory created with mode 0o700 by the uid and gid the daemon is told to expect; keep shared fixture roots at their wider mode."

[gotcha.2331]
title = "apps/web is outside the root npm workspace"
symptom = "make human-build fails with 'tsup: not found' (or another missing devDependency) in an environment that installed only the root package-lock.json: apps/web has its own lockfile and is excluded from the root workspaces, so the root install never provides its tools."
fix = "Run npm ci inside apps/web before any human-build or human-test target; the root install does not cover it."

[gotcha.2332]
title = "A go test package fails to build when another test file still names a removed field"
symptom = "go test ./precompiles/<pkg>/ -run X reports '[build failed]' from a different test file of the package (retire_read_gate_test.go:115 keepers.AnchorKeeper undefined) even though the focused test and the package build pass."
fix = "A task that removes a field from a shared struct owns every test file in the package that names it: add those files to touches and delete the dead statements in the same change."

[gotcha.2333]
title = "A gateway method moved off the kernel core must also leave kernel_backend"
symptom = "The gateway answers {'code':-32010,'data':{'backend':'public_core','code':'kernel_unavailable','reason':'not_configured'}} for a method whose handler no longer reads the kernel, because kernel_backend (services/platform/hosted/gateway/src/rpc.rs:338) still maps the method name to a KernelBackend and the readiness check runs before the handler."
fix = "When a method's reads move to the indexer or the chain, remove its arm from kernel_backend in the same task and declare rpc.rs in touches."

[gotcha.2334]
title = "The precompile wrapper repacks an executor's retirement revert"
symptom = "A precompile method retired inside its executor (layerxanchor Execute answering RetiredRevert) reaches the EVM as Error('execution reverted') (100 bytes) instead of the 132-byte LXP_MODULE_DISABLED data, because precompiles/common/precompiles.go Run repacks every executor error through revertData unless its own retirePlan gate fired for that method."
fix = "Test retirement through Run, not GetExecutor().Execute; keep executor revert data in Run when the error is vm.ErrExecutionReverted and bytes were returned (decision.1981), and evaluate retirement before the staticcall refusal in Execute."

[gotcha.2335]
title = "A symbol a task deletes cannot stay in its symbols list"
symptom = "The focused test passes and completion fails with 'symbol <name> not defined in the graph' because the task's symbols list names a function one of its do lines deletes."
fix = "When a do line deletes a function, remove it from symbols in the same spec edit; symbols names what the finished task defines."

[gotcha.2336]
title = "A client component cannot import a server-only module"
symptom = "next build fails on a 'use client' component that imports a module beginning with import 'server-only' (apps/web/src/api/gateway.ts), even if only one function is used."
fix = "Move the read behind a 'use server' action in the route's actions.ts and call the action from the client."

[gotcha.2337]
title = "UnixMovementProvider validates socket ownership and mode at open"
symptom = "ProductionComponents::open fails with 'movement provider refused startup' when LAYERX_HUMAN_MOVEMENT_SOCKET names a path with no socket, a symlink, a socket not owned by LAYERX_HUMAN_MOVEMENT_PEER_UID/GID, or one with other-permission bits (the umask leaves them after bind); the provider connects lazily, so no provider process is needed."
fix = "In tests bind a UnixListener at the path inside a 0o700 directory, chmod the socket to 0o600 right after bind and keep the listener alive for the test's duration."

[gotcha.2338]
title = "decode_block requires receiptsRoot"
symptom = "A mock eth_getBlockByNumber answer without receiptsRoot decodes as SequencerError::Malformed in layerx-client sequencer.rs decode_block, and the interop relay then reports Receipted instead of Committed; it looks like a hash mismatch but is a missing field."
fix = "Mock blocks carry number, hash, parentHash, timestamp, transactionsRoot, receiptsRoot and transactions."

[gotcha.2339]
title = "ProductionComponents::open needs the events upstream variables"
symptom = "layerx-human-service ProductionComponents::open starts HumanOutbox, which calls producer::Client::from_environment and refuses without LAYERX_EVENTS_JOURNEY_, LAYERX_EVENTS_APPROVAL_ and LAYERX_EVENTS_WEBHOOKS_ UPSTREAM_URL (https origin with a port) and UPSTREAM_CA_DER (existing DER file)."
fix = "Tests bind a TcpListener on 127.0.0.1, point the three URLs at https://127.0.0.1:<port> and the three CA paths at a DER file they write; spawn opens no connection at startup."

[gotcha.2340]
title = "SELECTOR_GET_ASSET is the ledger getAsset selector"
symptom = "The gateway's SELECTOR_GET_ASSET (0x2cc3ce80) looks like a custody-only constant but custody_asset sends it to the ledger precompile; deleting it with the custody selectors breaks paxeer.rs."
fix = "Keep it beside the ledger constants when retiring the custody selectors."

[gotcha.2341]
title = "Local node panics need node.log"
symptom = "tools/qualification/localnode/v6120-node.sh keeps node.log under $NODE_HOME and exports no home path, so an eth_sendRawTransaction 'method handler crashed' in the Go test leaves no panic site in the test output."
fix = "Export LOCAL_NODE_HOME in localnode.env and log the tail of node.log from a t.Cleanup when the test failed."

[gotcha.2342]
title = "A webpack alias can hide a server-only import"
symptom = "next build passes when next.config.mjs aliases a server-only module path to a 'use server' actions file for one importer, while the importer still names the server-only module."
fix = "Import the server action module directly; add no resolve.alias detours."

[gotcha.2343]
title = "The receipt authority's kernel socket has three readers"
symptom = "Deleting Config.lni_socket and lni_gate in services/platform/hosted/authority/src/main.rs breaks human/budget_state.rs:77 and :256, checkpoint_for and verify_withdrawal_request with E0609; the receipt handshake is only one of the socket's users."
fix = "Remove the handshake first; delete the fields after the budget-state, checkpoint and withdrawal readers are ported."

[gotcha.2344]
title = "validate_submission_payload has a caller in public_reads.rs"
symptom = "The core fee route public_reads.rs:246 calls super::validate_submission_payload, so deleting the submission validator with the activity routes in main.rs fails the build."
fix = "Keep the validator until the fee route is ported or retired."

[gotcha.2345]
title = "sdkgen receipt_contract requires the retired program-execution sections"
symptom = "sdk/platform/generators receipt_contract fails with 'missing declaration type.ProgramExecutionV4.domain' because programs.kvx no longer carries [type.ProgramExecutionV4] and [type.ProgramExecutionV5] since 1d0cc3720."
fix = "Delete the ProgramExecutionV4/V5 loop of receipt_contract; keep the ProgramGuestAbi checks."

[gotcha.2346]
title = "The completion check refuses symbols another task already removed"
symptom = "cg spec done fails when a task's symbols list names identifiers that an earlier task deleted, even if the task's own build and tests passed."
fix = "List only the symbols the task adds or keeps; move deletions to the do lines."

[gotcha.2347]
title = "A unit gate can pass while the real path fails"
symptom = "Tasks that change an interface passed their declared test with mocked transports or hand-built messages and failed in the next task that consumed the real output: receipts the consumer could not verify, a socket a reader still needed, a validator with a live caller, a generator pinned to a removed schema."
fix = "Interface-changing tasks carry proof_policy: drive the real producer through the real transport into the real consumer in the declared test, restart and recover where state crosses a restart (decision 1990)."

[gotcha.2348]
title = "A cargo gate without --locked lets a manifest change drift the workspace lock"
symptom = "0fdebd9dc (task 8.96.4) dropped a dependency from services/platform/hosted/registry/Cargo.toml; its build ran without --locked, cargo rewrote the lock in the tree, the lock was outside touches and stayed stale on main, and every later --locked gate of the platform workspace refused before compiling (8.98.5, 8.98.1, 8.4.4, 10.20.3)."
fix = "A task that edits a Cargo.toml dependency declares the workspace Cargo.lock in touches and builds with --locked; a lock refresh task (18.1297.2) repairs a drift that already landed."

[gotcha.2349]
title = "Refreshing a stale lock in the tree qualifies a tree that is not the one published"
symptom = "Attempts of 8.11.3 (622f52719), 8.4.4 and 8.98.1 ran cargo fetch without --locked to get past the stale platform lock, built and verified with the refreshed lock, and published without it because the lock was outside touches; main still refuses --locked builds."
fix = "Record the drift as a finding and let the lock refresh task land; a passing gate on a tree the publication does not contain is not the task's proof."

[gotcha.2350]
title = "A whole-binary cargo test verify is an aggregate gate when another task owns cases in the binary"
symptom = "18.1228.1 ran cargo test --test agent_controls_rungs and failed thirteen attempts on three archive_fixture cases that 18.1149.1 lists as its tests."
fix = "Name the owned cases with --skip in the verify command (decision.1993) or run the declared cases with --exact; the owning task proves its own cases."

[gotcha.2351]
title = "A symbols entry the task deletes fails the graph check"
symptom = "8.50.4 listed post_activity in symbols while do_3 deletes Client::post_activity; two attempts implemented and tested everything and cg spec done refused with 'symbol post_activity — not defined in the graph'."
fix = "symbols lists only the symbols that exist after the task; a deleted symbol is named in the do line and the test, never in symbols."

[gotcha.2352]
title = "Regenerating a contract's outputs breaks the consumers the contract rewrite left behind"
symptom = "8.45.1 rewrote the receipt contract and 9.97.3 regenerated its Rust, TypeScript and Python outputs; the SDK verifiers, programs modules and web search and x402 clients still implemented the kernel receipt path over names the new contract no longer defines, and no task owned their port."
fix = "When a contract is rewritten, list every consumer of the generated names and give each a retirement or port task that the regeneration task requires (decision.1992)."

[gotcha.2353]
title = "A build command that checks the file the task deletes"
symptom = "16.8.1's build_cmd was bash -n on tools/paxeer-x/gates/2.2.sh while do_1 deletes that file; two attempts exited 127 at build and never verified."
fix = "When a do line deletes a file, the build and verify commands must name only files that remain; point them at the surviving sibling."

[gotcha.2354]
title = "A scan path wider than the task's touches catches sibling work"
symptom = "16.6.1 scanned --path scripts for retired callers and failed on scripts/ci/solidity-state-surface.sh, which 16.5.3 owned and had not yet published."
fix = "Either narrow the scan path to the task's own files or add the owner of every other file under the path to requires."

[gotcha.2355]
title = "A self-test that reads the spec text goes stale with the spec"
symptom = "retired_callers_test.py --self-test required its component set to equal the --component names in spec verify_cmd lines; after the scans moved into unittest files no verify_cmd named the tool and the self-test failed for every caller."
fix = "A tool's self-test must not depend on how the spec phrases its gates; check inclusion over every spec line, or drop the coupling."

[gotcha.2356]
title = "An operator renderer that reaches ssh and the live gateway cannot run as a gate"
symptom = "16.7.4's test ran xweb-config.sh render serve, which lists names over ssh through the private host map and prices through the gateway; the gate exited 2 on the unset host map."
fix = "Give the renderer overridable inputs (names variable, endpoint variable) and prove the consumer path against a loopback fixture in the record shape the contract test asserts."

[gotcha.2357]
title = "A continuation note on file relaunches a parked task at once"
symptom = "Tasks 12.34.4, 9.97.6, 8.19.6, 16.3.1 and 16.3.2 were relaunched within a minute of parking, each time from a stale note written before the spec change had synced; the holds placed afterwards found them claimed."
fix = "Hold the task first, land and sync the spec change, then write the continuation note and release; never write a note for a task whose packet would still carry the old touches."

[gotcha.2358]
title = "A Makefile rule retirement that drops sources from the link list"
symptom = "16.0.4 removed lxp_daemon_finality_authority.c and lxp_daemon_batch_wal.c from LAYERXD_SOURCES while retiring their test rules; the daemon's other sources still call them and layerxd no longer links, which make -n build test cannot show."
fix = "A source leaves a link list only with its last caller; when a task retires test rules, its build must link the binaries those rules exercised."

[gotcha.2359]
title = "An app-wide typecheck as the build gate of a shared hook change"
symptom = "12.34.4 changed one hook's return type with two consumer components outside its touches; the declared build (the whole wallet typecheck) failed three attempts on those consumers."
fix = "A task that changes a shared hook's shape owns every consumer the build compiles; list them in touches before the first attempt."

[gotcha.2360]
title = "A cargo test skip filter with a module prefix"
symptom = "18.1228.1 skipped archive_fixture::<case> and the same cases failed at the top level of another test binary."
fix = "cargo test --skip matches a substring; skip the bare case name so every binary that carries the case skips it."

[gotcha.2361]
title = "A no-argument container layout aggregate as a task gate"
symptom = "16.3.1's test ran tools/containers/check.sh with no arguments and failed on six Dockerfiles outside docker/ that other owners hold."
fix = "Gate on the explicit service and on the absence of the retired paths; the repo-wide layout aggregate is not a task-level gate."

[gotcha.2362]
title = "An included makefile defines a target the root test treats as retired"
symptom = "16.2.4 retired platform-hosted-topology-check from the root Makefile and make -n still answered it from services/platform/Makefile.inc:199."
fix = "Before listing a target as retired, run make -n <target> and read which included file still defines it; an included module's own check stays."

[gotcha.2363]
title = "A verify command that names a test binary the task empties"
symptom = "9.97.6 deleted receipt_keys.rs and receipt_fixture.rs as its do line allowed and the verify command still passed --test receipt_keys: 'no test target named receipt_keys'."
fix = "When a do line may delete a whole test file, the verify command lists only the binaries that survive."

[gotcha.2364]
title = "A retired type still named by a sibling module's header"
symptom = "1.12.1 deleted lxp_grant_state and lx_budget.h:204 (a budget module reader with no caller) still declared a function on it, outside 1.12.1's touches."
fix = "Before deleting a type, grep every header and source for its name and put each declaring file in the touches."

[gotcha.2365]
title = "A retirement assertion counted as a live reference"
symptom = "6.52.4's path scan flagged tools/ci/tests/test_makefile_wave4.py:61, where a retired contract path appears only in a list asserting it is absent from make -n output."
fix = "Give every retired-path scan a skip set for files that name retired paths to assert absence (makefile retirement tests, the deleted-tree catalogue); a match there is not a caller."

[gotcha.2366]
title = "A dependents compile fails on a sibling test a done task broke"
symptom = "8.16.7 built its crate clean and the dependents compile failed on a gateway test that names a constant a done task deleted eleven waves earlier; the done task's gate ran only its unit tests."
fix = "When a task deletes a pub item, its scan covers every test binary of the workspace that names it; when a dependents compile fails outside the task's touches, open a wave-1 repair task and gate the affected builds on it instead of widening the task."

[gotcha.2367]
title = "Relinking a retiring binary to satisfy a consumer"
symptom = "16.0.5 was written to relink layerxd so make build would pass for the emulator; the daemon does not even compile on main after a type retirement, and it is scheduled for deletion."
fix = "When a consumer's build runs an aggregate that links a retiring binary, point the consumer at the artifact it consumes; never restore a retiring surface to satisfy an aggregate."

[gotcha.2368]
title = "A producer shape change whose test readers live in another file"
symptom = "8.5.3 changed px_getNetwork's result and verified its own one_source_reads test; four degraded.rs tests kept asserting the old kernel field and failed on main for a week until 8.3.1's verify named one."
fix = "A task that changes a response shape greps the whole crate's tests for the old field names and lists each file in its touches; the proof_policy requires the consumers' assertions, not only the producer's."

[gotcha.2369]
title = "A self-test that hard-codes a path a tree move renamed"
symptom = "The retired-callers self-test expected the path agent to overlap a deleted tree; after the agent workspace moved to services/agent, no tree lay under agent/ and the self-test has failed on main since."
fix = "After a tree move, run every self-test that builds fixtures from repository paths and grep self-tests for the old prefix."

[gotcha.2370]
title = "A do line keeps helpers the task's own planned scan forbids"
symptom = "8.98.5 do_7 kept the lni connect helpers for a later task while do_4 asked the planned scan to fail on every retired path, so attempt 7 could not pass."
fix = "When a do line defers part of a retirement, the planned scan's list excludes that part explicitly and the deferring task's do lines add it back."

[gotcha.2371]
title = "A rule-text task built a binary another task ports"
symptom = "16.2.4's planned test asserted the make rule omits the WAL source and then built the binary, whose caller source still names the WAL symbols; the link failed in a task that does not touch that source."
fix = "The link proof belongs to the task that ports the caller; a Makefile task asserts rule text and make -n output and leaves the build to the task whose touches hold the sources."

[gotcha.2372]
title = "A root-token scan cannot tell a project's own Dockerfile from the root one"
symptom = "16.3.5 failed twice on eighteen lines where tests, deploy configuration and gates name the Dockerfile beside them, a docker/<name>/Dockerfile path or a retired-paths ledger."
fix = "When a scan matches a bare file token, read every hit before ruling: exempt directories that own a file of that name and ledgers that list retired paths; read the first failure of an attempt, not only the last."

[gotcha.2373]
title = "Sibling retirement groups reference each other's files"
symptom = "8.47.4's generator writes a fixture 8.47.5 deletes and 8.47.5's fixtures name 8.47.4's generator, so each task's absence scan hit the other's files."
fix = "When a retirement is split into groups, each scan skips the sibling groups' files and the task that requires all groups asserts the closure."

[gotcha.2374]
title = "A red test binary pulled into a verify"
symptom = "Decision 2005 put the layerx-sdk sdk binary into 9.97.6's verify; it had been failing on main since the agent-api contract moved to major 2 and the task failed on assertions it never touched."
fix = "Before adding a test binary to a verify, check it is green on main at the task's base; if it is red, the task that owns the file updates the stale assertions and the finding records the red period."

[gotcha.2375]
title = "A dead public path kept alive by package exports"
symptom = "The Python SDK's checkpoint-evidence path (x402.py, x402_checkpoint.py) had no caller but the __init__ exports and still broke the package import when its verifier dependencies went."
fix = "When deleting a stack, follow every import of the deleted names through the package, including modules the task did not list, and delete dead consumers with the stack instead of keeping them importable."

[gotcha.2376]
title = "Type-only consumers of a retiring interface"
symptom = "The TypeScript SDK's ai_market.ts imports two verifier interfaces as types only; deleting them with the kernel receipt functions broke the build three times."
fix = "When retiring a module, grep for type imports as well as calls; interfaces with a surviving type-only consumer stay exported and the finding names the consumer for its owner."

[gotcha.2377]
title = "Graph-check symbols must be defined in touched files"
symptom = "18.1195.1 and 18.1196.1 passed their verify and the qualification refused symbols naming the production item under test, which lives in an untouched file."
fix = "A test-only task lists its declared test functions as symbols; the graph indexes only touched and declared-symbol files."

[gotcha.2378]
title = "An ordinal change proven on the producer only"
symptom = "18.1188.1 moved the budget defund to activity 8 in the intents crate and verified that crate; the service's expected-operation constant and two test registries kept 7, so the real archive defund refuses its receipt and the archive binary has failed on main since."
fix = "An interface change lists every consumer of the old value (grep the constant and the ordinal across the workspace, tests included) in its touches and runs the consumers' binaries; this is the producer-transport-consumer proof the proof_policy requires."

[gotcha.2379]
title = "An archive schema derived from the schema it replaces"
symptom = "14.23.1 built the explorer archive schemas from the kernel schemas' schema() functions; 14.23.5, which deletes those, could not compile."
fix = "A replacement schema is written standalone; a task that deletes a schema greps for its module name in schemas and tests and lists every deriving file in its touches."

[gotcha.2380]
title = "A fixture deleted while unit tests include it by path"
symptom = "8.47.6 deleted receipt-programs-executed-v4.json and scanned sdk/platform/conformance; layerx-sdk, layerx-agentd and the platform CLI include the file with include_str! in their unit tests, so three lib test targets stopped compiling on main."
fix = "A deletion task greps the basename across the whole repository, tests included, and lists every reader in its touches or a wave-1 follow-up removes them before the deletion publishes."

[gotcha.2381]
title = "Generated constants asserted undefined by a retiring task"
symptom = "9.97.8 asserted PROGRAM_OUTCOME_TAGS and PROGRAMS_MODULE_ID undefined; they are generated into src/generated/receipt.ts and only the generator task removes them."
fix = "A retirement test asserts only names its own touches delete; generated names belong to the task that regenerates them."

[gotcha.2382]
title = "A continue line that does not restate the skipped do line"
symptom = "Attempt 4 of 1.12.1 continued from attempt 3 and skipped do_7's deletion a second time; the continue line said only 'keep its deletions'."
fix = "A continue line names the specific do lines the earlier attempt left undone, with the file and lines."

[gotcha.2383]
title = "A wave-29 scan asserting deletions of wave 44"
symptom = "16.9.4 ran the retired-callers scan with --deleted over trees that later-wave tasks delete and failed on every tree that still existed."
fix = "A task asserts only the state its own wave produces; absence of a tree is proven by the task that deletes it."

[gotcha.2384]
title = "A test that pins sibling test sources with include_str!"
symptom = "8.98.4's scan test included tests/real_node.rs, which task 8.19.7 deleted while the attempt ran, and the test binary stopped compiling."
fix = "Scan tests read the sources they check from disk at run time and list only files the task owns or no pending task deletes."

[gotcha.2385]
title = "A mock RPC script written from the described order, not the code's"
symptom = "lookup_authenticated issues pax_sequencerReceipt and px_getReceiptKeys and verifies execution before eth_getTransactionReceipt; seventeen attempts of 18.1200.1 scripted a receipt that failed verification and never reached the last exchange."
fix = "Read the client's call order from the code and script the mock's exchanges in that order with a receipt the client verifies."

[gotcha.2386]
title = "Chain-reading tests run against the default RPC URL"
symptom = "The gateway precompile route tests of 12.13.2, 12.13.3 and 12.13.4 need a node serving the precompiles; four attempts each ran against the default mainnet URL and failed with 502."
fix = "A task whose tests read the chain starts the local node fixture in verify_cmd and passes its RPC URL."

[gotcha.2387]
title = "A codec deleted at wave 29 while its callers retire at wave 44"
symptom = "1.6.3 deleted lxp_state_diff.h and its source at wave 29; three files that 1.34.1, 1.34.2 and 1.33.3 delete at wave 44 still included it and the library build stopped at the first include."
fix = "A deletion task sits after every task that deletes the remaining callers and requires them; its title saying 'once the users leave' is not a schedule."

[gotcha.2388]
title = "Build commands naming test targets an earlier retirement unruled"
symptom = "16.33.2, 16.33.5 and 16.33.6 built targets whose Makefile rules 16.0.4 and 16.2.4 had removed and stopped with 'No rule to make target' before any verify."
fix = "Before a batch lands, grep the Makefile for every target build_cmd names; a test file no rule compiles is dead and a retirement task deletes it."

[gotcha.2389]
title = "A retired-suite scan matching a shared header include"
symptom = "16.97.2's web intake scan matched '#include layerx/lx_web.h' and listed five live tests that include the still-live web module header."
fix = "Absence scans match the retired suite's own path and identifiers, never a header other live files include."

[gotcha.2390]
title = "A symbols list naming a helper the task deletes"
symptom = "8.18.1 listed collide, the manifest_check.py helper its do_4 removes; the verify passed and the graph check failed on the missing symbol twice."
fix = "symbols names only what the task defines or keeps in its touched files; anything a do line deletes leaves the list."

[gotcha.2391]
title = "A package initialiser importing the module a task deletes"
symptom = "8.32.1 deleted relay_archive/runtime.py and forward.py and __init__.py:3 still imported RelayArchive from the deleted module, failing the task's own import scan."
fix = "When a task deletes modules of a python package that outlives them, its touches include the package's __init__.py and a do line removes the import."

[gotcha.2392]
title = "A retired-module scan list longer than the task's port"
symptom = "8.98.4 and 8.98.5 listed every retired client module while their do lines kept lni, client, evidence or handover uses; attempts peeled one module per attempt, failing on the next."
fix = "The scan list of a migration task equals the modules its do lines port in the files it owns; kept modules are named in a do line and left out of the list."

[gotcha.2393]
title = "A differential that reports one line for six checks"
symptom = "13.34.1's qualify_workload returned 1 from six places and printed only 'low-conflict differential failed'; four attempts could not tell which stage diverged."
fix = "A test with several silent early returns prints the stage and the compared values on each return before any repair is attempted."

[gotcha.2394]
title = "A recorded exchange re-recorded under a test that decodes it"
symptom = "18.1129.1 re-recorded the x-websearch client exchange with a grantId reference; the typescript web search test still decoded grant bytes from it and failed on main."
fix = "A task that re-records a shared fixture lists every reader of the fixture and ports or hands off each; readers across the sdk trees count."

[gotcha.2395]
title = "A locked cargo build against a lock a path dependency outdated"
symptom = "18.1211.5 changed no manifest and cargo --locked refused services/interop/Cargo.lock; a path dependency manifest changed after the lock was last written."
fix = "When a candidate changes no manifest and --locked refuses, the lock is stale on main: the task touches the lock and refreshes it before the build."

[gotcha.2396]
title = "A deletion whose last caller sits outside the touches"
symptom = "1.12.1 deleted lxp_verify_payer_grant with the ledger header and lx_asset_transfer.c:68, not in its touches, still called it."
fix = "Before deleting a declaration, grep every caller across src, include and tests and add each file to touches with a do line."

[gotcha.2397]
title = "End-to-end tests still starting a retired daemon"
symptom = "10.20.3 and 18.1200.1 ran tests that start layerxd from build/bin after 5.50.1, 5.50.3 and 5.50.4 retired its servers; the binary no longer builds and 26 attempts chased it."
fix = "When a component is retired, every test that spawns it is listed and reworked onto the replacement in the same programme; a precondition on its binaries is a stop sign."

[gotcha.2398]
title = "A local node fixture that never brings the merge precompiles live"
symptom = "The gateway route tests of 12.13.2, 12.13.3 and 12.13.4 ran against the local node and every route returned precompile_not_served: eth_getCode at 0x0905-0x0908 is empty on the fresh genesis."
fix = "A fixture that stands in for the merged node proves the precompile set it serves with eth_getCode before any consumer test depends on it."

[gotcha.2399]
title = "A byte scan for a retired route matching the test that asserts its refusal"
symptom = "8.7.4's scan for /v1/activities under the gateway tests matched degraded.rs, a Rust test that posts to the route to assert the 503 refusal task 8.3.1 wrote."
fix = "A retired-corpus scan is scoped to the file kinds of the corpus; a test asserting the refusal of a retired route is a live consumer proof, not a leftover."

[gotcha.2400]
title = "Touched files a prerequisite task deleted"
symptom = "8.98.2 listed head_attestation.rs and head_attestation_tests.rs, which 8.8.4 removed before it ran; the graph check failed twice on files that cannot change."
fix = "When a prerequisite deletes a file in touches, the task drops it from touches and marks the do line superseded in the same batch that records the deletion."

[gotcha.2401]
title = "A planned retirement test must name a target the Makefile builds and runs bare"
symptom = "16.33.2 and 16.33.5 prescribed build_and_run_c_suite on lxp_test_maintenance_publication, which no rule builds, and on test_bridge_withdraw, which exits 1 silently and needs no input."
fix = "Before prescribing a target, find its build rule and a bare run rule in the Makefile; without a run rule prescribe a make exit-0 check only."

[gotcha.2402]
title = "A touched path a prerequisite already cleaned invites a gratuitous edit"
symptom = "16.33.2 attempt 5 changed two lines of tests/test_bridge_withdraw.c only to give the touched path a change after 16.94.1 had already satisfied the do line."
fix = "When a prerequisite satisfied a do line, drop the path from touches in a decision instead of leaving it to be edited."

[gotcha.2403]
title = "A verifier signature change must re-point every consumer in the same task or a named follow-up"
symptom = "verify_payment_receipt changed shape (9.97.10) while verify_rpc_payment, x402_http.py and x402_draw.py kept the old call shapes, so the x402 payment path has raised TypeError on main since."
fix = "Grep the callers of a changed function across the package and its tests and list them in touches or a follow-up task before the change lands."

[gotcha.2404]
title = "eth_getCode is not a precompile readiness probe"
symptom = "The node serves precompiles as native handlers and writes no account code, so getCode-based readiness refuses every served precompile."
fix = "Probe with eth_call data 0xffffffff and read the LXP_PRECOMPILE_UNKNOWN_METHOD rejection as served and an empty 0x result as not served."

[gotcha.2405]
title = "Retiring a kernel C symbol must remove its cgo consumer"
symptom = "1.12.1 deleted four grant symbols from the headers while modules/lxphost/read.go kept calling them, so make -f chain.mk install failed for every node task until 1.12.4."
fix = "For every deleted declaration grep C.<symbol> under modules/, precompiles/, node/ and daemon/ and touch those files in the same task."

[gotcha.2406]
title = "A removed fixture must leave every include_str! and readFileSync that names it"
symptom = "8.47.4 removed receipt-positive-v2.json while four Rust test files and one TypeScript test still include it, so two test builds failed on main."
fix = "Grep the fixture name across *.rs, *.ts and *.py before deleting it and touch each consumer in the same task or a named follow-up."

[gotcha.2407]
title = "A planned test must not read an environment-named fixture"
symptom = "10.0.3 attempt 2 read LAYERX_TEST_INTENT_FIXTURE_JSON, which nothing in the repository writes, so the test could never run on a fresh checkout."
fix = "A planned test opens its own components in a temp directory and serves its peers in process; an environment variable may only select an optional external binary the verify command names."

[gotcha.2408]
title = "Porting a test onto a retired API reproduces the retirement as a test failure"
symptom = "18.1205.1 attempt 5 built its cache value through declared_domain over a settlement document stripped since b284707f6."
fix = "Before using a helper in a test, check the decisions that name it; build fixtures through the constructor production uses (CacheValue::from_receipt)."

[gotcha.2409]
title = "A package-wide --tests build is gated by every other task's test files"
symptom = "18.1221.1 could not build because tests/degraded.rs, owned by 18.1205.1, fails to compile on main."
fix = "Build the targets the task's verify runs (--lib --no-run or --test <name>), never -p <crate> --tests."

[gotcha.2410]
title = "A test that spawns a tool must name it in the gate command"
symptom = "18.1233.1 and the new 10.13.9 spawn anvil; the gate environment installs Foundry only when the command text names it."
fix = "Prefix verify_cmd with anvil --version && for every test that spawns anvil, forge or cast."

[gotcha.2411]
title = "A declared touch already absent from main fails the graph check"
symptom = "8.19.5 attempt 4 passed its tests and failed on two deleted test files still listed in touches."
fix = "When a prerequisite removed a declared path, drop it from touches in a decision before re-qualifying."

[gotcha.2412]
title = "Deleting a header while other sources include it breaks liblayerx.a"
symptom = "1.18.2 and 1.19.3 deleted lx_web.h and lxp_bridge_credit.h while lx_web_adapter.c, lx_web_root.c, lx_batch.h, lxp_genesis.c, lxp_genesis_builder.h and lxp_module_ctx.c still include them."
fix = "grep -rn 'include <layerx/<header>>' src include tests before deleting a header and sequence the task behind the owners of every include."

[gotcha.2413]
title = "Changing a pub accessor's return type breaks callers outside the task"
symptom = "10.6.2 attempt 4 made SendRoute::intent return Option<&Intent> and broke sixteen call sites in reclaim.rs, intent_submit.rs and move_money.rs."
fix = "Keep the accessor shape and express the new case as a refusal at the producer; grep callers before changing a signature."

[gotcha.2414]
title = "A symbols entry naming a deleted function fails the graph check"
symptom = "9.97.6 and 9.97.7 passed every test and failed only because their symbols named the functions they removed."
fix = "Pure-deletion tasks declare symbols = []; name only functions that exist after the change."

[gotcha.2415]
title = "Module-level awaits in a node:test file run under every filter"
symptom = "9.97.12 attempt 4 passed its named test while the file's top-level history gateway block failed and left asynchronous activity after the run."
fix = "Wrap every top-level block of a node:test file in await test(name, ...) so a filtered run executes only the named test."

[gotcha.2416]
title = "A directory-wide scan test reaches files outside the task's touches"
symptom = "8.14.2 attempt 4 removed the anchor scripts and the scan still found the anchor genesis wiring in deployment.yaml and init-chain.sh."
fix = "Run the scan's pattern over the whole scanned tree while writing the task and add every hit to touches."

[gotcha.2417]
title = "Duplicated cgo preambles must change together"
symptom = "1.26.1 attempt 5 added a struct field to host.go's preamble and cgo refused the package with inconsistent definitions for C.lxphost_node because simulate.go repeats the typedef."
fix = "Before changing a cgo preamble type, grep the package for every file that repeats it and change all copies identically."

[gotcha.2418]
title = "A regenerated output cannot pass a lock that only a later task reseals"
symptom = "9.97.3 attempt 5 regenerated the receipt outputs and failed the pipeline lock comparison; the --write reseal belongs to 8.45.4, which requires 9.97.3."
fix = "When a task regenerates locked outputs, put the lock file in touches and update the affected digest entries by hand."

[gotcha.2419]
title = "Removed fixtures break include_str in test targets the dependents check compiles"
symptom = "10.13.9 attempts 1 and 2 failed the dependents compile on layerx-wire tests/maintenance_identity.rs, which includes two kernel fixtures task 8.47.5 deleted."
fix = "A fixture deletion task greps include_str, read_to_string and open paths across every workspace for the deleted names and lists the readers in a follow-up task before publishing."

[gotcha.2420]
title = "Module and operation on a sequencer receipt are not a payment discriminator"
symptom = "9.97.11 attempts 1 to 3 refused every draw with draw-receipt-mismatch on receipt.module_id == 1 and operation == 6 while every sequencer-receipt-v1.json case decodes to module 12, operation 2."
fix = "Decode the fixture once before writing a receipt field check; prove payment terms through the verifier's amount, asset and pay_to arguments."

[gotcha.2421]
title = "CacheValue::from_receipt never yields a Committed rung"
symptom = "18.1205.1 attempt 6 built its Committed cache value from a verified receipt and the level stayed SEQUENCER_SIGNED."
fix = "Build Committed values with CacheValue::from_checkpoint over a ThresholdReport from verify_certificate; copy the certificate fixture of layerx-proof tests/checkpoint.rs."

[gotcha.2422]
title = "A test-local copy of a shared helper drifts from production"
symptom = "18.1272.1 attempt 5 kept an inline canonical_owner module signing kernel envelope bytes while tests/support/canonical_owner.rs and production had moved to EVM transactions."
fix = "Include the shared support helper with #[path] and extend it; never keep a second copy in one test file."

[gotcha.2423]
title = "ProductionComponents fixtures need the whole production environment"
symptom = "10.0.3 attempt 3 set the roots and clock variables and stopped at LAYERX_HUMAN_AUTH_INDEX_KEY is required."
fix = "Copy the complete environment block of tests/production_unhooked.rs:872-895 into any fixture that constructs ProductionComponents."

[gotcha.2424]
title = "Renaming or deleting an enum variant is a crate-wide change"
symptom = "10.6.2 attempt 5 renamed Mechanism variants in resolver.rs and left six compile errors in move_money.rs, production_components.rs and a cfg(test) module of observed.rs."
fix = "grep the crate for every variant path including cfg(test) modules, add each file to touches, and build the library unit tests as well as the integration target."

[gotcha.2425]
title = "Deleting a test source breaks scan tests that include it from another crate"
symptom = "8.98.14 attempts 1 to 3 failed to compile layerx-platform-core's test targets because no_kernel_disclosure_codec.rs includes two gateway test files task 8.19.5 deleted."
fix = "A task that deletes a source file greps the repository for its path in include_str, source! and read_to_string calls and removes or re-points every reader in the same change."

[gotcha.2426]
title = "Agent-function precompiles refuse on activation before reading the selector"
symptom = "5.98.4 attempt 5 probed 0x0901 with an unknown selector and got LXP_AGENT_NOT_ACTIVE, not LXP_PRECOMPILE_UNKNOWN_METHOD."
fix = "A readiness probe over 0x0901-0x0908 accepts the activation refusal as served; read the handler's first checks before fixing an expected error code."

[gotcha.2427]
title = "A deleted conformance fixture breaks cfg(test) modules in sibling crates"
symptom = "8.47.11 attempts 1 to 3 failed to build layerx-proof's library tests because program.rs:854 includes receipt-programs-executed-v4.json, deleted by 8.47.6."
fix = "Before building a crate's tests after fixture deletions, grep include_str over the crate for every removed fixture name and remove or re-point each reader; do_3's grep covered only receipt-programs- and receipt-positive-."

[gotcha.2428]
title = "Admission refuses a reused account sequence before the idempotency replay check"
symptom = "16.33.5 attempt 8 expected LXP_ERR_IDEMPOTENT_REPLAY for a replayed call and the kernel answered LXP_ERR_SEQUENCE_REUSED."
fix = "A replay that reuses the account sequence is a sequence refusal (lxp_admission.c:33-37); only a fresh sequence with a known idempotency key reaches LXP_ERR_IDEMPOTENT_REPLAY."

[gotcha.2429]
title = "JSON-RPC evidence carries no signed activity bytes"
symptom = "8.98.3 attempt 5 could not port the withdrawal re-verification: ProofBundle, the replica document and the receipt reads carry headers, proofs and receipts, never the canonical signed activity."
fix = "A port from the retired node interface to JSON-RPC lists every byte string the old call returned and checks each has a JSON-RPC source before the task is specified; a check that needs the signed activity moves to the submission path."

[gotcha.2430]
title = "The embedded checkpoint settlement document fails every certificate verification"
symptom = "18.1205.1 attempt 7 called verify_certificate and got Configuration(Json(MissingField('schema'))) from the embedded checkpoint-settlement.json."
fix = "Until 9.27.4 lands, no test can hold a CHECKPOINT_FINALISED value; use inclusion evidence (Receipted) and assert the rung checks that are reachable."

[gotcha.2431]
title = "The ledger send(bytes) construct admits only Asset send payloads"
symptom = "18.1272.1 attempt 6 wrapped a Governance lifecycle payload in send(bytes) to 0x101a and bind_call answered MalformedPayload from decode_send."
fix = "Before specifying a transaction form for a payload, read decode_method's arm for the target address and selector and confirm the payload decoder it calls accepts that module."

[gotcha.2432]
title = "Budget context binding derives account ids at protocol 3 regardless of the preparation protocol"
symptom = "18.1188.2 attempt 8 derived the context accounts at layerx_intents::canonical::PROTOCOL_VERSION and bound_context answered MalformedPayload."
fix = "Build a BudgetStateContext with account_id_for_protocol(.., 3), the derivation native.rs:220 uses; a mismatch surfaces as MalformedPayload, not FieldMismatch."

[gotcha.2433]
title = "A deleted conformance fixture breaks a test support module pulled into a library test by #[path]"
symptom = "8.98.14 attempt 5 and 8.98.3 attempt 6 failed to build the authority tests on lifecycle_dispatch.rs:172 including receipt-programs-positive-v3.json, deleted by 8.47.5."
fix = "After fixture deletions grep include_str across services/platform too, including tests/support files reached through #[path] in src/lib.rs; the crate's own src tree is not the whole test build."

[gotcha.2434]
title = "Porting one checkpoint reader to the RPC block type breaks every sibling consumer of VerifiedCheckpoint"
symptom = "8.98.3 attempt 6 changed checkpoint_for to return SequencerBlock and human.rs, human/dynamic.rs and human/budget_state.rs failed to compile on canonical_header, report() and the socket constants."
fix = "Before replacing a shared return type, grep the crate for every consumer of the old type's methods; port them in the same task or leave the type and record the gap."

[gotcha.2435]
title = "Retirement tests name the files they retire, so a sibling absence scan must skip them"
symptom = "8.45.4's conformance walk flagged kernel-fixtures-retired-2.test.py and kernel-fixtures-retired-4.test.py for naming the retired generator and fixture."
fix = "When a scan asserts a name is absent from a tree, exclude the tests whose assertions quote that name, or the two scans contradict each other."

[gotcha.2436]
title = "A hand edit to a DO NOT EDIT generated file fails the generator's check gate much later"
symptom = "8.46.1, 8.46.2 and 18.1308.2 wrote EVMMetadata into sdk/platform/go/generated.go; 8.45.4's reseal test ran check_go and reported the file stale."
fix = "Put hand-written code beside a generated file in a handwritten sibling of the same package and list it in pipeline.kvx; never add to a file whose header says the generator owns it."

[gotcha.2437]
title = "pax-tendermint answers GET /status without the jsonrpc result envelope"
symptom = "5.98.4 attempt 6 asserted status['result']['node_info'] and the body carried node_info at the top level."
fix = "Read Comet GET responses the way tools/hpx/registry/main.go rpcGet does: unwrap result when present, otherwise use the object itself."

[gotcha.2438]
title = "The call activity binary's default path reads a conformance fixture that no longer exists"
symptom = "16.33.5 attempt 9 would have failed after the spend case too: test_call_activity.c:3329 opens receipt-programs-executed-v3.json with no argument given."
fix = "Grep the C test sources for every deleted fixture path, not only Rust include_str readers."

[gotcha.2439]
title = "A consensus standby that is not in the committee times out on acknowledgements without saying so first"
symptom = "12.35.4 attempts up to 19 saw acknowledgement timeouts; only the latest log reached 'validator not in committee' at round_state.go:537."
fix = "When replication acknowledgements time out, check committee membership of the acknowledging identity before tuning timeouts."

[gotcha.2440]
title = "A test fixture that reads node sockets from the environment cannot qualify where no node runs"
symptom = "10.0.3 attempt 5 required LAYERX_AGENT_HUMAN_NODE_LNI and the authority endpoint from the environment and both tests failed before any request."
fix = "Serve the counterpart in process (RealAgentLayer pattern in tests/intent_submit.rs) and set every ProductionComponents variable from the test itself; never gate a task's test on binaries or sockets the environment must provide."

[gotcha.2441]
title = "A DO NOT EDIT catalogue edited in place drifts silently until the next --write"
symptom = "Four tasks changed sdk/platform/go/generated.go and the JVM GeneratedContract.java by hand; the reseal task then saw --write revert routes, vocabulary and retired operations and stopped, five attempts in."
fix = "Put the change into the schema the generator reads, into the generator, or into a handwritten sibling file, and let the task that changes an interface run the generator and the consumer tests on one revision."

[gotcha.2442]
title = "Two services, two words for the same rung"
symptom = "Webhooks say block-committed (decision.813) and the human API says checkpoint-finalised (decision.1002); SDK tasks copied the webhook word into the human SDKs, which then refused every committed journey the human service serves."
fix = "Name the producer of the interface before choosing a vocabulary; a consumer speaks its producer's words, and a requirement that borrows another interface's word is amended, not implemented."

[gotcha.2443]
title = "A typed operation catalogue cannot address a retired wire name"
symptom = "The Swift and .NET retired-faucet tests send PlatformOperation.AgentFaucetClaim; once the catalogue drops the case the tests cannot be written, while the Go and JVM tests send the string faucet.claim."
fix = "Keep retired-name refusal tests on string-based transports; delete them where the transport is typed and note where the coverage lives."

[gotcha.2444]
title = "A scan list that names a module the same decision keeps"
symptom = "A retired-module scan over trust.rs listed batch while the decision that wrote it kept the trust::checkpoint batch lookup; the attempt that did everything else right failed on that one line."
fix = "When a decision keeps a call, take its module out of the scan over that file in the same decision, and name the task that retires both."

[gotcha.2445]
title = "A reachability guard needs the wiring before it can pass"
symptom = "The first run of the C and Rust reachability guard listed 78 programs: kernel suites built by name through a pattern rule, modules of fixture crates rooted under tests/, programs built by stem from a gate script, and four whose rules earlier retirements removed without the file."
fix = "Decide what a build reference is (path or stem, which script roots, which suites are built by name) before the guard is written, exclude crates rooted under tests/, and give every program the guard exposes an owner task before the guard task runs."

[gotcha.2446]
title = "A test double with a constant identity fails the first real-identity check"
symptom = "The human-service real-layer double hardcoded a budget id and derived the account from it; the kernel codec compared the payload's budget id with the context's and refused the preparation."
fix = "A double that stands in for a producer derives every identity from the bytes it is handed, never from a constant."

[gotcha.2447]
title = "A purpose check no input can satisfy is a defect, not a gate"
symptom = "native_send_preview_v1 required the disclosure's purpose commitment to equal the requested one; a native send never discloses a payment, so the commitment is always None and every send was refused, while the sibling owner-preview path already refused only a present commitment."
fix = "When a check cannot be satisfied by any valid input, read the sibling path and the binding code before adding fields; the commitment is bound where the capability is checked."

[gotcha.2448]
title = "A hand-added catalogue field has readers the reseal does not see"
symptom = "Resealing the Go human catalogue removed the PerLeg field a task had added by hand; the conformance command outside the task's touches still compared it and the build failed one attempt later."
fix = "Before a generator reverts a hand edit, build every package in the module (go build ./...) and list the readers of the field; add each reader's file to the touches in the same decision."

[gotcha.2449]
title = "The journey boundary and the socket are two different agent seams"
symptom = "A router-level test was told to reuse the journey-level in-process agent of a sibling test; the Router reaches the agent only through a Unix socket, so the attempt started a real agent that needed a node."
fix = "Name the seam a test exercises: a journey test injects the boundary trait, a router test serves the socket in process with the crate's existing peer pattern."

[gotcha.2450]
title = "A Makefile target is not a graph symbol"
symptom = "A task listed its new phony Makefile target among its symbols; build and all three tests passed and the done check still failed because the code graph indexes functions and types, not make targets."
fix = "List functions, types and tests under symbols; a Makefile target is proven by the build command or a test that runs it."

[gotcha.2451]
title = "The agent JSON surface carries no native send preview"
symptom = "A test posted a native_send_preview_v1 variant through handle_rpc and got 400 envelope.malformed: the prepare operation of the JSON surface routes only native_effect_v1, native_registration_v1, native_send_v1 and native_send_submit_v1; previews travel as human frames (operation 63) written by the human service."
fix = "Prove a native send preview through serve_one with the frame the human service writes (agent_runtime.rs native_send_preview), not through the JSON surface."

[gotcha.2452]
title = "The served-precompile probe is an eth_call with selector 0xffffffff"
symptom = "Gateway tests expected an eth_getCode probe for a served precompile and saw none, and a route's eth_call count came out one too high: since the node serves precompiles natively without account code, ensureServed probes with eth_call data 0xffffffff once per process per key."
fix = "Assert the probe as that eth_call and exclude it from per-route eth_call counts; eth_getCode at a native precompile answers 0x."

[gotcha.2453]
title = "The attestor test support resolves a wallet identity only from a held secp256k1 key bound to the primary's policy account"
symptom = "A service test created a human primary key through the attestor test support and asked for its EVM wallet; the attestors refused with key_invalid_share: the inventory listed no key for generation, and the public-wallet route needs a held secp256k1 key owned by the same subject whose address equals the account the primary was generated with."
fix = "Generate the owner's secp256k1 wallet first, approve the primary key id for generate, create the primary with the wallet address as its account, approve it for sign, then resolve the wallet."

[gotcha.2454]
title = "A human service test gated on the protected native producer fixture never runs inside a qualification gate"
symptom = "A new test copied the fixture reader of tests/native_send_producer.rs, which expects PAXEER_X_HUMAN_NATIVE_SEND_PRODUCER_FIXTURE, a running human service over TLS and a real daemon socket; the gate had none of them, so both cases panicked with NotPresent before their first assertion and the task failed three times without the preview path ever being exercised."
fix = "Write such tests against an in-process peer double over a UnixListener and a temporary principal store, the way tests/agent_runtime_nonces.rs and tests/agent_runtime_eip1559.rs do; leave the protected fixture tests as release gates."

[gotcha.2455]
title = "The human service's plan route answers every refusal with the same reasonless 403"
symptom = "An end-to-end fixture got {code: forbidden, retry: final} from POST /v1/intents/plan with no attestor refusal recorded; the route has about a dozen checks that answer exactly this (assertion admission, owner identity, balance coordinates, custody binding, plan refusals, leg transactions, observation cache), so the failing check could not be read from the response."
fix = "Make the fixture's doubles record every request they serve and print the lists in the failure text, then bisect along the route's forbidden emitters in call order."

[gotcha.2456]
title = "The node serves a sequencer receipt only by transaction hash"
symptom = "A service route keyed by the receipt's global sequence looked for a node JSON-RPC twin of the retired selector-3 receipt lookup; pax_sequencerReceipt (rpc/sequencer_receipt.go:252) takes a transaction hash and nothing looks a receipt up by global sequence."
fix = "Key the route by transaction hash and read the global sequence from the executed receipt's seq field; a global-sequence index would be a new node method."

[gotcha.2457]
title = "A sequencer primary refuses to start without a standby address even though its config validation admits one"
symptom = "Config.Validate (node/sequencer/config.go:165-205) accepts an empty sequencer.standby-address, but NewNode (node/sequencer/node.go:62) then fails with ErrConfigStandbyAddress and NewReplicator refuses a nil dialer, so a single-node sequencer start needs a second node it never uses."
fix = "Treat the empty address as standalone replication (task 12.35.9) or configure a standby; do not point the standby address at the primary's own listener."

[gotcha.2458]
title = "The layerxauth keeper executes any governance payload ordinal the kernel admits, but only methods on its ABI reach it"
symptom = "A service built a DID registration as a ledger send(bytes) call because no precompile exposed a lifecycle method; the ledger decoder refused the governance bytes with MalformedPayload. The layerxauth keeper's execute (modules/layerxauth/keeper/execute.go:15) already maps payload[1] to kernel activity 0x00070000 | ordinal and the kernel decoder admits ordinals 1 and 3."
fix = "Add the ABI method, gas row and handler on the layerxauth precompile and the matching decoder arm in layerx-crypto; never tunnel a governance payload through another module's send."

[gotcha.2459]
title = "The gateway client refuses a balances answer that says bound without a DID and an account"
symptom = "A test double answered px_getBalances with account {evm_address, bound: true} and the service reported upstream-degraded: retain_lookup in the gateway client requires bound to equal the presence of both layerx_did and layerx_account and an evm_address on every bound answer, and the plan path maps every gateway error to upstream-degraded."
fix = "Answer the declared nested join shape the gateway crate's own decoder test fixes: identities with evm_address, pax_address, layerx_did, layerx_account and bound, rows with asset_id, denom, custody, paxeer and layerx, and an integer joined_limit."

[gotcha.2460]
title = "The JSON-RPC module-state read proves one storage word, not a kernel module record"
symptom = "A caller ported a kernel module-state read (a 223-byte record) onto rpc::module_state::module_state and found it returns a single 32-byte slot value proven against a signed header the caller must supply; kernel-era records with their own layouts have no slot twin, and the node keeps that state in precompiles instead."
fix = "Read precompile-backed state through eth_call (SequencerEndpoint::call_at with the ABI selector and arguments) and take finality from the anchor precompile's latestFinalized and checkpoint views; reserve rpc::module_state for genuine single-slot module values."

[gotcha.2461]
title = "The layerxauth precompile pins its method count in two tests"
symptom = "A new layerxauth precompile method passed its own tests and the ABI test, then failed TestAuthGasTable (row count) and TestAuthSurfaceFrozen (three Len pins) because both pin the method count."
fix = "When adding a layerxauth method, raise the pinned counts in gas_test.go and surface_test.go together with the ABI, handler and gas row."

[gotcha.2462]
title = "Store row keys are limited to 128 identifier characters, and two 32-byte hex fields plus a prefix exceed it"
symptom = "A handler built a Cache row key from a prefix and two 64-character hex digests (148 characters); RowKey::new refused it as InvalidKey and the handler reported upstream-degraded on every request."
fix = "Key rows by one digest of the inputs (prefix plus 64 hex characters) and keep RowKey::new's IDENTIFIER_LIMIT in mind whenever a key concatenates hashes."

[gotcha.2463]
title = "A panic inside an evmrpc handler is reported only as 'method handler crashed' and the node log shows nothing"
symptom = "A client saw 'method handler crashed' from eth_sendRawTransaction; the JSON-RPC server recovers handler panics and logs them through its own logger, which the node does not route, and the handler's deferred recordMetricsWithError re-panicked without logging, so node.log held no error, no stack and the goroutine dump had already unwound."
fix = "Log the panic value and debug.Stack() in recordMetricsWithError before re-raising (task 12.35.11), and reproduce handler paths in process with the production SendConfig instead of only through a started binary."

[gotcha.2464]
title = "A retired-module scan list is per crate, and extending it before that crate's own port fails the port's neighbour"
symptom = "A core task added 'read' to the authority crate's retired-module list because an early do-line bundled the authority reader with the core port; the core port passed its own scan and the task failed on the authority crate's unchanged import."
fix = "Keep each crate's retired list with the task that ports that crate; a cross-crate clause in a do-line is a second task, not a line item."

[gotcha.2465]
title = "The agent creation lifecycle binding matches the disclosure construct method exhaustively"
symptom = "A task added a variant to layerx_crypto::disclosure::call::ConstructMethod, built and tested layerx-crypto, and landed; every later build of the layerx-human-service library failed with error[E0004] non-exhaustive patterns in agents/create.rs bound_activity."
fix = "When adding a ConstructMethod variant, add its bound_activity arm in the same change and build layerx-human-service as part of the gate; the two crates live in different workspaces, so the human service build must be named explicitly."

[gotcha.2466]
title = "The human service's component server validates every response against the declared schema and answers upstream-degraded on an undeclared key"
symptom = "A handler emitted fields the schema file did not declare; the service built and the peers answered, and every request still got 503 upstream-degraded with no log of the cause, because encode_response refuses an undeclared object key after the backend has executed."
fix = "When a handler emits a new response field, declare it in services/human/schema/human-api (optional lists are additive within a major), regenerate baseline.kvx with the refresh command in its manifest, and run the schema-check conformance test with the handler's test."

[gotcha.2467]
title = "Test wrappers start with Block.MaxGasWanted zero and the sequencer admission then refuses every transaction"
symptom = "An rpc test harness built app.NewTestWrapper, funded accounts and sent a transaction; the sequencer answered 'transaction does not fit the block limits: gas wanted 21000 exceeds Block.MaxGasWanted 0' from node/sequencer/limits.go, because the admission check reads the stored consensus params and the wrapper never stores any."
fix = "Store consensus params with Block.MaxGasWanted set (50000000 is the production genesis value) through App.StoreConsensusParams before the harness's first block, as node/genesis_sequenced_test.go does."

[gotcha.2468]
title = "Removing a variant from a human-service enum left two test targets uncompilable on main"
symptom = "A task removed two variants from journeys::resolver::Mechanism, built and tested its own targets and landed; tests/intent_nonces.rs and tests/resolver.rs still named the variants and every later --all-targets build of layerx-human-service failed on them."
fix = "When removing or renaming an enum variant in services/human, grep the crate's tests directory for the variant and build the crate with --all-targets in the gate; the resolver's refusal for custody routes is pinned in tests/send_routes.rs, so do not duplicate it elsewhere."

[gotcha.2469]
title = "The authority's Config is built literally in more than one test, so a new field breaks tests outside the task that added it"
symptom = "A task added chain_rpc_url to the hosted authority's Config and updated the tests it owned; cargo build --tests then failed in tests/chain_receipts.rs, which constructs Config with a struct literal and was not in the task's touches."
fix = "When adding a field to services/platform/hosted/authority's Config, grep the crate's tests for 'Config {' and add every literal to the touches before the build."

[gotcha.2469]
title = "The authority's Config is built literally in more than one test, so a new field breaks tests outside the task that added it"
symptom = "A task added chain_rpc_url to the hosted authority's Config and updated the tests it owned; cargo build --tests then failed in tests/chain_receipts.rs, which constructs Config with a struct literal and was not in the task's touches."
fix = "When adding a field to services/platform/hosted/authority's Config, grep the crate's tests for 'Config {' and add every literal to the touches before the build."

[gotcha.2470]
title = "A cargo gate that names a test target another task has yet to create exits 101 before any test runs"
symptom = "A verify command listed --test intent_plan_evm for a crate whose tests/intent_plan_evm.rs is a planned path of a different task; cargo refused with no test target named intent_plan_evm and the task could not qualify although its own change built."
fix = "Name only test targets that exist at the task's base or that the task itself creates; leave another task's planned target to that task's gate."

[gotcha.2471]
title = "A status-only assertion against the authority hides which refusal code produced a 503"
symptom = "Three TLS tests failed with 503 where 200 was expected and the attempt could only report pre-existing; the authority's refusal body carries error.code and server.log carries the eprintln reasons, neither of which the assertions printed."
fix = "Assert on status and body together and print the server log tail on failure, so a refused route names its cause in the first run."

[gotcha.2472]
title = "An ES-module package whose exports declare only import and types conditions cannot be required by Playwright's CommonJS loader"
symptom = "A Playwright suite in a package without 'type': 'module' imported a workspace library that imports @sidiora/layerx-sdk/browser; Node failed with Package subpath './browser' is not defined by exports because the map had no require or default condition, while Vitest over the same files passed."
fix = "Give every exports entry a default condition (Node 24 can require an ES module), and when a Playwright webServer never becomes ready, pipe its stdout and fetch the probe URL by hand: Playwright treats a 500 as not ready and says nothing about why."

[gotcha.2473]
title = "A fresh perps node emits its first FundingSettled only at the first whole hour after its first block, and end-block failures surface as Cosmos events"
symptom = "An end-to-end test waited six minutes for FundingSettled on a freshly started node and passed or failed depending on where its window fell against the wall-clock hour; the perps funding step records the first hour it sees and emits nothing, and a market whose end-block step fails is skipped with a perps_endblock_error event that eth_getLogs never shows."
fix = "Give a local genesis perps market states whose last_index_hour is one hour before genesis so the first block settles, and read /block_results for perps_endblock_error before concluding that a settlement is late."

[gotcha.2474]
title = "An exports map with only types and import conditions breaks every bundler and CommonJS consumer"
symptom = "A webpack build and a CommonJS loader both failed to resolve a package subpath whose exports entry declared only types and import; the ESM consumers passed, so the defect surfaced only in aggregate builds."
fix = "Give every exports entry a default (or require) condition beside import, and make aggregate gate tests print the failing step's log tail so the owning module is visible from the test output."

[gotcha.2475]
title = "The root Foundry project does not build as a whole, so new contracts need their own profile"
symptom = "forge build --root . under the default profile failed on retired kernel contracts whose libraries no longer exist and on tests importing an unpopulated contracts/lib; the new contracts themselves were fine."
fix = "Build and test new Solidity work under a dedicated [profile.<name>] in foundry.toml (its own src, test, out and cache_path) and prefix the commands with FOUNDRY_PROFILE=<name>."

[gotcha.2476]
title = "Every declared touch path must exist and change, and the xweb kind admissions live under types/"
symptom = "A task declared modules/xweb/observation.go and modules/xweb/genesis.go; the files live in modules/xweb/types, so the done check refused the otherwise passing attempt for two unchanged paths."
fix = "Check each touch path exists on main before committing a task block, and expect the done check to refuse any declared path that no commit changed."

[gotcha.2477]
title = "pnpm install inside the repository resolves the root workspace unless told otherwise"
symptom = "pnpm --dir <package> install for a package outside pnpm-workspace.yaml still found the repository workspace file and tried to install all twenty members, one of which depends on a registry package that does not exist."
fix = "Pass --ignore-workspace to pnpm install for packages that are not workspace members, and keep their file: dependencies on sibling packages."

[gotcha.2478]
title = "A pinned receipt key is selected by the receipt's context_hash, so kernel-era signed fixtures cannot be pinned"
symptom = "A server-launching test pinned the fixture's sequencer id as a receipt key; the authority refused every state record as state_evidence_refused because the signed receipt's context_hash was another value, and a zero key id is refused outright."
fix = "Derive test receipts from the committed fixture at run time: write the key id into context_hash, re-encode unsigned, re-sign the receipt digest and the batch header digest with the test key, and pin that key."

[gotcha.2479]
title = "The wallet already consumes a name indexer in the explorer name-service shape"
symptom = "A name system planned without an indexer would have left the wallet's My Names tab and the explorer's name display empty: apps/wallet/src/lib/pns.ts and apps/explorer/configs/app/apis.ts both read the explorer name-service API, and the wallet proxy pointed at a literal origin serving nothing."
fix = "When a feature replaces a hosted dependency, grep the consumers for the API shape they already speak and serve that shape; commit one answer vector that the producer test and the consumer test both assert against."

[gotcha.2480]
title = "A Next custom server ignores edits to the imported config object"
symptom = "An embedded dev server set basePath to the empty string on the object imported from next.config.mjs and still served the product basePath, so every probe on the root answered 404 and the Playwright web server never became ready."
fix = "Pass the adjusted object as next({ conf }) explicitly, and install the Playwright browser in the gate's build command when the environment has none."

[gotcha.2481]
title = "The v6120 export is past the sequencer activation height, so a plain local node rejects its own proposals"
symptom = "A local node started from the v6120 export without sequencer mode produced its first block and then rejected every proposal with 'sequenced proposal tx 0 is not a sequence batch'; a test waiting for a transaction receipt timed out with no error from the RPC."
fix = "Start v6120-node.sh with --sequencer for any test that sends a transaction; look for the proposal rejection in the node log whenever a receipt never arrives."

[gotcha.2482]
title = "An advance error mapped to one opaque code is unbisectable; log it with the journey id"
symptom = "A journey read advanced an intent journey and mapped every error to upstream-degraded, so a failing test saw only the code after the node double had accepted the transaction and served no receipt."
fix = "Log the error's Debug form with the journey id before mapping it, and make test doubles serve the receipt and block reads for every transaction they accept."

[gotcha.2483]
title = "Retiring a planner route also retires the tests that needed its multi-leg plans"
symptom = "After the planner began refusing every custody endpoint, a nonce-reuse test that built a two-leg deposit plan failed with NoRoute; no remaining route yields more than one leg and the plan type has no test constructor."
fix = "When a route is removed, list the tests that reach it through plan() and remove or rewrite them in the same wave; keep the single-leg assertions."

[gotcha.2484]
title = "A refusal that folds several comparisons into one string needs test-side named assertions"
symptom = "A creation test failed with 'lifecycle transaction binding differs' twice; the production check compares eight fields and names none, so neither attempt could tell which binding of the EVM-form owner was wrong."
fix = "Have the test support recompute and assert each binding with its own message before calling the production check, so the next failure names the field."

[gotcha.2485]
title = "A retired contract imported by a test breaks a scoped Foundry profile"
symptom = "A names-only Foundry profile still failed to build because one test imported the governance timelock, whose own imports were retired earlier in the feature."
fix = "Scoped profiles compile every import of their tests; govern Governed components in tests through a pranked plain address and never import sources outside the profile's own directory."

[gotcha.2486]
title = "budgetCreate carries no idempotency word; its disclosure word is the budget id"
symptom = "A lifecycle binding compared the disclosure idempotency word against the stage action key for every method; for budgetCreate the word is the budget id by construction, so the budget-creation stage could never pass on any owner path."
fix = "When a disclosure derives the idempotency word from a method-specific field, bind that field to what the payload comparison already pins and keep the action-key comparison for the methods that carry one."

[gotcha.2487]
title = "A test that writes under the repository root leaves untracked files behind every run"
symptom = "An integration test rooted its TLS fixture tree at qual-logs/hm2 under the repository; the gate passed and the attempt was still refused for sixty untracked files outside the task's scope."
fix = "Root test fixtures at env!(CARGO_TARGET_TMPDIR) (or an equivalent build-output directory) and never under a source path that git does not ignore."

[gotcha.2488]
title = "A mode guard around test-node setup leaves the sequenced node without prices or collateral"
symptom = "The local node script skipped its price feed and collateral setup in sequencer mode; the perps end-to-end test then saw getMarkPriceDetails revert with a zero mark on a market whose funding was already settling."
fix = "Gate only the steps a mode truly cannot run (here activate_merge on an already-activated export) and run every state-setup step in every mode; check the script's own mode-neutral tests against each start form."

[gotcha.2489]
title = "A handler result that fails the response schema is answered as upstream-degraded with no reason"
symptom = "The human service answered 503 upstream-degraded on every read of a new journey kind; nothing in the logs named a cause. finish_response validates each result against the operation's declared response type and maps a schema refusal to upstream-degraded silently."
fix = "When a new handler answers 503 with no chain or store error in sight, check the result against the operation's response type in the schema first; the service now logs one line per schema refusal naming the operation, trace and SchemaError."

[gotcha.2490]
title = "A pending-block RPC read between Seal and Open crashed the handler"
symptom = "eth_sendRawTransaction on the node holding the open block answered method handler crashed; the node log showed the handler panicking with sequencer: no block is open because the context provider panics when the open layer is nil in the few milliseconds between sealing one block and opening the next."
fix = "Send-path pending reads go through WatermarkManager.PendingContext, which waits up to PendingOpenWait for the next open block and answers the retriable ErrPendingBlockClosed; the app's provider performs the same bounded wait before it panics."

[gotcha.2491]
title = "The Next development server keeps the configured basePath and the browser harness must follow it"
symptom = "A browser harness started the wallet's development server with a basePath override in conf and probed the root URL; the app served under /wallet, every probe answered 404 and the harness timed out after ten minutes."
fix = "Point webServer.url and baseURL at the product base path with a trailing slash and write page navigations as relative paths (./?screen=...), never with a leading slash."

[gotcha.2492]
title = "eth_getProof answered a store-level proof that cannot reach the app hash"
symptom = "A test verified the eth_getProof answer against the committed app hash and failed with calculated root hash is invalid: the handler queried the evm store directly and returned only the ics23:iavl op, missing the ics23:simple op that links the store root to the app hash."
fix = "Prove storage slots through the root multistore (path /<store>/key with Prove) so the proof carries both ops; a client with a signed header can then verify it with the ics23 codec alone."

[gotcha.2493]
title = "A new struct field needs every initializer site in the touches, including test helpers in other modules"
symptom = "Adding a field to the indexer's Unit broke the build in a test helper of another module that constructs a Unit literally; that file was outside the task's touches, so two attempts stopped at the same compile error."
fix = "Before adding a field to a struct, list every literal initializer (grep for the type name followed by a brace) and put each file in the task's touches."

[gotcha.2494]
title = "A fixture that signs lifecycle calls must cover every stage's construct"
symptom = "The agent creation test fixture built budgetCreate calldata for every Budget-module payload and panicked on the funding stage's ordinal 2 once the creation stage finally bound"
fix = "Enumerate the stages a flow compiles (the compile.rs arms) before writing a fixture's calldata builder, and give the decoder a construct for each precompile method the flow signs"

[gotcha.2495]
title = "Retiring enum variants must carry every test target that names them"
symptom = "A gateway lib-only gate let an integration test keep nine deleted ProductionRoute variants, and unrelated tasks failed their dependent-crate check against the gateway test target"
fix = "When a task deletes variants or routes, grep the crate's tests directory and put every file that names them in touches; qualify with --all-targets or the test target itself"

[gotcha.2496]
title = "testify require.Same needs pointers"
symptom = "require.Same on two sdk.Context MultiStore() interface values failed with both arguments must be pointers after the behaviour under test already passed"
fix = "Assert header and height equality on contexts; reserve require.Same for pointer values"

[gotcha.2497]
title = "Browser-session reads need the session cookie in test fixtures"
symptom = "An intent journey list read answered 401 while the detail read passed, because the list route is a browser-session read and the fixture carried only the bearer"
fix = "Check each route's authentication kind before writing a fixture; open the passkey session once and send its cookie with every request"

[gotcha.2498]
title = "A leaf pnpm install walks up to the root workspace"
symptom = "pnpm --dir sdk/names install resolved all workspace projects and failed on an unpublished dependency of another package once the names manifest changed"
fix = "Install leaf packages that keep their own lockfile with --ignore-workspace, or add them to the workspace deliberately"

[gotcha.2499]
title = "Deleting a file must carry every include_str! of it"
symptom = "A Python-gated task deleted services/platform/relay_archive/runtime.py while a Rust integration test still include_str!-ed it, so every later build of the gateway test target failed with 'couldn't read' on an unrelated task"
fix = "Before deleting a file, grep the repository for its path (include_str!, include_bytes!, fixtures) and put every referrer in touches; a deletion's gate must compile the crates that embed the file"

[gotcha.2500]
title = "A build command fix must sweep every task that shares the command"
symptom = "Decision 2178 repaired the names SDK install command on one task while a sibling task kept the old command and failed on the identical root-workspace resolution one attempt later"
fix = "When a ruling changes a build_cmd or verify_cmd, grep the spec for every task carrying the same command and change them in the same batch"

[gotcha.2501]
title = "A pending-window fix must cover the send itself"
symptom = "The RPC send path waited for an open block on its nonce read and receipt record but handed the transaction to Accept unguarded, so a fixture's first call during a sealed layer failed with the raw sequencer error"
fix = "When a wait is added for a closed window, list every call on the handler path that touches the open layer, including the final hand-off, and guard each one"

[gotcha.2502]
title = "Adding an enum variant must carry the exhaustive matches of dependent crates"
symptom = "A decoder task added ConstructMethod::PayBudgetFund with a layerx-crypto-only gate while the human service matched the enum exhaustively, so every human workspace build failed until the consumer task landed its arms half an hour later"
fix = "A task that adds a variant to a public enum puts every exhaustive match in dependent crates in touches, or the consumer task that adds them merges in the same step"

[gotcha.2503]
title = "Deleting a crate must carry its workspace manifest and lockfile"
symptom = "A deletion task's touches named only the crate's files, so the workspace manifest kept the member and every cargo command in the human workspace failed with a missing manifest"
fix = "Grep the workspace Cargo.toml members and the Cargo.lock package list for a crate before deleting it and put both in touches"

[gotcha.2504]
title = "A task that edits the specification document cannot be compared by raw tree after its done record"
symptom = "A task whose touches include the specification document verified, then the done record rewrote the task's own status line inside that allowed file, so the measured candidate never matched the verified one and two attempts failed with the same unmet check"
fix = "Mask the task's own status line in the comparison hash when the specification document is an allowed path; the published commit keeps the real content"

[gotcha.2505]
title = "A native envelope binder has no call-name port to an EVM call binder"
symptom = "A migration task ordered call-name ports of every binder use, but two sites bind unsigned native kernel envelopes, which the EVM call binder cannot take; two attempts failed the retirement scan on them"
fix = "When a retired function has no same-shape replacement, retire its callers with the task that deletes their file and order the deletion of the definition behind them"

[gotcha.2506]
title = "A consumer task cannot precede the producer whose fields it reads"
symptom = "10.95.1 read AccountBalances.height and AssetBalance.amount while 10.24.1, which adds them, required 10.95.1; neither order built."
fix = "Point the requirement from consumer to producer and let the producer port the single dependent call site in the same change."

[gotcha.2507]
title = "A test fixture built on a deleted module falls with the module"
symptom = "intent_submit.rs still imported layerx_human_service::binding after 10.9.1 deleted it, so a later task could not port the signatures inside that fixture."
fix = "Delete the fixture and the cases' binding steps; decide what the product still reads and write that record directly."

[gotcha.2508]
title = "A journey identifier in a test must carry the jrn_ prefix"
symptom = "JourneyId::new('move-bank-send') refused with InvalidIdentifier kind journey and both tests panicked before asserting anything."
fix = "Use jrn_-prefixed lowercase identifiers (notify/event.rs:73), as the other tests do."

[gotcha.2509]
title = "A fixture loop that logs only on failure leaves an empty log when its parent times out"
symptom = "feeder.log was empty after the 30 second price wait killed the feeder, so the first failing step was invisible."
fix = "Log every iteration before and after the broadcast and size the wait to the first commit and aggregate."

[gotcha.2510]
title = "A test-support server for a retired protocol is deleted, not re-encoded"
symptom = "The evidence node spoke LNI frames; the retired-module scan refused lni paths while a do-line asked to keep the handshake."
fix = "Delete it with its tests once its consumer moved to the real RPC; keep the journal types the consumer still uses."

[gotcha.2511]
title = "A retirement scan for a package name fails while sibling tasks still delete the package's other files"
symptom = "10.27.2's test scanned for layerx-explorer-index and found the package's own sources and the tests of 10.27.4, 10.27.5 and 10.27.7."
fix = "Scan for the deleted files' names and the symbol they exercised; order the tasks whose scans hit each other's files with requires."

[gotcha.2512]
title = "A sequencer send refused -32000 'receipted but its logs are not recorded ... pending height H+1, receipt height H' is a send-path race, not a consumer fault"
symptom = "rpc/send.go recordReceiptLogs compared the pending height with the receipt's height after Accept; a layer sealing between the two refused a transaction the sequencer had receipted (18.670.1 a12, 10.6.1 a3, 5.47.4, 18.997.1, 11.37.3)."
fix = "task 5.98.7 records the logs from the AcceptedSend the accepter returns and orders Committed after in-flight sends; consumers must not retry the send (the nonce is spent) nor mask the refusal."

[gotcha.2513]
title = "A touches entry for a file another task deleted on main fails the done gate as 'no matching change'"
symptom = "10.98.10 attempt 4 listed tests/deposit.rs in touches after 10.20.x deleted it at ad92aa7fc; the gate found no change for the path."
fix = "drop the path from touches and withdraw the do line that named it; the attempt's remaining work stands."

[gotcha.2514]
title = "Playwright body.innerText of '' against a Next dev server usually means a client exception swallowed by the dev overlay"
symptom = "12.35.2 attempt 8 printed body '' although the init script ran; the Next dev overlay lives in a nextjs-portal element outside body text."
fix = "attach page.on('pageerror') and page.on('console') before goto and print locator('nextjs-portal') text with the navigation response status before changing product code."

[gotcha.2515]
title = "A task reshaping a shared struct must build every consumer crate in its own build_cmd, not only its test target"
symptom = "10.24.1 changed AssetBalance in layerx-network-gateway and built only the gateway test; production_components.rs in layerx-human-service kept the old fields and main stopped building for every human-service task (10.95.1 a4, 18.1156.1 a12, 18.1151.1 a12, 10.27.2 a4)."
fix = "a port task (10.24.4) repairs the consumer and the human-service builders require it; when writing a producer task, put cargo build -p <consumer crate> into build_cmd."

[gotcha.2516]
title = "Deleting a module's files is not enough when the crate's facade still defines methods over it"
symptom = "9.24.3 deleted the arbiter and execution prestate readers but client.rs kept seven methods and two evidence type names over them (36 errors)."
fix = "list the facade file in touches and name the methods to delete; the callers in other crates belong to the wiring tasks."

[gotcha.2517]
title = "A symbols entry for a type the task deletes fails the done gate as 'not defined in the graph'"
symptom = "10.24.3 attempt 1 listed AnchorHead in symbols while do_1 deleted it."
fix = "list only symbols that exist after the task; deleted names belong in the do lines."

[gotcha.2518]
title = "A programme check over the installed spec is green only when the features it checks are complete"
symptom = "17.4.5's uncovered-selector test failed with 127 selectors for tests pending tasks have not written."
fix = "sequence such checks behind the domain completion gates (N.0.9) instead of running them mid-programme."

[gotcha.2519]
title = "Refusal-only retired components never appear in the callers inventory"
symptom = "17.2.6's stale_rows flagged requires-sei-wasm, a row with deleted_trees = [] whose callers are shell scripts."
fix = "treat components without deleted_trees as outside the inventory's domain."

[gotcha.2520]
title = "A schema edit without a regenerated client fails the api-gen drift test on every later main"
symptom = "10.0.3 (63aee3813) extended services/human/schema/human-api and left apps/web/src/api/generated at its earlier shape; make human-build was red until 14.0.5."
fix = "a task that touches the human-api schema regenerates the client in the same change, or the spec names the web task that does and sequences the aggregate gates behind it."

[gotcha.2521]
title = "A browser test that sees an empty document must prove the server serves the app before touching the test"
symptom = "12.35.2 spent attempts 7 to 9 refining diagnostics while no test had ever rendered the wallet shell under the app config."
fix = "fetch the page from the test process, run the simplest existing test under the same config, and only then decide whether the config or the test is at fault."

[gotcha.2522]
title = "go build compiles no _test.go file, so a changed Accept signature passed the build and broke the consumer package's tests"
symptom = "5.98.7 attempt 1 changed SequencerAccepter.Accept to return AcceptedSend; go build ./rpc/... ./node/... passed and go test ./node/sequencer/ failed to compile on two test callers outside touches."
fix = "a task that changes a signature test files call adds go vet over those packages to its build gate and names the calling test files in touches."

[gotcha.2523]
title = "A do-line that names the callers to delete must be written from the file, not from memory"
symptom = "9.24.3 do_4 named seven facade methods; the client had twelve that referenced the deleted modules, so attempt 3 still failed with sixteen errors."
fix = "enumerate by the module or type reference (grep the file for crate::<module> and the evidence types) and cite each method with its line."

[gotcha.2524]
title = "A deletion task's gate must compile the crates that import the deleted items"
symptom = "9.24.3 passed cargo build -p layerx-client --test sequencer and left layerx-agentd with thirteen errors on main; every agent and human workspace build failed afterwards on a break none of them touched."
fix = "give every task that deletes or renames a library item a build gate that compiles the dependent crates (decision 2190), and when an attempt fails on such a break, author the port task rather than rerunning the consumer."

[gotcha.2525]
title = "A fix at a higher wave than its broken consumers cannot be expressed as a requires"
symptom = "the agent daemon fix 9.24.5 sits at wave 35 while the human tasks that fail on the break sit at wave 19; a task may not require a higher-wave task."
fix = "hold the lower-wave consumers by operator hold until the fix publishes, and write the dependency into the consumers' do-lines instead of their requires."

[gotcha.2526]
title = "A port ruling must name the committed source of every field of the deleted type"
symptom = "9.24.5 asked to carry every prestate check onto a balance read and three attempts stopped without a build: the deleted prestate carried eight kinds of fact and the balance read carried two."
fix = "before ruling a port, list the accessors the consumers call on the deleted type (grep the accessor names and count the call sites) and name the committed source for each one, including the check that has none and is dropped on record."

[gotcha.2527]
title = "The touches list is the edit scope; an unlisted consumer blocks qualification"
symptom = "5.98.7 attempt 9 met a type error in a test file the task did not list, asked whether it could edit the file and stopped without a build; the previous ruling had listed the callers go vet had named so far, not every caller in the tree."
fix = "when ruling on an interface change, enumerate every caller of the changed symbol across the tree with one search (not the ones the compiler has reported so far) and add each consumer file to touches in the same batch, so the implementation never meets an unlisted file."

[gotcha.2528]
title = "A verify command that selects tests by name passes with zero matches"
symptom = "27 acceptance tests named by done tasks were never written: go test -run, cargo test -- --exact, swift test --filter, node --test-name-pattern and vitest -t all exit 0 when nothing matches, or when one alternative of a regex matches, so the gates passed and the parity check found the names missing weeks later (finding 17.4.5.2)."
fix = "pin the pass to the named test in the verify command (tee the output and grep '--- PASS: Name ' for go, 'test result: ok. N passed' for cargo, 'Executed N tests, with 0 failures' for swift, '# pass N' for node --test, 'Tests N passed' for vitest), or use a runner that refuses an unknown selector; never let a single alternation cover several names."

[gotcha.2529]
title = "A wallet-signed bank 0x1001 send executes with success false"
symptom = "move_leg_completes_from_its_receipt submitted send(address,address,string,uint256) to bank 0x1001 from the node key and the receipt reported execution.success false: pointerSend (precompiles/bank/bank.go:306) refuses any caller but the denom's ERC20 native pointer, so no externally signed transaction can call send."
fix = "route wallet moves of a denom through its ERC20 native pointer (pointerview 0x100A getNativePointer, then transfer(address,uint256) to the pointer) as decision 2197 rules, and prove every executable call shape against the real chain before asserting it in a route test."

[gotcha.2530]
title = "A verify command written with single quotes inside a single-quoted node -e argument never runs"
symptom = "17.5.12 attempts 1 and 2 failed at node -e 'require.resolve('@sidiora/...')': the shell closed the quote at the inner one and node parsed an unquoted module id (SyntaxError: Invalid or unexpected token)."
fix = "quote a node -e program with double quotes in the spec string (escaped as \' in the kvx value) and keep single quotes inside it, as the merchant-shop build command does."

[gotcha.2531]
title = "A double quote inside a spec command is written out as a single quote"
symptom = "The build gate of 18.90.1 (grep -q 'test 'reject an anchors page that lost a field'') and the verify gate of 17.5.12 (node -e 'require.resolve('@sidiora/layerx-sdk/browser', ...)') lost their inner double quotes when the spec was written, the shell split the commands at the inner quotes and both attempts failed on a command that never ran as intended."
fix = "Write commands that need no nested quoting: pass values to node -e as arguments read from process.argv, and match quoted test titles with grep -E and a single-character wildcard in place of each quote."

[gotcha.2532]
title = "A task's symbols list is checked against the code graph after verify passes"
symptom = "8.90.2, 8.90.3, 9.90.2 and 17.5.12 passed their verify commands and were still not marked done: the completion check resolves every symbols entry in the code graph and failed on test names a ruling had renamed in the tests list but not in symbols (testAgentEnvelopeEncodesVersionTwo, verifyReceipt_reports_the_submitted_rung_under_an_authority_key) and on Makefile target names (agent-sdk-ts-build, human-build), which are not functions."
fix = "when a ruling renames or deletes a tests entry, rewrite symbols in the same batch; list only functions, methods, classes and test functions that exist after the task (Go Test functions, Swift test methods, pytest functions, Rust test functions, TypeScript functions) and never Makefile targets, file names or test titles with spaces; an empty symbols list is valid."

[gotcha.2533]
title = "node --test prints the spec reporter in the gate, so grep for '# pass 1' never matches"
symptom = "9.90.2 attempt 3 ran its receipt test under node --test, the test passed and the gate still failed: in the qualification environment node chose the spec reporter (pass 1 with an info glyph) while the verify command grepped for the TAP line '# pass 1' (decision 2194's node form)."
fix = "pass --test-reporter=tap to node --test whenever the verify command greps '# pass N'; the decision 2194 node form reads node --test --test-reporter=tap."

[gotcha.2534]
title = "A cargo --tests build gate shows one broken test target per attempt"
symptom = "10.6.4 attempt 3 saw only tests/evidence_node.rs fail to compile; 14.0.6 attempt 8 fixed that file and then met three more broken targets (archive, native_onboarding_rungs, native_send_producer) the first log never showed, because cargo stops scheduling targets after the first compile error"
fix = "when a crate's test targets are broken on main, enumerate them once with cargo build --tests --keep-going and give the whole port to one task that the consumers require, instead of letting each consumer discover the next target"

[gotcha.2535]
title = "apps/web build type-checks the wallet SDK sources"
symptom = "make human-build runs the apps/web production build, whose TypeScript pass follows the tsconfig paths alias into ../../sdk/wallet/src and fails with TS2307 on viem and @supabase/supabase-js when sdk/wallet has no node_modules of its own, even though apps/web's install carries both packages"
fix = "install the services/wallet pnpm workspace, whose pnpm-workspace.yaml lists ../../sdk/wallet, and build sdk/wallet before make human-build; apps/web's node_modules is not on the resolution path of files under sdk/wallet"

[gotcha.2536]
title = "Platform make targets build and test offline"
symptom = "make workspace-build reaches platform-build-all, whose cargo builds and tests pass --offline on services/platform, tools/platform and sdk/platform/generators plus the marketplace program for wasm32-unknown-unknown, whose go build runs with GOPROXY=off, whose mvn runs with -o and whose dotnet build passes --no-restore, so the first uncached dependency fails the aggregate (failed to download anstream v1.0.0 at services/platform/Makefile.inc:98)"
fix = "warm every cache before the gate: cargo fetch --locked for the four manifests, rustup target add wasm32-unknown-unknown, go mod download in sdk/platform/go, mvn install of sdk/platform/jvm then dependency:go-offline of sdk/integrations/spring/example, and dotnet restore of sdk/platform/dotnet/LayerX.Sdk.csproj"

[gotcha.2537]
title = "cargo build --tests stops at the first broken test target"
symptom = "a port of stale integration tests surfaced one more broken target per attempt (10.6.5 attempts 2, 3 and 4 each found a single new file) because cargo stops compiling after the first failing target and reports only that one"
fix = "run the build command once with --keep-going before porting, so every broken target is listed in one pass and all of them join the touches together"

[gotcha.2538]
title = "Generated SDK files edited by hand fail platform-sdk-check later"
symptom = "a task edited sdk/platform/jvm GeneratedSchema.java and GeneratedContract.java directly under a gate of mvn tests only, and the wave 4 aggregate failed weeks of attempts later in generate_jvm.py --check with 'generated JVM schema is stale' because the committed files no longer equal the generator's output"
fix = "change the generator and regenerate; a task that touches a generated file runs that generator's --check in its verify command"

[gotcha.2539]
title = "eth_getProof on the node is an ICS23 witness, not a trie proof"
symptom = "a client decoded the node's eth_getProof answer with the go-ethereum shape (accountProof, balance, nonce, codeHash, storageHash) and verified it as an Ethereum trie under the app hash; the node answers {address, hexValues, storageProof: [{ops}]} with an IAVL existence proof and a multistore proof per slot, so the decoder read nothing and the verifier could never match"
fix = "decode the ops shape and verify with the registry's chain_proof ics23 and multistore functions under the block's stateRoot, which is the app hash"

[gotcha.2540]
title = "px_ methods are served by the network router, not the node"
symptom = "daemon code and test doubles posted px_getCommit, px_getValidators, px_getHistory and a px_getProofBundle that does not exist to the node's JSON-RPC, whose namespaces are debug, echo, eth, net, pax, test and txpool"
fix = "the daemon's endpoint is the router, which serves eth_, pax_ and px_ alike; local doubles answer the px_ methods in the router's shapes, and a method not in the router's published list is not a dependency"

[gotcha.2541]
title = "A consumer gate that waits on another pending task's placeholder"
symptom = "a task's second verify segment ran a daemon test whose pass depended on a fee policy another pending task was still implementing, so every attempt failed with its own files correct"
fix = "put the consumer test in the verify command of the task that implements the producer, and keep the first task's gate to what its own files make true"

[gotcha.2542]
title = "A producer gated without --tests breaks the crate's test targets silently"
symptom = "an integration task changed a public function signature and removed a custody method under a build gate of the library alone; two integration test files calling the old forms broke and were only found by a later task whose build compiles every test target"
fix = "a task that changes a public signature builds the crate with --tests, and greps its callers in tests/ into its touches"

[gotcha.2543]
title = "A schema change without regeneration fails platform-sdk-check later"
symptom = "a task edited services/human/schema/human-api under a build gate of its own crate; the platform SDK pipeline lock still carried the old source digest and every later wave 4 aggregate failed in sdkgen --check while the editing task was long done"
fix = "a task that edits a pipeline source (agent-api, human-api, mirror-v2 in sdk/platform/pipeline.kvx) runs make platform-sdk-generate and commits the regenerated outputs and the resealed lock, and its verify command includes make platform-sdk-check"

[gotcha.2544]
title = "Two generators owning one generated file fight over its header"
symptom = "make platform-sdk-generate ran a Python generator and then the Rust pipeline generator, both rendering sdk/platform/jvm GeneratedContract.java with different header comments, so whichever --check ran against the other's output reported the file stale and the aggregate failed after a correct regeneration"
fix = "one generator owns each generated file; the pipeline lock digests files rendered by another generator without rendering them itself, and a task that adds rendering of an existing output first removes the previous renderer"

[gotcha.2545]
title = "A ruling that rewrites part of a test must replay the fixture state"
symptom = "a ruling changed two assertions of a receipt-source test to the new retention rule but kept the Record call before them, which fills the two-slot source and evicts the very send the new assertion requires; the attempt followed the ruling and failed on it"
fix = "before dictating an assertion, walk the test's calls with the capacity and watermark in hand and state the expected value at each read"

[gotcha.2546]
title = "A port the task gate never runs can assert against a loader the producer stopped feeding"
symptom = "a test-port ruling told the implementer to load an EVM intent journey through the legacy journey engine; the producer had moved to a flat intent-evm row the engine's prefix scan never sees, the verify gate ran a fixture-gated release test instead of the ported target, and the port compiled, failed at runtime and was never exercised"
fix = "when a task ports a test target, its verify command runs that target; before dictating a read path, follow the producer's write to the row it persists and name the reader that serves it in production"

[gotcha.2547]
title = "Makefile targets are not code-graph symbols"
symptom = "a task listed two Makefile targets in its symbols; the attempt built, passed every gate and was refused by the graph check with 'symbol not defined in the graph' for both"
fix = "symbols name functions, types, methods or enums the graph extracts; name a Makefile target in the verify command or the do text, never in symbols"

[gotcha.2548]
title = "A deletion task must require the tasks that port its consumers"
symptom = "a task deleting a client crate's capability evidence type listed three done tasks as the place the daemon stopped using it, but two newer porting tasks still owned the remaining consumers; the client built and the daemon failed with nine errors on the deleted type"
fix = "before scheduling a type or module deletion, grep every consumer at the current base and require the task whose touches hold each one; the build gate compiles the consumer crates"

[gotcha.2549]
title = "A daemon test against anvil answers precompile reads in its own RPC proxy"
symptom = "a task moved the daemon's fee read onto the fee token precompile and the preview test that gates it panicked Unavailable: the test's chain peer forwarded the eth_call to anvil, which holds no code at the precompile address and returned empty data"
fix = "when a task adds a chain read on a path an anvil-backed test exercises, the test joins the touches and its proxy answers that read with the unit fixture's values; anvil never stands in for a precompile"

[gotcha.2550]
title = "A changed type's integration tests belong to the task that changes it"
symptom = "a task rewrote the daemon's proof bundle AccountState onto an ICS23 storage witness and deleted the client's account proof type; the integration test that built the old proof with balance, nonce and hashes sat outside the touches, and readers in three sibling tasks' files still called the deleted method, so the build failed before any gate"
fix = "before scheduling a type change, grep every constructor and reader in src and tests; tests of the changed shape join the touches, readers owned by sibling tasks move the deletion into a follow-up that requires them"

[gotcha.2551]
title = "A changed evidence encoding leaves consumer tests outside the producer's touches stale"
symptom = "a done task moved the lifecycle evidence check from the native owner envelope to the EVM signed transaction (create.rs bound_activity) with only its own crate's tests in the touches; the onboarding rung test still signed the native envelope and failed with Refused('invalid signed lifecycle transaction') attempts later inside an unrelated porting task"
fix = "a task that changes how a service decodes evidence lists every test that builds that evidence in its touches and verifies one of them; a porting task that meets such a fixture signs it through the shared support helper the already-ported tests use"

[gotcha.2552]
title = "The wallet ladder dropped a committed node receipt the explorer could not corroborate"
symptom = "once the node kept committed sends readable (5.5.22), pax_sequencerReceipt answered committed seconds after inclusion and observeTransfer pushed no receipt step at all for a committed answer without explorer evidence, so the send page showed Transfer Included with an empty ladder instead of Receipted"
fix = "a node answer above a rung proves that rung: present the highest rung the evidence supports (receipted from the receipt) and reserve the higher rung for the corroborating source"

[gotcha.2553]
title = "The wave 4 aggregate needs make platform-sample-install and the Platform toolchains before its readiness check"
symptom = "platform-sample-dependencies-ready (services/platform/Makefile.inc:58) exits with 'run make platform-sample-install first' when the Platform Python environment under build/platform-python is absent, and platform-sample-preflight also demands Maven, Swift and dotnet"
fix = "run make platform-sample-install in an environment that has mvn, swift and dotnet before any target that depends on platform-sample-dependencies-ready (platform-build-all, platform-verify-sdks, platform-test-middleware)"

[gotcha.2554]
title = "A client API rewrite lists the consumers of the removed items as touches"
symptom = "a task rewrote a client module's read API per a decision and the daemon's build failed on two files outside its touches that declared the removed proof type in request and result structs and called the removed evidence accessor; the attempt stopped at the build"
fix = "before rewriting a pub API, grep the dependent crates for every use of the removed items and add those files to the task's touches or write a decision naming the owning task"

[gotcha.2555]
title = "Fixture DIDs take the form did:layerx: plus 64 hex characters"
symptom = "a shared JSON-RPC fixture used the readable owner DID did:layerx:budget-owner; the daemon's generator and verifier tests passed, but the authority's export through layerx-client PxEndpoint refused with budget_proof_export_unavailable because px.rs identities() decodes a layerx_did only as did:layerx: followed by 64 hexadecimal characters, and produce_at hides which check returned Err(())"
fix = "generate fixture identifiers in the node's rendered form and assert that form in the generator test; when a consumer collapses errors to Err(()), read every decoder on its path before ruling"

[gotcha.2556]
title = "A directory move left one $(CURDIR)-prefixed path behind in a recipe no gate ran"
symptom = "3422bafe2 moved agent/ to services/agent/ and rewrote every root-anchored reference it matched, but services/platform/Makefile.inc:41 kept $(CURDIR)/agent/sdk/python because the $(CURDIR)/ prefix did not match the rewrite, and the only gate that runs make platform-sample-install is the wave 4 aggregate, which stayed red on other product checks for weeks before reaching it"
fix = "after a directory move grep the old path in every prefix form ($(CURDIR)/, $PWD/, ./, bare) across Makefiles and scripts, and run every recipe that installs from the moved tree, not only the gates that compile it"

[gotcha.2557]
title = "EVM owner evidence refused by consumers that compare the actor with a DID"
symptom = "after a producer switched ProtocolEvidence to the EVM owner form (actor = the 20-byte sender, owner_public_key = the sender's authority word), onboarding/native.rs kept four comparisons of evidence.actor with DID bytes and of evidence.owner_public_key with ed25519 keys and refused every ported test with EvidenceConflict, found only when the test port of a different task reached that site"
fix = "when a producer changes the encoding of an identity field, enumerate every consumer that compares that field (grep for the field name) and port them in the same task or in tasks the test port requires; a comparison that can never be true in the new form is a product defect, not a test fault"

[gotcha.2558]
title = "A lib-only build gate let a rewritten module break a test target nobody compiled"
symptom = "a task rewrote budget_proof.rs around a new trust type under a build gate of cargo build for four crates without --tests, and the integration test that imported the removed CommittedBudgetProofTrust failed to compile for every later task that builds layerx-agentd --tests"
fix = "a task that removes or renames a pub item greps the crate's tests/ directory for it and builds with --tests in its build gate; a consumer in tests/ is a consumer"

[gotcha.2559]
title = "An end-to-end test that proxies to a real third-party service cannot pass under its gate"
symptom = "a wallet test required a real explorer URL and a committed transaction hash from environment variables and forwarded the page's explorer requests to it, so it threw before the first assertion in the qualification environment, which provides the two local chains and no explorer"
fix = "serve the third party from the test: route the request and fulfil it with the document shape the page reads, derived from local chain state; keep real-service checks to release gates that declare the service"

[gotcha.2560]
title = "Escaped double quotes in a spec command reach the shell literally"
symptom = "a verify command stored with backslash-escaped double quotes inside a python3 -c was run with the backslashes intact and python failed with 'unexpected character after line continuation character'"
fix = "write gate commands without double quotes: single-quoted python with its values passed as arguments, unquoted $PWD and ${VAR:-default} forms"

[gotcha.2561]
title = "Transactions broadcast to the consensus RPC never commit at sequenced heights"
symptom = "a Cosmos transaction sent with paxd tx broadcast -b sync to a node running the sequencer returned code 0 and paxd q tx never found it while blocks kept committing; sequenced blocks carry only the sealed slice, which eth_sendRawTransaction alone feeds"
fix = "decision 2212 admits the mempool into the open layer at each proposal (task 5.98.8); until it is on main a sequencer-mode fixture cannot await a Cosmos transaction"

[gotcha.2562]
title = "A derived test task must carry the fixture prelude of the test it chains"
symptom = "a playwright test that calls its sibling test first failed on the sibling's environment requirement because the new task's verify command ran playwright alone"
fix = "copy the sibling task's build and verify prelude and change only the -g pattern"

[gotcha.2563]
title = "Wave aggregate gates need the full SDK toolchain environment"
symptom = "a wave gate task ran in the mixed-language environment, whose image has no Maven, Swift or dotnet, and make workspace-build stopped in platform-sample-dependencies-ready with 'run make platform-sample-install first' after every earlier target had passed"
fix = "every task whose gate runs make workspace-build, workspace-test or a platform-* target takes the sdk-all environment profile, which installs the platform sample dependencies before the gate"

[gotcha.2564]
title = "A task that deletes a symbol must not list it among its symbols"
symptom = "a port task that removed a stale import and its test passed its build and both verify runs and was refused at the done record because the symbol check wanted the two deleted names defined"
fix = "list only symbols that exist on the qualified revision; name a deleted symbol in the do text, never in symbols"

[gotcha.2565]
title = "A touches entry for a file a prerequisite already deleted fails the touched check"
symptom = "a port task listed a stale test file it was to delete; a prerequisite deleted it first, the task built and passed every test, and the done record was refused because no change to that path existed"
fix = "when a prerequisite takes over an edit, remove the path from the dependent task's touches in the same ruling that records the takeover"

[gotcha.2566]
title = "Make targets are not symbols for the done record's symbol check"
symptom = "a Makefile-only task listed two make targets as its symbols; the build and verify gates passed and the done record was refused because neither name is defined in the symbol graph"
fix = "a task whose only touched file is a Makefile declares no symbols; the touched check carries it"

[gotcha.2567]
title = "A task that adds a refusal to a shared path must run the sibling tests of that path"
symptom = "a task added the open-time-after-last-block refusal to the sequenced proposal path and verified only its own new test; two sibling tests sealing with earlier open times failed on main for six days until the next task gating the whole test family ran them"
fix = "when a verify command names a single test in a file, include the file's test family (a -run prefix) so the refusal is proven against every existing case"

[gotcha.2568]
title = "Proposal tests sealing at a fixed epoch fail a later open-time check"
symptom = "three sequencer proposal tests sealed their blocks at time.UnixMilli(1700000000...) while the fixture's LastBlockTime defaulted to now, so the open-time check a later task added made them fail and that task's verify ran only its own new test"
fix = "take open times relative to f.state.LastBlockTime in proposal tests, and a task that adds a check to a shared code path runs the whole test file of that path in its verify command"

[gotcha.2569]
title = "Two renderers of one ladder disagreed on the committed rung's source"
symptom = "TransactionLadder dropped the receipt's committed step before rendering while the saved observation of observeTransfer kept it first, so the shared StatusLadder showed data-source explorer on one page and receipt on the other and the send test failed at its committed assertion"
fix = "put a presentation rule in the shared component once, with a unit test of the mixed-source steps, instead of shaping the steps differently in each caller"

[gotcha.2570]
title = "A Maven suite qualified only with -Dtest selections went red under mvn install"
symptom = "every JVM SDK task verified with -Dtest of its own tests while the platform dependency step runs mvn install, which runs the whole suite; seven tests left behind by three earlier tasks failed the install and stopped two wave aggregates at the readiness check"
fix = "a task that touches a Maven module runs that module's whole suite in its verify command, and an install target that runs tests is itself a product gate"

[gotcha.2571]
title = "A type change compiled against the declared touches only"
symptom = "a task widened a constructor, removed enum variants and added an enum state in its declared files, and eleven callers in five undeclared files plus six integration tests of the same crate broke at build time"
fix = "before declaring touches for a type change, grep the crate for every constructor call, retired variant and exhaustive match, including tests/, and put each file in the touches; the build command compiles the crate's tests with cargo test --no-run"

[gotcha.2572]
title = "A test that demands an externally provisioned fixture document is a vacuous gate"
symptom = "a Move commit test read a protected JSON path from an environment variable naming a provisioned owner, attestor, identity, agent and bank node and panicked NotPresent in every qualification environment, while a sibling test of the same crate already ran the same server in-process over loopback doubles"
fix = "an integration test builds its fixture in-process from doubles the crate's test support provides; when a sibling test already has that fixture, lift it into tests/support and share it rather than invent an external document"

[gotcha.2573]
title = "A committed app-hash vector goes stale when main changes the store encoding"
symptom = "a task carried its generated ICS23 storage vector across a rebase, main had changed the IAVL leaf-version encoding so app_hash, store_root and the proof bytes differed, the compare-mode test failed with 'regenerate with LXP_WRITE_VECTORS=1' and the regeneration consumed the last repair cycle"
fix = "after a rebase of a task that commits a generated vector, regenerate it with its writer switch before the build and commit the result with the rebase, so the first verify runs against the current store"

[gotcha.2574]
title = "A generator that filters one rendering of a schema set but not another breaks parity tests"
symptom = "generate_jvm.py appended operation-retired to the retired variants used for the human ErrorCode enum but built the contract set HUMAN_ERROR_CODES from the raw schema, so GoldenVectorTest (parity with the contract set) and GeneratedCatalogueJourneysTest (parity with the enum) demanded different SchemaErrors.HumanCode sets and no edit of the hand-kept enum could satisfy both"
fix = "every rendering of one schema set in a generator reads the same filtered model; when two generated views of a set disagree, fix the generator and regenerate, never the hand-kept mirror"

[gotcha.2575]
title = "getByRole alert counts the Next.js route announcer"
symptom = "a wallet end-to-end test asserted zero role alert elements after a successful send and found one: the empty aria-live announcer the Next.js app router mounts on every page carries role alert"
fix = "assert the alerts a user can read, getByRole('alert').filter({ hasText: /\S/ }), or a data-role the page's own alerts carry"

[gotcha.2576]
title = "Pending-tag reads outside the send path fail between blocks"
symptom = "eth_gasPrice on the sequencer resolved the pending watermark with a bare Snapshot and answered 'pending block unavailable: sequencer: no block is open' to an ethclient SuggestGasPrice call that landed between a seal and the next open; the send path had been given a bounded wait, the suggestion path had not"
fix = "a suggestion or read RPC that consults the open block falls back to committed values when no block is open; only the send path waits for the next open"

[gotcha.2577]
title = "A helper formula moved and a sibling test kept the old expectation"
symptom = "eth_gasPrice gained the default priority fee in gasPriceHelper and the test beside the one that was updated still expected base fee plus ten percent, so a later task touching the same test file inherited a failing test"
fix = "when a shared formula changes, grep the test tree for every literal built from it and update each; a task that meets a stale sibling expectation fixes it in place and records the commit that moved the formula"

[gotcha.2578]
title = "Browser-session requests to mutating routes need the CSRF pair"
symptom = "a test helper sent the browser session cookie to POST /v1/moves/quote without the __Host-layerx_csrf cookie and X-LayerX-CSRF header and got 403 forbidden, and the repair budget ran out before the fixed request was verified"
fix = "every browser-session request to a mutating route carries both the CSRF cookie and the header; add them in the shared request helper, not per call"

[gotcha.2579]
title = "A manifest change ships without the lock files that pin the crate"
symptom = "layerx-client gained two dependencies and every --locked build in seventeen workspaces refused before compiling; the publishing task listed the manifest but no Cargo.lock, so the lock it refreshed to build was not part of what landed"
fix = "a task that edits a Cargo.toml lists every Cargo.lock that resolves that crate and refreshes them with cargo metadata; a reviewer of a manifest change checks the lock files landed with it"

[gotcha.2580]
title = "Editing a generator file without resealing the pipeline lock"
symptom = "a change to sdk/platform/generators/generate_jvm.py moved the platform-sdkgen generator digest recorded in sdk/platform/pipeline.kvx and platform-sdk-check refused every later aggregate with stale generated SDKs"
fix = "any change under a generator root or a generated output listed in sdk/platform/pipeline.kvx is followed by the sdkgen --write reseal in the same task, and the task's verify runs the sdkgen --check"

[gotcha.2581]
title = "Two reports of one defect became two tasks with the same touches"
symptom = "neighbouring issue reports described the same renderer defect and were drafted as two tasks editing the same files, which would have collided on landing"
fix = "before adding a batch of tasks, group them by touches and keep one task per overlapping set, closing the other reports against it"

[gotcha.2582]
title = "Package names and test sentences in a task's symbol list"
symptom = "a task listed a generator package name and crate names as symbols, and others listed spelled-out test titles; the symbol graph check reported each as not defined and refused the done record although every gate command had passed"
fix = "symbols hold only identifiers the code graph can resolve (functions, types, methods, Go or Rust test functions); packages, crates, scripts and sentence-style test titles belong in the do text and the tests list"

[gotcha.2583]
title = "Deleting a test file without updating its parity row"
symptom = "retirement tasks deleted x-websearch kernel.rs and the mirror checkpoint vector test while spec/layerx-merge/programme/data/parity.kvx still selected those tests, so test_every_row_has_exact_selectors failed for every later task that touched the parity data"
fix = "a task that deletes a test file named by a parity row moves that selector into the row's dropped list and regenerates docs/parity-inventory.md in the same change"

[gotcha.2584]
title = "Markdown and prose test selectors in a task's symbol list"
symptom = "documentation tasks named their check as docs/<page>.md::<title> in tests and repeated the title in symbols; the graph check reported the title as not defined after every verify command had passed, and a Swift method written with its argument labels failed the same way"
fix = "a documentation or shell-only check keeps symbols empty or names real shell functions; a Swift symbol is its bare method name without argument labels"

[gotcha.2585]
title = "Renaming a probe without porting the fixture that serves it"
symptom = "the wallet live check switched its account probe to px_getAccount while the bash fixture suite kept answering lx_getAccount, so the suite failed with Method not found for every case and the next task touching it inherited a red gate"
fix = "a task that renames a request method lists every fixture and test double that answers it in touches and runs their suite in verify, proving the producer and consumer agree in the same change"

[gotcha.2586]
title = "Running a kernel case-table test binary without a case name"
symptom = "A verify command runs a build/tests/kernel/codec binary with no argument; tests/codec/lxp_kernel_case.h:28 prints No case named and exits 2 although every case would pass."
fix = "Name the case (or cases) on the command line, as the task's tests list spells them after the double colon."

[gotcha.2587]
title = "Adding a file under the generated markdown root without declaring it"
symptom = "A task adds a handwritten test under services/agent/sdk/typescript/test/ and the drift gate of the platform generators (--check) fails for the next task as an untracked file in the generated markdown root."
fix = "Declare every handwritten file added under the generated root in sdk/platform/pipeline.kvx [handwritten.<target>] in the same task."

[gotcha.2588]
title = "Serving a method whose kernel activity type was retired"
symptom = "A keeper method still encodes and submits an activity the kernel no longer registers; the kernel answers LXP_ERR_UNKNOWN_ACTIVITY at run time and the test that drives the method fails far from the retirement that caused it."
fix = "When a kernel type is retired, retire or re-point every host, keeper and precompile method that encodes it in the same decision, and assert the refusal in a test."

[gotcha.2589]
title = "Installing a standalone lockfile under the repository workspace root"
symptom = "A package directory carries its own pnpm-lock.yaml but no workspace file; pnpm climbs to the repository root, installs the root workspace and leaves the directory without node_modules, so its type check fails on missing imports."
fix = "Install with --ignore-workspace when the directory has a lockfile and no workspace file of its own."

[gotcha.2590]
title = "Truncating PATH to /usr/bin:/bin inside a test case"
symptom = "A test case rebuilds PATH from a fixture bin directory plus /usr/bin:/bin; toolchains the environment installs elsewhere (python3, go, node) disappear and the script under test reports them missing."
fix = "Prepend the fixture bin directory to the inherited PATH; hide a tool by placing a refusing stand-in in that directory instead of dropping the rest of PATH."

[gotcha.2591]
title = "Blocking inside a Playwright route handler"
symptom = "A route handler awaits a poll or a delay before answering; every fetch of the page to that route stalls behind it and the page state never advances within the assertion timeout."
fix = "Answer every request at once from the current state and keep the waiting in the test body."

[gotcha.2592]
title = "Running a cgo-linked Go step without building the native libraries"
symptom = "A build step runs go test on a package that links the kernel through cgo while only the TypeScript consumer is gated; the link fails or a stale vector is read."
fix = "Build the native libraries (make paxd-native-libs) first in the build step whenever a Go command touches a cgo package."

[gotcha.2593]
title = "Hard-coding a store name in a proof verifier"
symptom = "A verifier names the chain store with a literal that the node never registered; the fixture tests pass because the fixture opens a store under the same literal, and the live proof fails to verify."
fix = "Name the store through one constant shared by the verifiers and the fixture and check it against the node's registered store keys."

[gotcha.2594]
title = "Placing a scope path under the module directory instead of its file"
symptom = "A task lists a reader under chain_evidence/ because its sibling verifiers live there; the file sits one level up beside chain_evidence.rs, the attempt treats it as out of scope and the literal it was meant to remove survives."
fix = "Resolve every scope path with ls before writing it; name files, not the module that uses them."

[gotcha.2595]
title = "Handing a daemon every registered activity type"
symptom = "A test derives the daemon's admitted activity types from the whole registry; the daemon admits one type by design and exits at start, so every request of the test fails before the first assertion."
fix = "Pass the daemon exactly the type it admits and assert the list before starting it."

[gotcha.2596]
title = "Looking for a signed receipt in a fixture that never recorded one"
symptom = "A test expects a recorded receipt for an event the fixture never captured; the receipt is sequencer-signed and its logs are authenticated, so no hand-written recording can replace it."
fix = "Sign the receipt in the test with a key the configuration trusts, as the client receipt tests do."

[gotcha.2597]
title = "Judging a retired test by the absence of its file"
symptom = "A rule accepts a dropped test selector only when its file is gone; a file that kept other tests still exists and the retired function is refused although nothing declares it."
fix = "Accept the selector when the file is absent or no longer declares the function."

[gotcha.2598]
title = "Serving pending-only simulation reads between blocks"
symptom = "The proposer resolves untagged estimates and calls to the open block; between a seal and the next open there is none and clients see pending block unavailable."
fix = "Fall back to the latest committed state when the open-layer error is returned, as the gas price read does."

[gotcha.2599]
title = "Porting one test consumer of a changed producer type and leaving its siblings"
symptom = "A task changes a struct and a constructor, ports the one test file its text names and runs the crate-wide test build; two sibling test targets of the same crate still build the old shape and the build fails after the port."
fix = "Before building, grep the crate's tests for every use of each changed symbol and port them all in the same attempt."

[gotcha.2600]
title = "Build step that regenerates a committed vector"
symptom = "A task's build command runs a producer test in writing mode; the test rewrites the committed vector file, the verification then runs on a candidate the build never saw and the attempt ends with build_on_verified unmet although every step passed."
fix = "Generate and commit the vector once before the build; build and verify run the producer in checking mode and never write a tracked file."

[gotcha.2601]
title = "A struct field changed to Option and the test targets of a sibling crate kept the plain value"
symptom = "A done task changes two public struct fields to Option<u64> and ports the test file its text names; two other test targets of the same crate still build integer literals and every later task whose build compiles the crate's tests fails before touching its own work."
fix = "When a public type changes shape, grep every tests/ file of its crate for constructions of that type and port them in the same task."

[gotcha.2602]
title = "A private copy of a daemon test setup falls behind the daemon's mandatory inputs"
symptom = "One integration test keeps its own copy of the daemon start sequence while a shared support module carries the maintained one; the daemon gains mandatory inputs, the shared tests keep passing and the private copy's daemons exit at start."
fix = "Compare the private setup's environment against the shared support's before ruling on a daemon start failure, and prefer building through the shared support."

[gotcha.2603]
title = "A port instruction that names helper symbols misses literals of a widened type"
symptom = "A ruling asks the implementer to grep for three named constructors; a fourth type the same change widened has struct literals in another test file and the crate-wide build fails once more."
fix = "When a producer type gains fields, name every widened type in the grep instruction, not only the helpers that construct it."

[gotcha.2604]
title = "A finding blames test state when the production path is retired unconditionally"
symptom = "A test expected a finalisation error and got the retirement error; the first ruling asked for the retirement flag to be traced, while the production function returns the retirement error regardless of the flag since an earlier task."
fix = "Read the production function the failing call reaches before ruling on state; an unconditional retirement makes the test's path assertions stale, not the state."

[gotcha.2605]
title = "A test policy copies the shared defaults but not the deployed precompile allow-list"
symptom = "A daemon refuses every call to a precompile whose methods its policy does not list; the test policy mirrors the shared support's defaults, which list none, so the disclosed ledger call is refused with selector_not_allowed after the daemons finally start."
fix = "When a daemon test exercises a precompile call, copy that precompile's method list from the deployed policy file into the test policy."

[gotcha.2606]
title = "A task's symbols list names the symbols the task deletes"
symptom = "The done check validates each listed symbol against the code graph; a deletion task that still lists the deleted symbols passes build and verify and is refused at the done record."
fix = "For deletion tasks list only the symbols that remain after the change; audit the symbols list when writing a delete ruling."

[gotcha.2607]
title = "A sibling task re-shapes the lookup a ruling describes before the ruling runs"
symptom = "A ruling tells the test double to answer the 0x form a production lookup accepted on the day it was written; a later task changes the lookup to a denom-prefixed form and the double's answer is refused."
fix = "Before relaunching a task whose ruling names a production function, read that function's latest commit and re-check the ruling against it."

[gotcha.2608]
title = "A precompile call needs a cap for its own asset, not only the native one"
symptom = "After the method allow-list is in place the daemon refuses the ledger send with no_cap: the spend is recorded against the 32-byte asset id the envelope carries, and the test policy caps only native."
fix = "When a test moves a non-native asset through the daemon, add a cap keyed by that asset's lowercase 64-hex id alongside the method allow-list."

[gotcha.2609]
title = "A crate-wide grep instruction does not override the declared paths"
symptom = "A ruling asks the implementer to grep the whole crate and port every construction site, but the path policy limits edits to the declared paths, so the implementer ports the declared files and stops at the next undeclared one."
fix = "Grep the crate yourself when ruling on a widened type and declare every constructing file on the task in the same batch."

[gotcha.2610]
title = "A retired keeper path refuses before any fixture can be built through it"
symptom = "Tests that create their fixtures through message paths (RequestWithdrawal, RequestForcedExit) all fail with the retirement error once the verifier refuses unconditionally, and a shared-state hypothesis looks plausible because the failures span every test file."
fix = "Read one trace per file first: when each ends in the same retired call, rule on fixtures written directly into the store with the exported key helpers and delete the pure path tests the retirement test already covers."

[gotcha.2611]
title = "An unsigned EIP-1559 body is not what a signer daemon decodes"
symptom = "The daemon decodes the posted transaction with the signed-transaction binary decoder, which needs twelve list items, while the unsigned signing body has nine; a raw test request built from the unsigned encoder fails with 'rlp: too few elements'."
fix = "Post the wire shape the client posts: the nine signing fields plus three empty items, re-wrapped as a type-2 list; read the client's encoder before writing a raw request."

[gotcha.2612]
title = "A module deletion task inherits unported consumers from its requires list"
symptom = "A deletion task listed twenty-two requires on the assumption that they had ported every consumer; forty files still named the modules and the first attempt stopped at the first three compile errors."
fix = "Before launching a deletion task, grep the workspace for the module paths it deletes; when consumers remain, author port tasks per module group with grep-and-build verifies and make the deletion require them."

[gotcha.2613]
title = "A verifier deletion fails the dependent-crate check in the crates that re-export it"
symptom = "Deleting a proof verifier passed the crate's own build and failed the dependents check in the client crate that wrapped it; the daemon wrapped it too, two crates deep."
fix = "Grep every crate of the workspace for the deleted symbol names and declare each consumer file on the task with the exact retirement of its wrapper, variant and callers."

[gotcha.2614]
title = "A trait that mirrors a request method keeps the deleted type alive"
symptom = "A node request method was replaced on the concrete type while the trait that mirrors it for callers kept the old signature and the deleted return type, in a file the task did not declare."
fix = "When replacing a method on a type that also implements a trait exposing it, declare the trait file and rename the trait method and its implementation in the same task."

[gotcha.2615]
title = "A build-with-tests gate inherits every stale test binary of the crate"
symptom = "A task that builds a crate with --tests failed in a test file it never touched: an earlier task changed a constructor's signature and left the kernel-era test calling the old six-argument form."
fix = "When a task changes a signature, grep the crate's tests directory for callers in the same task; when a later task inherits the break, point it at the task that declares the stale file and make it require that task."

[gotcha.2616]
title = "A kms provider test target fails fast with Unavailable outside the runtime clock service"
symptom = "A task that added the provider target to its verify saw 14 of 15 tests fail in 0.03s with a bare Error: Unavailable while the attestor tests passed; the target samples the runtime clock from the environment."
fix = "Run every layerx-human-kms provider verify through cargo run -p layerx-runtime-clock -- --runtime-dir /tmp -- <cargo test ...> and build the clock crate in the build command; a 1-passed/14-failed result in a few milliseconds is this, not a provider break."

[gotcha.2617]
title = "A verify grep that spans two tasks' consumers fails the first task on the second's files"
symptom = "A module split across two port tasks gave the first task a grep over a symbol family the second task's test files still import; the first task's code was complete and its verify failed anyway."
fix = "Give each port task a grep over exactly the symbols it ports and let the dependent task carry the rest of the family in its own verify."

[gotcha.2618]
title = "A removal ruling must list the submodule and test files of the owning module"
symptom = "A do listing the call sites of a removed receipt helper named the module file but missed a submodule file holding the actual call, a context() method building the removed type, three Option parameters and a test file dedicated to the helper."
fix = "Before writing a removal do, grep the symbol and its type across the whole crate including src/<module>/ submodules and tests/, and list every hit with its line."

[gotcha.2619]
title = "A port that introduces a type's twin must re-export it from the old module in the same task"
symptom = "A port defined a selector enum anew in the rpc module while the retained read context still named the old module's enum; the --tests build failed on the ported test with expected old::Type, found Type, and the attempt treated the old module as out of scope."
fix = "Define the type once in the new module and make the old module pub use it, keeping any inherent impl there; list the old module file in the touches when the task introduces the twin."

[gotcha.2620]
title = "A test that reads an environment-named protected fixture file is not a proof"
symptom = "A receipt evidence test demanded an environment variable naming an external fixture file, a configuration from the environment and a live socket; nothing in qualification could satisfy it and the production code it covered stayed unqualified."
fix = "Write the test over the in-tree fixture the crate already has, extending the fixture's doubles where an answer is missing; a test may read no environment variable and open no socket the fixture did not start."

[gotcha.2621]
title = "The symbols and tests lists must not name a test the task deletes"
symptom = "A retirement task's do deleted a keeper test while the symbols and tests lists still named it; go test passed and the graph check refused the task because the symbol was not defined in the graph."
fix = "When a do deletes a test, remove it from symbols and tests in the same ruling and name only retained tests there."

[gotcha.2622]
title = "A touched path another task already deleted fails the graph check"
symptom = "A deletion task listed a source file in its touches that an earlier task had already removed; the implementation deleted everything else and the graph check refused the task on the one path with no change."
fix = "Before listing a deletion, run git log -1 -- <path> on main; a path with a deleting commit leaves the touches and the do notes which task removed it."

[gotcha.2623]
title = "In a split deletion the directory-level test belongs to the last deleting task"
symptom = "Two tasks deleted one crate's files in different waves; the earlier task's test scanned the whole directory recursively and failed on the files the later task owns."
fix = "The earlier task asserts the absence of exactly its own paths; the task that removes the last file requires the others and asserts the directory is gone."

[gotcha.2624]
title = "A --offline build fails once a lock refresh adds a package the registry cache lacks"
symptom = "A build command carried --offline; after a lock refresh added data-encoding to the workspace lock, cargo refused with no matching package found before compiling anything."
fix = "Qualification build and verify commands never pass --offline; --locked alone pins the resolution."

[gotcha.2625]
title = "A touched path written from memory must be checked with ls before the task is published"
symptom = "A task named a stylesheet under src/app/ while the file lives under src/styles/; the attempt made every other change, declined to edit a file outside its touches, and failed its verify grep on the two references in the real file."
fix = "Run ls or git ls-files on every touches entry when authoring a task; a path that does not exist on main is a spec defect, not an implementation gap."

[gotcha.2626]
title = "A task that changes a constructor signature must build its crate's tests before it is done"
symptom = "A done task narrowed a witness constructor from six arguments to one and left three call sites in a same-crate integration test unported; its verify built the library only, and every later task whose verify builds the crate with --tests inherited the compile error."
fix = "A signature-changing task's verify includes cargo build --tests for its own crate, and its touches list every test file that calls the changed item; a later task that meets the break requires the task that owns the test file instead of patching it."

[gotcha.2627]
title = "Two tasks whose test builds each need the other's fix deadlock unless the shared fix moves to the first in requires order"
symptom = "Task A's --tests build failed on a missing error impl assigned to task B, and task B's --tests build failed on a test file task A owns; after B was made to require A, A still could not pass, because the impl stayed in B."
fix = "When a later task's finding sequences it after an earlier one, move every fix the earlier task's verify needs into the earlier task in the same batch, and leave the later task a do that drops its duplicate hunk on rebase."

[gotcha.2628]
title = "A task that removes a crate from a workspace manifest must list every file that names that crate"
symptom = "A task deleted a crate from the human workspace manifest and the dependent service manifest, with its touches limited to the two manifests, the lock file and a boundary test; the service build failed on an uncalled method and a test that still imported the removed crate."
fix = "Before authoring a dependency removal, grep the crate's snake_case identifier across the workspace sources and tests, add every hit to the touches with a do that ports or deletes it, and make the verify compile the test targets that named it."

[gotcha.2629]
title = "A spec that names a wire enum value must quote it from the schema type's variants list"
symptom = "A task told the service to answer verification receipted or committed; the response type declares verification as a VerificationLevel whose variants are receipt-verified and checkpoint-finalised, with the rung names mapped beside them, so the faithful implementation was refused by the response schema at runtime and the test asserted an undeclared field."
fix = "Before writing a wire value into a do or acceptance criterion, open the schema type the operation's response names and copy the variant spelling; when the task wants the rung as well, declare it as the schema already does for sibling types."

[gotcha.2630]
title = "A decoder contract change must port the crate's own fixture test, not only the consumer it was written for"
symptom = "A done task changed the history page decoder to the served three-key shape and added a head read after each page, verified by a new daemon test, and left the client crate's integration test fixturing the old six-key page without a head exchange; the next task whose verify ran that test target failed on it."
fix = "A task that changes what a decoder accepts lists every test in its own crate that fixtures the old shape in its touches and runs that test target in its verify; a later task that meets the stale test ports it when it owns the file, or requires the owner when it does not."

[gotcha.2631]
title = "A recovery fixture's protocol spend must be covered by the receipts and holds the test supplies"
symptom = "A task text told a recovery test to expect the shared fixture record's spend of 25 to reconcile while the request carried no receipts and no holds; the restart rule reconciles only a spend between the receipt total and the receipt total plus unresolved holds, so the faithful test failed."
fix = "When a do names the expected accounting of a recovery, read the reconcile rule first and either serve a record whose spend the supplied receipts cover or assert the unreconciled outcome; the retired test being replaced shows which record it used."

[gotcha.2632]
title = "A task that deletes a crate must also drop its workspace member line in the same tree"
symptom = "A retirement task deleted a crate directory and its manifest but left the crate listed under [workspace] members, so every build of that workspace at main failed at manifest load until a later task removed the line; an unrelated attempt in the window was charged a failed build."
fix = "When a do deletes a crate, name the workspace manifest among the touches and say the member line goes with it; when an attempt fails at manifest load, check whether main at its base revision is consistent before reading further."

[gotcha.2633]
title = "Dropping a dependency from a crate's manifest stales every workspace lock that resolves that crate"
symptom = "A retirement removed two dependencies from a registry crate's manifest and regenerated only its own workspace lock; seventeen other lock files that resolve the crate by path still listed the two rows, so every --locked build of six other workspaces refused at main and sixteen implemented attempts failed before compiling."
fix = "When a do edits [dependencies] of a crate other workspaces resolve by path, list every Cargo.lock that names the crate in the touches and regenerate them in the same task, as task 9.25.16 did; when many attempts fail at once with 'lock file needs to be updated', look for the manifest change on main before reading any attempt."

[gotcha.2634]
title = "A manifest dependency removal is qualified with the crate's test targets, not its library alone"
symptom = "A task removed two crates from a test crate's manifest, built only the library target and verified the resolved dependency graph; three integration test files still imported the removed crates, and the workspace-wide dependent-crate check of the next programs task failed on them."
fix = "When a do removes a dependency, make the build gate cargo build --tests (or cargo check --all-targets) of the edited crate and grep the removed crate names out of its tests directory in the verify."

[gotcha.2635]
title = "Deleting a crate manifest must sweep the path dependency rows of every other workspace"
symptom = "A retirement deleted a crate's Cargo.toml inside its own workspace and verified only that workspace's metadata; another workspace still declared the crate as a path dependency for a member's test target, so that whole workspace stopped loading and every gate rooted in it failed at cargo metadata before building anything."
fix = "Before a do deletes a crate manifest, git grep the crate name across every Cargo.toml in the repository; list the dependent manifests, their test files and locks in the same task's touches or make a same-wave task that the deletion requires retire those consumers first, and make the deleting task's verify read cargo metadata --locked of every workspace that named the crate."

[gotcha.2636]
title = "A task whose touches are only lock files or manifests declares no symbols"
symptom = "A lock refresh task listed the resolved package name under symbols; the completion graph check looked for a code symbol of that name among the touched files, found none in seventeen lock files, and refused the record after every gate had passed."
fix = "Put a name under symbols only when a touched source file defines it; for lock, manifest, fixture or documentation tasks leave symbols empty and name the package in the dos instead."

[gotcha.2637]
title = "Retiring a public verifier must sweep its callers in every workspace, not only the producer's"
symptom = "A retirement deleted a proof verifier and ported the callers inside its own workspace; a service in another workspace still called the verifier at two sites, so that whole workspace stopped compiling and seventeen implemented tasks failed at their first build after rebasing."
fix = "Before a do deletes a pub item, git grep its name across the repository and list every calling file in the task's touches or make a same-wave task the deletion requires port the other workspaces first; the verify of the deleting task compiles each workspace that named the item."

[gotcha.2638]
title = "An acceptance that asserts no reference remains must require every task that deletes a referencing file"
symptom = "A module deletion whose acceptance test scans the workspace for the module name failed because a sibling deletion task in the same wave still owned the one remaining importer; the scan is only satisfiable after that sibling lands."
fix = "When a do or acceptance scans for a retired name across sources, git grep the name at authoring time and add every task that deletes or ports a hit to the task's requires, or move the scan to the last deletion of the series."

[gotcha.2639]
title = "A precondition grep over a crate must skip files that the module tree no longer reaches"
symptom = "A module-retirement task required a repository grep to print nothing before its build; the grep matched an import inside an orphaned submodule file that the compiler never reads once the parent module declaration is gone, the file sat outside the task's touches, and the attempt stopped without running a single gate."
fix = "Scope a precondition grep to the files cargo compiles, or name the orphaned files the grep must skip and the task that deletes them; a task's gates run regardless, and a precondition hit outside the touches is a finding, not a reason to skip the build."

[gotcha.2640]
title = "A verify that repeats a precondition grep needs the same exclusions"
symptom = "A precondition grep was amended to skip orphaned files, but the task's verify_cmd carried the same grep unamended; the next attempt built, passed its dependent-crate check and failed on the verify's grep over the same orphan."
fix = "When a precondition grep changes, read the verify_cmd for the same expression and change both in one batch."

[gotcha.2641]
title = "A declared touch that another task already deleted fails the graph check"
symptom = "A task declared a file in touches that an earlier task had deleted; the attempt made every other change, built and tested, and cg spec done refused because the touched path had no matching change."
fix = "Before a task launches, drop touches that no longer exist on main and say so in a do line; the graph check needs a change for every declared touch."

[gotcha.2642]
title = "A done task's deletion is verified against the live tree before a dependent ruling"
symptom = "A retirement scan hit a Makefile target that a done task's do line had promised to remove; the target was still on main at a different line and no pending task owned it."
fix = "When a ruling leans on a done task's deletion, grep the live tree for the deleted item first and open a fix task when it survives."

[gotcha.2643]
title = "Substring rules in a policy check must respect identifier boundaries"
symptom = "A private-path rule matched the token snapshot.bin inside the identifier snapshot.binding_tenant and reported a production file as reaching node-private state."
fix = "Match path tokens only where the neighbouring characters are not identifier characters, and keep a fixture test for an identifier that merely contains the token."

[gotcha.2644]
title = "A later ruling that keeps a module must be written into the task that deletes it"
symptom = "An owner decision kept a module reachable through a re-export, but the deleting task's do_1 still listed that module; the attempt followed do_1 and the build failed on the re-export."
fix = "When a decision changes what a pending task deletes, add the decision as a do line and amend touches and verify in the same batch."

[gotcha.2645]
title = "An issue task's verify runs the subtests that prove the issue's path"
symptom = "An issue task about a test's resource lifetime verified the whole end-to-end suite; eighteen attempts fixed the lifetime and then failed on four unrelated subtests of the same suite, each a separate defect."
fix = "Scope an issue task's verify with -run to the subtests that prove the reported path, and give the suite's other failures their own task that requires the issue task."

[gotcha.2646]
title = "A retirement grep over a conformance tree must skip an SDK that still exports the name"
symptom = "A verify grepped a conformance directory for a type the TypeScript SDK retired and matched Python conformance files that import the same name from the Python SDK, which keeps it."
fix = "Limit a retirement grep to the file types of the SDK that retired the name, or exclude the trees that legitimately keep it."

[gotcha.2647]
title = "A shared crate's API change must build every crate that consumes it before the task is done"
symptom = "A task retired four items of a proof crate's export API; its dependent-crate check built two interop crates and passed, while the agent daemon in the same workspace used all four items and has failed to build on every main since."
fix = "List the consuming crates of a changed public item across every workspace from a grep before qualification and build each one in the task's verify."

[gotcha.2648]
title = "A module retirement needs a consumer census and a port task per consuming crate before it launches"
symptom = "A task deleting three modules of a shared crate carried wiring requests for its consumers but no port tasks; the census after the second attempt found 94 consumer files across four workspaces with no owner."
fix = "Grep every workspace for the module paths and the retired item names when the retirement task is written, give each consuming crate a port task, and make the retirement require all of them."

[gotcha.2649]
title = "A boundary decoder extended on one side needs the producer's bytes in its test, not a hand-built frame"
symptom = "A consumer's receipt frame decoder was extended with nine fields and tested against a frame the test itself assembled; the producer kept writing the short frame and every real answer failed to decode."
fix = "Define the frame once where both sides can import it and feed the producer's encoder output to the consumer's decoder in the test."

[gotcha.2650]
title = "A new status value in a producer lands with the published schema and every SDK decoder"
symptom = "A daemon began answering not-ready lookups with two new verification statuses; the published contract and four SDK decoders still accepted the two old shapes, so a successful answer became an SDK verification failure."
fix = "Change the contract file and add producer goldens first, then give each SDK decoder a task that consumes those goldens."

[gotcha.2651]
title = "Deleting a test branch must delete the script that invoked it"
symptom = "A task removed the Rust probe branch of a qualification test and left the Python qualification calling the test executable for that branch, so the qualification re-entered itself."
fix = "When a task removes a code path, grep the repository for every caller of its entry point, including scripts, and list them in touches."

[gotcha.2652]
title = "A simulation read must not hand the open block's height to the committed-state provider after the block seals"
symptom = "An estimate read the open block's state and header, the block sealed before the precompile lookup, and the lookup asked the base app for a query context at the open height, which was above the committed height, so the handler panicked."
fix = "Resolve every height above the committed height on the simulation path to the open-block snapshot while it is open and to the latest committed context otherwise; never pass a height above the committed one to the base app."

[gotcha.2653]
title = "A task changing a package's exports must compile the package's own consumers in the same task"
symptom = "A task changed two source files of a TypeScript package and left the package's third file, which imports both, to a later task; the package's tsc project compiles every source file, so the task's build failed on the file it did not own, which was also broken on main by earlier ports."
fix = "When a package port is split across tasks, each task's build target must compile at its end: keep in-package consumers of changed exports in the task that changes them, and check the package compiles on main before the split is written."

[gotcha.2654]
title = "An offline Foundry build at the repository root needs the pinned compiler fetched first"
symptom = "A build running forge build --offline from the repository root failed with 'can't install missing solc 0.8.27 in offline mode'; the qualification environment prefetched the compiler only for a project named with --root."
fix = "When a forge command names no --root, fetch the solc_version of the repository root's foundry.toml with one online build before the offline build runs."

[gotcha.2655]
title = "An x402 offer the seller middleware verifies must carry the receipted commitment and a purpose"
symptom = "An integration built its payment requirements with no extra terms; the buyer paid and the seller answered 402, because its verifier requires a non-zero purposeHash under extra.layerx on the offer it issued."
fix = "Every seller-side offer carries extra.layerx with commitment receipted and a deterministic 64-hex purposeHash bound to the resource; assert it on the 402 response in the integration test."

[gotcha.2656]
title = "A test that imports packages through their dist entries needs those packages built by the task's build"
symptom = "A task's build was a syntax check of one script; its test imported four workspace packages through node_modules dist entries that nothing had built, and failed with ERR_MODULE_NOT_FOUND."
fix = "List every workspace package the test imports, directly or through support files, and build each one in the build command before the check."

[gotcha.2657]
title = "Dependents of a crate broken at the base are invisible to the dependent-crate check"
symptom = "A task deleted a module of a shared crate while another crate of the workspace did not build at the base; the check left out every crate depending on the broken one, which were exactly the deleted module's consumers, and the service did not build on main for two hours."
fix = "While any crate is broken at the base, grep its dependents for the retired names by hand before the retiring task qualifies, and keep the broken list empty as a priority."

[gotcha.2658]
title = "A retirement task must name every consumer file of the retired item, not only the ones a wiring request lists"
symptom = "A task retired an owner-activity module naming one KMS test as its consumer; a grep of the workspace shows four service sources, two service tests and one more KMS test calling it."
fix = "Write the retirement's do lines from a grep of every workspace for the item's path and names, and make the verify repeat that grep."

[gotcha.2659]
title = "A task block with an empty owner role stalls the collection of every finished task behind it"
symptom = "A node task was written with owner_role empty because its parent block had no owner key; when its first attempt finished, the collector could not name the branch to merge onto, raised, and nine other finished results waited behind it for a quarter of an hour."
fix = "Give every task the owner role of its family (the node rpc tasks are fm-node-runtime) and let the collector skip and report a result it cannot merge instead of stopping."

[gotcha.2660]
title = "A configuration-only task must not declare the whole tree's compiler run as its build"
symptom = "A task editing the root Foundry profile and one Python test declared forge build at the root as its build; the root Solidity tree had 42 missing imports from retirements already on main, and three attempts failed before any test ran."
fix = "Declare a build that exercises exactly the files the task touches (a configuration parse, a byte-compile) and leave the tree build to the tasks that own the sources."

[gotcha.2661]
title = "The recorded receipt vectors carry the sequencer's signing digest under the name receiptDigest, not the portable receipt digest"
symptom = "An integration test compared the buyer middleware's portable receipt digest, keccak256 of the signed receipt, with the receiptDigest field of the recorded vector, the signing digest over the unsigned receipt, and failed on two valid but different values."
fix = "Derive the expected portable digest from the vector's signedReceipt bytes with keccak256, as the buyer middleware tests do, and treat the vector's receiptDigest as the signing digest only."

[gotcha.2662]
title = "An SDK's verification level table must follow the daemon's rung names when they change"
symptom = "A Python decoder kept the six retired kernel verification levels while the daemon, its goldens and the same SDK's x402 client used the three rungs, so every not-ready status failed local verification."
fix = "When a producer renames an enumerated field's values, grep every SDK for the old names and port the tables and tests in the same change."

[gotcha.2663]
title = "A verifier must not require a field the offer contract makes optional for one scheme"
symptom = "A seller required a purpose hash on every offer while its own parser, the documentation and the interop seller made it optional for exact offers, so the exact-scheme example verified no receipt."
fix = "When a verification step reads an offer field, take the required flag from the same scheme rule the offer parser applies, and cover the optional case in the verifier's tests."

[gotcha.2664]
title = "A mismatch test must construct a mismatch the verifier's inputs let it observe"
symptom = "A test swapped a validator the commit never signed for and expected a refusal, but the evidence carries no validators hash, so the verifier saw three valid signatures of four and accepted."
fix = "Read the verifier's input type before writing a refusal test; mutate a field it compares, here a signing validator, and name the failure the verifier emits."

[gotcha.2665]
title = "A reachability guard must recognise every runner the tree uses"
symptom = "A guard that every pytest suite is passed to pytest flagged 21 SDK suites that a Makefile rule runs through unittest discover on their directory."
fix = "List the runners in the Makefile and workflows before writing a reachability rule, and accept each runner's directory form."

[gotcha.2666]
title = "A retirement's consumer request must name every platform binary that calls the retired item"
symptom = "A proof-crate retirement routed its platform callers through a request naming the hosted core only; the hosted gateway called the same function and has not compiled since."
fix = "Grep every workspace for the retired path and list each calling crate in the request or as its own port task before the retirement lands."

[gotcha.2667]
title = "A helper added to a private module needs the parent's re-export in the same task"
symptom = "A task declared the file of a new pub(crate) helper and its callers but not the module file that declares the helper's module privately, so the callers failed with E0603."
fix = "When a task adds an item to a module, list the module's parent file in touches and spell out the re-export line."

[gotcha.2668]
title = "A closure gate that requires every task of a family must have its requires completed when the family grows"
symptom = "A gate task written to run after all issue tasks listed 444 of them in requires; 89 issue tasks written later were not added, so the gate launched with three of them pending and failed on its own check."
fix = "When a task is added to a family that a gate task closes, append it to the gate's requires in the same batch, and build the gate's check to read the live task list so an omission still fails loudly."

[gotcha.2669]
title = "A configuration test must not build a source tree whose retirements are still pending"
symptom = "A test asserting a Foundry profile's permissions also ran forge build on the root sources; a retired security contract had been deleted while a storage contract importing it waits for its own retirement two waves later, so the build failed on every main in between."
fix = "Keep a profile or configuration test to the configuration it checks, and leave building the sources to the tasks that delete or keep them."

[gotcha.2670]
title = "A recorded receipt vector proves the verifier directly, never a served offer whose purpose is derived from the request"
symptom = "An integration test paid a server with a recorded sequencer receipt after the offer's purpose hash had been defined as a hash of the resource URL; the recorded receipt's purpose could not match and the server refused with 402."
fix = "Use recorded vectors against the verification function with their recorded terms, and drive served round trips, including restarts, with receipts the test signs over the offer it fetched."

[gotcha.2671]
title = "Retiring a module's public names must run every suite that imports them, not only the retiring crate's own tests"
symptom = "A task removed the checkpoint verifier from a Python SDK and ran the SDK's tests; two repository suites importing the removed names failed collection on every main for four days until an unrelated task added them to its verify."
fix = "Grep the repository's test trees for each removed name when the retirement task is written and either port those suites in the same task or give them their own task the retirement requires."

[gotcha.2672]
title = "A test-support file included by #[path] belongs to the task that deletes what it calls"
symptom = "A port task listed the integration tests it rewrote but not the support module five of them include by #[path]; the module still called three deleted canonical envelope functions, and the crate's --all-targets build failed in a test target outside the task's list."
fix = "When a task deletes or ports an API, grep the crate's tests/support directory as well as its test files, and declare every support module that names the API as a touch."

[gotcha.2673]
title = "A path a prerequisite task deletes must not stay in the touches of the task that confirms the deletion"
symptom = "A task listed a module among its touches while its first step only confirmed that a required task had already deleted it; the attempt changed nothing there, the verify passed, and the done record's graph check refused the task for an untouched path."
fix = "List as touches only the paths the task itself changes; put confirm-absent paths in the do text, never in touches."

[gotcha.2674]
title = "Narrow a blocked retirement to the items whose consumers are already gone instead of holding the whole task"
symptom = "A crate retirement sat blocked behind ninety-four consumer files; a census showed one deleted module had two test consumers and one encoder none, while the rest of the deletion set fed the daemon's whole preparation path."
fix = "Split the retirement: delete the unconsumed items now with their two fixture ports as requires, and move the consumed items to a blocked follow-up that requires the consumer migration family."

[gotcha.2675]
title = "A retirement's consumer grep must cover test targets of every crate, or a crate's tests stay broken for weeks unnoticed"
symptom = "A task deleted four canonical envelope functions and ported the service callers it listed; a KMS test target that only test code includes kept calling them, failed to compile on every main since, and was silently left out of the dependent-crate check as broken at the base."
fix = "Grep tests/ and tests/support/ of every workspace crate for the deleted names when the retirement is written, and give each broken test target an owner before the retirement runs."

[gotcha.2676]
title = "A retired exported Go constant must be built across the module, not just its own package"
symptom = "1.36.1 deleted codec.AvailabilityClassCount and passed its package gate; the layerxanchor keeper still used it, so paxd and every Go test package importing the app failed to build for the next tasks."
fix = "When a Go retirement deletes an exported identifier, grep the module for its last uses and build ./... or at least the daemon and modules trees in the task's build command."

[gotcha.2677]
title = "Do not gate a crate with --all-targets while some of its test targets are broken by an earlier task"
symptom = "10.21.8's --all-targets build of layerx-human-service failed three times on two test files no task owns, after the task's own port was complete."
fix = "Name the library, binaries and the touched test targets in the build command; record the pre-existing broken targets as a finding against their producer."

[gotcha.2678]
title = "A vectors producer outlives the type it serialises unless its retirement task names it"
symptom = "1.12.1 retired lxp_grant_state; the C producer of the wallet capability vectors still emitted grant vectors over it and broke the shared cc step of three later tasks."
fix = "When retiring a wire type, grep tests/qualification and the vectors producers for it and either delete the vector or move it into the retirement task."

[gotcha.2679]
title = "Delete a transport module only after a consumer census, and re-home shared types where their users live"
symptom = "9.24.7 deleted the LNI module whose Version type two RPC files import and whose transport the agent daemon library, seventeen test targets and the pay2e qualification still use."
fix = "Before a module deletion, grep every crate for its path; re-home shared types next to their consumers in the same task and block the deletion until the transport consumers have port tasks."

[gotcha.2680]
title = "Re-check a retirement decision's consumer basis before the task runs; new work may have adopted the surface"
symptom = "Decision 681 counted Governed.sol's importers in September; the .pax names contracts inherited it on 2026-10-31 and a gate written against the old basis failed on four live suites."
fix = "When a retirement task becomes eligible, grep the repository for the surface again and supersede or re-scope the task if live consumers appeared after the decision."

[gotcha.2681]
title = "The libtest harness takes --exact once; list every test name after a single flag"
symptom = "A verify command of the form `-- --exact a --exact b` fails with `Option 'exact' given more than once` before any test runs."
fix = "Write `-- --exact a b`; the filter names after one --exact are all matched exactly."

[gotcha.2682]
title = "A verify that compiles a test package must be checked against the package's state on main, not only the file the task changes"
symptom = "6.96.5 changed one non-test file and its verify ran go vet and go test of the keeper package, whose test file had not compiled since a loader retirement; the task failed on an error it did not cause."
fix = "Before declaring go vet or go test of a package, grep the package's _test.go files for symbols retired by done tasks; if the package is broken on main, verify through another package and write the repair as its own task."

[gotcha.2683]
title = "A manifest change in a crate that another workspace resolves by path drifts that workspace's lock file"
symptom = "9.28.1 removed a dependency from three agent crates and refreshed the agent locks; services/platform/Cargo.lock, which carries those crates through a path dependency, kept the removed package, and every --locked build under services/platform failed, including the clock runner the human gates start with."
fix = "When a task edits a Cargo.toml, list every Cargo.lock whose workspace resolves that crate by path (grep for the crate's directory in */Cargo.toml path = entries) and add the lock to touches with a cargo metadata --locked check in the verify."

[gotcha.2684]
title = "A retirement task that adds a reference-scan test must list the documents that name the retired assets"
symptom = "8.32.2 deleted the relay archive installer and added a test asserting no platform file names its variables; the directory's README documented the installer and its variables and failed the task's own test."
fix = "Before writing a scan test, grep the scanned tree for the retired names and add every hit, documentation included, to touches with a do that rewrites or deletes it."

[gotcha.2685]
title = "A task that deletes a Rust module file must also touch the parent that declares it"
symptom = "9.24.6 listed four submodule files of lni for deletion; lni/mod.rs kept their `pub mod` lines and re-exports, the crate failed with E0583, and two attempts stopped at the build because the module root was out of scope."
fix = "For every src file in a deletion list, add the file holding its `mod name;` line (and any `pub use name::` re-export) to touches with a do that removes those lines; grep the crate for `name::` before writing the verify."

[gotcha.2686]
title = "A test that drives a retired transport fails with the SDK's refusal code, not with an assertion"
symptom = "Two journal tests fed an HTTP fake to a journal that had moved to JSON-RPC eth_sendRawTransaction; every run stopped at EvmTransportUnavailable, and three attempts repaired the fixtures around it."
fix = "When a test fails inside the SDK with a transport-availability code, read the SDK method's current contract first and rewrite the test's transport and expected states to it; do not teach the fake the old protocol."

[gotcha.2687]
title = "A run card's profile key must be the dominant profile of its domain's tasks"
symptom = "17.7.5's render_counts refused the domain 15 card: it declared go while 29 of the domain's 58 tasks declare go-cgo, and the verify failed before the counts rendered."
fix = "Before declaring a card check, count the domain's task profiles and set the card's profile key (line 4 of the card) to the most common one; a kernel-bearing domain is go-cgo."

[gotcha.2688]
title = "Human-workspace cargo tests run under tools/runtime/run-with-clock.sh"
symptom = "9.35.9's verify ran cargo test on layerx-human-kms directly and twelve tests failed with Error: Unavailable because Host::new opens the runtime clock socket that the Makefile provides through sh tools/runtime/run-with-clock.sh."
fix = "Prefix every human-workspace cargo test in a verify with `sh tools/runtime/run-with-clock.sh `; the wrapper builds layerx-runtime-clock from services/platform and exports the socket; a --no-run step does not need it."

[gotcha.2689]
title = "A verify test that runs a repository script must be checked for the script on main"
symptom = "6.96.5's verify named TestBringUpAnchorGenesisValidates, which runs services/platform/hosted/paxeer/anchor-genesis.py through os/exec; task 8.14.2 had deleted the script, so the test failed on main before the task's change was exercised."
fix = "Before naming a test in a verify, grep it for exec.Command, subprocess or a script path and confirm the target exists on main; otherwise choose another test of the package and delete or port the orphan in its own task."

[gotcha.2690]
title = "A route retirement must delete the helpers the route called, and its verify must assert the import absent"
symptom = "Tasks 8.7.3, 8.8.3 and 8.20.1 retired the hosted kernel routes and passed verifies that checked the routes answer 404, leaving decode, verify and submit helpers compiled behind them; the kernel codec deletion later found 65 importing files."
fix = "When a task retires a route, list the handler chain it alone reached in the do items and end the verify with `! grep -rnE 'retired::path' crate/` so the deletion is provable per crate."

[gotcha.2691]
title = "A generator task must not reintroduce an import an earlier task retired; the retirement test must name the import, not only symbols"
symptom = "12.95.1 added `use layerx_wire::activity::{decode_unsigned, encode_unsigned}` back into the attestor vectors generator a month after 12.18.2 removed it; the generator's retired-name test scanned for other strings and passed."
fix = "A retired-name test asserts the module path (`layerx_wire::activity`) absent, not just the functions; a task that touches a file with such a test reads the test's list first."

[gotcha.2692]
title = "A runcard check that compares every card against the spec fails on the first mismatch; fix all cards in one attempt"
symptom = "17.7.5 attempt 2 fixed the domain-15 card and failed on domain 4; three more cards (12, 16, 17) would have cost three more attempts."
fix = "When a verify iterates a collection against the spec, compute the expectation for every element from the installed spec before the repair and fix them all in one attempt."

[gotcha.2693]
title = "A module whose AppModule was removed from the app has no routed message handler; its route tests fail for ever"
symptom = "6.96.5 attempt 4 ran modules/layerxanchor TestAppRoutesAnchorUpdateParamsRetired, which asserts MsgServiceRouter().Handler(MsgUpdateParams) is not nil; task 5.7.1 had removed the anchor AppModule from node/app.go, so the handler is nil on main."
fix = "Before picking a Go test for a verify, confirm the module is still wired in node/app.go (NewAppModule in the module manager, not only AppModuleBasic); otherwise build and vet without a test and delete the stale test in the task that restores the package's tests."

[gotcha.2694]
title = "A standalone package under a crate's tests/ directory is not a cargo test target"
symptom = "A verify named `--test local` for services/platform/hosted/gateway/tests/local/, which has its own Cargo.toml and [workspace]; cargo answered `no test target named local` and the attempt failed after a passing implementation."
fix = "Before declaring --test <name>, check that tests/<name>.rs or tests/<name>/main.rs exists in the crate; a directory with its own Cargo.toml is a separate package that needs its own --manifest-path or its own retirement."

[gotcha.2695]
title = "A --locked build of a standalone qualification package needs a committed Cargo.lock"
symptom = "services/agent/qualification/pay2 had no Cargo.lock on main; `cargo build --locked` failed before compiling anything."
fix = "When a task declares --locked against a manifest outside the main workspaces, confirm the lock file exists on main or make the task generate and commit it."

[gotcha.2696]
title = "go build of a tree whose cgo packages link make-built archives fails in the linker; prove compilation with go vet"
symptom = "A gate that ran `go build ./daemon/...` failed with `cannot find -llayerx` because modules/lxphost declares LDFLAGS against build/ and programs/target/, which only make produces."
fix = "Use `go vet <tree>` to type-check and compile cgo without linking, as the daemon build commands already do; reserve go build for trees with no cgo archive dependency or for a verify that runs make first."

[gotcha.2697]
title = "A deleted exported SDK type can have consumers outside the services tree; grep tools/ and apps/ before deleting"
symptom = "9.25.17 deleted three rpc_verification types after grepping services/agent; tools/platform/cli/src/wallet.rs constructed them at eight sites and the CLI stopped compiling for every later task."
fix = "Before a task deletes an exported item, grep the whole repository for its path and name, and list each consumer workspace in the task's do items or in a follow-up task that the deletion task requires."

[gotcha.2698]
title = "Explorer unit tests are *.spec.ts under vitest, not *.test.ts"
symptom = "A new apps/explorer test file named *.test.ts is never collected: apps/explorer/vitest.config.ts:18 includes only **/*.spec.ts and **/*.spec.tsx, and the package has no jest."
fix = "Name explorer unit tests *.spec.ts and run them with yarn --cwd apps/explorer vitest run <file>; the playwright scripts (test:pw) are for component screenshots only."

[gotcha.2699]
title = "Launchpad vitest collects src/**/*.test.ts(x) only"
symptom = "A verify naming a node:test *.test.mjs file under apps/launchpad/web exits 1 with 'No test files found': apps/launchpad/web/vitest.config.ts:11 includes only src/**/*.test.ts and src/**/*.test.tsx, and the existing creation-domain.test.mjs is not part of any verify."
fix = "Name launchpad unit tests *.test.ts or *.test.tsx and run them with pnpm --dir apps/launchpad/web exec vitest run <file>."

[gotcha.2700]
title = "Human-service tests that panic 'agent runtime peer: Unavailable' in 0.00s are missing the runtime clock"
symptom = "AgentRuntime::new and connect read RuntimeClock::from_environment (services/human/crates/layerx-human-service/src/server/agent_runtime.rs:2141, :2204) and map its absence to AgentBoundaryError::Unavailable, so every test that builds a runtime fails instantly when the clock is not running."
fix = "Run human-workspace cargo tests through sh tools/runtime/run-with-clock.sh as the Makefile does (Makefile:1640, :1679); only --no-run invocations may stay bare."

[gotcha.2701]
title = "An explorer type check run with yarn --cwd resolves -p against the package"
symptom = "yarn --cwd apps/explorer tsc --noEmit -p apps/explorer/tsconfig.json fails with TS5058 'The specified path does not exist' because tsc runs inside apps/explorer and looks for apps/explorer/apps/explorer/tsconfig.json."
fix = "Write the project path relative to the package: yarn --cwd apps/explorer tsc --noEmit -p tsconfig.json."

[gotcha.2702]
title = "cargo build --tests compiles every test target of the crate, including files the task never touches"
symptom = "A build_cmd of cargo build -p <crate> --tests fails on a pre-existing compile error in an unrelated tests/*.rs file (9.35.11 attempt 3 failed on tests/native_journey_approval.rs:233 and tests/support/canonical_owner.rs:190, neither in its touches)."
fix = "Before declaring a --tests build, confirm every test target of the crate compiles on main or make the task require the task that repairs the broken target; when a build fails outside the touches, record the finding and add the requirement rather than widening the task."

[gotcha.2703]
title = "A retirement test that asserts a symbol absent from the kernel archive needs every task that deletes a definer of that symbol"
symptom = "1.32.1 attempt 1 deleted src/paxeer/lxp_checkpoint_cert.c and still found lxp_guarantor_attestation_verify in build/liblayerx.a because src/guarantor/lxp_attestation.c (deleted by 1.31.1, which landed later) defined it too; 1.32.1 did not require 1.31.1."
fix = "When a task's test asserts symbols absent from an archive, grep the whole source tree for every definer and add each deleting task to requires."

[gotcha.2704]
title = "Completion gates must skip retire interfaces a later decision keeps"
symptom = "5.0.9 attempt 1 inventoried every retire-status interface of its domain and failed on the two LayerXAnchorStoreKey entries that decision 1954 keeps until the anchor-store-delete step; the gate was asserting against the design, not the code."
fix = "Before writing a completion gate, set each superseded interface to status keep in interfaces.kvx with a notes line naming the decision, and size the inventory on the remaining retire entries (decision 2278)."

[gotcha.2705]
title = "k256 is not a dependency of the platform CLI"
symptom = "A CLI change that calls k256::ecdsa::SigningKey directly fails the build with E0433 'unresolved module or unlinked crate k256': tools/platform/cli/Cargo.toml lists layerx-crypto, not k256."
fix = "Sign EIP-1559 calls through layerx_crypto::evm_transaction::Eip1559Call::sign and derive addresses with layerx_crypto::secp256k1::evm_address, as wallet_signing::EvmSigningKey does."

[gotcha.2706]
title = "Retired env names survive on purpose in refusal lists"
symptom = "A search for a retired setting's bare name finds refuse_retired_environment in the agent daemon, RETIRED_VARIABLES in the boundary harness and the host test asserting the refusal; none of them reads the setting."
fix = "Judge an env_var retirement by the absence of std::env::var and var_os reads outside the refusal list (decision 2279); a test that still sets a retired name before asserting a later required-variable error cannot pass and must drop the setting."

[gotcha.2707]
title = "A node verify that imports workspace packages lists their builds in dependency order"
symptom = "Three tasks failed with ERR_MODULE_NOT_FOUND on dist entries of @sidiora packages their tests imported directly or through a support module; the workspace was installed but nothing built, and one build was not enough when the imported package itself depended on another unbuilt one."
fix = "Prefix the verify with npm --prefix <package> run build for every imported package and its dependencies, ordered SDK, seller, buyer and merchant middleware, agent middleware, then integrations (decision 2282)."

[gotcha.2708]
title = "Adding a variant to ConstructMethod breaks every exhaustive match in the human service"
symptom = "A task added ConstructMethod::ProgramCall in layerx-crypto and its gates built the agent workspace; the human service's bound_activity match was non-exhaustive (E0004) and no human-workspace task could build until an arm landed."
fix = "A task that adds a variant to a cross-workspace enum lists every exhaustive match in every workspace (grep 'ConstructMethod::' under services/) and adds the arm, or spawns the arm task before it qualifies; the human-workspace tasks then require that task."

[gotcha.2709]
title = "A schema change without make platform-sdk-generate fails every later --check at the base"
symptom = "Two tasks changed the agent-api schema; sdk/platform/pipeline.kvx kept the old digest and the drift gate reported stale generated SDKs for every unrelated generator task afterwards."
fix = "Run make platform-sdk-generate in the task that changes a schema or generator and commit pipeline.kvx with the outputs; the first task that meets the stale gate absorbs the regeneration."

[gotcha.2710]
title = "A Go EVM test harness cannot raise MinimumFeePerGas above the module maximum"
symptom = "A precompile harness set MinimumFeePerGas to 1 gwei and EvmKeeper.SetParams panicked 'min fee per gas ... exceeds maximum 67000000' before any test body ran."
fix = "Keep the EVM params the test app provides and size funding from GetNextBaseFeePerGas; MaxMinFeePerGas is 67000000 (modules/evm/types/params.go:55)."

[gotcha.2711]
title = "LatestSignerForChainID(0) panics; legacy transactions sign with FrontierSigner"
symptom = "An ante test built a chain-id-zero legacy transaction through LatestSignerForChainID and the EVM library panicked 'invalid chainID 0'."
fix = "Sign pre-EIP-155 cases with ethtypes.FrontierSigner{} and give typed transactions a real chain id; a repair made after the last verify run is unqualified until the next attempt reruns the verify."

[gotcha.2712]
title = "A package verify of ./modules/<x>/... runs every test of the package, including ones broken at the base"
symptom = "A task that ported four tests was failed by two others in the same package that had been broken since earlier tasks deleted the module from the app and removed the script they drove."
fix = "Before naming a package-wide verify, run the package once at the base and claim the pre-existing failures in the task (fix, delete with reason, or record a finding); a package-wide verify is a statement about the whole package."

[gotcha.2713]
title = "A verify that greps a saved test log and never prints it leaves nothing to read"
symptom = "tools/bringup/check-live.test.sh runs under set -euo pipefail, so its first failing command ends the suite; a verify of the shape 'suite > log 2>&1; grep -q <ok line> log' then fails with an empty verify log, and 18.1484.1 burned three attempts without a record of the stopping case."
fix = "End such verifies with || { cat <log>; exit 1; } as 18.776.1 does, and never list a shell script's file stem under symbols (the done record checks symbols against the graph; scripts are touched paths)."

[gotcha.2714]
title = "A symbols entry that is not in the graph refuses a passing attempt"
symptom = "The done record checks every symbols entry against the symbol graph after the verify passes; 21.41.1 listed the Go keyword func (read off a method signature) and was refused with 'symbol func not defined in the graph' after a green verify, and 40 proof tasks carried the same kind of entry."
fix = "Derive symbols from identifiers only: drop keywords (func, struct, export, const, class, function, type, interface), primitive type names and file stems before writing a task."

[gotcha.2715]
title = "cargo build --tests of layerx-human-service fails on a sibling test target until 9.35.11 lands"
symptom = "tests/native_lifecycle.rs:29 calls canonical::decode_signed_activity, which the crate no longer exports, so any build of -p layerx-human-service --tests fails before the task's own target compiles (9.100.2 attempt 1)."
fix = "Build -p layerx-human-service --lib --test <target> for the targets the verify runs; 9.35.11 owns the port of native_lifecycle.rs."

[gotcha.2716]
area = "platform-sdkgen"
symptom = "The program-contract write and check commands silently accepted excess positional arguments."
cause = "The CLI dispatched both modes without validating their declared optional repository and lock arguments."
do = "Reject excess arguments before reading or writing; proof_generators exercises the built writer and the receipt parity gate consumer, including malformed receipt.kvx and generated output. Use 104.38.6.sh --check-program-contracts <repo-root> <sdkgen-binary> for the real focused consumer without running every SDK suite."

[gotcha.2717]
title = "go build ./<path>/... from the repository root fails for a package under a nested go.mod"
symptom = "services/launchpad/*, services/wallet/attestor, sdk/launchpad/protocol and tools/loadtest carry their own go.mod; go build ./services/launchpad/api/internal/app/... run from the root answers 'directory prefix ... does not contain main module or its selected dependencies' (21.17.1 attempt 1 and six siblings)."
fix = "Build and test such a package from its module directory: cd <module> && go build ./<package>/... and cd <module> && go test -count=1 ./<package>/ -run '^Test...'."

[gotcha.2718]
title = "precompiles/layerxledger's test package has not compiled since Keeper.GetPayerGrant left"
symptom = "pause_test.go:158, payments_test.go:204 and :217 and views_test.go:155 call Keeper.GetPayerGrant, removed by 1.12.4 (decision.2080); 1.12.4's verify vetted precompiles/layerxpay only, so go test ./precompiles/layerxledger/ fails to compile for every later task in that package (21.11.1 attempt 1)."
fix = "When a task removes a keeper method, grep the precompile test packages for callers and vet them in the task's verify; 21.11.1 repairs the three tests to the current ErrNoPayerGrant behaviour."

[gotcha.2719]
title = "Two more Go test packages on main do not compile after a retirement"
symptom = "modules/layerxledger/types/params_test.go:22 asserts KernelKVPrefix (retired by 2.3.1, 215b90bd1) and modules/layerxcustody/keeper/deposit_root_test.go:106 calls verify.BatchHeader (retired by 1.36.2, e999c6df5); the retiring tasks' verifies ran other packages, so go test of either package has failed to compile since."
fix = "A task that retires an exported symbol greps every _test.go caller across modules/, precompiles/ and daemon/ and vets those packages in its verify; 21.115.1 and 21.89.1 repair these two."

[gotcha.2720]
title = "retired_client_modules.rs of layerx-platform-core includes a deleted source file"
symptom = "services/platform/hosted/core/tests/retired_client_modules.rs:35 does include_str!('../src/withdrawal.rs'); 8.99.1 deleted that module (8f777f5cf), so every cargo build --tests of the crate fails on this target (21.126.1 attempt 1)."
fix = "A task that deletes a source file greps the crate's tests for include_str! and module scans naming it; 21.126.1 drops the entry."

[gotcha.2721]
title = "A proof that reads its producer from the environment never passes qualification"
symptom = "21.42.1 and 21.156.1 attempt 1 asserted LAYERX_PROOF_CLIENT_RPC_URL and GAS_STATION_PROOF_CONFIG and failed when unset; the qualification environment provides no operator-provisioned services."
fix = "Host the producer in-process (loopback listener, in-memory store, application harness) or build it in build_cmd (21.5.1: make layerx-genesis-build); never read URLs or configuration names from the environment in a proof."

[gotcha.2722]
title = "The generators crate's drift tests have failed on main since two retirements"
symptom = "sdk/platform/generators/tests/drift.rs:764 requires a module declaration for every agent transport operation while v1.kvx:320 keeps the retired faucet.claim transport section (9.1.5), and drift.rs:700-720 asserts an execution-profile check 9.97.3 removed from main.rs after 9.10.2 deleted the types; any task whose verify runs cargo test on the crate (18.1487.1 attempts 1-3) fails on them."
fix = "A task that retires a schema section or a generator check runs the generators crate's full test suite in its verify and repairs drift.rs in the same commit; 18.1487.1 repairs both."

[gotcha.2723]
title = "A retirement matcher that counts bare stems reports prose and sibling assertions as live references"
symptom = "18.1443.1 attempt 3 matched the stems Ed25519, EOA and owner-custody inside error messages, a comment and owner-custody.json, and matched the quoted paths of other retirement-assertion suites under tests/ci and cmd/retirement, failing 13 suites."
fix = "Exclude retirement-assertion files by pattern and require the retired file's own extension after a stem; the one real stale reference (103.6.11.sh:33) is removed by the task."

[gotcha.2724]
title = "node/sequencer tests stopped compiling when a proof task changed a shared helper's signature"
symptom = "21.49.1 (83a683c37) changed position_test.go:114 to xwebInfo(t *testing.T) and ran only its own proof; precompile_refresh_test.go:69 still calls xwebInfo(), so every later go test ./node/sequencer fails to build (21.19.1 and 21.87.1 attempts 2)."
fix = "A task that changes a test helper's signature greps the package for every caller before its verify; 21.19.1 repairs the call and 21.87.1 requires it."

[gotcha.2725]
title = "The pay2 qualification crate still builds a gateway test binary and a dead funded target"
symptom = "services/agent/qualification/pay2/Cargo.toml:44 builds a bin from services/platform/hosted/gateway/tests/local/verifier.rs and build.rs reads that directory, which 8.101.4 deletes; funded.rs includes an OUT_DIR lifecycle.rs that no build has generated since 9.97.2 removed adapt_lifecycle (a4d7551ed), so the funded test target has been unbuildable since."
fix = "A task that deletes a directory greps Cargo manifests and build scripts across the repository for its path; 9.35.13 makes pay2 self-contained and 8.101.4 requires it."

[gotcha.2726]
title = "A touches entry spelled with a ./ prefix is treated as outside scope"
symptom = "21.86.1 listed ./precompiles/setup.go, ./precompiles/launchpad/surface_test.go and ./precompiles/launchpad/setup_test.go; the scope check compares plain repository paths, so attempt 1 was refused for editing files the task names."
fix = "Spell touches as plain repository-relative paths; the batch normalises every ./ entry."

[gotcha.2727]
title = "A finding recorded during qualification is not resolved by the task landing"
symptom = "1281 of the 2211 [finding.*] blocks of qualification.kvx are cited by no do or decision; the tasks that recorded them are done, and nothing says whether the observed condition still holds on main."
fix = "Every finding gets a [disposition.<id>] block under spec/layerx-merge/dispositions/ whose evidence cites a commit or a file:line of main (feature 22); the closure refuses while one is missing or open without a landed follow-up."

[gotcha.2728]
title = "bind_call checks only the recordLifecycle header shape, never the body"
symptom = "decode_method (layerx-crypto/src/disclosure/call.rs:453-470) accepts a 0x101c recordLifecycle call when payload[0] is 0x71 and (payload[1], payload[2], payload[3], length) is one of (1,0,2,68), (1,2,1,8..=1024), (3,0,3,70), (3,0,5,86); a test that corrupts a body byte and asserts bind_call refuses it fails (9.35.9 attempt 6, native_setup.rs:442)."
fix = "Assert bind_call refusals only for the target, selector, header bytes and length; assert body validity at the provider or the kernel decoder, and record a refusal the product does not make as a finding."

[gotcha.2729]
title = "The arbiter's native fee authority key copies a NUL-terminated literal into a 28-byte slice"
symptom = "programs/crates/layerx-programs-arbiter/src/authority.rs:788 copies the 29-byte literal of the 28-character policy name plus a trailing NUL into policy[..28], so every call that reaches the native fee authority check panics (21.53.1 attempt 3, three proof cases)."
fix = "Copy byte-string literals without a trailing NUL into fixed slices, or size the slice from the literal; the Go and C producers zero-pad the 28-byte name to 32 bytes."

[gotcha.2730]
title = "A retirement that relies on a wiring request leaves dead producer references"
symptom = "5.54.5 deleted nine daemon tests and relied on a wiring request to remove their references; seven qualification scripts and five build fragments included by the Makefile still name them, and 21.5.1's proof found the first one missing."
fix = "A task that deletes a file greps the tree (scripts, build fragments, Makefile includes, docs) for its path and either removes the references itself or lists them under touches; 22.16.4 closes this set."

[gotcha.2731]
title = "Stale tests and non-building crates surface only when a later task happens to consume them"
symptom = "Four of the open dispositions (1.29.1, 4.22.1.1, 8.42.5.1, 8.47.10.1) are tests or programs that reference deleted files, found by chance when another task built the same package; nothing inventoried the tree's build and test targets after the retirements."
fix = "Run a per-target inventory of every workspace at a named revision (the 22.91.x reports) and treat each failing target as a finding with its own follow-up before claiming closure."

[gotcha.2732]
title = "A revocation that deletes the authorization hides the revocation reason"
symptom = "layerxauth RevokeGrant deleted the matching Cosmos grant, so a later exec failed in authz with ErrUnauthorized before the LayerXScopeAuthorization could refuse with ErrAuthRevoked, and the integration test was written to the weaker error (2.12.4.1)."
fix = "Keep the authorization and let its epoch check refuse with the specific error; delete only on explicit grant deletion."

[gotcha.2733]
title = "A gate task that finds nothing to change must be declared as a gate"
symptom = "The crate closure tasks 22.90.x were declared planned work; when the crate already built, the attempt changed no file and was refused for changing nothing."
fix = "Declare verification-only tasks with gate_kind existing so a passing verify with no change qualifies them."

[gotcha.2734]
title = "A proof must not import helpers from another test file"
symptom = "proof_exchange.test.ts imported consumer helpers from precompile-calls.test.ts and xweb-api.test.ts; their module-level assertions ran on import and one failed before any proof case (21.160.1 attempt 2)."
fix = "Shared consumers live in a support module without top-level assertions; a test file is never an import target."

[gotcha.2735]
title = "A sweep whose enumeration is empty needs an explicit empty-inventory form"
symptom = "The go-cmd sweep found no Go package under cmd/ and wrote targets_total = 0 with no target block; the verify required at least one target (22.91.22 attempt 1)."
fix = "A sweep verify accepts targets_total = 0 when the report carries the enumeration command and its observed result; the other sweeps keep the non-empty rule."

[gotcha.2736]
title = "A pending-tagged read refuses on an idle proposer"
symptom = "eth_getBalance with the pending tag returned 'pending block unavailable: sequencer: no block is open' between blocks because resolvePending surfaced the snapshot error instead of the latest committed height (21.92.1 attempt 2)."
fix = "Pending reads fall back to the latest committed block while no block is open, as the simulation path already does (22.7.2)."

[gotcha.2737]
title = "Resolving a precompile's info constructs every merge precompile"
symptom = "precompiles.GetPrecompileInfoE(xweb) failed with the layerxpay merge constructor's LXP_PRECOMPILE_NO_CONTEXT refusal because validating an info entry builds the merge table with a keepers value that lacks LayerXPayKeepers (22.5.5 attempt 1; the same refusal in tests/chain, tests/occ and three layerxagent merge tests)."
fix = "Keep name, address and ABI resolution static and separate from merge construction; harnesses that build the merge table use one shared keepers helper that satisfies every merge constructor (22.6.4)."

[gotcha.2738]
title = "A service's own migrations drifted from the production DDL its code reads"
symptom = "services/launchpad/social/migrations create eight chat tables while the Go code reads twenty-two; the twelve missing tables and three functions exist only in the production migrations under launchpad/spec, so the schema test of 22.4.3 could not pass (attempts 1 and 2)."
fix = "A service that mirrors production migrations carries a test that every relation its SQL names is created by its own Up sections (22.4.4)."

[gotcha.2739]
title = "A whole-file verify fails on tests the task did not touch"
symptom = "22.10.6 added one passing test to services/platform/hosted/human/test_material.py but its verify ran the file, and three pre-existing tests fail in a clean checkout (environment-only inputs, a two-line join of a three-line shell call, a removed guarantor container)."
fix = "Narrow the task verify to the task's test and open a separate repair task for the pre-existing failures, chained as a requirement so the file passes whole at closure (22.10.7)."

[gotcha.2740]
title = "A crate that compiles another crate's main.rs by path does not see its pub(crate) re-exports"
symptom = "layerx-agentd-host builds ../layerx-agentd/src/main.rs as its bin; main.rs re-exports parse_request, response, DeadlineStream and Parsed from serve_http with pub(crate) use, and human_owner_mode.rs imports them from super, which fails under the host build (22.9.12 attempt 1 and every dependent-crate check since)."
fix = "Import shared helpers from their defining module (super::serve_http::{...}) rather than relying on a parent re-export when the file is compiled under more than one crate root (22.9.16)."

[gotcha.2741]
title = "Casting an EVM address to sdk.AccAddress bypasses the EVM association"
symptom = "modules/layerxchains bonds, funds and refunds against sdk.AccAddress(operator.Bytes()); the bank's recipient checker refuses a cast address whose account has a different associated pax address, so every createChain with a bond failed with invalid bank recipient (20.3.4 attempt 2)."
fix = "Resolve EVM addresses through the EVM keeper association (GetPaxAddressOrDefault) before any bank transfer, in keepers and precompiles alike (20.3.5)."

[gotcha.2742]
title = "Kernel idempotency records live in memory and vanish on reopen"
symptom = "A repeated payExact with the same PaymentReference succeeded after Close and reopen because the kernel's idempotency set is not reloaded from the host store prefix the records are persisted under (21.11.1 attempt 3)."
fix = "Restart-recovery proofs must cover idempotency: the host checks the committed record or reloads the set on open (22.2.7)."

[gotcha.2743]
title = "A verify that rewrites a tracked file never qualifies"
symptom = "22.17.3 attempts 1 and 2 passed their verify but the done record was refused because the verify ran the reconcile script, which rewrites the committed interfaces report, so the candidate tree differed from the verified tree."
fix = "Give report-producing scripts a check mode that compares and exits non-zero on difference, and run that mode in verify_cmd."

[gotcha.2744]
title = "A bond-too-low probe one wei short hits the remainder refusal first"
symptom = "18.1496.1 probed createChain with 110e18 - 1 wei expecting the bond-too-low reason, but a value that is not a whole bank unit (10^12 wei) is refused for its remainder before the bond comparison (attempt 2)."
fix = "Probe bank-unit thresholds with values that are whole bank units; assert the remainder refusal separately."

[gotcha.2745]
title = "The spec validator finds requirement ids that tasks reference but no block declares"
symptom = "tools/specgen TestRepositorySpecIsValidAndCurrent reported nine errors: tasks 17.5.12, 9.25.3 to 9.25.8, 9.25.17 to 9.25.19, 8.98.16, 13.30.6 and 9.24.5 reference reqs 9283, 9258, 9257, 9256, 89816, 13306 and 9275 that were never written."
fix = "Run the spec lint and the reference check before every spec commit; a task's reqs list names only declared requirement blocks (restored in batch 320)."

[gotcha.2746]
title = "cargo check -p names a path dependency that is not a workspace member"
symptom = "cargo check --manifest-path <ws>/Cargo.toml -p <crate> for a crate another workspace owns (services/human naming layerx-agentd) exits 101 with a panic in the feature resolver: did not find features for (PackageId ...) within activated_features."
fix = "Name the consuming member crates instead; the non-member library is compiled as they use it. Only members and registry packages are valid -p targets."

[gotcha.2747]
title = "apps/web type-checks the wallet sdk sources under exactOptionalPropertyTypes"
symptom = "apps/web/tsconfig.json includes ../../sdk/wallet/src/index.ts and provider.ts, so a construct the wallet sdk's own tsc accepts ({ chainId: tx.chainId } with an undefined-able value) fails npm --prefix apps/web run typecheck with TS2379 for every web task."
fix = "Pass optional properties only when defined or type them as T | undefined; run the web typecheck after any wallet sdk change."

[gotcha.2748]
title = "material.assemble_policy refuses before it reads inputs when the output is not policy.json"
symptom = "A test expecting FileNotFoundError for a missing deployment got ValueError 'Human owner bundle refused: canonical policy filename' because material.py:271 checks the output filename first."
fix = "Name the output policy.json in tests of the missing-input paths; the filename check is the first refusal."

[gotcha.2749]
title = "tools/platform CLI integration tests spawn dbus-daemon"
symptom = "cargo test --workspace under tools/platform panics in every CLI integration test at tests/common/credential_environment.rs:54 when dbus-daemon is not installed."
fix = "Install dbus-daemon or compile the tests with --no-run; task 22.16.9 adds a named skip."

[gotcha.2750]
title = "pending nonce after a receipt resolved answered the committed nonce"
symptom = "A second eth_sendRawTransaction signed with eth_getTransactionCount pending right after pax_sequencerReceipt resolved the first transfer was refused with -32000 'incorrect account sequence'."
fix = "Do not submit twice from a pending nonce until task 18.1502.1 lands; the fallback of rpc/watermark_manager.go:103 serves the committed nonce while it should serve the open block's."

[gotcha.2751]
title = "Error-path tests that write to an unwritable path pass when the tests run as root"
symptom = "memiavl TestWriterLoopErrors and TestSnapshotWriterErrorHandling expect WriteSnapshot to fail on /invalid/path and get nil in the qualification environment, which runs as root and can create the directory."
fix = "Skip such tests in a verify that runs as root (-skip 'Name|Name'), or make the test use an unwritable fixture that does not depend on permissions (a path under an existing regular file)."

[gotcha.2752]
title = "Changing a GATE_ALWAYS registration in the genesis module table moves every published fixture's root"
symptom = "Replacing the programs registration in src/protocol/lxp_genesis.c's module_table made tests/fixtures/public-testnet-genesis-v3 and public-testnet-genesis verify with LXP_ERR_ROOT_MISMATCH (-801) and broke lxp_genesis_module_plan_default."
fix = "Add new registrations behind a manifest enable flag that the published fixtures do not set; never regenerate the public fixtures."

[gotcha.2753]
title = "tools/repotest requires every tests/**/test_*.py pytest module to be referenced from a build file"
symptom = "TestEveryPytestSuiteIsReferenced failed on tests/qualification/test_mcp_binding_receipt_keys.py, added by a task whose verify ran the file directly, with no Makefile, workflow, tools/ or scripts/ reference."
fix = "When a task adds a pytest module under tests/, add the Makefile target (or pass its directory to pytest) in the same change."

[gotcha.2754]
title = "The attestor's run() needs the pinned custody producer authority before it serves anything"
symptom = "services/wallet/attestor/cmd/attestor tests of run() exited early with 'custody authority unavailable or refused' because main.go:206 requires ATTESTOR_AUTHORITY_PUBLIC_KEY_FILE, _ISSUER and _TENANT and the test env set none."
fix = "Give run() tests a fixture authority public key file and the three variables; agent.NewAuthority (authority.go:118-130) names what it refuses."

[gotcha.2755]
title = "precompiles/xweb/XWeb.sol and contracts/src/precompiles/IXWeb.sol must stay byte-identical and match abi.json's events"
symptom = "TestABIMatchesTheSolidityInterface compares the two files byte for byte and TestEventTopics counts 'event ' declarations against abi.json; a doc comment added to one file or an event added only to abi.json fails the package."
fix = "Change the three files (abi.json, XWeb.sol, IXWeb.sol) and contracts/test/XWebConsumer.t.sol together."

[gotcha.2756]
title = "Removing a block from the agent API contract within one major breaks every dependent crate"
symptom = "layerx-agent-api's build script compares services/agent/schema/agent-api/v1.kvx with golden/v1.kvx and panics at build.rs:324 'breaking contract removal without a major increment' when a baseline key is gone at the same major; the removal of a retired operation block (2ddf941d9) stopped every crate depending on layerx-agent-api from building."
fix = "Retire an operation by setting disposition = retired and keeping the block; remove blocks only with a major increment that moves the golden baseline. A task that edits v1.kvx builds layerx-agent-api in its verify."

[gotcha.2757]
title = "kvx has no decimal values"
symptom = "A sweep wrote elapsed_seconds = 600.071 and the kvx reader stopped with 'expected a quoted string, integer, boolean or string list value'."
fix = "Write durations as integers (whole seconds or milliseconds) or quoted strings; check a generated kvx with grep -nE '^[a-z_]+ = [0-9]+[.][0-9]+' before committing it."

[gotcha.2758]
title = "A go test -run pattern that matches nothing passes silently"
symptom = "go test prints '[no tests to run]' and exits 0 when -run matches no test; a verify leg naming a test file another task creates later proves nothing."
fix = "Name tests that exist at the task's base with anchored patterns (^TestName$) and let the task that creates a test carry its own verify leg."

[gotcha.2759]
title = "Consensus params that set MaxGas but not MaxGasWanted refused every transaction at Accept"
symptom = "node/sequencer limits.go compared gas wanted with Block.MaxGasWanted even when it was 0, so every RPC fixture that set only MaxGas refused each transaction with 'gas wanted 21000 exceeds Block.MaxGasWanted 0'."
fix = "Read a zero or negative MaxGasWanted as unbounded (decision 2306) and state the bound explicitly in fixtures that mean to test it."

[gotcha.2760]
title = "A task whose verify runs the cgo node package needs the go-cgo profile"
symptom = "Programme gates under the python profile called go test ./node and failed to link: cannot find -llayerx and the programs runtime archive."
fix = "Give any task that runs go test ./node, ./rpc or another cgo package the go-cgo profile, whatever language its own files are in."

[gotcha.2761]
title = "Errors returned through a gRPC client carry text, not a wrapped chain"
symptom = "require.ErrorIs(err, sdkerrors.ErrInvalidAddress) on a gRPC client error failed although the keeper wrapped that error: the status error holds the message as text only."
fix = "Assert status.Code and the message text on the client path, and assert errors.Is / errors.As on a direct call of the query server."

[gotcha.2762]
title = "Check the headers before asserting that a type is retired"
symptom = "A CI test asserted lxp_verified_receipt_authority_facts was gone while include/layerx/lxp_receipt.h still defines it and src/modules/programs/call.c uses it; three legitimate test files failed the assertion."
fix = "An absence test names deleted files and their references, taken from the deleting commit, never a type or symbol unless the header no longer declares it."

[gotcha.2763]
title = "A contract build that passes does not prove the schema tests pass"
symptom = "The agent API build-script gate checks removals only; two additive schema edits (a new record block, a reworded outcome) built fine while cargo test -p layerx-agent-api --test schema failed on a stale golden and stale literal pins."
fix = "A task that edits services/agent/schema/agent-api/*.kvx moves golden/v1.kvx and the schema.rs pins in the same commit and runs the schema tests in its verify (decision 2307)."

[gotcha.2764]
title = "A test that expects a raised type must follow the wrapper that converts it"
symptom = "test_material.py expected FileNotFoundError from assemble_policy while read_bytes had converted it into a ValueError bundle refusal a month earlier."
fix = "When a test expects an exception type, read the call path for a converting wrapper and assert the type and message the product raises now."

[gotcha.2765]
title = "A test for a later validation must satisfy the earlier mandatory configuration"
symptom = "The seller network-identifier test constructed SellerMiddleware without receipt keys; the constructor refuses missing keys before it reads the networks, so the expected unsupported-payment never surfaced."
fix = "Give such a test the mandatory fixtures (a pinned key) so it reaches the validation it asserts; do not reorder product checks to suit the test."

[gotcha.2766]
title = "Pick the fixture case the verifier decodes, not the first vector of the file"
symptom = "Python x402 payment tests fed the plain transfer vector to a verifier that decodes a ledger draw and failed with Local verification failed."
fix = "Select the fixture case by id (V1-layerxledger-pay-exact) and derive the terms from its log, the way the TypeScript seller tests do."

[gotcha.2767]
title = "Deleting a test file also removes it from an explicit test script"
symptom = "The TypeScript SDK's npm test lists each compiled test by path; deleting the source left Cannot find module for its dist file."
fix = "When a test file is deleted, edit the package.json test script (and any list that names it) in the same change and add package.json to touches."

[gotcha.2768]
title = "The merge plan gate counted v6.12.0 addresses a full-genesis chain never selected"
symptom = "Applying the merge plan on a test wrapper panicked with 'missing merge constructors or activation precompiles: 0x1020 ... 0x1025' because the v6.12.0 set was selected only on a done height while the gate counted every activation address."
fix = "Derive liveness of a versioned set from the module version map as well as the done height (decision 2308), the rule the activation entries already follow."

[gotcha.2769]
title = "A schema edit leaves the generated SDKs stale"
symptom = "The platform generator's --check refused after a schema file changed although every crate test passed."
fix = "Run the generator without --check after any schema edit and commit the regenerated files with the pipeline manifest (decision 2310)."

[gotcha.2770]
title = "A missing named export fails the whole ESM test file at load"
symptom = "A buyer test file imported a class the shared runtime module had renamed; node reported the SyntaxError before any test ran, so every case in the file counted as failed."
fix = "Grep the support module's exports when a test imports it, and port renamed clients with their new constructor arguments."

[gotcha.2771]
title = "An ABCI error built from an empty log names no reason"
symptom = "The sequencer's Accept wrapped codespace, code and an empty log into an error whose text was blank, so the test only showed a stack."
fix = "Include codespace and code in the error text when the log is empty, and have harnesses print them."

[gotcha.2772]
title = "Grant reads moved from the keeper to the precompile view"
symptom = "Tests still called Keeper.GetPayerGrant two days after 1.12.4 deleted it; vet failed for the whole test package."
fix = "Read grants through the getPayerGrant view of the precompile and grep every test package for a deleted accessor, not only the file the finding named."

[gotcha.2773]
title = "A ruling naming a file outside the task's touches is never applied"
symptom = "Six candidates of one task left a one-line test repair undone because the test file the finding named was not in the task's touches list, which bounds every change a task may make."
fix = "Every do item that names a file adds that file (or its directory) to touches in the same ruling; check the touches list before writing the do item."

[gotcha.2774]
title = "A fixture pins nonce 0 on a shared package account"
symptom = "Two tracer shape tests failed on 'expected 0x0 actual 0x2' because the fixture pinned the transaction nonce while earlier tests in the package had advanced the account."
fix = "Build fixture transactions with the account's current nonce (EVMKeeper.GetNonce) and assert that value."

[gotcha.2775]
title = "eth_estimateGas panics while no block is open"
symptom = "The estimate path still required an open sequencer block after the send path had been taught to use the committed state, so a quiet node panicked 'sequencer: no block is open'."
fix = "Resolve the pending tag to the committed height on every RPC path, not only the one the failing test exercised."

[gotcha.2776]
title = "A generated C decoder names a type the header retired"
symptom = "A Go test that compiles a C decoder against the kernel headers failed on 'unknown type name' after the header dropped the grant type with the retired kernel grant store."
fix = "Drop the decoder arm with the retired payload and keep the test on the structs the header defines."

[gotcha.2777]
title = "StaticCall given the executor's gas runs out of gas"
symptom = "A precompile view test passed the executor's RequiredGas to the EVM call while the registered contract charges a wrapper surcharge, so every call reported out of gas."
fix = "Charge the EVM call what the registered contract requires (the package RequiredGas) and assert zero gas left."

[gotcha.2778]
title = "The payment payer is the receipt from-account, not the log topic"
symptom = "Five payment tests failed payment-binding-mismatch because the payer passed to the verifier was the PaymentExact log's payer topic (the ledger account) while the SDK binds payer to the receipt's from-account (the EVM sender left-padded to 32 bytes)."
fix = "Decode the conformance receipt with its pinned key and read from_account before writing a fixture ruling."

[gotcha.2779]
title = "An operator-evidence test cannot be rebuilt from committed producers"
symptom = "Repeated rulings asked a test to build an owner-evidence tree with the committed producers, which do not emit every record the policy assembler requires and need a running node."
fix = "Skip the operator test with the reason named when the inputs are absent and prove the property on a minimal fixture in a separate unit test."

[gotcha.2780]
title = "Redefining a module's enable key changes every genesis root"
symptom = "A storage-retirement flag was wired by returning its parameter key from the module enable-key function, so every manifest without the flag verified with LXP_ERR_ROOT_MISMATCH."
fix = "Give a new flag its own parameter key and a dedicated lookup; never change the key an existing parameter is identified by."

[gotcha.2781]
title = "A plan-default test passes a retired argument and expects success"
symptom = "A genesis plan test called the plan default with custody credit enabled and expected LXP_OK, while the function refuses that argument by design."
fix = "Read the function's refusal arms before writing a test expectation for a retired option."

[gotcha.2782]
title = "Routing reads charged the transaction's gas meter"
symptom = "Chain-domain lookups made while routing a transaction read the registry under the sender's gas meter, so a plain transfer at the minimum gas ran out of gas on a virtual chain."
fix = "Run consensus bookkeeping reads under an infinite gas meter; the sender pays only for execution."

[gotcha.2783]
title = "A test port asked for grant bytes a retired store cannot return"
symptom = "A ruling ported keeper grant reads to the precompile view, but the view refuses every id since the grant store retired, so the port could not pass."
fix = "Read the view body before ruling a port; assert the refusal when the underlying store is retired."

[gotcha.2784]
title = "A fixture carried resolution answers inside the wire request"
symptom = "A conformance fixture's request object gained the resolver's answers, so the SDK encoders' equality tests against it failed in two languages."
fix = "Keep the request object of a fixture equal to what the SDK encodes; put derived answers under the result."

[gotcha.2785]
title = "A test expected decimal heights the producer emits as hex"
symptom = "A daemon test asserted receipt key heights as decimal strings while the producer and the parser both use 0x quantities."
fix = "Read the producer's encoding before asserting a wire value."

[gotcha.2786]
title = "A port premise claimed a module the application still registers was removed"
symptom = "A ruling said a module left the module manager and asked for nil-keeper assertions; the application still registers it and carries the keeper by a later decision."
fix = "Check node/app.go and the precompile keepers before ruling what a retirement removed."

[gotcha.2787]
title = "A Rust test cannot link a C symbol defined outside the library sources"
symptom = "An FFI function defined in a C file compiled only into the C test targets was called from a cargo test, which failed to link."
fix = "Prove FFI paths from the side that links the definition; keep Rust tests on the crate's pure paths."

[gotcha.2788]
title = "A Go proof that drives a Node consumer needs that package's dependencies"
symptom = "A Go test ran node --import tsx inside a pnpm package whose dependencies were never installed, so it failed on module resolution."
fix = "Install the consumer package's dependencies in the task's build command before the Go build."

[gotcha.2789]
title = "The pending tag is refused off the proposing node"
symptom = "A proof read the pending nonce from a node that does not propose blocks and was refused with -32000."
fix = "Read nonces at latest or at a height unless the client talks to the proposer."

[gotcha.2790]
title = "A test handed a document to a helper that takes text"
symptom = "A rewrite-genesis test passed a validator object to the public-key helper, which requires base64 text."
fix = "Read a helper's first require before calling it from a test."

[gotcha.2791]
title = "A package-wide verify carried eleven tests the task never touched"
symptom = "A task's verify ran four packages whole, and eleven unrelated stale or regressed tests blocked it for three attempts."
fix = "Gate a task on the tests of its own files and give the whole-package run its own repair task."

[gotcha.2792]
title = "A crate test run included tests that only a producer script can run"
symptom = "Bare cargo test of a programs or agent crate fails on tests whose first output line is a missing-input refusal (PAXEER_X_*, LAYERX_INTERPRETER_WASM, a genuine corpus), hiding the genuine failures beside them."
fix = "Exclude producer-input tests by name (-- --skip <fn>) in a bare verify and name their producer in the finding; the producers (tools/qualification/paxeer-x, tools/paxeer-x/gates, the Makefile recipes) qualify them."

[gotcha.2793]
title = "A Makefile recipe runs tests as ignored that carry no ignore attribute"
symptom = "Makefile:3020 runs the bindings conformance tests with -- --ignored --exact, but bindgen_conformance.rs has no #[ignore] attribute, so the recipe selects nothing and reports success."
fix = "When a test loses its ignore attribute, the recipe that ran it with --ignored is updated in the same commit; a recipe that selects zero tests is a silent pass."

[gotcha.2794]
title = "A committed config lacked the schema key its only reader requires"
symptom = "contracts/config/checkpoint-settlement.json had no schema key while layerx-types settlement.rs refuses any document without schema = layerx/checkpoint-settlement/1; eight tests across two crates failed on the first read."
fix = "When a reader gains a required key, the committed documents it reads and the tests that pin their key sets change in the same commit; check the config directory for every document the reader loads."

[gotcha.2795]
title = "A loopback RPC fixture answered in a shape its consumer decoder refuses"
symptom = "tests/sequencer_start.rs answered px_getReceiptKeys with a bare array of hex-string heights while the shared layerx-client decoder requires an object with a keys array and numeric heights; every consumer test reported Malformed."
fix = "A fixture that stands in for a producer is written against the consumer decoder's exact field names and types (read decode_receipt_keys first), and the finding checks that a real producer for the method exists at all."

[gotcha.2796]
title = "A TypeScript decoder required a field the published contract never had"
symptom = "services/agent/sdk/typescript/src/intent.ts demanded a sponsored key on IntentPlan; the generated web contract and the wallet types carry none, so the conformance fixture failed exactKeys."
fix = "A hand-written decoder's required key set is checked against the generated contract type before the fixture is blamed; derive convenience flags (sponsored) from contract fields instead of adding keys."

[gotcha.2797]
title = "A parity regex pinned a source shape another task changed"
symptom = "merge_gateway_parity_test.go and setup_test.go matched an object literal assignment; the gateway table became Object.freeze(... as const satisfies ...) and the parity check silently matched nothing."
fix = "A regex over another package's source matches the exported identifier and the braces it needs, tolerating wrappers, and fails loudly when the match is empty."

[gotcha.2798]
title = "A genesis validated without its activation height passed, then panicked at init"
symptom = "The merge plan path validated the module genesis before the activation height was resolved, so the receipt-key coverage check never ran there; the keeper resolved the height at InitGenesis, failed the same check and panicked where the test expected an error."
fix = "Validate a genesis with every field the init path will resolve into it, in the caller that can return an error; treat the module's InitGenesis panic as unreachable, not as the refusal."

[gotcha.2799]
title = "A retirement test removed a store before the height that deletes it"
symptom = "TestEveryAnchorSelectorRetired unmounted the anchor store at the merge height while the precompile keeps serving views until the store-delete upgrade; the views reverted with an unregistered-store message instead of the retirement text."
fix = "Model the retirement heights the precompile implements (write height, view/store-delete height) in the test's store setup; remove a store only at the height the upgrade deletes it."

[gotcha.2800]
area = "human kms"
symptom = "The retained KMS material producer emits modules, module_id and activity_types, while Config::load accepts only a chain_id snapshot."
cause = "material.py::kms_prerequisite still serves the retired module registry contract."
do = "Keep the retained producer manifest intact; project a protected chain snapshot for the KMS consumer, and prove both the legacy refusal and the current path with proof_human_kms."

[gotcha.2801]
area = "human kms"
symptom = "A malformed executor certificate could be pinned at startup and a zero EVM address could be accepted by AttestorSigner::from_config."
cause = "Certificate bytes were hashed without parsing and the public signer constructor relied on its caller to validate the address."
do = "Decode executor DER before pinning it and refuse the zero address in the public constructor; exercise these refusals with producer-owned protected files."

[gotcha.2802]
area = "human kms qualification"
symptom = "The declared all-tests build fails in unchanged provider.rs and sign_eip1559_requests.rs on removed canonical activity APIs, removed owner-rotation variants, and a missing RemoteKmsProvider::new clock argument."
cause = "Those test targets were not migrated with the interfaces they consume; both paths are outside the proof task scope."
do = "Record once and stop without changing these tests or running verification: revision 06b17620f8ca0d7f258ea171b401827f478591e7; command cargo build --locked --manifest-path services/human/Cargo.toml -p layerx-human-kms --tests; exit 101; private evidence /out/logs/build-1.log."

[gotcha.2803]
area = "human kms proof"
symptom = "Carried-over gotcha entries conflicted with newly landed entries, and the proof duplicated the entrypoint environment mapping."
cause = "The appended entry identifiers collided and the test constructed its own material bindings."
do = "Preserve both ledger histories with distinct identifiers and consume kms_environment output for direct Config::load calls as well as binary startup."

[gotcha.2804]
area = "human kms qualification"
symptom = "The declared build stops in services/agent/crates/layerx-agent-api/build.rs:324 because its compatibility check rejects removal of transport.agent_http.operation.faucet.claim.access without a major increment."
cause = "The dependency schema contract is inconsistent before the KMS test targets compile; the dependency and schema paths are outside task 21.63.1 scope."
do = "Record without repairing or rerunning this unrelated failure: revision a0bb928babae3964ae304283c926e54a342af0b3; command cargo build --locked --manifest-path services/human/Cargo.toml -p layerx-human-kms --tests; exit 101; private evidence /out/logs/build-1.log. Verification did not run."

[gotcha.2805]
title = "A hand-edited fixture list diverged from the golden it was derived from"
symptom = "holders.json gained 13 addresses in a sweep commit with no matching read in golden.json; two count assertions failed for one token while every other token matched."
fix = "A derived fixture (holder list, address table) is regenerated from its golden, never edited by hand; when a count assertion fails for one token, diff the fixture's history against the golden's before touching the test."

[gotcha.2806]
title = "A wrapped SDK error leaked its call site into a revert reason"
symptom = "sdkerrors.Wrapf appends the wrapping file and line in brackets; a precompile that copies the error text into the revert reason exposed a source path and two pinned-text tests failed only on that suffix."
fix = "Build kernel-side refusals with fmt.Errorf and %w; when a revert-reason test fails on a trailing bracketed path, repair the error construction site, never the expectation."

[gotcha.2807]
title = "A daemon logged a reason code and dropped the error behind it"
symptom = "livestreamd exited 1 with reason=livestream_runtime_failed and no error text, so a proof that starts it saw only the exit status and could not tell which configuration refusal fired."
fix = "A process exit on error logs err.Error() beside the reason code; a proof that spawns a daemon captures its stderr into the failure message."

[gotcha.2808]
title = "A crate-root test helper carried pub(super) and broke every dependent build"
symptom = "Three helpers placed at the crate root of an integration-test file between two cfg(test) modules were declared pub(super); rustc refused with E0433 and five tasks whose dependent-crate check builds layerx-agentd tests failed on a file none of them may edit."
fix = "Items at the root of a tests/*.rs file are private or pub, never pub(super); a dependents build failure on a file outside the task's scope becomes a root-cause task the others require."

[gotcha.2809]
title = "A test and a Go producer still routed activity types the kernel had retired"
symptom = "The kernel asset module shrank to eight activity types and its retirement tests asserted the three dropped types refuse, but the genesis manifest test and the ledger grant keeper kept submitting them and both failed with LXP_ERR_UNKNOWN_ACTIVITY."
fix = "When a kernel activity type is retired, grep every list of activity types (C tests, Go keepers, contract documents) in the same change; a -106 routing result in a test is a stale list until the registry table says otherwise."

[gotcha.2810]
title = "A fixture, its decoder and its producer carried three different leg shapes"
symptom = "The intent plan fixture legs carried chainId, data and payment, the TypeScript decoder required call and nonce, and the human service emitted flat snake_case EVM fields; the decoder failed the fixture and the fixture never matched a real response."
fix = "Before repairing a decoder against a fixture, read the producer's json! site and the published schema; the fixture is regenerated from the producer and both consumers follow it."

[gotcha.2811]
title = "A touches entry for a file a prerequisite had already deleted blocked a passing candidate"
symptom = "The completion check requires a matching change for every touches entry; a test file the task was told to delete had been deleted by a prerequisite task first, so the otherwise green candidate was refused."
fix = "When a prerequisite lands the deletion or creation a task was told to make, drop that path from the task's touches in the same ruling; never add a path to touches that the task will not change."

[gotcha.2812]
title = "A fee estimate without a payer address was refused by the real node"
symptom = "eth_estimateGas with maxFeePerGas set and no from is checked against the zero address's balance and answers insufficient funds for transfer even for a zero-value call; the funded account one line earlier was never consulted."
fix = "Estimate a fee-bearing call with from set to the account that will sign; keep the fromless estimate for calls whose fee fields are zero and say so in its doc comment."

[gotcha.2813]
title = "A harness repair let a panicking test run for the first time and it failed on an older change"
symptom = "A chain test that had panicked for weeks on a missing merge-table dependency ran again once the harness registered the keepers, and failed on fee collection that no run had checked since the last green revision."
fix = "When a repair makes a long-panicking test run, treat its failure as unlocated: bisect from the last green revision with exit 125 on the old panic before changing the test or the product, and name the commit the bisect finds in the commit message."

[gotcha.2814]
title = "A proof read its funded key from the process environment and failed where none was set"
symptom = "The proof declared the node build outside its scope and read LOCAL_NODE_KEY and the RPC URL from the environment; seven of eight tests passed and the eighth found no key."
fix = "A proof that needs a node builds it in build_cmd and starts it itself, reading key material from the file the node script writes; a doc comment declaring the producer out of scope is a ruling request, not a substitute for one."

[gotcha.2815]
title = "A TypeScript test imported a Python package through an inline program the dependency scan could not see"
symptom = "The qualification environment installs the Python packages a pytest target imports by scanning .py files; a TypeScript test spawned python3 -c with its own imports, so cryptography was never installed and one of thirty checks failed."
fix = "A cross-language parity check names its interpreter-side dependencies where the environment can find them; the environment now also provides them for the TypeScript SDK tests that spawn python3."

[gotcha.2816]
title = "A module left in the basic manager but outside the module manager fails validate-genesis on every export"
symptom = "layerxanchor kept its AppModuleBasic for the codec and message route after its genesis lifecycle was removed; exports omit it and the basic manager's ValidateGenesis unmarshals a nil message, so the release rehearsal's validate-genesis step failed on a correct export."
fix = "A module without a genesis lifecycle accepts an absent state in ValidateGenesis and the export test asserts the key is absent, so the two registrations stay consistent."

[gotcha.2817]
title = "A proof that asserts a verifier refusal must read the verifier's check order first"
symptom = "proof_sdk.rs expected ReceiptCheck::ProtocolVersion for a version-2 receipt; the verifier accepts version 2 and refused at ReceiptCheck::Asset because the test built its batch from a different asset."
fix = "Build the authority from the decoded receipt's own fields, assert success, then assert the one refusal the test deliberately provokes; cite the verifier lines in the doc comment."

[gotcha.2818]
title = "A Makefile comparison against a file a prior task deleted fails every later run"
symptom = "test-state-proof compared the generated vectors against a human-client vectors file deleted with its module; the first comparison still held, the second could not open its file."
fix = "A deletion task greps the Makefile and qualification scripts for the deleted path; a target that compares against two copies drops the one whose owner left."

[gotcha.2819]
title = "An install that writes a binding document must track every section the daemon client requires"
symptom = "The platform CLI install wrote no agent.readiness section after the daemon client started requiring the authenticated gateway, so a fresh install could not serve its catalogue through the daemon."
fix = "The producer of a document and its strict consumer change together; a test installs with the producer and opens with the consumer rather than copying a hand-written document."

[gotcha.2820]
title = "A whole-crate cargo test in a task verify sweeps other tasks' proof targets"
symptom = "A reconciliation task's four-crate cargo test failed on node-backed proofs and producer-input TLS tests owned by other tasks after its own targets passed."
fix = "Name the test targets the task owns in its verify; whole-crate runs belong to crate-level closure gates."

[gotcha.2821]
title = "A go-ethereum client recomputes block hashes the node never served"
symptom = "A chain-path proof compared ethclient Block.Hash() with receipt.BlockHash; the node serves the consensus block id as the hash field and the client's keccak of the decoded header differs on every block."
fix = "Assert the hash fields the node serves (raw eth_getBlockByNumber hash, eth_getBlockByHash round trip, the consensus block id at the receipt height); never Block.Hash() of a decoded block."

[gotcha.2822]
title = "Two completion outcomes of one receipt must share one journal path"
symptom = "The relayer journal let an Included completion follow a Receipted entry but demanded a Pending entry for a Reverted completion, so the status-zero integration test failed with a conflict and a unit test had pinned the asymmetry."
fix = "Model the journal as Pending, Receipted, Completed with the outcome as data; assert conflicts on missing or already completed entries, never on the outcome value."

[gotcha.2823]
title = "A three-crate verify with two dependent-crate checks does not fit one qualification budget"
symptom = "A runtime task repaired its candidate after the first verify, rebuilt, and the second dependent-crate check consumed the remaining budget so the verify never ran on the repair."
fix = "Run the dependent-crate check once per candidate revision and let a gates-only requalification carry an unverified repair."

[gotcha.2824]
title = "A handwritten test landed in a generated markdown root without its manifest declaration"
symptom = "A task added a proof test under a directory the platform generator owns; the generator's check refused the unclassified file and every later task whose build runs the generate target failed at the base."
fix = "A file placed under a generated root is declared in the pipeline manifest in the same change; a generator refusal naming a file none of the candidate's hunks touch is a base break, repaired by declaring the file, never by deleting it."

[gotcha.2825]
title = "A task whose spec status read blocked never starts, and the attempt record shows only the start refusal"
symptom = "Three attempts of one task failed at the start step within eleven minutes because the spec block said blocked at the time; the status flipped to pending an hour later and the task sat idle because every attempt record carried no revision and no note could attach to it."
fix = "When a spec status flips from blocked to pending, relaunch the task fresh from main; a start refusal is never a candidate to continue from, and the attempt history of a blocked period is not counted against the task."

[gotcha.2826]
title = "A negative text search in a verify must cover only files the task may edit"
symptom = "A port task listed six files and a verify that searched the whole crate for the retired module; the census outside the six files named ten more consumers, the agent stopped by its own rule and the verify failed on a file the task could not touch."
fix = "Scope the negative search to the touches list, split the remaining consumers into sibling tasks per group, and let the deletion task search the whole tree once every sibling has published."

[gotcha.2827]
title = "A generic frame codec filed under a retired protocol module is product, not retired code"
symptom = "The module slated for deletion held the length-prefixed codec and the Unix-socket transport the daemon's live Human peer socket speaks, beside the kernel handshake that is retired."
fix = "Before deleting a module, classify each file by who speaks it at runtime; re-home the live wire under a neutral module with re-exports from the old path, and delete only the protocol no runtime peer speaks."

[gotcha.2828]
title = "A planned command row recorded with its binary prefix hides a served command from the registry matcher"
symptom = "Query command rows were written as the full invocation (binary, module, command word) while the source declares only the command word under a parent command, so the completion gate counted served commands as missing."
fix = "Record a command row by the command word the source declares and keep the full invocation in the contract field; the gate matches what the source carries."

[gotcha.2829]
title = "A retired interface row without a symbol in the tree is counted missing unless its status says retire"
symptom = "Rows for surfaces a later decision removed kept their planned status and were counted as missing work by the completion gate, inflating the gap list with surfaces no task may build."
fix = "When a decision retires a surface, flip its registry rows to retire with the decision in notes in the same change; the gate then reports them outside the served and missing counts."

[gotcha.2830]
title = "A route or method planned in one file and served from a sibling stays unserved in the registry until the row records the served path"
symptom = "Account routes planned in an owner handler file were served from the preferences handler, and gateway methods planned in one module landed in the chain-reads module; the registry rows kept the planned paths and the gate searched the wrong files."
fix = "A task that lands an interface updates the registry row's path and line to where it landed; the registry describes the tree, not the plan."

[gotcha.2831]
title = "A file included as a module by path shares its items with the crate, so private crate-root items break the including module"
symptom = "A proof test file is included as the daemon's serve_http module through a path attribute; when a task dropped pub(super) from three helpers to fix the test target, the daemon module that imported them failed with E0603 and every dependent build of the host binary went red."
fix = "Items reached from both the test target and the including module carry pub(crate), which compiles at a crate root in both roles; check every importer of an included file before changing its visibility."

[gotcha.2832]
title = "Deleting a blanket trait impl in a shared library task before its consumer is ported breaks the library build"
symptom = "A library port deleted a stub impl that one events file, owned by a sibling task, still passed a transport into; the library task failed its own build three times on a call it could not edit."
fix = "Keep a stub impl until the task that owns its last consumer has published; retarget the import, and let the deletion task remove the stub once the consumer is gone."

[gotcha.2833]
title = "A test that requires a receipted submission to revert contradicts receipt finality"
symptom = "A journal task asked its unit test to move a submission from Receipted to Reverted, and the release code refused the transition as a conflict because a receipt is final once its block is committed."
fix = "Write state-machine tests from the product rule: only a pending submission reverts, and a receipted one refuses; build a reverted fixture from an unreceipted pending submission."

[gotcha.2834]
title = "One package install per package in a verify loop exceeds the task time budget"
symptom = "A verify that ran npm ci in each of several packages spent ten minutes installing before the first failing test, and the second verify was stopped at the thirty-minute limit while reinstalling."
fix = "Install only when node_modules is absent, so the second verify of a task reuses the first install and spends its time on the tests."

[gotcha.2835]
title = "A collector-balance assertion written before fee routing landed stays stale until the test reads the routed account"
symptom = "A fee test expected the paid fee on the fee collector, but the fee-token routing of an earlier change sends allowed fee tokens to a holding or distribution account, so the expected balance never arrived."
fix = "Assert the account the routing parameters name; read the fee path in the module's end-block and collect code before asserting where a fee lands."

[gotcha.2836]
title = "A verify that runs only the unit test of a changed encoder misses the subscription tests the same change breaks"
symptom = "A newHeads encoder change required a thirty-two byte state root and its verify ran one encoder unit test; the two newHeads subscription tests of the same package failed on main afterwards and surfaced in an unrelated task's verify."
fix = "When a change tightens an encoder rule, the verify runs every test of the package that exercises the encoder end to end, not only the unit test the change added."

[gotcha.2837]
title = "A test that reads a fixture tree outside its package fails to run once that tree is removed"
symptom = "Two REST package tests read contract fixtures from a launchpad configuration tree that an earlier change removed and that no revision ever held in the expected version, so the package's tests failed before any assertion and took every task that named the package down with them."
fix = "Keep test fixtures inside the package under testdata; a fixture outside the package is a dependency the package cannot see change."

[gotcha.2838]
title = "A library deletion task whose negative search spans every consumer cannot pass before each consumer crate is ported"
symptom = "A codec removal task searched services and tools for the module paths it deletes and found two hundred and sixty-seven sites across thirteen crates; two attempts stopped on the search, since the task may edit only its own crate."
fix = "Write one port task per consumer crate with the site inventory and a crate-local negative search, list them in the deletion task's requires, and make the deletion task's search name the retired items rather than module paths that live code still imports."

[gotcha.2839]
title = "A module that began as a retired codec and now also holds live call-binding items is pruned, not deleted"
symptom = "A deletion item asked to move the kept definitions out of two modules and delete the files, but the modules had grown the type-2 call disclosure and its error, role and native-operation types, which thirteen crates import by the module path."
fix = "Before deleting a module, list its public items against their importers; when live items outnumber retired ones, delete the retired items in place and keep the module path, so consumers port only the calls that change."

[gotcha.2840]
title = "A task that requires a task of a later wave is refused by the plan check and stops every task with it"
symptom = "A repair task was written into wave 1 with a requirement on a task that sits in a later wave; the plan check refused the whole task graph for a later-wave requirement, and no task was admitted until the wave was raised."
fix = "Give a new task the highest wave among its requirements or higher, and run the plan check on the whole graph before the change lands; a single bad reference refuses every task, not only the one that carries it."

[gotcha.2841]
title = "A signing preparation that pairs the live transaction with a retired authorization record keeps the retired codec alive in every signing test"
symptom = "The daemon's signing preparation carried the type-2 transaction and a second record restored from an activity envelope; the pre-submit check verified the envelope binding while the submitted bytes were the transaction, so each signing test first encoded an envelope it never submitted."
fix = "Bind the disclosure to the bytes that are actually signed (the call and its sender) and drop the second record; a verification that checks a record other than the submitted one proves nothing about the submission."

[gotcha.2842]
title = "A retirement whose consumers span a twenty-thousand-line runtime file is split by operation variant, not by file"
symptom = "A single port task over the runtime file would hold the whole crate's edit scope for days and could not name one test target; the prepare and submit variants each have their own request shape, cache and test file."
fix = "Write one task per variant family (prepare, native effect, native send, registration, submit) with the variant's functions and its test target named, ordered so that each task's build is complete on its own; the runtime file appears in several touches lists and the tasks run one after another."

[gotcha.2843]
title = "A boundary check that walks whole crates fails a task whose edit scope is two files"
symptom = "The retired-surface task of the human CLI failed its boundary check on ambient nondeterminism in three files it is not allowed to edit (the KMS proof tests and the test-support evidence node), so every attempt ended at the same check regardless of the task's own work."
fix = "When a check reads outside the task's touches, name the outside files in a task of their own and make the failing task require it; a task cannot pass a check whose inputs it may not change."

[gotcha.2844]
title = "Two broken crates in two workspaces deadlock every task whose dependent-crate check builds both"
symptom = "The agent workspace failed on three private items of an included test file and the human workspace failed on four retired accessors; the task owning each half failed its check on the other half, so neither could publish and five more tasks failed behind them."
fix = "Merge the two repairs into one task, supersede the other, and make every task whose check builds either workspace require the merged task; a repair split along workspace lines cannot pass a check that spans both."

[gotcha.2845]
title = "A build of a crate's test targets compiles every sibling test file, including a broken one the task does not own"
symptom = "A task building the KMS crate with --tests failed on a test file it was not allowed to edit; the task's own change was correct."
fix = "When a build command compiles test targets, every test file in the crate is in the build; a broken sibling test is a requires on the task that repairs it, not a repair for the task that hit it."

[gotcha.2846]
title = "A security report's proof of concept is the verify test, written into the task before the fix"
symptom = "Advisory fixes written from the report's prose alone were hard to qualify: the test had to be invented after the fix and tended to test the fix rather than the attack."
fix = "Turn the reporter's reproduction into the named test in the task's verify (the delegatecall, the over-cap permit, the refused recipient, the closed position, the low-power majority, the delegate on the owner path, the rate-limited burst, the fee-token receipt, the replayed receipt) so the attack fails before the fix and passes after."

[gotcha.2847]
title = "A closure checker task fails until every follow-up task its inputs name is done, so those tasks are its requires"
symptom = "The dispositions closure task ran at wave 6, passed its own tests and failed its verify on the live state of the dispositions: follow-up tasks pending, missing or pointing at a literal placeholder."
fix = "A task whose verify reads the live specification state requires every task that state names and sits in a wave above all of them; its inputs (placeholders, missing ids, duplicate sections) are repaired in the specification, not in the checker."

[gotcha.2848]
title = "An appended finding section must not reuse an existing id"
symptom = "qualification.kvx carried two identical [finding.1.21.1] sections; every parser that indexes findings by id refused the file."
fix = "Before appending a finding, check the id is unused; a duplicate is removed as a specification edit."

[gotcha.2849]
title = "A transport entry restored for a retired operation needs its operation declaration too"
symptom = "The drift test compares the transport operations of the agent API schema with the [operation.<name>] declarations; a task restored the retired faucet.claim transport entry without the declaration and the next task to touch the schema failed the drift test."
fix = "Restore or add transport entries and operation declarations together; the drift test is the oracle for both."

[gotcha.2850]
title = "Node's strip-only TypeScript loader refuses constructor parameter properties"
symptom = "A TypeScript source loaded directly by node --test used constructor parameter properties (private readonly in the parameter list) and node 24 refused it with ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX in strip-only mode."
fix = "A .ts file that node loads without a build step declares its fields explicitly and assigns them in the constructor body; parameter properties, enums and namespaces need a build step."

[gotcha.2851]
title = "An in-repo Maven module must be installed before a dependent module can resolve it"
symptom = "mvn dependency:resolve on an integration module failed with 'Could not find artifact' for the repository's own sdk artifact, because the local repository had no copy and no remote carries it."
fix = "Run mvn install (tests skipped) of the in-repo module first, then resolve the modules that depend on it; put both into the same command."

[gotcha.2852]
title = "A match-arm repair must cite the variant list of the current main, not a planned one"
symptom = "A do item named two enum variants that a later task was going to add; the attempt added arms for them and the build failed with E0599 because the enum on main did not declare them."
fix = "Before writing a do item that names enum variants or fields, read the declaration on the current main; a repair that depends on a planned variant belongs to the task that adds the variant."

[gotcha.2853]
title = "A pinned dependency requirement blocks a lock-file raise"
symptom = "A lock-file raise to a floored version failed silently: the manifest pinned the dependency with an exact requirement (=9.3.1), so the lock could not move without a manifest edit outside the task's touches."
fix = "A floor task whose package is pinned exactly in a manifest includes that manifest in its touches, raises the requirement with the lock, and builds the crate that uses it."

[gotcha.2854]
title = "A go.mod replace onto an in-repo module changes the module graph and go.sum must follow"
symptom = "Replacing a published module with a relative in-repo path made the module graph load a requirement whose go.mod hash go.sum did not carry; the task's own environment built, a fresh environment failed with missing go.sum entry for go.mod file."
fix = "A task that edits go.mod runs go list -mod=readonly -m all and go mod verify as part of its verify and commits the go.sum entries they need; the dependent check builds in a fresh module cache."

[gotcha.2855]
title = "Changing a package's decision rule while running only the new test file leaves the package suite red"
symptom = "7829d8d2b (22.23.10) made a differing requestDigest a 409 receipt_reuse refusal and verified only two test files; the seller package suite failed on main at settlement-response.test.mjs:352 until 22.8.11 repaired it."
fix = "A task that changes a decision rule of a package runs that package's whole test suite in its verify, not only the file it adds."

[gotcha.2856]
title = "A retired transport section must not be declared as a catalogue operation"
symptom = "Adding [operation.faucet.claim] to satisfy the catalogue drift test generated an Operation variant that five exhaustive matches of the agent daemon did not cover and the dependent-crate check failed."
fix = "Exempt retired transport sections in the drift test (decision 2370); never declare an operation for a name the daemon refuses by RETIRED_OPERATIONS."

[gotcha.2857]
title = "A replace onto an in-repo module needs go.mod's indirect requirements updated as well as go.sum"
symptom = "After 66d80726c, go mod download alone left go vet reporting that go.mod needs updates: the graph selects newer golang.org/x modules than the indirect requirement lines record, and -mod=readonly refuses the build."
fix = "Run go mod tidy with the pinned toolchain in the task that lands the replace and commit go.mod and go.sum together (decision 2371); every other Go task keeps go.mod and go.sum out of its edits."

[gotcha.2858]
title = "A single-minimum floor checker cannot express per-major floors"
symptom = "tools/deps/lockfloor.py compares every resolved copy against one floor per package; a floor taken from the higher major's patched release fails the lower major's patched copy that a consumer pins (ajv 8 and fast-uri 3.1.9)."
fix = "Floor the package at the lowest patched release across its major lines (decision 2372) and state in the task text which consumer pins the lower line."

[gotcha.2859]
title = "A verify that chains toolchains of two SDK families needs the all-SDK profile"
symptom = "18.1503.1 verified cargo run, cargo test and mvn compile under the mixed profile and failed with mvn not found after every Rust step passed."
fix = "Set the profile key (line 4) to the all-SDK profile for any task whose verify names tools of two SDK families (decision 2373); check the profile against every command in the verify when writing the task."

[gotcha.2860]
title = "An all-targets Rust build of the agent daemon workspace plus the human workspace exhausts the qualification environment storage"
symptom = "22.9.33 built -p layerx-agentd -p layerx-agentd-host --all-targets and the human workspace tests, then the dependent-crate check failed to write rmeta with no space left on device (attempts 3, 5, 6)."
fix = "Write build_cmd as the declared targets only: cargo test --no-run per test target and cargo build per binary (decision 2374); never --all-targets on the agent daemon workspace."

[gotcha.2861]
title = "mvn -o fails on an environment that has not cached the pom's plugins"
symptom = "18.1503.1's verify ran mvn -q -o compile and Maven could not resolve maven-source-plugin 3.3.1 in offline mode although the compile itself needs nothing beyond the JDK."
fix = "Write Maven verify steps without -o like every other JVM verify of the feature (decision 2375)."

[gotcha.2862]
title = "The serve_routes test target belongs to the agent daemon host crate"
symptom = "22.9.33's build and verify named --test serve_routes under -p layerx-agentd and cargo refused: the target is declared in services/agent/crates/layerx-agentd-host/Cargo.toml (host-tests/serve_routes.rs)."
fix = "Name each test target under the package whose Cargo.toml declares it; check [[test]] declarations before writing a cargo test --test command."

[gotcha.2863]
title = "A reuse refusal keyed on an unverified receipt hint is a settlement oracle"
symptom = "The seller returned 409 receipt reuse from the payload's receiptDigest hint before verification, so a tampered payment got 409 instead of 402 and the status alone told whether the digest had been settled."
fix = "Verify first, then decide reuse (decision 2376); any pre-verification lookup may only serve the identical-request replay."

[gotcha.2864]
title = "A loader precondition on module-9 activities reaches every test that executes one"
symptom = "After 22.2.7 made programs activities require the active fee record, three lxphost tests that run a registry activity without the fixture helper failed with LXP_ERR_VERSION_UNSUPPORTED; the task listed two and attempt 2 stopped on the third as pre-existing."
fix = "When a change adds a store precondition to a module's execution, grep the package for every test that executes that module's activities and give each the fixture call; run the task's whole verify selection before the single verify run."

[gotcha.2865]
title = "A catalogue-absence test needs every deleting task in its requires, not only the ones that failed before"
symptom = "16.90.1 gained the daemon, guarantor and bridge deletions as requires after attempts 1 and 2 and still failed on attempt 3 because the LNI client module deletion (9.24.7) was never listed; each attempt found the next present tree."
fix = "Before relaunching a test task that asserts absence, check every tree it asserts against main and the catalogue and add the owner task of each present tree to requires in one pass."

[gotcha.2866]
title = "A rewrite that leaves a test module unimportable passes when its own verify never collects that module"
symptom = "16.97.6 rewrote tests/agent/sdk/python/test_receipt_fixture.py without the sys.path insertion its siblings carry; its verify ran only the meta-tests of tests/ci, so the import error surfaced weeks later in 22.25.3, whose verify collects the whole directory."
fix = "When a task rewrites a test module, its verify_cmd runs that module itself, not only a test that reads it; when a later task fails collecting a module it did not write, add the module to touches and rule the fix in a do item instead of relaunching."

[gotcha.2867]
title = "Two do items pinning opposite call counts for the same test case stall the attempt"
symptom = "22.8.11 do_14 pinned settleCount 1 for the differing-request-digest replay and decision 2376 made the authority settle before refusing the reuse; attempt 13 implemented the decision, saw the pinned count fail, and stopped to ask instead of choosing."
fix = "A decision that changes control flow restates every count it moves, in the same batch, naming the test case and the new values; a later do item that contradicts an earlier one says so."

[gotcha.2868]
title = "A behaviour change closed on its own package tests leaves an earlier task's chain test asserting the old behaviour"
symptom = "The fee-token sweep of 63dfe3cbc was closed on the modules/evm/keeper tests alone while TestSidioraFeePaid, written the same day, asserted that the collection address keeps the converted fee; the contradiction surfaced only when 22.6.4 made the chain test run again, and two findings and a bisect order were spent on a design that was already documented in the sweep's closure note."
fix = "Before ordering a bisect for a failing assertion, read the git log of the production code the assertion depends on and the closure note of the commit that introduced the behaviour; when the behaviour is documented, rule the test wrong and move on."

[gotcha.2869]
title = "A Python test module that imports names a retirement task removed fails at collection in every later task that collects it"
symptom = "tests/agent/sdk/python/test_receipt_fixture.py imported verify_receipt and decode_program_receipt_outcome after 9.97.7 retired them from layerx_sdk; the port of 18.1478.1 covered three sibling files and not this one, so 22.25.3 stopped at collection with ImportError."
fix = "When a retirement removes public names, grep every test tree that imports the package (tests/agent/sdk/python as well as services/agent/sdk/python/tests) and port or delete each importer in the same task; decision 2381 assigns this file to 22.25.3."

[gotcha.2870]
title = "A precompile that resolves the caller before the method lookup answers the unknown-method case with the caller's error"
symptom = "precompiles/layerxauth/layerxauth.go:70-95 calls Actor for every non-constant method before looking the method up, so the bound-caller case of TestAuthWriteRefusals reads LXP_UNKNOWN_FIELD from lxphost.DIDID instead of the unknown-method text once the lxphost resolution changed under it."
fix = "Decision 2382: the failure belongs to the task that owns modules/lxphost (22.11.8); a task that did not change the refusal path narrows its verify to the table it owns and names the base failure in its commit message."

[gotcha.2871]
title = "A dependency raise that deletes go.sum and a vendored Cargo.lock breaks every build of the module while its own verify passes"
symptom = "22.24.16 (3a45b8541) deleted services/wallet/attestor/go.sum and the kernelvectors Cargo.lock while raising three floors; its verify ran go mod verify and go build inside the module where the Go toolchain resolved modules without the sum file, and the human-service tests that build the attestor binary with -mod=readonly then failed on a missing go.sum entry."
fix = "A raise that touches a module manifest ends with go mod tidy (or cargo generate-lockfile offline) and the verify asserts test -s on the sum or lock file; decision 2383 restores both files in 22.24.24 and 22.24.25."

[gotcha.2872]
title = "A lock-file raise re-applied onto lock files that moved keeps the old version in every manifest"
symptom = "22.24.19 attempt 4 re-applied attempt 3's rustls 0.23.46 raise onto six Cargo.lock files that main had regenerated (0108cb23e, e8ef05d35); the merge kept the regenerated 0.23.45 entries without a conflict, so the floor check reported 0.23.45 < 0.23.46 in services/human, services/platform, tools/platform, services/interop, services/agent and services/agent/fuzz."
fix = "A lock-file raise is redone on the current lock files with cargo update -p <crate> --precise <version> per manifest, never re-applied as a patch; the floors file and the pinned manifests carry the intent."

[gotcha.2873]
title = "A test that pins a retired header value by its generated enum variant fails to compile after the header retires it"
symptom = "1.1.5 (f8721c8e3) retired LXP_ERR_DA_MISSING from include/layerx/lxp_result.h; services/agent/crates/layerx-types generates KnownResult from that header, so tests/errors.rs:321 (Some(KnownResult::DaMissing)) stopped compiling and every task whose verify builds the layerx-types tests failed with E0599."
fix = "A header retirement greps the generated-enum consumers (services/agent/crates/layerx-types/tests) for the variant name and drops or re-pins the expectation in the same task; 22.9.17 carries the drop for errors.rs:321."

[gotcha.2874]
title = "A fixture test that expects an admission to expire fails once the reader bridges admissions of any age"
symptom = "tests/program_chain_head.rs:686 expected HistoricalTrustAnchor for an admission 14 days and 1 ms old; after 9be053c27 the reader bridges the admission through served checkpoints and verifies it, so unwrap_err panicked on an Ok value."
fix = "Decision 2384: assert the bridge (the admission verifies at the later time) and construct the refusal by withholding an intermediate checkpoint read; the 14-day constant is a step-push rule, not an expiry."

[gotcha.2875]
title = "A receipt verifier written for a fee-separate ledger refuses every real EVM receipt whose sender paid gas"
symptom = "node/sequencer/receipt.go captures the sender's native balance before and after the transaction, so debit_after is lower by amount plus the gas fee when the fee is paid in the receipt asset; services/agent/crates/layerx-proof/src/receipt.rs:385-392 checks debit_before - amount == debit_after and reports DebitBalance for an account-open receipt whose only debit was the fee."
fix = "Decision 2385: the identity accounts for fee_charged when the fee denomination in Effects[0].Body[108..] digests to the receipt asset; 22.9.36 carries it with vectors for both fee paths."

[gotcha.2876]
title = "A sample's Next build output committed past its own ignore rule turned a passing qualification into a different candidate"
symptom = "22.8.11 attempt 14 qualified bd51e24b3 and then committed 5a1534c62 with 150 files under services/platform/docs/samples/paid-route-next/.next, although that sample's .gitignore ignores .next/; the recorded verification revision no longer matched the candidate."
fix = "The qualification records the commit it ran on; a later commit is a new candidate. Build output under an ignored path is never force-added, and a candidate is inspected with git status --ignored before the qualification run."

[gotcha.2877]
title = "Deleting a source file leaves its public declarations in the header until a completion gate counts them"
symptom = "src/network/lxp_batch_publish.c and src/sequencer/lxp_batch_time.c were deleted with their tests, but include/layerx/lxp_batch.h still declares lxp_batch_body (:72-82), lxp_batch_timestamp_select (:91) and lxp_batch_timestamp_validate (:93); the domain-1 completion gate (1.0.9) found the three catalogued retire-status interfaces present."
fix = "A source deletion greps include/ for every symbol the file defined and removes the declarations in the same task; decision 2386 assigns the three to 1.0.10."

[gotcha.2878]
title = "A pinned-digest test on the former asset field and a stale transient-receipt comparison stop a receipt task that changed neither"
symptom = "22.23.8 attempt 3: TestReceiptFeeFields (node/sequencer/receipt_equality_test.go:44 in the fee-token case) pins the fee token's digest as the receipt asset, which decision 2360 moved to the payment asset; TestAccepterReceiptsASendAcrossASeal (node/sequencer/accepter_test.go:383) compares the transient receipt (CumulativeGasUsed 0 at execution) with the signed receipt's Exec, which carries the cumulative gas Receipter.after adds (receipt.go:457, accepter.go:103)."
fix = "The fee-token case asserts the payment-asset digest; the across-a-seal comparison takes CumulativeGasUsed from the signed summary (Effects[0].Body[8:16]) before comparing, the way accepter.go:103 does; both files are in 22.23.8's touches."

[gotcha.2879]
title = "A task whose symbol list names files or deleted declarations never qualifies"
symptom = "22.24.24, 22.24.25 and 1.0.10 attempts 1 and 2: the completion check reported symbol go.sum, symbol Cargo.lock and the three retired lxp_batch declarations as not defined in the graph, with every build and test passing."
fix = "The symbols list names only code symbols that exist in the indexed graph after the change; a lock-file or deletion task declares an empty symbols list."

[gotcha.2880]
title = "A Go build list that names a test-only package fails before any test runs"
symptom = "22.6.5 attempts 1 to 3: go build ./precompiles/layerxagent/served/ stopped with no non-test Go files; the same list under go vet and go test is fine."
fix = "Build lists name packages with non-test sources; test-only packages belong to the vet and test lists only."

[gotcha.2881]
title = "The SDK corpus-bound library test needs the built terminal v5 corpus exported"
symptom = "22.9.18 attempts 4 and 6: v5_native_corpus_binds_exact_profiles_authority_and_all_outcomes returned Verification because PAXEER_X_PROGRAM_TERMINAL_V5_CORPUS was unset; 1.18.4's verify shows how the corpus is built and where its path is printed."
fix = "A verify that runs the layerx-sdk library tests builds the corpus first (program-terminal-v5.py --build, then --manifest) and exports the printed path."

[gotcha.2882]
title = "Adding a served RPC method without regenerating the served-methods golden fails the next whole-package run"
symptom = "22.7.3 attempt 5: TestServedMethodsHTTPGolden found px_getReceiptKeys (22.9.28) in the served set but not in rpc/testdata/served_methods_http.golden."
fix = "Every task that registers or removes a served method updates the golden in the same change and lists it in touches."

[gotcha.2883]
title = "An exact version pin in a manifest blocks a lock-file floor raise that does not touch the manifest"
symptom = "22.24.19 attempt 5: six lock files stayed at rustls 0.23.45 because six manifests pin rustls with an exact =0.23.45 requirement, outside the task's touches."
fix = "A floor raise lists every manifest with an exact pin of the raised crate and moves the pin with the lock files."

[gotcha.2884]
title = "A client encoded to a call shape the chain never produced passes its own tests and fails the first look at the real ABI"
symptom = "22.9.10 attempt 14: the perps v2 open and cancel signatures of 9.33.13 and 12.33.8 do not exist in precompiles/perps/abi/abi.json; the web proof had substituted them for the real declarations."
fix = "A client call shape is asserted against the producer's ABI file, never against a declaration the test writes itself."

[gotcha.2885]
title = "A producer task whose verify runs one test target leaves sibling tests of the same crate asserting the old shape"
symptom = "22.9.17 attempt 10: 9.35.16 changed bind_call's budgetCreate disclosure to two amounts and qualified on --test disclosure_call alone; tests/budget_call.rs in the same crate still expected one amount and failed the next whole-crate run."
fix = "A task that changes a crate's behaviour runs that crate's whole test set in its verify, or names the sibling tests it leaves to a task that requires it."

[gotcha.2886]
title = "A receipt-shape change that makes a field mandatory fails every vector builder and fixture copy another task owns"
symptom = "22.23.8 attempt 5: ReceiptInput.PaymentDenom became required and the vector test's builder and the V1 to V3 fixture copies, owned by 22.25.3, were not in the task's touches."
fix = "A task that adds a mandatory input field lists every builder of that input and every recorded fixture of its output in touches, and orders itself after the task that is regenerating the same fixtures."

[gotcha.2887]
title = "A test registered as test(fn) without a name is a todo under vitest 4 and never runs"
symptom = "22.11.8 attempt 1: the wallet proof test(proof_layerxledger_0x101a) reported 1 todo and the Go proof that shells out to it demanded 1 passed; apps/launchpad/web registers tests the same way."
fix = "Register every vitest test with an explicit name string and the function; a proof that shells out to another runner asserts 1 passed, never the absence of failures."

[gotcha.2888]
title = "A boundary gate's retired list drifts from its producers"
symptom = "10.1.4: the retired-import list named a struct the proof crate still defines and a module path a done task had moved; the gate failed on 23 files of the merged tree."
fix = "Before a gate lists a symbol or module as retired, read its producer at HEAD and the task that retired it; a moved module is a changed import, not a retired one."

[gotcha.2889]
title = "A hand-maintained catalogue drifts from the schema it mirrors"
symptom = "22.25.3: operations.json named Journey for three operations whose schema answered AgentCreationJourney and OnboardingJourney since 10.15.4; the Go conformance command refused the catalogue."
fix = "When a schema type is renamed, grep every catalogue that mirrors it (operations.json, the generated Go, Swift and C# catalogues) and regenerate before resealing the pipeline lock."

[gotcha.2890]
title = "Corpus builders still request a header whose rule retired"
symptom = "22.9.18: eight qualification producers asked make for generated/lxp_checkpoint_settlement.h after 16.2.2 removed the rule, so every corpus build exited 2."
fix = "A task that retires a Makefile rule greps tools and scripts for the generated artefact's name and removes every request in the same change."

[gotcha.2891]
title = "A producer change leaves consumer tests stale in other packages"
symptom = "7.10.1 removed four header keys and left rpc/subscribe_test.go pinning them; 5.98.6 changed the sealed-layer send path and left rpc/send_sequencer_test.go expecting the old error; 9.35.17 dropped a struct field and left four human-service test constructions with it; 22.9.37 narrowed an SDK encoder and left the wallet SDK caller with two arguments."
fix = "Before a task that changes an encoder, a struct, an error path or a signature is marked done, grep the whole repository for every consumer and test of the changed symbol and either change them in the task or hand them to a named task the dependents require."

[gotcha.2892]
title = "Vendored source reformatted alongside a behavioural change"
symptom = "22.13.12 attempt 1 ran a formatter over the vendored engine (404 lines in one file) and inside that diff replaced a fallible push with an infallible one, which two metering tests caught."
fix = "Vendored sources keep the upstream formatting; a change to them is the smallest behavioural diff, reviewed line by line, with the checksum refreshed afterwards."

[gotcha.2893]
title = "A planned file that a later ruling moved stays in the enforced lists"
symptom = "21.95.1 do_8 moved the proof to the consumer crate and deleted the daemon test target, but touches, tests and planned_paths still named the deleted file, so the done check refused a passing candidate for a path with no change."
fix = "A ruling that moves or deletes a planned file updates touches, tests and planned_paths in the same ruling; the done check requires a change for every touches entry."

[gotcha.2894]
title = "An ABI output that carries a runtime envelope is bounded by the envelope, not by the call's declared capacity"
symptom = "9.97.15 attempt 4 refused the producer's own conformance case because the decoder compared the 372-byte terminal envelope the precompile packs as response against the call's responseCapacity of 64, which bounds the guest response inside the envelope."
fix = "Before bounding a precompile output, read the handler that packs it (precompiles/layerxprograms/method_call.go) and a reference decoder (sdk/platform/go/programs.go); a capacity declared in the call bounds the guest payload, not the runtime framing around it."

[gotcha.2895]
title = "A generic producer fixture cannot feed an application-specific journal"
symptom = "9.97.15 do_2 asked the conformance case to resolve the fixture receipt in the AI operation journal, but the fixture program's calldata is two bytes and no PAXAI request intent can be built from it."
fix = "A conformance case proves the shared layers (receipt, log, call result); the application layer is proved with the application's own signed record and a receipt view in the fixture's shape."

[gotcha.2896]
title = "A JSON-RPC HTTP status answer is an envelope"
symptom = "10.20.6 attempt 7 read sync_info at the top level of the CometBFT /status answer and panicked on the latest height; the payload sits under result."
fix = "Read a node's HTTP status through its JSON-RPC envelope (result, error, id) and assert the envelope before the field."

[gotcha.2897]
title = "A comparison compares the copies the finding names, not every fixture that looks alike"
symptom = "18.1211.6 compared a daemon committed-fixture vector in another format with the sequencer receipt source and failed on a case the source never carried."
fix = "List the files a finding names as copies and compare exactly those; a fixture in another format with its own producer is not a copy."

[gotcha.2898]
title = "A test that starts a toolchain binary names it where the environment can see it"
symptom = "22.9.10 attempt 15 failed in gas-station.test, which starts anvil, although no command of the task names anvil; the environment installs toolchains from the commands it sees."
fix = "When a suite starts a binary in a subprocess, the environment that runs the suite is told about the binary by the suite's name; record the dependency with the task."

[gotcha.2899]
title = "A generator that projects a source file verbatim inherits every retired include"
symptom = "22.9.18's corpus build failed on a header the kernel retired three days earlier, because program-terminal-v5.py copies tests/programs/test_language_abi.c into its fixture and that file was never ported."
fix = "When a module is retired, list every file that includes its header, generated projections included, and port or retire each in the same wave."

[gotcha.2900]
title = "A test that never ran is stale on arrival"
symptom = "The agent SDK gas-station test asserted the latest block tag five days after the source moved to pending; no environment had the local EVM, so the test never ran and nobody noticed."
fix = "When a toolchain is first provided, read the test's expectations against the current contract before treating a failure as a regression of the candidate."

[gotcha.2901]
title = "A field added to a producer's view reaches every consumer's mutation test"
symptom = "22.23.8 added paymentDenom to the sequencer receipt view; the relayer's submitted-rung test copies every receipted field onto a submitted answer and expects a refusal, so the new field made the relayer test fail although the relayer never read it."
fix = "When a view gains a field, list the consumers whose tests enumerate the view's fields and port them with the producer."

[gotcha.2902]
title = "A triage report is cheaper than a guess"
symptom = "Fifty-one open issues and eighty-seven findings waited for a reader; writing one report task per issue and one disposition task per ten findings turns the backlog into checkable files."
fix = "Triage by report with a fixed shape and a checker, then splice the accepted blocks; never author tasks from issue text that nobody checked against main."

[gotcha.2903]
title = "A fixture shape is a contract shared by both sides"
symptom = "The receipt-key decoder was retyped to the node's object shape and verified against the gateway proof alone; three agent daemon fixtures still served the old bare list, and the budget pipeline test failed on a decode error two tasks later."
fix = "When a decoder or a recorded exchange changes shape, grep every fixture and test that serves or consumes the shape and run them in the same task."

[gotcha.2904]
title = "An in-memory index behind an RPC needs a restart proof"
symptom = "The sequencer receipt source was filled only by the live accepter; a restart replayed the log, re-executed every send and answered null to every receipt lookup."
fix = "Every in-memory read model that an RPC serves is rebuilt from durable state on start, and the restart test reads a pre-restart record back."

[gotcha.2905]
title = "A reader refuses a value shape its producer writes"
symptom = "The sweep records wrote decimal elapsed seconds; the summary reader written against the records accepted integers only and refused the first file with a decimal."
fix = "Derive a reader's accepted value shapes from the files it will read, and test it on one real record of each producer."

[gotcha.2906]
title = "A service test fails on the key loader, not the key"
symptom = "The gas station's documented-deploy test failed with KeySource although every documented variable was set: from_config used a prefixed file-or-KMS loader while the deploy contract exports the raw key in the named variable."
fix = "Read the deploy template and the init script before choosing a loader; the loader must read what the operator sets."

[gotcha.2907]
title = "A completion gate requires the planned paths of retired tasks"
symptom = "The gate collected planned paths from a task list and required each as a file; one belonged to a capability a later decision retired and deleted."
fix = "Exclude the planned paths of retired tasks explicitly and assert the retired files are absent."

[gotcha.2908]
title = "A floor raise that verifies only the install leaves consumers red"
symptom = "Two dependency floor tasks raised vitest, vite and viem and verified the lock floor and a frozen install; the apps' type checks broke in config and component files nobody touched."
fix = "A floor task's verify runs the type check of every package whose lock it raises, or a follow-up task does so before dependents launch."

[gotcha.2909]
title = "A triage report compared against the wrong served source"
symptom = "The report took the pre-merge executor ABI as the served scheduler ABI; under the merge upgrade a wrapper precompile serves five events and the cold metadata was right."
fix = "Resolve which type is served at the upgrade in force before calling metadata stale."

[gotcha.2910]
title = "A test file imports a module its manifest lacks"
symptom = "Regenerating go.sum could not make go list -mod=readonly pass: the production test imported a module absent from go.mod."
fix = "Run go list -mod=readonly -deps -test at the base before regenerating sums, and add missing requirements to the manifest."

[gotcha.2911]
title = "A build command names a tool the environment profile lacks"
symptom = "pnpm against an npm-pinned package and gradle in an image without it failed before any code ran."
fix = "Match the build command to the package's pinned manager and the profile's toolchain; compute what the absent tool would have produced from published artifacts."

[gotcha.2912]
title = "A recorded upstream corpus cannot be re-typed onto another chain"
symptom = "Thirty-four recorded transactions traced against upstream balances and a Wasm capability the chain does not have; rewriting type URLs left insufficient-funds and duplicate-denomination traces."
fix = "Retire corpora recorded on another chain and record new ones on this chain instead of patching their encodings."

[gotcha.2913]
title = "A network-rule change left the vector suite on the old grammar"
symptom = "The model moved to one eip155 network and refused the layerx: namespace; the vector tests and a payload fixture kept the namespace and six tests went red without any task running them."
fix = "A task that changes an acceptance rule runs every test file that includes the fixtures the rule reads."

[gotcha.2914]
title = "A range override drags a 1.x consumer onto a 2.x major"
symptom = "An override written as package@<2.8.0 matched the ^1.30.1 dependency of a 1.x consumer and forced it to 2.8.0, which dropped an export the consumer reads at load time."
fix = "Bound alert overrides below by the first affected major and check every dependent range the override rewrites in the lock."

[gotcha.2915]
title = "A new struct field breaks an initializer outside the task scope"
symptom = "Adding a field to a context struct failed the lib test build in another module's initializer that the task could not edit."
fix = "Grep every initializer of a struct before adding a field and list each file in touches."

[gotcha.2916]
title = "A frozen install consumed the whole task limit"
symptom = "A yarn frozen install of a large app took fifteen minutes and the attempt ended before its verify ran."
fix = "Give install-heavy tasks a longer time limit and measure the install before fixing the limit."

[gotcha.2917]
title = "A command template substitution doubled a directory prefix"
symptom = "A verify command cloned from a template received a full path in place of a file name and named the dispositions directory twice; twenty-three tasks failed their verify with FileNotFoundError after doing the work."
fix = "After substituting into a cloned command, assert that every path it names exists or will be created by the task before landing it."

[gotcha.2918]
title = "A continued attempt carried an edit of a file that had left the scope"
symptom = "A ruling removed a file from a task's touches, but the next attempt continued from the earlier tree and kept the file's edit it could no longer revert."
fix = "When a ruling removes a file from the scope, start the next attempt from main instead of continuing from the earlier tree."

[gotcha.2919]
title = "A restore path returned the new record into a cache typed for the old one"
symptom = "Carriers were migrated to restore the call-bound preparation while the runtime cache still held the legacy record, so the two insertions failed to compile."
fix = "When a producer changes a record type, enumerate every cache that holds it and decide the holding shape in the same task."

[gotcha.2920]
title = "A directory-scoped publication dropped the tracked lock files under it"
symptom = "Tasks whose scope named a directory were published without the lock and checksum files tracked there, because those files were classed as generated; frozen installs and readonly module resolution failed later on main."
fix = "When a scope is a directory, keep every tracked lock file under it in the published tree and verify the ecosystem's frozen install on the published revision."

[gotcha.2921]
title = "A flat version floor failed instances outside the advisory's range"
symptom = "A minimum version derived from an advisory on one major was applied to every resolved instance of the package, so a 1.x instance pinned by an unrelated dependency failed a floor meant for 2.x."
fix = "Scope a floor to the advisory's version range when the lock legitimately carries an older major."

[gotcha.2922]
title = "A struct gaining a field broke initializers in dependent crates"
symptom = "A context struct gained a required field in one crate; the dependent-crate check found the initializers in two other crates and their tests uncompilable."
fix = "When a task adds a required field, list every crate that initializes the struct in its scope and migrate them in the same task."

[gotcha.2923]
title = "A registry presence check ignored the row's status"
symptom = "The interface sweep counted every absent symbol as missing, including thousands of rows whose status already said retire, so the report could not tell a wrongly dropped interface from a retired one."
fix = "Classify registry rows by status and presence together, and settle the rows that need judgement with written evidence per row."

[gotcha.2924]
title = "An SDK type change left a sibling test on the old shape"
symptom = "A task ported a payment type and its named test, but a second test file constructing the same type was outside its scope, so the package no longer type-checked."
fix = "When a task changes an exported type, search the package for every construction of it and put each file in the task's scope."

[gotcha.2925]
title = "A fixture chain lacking receipt fields starved the view under test"
symptom = "View tests waited forever for a receipt because the shared fixture chain returned receipts without the nonce and logIndex fields the SDK readers require."
fix = "Build fixture receipts from the fields the reader checks, and assert those fields in the fixture's own test."

[gotcha.2926]
title = "A refusal tag renumbering left a native corpus fixture asserting the old tag"
symptom = "The runtime began reporting a kernel refusal of a settlement leg under the kernel tag instead of the receipt-mismatch tag; the native corpus fixture kept asserting the old tag and the signed corpus was no longer emitted, so every consumer of the corpus failed its qualification."
fix = "When a producer changes an encoded tag, run the native corpus producer and every fixture that asserts the tag in the same task."

[gotcha.2927]
title = "A scope rename stranded a publication that deleted the old path"
symptom = "A task moved a test file to another crate; its scope was renamed to the new path only, so the publication that deleted the old file was refused for a change outside the scope although the verify and the done check had passed."
fix = "When a task moves or deletes a file, keep the old path in the scope beside the new one; a deletion is a change of the old path."

[gotcha.2928]
title = "CMake 4 refuses projects declaring a minimum version below 3.5"
symptom = "A Rust crate that compiles a bundled C++ project through the cmake crate failed in its build script with Compatibility with CMake < 3.5 has been removed, because CMake 4 no longer accepts cmake_minimum_required values below 3.5."
fix = "Upgrade or drop the dependency that bundles the old project; CMAKE_POLICY_VERSION_MINIMUM=3.5 only probes whether the rest of the build would succeed."

[gotcha.2929]
title = "A test that starts a tool binary needs the binary in the qualification environment"
symptom = "The TypeScript SDK gas-station test starts a local EVM through anvil; run directly as node dist/test/gas-station.test.js in an environment without Foundry it fails with local EVM exited before readiness after every other case passed."
fix = "Install Foundry before running the compiled SDK tests, or set ANVIL_BIN to the binary; the failure is environmental, not a product defect."

[gotcha.2930]
title = "A dependent-crate check fails on a test package already broken on the main line"
symptom = "A change to the agent daemon's tests built cleanly, but the dependent-crate check compiled the human service's custody test, which no longer matches the daemon's prepare types on the main line, and reported the task as failed."
fix = "Make the task depend on the task that repairs the broken package, and record the break as a finding so nobody re-investigates it."

[gotcha.2931]
title = "A hand-built EIP-1559 call with a placeholder target is refused by the disclosure binder"
symptom = "A test built an Eip1559Call with to = 0x1a repeated and a kernel authorization as data; bind_call in layerx-crypto's disclosure/call.rs refused it with MalformedPayload because the binder accepts only registered targets with canonical ABI payloads."
fix = "Build test calls against a registered target with the ABI the binder decodes, and sign kernel authorizations through their own path instead of wrapping them in an EVM call."

[gotcha.2932]
title = "A completion check rejects a symbol that names a file instead of a definition"
symptom = "A task whose symbols list carries a file or module name (exchange-client) fails the completion check with not defined in the graph after a passing verify, on every attempt."
fix = "Declare symbols = [] unless every entry is a function, type or constant the code graph defines; a file is proven by touches, not symbols."

[gotcha.2933]
title = "The explorer typecheck fails on the main line before a dependency change is tested"
symptom = "yarn tsc --noEmit in apps/explorer reports 343 errors in toolkit/chakra, toolkit/components and ui/zetaChain whatever the lock change, so a build command that runs it fails every attempt."
fix = "Build dependency tasks with the frozen install alone and restore the typecheck in its own task (14.99.1); record the pre-existing failure as a finding."

[gotcha.2934]
title = "A service test takes its clock from the environment and panics in qualification"
symptom = "RuntimeClock::from_environment in a test needs the runtime clock authority variables; without a running node runtime the test panics with clock authority unavailable while its siblings pass."
fix = "Start the in-process clock the component frame test uses (RunningClock::start, RuntimeClock::connect) and never read the ambient clock authority from a test."

[gotcha.2935]
title = "A whole-file absence rule rejects retirements proven by test inputs"
symptom = "The reconcile checker refused a retired row because the retired variable survives only as test literals in the registered file."
fix = "List those lines in remaining as path:line references inside the registered path; the checker skips exactly them (decision 2494)."

[gotcha.2936]
title = "A fixture-counting verify iterated a mapping where the fixture holds a list"
symptom = "The verify of 18.1574.1 counted vectors by iterating the values of the receipt fixture's top-level entry; the entry is an object whose cases key holds the list of vectors, so every element was a string and the verify died on a missing get method."
fix = "Read the fixture shape (keys and nesting) before writing a counting verify; count over the list the fixture actually holds."

[gotcha.2937]
title = "A retired-path guard matches words inside panic messages"
symptom = "tests/retired_crypto_codec_2.rs of the human service splits each migrated test file into statements and treats every word after layerx_crypto as an identifier, so a panic message containing the word bind in the same statement as a layerx_crypto path fails the guard."
fix = "Keep panic and error text in a statement that names a layerx_crypto path free of the retired identifiers (bind, onboarding, rotation, sign_disclosed and the envelope encoders)."

[gotcha.2938]
title = "A task that cites an acceptance criterion the requirement lacks breaks the repository spec validation"
symptom = "Task 9.35.17 cites 22056.2 while [req.22056] has only ac_1; tools/specgen TestRepositorySpecIsValidAndCurrent fails on the main line."
fix = "Every <req>.<n> a task cites must exist as ac_<n> of that requirement; add the criterion rather than the reference."

[gotcha.2939]
title = "A hand-edited generated file fails the generator lock check"
symptom = "sdk/platform/jvm/pom.xml is generated by sdk/platform/generators (JVM_FILES in src/main.rs) and compared against a digest lock; 22.96.21 edited the dependency floors in the file, so the generator check reports the file as stale or hand-edited."
fix = "Change the renderer in the generator and regenerate (make platform-sdk-generate); never edit a generated file in place."

[gotcha.2940]
title = "Wrapping an SDK error with fmt.Errorf and %w loses its ABCI codespace and code"
symptom = "modules/layerxexchange/keeper/intents.go wraps types.ErrRetired with fmt.Errorf, so the ABCI response carries the generic codespace and code and the retirement test fails."
fix = "Wrap registered SDK errors with the SDK errors Wrapf (or Wrap) so the codespace and code survive to the ABCI result."

[gotcha.2941]
title = "A crate-wide test build fails on a stale sibling test after an interface change"
symptom = "9.35.19 builds every test target of layerx-agentd; tests/w7_core_time.rs still constructs prepare::Prepared where register and register_preparation now take prepare::evm::Prepared after 9.35.17, so the build fails before the task's own tests run."
fix = "When a task changes a type that tests construct, every test file constructing it belongs in touches (decision 2342 lesson); a follow-on task that builds all test targets must carry the stale files too."

[gotcha.2942]
title = "A sweep repair of a crate that another open task is already fixing must wait for that task"
symptom = "The layerx-mcp sweep repair hit the same live-node tests issue task 18.1578.1 isolates; running both at once would have made the repair task re-solve or skip the proof."
fix = "Make the sweep repair require the open task that owns the failure and leave its verify exercising the fixed tests."

[gotcha.2943]
title = "A re-sweep that started before the repair it depended on was published failed on the old break"
symptom = "The human-service re-sweep (22.99.88) built the custody test target minutes before the custody.rs repair of 22.95.11 landed and stopped on E0063/E0560/E0609."
fix = "Make the re-sweep require the repair task and requalify it on the current main once the repair is published."

[gotcha.2944]
title = "The Rust test harness skip filter matches by substring"
symptom = "A seven-test real-workload family in the hosted PaxAI service shares the _real_ name marker; listing each test separately bloated the verify command."
fix = "Exclude a family with its shared marker in one --skip filter and list every excluded test by name in the repair record."

[gotcha.2945]
title = "The fee-token sequencer receipt vector names a different payment asset on purpose"
symptom = "A repair stopped because sequencer-receipt-fee-token-v1.json carries paymentDenom usid while the other vectors carry uhpx and read it as a fixture disagreement."
fix = "The fee-token vector records a fee paid in another asset (22.23.8, 22.95.3); it is not a defect and must not be edited."

[gotcha.2946]
title = "Generated pointer files go stale when the workflow spec changes without a re-render"
symptom = "tools/specgen TestRepositorySpecIsValidAndCurrent reports CLAUDE.md, AGENTS.md, .cursor/rules/spec-workflow.mdc and .github/copilot-instructions.md stale and fails every specgen change."
fix = "Re-render with go run ./tools/specgen -root . and commit the four outputs in the same change."

[gotcha.2947]
title = "Feature-gated helpers used by ungated tests break an all-targets build with default features"
symptom = "The vendored wasm-instrument crate defines DynamicHelper and add_dynamic_helpers under the bulk feature while two helper-sequence tests in src/gas_metering/mod.rs use them without a gate; cargo build --all-targets fails with E0433/E0425."
fix = "Gate the tests with the same feature attribute as the items they use, or enable the feature in the test profile; never widen default features to make a test compile."

[gotcha.2948]
title = "A manifest change without a lock refresh fails the requalification build under --locked"
symptom = "The gateway repair added two dependencies to services/platform/hosted/gateway/Cargo.toml; the workspace lock was outside the edit scope, so the requalification build stopped with the lock file needs to be updated."
fix = "Give every task that may change a manifest the workspace lock file in its scope and refresh only the entries that manifest needs."

[gotcha.2949]
title = "Sweep record header counts drift from their blocks after block-level re-records"
symptom = "go-consensus.kvx declared 161 passed targets while all 162 blocks passed, failing the summary generator for an unrelated task."
fix = "Recompute header counts from the blocks whenever a block result changes."

[gotcha.2950]
title = "The receipt source is rebuilt only from entries after the last committed WAL entry"
symptom = "node/sequencer/wal replay feeds exec only the entries after the last COMMITTED entry, so a send committed before a restart has no receipt after it and pax_sequencerReceipt answers nothing for it."
fix = "Rebuild the receipt source from every retained ACCEPT entry on start, marking those at or below the commit watermark committed without re-executing them."

[gotcha.2951]
title = "Test fixtures serve receipt-key heights as hex strings while the node serves numbers"
symptom = "The agent daemon node fixtures answer firstHeight and lastHeight as 0x strings; rpc/sequencer_receipt.go encodes them as uint64 numbers, so a decoder matched to the real wire refuses the fixture."
fix = "Make every fixture answer the exact JSON shape of the Go wire type and decode numbers as numbers."

[gotcha.2952]
title = "Conformance digest constants go stale when the recorded fixture directory is regenerated"
symptom = "x-websearch recorded_suite hashes every file under fixtures/gateway and counts the gateway endpoint rules; after re-recording, CONFORMANCE_SUITE_DIGEST and CONFORMANCE_VECTOR_COUNT in src/lib.rs no longer match and the gate reports a conformance error."
fix = "Regenerate the digest and count constants in the same change that re-records the fixtures."

[gotcha.2953]
title = "Rendered spec pointer files that differ from the committed adapters make the qualification candidate drift"
symptom = "The qualification done step re-renders CLAUDE.md, AGENTS.md, the cursor rule and the copilot instructions; when the committed files differ from the render, the verified tree is not the candidate (same_candidate unmet)."
fix = "Commit the four pointer files exactly as the renderer writes them and keep the generator check mode identical to the renderer."

[gotcha.2954]
title = "Two landed repairs added manifest dependencies without the workspace lock and turned every --locked build of the workspace red"
symptom = "22.99.49 (layerx-client) and 22.99.50 (layerx-sdk) each added dependencies to their Cargo.toml; services/agent/Cargo.lock was outside their scope and their own verifies passed before the merge, so main now fails cargo build --locked for the whole services/agent workspace."
fix = "Give every Rust task its workspace lock as a planned path (decision 2511) and refresh the lock in the same commit as the manifest."

[gotcha.2955]
title = "The indexer proof tests spawn the Go proof producers, which link against the kernel native libraries a Rust-only build never produces"
symptom = "hosted/indexer/tests/history_position.rs runs go test for the layerxledger, layerxpay and layerxauth proof producers and reads their bytes from stdin; in a Rust-only environment the Go link step fails (cannot find the kernel and programs environment libraries) and the three proof tests panic with an empty producer answer."
fix = "Run such tasks in the mixed environment profile and build the kernel native libraries (make -s paxd-native-libs) before the cargo build."

[gotcha.2956]
title = "A fixture file a test includes at compile time was created during the task but did not reach its commit"
symptom = "Task 9.98.2 made two agent daemon tests include tests/fixtures/authority/provider-subject/consent.activity; its commit a1ea1c8a6 deleted onboarding.activity but did not add the new file, so cargo build --tests of layerx-agentd fails on main for every later task while the task's own verification had passed against its working tree."
fix = "22.99.159 restores the fixture from its producer (the signed consent inside sponsored.activity); every task that creates a file its code includes or reads lists the file in the change set and the repair record names it; reviewers compare the commit's file list with the new include_bytes and read_to_string paths."

[gotcha.2957]
title = "A crate manifest change left four workspace lockfiles stale and every locked build on main failed"
symptom = "Commit 051e6c3e0 (task 13.99.1) removed the wasm32 spin dependency from programs/crates/layerx-programs-ai-market/Cargo.toml; the crate is a path dependency named in programs/Cargo.lock, services/agent/Cargo.lock, services/human/Cargo.lock and services/platform/Cargo.lock, none of which followed, so cargo build --locked in those workspaces and make paxd-native-libs (programs-release-build, Makefile:2738) fail with the lock file needs to be updated."
fix = "22.99.160 refreshes the four lockfiles with cargo update --workspace; decision 2513 makes every manifest-changing task refresh and carry every workspace lock naming the crate."

[gotcha.2958]
title = "Extending an exact receipt field set is a producer change that every consumer fixture must follow"
symptom = "22.23.11 added paymentDenom to RECEIPTED_FIELDS and matched the receipted and committed rungs with Fields::exact; its verify ran only the layerx-client tests, so the daemon's receipt fixtures (ops/program.rs, human_runtime.rs, tests/support/mod.rs and the receipt mocks under tests/) kept decoding as Malformed and 9.35.19 attempt 8 failed seven unrelated tests on main."
fix = "A task that adds a field to an exact field set lists every consumer crate's fixture files in its paths, adds the field there in the same change and runs those crates' tests in its verify; 9.98.4 repairs the fixtures."

[gotcha.2959]
title = "A header rename at a paid gateway is a producer change every client must follow"
symptom = "The x-websearch gateway reads LAYERX-PAYER-ADDRESS (an EVM address) and ignores the former LAYERX-PAYER-DID header, so the TypeScript and python web-search clients kept sending the retired header and failed only through the replayed exchange the gateway recorded (400 unrecorded_request on the metered search)."
fix = "When a producer renames or re-types a request header, git grep the old name across every client and queue one consumer task per owning domain; the recorded exchange is the contract both sides must match, and a header the producer silently ignores is still a defect."

[gotcha.2960]
title = "A package-wide Go test run is not a repair task's gate when the package carries service-bound tests"
symptom = "Repair tasks in services/launchpad packages passed their own tests and failed the gate on pre-existing tests that need PostgreSQL, Redis, S3, Anvil or a live RPC endpoint; others wrote repair tests that themselves skip-fail without such services."
fix = "A repair task's verification runs only its own TestRepair_N_* functions, and those run in-process; the package's other tests must keep compiling and follow any behaviour the repair changes."

[gotcha.2961]
title = "A durable approval's actor is an EVM address; a DID comparison on it never matches"
symptom = "The approval budget facts operation compared a managed agent DID with the held activity actor, which the hold validation fixes to the 40-hex address form, and parsed that actor as a DID; the operation refused every real held approval."
fix = "Resolve the managed agent by its signing address and use its DID afterwards (decision 2517); never parse a durable approval actor as a DID."

[gotcha.2962]
title = "A repair test that needs environment variables, credentials, a live RPC endpoint, a subprocess toolchain or a device is not a gate"
symptom = "Repair tests asked for PostgreSQL, Redis and S3 variables, a funded signer, a live RPC endpoint, node or Go subprocesses and a .NET runtime; none exists in the qualification environment, so the tasks failed or refused regardless of the repair."
fix = "A repair proof runs in-process against the real code path with committed fixtures (recorded transcripts, httptest servers, in-memory stores); an external dependency in a test is a defect of the test, not a reason to qualify elsewhere."

[gotcha.2963]
title = "A TestMain that executes an external binary makes the whole package gate environment-bound"
symptom = "services/launchpad/security/control starts an Anvil binary in TestMain, so even a -run pattern selecting only the repair tests fails where the binary is absent."
fix = "TestMain never executes an external program; a fixture that needs one starts on first use inside the tests that need it, and the repair tests run without it."

[gotcha.2964]
title = "A repair task takes its toolchain from the directory build manifest, never from a default"
symptom = "Go gates were generated for a Rust crate (Cargo.toml), a .NET SDK (.cs sources) and a directory holding only deployment manifests; the attempts wrote Go tests that shelled out to cargo or dotnet and failed to compile."
fix = "Rust crates get a cargo integration test, Python or manifest-only directories a pytest source assertion, and a Go test only where a go.mod governs the directory."

[gotcha.2965]
title = "go test -run with a pattern that selects no test exits 0"
symptom = "A repair proof named TestMobileRepairLive was not selected by the gate pattern TestRepair_30_, so the gate would have passed with no test executed."
fix = "Every Go repair gate runs with -v, keeps its log and requires a PASS line for a TestRepair_N_ function before accepting exit 0."

[gotcha.2966]
title = "A repair candidate carries only sources under its touches and its test: no helper project of another toolchain, no compiled cache, no ignore-file edit"
symptom = "Candidates committed Python bytecode caches, Rust probe crates under deploy and test directories, Go producers inside Rust and Python packages, and .cgignore edits that exposed a cargo target directory as 6963 changed paths; each failed the scope or same-candidate check."
fix = "Delete helper projects and caches before the gate runs; the proof lives in the test file of the directory toolchain (gotcha 2964); a repair task never edits .cgignore."

[gotcha.2967]
title = "The gate runs last, on the final candidate tree"
symptom = "Several attempts passed their verify command on a tree that differed from the committed candidate because files were edited or generated after the run, so the recorded run qualified nothing."
fix = "Run the verify command as the last action and change nothing afterwards; if any file changes, run the gate again and record that run."

[gotcha.2968]
title = "A hand-built fixture must satisfy the production validators its consumer runs"
symptom = "Repair tests failed inside genesis validation, MsgCreateValidator.ValidateBasic, the generated HTTP response contract, the ABI result decoder and the SDK canonical-output decoder because the fixture was typed by hand instead of produced by the real encoder: perps genesis order indexes, a validator message without a commission, a preferences response missing notification categories, undecodable mocked return data, a terminal output blob with the wrong offsets."
fix = "Produce fixtures with the production encoder, generator or message constructor and run the same validator the consumer runs on them before asserting on the consumer; when the validator refuses the fixture the test is wrong, not the component."

[gotcha.2969]
title = "The verify command matches the toolchain of the directory under repair"
symptom = "Four repairs of Node example packages under services/platform carried a cargo test command naming a test target that no crate owns, so the implementers added bogus Rust test files to the platform workspace; a Next example was installed from the public registry where its private package does not exist; an explorer app pinned to yarn was driven with pnpm."
fix = "Before writing a repair task read the package manifest of the touched directory and derive the build and verify commands from its own toolchain and scripts; a Rust command never gates a Node package and a registry install never gates a private package."

[gotcha.2970]
title = "A crate directory under a workspace is not a member until the workspace manifest lists it"
symptom = "A repair task built a crate with cargo -p by the name of its directory under services/human/crates; the directory held one orphaned test file left behind by the deletion tasks of the crate, no manifest, and no workspace entry, so cargo refused the package id and the task failed at build."
fix = "Before writing a cargo -p command read the workspace members list and the directory manifest; a directory that has lost its manifest is a deletion leftover and the task removes it instead of building it."

[gotcha.2971]
title = "The tail of a go test log hides why the package failed"
symptom = "Two repair tasks printed every one of their TestRepair_ tests as PASS and still reported FAIL for the package: the cause (a sibling test in the same file from an earlier attempt, a vet refusal or a panic outside the matched tests) sat above the eighty-line tail the gate shows, and the agents called it out of scope."
fix = "A go verify prints the RUN, PASS, FAIL and panic lines of the whole log before its tail, and every test matched by the run filter belongs to the task that owns the filter: it is fixed or removed, never declared out of scope."

[gotcha.2972]
title = "A test reaches repository files through the helpers the production tests use"
symptom = "A repair test typed the migrations directory from the repository layout (spec/production-system at the root) while the production tests of the same package build it from the coordinator test helper, which already knows the real directory (launchpad/spec/production-system/integration/migrations) and the repository root; the attempt then called its own path bug an out-of-scope fixture defect. A second test compared a checksummed address the producer emits against a lowercase literal and called the mismatch a fixture problem."
fix = "A test derives paths, addresses and other shapes through the production helpers and types (the root helper, the address type's parser, the encoder), never from literals typed by hand; a mismatch between the literal and the producer is a test defect the task fixes, not a scope limit."

[gotcha.2973]
title = "A dependency added to one npm workspace member without the root lockfile breaks npm ci for every member"
symptom = "A published repair added a ganache devDependency to services/platform/examples/marketplace/package.json, a member of the root npm workspace, without touching the root package-lock.json; npm ci run inside services/agent/sdk/typescript then refused with the lockfile out of sync, and every task building a workspace member failed before compiling (22.9.10 a30)."
fix = "The npm lockfile of a workspace lives at the root and npm ci in any member directory validates the whole workspace; a task that changes a member manifest carries the root lockfile as a planned path, and a test never needs a package the manifest and lockfile of its package do not already declare."

[gotcha.2974]
title = "A producer repair that changes a public type must carry the consumer crate's tests, not only its sources"
symptom = "22.31.157 changed the gateway balance row amount from a 128-bit integer to the exact Quantity type and updated the human service sources that read it, but left services/human/crates/layerx-human-service/tests/observed_balances_denom.rs on the old type; every later task building that crate with --tests, and every task whose dependent-crate check includes it, failed before its own verify ran (22.33.56 to 22.33.62, 22.33.48, 22.33.51, 22.33.117, 22.33.218, 22.33.221, 22.33.244 a1)."
fix = "An interface change lists the consumer's tests directory in its touches and its verify builds the consumer with --tests; the consumer's integration tests are part of the real producer, transport and consumer path."

[gotcha.2975]
title = "A scope path whose directory name contains bracket characters is read as a glob character class"
symptom = "22.33.163 a1 declared the Next.js route directory apps/wallet/src/app/api/wallet/[...path]; the scope check treated the brackets as a character class, matched no changed file and refused the candidate although the type-check and all seven tests passed."
fix = "Declare the parent directory of a bracketed route directory in touches and reference the bracketed path only in the verify command."

[gotcha.2976]
title = "A type-check that follows relative imports into sibling packages needs those packages installed from their own workspace"
symptom = "apps/perps imports modules of sdk/wallet and services/wallet/gateway by relative path (published by 22.31.4); its type-check failed on every attempt with viem, the noble packages and zod unresolved because only apps/perps had been installed (22.33.12, 22.33.77, 22.33.79 to 22.33.83, 22.33.193 a1). sdk/wallet and the gateway are members of the services/wallet pnpm workspace, whose lockfile is services/wallet/pnpm-lock.yaml; an install run inside sdk/wallet alone climbs to the repository root workspace and installs nothing useful."
fix = "The build command of a task whose type-check crosses into the wallet workspace runs pnpm --dir services/wallet install --frozen-lockfile --ignore-scripts first; the lasting repair makes apps/perps declare those packages (22.31.444)."

[gotcha.2977]
title = "The bridge application's global layout props type exists only after the framework's type generation step"
symptom = "apps/bridge/src/app/layout.tsx uses the LayoutProps global type that Next.js 16 generates with next typegen; a bare tsc --noEmit fails with the name not found before any task test runs (22.33.264, 22.33.266, 22.33.268 a1), while the package's own typecheck script runs the generation first."
fix = "A type-check gate of a Next.js application runs the package's typecheck script (or next typegen before tsc), never tsc alone."

[gotcha.2978]
title = "The web application's node:test suites cannot import a module that imports a Next.js runtime entry"
symptom = "apps/web runs its e2e suites with node --test; a test that imports src/kit/explorer.tsx or src/journeys/onboarding/onboarding.tsx fails with ERR_MODULE_NOT_FOUND for next/link or next/navigation because the Next.js package resolves those entries only through its bundler, not through the Node ESM resolver (22.33.337 a1 and a2); the committed suites import only the copy catalog, the perf budgets and other pure modules."
fix = "A node:test case of apps/web imports pure modules only; behaviour of a component that imports a Next.js entry is asserted through the component's extracted pure logic or through the Playwright suites, never by importing the component under node --test."

[gotcha.2979]
title = "Explorer component suites fail in teardown when the mocked fetch receives a request the component built from unset configuration"
symptom = "apps/explorer runs every vitest suite with the global fetch mock enabled by vitest/setup.ts; a component whose request is built from configuration the suite never set, or whose query refetches after the test ends, calls fetch with an undefined request and the mock's request normalisation throws a TypeError reading toString, reported as a failed suite or hook rather than a failed case (22.33.501, 22.33.282, 22.31.382, 22.33.367 all spent their repair budget on it)."
fix = "An explorer suite that exercises a component's request disables the global mock for the suite, serves recorded responses from a loopback node:http server it starts, and re-enables the mock in afterAll, as the published repairs 22.31.379 and 22.31.380 do; a suite that keeps the mock gives the component its endpoint explicitly and asserts the request URL."

[gotcha.2980]
title = "perps-data store and replay tests refuse the database the qualification environment provides when a task clause says the gate needs no environment variable"
symptom = "services/platform/perps-data stores its projections in PostgreSQL and its store and replay tests open the database named by PERPS_DATA_TEST_DATABASE_URL, which the qualification environment provisions for every task under that path (the done repairs 3.42.8, 3.45.1 and 22.31.21 ran against it). Two medium-wave attempts (22.33.826, 22.33.827) unset the variable to honour the wave clause that a gate needs no environment variable, credential or external binary, and their store-backed tests failed in setup."
fix = "For services/platform/perps-data the PostgreSQL database named by PERPS_DATA_TEST_DATABASE_URL is the real store's fixture and the no-environment clause yields to it: tests open that database, create a schema unique to the run, and fail naming the variable when it is absent; they never unset it, mock the store, or substitute another engine."

[gotcha.2981]
title = "python test runs write bytecode caches beside the tests and the candidate stops matching the built revision"
symptom = "pytest writes __pycache__/*.pyc next to the test files it runs; the publication check swept them into the candidate of 22.33.776 a1 (all 11 tests passed, built and verified revisions differed) and of 22.33.727 a2 (a requalification run with no edits at all), and three bytecode files under tools/qualification/audit_repairs/__pycache__ were committed by 22.34.1, 22.31.425 and 22.31.427 because the root .gitignore has no bytecode rule."
fix = "The qualification environment runs Python with bytecode writing disabled, the root .gitignore ignores __pycache__/ and *.pyc (task 22.31.458 removes the three committed files), and a verified revision that differs from the built one only by bytecode caches is a qualification-environment effect, not an attempt defect: the attempt is requalified."

[gotcha.2982]
title = "a touches entry given as a bare string was iterated character by character and shredded four scope lists"
symptom = "The touches lists of 22.31.275, 22.31.280, 22.31.281, 22.31.282 and 22.95.1 carried one path split into single characters (an earlier ruling passed the swagger output path as a string, not a list), so the attempts of 22.31.275 and 22.31.280 were refused for changing the regenerated swagger file outside scope although the ruling had meant to admit it."
fix = "List fields are set from lists only (the helper now refuses a bare string); the five lists are rewritten whole, and a scope refusal on a path a ruling meant to admit is checked against the raw touches list before the attempt is blamed."

[gotcha.2983]
title = "a published repair raised one launchpad module to Go 1.27 behind a nested workspace file and broke every build in the shared launchpad workspace"
symptom = "Task 22.33.958 (published 07:06Z) set services/launchpad/notifications/go.mod to go 1.27.0 for its go-pglite dependency (which itself requires 1.27.0) and added services/launchpad/notifications/go.work so its own gate passed; services/launchpad/go.work still says go 1.25.0, so every build of a workspace member fails with the message that ../notifications requires go >= 1.27.0 (22.33.1028 attempt 2, 22.33.1049 attempt 1; 22.31.63 attempt 5 worked around it with GOWORK=off, which is not a gate)."
fix = "A module version bump carries its workspace with it in the same commit, no member of a workspace carries its own workspace file, and disabling the workspace is never a gate workaround; repair 22.31.461 raises the launchpad workspace and removes the nested file, and every unfinished Go task under services/launchpad requires it."

[gotcha.2984]
title = "medium-wave gates generated from a directory name instead of its files never run"
symptom = "The medium repair wave derived each task's gate from the path of the audited directory: eleven tasks got a go test gate on directories holding only Rust or Python sources (the webhooks, paxeer, node, human and testnet services, the release and qualification tools, the explorer deploy tools, the pay2 qualification crate and the platform CLI), and ten tasks got a cargo --test gate through a Cargo.toml that is a virtual workspace root (services/agent, services/platform, services/interop, programs, the explorer libs and sig-provider roots), which cargo refuses because a virtual manifest has no package to test."
fix = "A gate names the toolchain of the files it proves: a cargo --test gate goes through a member crate's own manifest and the test lives in that crate's tests directory; a directory of Python sources gets a pytest gate; a doc-drift finding is proved by a Python test under tools/qualification/audit_repairs. Batch 420 corrects the twenty-one gates; a new generated gate is checked against the files of its first touched path before it is published."

[gotcha.2985]
title = "a member crate manifest deleted while the workspace still lists the member stops every cargo gate of that workspace"
symptom = "Repair 22.33.1319 retired the Paxeer boundary relay by deleting services/platform/hosted/paxeer/Cargo.toml and recording a wiring request to drop hosted/paxeer from services/platform/Cargo.toml, while the member stayed listed; from that commit on every cargo command through the platform workspace failed with failed to load manifest for workspace member hosted/paxeer before any test ran (attempts of 22.33.1329, 22.33.1418 and 22.33.1465), and the binary the crate builds is still consumed by the Makefile public TLS test, the docker image, gate 24.16 and the platform test support (decision 2325)."
fix = "A task that retires a crate removes the member from the workspace manifest and its lock entry in the same change, or leaves the manifest in place and records the wiring request; a manifest is never deleted alone. 22.31.465 restores the manifest per decision 2524 and attempts that failed on the missing member are continued behind it."

[gotcha.2986]
title = "A repair deleted deployment files other hosted scripts import"
symptom = "22.33.1319 removed services/platform/hosted/paxeer/evm.py, custody-genesis.py, deploy-contracts.sh, deployment.yaml and deployment-input.beta.json as unreferenced, while hosted/human/merged_owner.py, hosted/human/test_material.py, tools/qualification/paxeer-x fixtures, tools/release/rehearsal/programme.py, tools/bringup tests, services/platform/Makefile.inc and the hosted beta test script still import or invoke them; 22.33.1402 and later attempts failed on the missing module."
fix = "Task 22.31.467 restores the five files byte-identical to their last committed content (decision 2524) and amends the 1319 repair test so it no longer asserts their absence. A deletion is a producer change: grep every consumer across the repository, not only the owning directory, before removing a file."

[gotcha.2987]
title = "Ninety-seven audit repair tasks serialized on one root file"
symptom = "Every root-readme-topology finding of the medium wave was emitted as a separate task declaring README.md in its paths, so the tasks could only run one at a time and the queue of eligible work fell far below the capacity available."
fix = "Decision 2525: one task, 22.31.470, rewrites the root README for all of them; the ninety-six remaining tasks keep only their own test module and record in their paths, require 22.31.470, and assert the finding's expected facts against the README as 22.31.470 left it. A finding on a shared root file belongs to one owning task; the others consume its result."

[gotcha.2988]
title = "A schema migration rewrote a whole table inside its transaction"
symptom = "Explorer migration 20261104000000 (task 22.31.406) executed UPDATE paxeer_x_price_observations SET accepted = NULL over every row and held an exclusive lock from a no-op column change for the whole transaction; on the hosted database the statement ran until the connection dropped, the release restarted and began the same migration again, so the explorer never reached start and the table stayed locked for hours. It would also have cleared every accepted row for market reads with no indexer process wired to replay them."
fix = "Commit c80e00c2c2 made the migration install the replay queue only and moved the reset into the replay transaction that starts one block, bounded to that block and redone with its first batch. Decision 2526: migrations install structure; data rewrites run as bounded, resumable steps outside the migration transaction. Task 22.31.472 requalifies the 406 repair test against the changed files and wires the replay runner into the indexer."

[gotcha.2989]
title = "Build-time database TLS options with a function term broke the explorer release"
symptom = "Task 22.33.471 imported config/database_tls.exs from the explorer app's prod.exs; its customize_hostname_check match_fun is the function returned by :public_key.pkix_verify_hostname_match_fun/1, and mix release refuses to write build-time configuration containing function terms (only &Mod.fun/arity captures are allowed). Every explorer backend image build on main failed from commit 25b4ee81e6 until 9dabd5ce50, which also kept the migration fix c80e00c2c2 from reaching the hosted database."
fix = "Database TLS options are runtime configuration only (decision 2527): prod.exs no longer imports them, config/runtime/prod.exs applies them at startup, and task 22.31.473 adds a guard that reads the production build configuration and refuses function terms, plus a release run in the qualification environment."

[gotcha.2990]
title = "Explorer frontend spec files failed the production build's lint step"
symptom = "next build lints every file of apps/explorer including spec files; eight spec files added by audit repairs (repair-22-31-379, repair-22-31-380, repair-22-31-448, repair-22-33-289, repair-22-33-292, repair-22-33-295, paxeerX.spec.ts, dependencyVersions.spec.ts) call test(fn) with a function reference as the title, which eslint-plugin-vitest rejects (valid-title, expect-expect), so the frontend image build has failed since they landed while the tasks' tsc and vitest gates passed."
fix = "Task 22.31.474 repairs the spec files and the TS2769 in repair-22-33-299.spec.ts; decision 2528 makes every pending apps/explorer task run eslint on the spec files it adds."

[gotcha.2991]
title = "The EVM chain id still defaults to a foreign test network"
symptom = "modules/evm/config/config.go line 10 keeps DefaultChainID = 713714 (an inherited upstream test network) and maps pacific-1, atlantic-2 and arctic-1 beside hyperpax_125-1; any application whose cosmos chain id is not in the mapping signs and verifies for chain 713714, so node tests built on an unmapped test chain fail with invalid chain id for signer: have 125 want 713714 (22.33.1141 attempt 1), and two tasks already had to be told that no Paxeer network uses 713714."
fix = "Decision 2529: the default EVM chain id is 125 and the foreign network mappings are removed (task 22.31.476); tests derive the signer chain id from the application's configured chain id, never from a literal."

[gotcha.2992]
title = "A repair gate for the nested launchpad user module used root-relative Go patterns"
symptom = "The build command of 22.31.471, go build ./services/launchpad/user/..., failed with directory prefix services/launchpad/user does not contain main module because that directory is its own Go module (services/launchpad/user/go.mod) outside the root module; the implementation never compiled."
fix = "Gates for that module change into it first (cd services/launchpad/user && go build ./...), as the other launchpad user tasks already do; 22.31.471 is requalified with repaired commands."

[gotcha.2993]
title = "The middleware conformance package stopped compiling after the seller payment union"
symptom = "services/platform/middleware/conformance/src/scenarios.ts line 447 reads paymentReference from verification.payment, whose type became PaymentExactEvent | PaymentDrawnEvent when the seller repair of audit record 22.30.86 landed (5a468c4b87); PaymentDrawnEvent (seller ledger.ts line 37) has no paymentReference, so every gate that builds the conformance package (22.33.1479, 22.33.1480, 22.33.1481) fails before its tests run."
fix = "Repair task 22.31.477 narrows the union in the committed-rung scenario (decision 2530); the three consumers require it."

[gotcha.2994]
title = "A root workspace member manifest changed without the root lockfile"
symptom = "The repair of audit record 22.30.74 in services/platform/examples/agent-spend (ea2e88ad0a, task 22.33.1364, 12:11Z) added viem, @sidiora/layerx-agent-integrations and two devDependencies to the example's package.json, a member of the root npm workspace, without regenerating package-lock.json; since then every gate that runs npm ci at the repository root (and npm --prefix <member> ci, which resolves the same root lock) fails with EUSAGE before compiling: 22.31.477, 22.33.612, 22.33.619, 22.33.1478, 22.33.1480 and more."
fix = "Repair task 22.31.479 regenerates the root lock, drops the unused devDependencies and adds a test proving every workspace member's declared dependencies resolve in the root lock; the root-npm tasks require it."

[gotcha.2995]
title = "Medium-wave repair tasks held the whole audit-repairs directory as a touch"
symptom = "138 pending tasks of the medium wave declared tools/qualification/audit_repairs (the directory) as a touch while their gates only read and write test_repair_<id>.py and repair_<id>.kvx inside it; because two tasks that touch a directory and a file inside it exclude each other, at most one of them could be live at a time and the eligible pool fell to single digits with over a hundred eligible tasks."
fix = "The touches of every pending task of that shape are narrowed to its own two files; the directory touch stays only on tasks that already published."

[gotcha.2996]
title = "The root README rewrite and an earlier README repair conflicted at publication"
symptom = "22.33.33 (doc-drift of audit record 22.30.102) changed README.md and reached the human domain integration first; 22.31.470 then rewrote the root README on main and, as its do_3 required, reconciled the 22.33.33 changes into the rewrite; the later merge of the human domain into main conflicted on README.md and stalled every human-domain publication for ninety minutes."
fix = "The merge keeps the 22.31.470 README (33e39ac9e2), which already carries the 22.33.33 facts; tasks whose README changes later conflict re-apply them on top of the rewrite."

[gotcha.2997]
title = "Installed binaries under apps/perps/node_modules are tracked"
symptom = "Nine executable files under apps/perps/node_modules/.bin (autoprefixer, esbuild, next, webpack and five more) are committed although apps/perps/.gitignore lists /node_modules. A dependency install anywhere in the repository rewrites them, and the qualification gate then counts the rewritten file as a change outside the task's declared paths: 22.31.447 attempt 3 passed every gate and was rejected for apps/perps/node_modules/.bin/webpack."
fix = "22.31.480 removes the nine files from the index so the ignore rule takes effect. Until it lands, a task whose gates run a dependency install restores the directory with git checkout -- apps/perps/node_modules before finishing."

[gotcha.2998]
title = "Two parallel hosted-platform repairs crossed on the maintained node manifest"
symptom = "22.33.1319 (relay retirement, committed 08:38Z, merged 10:23Z) wrote four Go tests that encode the native deployment as the manifest services/platform/hosted/node/deployment.yaml stood in its own tree: image ghcr.io/sidiora-labs/layerx-kernel:0.1.0, service targets chain-rpc and consensus-rpc, a --receipt-key-file argument and a shell provisioning loop. One minute later 22.33.1319's neighbour 22.30.76 part 1 (5b49dd0528, hosted/tests config-drift) rewrote that manifest into one kernel container ghcr.io/sidiora-labs/kernel:0.1.0 with targets rpc, consensus and health and a Python provisioning map. Both passed their gates in their own trees; on main the four 1319 tests fail, and 22.31.465, whose verify runs them, cannot qualify."
fix = "Decision 2532 names the manifest the producer; 22.31.481 reconciles the four tests with it; 22.31.465's verify no longer runs the 1319 tests. A test that asserts a deployment fact reads it from the maintained document rather than repeating the literal."

[gotcha.2999]
title = "A repair planted a second install root under apps/wallet/src/lib/swap"
symptom = "22.33.121 (published 2026-11-04 14:15Z) added apps/wallet/src/lib/swap/package.json and npm-shrinkwrap.json declaring @ethereumjs/block, common, tx, util and vm 10.1.3, solc 0.8.27 and prettier for its fixture evm-22-33-121.fixture.ts, installed into an ignored node_modules beside them. apps/wallet/package.json declares none of these, so the app type-check (tsc --noEmit -p apps/wallet/tsconfig.json) fails with TS2307 on the five imports for every later wallet task; 22.33.123 attempt 2 (14:40Z) was the first."
fix = "22.31.482 moves the five @ethereumjs packages and solc into the devDependencies of apps/wallet/package.json with the pnpm lock, removes the nested manifests and fixes the fixture's implicit any; 22.33.123, 22.33.133 and 22.33.186 require it. One install root per application: a fixture never carries its own manifest."

[gotcha.3000]
title = "The embedded precompile ABI inventory of sig-provider drifted from its generator"
symptom = "services/explorer/services/sig-provider/sig-provider/src/sources/precompiles.json no longer equals the inventory the production ABI generator emits when it is executed in-process: the abi section differs (the BackstopLiquidation event among others). 22.33.312 attempt 1 (2026-11-04 14:49Z) asserted the equality and failed; its other five documentation checks passed."
fix = "22.33.312 regenerates the embedded inventory from the real generator in the same change and keeps the equality assertion; the inventory file is in its paths and the Rust integration cases join its verify."

[gotcha.3001]
title = "Un-ignoring a package directory in .cgignore drags its install root into the recorded change set"
symptom = "22.33.246 attempt 1 (2026-11-04 14:59Z) edited .cgignore outside its paths and installed programs/sdk/assemblyscript; the recorded change set then listed 122 files under programs/sdk/assemblyscript/node_modules although the directory's own .gitignore excludes node_modules, and the build ran at an earlier revision than the verify (build_on_verified unmet), so the passing tests did not qualify."
fix = "The attempt continues: .cgignore reverts, the install root leaves the change, and build and verify run at the same revision. An install root is never part of a change (gotchas 2997, 2999); a repair that needs a package installed installs it in its build command."

[gotcha.3002]
title = "The Paxeer boundary manifest was retired while five consumers still read it"
symptom = "Task 22.33.1319 (065d0370da) deleted services/platform/hosted/paxeer/deployment.yaml and made the deployment command re-emit the node manifest instead. services/platform/hosted/gateway/tests/repair_22_31_345.rs line 12 still includes the file at compile time, so every build of the gateway tests fails (22.31.208 attempt 4, 22.33.1336 attempt 4, 22.33.1445 attempt 2, 22.33.1550 attempt 2 on 2026-11-04); services/platform/hosted/human/test_material.py, services/platform/hosted/node/tests/node-topology-test.py, services/platform/hosted/tests/topology-check.sh and services/platform/hosted/testnet/README.md still describe the paxeer workload the file declared."
fix = "Task 22.31.483 restores the tracked boundary manifest and reconciles the consumers (decision 2533); the blocked tasks require it and requalify when it is on main."

[gotcha.3003]
title = "The AI-market hosted service decodes the joint reputation-admission section without splitting it"
symptom = "programs/crates/layerx-programs-ai-market/src/reputation_transition.rs writes the ReputationAdmission section as a joint section (encode_joint, split_joint) since the epoch and registry producers were repaired; the hosted service's discovery.rs line 134 and membership.rs line 289 still hand the whole section to AdmissionTable::decode and fail with UnsupportedVersion. 22.33.1465 attempt 3 (2026-11-04) recorded the break as the authority-joint-section wiring request."
fix = "Task 22.31.484 splits the section with split_joint before decoding in FinalizedAuthority::bind and MembershipObserver::observe and proves the producer to consumer path with a joint section from encode_joint; 22.33.1465 requires it."

[gotcha.3004]
title = "Two consumers of layerx-client were never ported to the retired px and committed-block types"
symptom = "services/platform/hosted/core/src/public_reads.rs still calls Uint256::to_be_bytes, reads the layerx field of PxAssetEntry and compares string asset ids with byte asset ids (lines 96, 105, 137, 384), and services/agent/crates/layerx-agent-api/src/read.rs line 715 reads chain_sequence from CommittedBlockContext; both stopped compiling when 22.31.221 (fe2e725ea8) and 9.25.1 (036a1da1b6) retired those fields. The dependent-crate check of every layerx-client and programs-sdk task fails on them (22.33.1544, 1545, 1547, 222, 249 on 2026-11-04; public_reads.rs appears in 57 dependents logs of 39 tasks)."
fix = "Task 22.31.485 ports both consumers to the current layerx-client API with tests; the five blocked tasks require it and requalify when it is on main."

[gotcha.3005]
title = "A bracketed route segment in a touched path is read as a glob character class by the done gate"
symptom = "Touches such as apps/web/src/app/explorer/accounts/[accountId] are matched as a glob, so [accountId] stands for one character and never matches the real directory: 22.33.348 attempt 1, 22.33.361 attempt 1 and 22.33.362 attempt 1 (2026-11-04) passed their type-check and tests and were refused with touched ... no matching change although the directory changed."
fix = "Touches never contain a bracketed segment: the four affected tasks (348, 361, 362, 449) now touch the parent route directory, and the three finished attempts requalify."

[gotcha.3006]
title = "apps/perps/tsconfig.tsbuildinfo is tracked, so every perps type-check changes a file outside the paths"
symptom = "The root .gitignore ignores only apps/web/tsconfig.tsbuildinfo; the incremental type-check of apps/perps rewrites the tracked apps/perps/tsconfig.tsbuildinfo and the result is refused as a change outside the paths (22.33.190, 192, 193, 194, 195, 199, 200 on 2026-11-04, after 22.31.479 cleared their earlier refusal)."
fix = "22.31.480 removes the file from the index together with the install binaries and ignores it in apps/perps/.gitignore; the perps tasks require 22.31.480 and relaunch when it is on main."

[gotcha.3007]
title = "The committed receipt recording was signed under the retired default chain id 713714"
symptom = "daemon/committed-fixture/vectors/vector-v4-committed.json carries a legacy raw transaction whose EIP-155 chain id decodes to 713714: it was recorded while modules/evm/config/config.go still defaulted an unmapped application chain id to that inherited test network (gotcha 2991; 22.31.476 moved the default to 125). The production wallet authenticator refuses any recording whose transaction is not on chain 125 (sdk/wallet/src/receipt.ts line 455, transaction or receipt layout), so 22.33.338 attempt 7 (2026-11-04 16:03Z) could not authenticate the committed pair through the production path, and apps/wallet/src/surfaces/repair-22-33-205.test.ts line 116 pins the retired id instead. The receipted vectors v1 and v2 of the same directory already decode to chain 125."
fix = "22.31.486 re-records the committed vector with the recorder as it stands (the unmapped committed-fixture id now answers eth_chainId 125), refreshes the derived conformance, explorer, wallet and human-service copies and every consumer that pins the recording's hashes, and asserts the chain id in the recorder's own test; 22.33.338 requires it. A recording that the production verifier refuses is a producer defect, never a reason to bypass the verifier."

[gotcha.3008]
title = "The explorer client's merged OpenAPI document carries legacy v1 health schemas its merge script does not produce"
symptom = "services/explorer/services/libs/blockscout-client/swaggers/blockscout-api-final.yaml defines v1HealthCheckResponse with status, healthy and data, and v1Data with four block fields, although ts-src/merge-overrides.ts builds that document from swaggers/blockscout-api-v2.yaml (status only) plus the overrides under swaggers/overrides, none of which defines those two schemas; the generated models crate/src/models/v1_health_check_response.rs and v1_data.rs carry the committed shape. 22.33.360 attempt 2 (2026-11-04 16:44Z) asserted equality with the upstream snapshot for those two names and failed on it while its other five checks passed."
fix = "The committed document and its generated models are the contract the client ships: a test checks each schema against its generated model, not against the upstream snapshot, and the divergence from the merge script's output is recorded in the task record for the next intentional regeneration (README procedure). 22.33.360 attempt 3 applies it."

[gotcha.3009]
title = "Comparing maps of EVM precompile instances with require.Equal panics in the diff printer"
symptom = "node/upgrades_activation_test.go line 353 (22.33.1142 attempt 1, 2026-11-04 16:33Z) compared two map[common.Address]vm.PrecompiledContract values with require.Equal after ApplyUpgrade; the restored contracts are fresh instances whose keeper and function fields never compare deeply equal, and the diff printer then panicked with reflect.Value.Interface on their unexported fields, so the test reported a panic instead of the mismatch."
fix = "A served precompile set is compared by address (sorted keys), with require.Same for every instance that must be preserved and a behavioural check for every restored one; 22.33.1142 attempt 2 applies it and the other node upgrade test tasks follow the same shape."

[gotcha.3010]
title = "A path that does not exist in the tree fails the done graph check"
symptom = "22.34.4 attempt 5 (2026-11-04 16:40Z) passed its build and verify; the done gate refused the result because one of the task's paths named a file that is not in the tree, so the graph check could not resolve it."
fix = "Paths name files or directories that exist on main (or that the task itself creates); the 22.34.4 paths are reduced to rpc and the EVM RPC contract page and the attempt is requalified."

[gotcha.3011]
title = "Narrowed paths must carry every file an earlier attempt of the task already changed"
symptom = "Within ten minutes of the path narrowing of decision 2534 (2026-11-04 17:00Z) nine publications were held because the narrowed paths omitted files their own earlier attempts had changed (22.33.190, 192, 195, 198, 200 attempt 4; 1143, 597 attempt 1; 1465 attempt 4; 849 attempt 1)."
fix = "The paths of every open task with a recorded attempt are widened to the union of the files its attempts changed, and the held attempts are requalified; a narrowing never removes a file an attempt of the task touched."

[gotcha.3012]
title = "A content digest pinned on a manifest that a later task must restore breaks the pin"
symptom = "node/repair_m1319_test.go line 452 pins the digest of the Paxeer boundary deployment manifest; 22.31.483 restores the tracked manifest, so the pinned digest no longer matches (22.31.483 attempt 2, 2026-11-04 16:51Z)."
fix = "22.31.483 re-pins the digest to the restored manifest in the same change; a digest pin on a file another open task owns is re-pinned by that task, never left to drift."

[gotcha.3013]
title = "The PAY2 qualification receipt policy follows the state-commitment protocol version while the node serves protocol 2"
symptom = "services/agent/qualification/pay2 fixed its receipt policy to version 3 (the state-commitment protocol version of layerx-wire limits.rs) while rpc/sequencer_receipt.go line 46 serves protocol 2 and the SDK verifier (rpc_verification.rs line 602) requires 2; 22.33.1569 attempt 2 (2026-11-04 16:46Z) failed on that mismatch."
fix = "The qualification receipt policy follows protocol version 2 (decision 2435); 22.33.1569 continues with the policy corrected and the funded fixtures in its paths."

[gotcha.3014]
title = "The Rust SDK and the daemon budget encoder name the verification rung achieved_rung while the schema, the API and the Python and TypeScript SDKs name it achieved_verification_level"
symptom = "spec read.kvx line 7 and identity.kvx line 200, read.rs lines 1135-1159, agent_http.py line 483 and agent-http.ts line 618 use achieved_verification_level; agent_envelope.rs lines 1733-1736, rpc_export.rs lines 212-217, rpc_history.rs lines 154-157, rpc_budget.rs lines 68 and 253 and agent_rpc_adapters.rs line 1762 use achieved_rung. 22.33.1572 attempt 3 (2026-11-04 17:05Z) exposed the drift through the parity tests."
fix = "Decision 2535: the wire name is achieved_verification_level everywhere; 22.31.487 ports the Rust SDK and the daemon encoder and 1572 waits for it."

[gotcha.3015]
title = "The native storage-environment settlement receipt is produced framed while the runtime terminal reader accepts only the canonical bytes"
symptom = "host_ffi.rs near line 850 appends the receipt digest to the canonical usage bytes; the runtime terminal settlement module line 262 reads the receipt canonical-only and ffi_call.rs lines 2436-2445 map the refusal to NON_CANONICAL. 22.33.213 attempt 6 (2026-11-04 17:08Z) hit the refusal on the independent native submission."
fix = "Decision 2536: the receipt is framed as canonical usage bytes plus SHA-256 digest and the terminal reader unwraps and authenticates the frame; 22.31.488 implements both ends and 213 waits for it."

[gotcha.3016]
title = "The fiat conformance journeys reference the shared payExact vector whose reference is not provider-derived"
symptom = "services/interop/specs/conformance/fiat/sequenced-journeys.json points at the payExact recording of sdk/platform/conformance/fixtures while the fiat adapter derives idempotency keys and payment calldata from the provider journey (lib.rs lines 276 and 356); 22.33.94 attempt 3 (2026-11-04 16:58Z) failed the journey comparison."
fix = "22.31.489 re-records the fiat journeys from the adapter against the type-2 committed vector of 22.31.486; 94 waits for it."

[gotcha.3017]
title = "A verify that runs the whole TypeScript SDK suite fails on suites the task does not own"
symptom = "22.9.10 ran npm test (the full self-contained suite) in thirty-five attempts; every attempt since attempt 20 failed on suites outside the task (px, gas-station-pending, proof_gas_station, repair-22-33-21, repair-22-31-148, native-effect) while the market-operation suites passed."
fix = "The 22.9.10 verify names the suites the task owns; the unrelated failing suites are recorded as a finding for the closure sweep."

[gotcha.3018]
title = "The explorer's node client treats an HTTP 200 JSON-RPC error envelope as a result and the acceptance replay stalls on one held block"
symptom = "On 2026-11-04 17:47Z the price-acceptance replay held at block 37357231: the first configured CometBFT URL answered HTTP 200 with the envelope code -32603, height is not available (base height 42581978); cosmos_rest.ex fetch_block_results treated the 200 as success, results/1 reported it malformed, no failover to the second URL happened although that node retains the height, and next_job in price_acceptance_backfill.exs re-selected the same lowest block every retry. Thirteen of the fourteen public nodes prune block results below 42.58M; one retains them."
fix = "22.31.490: an error envelope is a failed attempt for that URL so the round-robin moves on, and the replay orders held rows after error-free rows so one unavailable block cannot stall the queue. The retention of block results on the public nodes is an operations matter recorded for the owner."

[gotcha.3019]
title = "A verify that names the wrong make targets never runs the task's own tests"
symptom = "22.33.1237 attempt 1 and 22.33.1236 attempt 1 (2026-11-04 17:20Z) ran test-module-ctx and test-module-registry while their changed files are the perps, asset, escrow and oracle module tests; the registry test failed on an unrelated inventory and the changed tests never ran."
fix = "Both verifies now build and run the module test binaries the tasks changed (Makefile targets under build/tests)."

[gotcha.3020]
title = "Paths widened after an attempt started are dropped from that attempt's result"
symptom = "The qualification environment records a result against the paths the task had when the attempt started: a file the attempt wrote under a path added later is reported as changed outside the paths and left out of the recorded tree. 22.33.1321 attempt 2, 22.33.1402 attempt 4, 22.33.619 attempt 10 and 22.33.595 and 22.33.596 attempt 2 (2026-11-04 17:00Z-18:30Z) all failed this way although every flagged file is in the paths on main now."
fix = "A relaunch after a widening starts from the attempt whose tree still holds the files (the earlier attempt), not from the attempt that lost them; the rulings of this batch name that attempt."

[gotcha.3021]
title = "A widening written under the wrong tree does not cover the attempt's files"
symptom = "Batch 439 widened 22.33.595 and 22.33.596 with their type, test and fixture files placed under sdk/wallet, while the attempts wrote them under services/explorer/services/smart-contract-verifier/smart-contract-verifier-server; attempt 2 of both tasks (2026-11-04 18:14Z) failed on the same files as attempt 1."
fix = "The paths are replaced with the attempt-1 change set under the verifier server tree and both tasks requalify from attempt 1; a widening is copied from the attempt's recorded change list, never retyped."

[gotcha.3022]
title = "The Go verify filter hides compile errors and prints the lines after a failure instead of the assertion before it"
symptom = "22.33.1292 attempt 1 (2026-11-04 17:34Z) failed because rpc/block_trace_profiled_test.go imports the go-ethereum tracer logger package unaliased next to the package-level logger variable of rpc/filter.go; the verify output showed only FAIL because the filter keeps no compiler lines. 22.33.1297 attempt 2 (18:36Z) showed three FAIL lines and no assertion text because the go test -v output prints a case's messages before its FAIL line and the filter printed the lines after it."
fix = "The filters of 22.33.1292, 22.33.755 and 22.33.1297 also keep compiler and test-file lines and print sixteen lines before each FAIL; the import is aliased in 1292."

[gotcha.3023]
title = "The Go platform SDK module has two environment-dependent probes that fail inside a package-wide gate"
symptom = "22.31.486 attempt 1 (2026-11-04 17:49Z) ran go test over the whole sdk/platform/go module: TestAgentOperationEnvelopeProcessCases wants a case file named by PAXEER_X_AGENT_ENVELOPE_CASE and TestProgramTerminalV5HistoricalCodecCorpus wants a signed native terminal corpus; both are unrelated to the committed vector and fail in any clean environment. The re-recorded vector also invalidated the consumer fixture sdk/platform/go/testdata/repair_m1384/checkpoint.json pinned by three portable-receipt tests."
fix = "The gate of 22.31.486 names the vector, inclusion, portable-receipt and conformance tests and the conformance command package; the two probes are a closure-sweep finding; the checkpoint fixture is re-captured in the same change."

[gotcha.3024]
title = "The committed receipt corpus carries no preexecution refusal"
symptom = "tools/qualification/paxeer-x/native-terminal-outcome.py requires a terminal-0 case with status 0, empty return data, no logs and a kernel error, and 22.33.877 attempt 1 (2026-11-04 17:40Z) served V2-layerxledger-revert for it: a post-execution revert with revert data, which the production check refuses. sdk/platform/conformance/fixtures/sequencer-receipt-v1.json has transfer, approve, pay-exact, bridge-out, program-call, ledger-revert and refusal cases and nothing refused before execution."
fix = "Decision 2537: 22.31.491 adds the committed preexecution refusal V2-pax-transfer-insufficient-funds to the generator and the corpus; 22.33.877 proves terminal-0 against it."

[gotcha.3025]
title = "Two receipt digest definitions are live in the TypeScript payment path"
symptom = "After 22.33.1400 (2026-11-04 16:05Z) the seller middleware emits and checks receiptDigest as the receipt-signature digest the SDK verifier returns, while the buyer middleware (src/index.ts line 374), the agent middleware (src/index.ts lines 896 and 1037, src/daemon.ts line 241), the conformance package (src/receipts.ts line 197) and the Express and Next route checks (keccak of the canonical receipt bytes) still derive it as keccak-256 of the signed receipt. 22.33.619 attempt 10 (17:00Z) failed with receipt-not-backed at the Next route for the committed pay-exact vector that attempt 9 had passed before 1400 landed."
fix = "Decision 2538: the receipt-signature digest is the one definition (docs/site/docs/interop/portable-receipts.md); 22.31.492 aligns the middleware family and 22.31.493 the route integrations, each proven across the real buyer, seller and route path."

[gotcha.3026]
title = "The Rust SDK never binds the submitted signed transaction to the verified receipt"
symptom = "VerifiedRpcReceipt in services/agent/crates/layerx-sdk/src/rpc_verification.rs has canonical_activity and batch_evidence fields that every constructor leaves None and a binder nobody calls; Wallet::send in wallet.rs discards the raw signed transaction after execute returns its hash. 22.33.1569 attempt 3 (2026-11-04 18:30Z) failed the funded Send scenario on exactly that: the scenario needs the exact submitted transaction and the inclusion material behind a receipted verification."
fix = "Decision 2539 and task 22.31.494: the wallet execution path binds the raw signed transaction and the inclusion-verified path retains its proof material; 22.33.1569 requalifies after it."

[gotcha.3027]
title = "Every declared path must carry a change when the task is marked done"
symptom = "22.33.435 attempt 4 (2026-11-04 18:40Z) passed ten of ten tests and failed ten graph checks: seven capture files and the task record are in the paths but the attempt never wrote them; 22.33.560 attempt 6 and 22.33.1244 attempt 3 failed one graph check each on an unwritten task record."
fix = "A declared path is a commitment: the attempt writes it or the ruling removes it. The three tasks continue and write the files; a widening lists only files an attempt did or must change."

[gotcha.3028]
title = "The approval service refuses every awaiting hold with ClockRequired"
symptom = "services/agent/crates/layerx-agentd/src/approval/mod.rs ApprovalService::list, get, approve and reject take a current sequence and no time, and reach the policy's validate_for_read in policy/approval.rs with no clock, which refuses with ClockRequired after reserve_and_hold_at has succeeded. 22.33.44 attempt 4 (2026-11-04 18:40Z) hit it in seven of fifteen human-service cases that drive the real service."
fix = "Task 22.31.495 threads explicit time through the four service entry points into the timed policy functions; 22.33.44 requalifies after it."

[gotcha.3029]
title = "The current key-rotation lifecycle payload is refused by the disclosure binder and by the auth module"
symptom = "layerx_intents::compile turns a KeyRotation intent into a 92-byte lifecycle payload with tag bytes 0x71 0x02 and four fields (owner digest, pending key, challenge bounds, effective sequence) under activity type governance/2. services/agent/crates/layerx-crypto/src/disclosure/call.rs binds recordLifecycle payloads only with tag byte 1 or 3 in four fixed shapes and refuses the rotation as MalformedPayload, and modules/layerxauth/keeper/lifecycle.go refuses any payload whose second byte is not 1 or 3 as non-canonical. 22.33.44 attempt 4 of the human service (2026-11-04 18:50Z) failed both rotation cases on the binder before custody."
fix = "Decision 2540 and task 22.31.496: the binder and the module admit the compiler's rotation payload and forward it as activity type 0x00070002; 22.33.63 requalifies after it."

[gotcha.3030]
title = "22.33.593's paths named a crate directory that does not exist"
symptom = "The task's paths placed services/mod.rs, verification_metrics.rs, vyper_verifier.rs, the task record and the test under services/explorer/services/smart-contract-verifier/smart-contract-verifier/src/services, a directory the library crate does not have; the attempts wrote them under the server crate's src/services and were refused twice as outside the paths (attempt 2 at 2026-11-04 18:46Z)."
fix = "The paths are replaced with the attempt-2 change set under the server crate plus the four files it wrote outside; a repair task's paths are checked against the tree before they are written (gotcha 3021)."

[gotcha.3031]
title = "A requalify started from an attempt whose result dropped files runs without them"
symptom = "22.33.810 attempt 3 passed every gate with native_evidence.py, the native EVM fixture and the task record in its tree, but the result recorded them as outside the paths and dropped them (gotcha 3020); attempt 4, requalified from that result, failed at collection on the missing module (2026-11-04 18:47Z). 22.33.449 attempt 3, requalified from attempt 2, carried only the spec file because attempt 2's result had dropped media-type.ts (18:49Z)."
fix = "A requalify names an attempt whose recorded tree holds every file, or the ruling continues and re-creates the dropped files; the rulings of this batch do the latter for 810 and start 449 from attempt 1, which holds the file."

[gotcha.3032]
title = "The gate of 22.33.18 ran the whole Python integration suite"
symptom = "22.33.18 attempt 1 (2026-11-04 19:05Z) verified with the Makefile target that runs every test under tests/ci: 201 cases, eleven failures, of which eight belong to other work (two agent codec corpus cases, the cw20 deploy-script check, two retired-use kernel suite checks and 22.33.727's retained EIP-1559 case) and three are the task's own cases."
fix = "The verify is narrowed to the task's test file and the five SDK test files in its paths; the eight unrelated failures are a closure-sweep finding, not re-run here."

[gotcha.3033]
title = "The authority budget-state change of 22.31.208 broke two daemon test targets that include it by path"
symptom = "22.31.208 (on main 2026-11-04 18:41Z) made services/platform/hosted/authority/src/human/budget_state.rs and its native.rs reference crate::committed, crate::loopback_http, super::Human, super::Policy and a human field on Config. services/agent/crates/layerx-agentd/tests/human_approval_budget_actor.rs and human_projection_facts.rs include that module with a path attribute over a small shim and no longer compile (E0432, E0433, E0425, E0422, E0609). Every dependent-crate check that builds the daemon tests has failed since: 22.31.212 attempt 6, 22.33.1544 attempt 2, 217 attempt 3, 218 attempt 4, 222 attempt 3, 224 attempt 3, 233 attempt 3, 1547 attempt 2, 249 attempt 2 and 261 attempt 2 between 19:10Z and 19:24Z."
fix = "Decision 2541 and task 22.31.497 restore both targets against the current authority source; the ten attempts requalify after it."

[gotcha.3034]
title = "22.33.1545 removed two fields of ObservedBlockContext that a published consumer test constructs"
symptom = "Attempt 2 of 22.33.1545 (2026-11-04 19:19Z) rebuilt services/agent/crates/layerx-client ObservedBlockContext without sealed_batch and finalised_checkpoint; services/agent/crates/layerx-agent-api/tests/repair_22_31_485.rs, on main since 18:40Z, constructs the struct with both fields and the dependent-crate check failed with two E0560 errors."
fix = "The consumer test joins the task's paths and the attempt continues porting it in the same change (decision 2521 class: an interface change carries its consumers)."

[gotcha.3035]
title = "A protected store root in a test must be created private and canonical"
symptom = "The daemon store refuses any root whose mode is not exactly 0700, whose owner is not the process or whose path is not canonical (services/agent/crates/layerx-agentd/src/store/protected.rs validate). 22.33.1535 attempt 2 (2026-11-04 19:11Z) created its roots with the default directory mode under the temporary directory and two cases failed on 'store root is not a canonical owned private directory'."
fix = "Tests create store roots with mode 0o700 and open the canonicalised path, as the daemon's own store tests do."

[gotcha.3036]
title = "The outbox hands out bytes for transmission only while a submission is Queued"
symptom = "services/agent/crates/layerx-agentd/src/outbox/mod.rs bytes_for_transmission returns NotQueued once a submission has left Queued. 22.33.1571 attempt 2 (2026-11-04 19:13Z) restored a submission recorded Unknown after a lost response and asked for its bytes to re-send it; both node-recovery cases failed on NotQueued."
fix = "Recovery of an unknown submission goes through the resolver (admin resolve_unknown or the degraded resolver) that looks the hash up on the node first; tests follow that path."

[gotcha.3037]
title = "The explorer's transaction tag lookup crashes on a transaction without a recipient"
symptom = "services/explorer/backend/apps/block_scout_web/lib/block_scout_web/controllers/account/api/v2/tags_controller.ex tags_transaction passes transaction.to_address_hash to GetAddressTags.get_public_tags, whose only clause requires a non-nil hash; a contract-creation transaction has none, so GET /api/account/v2/tags/transaction/:hash answers 500 with a FunctionClauseError. 22.33.478 attempt 2 (2026-11-04 19:18Z) hit it with the recorded transaction example; 7 of 8 cases passed."
fix = "Decision 2542 and the 478 ruling: the controller answers the sender's public tags and an empty recipient side for such a transaction; the controller joins the task's paths."

[gotcha.3038]
title = "22.33.517 tightened the archive receipt types without their explorer consumers"
symptom = "Attempt 2 of 22.33.517 (2026-11-04 19:27Z) made payload_hash required and block_number nullable in apps/explorer/types/api/paxeerXArchive.ts; the explorer type-check then failed with fifteen errors in ten consumer files under ui/paxeerX/receipts, ui/pages, stubs and lib/api/services, none of them in the task's four paths, and the verify never ran."
fix = "The ten consumer files join the task's paths and the attempt continues porting them in the same change (decision 2521 class)."

[gotcha.3039]
title = "Unknown-submission fixtures still serve the single-step receipt lookup"
symptom = "The client's authenticated lookup asks pax_sequencerReceipt and then eth_getTransactionReceipt (services/agent/crates/layerx-client/src/rpc/receipt.rs, tolerant of a failing second call since 22.31.222). The loopback nodes of services/agent/crates/layerx-agentd/tests/unknown_receipt_lookup.rs assert one method per exchange, so the second request tripped the fixture and the client saw a malformed answer; 22.33.1538 attempt 2 (2026-11-04 19:26Z) failed 8 of 22 cases this way or on the resulting state."
fix = "The fixtures serve the current exchange sequence; a case that still resolves a receipt with a missing or changed payment denomination is a resolver finding to record."

[gotcha.3040]
title = "A declared runtime module the scripts call was never written"
symptom = "22.33.761 attempt 3 (2026-11-04 19:27Z) rewrote the upgrade-module shell scripts to exec tests/integration/upgrade_module/scripts/upgrade_runtime.py and made its test import that module, but the module is neither in the change set nor in the attempt's recorded tree; the verify failed at collection."
fix = "The attempt continues and writes the declared module; a path a change calls must be in the change."

[gotcha.3041]
title = "A recorded creation bytecode and its recorded metadata JSON came from two different compiler runs"
symptom = "22.33.750 attempt 2 (2026-11-04 19:3xZ) asserted that the CBOR trailer of the recorded SimpleAccount7702 creation bytecode names the sha256 of the recorded metadata string; the trailer hash 6792d629... matches neither the sha256 of the recorded string with its escaped dash (bcc28015...) nor with the dash as UTF-8 (ad6d4637...), so the two recordings are not one compiler output. The assertion is correct and caught the mismatch."
fix = "22.33.750 re-records creation bytecode and metadata byte-exact from one solc 0.8.28 cancun optimizer-200 run of the final source at implementation time and keeps the trailer and source-keccak assertions; any recorded compiler pair is produced by one run and checked against itself."

[gotcha.3042]
title = "A test fixture destructor that panics turns one failed case into a process abort that hides every failure report"
symptom = "22.33.1336 attempt 6 and 22.31.497 attempt 1 (2026-11-04) each lost their failure report: one case panicked, the fixture's Drop then panicked as well (a join asserted clean, a thread already down), the test binary aborted with SIGABRT and the harness never printed the per-case stdout or the failures list, so only the two panic lines remained in the log."
fix = "Fixture destructors are best-effort: a Drop never asserts or unwraps; the test body asserts the clean stop it needs. 22.33.1336 attempt 7 and 22.31.497 attempt 2 apply this before anything else so their real reports appear."

[gotcha.3043]
title = "The repository's own CI python suite carries assertions behind interfaces that later tasks retired or moved"
symptom = "On main at 2026-11-04 19:00Z eight cases of tests/ci fail for reasons unrelated to any one task: the agent codec corpus test posts to a /rpc path the SDK now refuses (decision 2521); tests/vectors/codec/generate.py raises because the retired budget-pull type is no longer undeclared; the cw20 deploy-script check greps a shell script that now delegates to the Go load-test binary, whose deploy operation still stores the four retired contracts; the retired-reference check flags the weak-symbol absence test and the interface table row that name the retired bridge-credit symbol; and the kernel audit case audit_genesis_historical_import_hashes fails with LXP_ERR_ROOT_MISMATCH."
fix = "Tasks 22.31.498 to 22.31.502 repair each case from its producer with its own pytest or make target as the verify; an aggregate python gate stays out of task-level qualification (gotcha 3032)."

[gotcha.3044]
title = "Test files placed under the explorer pages directory compile as routes and break the frontend image"
symptom = "Three audit repairs (22.33.448, 22.33.450, 22.33.451) placed vitest spec files and .kvx records under apps/explorer/pages (pages/api/repair-22-33-448.spec.ts, pages/api/monitoring/repair-22-33-450.spec.ts, pages/apps/repair-22-33-451.spec.ts and their records). next build compiles every file under pages as a route, so node-fetch and fetch-blob entered the client bundle and the production build failed with UnhandledSchemeError reading node:buffer, node:events, node:fs, node:http and node:https. The repository's explorer image build has failed on every main revision since 2026-11-04 18:48Z (last green c734cc91b3 at 16:08Z); the task gates ran only vitest, which never exercised next build."
fix = "22.31.503 moves the three specs and records out of pages, adds a guard that refuses test and record files under pages (decision 2544), and runs the production next build as its build gate, so the consumer the records broke is part of the proof."

[gotcha.3045]
title = "The C test environment has no pytest and the generated python gate was an aggregate"
symptom = "22.33.891 attempt 1 and 22.33.892 attempt 1 (2026-11-04 19:31Z) carried the generated verify make -s test-tests-python, which runs the whole python suite of the repository (an aggregate gate, gotcha 3032 class). 892 failed with No module named pytest before any case ran; 891 ran 120 cases and its six failures were the stale repository cases of gotcha 3043, none inside its paths. Neither attempt executed the C test binaries it had changed."
fix = "Both tasks continue with narrowed gates: the build installs pytest when it is missing and builds the test binaries of the paths; the verify runs those binaries and the one python file of the paths. A generated gate names the task's own targets, never a suite of the repository."

[gotcha.3046]
title = "A consumer test asserted scenario names its producer never registered, and the producer left the driver unwired"
symptom = "22.33.889 attempt 2 (2026-11-04 20:22Z) failed its only remaining case because tools/release/tests/test_programme.py asserted that programme.py registers check_kernel_transaction_commit, check_native_program_lifecycle and check_kernel_restart_recovery, names the test invented while 22.33.893 was pending. 22.33.893 landed five merged scenarios under its own names (check_merged_transaction, check_current_guest_deployment, check_native_xweb, check_tenant_isolation, check_persisted_restart) in the CHECKS registry, and tools/release/rehearse-v6120.sh still wires only the sixteen earlier checks (lines 525-540)."
fix = "889 continues: its test asserts the five registered names, and it wires the five driver functions in rehearse-v6120.sh, which joins its paths. A test that depends on another task's future interface asserts the names that task records, never names of its own."

[gotcha.3047]
title = "Gateway unit tests run inside every repair test binary and two of them are broken on main"
symptom = "services/platform/hosted/gateway test files begin by including src/main.rs, so every unit test of the gateway binary runs in each repair test binary. 22.33.1336 attempt 7 (2026-11-04 20:18Z) passed 150 cases and failed 6; two of the failures are unit tests broken on main by other tasks: explorer_proxy::tests::explorer_query_and_finite_routes asserts 142 routes while the table holds 145 since 22.31.380 and 22.31.382 added routes, and capabilities::tests::capabilities_schema_declares_every_surface asserts two sentences of the openrpc.json description that the 22.33.1443 rewrite dropped."
fix = "22.31.504 repairs the two unit tests; repair verifies of the gateway skip them by name until it lands and record the finding (decision 2545)."

[gotcha.3048]
title = "Two repair tasks required each other"
symptom = "22.31.495 (explicit time through the approval service) required 22.31.497 because its build compiled every daemon test target and the two targets 22.31.497 restores did not compile (gotcha 3033); 22.31.497 attempt 2 (2026-11-04 20:18Z) restored both targets but its last case reads an awaiting hold through ApprovalService::get, which refuses with ClockRequired until 22.31.495 threads the clock. Neither task could finish first."
fix = "Decision 2547: 22.31.495 builds and tests only its own targets and no longer requires 22.31.497; 22.31.497 requires 22.31.495 and passes the runtime time into the service read."

[gotcha.3049]
title = "A generated codec corpus was committed by the task that fixed its generator"
symptom = "22.31.499 committed tests/vectors/codec/replay_corpus.lxb (the output of tests/vectors/codec/generate.py) although the file was not in its paths; 22.31.498 attempt 2 (2026-11-04 20:37Z) then failed its clean-checkout case, which archives HEAD and asserts the corpus is absent before the make target prepares it."
fix = "Decision 2546: the corpus is generated and stays out of the tree; 22.31.498 removes the committed file and ignores it in tests/vectors/codec/.gitignore."

[gotcha.3050]
title = "A package-wide verify met producer changes landed in the same package"
symptom = "22.99.148 attempt 3 (2026-11-04 20:27Z) repaired its own three cases, then the package test run of services/agent/sdk/typescript failed four unrelated cases: the px test asserts the package test script names the ai-market test, but 22.9.10 (cb50180548) routed the script through scripts/run-tests.mjs; two web-search repair tests construct WebSearchClient without receipt keys, which the same commit made mandatory; and the gas-station proof imports sdk/wallet/src/modules/gas-station.ts, whose viem dependency the agent package install does not provide."
fix = "The package sweep task owns the package: its tests follow the current contracts (the runner selection list, mandatory receipt keys) and its build installs the wallet package with pnpm before the agent package."

[gotcha.3051]
title = "22.33.1138 made lx_account_open refuse the system reserve and withdrawals accounts the kernel still uses"
symptom = "src/ledger/lx_account_registry.c (commit b7a6627243, 2026-11-04 19:10Z, task 22.33.1138) returns LXP_ERR_UNAUTHORIZED_DEBIT for every name of kind LX_ACCOUNT_SYSTEM_PAXEER_RESERVE or LX_ACCOUNT_SYSTEM_PAXEER_WITHDRAWALS before the index lookup, on the audit premise (findings 22.30.5.27 and 22.30.5.28) that these are retired custody accounts. The live kernel contradicts the premise: lxp_genesis.c refuses a manifest without the fees, reserve and withdrawals accounts, the bridge withdraw path (src/modules/bridge/lxp_bridge_withdraw.c) and lxp_module_ctx.c target the withdrawals account, and lx_asset_account_open (src/modules/asset/lx_asset_state.c) routes through lx_account_open. The fixtures of tests/modules/test_asset_withdraw.c, the withdrawal routing case of tests/modules/test_asset_registry.c, tests/test_bridge_withdraw.c and tests/test_reserve_reconcile.c open these accounts under GENESIS authority and fail since that commit; 22.33.1236 attempts 3 and 4, 22.33.891 attempt 2 and 22.33.892 attempt 2 failed on it, and the batch-446 instruction to 22.33.1236 to reorder its opens addressed a symptom."
fix = "22.31.505 restores the admission rule that held before 1138 (decision 2548): module-value names refused unconditionally, system names refused under CREDIT authority and admitted under GENESIS and GOVERNANCE; 1236, 891 and 892 wait for it and re-run their gates before any repair."

[gotcha.3052]
title = "The Wallet Go tests workflow has never passed on main: no pnpm for the ceremony suite and two attestor cases"
symptom = "Every run of .github/workflows/wallet-go-test.yml on main in the last 200 runs failed. The Ceremony job runs go test in services/wallet/ceremony, whose internal/testsupport/postgres.go runs pnpm install --frozen-lockfile and pnpm exec tsx in the wallet package found above the test directory, but the job installs only Go: five rehearsal cases fail with pnpm not found. The Attestor job fails TestSnapshotFollowsAddShare (services/wallet/attestor/internal/server/server_test.go line 843: node-1 holds 1 snapshot after keys.addshare, want 2) and TestDescribeReturnsPublicMaterialToTheOperator (line 968: the refreshed generated-evm fields differ from the expected public material)."
fix = "22.31.506 provisions Node and the pinned pnpm in the Ceremony job the way platform.yml does and repairs the two attestor cases against the real server (decision 2550); the first green run of the workflow on main is the proof it records."

[gotcha.3053]
title = "The launchpad service images stopped building: a go directive above the pinned toolchain and stale module graphs behind a moved replace target"
symptom = "Publish off-chain images (.github/workflows/offchain-images.yml) has been red on main since 2026-11-04 01:51Z. deploy/launchpad/Dockerfile.svc builds with golang:1.26.4 under GOTOOLCHAIN=local and checks that go mod download and go mod verify leave go.mod and go.sum unchanged. services/launchpad/api/go.mod declares go 1.27.0 since 22.31.453 (c22a03aa47), so the api image refuses to build (go.mod requires go >= 1.27.0); services/launchpad/notifications/go.mod declares the same since 22.33.958. In indexer, ranking-algo, the stats module, social and user the download step rewrites go.mod and go.sum, because sdk/launchpad/shared, which they take through a replace directive, moved its requirement set in the same commit (go-ethereum 1.17.4, pion dtls v3, stun v3, transport v4) while their own graphs were not regenerated; the 453 gate built each module with the go of the qualification environment and never ran the image step. Six of fifteen images fail on every push."
fix = "22.31.507 brings every launchpad go directive back under the pinned toolchain and regenerates the six module graphs; its verify runs the Dockerfile step per module under GOTOOLCHAIN=go1.26.4 (decision 2549)."

[gotcha.3054]
title = "A process-global rate limiter is shared by every gateway unit test carried into one repair binary"
symptom = "22.33.1336 attempt 8 (2026-11-04 21:03Z): history::tests::unified_history_answer_reads_the_paxeer_node_over_http, a gateway unit test included into the repair binary (gotcha 3047), failed with -32001 public_read_rate_limit while it passes in every other binary; the public read rate limiter is process-global and the sibling tests of that binary exhaust it first."
fix = "A repair binary skips a carried unit test that depends on process-global state its siblings exhaust; the test keeps running in the gateway's own binary."

[gotcha.3055]
title = "22.33.1501 made the wallet surface read the web-data payment availability and the surface test double does not answer it"
symptom = "a4710dac6e (22.33.1501, 2026-11-04 12:35Z) changed apps/wallet/src/surfaces/useSurface.ts and sdk/wallet/src/modules/web-data.ts after 22.33.205 published at 06:32Z: readGrantCaps now calls paymentAvailability (the module's getParams read at the web-data module address) and the GrantChain double in apps/wallet/src/surfaces/test/chain.tsx throws 'no contract answers' for it; three cases of apps/wallet/src/surfaces/repair-22-33-205.test.ts are red on main and failed 22.31.486 attempt 3 at 20:46Z."
fix = "22.31.508 teaches the double the producer's call; a change that adds a chain read to a surface updates the surface's test doubles in the same change (decision 2554)."

[gotcha.3056]
title = "The buyer middleware confirms only named payees, and the V4 committed recording pays an asset account"
symptom = "22.31.492 attempt 3 (2026-11-04 21:03Z): the buyer's prepare checks that the offer's account name hashes under the legacy or native account-id domain to payTo; the V4 recording's payee is ledgerkeeper.AccountID(did, asset), an asset account with no name, so a committed offer carrying that payTo is refused requirements-mismatch at the payee check."
fix = "The committed-rung regression pays the named V1 payee (decision 2552); whether an offer must be able to name an asset-account payee (a DID and an asset) is recorded as an open question for the owner."

[gotcha.3057]
title = "Threading time through the approval service has consumers in two other crates"
symptom = "22.31.495 attempt 2 (2026-11-04 21:07Z): the dependent-crate check compiled services/agent/crates/layerx-mcp/src/catalogue.rs (line 813, E0061: the approval call now takes a time argument) and the layerx-human-service repair test services/human/crates/layerx-human-service/tests/repair_22_33_61.rs (lines 510 and 538, E0063: DecisionRequest initialisers without current_time) against the new interface and stopped before the verify."
fix = "Both consumers join the task's paths and it fixes them; an interface change lists its consumers in its paths before it launches."

[gotcha.3058]
title = "The wallet gateway send path times out against the in-process database socket server"
symptom = "22.33.208 attempt 3 (2026-11-04 21:07Z): with the database opened through the in-process engine's socket server (ten connections) by test/support/node-receipts.ts and the gateway pool at its default size, the send route answered 500 send_failed, connection terminated due to connection timeout, while two other cases of the same file passed against the same database."
fix = "The test sets DATABASE_POOL_MAX to 1 before the pool opens; a path that needs two connections at once is a defect the task names."

[gotcha.3059]
title = "The Python SDK web-search receipt digest is a third digest definition"
symptom = "22.33.18 attempt 2 (2026-11-04 21:40Z): services/agent/sdk/python/layerx_sdk/web_search.py line 395 computes receiptDigest as SHA-256 over the merkle-leaf domain and the signed receipt bytes, pinned by its own test at tests/test_web_search_sequencer.py line 55; the web-search server compares the canonical receipt digest (decision 1103) and the portable receipt digest is the signature digest (decision 2538); the replayed exact exchange of tests/ci/test_repair_22_33_18.py differed from the recording only in receiptDigest."
fix = "22.31.510 moves the SDK to the digest its own verifier returns and re-checks the recording; 22.33.18 waits for it."

[gotcha.3060]
title = "The V1 pay-exact receipt vector is synthetic and carries no committed inclusion material"
symptom = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json (case V1-layerxledger-pay-exact) is generated by rpc/sequencer_receipt_vectors_test.go from hand-built transaction logs; it has no recorded batch transaction, transaction proof or result proof, which services/agent/sdk/typescript/src/committed-proof.ts verifyReceiptInclusion requires for the committed rung. 22.31.492 attempt 4 (2026-11-04 22:03Z) stopped on that missing field as its instructions said."
fix = "Committed-rung evidence comes only from the node recorder in daemon/committed-fixture; decision 2555 replaces the V1 direction of decision 2552."

[gotcha.3061]
title = "x402 offers name the payee's main account while production asset payments settle into the asset sub-account"
symptom = "The offer field extra.layerx.account carries agent:<did>:main and services/platform/middleware/buyer/src/index.ts accountNamesPayTo refuses any payTo that is not that name's identifier. Production asset payments land in the DID's asset sub-account (modules/lxphost/accountmap.go AssetAccountID, name agent:<did>:asset:<asset hex>); the main account holds the native asset only (services/human/crates/layerx-human-service/src/agents/create_native.rs funds the main account with the native asset and the budget asset into the sub-account). Every production asset offer is therefore refused as requirements-mismatch, and the committed recordings carry no payee identity, so no consumer test could build a matching offer (the open question of gotcha 3056)."
fix = "Decision 2555: the buyer accepts the main account identifier or the DID's asset sub-account identifier for the offer's asset; 22.31.511 records vector V7 with the parties in its provenance; 22.31.492 follows it."

[gotcha.3062]
title = "The grant-caps surface reports the retired state while its discovery cases assert coverage states"
symptom = "22.33.1501 (a4710dac6e) made readGrantCaps in apps/wallet/src/surfaces/useSurface.ts return state retired with the web-data payment availability after DID binding; three cases of apps/wallet/src/surfaces/repair-22-33-205.test.ts still assert the incomplete and empty discovery states. 22.31.508 attempt 1 (2026-11-04 22:08Z) fixed the double (34 of 37 cases pass) and the three failed on the contract."
fix = "Decision 2556: the three cases follow the retired contract; the test file joins the task's paths."

[gotcha.3063]
title = "Program mutations of the Python agent transport moved to the node root without their consumer test"
symptom = "22.33.16 (6683a9d260, 2026-11-04 15:48Z) routed program mutations and hash reads of services/agent/sdk/python/layerx_sdk/agent_http.py to the node root as JSON-RPC (eth_sendRawTransaction and pax_sequencerReceipt with application/json) and did not run tests/agent/sdk/python/test_repair_22_31_147.py, whose twelve lifecycle cases still expect the octet-stream agent route; 22.31.510 attempt 1 (2026-11-04 22:08Z) passed its own seven cases and failed on those twelve."
fix = "Decision 2557: the 147 cases follow the node-root contract; 22.31.510 realigns them and the file joins its paths."

[gotcha.3064]
title = "A path list naming the bare tests directory waits on every test change"
symptom = "22.33.1135 and 22.33.1136 declared tests as a path next to their kernel source file; the admission check treats every task changing any file under tests/ as an overlap, so both stayed eligible but unlaunched for hours."
fix = "Their paths now name the source file alone, with tests/codec and tests/ledger as planned paths."

[gotcha.3065]
title = "The JSON codec of sdk/codec names its methods MarshalAsJSON and UnmarshalAsJSON"
symptom = "sdk/codec/codec.go lines 60 and 73 declare MarshalAsJSON(proto.Message) and UnmarshalAsJSON([]byte, proto.Message) on the JSONCodec interface; the upstream names MarshalJSON and UnmarshalJSON do not exist on codec.Codec. 22.31.509 attempt 1 (2026-11-04 22:21Z) compiled its recorder and mirrored the V6 vector, then its test called encoding.Marshaler.MarshalJSON and UnmarshalJSON and the verify failed to compile."
fix = "Tests that encode a module genesis through the production encoder call MarshalAsJSON and UnmarshalAsJSON (or MustMarshalJSON); 22.31.509 continues with that fix."

[gotcha.3066]
title = "A genesis manifest without guarantors is canonical only under the state-commitment protocol version"
symptom = "src/protocol/lxp_genesis.c validate (line 550) refuses a manifest whose protocol_version is not LXP_PROTOCOL_VERSION_STATE_COMMITMENT and whose guarantor_count is zero with LXP_ERR_NON_CANONICAL before the fee-authority parameter check that yields LXP_ERR_VERSION_UNSUPPORTED (line 571). 22.33.891 attempt 3 (2026-11-04 22:03Z) set the fixture's guarantor_count to zero for the merged node initialization and kept the allowance-policy case that expects an occupancy-version copy of that manifest to be refused LXP_ERR_VERSION_UNSUPPORTED; the kernel answered LXP_ERR_NON_CANONICAL."
fix = "A version-downgrade case on a zero-guarantor manifest asserts LXP_ERR_NON_CANONICAL, or it downgrades a manifest that carries guarantors to reach the version refusal; 22.33.891 continues with the assertion aligned to the kernel contract."

[gotcha.3067]
title = "A test support file cannot path-include another service's source module"
symptom = "22.33.1510 attempt 2 (2026-11-04 22:05Z) added a module in services/human/crates/layerx-human-service/tests/support/approval_owner.rs with a path attribute pointing at services/platform/hosted/authority/src/human; the authority's budget_state module imports crate::committed and crate::loopback_http and refers to super::Human, super::Policy and Config.human, none of which exist in the Human service's test crate, so the build failed with seven unresolved names (the class of gotchas 3033 and 3047). The Human service's budget-state input is written by the agent daemon (layerx_agentd::human_runtime, a dependency of the service crate since 22.31.462), not by the platform authority."
fix = "Integration tests consume a producer through its crate dependency or a recorded transcript, never through a path-included copy of its source; 22.33.1510 continues with the module removed and the daemon library as the producer (decision 2558)."

[gotcha.3068]
title = "A finding recorded without a continuation note re-qualifies the attempt's last tree unchanged"
symptom = "22.33.1236 attempt 5 and 22.33.891 attempt 3 (2026-11-04 22:03Z) ran after 22.31.505 landed as pure re-qualifications of the parked trees: no agent read the do items written for them in batches 448 and 449, so the instructions to restore the main fixture shape in tests/modules/test_asset_withdraw.c and to report the escrow outcome code were never carried out and both attempts failed on the unchanged trees."
fix = "A ruling whose do items need edits carries a continuation note; a finding alone only re-runs the gates on the parked tree. 22.33.1236 and 22.33.891 continue with their outstanding do items restated."

[gotcha.3069]
title = "The explorer frontend production build has been red since 35e7244d4 because node-fetch reaches a client or edge compile"
symptom = "The Explorer / Images workflow last passed at c734cc91b (2026-11-04 16:08Z) and has failed on every commit since 35e7244d4 (20:40Z): next build reports five UnhandledSchemeError modules (node:buffer, node:events, node:fs, node:http, node:https) imported through node_modules/node-fetch/src/index.js, which is only valid in the Node server compile. The import trace in the workflow log stops at node-fetch itself; the module that drags it into a client or edge graph is one of the apps/explorer files changed between the two commits (pages/api/proxy.ts, pages/apps/[id].tsx, nextjs/utils/fetchApi.ts, nextjs/utils/fetchProxy.ts, instrumentation.node.ts and the ui and toolkit files of 22.33.451 and 22.33.423 among them). The type-check gates of the explorer repairs do not run next build, so none of them saw the break."
fix = "22.31.512 restores the production build and adds a static import check that keeps node-fetch in server-only modules; a repair that changes the explorer page graph runs next build, not only the type-check."

[gotcha.3070]
title = "The Wallet Go tests workflow has a second failure layer behind the pnpm repair of 22.31.506"
symptom = "After 22.31.506 the workflow (run 41921062931 on f3efea604, 2026-11-04 21:58Z) still fails in both jobs: the Attestor job has no Node or pnpm step although proof_s28_wallet_attestors_tss_test.go runs pnpm exec in services/wallet/gateway, the native purpose cases of internal/server require prebuilt Rust custody consumers through PAXEER_X_NATIVE_CUSTODY_RUST_TEST and PAXEER_X_NATIVE_SEND_RUST_TEST that nothing exports, the attestor policy copy abi/xweb.json differs from precompiles/xweb/abi.json again (22.31.130 refreshed the producer at 00:37Z), the loadtest owner-token case reports three timeouts, the ceremony client encoding differs from its golden for keys.import.request, the move tool drops funded_tiers, layerx_accounts and whitelist_entries because its table list is static, deliver ends in ErrJournal, rehearsal ends in ErrIdentityRecovery, and the gateway envelope script exits 243 without its stderr in the failure."
fix = "22.31.513 provisions the Attestor job like the Ceremony job, builds the Rust consumers in the workflow, regenerates the drifted copies from their producers and repairs the ceremony paths along the real plan, archive, deliver and rehearse flows; the first green workflow run is the recorded proof."

[gotcha.3071]
title = "The Python SDK transport suites have been red since the committed payment binding of 22.31.147 and nobody ran them"
symptom = "services/agent/sdk/python/tests/test_web_search_sequencer.py, test_x402_http_sequencer.py and test_sequencer_receipt.py fail on main (14 cases: 11, 2 and 1) since 5fe9f32adb (22.31.147, 2026-11-04 14:37Z) made x402.py line 220 refuse any payment whose transaction is not chain 125 to the ledger address with zero value, and x402_rpc.py line 69 refuse RPC hex without a 0x prefix; 2f25fe8391 (22.33.17) also changed x402_rpc.py. The suites load the synthetic V1 vector whose rawTransaction carries no 0x prefix, so every case ends in payment-binding-mismatch or invalid-rpc-hex. 22.31.147 and 22.33.17 verified only their own repair tests (rule 3046), and 22.31.510 attempt 2 was the first gate to run the suites."
fix = "22.31.514 reconciles the three suites with the production verifier against a recording the recorder made; 22.31.510 continues on top of it."

[gotcha.3072]
title = "Threading the decision time through the daemon approval service broke its consumer tests in the Human service and the MCP crate"
symptom = "9c3cd0e74d (22.31.495, 2026-11-04 22:07Z) added current_time to layerx_agentd approval DecisionRequest and a fourth TimestampSeconds argument to the approval service get. services/human/crates/layerx-human-service/tests/approvals.rs and tests/decide.rs and the MCP tests repair_22_33_1551.rs, session_tools_major_two.rs and support/session_transport.rs still build the old shape, so cargo build --tests of the Human service fails on main; 22.33.44 attempt 5 (a requalification without edits) failed on that build with none of its own files involved. The producer task's verify ran only daemon targets."
fix = "22.31.515 updates every consumer to the explicit decision time; 22.33.44 requalifies after it. A producer task that changes a shared type or signature runs the test targets of every in-repository consumer crate (decision 2560)."

[gotcha.3073]
title = "The native fixture of the module tests exhausts its arena at the second escrow open of the committed-iterator case"
symptom = "22.33.1236 attempt 6 passed every case of the seven binaries except tests/modules/test_escrow_invariants.c line 371: the native submission of the second LX_ESCROW_OPEN returned LXP_ERR_ARENA_EXHAUSTED (-905) where LXP_OK was expected. The fixture submits several native transactions through one arena without resetting it to its mark between submissions; the kernel resets the execution arena per transaction (src/protocol/lxp_kernel.c line 287)."
fix = "The attempt continues: the fixture resets its arena to the mark before each native submission the way the kernel does, or sizes it for the sequence; nothing under src or include changes."

[gotcha.3074]
title = "The daemon recovery refuses the budget state a recorded authority transcript serves, so the approval actor stays read-only"
symptom = "22.33.1510 attempt 3 moved the Human service integration fixture onto the agent daemon library with a recorded loopback authority transcript (tests/support/approval_fixture/authority.json served over a loopback TLS listener). The daemon's startup recovery logged recovery tenant=approval-actor-tenant failed: BudgetState with reason Unavailable (services/agent/crates/layerx-agentd/src/human_runtime.rs line 14521) and then read-only, so all three cases ended in a Refused decision; nothing in the Human service was at fault."
fix = "The attempt continues: the transcript carries the budget record the daemon recovery decodes exactly as the real authority emits it, or the fixture produces the budget state through the daemon library directly as decision 2558 allows; the Unavailable refusal (store lock or persisted record, human_runtime.rs line 748) is removed at its cause."

[gotcha.3075]
title = "Two daemon tests include the hosted authority's human module by path and broke when the authority grew"
symptom = "services/agent/crates/layerx-agentd/tests/human_approval_budget_actor.rs line 67 (22.9.39) and tests/human_projection_facts.rs line 454 (22.9.38) include services/platform/hosted/authority/src/human by path under a hand-written stand-in for the authority crate root. 22.31.208 (4a36a7f456, 2026-11-04 18:41Z) made budget_state.rs and budget_state/native.rs use crate::committed, crate::loopback_http, super::Human, super::Policy and a human field on Config, none of which the stand-in has, so cargo build --tests of layerx-agentd has been red since then; 22.34.5 attempt 1 failed on that build with none of its own files involved. The authority verify of 22.31.208 could not see it, and the two tests are not in the verify of any later task."
fix = "22.31.516 removes both path includes: the authority exports its human budget-state producer from its library target (layerx-platform-authority, which depends on layerx-client and not on the daemon) and the two daemon tests consume it as a dev-dependency. Gotcha 3067 named the class; decision 2564 closes it for the authority."

[gotcha.3076]
title = "The wallet gateway send route holds an open transaction while the rate limiter queries through the pool"
symptom = "services/wallet/gateway/src/routes/sign.ts takes a client from the pool (line 358), opens a transaction (line 362) and then awaits limiter.consume for the account scope (line 390), which runs its own query through the pool (src/audit.ts line 120). With one connection available the route deadlocks: 22.33.208 attempt 4 drove the real send path against the in-process single-connection engine and received 500 send_failed with a connection timeout after six seconds. In production the pool hides it until the pool is exhausted under load, when every send waits on a connection the sender itself holds. The audit class of 22.33.208 is runtime-risk; this is the risk."
fix = "22.31.517 moves every limiter consume and pool query out of the open transaction (or runs it on the transaction client) in sign.ts and audits the other routes for the same shape; 22.33.208 continues on top of it with the pool size pinned to one so the test proves the path."

[gotcha.3077]
title = "The daemon's own approval_semantics test still builds the pre-495 decision request, so every test build of layerx-agentd is red"
symptom = "22.31.495 (9c3cd0e74d) added current_time to the approval DecisionRequest and a fourth argument to the approval service get, and 22.31.515 repairs the Human service and MCP consumers (gotcha 3072); services/agent/crates/layerx-agentd/tests/approval_semantics.rs lines 171, 191, 245 and 269 still build DecisionRequest without current_time and line 298 still calls get with three arguments, so cargo build -p layerx-agentd --tests fails with four E0063 and one E0061 on main (22.31.497 attempt 3, exit 101), and every task whose build or verify compiles the daemon test targets (22.31.497, 22.31.516, 22.33.1550) fails before its own work is judged."
fix = "22.31.519 passes the explicit decision time at the five sites; 22.31.516 requires it and 22.31.497 continues after 516."

[gotcha.3078]
title = "The explorer type-check is red on main because the 22.33.270 test imports an undeclared package"
symptom = "apps/explorer/toolkit/components/forms/fields/repair-22-33-270.spec.ts line 4 imports ResizeObserver from @juggle/resize-observer and apps/explorer/package.json never declared it (22.33.270, 58d8e44429), so yarn tsc --noEmit -p tsconfig.json fails with TS2307 and every task whose build type-checks the explorer (22.31.512 attempt 1, exit 2) fails before its own work is judged."
fix = "22.31.512 attempt 2 replaces the import with a local stand-in class; a test never imports a package its application does not declare."

[gotcha.3079]
title = "pnpm 12 refuses the wallet workspace install because four dependency build scripts are undeclared"
symptom = "services/wallet/pnpm-workspace.yaml allows only the esbuild and sharp build scripts; under pnpm 12, the qualification environment's version, pnpm install --frozen-lockfile over the workspace ends with ERR_PNPM_IGNORED_BUILDS for @sentry/cli, bufferutil, keccak and utf-8-validate, so the ceremony move and rehearsal tests, whose fixture runs that install (services/wallet/ceremony/internal/testsupport/postgres.go line 230), fail in ten cases (22.31.513 attempt 1). The public workflow pins pnpm 9.15.9, which runs every script unasked, so the workflow never saw it."
fix = "22.31.520 declares the four scripts (decision 2567); 22.31.513 continues after it."

[gotcha.3080]
title = "The 22.31.147 lifecycle test still asserts the program route that 22.33.16 retired"
symptom = "tests/agent/sdk/python/test_repair_22_31_147.py test_lifecycle_transaction_binding_and_retained_http_bytes expects each lifecycle request as a POST with Content-Type application/octet-stream answered 202 unknown. Since 22.33.16 (6683a9d260) services/agent/sdk/python/layerx_sdk/agent_http.py sends program mutations to the node root as the eth_sendRawTransaction JSON-RPC call with Content-Type application/json and the Idempotency-Key header (lines 215 to 240) and reads receipts with pax_sequencerReceipt; the 22.33.16 record names this test as a consumer to migrate, yet nothing migrated it, so the case fails on main (22.31.514 attempt 1)."
fix = "22.31.514 attempt 2 rewrites the case to the node-root contract; a producer change lands with its named consumers (decision 2560)."

[gotcha.3081]
title = "Pre-creating a daemon store root with create_dir_all makes the store refuse to open"
symptom = "services/agent/crates/layerx-agentd/src/store/protected.rs validate accepts only a canonical directory owned by the process with mode 0700. A test that creates the root with fs::create_dir_all (mode 0755) and then opens ApprovalExpiry or Store on it gets the Store error (services/human/crates/layerx-human-service/tests/approvals.rs line 260, 22.31.515 attempt 1); tests/support/production_fixture.rs line 384 sets 0o700 for exactly that reason."
fix = "22.31.515 attempt 2 lets the store create the root or sets 0o700 first; a fixture never pre-creates a store root with default permissions."

[gotcha.3082]
title = "The re-recorded committed vector carries an absent vote with a null signature, and two recording consumers crash on it"
symptom = "22.31.486 (74ef78b42b) re-recorded sdk/platform/conformance/fixtures/vector-v4-committed.json under chain 125; positive.receiptInclusion.NextCommit.Signatures now holds a vote with BlockIDFlag 1 (absent) whose Signature is null, as CometBFT records it. apps/web/e2e/repair-22-33-338-commit.ts line 7 and services/platform/middleware/seller/test/committed-fixture.mjs line 9 decode every vote signature with Buffer.from(value, base64) and throw ERR_INVALID_ARG_TYPE (22.33.338 attempt 8, kit_separate_layerx_finality; 22.33.1478 attempt 8, the two committed cases). The production verifier skips flag 1 and flag 3 votes before it reads a signature (services/agent/sdk/typescript/src/verifier.ts line 674)."
fix = "Decision 2568: a recording consumer decodes a null vote signature as empty bytes and keeps the flag; 338 and 1478 continue with that fix."

[gotcha.3083]
title = "22.31.515 leaves two Human service test files on the signatures 22.31.495 retired"
symptom = "services/human/crates/layerx-human-service/tests/decide_nonces.rs (get at lines 375, 406, 599 and 627; DecisionRequest at lines 455 and 483) and tests/repair_22_31_159.rs (get at lines 103 and 278) still call the daemon approval service with three arguments and build DecisionRequest without current_time; 22.31.515 covers approvals.rs, decide.rs and the layerx-mcp tests only, so cargo build --tests for the Human service crate stays red on main after both land (22.33.1510 attempt 4, exit 101, eight errors)."
fix = "22.31.521 passes the decision time in both files; 22.33.1510 continues after 515 and 521. A signature change is traced through every test crate that calls it, not only the ones named by the first failure (decision 2560)."

[gotcha.3084]
title = "A receipted-rung node recording is verified without the predecessor check, so the sequence-hash refusal vector records"
symptom = "services/wallet/gateway/test/support/chain.ts recordSequencerReceipt (22.33.210 attempt 2, line 232) runs verifySequencerReceipt, which refuses an unpinned key, a height outside the key range, an activity id that is not the raw transaction hash and non-canonical bytes, but the chain of sequence hashes (R6) is checked only in the committed batch path (services/agent/sdk/typescript/src/verifier.ts line 787). The V3-seq-hash-mismatch case of sdk/platform/conformance/fixtures/sequencer-receipt-v1.json, whose receipt chains from a root other than its declared prevSeqHash, therefore records instead of throwing, and the refusal loop fails with promise resolved instead of rejecting (the vitest message argument does not name the id)."
fix = "The fixture compares the verified receipt's previousStateRoot with the recording's prevSeqHash before recording; each refusal id is asserted in its own case so the output names it."

[gotcha.3085]
title = "The 338 support fixture swallows the handler failure that makes the session load fail"
symptom = "apps/web/e2e/repair-22-33-338-support.ts catches every assertion its request handler raises into an errors array and answers 500, and the test asserts that array empty only after asserting the session load ready (repair-22-33-338.test.ts line 143), so the output reads 'failed' !== 'ready' and the refused header, path or body assertion never prints (22.33.338 attempts 7 and 8)."
fix = "The test asserts the errors array empty before the load state and puts the handler's message in the 500 body, so the next run names the cause."

[gotcha.3086]
title = "The explorer production build is red because the page type map lacks the chain routes"
symptom = "apps/explorer/lib/metadata/getPageOgType.ts line 5 types OG_TYPE_DICT as Record<Route['pathname'], OGPageType>, and 20.6.1 and 20.6.2 (8a48e23649, e6ae5134d5) added pages/chains/index.tsx and pages/chains/[id].tsx without an entry for either route. The committed route type apps/explorer/nextjs/nextjs-routes.d.ts predates those pages, so yarn tsc --noEmit passes, but NODE_ENV=production yarn next build regenerates the route type from pages/ and then fails the type check with '/chains' and '/chains/[id]' missing (22.31.503 attempt 2, exit 1). lib/metadata/templates/title.ts line 10 worked around the same gap with an intersection type instead of fixing the map."
fix = "22.31.522 adds the two entries and commits the regenerated route type; 22.31.503 continues after it. A new page lands with its metadata map entries and the regenerated route type (decision 2560)."

[gotcha.3087]
title = "22.31.159 removed the money from the approval-waiting notification and left the full-detail payload without the amount"
symptom = "0e88a62cab (22.31.159) changed services/human/crates/layerx-human-service/src/approvals/mod.rs line 405 to send the approval-waiting notification with money None and persists the exact base units and asset id as an ApprovalNotification binding instead (src/approvals/notification.rs, for_delivery at line 57). The full-detail payload built by src/notify/content.rs line 44 therefore carries no amount, and tests/approvals.rs line 343 (the full-payload amount assertion) fails on main (22.31.515 attempt 2). The 159 record itself lists two open follow-ups: a wiring request to the notify module to expose the binding's amount and asset in full-detail payloads, and the approvals.rs assertion to consume the binding; neither was done."
fix = "22.31.523 does the notify wiring (decision 2569); 22.31.515 attempt 3 reads the amount through the binding. A producer that moves data out of a payload lands with the consumer that re-exposes it (decision 2560)."

[gotcha.3088]
title = "The shared committed fixture under the seller tests still crashes on the absent vote"
symptom = "services/platform/middleware/seller/test/committed-fixture.mjs line 9 decodes every vote signature with Buffer.from(value, 'base64') and the re-recorded sdk/platform/conformance/fixtures/vector-v4-committed.json (22.31.486) holds a BlockIDFlag 1 vote with Signature null (gotcha 3082). The fixture was in no task's paths: 22.33.338 repaired its own apps/web copies and 22.33.1478 attempt 9 copied the decoders into its own support file instead. Six suites import the shared fixture directly or through conformance/pay6/committed-fixture.mjs (seller 434 and 457, agent 457, pay6 committed-rung, conformance 1479, merchant evm-terms, buyer portable-receipts) and every one crashes before its first assertion; 22.31.492 attempt 5 failed only there."
fix = "22.31.524 applies decision 2568 to the shared fixture and runs its importers; 22.31.492 continues after it. A recording consumer shared by several packages gets its own task when the recording changes."

[gotcha.3089]
title = "The web-search recording pairs a legacy transaction with a type-2 receipt"
symptom = "services/interop/crates/x-websearch/tests/fixtures/gateway/exact.json (11.98.1) records a replay-protected legacy transaction (first byte 0xf9) for the PAX exact payment and client-exchange.json records the receipt the recorder answered for it with operation 2. 22.31.514 made the Python binding require receipt operation 0 for a legacy transaction and 2 for a type-2 transaction, so verify_payment_receipt now refuses the pair with 'payment binding payment mismatch' and the web-search client reports receipt-unverified; 22.31.510 attempt 2 passed the same case before 514 and attempt 3 fails all three parameters of tests/ci/test_repair_22_31_510.py after it."
fix = "22.31.526 re-records the exact fixtures with a type-2 chain-125 transaction and its receipt under the recorder; 22.31.510 continues after it. A recording's transaction and receipt come from one signing, never from two fixtures."

[gotcha.3090]
title = "The seller inlines the full committed evidence into the settlement response header"
symptom = "services/platform/middleware/seller/src/index.ts line 389 spreads encodePaymentCommitmentEvidence(commitmentEvidence) into extensions.layerx of the released settlement, so the PAYMENT-RESPONSE header carries the block header, the next commit, the validator set and the inclusion proof as 0x hex. For the two-validator recording that exceeds Node's 16 KiB header limit and a default fetch fails with UND_ERR_HEADERS_OVERFLOW (22.33.1478 attempt 9, recordedNodePaymentCrossesExampleAndRecovers, both iterations); a production validator set is larger. No consumer reads the evidence from the header: the buyer middleware resolves it from the network through its commitments resolver (buyer src/index.ts line 427) and the seller keeps it in the fulfillment record."
fix = "Decision 2570: the header carries the committed rung by reference; 22.33.1478 attempt 10 makes the change (seller src is in its paths). Consensus evidence travels by reference in HTTP headers, never inline."

[gotcha.3091]
title = "A refused payment attempt on a paid order throws order-conflict in the merchant"
symptom = "services/platform/middleware/merchant/src/index.ts checkout (line 240) calls orders.markRefused for every refused seller decision; services/platform/examples/support/merchant-app.mjs transition (line 175) then finds the order already paid-verified and throws MerchantError order-conflict. A buyer who replays a tampered payment header against an order it already paid gets an internal conflict instead of a refusal, and the merchant exports proof (seller test proof_middleware_seller_ts_exports.test.mjs line 296) fails on it (22.33.1478 attempt 9)."
fix = "Decision 2571 and 22.31.525: a paid-verified order is never transitioned by a later attempt; the merchant answers refused with the order unchanged. Terminal order states are checked before any transition is asked of the store."

[gotcha.3092]
title = "An attempt moved the seller's receipt digest back to keccak to match a recording"
symptom = "22.33.1478 attempt 9 changed services/platform/middleware/seller/src/index.ts to verify receiptDigest against keccak256(verified.canonicalBytes) at both settle sites, undoing 22.31.511 (decision 2538: receiptDigest is the receipt-signature digest the verifier returns) so the committed recording's receiptDigest field would pass; the same attempt's settlement-response.test.mjs line 313 asserts the authority is consulted a second time on a stored fulfillment whose request digest differs, while production refuses receipt_reuse from the record alone (index.ts line 290)."
fix = "Both are refused in the attempt 10 ruling: production keeps the verifier's digest and the record-only refusal; the fixture derives the proof digest from the verifier and the test asserts one settle and one release. Production never moves to meet a fixture."

[gotcha.3093]
title = "A ruling that confines edits to listed sites must say the setup those sites need is allowed"
symptom = "22.31.521 do_1 ends 'Change nothing else in either file' after listing the eight call sites that need the decision time; attempt 1 changed nothing and stopped, reading the sentence as forbidding the clock fixture the sites need, although both files are wholly in the task's paths."
fix = "22.31.521 do_3 names the setup; a ruling that lists sites also names the fixture or helper they may add."

[gotcha.3094]
title = "The MCP crate still calls the retired sequence-only approval entries, so every MCP hold is refused"
symptom = "22.31.495 retired the sequence-only daemon entries hold, hold_reserved, reserve_and_hold, decide and expire in services/agent/crates/layerx-agentd/src/policy/approval.rs; each now returns ApprovalError::ClockRequired and the timed entries hold_at, hold_reserved_at, reserve_and_hold_at, decide_at and expire_at take the decision time. services/agent/crates/layerx-mcp/src/approval.rs (require, approve, reject, expire, lines 41-124) and tools/web/approval_state.rs line 302 still call the retired ones with current_sequence only; WebApproval carries no clock, WebAuthority::new takes none, and the daemon's HumanRuntime::mcp_clock accessor has no caller. In production every web spend above the approval threshold is refused as 'the approval boundary refused the web spend' and the five restart cases of repair_22_33_1551 fail (22.31.515 attempt 3). The MCP consumer was never ported when the producer changed."
fix = "Decision 2572 and 22.31.527 port the MCP crate to the timed entries with the daemon clock; 22.31.515 continues after it. A producer that retires an entry lists its production callers in other crates, not only their tests."

[gotcha.3095]
title = "Installing from the wallet gateway directory refuses the ignored build scripts"
symptom = "pnpm --dir services/wallet/gateway install --frozen-lockfile fails with ERR_PNPM_IGNORED_BUILDS (ignored build scripts of @sentry/cli, bufferutil, keccak and utf-8-validate) before the type check runs (22.31.517 attempt 1); services/wallet is the pnpm workspace root (pnpm-workspace.yaml and the lockfile live there) and 22.31.447 built with pnpm --dir services/wallet install --frozen-lockfile --ignore-scripts followed by the gateway type check."
fix = "22.31.517 builds the 447 way and attempt 1 is requalified. Wallet gateway builds install at the services/wallet root with --ignore-scripts."

[gotcha.3096]
title = "A Human service test must create its store root as a 0700 directory"
symptom = "The Human service agent store refuses a store root that is not a canonical owned private directory with Io PermissionDenied; a test fixture that creates the stream directory with default permissions fails before its first assertion (22.31.523 attempt 1, three cases). The existing fixtures create the root with DirBuilder mode 0o700 (tests/component_frame.rs line 38, tests/custody.rs line 62) or set_permissions 0o700 (tests/balance_rungs.rs line 431)."
fix = "22.31.523 attempt 1 corrected its fixture in its final revision and is requalified; a new Human service test takes its store root from an existing fixture."

[gotcha.3097]
title = "The explorer page type map and the page tests blocked each other's production build"
symptom = "22.31.503 moves the four audit test files out of apps/explorer/pages but its production build fails in the type check of lib/metadata/getPageOgType.ts because the page type map lacks '/chains' and '/chains/[id]' (gotcha 3086); 22.31.522 adds those two entries but its production build regenerates nextjs/nextjs-routes.d.ts from pages/ and the four test files still under pages become routes the map does not list (22.31.522 attempt 1, gotcha 3044). Each task's build gate needed the other task's change."
fix = "22.31.503 absorbs the two map entries and continues now; 22.31.522 continues after 503 with its spec and record. When two repairs share one build gate, one of them carries the other's smaller change."

[gotcha.3098]
title = "The native terminal-outcome checker has no corpus interface and the V2 per-vector copy is a second fixture"
symptom = "22.31.491 attempt 1 called tools/qualification/paxeer-x/native-terminal-outcome.py with corpus and case arguments; the checker reads the LAYERX_ARBITER_PRESTATE_INPUTS inventory manifest of native captures, writes retained-native-records.tsv and runs the layerx-proof native_terminal_outcome test, so the call fails before any assertion. The second failure is conformance-copies/V2: sdk/platform/conformance/fixtures/vector-v2-receipted-revert.json must carry the same V2 cases as the receipt fixture (rpc/sequencer_receipt_vectors_test.go line 1277) and was outside the task's paths."
fix = "A task that adds a case to a vector group names the per-vector copy of that group in its paths and regenerates it with the generator's update flag; the committed pre-execution refusal is proved by the Go test on the receipt properties, and the checker-side proof stays with 22.33.877, which redefines the checker's capture contract."

[gotcha.3099]
title = "The ledger draw rename of 22.33.1475 left two consumer tests on the old field names"
symptom = "22.33.1475 renamed the LedgerDraw fields from, assetId and receiverSequence to recipient, purposeHash and sequence in services/platform/middleware/seller/src; services/platform/middleware/seller/test/repair-22-31-434.test.mjs grantDraw (around line 141) and services/platform/middleware/agent/test/repair-22-31-435.test.mjs line 35 still pass the old names, so encodeUint(undefined) throws invalid-payment-payload at ledger.js line 69 in six 434 cases whenever the suite runs."
fix = "A field rename ports every test that builds the type (decision 2560); 22.31.524 attempt 2 ports both tests and adds the 435 test to its verify."

[gotcha.3100]
title = "The 22.31.457 seller test pinned a fully signed committed vector"
symptom = "services/platform/middleware/seller/test/repair-22-31-457.test.mjs line 26 asserts signedPower equals totalPower; the vector 22.31.486 re-recorded has validators of power 7000000000 and 1 with the power-1 vote absent (gotcha 3082), so signedPower is 7000000000 against totalPower 7000000001 and the case fails although the two-thirds threshold holds."
fix = "Committed-rung consumer tests assert the threshold and the recorded powers, never equality of signed and total power; 22.31.524 attempt 2 corrects the assertion."

[gotcha.3101]
title = "The metered retirement left seventeen metered-success cases in the web-search payment suite"
symptom = "22.31.169 retired the metered scheme in services/interop/crates/x-websearch/src/payment.rs (offers are exact per asset; metered records stay readable) and recorded the reconciliation of services/interop/crates/x-websearch/tests/payment.rs as a wiring request that was never turned into a task. 22.31.526 attempt 1 runs that binary: 17 cases fail (four offers where eight are expected, no metered offer in SID, every metered draw, grant, nonce and recovery case) while the attempt's own four exact cases pass."
fix = "A retirement ports or removes the consumer tests of the retired path in the same change or in a required task; 22.31.528 reconciles the suite and 22.31.526 continues after it."

[gotcha.3102]
title = "A ledger transfer preparation needs a well-formed asset-send payload since the call-bound disclosure"
symptom = "services/human/crates/layerx-human-service/tests/decide_nonces.rs line 277 prepares PrecompileCall::ledger_transfer(vec![0x33; 32]); since 9.35.1 the preparation binds the call disclosure through the call codec, which decodes the ledger payload as an asset-send envelope (tag 0x5301, ten fields) and refuses 32 bytes of 0x33 with Disclosure(MalformedPayload), so both decide_nonces cases fail before any decision-time call."
fix = "Test preparations build the payload from a compiled send intent as tests/journey_faults.rs does; 22.31.521 attempt 3 replaces the fixture."

[gotcha.3103]
title = "The fiat journey checks were written against the journey shape before the re-recording"
symptom = "22.31.489 re-recorded the three credited fiat journeys into sdk/platform/conformance/fixtures/fiat-receipts-v1.json and each sequencer block now declares fixture, case, rung, transaction_hash, receipt_digest, idempotency_key, payment_reference, payment_calldata, counterparty and expires_at with no sequence key; the 22.33.94 test asserted a sequence key, its importer looked cases up in the shared sequencer-receipt-v1.json, and its producer finding pinned line contents of rpc/sequencer_receipt_vectors_test.go that 22.31.489 changed. The task text also named the recorder at a path that only the attempt had created while the committed refresher lives at services/interop/crates/layerx-fiat/record_sequenced_journeys.py."
fix = "A test that waits on a re-recording is re-read against the recorded shape before it reruns; 22.33.94 attempt 5 ports the test and the importer and makes the importer the single recorder."

[gotcha.3104]
title = "The seller export proofs fail in three decision-2538 consumers outside the seller task"
symptom = "22.33.1478 attempt 10 passes 22 of 25 cases; sellerExportsPersistCommittedPaymentsAcrossConsumers fails receipt-not-backed because Express and Next assertReceiptBacked compare keccak of the canonical bytes (sdk/integrations/express/src/index.ts line 461, next line 480), and the merchant and RPC export proofs fail verification-failure because the conformance recorder emits keccak of the signed receipt (services/platform/middleware/conformance/src/receipts.ts line 197) and ConformancePaymentRpcSession.call answers five receipt fields the strict seller RPC consumer refuses."
fix = "The Express and Next checks are 22.31.493, the conformance recorder and the full receipt answer are 22.31.492; 22.33.1478 continues after both."

[gotcha.3105]
title = "The approval list widening of 22.31.495 left three MCP test callers on four arguments"
symptom = "9c3cd0e74d (22.31.495) gave ApprovalService::list in services/agent/crates/layerx-agentd/src/approval/mod.rs a fifth current_time argument of type TimestampSeconds. services/agent/crates/layerx-mcp/tests/repair_22_33_1552.rs lines 530 and 607 and tests/support/session_transport.rs line 735 still pass four, so every build of the layerx-mcp test targets fails on main before any task change, and the done task 22.33.1552 no longer compiles its own verify. 22.31.515 named the get callers and the DecisionRequest initialisers but not the list callers; 22.31.527 attempt 1 ported line 735 and then failed its build on the two 1552 callers outside its declared files."
fix = "22.31.527 attempt 2 ports the three list callers with the case's deterministic clock time and keeps every assertion; 22.31.515 keeps the Human service sites and drops any MCP test edit 527 already made (its do_7)."

[gotcha.3106]
title = "The MCP web authority is constructed in production only by the daemon payer attach site"
symptom = "22.31.527 planned services/agent/crates/layerx-mcp alone, but layerx_mcp::binding::WebAuthority::new is called in production only from attach_mcp_payers in services/agent/crates/layerx-agentd/src/main.rs line 1052; the layerx-mcp binary (src/bin/layerx-mcp.rs) opens the binding document and attaches no web authority, and layerx-mcp lists layerx-client only as a dev dependency, so the RuntimeClock::from_environment leg of decision 2572 has no caller. Attempt 1 gave WebAuthority::new the clock parameter and recorded that the daemon site and the dependency were outside its paths; the shared owner already exposes the runtime clock as SharedAgentOwner::mcp_clock (human_runtime.rs line 2569)."
fix = "Decision 2574: the daemon passes owner.mcp_clock() at the attach site, the environment-clock leg of 2572 is withdrawn, and 527 gains the daemon file, the daemon binary build and thirty more minutes."

[gotcha.3107]
title = "The approve path now verifies the budget after the hold and the nonce test boundary refuses it"
symptom = "67f0df3c9e (the 22.30.107 medium repair of services/human/crates/layerx-human-service/src/approvals) made Decisions::approve call the boundary's verified_budget_after before authorising (src/approvals/decide.rs line 182) and refuse an unverified budget. The AgentdDecisions boundary in tests/decide_nonces.rs (around line 480) answers Err(VerificationFailed) after a successful get, written when the nonce flow never reached it, so 22.31.521 attempt 3 fails both nonce cases with Agent(VerificationFailed) before the nonce check and the stale case never records StaleNonce; tests/decide.rs line 413 answers the same call with a verified budget."
fix = "22.31.521 attempt 4 answers verified_budget_after as tests/decide.rs does and keeps every nonce assertion."

[gotcha.3108]
title = "The seller and agent repair fixtures still derive receiptDigest by keccak and build the envelope transport without the gateway credential"
symptom = "services/platform/middleware/seller/test/repair-22-31-434.test.mjs lines 53 and 236 and services/platform/middleware/agent/test/repair-22-31-435.test.mjs lines 113 and 546 set receiptDigest to keccak256 of the signed or canonical receipt bytes, which decision 2538 retired; the seller verifier (dist/index.js verifyReceiptDigest, fed by the seller middleware and the agent grant middleware) refuses six cases with verification-failure. The agent test's own envelopeClient (435 line 274) constructs AgentEnvelopeTransport with endpoint and session only, which c95437fb00 made an invalid argument (repair-22-33-20.test.ts line 111 asserts the refusal); services/platform/middleware/agent/test/repair-support.mjs line 150 constructs it correctly with surface gateway and a LayerXKeyCredential from fixed bytes. 22.31.524 attempt 2 passes 17 of 25 with these eight left as pre-existing."
fix = "22.31.524 attempt 3 takes receiptDigest from the verifier result as repair-22-31-457.test.mjs line 77 does and builds the client as repair-support.mjs does; no assertion changes."

[gotcha.3109]
title = "The regenerated chain routes break every explorer map keyed by the route pathname"
symptom = "apps/explorer keeps four maps typed Record<Route['pathname'], ...>: lib/metadata/getPageOgType.ts, lib/metadata/templates/description.ts, lib/metadata/templates/title.ts and lib/mixpanel/getPageType.ts. 22.31.503's text named only getPageOgType.ts for the '/chains' and '/chains/[id]' entries; attempt 3 added them to getPageOgType.ts and description.ts, title.ts already intersects the two routes, and the production build then failed in lib/mixpanel/getPageType.ts (PAGE_TYPE_DICT, line 3) outside the task's paths."
fix = "Decision 2575; 22.31.503 attempt 4 adds the two entries to the mixpanel map and the task's paths gain apps/explorer/lib/mixpanel."

[gotcha.3110]
title = "A receipt corpus addition changes the portable V5 provenance digest that the committed-fixture gate pins"
symptom = "22.31.491 adds a case to sdk/platform/conformance/fixtures/sequencer-receipt-v1.json; sdk/platform/conformance/fixtures/vector-v5-portable.json carries provenance.receiptedSha256, the SHA-256 of that whole corpus file, and daemon/committed-fixture/vector_v4_test.go TestRepairM_486_DerivedCopies (line 396) compares it with the corpus bytes. The task's verify runs that package, but its paths named the receipt fixture and the V2 copy only, so attempt 2 passed every RPC and SDK target and failed on the stale V5 digest outside its paths. sdk/platform/conformance/fixtures/refresh_receipt_vectors.py main() recomputes both V5 provenance digests from the recorded sources (lines 209-210) without re-recording and keeps the bundle bytes."
fix = "Decision 2576; 22.31.491 attempt 3 refreshes the V5 provenance with the refresher and the portable fixture joins the task's paths."

[gotcha.3111]
title = "A hoisted function declaration does not inherit the parse-result narrowing of the route handler that declares it"
symptom = "22.31.517 attempt 1 moved the EVM sign route's approval lookup into async function ready(client) declared inside the handler after the signSchema.safeParse guard; services/wallet/gateway/src/routes/evmApprovals.ts line 479 reads parsed.data.approval_id inside it. TypeScript hoists a function declaration above the guard, so the parsed.success narrowing does not apply inside it and tsc --noEmit reports TS18048, parsed.data is possibly undefined. The review and approve routes read parsed.data inside arrow callbacks created after the guard, which keep the narrowing. Attempt 2 requalified on the corrected install command and the type check was the only failure."
fix = "Decision 2577; 22.31.517 attempt 3 binds the approval id once after the guard and the helper reads that binding."

[gotcha.3112]
title = "The web hold path requires payer approval resources that the web suite's recorded payer never provides"
symptom = "22.33.1551 (b1ecc6e2e4, 2026-11-04) made services/agent/crates/layerx-mcp/src/tools/web/approval_state.rs authorise_held (line 180) take WebApprovalResources (store, limiter, limits, expiry) from WebPayer::approval_resources, whose default at src/tools/web.rs line 542 is None, mapped to WebPayerError::Unavailable. Only the task's own tests/repair_22_33_1551.rs implements it (line 446, resources() at line 551); the RecordedPayer of tests/web.rs does not, so the four hold cases of the web suite (an_unapproved_spend_is_held_and_never_paid at line 1332, a_rejected_spend_is_refused_without_payment at line 1368, and the two session cases through assert_held_until_approved at line 2220) fail with the web payer is unavailable. The suite was already red on 2026-11-02 and 2026-11-03 with four other cases, and no task runs it as a gate except 22.31.510 and 22.31.526, which cannot pass until it is green."
fix = "Task 22.31.529 gives the recorded payer the approval resources; 22.31.526 requires it."

[gotcha.3113]
title = "The web suite pins the recorded USDC fetch receipt digest as a constant"
symptom = "services/agent/crates/layerx-mcp/tests/web.rs line 64 holds FETCH_RECEIPT_DIGEST f5eec8bb9029099664f41af54ef0662f184916fdfbf59dd11e2ca3f700a82301, the receiptDigest of the previous USDC exact recording in services/interop/crates/x-websearch/tests/fixtures (the suite reads the fixtures through a relative path at line 75), and compares it at lines 1099 and 2143. 22.31.526 attempt 2 re-recorded the four exact payments as type-2 chain-125 transactions, so the USDC digest became b27f1014cf967addb57bd2fce7ccb96e41ec8113e2da96c93314ccaa4699c398 and the three cases that pin it failed in the task's own verify. SEARCH_RECEIPT_DIGEST (line 61) is the metered search recording, which the re-recording left unchanged."
fix = "Decision 2578; 22.31.526 attempt 3 re-pins the constant from the re-recorded fixture."

[gotcha.3114]
title = "The gateway attestor client hides the probe refusal behind participant_unavailable"
symptom = "services/wallet/gateway/src/attestor/client.ts line 787 throws participant_unavailable when a node is not ready, while the probe (lines 835 to 851) records the actual refusal, a 503 readiness report, a health identity outside the approved inventory, or an inventory the loader in src/agent/authority.ts line 64 rejects, only in node.lastError, which AttestorDaemonClient.health in src/provision/bind.ts line 197 does not return; the 22.31.513 identity producer therefore failed two rehearsal and three cmd/ceremony tests with no cause on record."
fix = "Return lastError beside ready from AttestorDaemonClient.health and print the per-node health report before refusing in services/wallet/ceremony/testdata/original-identities.mts; 22.31.513 attempt 3 does so first and then repairs the cause along the real path."

[gotcha.3115]
title = "The agent repair fixture keyed to the verifier digest cannot pass before the agent middleware is ported"
symptom = "services/platform/middleware/agent/src/index.ts lines 896 and 1037 and src/daemon.ts line 241 still derive receiptDigest by keccak256 of the signed receipt; after 22.31.524 attempt 3 keyed services/platform/middleware/agent/test/repair-22-31-435.test.mjs to the verifier digest (decision 2538), the two draw cases refuse at the agent grant verifier and the two daemon submission cases refuse at the seller verifier or return verified where the pending submission should be unknown (line 495); the production port belongs to 22.31.492, which requires 22.31.524."
fix = "22.31.524 verifies without that file (decision 2579); 22.31.492 adds it to its verify, ports the three sites and settles the line 495 resume behaviour against the rung contract."

[gotcha.3116]
title = "The asset-domain approval test forbids any Amount line that a full-detail notification now carries from the binding"
symptom = "services/human/crates/layerx-human-service/tests/repair_22_31_159.rs line 265 asserts a text-channel delivery payload never contains Amount:, written when the only amount line was the Money render; 22.31.523 (8dfb4b3f08, 2026-11-05 01:48Z, decision 2569) made Content::bind_approval in src/notify/content.rs line 27 push Amount: with the exact base-unit amount and Asset: with the stable asset id from the persisted ApprovalNotification binding, which is the distinct-field form the 22.30.107 finding proposed; the three asset-domain cases fail at that line after 22.31.521 attempt 5 repaired the store root, while the 523 cases assert exactly those lines (tests/repair_22_31_523.rs lines 219 and 222)."
fix = "The 159 test asserts the binding form: an Amount line is exactly the base-unit amount followed by an Asset line with the identifier, and the rendered money form (amount, space, asset) never appears; 22.31.521 attempt 6 makes that change and nothing else."

[gotcha.3117]
title = "The MCP server records a decision-time clock refusal as an unknown invocation outcome"
symptom = "services/agent/crates/layerx-mcp/src/boundary.rs line 63 makes BoundaryRefusal::Unavailable report unknown() true, so when decision_time in src/approval.rs line 169 refuses a zero-generation clock sample the server classifies the outcome as InvocationOutcome::Unknown (src/server.rs lines 1157 to 1166), settles no outcome bytes and returns ServerError::InvocationUnknown; the 22.31.527 zero-generation case then fails at tests/repair_22_31_527.rs line 130 with Authority(InvocationUnknown) instead of reaching the release boundary with the Unavailable refusal, although no hold, payment or network effect had started."
fix = "Decision 2581: a refusal raised before any effect settles the invocation as refused; 22.31.527 attempt 4 carries that provenance so unknown() is false for it or samples the decision time before the durable invocation begins."

[gotcha.3118]
title = "The seller again refuses a differing request as receipt reuse before the authority verifies it"
symptom = "22.33.1400 (185e02b301) keyed the seller fulfilment lookup on the transaction hash derived from the unverified payload and returns receiptReuseDecision at services/platform/middleware/seller/src/index.ts lines 289 to 291 whenever the record found by that hint or by the legacy receipt-digest hint carries a different request digest, before this.#authority.settle runs; this is the pre-verification refusal decision 2376 removed through 22.8.11, so sdk/integrations/next/test/receipt-keys.test.mjs line 296 (a settled receipt presented with a changed receipt key) receives 409 receipt_reuse instead of 402 verification-failure and 22.31.493 attempt 1 failed on that case while its own four cases passed."
fix = "Decision 2582: an unverified hint serves the identical-request replay alone; 22.31.530 moves the differing-request refusal behind the authority verification and 22.31.493 continues after it."

[gotcha.3119]
title = "The web hold path refuses an above-threshold metered spend under an existing grant instead of holding it"
symptom = "22.33.1551 (b1ecc6e2e4) made every web hold a durable approval over a payer transaction; for the metered scheme its approval_call (services/agent/crates/layerx-mcp/src/tools/web/approval_state.rs lines 420 to 436) returns Configuration(metered_receiver_approval) whenever the payer reports a standing grant, because the receiver executes the draw and no payer transaction exists to approve. Every above-threshold metered spend under an existing grant is therefore refused instead of held, and an_unapproved_spend_is_held_and_never_paid, a_rejected_spend_is_refused_without_payment, a_held_web_spend_through_tools_call_is_never_paid_until_approved and a_held_spend_in_a_session_opened_from_its_binding_is_reported_as_held in tests/web.rs fail with that refusal once 22.31.529 attempt 1 gave RecordedPayer its approval resources (18 of 22 cases pass). Before 22.33.1551 the hold (src/tools/web.rs at the parent of b1ecc6e2e4, lines 1439 to 1454) held a metered spend on its disclosure alone."
fix = "Decision 2583; 22.31.531 holds the draw on its disclosure and spend commitment and retires the refusal; 22.31.529 continues after it."

[gotcha.3120]
title = "The production web payer offers no approval resources, so every above-threshold web spend is refused as unavailable in the daemon"
symptom = "services/agent/crates/layerx-agentd-host/src/payer.rs WebPayerBoundary (line 394) implements WebPayer without approval_resources, prepare_transaction or submit_transaction, so the trait defaults apply (services/agent/crates/layerx-mcp/src/tools/web.rs lines 551 to 567: None and Refused). services/agent/crates/layerx-agentd/src/main.rs line 1037 builds this payer and line 1052 attaches it; the binding (services/agent/crates/layerx-mcp/src/binding.rs lines 1141 to 1152) reads approval_resources once when it builds the web route, and authorise_held (approval_state.rs line 180) returns the web payer is unavailable for every spend above the approval threshold. Only the test payers (tests/support/web_hold.rs RecordedNodePayer) carry resources; 22.33.1551 recorded the production side as a wiring request in its test header and no task carried it."
fix = "Decision 2584; 22.31.532 wires the shared store of the daemon, an approval expiry over it and the MCP budget limit into the production payer and implements the two transaction methods through its EIP-1559 signing path."

[gotcha.3121]
title = "Three committed seller suites still build the portable proof with keccak-256 of the signed receipt"
symptom = "Decision 2538 made receiptDigest the receipt-signature digest and 22.33.1400 (185e02b301) made the seller compare it in verifyReceiptDigest (services/platform/middleware/seller/src/index.ts line 214) against the digest the verifier returns. The seller suites receipt-replay.test.mjs (lines 41 and 149), settlement-response.test.mjs (line 108) and receipt-verification.test.mjs (lines 103 and 152) still compute keccak-256 of the signed receipt bytes, so every settlement in them fails with verification-failure and the three suites have been red on main since 185e02b301; repair-22-31-434.test.mjs (line 55) and repair-22-31-530.test.mjs already pin the verifier digest and pass. 22.31.530 attempt 1 implemented its change and passed its own four cases and the 434 suite, then failed its verify on six cases of the two red suites."
fix = "22.31.533 re-pins the three suites to the verifier digest under decision 2538; 22.31.530 continues after it."

[gotcha.3122]
title = "Two agent approval suites still call the retired sequence-only hold entry and receive ClockRequired"
symptom = "22.33.1507 deprecated hold, reserve_and_hold, hold_reserved, decide and expire in services/agent/crates/layerx-agentd/src/policy/approval.rs (lines 674 to 728, 1040, 1267) and made them return ApprovalError::ClockRequired; the timed entries hold_at (line 858), hold_reserved_at, decide_at and expire_at replaced them and tests/approval_ops.rs already uses hold_at with ApprovalSequence and TimestampSeconds arguments. tests/approval_semantics.rs (22.31.519 attempt 2, lines 151 to 153, 241, 297 and 324) and tests/approval_ordering/mod.rs (22.33.1539, lines 151 and 231) still call hold with bare sequence numbers, so every admission in them refuses ClockRequired and the outlive case that expects InvalidWindow sees ClockRequired instead."
fix = "22.31.519 attempt 3 and 22.33.1539 port the cases to hold_at with the decision time the suites already fix; no product change."

[gotcha.3123]
title = "A test that pre-creates the approval store root with default permissions is refused by the protected root"
symptom = "ApprovalExpiry::open (services/agent/crates/layerx-agentd/src/approval/expiry.rs line 103) opens the shared Store, whose ProtectedRoot::open (src/store/protected.rs) creates missing ancestors with mode 0o700 and refuses an existing directory whose mode is not exactly 0o700, is owned by another user or is reached through a symbolic link. tests/approval_semantics.rs Directory::new (22.31.519 attempt 2, lines 30 to 37) and tests/approval_ordering/mod.rs line 32 create the root with fs::create_dir_all under the default mode first, so the first open fails with ApprovalExpiryError::Store; tests/approval_ops.rs lets the expiry create the root and passes."
fix = "The suites stop pre-creating the root (or create it with mode 0o700); the protected root contract stands."

[gotcha.3124]
title = "The daemon judges budget-state verification by the retired literal label range 4 to 5 and the Human service reports the refusal as NotFound"
symptom = "services/agent/crates/layerx-types/src/verify.rs VerificationLevel::from_wire_rank accepts 0, 1, 2, 3 and 6 and refuses 4 and 5 as reserved historical labels; its rung maps Committed (6) to Rung::Committed. services/agent/crates/layerx-agentd/src/human_runtime.rs approval_budget_after (line 9893) and src/budget/program_sources.rs line 49 still accept only verification 4 or 5, so the recorded authority of tests/support/approval_fixture (budget_state.verification 6) is refused, and services/human/crates/layerx-human-service/src/server/agent_runtime.rs map_approval_error (line 4389) turns AgentBoundaryError::Refused into ApprovalBoundaryError::NotFound. 22.33.1510 attempt 5 therefore fails both approval cases at verified_budget_after with approval budget actor: NotFound although recovery reconciles the budget (gotcha 3074 is closed). 22.31.462 moved the Human-service decoders to the shared contract but these two daemon sites were not touched."
fix = "Decision 2585; 22.31.534 routes both sites through the shared decoder and adds a Refused variant to the Human boundary error; 22.33.1510 continues after it."

[gotcha.3125]
title = "A renderer case still expects a Submitted-rung budget with evidence to be refused as unverified"
symptom = "22.33.61 ruled that Submitted budget evidence is carried into the presentation with an explicit unverified state and never treated as approval authority; services/human/crates/layerx-human-service/src/approvals/render.rs (lines 140 to 175) refuses UnverifiedBudget only when budget_after.evidence_digest is all zero, after the DigestMismatch check, and otherwise renders carrying the rung. tests/render.rs mismatched_digest_and_unverified_budget_are_refused_before_content (22.33.44 attempt 6, lines 296 to 303) sets rung Submitted on a budget with a non-zero digest and asserts Err(UnverifiedBudget), so the one failing case of fifteen contradicts the 22.33.61 contract that tests/repair_22_33_61.rs proves."
fix = "Decision 2586; 22.33.44 attempt 7 aligns the case: Submitted with evidence renders with its rung, a zero evidence digest is UnverifiedBudget, DigestMismatch first."

[gotcha.3126]
title = "Four assertions of the three committed seller suites predate the reuse, metered and commitment contracts of 22.31.434 and the differing-request verification of 22.31.530"
symptom = "With the digest re-pinned (22.31.533 attempt 1, 18 of 22 pass) the three suites still fail where they assert the pre-22.31.434 behaviour: receipt-replay.test.mjs receiptIdentityIsScopedToMerchant expects a second principal to release the same receipt (receiptReusePrincipal of repair-22-31-434.test.mjs proves it is refused as receipt_reuse); receipt-verification.test.mjs meteredOfferWithPurposeHashVerifies expects an exact-payment proof to satisfy metered and subscription offers (sellerGrantFinalVerifier proves the refusal); settlement-response.test.mjs settlementResponseCarriesPortableReceipt builds self-signed committed evidence without the inclusion anchor and an independently resolved validator set that verifyPaymentCommitmentEvidence now demands (commitmentInclusionUnverified) and at line 308 still equates the portable receiptDigest with keccak-256 of the signed receipt; replayedSettlementAnswersStoredTransaction expects settleCount 2 after a stored record with a different request digest, which is the verification before the reuse refusal 22.31.530 adds. 22.31.530 requires 22.31.533 while 22.31.533 cannot pass that last case before 22.31.530 lands."
fix = "Decision 2588: 22.31.530 carries the digest re-pin and the four alignments with its product change; 22.31.533 continues after it as the recording task."

[gotcha.3127]
title = "The MCP web unit test for a standing-grant settlement has been red on main because its payer double answers only the grant view"
symptom = "services/agent/crates/layerx-mcp/src/tools/web.rs resolves the payer account for every offer through payer_account (line 1174 on main), which issues the account view with selector 0x3f050cbc (owner and asset words) through WebPayer::view; the unit test standing_grant_settles_metered_offer_without_issue (line 2694) drives the tool with StandingPayer whose view asserts the grant view selector 0x423fe4b2 and the grant id argument on every call, so the test panics on the account view before the settlement. No landed gate ran the layerx-mcp library tests (22.31.527 and 22.33.1551 ran their integration targets only); 22.31.531 attempt 1 is the first verify with the lib target and failed there before its own three targets ran."
fix = "22.31.531 attempt 2 teaches the double every view the production path issues and keeps the counts honest; the gate keeps the lib target."

[gotcha.3128]
title = "The host payer EVM suite has been red on main at two cases that read configuration from the ambient environment"
symptom = "services/agent/crates/layerx-agentd-host/tests/payer_evm.rs web_pay_exact_submits_a_signed_layerxpay_call resolves the terms through WebCall::exact_terms, which since 22.31.224 (services/agent/crates/layerx-mcp/src/tools/web.rs line 244) builds a node connection from NodeRpcConfig::from_environment and refuses Configuration(node_rpc) when the node variables are absent; no production path calls that entry, the tool resolves terms through exact_terms_with_payer over the payer boundary. web_grant_submits_a_signed_ledger_issue_grant_call signs through AttestorSigner::sign_ledger_grant_with_stored_assertion whose request_native_signature (services/human/crates/layerx-human-kms/src/attestor.rs line 1164) reads RuntimeClock::from_environment when no native clock is installed (10.1.10) and fails Configuration(native replay clock), which payer.rs attestor_error maps to Refused. No gate ran payer_evm after 22.31.224 or 10.1.10 landed (22.31.527 only edited the call site; 22.33.1511 only added a case); 22.31.532 attempt 1 is the first and failed there before its own target ran."
fix = "22.31.532 attempt 2 aligns both cases to the production paths: terms through the payer boundary, a fixed native clock through with_native_replay_journal over the harness clock; the gate keeps payer_evm."

[gotcha.3129]
title = "Every build of the whole agent daemon test set was blocked on main between the merge of 22.31.495 and the publication of 22.31.519 attempt 3"
symptom = "22.31.495 (merged 2026-11-04 22:07) added current_time to DecisionRequest and a TimestampSeconds argument to ApprovalStore::get (services/agent/crates/layerx-agentd/src/approval/mod.rs line 2120) without updating tests/approval_semantics.rs; 22.31.519 attempt 2 had qualified before that merge, so the suite stayed red on main until 22.31.519 attempt 3 (d739b429df) passed the explicit decision time. 22.31.534 attempt 1, whose declared build is cargo build -p layerx-agentd --tests, failed with five compile errors in that suite (DecisionRequest without current_time at lines 171, 191, 245 and 269; get with three arguments at line 298) before its own verify ran."
fix = "A task whose declared build compiles every test target of a crate inherits every red target of that crate; when the red target belongs to another in-flight task, the task is held behind that task and its attempt is continued unchanged rather than repairing a suite it does not own (decision 2589)."

[gotcha.3130]
title = "The seller suite alignment under 22.31.530 carried the Next consumer suite whose production port 22.31.493 owns, and the aligned seller now answers it 500"
symptom = "22.31.530 attempt 2 passes all 27 seller cases but its verify also ran sdk/integrations/next/test/receipt-keys.test.mjs, where integrationSettlesSignedSequencerReceipt (line 309) received 500 instead of 200 at line 273: sdk/integrations/next/src/index.ts assertReceiptBacked (line 480) still compares the portable receiptDigest to keccak256 of decision.verification.canonicalBytes, while the seller now releases the receipt-signature digest of decision 2538. 22.31.493 do_1 ports the Next and Express assertReceiptBacked to the verifier digest and continues after 22.31.530."
fix = "Per decision 2579 a repair task verify never carries a consumer test whose production port a later task owns; the Next build and suite leave the 22.31.530 verify and stay in the 22.31.493 verify, which already runs both receipt-keys suites."

[gotcha.3131]
title = "The production web payer boundary never implemented the view method, so every production exact-offer payment through the MCP web tool fails as Unavailable"
symptom = "services/agent/crates/layerx-agentd-host/src/payer.rs WebPayerBoundary (line 394) implements validate_search_quote, pay, sign_grant, draw and submit of the WebPayer trait (services/agent/crates/layerx-mcp/src/tools/web.rs line 549) but not view, whose trait default answers WebPayerError::Unavailable. The production daemon wires that boundary (services/agent/crates/layerx-agentd/src/main.rs line 1057) behind the shared MCP payer, and the web payment path (web.rs line 1030 select_offer, then payer_account at line 1284) resolves the payer account by viewing accountId(bytes32,bytes32) on the ledger precompile through payer.view, so the production path has answered Unavailable on every exact offer; only the two test doubles implement view. 22.31.532 attempt 2 exposed it by resolving the exact terms through exact_terms_with_payer over the production boundary as ruled in gotcha 3128: payer_evm web_pay_exact_submits_a_signed_layerxpay_call failed with Payer(Unavailable) and the repair suite never ran."
fix = "The boundary answers view by encoding the call and reading it through the pending node call, exactly as validate already reads accountOwner (payer.rs lines 170 to 178); the real producer to consumer path is proven by the existing suite, which now resolves the terms through the production boundary (decision 2590)."

[gotcha.3132]
title = "With approval_semantics repaired, the whole-crate daemon test build now stops at the human approval budget actor target, which stays red on main until 22.31.516 lands"
symptom = "services/agent/crates/layerx-agentd/tests/human_approval_budget_actor.rs includes services/platform/hosted/authority/src/human/budget_state.rs by path inside the authority_producer stand-in (line 67); since 22.31.208 (4a36a7f456) rewrote that module and added budget_state/native.rs, the included code names items the test crate root never provided: crate::committed (native.rs line 2, budget_state.rs lines 23 and 56), crate::loopback_http (native.rs line 88), super::Human and super::Policy and a human field on the stand-in Config (budget_state.rs lines 407 and 415), and line 1033 of the suite still calls ApprovalService::get with three arguments (22.31.495). Eight errors, the target does not compile (gotchas 3033 and 3075, decision 2564: 22.31.516 replaces the include with the authority library and 22.31.497 restores the two targets). 22.33.1539 attempt 6 and, by the same build, 22.31.534 attempt 2 compile every daemon test target and fail there before their own work is judged."
fix = "Decision 2591: every open task whose declared build or verify compiles the whole layerx-agentd test set requires 22.31.516 until it lands; 22.33.1539 attempt 6 is continued unchanged behind it and 22.31.534 is held the same way before its second attempt starts (decision 2589)."

[gotcha.3133]
title = "The web tool reads the receiver sequence under the recipient account id where the ledger keys nextSequence by the receiver DID key; the committed unit double answered by selector alone and hid it"
symptom = "GrantTerms::next_sequence_call in services/agent/crates/layerx-mcp/src/tools/web.rs (line 753) encodes nextSequence(bytes32,bytes32) over GrantTerms.recipient and the asset, and recipient is the offer pay-to account id (web.rs lines 318 and 1366 to 1369, approval_state.rs line 384); the ledger keeps the receiver sequence by DID key (modules/layerxledger/keeper/views.go line 44 NextSequence(didKey, assetID), precompiles/layerxledger/views.go line 19), and the real producer in services/interop/crates/x-websearch/src/payment.rs resolves the receiver DID through getLayerXDid (line 256) before nextSequence(did_key, asset) (line 284). The trait default draw (web.rs lines 597 to 604) and the approval path of 22.31.531 both issue the view under the account id, so every metered draw reads a sequence that never advances. The committed unit double answered the view by selector alone; the recording of the real producer in tests/support/web_hold.rs holds nextSequence(2b27bb5b..., 5c1d0a93...) and refused nextSequence(ea4a7d75..., 5c1d0a93...) as unrecorded in 22.31.531 attempt 2, and its destructor then panicked on the stopped recording thread and aborted the process."
fix = "Decision 2592: GrantTerms carries the receiver DID key parsed from the offer account and next_sequence_call issues nextSequence(receiver_did_key, asset); every double that answers the sequence view asserts that key; the recording destructor never panics."

[gotcha.3134]
title = "With the real authority producer compiled into the daemon tests, the budget-state response carries the retired verification label 4 and the daemon refuses it: 22.31.462 made the remote consumer require the committed wire rank 6 while the hosted authority never changed"
symptom = "services/platform/hosted/authority/src/human/budget_state.rs line 289 writes verification 4 into the budget-state document, and src/human.rs lines 1134 (capability scope) and 1219 (key policy) write the same literal; layerx_types::verify::VerificationLevel retired ranks 4 and 5 (from_wire_rank refuses them, decision 907 and 22.33.1542), and 22.31.462 (a349c0fb8c) made RemoteHumanAuthority::budget_state in services/agent/crates/layerx-agentd/src/human_runtime.rs line 2065 require VerificationLevel::COMMITTED.wire_rank(). The key-policy and scope consumers (human_runtime.rs lines 2109 to 2110, 18430 to 18431, 19830 to 19831; managed_agent.rs line 784) still accept 4 to 5, and src/budget/budget_proof.rs line 22 requires the retired CHECKPOINT_FINALISED that from_wire_rank never returns, so the budget-proof path refuses every document. 22.31.516 attempt 2 compiled the real producer into tests/human_approval_budget_actor.rs and the first case stopped at line 736 with Refused; the recorded fixtures and assertions of that file and of tests/human_projection_facts.rs still hold label 4."
fix = "Decision 2593 and the new task 22.31.535: the hosted authority emits the committed wire rank for its committed-evidence responses and every daemon consumer decodes the label through from_wire_rank and requires COMMITTED; 22.31.516 continues after 535 and moves the recorded fixtures and assertions of its two test files to the committed label."

[gotcha.3135]
title = "The explorer stat recipe resolves the scan variant value text to weight 500: the variant re-points the slot to the heading.sm text style and the compound variant that restores statValue does not win the weight back"
symptom = "In apps/explorer/toolkit/theme/recipes/stat.recipe.ts the base valueText carries textStyle statValue with an explicit fontWeight 600, the scan entry of the variant axis sets textStyle heading.sm (weight 500 in foundations/typography.ts) on the same slot, and the scan compound variant sets textStyle statValue again without stating the weight. The recipe system resolves the slot with the statValue size, line height and mono family but the heading.sm weight, so recipesResolveToTheVisualSystem in toolkit/theme/repair-22-35-1.spec.ts (line 214) fails for every size while the other 92 cases of the ten spec files pass; 22.35.1 attempt 1 used both repair cycles elsewhere."
fix = "Decision 2594: a slot that must render a composed text style never carries a second text style on another variant axis, and the layer meant to win states the properties the composition is relied on for (at least fontWeight) explicitly; attempt 2 removes the heading.sm re-point and states the weight in the scan compound variant."

[gotcha.3136]
title = "One GrantTerms construction landed beside the receiver DID key field and leaves the host repair test target red on main, stopping the next web task at its dependent-crate check"
symptom = "22.31.531 attempt 3 added receiver_did_key to layerx_mcp::tools::web::GrantTerms and updated the production sites and the four test constructions named in its instruction; 22.31.532 attempt 3 landed in the same window and added a fifth construction, draw_call in services/agent/crates/layerx-agentd-host/tests/repair_22_31_532.rs (line 590), which names every field but the new one. The target no longer compiles, and 22.31.529 attempt 2, whose dependent-crate check builds the host tests, stopped there with exit 0 on its own build and no verify run; its two files are unchanged by the defect."
fix = "Decision 2595 and the new task 22.31.536: the construction gains the field in a one-site task with the host target as its gate; 22.31.529 continues after it unchanged."

[gotcha.3137]
title = "The restart-recovery stored spend names the sender address hex as the disclosure actor and as the hold agent, so an approver sees an address where the agent DID belongs"
symptom = "22.33.1551 (b1ecc6e2e4) added StoredSpend to services/agent/crates/layerx-mcp/src/tools/web/approval_state.rs. Its prepared method (line 167) builds the disclosure actor from hex(&self.sender) and the hold path (about line 359) sets the hold context agent to Did::new over the same hex, while spend_disclosure in src/tools/web.rs (line 1531) names config.payer_did as the actor; both DID constructors accept the forty-character hex string, so nothing refused it. 22.31.529 attempt 3 exposed it: its two session hold cases assert ticket.disclosure.actor equals the payer DID and received the address hex (tests/web.rs line 2272)."
fix = "Decision 2597 and the new task 22.31.537: the stored spend carries the actor DID it was disclosed under; the ticket actor and the hold agent are that DID; a record without it is refused as changed and re-presented."

[gotcha.3138]
title = "The web suite hold cases assert that no grant terms were prepared while a spend is held, but since the hold moved onto the draw disclosure the production path looks up the standing grant and prepares the draw before placing the hold"
symptom = "22.31.529 attempt 3: tests/web.rs lines 1357, 1365 and 1415 assert payer.grants.is_empty() and fail. The suite payer records the terms of every standing-grant lookup in grants (its standing_grant method), and approval_call in approval_state.rs (lines 452 to 500) asks for the standing grant and prepares the draw before authorise_held places the hold (about line 359), as 22.31.531 and decision 2583 intended; every signatures() == 0 assertion still holds, nothing is signed or sent, and the suite already expects grants.len() == 1 after the approval (line 1381). The three assertions date from the hold that preceded any payer interaction."
fix = "Decision 2596: a hold case asserts one prepared terms record and zero signatures; the pending retry and the decision add none because the stored spend serves them."

[gotcha.3139]
title = "A pre-existing stat recipe test pins the scan value to the heading.sm text style that the explorer design brief retires, so the brief-conformant recipe fails the old test"
symptom = "22.35.1 attempt 2 applied the batch 474 instruction (gotcha 3135, decision 2594): the scan variant valueText no longer names heading.sm and the scan compound variant states textStyle statValue with fontWeight 600. Build exit 0, 92 of 93 tests passed; apps/explorer/toolkit/theme/recipes/stat.recipe.spec.ts line 22 (from 9a7c1d9479, 2026-10-21) still expects scan valueText to match textStyle heading.sm and failed. The attempt preserved the test and recorded the conflict instead of changing an assertion it was not told to change."
fix = "Decision 2598: the brief wins over a test that pins the retired style; the assertion moves to the brief's stat value style and the attempt continues."

[gotcha.3140]
title = "Decision 2597 ruled the ticket actor of a held web spend to be the payer DID, against the daemon registry convention that the actor of a held EVM call is the sender address hex; the task that implemented it failed at the registry validator"
symptom = "22.31.537 attempt 1 persisted the payer DID as the stored spend actor and moved the hold agent to it; build exit 0, 13 of 14 tests passed, and repair_22_33_1551.rs line 109 failed with CorruptRecord from ApprovalRegistry::validate_registry. The convention is the daemon's since 9.35.18 (8b17c437a2): services/agent/crates/layerx-agentd/src/policy/approval.rs validate_held_call (line 1427) requires the disclosure actor to equal the hex of the bind_call actor, the sender; hold_reserved_at (line 993) requires the hold agent to equal the disclosure actor; human_runtime.rs line 17851 decodes the actor as the sender address; native_program.rs line 1494 and capability/effects.rs line 405 compare it with the sender; and the repair tests repair_22_33_1551.rs and repair_22_31_531.rs assert hex(&[0xab; 20]) as the actor. The stale expectation is the web suite assertion at tests/web.rs line 2272 (from 3422bafe2f, 2026-10-19, before 9.35.18), which gotcha 3137 took as the intended behaviour without reading the registry."
fix = "Decision 2599 supersedes 2597: the actor of a held EVM call is the sender address hex everywhere; 22.31.537 reverts the DID change and proves the convention through the registry across restart; 22.31.529 moves its line 2272 assertions to the address hex."

[gotcha.3141]
title = "22.31.535 made the hosted authority emit the committed verification rank 6 and converted the daemon consumers it listed, but two consumers still accept only the retired ranks 4 and 5, so the approval budget request path refuses every committed budget state"
symptom = "22.31.516 attempt 4: build exit 0 at 03ef231d21, the dependent-crate check passed, and human_approval_budget_actor failed at tests/human_approval_budget_actor.rs line 1025: the EVM hold approval budget request returned the refusal byte (LXHAGT01 followed by 0x01) where acceptance was expected, after the attempt had moved its recorded authority responses to VerificationLevel::COMMITTED.wire_rank(), which is 6. In services/agent/crates/layerx-agentd/src/human_runtime.rs the guard in approval_budget_after at line 9903 reads !(4..=5).contains(&state.verification), and src/budget/program_sources.rs line 49 reads !(4..=5).contains(&proof.verification().wire_rank()) although every VerifiedBudgetProof is already decoded through budget_verification_level, which accepts only COMMITTED, so the program presentation budget binding refuses every proof it is given. The only other 4..=5 literals are in the two 22.31.516 suites (human_approval_budget_actor.rs lines 778 and 1067, human_projection_facts.rs lines 249 and 1181), whose attempt 4 versions already compare with the committed rank."
fix = "Decision 2600 and the new task 22.31.538 repair the two production guards with unit tests; 22.31.516 continues behind it unchanged, and its suites remain the real-path proof of the approval budget request at rank 6."

[gotcha.3142]
title = "A record amended after the gates is a new candidate, so an attempt whose build and verify both passed was not qualified; the same attempt tightened a persisted-record decoder to the committed rank although its writer stores the retired rank 4 for committed receipts"
symptom = "22.31.538 attempt 1: build exit 0 and verify exit 0 (four repair tests passed) at 31904c37e1, then the attempt appended the gate results to tests/repair_22_31_538.kvx and committed again as 83b560a1f6, so the qualified revision and the candidate differed (same_candidate unmet). The attempt also converted a third site, McpInvocationRecord::decode in services/agent/crates/layerx-agentd/src/session_control.rs (line 3770, previously verification_rank 3 to 5), to require COMMITTED; but that record is written at line 1450 from the receipt store level, and receipt.rs line 601 labels every committed-rung receipt VerificationLevel::CHECKPOINT_FINALISED (wire rank 4), so after the change every persisted committed MCP receipt would reload as Corrupt. The two authority-rank guards of the task are correct."
fix = "Attempt 2 reverts the session_control.rs change (22.31.539 owns that decoder with legacy mapping), keeps the two guards and their tests, and records the gates by reference to the gate ledger without amending any file after they run."

[gotcha.3143]
title = "The agent daemon and the Human service still use the retired labels CHECKPOINT_FINALISED and SETTLEMENT_ANCHORED as their committed verification level, while layerx-types retired them: from_wire_rank refuses ranks 4 and 5, compare() returns Less whenever either side is retired, and Ord sorts the two retired labels below UNVERIFIED"
symptom = "Found while ruling 22.31.538 attempt 1. In services/agent/crates/layerx-agentd: receipt.rs line 601 labels a committed-rung receipt CHECKPOINT_FINALISED and decode_metadata (line 821) accepts only 1 to 5, so a receipt written at COMMITTED (6) cannot be reloaded; human_runtime.rs production_rung_floor (line 19674) maps Rung::Committed to CHECKPOINT_FINALISED and raise_verification_level is called with it (line 13655); the identity floors at human_runtime.rs lines 5074, 11740, 11790, 12954 and 14248 test identity.verification_level < CHECKPOINT_FINALISED, which is false for every level because Ord places the retired labels lowest, so those floors never refuse; managed_agent.rs line 592 and read/committed.rs lines 167 and 421 report CHECKPOINT_FINALISED as the achieved level of committed evidence; the decoders human_receipt_frame.rs line 106, human_runtime.rs rank() line 11446, the identity string decoder line 17539 and config.rs line 506 know only codes 1 to 5; receipt_rung_code (line 18044) encodes COMMITTED as 5; services/agent/qualification/pay2/sequence.rs line 171 is the same producer. In services/human/crates/layerx-human-service, agents/spend.rs lines 286, 316, 394 and 428 call compare(CHECKPOINT_FINALISED).is_ge(), which is always false, so a spend never classifies as Rung::Committed and the budget proof check at line 394 refuses every proof; activity/export.rs line 1307 exports the retired label for committed receipts; the test support crate (layerx-human-test-support/src/lib.rs line 191) sets the retired label as the tenant default. The daemon build emits 147 use-of-deprecated warnings for these constants. 22.31.535 and decision 2593 covered the hosted authority wire rank only."
fix = "Decision 2601 and two new tasks: 22.31.539 retires the labels in the daemon (COMMITTED everywhere, legacy codes 4 and 5 decoded as COMMITTED from stored or received records) and 22.31.540 does the same in the Human service after it, so the daemon consumer accepts both codes before the Human producer emits 6."

[gotcha.3144]
title = "An integration test that includes a library source file by path compiles that file a second time with the test crate as its root, so a unit test in the included file that names crate:: paths breaks the --tests build of the whole crate; a task whose build gate names --lib only never compiles the integration tests and lands the break"
symptom = "services/agent/crates/layerx-agentd/tests/repair_22_31_535.rs line 27 includes src/budget/budget_proof.rs by path (with pub use re-exports of layerx_agentd::read and ProtocolBudgetState at the test crate root so that crate::read resolves) in order to run the in-crate proof verifier tests inside the declared integration gate. 22.31.538 added repair_22_31_538_program_presentation_binds_committed_proof_and_sequence to the tests module of budget_proof.rs with use crate::budget::program_sources and use crate::budget::ProgramSourceError (lines 750 and 753); its build gate was cargo build -p layerx-agentd --lib, which never compiles the test targets, so main at 8499852066 fails cargo build -p layerx-agentd --tests with E0432 and E0433 while compiling the repair_22_31_535 test target. 22.31.516 attempt 5 failed its build on that error (exit 101, verify not run). 22.31.539 attempt 1 failed the same build earlier, on the eight errors of the human_projection_facts target, whose by-path include of the hosted authority human module no longer matches the authority after 22.31.535; that break is the subject of 22.31.516 itself. The daemon test tree holds five more by-path includes of library source (rpc_surface_major_two.rs, rotation_refused.rs, repair_22_33_1514.rs, repair_22_33_1531.rs, repair_22_33_1543.rs)."
fix = "Decision 2602 and two new tasks: 22.31.541 removes the include from the 535 test and runs the in-crate tests through --lib; 22.31.542 removes the remaining by-path includes of library source from the daemon integration tests after 541, 516 and 539. 516 and 539 continue behind 541; every daemon task builds --tests."

[gotcha.3145]
title = "A recorded committed receipt whose rung is flipped to receipted still carries blockNumber and blockHash, and the SDK refuses that answer as malformed; the node emits the two block fields only for the committed rung"
symptom = "22.33.18 attempt 3 (80 of 81 cases passing): test_http_committed_offer_waits_for_verified_inclusion_after_restart in services/agent/sdk/python/tests/test_x402_http_sequencer.py models the receipted step by loading the committed vector into the fixture node (add_recording copies receiptJson whole, including blockNumber and blockHash) and setting rung to receipted. rpc/sequencer_receipt.go lines 165 to 191 define the view: a receipted answer carries no blockNumber or blockHash, and the SDK check in layerx_sdk/x402_rpc.py line 135 refuses a receipted answer that carries blockHash as invalid-sequencer-receipt, which is the contract of decision 1935 and the x402 evidence rule. The SDK is right; the fixture is wrong."
fix = "Attempt 4 drops blockNumber and blockHash from the receipted step of the fixture and keeps the SDK refusal; nothing else changes."

[gotcha.3146]
title = "The 535 daemon consumer test reads a committed-document corpus that the hosted authority producer test writes under the OS temp dir (keyed by the producer sources), so a verify command that runs the consumer alone fails with NotFound at the corpus read"
symptom = "22.31.541 attempt 1: build exit 0, the four in-crate proof tests passed under --lib, then cargo test -p layerx-agentd --test repair_22_31_535 failed in repair_22_31_535_remote_consumers_require_committed_producer_documents with Os NotFound at the must() helper (line 25). tests/support/committed_authority_documents.rs corpus_path() places documents.json under temp_dir()/layerx-repair-22-31-535-<digest>/, and only services/platform/hosted/authority/tests/repair_22_31_535.rs (repair_22_31_535_producers_emit_committed_documents, line 79 to 89) writes it. The 535 verify command ran the authority test before the daemon test, which is why 535 qualified; the 541 verify command named the daemon test alone."
fix = "The 541 verify command runs the authority producer test before the daemon consumer test, as the 535 gate does, and the consumer names that producer test in its message when the corpus is missing. A consumer test that depends on another crate's producer test states the producer in its gate."

[gotcha.3147]
title = "Two explorer restyle tasks of the same wave both changed apps/explorer/ui/snippets/searchBar/SearchBarInput.tsx: the app shell task restyled the compact top-bar field although the searchBar directory is not among its declared paths, and the search-as-prompt task, started from an earlier base, passed its gates but could not be merged onto the explorer integration"
symptom = "22.35.3 attempt 1 (hero and compact search, grouped suggestions, Cmd and Ctrl K focus, light and dark stories; build and seven tests passed at 01d282f156) was held at publication with a three-way conflict in SearchBarInput.tsx: base 64071d03a7, integration 1f4ffe1531 (after 22.35.2, commit 6affbc654e, which changed the file for the compact field of the top bar), result f36b8c2b12. 22.35.2 declares apps/explorer/ui/snippets/header, navigation, topBar, footer, shared/layout, configs/app/ui.ts and lib/hooks/useNavItems.tsx; the design brief places the compact top-bar field and the hero prompt field in one component, so both tasks had reason to edit it, but only 22.35.3 owns the directory."
fix = "Decision 2604 and a continue for 22.35.3: rebase the attempt-1 tree onto the current integration, keep the compact top-bar variant of 22.35.2 together with the prompt behaviour of this task in the one component, and run the gates again. 22.35.3 records that it follows 22.35.2."

[gotcha.3148]
title = "The explorer entity-page proof compared the text of every tab in the address tab row with the bare tab names, but the entity tab row renders the count of a tab as a muted mono span inside the tab, so the Transfers tab read Transfers(10) and the comparison failed"
symptom = "22.35.6 attempt 1 (entity header, tab rows and labelled section groups for transactions, blocks, addresses and tokens, Markets tiles; three builds, one verify at 7ae8e143859d) passed eight of its nine proofs; addressPageRendersEntityTabSetAndOverview in apps/explorer/ui/shared/Page/repair-22-35-6.spec.tsx expected the tab texts Overview, History, Transfers, Portfolio, Analytics, Contract, More and received Transfers(10) for the third tab, because EntityTabs.tsx appends a text.muted mono span with the counter the address counters endpoint returns. The attempt amended the expectation to include the counter but had no verify run left."
fix = "A continue for 22.35.6: the tree stands; the tab label and its counter become two elements the proof reads separately, and the gates run once more at the final revision."

[gotcha.3149]
title = "The tooling acceptance-test task touches the daemon source directory, so its dependent-crate check compiled the MCP and Human service test targets and failed on consumer breaks that another task had not yet published; and its retired-name scan flags the agent boundary checker, whose job is to name the retired client module it refuses"
symptom = "16.90.1 attempt 9 (the two acceptance tests, the three in-scope LNI doc renames; build exit 0 at 25e688840ff6) ended with exit 7 before its verify: the dependent-crate check of layerx-agentd-host, layerx-mcp and layerx-human-service failed on repair_22_33_1551.rs line 668 and tests/decide.rs lines 361, 387, 466, 491 and 498 (missing current_time and the fourth TimestampSeconds argument), the consumer breaks of 22.31.495 that 22.31.515 repaired on main at ba398e5457 five hours after the attempt. The retired-callers scan of attempt 8 also flagged services/agent/tools/boundary-check/src/main.rs lines 99, 100 and 166, where the checker defines lni_reference and tests for layerx_client::lni; the catalogue already allows the same lines of the Human boundary checker (services/human/tools/boundary-check/src/lib.rs) by an allowed-reference entry."
fix = "Decision 2606 and a continue for 16.90.1: rebase onto main, which carries 22.31.515 and 22.31.521, add the allowed-reference entry for the agent boundary checker lines, and run the gates once more. 16.90.1 records that it follows 22.31.515 and 22.31.521."

[gotcha.3150]
title = "Four daemon integration tests still expect a human-protocol refusal as the bare nine-byte frame (the magic LXHAGT01 and status byte 1), but encode_response in services/agent/crates/layerx-agentd/src/human.rs has appended a length-prefixed reason to every refusal since the 22.30.93 repair (22.31.219, ab3600e85a), so the first such assertion fails as soon as the test target compiles again"
symptom = "22.31.516 attempt 6 (authority library as a dev-dependency, build and dependent-crate check exit 0 at 128c6e20821b) failed its verify at tests/human_approval_budget_actor.rs line 1047: the refusal of an operation with a stale sequence came back as the magic, status 1, the big-endian length 17 and the bytes operation.refused, while the test expected the nine bytes alone; the second suite did not run. The same bare expectation remains at lines 1052 and 1058 of that file, at lines 214, 266 and 271 of tests/human_projection_facts.rs (both in the scope of 22.31.516), at line 18 of tests/human_peer_retired.rs and at line 1026 of tests/native_send_preview_evm.rs. tests/human_peer_rungs.rs line 73 already builds the reason-bearing frame with its field helper and is the model."
fix = "Decision 2607, a continue for 22.31.516 (amend the five assertions in its two files to the reason-bearing frame) and the new task 22.31.543 for the two remaining files."

[gotcha.3151]
title = "With the agent boundary checker allowed, the retired-name scan of the lni component reaches four lines on main that describe the retirement rather than call the retired transport: the daemon README sentence that says no LNI connection is required (asserted verbatim by a repair test), a crate doc comment of layerx-client, and two lines of a repair record kept beside the code"
symptom = "16.90.1 attempt 10 (both acceptance tests, the catalogue allowance of decision 2606; build exit 0 at 789dea382280) failed its verify on the lni subtest with four hits: services/agent/crates/layerx-agentd/README.md line 40 (No LNI connection is required, a sentence tests/repair_22_33_1532.rs line 302 asserts the README contains), services/agent/crates/layerx-client/src/lib.rs line 7 (the crate doc comment: without a separate kernel protocol or public LNI boundary) and services/agent/crates/layerx-client/src/repair_22_33_1541.kvx lines 7 and 16 (the record of the task that removed the public lni module). None of the four is a caller; all four landed on main after attempt 8 ran."
fix = "Decision 2608 and a continue for 16.90.1: allow the README sentence and the two record lines by line entries in the catalogue, reword the layerx-client doc comment, and run the gates once more."

[gotcha.3152]
title = "The daemon test tests/native_send_preview_evm.rs starts a local EVM process (the LAYERX_TEST_ANVIL executable, anvil on PATH by default) before its first assertion, and the qualification environment provides the Foundry binaries only when the build or verify command text names forge, cast or anvil (decision 2068); a gate that reaches the test only through the cargo test target list runs without the binary and fails with NotFound at line 161"
symptom = "22.31.543 attempt 1 implemented both full-frame assertions and the repair record; build exit 0 and the dependent-crate check exit 0 at d32e243e779d; human_peer_retired passed its one case; native_send_preview_evm failed at line 161 spawning the local EVM, Os error 2 NotFound, before reaching the amended assertion at line 1026. 9.35.19 and 9.35.20 run the same test through tools/runtime/run-with-clock.sh, which names no Foundry tool, so their gates carry the same latent gap."
fix = "Decision 2609 and a requalify for 22.31.543: its verify command and those of 9.35.19 and 9.35.20 open with anvil --version so the environment provides the binary; the attempt-1 tree is re-qualified unchanged."

[gotcha.3153]
title = "A daemon test target that compiles again after a long red period can still call a sequence-only approval entry that 22.31.495 retired (hold, hold_reserved, reserve_and_hold, decide, expire now return ApprovalError::ClockRequired unconditionally, gotcha 3094); the stale call was invisible while the target did not build"
symptom = "22.31.516 attempt 7 (build exit 0 and dependent-crate check exit 0 at 3039b4588564; human_approval_budget_actor passed) failed one of five human_projection_facts cases: real_authenticated_approval_and_managed_exports_preserve_facts_refusals_and_reopen panicked at the legacy reservation hold with approval budget actor: ClockRequired. The call is must(hold_reserved(&owner.approvals, ..., sequence, window, &legacy_reservation)) at line 1453 of the file on main; the next statement already holds the second reservation through hold_reserved_at with runtime.clock.as_ref(). The target had not compiled since the path-included authority module broke, so the retirement never reached this caller."
fix = "A continue for 22.31.516 (decision 2610): the legacy hold moves to hold_reserved_at with the same runtime clock; the rest of the attempt-7 tree stands."

[gotcha.3154]
title = "The replay-bounds test of the done task 22.31.216 (tests/repair_22_31_216.rs) calls the retired sequence-only approval entries reserve_and_hold (lines 160, 208, 225, 362), hold_reserved (line 285, expecting TooManyItems) and hold (line 296) and so fails on main whenever it runs; no landed task carries the port"
symptom = "Reading the retired-entry callers under services/agent/crates/layerx-agentd/tests after gotcha 3153: repair_22_33_1507.rs asserts the ClockRequired refusal on purpose, human_projection_facts.rs is amended by 22.31.516, and repair_22_31_216.rs is the remaining caller that expects the former results. The task 22.31.495 that retired the entries listed none of these tests."
fix = "New task 22.31.544 ports repair_22_31_216.rs to reserve_and_hold_at, hold_at and hold_reserved_timed with a fixed decision time and keeps every expectation; the gate of 22.31.216 runs green again."

[gotcha.3155]
title = "The native preview daemon test (tests/native_send_preview_evm.rs) is refused by the owner preview path at its first call, before the refusal-frame assertion a repair amends; HumanOperationError::Refused carries no reason, so the failing guard cannot be read from the panic and the test last passed before the committed verification rank, the approval time threading and the receipt rank landed"
symptom = "22.31.543 attempt 2 (build exit 0 at 5ce5764e25af; the Foundry toolchain installed once the gate named anvil, version 1.9.0; human_peer_retired passed) failed native_send_preview_is_an_unsigned_ledger_transfer_call at line 900: must(fixture.owner.native_send_owner_preview_v1(...)) panicked with bootstrap peer: Refused. The amended assertion at line 1026 was never reached. The guard chain of native_send_owner_preview_on_surface in src/human_runtime.rs has more than twenty Refused exits with one shared variant; the test file last changed on 2026-11-01 (9.25.7) while the daemon owner path changed on 2026-11-04 and 2026-11-05 (22.31.495, 22.31.535, 22.31.538, 22.31.541)."
fix = "Decision 2611 and a continue for 22.31.543: one backtrace run pins the refusing guard; a stale fixture is amended in the attempt, a production refusal of a correct request is recorded and left for a repair task."

[gotcha.3156]
title = "The daemon store (services/agent/crates/layerx-agentd/src/store/protected.rs, since the store audit repair of 2026-11-04) refuses a store root that is not a canonical owned private directory; a daemon test fixture that creates its root with std::fs::create_dir and default permissions fails at Store::open before its first assertion, the same shape as the Human service case of gotcha 3096"
symptom = "22.31.544 attempt 1 ported all six retired calls of tests/repair_22_31_216.rs and wrote the record; build exit 0 and dependent-crate check exit 0 at a619f7302b24; all four cases panicked at line 40 (Root::open) with open store: store I/O failure: store root is not a canonical owned private directory, because Root::new at line 32 creates the directory with default permissions. Sibling fixtures already set mode 0700 after creating the root (tests/bootstrap_bind_layerx.rs lines 68 to 76, tests/human_approval_budget_actor.rs line 652)."
fix = "Decision 2612 and a continue for 22.31.544: Root::new sets the directory permissions to 0700 as the sibling fixtures do; the port stands."

[gotcha.3157]
title = "Porting a retired sequence-only hold call to its timed entry changes what the hold means: the timed entry writes the LXAPHLD5 record (legacy bytes plus the created and expiry facts) and the facts operation 47 then answers with the facts, while a test that modelled a hold recorded before the clock existed expects the unavailable status byte 2. The daemon still decodes a bare LXAPHLD4 record on replay (decode_legacy_hold in src/policy/approval.rs) with no presentation, which is the case the test was guarding"
symptom = "22.31.516 attempt 8 at 533c08cdf4133b226683dd97bd8cd7d78528917a: build exit 0, dependent-crate check exit 0, human_approval_budget_actor passed; human_projection_facts failed one case at tests/human_projection_facts.rs line 231 where the legacy approval, now held through hold_reserved_at, answered operation 47 with 141 bytes of facts instead of the two-byte frame LXHAGT01 followed by status byte 2. The fixture already drops its owner and reopens the store before the serving owner replays the holds (lines 1488 to 1491), so the legacy record can be rewritten in the legacy format between those steps."
fix = "Decision 2613 and a continue for 22.31.516: the fixture writes the pre-clock hold as a bare LXAPHLD4 record into the store after the timed hold and before the reopen; the expectations stay."

[gotcha.3158]
title = "22.31.214 (commit 29d6ecaded) retired NativeSendPurposeV1 in services/agent/crates/layerx-agent-api (validate_fields and canonical_bytes return ContractError::Mismatch(native_send.legacy_version) unconditionally) and introduced NativeSendPurposeV2 and SignedNativeSendPurposeV2 in src/native_send.rs, recording four wiring requests in tests/repair_22_31_214.rs for the daemon, the SDK, the Human service with the KMS and the schema; none became a task, so every production producer and consumer of the native send purpose still builds the retired V1 and refuses every correct request: the daemon owner preview (src/human_runtime.rs line 6310 and the MCP native web purpose at lines 436 and 2656), the wire decoders in src/agent_rpc_wire.rs, the binding verifiers in src/capability/binding.rs, the SDK native_effect.rs, the MCP catalogue, the Human journeys engine, server native_send.rs and agent_runtime.rs, custody/provider.rs, the KMS attestor, and services/agent/schema/agent-api/v1.kvx with its golden copy"
symptom = "22.31.543 attempt 3 at c1ea1692db67af4e7d13364efe38b93ee817b9a2 ran the decision 2611 diagnosis: build exit 0, human_peer_retired passed, native_send_preview_evm refused at tests/native_send_preview_evm.rs line 900 before the amended assertion; the attempt pinned the guard to src/human_runtime.rs lines 6335 and 6336 (validate of the constructed NativeSendPurposeV1) and layerx-agent-api/src/identity.rs lines 407 to 410 (the unconditional refusal) and recorded it under blocker.owner_preview in tests/repair_22_31_543.kvx, changing nothing under src. Confirmed on main: no consumer outside layerx-agent-api names NativeSendPurposeV2."
fix = "Decision 2614: four port tasks 22.31.545 to 22.31.548 adopt the V2 contract along the daemon, the schema, the SDK with MCP and the Human service with the KMS; 22.31.543 is held behind 22.31.545 and continues after it."

[gotcha.3159]
title = "Decisions 2593 and 2600 moved the budget-state, capability-scope and key-policy documents of services/platform/hosted/authority to VerificationLevel::COMMITTED.wire_rank() and every daemon consumer of those ranks to from_wire_rank, but the subject identity and context documents carry a string label and were left on the retired one: src/human.rs line 1030 and src/human/dynamic.rs lines 388 and 625 still write verification_level checkpoint_finalised. On the consumer side services/agent/crates/layerx-agentd/src/human_runtime.rs lines 17543 to 17552 map only the five pre-committed strings, so a committed label is refused as Unverified while the two retired labels decode; src/human_runtime/subject.rs line 54 requires the literal checkpoint_finalised; and the five identity guards at human_runtime.rs lines 5074, 11749, 11799, 12963 and 14257 test identity.verification_level < VerificationLevel::CHECKPOINT_FINALISED, a deprecated constant that the Ord impl of layerx-types verify.rs (line 114) sorts below every current level, so the comparison is false for every decoded level and the guards refuse nothing on evidence strength: an identity labelled sequencer_signed passes a check written to require committed evidence"
symptom = "Read on main at 6ad9580444 while sweeping retired contracts for unported consumers after gotcha 3158: the authority identity and context producers, the daemon parser, the subject.rs literal, the five guards, the Ord impl keys (CheckpointFinalised 0, SettlementAnchored 1, current ranks wire_rank plus 2) and the seven daemon test fixtures that serve the retired label (tests/bootstrap_bind_layerx.rs lines 395 and 399, tests/native_send_preview_evm.rs lines 441 and 445, tests/human_approval_budget_actor.rs line 374, tests/human_projection_facts.rs lines 761 and 771, tests/support/repair_22_33_1529.rs line 232). No authority test asserts the identity label."
fix = "Decision 2615: one task 22.31.549 adds wire_label and from_wire_label to layerx-types, makes the authority emit the committed label for identity and context, makes the daemon decode through the shared helper and require COMMITTED in every identity guard, moves the fixtures and proves both sides; it follows 22.31.545 because they amend the same preview test."

[gotcha.3160]
title = "Batch 494 wrote task 22.31.549 from a fresh read of the identity label path without checking the decisions index site by site: gotcha 3143, decision 2601 and task 22.31.539 (pending behind 22.31.516) already own the five identity floors at services/agent/crates/layerx-agentd/src/human_runtime.rs lines 5074, 11749, 11799, 12963 and 14257 and the identity string decoder at line 17543, and task 22.31.540 owns the Human service sites; decision 2615 also contradicted decision 2601 on the legacy spellings, 2601 mapping checkpoint_finalised and settlement_anchored in a received identity document to COMMITTED (the consumer accepts both encodings before the producer changes) where 2615 refused them. Only the hosted authority producers (src/human.rs line 1030, src/human/dynamic.rs lines 388 and 625), src/human_runtime/subject.rs line 54, the seven daemon fixtures serving the string label and the shared label helpers were uncovered"
symptom = "Found while sweeping the remaining uses of the retired constants after batch 494 landed (1c95cc6f5c); the sweep reproduced gotcha 3143 site by site before the decisions index was consulted."
fix = "Decision 2616: 2601 stands for a received identity document; 22.31.549 is narrowed to the producer side and the uncovered sites, follows 22.31.539, and its from_wire_label helper decodes the current labels only. Before a new task is written every site it names is checked against the existing gotcha, decision and task text."

[gotcha.3161]
title = "Decision 2613 rested on a wrong reading of the replay path: since 22.33.1507 (37b3ea7c04, 2026-11-04) validate_replayed in services/agent/crates/layerx-agentd/src/policy/approval.rs (line 1439) refuses a replayed hold that carries no time presentation as LegacyTimeUnits, so a bare LXAPHLD4 record under a hold key makes replay_tenant fail and the owner that replays that store refuses to open; the facts operation 47 never reaches a pre-clock hold, and the 1507 record names operator-owned re-preparation or cancellation of such holds as the recovery path"
symptom = "22.31.516 attempt 9 at cfd12b83e73f22dc1110089d084fc77bcae7e8fe: build exit 0, human_approval_budget_actor passed; human_projection_facts failed in real_authenticated_approval_and_managed_exports_preserve_facts_refusals_and_reopen at tests/human_projection_facts.rs line 1087, where constructing the serving owner panicked with approval budget actor: Refused after the daemon logged that recovery of the human-v1 tenant failed with reason Unavailable; verify exit 101. The attempt had rewritten the stored LXAPHLD5 hold to its embedded LXAPHLD4 payload exactly as decision 2613 asked."
fix = "Decision 2617 and a continue for 22.31.516: the main case keeps the timed hold and expects the facts frame for operation 47; the pre-clock record moves to its own case that asserts the refusal to open across a real store reopen. The recovery of legacy holds named by the 1507 record has no task owner and is recorded for the owner. A decision that describes what production code does is checked against the current main, not against the reading that an earlier gotcha recorded."

[gotcha.3162]
title = "A task whose verify target carries an assertion owned by a pending follower cannot qualify: 22.31.545 runs tests/native_send_preview_evm.rs, whose refusal assertion after post_preview(5, [12; 32]) (line 1026 on main) still expects the two-byte frame while the daemon answers the reason-bearing frame (magic, status byte 1, a big-endian u32 length of 17 and operation.refused); that assertion is 22.31.543 do_2, and 22.31.543 follows 22.31.545 since decision 2614, so neither task could reach a passing verify"
symptom = "22.31.545 attempt 1 at 238d3c29af4bb9dcc25e28d01e87ecb5a95c70d1: build exit 0, dependent-crate check exit 0, the library native_send tests passed; native_send_preview_is_an_unsigned_ledger_transfer_call failed at tests/native_send_preview_evm.rs line 1033 of the attempt with the full refusal frame on the left and the two-byte expectation on the right; the restart regression tests/repair_22_31_545.rs built and did not run."
fix = "Decision 2618 and a continue for 22.31.545: the attempt amends that one assertion to the whole frame through a field helper; 22.31.543 keeps it on rebase. When a follower owns an assertion inside a leader verify target, the leader writes it and the follower keeps it."

[gotcha.3163]
title = "22.33.50 attempt 5 repaired the daemon verification code sites (code 6 in human_receipt_frame.rs decode_from and in the rank function of human_runtime.rs, persist_authenticated_receipt at receipt.rs line 601 and decode_metadata) that gotcha 3143 and decision 2601 assign to 22.31.539, because its attempt-5 ruling (do_10, written before 22.33.1542 and 2601) widened the scope to services/agent/crates/layerx-agentd/src; the two failing cases then refused with AgentBoundaryError::CorruptResponse from the Human service decode of the recorded control evidence, and the attempt did not locate the site"
symptom = "22.33.50 attempt 5 at d51d717f669fbfc95a2e2ab9cb3d669714bb66c9: build exit 0, dependent-crate check exit 0; finding12_committed_label_requires_retained_consensus_evidence passed, finding12_control_transport_preserves_checkpoint_verification failed at tests/repair_22_33_50.rs line 560 (Err(CorruptResponse) where Err(Refused) is asserted) and finding12_recorded_paxd_receipt_transport_recovers_before_replay failed at line 70 (the checked helper on the recorded control evidence); verify exit 101."
fix = "22.33.50 now requires 22.31.539 and 22.31.540 and continues after them without its daemon edits; the attempt runs the failing cases once with RUST_BACKTRACE=1 before the gates to name the CorruptResponse site. A ruling that widens a task into another domain is re-read against the decisions index when a later decision assigns those sites."

[gotcha.3164]
title = "vitest toMatchObject treats a Buffer expectation and a Uint8Array value as different types even when the bytes agree: the station replay evidence of the wallet gateway carries activityId as a Uint8Array and the test helper bytes() returns a Buffer, so the match at services/wallet/gateway/test/repair-22-33-207.test.ts line 778 fails on type alone"
symptom = "22.33.207 attempt 1 at 9e2d7c38271235266bdad9d61d5e4729edbe7bb6: typecheck passed; eight of nine cases passed; stationReplayPreservesCanonicalNodeExecutionEvidence failed with the expected Buffer data array against the received Uint8Array of the same bytes; the first verify run had also met a transient gas_station_unavailable refusal and a closed database connection that the second run did not; verify exit 1."
fix = "A continue for 22.33.207: the case asserts Buffer.from(evidence.receipt.activityId) against bytes(txHash) with toEqual and resultCode with its own expectation; production code stays unchanged."

[gotcha.3165]
title = "The explorer address page disables its entity tab row while any of its page queries still serves placeholder data (isTabsLoading in ui/pages/Address.tsx joins the address query, the tab counters query and the feature-gated widget, user operations and MUD queries), so a proof that clicks a tab right after a sibling element shows loaded data can hit a disabled trigger and the route push never happens: 22.35.6 attempt 2 clicked the History tab once the Transfers counter showed the loaded count (3 where the placeholder shows 10) and asserted router.push synchronously; the push had zero calls"
symptom = "22.35.6 attempt 2 at ef0a0fe2e475ec12e86703510e5e749b9ed2cd87: two builds (exit 2 then exit 0), verify exit 1 with eight of nine proofs passed; addressPageRendersEntityTabSetAndOverview in apps/explorer/ui/shared/Page/repair-22-35-6.spec.tsx failed at line 123 with router.push called zero times after fireEvent.click on the History trigger. The attempt then amended the proof to wait for the trigger to report enabled and to await the push assertion, built once more (exit 0 at 57be677d3751afc09f2b5cb4f7ca73d55d44c294) and had no verify run left: the second attempt in a row that spent the single verify run of this task on one assertion of the same proof."
fix = "Decision 2619 and a continue for 22.35.6: the attempt-2 tree stands with its amended proof, and the attempt runs that one proof by name before the gates so the single verify run is spent on a tree whose proof is known to pass."

[gotcha.3166]
title = "22.31.545 (bf55875f50) made native_send_prepare_digest in the agent RPC routing module of services/agent/crates/layerx-agentd (the file beside agent_rpc_adapters.rs) take crate::agent_rpc_wire::NativeSendPrepareRequestV2 instead of the layerx_agent_api V1 request, and the inline test of src/agent_rpc_wire.rs (line 3357) calls it through the crate path of the routing module; tests/rpc_surface_major_two.rs includes src/lib.rs as a module and src/agent_rpc_wire.rs a second time by path, so inside that target the request the test builds and the type the function expects are two distinct NativeSendPrepareRequestV2 types and the target no longer compiles (E0308)"
symptom = "22.31.547 attempt 1 at fab6cba03cd0005b7ed1cc66253876a4d7a1cf3f: the SDK V2 carrier, signing and wire, the envelope transport, the catalogue version, the end-to-end case and the record built (exit 0); the dependent-crate check (cargo check --all-targets on layerx-agentd and layerx-agentd-host) failed with exit 101 on the single error in the rpc_surface_major_two target and no verify run followed. 22.31.545 itself declared a build of the library and two test targets rather than --tests, and its dependent-crate check covered layerx-agentd-host and layerx-mcp, so the broken target reached main."
fix = "Decision 2620 and a new task 22.31.550: the digest becomes a method on NativeSendPrepareRequestV2 in agent_rpc_wire.rs, the inline test calls it by local path and the routing module forwards to it; 22.31.547 continues after 22.31.550 and 22.31.542 follows 22.31.550. A daemon task declares the --tests build decision 2602 requires even when it changes only a few files."

[gotcha.3167]
title = "The layerx-sdk integration tests have no harness that starts a daemon: tests/native_capabilities.rs reads the conformance fixture JSON and tests/sdk.rs only names the daemon socket path, so the 22.31.547 instruction to start the daemon the way those tests do could not be followed; attempt 1 reused the daemon preview fixture by including tests/native_send_preview_evm.rs of layerx-agentd with the include macro and a dev-dependency on layerx-agentd"
symptom = "22.31.547 attempt 1 at fab6cba03cd0005b7ed1cc66253876a4d7a1cf3f: services/agent/crates/layerx-sdk/tests/repair_22_31_547.rs includes the daemon test file by path and drives the owner preview, the SDK transport and the daemon RPC through its Fixture; the build passed and the case was never run because the dependent-crate check failed first (gotcha 3166)."
fix = "Decision 2620 accepts the include for the SDK end-to-end case, 22.31.543 keeps the included file compiling for it, and 22.31.547 records the reason."

[gotcha.3168]
title = "The layerx-agentd library test target (cargo test -p layerx-agentd --lib) is red on main: at the 22.31.539 attempt-2 base (cb4ce28b) 45 of 325 cases fail, 9 failed on 2026-11-03, and no task runs the whole target, so the breakage grew unnoticed while each task filtered to its own cases. A verify that names a bare --lib together with integration targets stops cargo at the first failing binary, so the eight integration targets of 22.31.539 never ran."
symptom = "The failures split by owner: 17 approval and policy cases call the retired sequence-only hold entry hold_reserved in src/policy/approval.rs (lines 728 to 745 return ClockRequired; the live entries are hold_reserved_at at line 804 and hold_reserved_timed at line 830); 13 cases open a store on a default-mode temp directory or reopen one root while the first handle lives, which src/store/protected.rs refuses (line 66 store root already has a writer, lines 89 to 93 store root is not a canonical owned private directory); 7 receipt-fixture cases belong to 9.98.4; 2 native send wire cases are fixed by 22.31.545; 2 TLS identity cases are the producer-input pair of decision 2325; 5 remain unclassified (the middleware observation transcript case of the agent RPC routing module, capability::effects::tests::register_is_unsupported_not_empty, read::committed::tests::program_sources_select_the_chain_bound_principal_inventory and the two read::program_node::historical_deployment_tests cases)."
fix = "Tasks 22.31.551 to 22.31.555 repair the fixtures by owner and 22.31.554 proves the whole library target green under the runtime clock; until then every daemon task filters the library target to its own modules in a cargo test invocation separate from its integration targets (decision 2621)."

[gotcha.3169]
title = "In-crate daemon tests that build a store fixture with std::env::temp_dir().join(..) and a default-mode create_dir or create_dir_all fail with store root is not a canonical owned private directory, and tests that call Store::open twice on one root while the first handle is alive fail with store root already has a writer (WouldBlock); approval and policy tests that call hold_reserved fail with ClockRequired."
symptom = "src/store/protected.rs validates the root as a directory of mode 0o700 owned by the current uid whose canonical path equals the given path, and takes an exclusive lock for a writable open; the passing pattern is the Directory helper of tests/approval_ordering/mod.rs (lines 24 to 38: DirBuilder with mode 0o700, a unique label plus the process id, remove_dir_all first) or fs::set_permissions(root, from_mode(0o700)) as in src/enrolment.rs line 1284, with the first handle dropped before a second open; hold_reserved_at takes a clock whose sample returns a non-zero generation, as the human_approval_budget_actor test does at line 1120."
fix = "22.31.551 ports the hold calls, 22.31.552 and 22.31.555 fix the store fixtures; a new in-crate test takes the Directory pattern and the timed hold entry from the start."

[gotcha.3170]
title = "The Makefile target paxai-host-boundary-build (Makefile line 2983) exits 1 with wasm-opt is required when the binaryen optimiser is not on PATH, so 22.99.77 attempt 13 failed before cargo ran."
symptom = "The target optimises the ai-market guest with wasm-opt; GOTCHA 7862 already names binaryen as the package; the qualification environment did not install it because no task declared it."
fix = "The qualification environment now installs binaryen whenever a build or verify command names paxai-host-boundary or wasm-opt; 22.99.77 re-qualifies as it stands."

[gotcha.3171]
title = "The 22.33.1537 attempt-2 tree calls support::current_node from services/agent/crates/layerx-agentd/tests/outbox_recover.rs (near lines 140 and 322 to 324) while tests/support/mod.rs defines no such helper, so every build of the outbox_recover target fails with E0433 four times; attempts 3 and 4 re-ran the gates without an agent and could not add it."
symptom = "tests/support/mod.rs holds the shared constructors of the daemon integration tests (signed_transaction, verified_submission, the budget_* builders, directory, the evidence_authority family, the raw_receipt family, signed_batch_header, rpc_hex and serve) but no constructor of the current node; the amendment that asked for one was written as a task instruction without a relaunch note, so the automatic re-qualification after 22.31.497 reused the attempt-1 ruling."
fix = "22.33.1537 attempt 5 continues with an agent and writes tests/support/current_node.rs, declared in tests/support/mod.rs (decision 2622); an amendment that needs an agent is always registered as a continue ruling."

[gotcha.3172]
title = "An attempt whose gates started before 22.31.550 reached main (merge d9054f4423, 15:43Z on 2026-11-05) still built the layerx-agentd test targets against the gotcha-3166 break and failed with the single E0308 in the rpc_surface_major_two target, although the repair was on main by the time its result was read; 22.31.534 attempt 2 (its own --tests build) and 22.33.223 attempt 7 (the dependent-crate check of the ai-market program crate, which builds the daemon test targets) are the last two."
symptom = "The automatic re-qualification after a required task lands fires only for tasks whose requirements list that task; neither 534 nor 223 required 550, so they stay failed until a ruling adds it."
fix = "Both re-qualify as they stand with 22.31.550 added to their requirements (decision 2623); no further attempt can start on a base without the repair."

[gotcha.3173]
title = "Nine re-qualified attempts whose builds first passed after 22.31.550 landed reached their verify for the first time and failed on their own tests: a fixture spelling (22.31.494), literals copied from a vector since re-recorded (22.33.1547), expectations written before a required repair changed production (22.33.217, 22.33.1536, 22.33.261), a test premise about an encoding (22.33.218), a missing task record (22.33.233) and a main test target left red by a later task (tests/repair_22_31_220.rs after 22.31.227, included by path into the 22.33.1533 binary)."
symptom = "A tree blocked for days behind the gotcha 3033 and 3166 build breaks never ran its verify, while the repairs it requires changed the production it tests."
fix = "Such a failure gets a continue ruling naming the production fact per failing case, never another gate-only re-run; a main test target included by path into a task binary is realigned by that task and the file is added to its paths."

[gotcha.3174]
title = "px_listAssets serves asset_id with the 0x prefix (the gateway one_source_reads transcript, exact asserted result) and services/agent/crates/layerx-client/src/px.rs line 311 keeps the text as served, while src/rpc/withdrawal.rs get_asset formats the looked-up id as bare hex and src/rpc/payments.rs get_asset compares the strings, so every withdrawal registry lookup answers AssetUnavailable."
symptom = "Found by the first verify run of 22.33.1547 attempt 4 (withdrawal_registry_reads_the_fee_schedule_and_asset_through_json_rpc)."
fix = "22.33.1547 repairs the consumer to compare decoded bytes (decision 2624)."

[gotcha.3175]
title = "services/agent/crates/layerx-agentd/src/events/ingest.rs commit_block promotes pending and retained logs to the retired legacy CHECKPOINT_FINALISED label (lines 1018, 1039 and 1052); the current verification level has no rank for it, so a promoted receipted log fails validation with ReceiptEvidenceMismatch and its persisted pending record reopens as CorruptEvent."
symptom = "Observed by the 22.33.14 attempt 5 producer ingestion cases (12 of 14 pass; the restart case passes)."
fix = "22.31.556 migrates the promotion and the metadata and pending codecs to the current committed level; 22.33.14 re-qualifies behind it."

[gotcha.3176]
title = "The platform CLI test tasks 22.33.1495, 22.33.1496 and 22.33.1497 ran in the same wave as the source tasks 22.33.1492, 22.33.1493 and 22.33.1494 of the same audit record and failed on the production sites those source tasks own: tools/platform/cli/src/rpc.rs lines 21 and 37 and wallet.rs line 806 still require the retired /rpc suffix (RPC URL must end in /rpc) and toolset.rs lines 225, 274 and 335 still post to /rpc, contrary to decision 2521."
symptom = "The three test tasks require only 22.31.212 and 22.31.213; their retired-endpoint cases (test_retired_endpoint_rpc_identity, test_retired_endpoint_lx_refusal, test_retired_endpoint_chains, program_lifecycle_third_shape and the five wallet cases of 22.33.1497) assert the root admission the source tasks introduce."
fix = "Decision 2626: the consumer test tasks of an audit record wait for the producer repair tasks of the same record; 22.33.1495 now requires 22.33.1492 and 22.33.1493, 22.33.1496 requires all three, 22.33.1497 requires 22.33.1493 and 22.33.1494, and each continues with its own test defects fixed."

[gotcha.3177]
title = "The intent compiler services/human/crates/layerx-intents/src/compile.rs refuses IntentKind KeyRotation at protocol version 3 (the version admission near line 164 lists only SessionGrant, RecoveryRegistration, NativeBudgetCreate and NativeAssetAccountOpen) and its KeyRotation branch (lines 219 to 240) writes the unprefixed layerx_wire::hash::did_id digest, while the kernel lxp_did_id_derive (src/state/lxp_identity.c lines 46 to 56) hashes a two-byte big-endian length prefix plus the DID bytes under the DID id domain and the governance validator (src/modules/governance/lxp_governance.c lines 185 to 192) requires protocol version 3 and the derived actor identifier equal to payload bytes 4 to 36, else LXP_ERR_AUTH_SCOPE (-204)."
symptom = "22.31.496 attempt 3 compiled the proving rotation with Intent::v1 for an owner key that is not the executing fixture identity and the kernel answered -204; the daemon, the disclosure crate and the compiler V3 RecoveryRegistration branch already derive with did_id_for_protocol(did, 3)."
fix = "Decision 2625 and task 22.31.557: the compiler admits V3 KeyRotation and derives the identifier with did_id_for_protocol(did, 3) for V3 while V1 and V2 bytes stand; 22.31.496 waits for it and compiles the proving rotation as V3 for the fixture identity DID."

[gotcha.3178]
title = "A stand-in node peer that answers read.proof_bundle with the generic success body (request_id, value, verification_status) is refused by the SDK decoder decode_proof_bundle_response (services/agent/crates/layerx-sdk/src/agent_envelope.rs lines 1727 to 1745, since 22.31.487), which requires exactly the fields value, achieved_verification_level and freshness, a freshness.relative_to block whose height equals the value height with a non-zero hash, and an achieved verification status."
symptom = "22.33.1572 attempt 4 panicked at tests/repair_22_33_1572.rs line 328 with Decode ReadProofBundle after 22.31.487 landed; the daemon producer serialises VerifiedRead of ProofBundle through encode_json (human_runtime.rs proof_bundle_operation_value near line 21911, used by the adapter at agent_rpc_adapters.rs line 1856)."
fix = "A stand-in answer for a verified read reproduces the daemon producer document, never the generic success body; 22.33.1572 continues with the peer answering the VerifiedRead of ProofBundle JSON."

[gotcha.3179]
title = "22.33.1492 attempt 1 committed revision ed24e41ad8db3acdec80966818619914c517d618 whose test assertions sit ten lines below the lines its own gate log names (tests/repair_22_33_1492.rs lines 823 and 1317, src/a2a.rs line 1600 versus the committed assertions at 833, 1327 and 1610): the tree was amended after the gates ran, so the recorded failures describe a tree that no longer exists (gotcha 3142)."
symptom = "The three failures are real at either tree: the root listener does not answer 401 to an uncredentialed POST, programs::lifecycle_calldata writes zero where the conformance fixture encodes the fee-limit word 0x3e8 (hex offset 583), and the response-loss case expecting state rejected receives a task document without a status."
fix = "The continue ruling repeats the gate-after-amend rule: build and verify run once at the final revision and the record cites that revision; the three production facts are named per case."

[gotcha.3180]
title = "services/human/crates/layerx-human-service/tests/native_send_producer.rs line 659 (the case genuine_human_owner_session_consent_preview_and_reopen) still reads first.purpose.owner_public_key, a field NativeSendPurposeV2 (services/agent/crates/layerx-agent-api/src/native_send.rs) no longer has since 22.31.545 and 22.31.548 renamed it consent_public_key; the test target of layerx-human-service does not compile on main (E0609)."
symptom = "22.31.548 ported the journey engine, the native send server, the custody provider and the KMS attestor and touched only native_send_purpose.rs and native_journey_approval.rs among the tests; the dependent-crate check compiles every test target of layerx-human-service through its consumers, so 18.1578.1 attempt 3 and 22.99.77 attempt 14 (both green on their own build) failed on this one error before their verify ran."
fix = "Task 22.31.558 ports the site to consent_public_key; 18.1578.1 and 22.99.77 require it and re-qualify once it lands; decision 2627 makes a field rename cover every test target of the crate."

[gotcha.3181]
title = "services/agent/crates/layerx-agentd/src/receipt.rs serve_kernel_evidence decodes only evidence version 1 (decode_evidence refuses any other version byte) and returns Ok(None) when the public evidence key holds a current EVIDENCE_VERSION 2 transaction evidence record, so evidence_inventory lists every current receipt under without_evidence and a tenant whose only receipt is a current transaction receipt recovers as a tenant without evidence."
symptom = "22.33.1537 attempt 5: the startup fixture stores a current transaction receipt through store_verified_if_absent and serve_evidence serves it, yet startup_recovery_reconciles_evidenced_tenant_and_holds_tenant_without_evidence finds with_evidence.len() 0 (tests/outbox_recover.rs line 334); serve_evidence itself (lines 405 to 420) already builds the ReceiptEvidenceRecord for a current record from the served receipt and the decoded transaction evidence."
fix = "22.33.1537 continues: evidence_inventory decodes a current-version record with the transaction evidence decoder and pushes the same ReceiptEvidenceRecord serve_evidence builds, and refuses version 1 and legacy-key records with EvidenceVersion as its attempt-2 ruling asked."

[gotcha.3182]
title = "tools/platform/cli/src/register.rs line 237 (the in-crate case the_request_names_the_method_and_params_the_gateway_serves) pins the registration method of services/platform/hosted/gateway/openrpc.json to exactly two positional parameters, while the gateway has published the optional third parameter email_or_verification_token since 22.31.202 (its record: publish the handler optional email_or_verification_token parameter)."
symptom = "22.33.1493 attempt 1 fails only this case (57 of 58 pass): left signer_public_key, registration_signature, email_or_verification_token against right signer_public_key, registration_signature; the gateway document is the producer of record for the method it serves."
fix = "22.33.1493 continues: the case asserts the two required parameters, that the third is published as not required, and that the request supplies every required parameter; the CLI sends the token only when the command carries one."

[gotcha.3183]
title = "services/agent/qualification/pay2/required.rs line 7 replaces every failing Result with the context string and the words error contents redacted, so pay2_input_test_gap_executes_the_funded_sdk_and_mcp_workflow (22.33.1569 attempt 4) fails at tests/support/funded_scenario.rs line 535 (payer_wallet.wait_for Batched, 60 seconds) with no error class, reason or code in the log."
symptom = "The attempt-3 tree re-qualified after 22.31.494 landed (the tree includes it); the loopback peer printed that it verified the current EVM receipt v2 immediately before the batched wait failed, so the failure sits between the verified receipt and the Batched commitment the payer wallet waits for."
fix = "22.33.1569 continues: the helper keeps the context but appends the error variant and reason (an SDK error carries no credential), the scenario then names the refusing or timing-out step, and the fix follows that fact."

[gotcha.3184]
title = "Within the hour after 22.31.548 landed, six more attempts died on the single stale site at services/human/crates/layerx-human-service/tests/native_send_producer.rs line 659 (gotcha 3180): 22.31.534 attempt 4 in its own build (its build command compiles the Human service test targets), and 22.33.1536 attempt 5, 22.33.233 attempt 6, 22.33.261 attempt 5, 22.33.14 attempt 6 and 22.33.217 attempt 6 in the dependent-crate check, which compiles the Human service test targets even for the ai-market programs crate because it builds every path dependency through the members that consume it."
symptom = "Each attempt built its own targets (exit 0 where the build did not include the Human service) and never reached its verify; every open Rust task in the agent, programs and tools trees reaches the same site through the dependent-crate check until 22.31.558 lands."
fix = "Decision 2628: while a shared test target is red on main, the open tasks whose gates compile it wait behind the repair task instead of spending attempts on the identical failure; the six attempts re-qualify behind 22.31.558 and five eligible Rust tasks are held behind it."

[gotcha.3185]
title = "22.31.557 attempt 1 (the intent compiler protocol-3 key rotation repair, services/human/crates/layerx-intents) built clean and then failed the dependent-crate check on the same stale site, services/human/crates/layerx-human-service/tests/native_send_producer.rs line 659 (gotchas 3180 and 3184), before its verify ran: the intents crate is consumed by the Human service, so its dependent-crate check compiles the Human service test targets."
symptom = "The repair task 22.31.558 was in flight when 557 was launched (557 was already running when decision 2628 landed), so the hold could not reach it; 22.31.496 waits behind 557 and now, through it, behind 558."
fix = "22.31.557 re-qualifies behind 22.31.558 with its attempt-1 tree standing (decision 2628); no other open task outside the hold compiles the Human service through its dependent-crate check."

[gotcha.3186]
title = "22.31.558 attempt 1 ported native_send_producer.rs line 659 to consent_public_key, built every Human service test target (exit 0) and passed the dependent-crate check, then failed its verify: the case genuine_human_owner_session_consent_preview_and_reopen reads the recorded fixture path from the environment variable PAXEER_X_HUMAN_NATIVE_SEND_PRODUCER_FIXTURE at line 573 and panics when it is absent, so the verify command written in batch 505 named a case that cannot run in the qualification environment."
symptom = "The task exists only to make the target compile again (gotcha 3180); the ported assertion is exercised wherever the recorded fixture is present, and the repair is proven by the compile of the target and the dependent-crate check."
fix = "Decision 2630: the verify of 22.31.558 compiles the producer test target with --no-run; attempt 2 re-qualifies the attempt-1 tree with the corrected command."

[gotcha.3187]
title = "22.31.547 attempt 3: the first SDK V2 consent request that crosses the daemon RPC Prepare path against the Anvil-backed preview fixture (services/agent/crates/layerx-agentd/tests/native_send_preview_evm.rs, included by path into the layerx-sdk test) is answered 403 PolicyRefusal owner.refused, while the in-process owner preview for the same account succeeded one step earlier; the second case then fails with a PoisonError on the bootstrap peer because the first panic held the fixture lock."
symptom = "owner.refused is the mapping of HumanOperationError::Refused in the owner_error helper of the agent RPC routing module (the file beside agent_rpc_adapters.rs); on the V2 path rpc_prepare_native_send (human_runtime.rs near line 6961) reaches it from the body digest check, the wire conversion, the prepared cache lookup, the observed head sequence comparison, and native_send_purpose_owner (near line 7049, landed by 22.31.548), which in turn refuses from native_purpose_owner (peer subject, uid, tenant and session origin checks, then the identity head sequence, verification level, revocation and PrimaryKey authority checks), from a bound_address answer that is None or zero (an eth_call at pending to the addr precompile with GET_EVM_ADDR_BY_LAYERX, which the fixture chain peer serves for the account key), from a node head number different from the observed head sequence, and from the permit boundary; none of these names itself on the wire."
fix = "22.31.547 continues: the test bisects the refusal by calling the owner resolution steps directly with the fixture values, aligns the fixture where the fixture is wrong, and records a finding where the daemon check is wrong for a real network; the fixture file joins the task touches."

[gotcha.3188]
title = "22.33.1569 attempt 5 surfaced the redacted error: the payer wallet wait for Commitment::Batched returns RpcError::Pending after the full 60 seconds, although the loopback peer serves the committed receipt (rung committed, blockNumber 0x2, inclusion material), px_getCommit at height 2 and eth_getBlockByNumber 0x2."
symptom = "In layerx-sdk rpc_verification.rs receipt_at_commitment, a Batched or Finalised wait without caller-pinned commit evidence requires the client node_commit trust installed by RpcClient::with_node_commit_authority (rpc_commit.rs) and otherwise fails with MissingFinalityTrust; the funded scenario (tests/support/funded_scenario.rs) builds the payer wallet without it, and read_before_deadline turns every transport failure inside the deadline into None, so a loopback peer thread that panics (its assertions on px_getCommit params or an unrecorded method) is reported as Pending rather than as the panic."
fix = "22.33.1569 continues: the scenario installs the node commit authority and coverage for the funded peer, the peer thread panic is joined into the test failure, and the per-poll method and rung are logged until the Batched receipt verifies."

[gotcha.3189]
title = "22.31.539 attempt 3 and 22.31.478 attempt 5 (a Go and native-library task whose dependent-crate check still compiles the Human service through the agent crates it links) failed on the stale site at native_send_producer.rs line 659 (gotcha 3180) before their verify ran; both were already running when decision 2628 landed."
symptom = "The attempt-5 record of 22.31.478 cites revision 8cc1e9b86f8c31729dd4c66cccbf3105e7bce74b while the committed tree is b81618c97e303792a69b9531123f4093af9bf4ef, so the gates run once at the committed revision on re-qualification."
fix = "Both re-qualify behind 22.31.558 with their trees standing (decision 2629)."

[gotcha.3190]
title = "22.33.1537 attempt 6: the attempt-5 ruling (gotcha 3181) asked evidence_inventory to turn a current EVIDENCE_VERSION 2 record into the ReceiptEvidenceRecord that serve_evidence builds; no such conversion exists. ReceiptEvidenceRecord, PersistedReceipt (budget/hold.rs), recover_tenant_budget (human_runtime.rs near line 2319), budget rebuild and reconcile and EvidenceAuthority::verify_receipt all take RawReceiptEvidence, the version 1 shape with a signed batch header and a Merkle inclusion proof, while the current record (TransactionReceiptEvidence) carries the canonical node receipt, its Ed25519 signature under the governed node receipt key and the block height. The attempt also fell to the stale site of gotcha 3180 before its verify ran."
symptom = "On a restart every receipt stored through store_verified_if_absent since the version 2 producer landed is inventoried under without_evidence, recover_tenant_budget answers EvidenceMissing for the tenant, and the tenant is held from writes until an operator intervenes; the audit finding receipt_v2_producer_not_wired (22.31.364) repaired the producer side only. The managed agent inventory reader (managed_agent.rs near line 604) walks only the two existing lists."
fix = "Decision 2632 and task 22.31.559 give the recovery path a verified current-evidence kind; 22.33.1537 continues after it with its startup assertion intact."

[gotcha.3191]
title = "22.31.557 attempt 2 (the first verify run of the tree, after attempt 1 fell to the stale site of gotcha 3180): the compile and differential suites pass and three of the four repair cases pass; v3_public_key_did_rotation_matches_the_governance_actor_derivation stops at its first assertion, the DID length, with left 75 and right 74."
symptom = "The case builds a public-key DID as the prefix did:layerx: followed by 64 hex characters and pins the length as 10 plus 64; the prefix is 11 bytes (did, a colon, layerx, a colon), so the DID is 75 bytes. The derivation assertions that follow (the actor identifier equals did_id_for_protocol for protocol 3, payload bytes 4 to 36 carry it, the disclosure round trip reproduces the rotation bytes) have not run yet."
fix = "22.31.557 continues: derive the length pin from the prefix and the key encoding, re-run, and read the derivation assertions; the attempt-2 tree stands."

[gotcha.3192]
title = "22.31.547 attempt 4 (the first verify run of the attempt-3 tree): the SDK library suite passes, the owner preview on the loopback EVM node fixture passes, and the genuine first V2 Prepare through handle_rpc is answered 403 PolicyRefusal owner.refused before owner resolution (repair_22_31_547.rs line 307, left 403 right 200); case 2 then fails on the poisoned fixture lock as a cascade."
symptom = "The daemon publishes two different preparation identifiers for one native send. native_send_owner_preview_on_surface (human_runtime.rs near line 6237, the assignment near line 6369) sets purpose.preparation_id to the SHA-256 digest of the unsigned EVM call, the digest verify_native_owner_send_purpose (capability/binding.rs near line 3922) requires; prepare_gated (near line 15029) caches the preparation under the SHA-256 digest of the native authorization envelope bytes and gives the cached entry that same digest as its durable key (the cache insert near line 15130); rpc_prepare_native_send (near line 6961) looks the preparation up under hex(purpose.preparation_id) in the cache and under DurablePreparation::store_key of that identifier in the store (near line 6994) and answers Refused when absent, so a correct first Prepare never finds its own preparation. rpc_prepare_native (near line 5599) and rpc_prepare_native_effect (near line 6503) follow the same lookup pattern. The attempt refused to rewrite cache entries or forge records and recorded the alignment request instead."
fix = "Decision 2634 and task 22.31.560 align the identifier; 22.31.547 requalifies after it with its attempt-4 tree intact."

[gotcha.3193]
title = "22.33.1569 attempt 6: build 1 failed on a local buffer named bytes shadowing the decoder (E0434, E0618), repaired in build 2; the verify then runs one case green and the funded SDK and MCP case stops at the grant issue (funded_scenario.rs near line 592, PAY2 SDK grant issue: MissingFinalityTrust) after the Batched Send verified."
symptom = "The SDK holds one immutable NodeCommitCoverage per RpcClient: RpcClient::with_node_commit_authority(authority, coverage) requires the covering height inside the authority window and a non-empty activity id list, and every non-Executed wait (rpc_verification.rs near line 334) verifies against that one coverage or answers MissingFinalityTrust. The scenario provisions coverage for the Send on a fresh payer client once the Send activity id is known, then issues the grant through the same client, whose coverage does not name the grant activity."
fix = "Decision 2635: the scenario builds a dedicated client with coverage for each activity before each non-Executed wait; dynamic coverage acquisition inside the SDK is an owner decision recorded for the owner."

[gotcha.3194]
title = "22.31.478 attempt 6 (the first verify run of the fixture after the actor funding repair): asset registration, mint, deploy and the rewards account registration execute with result code 0, then the CREATE program call (activity 0x00090003, repair_478_test.go line 285) returns LXP_ERR_NON_CANONICAL at the require.Zero of the execute helper (line 231) before Fund runs."
symptom = "The call payload layout of EncodeCallPayload matches the hand-built call the lxphost programs registration test executes with result 0, and the capability bytes (event, shared read, shared write as 3, 7, 8) are in the CapabilitySet canonical key order, so the payload envelope is not the refusal. The kernel surfaces a guest refusing its own input as LXP_ERR_NON_CANONICAL (the pay5 native round-trip fixture pins exactly that code for a malformed transfer_from input), and the programs accounts module answers the same code for a malformed account name or kind; the fixture create calldata is produced by the current tree while the before guest is built from the base revision 71ea2b5."
fix = "22.31.478 continues: find the refusing site (guest input decoding of the create calldata under each guest, or the account path) and repair the fixture or the guest inside the task paths without touching either allowance."

[gotcha.3195]
title = "22.33.1536 attempt 6 (the first verify run of the attempt-5 tree): five cases in three main test targets included by path fail on fixture facts: handshake_gate.rs lines 279 and 312 expect Err(Sequencer(Malformed)) from receipt_keys on an empty keys list and receive Ok([]); export.rs line 22 reports Contract from verify of the state artifact in two cases; finality_rungs.rs line 25 reports InvalidCommit for an accepted quorum case."
symptom = "decode_receipt_keys (layerx-client sequencer.rs near line 947) decodes an empty keys array as an empty list and boot.rs readiness (near line 152) refuses it with GateError::NoReceiptKeys, which is what the main versions of both handshake cases assert; export verify (export.rs near line 184) answers Contract from OfflineExport::validate, from the fact-to-bundle count check or when no bundle established the block hash, and the fixture composes a state fact with a JSON rows account proof that the daemon never produces; the accepted quorum cases run through verify_with_header, which checks header height, chain id, version_block 11, validators hash, header.block_hash() against commit.block_hash, a non-empty transaction list and the data root over SHA-256 transaction hashes, so one of those fields disagrees in the fixture triple of header, commit and loopback block."
fix = "22.33.1536 continues with the production refusal variants restored and the two fixtures made consistent with the code paths they exercise."

[gotcha.3196]
title = "18.1578.1 attempt 4 (the first verify run): the consumer proof against the disposable node runs 536 seconds and stops at the first read refused by the daemon route, Unavailable(verified native evidence is unavailable), which is the consumer mapping of a 503 verified_read_unavailable answer; the proof prints the raw node answer on node refusals and nothing for a daemon refusal, so neither the read (receipt, proof, checkpoint, availability or the checkpoint read after reopen) nor the NativeReadError variant behind the 503 is known."
symptom = "native_read_response in the agentd proof maps every NativeReadError except InvalidRequest, CursorMismatch and ResultTooLarge to 503 with a fixed body; NativeReadRoute::read answers Unavailable, Verification, Connection, Receipt, Availability or Evidence."
fix = "18.1578.1 continues: the daemon-side proof carries the error variant in the 503 body and the consumer proof prints status and body on an unexpected refusal, so the next run names the read and the production fact."

[gotcha.3197]
title = "22.31.534 attempt 5: the build stopped on No space left on device and a linker Bus error while compiling the layerx-human-service test targets; no gate reached the tree."
symptom = "The qualification environment ran out of disk during the build; the attempt tree is unchanged since attempt 2."
fix = "Requalify at the same tree."

[gotcha.3198]
title = "22.99.77 attempt 15 (the first verify run of the attempt-12 tree): twelve native cases return status -3 at the harness status assertion (host_boundary.rs line 480 in nine cases, rewards_native.rs line 1678 in two, f03_evaluator_host.rs line 2739) after the attempt-12 harness change raised the response capacity word from 16 to 16384 in tests/programs/test_ai_host_boundary.c; before that change only the harness CREATE returned -3."
symptom = "-3 on the harness status line is the kernel result LXP_ERR_NON_CANONICAL (include/layerx/lxp_result.h line 38), the return of lxp_kernel_execute_activity that the harness execute helper prints (test_ai_host_boundary.c lines 220 to 289); it is not the guest STATUS_BOUNDS of host/mod.rs line 34, which never reaches the harness status. The capacity 16384 passes both bounds (call.c line 2522 against LX_PROGRAMS_MAX_RESPONSE_BYTES 1048576 and execute.rs line 4365 against MAX_CALL_RESPONSE_BYTES), so the refusal is one of the 93 non-canonical return sites of call.c, most likely the payload length check near lines 2495 to 2555, because the capacity word changes the encoded payload length. The Rust test asserts the status only and never prints receipt.result_code."
fix = "Print the kernel status and the receipt result code on every harness call, bisect the capacity word (16, 4096, 16384) and realign the payload the harness writes with the length the decoder expects."

[gotcha.3199]
title = "22.99.77 attempt 15: every_routed_operation_fits_the_protocol_cpu_fuel_cap (fuel_budget.rs line 1674) fails with OPEN_EPOCH at height 896 and 46461 bytes of shared state attempting 1000626 and at height 1024 (49325 bytes) 1000008, ADMIT_TASK at 1030 (50141 bytes) 1000049 and at 1033 (50494 bytes) 1000002 against the DEFAULT_CPU_FUEL cap 1000000; CREATE fits at 186538."
symptom = "The guest was built by make paxai-host-boundary-build with the distribution wasm-opt version 120 the qualification environment installs; attempts 10 and 11 were 2 to 39 units over the cap at the same heights, so the fuel still scales with the shared state size and the margin is 2 to 626 units."
fix = "Remove or bound the state-size proportional work on the OPEN_EPOCH and ADMIT_TASK paths and prove the budget with the wasm-opt version the qualification environment installs, not a local build."

[gotcha.3200]
title = "22.31.539 attempt 4 (requalify of the attempt-3 tree): the lib suite and five test targets pass; bootstrap_bind_layerx fails at bootstrap_bind_layerx.rs line 58 with bootstrap peer: Os code 2 NotFound because the test starts anvil (LAYERX_TEST_ANVIL or anvil on the path, lines 164 to 166) and the qualification environment had none; the second case fails on the poisoned lock at line 816."
symptom = "The attempt-4 change to that file is one label (CHECKPOINT_FINALISED to COMMITTED). Earlier attempts of other tasks passed the same target because their implementation step installed anvil before the gates ran; a requalify run has no implementation step."
fix = "The qualification environment now installs the Foundry toolchain when a named test target reads LAYERX_TEST_ANVIL; requalify at the same tree."

[gotcha.3201]
title = "22.33.217 attempt 7: 21 of 22 cases pass; view_binding::header_reports_exact_state_identity_and_explicit_absence (tests/view_binding.rs line 332) expects NotYetProduced for feature 0 of an uncreated market and receives ContentUnavailable; the main version of the test (line 325) asserts the same."
symptom = "In src/queries.rs feature_availability (line 531) maps feature 0 through decoded(policy_of(shared), produced), and policy_of answers Err(NOT_FOUND) on an empty PolicyLifecycle section, which the decoded helper maps to ContentUnavailable; the read_header doc names an uncreated market as NOT_FOUND and the 22.31.253 rule (do_15 of 22.33.217) reserves NotYetProduced for an enabled feature with no produced state and NotEnabled for a disabled feature."
fix = "feature_availability reports NotYetProduced for an empty enabled section before any decode runs; ContentUnavailable is reserved for a present section whose decode fails."

[gotcha.3202]
title = "22.33.261 attempt 6: five cases pass; reward_native_reopen (tests/repair_22_33_261.rs line 1463) fails at line 1490 with commit process failed because the commit phase child panicked in the ok wrapper (line 63) with real path refused: ApplicationError(1)."
symptom = "ApplicationError(1) is BAD_VERSION (src/errors.rs line 64, code 0x0001) of the ai-market program. The commit phase write_recovery_store (lines 1329 to 1368) runs the settled fixture, commit_market, the claim request, commit_payout for the claim, decode_shared_state, the request-close call, the refund-free request and commit_payout for the refund; commit_payout wraps decode_envelope, rewards::apply, RewardsAccount::for_ledger and value_adapter::plan in ok, and the wrapper message names no call. Attempt 5 moved the refusal from status 526 to 1 without naming the refusing call."
fix = "Name the refusing call in the wrapper message, find the structure the fixture encodes under a version the production decoder refuses, and realign its version byte; the reopen assertions stay."

[gotcha.3203]
title = "22.33.1569 attempt 7: the grant issue now verifies with activity-specific coverage; the SDK grant draw fails at tests/support/funded_scenario.rs line 677 expecting ledger operation 6 and receiving 2 (amount 2 expected, 0 served)."
symptom = "The loopback peer encodes one fixed protocol receipt shape in execution_receipt (tests/support/funded_peer.rs near lines 640 to 660: module 12, module version 1, operation 2, the uhpx asset digest, amount 0) for every eth_sendRawTransaction whatever ledger operation the bound disclosure constructs (LedgerSend, LedgerIssueGrant, LedgerDraw). The pay2e qualification test on main (pay2e_test.rs lines 598, 735 and 834) expects operation 6 with the drawn amount for a draw and 7 for a grant issue from the network, and the scenario copies those assertions. The attempt recorded the mismatch as a pre-existing receipt contract fault; it is a fixture gap inside the task paths."
fix = "The peer derives module id, operation tag, asset and amount of the served receipt from the construct method of the bound disclosure; the fixed EVM shape stays only for a call that constructs no ledger operation."

[gotcha.3204]
title = "22.31.496 attempt 4: the Rust proof passes (2 cases) and the Go keeper gate stopped on No space left on device while linking the auth module test binary; the keeper cases never ran."
symptom = "The qualification environment ran out of disk during the Go link, the second such stop this week after 22.31.534 attempt 5 (gotcha 3197); the attempt tree carries the protocol-3 actor identity rotation the attempt-4 ruling asked for."
fix = "Requalify at the same tree."

[gotcha.3205]
title = "18.1578.1 attempt 5: the dependent-crate check at candidate 6c8a7b27 fails with E0433 unlinked crate openssl at tests/proof_native_reads.rs line 666 because src/main.rs then included that test by path into the host crate (layerx-agentd-host declares base64 0.22.1 and no openssl); the final revision 1ef2b0ee61 includes only proof_serve_errors.rs (line 59, as main) and the agentd proof is included only from layerx-mcp/tests/proof_native_reads.rs line 27, so the build passes, but verify and the dependent-crate check never ran at the final revision; the consumer proof (the mcp observe case, lines 283 to 300) first sees the receipt read answer rung receipted and then proof.get answer 503 verified_read_unavailable."
symptom = "In read/native.rs proof() the Unavailable answer arises at three sites: the served route carries no result source (near line 171), the receipt lookup is not Verified (176 to 187), and block_by_number at the receipt height answers None (189 to 196); a verified receipt read excludes the second site. PERPS_DATA_TEST_COMET is a field read from the env file the local node script writes with --env-out, not the process environment."
fix = "Attempt 6 runs build, dependent-crate check and verify at the final revision and distinguishes the first and third Unavailable sites from the consumer side before changing the route."

[gotcha.3206]
title = "22.31.559 attempt 1: every budget accounting assertion passes; the one failure is tests/repair_22_31_559.rs lines 332 to 339 expecting the recovered ceiling snapshot consumed to equal the receipt amount (left 0, right 1000000000000000000)."
symptom = "human_runtime.rs builds RecoveryInputs with empty ceiling_receipts and unknown_ceiling_reservations (line 2376 on main, 2406 in the attempt); Ceiling::rebuild in capability/consume.rs (lines 70 to 115) sums consumed only from reservation-bound receipt applications; reconcile (218) only sets the protocol reconciliation flag; snapshot (230) reports that consumed. Tenant budget receipts of either evidence kind are counted in budget_accounting.receipt_consumed, which do_5 asked for."
fix = "The assertion states the production fact (ceiling consumed 0, reconciled after reconcile); decision 2640."

[gotcha.3207]
title = "22.33.1536 attempt 7: the u64::MAX voting power case expects acceptance under the header-bound path and receives InvalidCommit."
symptom = "verify_with_header (finality.rs line 571) calls read::checkpoint, which refuses a commit whose total voting power exceeds i64::MAX / 8 (checkpoint.rs lines 660 to 670, u64 checked adds), while the un-headered observe_block path (finality.rs verify, u128 sums) accepts; main asserts the lenient case only through observe_block (finality_rungs.rs lines 314 on)."
fix = "Under the header path both u64::MAX cases expect InvalidCommit; the accepted expectation stays on observe_block; decision 2641."

[gotcha.3208]
title = "22.33.1536 attempt 7: the export fixture serves ICS23 storage witnesses from programs/tests/vectors/ics23-evm-storage-app-hash.json over a loopback eth_getProof listener, encodes them as JSON rows into account_proof, and verify answers Contract."
symptom = "agentd src/export.rs verify (line 184) calls verify_account (672 to 714), an RLP Ethereum account trie reader (six-field proof node list, four-field account); no producer on main fills account_proof (human_runtime.rs line 21892 sets None; retain_bundle at export.rs 428 has no caller; produce is called at human_runtime.rs 16540); the daemon state witness path is ICS23 (proof_bundle.rs lines 163 to 170 read the storage witness, verified at 473 with verify_storage_witness under the checkpoint app hash; checkpoint.rs line 573 types account_proof as StorageWitness slices; tests/export.rs lines 238 to 249 build an RLP trie fixture). Decisions 2204 and 2639 rule that EVM storage proofs are ICS23 witnesses through the app root."
fix = "Task 22.31.561 realigns the consumer and gives produce a real producer; the 1536 export cases requalify behind it; decision 2642."

[gotcha.3209]
title = "22.35.8 attempt 1: vitest fails with TypeError reading APP_PROFILE at configs/app/app.ts line 19 from an import cycle between apps/explorer/lib/cookies.ts and configs/app, pre-existing on main; the attempt breaks it in lib/cookies.ts (importing getEnvValue from configs/app/utils), outside the task touches; tsc passes, vitest and the build are unverified at the final revision."
symptom = "A module cycle at a leaf (cookies reading the composed app config while the config imports cookies) is broken at the leaf by importing the utility module, not the composed config."
fix = "Requalify the same tree with lib/cookies.ts added to the touches; decision 2643."

[gotcha.3210]
title = "22.31.217 attempt 6 (first verify run): 6 passed, 10 failed; six Disclosure(MalformedPayload) at tests lines 337 and 485 replaying corpus constructs through the native preparation binder; three Snapshot from read_native_effect_budget_sources (lines 1055, 1160, 1221); one Refused from verify_budget_proof at line 852 (counter above height); one panic at line 409 because the program_settlement case carries no receipt."
symptom = "The binder accepts only the ConstructMethod signature table (layerx-crypto disclosure/call.rs lines 106 to 127: call, openAccount, register, mint, burn, send, issueGrant, draw, revokeGrant, budgetCreate, budgetCreateNative, grantSession, budgetFund, budgetDefund, grantCapability, recordLifecycle, transfer and the bank send) and refuses MalformedPayload for chain id 0, gas limit 0 or a priority fee above the max fee (prepare/disclose.rs lines 22 to 27); budgetFundNative, budgetRevoke, deploy, upgrade, deprecate and exitValue are deployed ABI (precompiles/layerxpay/abi.json; sdk/platform/conformance/operations.json lines 506 to 532) with no agent-side constructor. Snapshot requires a nonzero now, caps did equal to the actor, a nonzero state root, level at least STATE_PROVEN, freshness global and observed head sequence equal to the prepared observed head sequence, batch number equal to the caps observed height and the node block number equal to both (program_sources.rs lines 430 to 447 and 40 to 52), and fee_policy.rs lines 126 to 137 require a header at that height with nonzero hash and state root. verify_budget_proof has about 25 Refused sites (budget_proof.rs lines 21 to 365)."
fix = "Attempt 7 states one production fact per failing case; decision 2644."

[gotcha.3211]
title = "22.33.1569 attempt 8: the peer serves module 1 operation 7 amount 0 for the grant issue, then the SDK peer_receipt stage fails with RpcError::Verification and the grant issue execution reports Transport; the task record calls the SDK verifier EVM-only and out of scope."
symptom = "verify_node_receipt (layerx-sdk rpc_verification.rs lines 502 to 645) binds the protocol asset to the SHA-256 of paymentDenom, from and to to the 20-byte JSON addresses left-padded to 32 bytes, the context hash to keyId, signingKey to the policy key, the batch id to the height word and the summary effect to gasUsed, index, sponsor, contract address, fee denom, return data length and the vmError digest (the final check at line 643); the node decoder applies the same binding (rpc/sequencer_receipt.go lines 579 and 584, addr32). The attempt-8 peer encodes the ledger counterparty account ids into from and to and the grant asset into the receipt asset (funded_peer.rs lines 615 to 650 and 700 to 706), so the receipt is refused exactly as the node would refuse it. pay2e_test.rs on main (lines 726 to 737) verifies operation-7 receipts through the same SDK path."
fix = "Attempt 9 keeps the receipt header words as the node encodes them and carries the ledger operation in the module, operation and amount words; decision 2645."

[gotcha.3212]
title = "22.31.478 attempt 7: deploy of the ABI-5 guest succeeds (host configured with ProgramsGuestABI 5) and the profile-1 rewards account registration (activity 0x00090006, derivation bytes paxai/rewards/v1) answers LXP_ERR_VERSION_UNSUPPORTED (repair_478_test.go line 244 via 301) for both guests."
symptom = "lxp_programs_account_register reaches deployed_program (src/modules/programs/accounts.c lines 292 to 301), which calls lxp_programs_account_guest_validate (432 to 449): ABI 2 passes without a profile; any other guest ABI under the state-commitment protocol needs the program-account-profile record, and a missing record (profile_read answering UNKNOWN_FIELD) is reported as VERSION_UNSUPPORTED (446 to 448). The kernel writes that record only in the profile-2 opt-in execute (1091 to 1100) whose validation (451 to 464) requires ABI 2, so a guest above ABI 2 cannot create its own record on chain; the programs registry crate composes the same records for registered programs (layerx-programs-registry chain_accounts.rs near 295) and the Go tests write the program-owner and program-account-profile records directly under the module prefix 1,0,9 (precompiles/layerxprograms/view_accounts_test.go lines 79 to 80; task 13.27.1 do_12)."
fix = "Attempt 8 writes both records in fixture setup before the registration; decision 2646."

[gotcha.3213]
title = "22.31.496 attempt 5: the Rust proof passes (2 cases) again and the Go keeper gate stopped on No space left on device while linking the auth module test binary, the third such stop in one day after 22.31.534 attempt 5 and 22.31.496 attempt 4 (gotchas 3197 and 3204)."
symptom = "A Rust test build followed by a Go test link of the auth keeper module exceeds the disk the qualification environment provides for a mixed Rust and Go gate; the tree is the attempt-4 tree the attempt-5 ruling accepted."
fix = "Requalify at the same tree; the engineering process raises the disk available to mixed Rust and Go gates before the next run."

[gotcha.3214]
title = "22.31.539 attempt 5: build exit 0, dependent-crate check exit 0, the library suite passes (5 cases) and bootstrap_bind_layerx fails: agent_register_prepares_bind_layerx receives a 403 PolicyRefusal owner.refused Terminal where it expects 200 (tests/bootstrap_bind_layerx.rs line 704), and the session case fails on the poisoned fixture lock as a cascade."
symptom = "The refusal is the one 22.31.547 attempt 4 met (gotcha 3192, decision 2634): the daemon keys the native send preparation under the envelope digest while the purpose names the EVM call digest, so every correct bind request is refused until 22.31.560 lands; the attempt tree differs from main in that test by one line (the checkpoint state COMMITTED)."
fix = "Requalify behind 22.31.560 at the same tree; the tree does not change."

[gotcha.3215]
title = "22.99.77 attempt 16: the native harness now prints the kernel status per CALL and every one of the 12 failing native cases shows snapshot_create 0, begin_level 0, schedule_decode_validate 0 and prepare_activity -3 with receipt result_code 0; the layout check (capacities 16, 4096 and 16384) passes, so the payload decodes; the fuel suite still lists OPEN_EPOCH at 896 and 1024 state bytes (1000122 and 1000002), ADMIT_TASK at 1033 (1000011), five SealEvidence cases at 1088 (up to 1000188) and three RevealScore cases at 1104 (up to 1000037) over the 1000000 CPU cap."
symptom = "-3 is LXP_ERR_NON_CANONICAL raised inside lxp_kernel_prepare_activity (src/protocol/lxp_kernel.c line 2698) after the call reaches the programs module: the native binding in programs/crates/layerx-programs-runtime/src/ffi_call.rs maps every executor error of a profiled CALL to NON_CANONICAL (line 2896) and refuses a profiled CALL whose execution leaves no replay record (lines 2899 to 2902); a replay capture that exceeds the profile (replay_record.rs from_captured, lines 62 to 90: more leaves than maximum_boundaries or a witness over maximum_bytes) is such an executor error. The harness profile (tests/programs/test_ai_host_boundary.c lines 357 to 382) sets 128 boundaries and 1048576 bytes while the kernel maximum is 4096 boundaries (include/layerx/programs.h lines 676 to 677); a budget exhaustion would have produced a record with result code 2 instead of -3 (execute.rs lines 4515 to 4545)."
fix = "Prove each failing CALL through the runtime executor with the same replay profile in a Rust test first (decision 2647), raise the harness profile to the kernel maximum when the leaf count is the limit, and bring the four over-cap operations under the cap through the joint-section readers; the kernel mapping stays."

[gotcha.3216]
title = "22.33.1569 attempt 9: the funded workflow now verifies the batched Send (module 12 operation 2) with pinned node authority, coverage and inclusion, then the grant issue receipt the peer serves as module 1 operation 7 is refused by the peer self-check: verify_node_receipt answers Verification and the diagnostic verify_logs answers ReceiptShape; the task record calls the layout check out of scope."
symptom = "sequencer_layout (layerx-proof sequencer_logs.rs lines 241 to 253) refuses a protocol receipt whose module id is at or below KERNEL_MODULE_COUNT 11, and the SDK verifier runs it on every node receipt (rpc_verification.rs line 592); the node binds the same way: BuildReceipt and NewReceipter refuse module ids at or below KernelReservedModules 11 (node/sequencer/receipt.go lines 215 and 319; receipt_source.go lines 78 and 129), the operation word is the EVM transaction type and the amount word the transaction value (receipt.go lines 420 and 421), and the SDK itself asserts module 12 operation 2 on its receipts (program_lifecycle.rs lines 353 to 354). A ledger precompile call to 0x101A is an EVM transaction; the node receipt shows the ledger operation only through the precompile events PayerGrantIssued and PaymentDrawn (precompiles/layerxledger/abi.json, payments.go lines 18 to 20) and the return data, never through the module, operation or amount words; decision 2645 was wrong on those words."
fix = "Serve every receipt with the node words (module 12, operation the transaction type, amount the value), carry the precompile events in the receipt logs and log effects, and prove the ledger operation from the verified logs (decision 2648)."

[gotcha.3217]
title = "22.31.534 attempt 6 (requalify on the attempt-5 tree): the Rust build stopped with rustc-LLVM ERROR IO failure on output stream No space left on device while compiling the layerx-human-service stream_journal_domain test, then the gate ended without an evidence record when its candidate step could not write a temporary index on the full disk; the run was recorded as an environment loss and the requalify note is retained."
symptom = "The human-service test build alone fills the disk the qualification environment provides; the attempt-5 stop (gotcha 3197) was at the Go gate of the same task, so the fill point moves with the stage reached, and the 20:36Z separation of the dependent-crate check target does not reach a build-stage fill."
fix = "The engineering process now builds Rust gates without debuginfo and records free disk at the start of every build and verify; the retained note re-runs the attempt-5 tree unchanged."

[gotcha.3218]
title = "22.31.496 attempt 6 (requalify, gotcha 3213): the Rust proof passes (2 cases) and the Go keeper gate stopped again on No space left on device while linking the auth module test binary, the fifth such stop in one day; the attempt-5 ruling said the environment was corrected before this run, which was not so: the correction shipped after this run started."
symptom = "The run started at 20:26Z with the gate as it stood; the debuginfo change of gotcha 3217 reaches runs started after 20:55Z."
fix = "Requalify once more at the same tree under the corrected environment; the ruling text names the correction honestly."

[gotcha.3219]
title = "22.31.560 attempt 1: 2 of 3 cases pass; native_send_first_prepare_and_reopened_prepare_match_owner_preview fails because the first Prepare answers 503 owner.unavailable after SigningPreparation::restore succeeded; the log shows two tenants in one request, the principal tenant (human-v1:7099...) and the transport tenant bootstrap-service."
symptom = "rpc_prepare_native_send (human_runtime.rs from line 6976 of the attempt tree) checks retention under DurablePreparation::store_key with the principal tenant (lines 7009 to 7012), then prepare_gated (line 7034) retains under the peer tenant and stores the authorization-reference key with put_local mapped to Unavailable, and native_send_purpose_owner (line 7050) restores through verify_native_owner_purpose (capability/binding.rs line 2938) with the session tenant, mapping every restore error to BindingError::Corrupt, which owner_error turns into Unavailable; the originating error is lost at both sites."
fix = "One tenant, the principal tenant the durable store key already uses, for retention, cache key, authorization reference and restore; every Unavailable mapping carries the originating error in the diagnostic (gotcha 3202)."

[gotcha.3220]
title = "22.33.1569 attempt 10: the receipt words are verified (the loopback peer serves module 12 operation 2, the SDK grant draw verifies), then cumulative_evidence(prior_draw).required(PAY2 first draw cumulative ingress) at tests/support/funded_scenario.rs line 867 fails with Evidence because the receipt carries no canonical activity."
symptom = "layerx_mcp::tools::wallet::cumulative_evidence (services/agent/crates/layerx-mcp/src/tools/wallet.rs lines 306 to 312) needs canonical_activity and batch_evidence; the SDK sets canonical_activity None on every receipt it builds (rpc_verification.rs line 355) and binds it only in Wallet::send and Wallet::payment (wallet.rs lines 80 and 228) on the receipt of the first wait; Wallet::wait_for (line 194) and wait_for_with_commit (line 204) return the bare RpcClient receipt, so a receipt the SDK waited to Batched or Finalised for its own transaction has no canonical activity and no consumer can build cumulative ingress from it."
fix = "A production SDK gap: later commitment waits on an SDK-submitted transaction keep the canonical activity (decision 2650, task 22.31.563); the scenario uses that path for its prior draw."

[gotcha.3221]
title = "22.31.478 attempt 8: registration and CREATE pass (CPU fuel 188494); Fund stops at kernel allowance 10000000 with CPU fuel 999978 and LXP_ERR_GAS_EXHAUSTED terminal 3 (repair_478_test.go line 403); 22.33.223 attempt 8 shows the same operation from the Rust side: guest FUND at height 129 refused Resource BudgetExceeded Cpu limit 1000000 attempted 1000057, and every_routed_operation_fits_the_protocol_cpu_fuel_cap fails on it."
symptom = "The Fund operation decodes and re-encodes more of the shared state than it writes; its CPU fuel is 57 units over the 1000000 protocol cap, the same decode-cost class the joint-section readers removed from ADMIT_TASK in 22.99.77 attempt 17 (947701 after, 1000011 before)."
fix = "Fund reads only the sections it writes through the joint-section readers; 22.31.478 proves it from the Go harness and 22.33.223 requalifies behind 478 instead of repeating the repair."

[gotcha.3222]
title = "22.33.223 attempt 8: two failures, both the Fund fuel cap of gotcha 3221 (market_protocol_boundary close_settlement_coverage_through_compiled_guest and fuel_budget every_routed_operation_fits_the_protocol_cpu_fuel_cap); the task requires 443, 485, 497, 550 and 558 but not 22.31.478, so its attempt ran against a guest that 478 is repairing."
symptom = "A consumer task whose own gate exercises an operation under repair in a producer task must require that task, or it fails on the producer defect and relaunches for nothing."
fix = "need(22.33.223, 22.31.478) and a requalify note once 478 lands; the attempt-8 tree is kept."

[gotcha.3223]
title = "22.99.77 attempt 17: the runtime-executor proof ordered by decision 2647 (tests/support/native_replay.rs line 85, execute_authorized_authenticated under a 1000000 CPU DeclaredBudget with the harness replay profile) names the cause of every -3: ExecutionError Fault Resource BudgetExceeded Cpu limit 1000000 attempted 11014910 for all eleven native cases; the fuel suite still lists OPEN_EPOCH at 896 and 1024 state bytes (1000101 and 1000002), two SealEvidence cases at 1088 (1000058 and 1000017) and three RevealScore cases at 1104 (1000024, 1000011 and 1000011) over the cap, while ADMIT_TASK now fits (947701 and 962249)."
symptom = "Under a replay profile the execution observer charges a step commitment per step to the guest CPU meter (programs/crates/layerx-programs-runtime/src/host/mod.rs lines 696 to 710: step_commitment_fuel plus arbitration_step_commitment_fuel_with_host, then meter.charge_cpu(total_fuel)); commit.rs line 883 prices it at STEP_COMMITMENT_BASE_FUEL 32 plus STEP_COMMITMENT_FUEL_PER_BYTE 1 per encoded state byte, so a market state of tens of kilobytes costs about eleven million CPU units in commitments and no profiled CALL can fit the 1000000 cap whatever the guest does; the seven over-cap operations are ordinary decode cost."
fix = "Decision 2649: step-commitment fuel of a replay profile is metered outside the guest CPU cap (task 22.31.564); 22.99.77 waits for 564 and brings the seven residual operations under the cap meanwhile."

[gotcha.3224]
title = "22.99.52 attempt 2: the last verify (at e7199c1cc7) failed 2 cases in layerx-mcp tests/repair_22_31_223.rs line 1039 (open daemon web route Refused: the agent store is unavailable, store I/O failure, store root already has a writer); the agent then fixed the fixture writer ownership and the final build passed, but the repair budget was spent, so the final tree cc4c6478ac was never verified."
symptom = "A tree whose last change followed the last verify has no verify result; a code ruling on it would be a guess."
fix = "Requalify attempt 3 on the attempt-2 tree as it stands."

[gotcha.3225]
title = "22.31.217 attempt 7: 12 passed, 6 failed: two Disclosure(MalformedPayload) at tests lines 548 and 722, three Snapshot at lines 1408, 1507 and 1568 from read_native_effect_budget_sources, and one dependent case; attempt 6 had ten failures of the same two classes and the attempt-7 record again calls the disclosure binder and the fee reader out of scope."
symptom = "Both producers are deterministic on main: prepare/disclose.rs bind (lines 21 to 26) answers MalformedPayload only for a call with chain_id 0, gas_limit 0 or max_priority_fee_per_gas above max_fee_per_gas; budget/fee_policy.rs native_fee_policy (lines 123 to 137) answers Snapshot only when height is 0, the endpoint block_number is below height, block_by_number(height) is empty, the header number differs, the header hash or the state root is zero, or the re-read at lines 216 to 223 differs. Each failing case therefore feeds a call or an endpoint state that meets one of those conditions; the production readers are not the defect."
fix = "Attempt 8 fixes the fixture per failing case against the named conditions and prints the originating refusal in every assertion; no production interface is missing."

[gotcha.3226]
title = "22.33.1510 attempt 6 (base b6aa2ed90e, which includes the 22.31.534 repair 4e8983196e): 1 passed, 2 failed at tests/support/approval_owner.rs line 1158, approval budget actor: Corrupt from client.verified_budget_after; the record calls it a pre-existing out-of-scope mismatch between a daemon label 6 and a Human rung byte."
symptom = "The daemon answers ApprovalBudgetAfterV2 in human_runtime.rs approval_budget_after (from line 9877) and writes out.u8(state.verification), the budget-state verification label (6 for COMMITTED; VerificationLevel::from_wire_rank in layerx-types verify.rs), while the Human decoder (services/human/crates/layerx-human-service/src/server/agent_runtime.rs lines 4322 to 4332 and decode_rung at line 4477) reads a rung rank 0, 1 or 2 and answers CorruptResponse for anything else; 22.31.534 taught both sides to judge the label through budget_state_is_committed but left the wire byte as the label. The daemon has receipt_rung_code (human_runtime.rs line 11539) for exactly this conversion."
fix = "Decision 2651 and task 22.31.562: the daemon writes the rung rank; 22.33.1510 requalifies behind 562."

[gotcha.3227]
title = "22.33.260 attempt 3 (its first verify; attempt 2 was the dependents break): the build and the dependent-crate check pass and all 8 repair_22_33_260 cases fail with Error: ApplicationError(1) before any routed refusal is printed, so the error comes from the fixture builders (small_fixture, grow, activate_fixture) or the codec helpers, not from an applied operation."
symptom = "ApplicationError(1) is BAD_VERSION (programs/crates/layerx-programs-ai-market/src/errors.rs line 64); its producers are codec.rs schema (line 428, a section whose leading u16 is not SCHEMA_VERSION 1), admission.rs AdmissionTable::decode (line 660) and the consent decoder (line 1148, leading u16 not 1), and aggregation_codec.rs line 198. The eight cases share prove_admissions, so one site explains all eight; the attempt record names none of them."
fix = "Attempt 4 labels each fixture step with its name on the error path, names the refusing decoder and the bytes it read, and repairs the fixture encoding or the producer accordingly; one fact for eight cases."

[gotcha.3228]
title = "Legacy approval holds: approval.rs lists the holds of a tenant through store.list_object_ids(tenant, ObjectKind::PreparedActivity), decodes each and runs validate_replayed on it (lines 205 to 225); a hold stored under the legacy magic LXAPHLD4 has no presentation, so validate_replayed answers LegacyTimeUnits and the whole tenant listing aborts on the first legacy hold; the store migration (store/migrate.rs, CURRENT_SCHEMA_VERSION 3) has no step that rewrites those values."
symptom = "The timed hold form LXAPHLD5 (encode_hold, approval.rs line 1485) wraps the legacy bytes under two u64 presentation fields, created_at_unix_seconds and activity_expires_at_unix_seconds, and the listing was written for stores that only ever held timed holds; the v2 to v3 bump changed header bytes only."
fix = "Add store schema version 4 whose migration rewrites every LXAPHLD4 PreparedActivity value to LXAPHLD5 with created_at 0 (not recorded) and activity_expires_at equal to the prepared expiry; the listing then validates every hold (decision 2653, task 22.31.565)."

[gotcha.3229]
title = "A profiled native CALL whose runtime execution fails for any reason answers the kernel status -3 LXP_ERR_NON_CANONICAL (ffi_call.rs lines 2886 to 2902): the replay bound of the capture, a guest fault and a non-canonical payload are indistinguishable at the kernel boundary, and gotchas 3215 and 3223 cost two attempts to tell them apart from the Rust side."
symptom = "The native binding maps every ExecutionError of a profiled CALL and a missing replay record to NON_CANONICAL; LXP_RESULT_CODE_LIST (include/layerx/lxp_result.h) has no code for either condition and the -7xx range ends at -739 LXP_ERR_ESCROW_LINK_MISMATCH."
fix = "Add X(LXP_ERR_REPLAY_BOUND, -740) and X(LXP_ERR_GUEST_FAULT, -741), map the replay-bound error and the guest fault to them in ffi_call.rs, and carry both through every code enumeration (decision 2655, task 22.31.566)."

[gotcha.3230]
title = "The SDK commitment verifier takes its node commit coverage pinned by the caller: with_node_commit_authority(authority, coverage) (rpc_verification.rs lines 68 to 85) stores one NodeCommitCoverage built from a fixture batch proof, and the tests build it by hand from the batch tx and proof of the fixture record (tests/support/audit_22_30_99.rs lines 330 to 353, tests/repair_22_31_494.rs lines 728 to 753); a wait for any other height verifies against the wrong coverage."
symptom = "The committed path fetches px_getCommit per height (line 285) but never fetches the batch the coverage describes, although the node already serves px_getSequenceBatch (rpc/px_kernel.go line 134: height, tx and the proof total, index, leafHash and aunts validated against DataHash)."
fix = "Fetch the coverage per wait from px_getSequenceBatch at the committed height, keep only the authority pinned by the caller, and leave a fixture override for tests (decision 2656, task 22.31.567)."

[gotcha.3231]
title = "The explorer home page shows Total blocks from the stats field total_blocks, which stats_controller.ex line 99 fills with BlocksCount.get() (apps/explorer/lib/explorer/chain/cache/counters/blocks_count.ex), a count of the consensus blocks the indexer has stored; on the public network the tile reads about 17 million while the chain head is the latest block number."
symptom = "A row count of indexed blocks equals the block height only on a chain indexed completely from genesis; the explorer indexes from a configured first block, so the count and the height diverge."
fix = "Serve total_blocks as the latest consensus block number (Chain.block_height, explorer/chain.ex line 1322) and the same value in chain_controller.ex line 19 (decision 2659, task 22.35.9)."

[gotcha.3232]
title = "Documentation is spread over sub-project directories instead of docs/ at the repository root: services/platform/docs holds 87 files including 13 code samples of which three are root pnpm and npm package entries, the single vendored project directory under addiqate/ carries 104 documentation files and its own root CHANGELOG, CODEMAP, WHY, MAINTAINERS, CODE_OF_CONDUCT, CONTRIBUTING, SECURITY and CITATION files, services/wallet/docs, apps/wallet/docs and apps/explorer/docs hold 8, 7 and 6 files, and apps/launchpad/production_checklist.md, apps/perps/data_api.md, services/agent/COMPATIBILITY.md, services/explorer/UPSTREAM.md and services/interop/PORTABILITY.md sit at sub-project roots."
symptom = "Each sub-project was imported with its own documentation tree; the root docs/README.md index never gained rows for them and a reader has no single place to look."
fix = "Move every sub-project documentation tree under docs/<project>/, remove sub-project root documents (keeping README, tooling and agent instruction files), rewrite links, and give the vendored project directory its home under tools/ (decision 2663, tasks 22.36.1 to 22.36.6)."

[gotcha.3233]
title = "SECURITY.md has the sections Report privately, Handling and disclosure, Response targets, Bug bounty, Supported versions and Scope, and no place that records an accepted, time-bound exemption; the wasmer advisory GHSA-55f3-3qvg-8pv5 (cosmwasm-vm 1.5.12 pins wasmer 4.2.2) is accepted until the next runtime upgrade but documented only in wasm-runtime/libwasmvm/repair_22_31_450.kvx, whose disposition still reads retain pinned deterministic engine; owner dismissal required, and tools/qualification/audit_repairs/test_repair_22_31_450.py line 108 asserts that wording."
symptom = "The repair record was written before the owner ruling, and the public security document has no exemptions section to carry a ruling."
fix = "Add a Known exemptions section to SECURITY.md naming the advisory, the pinned versions, why the modules are not exposed and the review trigger, and update the repair record disposition and its test together (decision 2662, task 22.32.191)."

[gotcha.3234]
title = "docs/readme/PUBLIC-RPC.md (node table, lines 27 to 40), docs/site/docs/reference/public-rpc.md line 18 and README.md line 75 list the fourteen public nodes api1 to api14 without saying which node keeps full history: pax_sequencerReceipt answers -32000 on a pruned node for an old height, and a reader cannot tell a pruned answer from a defect."
symptom = "The documents were written when every node pruned alike; the retention ruling (api2 keeps the archive, the others prune) was never recorded."
fix = "State the retention policy in all three documents with a short guidance paragraph on which node to query for historical receipts and state (decision 2658, task 22.32.190)."

[gotcha.3235]
title = "22.31.563 attempt 1: the wallet waits are implemented (wallet.rs plus 36 lines, rpc_verification.rs plus 6) and the build fails twice with E0463 can-not-find-crate at tests/repair_22_31_563.rs line 455: the test declares extern crate layerx_programs_registry (then layerx_programs) to construct the SimpleProof inside the ReceiptCommitEvidence of the Finalised path."
symptom = "The SDK commit-evidence interface (rpc_verification.rs wait_for_with_commit line 116, wallet.rs line 204) takes layerx_client::rpc::receipt_commit::ReceiptCommitEvidence, whose transaction_proof field is layerx_programs_registry::chain_proof::merkle::SimpleProof; layerx-client depends on that crate (its Cargo.toml line 10) and layerx-sdk does not, and no SDK test on main constructs the evidence, so the type cannot be named from the SDK tests."
fix = "Add layerx_programs_registry as a dev-dependency of layerx-sdk with the path and pinned version the client uses, update the layerx-sdk entry of services/agent/Cargo.lock by that one dependency, and extend the task paths to both manifests."

[gotcha.3236]
title = "22.99.52 attempt 3 (requalify): the build passes and the whole-crate verify fails one target, tests/repair_22_31_223.rs: existing_grants_still_require_verified_receipts panics with unrecorded node request, an eth_call of accountId(bytes32,bytes32) (selector 3f050cbc) to the ledger 0x101a at the node root path; the fixture answers that view only at the path /rpc (lines 704 to 730) and its root route serves recorded node traffic by exact match (lines 740 to 747)."
