fix = "run make build programs/target/debug/liblayerx_programs_sandbox.a before go test"

[gotcha.1552]
area = "task 3.2.8"
symptom = "LXPCodeName returns \"\" for any value <= -1000, including absent values, not LXP_UNKNOWN"
fix = "take unknown probes above the fatal limit"

[gotcha.1553]
area = "task 4.2.11"
symptom = "a cargo target dir shared across worktrees compiled layerx_program_sdk from another worktree (two crate versions, E0308)"
fix = "use a per-task CARGO_TARGET_DIR"

[gotcha.1554]
area = "task 4.2.11"
symptom = "rewards_native/roster_transition need build/paxai-host-boundary/manifest"
fix = "run make paxai-host-boundary-build before the cargo test"

[gotcha.1555]
area = "task 6.5.47"
symptom = "the central RPC backend admission in gateway rpc.rs runs before route handlers, so retiring a handler alone yields -32010 not -32601"
fix = "the lx_ refusal must sit ahead of admission (task 10.6.2)"

[gotcha.1556]
area = "task 6.5.46"
