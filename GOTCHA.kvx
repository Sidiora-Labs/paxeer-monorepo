[gotcha.575]
text = "A worker may freeze its file manifest directly in result.json; use the named handoff rather than guessing manifest.json."

[gotcha.576]
text = "Human web API uses the unified /human prefix while retained browser routing expects root /v1; preserve real routing and exact assertions until their fixture contract is resolved."

[gotcha.577]
