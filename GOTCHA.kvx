[gotcha.1339]
area = "rpc/subscribe.go"
symptom = "rpc package tests bind fixed ports (7777 and up)."
fix = "concurrent go test ./rpc/ runs in sibling worktrees panic with address already in use; TestSubscribeNewHeadsAutobahn can never pass while encodeCommittedBlock refuses every Autobahn head; geth rpc registers every exported method of a service, so setters on SubscriptionAPI would become callable eth_* methods - keep publish/attach surfaces off API types."

[gotcha.1340]
