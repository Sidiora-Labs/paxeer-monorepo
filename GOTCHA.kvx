[gotcha.1598]
area = "task 2.4.9"
symptom = "go build on a package pattern that matches only _test.go files exits 0 and compiles nothing"
fix = "a build_cmd on a test-only package checks nothing; add go vet or go test -run XXX -count=1 to compile the tests"

[gotcha.1599]
