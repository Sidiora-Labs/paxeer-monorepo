[gotcha.1017]
title = "railway build slots"
observed = "redeploying all 22 services at once leaves most queued on 'Waiting for build slot' until they FAIL with 'Deployment does not have an associated build' and no logs; redeploy at most three at a time (pro plan)"

[gotcha.1018]
title = "railway rejects VOLUME"
observed = "a Dockerfile with a VOLUME instruction fails the Railway build with 'dockerfile invalid: docker VOLUME at Line N is not supported'; drop the instruction and mount a Railway volume at the same path"

[gotcha.1019]
title = "next standalone on railway"
observed = "Next.js standalone server listens on the container hostname by default and Railway's healthcheck never reaches it; set HOSTNAME=0.0.0.0 and PORT in the image and serve a static /healthz route"

[gotcha.1020]
title = "verify_cmd fallback echo"
observed = "a verify_cmd of the form 'docker build ... || echo \"docker unavailable\"' returns 0 when the build itself fails; test docker availability in a separate step and let the build exit code through"

[gotcha.1021]
title = "dockerignore hides the shim"
observed = "the per-image Dockerfile.dockerignore files ignore docker/ wholesale; an image that copies docker/common/env-files.sh and its files.tsv needs the two '!docker/...' exceptions or the COPY fails with 'not found'"

[gotcha.1022]
title = "railway builds the last stage"
observed = "Railway builds a Dockerfile with no --target, so the last stage is what runs; a railway stage placed before the box stage is silently ignored and the box entrypoint starts without the env-files shim"

[gotcha.1023]
title = "box data root 0700 hides the volume from service uids"
observed = "the kernel and registry units created their /var/lib/layerx/<app> data root with mode 0700, so every in-container service uid (4020, 4030) got 'Permission denied' on /data/tls/<row> the moment the certificates existed; the data root needs 0711 and the per-row ownership the init applies"

[gotcha.1024]
title = "one LAYERX_TLS_DIR per ca.sh run, one volume per unit"
observed = "ca.sh issue writes every box row under the single LAYERX_TLS_DIR of the run; when the kernel and registry share a host the registry rows land in the kernel volume and must be moved to /var/lib/layerx/registry/tls where the registry container mounts /data"

[gotcha.1025]
area = "spec"
symptom = "An existing canonical requirement section is repeated with duplicate title and acceptance keys, blocking complete-file KVX parsing."
cause = "Separate planning additions reused a requirement identifier."
do = "Keep new requirement identifiers namespaced; record the pre-existing duplicate and validate added sections and dependencies separately without claiming a complete-file pass."

[gotcha.1026]
date = "2026-10-08"
text = "The default shell PATH omits the installed Rust tools; use /root/.cargo/bin explicitly for the admitted rustc/cargo 1.91.1 toolchain."

[gotcha.1027]
date = "2026-10-08"
text = "Codex CLI granular profiles treat exact regular-file write roots as directories and fail with ENOTDIR. Keep project files read-only to the writer and materialize only declared files from an exclusive private output directory."

[gotcha.1028]
date = "2026-10-08"
text = "A deny-by-default CLI profile must grant the exact installed CLI binary read/execute access because its Linux sandbox helper re-executes that binary."

[gotcha.1029]
date = "2026-10-08"
text = "The auxiliary isolation probe exited 1 because self process metadata, nested user namespace creation and synthetic-directory writes remained possible. Preserve that result; a separate real runtime probe exited 0 for approved access and excluded host read/patch denial. These are distinct results."

[gotcha.1030]
date = "2026-10-08"
text = "Private operational evidence contains large copied source trees and one-line metadata. Inventory filenames at bounded depth before selecting operational reports; a broad recursive text scan produced truncated output and was stopped."

[gotcha.1031]
date = "2026-10-08"
text = "No cortex_guard executable or callable tool was available in this session. Do not report it as run; retain the explicit owner-authorized action scope and use available Codify scope checks without claiming equivalence."

[gotcha.1032]
date = "2026-10-08"
text = "rg was unavailable inside the minimal author sandbox (exit 127); the writer used grep on the same approved input. Host rg availability does not imply child sandbox availability."

[gotcha.1033]
date = "2026-10-08"
text = "A fresh-worktree full Codify initialization remained CPU-bound after more than eleven minutes. The coordinator stopped only its own initialization process and requested sync of the two declared Python files; no task build or behavior gate was rerun for indexing."

[gotcha.1034]
date = "2026-10-08"
text = "Workspace qualification first refused without a reason label because the runtime producer recorded UNRUN_UNCHANGED and the validator expected UNRUN. The bounded repair bound the exact producer status and added safe refusal/testcase diagnostics without changing the failed infrastructure result."

[gotcha.1035]
date = "2026-10-08"
text = "Codify advisory review without the named agent selected an older task and snapshot; use an explicit task packet and CG_AGENT for scoped ownership. Scoped guard still reported Python standard-library/name-resolution warnings; the canonical behavior gate and Codify graph-touch checks passed without force."

[gotcha.1036]
date = "2026-10-08"
text = "Codify CLI work open emits human-readable text by default. Capture it as a log and retain the opaque cg work update revision; do not rerun admission solely to change the output format."

[gotcha.1037]
date = "2026-10-08"
text = "Use an exact bounded filename inventory before opening private task metadata or neutral task-graph inputs; inferred filenames omitted their author or planning component and were absent."

[gotcha.1038]
date = "2026-10-08"
text = "The protocol author emitted all nine declared files but timed out before the complete framing handoff. File presence alone does not admit qualification; preserve the private candidate and record all gates UNRUN."

[gotcha.1039]
date = "2026-10-08"
text = "Reserve qualification time inside the task limit and finish exact framing allocations early. A source continuation stopped at its fixed deadline cannot be treated as completed implementation or used to claim a passing gate."

[gotcha.1040]
date = "2026-10-08"
text = "CLI permission overrides require TOML inline maps rather than JSON object text. Three fresh parallel authors refused invalid configuration before source execution; exact original failure logs were retained and the serializer was repaired without changing confinement."

[gotcha.1041]
date = "2026-10-08"
text = "The common codec test reported eleven passing cases, but Codify rejected the Cargo.lock touch. Explicitly staging the ignored lockfile did not resolve the graph-touch check; retain both code and check, record implemented-not-qualified, and do not rerun the passing behavior test or force completion."

[gotcha.1042]
date = "2026-10-08"
text = "Codify recognised the lockfile through the task-tagged commit and all twelve source-touch checks passed without force or another behavior test. Retain the earlier failure and distinguish implemented graph status from completed qualification."

[gotcha.1043]
date = "2026-10-08"
text = "A fresh CLI author exited zero without source after confusing parent-controller restrictions with its own source-author role and attempting unavailable delegation. Require explicit direct-author authority, complete owned-file inventory and whole-task handoff; exit zero alone does not establish implementation."

[gotcha.1044]
date = "2026-10-08"
text = "Derive SDK and hosted-service task paths and Cargo package names from the actual source tree before dispatch. A mistaken abbreviated prefix requires identical-byte private artifact relocation and exact handoff correction; never invent a facade crate to match it."

[gotcha.1045]
date = "2026-10-08"
text = "NativeOwnerOutcome verification supports owner modules and prohibits monetary effects; Programs rewards must use the actual Programs outcome verifier and exact transfer/state join. A verifier name alone does not establish the supported module or authority scope."

[gotcha.1046]
date = "2026-10-08"
text = "Noninteractive qualification shells may omit the Rust toolchain directory from PATH. Resolve installed tool paths before qualification; a launcher failure before executing rustfmt or cargo is not a build or behavior run."

[gotcha.1047]
date = "2026-10-08"
text = "Codify work open accepts --task rather than a positional task ID. Use the explicit flag and retain an unsuccessful invocation separately; do not rerun a successful work-open command merely to change log formatting."

[gotcha.1048]
date = "2026-10-08"
text = "Fresh full-repository graph initialization can consume the task time budget. Reuse an already indexed clean manager worktree with a separate branch and identical-byte materialization; preserve the interrupted initialization log and original private worktree."

[gotcha.1049]
date = "2026-10-08"
text = "A Codify claim and work-open record do not set canonical task status to in_progress. Run cg spec start explicitly before qualification. A done preflight rejection for pending status executed no behavior gate; preserve the completed build and do not repeat it."

[gotcha.1050]
date = "2026-10-08"
text = "Codify completion may outlast a bounded subprocess timeout after its behavior gate has passed. Retain separate verify and completion outcomes, publish an honest implemented checkpoint, and do not automatically repeat the unchanged gate or mark the task done."

[gotcha.1051]
date = "2026-10-08"
text = "Resolve the configured repository identity from existing verified project records before remote API reads; a local workspace directory name does not identify its remote owner or repository."

[gotcha.1052]
date = "2026-10-08"
text = "Codify work-open may time out before producing a packet. Record that tool outcome separately, retain complete source as unqualified, and never report formatting, a build or behavior verification that did not execute."

[gotcha.1053]
date = "2026-10-08"
text = "Large active KVX specifications expose quadratic parser entry lookup. A local indexed parser candidate passed ordered semantic parity and focused checks; use its explicit path for new task commands while retaining all graph and verification checks. Existing installed tools and already-passed gates remain unchanged."

[gotcha.1054]
date = "2026-10-08"
text = "Large parsed KVX specifications also require indexed repeated lookups. The local persistent lookup candidate preserves semantic parity and passed 769 focused checks; its publication guard completed in 0.22 seconds. Retain all checks and never repeat already-passed behavior gates merely to record them."

[gotcha.1055]
date = "2026-10-08"
text = "The local Codify scanner candidate preserves all graph and FTS writes while batching repeated FTS deletions per existing transaction chunk. Its single focused sync gate passed; large repository completion still timed out after the product behavior gate passed."

[gotcha.1056]
date = "2026-10-08"
text = "The AI simulation evidence module belongs under programs/crates/layerx-programs-registry, not the agent workspace. Use the exact existing producer path when granting source inputs."

[gotcha.1057]
date = "2026-10-08"
text = "Acceptance identifiers are case-sensitive. Preserve the canonical uppercase AI prefix when selecting metadata blocks."

[gotcha.1059]
date = "2026-10-08"
text = "The canonical spec completion command can exceed fifteen minutes after its focused gate has already passed, even with the indexed parser. Record the passed gate as the task evidence, set the status directly, and note the completion timeout once in the qualification log instead of repeating the gate."

[gotcha.1060]
date = "2026-10-08"
text = "The AI evidence validator checks the workspace admission's pinned checkout HEAD and branch before it reads any selector record, so every non-workspace selector refuses with git-head once that checkout moves. Re-pin the admission on the current candidate before running any selector gate, and reference each selector record from other_selector_records."

[gotcha.1061]
date = "2026-10-08"
text = "The Codify server spawns spec trace workers that can spin at full CPU for hours against a large spec. Check for stuck trace processes before running gates and stop them; they do not finish on their own."

[gotcha.1062]
date = "2026-10-08"
text = "A process kill by command-line pattern also matches the shell that issued it and ends the current tool call. Match on a bracketed character class or kill by process id."

[gotcha.1063]
area = "programs/ai-market"
text = "SharedState::section() ties the returned slice to the &self borrow, not to the state data; to get a section slice that outlives the decoded SharedState use codec::decode_state(bytes).sections[i] or the public feature_sections array."

[gotcha.1064]
area = "programs/ai-market"
text = "ReplayTable::record_success refuses revision 0, so a creating operation must build the initial replay records with the common replay codec to reach revision 1."

[gotcha.1065]
area = "programs/ai-market"
text = "The ai-market crate is no_std without alloc: decoded variable-length lists must be borrowed typed-or-encoded views (like codec::ScoreVector) and complete-content checks need a caller-supplied leaf scratch buffer; publisher checks go through evaluators::codec::verify_digest, not ed25519-dalek directly, so host errors stay separate from bad signatures."

[gotcha.1066]
area = "programs/ai-market"
text = "The programs workspace clippy lints are deny (all/pedantic/unwrap_used) but cargo build and cargo test do not run them; new crate code can pass its task gate and still fail the wave-level clippy gate."

[gotcha.1067]
area = "tooling"
text = "In a crate whose lib.rs is the only file under src/, a sed run from src/ against both ../src/lib.rs and lib.rs edits the same file twice and duplicates the module line."

[gotcha.1068]
area = "programs/ai-market"
text = "A reward ledger header in shared state keeps record count consistent with rows only when terminalization increments retained_epochs; the prune path must decrement it or check_rows refuses."

[gotcha.1069]
area = "programs/ai-market"
text = "Tests that glob-import both workers::* and registry_ops::* hit a compile ambiguity on CallContext and apply; qualify them through the module path."

[gotcha.1070]
area = "programs/ai-market"
text = "The common state frame reaches exactly 196608 bytes only when every section is at its cap; a real F01 policy section cannot fill its cap, so a full-size capture test needs framing-level filler sections."

[gotcha.1071]
area = "programs/ai-market"
text = "Workspace clippy denies unwrap_used and expect_used with no test allowance: clean tests return Result, and a derived Debug on a test error enum trips dead_code, so write Debug by hand. To see per-file findings while other files fail at deny level pass -- -W clippy::all -W clippy::pedantic -W clippy::unwrap_used -W clippy::expect_used."

[gotcha.1072]
area = "programs/ai-market"
text = "PrincipalId and RequestId refuse all-zero bytes; test helpers that build ids as [n; 32] must never use n=0."

[gotcha.1073]
area = "programs/ai-market"
text = "cargo clippy -p on one programs crate still lints the workspace SDK build script and fails there at deny level; use --no-deps, and while the crate lib still has deny errors add -- --cap-lints warn (or -W overrides) to get the test targets linted at all."

[gotcha.1074]
area = "programs/ai-market"
text = "ApplicationError does not implement std::error::Error; tests that use ? must return CodecResult<()>, not Box<dyn Error>."

[gotcha.1075]
area = "programs/ai-market"
text = "clippy::large_stack_arrays fires on const items too; fixed-capacity tables in the no_std crate must be initialised in place over the state section bytes and read through borrowed views, never as whole-struct consts or stack copies."

[gotcha.1076]
area = "platform/hosted"
text = "A standalone crate under platform/ needs an empty [workspace] table in its Cargo.toml, otherwise cargo attaches it to platform/Cargo.toml and refuses to build because it is not a listed member."

[gotcha.1077]
area = "fleet-landing"
text = "Parallel ai-market tasks each append pub mod lines to lib.rs, so the rebase at landing conflicts on the module list; the leader landing script must detect the conflict and resolve it by union, and the status flip to done must happen only after the fast-forward merge succeeded, never in the same unchecked command sequence."

[gotcha.1078]
area = "platform/hosted"
text = "A rustls StreamOwned write on a connection whose handshake failed calls complete_io and can block on the socket read timeout; never write a reply or close_notify unless the handshake completed."

[gotcha.1079]
area = "tooling"
text = "When filtering clippy output for owned files match the relative --> src/ and --> tests/ paths; absolute-path filters miss them."

[gotcha.1080]
area = "programs/ai-market"
text = "An unframed fixed-row region can use all-zero as the unused marker only because a valid reward row always carries a non-zero budget; any new row type needs its own non-zero sentinel field or explicit framing."

[gotcha.1081]
area = "programs/ai-market"
text = "Turning glob imports into explicit lists can drop names used only under cfg(target_arch = \"wasm32\"); host clippy still passes and only the wasm build catches it, so run the wasm build after any import cleanup."

[gotcha.1082]
area = "programs/ai-market"
text = "When a test helper's error type is the same as the refusal under test, ? can make a setup failure look like that refusal; keep them apart with a nested Result."

[gotcha.1083]
area = "tooling"
text = "clippy --fix can leave doc backticks malformed around parenthesised expressions, and a blanket text replace of helper() with helper()? also hits test names ending in that word; review every mechanical edit."

[gotcha.1084]
area = "programs/ai-market"
text = "F02 WorkerTable::decode consumes the whole IdentityRoster section strictly; any feature sharing that section (F03 evaluator region follows the worker table) must split the worker prefix by its count byte via authority::split_identity_section and keep the suffix when rewriting."

[gotcha.1085]
area = "programs/ai-market"
text = "ChallengeAssessment (0x0304) is ObjectLocal and not in registry_before_epoch, so a test envelope for it needs sequence 0 and a present roster or encode_envelope refuses it."

[gotcha.1086]
area = "layerxd"
text = "layerxd --serve needs a live Paxeer JSON-RPC at startup: the finality authority bind calls eth_chainId and fails with -904 if nothing answers; an unused-port RPC only works for bootstrap. Tests start a real paxd via tests/daemon/paxeer_x_runtime_fixture.py."

[gotcha.1087]
area = "layerxd"
text = "sequencer.env must not carry LAYERX_NODE_SEQUENCER_PRIVATE_KEY; launch through platform/hosted/node/sequencer-env.sh layerx_sequencer_environment. bootstrap.sh requires SETTLEMENT_CONTRACT and CHECKPOINT_REGISTRY at the anchor precompile 0x...1014."

[gotcha.1088]
area = "programs/ai-market"
text = "clippy too_many_lines (pedantic, deny) applies to library functions too: keep public composers under 100 lines by splitting the gates into helpers; wildcard_imports is denied, so test files need explicit imports."

[gotcha.1089]
area = "programs/ai-market"
text = "F01 CreateMarket yields lifecycle REGISTERED (1); roster rollover and admission must treat lifecycle 1 as live. PrincipalId's tuple field is private; build it with PrincipalId::new."

[gotcha.1090]
area = "programs/ai-market"
text = "F02 AcceptEnrollment sets effective_epoch = clock+1 even before the first epoch opens, which clashes with F08 bootstrap epoch 0; rollover applies the F02 effective epoch only to a changed key version, never to the first install."

[gotcha.1091]
area = "relay-archive"
text = "Content-addressed archive segments persist after a refused admit, so a missing-segment refusal test must run before any earlier step uploads that unit's segments."

[gotcha.1092]
area = "layerxd"
text = "make paxeer-build needs /usr/local/go/bin on PATH and writes ROOT/build/paxd regardless of BUILD_DIR; /usr/local/bin/paxd may be an old build without the layerxanchor module. The daemon keeps its LNI admission journal as the dot file checkpoints/.layerxd-lni-admission.log, part of native state."

[gotcha.1093]
area = "layerx-archive-codec"
text = "cmd/layerx-archive-codec submit speaks LNI minor 7 while the daemon answers minor 8, so the codec refuses with LXP_ERR_MALFORMED_ENVELOPE (-105); validate with `layerx-archive-codec activity` and submit through the Python LniClient at minor 8."

[gotcha.1094]
area = "layerxd"
text = "A clean shutdown always leaves the latest checkpoint at the head, so a restore test never exercises canonical replay unless it deletes the newest checkpoint pair first; replay from an older checkpoint had no coverage and fails with -101 for a Programs deploy batch. gdb is not installed on the build box."

[gotcha.1095]
area = "programs/ai-market"
text = "When several features share one state section, the writer's scratch must cover the whole section payload cap, not only its own maximum, because the other features' bytes are copied through unread; growing the scratch raises the published minimum-scratch constant (workers::CONTROL_SCRATCH_BYTES), so every caller must size from the constant."

[gotcha.1096]
area = "programs/ai-market"
text = "A full worker table plus a real F03 region (13825 bytes) never reaches the IdentityRoster cap (24568), so a capacity-refusal test needs opaque padding bytes, which only works because F02 copies the region without decoding it. too_many_lines (deny) also hits integration test functions: split long walks with a step helper."

[gotcha.1097]
area = "programs/ai-market"
text = "dispatch.rs is a selector metadata table, not a router: no crate-level execute entry point exists yet, each feature exposes its own apply with its own signature. The host-facing dispatcher is T-C02's deliverable; do not add partial per-feature routers."

[gotcha.1098]
area = "programs/ai-market"
text = "Test worlds must keep header.state_revision equal to SharedState.revision after every edit (registry_ops::apply and OpenEpoch refuse NON_CANONICAL otherwise); F06 fund bumps the revision itself through FundReplay, so never add a second increment. Before the first open the F08 required effective epoch is 0 and approvals expire at origin+64, so staff markets early."

[gotcha.1099]
area = "programs/ai-market"
text = "F08 approve/admit refuse evaluator-owner conflicts up front, so conflict states for A04 must be built with a direct AdmissionTable::insert of a staged meta plus an F03 grant, modelling restored committed state. clippy --all-targets prints nothing for clean integration test targets."

[gotcha.1100]
area = "layerxd"
text = "process->programs.fee_schedule in the daemon struct is a stale cache that nothing writes since c9f7d3a04; version gates must resolve the governed schedule through occupancy_parameters (receipt fee_schedule_version or active record), never read the cached field."

[gotcha.1101]
area = "layerxd"
text = "Replay must bind each activity with the batch prefix (batch_id plus activity_root) rebuilt from the published DA body, as live execution and the guarantor do, not the per-activity lxp_batch_identity_activity; on a batch-maintenance protocol header last_sequence covers the maintenance record, so the DA activity count is last-first, not last-first+1."

[gotcha.1102]
area = "fleet"
text = "If cd and export sit inside a backgrounded command chain, make runs in the leader repo's working directory; always cd to the worktree explicitly in the same foreground command."

[gotcha.1103]
area = "programs-module"
text = "agent/crates/layerx-types/build.rs reads every `LX_PROGRAMS_* = 0x...` line in include/layerx/programs.h as a module-9 activity ordinal and requires the *ABI_VERSION constants to ascend to SANDBOX_DESTROY = 4; non-activity constants there need another prefix (LXP_PROGRAMS_), and a new activity cannot raise the ABI without updating build.rs."

[gotcha.1104]
area = "programs-module"
text = "A module ctx stages at most LXP_KERNEL_MAX_STAGED_BLOBS (4) blobs per activity and lxp_programs_storage_stage_final stages value blobs plus the manifest, so seed one namespace per ctx; it never deletes the previous manifest or value blobs, so superseded blobs stay live until retired. lxp_programs_replay_capture_stage needs ctx->call_admission.present with matching fee/metering versions, activity_id equal to the capture id and global_sequence equal to capture->sequence."

[gotcha.1105]
area = "programs/ai-market"
text = "F08 allows only 4 successful enrollments per epoch and the counter resets only at an opening, so the first opening can freeze at most 1 worker beside the 3 required evaluators; enroll further workers inside an opened epoch."

[gotcha.1106]
area = "programs/ai-market"
text = "workers::apply (F02) bumps the shared revision but not the F01 header state_revision, so F01 transitions refuse its raw output NON_CANONICAL until the header is rebound; the router (T-C02) must keep the two in step. In a sealed task region the seal sits between the presence byte and the records, so hashing region[3..] is only right for an unsealed region. clippy struct_field_names rejects a test struct field named after its struct."

[gotcha.1107]
area = "programs/ai-market"
text = "Envelope::validate checks payload length per operation at encode time, so a wrong-operation fixture must use an operation whose bounds accept the payload (e.g. Heartbeat, 0..15965) or it is refused NON_CANONICAL before the handler runs. F03 authority::apply leaves the F01 header revision unchanged; re-encode through the section loader to keep header and shared revision equal."

[gotcha.1108]
area = "fleet"
text = "Clippy and rustfmt fixes are the format step, not repair cycles; the two repair cycles belong to build_cmd and verify_cmd failures only. Workers that spend the budget on lint must be sent back."

[gotcha.1109]
area = "layerxd"
text = "The LNI socket parent directory must be mode 0750 with the peer gid; mkdtemp gives 0700 and lxp_daemon_lni_serve then fails without detail. Programs transfer execution resolves the source account by authority->principal (the DID id); accounts opened from agent:<did>:main get a different id, so kernel-executed LX_PROGRAMS_TRANSFER fails UNKNOWN_ACCOUNT_NAMESPACE in fixtures."

[gotcha.1110]
area = "platform"
text = "Clippy on a standalone hosted crate does not lint its path dependencies; lint authority changes with `cargo clippy -p layerx-platform-authority --lib` from platform/. Test stdout is block-buffered when piped while stderr is not, so a FAIL line can precede the CASE lines that ran first in make logs."

[gotcha.1111]
area = "evidence"
text = "tools/paxeer-x/ai_evidence.py with no PAXAI_ADMISSION_RECORD/PAXAI_APPROVAL_RECORD set refuses at stage=authority reason=path-string before reading anything; with the workspace authority records set it refuses at reason=git-head because the pinned base no longer equals HEAD. The storage-prerequisite-evidence selector binds every producer revision to the single admission base_revision, so producers qualified at different revisions can never be consumed together without re-pinning one candidate. Lane-branch producer revisions are re-committed on landing; match them with git patch-id --stable, not merge-base."


[gotcha.1112]
area = "ai-market"
text = "The F03 challenge-identity preimage is 233 bytes (chain, program, market, epoch, evaluator, report, category, evidence, requester), not 265; count field widths from the spec instead of reusing remembered totals. evaluators::authority::apply does not re-bind the F01 header state_revision, so tests must re-encode with Parts::load(..).encode() or the next committed() read fails NON_CANONICAL. F03 report admission (evaluators::admission::admit_report) is reachable only through the F04 RevealScore path and the ChallengeAssessment selector routes to evaluators::admission::apply_challenge; the 228-byte RevealScore event is returned in a caller buffer because large_enum_variant is denied."


[gotcha.1113]
area = "ai-market"
text = "F04 commit/reveal: SealEvidence consumes evaluator sequence 1, so the first CommitScore is role sequence 2 and RevealScore 3; a commit expiry equal to the window end makes an out-of-window retry fail EXPIRED before the WRONG_PHASE check, so test the two refusals with separate expiries; a suspended market refuses new commits with F08_MARKET_PAUSED but still admits reveals of existing commits; after key rotation the next-epoch commit must bind the new key_version (old version KEY_MISMATCH, old epoch binding WRONG_EPOCH); RevealScore payload_min 364 refuses an empty report at the envelope as NON_CANONICAL, F04_NO_SCORES is only reachable through the direct decoders; the largest CurrentReports section is 12994 bytes against the 24568-byte cap, so the cap-overflow path is unreachable from valid input."


[gotcha.1114]
area = "programs"
text = "The native programs module registrations (programs_module_registration_v4 and the v4 storage-retirement variant, also the genesis module table) carry abi_version 4, and src/modules/programs/call.c refuses any CALL whose abi_version exceeds the registered module's, so a guest ABI 5 program fails pre-runtime with -101 on every host. Guests at ABI != 2 need an LXPA2 account profile before lxp_programs_account_register (else -101) and the LXPA2 opt-in needs runtime->state_feed plus a commit observer (else -103); a harness can deploy at ABI 2, register, then UPGRADE to ABI 5 with the same code hash. decode_envelope returns WRONG_ROSTER before UNKNOWN_OPERATION for selectors that require a roster. rustfmt on lib.rs walks every module, so format per file."


[gotcha.1115]
area = "ai-market"
text = "epoch::open_epoch refuses with WRONG_PHASE, not F06_EPOCH_ALREADY_RESERVED, while the previous epoch is still reserved; F05 aggregation::apply (BeginAggregation, ProcessAggregation with an 8-worker cursor, FinalizeAggregation) expects the router to derive AuthorityContext.aggregate_sealed from aggregation::progress(current).phase, to refuse any immediate caller, and to map Outcome::AlreadyApplied to a zero-event unchanged-state result; a retry with a different epoch, config or roster binding returns WRONG_EPOCH, WRONG_CONFIG or WRONG_ROSTER and CONFLICT only on an input digest mismatch; clippy pedantic also denies unused_self and match_wildcard_for_single_variants in test files."


[gotcha.1116]
area = "programs"
text = "PreparedProgramAccount's derived account hashes only program and seed, not the asset, so a ledger's asset can only be checked against an already-bound RewardsAccount; runtime ProgramSpend and Transfer402 staging and TransferCapability are pub(crate), reachable from a crate test only by executing a guest that calls the host functions; SDK PreparedProgramAccount::spend_grant takes an SDK Amount, not u128; the host-boundary C harness grants fixed capabilities {0,3,3,7,8} with no Transfer402, ProgramSpend or BalanceView grant, so native funding, spend and balance-sight paths need harness grants added."


[gotcha.1117]
area = "ai-market"
text = "epoch::open_epoch does not physically clear the previous epoch's F03 rows or commit records in CurrentReports: they read as absent through admitted_report/slot for the new epoch and the first new-epoch reveal rewrites the region, so assert logical absence, not byte retirement; dispatch::route frames a Retained F04 retry as AlreadyApplied whose payload is the 32-byte retained result digest, not the original record/receipt payload; a historical exact retry after rollover returns WRONG_EPOCH (EXPIRED once past expiry), there is no distinct historical-status frame; rustc dead-code analysis ignores derived Debug, so a test error enum wrapping ApplicationError and io::Error needs a manual Debug impl that reads its fields."


[gotcha.1118]
area = "programs-host"
text = "With programs_module_registration_v5 active, a guest ABI 5 CALL clears call.c's -101 version gate and then fails NON_CANONICAL (-3) inside layerx_programs_call_begin: first DeclaredBudget refuses cpu_fuel above DEFAULT_CPU_FUEL 1_000_000 (runtime meter.rs), then the AI market CREATE itself exhausts the cap (BudgetExceeded Cpu, attempted ~9.64M under the genesis WASMI_0_31_2 schedule); both map to -3. accounts.c lxp_programs_account_module_validate admits only ABI 2/3/4, so register v5 only after DEPLOY and ACCOUNT bring-up and track recorded_module_version per active registration. call.c's per-byte WASM callbacks (activity_byte, catalog_wasm_byte) reopen the artifact and re-hash the whole blob per byte, quadratic in guest size: a 385 KB guest costs ~25 min per CALL. After the Rust static lib rebuilds, make does not relink build/tests/paxai_host_boundary (order-only prerequisite); delete the binary to force the relink."


[gotcha.1119]
area = "indexer"
text = "layerx-indexer clippy can only isolate findings in owned files with --no-deps -- --cap-lints warn; without it, lint errors in platform/hosted/internal and then the indexer's own pre-existing deny-level findings (lib.rs docs, abi.rs, api.rs, codec.rs, config.rs, layerx.rs, paxeer.rs, existing tests) stop compilation before test targets are linted. The indexer has no ed25519-dalek dependency: verify Ed25519 through the rustls ring provider (default_provider().signature_verification_algorithms.mapping for ED25519) and sign in tests with rustls::crypto::ring::sign::any_eddsa_type on PKCS#8 v1 DER; the raw public key is the last 32 bytes of the SPKI."


[gotcha.1120]
area = "indexer"
text = "Running rustfmt on a crate's src/lib.rs reformats every child module; platform/hosted/indexer/src/paxeer.rs on main is not rustfmt-clean and gets rewritten, so format only the new files, never lib.rs. In the AI market state, section 4 (ReputationAdmission) on main holds only the F08 AdmissionTable whose decode rejects trailing bytes, so F07 reputation data cannot coexist there until a joint F07/F08 split is defined; the indexer reads the RP07 frame as the self-delimiting leading region through one seam (reputation_region). ReputationState insert/append/prune are pub(crate), so outside the program crate a populated F07 section can only be built by framing RP07 bytes and checking them against decode_section/encode_section."


[gotcha.1121]
area = "ai-market"
text = "Byte-exact expected-state builders must carry untouched sections raw: re-encoding a never-enrolled market through decoded WorkerTable/AdmissionTable turns empty sections into encoded empty tables and the bytes stop matching the real state. Withdrawing a pending policy on market close must append a CANCELLED history header (folding the oldest when four are recent) or validate_policy_records refuses because highest > current with no pending. clippy::similar_names flags stale/stage pairs in tests. REQUEST_CLOSE/ADVANCE_CLOSE (0x010A/0x010B) are still unrouted: the dispatch arm is closure::apply mapping Outcome::Applied to Step::Applied with the 115-byte F01 receipt as record payload and Outcome::Retained to Step::Retained, plus closure::SCRATCH_BYTES in the router scratch maximum; the phase 3 RefundFree Payout effect must be staged atomically with the committed state by the router once the F06 native transfer seam exists."


[gotcha.1122]
area = "ai-market"
text = "On an unfunded market the F05/F06 settlement section is empty; helpers that decode the reward state must treat empty as the initial ledger or `?` surfaces NOT_FOUND (0x0015) with no location. PruneEpoch of a terminal row with no eligible score returns Pruned(Present(allocation digest)), not Absent. rewards::Outcome needs #[allow(clippy::large_enum_variant, reason = ...)] because Box is unavailable without alloc (same pattern as registry_ops). Reward selectors 0x0601-0x0605 are implemented by rewards::apply (settle on wasm32, plan on the host through value_adapter) but still unrouted: the arm maps Applied to Step::Applied with Payload::Suffix, AlreadyApplied{subject} to Step::Unchanged(Payload::record(subject)) and Retained to Step::Retained, plus rewards::SCRATCH_BYTES in the router maximum; the host harness must grant Transfer402, ProgramSpend and BalanceView and resolve principal accounts by principal before the native Fund witness can run."


[gotcha.1123]
area = "webhooks"
text = "Pre-existing clippy denials in webhooks trusted.rs, hosted.rs, boundary.rs and main.rs stop clippy from compiling the test targets; lint new files with --no-deps and those lints passed as -W. codec::state_digest refuses anything that is not a valid encoded PAXAS1 StateFrame, so fixtures must build frames with codec::encode_state. The canonical queries::SnapshotBinding::encode refuses rank above 4, so rank-5 settlement anchoring is refused as InvalidRequest although the F10 contract says rank 5 is shown when achieved. layerx_proof::checkpoint has no public BatchHeader constructor; tests encode the 0x1701 header with the layerx_wire Encoder. libtest prints a child process's verdict on the same line as the test name, so parent tests must search within the line."


[gotcha.1124]
area = "git"
text = "The stash list is shared across every worktree of a repository. A `git stash` on main around a landing plus a `git rebase --autostash` (or a stash) running concurrently in a worker worktree swap contents on pop: main received a worker's uncommitted module edits and the worker tree received main's local script change. Never stash in a multi-worktree fleet; park a local uncommitted file by copying it aside and restoring it after the landing, and have workers commit before any rebase."


[gotcha.1125]
area = "indexer"
text = "Plain clippy on layerx-indexer stops at 72 pre-existing errors in store.rs, paxeer.rs, settlement.rs, config.rs, layerx.rs, api.rs, abi.rs, paxscan.rs, transport.rs, codec.rs and lib.rs, so dependent crates and tests are never linted; lint new files with `-- --cap-lints warn` and filter by file. Platform integration tests can use CARGO_TARGET_TMPDIR for file-backed SQLite scratch dirs. The layerx-programs-ai-market path dependency from the programs workspace resolves inside the platform workspace. The AI snapshot projection lives in indexer ai_market.rs (tables ai_stream, ai_snapshot, ai_participant, ai_outbox, ai_lease, ai_alert; SNAPSHOT_EVENT_TAG 0x0A10) and gateway ai_views.rs; neither the gateway entry nor the indexer follower calls them yet, and a certificate for another root at the same sequence is refused with BindingMismatch without quarantine."


[gotcha.1126]
area = "ai-artifacts"
text = "On Linux fs::remove_dir_all on a path that is a regular file fails with ENOTDIR and does not unlink it, so a session staging dir replaced by a file is a real purge failure on a root-run host. A test that edits the artifact store offline must stop the service child first: the process holds the whole state in memory and its next persist overwrites offline edits. The test-side TaskBinding region must be sorted by TaskId and start with a u16 count plus presence byte 0, and PolicySection::encode needs a buffer of Section::PolicyLifecycle.payload_cap(), not the encoded length. An artifact can only be bound to market state when its manifest context market equals derive_market(chain, program). In the service, with_id and idempotent are generic over the error type (call as with_id::<Req, _>), a refusal is stored as the request's disposition so a retry needs a new request_id, and the lock order is always store then ledger."


[gotcha.1127]
area = "programs-host"
text = "In a native harness an ACCOUNT activity run through lxp_kernel_execute_activity needs runtime->state_feed and kernel->observe_commit or it returns MODULE_DISABLED; harnesses drive the LXPA2 opt-in through module-level lxp_kernel_dispatch. Make targets that link PROGRAMS_RUNTIME_LIB call cargo and fail with exit 2 (env: 'cargo': No such file) unless /root/.cargo/bin is on PATH. lxp_programs_program_abi returns LXP_ERR_UNKNOWN_FIELD for an unknown program (the kv_get status passed through). A successful v5 CALL on the snapshot path also needs the transfer_set_root pre-copy in kernel_snapshot_apply_prepared_with_capture to cover module_version 5, otherwise lxp_receipt_bind_program_outcome fails FATAL_INVARIANT. The daemon still hardcodes the programs module version to ABI 4 in lxp_daemon_lni.c and lxp_daemon_process.c, so a node that registers v5 is refused by lxp_module_version_for_epoch until those follow the active registration."


[gotcha.1128]
area = "programs-host"
text = "A module ctx can stage at most 4 blobs (LXP_KERNEL_MAX_STAGED_BLOBS); every storage namespace write stages the manifest plus each non-empty value, so fixtures must seed multi-namespace storage across several ctx commits. At the legacy protocol the occupancy bridge init in CALL execute reads the owner account for every program-shared storage namespace and refuses UNKNOWN_FIELD before the runtime runs when no program account exists. The test-program-artifacts binary links liblayerx.a built without -DLXP_TESTING, so LXP_TESTING counters are invisible to that gate. call.c now resolves the root wasm, each catalog entry, each interface and each storage namespace once per bound call activity (cache released by call_activity_release, storage views dropped at storage_final_authorize, failures never cached, no cross-call reuse); payment_name_byte still does one account lookup per byte because it hashes nothing."


[gotcha.1129]
area = "programs-ai-market"
text = "The F08 enrollment window admits 4 successful admissions per epoch counting workers and evaluators together and resets only at OPEN_EPOCH, so a fixture with 2 workers and 3 evaluators must open its first epoch with one worker and enroll the second afterwards; retained_epochs counts completed rows (rises at terminalize, not reserve) and the 33rd reserve prunes the oldest prunable completed row; a crate test target that includes a native ABI 5 CALL takes ~40 minutes for that case alone until the fuel cap lands; the native harness manifest must exist (make paxai-host-boundary-build) before any native case runs."

[gotcha.1130]
area = "programs-ai-market"
text = "Four F03 refusal codes in the spec are unreachable or shadowed through the envelope: unsorted/duplicate score vectors return NON_CANONICAL (2) not F03_NONCANONICAL_VECTOR (780); an empty vector is refused NON_CANONICAL by the reveal payload_min (364 bytes) before F03_NO_SCORES (778) is checked; a changed program or market returns WRONG_PROGRAM (4) / WRONG_MARKET (5) not WRONG_DOMAIN (3); a different digest on a final slot returns CONFLICT (20) because the existing-report check precedes F03_REPORT_ALREADY_FINAL (775). Also the dispatch::route evaluator arm passes aggregate_sealed=false unconditionally and F03-A16 'suspension still allows commit' contradicts F04's F08_MARKET_PAUSED refusal; both left intact and recorded."

[gotcha.1131]
area = "programs-ai-market"
text = "F01 SUSPEND and UPDATE_METADATA payloads start with expected_revision:u64 (reason32 follows for SUSPEND; a wrong order is refused F01_STALE_REVISION 0x0103); the trailing optional u64 is the operator grant sequence and an owner sending a nonzero value is refused UNAUTHORIZED. codec::decode_envelope refuses PAXAI service envelopes (PAXAIS1 magic) as NON_CANONICAL and selectors 0x0281..=0x0286 decode natively as UNKNOWN_OPERATION. The largest canonical worker manifest under the grammar is 2366 bytes although the spec text says an 8192-byte admitted manifest; the 8192 figure is the input cap. Clippy pedantic large_types_passed_by_value fires on WorkerCurrent (304 bytes) in test helpers."

[gotcha.1132]
area = "agent-client"
text = "In the ai-market envelope an object-local operation (CLAIM and the other per-object selectors) must carry sequence 0 while role operations need a nonzero sequence; encode_envelope refuses the wrong one NON_CANONICAL before any preview runs. Workspace clippy on layerx-client stops at dependency errors (layerx-types program_lifecycle.rs missing # Errors docs) and the crate carries ~160 pre-existing pedantic findings outside the AI client files; lint owned files with --no-deps -- --cap-lints warn. The new platform/sdk/schema/paxai-v1.kvx and the --check-paxai generator arm change the mirror-v2 source and generator digests, so pipeline.kvx needs regeneration before the sdk check gate."

[gotcha.1133]
area = "programs-ai-market"
text = "F06 terminalize for a no-score epoch clears the row's entries and releases its slots, so anything that rebuilds the frozen roster after terminalization must read it from the pre-transition state (with_region's update closure now receives it). Evaluator grants expire after 32 epochs (expiry_epoch_exclusive = effective + 32) and F02 enrollment expiry must outlive long multi-epoch fixtures. F01 CREATE does not allocate the F07 reputation region in the joint ReputationAdmission section yet; readers of the joint section (aggregation progress, admitted_report, commit-reveal slot, sealed_task_set, roster, queries, F10 projections, F08) must read the F08 table through the joint split. The spec's BindingMismatch for an old-model lookup is F07_SEGMENT_MISMATCH / WRONG_CONFIG in code."

[gotcha.1134]
area = "agent-sdk-typescript"
text = "SecretBytes built from a Node Buffer can be used once: Buffer.slice shares memory and withBytes zeroes the stored secret after the first use, so pass a plain Uint8Array. native-v1 program.call posts the signed activity as a raw binary body, not JSON hex, and the activity signature is ed25519 over sha256(\"LXP/v1/signature-preimage\\0\"||unsigned). encodeNativeProgramCallV1, decodeNativeProgramCallV1, the NativeProgramRequestV1 constructor and the generated supportsProgramGuestAbi all refuse guest ABI 5 although the PAXAI schema requires it; the gateway serves AI market JSON ids with a 0x prefix where the spec says plain hex."

[gotcha.1135]
area = "programs-ai-market"
text = "An F01 ADMIT deadline must be at most height + task_timeout_heights (32 by default) and within the commit window; a deadline past the worker metadata expiry is accepted only while height < expiry, afterwards ADMIT refuses with F02_METADATA_EXPIRED. A refused role step does not consume its replay sequence, so the next accepted step reuses it. Clippy too_many_lines (100) applies to #[test] functions; split long journeys behind a shared setup helper. A worktree rebased onto main after F10-T03 regenerates programs/Cargo.lock with the layerx-programs-ai-market dependency line and fleet-commit.sh stages it."

[gotcha.1136]
area = "agent-sdk-python"
text = "layerx_sdk is not importable under pytest unless the test inserts agent/sdk/python into sys.path (no conftest). The frozen paxai schema operations table has 55 rows. compileall writes __pycache__ even with PYTHONDONTWRITEBYTECODE; remove it before committing. No Python formatter is installed for agent/sdk/python. The Python native_program_call codec, generated/receipt.py and programs._execution admit guest ABI 1-4 only, and Python has no owner-consent disclosure binder nor roster, market-header or score payload codecs, so FUND/CLAIM recipient and entitlement previews cannot be checked there yet."

[gotcha.1137]
area = "paxai-worker"
text = "RewardState decoding needs exactly REWARD_STATE_BYTES, but after an epoch opening the F06 section also carries an F05 tail; fixtures must slice ..REWARD_STATE_BYTES and re-append the tail (the transport_identity fund helper decodes the whole section). Clippy pedantic struct_field_names refuses a field that starts with its struct name. The worker crate lacks layerx-proof and layerx-types dev-dependencies, so membership tests bind real FinalityEvidence, Head, IdentityEvidence and roster documents without a signed checkpoint-certificate fixture."

[gotcha.1138]
area = "paxai-worker"
text = "Array-repeat patterns such as [0; 32] are not valid match patterns; use a guard (bytes if bytes == [0; 32]). Splicing the transport_identity fixture into a new test collides registry_ops::Outcome with the crate Outcome and a local customer binding shadows the customer() key fn; alias and rename. With fsync on every write the job_recovery gate takes about six minutes (160 durable submits plus 128 MiB queued payload). The ProcessRunner speaks the PAXRUN1 describe/dispatch/lookup/cancel protocol over PAXAI_RUNNER; without a provisioned runner the real-runner cases fail."

[gotcha.1139]
area = "explorer-frontend"
text = "yarn is not on PATH on the build boxes; use COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack yarn (1.22.22). pkill -f 'corepack yarn' from a tool shell kills that shell too (exit 144) because the pattern matches its own command line, and a pgrep -f waiter inside bash -c matches itself and never exits. The Paxeer X env presets pin every colors.theme leaf through NEXT_PUBLIC_COLOR_THEME_OVERRIDES, so any theme default change needs the preset line updated or the preset parity spec fails; lib/settings/colorTheme.ts overrides bg.primary at runtime with its own hexes. The Explorer / Build workflow runs on pull_request only, so explorer changes must go up as a PR to be built on GitHub."

[gotcha.1140]
area = "explorer-backend"
text = "The backend has no WebSocket JSON-RPC client: ETHEREUM_JSONRPC_TRANSPORT other than http/ipc silently fell through to IPC with no IPC_PATH, a ws(s) URL in an HTTP URL variable broke every eth_call including token metadata, and MICROSERVICE_METADATA_ENABLED without an http(s) URL answered 501 silently; all three now refuse boot with a named variable. Every list endpoint waits synchronously on the metadata tag lookup; its timeout is MICROSERVICE_METADATA_REQUESTS_TIMEOUT (default 1s, was hard-coded 5s). explorer/deploy/tests/config-check.sh needs bash (set -o pipefail). test-ratio.sh does not count config/*.exs as source. The first mix-in-builder run on a fresh worktree builds the image and all deps (>10 min); run it in the background."

[gotcha.1141]
area = "native-storage"
text = "lxp_ctx_blob_put is content-addressed: the key must equal sha256(bytes) or it returns CONTEXT_MISMATCH (-213). programs_module_registration_v5 uses activity_types_v4, which lacks LX_PROGRAMS_STORAGE_RETIREMENT 0x0009000B, so a retirement activity is refused at authority resolution with AUTH_SCOPE (-204), not at the module; the authority envelope caps the declared ordinal at 0x0A. lxp_module_ctx_prepare_commit re-checks only kernel blob/KV totals and ignores open capacity reservations. send_node_info advertises no capacity capability. The daemon pins the programs module version in lxp_daemon_lni.c and lxp_daemon_process.c. -fsyntax-only misses unused statics; a _Static_assert across two anonymous enums trips enum-compare unless both sides are cast to int. Snapshots exclude identities and need next == gs+1; the store writer refuses an existing final file; seed ops are unlogged; log durability needs ACTIVITY+RECEIPT plus sync and the log must be reopened after a forked crash; lni_stop releases kernel capacity; staged blob slots count deletions; fault hooks are live in the production library."

[gotcha.1142]
area = "sdk-generators"
text = "The platform SDK generator needs gofmt on PATH (/usr/local/go/bin) for its Go write and check modes. The layerx-sdk crate is formatted with rustfmt edition 2024; checking it with edition 2021 reports false diffs. compileall in a build_cmd leaves __pycache__ under agent/sdk/python to remove before committing. System python3 has no pytest; the scratch venv under the session scratchpad carries it. Kernel receipt fixtures can be re-signed with the test sequencer seed 0x45, whose public key matches receipt-programs-executed-v4.json. The generator --check modes fail on stale generated catalogs left by earlier hand edits; regenerate with --write and --write-program-contracts, never hand-edit generated output."

[gotcha.1143]
area = "ai-market-tests"
text = "The UNAUTHORIZED refusal frame always carries revision 0 (ApplicationResult::failure); every other refusal carries the visible revision. F05 FinalizeAggregation rewrites the F06 reward row inside the settlement section, so only F01/F02 steps leave SettlementClaims byte-identical; with NoEligibleScore the F06 row ends with entry_count 0 and the budget released to free. Clippy pedantic too_many_lines (limit 100) applies to test functions in the paxai-worker crate and no test there uses allow attributes: split long tests into helpers."

[gotcha.1144]
area = "explorer-ci"
text = "Every explorer workflow was disabled_manually since 2026-10-02, so main accumulated lint debt the gates never saw: five frontend files failed eslint (import order, curly-newline, jsx-no-bind, nested ternaries, jsx-wrap-multilines) and six backend files failed mix format plus credo --strict [F]/[R]/[D] findings (nesting depth, cyclomatic complexity, duplicate variable, with/else, alias order, nested module aliases); credo TagTODO has exit_status 0 so TODO tags never fail. scripts/explorer/test-ratio.sh counts every changed .ex/.ts/.tsx as a source needing a changed referencing test and fails when tests are fewer than sources, so lint-only repairs still need one changed test per repaired source. Read the full --check-formatted diff in the job log: it lists every unformatted file, not only the first. fetchProxy calls node-fetch v3, which fetchMock cannot intercept; its spec needs a real node:http server on port 0."

[gotcha.1145]
area = "ai-market-fuel"
text = "The workspace release profile sets strip=true, which removes the wasm name section; per-function fuel profiling needs strip=\"debuginfo\", and strip=false fails linking because of --compress-relocations. ExecutionContext::authenticated was gated to host-ffi/test, so no authenticated ABI-5 route existed outside host-ffi until execute_authorized_v5_budgeted_for_qualification. RewardState::check spent most of its fuel decoding all 256 dictionary slots two to three times per call; reading slots directly with an all-zero unused check and validating once per rollover cut OPEN_EPOCH from 3.7M to 0.93M fuel. fuel_budget prints its table only with --nocapture. StorageTransaction::commit is #[must_use]. The ai-market guest build and its fuel gate need cwd programs/ and PAXAI_CHAIN_DOMAIN exactly as the Makefile sets it."

[gotcha.1146]
area = "programs-runtime"
text = "Every public v2 executor route (execute_authorized_v2_budgeted_for_qualification and siblings) forces ABI 2, so an ABI 3-5 module is refused as an unsupported ABI version; ABI 5 guests use Executor::execute_authorized_v5_budgeted_for_qualification, which needs a non-zero activity sequence and batch height. In terminal.rs the `3 | 4` arms at the failure-field and response-failure decoders are failure tag codes, not ABI versions; the only ABI gate on the v5 path is in decode_v5. Runtime-crate clippy --all-targets stops on about 239 pre-existing lib errors; cap lints at warn to see findings in your own files."

[gotcha.1147]
area = "native programs / NODE_INFO / module ctx"
symptom = "Adding a NODE_INFO capability or a prepare-time capacity recheck trips handshake or registration rules that are not visible at the C call site."
fix = "NODE_INFO capability names are capped at 64 bytes each by the Rust client (handshake.rs MAX_CAPABILITY_BYTES) and must be strictly increasing in byte order or the handshake fails with MalformedNodeInfo; the capacity entry is the compact capacity:granted=<blobs>,<bytes>,<kv>, payload buffer 640 and capability array 25. Before a capacity profile is installed observe returns MODULE_DISABLED and the node advertises granted=0,0,0, omitting the entry while the projection is stale. The prepare_commit recheck counts only work grants held by other activities and refuses with the existing LXP_ERR_ARENA_EXHAUSTED, leaving staged slots and commit_prepared untouched. lxp_module_ctx has a field under #ifdef LXP_TESTING, so a native test embedding the struct must compile with the library flags. lxp_kernel_register_module refuses a second registration at an equal ABI (v4 and v4_storage_retirement are exclusive); v5 on top of either supersedes it."

[gotcha.1148]
area = "explorer frontend / address page"
symptom = "The address page landed on the Transactions tab with its list request never sent; token transfers the same; the tab strip held for seconds on every address."
fix = "toolkit RoutedTabs never writes the default tab into the URL, so any `tab === '<id>'` gate leaves the default tab's query disabled on landing and a disabled TanStack v5 query with placeholderData stays a placeholder forever; gate the local list as the complement of the explicit cross-chain sub-tab instead. The shared retry policy retried 501 like a transient 5xx (two backoffs); 501 is now final. Unit script is `yarn test:vitest --run <specs>` (not test:unit); `yarn install` in a git worktree fails only at the husky postinstall because .git is a file, the dependencies are usable."

[gotcha.1149]
area = "spec / public checker"
symptom = "The publication checker rejected `path.go:1234` line citations as port numbers and flagged identifier words such as `_REJECTED` inside error codes as reputational wording."
fix = "Anchor the port pattern to `localhost`, an IP or `://host` before the colon; strip `LXP_*` identifiers and backticked names before matching; write citations as path:line."

[gotcha.1150]
area = "spec / cg spec lint"
symptom = "`cg spec lint -f <feature>` reported `reqs points at N, which no [req.*] declares` on every task that listed bare requirement numbers."
fix = "Task `reqs` entries must name an acceptance criterion in `<req>.<ac>` form (for example `4.2`), never a bare requirement id; add an acceptance criterion when no existing one fits rather than pointing at a placeholder."

[gotcha.1151]
area = "spec / wave planning"
symptom = "Two tasks in the same wave declared `touches` on the same directory, which the parallel-admission rule treats as an exclusive-ownership conflict."
fix = "Declare `touches` at file level and move the dependent task one wave later; renumber it to that wave so its id matches."

[gotcha.1152]
area = "spec / contract naming"
symptom = "A blanket rename of short contract ids (K1..K5) to public file names also rewrote the sequencer receipt key names K1/K2 inside the sequencer contract."
fix = "Exclude files whose own vocabulary reuses the short ids from the mapping, or rename only the title line there."

[gotcha.1153]
area = "spec / specgen"
symptom = "`spec/specgen` and `scripts/specgen.sh` point at `../tools/specgen`, which does not exist from those directories, and `go` is not on PATH in a bare shell."
fix = "Run `/usr/local/go/bin/go run ./tools/specgen -root <repo> render` from the repository root; `requirements.md`/`design.md`/`tasks.md` mirrors are only produced when `[render] markdown_mirror = true` in spec/workflow.kvx."

[gotcha.1154]
area = "spec / lint"
symptom = "`cg spec lint` rejects dotted multi-segment requirement ids such as `[req.3.7]` and task `reqs` entries of the form \"3.7.2\"; only single-segment `[req.<n>]` with entries \"<n>.<ac>\" are accepted."
fix = "Author feature-local requirements as `[req.<N><kkk>]` (N*1000+k) and cite acceptance criteria as \"<N><kkk>.<a>\"; keep the mapping note in [meta] so readers can decode the ids."

[gotcha.1155]
area = "spec / authoring"
symptom = "A generated spec part with thousands of near-identical do steps (same sentence with only a symbol substituted) passes lint and size floors but carries no implementation information; it was rejected on sampling."
fix = "Sample every delivered part before accepting it: grep the do_ lines for the dominant sentence shape and read three random capabilities end to end; template expansion is a rejection criterion independent of line count."

[gotcha.1156]
area = "spec / public check"
symptom = "The public-content checker matched product words and paths as if they were internal language: `reputation` from ai_reputation.rs, `governance/owner-rotation`, `agent/unsafe-allowlist.toml`."
fix = "Match only the sensitive word forms (for example `reputational`, not `reputation`) and strip repository paths and backticked identifiers before matching; keep the exemptions listed beside the pattern so they are reviewable."

[gotcha.1157]
area = "spec / planning"
symptom = "Wave-0 tasks with requires = [] still depended on sibling wave-0 types (sequencer msgs, plan constants, activation lists) that no landed task provided, so workers hit missing interfaces mid-implementation."
fix = "requires = [] means the task must build on the tree as it stands at wave start; a task whose do steps name a symbol that no earlier task or the current tree defines must require the task that defines it, even inside the same wave."

[gotcha.1158]
area = "build / protobuf"
symptom = "buf generate without an input regenerated every module and the first run spent minutes downloading plugins; regenerating one module's tx.pb.go through the whole protoc script pulled unrelated diffs."
fix = "Run buf generate with an explicit input and path (buf generate api --path api/<module>/tx.proto), or build protoc-gen-gocosmos from the module cache and use a private template that writes outside the tree, then copy only the wanted tx.pb.go."

[gotcha.1159]
area = "go / api design"
symptom = "Adding an rpc to a Msg service breaks every package that asserts the keeper implements MsgServer until the keeper handler exists, so a types-only task that adds the rpc leaves the module unbuildable."
fix = "The rpc line in tx.proto and its keeper handler land in the same task; a types task may add message types only."

[gotcha.1160]
area = "go / naming"
symptom = "A Go package whose entry type is named Open cannot also export func Open, and node/sequencer cannot import package node (node/app.go builds the executor), so an import cycle appears as soon as the executor references *node.App."
fix = "Name constructors after their product (OpenWAL, not Open) when a type shares the name, and give the executor a Host interface that *node.App satisfies instead of importing node."

[gotcha.1161]
area = "go / portability"
symptom = "golang.org/x/sys/unix Fdatasync exists on linux only; a WAL that calls it unconditionally does not compile on other targets."
fix = "Keep the fdatasync call behind a build-tagged file with a fallback that calls File.Sync."

[gotcha.1162]
area = "layerxproof / codec"
symptom = "DecodeReceipt requires strictly increasing (module_id, ordinal) pairs and at most 512 effects; vectors with equal or unordered pairs decode as errors, and a sequencer bound above MaxEffects is unreachable."
fix = "Generate receipt vectors with ordered effect pairs and derive any sequencer effect bound from the codec limit rather than from the wire size alone."

[gotcha.1163]
area = "rust / clippy"
symptom = "cargo clippy on the agent crates fails inside layerx-types on warnings that the agent crate does not own."
fix = "Run cargo clippy -p <crate> --all-targets --no-deps so only the crate under qualification is linted."

[gotcha.1164]
area = "kernel / tests"
symptom = "make test-idempotency runs only the journal_single_entry case; the checkpoint and restart cases need explicit --checkpoint and --restart arguments that the Makefile target does not pass, and lxp_snapshot_write requires snapshot_size to equal the written length exactly."
fix = "A task whose acceptance names the checkpoint or restart cases must either pass those arguments in its verify_cmd or add a Makefile target that does; size every new entry format in lxp_snapshot_size before writing it."

[gotcha.1165]
area = "kernel / Makefile"
symptom = "A test target that links only liblayerx.a fails to link once the test references any kernel or governance-module symbol (undefined layerx_programs_* and EVP_*)."
fix = "Link such a test like the lxp_test_owner_rotation_unit rule: $(LIBRARY) $(PROGRAMS_RUNTIME_LIB) $(LIBRARY) $(PROGRAMS_NATIVE_LDLIBS) -lcrypto -pthread -ldl -lm with a programs-build order-only dependency; a task adding kernel-path cases to such a test must list the Makefile in its touches."

[gotcha.1166]
area = "layerxproof / verify"
symptom = "A strict ed25519 verifier already exists at layerxproof/verify (Ed25519Digest); a second one was nearly written in the sequencer."
fix = "Reuse layerxproof/verify for every ed25519 check over kernel digests."

[gotcha.1167]
area = "consensus / tests"
symptom = "makeState in the consensus/internal/state tests sets the genesis time to the current time, so any fixed past header time fails validateBlock in ApplyBlock and ValidateBlock."
fix = "Open test blocks one second after state.LastBlockTime instead of a fixed timestamp."

[gotcha.1168]
area = "node / tests"
symptom = "DefaultConsensusParams in node/test_helpers.go leaves MaxGasWanted at 0, so a gas bound faithful to checkTotalBlockGas refuses every tx, and occ_tests utils.ToTxBytes signs Cosmos txs with gas 1e10."
fix = "Block-limit-aware tests set the baseapp BlockParams through the params subspace and sign their own txs with a gas below the limit."

[gotcha.1169]
area = "kernel / ledger"
symptom = "ACCOUNT_OPEN binds a ledger receipt that requires exactly one effect in the buffer and a journal opened at store next_sequence; reusing a buffer across dispatches fails the receipt bind."
fix = "Give each dispatch in a test a fresh effect buffer and a journal opened at the store's next_sequence."

[gotcha.1170]
area = "codify / fleet"
symptom = "cg spec done on a 95,000-line spec takes more than ten minutes while dozens of workers build, and killing it by pattern with pkill -f also killed the shell whose command line contained the pattern."
fix = "Under fleet load record done by editing the task status and carrying revision, command, exit code and log path in the commit message; never pkill -f a pattern that appears in the current command line."

[gotcha.1171]
area = "none"
symptom = "task 0.1 is scheduled in wave 0 with requires=[] but depends on construct packages and the plan constant delivered by later tasks (10.0.1, 10.0.2, the construct feature tasks)."
fix = "its requires list should name them and the wave should follow them."

[gotcha.1172]
area = "none"
symptom = "the merge plan is a named plan without a semver tag."
fix = "precompile gating by semver.Compare in GetCustomPrecompiles cannot express it; gating goes through the evm keeper activation entries."

[gotcha.1173]
area = "consensus/node"
symptom = "in makeNode the dbCloser is closers[1]."
fix = "shutdownOps closes the block and state DBs itself; any closer that must run before the stores close has to be prepended, not appended."

[gotcha.1174]
area = "consensus/node"
symptom = "node tests default to memdb whose Close is a no-op."
fix = "a use-after-close shows up only with cfg.DBBackend = goleveldb, and goleveldb's Close leaves a memory-pool drain goroutine alive for up to 1s, which trips a 1s leaktest."

[gotcha.1175]
area = "api/layerxauth"
symptom = "scripts/protoc.sh runs offline from the module cache but rewrites about 180 generated .pb.go files repository-wide."
fix = "restore every one outside the task with git checkout before committing (protoc log at logs/0.11-protoc.log)."

[gotcha.1176]
area = "node/sequencer"
symptom = "node/sequencer cannot import package node because node/app.go will build the executor."
fix = "the executor takes a Host interface that *node.App satisfies. Type names Config, DefaultConfig, OpenLayer, SealedLayer, SealedBlock, SeqHash, BuildReceipt and MicroBatch are reserved for sibling tasks in node/sequencer. On a failed ante, the EVM deliver path bumps the nonce through DeliverTxCallback in the per-tx branch, so a dropped branch is what keeps a refused transaction from touching the nonce."

[gotcha.1177]
area = "node/sequencer"
symptom = "package sequencer_test shares one namespace across sibling task test files."
fix = "generic helper names (word, label, repeat) collide after rebase; use task-prefixed helper names."

[gotcha.1178]
area = "node/sequencer"
symptom = "state written through CommitMultiStore().CacheMultiStore().Write() after Commit did not reach an executor opened afterwards in the test app."
fix = "do pre-open setup on the TestWrapper context before the height-1 FinalizeBlock."

[gotcha.1179]
area = "node/sequencer"
symptom = "transient EVM receipts carry CumulativeGasUsed 0 until flush."
fix = "the committed value is the per-block running sum of GasUsed in txIndex order."

[gotcha.1180]
area = "rpc/utils.go"
symptom = "go build ./rpc/... does not compile node/sequencer (only rpc tests import it)."
fix = "an executor API change can leave build green while the rpc test binary fails."

[gotcha.1181]
area = "rpc/utils.go"
symptom = "In rpc external tests, a WatermarkManager over the global Ctx provider reports latest = Ctx height (8), not MockClient Status height (103), because Watermarks takes the minimum source."
fix = "Recorded from the task report, which states no separate fix.."

[gotcha.1182]
area = "node/sequencer"
symptom = "cachekv Get never fills its own cache from the parent."
fix = "a frozen cache branch is safe to read from many goroutines while a branch above it is written; only Write() on that branch (which swaps its maps without the reader lock) races with readers."

[gotcha.1183]
area = "layerxproof/codec"
symptom = "the Go receipt decoder reads module_id/module_version after the effects."
fix = "a layout-dependent effect bound can only be settled after the effects are decoded; the go verifier vectors (valid-0 etc.) are protocol 3, so they never select the sequencer layout."

[gotcha.1184]
area = "layerxproof/codec"
symptom = "the kernel already pins agent asset and all other kind ids in tests/ledger/test_account_id.c."
fix = "reuse those vectors rather than recomputing."

[gotcha.1185]
area = "node/sequencer"
symptom = "rpc cannot import node/sequencer."
fix = "the PendingTx struct lives in rpc/utils.go and sequencer.PendingTx is a type alias of it; node/sequencer already depends on rpc through node, so adding the import creates no cycle."

[gotcha.1186]
area = "node/sequencer"
symptom = "replicate on a fresh link sends the whole retained window."
fix = "Release's Ack.GapFrom..GapTo now names the ACCEPT seqs resent ahead of the group (requested by a gap answer or carried by a fresh link); this keeps TestStandbyAppliesInSeqOrder's gap assertion intact. Ack doc comment updated to match."

[gotcha.1187]
area = "node/sequencer"
symptom = "a re-sent LEASE with an equal epoch is admitted again by the standby and re-applied/re-appended (admit refuses only a lower epoch)."
fix = "harmless here but every fresh link repeats it."

[gotcha.1188]
area = "node/sequencer"
symptom = "pgrep -f/pkill -f with a pattern from the current command line matches the waiting shell itself."
fix = "wait on a PID with kill -0 instead."

[gotcha.1189]
area = "include/layerx"
symptom = "make test-idempotency runs only journal_single_entry."
fix = "checkpoint, legacy snapshot and restart cases run only via --checkpoint/--restart, so snapshot regressions in the idempotency codec are not caught by the declared gate."

[gotcha.1190]
area = "include/layerx"
symptom = "lxp_snapshot_write requires the precomputed snapshot_size to equal the written length exactly."
fix = "any change to an entry codec's size must be mirrored in lxp_snapshot.c snapshot_size and the daemon capacity estimate."

[gotcha.1191]
area = "include/layerx"
symptom = "(1) A test target that links only liblayerx.a fails to link once the test references any kernel or governance-module symbol."
fix = "it needs the programs runtime archive, a second liblayerx.a and -lssl -lcrypto -pthread -ldl -lm. (2) PROGRAMS_RUNTIME_LIB is defined with := near Makefile line 3400, so as a prerequisite of a rule written above that line it expands to empty; only the order-only programs-build prerequisite guarantees that the archive exists."

[gotcha.1192]
area = "include/layerx"
symptom = "pause_fixture payload buffer was 512 bytes, too small for an encoded lxp_receive carrying a full payer grant."
fix = "widened to 1024 in the test file."

[gotcha.1193]
area = "modules/lxphost"
symptom = "sdk/store/rootmulti mounts StoreTypeIAVL as a DB adapter whose Commit hash is the constant 'FAKE_HASH'."
fix = "CommitMultiStore.Commit().Hash never changes with state and app-hash equality tests through it prove nothing; programs activities at protocol version 3 need a real ed25519 signature over lxp_activity_signing_preimage even when signature_valid is set; programs/target/debug/liblayerx_programs_sandbox.a is built by make build regardless of CARGO_TARGET_DIR; lxp_result is a macro for int32_t, so cgo code must use C.int32_t, not C.lxp_result."

[gotcha.1194]
area = "api/tokenfactory"
symptom = "(1) tx.pb.go can be regenerated for a single proto without running the whole scripts/protoc.sh."
fix = "Build protoc-gen-gocosmos from the module cache, run buf generate with a private template that writes outside the tree and uses --path api/<module>/tx.proto, then copy only that tx.pb.go. (2) Adding an rpc to a Msg service breaks every package that asserts the keeper implements MsgServer, so the rpc line must land in the same task as its keeper handler."

[gotcha.1195]
area = "api/tokenfactory"
symptom = "buf generate for one proto downloads grpc-gateway plugin deps on first run and can exceed two minutes."
fix = "run it in the background."

[gotcha.1196]
area = "api/layerxledger"
symptom = "buf generate --path finds no files under the multi-input buf.gen.yaml."
fix = "give the input explicitly (buf generate api --path api/<module>) and copy only that module's tx.pb.go, not the whole protoc.sh copy-back."

[gotcha.1197]
area = "src/protocol"
symptom = "preview_state_root built its preview store without copying idempotency_retention."
fix = "any preview prune silently diverged from commit (fixed in scope: retention now copied); preview_apply_journal now calls lxp_idempotency_can_commit before lxp_idempotency_live_count so a corrupt count > max returns FATAL_INVARIANT before the live-count scan walks past the array."

[gotcha.1198]
area = "modules/layerxauth"
symptom = "a worktree rebase onto main can land on a stale main ref while the leader is landing."
fix = "check git log HEAD against main after rebasing and rebase again if behind."

[gotcha.1199]
area = "modules/lxphost"
symptom = "EVM NewKeeper accepts bank Keeper as an interface and transfer Keeper as a concrete value."
fix = "binding fixtures must match those real constructor types."

[gotcha.1200]
area = "modules/lxphost"
symptom = "Makefile pins program runtime outputs to programs/target even when CARGO_TARGET_DIR is exported."
fix = "Recorded from the task report, which states no separate fix.."

[gotcha.1201]
area = "modules/lxphost"
symptom = "Direct Go references to macro-backed C.lxp_u128 and C.lxp_receipt typedefs cause inconsistent cgo definitions across files."
fix = "tagged C.struct_lxp_u128 and C.struct_lxp_receipt references pass go vet."

[gotcha.1202]
area = "tests/state"
symptom = "governance sub-op 8 cannot issue a delegated capability while the grantor identity REVOCATION is 0, because grant validation refuses grantor_revocation_sequence 0."
fix = "seed governance identities at REVOCATION 1 or higher before issuing grants."

[gotcha.1203]
area = "modules/lxphost"
symptom = "the Go account codec (layerxproof/codec AccountKind) lagged the kernel's account kinds (agent ':asset:' sub-accounts, now added as kind 14 by task 0.7)."
fix = "the retired 'asset:<hex>:issuance' seed names are still C-only, so DeriveAccountID refuses them."

[gotcha.1204]
area = "modules/lxphost"
symptom = "cgo rejects a C struct type referenced from Go in two files of one package when the preambles include different header sets ('inconsistent definitions for C.lxp_kernel')."
fix = "pass a void* handle instead."

[gotcha.1205]
area = "modules/lxphost"
symptom = "lxp_bridge_credit.c registry_asset hashes 'layerx-asset:125' + symbol without the second colon, diverging from every Go and genesis asset id."
fix = "Recorded from the task report, which states no separate fix.."

[gotcha.1206]
area = "modules/tokenfactory"
symptom = "GetTokenDenom takes (creator, subdenom)."
fix = "validating a full denom means DeconstructDenom first, then GetTokenDenom on the parts; DeconstructDenom returns a plain sdk.ValidateDenom error, not ErrInvalidDenom, when the denom string itself is malformed."

[gotcha.1207]
area = "modules/tokenfactory"
symptom = "a tokenfactory keeper test that calls unexported keeper methods must be in package keeper and build the keeper from sdk/testutil.DefaultContext, because importing node/apptesting from package keeper is an import cycle."
fix = "Recorded from the task report, which states no separate fix.."

[gotcha.1208]
area = "modules/layerxledger"
symptom = "include/layerx/lxp_module.h has no LXP_MODULE_LEDGER id (ledger receipts use LXP_MODULE_ASSET, src/ledger/lxp_receipt.c:9)."
fix = "KernelKVPrefix 0x02 covers the asset module id, and its key layout should mirror modules/lxphost/ctx.go moduleKVKey (prefix."

[gotcha.1209]
area = "api/tokenfactory"
