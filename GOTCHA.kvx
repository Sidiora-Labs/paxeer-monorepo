[gotcha.4046]
title = "A prerequisite that extends the retired-callers catalogue could not be merged into a follower"
symptom = "Tasks 22.39.299 attempt 1 and 22.39.288 attempt 2 ended before any turn: the prerequisite 22.39.297 (a3bd3021da71) is published but not yet on main, and its merge onto the start revision a304e0de9b conflicts in tools/paxeer-x/retired_callers.json, the path decision 3142 merges by union; the qualification environment only knew the union for GOTCHA.kvx and the qualification ledger."
