fix = "root node_modules link resolves workspace packages to main-checkout dirs, so their dist/*.d.ts must be built once in the main checkout (npm --prefix <pkg> run build, sdk first); dist/ is gitignored"

[gotcha.1595]
area = "npm workspaces"
symptom = "agent/sdk/typescript/node_modules is empty after root npm ci (hoisted)"
fix = "node resolution walks up to <worktree>/node_modules -> root node_modules, so the root link covers it; npm ci --workspaces=false inside a package provisions a package-local tsc when the hoisted link is absent"

[gotcha.1596]
area = "npm workspaces"
