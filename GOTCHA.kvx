[gotcha.1526]
area = "rpc logs"
symptom = "wire log addresses are lowercase hex, never checksummed"
fix = "encode expected addresses with hexutil.Encode(addr.Bytes())"

[gotcha.1527]
area = "rustfmt"
symptom = "running rustfmt on a crate lib.rs without --config skip_children=true reformats every child module"
fix = "format only the touched files, or pass skip_children=true"

[gotcha.1528]
area = "kernel host runtime"
symptom = "lxp_kernel_bind_module_runtime refuses an asset runtime with asset_count 0"
fix = "the host sets module_runtime[LXP_MODULE_ASSET] directly"

[gotcha.1529]
area = "kernel asset mint"
symptom = "asset mint returns BALANCE_BYPASS unless lxp_kernel_set_capabilities is given lxp_kernel_canonical_ledger_apply"
fix = "pass the canonical ledger apply capability before minting"

[gotcha.1530]
area = "cgo"
symptom = "C struct types differ between Go files with different cgo preambles"
fix = "pass registries across files as `unsafe.Pointer`"

[gotcha.1531]
area = "kernel build"
symptom = "a cold make build takes over thirty minutes on the shared machine"
fix = "keep the per-task build directory between runs"

[gotcha.1532]
area = "comet fixtures"
symptom = "types.MakeCommit panics in VoteSet.MakeCommit when fewer than two thirds sign"
fix = "build a below-threshold fixture by replacing signatures in a full commit with NewCommitSigAbsent"

[gotcha.1533]
area = "comet fixtures"
symptom = "NewValidatorSet reorders validators by power then address, so MakeCommit signers must follow that order or signatures land on the wrong indexes"
fix = "sort signers like NewValidatorSet before signing"

[gotcha.1534]
area = "explorer mix gates"
symptom = "the first mix run in a fresh worktree compiles every dependency into a new build volume and takes over twenty minutes"
fix = "reuse the builder volume across runs of one worktree"

[gotcha.1535]
area = "node sequencer tests"
symptom = "node/sequencer imports rpc, so a test that uses the node signer must live in package evmrpc_test and reach SequencerReceiptResult through the pax_sequencerReceipt HTTP API"
fix = "write the test as an external package test"

[gotcha.1536]
area = "rust receipt decoder"
symptom = "the receipt decoder is strict, so a signature flag of 2 is refused at ReceiptCheck::Decode, never at CanonicalEncoding"
fix = "assert the Decode rung for malformed flags"

[gotcha.1537]
area = "sequencer receipt tests"
symptom = "the EVM base denom is uhpx while the older sequencer receipt test uses upax as its fee denom"
fix = "use uhpx in new fixtures"

[gotcha.1538]
area = "cargo clippy"
symptom = "cargo clippy --all-targets stops at the first denied target, so a lint task scoped to lib files cannot pass while bin and tests targets still carry pedantic denials"
fix = "scope lint tasks to the whole crate"

[gotcha.1539]
area = "1.1.6"
symptom = "two verify runs: a worker reran verify_cmd with -v only for per-test counts"
fix = "run verify_cmd once with -v from the start when per-test counts are wanted"

[gotcha.1540]
area = "spec do lines"
symptom = "spec line references drift: addr.go:124 is addr.go:123 and station.rs:1187 moved to :1279"
fix = "cite symbols not line numbers in do lines where the file is under active change"

[gotcha.1541]
area = "node/sequencer tests"
symptom = "newHarness and newReceiptHarness build the app without custom precompiles"
fix = "precompile tests use NewTestWrapper(..., true)"

[gotcha.1542]
area = "upgrade plans in tests"
symptom = "upgrade plan scheduled ahead with a registered handler panics BINARY UPDATED BEFORE TRIGGER"
fix = "set plan.Info to {\"upgradeType\":\"minor\"}"

[gotcha.1543]
area = "wasm keeper tests"
symptom = "wasm QuerySmart panics on a context with zero block time"
fix = "set a block time on the test context"

[gotcha.1544]
area = "interop/Cargo.lock"
symptom = "interop/Cargo.lock on main fell behind layerx-client Cargo.toml so every --locked interop gate refused before compiling"
fix = "refresh the lock offline with cargo metadata and commit it with the crate change"

[gotcha.1545]
area = "tests/modules/test_stream_lifecycle.c"
symptom = "test_stream_lifecycle.c shifts a 32-bit unsigned value by 56 to build timestamp bytes, undefined behaviour that passes at -O2 and fails at -O0"
fix = "cast to uint64_t before shifting"

[gotcha.1546]
area = "src/modules/stream/lx_stream_state.c"
symptom = "stream result codec accepts only ordinals 1-7 so a result saved with ordinal 8 fails lx_stream_result_save with LXP_ERR_NON_CANONICAL"
fix = "extend the codec before adding an activity ordinal"

[gotcha.1547]
area = "verify_cmd"
symptom = "verify_cmd joining two go test runs with && skips the second on the first failure"
fix = "run the second half alone for evidence when the first fails"

[gotcha.1548]
area = "task 0.70"
symptom = "a rebase onto a main that already carries the branch commit silently drops it, leaving the worktree head equal to main"
fix = "check git log main..HEAD after a rebase before reporting files"

[gotcha.1549]
area = "task 1.1.13"
symptom = "direct Go references to the macro-backed C.lxp_u128/C.lxp_receipt typedefs give inconsistent cgo definitions across files"
fix = "use C.struct_lxp_u128 and C.struct_lxp_receipt"

[gotcha.1550]
area = "task 2.2.3"
