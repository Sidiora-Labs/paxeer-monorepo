[gotcha.1603]
area = "node upgrade plans"
symptom = "a test that pins the full knownUpgradePlans() list fails whenever another task registers a new plan"
fix = "update the pinned list with the new plan in the task that registers it"

[gotcha.1604]
area = "programs/vendor"
symptom = "the root *.pem and binaryen config.h gitignore rules hide 41 vendored files listed in .cargo-checksum.json, so a clean checkout fails the offline checksum"
