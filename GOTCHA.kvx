[gotcha.1012]
title = "gnu chmod keeps setgid"
observed = "under a setgid parent (chmod 3775) GNU chmod 0750 on a child directory keeps the inherited setgid bit -> chmod g-s explicitly before an owner-and-mode check"

[gotcha.1013]
