fix = "formatting it as a touched file reflows unrelated lines."

[gotcha.1324]
area = "agent/crates"
symptom = "layerxproof/codec DecodeReceipt requires (module_id, ordinal) to strictly increase across effects and keeps MaxEffects 512."
fix = "log effects must take ordinal = effect position (log index + 1) and the Go verifier needs the same sequencer bound."

[gotcha.1325]
area = "agent/crates"
symptom = "clippy on any agent crate fails in layerx-types before it reaches the target crate."
fix = "pass --no-deps to lint only the crate you own."

[gotcha.1326]
area = "rpc/send.go"
symptom = "rpc cannot import node/sequencer (node/sequencer imports node, which imports rpc)."
fix = "external test package evmrpc_test can, and must build its own App/executor/receipt key harness."

[gotcha.1327]
area = "rpc/sequencer_receipt.go"
symptom = "the pax legacy HTTP gate (rpc/pax_legacy.go) fail-closes every pax_* method that is not in the gated list."
fix = "a new pax_* method needs an exemption or it answers -32601."

[gotcha.1328]
area = "rpc/sequencer_receipt.go"
symptom = "legacy sdk/store/rootmulti CacheMultiStoreWithVersion ignores its version argument and returns the latest state."
fix = "historical-height tests need their own per-height state."

[gotcha.1329]
area = "rpc/simulate.go"
symptom = "the pendingSequencer test context provider from pending_state_test.go returns committed contexts with no consensus params."
fix = "any latest-path simulate or header read on it fails 'consensus block parameters are unavailable'; wrap it with app.GetConsensusParams the way RPCContextProvider does."

[gotcha.1330]
area = "rpc/simulate.go"
symptom = "CheckVersion uses VersionExists(ctx.BlockHeight()), which is false for the open-block snapshot at height H+1."
fix = "pending reads have to skip it."

[gotcha.1331]
area = "rpc/simulate.go"
symptom = "the address 0x1234567890123456789023456789012345678901 in the shared rpc test server state is not a plain EOA (a zero-value estimate to it costs 0x52b0, not 0x5208)."
fix = "Recorded from the task report, which states no separate fix.."

[gotcha.1332]
area = "rpc/tx.go"
symptom = "TestGetTransactionCountPendingFallsBackToLocalNonce asserted the EvmNextPendingNonce fallback that req 9019.4 forbids."
fix = "It was rewritten as TestGetTransactionCountPendingRefusedWithoutSequencerRoute, which asserts ErrPendingServedBySequencer; the verify regex matches it by prefix."

[gotcha.1333]
area = "rpc/tx.go"
symptom = "App.EvmNonce reads GetCheckCtx, not the open block."
fix = "it is not a valid NonceQueue reader in sequencer mode; the tests read the nonce from Executor.Snapshot()."

[gotcha.1334]
area = "rpc/tx.go"
symptom = "occ_tests/utils clashes with consensus/libs/utils in rpc/tx_test.go."
fix = "import it as occutils."

[gotcha.1335]
area = "rpc/tx.go"
symptom = "export.NewRPCTransaction leaves blockNumber, transactionIndex and the effective gas price unset for a zero block hash."
fix = "The pending encoder passes a non-zero placeholder hash and then clears BlockHash."

[gotcha.1336]
area = "rpc/tx.go"
symptom = "Package-level helper names in rpc collide across parallel tasks (isPendingTag)."
fix = "give them task-specific names."

[gotcha.1337]
area = "rpc/filter.go"
symptom = "NewFilterAPI from the external evmrpc_test package panics on a zero FilterConfig timeout (time.NewTicker(0)) and its fields are unexported."
fix = "use evmrpc.NewFilterConfig (added in 9.0.8)."

[gotcha.1338]
area = "rpc/filter.go"
symptom = "the sequential executor cannot hold L_N and L_open at once (Open requires LastBlockHeight+1)."
