[finding.22.30.1.8]
test = "tests/modules/test_escrow_audit.h:audit_escrow_dedicated_custody; audit_escrow_shared_restored_custody"
proof = "Canonical signed activities pass encode/decode and kernel dispatch for protocol versions 1, 2 and 3; a second hold presenting the first custody account refuses without changing balances, sequences, state root, events or hold records. Opening requires empty custody and exclusive live binding; completed holds may reuse an empty legacy account, preserving the existing sequential lifecycle contract."

[finding.22.30.1.9]
test = "tests/modules/test_escrow_audit.h:audit_escrow_overfunded_restore; audit_escrow_shared_restored_custody"
proof = "Real opening and native ledger credit produce an overfunded hold; snapshot write, destruction, recreation and file reload preserve it. Kernel full/partial capture, release, timeout, dispute opening and resolution refuse without moving balances or writing results. A restored shared account refuses even when each hold individually matches its balance. Owner-only excess recovery returns exactly the surplus, preserves the commercial lock, binds replay separately from release, and also handles terminal surplus."

[finding.22.30.1.10]
test = "tests/modules/test_escrow_audit.h:audit_escrow_overfunded_restore; audit_escrow_post_settlement_rollback"
proof = "Shared transition preparation checks binding and the production invariant before settlement and dispute opening. Shared settlement validates its projected lock after the real ledger application and result commit validates terminal state. A self-beneficiary capture reaches the real ledger, fails the post-settlement invariant and rolls back balances, account sequence, hold and result writes; reopened inconsistent holds refuse before settlement."

[finding.22.30.1.11]
test = "tests/modules/test_escrow_audit.h:audit_escrow_epoch_chunks; tests/modules/test_escrow_timeout.c:sweep_capacity"
proof = "Registered epoch transition processes 25 and 49 simultaneous expiries in deterministic chunks of 24, assembling one transfer set under the existing protocol/journal limits. A late inconsistent hold rolls back the epoch, state sequence, module state and balances; owner recovery then permits the same transition and all 49 exact refund results are asserted, followed by a no-double-refund epoch."

[wiring]
owner_recovery = "include/layerx/lx_escrow.h and modules/layerxpay/keeper (owning domains 1 kernel and 3 layerxpay): expose lx_escrow_recover_excess_execute through an explicitly owner-authenticated recovery admission; it is internally declared in src/modules/escrow/lx_escrow_internal.h and deliberately unavailable as an ordinary release or capture."

[notes]
gotchas = "No earlier gates existed in /out/run/gate.json. Kernel module contexts admit one economic transfer set, so chunks share one assembled set and the same journal instead of committing chunks independently. No repository C formatter is configured or installed; touched C follows the existing four-space style."
