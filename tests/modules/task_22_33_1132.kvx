[continuation]
qualification = "Retain the inherited delegate implementation and recovery proof, correct the task-owned zero-spend assertion, and run hf-build followed by hf-done on the unchanged final candidate. Current gate results belong to /out/run/gates.jsonl, not the previous-attempt entries above."
previous_assumption_superseded = "The attempt-3 ruling makes the zero-spend assertion a task-scoped failure to repair; the previous attempt's unrelated-failure assumption is superseded."
budget_law = "spec/layerx-merge/programme/audit/records/22.30.5.kvx finding 22.30.5.4 requires successful owner revoke/full refund with reloadable state and no retained spend authority; req.2260 requires the close refund and stale-revocation refusal. Neither requires erasing a revoked record's historical limit."
analysis = "The delegate validator change only rejects noncanonical delegate lists; it cannot alter a never-spent record with no delegates. budget_execute_revoke preserves its 200-unit historical limit when spent_this_period is zero, records revoked=true and sequence=2, and refunds all 300 units; lx_budget_spend_prepare refuses revoked records before rollover or allowance arithmetic. The record satisfies the budget law."
repair = "audit_zero_spend_exit_reopen now asserts the exact 128-bit period limit (zero for full defund, 200 for revoke and close) and configured limit, plus zero remaining budget before and after snapshot reopen. Exact refund events, balances, revocation flags and sequence, byte-identical recovery and spend refusals before and after rollover remain asserted for native and ordinary sources."

[gotcha.1]
symptom = "The audit step requests unchanged-tree verification, while the explicit ordered instructions forbid verification before implementation and outside hf-done."
resolution = "Follow the explicit gate order and record that no baseline was run; keep this record in scope because spec/ and the root gotcha ledger are outside scope."
