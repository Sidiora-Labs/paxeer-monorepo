[finding.22.30.5.3]
test = "tests/modules/test_budget_close.c:audit_delegate_state_put_reopen"
verify_target = "test-budget-revoke"
repair = "The public record validator rejects every zero delegate as well as descending or duplicate delegates before state insertion or creation funding mutates anything; encoding and decoding share this invariant."
proof = "Signed delegate-add activities insert the maximum delegate count in reverse order, using nonzero IDs distinguished only in their final byte. Sole, first, middle and last zero delegates, descending and duplicate records are refused by validate, state_put, create_execute, encode and decode without changing empty or populated stores, balances, sequences, receipts, codec outputs or committed state. An accepted create executes the real canonical ledger, serializes the inserted record into kernel KV storage, and survives disk snapshot write, kernel/state destruction and fresh load with identical bytes and balances; the reopened record is reinserted and consumed by signed delegate removal through kernel dispatch."

