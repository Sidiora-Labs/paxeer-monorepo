[finding.agent-restart-admission-proof]
tests = ["test_agent_restart_admission_barrier_refuses_missing_authority"]
implementation = "The pre-restart probe waits for a private Ed25519-authenticated fsynced-journal acknowledgment bound to the exact credential/request/idempotency bytes before dropping the HTTPS reply. The post-restart probe compares both retries and requires the same admitted operation identity, a nondecreasing journal sequence, and exactly one committed effect."
evidence_contract = "The owner signs canonical sorted compact ASCII JSON after LayerX/restart-admission/v1 NUL, with state, request_sha256, operation_id, journal_sequence, durable, committed_effects and value; admission/recovery paths and a separately pinned public key are supplied in the private case file."
remaining = "The existing external producer exports no signed durable barrier or committed stop/reopen recording; actual restart/effect closure is not claimed."
wiring = "Domain 16 qualification: tools/qualification/paxeer-x/agent_operation_envelope.py must export pinned signed admission_file/recovery_file after journal fsync, stop/reopen the actual owner, count committed effects after two retries, and retain the genuine agent-restart-admission recording in tests/agent/sdk/python/recordings_22_33_701."

[finding.precompile-legacy-write-proof]
tests = ["test_precompile_legacy_encoding_and_perps_rejections_remain", "test_launchpad_selector_mutabilities_come_from_committed_abi_artifacts"]
implementation = "Legacy WRITES vectors are explicitly encoding compatibility. All existing perps retired-signature rejection assertions remain; the focused proof exercises the real current 0x1015 encoders and all retained perps refusal assertions. Actual post-activation LXP_MODULE_DISABLED execution is an owner wiring request."
remaining = "No committed activated-chain exchange recording is available; precompiles/layerxexchange/layerxexchange.go still dispatches requestSettlement to the keeper. No successful retirement execution is claimed."
wiring = "Domain 3 exchange/node: precompiles/layerxexchange/layerxexchange.go and its real EVM fixture producer must implement the activated requestSettlement refusal and publish unmodified error/current-deposit exchanges in tests/agent/sdk/python/recordings_22_33_701/exchange-post-activation.json."

[finding.program-account-legacy-identity]
tests = ["test_program_account_legacy_identity", "test_program_account_current_identity_over_recorded_rpc", "test_program_account_current_identity_refuses_rebinding"]
implementation = "The real node-generated V1-layerxprograms-call raw EIP-1559 transaction and signed receipt travel unchanged through loopback JSON-RPC into PaymentRpc and the shipping Programs verifier. Assertions bind keccak(raw), recovered EVM sender/principal, nonce, destination 0x101d, operation, execution status and receipt. Wrong raw signature, network, program and key pin are refused. Historical authorization-root and Activity tamper coverage remains intact and labeled."
provenance = "rpc/sequencer_receipt_vectors_test.go -> sdk/platform/conformance/fixtures/sequencer-receipt-v1.json#V1-layerxprograms-call -> HTTP JSON-RPC -> PaymentRpc -> _verify_program_transaction/_submission. Transport/client reopen replays authentic recorded evidence; it does not claim new node execution."

[finding.program-http-missing-ingress]
tests = ["test_program_http_current_ingress_and_protected_inputs"]
implementation = "Protected fixture version 2 binds actual gateway and paxd binary digests and existing candidate source files, requires ABI 1 through 5, sends raw transactions and eth_call to the node, retains gateway discovery/interface reads and signature pins, and looks up independently authenticated transaction receipts. Private file ownership/modes, exact keys, duplicate-field rejection and signature/network/program refusals remain required."
remaining = "The existing protected producer is version 1 and names the absent native_call.rs. The committed node receipt corpus covers guest ABI 1 only, so all-ABI execution, simulation and real unknown-to-committed restart recovery remain unqualified."
wiring = "Domain 9 qualification with Domain 13 Programs: scripts/qualification/paxeer-x/program-http-producer.py must emit the version-2 node_rpc/node_pid/node_source_manifest/receipt_keys/raw_transaction_file contract, all five actual guest executions and same-store recovery acknowledgment; rpc/sequencer_receipt_vectors_test.go must retain genuine signed ABI 2-5 and recovery receipts."

[finding.program-lifecycle-retired-transport]
tests = ["test_program_lifecycle_current_transaction_codec", "test_program_lifecycle_historical_internal_coverage"]
implementation = "All six committed lifecycle ABI vectors pass the SDK native payload decoder and ABI calldata encoder, then the real EIP-1559 signer/decoder with chain 125, destination 0x101d, exact calldata, recovered signer and keccak(raw) identity. Historical native payload/signature/bounds tests remain and pass mandatory raw transaction/key-pin arguments. Lifecycle submission, real per-operation receipts and stop/reopen recovery belong to the owners named below."
remaining = "The shipping bind_signed_program_lifecycle still requires native Activity version 3 and cannot admit the signed EVM transactions; the existing receipt corpus has no lifecycle transactions. No deploy/upgrade/wind-down execution or recovered commitment is claimed."
wiring = "Domain 9 SDK: services/agent/sdk/python/layerx_sdk/program_wire.py, program_lifecycle.py, agent_http.py and programs.py must bind and route lifecycle EIP-1559 transactions and authenticate each lifecycle operation's receipt, replacing the retired REST mutation boundary."
wiring_recordings = "Domain 13 Programs: rpc/sequencer_receipt_vectors_test.go and the real 0x101d lifecycle fixture producer must publish deploy, upgrade, route, deprecate, tombstone and exit receipts with unknown-to-committed stop/reopen observations in tests/agent/sdk/python/recordings_22_33_701/program-lifecycle.json."

[finding.program-trust-envelope-shape]
tests = ["test_program_trust_envelope_shape_and_freshness", "test_program_trust_real_producer_envelope_over_http"]
implementation = "Trust HTTP fixtures use lower-case achieved/unverified, achieved.rung and the exact requested/achieved/reason shape from agent_rpc.rs success_body/verification_json. Rollback, expiration and concurrent-head-change refusals remain. The producer's committed agent-http-success.json is replayed through real AgentEnvelopeTransport/ProductionClient with only correlation-id remapping; old capitalization and level are refused."
provenance = "services/agent/crates/layerx-agentd/tests/rpc_surface_major_two.rs#agent_http_envelope_goldens_round_trip checks the exact committed producer golden; no Rust subprocess or alternate producer implementation is used by this gate."

[finding.typed-program-verification-state]
tests = ["test_typed_program_verification_state"]
implementation = "Typed discovery/interface tests consume current lower-case unverified fixtures through real HTTP. A separate current-schema envelope case checks exact preservation of unverified and achieved.rung through the envelope client, then the production typed discovery decoder; neither server assertion promotes the typed evidence to locally verified commitment."
wiring = "Domain 9 agent RPC: services/agent/crates/layerx-agentd/tests/rpc_surface_major_two.rs should retain genuine unverified and signed Programs discovery/interface goldens alongside the existing producer success golden so the typed case can replay operation-specific producer output unchanged."

[finding.px-network-fixture-shape]
tests = ["test_px_network_fixture_shape", "test_px_history_chain_pages_and_bounds", "test_px_chain_only_openrpc_contract_and_retired_anchor_refusal", "test_px_recorded_chain_125_root_answers_over_sdk_rpc", "test_px_current_network_numeric_bounds"]
implementation = "Network fixtures use chain 125 and all current consensus fields; numeric tests enforce committed height <= block height and u64 bounds and reject anchor finality. OpenRPC and the bank ABI define current chain-only balance rows and uint256 amounts; loopback PxClient.call preserves those exact fields without a substitute typed decoder. Captured root answers from two documented numbered chain-125 nodes replay unchanged through PaymentRpc, including genuine method-unavailable errors. Existing null, pagination, row-ID and historical codec assertions remain; current committed history pages contain only Paxeer rows."
remaining = "Typed bank balances still require joined_limit/custody; the history decoder still accepts retired layerx sides; PaymentRpc still restricts endpoint paths to /rpc. These production changes are outside scope. The inherited 128-bit quantity integration assertion remains unchanged; the focused proof separately exercises the actual bank/OpenRPC uint256 contract, including exact maximum and overflow refusal."
wiring = "Domain 9 PX SDK: services/agent/sdk/python/layerx_sdk/px.py must decode current gateway/src/paxeer.rs bank-coin balances with height and reject retired kernel history joins while preserving null, canonical uint256 numeric and pagination bounds."
wiring_endpoint = "Domain 9 transport: services/agent/sdk/python/layerx_sdk/x402_rpc.py must admit documented root node endpoints; current replay uses the existing /rpc SDK transport and never claims that prefix is a public node route."

