observed = "50 tests pass; the committed-payment helper wrongly treats its first Transfer log as PaymentExact."
assumption = "Repair the helper to require exactly one event selected by ledger address and PaymentExact signature and bind reference, source, recipient, asset and amount to signed calldata, matching the Go producer's own verification."

[gotcha.committed-log-order]
observed = "The public-node committed recording includes Transfer before PaymentExact, unlike the focused Go-harness payment recording."
resolution = "Select the event by its recorded address and signature, require uniqueness, retain every original field equality and add reference/source checks; preserve producer bytes and add missing/duplicate/rebinding refusals."

[gotcha.independent-abi-address-types]
observed = "The task's independent evm_transaction.encode_call check passed a hex address string, while that ABI codec requires exactly 20 bytes."
resolution = "Convert only ABI address inputs to their exact byte representation; retain all independently generated selector, body, destination, value and wallet request equality assertions."
