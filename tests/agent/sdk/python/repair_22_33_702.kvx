[gotcha.producer-identity-and-encoding]
observed = "Attempt 1 assumed all current payments used type 2 and used the Ed25519 grant DID for payer-address account derivation; both assumptions contradict committed producer code and recordings."
resolution = "Read the original vector_v4.go signer and payment.rs payer_account definition, preserve their evidence, add explicit SDK support, and qualify only with hf-build then hf-done on the final candidate."

[qualification.attempt-2-first-gate]
revision = "79925044fd2f910b279c7974484ba1bfe9d9b2d4"
command = "cg spec done 22.33.702 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
