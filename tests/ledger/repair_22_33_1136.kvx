wiring_request = "src/ledger/lx_account_registry.c and include/layerx/lxp_ledger.h, domain 1 (kernel): resolve decision 2548 before separating live creation policy from historical canonical validation and indexed lookup; retain explicit migration of identifiers and balances."
baseline = "Not run: the execution order forbids tests before the entire implementation and allows verification only through hf-done; no baseline failures are claimed."
