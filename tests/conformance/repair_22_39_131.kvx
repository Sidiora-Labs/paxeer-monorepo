repair = "The CLI correctly reads the canonical module interfaces. Update the complete expected schema to the seven live asset ordinals 1,2,3,4,5,10,11: ordinal 9 is retired. Keep full JSON equality, enabled module equality, deterministic ordering and every input refusal."
test = "cmd/layerx-module-registry/test_registry.py::test_registry"

[choice.admission]
owner = "22.33.1076; current program_wire EVM contract"
source = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json#V1-layerxprograms-call"
repair = "The retired native network-7 signed-activity fixture is no longer an admission transaction. Consume the production node's signed chain-125 EIP-1559 program call, retain every native call bound, require foreign-network and malformed-signature refusal, and prove the altered signature cannot authenticate the recorded sender or bind to the authentic signed execution receipt. Keep commitment and real-node-reopen proofs unchanged."
test = "test_native_program_admission_refuses_foreign_network_and_forged_signature"

