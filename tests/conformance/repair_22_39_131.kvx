[choice.transport]
repair = "Use PaymentRpc for eth_/pax_ at the node root, HostedGatewayRpc for px_ at /rpc, and CometRpc for commit/validators at its root. All use the production bounded JSON-RPC HTTP codec; assert exact methods, parameters, paths, content types, independent request IDs and cross-interface refusals."
