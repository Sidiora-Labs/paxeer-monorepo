[repair.22.33.1076]
mode = "BUILD"
base_revision = "76c050242a1edcad6212aa52fac15670ecb5612d"
scope = "tests/daemon"
build_cmd = "python3 -m py_compile tests/daemon/test_handover_chain_no_read_consumer.py tests/daemon/test_protocol_owner_binds_state_feed.py tests/daemon/test_serve_commits_programs_call.py tests/daemon/test_serve_startup_without_anchor_bind.py"
verify_cmd = "python3 -m pytest -q tests/daemon/test_repair_22_33_1076.py"
baseline = "The supplied previous-attempt result reports 16 passed and two failed: test_repair_f018_programs_call_executes_and_commits and test_repair_f019_startup_and_reopen_without_anchor_store both lack the node-produced programs-commit-reopen.json. The current /out/run/gates.jsonl is absent; no new unchanged-tree verification was run because the ordered gate instructions prohibit manual pytest and pre-implementation testing."
evidence = "The runner's private /out/run/gates.jsonl records candidate revision, command, exit and log for hf-build and hf-done; the final response copies the last bounded gate result."
closure = "The four retired references use retained production paths; qualification requires the node-produced commitment/reopen recording and the declared Python replay proof. A receipted execution vector is not commitment or restart evidence."

[finding.f016]
test = "test_repair_f016_retained_handover_needs_no_read_consumer"
implementation = "Import the existing cmd/retirement handover inventory instead of executing the removed handover-chain.py; require absent retired paths and prohibit the read-consumer binary and environment selector in the retained harness and build entry point."
proof = "The production Python transaction codec, JSON-RPC client and program receipt verifier also consume the unmodified node-produced embedded-program execution vector through loopback."

[finding.f017]
test = "test_repair_f017_embedded_runtime_owns_and_binds_state"
implementation = "Check retained embedded host ownership and ordered restore, account and asset binding, metering and occupancy resolver contexts, programs binding, execution and branch/blob persistence; preserve the prohibition on generic kernel feed binding."
proof = "The production client receives and verifies the embedded-program call's actual signed execution result, output/log bindings and sequence roots from rpc/sequencer_receipt_vectors_test.go."
limit = "Source assembly checks and recorded runtime execution do not independently execute the Go/cgo host in the Python gate."

[finding.f018]
test = "test_repair_f018_programs_call_executes_and_commits"
implementation = "Submit the retained signed EVM programs call through PaymentRpc to a transcript server, require committed receipt and successful transaction status in the same block, verify signer, chain, native call, signed output, logs and state read at that committed height; retain guest ABI 1 and response capacity 16."
additional_tests = ["test_original_programs_call_admission_payload_keeps_every_bound", "test_recorded_embedded_program_execution_uses_real_codec_and_rpc", "test_program_execution_refuses_tampered_transport_evidence", "test_program_receipt_refuses_untrusted_or_expired_credentials", "test_native_program_admission_refuses_foreign_network_and_forged_signature", "test_receipted_vector_cannot_stand_in_for_original_call"]
proof = "The separate programs-commit-reopen recording captures the original capacity-16 call through production admission, execution, commitment and getProgram at the committed height."

[finding.f019]
test = "test_repair_f019_startup_and_reopen_without_anchor_store"
implementation = "Check current embedded startup and store-loader ordering and the separate anchor-store deletion upgrade, then require identical authenticated receipt, committed block and program state observations from before and after a real node close/reopen across deletion."
proof = "The recorder stops and reopens the persisted App, consensus service and sequencer WAL around the anchor-store deletion, then records recovered committed receipt, status and program state without resubmission."

[recording.production]
generator = "tests/daemon/recorder/main.go"
command = "go run ./tests/daemon/recorder"
output = "tests/daemon/fixtures/programs-commit-reopen.json"
implementation = "Persistent embedded App and real local consensus with the production sequencer, WAL, HTTP RPC, programs precompile and sandbox; apply the merge handler, submit the original ABI-1 capacity-16 call, commit, stop the node, apply the anchor deletion store loader, reopen and consume the recovered receipt and program state without a second submission."
qualification = "Generate once during implementation; the declared Python gate only consumes the committed transcript."
outcome = "Attempt 6 produces programs-commit-reopen.json on the base containing 22.31.475: the height-three consensus handshake accepts the unchanged persisted application hash, anchor deletion commits at height four, and the original receipt, transaction status and program state are recovered without resubmission."

[gotcha.gate_order]
observed = "The task requests an unchanged-tree verify in step 8 while explicitly forbidding pre-implementation tests and manual pytest runs."
resolution = "Use only the ordered hf-build/hf-done gates and disclose the absent baseline; strict scope places this note and wiring requests here rather than editing spec files or GOTCHA.kvx."

[gotcha.evidence_level]
observed = "The available programs vector comes from a real EVM call on an embedded host, but its JSON explicitly says receipted and carries no node reopen or committed program-state observation."
resolution = "Keep commitment and recovery assertions strict; never relabel this vector committed, manufacture state, or use replay-listener restart as node recovery."

[gotcha.python_cache]
observed = "The runner candidate walks every file in the allowed directory, including generated bytecode."
resolution = "The current runner explicitly excludes __pycache__, .pyc and .pyo build outputs from its candidate, keeping the build and verification on the same source candidate."

[qualification.first_verify]
revision = "1fa79d921e9fd80cc6ad12239db89f00a532f3b1"
command = "cg spec done 22.33.1076 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "14 passed and 3 failed: commitment and reopen lack node-produced evidence; the status-tamper assertion expected ValueError where PaymentRpc correctly raises a typed decode failure before receipt verification."

[gotcha.status_refusal]
observed = "PaymentRpc interprets status 0 as a revert and refuses a successful ABI output presented as revert data with DECODE_FAILURE before the authenticated receipt binder runs."
resolution = "Assert the exact typed client error and separately retain the ValueError assertion for the authenticated receipt status binding; no exception check is removed or broadened."

[continuation.capacity_binding]
implementation = "Bind the decoded programs call to explicit response capacity 64 for the existing execution corpus and 16 for committed/reopened evidence, preserving ABI 1, calldata, capabilities, access declaration and all seven resource budgets."
test = "test_receipted_vector_cannot_stand_in_for_original_call"
proof = "The real decoder and receipt client consume the original signed transaction and production receipt over loopback, and reject this capacity-64 receipted vector when a capacity-16 commitment call is required."

[gotcha.recording_dependency]
observed = "The only committed local-chain vector records ledger payExact, while the programs-call vector records receipted execution; neither includes committed programs state or actual node reopen across anchor-store deletion."
resolution = "The continuation explicitly authorizes native recording at implementation time. Generate a distinct original-call transcript using tests/daemon/recorder/main.go and retain all Python commitment and recovery assertions."

[gotcha.retired_runtime_fixture]
observed = "The ruling names tests/daemon/paxeer_x_runtime_fixture.py, but cmd/retirement/test_daemon_tests_runtime_fixture.py requires that legacy file to remain absent."
resolution = "Use the retained node/sequencer runtime and consensus/rpc/test lifecycle in an in-scope recorder; keep the retired fixture absent."

[gotcha.recorder_testing_entry]
observed = "Calling testing.RunTests directly from the recording executable ran zero cases because the testing runtime was not initialized."
resolution = "Use testing.Main to execute the real recording lifecycle and its assertions."

[gotcha.genesis_branch]
observed = "Flushing the entire genesis state twice violated the bank supply invariant; context.KVStore also wraps the underlying cache in a gas store without Write."
resolution = "Publish only fixture kernel, binding and upgrade branches through MultiStore().GetKVStore; leave bank genesis and its production supply invariant on the normal path."

[gotcha.recorder_startup]
observed = "An assertion in a consensus callback hid the sequencer startup error; the enabled sequencer requires explicit positive nonce queue bounds."
resolution = "Return startup errors to Commit and the recording goroutine, and set fixture queue bounds to four per sender and eight total."

[gotcha.upgrade_boundary]
observed = "Scheduling anchor deletion in genesis triggered the production major-upgrade early-binary refusal before the call could commit."
resolution = "Supply the named upgrade file only after stopping at the preceding height, then let the retained store loader and BeginBlock upgrade handler perform deletion on reopen."

[gotcha.deleted_store_descriptor]
observed = "StoreKeys retains a deleted store's descriptor after the loader removes its commit store."
resolution = "Assert GetCommitKVStore(layerxanchor) is nil and record only descriptors whose commit stores remain mounted."

[gotcha.bootstrap_source]
observed = "Consensus captures the sequencer source at construction, before the fixture can start the sequencer from committed bootstrap state."
resolution = "The fixture exposes a stable SequencerSource interface that delegates admission, admission acknowledgements and sealing directly to the production source installed after block one."

[gotcha.validator_genesis]
observed = "A fixture genesis with a bonded validator but no slashing SigningInfos committed deployment and then correctly refused its next vote-bearing block."
resolution = "Include that validator's normal signing metadata in slashing genesis, preserving vote processing and all production invariants."

[gotcha.consensus_persistence]
observed = "The RPC test helper defaults to memdb, losing consensus block and state history even when the application and sequencer WAL persist."
resolution = "Select the production goleveldb consensus backend in the recording fixture so reopen handshakes against the actual committed chain history."

