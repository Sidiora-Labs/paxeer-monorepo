[repair.22.39.411]
title = "Kernel test programs follow included headers"
dependency_files = "Each listed compile-and-link rule writes a compiler dependency file beside its binary under build/tests; the Makefile includes those files and the compiler records direct and nested headers."
direct_local_header_rule_1 = "tests/programs/test_lifecycle.c -> build/tests/programs_lifecycle: audit_22_30_2.h includes src/modules/programs/storage.h and sandbox.h"
direct_local_header_rule_2 = "tests/programs/test_call_activity.c -> build/tests/programs_call_activity: src/modules/programs/artifact.h"
direct_local_header_rule_3 = "tests/programs/test_blob_lifecycle.c -> build/tests/lxp_test_blob_lifecycle: src/modules/programs/storage.h"
direct_local_header_rule_4 = "tests/programs/test_ai_host_boundary.c -> build/tests/paxai_host_boundary: src/modules/programs/storage.h"
direct_local_header_rule_5 = "tests/programs/test_call_escrow_principal.c -> build/tests/programs_call_escrow_principal: included src/modules/programs/call.c includes its module headers"
direct_local_header_rule_6 = "tests/programs/test_call_builders.c -> build/tests/test_call_builders: included src/modules/programs/call.c includes its module headers"
nested_source_rule_1 = "tests/programs/test_monetary_law.c -> build/tests/programs_monetary_law: included test_call_activity.c includes src/modules/programs/artifact.h"
nested_source_rule_2 = "tests/programs/test_metered_call.c -> build/tests/programs_metered_call: included test_call_activity.c includes src/modules/programs/artifact.h"
nested_source_rule_3 = "tests/test_programs_oracle_read.c -> build/tests/test_programs_oracle_read: included tests/programs/test_call_activity.c includes src/modules/programs/artifact.h"
nested_source_rule_4 = "tests/test_web_program_path.c -> build/tests/test_web_program_path: included tests/programs/test_call_activity.c includes src/modules/programs/artifact.h"
nested_source_rule_5 = "programs/tests/differential/parallel.c -> build/tests/programs_parallel_differential: included tests/programs/test_call_activity.c includes src/modules/programs/artifact.h"
public_header_rule_1 = "tests/programs/test_registration.c -> build/tests/programs_registration"
public_header_rule_2 = "tests/programs/test_transfer_principal.c -> build/tests/programs_transfer_principal"
public_header_rule_3 = "tests/programs/test_metering_schedule.c -> build/tests/programs_metering_schedule"
