public_header_rule_7 = "tests/programs/test_blob_admission.c -> build/tests/lxp_test_blob_admission"
public_header_rule_8 = "tests/programs/test_paxai_native_gaps.c -> build/tests/lxp_test_paxai_native_gaps"
