qualification = "Run hf-build followed by hf-done on the final candidate; the runner-private gate ledger provides the verified revision and evidence without changing this record after verification."

[gotcha.continuation]
symptom = "The inherited registration and lifecycle tests referenced the removed fee-governance activity; staged shared roots also consume the full blob budget."
resolution = "Use the current exact registration list and receipt-backed profile staging API; charge the deletion budget only when a value actually needs deletion."

