[task]
id = "22.31.24"
audit = "22.30.2"
mode = "BUILD"
verify = "make -s programs-core-test via hf-done"
evidence = "Runner-private gates.jsonl and the final hf-done evidence line bind the exact candidate revision, command, exit and log."
baseline = "No earlier gate ledger existed. No baseline test was run: the explicit gate order prohibits testing before implementation and prohibits invoking verify_cmd by hand. Existing tests remain registered with their original assertions."

[finding.migration-accounting-version]
repair = "Use the canonical ABI transition policy in the stable LXMA1 reader, retaining all other canonical checks."
test = "audit_migration_abi5_bound_authority_recovery"
proof = "A real governance receipt stages and activates the historical migration profile; a deployed ABI 5 program executes its migration through the kernel, emits LXMA1, closes storage and recovers all 613 accounting bytes unchanged."

[finding.bound-migration-signature]
repair = "Apply the existing native Programs signer binding to authenticated unsigned state-commitment migrations; signed envelopes retain Ed25519 verification, and payload, envelope and activity binding checks remain mandatory."
test = "audit_migration_abi5_bound_authority_recovery"
proof = "Execute the authenticated unsigned migration through the kernel, rejecting forged principal, altered payload, missing binding and an invalid signed envelope before accepting and recovering the accounting record."
wiring = "Domain 1: modules/lxphost and precompiles/layerxprograms must run this migration through the actual Go Programs precompile after the host fee-transaction and ABI-registration wiring repairs; this task's C gate cannot execute that out-of-scope integration."

[finding.storage-environment-live-blob-references]
audit_id = "sandbox-live-blob-references"
repair = "Use the journal-aware Programs iterator to scan shared, principal and snapshot storage heads and other direct Programs blob roots before reclamation."
test = "audit_storage_environment_live_blob_references; audit_storage_environment_staged_blob_references"
proof = "Create funded lease state through dispatch and canonical namespaces through the storage producer, transport its head to the snapshot namespace, destroy the lease through dispatch, close/reopen between phases and import every surviving shared cell and its identical manifest. Repeat with a shared head created only in the destroying activity's journal."

[finding.storage-environment-cleanup-delete-budget]
audit_id = "sandbox-cleanup-delete-budget"
repair = "Persist phase 2 after snapshot value reclamation, remove both heads and unreferenced manifests in phase 2, then persist phase 3 before settlement when deletions consumed blob slots; reserve all four slots for the canonical archives published atomically with final occupancy, refund and terminal state."
test = "audit_storage_environment_cleanup_delete_budget"
proof = "Reclaim a namespace and a different snapshot containing three unique final values; commit and close/reopen each of four phases, assert the four-blob kernel limit, durable cursor, deferred refund, absence of both reclaimed heads and manifests before settlement, terminal replay protection and exact recovered escrow refund. Recover and hash-validate all four canonical archive blobs against producer and terminal digests; only the four archives and any live shared blobs remain."

[finding.native-block-maintenance]
status = "requires out-of-scope native wiring"
test = "audit_maintenance_boundary_recovery"
proof = "An actual storage-writing guest creates a governed occupancy position; the C block-boundary finalizer advances lease expiry, charges occupancy, observes demand, refuses repeated boundaries and continues after closing and reopening storage. This is C boundary evidence, not an actual native node block proof."
wiring = "Domain 1: modules/lxphost/host.go and modules/lxphost/module.go plus the owning native node block lifecycle must restore authoritative committed accounts, records and blobs, invoke lxp_programs_finalize_occupancy_batch_selected once per committed block, publish all records/blobs/transfer legs atomically, and prove node advancement, charging, expiry, replay refusal and restart continuation."

[notes]
snapshot = "The existing C storage producer admits principal/shared namespaces; the test transports its emitted canonical head into the existing snapshot-head shape. No manifest or value bytes are fabricated."

