{
  "name": "pax-rpc-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained suite that verifies Pax's EVM JSON-RPC against a local geth reference node. Optional manual Hardhat forks require ETH_MAINNET_UPSTREAM and a positive safe-integer ETH_MAINNET_FORK_BLOCK.",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "hardhat compile",
    "rpc:geth": "geth --dev --http --http.addr 127.0.0.1 --http.port 9547 --http.api eth,net,web3,debug,txpool --dev.period 0",
    "rpc:fork": "hardhat --config hardhat/hardhat.config.ts node --port 9546",
    "rpc:bootstrap": "mocha --config .mocharc.bootstrap.json",
    "rpc:run": "mocha --config .mocharc.run.json",
    "test:rpc": "npm run rpc:bootstrap && npm run rpc:run",
    "report:merge": "mochawesome-merge \"reports/new_rpc/*.json\" > reports/merged.json && marge reports/merged.json -o reports/merged -f rpc-tests --reportTitle \"Pax RPC Tests\" --charts",
    "rpc:ci": "bash scripts/run-ci.sh",
    "test": "npm run rpc:ci"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/cosmwasm-stargate": "^0.32.4",
    "@cosmjs/crypto": "^0.32.4",
    "@cosmjs/encoding": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@cosmjs/tendermint-rpc": "^0.32.4",
    "@pax-js/cosmos": "github:Paxeer-Network/pax-js#v1.0.6-pax.1",
    "cosmjs-types": "^0.9.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@fastify/busboy": "^3.2.2",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.18.2",
    "chai": "^4.4.1",
    "hardhat": "^2.22.10",
    "mocha": "^10.7.3",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@fastify/busboy@<3.2.2": "^3.2.2",
    "adm-zip@<0.6.1": "^0.6.1",
    "axios@<1.20.0": "^1.20.0",
    "brace-expansion@<2.1.7": "^2.1.7",
    "cookie@<0.7.0": "^0.7.0",
    "esbuild@<0.28.1": "^0.28.1",
    "fast-uri@<3.1.9": "^3.1.9",
    "follow-redirects@<1.16.2": "^1.16.2",
    "form-data": "^4.0.6",
    "handlebars@<4.7.10": "^4.7.10",
    "immutable@<4.3.9": "^4.3.9",
    "js-yaml@<4.3.2": "^4.3.2",
    "lodash@<4.18.0": "^4.18.0",
    "minimatch@<11.0.1": "^11.0.1",
    "protobufjs@<7.6.3": "^7.6.3",
    "qs@<6.16.1": "^6.16.1",
    "serialize-javascript@<7.1.3": "^7.1.3",
    "tmp@<0.2.6": "^0.2.6",
    "undici@<6.29.1": "^6.29.1",
    "uuid@<11.1.1": "^11.1.1",
    "ws@<8.21.0": "^8.21.0"
  }
}
