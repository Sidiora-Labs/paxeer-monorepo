[repair.22.39.367]
requirement = "22998.1"
base_revision = "7cc619fab1cd2b6ff464a2c261766402af81dc17"
reproduction = "The ordinary pre-change make -f chain.mk install passed. Twenty sequential helper --sequencer starts followed by --stop all exited zero: 20 runs, 0 stalls. The original intermittent stall was not reproduced."
reproduction_evidence = "/tmp/repair_22_39_367/baseline-build.log, baseline-results.json, reproduce.log and baseline-helper-01.log through baseline-helper-20.log (private)."
direct_state = "Started the stopped full bootstrap peer with halt height 34742404, no persistent or bootstrap peers and consensus sequencer disabled. It reported not caught up yet with max_peer_height=0; SIGTERM produced exit 0 in 0.033 seconds, within the unchanged ten-second bound."
direct_evidence = "/tmp/repair_22_39_367/baseline-direct.json and baseline-direct.log (private)."
cause = "Under the do_4 no-stall fallback, node/app.go HandleClose called adminServer.GracefulStop without a bound. A connected peer can open an admin unary RPC and withhold its request body, leaving gRPC processUnaryRPC receiving the missing body at google.golang.org/grpc@v1.57.1/server.go:1320 while GracefulStop waits without a deadline (captured at its serveWG.Wait at server.go:1889; connection draining also waits at server.go:1893). This is a demonstrated unbounded close path, not an attribution of the unreproduced intermittent stall."
change = "sdk/server/grpc/server.go StopGRPCServer drains requests for the supplied grace period, calls gRPC Stop to cancel outstanding RPCs at expiry and joins GracefulStop before returning. node/app.go HandleClose uses a five-second period and logs any forced RPC cancellation. Receipt pruning, database, ownership and application store closes retain their order; no exit call or stronger process signal was added."
regression = "TestRepair2239367CloseWithUnfinishedAdminRPC sends real admin RPC headers over TCP and withholds its body, captures the blocked GracefulStop goroutine, reopens the receipt store while the admin drain waits, and asserts HandleClose returns within ten seconds without client cancellation."
store_cases = "TestRepair2239367CloseReleasesApplicationStoreBeforeHandler reopens the real application store inside its close handler; TestRepair2239367CloseIdleReceiptStore asserts that an idle pruner and database workers close within two seconds and release ownership; TestRepair2239367StopIdleGRPCServer proves a drained server finishes without waiting for the grace deadline."
race_command = "go test -p=1 -race -ldflags=-checklinkname=0 ./node ./sdk/baseapp ./sdk/server/grpc ./storage/ledger_db/receipt -run '^TestRepair2239367' -count=1 -v"
race_evidence = "/tmp/repair_22_39_367/race.log (private); the log records the actual outcome and blocked goroutine file and line."
build_command = "make -f chain.mk install"
verify_command = "test -s tests/ci/repair_22_39_367.kvx && for i in 1 2 3 4 5 6; do bash tools/qualification/localnode/v6120-node.sh --sequencer --env-out ${TMPDIR:-/tmp}/lx-localnode/localnode.env && . ${TMPDIR:-/tmp}/lx-localnode/localnode.env && bash tools/qualification/localnode/v6120-node.sh --stop $LOCAL_NODE_HOME || exit 1; done"
verification_runs = "The declared hf-done loop performs six ordered starts and stops. Each ready home and any stop refusal is retained in /out/logs/verify-1.log (or the final repair log). An exit-zero verify row establishes that runs 1, 2, 3, 4, 5 and 6 all started and stopped within the helper's unchanged bound. Actual results are supplied by the gate ledger."
verified_revision = "The authoritative candidate revision and actual gate outcomes are in matching build and verify rows of /out/run/gates.jsonl and the final hf-done evidence line. This record is frozen before those gates so their revisions can match."
gotcha = "GOBIN is configured separately from GOPATH/bin; resolve the executable through go env GOBIN when reproducing directly. No root ledger or spec files were edited because the task scope excludes them."
captured_goroutines = "The private race.log dump captures the real unary reader at grpc server.go:1320, GracefulStop at grpc server.go:1889, StopGRPCServer at sdk/server/grpc/server.go:72 and HandleClose at node/app.go:1595. The original intermittent node stall supplied no dump because neither the twenty helper runs nor the direct state stalled."
race_result = "Exit 0. All four TestRepair2239367 cases executed and passed with the race detector: held admin RPC 5.07s, application-store close order 0.14s, idle gRPC drain 0.01s, idle receipt-store close 0.26s. No race report. Private evidence: /tmp/repair_22_39_367/race.log and race.exit."
post_change_observation = "The ordinary make -f chain.mk install exited 0 after the implementation; a fresh helper --sequencer start and --stop both exited 0, with no stall. Private evidence: /tmp/repair_22_39_367/repaired-build.log and repaired-helper.log."
interruption = "The gateway restart terminated the first race compilation before any case executed; the same command resumed using its completed build cache, and the complete execution exited 0. No completed case or counted gate was repeated."
