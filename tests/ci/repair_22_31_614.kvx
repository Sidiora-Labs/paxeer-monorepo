previous_lock_revision = "ef11ec4bc2"
decision = "2790"
gotcha = "3410"
resolution_command = "cargo metadata --format-version 1 --manifest-path services/platform/Cargo.toml"
resolution_runs = 1
resolution_exit = 0
resolution_log = "/tmp/platform-lockfile-22-31-614-resolution.log"
added_entries = []
removed_entries = []
version_changes = []
summary = "The single resolution preserves every package version and checksum; the stale layerx-sdk dependency list gains two existing locked packages. No manifest was changed and cargo update was not run."
verified_revision_evidence = "/out/run/gates.jsonl records the exact candidate revision, command, exit code and private log for hf-build and hf-done; the final response copies the last hf-done receipt. The candidate includes this repair record, so its revision is retained externally rather than embedded in the content it hashes."
build_command = "cargo tree --locked --manifest-path services/platform/Cargo.toml -p layerx-runtime-clock --depth 1"
verify_command = "cargo build --locked --manifest-path services/platform/Cargo.toml -p layerx-runtime-clock --bin layerx-runtime-clock && python3 -m pytest -q tests/ci/test_platform_lockfile_current.py"

