build_evidence = "/out/run/gates.jsonl, kind=build; the final passing entry names the candidate revision, exact build command, exit code and private log."
verify_evidence = "/out/run/gates.jsonl, kind=verify; the final passing entry names the same candidate revision, cg spec done command, exit code and private log for the wiring tests and make test-tools-python."
