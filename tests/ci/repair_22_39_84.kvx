[repair.22.39.84]
base_revision = "3a0f70d0fce59d96719043d5294b98aa3718e3bd"
continued_revision = "dbfdb5affdcf022bf7ab21aa40d332fc8f21ec7f"
decisions = ["2771", "2820", "2893", "2896", "2905", "2912"]
implementation = "Keep all thirteen suite fragments and the test-tools-python target, defer candidate policy execution until foundation() is called, and run the target in the unconditional tools-python CI job with its native prerequisites."
suites = ["tools/release/tests", "tools/release/rehearsal", "tools/bringup/tests", "tools/containers", "tools/deps/tests", "tools/rollout", "tools/deploy", "tools/docs/gen", "tools/spec", "tools/benchmark", "tools/jev/tests", "tools/jev/checks", "tools/paxeer-x/tests"]
ci_prerequisites = ["Go from go.mod", "Rust 1.91.1", "Foundry v1.8.1 with the existing pinned action", "zstd", "Docker buildx with the image workflow action pin", "make build/liblayerx.a", "make build-loadtest", "forge build of the EVM loadtest contracts installs solc for their offline binding checks", "go build ./tools/bringup/cmd/bringup-inspect onto PATH", "cargo build --locked --manifest-path tools/bringup/tests/xweb-loader/Cargo.toml", "runner SSH key in authorized_keys and localhost sshd started"]
baseline = "tests/ci/data/tools_python_suite_baseline.json lists exact inherited nodeids, reasons and retiring tasks; the make recipe reads its deselections and the wiring test restricts entries to the families explicitly authorized by decisions 2896 and 2905 and the prior paxeer-x ruling."
verified_revision_source = "The last successful build and verify entries of /out/run/gates.jsonl name the final candidate revision, exact commands, exit codes and private logs; qualification is claimed only when both records have the same revision and verify exits zero."
build_evidence = "/out/run/gates.jsonl, kind=build; private command output /out/logs/build-*.log"
verify_evidence = "/out/run/gates.jsonl, kind=verify; private command output /out/logs/verify-*.log"

[case.wiring]
test = "tests/ci/test_tools_python_suites_wired.py"
assertion = "The make target passes all thirteen real suite directories to pytest, consumes only documented baseline entries, runs on pushes to main and pull requests after all native prerequisites, and collects every paxeer-x module with no Go on PATH while real policy calls still require Go."

[case.candidate_refusals]
retiring_task = "22.39.144"
observed = "The continued baseline records that candidate create refuses the 31-service dispatch fixture because catalogue requires 40 services before calling Go; the prior direct contract replay exited zero with no stderr, and these refusals remain baselined under the prior ruling."

[gotcha.xweb_loader_lock]
observed = "The standalone xweb-loader crate has no committed Cargo.lock at the base, so its first --locked build refuses before compilation."
resolution = "Generate and carry its Cargo.lock with the task, then use the locked build in CI."

[gotcha.offline_solc]
observed = "The EVM binding suite invokes forge build --offline with solc 0.8.20, so a fresh Foundry installation also needs that compiler before the suite."
resolution = "Build the real EVM loadtest contracts in the prerequisite step, allowing Foundry to fetch the pinned compiler before offline checks run."

[qualification.attempt3]
status = "implemented_not_qualified"
revision = "068cca699aa8d3aa7f9be5663e2b6cd81a6fdd35"
build_command = "forge --version > /dev/null && zstd --version > /dev/null && docker buildx version > /dev/null && test -x build/loadtest && test -s build/liblayerx.a && command -v bringup-inspect > /dev/null && test -x tools/bringup/tests/xweb-loader/target/debug/bringup-xweb-config-loader && python3 -m py_compile tests/ci/test_tools_python_suites_wired.py tools/paxeer-x/candidate.py"
build_exit = 0
build_log = "/out/logs/build-1.log"
verify_command = "cg spec done 22.39.84 -f layerx-merge --root /work/paxeer-monorepo"
verify_exit = 1
verify_log = "/out/logs/verify-1.log"
executed_verification = "python3 -m pytest -q tests/ci/test_tools_python_suites_wired.py && make test-tools-python"
result = "4 wiring tests passed; tools suites: 79 failed, 736 passed, 8 pre-existing skips, 44 pre-existing deselections, 7 errors, 463 subtests passed in 814.39 seconds."
baseline_additions = "66 exact nodeids observed failing in the authorized families; these data additions have not been requalified."
continued_by = "Attempt 4 follows decision 2905: task 22.39.157 covers every nodeid under tools/release/tests/ and tools/release/rehearsal/; task 22.39.164 covers every nodeid under tools/bringup/tests/ and tools/benchmark/."
final_revision_note = "Only the baseline and this repair record changed after the failed gate; no passing qualification is claimed for those changes and no unrelated repairs or gate reruns were attempted."

