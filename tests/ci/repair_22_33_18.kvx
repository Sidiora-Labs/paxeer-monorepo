[finding.web-payment-test-fixture.refusal-order]
symbol = "services/agent/sdk/python/layerx_sdk/web_search.py::WebSearchClient._settle"
test = "test_web_search_sequencer.py::test_web_search_public_metered_offer_binds_payer_and_refuses_retired_payment"
observed = "The production settlement consumer compares _receipt_digest before calling verify_sequencer_receipt or reading the raw transaction, so an unchanged real server settlement returns settlement-receipt-mismatch before the retired grant can return receipt-unverified."
proof = "Both payer-DID variants replay the committed server challenge/settlement over loopback HTTP across client reopen; the repaired consumer fetches the transaction through root-path PaymentRpc and returns receipt-unverified caused by LXP_NO_PAYER_GRANT. An independent raw-transaction lookup and verifier require the identical refusal; the finding id remains attached to the refusal-order assertions."
wiring = "services/agent/sdk/python/layerx_sdk/web_search.py::WebSearchClient._settle — domain 9 SDK/web owner: verify the receipt before settlement comparison and align _receipt_digest with services/interop/crates/x-websearch/src/payment.rs::Plane::verify_receipt; the latter verifies the sequencer signature before binding receipt metadata, logs and payment terms."
endpoint = "Both task web integrations construct PaymentRpc with the loopback node root, with no /rpc suffix; the imported peer's unrelated metered tests are outside the narrowed gate."

