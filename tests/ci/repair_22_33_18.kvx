[repair.22.33.18]
audit = "22.30.100"
base_revision = "e827041cca0c781ef801b010257edbe54ff64ed0"
seed_revision = "58ba7cf558d50a0c759b1650386c915ecf582add"
baseline = "Continue the seeded first attempt without rerunning its failed aggregate gate: the supplied ruling records three task web cases plus unrelated aggregate failures; prior qualification entries below retain the earlier evidence. Direct verify_cmd execution is forbidden."
evidence = "The private runner hf-build/hf-done ledger records candidate revision, command, exit and log; the final response copies its last result."
qualification = "The bounded hf-done gate runs python3 -m pytest -q tests/ci/test_repair_22_33_18.py followed by the five SDK test files explicitly; the collector invokes no subprocess toolchain or native artifact."

[finding.market-producer-fixture]
test = "test_ai_market_commit.py::test_market_node_receipt_summary_events_and_return_binding"
repair = "Consume the unchanged node program-call receipt through PaymentRpc and programs._submission; assert summary/event count, return-data digest, signed view/log refusals and unrelated-market-journal refusal. Preserve independent receipt codec coverage in market_receipt_producer.c and the in-process journal codec peer."
limitation = "The available node recording executes a generic program, not a PAXAI envelope; it is not represented as a successful market journal execution."
wiring = "rpc/sequencer_receipt_vectors_test.go and sdk/platform/conformance/fixtures/sequencer-receipt-v1.json — domain 9 node/programs owner: publish a successful PAXAI market-call transaction plus its node receipt, summary, events and return data for positive journal integration."

[finding.market-finality-test-gap]
test = "test_ai_market_commit.py::test_market_forged_commit_is_refused_after_restart"
repair = "Existing journal, revert, landing and reopen cases use pinned CommitTrust and real signed multi-transaction Comet inclusion evidence; forged transaction/aunt/index/header/signature/quorum/chain evidence is refused without journal mutation. Landing-only evidence stays receipted until the pinned verifier succeeds."
peer = "The prerequisite's committed in-process validator peer emits canonical signed commits for the retained transaction; its codec is checked against consensus/types/testdata/light_commit_v1.json."

[finding.retirement-test-preserves-batches]
test = "test_retired_kernel_receipts.py::test_kernel_receipt_paths_are_gone"
positive_test = "test_retired_kernel_receipts.py::test_retained_receipt_and_commit_verification_are_public"
repair = "Prohibit AuthorizedReceiptBatch, PaymentCommitmentEvidence, _SequencerAuthorization and rpc_batch_evidence across public exports and Python declarations/stubs; retain ReceiptKey, raw signed transaction, program execution/recovery and current commit-verifier proofs."

[finding.web-payment-test-fixture]
test = "test_web_search_sequencer.py::test_web_search_public_exact_exchange_replays_server_offer_and_pending"
metered_test = "test_web_search_sequencer.py::test_web_search_public_metered_offer_binds_payer_and_refuses_retired_payment"
repair = "Replace the native-transfer payment fixture with node payExact evidence; replay committed sidecar challenges, ledger accountId RPC responses, payer-address headers, exact payment/signature/settlement and bounded pending retry through public fetch; preserve unknown-key and altered-operation refusals. Replay metered search through real grant preparation and raw-transaction lookup with both registered and address-derived DIDs, refusing retired grants after reopen."
wiring = "services/interop/crates/x-websearch/src/payment.rs and services/agent/sdk/python/layerx_sdk/web_search.py — domain 9 web/ledger owner: reconcile the historical metered sidecar offer with the owning ledger removal of payer grants; no successful grant receipt or settlement is invented here."

[finding.draw-test-transport-shape]
test = "test_x402_draw_sequencer.py::test_grant_draws_verify_through_receipt_keys"
recovery_test = "test_x402_draw_sequencer.py::test_grant_draw_recovery_uses_payment_rpc_without_resubmission"
repair = "Replace the obsolete two-argument receipt-returning transport with real PaymentRpc over a loopback transcript server; call register before and after reopen and assert typed LXP_NO_PAYER_GRANT with no rows or network sends. Separately reopen committed legacy storage, preserving raw transaction/hash bytes and unknown/submitted states; receipt-shaped evidence cannot revive a retired grant. Keep positive payExact receipt and key-tampering verification."
wiring = "services/agent/sdk/python/layerx_sdk/x402_draw.py and modules/layerxledger — domain 9 ledger/payments owner: the proposed successful register/draw recovery path conflicts with the owning removal task, whose register unconditionally refuses payer grants; supply a supported replacement contract before adding positive draw execution."

[finding.http-test-transport-shape]
test = "test_x402_http_sequencer.py::test_buyer_verifies_sequencer_receipts_through_receipt_keys"
commitment_test = "test_x402_http_sequencer.py::test_http_committed_offer_waits_for_verified_inclusion_after_restart"
repair = "Use real prefixed send/hash and separate receipt lookup through PaymentRpc; call grant registration and prove typed refusal/no release. Persist and reopen buyer submissions across unknown/submitted/receipted outcomes without retransmission; committed offers refuse receipt-only evidence and release exactly once after independently pinned block inclusion, including fulfillment-store reopen."

[wiring.c_harness]
request = "Makefile test-tests-python — domain 16 build/test owner: the declared target begins with Python, and its existing CI suite also invokes native tooling; this task forbids adding Makefile edits or native artifact/toolchain requirements to its repair tests; wire tests/protocol/lxp_test_repair_22_33_18.c with tests/lxp_test_harness.c, market_receipt_producer.c compiled with MARKET_RECEIPT_CODEC_LIBRARY, and liblayerx in the separately owned native gate."
limitation = "The C harness cases preserve codec coverage and verify verbatim node summary/event/return-data and ledger-event receipt bytes through the kernel codec/signature verifier; this Python-only gate does not claim their compilation or execution, nor C execution of Python HTTP/journal components."

[wiring.task_record]
request = "spec/layerx-merge/spec.kvx — owning spec domain: link this finding-to-test record and its wiring requests from task 22.33.18; the task explicitly forbids spec edits."


