[repair.22.39.366]
requirement = "22998.1"
base_revision = "8dab153760cc65171174cfaff17fe25ae85d6fb5"
baseline = "Gotcha 4192 records Unknown module type for services/agent/sdk/typescript/node_modules/@scure/base/index.ts after make platform-js-install human-js-install. The implementation-first gate order permits no separate baseline Next build; the declared verification exercises the repaired sample in both layouts."
import_path = "services/platform/examples/samples/paid-route-next/app/paid/route.js:2 and app/layerx/webhooks/route.js:2 import lib/layerx.js, whose line 10 imports @sidiora/layerx-next; sdk/integrations/next/src/index.ts:6-12 imports @sidiora/layerx-sdk; services/agent/sdk/typescript/src/account-derivation.ts:16 imports @scure/bip32, which imports @scure/base."
cause = "services/platform/examples/samples/paid-route-next/next.config.mjs:3 transpiled @scure/bip32 alone. After human-js-install creates the agent SDK private node_modules, Turbopack reaches that installation's @scure/base/index.ts without a transpilePackages declaration for it. The serverExternalPackages list does not configure compilation of transitive dependencies reached by the bundled graph."
reference_repair = "sdk/integrations/next/example/next.config.mjs:3-4 and sdk/integrations/next/example/repair-22-39-352.kvx describe and repair the same dependency path by transpiling @scure/base."
change = "services/platform/examples/samples/paid-route-next/next.config.mjs:4 adds @scure/base beside @scure/bip32 in transpilePackages. Turbopack, the paid route, the webhook route and all serverExternalPackages remain enabled; no dependency or install-order change is needed."
configuration_search = "Searched docs/platform, tests/ci and tools/qualification for paid-route-next, next.config.mjs, nextConfig, transpilePackages, serverExternalPackages and distDir; no literal copy of this sample's Next bundler configuration was found."
documentation_pin = "docs/platform/content/framework/next.md:140-147 quotes the sample's predev/build:dependencies configuration and npm run dev invocation; this out-of-scope documentation is recorded without modification."
test_pin = "tests/ci/test_docs_make_targets_and_scripts.py:58-69 quotes and asserts dev = next dev and the predev command, and requires predev == prebuild; tools/qualification/audit_repairs/test_repair_22_36_2.py:118 inventories the sample next.config.mjs. Both out-of-scope cases remain unchanged."
build_command = "make platform-js-install human-js-install"
verify_command = "test -s tests/ci/repair_22_39_366.kvx && npm run build --workspace @sidiora/layerx-doc-paid-route-next && rm -rf services/agent/sdk/typescript/node_modules && npm run build --workspace @sidiora/layerx-doc-paid-route-next"
private_install_result = "The first npm run build in hf-done exercises the root install followed by the agent SDK private install created by hf-build; an exit-zero verification row establishes that this Next Turbopack build passed."
root_install_result = "The second npm run build in hf-done exercises the root install alone after the declared command removes services/agent/sdk/typescript/node_modules; an exit-zero verification row establishes that this Next Turbopack build passed."
verified_revision = "The exact candidate revision is retained in the final hf-done evidence line and matching build and verify rows of /out/run/gates.jsonl; both gates must exit zero at the same revision."
evidence = "Private evidence: /out/run/gates.jsonl, /out/logs/build-1.log and /out/logs/verify-1.log, or the final repair run paths printed by hf-done. This record defines the two layout checks; their actual exit status and verified revision are supplied by the gate ledger."
