[coverage]
routing_check = "Both workflow test modules execute the real repository routing script at the repository root."
job_shapes = "Every job with runs-on in human.yml and platform.yml outside the script's EXCLUDED table must carry the exact routed form; all eighteen restored jobs are explicitly named and independently asserted, including their absence from EXCLUDED. Both hosted jobs have independent assertions for their runner and exclusion reason."
retained = "Only the eighteen runs-on lines change within workflow jobs; every guard, input and step is retained. The loadtest runner assertion follows the repository-audit reference under decision 2874; every other existing test assertion is retained. The explorer workflow adds a comment outside the jobs explaining its container-runtime exclusions, so its required touches path changes without altering either job."
live_inputs = "job_inputs inspects the job body and inherited workflow environment, excluding the guard and only the exact routed runs-on expression. vars.CI_LINUX_RUNNER has a hosted-runner fallback in that expression and is not a required live-service input; every other input reference remains inspected, including any runner variable consumed elsewhere. The new exact-form routing assertions validate runner selection independently. Every existing presence, bypass and consumed-input assertion remains enforced."

[implementation_notes]
line_numbers = "The inventory's release-promotion line 576 predates the current workflow layout; its restored runs-on is at line 1602."

