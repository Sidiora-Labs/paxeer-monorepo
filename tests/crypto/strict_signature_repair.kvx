[task.22.33.4]
audit_record = "22.30.1"
base_revision = "9fda5aafcf8b4dba3d79ad6d650ea1272c960511"
finding_6 = "test_ed25519_independent_strict_vectors and test_ed25519_point_refusals in tests/crypto/lxp_test_ed25519.c: independent RFC 8032 positive control, recorded CCTV weak-point equation vectors, all torsion y coordinates and their sign variants, nonreduced and off-curve public keys and R; exact LXP_ERR_BAD_SIGNATURE results through raw, domain and mixed-batch production entry points."
finding_7 = "test_secp256k1_eip155_recovery_vector in tests/crypto/lxp_test_secp256k1.c: published EIP-155 signing bytes, digest, compact r/s and recovery ID recover exactly 9d8a62f656a8d1615c1294fd71e9cfb3e4855a4f; the published private key derives the same address. Changed digest and recovery parity cannot bind that signer. Existing generated private-key-one signatures must recover exactly 7e5f4552091a69125d5dfcb7b8c2659029395bdf for exactly one ID. Existing low-S, zero/out-of-range r and invalid-ID checks remain, with additional high-S, zero/out-of-range s and ID 255 refusals."
implementation = "src/crypto/lxp_ed25519.c explicitly rejects every small-order public key and R before OpenSSL equation verification; canonical y checking remains separate from point validation and provider-dependent equation handling. Independently recorded CCTV cases include equation-valid weak A and R, making the refusal boundary observable."
baseline = "Initial working tree had only runner-owned .cgignore and spec status changes; /out/run/gates.jsonl did not exist and gate.json showed zero builds and verifies used. No baseline verify ran because the explicit order requires complete implementation before hf-build and hf-done; no pre-change failures are claimed."
fixtures = "tests/crypto/ed25519_strict_vectors.json and its C initializer ed25519_strict_vectors.inc contain identical cases with explicit OK/BAD_SIGNATURE verdicts; source URL, revision, source SHA256 and original CCTV indices are retained in the JSON."
secp256k1_source = "https://eips.ethereum.org/EIPS/eip-155#example; v=37, chain ID 1, recovery ID 0; the example is historical cryptographic test data, not a Paxeer chain ID setting."
wiring_request = "layerxproof/verify/verify_test.go and layerxproof/testdata/vectors.json (domain 1, kernel/proof verifier): consume tests/crypto/ed25519_strict_vectors.json through the existing strict Go verifier vector test and require ErrBadSignature for every BAD_SIGNATURE case; these paths and the Go gate are outside this task scope. Go execution is not claimed by the native gate."
qualification = "The runner-owned private gate ledger and final evidence line record the exact qualified candidate revision, command, exit code and log; the record is intentionally written before qualification so build and verification use the same candidate."
gotchas = "The pinned CCTV JSON uses uppercase Flags and null for unflagged entries; read Flags as an optional list when selecting original indices. No repository C formatter is configured or installed; touched C follows existing style. GOTCHA.kvx and spec files are outside the task's permitted write scope."
