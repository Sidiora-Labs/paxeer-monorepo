[Unit]
Description=Merged paxd kernel
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=/etc/layerx/kernel.env
ExecStartPre=/usr/bin/test -s /var/lib/layerx/kernel/layerx/node/config/genesis.json
ExecStartPre=-/usr/bin/docker rm -f layerx-kernel
ExecStartPre=/usr/bin/docker pull ${LAYERX_KERNEL_IMAGE}
ExecStart=/usr/bin/docker run --rm --name layerx-kernel --stop-timeout 60 --env-file /etc/layerx/kernel.env -v /var/lib/layerx/kernel:/data -p 127.0.0.1:8545:8545 -p 127.0.0.1:8546:8546 -p 26656:26656 -p 127.0.0.1:9460:9460 ${LAYERX_KERNEL_IMAGE}
ExecStop=/usr/bin/docker stop -t 60 layerx-kernel
Restart=always
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=70

[Install]
WantedBy=multi-user.target
