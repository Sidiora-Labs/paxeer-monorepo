wiring_request_truncation = "Domain 5 (Go storage), storage/db_engine/litt/disktable/disk_table_test.go: update truncatedValueFileTest requiredLength from offset + valueSize + 4 to the exact raw extent offset + Address.ValueSize(); this fixture is outside this task's scope."
