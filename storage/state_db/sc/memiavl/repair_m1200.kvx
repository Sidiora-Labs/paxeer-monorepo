[finding.memiavl-unroutable-read]
tests = ["TestRepairM_1200_UnroutableRead", "TestRepairM_1200_UnloadedReads"]
proof = "Real CommitStore changesets and commits feed unified Committer Get, Has, Iterator and GetProof calls; loaded typos return routing errors, valid stores preserve presence, absence, empty values, ordering and verifiable proofs, and unloaded handles retain safe absence with input validation."

[finding.memiavl-export-cancellation]
tests = ["TestRepairM_1200_ScanStopConvention", "TestRepairM_1200_ExportCancellation", "TestRepairM_1200_SnapshotExportConvention"]
proof = "Real mutable trees with 32768 leaves stop on true and visit all nodes on false; real scans and snapshot exports feed the production exporter channel, whose backpressure and cancellation bound callback count to buffer size plus two and release queued writers within two seconds. Tree.Export and snapshot-backed Tree.Export preserve full stream equality and support prompt idempotent early close."

[constraint.baseline-order]
observed = "Step 6 requests unchanged-tree verification but the explicit gate order requires full implementation, hf-build and then hf-done, and prohibits manual verify runs."
resolution = "Follow the explicit gate order and record the baseline omission without claiming an unrun result."

[gotcha.callback-convention]
observed = "ScanPostOrder promised false-to-stop while both exporter paths use true-to-stop, and the mutable scanner ignored its callback result."
resolution = "Honor and document true-to-stop throughout and check cancellation before attempting another buffered send."

[qualification.proof-fixture]
revision = "623f54a6ff54cebf0bf4c1fd8cccfe2c04f7e398"
