[repair.22.33.954]
finding = "delivery-observation-clock"
proving_tests = ["test_delivery_observation_clock_ingestion_before_and_after_receipt_polling", "test_delivery_observation_clock_exact_budget_and_signed_latency", "test_delivery_observation_clock_rejects_budget_and_causality_failures", "test_delivery_observation_clock_producer_rejects_unbound_receipts", "test_delivery_observation_clock_rejects_observation_as_source_authority", "test_delivery_observation_clock_consumer_rejects_changed_binding", "test_delivery_observation_clock_calibration_is_pinned_bounded_and_current", "test_delivery_observation_clock_rejects_expired_database_timestamp", "test_delivery_observation_clock_rejects_unbound_database_clock"]
baseline_revision = "0e1d5eb94cabe89e2260279a849b7154911ef8ee"
baseline_execution = "Not run: the explicit task gate order prohibits verification before complete implementation and running verify_cmd by hand; no baseline failures are claimed."
clock_contract = "Source timestamps are measured at the chain transaction commit boundary, never at block proposal or receipt observation; offsets are local clock minus UTC. Pinned independent UTC calibration binds source and PostgreSQL clocks and validity windows, with each measured uncertainty bounded by 5ms."
latency_contract = "Signed latency is corrected PostgreSQL transaction commit minus corrected source transaction commit; reject negative latency beyond combined measured uncertainty, retain the signed value without clamping, and qualify the conservative latency-plus-uncertainty millisecond histogram at the unchanged 500000000ns p99 target."
receipt_contract = "The production record_workload_receipt client polls eth_getTransactionReceipt and binds transaction, block, height, successful status and logs to an independent source commit record and pinned calibration; read_receipts checks those exact digests against the independent source journal before reconciliation."
qualification_evidence = "The runner records the exact candidate revision, command, exit and private log in /out/run/gates.jsonl; the final hf-done line identifies the verified revision. No live capacity qualification is claimed by the focused in-process peer tests."
wiring_request = "tools/launchpad/production/load/phase2_feeder.py (owner: launchpad production load/domain 4): use delivery.measure_phase4.record_workload_receipt with independently captured chain_transaction_commit records, emit <profile>-source-commits.jsonl beside <profile>-receipts.jsonl, and supply the approved clock_calibration pin in the capacity ledger; obtain actual transaction commit timestamps/clock identity from the owning chain node telemetry, never synthesize them from block timestamps or polling."
wiring_request_database_clock = "tools/launchpad/production/load/phase2_feeder.py PostgresObserver.committed (owner: launchpad production load/domain 4): include the independently measured primary database clock_id in each commit observation, bound to the configured PostgreSQL server and matching clock_calibration.postgres_clock_id; absent or mismatched identities fail qualification."
gotcha = "The generic audit step asks for a baseline verify, but this task's explicit gate order forbids it; source producer wiring is outside the allowed paths and is recorded here rather than changing production/load or spec files."
continuation_base_revision = "0d67b10a1307bd87573ba79cf46b7f9c0337f7e3"
continuation = "Retain the first attempt's implementation and all 21 test cases. Its passing verification was held because generated bytecode changed the candidate between build and verification; delivery/.gitignore now explicitly excludes Python bytecode, and the runner excludes it from candidate construction. Run hf-build followed by hf-done on the unchanged source candidate; the runner owns commits."
continuation_gotcha = "py_compile writes bytecode even when import bytecode writing is disabled; exclude generated caches rather than publishing interpreter-specific output. Existing GOTCHA.kvx entry 2981 records this environment effect; no out-of-scope ledger edit is made."
