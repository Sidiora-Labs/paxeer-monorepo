[gotcha.local-timeout-is-not-wire-data]
observed = "The checker requires every declared interface field to have an inventory disposition, including local client configuration; a new timeout option is not a new wire property."
resolution = "Use legacy_only without a target field and record the package, field, introducing commit and both source digests; retain all negative checks."

[gotcha.baseline-order]
observed = "do_1 requests a baseline run, while the explicit gate order prohibits testing before full implementation and running verify_cmd by hand."
resolution = "Attribute inherited baseline failures explicitly and run the complete declared verification only through hf-done."

[gotcha.service-paths]
observed = "The launchpad metadata and user service directories are metadata and user, not token-metadata and users."
resolution = "Use the existing handlers.go authorities recorded in each finding; no source outside task scope changes."
