decision = "3177; gotcha 4099"
base_revision = "d5614dd88e548d183376cb26eefb979a56b77018"
change = "Regenerate live source digests from their current authority bytes through the original 22.33.963 file producer; only core-manifest changes after a2bf776a9f sorted the deployment manifest keys."
scope = "Only testdata/repair_22_33_963/capabilities.json and this repair record change; every test, assertion, frozen provenance entry and other frozen record retains its bytes."
qualification = "The qualified revision, command, exit and private log are recorded by hf-build/hf-done in /out/run/gates.jsonl; only a passing hf-done qualifies this task."
qualification_policy = "Run the declared hf-build then hf-done on the same candidate; unrelated baseline failures below remain with fm-launchpad and are neither weakened nor repaired here."

[baseline]
