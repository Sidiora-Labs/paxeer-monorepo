log_sha256 = "348886f30c639cf115c55acdcf76efd9476f2822a9a8b7e464e54c5efda68f01"
result = "26 failed, 41 passed, 13 errors; seven subtests passed; every failing or error case is listed below with its first error."
manifest_cases = 2
unrelated_cases = 37

[producer]
command = "python3 - <<'PY'\nimport hashlib,importlib.util,json\nfrom pathlib import Path\nhere=Path('tools/launchpad/production/interfaces').resolve()\nloader=importlib.util.spec_from_file_location('record_producer',here/'test_repair_22_33_963.py')\nproducer=importlib.util.module_from_spec(loader)\nloader.loader.exec_module(producer)\npath=here/'testdata/repair_22_33_963/capabilities.json'\nbefore=path.read_bytes()\ndocument=producer.capability.load(path)\nauthorities={'workspace':producer.ROOT,'contracts':producer.ROOT/'contracts/launchpad'}\nentries=[]\nfor source in document['sources']:\n    if source['proofKind'] != 'source':\n        raise ValueError('Unexpected proof kind: '+source['id'])\n    if source.get('mode') == 'frozen_provenance':\n        continue\n    authority=authorities[source['authority']].resolve()\n    target=(authority/source['path']).resolve()\n    if not target.is_relative_to(authority):\n        raise ValueError('Source escapes authority: '+source['id'])\n    previous=source['sha256']\n    source['sha256']=hashlib.sha256(target.read_bytes()).hexdigest()\n    entries.append({'id':source['id'],'authority':source['authority'],'path':source['path'],'before':previous,'after':source['sha256']})\nproducer.write_json(path,document)\nreport={'producer':'test_repair_22_33_963.write_json / capability_check.load / sha256 of authority source bytes','before':hashlib.sha256(before).hexdigest(),'after':hashlib.sha256(path.read_bytes()).hexdigest(),'sourceDigest':hashlib.sha256(json.dumps(document['sources'],sort_keys=True,separators=(',',':')).encode()).hexdigest(),'entries':entries,'frozen':[s for s in document['sources'] if s.get('mode')=='frozen_provenance']}\nPath('/out/logs/capabilities-regeneration.json').write_text(json.dumps(report,indent=2,sort_keys=True)+'\\n')\nprint(json.dumps(report,indent=2))\nPY"
exit = 0
log = "/out/logs/capabilities-regeneration.json"
codec = "test_repair_22_33_963.write_json; capability_check.load; hashlib.sha256 on each resolved live source file; no manifest digest is assigned as a literal."
consumer = "test_capability_authority_path reopens the emitted capabilities document, binds the real current contracts authority and recorded SDK catalogue, and invokes the unchanged capability_check.validate and CLI."
materializer = "test_materializer_authority_path invokes the unchanged materialize.main with --spec testdata/repair_22_33_963/selected-catalog.kvx and --supplementary testdata/repair_22_33_963/supplementary.json, reopens generated schema/catalogue bytes, and retains drift and immutable-version assertions."
producer_boundary = "The declared verification executes both producer/consumer cases; no standalone verification command is run before hf-done. Source consistency never claims runtime, browser, chain or release qualification."

