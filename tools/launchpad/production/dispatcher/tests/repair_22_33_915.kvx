[repair.22.33.915]
audit = "spec/layerx-merge/programme/audit/records/22.30.20.kvx"
requirement = "22998.1"
base_revision = "0d67b10a1307bd87573ba79cf46b7f9c0337f7e3"
verification = "hf-done records the exact verified candidate revision, command, exit code and private log; no gate success is claimed before that evidence."
baseline = "No unchanged-tree test execution is claimed: the task order requires implementation before qualification and prohibits running verify_cmd by hand. The incoming gate ledger is empty; the audited hardcoded paths and old ownership exceptions are confirmed by source inspection, not represented as measured failures."
proof = "The real component is a filesystem dispatcher. An explicit committed 208-task, 50-lane peer is parsed by production Graph; its projection uses the actual parsed tasks and lane definitions, then production USTAR archive/extraction transports it to the consumer. Owned source bytes pass through production JSON manifests, content-addressed blobs and trusted staging. There is no network header or restart-recovery finding in this task."
fixture_limit = "fixtures/repair_22_33_915/spec.kvx is an explicitly selected isolated peer, never a fallback or a replacement for the absent reviewed canonical DAG. Default paths still fail closed if canonical documents are missing. These tests prove path resolution and invariants, not production lane qualification."
wiring_request = "Dispatcher tests transport the isolated committed peer and derive its matching execution-plan projection."

[finding.graph-test-machine-root]
tests = ["test_routing_checkout_paths_and_explicit_fixture_override", "test_routing_graph_bounds_dependencies_and_ownership", "test_routing_explicit_missing_documents_fail_closed"]
change = "Derive the checkout and launchpad production document paths from __file__; retain every existing graph bound, dependency, status, ownership and projection assertion. Explicit per-case input paths allow isolated peers without rewriting canonical globals."

[finding.owned-leaf-tests-old-layout]
tests = ["test_routing_current_owned_leaves_and_all_refusals"]
change = "Use actual SDK/mobile leaf bytes under the current ownership map, reopening manifests for staging and preserving foreign ownership, lock, nested manifest, generated sibling, schema and traversal refusals; retired leaf exceptions are additionally refused."

[finding.patch-test-machine-root]
tests = ["test_routing_checkout_paths_and_explicit_fixture_override", "test_routing_fifty_lane_patch_and_handoff_bounds", "test_routing_explicit_missing_documents_fail_closed"]
change = "Resolve canonical spec from the checkout, use current launchpad handoffs for all fifty lanes, check staged bytes and foreign ownership, and preserve old and current handoff boundary refusals."

[finding.fixture-test-machine-root]
tests = ["test_routing_checkout_paths_and_explicit_fixture_override", "test_routing_status_normalization_and_projection_mismatch", "test_routing_explicit_missing_documents_fail_closed"]
change = "Default the document root to checkout/launchpad and preserve the explicit PRODUCTION_DISPATCHER_SPEC_ROOT override. Execute pending, in_progress and done normalization, original-input immutability, fifty-ready, blocked dependency and divergent projection assertions."

[finding.source-policy-tests-old-layout]
tests = ["test_routing_source_policy_all_consumers_and_secret_refusals", "test_routing_moved_source_links_refused_by_every_consumer"]
change = "Retain legacy isolated roots and extend all policy checks to sdk/launchpad/protocol/coverage and sdk/launchpad/shared/secrets across digests, exact declared input hashes, archives, extraction and disk-backed patch staging. Preserve nested secret/output and symlink/hardlink refusal across all source consumers."

[gotcha.scope]
observed = "The local graph was stale for scoped sources; direct reads located the audited files. GOTCHA.kvx and spec records are outside the authorized scope, so task notes remain here."
inherited_state = "The runner's .cgignore and in-progress spec status edits are left untouched."

[gotcha.bytecode]
observed = "Python compilation writes bytecode even with PYTHONDONTWRITEBYTECODE; caches within the allowed tests directory can change the candidate after build."
repair = "Both declared gates run with the same PYTHONPYCACHEPREFIX outside the checkout; generated bytecode is not part of the task candidate."
