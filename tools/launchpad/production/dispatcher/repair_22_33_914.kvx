[repair.22.33.914]
audit = "spec/layerx-merge/programme/audit/records/22.30.20.kvx"
requirement = "22998.1"
base_revision = "4299cb15eced23eb9a839162acd11e9a937edd05"
verification = "hf-done records the verified candidate revision, exact cg spec done command, exit code and private evidence log; no success is claimed before that gate."
baseline = "No pre-change run is claimed: the explicit implementation-first gate order forbids the unchanged-tree verify requested by do_7. The supplied prior-attempt evidence reports 36 tests passing at 090ac2fef0b6df4bbad28d73932f0a191c65d82c, but qualification was held for same_candidate and build_on_verified; this continuation must qualify its own unchanged candidate."
proof = "The component is a filesystem dispatcher: real Go source bytes flow through production digest and declared-input policy, USTAR archive/extraction, JSON manifest/blob transport and trusted patch staging. No network interface, restart-recovery finding, subprocess toolchain or external service is involved."
wiring_request = "launchpad/spec/production-system/spec.kvx and execution-plan.json: launchpad domain 4 coordinator must restore the reviewed matching DAG/plan before production lifecycle qualification; these files are outside this task's paths."

[finding.dispatcher-readme-moved-commands]
task_alias = "routing (doc-drift)"
tests = ["test_routing_documented_real_inputs_follow_archive_and_declared_input_policy"]
change = "Retain corrected monorepo commands and explicit absent-DAG and fixture limits; document actual shared module Go inputs, module command and narrow moved ownership boundaries."

[finding.dispatcher-reserved-paths-before-move]
task_alias = "routing (config-drift)"
tests = ["test_routing_moved_owned_leaves_round_trip", "test_routing_all_fifty_handoffs_and_foreign_lane_refusal", "test_routing_reserved_paths_refused_by_real_patch_producer", "test_routing_contract_roots_and_unsafe_ownership_remain_reserved"]
change = "Reserve moved frozen contract and production document roots; allow only the moved SDK generated leaf, SDK/mobile manifests and L01-L50 handoffs under trusted explicit ownership. Retired leaf exceptions are removed."

[finding.source-policy-drops-moved-code]
tests = ["test_source_policy_moved_go_digest_archive_and_stage", "test_source_policy_moved_source_links_refused_by_all_consumers"]
change = "Admit exact moved protocol coverage and direct secrets-management Go sources while preserving legacy isolated fixture roots, nested output/credential exclusion and link refusals."

[gotcha.scope]
observed = "The graph's source discovery returned no current SDK source paths; direct repository reads located the reviewed files. Root GOTCHA.kvx and spec records are outside the authorized scope, so task-specific limitations are retained here."

[gotcha.candidate_bytecode]
observed = "The gate candidate collector includes untracked bytecode beneath an allowed directory; py_compile and pytest can rewrite those files between candidate snapshots, invalidating build/verify revision identity."
repair = "Remove generated dispatcher bytecode before qualification and set PYTHONPYCACHEPREFIX to a temporary directory outside the checkout for both hf-build and hf-done; the declared commands and all assertions remain unchanged."
inherited_state = "The runner-provided .cgignore change and in-progress spec status are outside this task's scope and are left untouched."
