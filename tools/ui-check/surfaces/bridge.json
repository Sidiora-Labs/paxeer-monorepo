        { "name": "main", "selector": "main" },
        { "name": "first heading", "selector": "main h1" },
        { "name": "primary control", "selector": "#bridge [data-slot=\"card-content\"] > button:last-of-type" },
        { "name": "bridge card", "selector": "#bridge > [data-slot=\"card\"]" },
        { "name": "source route card", "selector": "section[aria-label=\"From\"]" },
        { "name": "destination route card", "selector": "section[aria-label=\"To\"]" },
        { "name": "amount input", "selector": "#bridge-amount" },
        { "name": "destination input", "selector": "#bridge-destination" },
        { "name": "first bridge metric", "selector": "#bridge dl > div:first-child" },
        { "name": "import form", "selector": "form[aria-label=\"Import a bridge transfer\"]" },
        { "name": "import primary control", "selector": "form[aria-label=\"Import a bridge transfer\"] button[type=\"submit\"]" },
