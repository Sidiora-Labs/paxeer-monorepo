        {
          "name": "search-explore",
          "steps": [
            {
              "action": "click",
              "selector": "button[aria-label=\"Search documentation\"]"
            },
            {
              "action": "wait",
              "text": "All docs"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "search-results",
          "steps": [
            {
              "action": "click",
              "selector": "button[aria-label=\"Search documentation\"]"
            },
            {
              "action": "fill",
              "selector": "input[name=\"documentation-query\"]",
              "value": "payment"
            },
            {
              "action": "wait",
              "text": "result"
            }
          ],
          "modes": [
            "default",
            "reduced-motion",
            "double-text",
            "keyboard"
          ]
        },
        {
          "name": "search-empty",
          "steps": [
            {
              "action": "click",
              "selector": "button[aria-label=\"Search documentation\"]"
            },
            {
              "action": "fill",
              "selector": "input[name=\"documentation-query\"]",
              "value": "no-such-documentation-zzzz"
            },
            {
              "action": "wait",
              "text": "No results for"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "search-section",
          "steps": [
            {
              "action": "click",
              "selector": "button[aria-label=\"Search documentation\"]"
            },
            {
              "action": "click",
              "selector": ".search-filters button:nth-child(2)"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "search-selected",
          "steps": [
            {
              "action": "click",
              "selector": "button[aria-label=\"Search documentation\"]"
            },
            {
              "action": "fill",
              "selector": "input[name=\"documentation-query\"]",
              "value": "payment"
            },
            {
              "action": "press",
              "selector": "input[name=\"documentation-query\"]",
              "key": "ArrowDown"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "search-dismissed",
          "steps": [
            {
              "action": "click",
              "selector": "button[aria-label=\"Search documentation\"]"
            },
            {
              "action": "press",
              "selector": "input[name=\"documentation-query\"]",
