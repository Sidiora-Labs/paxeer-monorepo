          "modes": [
            "default",
            "reduced-motion",
            "double-text",
            "keyboard"
          ]
        },
        {
          "name": "assistant-draft",
          "steps": [
            {
              "action": "click",
              "selector": ".docs-assistant-launch-button"
            },
            {
              "action": "fill",
              "selector": "textarea[name=\"question\"]",
              "value": "How do I make my first Paxeer X payment?"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "assistant-answer",
          "steps": [
            {
              "action": "click",
              "selector": ".docs-assistant-launch-button"
            },
            {
              "action": "fill",
              "selector": "textarea[name=\"question\"]",
              "value": "How do I make my first Paxeer X payment?"
            },
            {
              "action": "click",
              "selector": ".docs-assistant-composer button[type=\"submit\"]"
            },
            {
              "action": "wait",
              "text": "Sources \u00b7 1"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "assistant-sources",
          "steps": [
            {
              "action": "click",
              "selector": ".docs-assistant-launch-button"
            },
            {
              "action": "fill",
              "selector": "textarea[name=\"question\"]",
              "value": "How do I make my first Paxeer X payment?"
            },
            {
              "action": "click",
              "selector": ".docs-assistant-composer button[type=\"submit\"]"
            },
            {
              "action": "wait",
              "text": "Sources \u00b7 1"
            },
            {
              "action": "click",
              "selector": ".docs-assistant-sources > summary"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "assistant-cleared",
          "steps": [
            {
              "action": "click",
              "selector": ".docs-assistant-launch-button"
            },
            {
              "action": "fill",
              "selector": "textarea[name=\"question\"]",
              "value": "How do I make my first Paxeer X payment?"
            },
            {
              "action": "click",
              "selector": ".docs-assistant-composer button[type=\"submit\"]"
            },
            {
              "action": "wait",
              "text": "Sources \u00b7 1"
            },
            {
              "action": "click",
              "selector": ".docs-assistant-header button:has-text(\"Clear\")"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "assistant-dismissed",
          "steps": [
            {
              "action": "click",
              "selector": ".docs-assistant-launch-button"
            },
            {
              "action": "click",
              "selector": "[aria-label=\"Close assistant\"]"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "main-navigation",
