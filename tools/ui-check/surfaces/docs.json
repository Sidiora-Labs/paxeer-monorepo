      "name": "system-map",
      "path": "/system-map/",
      "states": [
        {
          "name": "system-query",
          "steps": [
            {
              "action": "fill",
              "selector": "input[name=\"system-query\"]",
              "value": "Paxeer chain node"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "system-empty",
          "steps": [
            {
              "action": "fill",
              "selector": "input[name=\"system-query\"]",
              "value": "no-such-system-zzzz"
            },
            {
              "action": "wait",
              "text": "No systems match these filters."
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "system-cleared",
          "steps": [
            {
              "action": "fill",
              "selector": "input[name=\"system-query\"]",
              "value": "no-such-system-zzzz"
            },
            {
              "action": "click",
              "selector": "button:has-text(\"Clear filters\")"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "system-filtered",
          "steps": [
            {
              "action": "press",
              "selector": "select[name=\"system-kind\"]",
              "key": "ArrowDown"
            },
            {
              "action": "press",
              "selector": "select[name=\"system-kind\"]",
              "key": "Enter"
            }
          ],
          "modes": [
            "default"
          ]
        },
        {
          "name": "system-change",
          "steps": [
            {
              "action": "press",
              "selector": "select[name=\"system-change\"]",
              "key": "ArrowDown"
            },
