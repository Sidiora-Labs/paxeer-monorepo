{
  "name": "Paxeer X documentation",
  "directory": "../../../docs/site/paxeer-docs",
  "build": "CIRCLE_NODE_TOTAL=3 npm run build",
  "start": "node ../../../tools/ui-check/surfaces/docs/start.mjs",
  "address": "http://localhost:4173",
