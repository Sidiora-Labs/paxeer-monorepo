{
  "name": "Sidiora Launchpad \u2014 terminal",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "views": [
    {
      "name": "meta-ag-orders",
      "path": "/meta-ag/orders",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        },
        {
          "action": "wait",
          "text": "Orders are not available yet"
        }
      ]
    },
    {
      "name": "meta-ag-swap",
      "path": "/meta-ag/swap",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        },
        {
          "action": "wait",
          "text": "Swaps are not available yet"
        }
      ]
    },
    {
      "name": "swap",
      "path": "/swap",
      "states": [
        {
          "name": "settings",
          "modes": [
            "default",
            "keyboard"
          ],
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label^=\"Trade settings, slippage\"]"
            },
            {
              "action": "wait",
              "text": "Max slippage"
            }
          ]
        },
        {
          "name": "coin-selector",
          "modes": [
            "default",
            "keyboard"
          ],
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"Select coin\") >> nth=0"
            },
            {
              "action": "wait",
              "text": "Select a coin"
            }
          ]
        }
      ],
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        },
        {
          "action": "wait",
          "text": "You receive"
        },
        {
          "action": "press",
          "selector": "html:not(:has([role=\"status\"]:text-is(\"Loading tokens...\")))",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "terminal",
      "path": "/terminal",
      "states": [
        {
          "name": "layout-menu",
          "modes": [
            "default",
            "keyboard"
          ],
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label=\"Terminal layout\"]"
            },
            {
              "action": "wait",
              "text": "Reset column layout"
            }
          ]
        },
        {
          "name": "settings-menu",
          "modes": [
            "default",
            "keyboard"
          ],
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label=\"Terminal settings\"]"
            },
            {
              "action": "wait",
              "text": "Reset column layout"
            }
          ]
        }
      ],
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Workspace\"] table tbody tr a[href^=\"/terminal/0x\"]):has(section[aria-label=\"Workspace\"] table tbody :text(\"< $0.01\"))",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "terminal-coin",
      "path": "/terminal/0x1111111111111111111111111111111111111111",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(aside[aria-label=\"Pair discovery\"] li[data-pool])",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "This coin is not available yet"
        },
        {
          "action": "press",
          "selector": "html:has(aside[aria-label=\"Pair discovery\"] :text(\"Prices can't load right now\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Pair activity\"] [role=\"alert\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Trade\"] :text(\"Something went wrong, try again\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Window stats\"] :text(\"Since\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-labelledby=\"terminal-accordion-similar\"] :text(\"Similar coins can't load right now\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Price chart\"]):not(:has(section[aria-label=\"Price chart\"] [role=\"status\"]:text-is(\"Loading chart...\")))",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "terminal-portfolio",
      "path": "/terminal/portfolio",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Sign in to see your portfolio"
        }
      ]
    },
    {
      "name": "terminal-rewards",
      "path": "/terminal/rewards",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Connect your wallet to view rewards"
        }
      ]
    },
    {
      "name": "terminal-track",
      "path": "/terminal/track",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Sign in to track wallets"
        }
      ]
    },
    {
      "name": "terminal-trenches",
      "path": "/terminal/trenches",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(ul[aria-label=\"New pairs\"] li :text(\"< 0.01\"))",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "terminal-slug",
      "path": "/terminal/trending",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-terminal-frame] > div[aria-busy=\"false\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Workspace\"] table tbody tr a[href^=\"/terminal/0x\"]):has(section[aria-label=\"Workspace\"] table tbody :text(\"< $0.01\"))",
          "key": "Shift"
        }
      ]
    }
  ],
  "answers": [
    {
      "method": "GET",
      "pattern": "https://www.google-analytics.com/analytics.js",
      "file": "answers/analytics.js",
      "status": 204,
      "headers": {
        "content-type": "text/javascript"
      }
    }
  ],
  "typeScale": [
    {
      "min": 11,
      "max": 12
    },
    {
      "min": 12,
      "max": 13
    },
    {
      "min": 13,
      "max": 14
    },
    {
      "min": 14,
      "max": 16
    },
    {
      "min": 16,
      "max": 18
    },
    {
      "min": 20,
      "max": 24
    },
    {
      "min": 24,
      "max": 28
    },
    {
      "min": 32,
      "max": 44
    },
    {
      "min": 48,
      "max": 64
    },
    {
      "min": 16,
      "max": 28
    }
  ],
  "buildMs": 1800000
}
