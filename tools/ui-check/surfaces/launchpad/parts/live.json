{
  "name": "Sidiora Launchpad \u2014 live",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs --surface tools/ui-check/surfaces/launchpad/parts/live.json",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "readyMs": 120000,
  "views": [
    {
      "name": "live",
      "path": "/live",
      "ready": [
        {
          "action": "click",
          "selector": "[data-live-row-notice] :text-is(\"No live streams right now\"):visible >> nth=0"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "live-empty",
      "path": "/live?render=empty",
      "ready": [
        {
          "action": "click",
          "selector": "[data-live-row-notice] :text-is(\"No live streams right now\"):visible >> nth=0"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "live-error",
      "path": "/live?render=error",
      "ready": [
        {
          "action": "wait",
          "text": "Live streams are not available yet"
        },
        {
          "action": "wait",
          "text": "Platform activity is not available yet"
        }
      ],
      "expects": [
        {
          "method": "GET",
          "pattern": "https://sidiora.test:4173/*",
          "status": 503
        }
      ]
    },
    {
      "name": "live-loading",
      "path": "/live?render=loading",
      "ready": [
        {
          "action": "click",
          "selector": "[data-live-row-notice] :text-is(\"No live streams right now\"):visible >> nth=0"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "live-all",
      "path": "/live/all",
      "ready": [
        {
          "action": "wait",
          "text": "No live streams right now"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
