{
  "name": "Sidiora Launchpad \u2014 community",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "views": [
    {
      "name": "bounties",
      "path": "/bounties",
      "ready": [
        {
          "action": "wait",
          "text": "Make a chart"
        },
        {
          "action": "wait",
          "text": "No bounties paid out yet"
        },
        {
          "action": "press",
          "selector": "html:not(:has([data-region=\"bounty-list\"] [aria-busy=\"true\"])):has([role=\"tab\"]:text(\"Bounties1\")):has([role=\"tab\"]:text(\"Paid0\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:not(:has(dl[aria-label=\"Bounty totals\"] .sl-skeleton))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(footer dl[aria-label=\"Platform activity\"]:not([aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "bounties-empty",
      "path": "/bounties?render=empty",
      "ready": [
        {
          "action": "wait",
          "text": "No open bounties yet"
        },
        {
          "action": "wait",
          "text": "No bounties paid out yet"
        },
        {
          "action": "press",
          "selector": "html:has([data-region=\"bounty-list\"] :text(\"No open bounties\")):not(:has(dl[aria-label=\"Bounty totals\"] .sl-skeleton))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(footer dl[aria-label=\"Platform activity\"]:not([aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible [data-ticker-empty]:has-text(\"No top earners in the last 24h\"))",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "bounties-error",
      "path": "/bounties?render=error",
      "expects": [
        {
          "method": "GET",
          "pattern": "https://sidiora.test:4173/*",
          "status": 503
        }
      ],
      "ready": [
        {
          "action": "wait",
          "text": "Bounties are not available yet"
        },
        {
          "action": "wait",
          "text": "Bounties can't load right now"
        },
        {
          "action": "wait",
          "text": "Platform activity is not available yet"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible [data-ticker-state=\"ready\"])",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "bounties-loading",
      "path": "/bounties?render=loading",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-region=\"bounty-list\"] [aria-busy=\"true\"]):has(footer dl[aria-busy=\"true\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible [data-ticker-loading])",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "bounties-bountyId",
      "path": "/bounties/8e894db0-87e7-4d2a-9f1c-3a192a239ba0",
      "ready": [
        {
          "action": "wait",
          "text": "Post a chart of the pool"
        },
        {
          "action": "wait",
          "text": "No submissions yet"
        },
        {
          "action": "wait",
          "text": "Sign in to submit"
        },
        {
          "action": "press",
          "selector": "html:not(:has([data-shell-content] [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(footer dl[aria-label=\"Platform activity\"]:not([aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
