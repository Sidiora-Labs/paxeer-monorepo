{
  "name": "Sidiora Launchpad — home",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs --surface tools/ui-check/surfaces/launchpad/parts/home.json",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "readyMs": 120000,
  "views": [
    {
      "name": "home",
      "path": "/",
      "states": [
        {
          "name": "search-dialog",
          "steps": [
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible :text(\"callouts yet\"))",
              "key": "Shift"
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label^=\"Search coins and users (\"]:visible"
            },
            {
              "action": "wait",
              "text": "Remember recent views on this device"
            }
          ]
        },
        {
          "name": "sign-in-dialog",
          "steps": [
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible :text(\"callouts yet\"))",
              "key": "Shift"
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) header button:has-text(\"Sign in\")"
            },
            {
              "action": "wait",
              "text": "Connect a wallet to sign in"
            }
          ]
        },
        {
          "name": "paste-address-dialog",
          "steps": [
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible :text(\"callouts yet\"))",
              "key": "Shift"
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label=\"Open a coin from a pasted address\"]"
            },
            {
              "action": "wait",
              "text": "Paste the coin address here"
            }
          ]
        },
        {
          "name": "search-filled",
          "steps": [
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible :text(\"callouts yet\"))",
              "key": "Shift"
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label^=\"Search coins and users (\"]:visible"
            },
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) input[aria-label=\"Search coins and users by name, symbol, wallet or address\"]",
              "value": "science"
            },
            {
              "action": "wait",
              "text": "2 coins, 0 users"
            }
          ]
        },
        {
          "name": "callouts-tab",
          "steps": [
            {
              "action": "click",
              "selector": "[data-home-feed]:visible [role=\"tab\"]:has-text(\"Callouts\"), [data-home-board]:visible section[aria-label=\"Hot callouts\"] [data-column-actions] button[aria-pressed]"
            },
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible [role=\"tabpanel\"] :text(\"No callouts yet\")), html:has([data-home-board]:visible section[aria-label=\"Hot callouts\"] :text(\"callouts yet\"))",
              "key": "Shift"
            }
          ]
        },
        {
          "name": "top-tab",
          "steps": [
            {
              "action": "click",
              "selector": "[data-home-feed]:visible [role=\"tab\"]:has-text(\"Top\"), [data-home-board]:visible section[aria-label=\"Hot callouts\"] [data-column-actions] button[aria-pressed]"
            },
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible [role=\"tabpanel\"] :text(\"No hot callouts yet\")), html:has([data-home-board]:visible section[aria-label=\"Hot callouts\"] :text(\"callouts yet\"))",
              "key": "Shift"
            }
          ]
        }
      ],
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible :text(\"callouts yet\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"0x1111...1111\")):has([data-home-board]:visible section[aria-label=\"Leaderboard\"] :text(\"0x4444...4444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible :text(\"Pool details: Prices are not loading right now, try again\")), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"Pool details: Prices are not loading right now, try again\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444…4444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "first-visit",
      "path": "/?render=first-visit",
      "states": [
        {
          "name": "cookie-consent",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"I understand and agree\")"
            }
          ]
        },
        {
          "name": "cookie-accepted",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"I understand and agree\")"
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"Accept\")"
            }
          ]
        }
      ],
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible :text(\"callouts yet\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible li[data-pool=\"0x1111111111111111111111111111111111111111\"]), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"0x1111...1111\")):has([data-home-board]:visible section[aria-label=\"Leaderboard\"] :text(\"0x4444...4444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible :text(\"Pool details: Prices are not loading right now, try again\")), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"Pool details: Prices are not loading right now, try again\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444…4444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "home-empty",
      "path": "/?render=empty",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible h3:text(\"No coins trending yet\")), html:has([data-home-board]:visible :text(\"callouts yet\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible h3:text(\"No coins trending yet\")), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"No coins trending yet\")):has([data-home-board]:visible section[aria-label=\"Leaderboard\"] :text(\"No traders yet\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"No top earners in the last 24h\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ],
      "states": [
        {
          "name": "callouts-empty",
          "steps": [
            {
              "action": "click",
              "selector": "[data-home-feed]:visible [role=\"tab\"]:has-text(\"Callouts\"), [data-home-board]:visible section[aria-label=\"Hot callouts\"] [data-column-actions] button[aria-pressed]"
            },
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible [role=\"tabpanel\"] :text(\"No callouts yet\")), html:has([data-home-board]:visible section[aria-label=\"Hot callouts\"] :text(\"callouts yet\"))",
              "key": "Shift"
            }
          ]
        },
        {
          "name": "top-empty",
          "steps": [
            {
              "action": "click",
              "selector": "[data-home-feed]:visible [role=\"tab\"]:has-text(\"Top\"), [data-home-board]:visible section[aria-label=\"Hot callouts\"] [data-column-actions] button[aria-pressed]"
            },
            {
              "action": "press",
              "selector": "html:has([data-home-feed]:visible [role=\"tabpanel\"] :text(\"No hot callouts yet\")), html:has([data-home-board]:visible section[aria-label=\"Hot callouts\"] :text(\"callouts yet\"))",
              "key": "Shift"
            }
          ]
        }
      ]
    },
    {
      "name": "home-error",
      "path": "/?render=error",
      "expects": [
        {
          "method": "GET",
          "pattern": "https://sidiora.test:4173/*",
          "status": 503
        }
      ],
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible [data-state=\"unavailable\"]:has-text(\"Trending is not available yet\")), html:has([data-home-board]:visible :text(\"Callouts are not available yet\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible [data-state=\"unavailable\"]:has-text(\"Trending is not available yet\")), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"Trending is not available yet\")):has([data-home-board]:visible section[aria-label=\"Leaderboard\"] :text(\"Leaderboard is not available yet\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible:has(button[role=\"radio\"][aria-label=\"Top earners\"][aria-checked=\"true\"]) > div:last-child:empty)",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Platform activity is not available yet"
        }
      ]
    },
    {
      "name": "home-loading",
      "path": "/?render=loading",
      "ready": [
        {
          "action": "click",
          "selector": "[data-home-feed]:visible [role=\"tab\"]:has-text(\"Callouts\"), [data-home-board]:visible section[aria-label=\"Hot callouts\"] [data-column-actions] button[aria-pressed]"
        },
        {
          "action": "wait",
          "text": "Loading callouts"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"0x1111...1111\")):has([data-home-board]:visible section[aria-label=\"Leaderboard\"] :text(\"0x4444...4444\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-home-feed]:visible), html:has([data-home-board]:visible section[aria-label=\"Trending\"] :text(\"Pool details: Prices are not loading right now, try again\"))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444…4444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "auth-callback",
      "path": "/auth/callback",
      "ready": [
        {
          "action": "wait",
          "text": "Email sign-in is not available yet"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444…4444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "new",
      "path": "/new",
      "ready": [
        {
          "action": "wait",
          "text": "0x1111...1111"
        },
        {
          "action": "press",
          "selector": "html:has(#main-content table tbody tr :text(\"0x1111...1111\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Pool details: Prices are not loading right now, try again"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444…4444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    },
    {
      "name": "not-found",
      "path": "/page-not-found",
      "expects": [
        {
          "method": "GET",
          "pattern": "https://sidiora.test:4173/page-not-found",
          "status": 404
        }
      ],
      "ready": [
        {
          "action": "wait",
          "text": "Page not found"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444…4444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "$2.00"
        }
      ]
    }
  ],
  "answers": [
    {
      "method": "GET",
      "pattern": "https://www.google-analytics.com/analytics.js",
      "file": "answers/analytics.js",
      "status": 204,
      "headers": {
        "content-type": "text/javascript"
      }
    }
  ],
  "typeScale": [
    {
      "min": 11,
      "max": 12
    },
    {
      "min": 12,
      "max": 13
    },
    {
      "min": 13,
      "max": 14
    },
    {
      "min": 14,
      "max": 16
    },
    {
      "min": 16,
      "max": 18
    },
    {
      "min": 20,
      "max": 24
    },
    {
      "min": 24,
      "max": 28
    },
    {
      "min": 32,
      "max": 44
    },
    {
      "min": 48,
      "max": 64
    },
    {
      "min": 16,
      "max": 28
    }
  ],
  "buildMs": 1800000
}
