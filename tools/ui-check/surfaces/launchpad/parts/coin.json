{
  "name": "Sidiora Launchpad \u2014 coin",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "embeddedMessages": [
    {
      "script": "/charting_library/bundles/",
      "message": "Permissions policy violation: unload is not allowed in this document."
    }
  ],
  "views": [
    {
      "name": "coin-address",
      "path": "/coin/0x1111111111111111111111111111111111111111",
      "states": [
        {
          "name": "trades",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) #coin-tabs-tab-trades"
            },
            {
              "action": "wait",
              "text": "No older trades"
            }
          ]
        },
        {
          "name": "about",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) #coin-tabs-tab-about"
            },
            {
              "action": "press",
              "selector": "html:has([role=\"log\"][aria-label=\"Coin chat\"]:not(:has([aria-busy=\"true\"])))",
              "key": "Shift"
            }
          ]
        },
        {
          "name": "callouts",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) #coin-tabs-tab-callouts"
            },
            {
              "action": "wait",
              "text": "Be the first to post a callout for this coin."
            }
          ]
        }
      ],
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-coin-header=\"ready\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-mobile-trade-cta])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(aside[aria-label=\"Hot callouts\"]):not(:has(aside[aria-label=\"Hot callouts\"] .sl-skeleton))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Price chart\"] iframe):has(section[aria-label=\"Price chart\"] [role=\"group\"]:not([inert])), html:has(section[aria-label=\"Price chart\"] :text(\"No trades yet\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "No holders yet"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-label=\"Stats and audit\"]):not(:has(section[aria-label=\"Stats and audit\"] .sl-skeleton))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-labelledby=\"creator-card-title\"] a):not(:has(section[aria-labelledby=\"creator-card-title\"] .sl-skeleton)):not(:has(section[aria-labelledby=\"creator-card-title\"] [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Onchain name: Science Inu"
        },
        {
          "action": "press",
          "selector": "html:has(nav[aria-label=\"Mobile navigation\"]:visible), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        }
