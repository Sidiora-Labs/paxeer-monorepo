{
  "name": "Sidiora Launchpad \u2014 coin",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "views": [
    {
      "name": "coin-address",
      "path": "/coin/0x1111111111111111111111111111111111111111",
      "states": [
        {
          "name": "trades",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) #coin-tabs-tab-trades"
            }
          ]
        },
        {
          "name": "about",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) #coin-tabs-tab-about"
            }
          ]
        },
        {
          "name": "callouts",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) #coin-tabs-tab-callouts"
            }
          ]
        }
      ]
    },
    {
      "name": "coin-0x1111111111111111111111111111111111111111-empty",
      "path": "/coin/0x1111111111111111111111111111111111111111?render=empty"
    },
    {
      "name": "coin-0x1111111111111111111111111111111111111111-error",
      "path": "/coin/0x1111111111111111111111111111111111111111?render=error",
      "expects": [
        {
          "method": "GET",
          "pattern": "https://sidiora.test:4173/*",
          "status": 503
        }
      ]
    },
    {
      "name": "coin-0x1111111111111111111111111111111111111111-loading",
      "path": "/coin/0x1111111111111111111111111111111111111111?render=loading"
    },
    {
      "name": "create",
      "path": "/create",
      "states": [
        {
          "name": "draft-filled",
          "steps": [
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #create-name",
              "value": "Science Inu"
            },
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #create-symbol",
              "value": "SCINU"
            },
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #create-description",
              "value": "A coin for science."
            }
          ]
        },
        {
          "name": "social-links",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) summary[aria-controls=\"create-social-links-panel\"]"
            }
          ]
        },
        {
          "name": "fee-strategies",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"More options\")"
            },
            {
              "action": "wait",
              "text": "Fewer options"
            }
          ]
        }
      ]
    },
    {
      "name": "create-chain",
      "path": "/create/chain",
      "states": [
        {
          "name": "names-filled",
          "steps": [
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #chain-name",
              "value": "science-chain"
            },
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #chain-token-name",
              "value": "Science Inu"
            },
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #chain-token-symbol",
              "value": "SCINU"
            }
          ]
        },
        {
          "name": "name-validation",
          "steps": [
            {
              "action": "fill",
              "selector": "html:has([data-shell-ready]) #chain-name",
              "value": "Invalid name"
            }
          ]
        },
        {
          "name": "fee-strategies",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"More options\")"
            },
            {
              "action": "wait",
              "text": "Fewer options"
            }
          ]
        },
        {
          "name": "connect-wallet",
          "steps": [
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button:has-text(\"Connect wallet\")"
            },
            {
              "action": "wait",
              "text": "Connect a wallet to sign in"
            }
          ]
        }
      ]
    },
    {
      "name": "token",
      "path": "/token"
    },
    {
      "name": "token-poolAddress",
      "path": "/token/0x1111111111111111111111111111111111111111"
    },
    {
      "name": "tokens-tokenAddress-metadata",
      "path": "/tokens/0x3333333333333333333333333333333333333333/metadata"
    }
  ],
  "answers": [
    {
      "method": "GET",
      "pattern": "https://www.google-analytics.com/analytics.js",
      "file": "answers/analytics.js",
      "status": 204,
      "headers": {
        "content-type": "text/javascript"
      }
    }
  ],
  "typeScale": [
    {
      "min": 11,
      "max": 12
    },
    {
      "min": 12,
      "max": 13
    },
    {
      "min": 13,
      "max": 14
    },
    {
      "min": 14,
      "max": 16
    },
    {
      "min": 16,
      "max": 18
    },
    {
      "min": 20,
      "max": 24
    },
    {
      "min": 24,
      "max": 28
    },
    {
      "min": 32,
      "max": 40
    },
    {
      "min": 48,
      "max": 64
    },
    {
      "min": 16,
      "max": 28
    }
  ],
  "buildMs": 600000
}
