{
  "name": "Sidiora Launchpad \u2014 rewards",
  "directory": "../../../../../",
  "build": "node tools/ui-check/surfaces/launchpad/build.mjs",
  "start": "node tools/ui-check/surfaces/launchpad/start.mjs",
  "address": "https://sidiora.test:4173",
  "readyPath": "/",
  "views": [
    {
      "name": "holder-rewards",
      "path": "/holder-rewards",
      "states": [
        {
          "name": "grid",
          "steps": [
            {
              "action": "wait",
              "text": "Showing 1 of 1 loaded coins."
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) [aria-label=\"Grid view\"]"
            }
          ]
        },
        {
          "name": "filters",
          "steps": [
            {
              "action": "wait",
              "text": "Showing 1 of 1 loaded coins."
            },
            {
              "action": "click",
              "selector": "html:has([data-shell-ready]) button[aria-label=\"Filters\"]"
            }
          ]
        },
        {
          "name": "sort",
          "steps": [
            {
              "action": "wait",
              "text": "Showing 1 of 1 loaded coins."
            },
            {
              "action": "press",
              "selector": "html:has([data-shell-ready]) select[name=\"Sort by\"]",
              "key": "End"
            },
            {
              "action": "press",
              "selector": "html:has([data-shell-ready]) select[name=\"Sort by\"]",
              "key": "Enter"
            },
            {
              "action": "press",
              "selector": "html:has([data-shell-ready]) select[name=\"Sort by\"]",
              "key": "Escape"
            }
          ]
        }
      ],
      "ready": [
        {
          "action": "wait",
          "text": "Showing 1 of 1 loaded coins."
        },
        {
          "action": "press",
          "selector": "html:has(section[aria-labelledby=\"top-paying-title\"] article :text(\"Science Inu\")):has(#main-content table :text(\"Science Inu\")):not(:has([aria-label=\"Loading market cap\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-shell-ready]):not(:has(#main-content [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:not(:has(section[aria-label=\"Market ticker\"]:visible)), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        }
      ]
    },
    {
      "name": "holder-rewards-empty",
      "path": "/holder-rewards?render=empty",
      "ready": [
        {
          "action": "wait",
          "text": "No holder rewards paid yet"
        },
        {
          "action": "press",
          "selector": "html:has([data-shell-ready]):not(:has(#main-content [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:not(:has(section[aria-label=\"Market ticker\"]:visible)), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"No top earners in the last 24h\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        }
      ]
    },
    {
      "name": "holder-rewards-error",
      "path": "/holder-rewards?render=error",
      "expects": [
        {
          "method": "GET",
          "pattern": "https://sidiora.test:4173/*",
          "status": 503
        }
      ],
      "ready": [
        {
          "action": "wait",
          "text": "Holder rewards are not available yet"
        },
        {
          "action": "press",
          "selector": "html:has([data-shell-ready]):not(:has(#main-content [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:not(:has(section[aria-label=\"Market ticker\"]:visible)), html:has(section[aria-label=\"Market ticker\"]:visible:has(button[role=\"radio\"][aria-label=\"Top earners\"][aria-checked=\"true\"]) > div:last-child:empty)",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "Platform activity is not available yet"
        }
      ]
    },
    {
      "name": "holder-rewards-loading",
      "path": "/holder-rewards?render=loading",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-shell-ready]):has(section[aria-labelledby=\"top-paying-title\"] [aria-busy=\"true\"]):has(section[aria-labelledby=\"holder-rewards-stats-title\"] [aria-busy=\"true\"]):has(section[aria-labelledby=\"all-holder-rewards-title\"] [aria-busy=\"true\"])",
          "key": "Shift"
        }
      ]
    },
    {
      "name": "leaderboard",
      "path": "/leaderboard",
      "ready": [
        {
          "action": "press",
          "selector": "html:has([data-cup-state=\"unsupported\"]):has(#leaderboard-panel-traders table tbody tr[data-rank=\"1\"])",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-shell-ready]):not(:has(#main-content [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:not(:has(section[aria-label=\"Market ticker\"]:visible)), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
          "key": "Shift"
        },
        {
          "action": "wait",
          "text": "2.00 USDL"
        }
      ]
    },
    {
      "name": "leaderboard-callouts",
      "path": "/leaderboard?tab=callouts",
