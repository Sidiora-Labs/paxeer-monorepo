          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:has([data-shell-ready]):not(:has(#main-content [aria-busy=\"true\"]))",
          "key": "Shift"
        },
        {
          "action": "press",
          "selector": "html:not(:has(section[aria-label=\"Market ticker\"]:visible)), html:has(section[aria-label=\"Market ticker\"]:visible :text(\"0x4444\u20264444\"))",
