{
  "name": "Wallet demonstration",
  "directory": "../../../services/wallet/demo",
  "build": "pnpm --dir ../../../sdk/wallet exec tsc -p tsconfig.json && NEXT_PUBLIC_PAXEER_WALLET_API=http://localhost:3001 NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=demo-panel-test-anon-key pnpm build --webpack",
  "start": "node ../../../tools/ui-check/surfaces/wallet-demo/serve.mjs",
  "address": "http://127.0.0.1:4173",
  "readyPath": "/",
  "views": [
    {
      "name": "home",
      "path": "/",
      "states": [
        {
          "name": "wallet-chooser-empty",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            }
          ]
        },
        {
          "name": "email-sign-in",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            },
            {
              "action": "click",
              "selector": "[open] [data-wallet-embedded]"
            },
            {
              "action": "wait",
              "text": "Send magic link"
            }
          ]
        },
        {
          "name": "email-filled",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            },
            {
              "action": "click",
              "selector": "[open] [data-wallet-embedded]"
            },
            {
              "action": "wait",
              "text": "Send magic link"
            },
            {
              "action": "fill",
              "selector": "[open] input[name=email]",
              "value": "wallet@example.com"
            }
          ]
        },
        {
          "name": "email-validation",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            },
            {
              "action": "click",
              "selector": "[open] [data-wallet-embedded]"
            },
            {
              "action": "wait",
              "text": "Send magic link"
            },
            {
              "action": "fill",
              "selector": "[open] input[name=email]",
              "value": "invalid"
            },
            {
              "action": "press",
              "selector": "[open] input[name=email]",
              "key": "Tab"
            },
            {
              "action": "wait",
              "text": "Enter an email address in the format you@example.com."
            }
          ]
        },
        {
          "name": "email-required",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            },
            {
              "action": "click",
              "selector": "[open] [data-wallet-embedded]"
            },
            {
              "action": "wait",
              "text": "Send magic link"
            },
            {
              "action": "click",
              "selector": "[open] form[aria-label=\"Email sign-in\"] button[type=submit]"
            },
            {
              "action": "wait",
              "text": "Enter an email address in the format you@example.com."
            }
          ]
        },
        {
          "name": "magic-link-sent",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            },
            {
              "action": "click",
              "selector": "[open] [data-wallet-embedded]"
            },
            {
              "action": "wait",
              "text": "Send magic link"
            },
            {
              "action": "fill",
              "selector": "[open] input[name=email]",
              "value": "wallet@example.com"
            },
            {
              "action": "click",
              "selector": "[open] form[aria-label=\"Email sign-in\"] button[type=submit]"
            },
            {
              "action": "wait",
              "text": "Check your email"
            }
          ]
        },
        {
          "name": "dialog-dismissed",
          "steps": [
            {
              "action": "click",
              "selector": ".page-header [data-wallet-connect]"
            },
            {
              "action": "wait",
              "text": "Supported wallets"
            },
            {
              "action": "click",
              "selector": "[open] button[aria-label=\"Close wallet\"]"
            }
          ]
        }
      ]
    },
