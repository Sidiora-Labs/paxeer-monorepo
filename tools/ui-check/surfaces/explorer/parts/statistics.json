{
  "name": "Paxscan explorer statistics",
  "directory": "../../../../../apps/explorer",
  "build": "node ../../tools/ui-check/surfaces/explorer/build.mjs",
  "buildMs": 1800000,
  "start": "node ../../tools/ui-check/surfaces/explorer/start.mjs",
  "address": "http://localhost:4173",
  "readyPath": "/__surface_ready",
  "views": [
    {
      "name": "/api-docs",
      "path": "/explorer/api-docs"
    },
    {
      "name": "/gas-tracker",
      "path": "/explorer/gas-tracker"
    },
    {
      "name": "/stats/[id]",
      "path": "/explorer/stats/coinPrice"
    },
    {
      "name": "/stats",
      "path": "/explorer/stats"
    },
    {
      "name": "/uptime",
      "path": "/explorer/uptime",
      "modes": [
        "default"
      ],
      "expects": [
        {
          "method": "GET",
          "pattern": "http://localhost:4173/explorer/uptime",
          "status": 404
        },
        {
          "method": "HEAD",
          "pattern": "http://localhost:4173/explorer/_next/data/*/uptime.json",
          "status": 404
        }
      ]
    },
    {
      "name": "/validators/[id]",
      "path": "/explorer/validators/1",
      "modes": [
        "default"
      ],
      "expects": [
        {
          "method": "GET",
          "pattern": "http://localhost:4173/explorer/validators/1",
          "status": 404
        },
        {
          "method": "HEAD",
          "pattern": "http://localhost:4173/explorer/_next/data/*/validators/1.json",
          "status": 404
        }
      ]
    },
    {
      "name": "/validators",
      "path": "/explorer/validators",
      "modes": [
        "default"
      ],
      "expects": [
        {
          "method": "GET",
          "pattern": "http://localhost:4173/explorer/validators",
          "status": 404
        },
        {
          "method": "HEAD",
          "pattern": "http://localhost:4173/explorer/_next/data/*/validators.json",
          "status": 404
        }
      ]
    }
  ],
  "answers": [
