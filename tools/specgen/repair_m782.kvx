[gotcha.1]
symptom = "An escaped quote before a hash truncates literal content; an escaped quote before a comma merges list items; encoded escapes reach generated Markdown."
cause = "Independent quote toggles ignored backslash parity and unquote only removed delimiters."
do = "Use the shared quote scanner and validated decoder, with file-to-render vectors and odd/even backslash coverage."
