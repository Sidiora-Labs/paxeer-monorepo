proofs = ["TestRepairM_782_QuotedValues", "TestRepairM_782_Lists", "TestRepairM_782_ProducerToRenderer", "TestRepairM_782_RejectMalformedStrings"]
repair = "Share escape-aware quote state between comment stripping and list splitting; decode quoted tokens with strconv.Unquote and reject malformed tokens during parsing. Preserve raw tokens and decode exactly once before interpolation and rendering."
baseline = "Not run: the task order requires complete implementation before building or testing and permits verification only through hf-done after hf-build; no pre-change failures are claimed."
