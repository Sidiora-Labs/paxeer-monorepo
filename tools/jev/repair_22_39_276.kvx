scope_resolution = "The catalogue is outside the explicit nine-file scope. No allowance is added, no live consensus path is dropped, and no package is renamed: replace the module-specific deposit list with a general keeper/types rule covering the native constructs and live retirement lifecycle. Add the actual bank implementation paths named by the funding replacement. Existing ledger decisions for covered paths remain mandatory."

[fixture_regeneration]
source_revision = "d5a0c9940685169b25d2095344655f65d2ff6420"
source = "Original committed cargo-deny JSONL transcripts at the same fixture paths in source_revision; the deterministic regeneration below prunes only branches whose retired crate trees are absent. Advisory IDs, descriptions, versions, labels, diagnostic order and completion summaries are preserved. These remain historical parser inputs, not a fresh scan or current vulnerability evidence."
command = "python3 -c 'import pathlib,tomllib; exec(tomllib.loads(pathlib.Path(\"tools/jev/repair_22_39_276.kvx\").read_text())[\"fixture_regeneration\"][\"python_source\"])'"
python_source = "import json\nfrom pathlib import Path\nimport subprocess\n\nROOT = Path.cwd()\nSOURCE_REVISION = \"d5a0c9940685169b25d2095344655f65d2ff6420\"\nREMOVED_CRATES = {\n    \"layerx-paxeer-verifier\": \"services/agent/crates/layerx-paxeer-verifier\",\n    \"layerx-programs-protocol-adapter\": \"programs/crates/layerx-programs-protocol-adapter\",\n}\nfor tree in REMOVED_CRATES.values():\n    if (ROOT / tree).exists():\n        raise ValueError(\"cannot prune a crate that still exists: \" + tree)\n\ndef retained_node(node):\n    if node[\"Krate\"][\"name\"] in REMOVED_CRATES:\n        return None\n    result = dict(node)\n    if \"parents\" in node:\n        parents = [retained_node(parent) for parent in node[\"parents\"]]\n        result[\"parents\"] = [parent for parent in parents if parent is not None]\n        if not result[\"parents\"]:\n            del result[\"parents\"]\n    return result\n\nfor workspace in (\"agent\", \"interop\"):\n    path = ROOT / \"tools/jev/checks/fixtures/repair_22_33_704\" / (workspace + \"-advisories.jsonl\")\n    original = subprocess.run(\n        [\"git\", \"show\", SOURCE_REVISION + \":\" + path.relative_to(ROOT).as_posix()],\n        check=True, capture_output=True, text=True,\n    ).stdout\n    output = []\n    for line in original.splitlines():\n        document = json.loads(line)\n        fields = document[\"fields\"]\n        if \"graphs\" in fields:\n            graphs = [retained_node(node) for node in fields[\"graphs\"]]\n            fields[\"graphs\"] = [node for node in graphs if node is not None]\n        output.append(json.dumps(document, sort_keys=True, separators=(\",\", \":\")))\n    path.write_text(\"\\n\".join(output) + \"\\n\", encoding=\"utf-8\")\n"

[gotcha.scope]
observed = "Runner setup changed graph ignore rules, workflow pointers and spec statuses before this task; the task forbids editing GOTCHA.kvx, spec files and the retired-caller catalogue or publishing commits directly."
action = "Preserve setup changes, record task-local findings here, and leave qualification status and publication to hf-done and the runner."

[gotcha.fixture_history]
observed = "The captured dependency graphs predate deletion of two crates and contain historical rustls versions; recapturing current cargo-deny output would change the vulnerability scenarios asserted by their consumers."
action = "Regenerate from the committed transcript source using the recorded structural transformation; keep all diagnostics and expectations without claiming the captures describe the current resolved dependency graph."
