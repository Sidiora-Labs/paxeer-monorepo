[finding.jev-deps-test-roots]
test = "test_repair_22_33_705.py::test_jev_deps_test_roots; test_dependency_capture_reaches_client_and_report_with_real_lockfile_anchors"
repair = "Use services/agent and services/interop in captured inputs and classifications, hash all five live deny files, scan all five manifests, and bind diagnostic and report anchors to real lockfile crate-name lines."
provenance = "Only the four advisory label line offsets in existing captures were relocated to current crate-name lines; advisory versions, descriptions and dependency graphs remain historical. In particular rustls 0.23.43 is recorded codec/routing input, not a claim against the installed 0.23.46."
wiring = "tools/jev/checks/deps.py, domain 16 (fm-tools-ops): replace retired agent/human/interop default roots with services/agent, services/human and services/interop; retain services/platform and programs (22.33.704)."

[finding.jev-doc-test-headings]
test = "test_repair_22_33_705.py::test_jev_doc_test_headings; test_identical_documentation_has_a_complete_clean_response"
repair = "Pin current English/German headings and levels; retain fenced-heading and missing/extra-section checks; report the actual structural difference; enumerate both maintained translation trees and exercise isolated command, endpoint and link-target drift over loopback HTTP."
wiring = "tools/jev/checks/docs.py, domain 16 (fm-tools-ops): publish both maintained translation/source catalogs and preserve fenced commands, bare URLs and link targets in comparison inputs (22.33.704)."

[finding.jev-missing-answer-test]
test = "test_pr.py::BodyFindingTests.test_missing_or_unrelated_answers_fail_at_the_request_boundary (production validation owned by 22.33.706); test_repair_22_33_705.py::test_jev_missing_answer_test_preserves_complete_review_and_certification; test_complete_commit_review_preserves_honesty_and_recorded_commit_anchors"
repair = "Reject empty, unrelated, partial and surplus answer dictionaries at JevClient.evaluate; a complete supported review produces anchored auto findings and a comment with no review/escalation items; retain production-certification and honesty checks."
wiring = "tools/jev/client.py, domain 16 (fm-tools-ops): validate each response against the exact requested question names and kinds before returning an Evaluation; reject incomplete or unrelated answers with JevRequestError (22.33.706)."

[fixtures]
http = "recorded_server.py serves committed response fixtures through real HTTP POST, Authorization and Content-Type headers; assertions bind canonical request bytes and response hashes through the real client and report codecs."
responses = "Decision-response shapes and values derive from existing Jev unit-test examples, with explicit valid/invalid scenario fixtures; these are loopback-server fixtures, not claims of new live-service captures."
commit = "fixtures/repair_22_33_705/commit.json captures git show metadata, name-status and stat output for the last non-merge commit touching test_pr.py reachable from source_revision; the gate parses that evidence without invoking git."
docs = "Operational Markdown fixtures differ in exactly one fenced command, one bare endpoint or one link destination. Both maintained translation trees use README.md as their reference, as their published preambles state."

