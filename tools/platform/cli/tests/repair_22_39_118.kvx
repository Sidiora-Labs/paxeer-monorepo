producer = "services/agent/crates/layerx-sdk/src/rpc.rs:288-291 rejects a mismatched asset; tools/platform/cli/src/wallet_send.rs:159-161 renders the debug error directly, propagated by src/wallet.rs:1442-1443."

[assertion.owner_refusal]
file = "tools/platform/cli/tests/wallet_evm_writes.rs"
symbol = "wallet_send_refuses_mismatched_account_reads_before_submission"
change = "Require exact detail InvalidResponse when owner is replaced; preserve every transport and no-submission assertion."
producer = "services/agent/crates/layerx-sdk/src/rpc.rs:287-291 rejects an owner unequal to the DID key; tools/platform/cli/src/wallet_send.rs:159-161 renders the debug error directly, propagated by src/wallet.rs:1442-1443."

[assertion.next_sequence_refusal]
file = "tools/platform/cli/tests/wallet_evm_writes.rs"
symbol = "wallet_send_refuses_mismatched_account_reads_before_submission"
change = "Require exact detail InvalidResponse for the noncanonical decimal next_sequence 019; preserve every transport and no-submission assertion."
producer = "services/agent/crates/layerx-sdk/src/rpc.rs:297 and :560-575 reject noncanonical decimal sequence text; tools/platform/cli/src/wallet_send.rs:159-161 renders the debug error directly, propagated by src/wallet.rs:1442-1443."

