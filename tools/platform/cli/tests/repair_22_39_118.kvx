[repair.hosted_account_transport]
file = "tools/platform/cli/tests/wallet_evm_writes.rs"
symbol = "WalletFixture::run_with_account_change"
change = "Pass the recording server root to both --rpc and --gateway-rpc; assert POST / for the hosted account query as well as node requests."
producer = "tools/platform/cli/src/wallet.rs:1023-1032 requires write.gateway_rpc for hosted account queries; services/agent/crates/layerx-sdk/src/rpc.rs:1188-1192 sends px_getAccount with the DID and asset, and :1530-1532 preserves the endpoint path. The recorder retains its production wallet_gateway::ledger_account response and exact px_getAccount parameters."

[assertion.nonce_address]
file = "tools/platform/cli/tests/wallet_evm_writes.rs"
symbol = "assert_submission"
change = "Require eth_getTransactionCount parameters to contain 0x followed by lowercase hexadecimal sender bytes and pending."
producer = "tools/platform/cli/src/wallet.rs:991-995 formats from_address with lowercase hex_encode and passes it to get_identity_sequence."

[assertion.estimate_sender]
file = "tools/platform/cli/tests/wallet_evm_writes.rs"
symbol = "assert_submission"
change = "Require the eth_estimateGas from field to equal the same lowercase hexadecimal sender address."
producer = "tools/platform/cli/src/wallet.rs:991 and :1089-1099 place from_address in the transaction object sent to eth_estimateGas."

[assertion.account_id_refusal]
file = "tools/platform/cli/tests/wallet_evm_writes.rs"
symbol = "wallet_send_refuses_mismatched_account_reads_before_submission"
change = "Require exact detail InvalidResponse when account_id is replaced; preserve the failed status, empty stdout, query occurrence and absence of submission."
producer = "services/agent/crates/layerx-sdk/src/rpc.rs:289-291 rejects an account_id unequal to the derived account; tools/platform/cli/src/wallet_send.rs:159-161 renders the debug error directly, propagated by src/wallet.rs:1442-1443."

