replacement = "Runtime callers use eth_getTransactionCount for EVM nonces, and eth_getLogs plus LXP Query/ProgramEvents for program events; these refusal cases are not runtime callers."

[evidence.fees]
source = "src/modules/programs/fees.c::lxp_programs_fee_governance_resolve_runtime; include/layerx/programs.h"
observed = "The declared and implemented reader selects active or exact-version protocol-state schedules, propagates errors and checks replay versions; the kernel host still binds it as an occupancy resolver."
replacement = "MsgUpdateFeeSchedule replaces the retired governance relay write; it does not replace this read-only selector needed for occupancy admission and snapshot restore."
constraint = "Renaming or duplicating the reader, deleting refusal tests, or disguising method literals would silence findings without repairing a retired caller."

