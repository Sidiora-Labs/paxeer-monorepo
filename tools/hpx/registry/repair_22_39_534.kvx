[lint_wiring]
rule = "Repeated-literal checks cover each listed Go package directory."
directory_1 = "consensus/cmd/contract_tests"
rules_replaced_1 = 1
path_1 = "^consensus/cmd/contract_tests/[^/]+\\.go$"
directory_2 = "consensus/privval"
rules_replaced_2 = 1
path_2 = "^consensus/privval/[^/]+\\.go$"
directory_3 = "modules/evm/client/cli"
rules_replaced_3 = 1
path_3 = "^modules/evm/client/cli/[^/]+\\.go$"
directory_4 = "modules/layerxledger/keeper"
rules_replaced_4 = 1
path_4 = "^modules/layerxledger/keeper/[^/]+\\.go$"
directory_5 = "modules/spot/keeper"
rules_replaced_5 = 1
path_5 = "^modules/spot/keeper/[^/]+\\.go$"
directory_6 = "precompiles/layerxagent/scheduler"
rules_replaced_6 = 1
path_6 = "^precompiles/layerxagent/scheduler/[^/]+\\.go$"
directory_7 = "precompiles/layerxpay"
rules_replaced_7 = 4
path_7 = "^precompiles/layerxpay/[^/]+\\.go$"
directory_8 = "precompiles/spot"
rules_replaced_8 = 5
path_8 = "^precompiles/spot/[^/]+\\.go$"
directory_9 = "rpc"
rules_replaced_9 = 3
path_9 = "^rpc/[^/]+\\.go$"
directory_10 = "sdk/crypto/keyring"
rules_replaced_10 = 2
path_10 = "^sdk/crypto/keyring/[^/]+\\.go$"
directory_11 = "sdk/version"
rules_replaced_11 = 1
path_11 = "^sdk/version/[^/]+\\.go$"
directory_12 = "tools/bringup"
rules_replaced_12 = 17
path_12 = "^tools/bringup/[^/]+\\.go$"
directory_13 = "wasm/staticarchive"
