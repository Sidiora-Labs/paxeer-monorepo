[go_commands]
rule = "Go package discovery separates runnable source from generator golden files and multilingual parser fixtures; process harnesses compile their Go cases inside the package they exercise."
changed_files = ["tools/hpx/registry/repair_22_39_511.kvx", ".golangci.yml", "Makefile", "go.mod", "go.sum", "tools/hpx/registry/go.mod", "core/deps/cosmwasm/packages/go-gen/src/main.rs", "core/deps/cosmwasm/packages/go-gen/tests/*.go.golden", "tools/hyperfide/tests/fixtures/go.mod", "tools/hyperfide/tests/fixtures/anchors/main.go", "tools/hyperfide/tests/fixtures/semantic/routes/src/api.go", "tools/hyperfide/tests/fixtures/semantic/systems/fixture.go", "apps/launchpad/web/src/widgets/rewards/registered-reward-handler_test.go.txt", "apps/launchpad/web/src/widgets/rewards/repair-22-31-44.test.ts", "services/platform/hosted/gateway/tests/support/hpx_ingress_test.go.txt", "services/platform/hosted/gateway/tests/hpx_ingress.rs"]
build_command = "forge --version > /dev/null && make -s paxeer-tools-install && for m in tests/fixtures/example/cosmwasm/cw1155 tests/fixtures/example/cosmwasm/cw20 tests/fixtures/example/cosmwasm/cw721 tests/fixtures/example/cosmwasm/echo tests/fixtures/example/cosmwasm/iter tools/benchmark/loadtest/contracts/jupiter tools/benchmark/loadtest/contracts/mars tools/benchmark/loadtest/contracts/saturn tools/benchmark/loadtest/contracts/venus tests/fixtures/example/cosmwasm/parallelization/bank tests/fixtures/example/cosmwasm/parallelization/staking tests/fixtures/example/cosmwasm/parallelization/wasm wasm-runtime/libwasmvm; do cargo fetch --locked --manifest-path $m/Cargo.toml || exit 1; done && for d in tools/hpx/registry sdk/cosmovisor sdk/ics23; do (cd $d && go mod download) || exit 1; done"
verification_command = "test -s tools/hpx/registry/repair_22_39_511.kvx && make -s paxeer-go-lint && GOPROXY=off go mod tidy -diff && cd tools/hpx/registry && GOPROXY=off go build ./..."
prerequisite_commands = ["npm --prefix contracts ci --ignore-scripts --no-audit --no-fund", "npm --prefix tests/integration/dapp_tests ci --ignore-scripts --no-audit --no-fund", "npm --prefix tests/integration/rpc_tests ci --ignore-scripts --no-audit --no-fund"]
verification_dependencies = ["contracts/node_modules", "tests/integration/dapp_tests/node_modules", "tests/integration/rpc_tests/node_modules"]
fixtures = "CosmWasm type fragments retain their bytes as .go.golden files; C parser fixtures retain their source bytes."
modules = "Module requirements and checksums follow Go module tidying."
root_module_command = "go mod tidy"
registry_module_command = "cd tools/hpx/registry && go mod tidy"
format_rule = "The format check requires successful parsing and an empty list of unformatted Go sources."

[go_lint_target]
rule = "The paxeer-go-lint target installs the pinned lint program, builds the native libraries required for type checking, and runs the root lint configuration with module downloads disabled."
changed_files = ["Makefile", "tools/hpx/registry/repair_22_39_511.kvx"]
command = "make -s paxeer-go-lint"

[contract_format]
rule = "Solidity sources follow the formatting configuration in foundry.paxeer.toml."
formatter_version = "v1.8.1"
changed_files = ["contracts/src/xweb/examples/ApiConsumer.sol", "contracts/test/XWebConsumer.t.sol"]
format_command = "FOUNDRY_CONFIG=foundry.paxeer.toml forge fmt --root . contracts/src/xweb/examples/ApiConsumer.sol contracts/test/XWebConsumer.t.sol"
check_command = "FOUNDRY_CONFIG=foundry.paxeer.toml forge fmt --check --root ."

[recording]
rule = "The recovery extension is compiled only for its recording tag and the overlay harness passes that tag when composing the committed fixture."
tag = "layerx_recovery_22_33_47"
changed_files = ["services/human/crates/layerx-human-security-provider/tests/support/recording/recovery.go", "services/human/crates/layerx-human-security-provider/tests/support/recording/record.py"]
commands = ["GOPROXY=off go vet ./...", "GOPROXY=off go build ./...", "GOPROXY=off go vet -tags layerx_recovery_22_33_47 -overlay overlay.json ./daemon/committed-fixture"]

[lint_wiring]
rule = "Lint runs over the root module without report limits; owner wiring requests identify an exact source file and linter, while source diagnostics in the command integration paths are repaired in place."
owner_wiring_request_count = 569
changed_files = [".golangci.yml", "tools/hpx/registry/repair_22_39_511.kvx"]
commands = ["GOPROXY=off build/paxeer-tools/golangci-lint run --max-issues-per-linter=0 --max-same-issues=0 --uniq-by-line=false", "gofmt -l", "GOPROXY=off go vet ./...", "GOPROXY=off go mod tidy -diff", "go mod verify"]
