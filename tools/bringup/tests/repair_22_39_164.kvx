assumption = "Historical attempt-2 finding, resolved by the authorized attempt-3 restoration of the whole-word policy under decision 2933; the documentation remains unchanged."
severity = "blocker"

[repair.faucet_identifier]
producer = "Before the 22.30.177 repair, tools/bringup/docs-names.sh used git grep -w for FAUCET_URL (6fce495bf8); GOTCHA.kvx:995-997 and decision 2933 preserve the whole-identifier boundary."
repair = "ValidateDocumentNames rejects FAUCET_URL only when neither adjacent character is a letter, digit or underscore. LAYERX_FAUCET_URL, LAYERX_GATEWAY_FAUCET_URL and LAYERX_SCHEDULED_FAUCET_URL retain their documented meaning."
assertion = "tools/bringup/repair_m794_test.go:TestRepairM_794_DocsNamePolicy and tools/bringup/tests/test_spec_paths.py:test_docs_names_checks_documentation_policy accept prefixed and suffixed identifiers and refuse the bare identifier at text edges and punctuation boundaries."

[repair.node_parent_names]
producer = "docs/site/docs/reference/public-rpc.md declares the node endpoints; spec/layerx-merge/spec.kvx:3546-3549 public_names publishes api1 through api14.mainnet-beta.paxeer.network; decision 2933 permits describing their shared parent and placeholder first labels."
repair = "DocumentationNames derives each parent domain from inventory.Nodes by removing exactly its first label and adds only that exact parent to the allowed set. No wildcard host permission is introduced."
assertion = "TestRepairM_794_DocsNamePolicy and test_docs_names_checks_documentation_policy accept mainnet-beta.paxeer.network and https://<node>.mainnet-beta.paxeer.network, and refuse unpublished.mainnet-beta.paxeer.network and api15.mainnet-beta.paxeer.network. The unchanged real documentation is checked by test_docs_names_reads_existing_spec."

