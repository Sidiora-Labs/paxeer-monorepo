[repair]
task = "22.39.164"
requirement = "22998.1"
source_revision = "215e9d31d2501e5207b4bb09ec9130e66ccaf154"
decision = "2905, 2908, 2923, 2933"
inventory_gotcha = "3609"
status = "implemented; continuation from c8e49bb70d6a4b1d9ed5494c13c683d895e6bf14 on 4973ad176011a0316da0b6fc54c889207a688a8b; qualification requires the bounded gate evidence below"

[qualification]
verified_revision = "The revision field of the final passing kind=verify entry in /out/run/gates.jsonl, provided the passing kind=build entry has the same revision. No passing revision is claimed before that evidence exists."
build = "hf-build"
verify = "hf-done"
private_evidence = "/out/run/gates.jsonl and the private /out/logs/build-*.log and /out/logs/verify-*.log paths it records"
rule = "Only a passing hf-done at the built revision qualifies this repair; pre-existing producer conflicts remain failures."

[environment]
public_job = ".github/workflows/ci.yml:61 tools-python installs nginx and libnginx-mod-stream through apt alongside openssh-server and the existing native prerequisites."
qualification = "The disposable qualification environment installs nginx and libnginx-mod-stream through apt in the same way as the public job; private installation evidence is /out/logs/prerequisite-apt.log. The native library, loadtest, bringup-inspect, xweb loader, pinned Solidity compiler and localhost SSH prerequisites follow the job's declared preparation commands."
producer = "tools/bringup/tests/test_repair_22_31_319.py:test_edge_manifest_roundtrip_both_consumers_over_ssh requires nginx and loads /usr/lib/nginx/modules/ngx_stream_module.so; tools/bringup/edge.sh:397 names libnginx-mod-stream."
assertion = "tests/ci/test_tools_python_suites_wired.py:test_ci_runs_tools_python_target requires both apt packages before the native prerequisite build and suite execution."

[assertion.search_front]
test = "tools/bringup/tests/test_repair_22_31_319.py:test_search_front_roundtrip_primary_backup_and_refusals"
producer = "tools/bringup/search-front.sh:118 calls load_hosts before discovery; tools/bringup/check-live.sh:323-342 reads BRINGUP_HOSTS_FILE and requires every declared role; tools/bringup/check-live.sh:545-561 discovers the nginx site through rpc_unit."
repair = "Supply tests/fixtures/repair_22_39_164/hosts.env, render each discovery site's real configuration with edge.sh, and translate the nginx directory to those fixture directories over real OpenSSH. Assert discovery equals the serving/validator listing before the original primary, backup, malformed and readiness refusal assertions."

[assertion.xweb_rotation]
test = "tools/bringup/tests/test_repair_22_31_319.py:test_xweb_config_roundtrip_rotation_and_refusals"
producer = "tools/bringup/xweb_transport.go:59-64 validates separate hosted gateway and node roots; tools/bringup/upgrade_state.go:75 requires a root-only node URL; tools/bringup/xweb_transport.go:97-113 decodes flat committed asset records."
repair = "Serve hosted px_listAssets at /gateway with its declared flat asset records and px_getReceiptKeys at the node root /. Retain every loader, rotation and malformed-history refusal assertion and assert both methods reach their declared paths."

[assertion.kernel_credential]
test = "tools/bringup/tests/test_repair_22_31_319.py:test_internal_probe_kernel_identity_over_private_route_over_ssh"
producer = "tools/bringup/check-live.sh:2360-2374 dispatches on the role group using the kernel's Human identity; tools/bringup/repair_cli.go:208-231 reads the protected bundle and prints the typed success line; tools/bringup/bundle.go:141 checks PEM/DER consistency."
repair = "Require exact refusal after DER key corruption and missing custody, restore the real key and prove readiness recovers, and assert the current group-based probe remains ready for an unused app argument. Count actual mTLS requests and retain the identity confinement assertions."

[assertion.kernel_private_route]
test = "tools/bringup/tests/test_repair_22_31_319.py:test_internal_probe_kernel_identity_over_private_route"
producer = "tools/bringup/check-live.sh:2365-2373 sends bringup-inspect internal-readiness over SSH and maps remote refusal to @@<group> 1 000 refused; tools/bringup/live_repair.go:506 validates private connect targets inside the remote inspector."
repair = "Update the existing transcript to the inspector command and typed response. Require every transcript exchange to equal a real OpenSSH/inspector/private TLS exchange in this test before replaying it. Missing identity and malformed routing must produce exact refusals without additional HTTP requests."

[assertion.xweb_seeds]
test = "tools/bringup/tests/test_xweb_config.py:XwebConfigTest.test_render_emits_no_lx_route"
producer = "services/interop/crates/x-websearch/src/config.rs:473-482 rejects example.com and other placeholder hosts; lines 707-712 require a nonempty validated seed list."
repair = "Use the published https://paxeer.network/ crawl seed and retain native loader validation of every rendered serve and attestor configuration and every altered configuration refusal."

[assertion.erc721]
test = "tools/benchmark/loadtest/contracts/evm/test_sources_match_bindings.py:test_my_nft_abi_matches_erc721_binding"
producer = "tools/benchmark/loadtest/contracts/evm/src/ERC721.sol:149-156 declares both MyNFT.mint and MyNFT.burn with the uint256 parameter tokenId."
repair = "Align bindings/erc721/abi.json and the Go binding's embedded ABI and method parameter names for both methods with the compiled source. Preserve exact canonical ABI equality and also require the embedded Go ABI to equal the compiled artifact."

[assertion.block_statistics]
test = "tools/benchmark/loadtest/scripts/test_repair_22_31_431.py:test_benchmark_rpc_envelope_block_statistics"
producer = "tools/benchmark/loadtest/scripts/metrics.py:57-60 exposes a Python datetime and lines 71-73 serialize it back; tools/benchmark/loadtest/operations/metrics.go:185-192 subtracts the supplied timestamp from the next block's RFC3339Nano timestamp without rounding."
repair = "Assert exactly (0, 33716908, 1869.633323): the supplied Python timestamp is 02:47:16.051308000 and the next captured block is 02:47:17.920941323. Keep tuple equality and the exact HTTP request sequence, without a floating point tolerance."

[assertion.baseline]
test = "tests/ci/test_tools_python_suites_wired.py"
producer = "Makefile:test-tools-python reads tests/ci/data/tools_python_suite_baseline.json and deselects exactly its listed nodeids."
repair = "Remove all ten bringup/benchmark entries and assert neither prefix nor retiring task 22.39.164 remains. Keep the 22.39.164 family in the exact-case validator so the family remains valid when empty."

