{
  "description": "SSH command/response contract at edge and authorized kernel origins. Public readiness is exercised against loopback TLS; manifest/site stdout is supplied unchanged by edge.sh. Test-only stream certificate, never a deployment identity.",
  "exchanges": [
    {
      "id": "dns-edge.bringup.test",
      "tool": "getent",
      "argv": [
        "ahosts",
        "edge.bringup.test"
      ],
      "stdout": "127.0.0.1 STREAM edge.bringup.test\n127.0.0.1 DGRAM edge.bringup.test\n"
    },
    {
      "id": "dns-box.bringup.test",
      "tool": "getent",
      "argv": [
        "ahosts",
        "box.bringup.test"
      ],
      "stdout": "127.0.0.1 STREAM box.bringup.test\n127.0.0.1 DGRAM box.bringup.test\n"
    },
    {
      "id": "dns-ramp.bringup.test",
      "tool": "getent",
      "argv": [
        "ahosts",
        "ramp.bringup.test"
      ],
      "stdout": "127.0.0.1 STREAM ramp.bringup.test\n127.0.0.1 DGRAM ramp.bringup.test\n"
    },
    {
      "id": "dns-railway.bringup.test",
      "tool": "getent",
      "argv": [
        "ahosts",
        "railway.bringup.test"
      ],
      "stdout": "127.0.0.1 STREAM railway.bringup.test\n127.0.0.1 DGRAM railway.bringup.test\n"
    },
    {
      "id": "dns-stream.bringup.test",
      "tool": "getent",
      "argv": [
        "ahosts",
        "stream.bringup.test"
      ],
      "stdout": "127.0.0.1 STREAM stream.bringup.test\n127.0.0.1 DGRAM stream.bringup.test\n"
    },
    {
      "id": "dns-rpc.bringup.test",
      "tool": "getent",
      "argv": [
        "ahosts",
        "rpc.bringup.test"
      ],
      "stdout": "127.0.0.1 STREAM rpc.bringup.test\n127.0.0.1 DGRAM rpc.bringup.test\n"
    },
    {
      "id": "edge-read",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "nginx_dir={NGINX_DIR}; cat \"$nginx_dir/edge/manifest\" 2>/dev/null; echo @@sites; for f in \"$nginx_dir\"/sites-available/* \"$nginx_dir\"/edge/stream/*.conf; do head -n 1 \"$f\" 2>/dev/null | grep -q \"^# rendered by tools/bringup/edge.sh\" && cat \"$f\"; done; true"
      ],
      "stdout": "",
      "stdout_file": "{SNAPSHOT}"
    },
    {
      "id": "box-upstream",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "curl -fsS --max-time 10 --connect-to 10.0.0.5:8080:10.0.0.5:8080 -H 'Host: box.bringup.test' http://10.0.0.5:8080/readyz"
      ],
      "stdout": "{\"ready\":true}"
    },
    {
      "id": "ramp-upstream",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "curl -fsS --max-time 10 --cacert {BOX_CA} --connect-to backend.bringup.test:9443:10.0.0.6:9443 -H 'Host: ramp.bringup.test' https://backend.bringup.test:9443/readyz"
      ],
      "stdout": "{\"ready\":true}"
    },
    {
      "id": "railway-upstream",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "curl -fsS --max-time 10 --connect-to backend.bringup.test:443:service.up.railway.app:443 -H 'Host: backend.bringup.test' https://backend.bringup.test:443/readyz"
      ],
      "stdout": "{\"ready\":true}"
    },
    {
      "id": "rpc-api1.mainnet-beta.paxeer.network",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "curl -fsS --max-time 10 -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_chainId\",\"params\":[]}' https://api1.mainnet-beta.paxeer.network/"
      ],
      "stdout": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x7d\"}"
    },
    {
      "id": "rpc-api2.mainnet-beta.paxeer.network",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "curl -fsS --max-time 10 -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_chainId\",\"params\":[]}' https://api2.mainnet-beta.paxeer.network/"
      ],
      "stdout": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":\"0x7d\"}"
    },
    {
      "id": "stream-upstream",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "edge.bringup.test",
        "timeout 10 openssl s_client -connect 10.0.0.7:9443 -servername stream.bringup.test </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256 2>/dev/null"
      ],
      "stdout": "sha256 Fingerprint=79:D4:3D:55:2E:17:6B:5E:0D:10:6F:4E:5B:F4:09:63:A3:82:0E:F1:2C:44:70:04:23:1A:27:28:70:33:02:06\n"
    },
    {
      "id": "internal-kms",
      "tool": "ssh",
      "argv": [
        "-n",
        "-o",
        "BatchMode=yes",
        "--",
        "kernel.bringup.test",
        "{INSPECTOR} internal-readiness https://internal-kms.railway.internal:9443/readyz {TLS_DIR}/human-event-client {PRIVATE_TARGET}"
      ],
      "stdout": "pass readiness http=200 ready=true identity=human-event-client\n",
      "exit": 0
    },
    {
