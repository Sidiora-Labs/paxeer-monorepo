[gotcha.scope]
observed = "Exclusive scope forbids GOTCHA.kvx and spec edits, commits and pushes; preserve runner metadata changes and keep finding maps, wiring requests and session gotchas in this task record. The runner owns publication."
[gotcha.inventory]
observed = "The audit calls layerxproof retired, but current modules/sequencer directly imports layerxproof/verify; removing that real dependency would falsify source provenance. Retain and positively assert the linked library while refusing retired executable products."
[gotcha.qualification]
observed = "The declared Go gate uses no credentials, environment variables, subprocesses or native artifacts. Standalone shell/Python/container qualifications retain their actual external prerequisites and are not claimed as executed by this bounded gate."

[gotcha.formatting]
observed = "Formatting caught a Go test string written with single quotes; corrected the string, matched certificate refusal assertions to the existing exact incompatible state, and selected the actual stream listener port before verification. The production build passed; a fresh build binds the corrected candidate before hf-done."

