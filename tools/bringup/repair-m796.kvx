[finding.fleet-unbounded-transports]
task_alias = "set (runtime-risk)"
test = "TestRepairM_796_FleetTransportDeadlines"
repair = "Bound release connection, headers, body and total transfer; verify checksums before atomic publication. Bound SSH dial/handshake/session and scp, propagate operator cancellation to transports and remote process groups, and fence remote operations with flock so recovery cannot race an abandoned mutation. Timeouts name durable recovery."
proof = "Real HTTP release producer and SSH transport against loopback peers: successful checksummed release, stalled headers/body/handshake/command, caller cancellation, corrupt and ambiguous checksum refusal, no incomplete publication."

[finding.fleet-test-missing-interruption-recovery]
task_alias = "set (test-gap)"
test = "TestRepairM_796_FleetInterruptionRecovery"
integration_target = "tools/bringup/repair_m796_test.go; the declared Go gate runs the service lifecycle cases directly, without the historical shell harness's always-active systemctl stand-in."
repair = "FleetOwner journals original source and target active states and binary hashes before source stop; streams data through bounded SSH; retains rollback material before swap; restores source and original target generation on reopen. State qualification binds active MainPID's /proc executable hash to its installed binary. Failed recovery blocks new admission."
proof = "Real owner/store/flock/SSH/tar path with disposable service generations: stop owner mid-copy and mid-swap, close outstanding streams, reopen, restore source and original target executable/data, preserve originally inactive targets, then complete a new generation and reopen again; refuse competing owners and failed restoration."

[finding.ca-test-obsolete-count]
test = "TestRepairM_796_CAApprovedRoster"
repair = "Replace obsolete count with exact six-field comparison to the independently approved thirty-member merged roster, retaining actual CA issuance and SAN checks."
proof = "Maintained base roster and name completion agree in all six fields with the approved roster; every real issued CA bundle crosses production base64 custody/report codecs and certificate validation; foreign common names, SANs, malformed rows, duplicate and retired identities are refused."

[finding.edge-test-router-routing]
test = "TestRepairM_796_EdgeAggregateRoutes"
repair = "Render maintained fourteen-node aggregate pool and current hosted gateway route. Preserve upstream TLS, SNI, forwarding headers, box/stream routes and actual manifest consumption."
proof = "Production map and renderers -> six-field manifest plus actual nginx sites -> production contract consumer; all fourteen member names and independent TLS/header checks pass through the same path, while legacy rows, disabled verification and all-down pools are refused."

[finding.foundation-artifact-inventory]
test = "TestRepairM_796_FoundationArtifactInventory"
repair = "Use paxd, attestor and bringup-inspect outputs with their source and runtime-library closure; retain layerxproof as the actual linked sequencer verifier library, excluding retired executables and settlement manifests. Compute the production import graph with go list -deps for paxd (netgo,ledger), bringup-inspect and the nested attestor module (CGO_ENABLED=0); validate recorded package edges, source/module digests and native build inputs without spawning a toolchain in the gate."
proof = "Embedded declaration -> actual CLI plan codec -> source closure over maintained repository files -> production fixture manifest consumer wiring; missing linked dependencies, retired outputs/version/source paths and foreign runtime libraries are refused. Native build provenance and artifact hashes remain required by the standalone consumer."

[finding.genesis-test-rejected-guarantor-input]
test = "TestRepairM_796_NativeGenesisInputs"
repair = "Replace rejected LXGB guarantor fixture with actual paxd genesis, bank/sequencer/lxphost inputs and the native receipt seed; preserve module, asset, malformed-input and signature checks."
proof = "Committed disposable native inputs -> real consensus genesis codec, bank validator, sequencer validator and pinned receipt signer -> file/CLI report; genuine consensus vote/signature generation verifies native committed output. Refuse retired modules, negative assets, receipt ranges, unknown fields, foreign signer/chain and malformed JSON."

[finding.mint-test-retired-contract]
test = "TestRepairM_796_MintCurrentConsumers"
repair = "Mint only current service owners and least-privilege webhooks roles; identity and registry tokens stay plain as their actual entrypoints expect, file secrets are base64 encoded; remove kernel replicas and separate authority routing."
proof = "Real cryptographic mint producer -> private atomically published files -> closed-schema delivery decoder -> maintained image files.tsv destinations; validate all nineteen consumers, thirty-one files, twenty-five distinct token boundaries and shared ends, real five-certificate SPKI-pinned ES256 inventory, modes, malformed inputs, foreign schemas and overwrite refusal. Actual deployment input reader and CLI mint are also exercised."

[finding.foundation-fixture-retired-producers]
test = "TestRepairM_796_FoundationCommittedRestart"
repair = "Initialize and validate with paxd, launch its integrated kernel, consume actual canonical Comet signatures and same-height EVM results, and retain native genesis, validator/receipt identities and cryptographically checked committed state across restart. Manifest v2 refuses retired foundation shape."
proof = "Real consensus signed header/vote producer -> loopback Comet/EVM JSON-RPC transport -> production durable FoundationState -> close/reopen and CLI consumer. Reject rollback, same-height divergence, wrong signatures, chain/block mismatch and retained genesis mismatch; preserve durable floor after every refusal."

