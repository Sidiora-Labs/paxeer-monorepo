[repair.22.39.4]
requirement = "22998.1"
base_revision = "c1c16a3682cc8a2685b1ee7e9c2901866bd40732"
change = "Fly do returns status and bytes and closes its response on every read path; callers retain typed API error details. Bridge cleanup and read-only Close errors are explicitly discarded. CI watches repaired packages and selects the root config."
tests = ["TestFlyClientDoReturnsStatusAndBody", "TestFlyClientDoClosesResponseBody"]
status_case = "Real httptest responses preserve 200, 201 and 422 status and exact bytes; POST headers and payload and all three caller error details are asserted."
close_case = "A real HTTP stream exceeds maxResponseBytes; the bounded result is asserted and the server observes request cancellation from closing the unread body."
qualification = "The runner records the immutable candidate revision, exact build and verify commands, exits and private logs in its gate ledger; no unrun gate is claimed here."

