genesis = "services/platform/hosted/paxeer/init-chain.sh; disposable single-validator chain hyperpax_125-1, EVM id 125, funded local fixture signer, loopback listeners only"
inputs = "Reader constructor sets slot 1 to 7 and installs 600154506000545000 (SLOAD 1; POP; SLOAD 0; POP; STOP). A successful read-only call is followed by CREATE constructor 6009600255600060005360016000f3, which sets slot 2 to 9 and installs STOP. Expired -1ns tracer timeouts produce actual per-transaction errors in both modes."
proof = "Node replies are retained unchanged; tests assert unchanged full-mode code and zero/nonzero SLOADs, absence from diff, CREATE poststate code/storage, clean comparison, isolated divergent storage/unchanged code/created code and fail-closed indeterminate comparison without state reads. Replay changes only JSON-RPC ids and explicit shadow-state divergences."
private_evidence = "/tmp/repair-m837-node-build.log; /tmp/repair-m837-node-init.log; /tmp/repair-m837-node-capture.log; /tmp/repair-m837-capture.log; /out/run/gates.jsonl"

