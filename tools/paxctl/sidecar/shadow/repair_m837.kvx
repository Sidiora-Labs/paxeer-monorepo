resolution = "Use the supported occ-enabled=false and giga_executor.occ_enabled=false settings for this disposable fixture capture without changing genesis or production node code; report the unrelated default-executor failure."
wiring_request = "node/ante and engine/deps/tasks (node execution owners): repair OCC handling of signer association balance iteration; outside this shadow test scope."

