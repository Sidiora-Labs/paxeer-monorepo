repair = "Removed the subprocess toolchain and helper module; retained the original exact coverage assertions, and exercised the public comparison verdict with committed HTTP peers."

[repair.22.31.328.gotcha]
observed = "Importing the full tracing node also requires additions to the CLI's out-of-scope manifest; building a helper module during verification violates the self-contained gate contract."
resolution = "The gate uses committed peer fixtures and the existing CLI dependency graph, with no TestMain, subprocess, external service or environment configuration."
