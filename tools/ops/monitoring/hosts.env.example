# Deploy input. Copy to /etc/paxeer-monitoring/hosts.env on the monitoring host and fill in.
# Never commit the filled copy.

# Space-separated name=address pairs. Every host is scraped on the CometBFT
# metrics port and the node_exporter port.
HOSTS=""
COMET_METRICS_PORT=26660
# paxd consensus RPC: /health for availability, /status for catch-up readiness.
COMET_RPC_PORT=26657
NODE_EXPORTER_PORT=9100

# Space-separated service metrics URLs (scheme, host:port and path are taken from each URL).
KEEPER_METRICS_URLS=""
FEEDER_METRICS_URLS=""
PAXAI_WORKER_METRICS_URLS=""
AI_EVALUATOR_METRICS_URLS=""
X_WEBSEARCH_METRICS_URLS=""
WALLET_ATTESTOR_METRICS_URLS=""

AUTHORITY_METRICS_URLS=""

# Space-separated explorer index head and stream metering provider URLs (probed for HTTP 2xx).
EXPLORER_INDEX_HEAD_URLS=""
STREAM_METER_PROVIDER_URLS=""

# Space-separated edge HTTPS URLs whose certificate expiry is watched.
EDGE_CERT_URLS=""

# Alert route: set ALERT_WEBHOOK_URL, or the ALERT_EMAIL_* block, or both.
ALERT_WEBHOOK_URL=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM=""
ALERT_SMTP_SMARTHOST=""
ALERT_SMTP_USERNAME=""
ALERT_SMTP_PASSWORD=""
