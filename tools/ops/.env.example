# Environment for keyring-migrate.sh; export these assignments before invocation.
# BACKUP_ENV selects a backup file containing the shared BACKUP_* settings below.
BACKUP_DIR=
BACKUP_ENV=/etc/paxeer/backup.env
BACKUP_HOST=
BACKUP_IDENTITY=
BACKUP_PREFIX=$(hostname -s)
BACKUP_RETENTION=14
BACKUP_SSH="ssh -o BatchMode=yes"
# First line of this protected file supplies the passphrase.
KEYRING_PASSPHRASE_FILE=
PAXD=paxd
