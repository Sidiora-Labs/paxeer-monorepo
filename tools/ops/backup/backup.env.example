# Deploy input for backup.sh / restore.sh. Copy to /etc/paxeer/backup.env (mode 0600).
BACKUP_ENV=/etc/paxeer/backup.env
# Archive store: leave empty when the job runs on the backup host.
BACKUP_HOST=
BACKUP_DIR=
BACKUP_RETENTION=14
BACKUP_PREFIX=$(hostname -s)
BACKUP_SSH="ssh -o BatchMode=yes"
# age public recipients; provide a protected recipients file.
BACKUP_RECIPIENTS_FILE=
# Complete node home (data, signing state and config) and kernel store are mandatory.
# Space-separated absolute paths; symlinks/special files are rejected.
BACKUP_NODE_HOME=
BACKUP_KERNEL_DIR=
BACKUP_SOURCES=
# Include every additional private key required by the deployment. The standard
# validator/node keys and signing state are always required, even if omitted here.
BACKUP_REQUIRED_KEYS=
# Required site-owned commands, intentionally unset: backup fails closed without them.
# Quiesce must stop/flush ALL writers and inhibit automatic restarts until resume.
# Resume must be idempotent, including after a partially failed quiesce.
BACKUP_QUIESCE_CMD=
BACKUP_RESUME_CMD=
# Validator receives BACKUP_RESTORE_ROOT and BACKUP_SNAPSHOT_MANIFEST, and remapped
# BACKUP_NODE_HOME/BACKUP_KERNEL_DIR. Reopen recovered stores offline, verify their
# committed height/root agreement and load every required key; nonzero rejects.
# Never start consensus/signing or use a live home, network or production socket.
BACKUP_VALIDATE_CMD=
BACKUP_LOCK_FILE=/run/lock/paxeer-backup.lock
# Optional command whose stdout is the wallet database dump.
BACKUP_DB_DUMP_CMD=
# Required for backup validation and restore.sh: protected age identity file.
BACKUP_IDENTITY=
