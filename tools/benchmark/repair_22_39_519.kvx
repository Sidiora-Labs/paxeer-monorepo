[meta]
name = "Benchmark and pipeline controller lint configuration"

[rule.1]
file = "tools/flyci/controller/config.go"
linter = "goconst"
status = "removed"
reason = "Repeated protocol values and command arguments use package constants."

[rule.2]
file = "tools/flyci/controller/github.go"
linter = "bodyclose"
status = "removed"
reason = "HTTP response bodies are closed before control returns."

[rule.3]
file = "tools/flyci/controller/github.go"
linter = "errcheck"
status = "removed"
reason = "Cleanup errors are checked and preserve the first operation error."

[rule.4]
file = "tools/flyci/controller/github.go"
linter = "gosec"
status = "removed"
reason = "Ownership comparisons avoid narrowing, rate conversions are bounded, and file access is confined to open directories."

