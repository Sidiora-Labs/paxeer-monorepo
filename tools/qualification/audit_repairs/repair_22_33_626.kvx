[gotcha.6]
observed = "A recorded daemon transcript carries a stale receipt_ref even though its flat response fields and signed receipt remain useful producer evidence."
resolution = "Keep all recorded bytes and the strict reference assertion; repair the in-scope peer reference with the exact current owner hash and request the outside-scope source fixture refresh."
