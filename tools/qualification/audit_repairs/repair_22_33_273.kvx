[task.22.33.273]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
acceptance = "22998.1"
repair = "Consume the root README rewrite owned by 22.31.470 under decision 2525; add focused documentation contracts and this evidence record without editing README.md."
baseline = "Initial git status and diff showed only runner-prepared .cgignore and spec task-start/dependency bookkeeping; neither scoped file existed. /out/run/gate.json recorded zero builds and verifies, and /out/run/gates.jsonl did not exist. No pre-change verify ran and no baseline test failure is claimed: the explicit implementation-first order and exclusive hf-done gate supersede the older instruction to run verification before changes."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_273.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The final successful verify row in /out/run/gates.jsonl names the exact verified candidate revision; its command, exit and private log are also copied verbatim from hf-done in the final task response."
evidence_policy = "Finalize this record before hf-build. The candidate hash includes this record, so embedding that hash back into the record would change the candidate. Qualification requires build and verify at the same revision; only the runner commits and publishes. No gate result is claimed here before execution."
source_proof = "The pytest module reads README.md directly and checks one chain-125 paxd network with the embedded kernel, BFT committed-block finality, root API host range and parsed curl JSON request, transaction acceptance and forwarding, all three receipt rungs and commitment requirements, merged build/start commands, retired custody/checkpoint executors and absence of separate daemon deployment guidance. It corroborates these facts against real host, consensus, RPC, retirement and build sources without invoking their toolchains."
review_only = "This documentation gate does not build or execute Go/C/Rust, start a node, contact public hosts, execute transactions, verify cryptographic proofs, run consensus, or stop/reopen a WAL. These runtime and operational properties require their owning domain's qualification; this doc-drift repair changes no production interface or restart-recovery behavior. Only README source facts and their source-level producer/transport/consumer connections are proved here."

[finding.root-network-description]
audit = "22.30.131"
file = "README.md"
owner_task = "22.31.470"
owner_domain = 17
resolution = "The inherited README describes the integrated paxd BFT chain, chain 125, node-root RPC, transactions followed through committed receipts, merged library/node build and operator start flow. Separate kernel/sequencer/checkpoint deployments are explicitly absent; retained custody and anchor interfaces are historical refusal surfaces."
tests = ["test_root_network_description_integrates_kernel_and_bft_finality", "test_root_network_description_public_rpc_and_chain_probe", "test_root_network_description_transaction_and_committed_receipt_path", "test_root_network_description_build_and_operations_use_paxd", "test_root_network_description_retires_separate_services_and_executors"]

[wiring.root_readme]
request = "README.md -> domain 17 / task 22.31.470: maintain the integrated paxd network, chain-125 root RPC, committed receipt flow and retired deployment guidance."
status = "Implemented by owning task in the inherited README; no additional missing source fact was identified during implementation review."
missing_facts = []

[format]
policy = "No Python or KVX formatter is configured for these paths. Apply repository .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions only after full implementation."

[gotcha.context]
observed = "Broad combined context output truncates easily in this repository, and cg brief reports an unrelated cached task and change count."
resolution = "Use bounded task/finding sections and actual git status/diff and the private gate ledger. Record task notes here because GOTCHA.kvx and spec files are outside scope."

[gotcha.baseline]
observed = "The legacy audit step requests an unchanged-tree verify before changes, while the explicit gate order prohibits tests before complete implementation or outside hf-done."
resolution = "Honor the explicit gate order and state that no baseline test ran; never invent a failure or spend an extra verification run."

[repair_cycle.1]
revision = "cdc0d641e532c083e30ca7f0440ccf3ef5b8e5a0"
command = "cg spec done 22.33.273 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Five tests passed; the RPC test failed because the section parser interpreted the fenced shell comment '# Expected result' as a Markdown heading and truncated the quick start."
repair = "Track Markdown code fences while extracting sections so all original assertions inspect the full production section; retain every source assertion unchanged. Rebuild before repeating hf-done on the repaired candidate."
