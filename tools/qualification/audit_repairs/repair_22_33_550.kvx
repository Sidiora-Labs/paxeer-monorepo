implementation = "Consume the root README rewrite owned by 22.31.470 under decision 2525. The inspected README already contains every expected documentation-4 fact: one paxd BFT network with an embedded kernel, chain 125, api1 through api14 root JSON-RPC, distinct hosted methods, transaction submission and committed receipts, retired custody/checkpoint executors, and the maintained merged-node build and start path. Add independent regression assertions and this repair record only."
source_proof = "The pytest module proves README source facts and traces their committed production counterparts: node host construction and consensus source, root RPC route, JSON-parsed hosted OpenRPC contract and node method registrations, send/forward/accept path, durable receipt release ordering, receipt rungs and committed-block coverage, retirement guards, and Makefile-to-chain.mk-to-paxd start wiring. It parses the documented curl JSON and shell arguments without running them, checks both architecture and transaction diagrams, and rejects stale layerxd/deployment guidance. No shell script, unit file or manifest is modified; no bash syntax gate is applicable."
review_only = "Native Go/C/Rust execution, transaction signing, real WAL recovery, live host availability and BFT commitment are not executed by this gate. Producer, transport and consumer paths are source assertions for a documentation-drift repair, not runtime certification. No interface or restart-recovery behavior is changed; no corresponding runtime proof is claimed. The gate needs no environment variable, credential, live endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit Order requires complete implementation before formatting/build/testing, hf-build before hf-done, and no manual verify_cmd execution. The conflicting baseline clause cannot be followed within that order. No baseline failures are claimed. Initial status/diff showed only runner-prepared .cgignore and spec bookkeeping, neither allowed task file existed, and no previous gate ledger existed."
wiring_requests = []
wiring_disposition = "README.md | domain 16 fm-tools-ops | task 22.31.470 owns the architecture and launch rewrite requested by documentation-4; every expected fact is present in its committed README, so no missing-fact wiring request remains. README.md is outside this task's scope and is not edited."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_550.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the exact verified content-derived revision, command, exit code and log path. hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification; embedding its own content-derived candidate revision would change that revision. The runner retains the declared evidence and commits the qualified result."

