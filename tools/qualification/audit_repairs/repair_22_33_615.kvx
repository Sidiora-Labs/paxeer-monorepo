[task.22.33.615]
audit = "22.30.163"
findings = ["008"]
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
repair = "RelayReceiptResolver requires a whole-host match for its HTTP exception: ASCII-case-insensitive localhost, ::1, [::1], or exactly four decimal IPv4 octets in 127/8, each bounded to 0..255 with no ambiguous leading zeros or DNS suffix. Constructor validation precedes transport; HTTPS, URI metadata refusals and redirect rejection are preserved."
source_proof = "Pytest checks the complete production requireRelay body and whole-host String.matches validator, exercises the regex extracted from Java against every decimal octet value, invalid boundaries and remote DNS lookalikes, and follows source wiring from ConsoleSampleMain configuration through the final validated relay URI, encoded request target, redirect refusal, response status and receipt evidence decoding. No substitute relay or Python endpoint implementation is used."
review_only = "Java execution, Java regex engine execution, compilation, device networking, and end-to-end receipt transport are not run by this Python-only source gate. Python regex checks use the extracted literal's common Java/Python syntax with ASCII case folding; Java integration behavior remains review-only. The shared core validator requires the out-of-scope wiring request below."
baseline = "No baseline verification was run: the ordered instructions require complete implementation before testing, hf-build before hf-done, and prohibit running verify_cmd by hand. At inspection both repair files were absent, the source still used startsWith(127.), and the private gate ledger did not exist. No pre-change failing test result is claimed."
evidence_ledger = "/out/run/gates.jsonl"
evidence_log = "/out/logs/verify-1.log"
verified_revision = "The final verify row's revision in evidence_ledger identifies the exact candidate qualified by hf-done; the final response copies that immutable revision, command, exit and log. The runner records the result without a self-referential edit to this candidate."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_615.py"

[finding.008]
audit = "22.30.163"
