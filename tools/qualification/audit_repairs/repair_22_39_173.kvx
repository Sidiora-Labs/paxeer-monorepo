qualification_reference = "The final passing build and verify rows of /out/run/gates.jsonl provide revision, command, exit and private log; both rows must name the same revision."

[gotcha.continuation_index]
observed = "The continued attempt preserved the six executable scripts on disk, but they were absent from the index because the vendored ignore rule still excludes their directory."
resolution = "Preserve their bytes and executable mode and explicitly stage each restored path past ignore rules; do not change the vendored ignore file."

[gotcha.partial_clone_inventory]
observed = "A recursive git ls-tree with byte sizes fetched unrelated promised blobs in this partial checkout; the metadata read was stopped before any implementation mutation."
resolution = "Request metadata only for the twenty-three required snapshot paths and use git show for their contents."

