gate_ledger = "/out/run/gates.jsonl"
verified_revision_source = "The final passing kind=verify row in the private gate ledger names the verified revision, command, exit and log; its revision must equal the final passing kind=build revision. The final hf-done JSON repeats those four fields."
build_log_source = "log in the final kind=build row of /out/run/gates.jsonl"
verify_log_source = "log in the final kind=verify row of /out/run/gates.jsonl"
evidence_binding = "Finalize this record before hf-build and hf-done; bind results by reference so no post-gate edit changes the qualified candidate. The runner commits."

[gotcha.inspection]
observed = "The Codify graph reports stale repository state and broad context reads exceed tool output limits."
resolution = "Use bounded source reads and the snapshot Git inventory; leave runner-owned bookkeeping intact. Root GOTCHA.kvx and spec files are outside the authorized edit scope, so record this finding here."

[finding.preexisting_desktop_asset]
