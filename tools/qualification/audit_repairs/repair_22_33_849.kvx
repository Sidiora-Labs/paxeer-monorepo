[gotcha.1]
observed = "The unchanged-tree verification instruction conflicts with the explicit wrapper-only implementation-first gate order."
resolution = "Record no baseline result, finish implementation first and run only hf-build then hf-done; GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "The retained example receipt verifier authenticates signatures at receipted level even when the node reports committed."
resolution = "Require its actual signature-verification level and separately bind the matching successful EVM receipt to canonical block membership and head; do not claim independent Comet commitment verification."

[gotcha.3]
observed = "Initial combined source reads exceeded output limits and several guessed paths were absent."
resolution = "Use bounded reads of actual retained source locations and parse declarations without importing the candidate module's Go-backed initialization."

[gotcha.4]
observed = "The continuation seed conflicted with main's protected hosted Programs wrapper; replacing the wrapper wholesale would drop its current service roster and private profile input boundary."
resolution = "Keep main's service roster, inline error boundary and private profile transport; add a closed native profile schema and route the repaired native acceptance through the existing wrapper structure. New tests bind the roster through the real dispatcher and reopen the profile through its real producer/consumer APIs."
