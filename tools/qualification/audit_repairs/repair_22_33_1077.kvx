[repair]
task = "22.33.1077"
requirement = "22998.1"
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
inspected_revision = "dd790a15820927fd866f2000b398a2c4dba7562e"
readme_revision = "38801bb427090ac96d47c86a026a63ec05e67315"
implementation = "Consume the README rewrite owned by 22.31.470 per decision 2525; add focused offline documentation regression checks and this finding-to-test record. README.md is unchanged by this task."
source_proof = "The module reads the production README, parses its JSON-RPC curl example with shlex and JSON, checks all public RPC URL hosts and root paths, parses the hosted OpenRPC manifest, and checks documented node/host/consensus wiring, transaction acceptance and forwarding, durable WAL acknowledgement before receipt release, RPC receipt rungs and committed coverage, retirement guards, Makefile/chain.mk target prerequisites and actual source directories. Diagram assertions preserve embedded execution and receipt-before-block-commit ordering."
review_only = "Native Go/C/Rust builds, node startup, network deployment, cryptographic validation, transaction execution, WAL restart/recovery, actual public endpoint availability and BFT consensus are not executed by this gate. Source connections establish documentation consistency, not runtime qualification. This doc-drift repair changes no production interface or stateful component; restart and interface execution tests are not applicable. No shell script, unit file or build file is modified, and documented shell snippets are parsed without running an external binary."
baseline = "Initial git status/diff showed only runner-prepared .cgignore and spec task/dependency status changes; neither scoped repair file existed. /out/run/gates.jsonl did not exist, so no earlier gate result is available. No pre-change test was run and no pre-change failing tests are claimed: the explicit implementation-first order and exclusive hf-done gate supersede step 5's incompatible unchanged-tree verify request."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1077.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl identify the exact verified content-derived candidate revision, command, exit code and log path; build and verification must pass on the same candidate revision. Finalize this record before gates: inserting its own candidate hash would change the candidate. The runner retains the evidence and commits the task; no manual commit or push is performed."
wiring_requests = []

[finding.f025]
audit = "22.30.43"
file = "README.md"
line = 44
class = "doc-drift"
severity = "medium"
owner_domain = "5 (root README wiring owned by fm-programme)"
owner_task = "22.31.470"
observed = "The audited README declared two execution domains, a separate layerxd daemon settling through layerxAnchor, make layerxd and a draft merge."
expected = "One paxd chain with embedded block-proposing kernel, EVM chain 125, api1..api14 root node JSON-RPC, a distinguished hosted px_ contract, signed execution evidence followed by block-committed final receipts, supported merged builds and actual repository layout; custody/checkpoint executors are retired refusal surfaces and there is no separate daemon or checkpoint deployment."
resolution = "The README left by 22.31.470 contains every expected fact; no missing-fact wiring request is identified. Its root README rewrite is the out-of-path proposal step and was already performed by its owning task; this task only consumes and checks it."
tests = ["test_f025_embedded_paxd_is_one_block_committing_network", "test_f025_root_rpc_hosts_and_chain_probe_are_unambiguous", "test_f025_hosted_px_contract_is_distinct_from_public_node_methods", "test_f025_transaction_to_committed_receipt_matches_source_connections", "test_f025_custody_and_checkpoint_executors_are_retired_refusal_surfaces", "test_f025_supported_build_tools_and_layout_match_the_merged_tree"]

[reconciliation]
px_methods = "The audit expects hosted gateway px_ methods, but rpc/server.go also registers native node px_ account/history and receipt-key methods. The README distinguishes both contracts rather than claiming every px_ method is hosted or available at every public node."
historical_anchor = "Checkpoint writes retire at the merge; remaining historical anchor reads retire at v7.0-anchor-store-delete. The README preserves this archive-only distinction without presenting another current settlement or deployment path."

[format]
policy = "No Python or KVX formatter is configured for these paths. Apply .editorconfig UTF-8, LF, final newline and trailing-whitespace conventions only after the full implementation."

[gotcha.1]
observed = "Combined broad reads exceeded output limits, cg brief/spec next reported an unrelated task and stale change counts, and guessed precompile.go paths do not exist."
resolution = "Use bounded sections and actual source filenames, Git status/diff and the private gate ledger; task-local notes remain here because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "The audit's unchanged-tree baseline verification instruction conflicts with the explicit ordered gate protocol, and embedding a final candidate revision inside its own repair record would change that revision."
resolution = "Claim no unrun baseline result; qualify only through hf-build then hf-done and retain exact revision evidence in the private ledger and final JSON without post-gate source edits."
