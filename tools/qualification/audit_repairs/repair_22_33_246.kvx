[repair]
task = "22.33.246"
base_revision = "8a5302e1b13ed685ab2cd21b29cd69052c2a8f6a"
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_246.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "hf-build and hf-done record the exact same candidate revision, command, exit code and private log in /out/run/gates.jsonl; the passing verify row names the verified revision. The final response copies the last hf-done evidence line. No gate success is predicted in this record."
implementation = "Bundle an exact copy of programs/sdk/abi-manifest.tsv at the AssemblyScript package root, explicitly publish it through package.json files, and resolve the default from the installed lint module using ../abi-manifest.tsv. Preserve explicit manifest/ABI options and all fail-closed validation. Add a real offline npm pack/install consumer regression registered as test:package, with a committed AssemblyScript source fixture compiled by the pinned existing compiler."
source_proof = "Pytest parses the package and compiler JSON, compares bundled and canonical manifest bytes and all 28 row shapes, resolves the installed bin-relative URL against the publish set, and checks the production loader-to-import-policy-to-source/WASM-consumer paths and diagnostic exits. It checks the committed runtime regression's actual pack, installation, isolated bin invocation, compiler producer, valid WASM, exact success output and negative assertions. These are executable source assertions, not JavaScript runtime execution or an npm pack result."
review_only = "npm run test:package is committed but not executed by this Python-only gate: it requires Node, npm and AssemblyScript, which the explicit gate contract excludes. The runtime regression packs and installs the actual package offline outside the repository, removes its staging producer, compiles actual guest source to WASM, and invokes the installed bin with default arguments. Its assertions cover successful source/WASM linting, forbidden source imports, wrong WASM signatures and missing/corrupt bundled manifests; their runtime outcome remains unqualified here. No npm package or native artifact is required by pytest. No restart-recovery or interface-mismatch finding applies to this stateless resource wiring repair."

[baseline]
