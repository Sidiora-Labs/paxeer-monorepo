[finding.042]
audit = "22.30.158"
file = "README.md"
line = 47
class = "doc-drift"
severity = "medium"
owner_domain = 1
readme_owner_task = "22.31.470"
observed = "The audited overview described a separate C daemon and checkpoint settlement, live custody/anchor precompiles and make layerxd. These obsolete facts are absent from the integrated README at the input revision."
resolution = "The merged kernel runs inside paxd with BFT block commit finality. Retained historical executor registrations are compatibility refusal surfaces; anchor historical views remain archive-only until v7.0-anchor-store-delete. They are not current custody funding or checkpoint execution services. Decision 2525 and the real upgrade gates resolve the audit's shorthand request for no custody/anchor precompiles."
tests = ["test_f042_merged_network_embeds_kernel_and_block_proposal", "test_f042_chain_probe_and_numbered_hosts_use_root_json_rpc", "test_f042_transaction_receipt_producer_transport_and_consumer", "test_f042_finality_requires_authenticated_block_commit", "test_f042_native_inventory_and_retired_executor_refusals", "test_f042_build_examples_produce_and_start_paxd", "test_f042_explorer_and_optional_hosted_gateway_entry_points", "test_f042_record_maps_finding_to_proofs_and_evidence"]

