verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_522.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The passing hf-done row in the private /out/run/gates.jsonl is authoritative for the exact candidate revision, command, exit code and evidence log, also copied verbatim to the final response. Build and verify must name the same candidate revision. A candidate hash cannot be embedded into its own content without changing the revision. This record is finalized before qualification; the runner publishes the qualified tree."
