audit = "22.30.181"
base_revision = "58a8a4ad7c85d3fe8034c6774a5778f1174e710f"
implementation = "Resolve Human workspaces beneath services; select the supported paxeer container recipes; bind archive gates to mirror-publisher, mirror-signer and the registered sequencer node receipt producer; qualify committed archive freshness, producer and recovery consumers; replace boundary/ABI-only withdrawal qualification with native paxd transfer and committed bank proof corpora; publish the standard merged-runtime foundation bundle and preserve every original consensus/receipt case."
baseline = "Not run: the explicit implementation-first order and exclusive hf-done verification rule prohibit the conflicting unchanged-tree verification instruction. No baseline failures or passes are claimed. Initial status/diff contained only runner-prepared .cgignore and spec bookkeeping, with no scoped prior edits; gate.json recorded zero builds/verifies and no prior gates.jsonl existed."
build_cmd = "bash -n tools/paxeer-x/gates/11.2.sh tools/paxeer-x/gates/111.6.11.sh tools/paxeer-x/gates/12.1.sh tools/paxeer-x/gates/18.3.sh tools/paxeer-x/gates/24.14.sh tools/paxeer-x/gates/24.16.sh"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_850.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger identify the exact content-derived verified revision, command, exit and log, with hf-build on the same candidate. The runner publishes; no manual commit or push is performed. This record is finalized before qualification because embedding its own candidate revision would change that revision."
source_proof = "Pytest parses each of the seven shells separately with bash -n, parses their embedded Python, parses current Cargo manifests and the runtime-bundle JSON, executes the production catalogue parser, and asserts real source declarations, guarded commands, exact retained inventories, source provenance and standard manifest consumer keys. The declared hf-build command is preserved verbatim; Bash treats its additional filenames as script arguments, so pytest supplies the individual syntax checks."
runtime_proof = "Execute the gate's actual Rust/Go count parsers as pure functions against explicit protocol examples and malformed/empty/skipped/failed/duplicate/mismatched inputs; those inputs are parser unit data and are never offered as native execution evidence. No native toolchain, environment variables, credentials, external endpoint or native artifacts are required by pytest; Bash is used only for the explicitly required syntax parsing."
review_only = "Native Rust/Go/container compilation and execution, cryptographic validation, archive freshness against a running node, native transfer execution, persisted verifier/spool recovery and foundation executable authenticity are reviewed through the retained real source paths, not executed or certified by this source qualification. The selected production tests contain the real producer/transport/consumer and close/reopen assertions; this Python gate does not claim to have run those native tests or restarted a native component."
formatting = "Follow repository .editorconfig whitespace and existing Python/Shell/KVX style; no formatter for these paths is configured or available in the environment."

