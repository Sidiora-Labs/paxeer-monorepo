[format]
policy = "No language formatter is configured for these shell, Python or KVX paths. Follow .editorconfig UTF-8, LF, final newline and no trailing whitespace, with existing four-space shell and Python indentation."

[gotcha.1]
observed = "The pre-change verification step contradicts the explicit implementation-first and hf-done-only order."
resolution = "Follow the explicit order and record static baseline facts without claiming a baseline run; keep notes in this scoped record because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "Broad repository ledger and audit reads exceed tool output limits."
resolution = "Use bounded reads of the exact task, finding, gate ledger and relevant workflow sections."

[gotcha.3]
observed = "A multi-file patch was rejected because a quoted Python string did not match its context."
