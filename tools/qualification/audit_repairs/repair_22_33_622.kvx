[task.22.33.622]
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
repair = "ReceiptGateTest no longer projects the synthetic settled/receipt_ref journey or supplies its evidence with a resolver lambda. Its original success case calls the configured production gate.track through the real broker, AndroidHttpTransport, MobileClient and HumanReceiptResolver against a loopback HTTP peer. The signed transaction, receipt, digest and pin remain the existing V1-pax-transfer producer recording. Additional Java assertions cover done and retained done-finalised vocabulary plus transported signature, raw transaction, digest, evidence identity, proof key, configured authority and payment-term refusals. All existing direct tamper, defensive-copy, key-height and invalid-configuration assertions remain."
source_proof = "The five offline pytest tests parse the committed JSON, base64 proof, pin heights and existing vector, recompute receipt identity and the domain-separated unsigned receipt digest, and assert the actual Rust producer fields and labels. They inspect the repaired ReceiptGateTest declarations, loopback request sequence and authorization checks, and the production Android entry point, HTTP codec, client, resolver and gate connections. This is source qualification, not execution of a replacement implementation. No shell script, unit file, manifest or build file is repaired."
review_only = "Java/JUnit execution, HTTP exchange, Ed25519 verification, transaction Keccak, live Human response emission and BFT commitment are not executed by this Python gate. human-receipt-journey-22-33-622.json is a source-derived contract fixture, not a captured Human response. Its signed bytes are copied unchanged from the committed sequencer recording, while its envelope and native done projection are checked against current producer source. done-finalised is retained schema compatibility coverage; the current native producer renders done. The test asserts receipted execution verification and does not claim that a service label authenticates BFT finality. Capturing a producer-emitted completed journey requires the out-of-path wiring request below. No restart-recovery or interface-mismatch finding applies."
baseline = "No pre-change verification was run and no baseline test failures are claimed: the explicit implementation-first and hf-done-only order takes precedence over the contradictory unchanged-tree baseline clause. Initial Git status/diff showed only runner-owned .cgignore and spec task-start bookkeeping, both preserved. Both scoped qualification artifacts were absent; gate.json recorded zero builds and verifies and gates.jsonl was absent. The synthetic journey incompatibility was observed by source inspection, not a baseline test run."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_622.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The exact candidate revision, command, exit and private log are recorded by the final hf-done JSON and the corresponding evidence_ledger row."
evidence = "Qualification requires build and verification to pass on the same candidate revision. This record is complete before the gates; embedding its own content-derived candidate hash would change the candidate. The runner retains exact immutable revision evidence and performs publication; no manual commit or push is performed."

