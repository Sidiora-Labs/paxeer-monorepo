proposal = "Rewrite README.md architecture and status around paxd kernel execution, root-path public JSON-RPC and committed-block finality; identify separate-daemon checkpoint instructions as retired."
wiring = "README.md -> domain 13 / task 22.31.470 owns the architecture, status and retired-deployment rewrite; the inherited README supplies every required fact, so no outstanding wiring request is identified."
tests = ["test_readme_network_embeds_kernel_and_proposes_committed_blocks", "test_readme_network_root_rpc_hosts_and_chain_probe", "test_readme_network_transaction_transport_and_committed_receipt", "test_readme_network_requires_block_commitment_for_finality", "test_readme_network_retires_custody_checkpoint_and_daemon_deployments"]

