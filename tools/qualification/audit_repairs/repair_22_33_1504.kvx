class = "doc-drift"
severity = "medium"
expected = "The finished network is one paxd BFT chain with an integrated proposing kernel and receipt finality on committed blocks; no live layerxd or checkpoint settlement plane remains."
resolution = "The owning task's README already satisfies the proposal; these tests independently qualify its architecture, current merge model and client flow while keeping historical executor discussion explicitly retired. Closure is conditional on hf-done passing, not this record's declaration."
tests = ["test_f21_integrated_network_and_merge_status", "test_f21_root_rpc_hosts_and_chain_probe", "test_f21_transaction_to_committed_receipt_source_path", "test_f21_diagrams_keep_execution_and_finality_in_one_network", "test_f21_retired_executors_and_historical_daemon_only", "test_f21_record_identifies_finding_proofs_and_qualification_limits"]

[format]
