repair = "Qualify audit 22.30.9 finding 21 against the production README rewritten by 22.31.470. The architecture, diagrams, root-path chain-125 JSON-RPC quick start, transaction and committed-receipt flows, merge status and retired executors state the expected integrated network model. README.md is outside scope and is unchanged by this task."
source_proof = "Six pytest tests assert README source facts and parse its actual curl JSON-RPC request and root URLs in-process. They connect documented transaction production to rpc/send.go acceptance/forwarding, node/sequencer/accepter.go durable acknowledgement before publication and rpc/sequencer_receipt.go committed block coverage; check integrated host/consensus declarations, root dispatch, retirement gates and diagram order; and validate the finding-to-test mapping. No shell scripts, unit files, manifests or build files are repaired by this documentation finding."
review_only = "Native Go/C/Rust execution, cryptographic verification, live endpoint availability, actual BFT commitment and WAL restart/recovery are not executed by this offline documentation gate. These source connections require runtime qualification elsewhere; this task changes no stateful component or interface and claims no restart-recovery or interface-mismatch proof."
baseline = "Initial git status/diff showed only inherited .cgignore and spec task-status bookkeeping; both scoped files were absent. The private gate ledger did not exist, so no earlier build or verify result was available. No pre-change verification was run: the explicit implementation-first order and exclusive hf-done gate supersede step 5's baseline-run request. No pre-change test failure is claimed."
wiring_requests = []
wiring_policy = "README.md belongs to domain 16 through task 22.31.470 per decision 2525; all finding 21 expected facts are present at readme_revision, so no missing-fact wiring request remains. Any future missing README fact must be requested from 22.31.470, never repaired outside this task's two paths."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1504.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and the private gate ledger retain the exact verified candidate revision, command, exit code and log path. Build and verify must pass on the same candidate revision. The record is finalized before qualification because embedding its own candidate hash would change the verified content. The runner records completion and publishes; no manual commit or push is performed."

[finding.21]
audit = "22.30.9"
