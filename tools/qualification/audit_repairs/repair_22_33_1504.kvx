[gotcha.1]
observed = "Codify brief/context can report unrelated task state or more changed paths than git status, and broad combined reads can exceed output limits."
resolution = "Use actual git status/diff, bounded task/source reads and the private gate ledger; retain this note here because GOTCHA.kvx and spec files are outside the user's scope."

[gotcha.2]
observed = "The audit step asks for a baseline verify although the explicit gate order prohibits verification before full implementation and permits only hf-done."
resolution = "Follow the explicit gate order, disclose the absent baseline, and claim only the gate evidence actually produced."

[gotcha.3]
observed = "The first hf-done failed at candidate e198234a8e10249672daf0c42df068e3688b4941: the Markdown section reader treated the fenced curl example's Expected result shell comment as a heading and truncated the quick start; command cg spec done 22.33.1504 -f layerx-merge --root /work/paxeer-monorepo exited 1, log /out/logs/verify-1.log."
resolution = "Repair the section reader to track Markdown fences and retain the complete example and following prose; keep every assertion unchanged and rerun build then verification on the repaired candidate."
