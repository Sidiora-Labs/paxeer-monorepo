inventory_repair = "The earlier scope assumption is superseded: precompiles.json is inside the authorized service path and the documented producer-to-embedded equality requires regeneration. The production generator changes only four stateMutability values for addCW1155Pointer, addCW20Pointer, addCW721Pointer and addNativePointer; its manifest and all 875 ABI records remain present. Producer files and the full equality assertion are unchanged."
qualification = "Use only hf-build followed by hf-done on the unchanged candidate; exact revision, command, exit and private log are retained in evidence_ledger and the final gate JSON. The new run has no prior gate ledger and starts with zero builds and verifications."

[gotcha.5]
observed = "The retained equality failure comes from four stale embedded pointer mutability fields, not a missing ABI or a different manifest."
resolution = "Refresh only the scoped generated inventory with the real generator; retain the strict whole-inventory equality and independent producer-union checks."
