[task.22.33.296]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
inspected_revision = "d6943925ce24609107753c7860bdc98af873fc60"
repair = "Decision 2525 delegates all README edits to task 22.31.470 in documentation domain 17. Preserve that task's completed README rewrite and add focused regression proof for audit 22.30.134/doc_1: the embedded block-proposing kernel in one paxd BFT network, chain 125, root public JSON-RPC, transaction submission and committed receipt flows, current build and precompile inventory, retired custody/checkpoint executors and historical settlement formats. README.md is read only."
source_proof = "The pytest module checks actual README source facts, parses its curl arguments and JSON payload, checks root URLs and the api1 through api14 range, compares all thirteen merge inventory rows with production MergeAddressTable entries, and checks Makefile prerequisites and the chain output target. It traces production source from RPC transaction acceptance/forwarding to sequencer/WAL receipt release and the receipt RPC consumer's committed sequence coverage. Host, consensus-source and retirement gates substantiate the documented model; repository source links must resolve. The record maps doc_1 to every declared test."
review_only = "Native Go/C/Rust builds, node startup, actual transaction execution, cryptographic proof verification, RPC availability, WAL restart/recovery and BFT commitment are not executed by this offline documentation gate. Producer/transport/consumer assertions establish source connections only, not runtime certification. No interface-mismatch or restart-recovery finding is repaired here. No shell script, unit, manifest or build file is changed; documented commands are parsed without running external binaries. The gate needs no environment variable, credentials, live endpoint, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit implementation-first order and hf-build then hf-done gates supersede the older baseline clause; verify_cmd was not run by hand and no baseline failures are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task bookkeeping; both scoped artifacts were absent. gate.json recorded zero build and verification runs with two repair cycles left; /out/run/gates.jsonl did not exist. Continue the inherited README from 22.31.470 without rewriting it."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_296.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private evidence_ledger name the exact verified content-derived candidate revision, command, exit code and log location. Build and verification must pass on the same candidate revision. Finalize this record before qualification; embedding a candidate revision into its own content changes that revision. The runner retains the declared evidence and commits the result; no manual commit or push is performed."
