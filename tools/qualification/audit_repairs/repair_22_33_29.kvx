[repair.22.33.29]
base_revision = "2a8418f3ce46275830d68ea57514c30466a3493f"
acceptance = "22998.1"
audit = "22.30.102"
disposition = "Replace the three stale success vectors with one internally consistent receipted transfer, portable receipt proof and binary evidence export. Preserve both original activity payloads byte for byte under historical-decode, outside the active examples. The five binding error fixtures already agree with the production retired-route refusal at this base and are preserved unchanged, with new assertions tying every envelope to its producer and route."
provenance = "The signed bytes, raw transaction, receipt identity, signing digest, height and pinned key come unchanged from V1-pax-transfer in sdk/platform/conformance/fixtures/sequencer-receipt-v1.json, generated by rpc/sequencer_receipt_vectors_test.go through the node producer. No private key or replacement receipt is generated. This is the proposal's portable evidence option: a merged-network transfer receipt, not an invented bank-send receipt. HTTP golden JSON and the bundle are encoded to the committed production serializer layouts; the added Rust tests assert byte/value equality with those actual serializers. This Python-only session does not claim a fresh Rust HTTP capture."
source_proof = "The pytest module parses all eight named JSON fixtures, the relevant schema KVX sections and this record; checks the retired-route dispatch, actual error constructor and optional-field serializer; traces activity receipt actuals and verifier labels into the production projection; traces the export route through EvidenceExport, bundle verification and the cache response; traces evidence.get through managed receipt export and PortableReceiptV2 verification; and checks the added Rust producer-equivalence tests are connected to these goldens."
executed_proof = "The actual production Python SDK consumes the base64-decoded signed receipt with an independently loaded pinned key and the committed raw EIP-1559 transaction, checks Ed25519 authentication, canonical encoding, signing digest, receipt identity, inclusion height, rung, transaction hash, recovered signer, amount and fee, and refuses malformed bytes, altered signatures, wrong/unknown/expired keys and a mismatched transaction. The binary export is fully parsed with bounds checks, every entry/fact and end offset asserted, its embedded receipt authenticated by that SDK, and its SHA-256 matched to the exported download path. Historical JSON is decoded and checked against pre-change byte hashes and the schema's retired-but-decodable variants."
review_only = "Rust compilation, Rust unit tests and live human-service HTTP routing are not executed by the Python-only gate. golden_evidence_verifier_round_trip calls the real managed receipt producer, schema encoder and PortableReceiptV2 parser/verifier, with malformed, wrong-key, altered-signature and identity-negative coverage. golden_current_activity_projections calls the actual feed, detail projection, EvidenceExport, EvidenceBundle codec/verifier and cache response producer and asserts golden equality. golden_retired_binding_producer_equivalence compares all five fixtures with ApiFailure::operation_retired(). Their native execution and live authority/catalog integration require the owning domain's Rust gate; source checks are not runtime proof of Rust. No restart-recovery or interface-mismatch finding is present in this task. No environment variable, credential, live endpoint, external binary, subprocess toolchain, native service artifact or device is needed by the declared pytest gate; its SDK crypto dependency is installed."
baseline = "No baseline verification ran: the requested pytest module did not exist, the initial tree contained only runner-prepared .cgignore/spec task-start edits, and /out/run/gates.jsonl was absent. The explicit implementation-first, hf-build then hf-done order forbids the conflicting unchanged-tree verification step. No baseline failures are claimed. Read-only inspection found all five binding fixtures already repaired in the base; this task adds their missing producer regression proof without rewriting them."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_29.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The private runner ledger and the final hf-done JSON name the exact content-derived revision, command, exit code and log path; build and verification must pass on the same candidate revision. This record is finalized before qualification so it does not embed its own content hash. No success is claimed before hf-done passes. Publication belongs to the runner; no manual commit or push."

