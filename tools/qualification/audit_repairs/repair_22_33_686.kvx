repair = "Consume the root README rewrite from task 22.31.470 under decision 2525. Add focused regression proof of audit 22.30.167/readme-network-doc without editing README.md: one paxd chain with its embedded kernel, chain 125, root public JSON-RPC, transaction and committed receipt flows, retired custody/checkpoint executors and merged-node build/release guidance."
source_proof = "The pytest module reads the production README and asserts its architecture, topology, numbered api1..api14 host range, chain probe and JSON request, transaction submission, WAL release ordering, receipt rungs and block coverage, signature/proof guidance, retirement gates, linked native build dependencies and upgrade descriptions against the actual producer/transport/consumer sources. Parse the documented curl arguments with shlex and its payload with json, without executing it. Parse this record and the audit as KVX/TOML and map every finding to declared tests."
review_only = "Native Go/C/Rust builds, node startup, transaction execution, signature verification, WAL restart/recovery, live endpoint availability and BFT commitment are not executed by this gate. Documentation source assertions establish the connections, not runtime or deployment certification. No interface or restart-recovery component is changed. No shell script, service unit or manifest is modified; Makefile dependencies are inspected as source. The complete gate uses Python and repository files only, with no environment variable, credential, endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit implementation-first order requires hf-build before the exclusive hf-done gate and forbids running verify_cmd manually, superseding step 5's baseline request. No baseline failures are claimed. Initial git status/diff contained only runner-prepared .cgignore and spec task-start/prerequisite status bookkeeping; neither scoped deliverable existed. gate.json recorded zero builds and verifies, and /out/run/gates.jsonl did not exist. README already contained the owning task's rewrite."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_686.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The last hf-done JSON and private /out/run/gates.jsonl name the exact verified content-derived revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification: embedding that candidate's own hash would change its content. The runner retains the evidence and commits the result."
