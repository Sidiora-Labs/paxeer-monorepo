[task.22.33.847]
audit = "22.30.181"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
repair = "Replace retired gate service aliases with current declared producer ids. Resolve the composite Rust workspaces beneath services without changing target selection. Both split-phase gates restore and validate the original finite deadline from their private build manifest before checking or executing artifacts, reject a differing explicit deadline and refuse exhausted budgets. Hosted testnet qualification requires the new private compiler manifest producer in tools/paxeer-x/gates/hosted_testnet_build.py, checks current revision/tree and complete repository source hashes, exact compiler target records and transcript digest, then executable digests before its existing corpus; recheck after execution. Retain counts and zero-skip checks, additionally compare exact executed case names to the inventory."
source_proof = "hf-build parses all six declared shell scripts with bash -n once. Pytest parses their embedded Python and checks guarded commands, exact workspace paths and target inventory, the entire original 39-case identity roster digest, current service ids from the real catalogue parser and unknown-service refusal in the dispatcher. Parse the current Cargo manifests to validate hosted library and binary target names. Assert compiler invocation, successful build before manifest publication, complete source identity comparison, transcript and executable binding before every corpus and after execution. No shell syntax parser is rerun by pytest."
runtime_proof = "Fresh Python processes execute the actual production deadline and private save/load declarations, write the build deadline, exit, reopen the manifest in another process and restore the same deadline with a decreasing remaining budget. The tests also refuse changed explicit, malformed, nonfinite and expired deadlines. This proves the split-phase deadline transport independently of compiler availability; full composite and export gate bodies are source-proven. Execute the real hosted build module's private file transport, mode/symlink/hardlink/duplicate-field refusals, source hashing of dependency/build/fixture/extensionless/untracked inputs, exact missing-compiler-target refusal, and executable digest and permission refusals against real temporary files containing committed source bytes. No fixture impersonates a compiler artifact or a successful hosted result."
review_only = "Rust, Go, Solidity and native compilation and the identity, Redis, TLS and hosted smoke corpora are not executed by this Python qualification. Their real invocations, retained inventory, compiler manifest schema and pre-execution checks are source-proven; successful native compilation, compiler authenticity, external registry integrity and live hosted integration remain review-only. Source hashes cover all tracked and nonignored repository inputs, including workspace manifests, Cargo.lock, fixtures and extensionless files; environment secret files are excluded. Operators must use the same pinned compiler and dependency cache for both phases; a caller with write access to private compiler evidence is part of the trust boundary. Gate 104.17.4's separate compiler-manifest finding f014 belongs to the next repair part and is not claimed here."
baseline = "Not run: the step requesting pre-change verification conflicts with the explicit order forbidding testing before complete implementation and manual verify_cmd execution. No pre-change failures are claimed. The initial private gate configuration had zero build and verify runs and no gate ledger; only runner-prepared .cgignore and task-start changes existed. Those changes are preserved."
evidence = "The exact verified content-derived revision, cg spec done command, exit and private log are recorded by the final hf-done JSON and /out/run/gates.jsonl, together with the matching hf-build revision. This record is finalized before the bounded gates, avoiding self-referential revision edits. The runner commits; no task commit or push is performed here."
formatting = "No Python, Shell or KVX formatter is configured for these paths or installed in the sandbox. Follow existing style and .editorconfig whitespace requirements for touched files only."

