[gotcha.baseline_order]
observed = "The inherited baseline clause conflicts with the explicit implementation-first wrapper-only gate order."
resolution = "Follow the explicit order and record no invented baseline result; GOTCHA.kvx and spec files are outside scope."

[gotcha.context]
observed = "Codify brief reports unrelated cached tasks/changes; broad source reads overflow output budgets and shell reads of guessed files fail."
resolution = "Use actual git status/diff, the exact task block, bounded named-source reads and the private gate ledger; no cached result is qualification evidence."

[format]
policy = "No Python/KVX/YAML formatter is configured for these paths; apply the existing .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions to touched files after complete implementation."
