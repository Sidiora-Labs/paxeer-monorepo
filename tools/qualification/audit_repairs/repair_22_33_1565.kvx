[qualification]
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1565.py"
done_cmd = "cg spec done 22.33.1565 -f layerx-merge --root /work/paxeer-monorepo"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The private hf-done ledger row records the exact content-derived candidate revision, command, exit and log. The final response copies it verbatim. Embedding that hash in this file would change the candidate hash, so this record is finalized before the gates. Build and verify must use the same unchanged candidate."
publication = "Only hf-build and hf-done run; do not claim a gate before it executes. The runner commits and publishes; no manual commit or push. Stop on hf-done pass or the bounded repair/time limit."
format = "No Python, Markdown, TOML or KVX formatter is configured for these paths. After the complete implementation apply .editorconfig UTF-8, LF and final-newline conventions, retaining language indentation and Markdown whitespace rules. No Cargo semantic change or lockfile update is needed."

[gotcha.1]
observed = "Combined context reads exceeded output limits; cg brief/survey described cached unrelated tasks and cg grep did not report raw ambient-clock matches."
resolution = "Use bounded source reads, actual Git state and raw file inventory for this task. Durable notes stay here because GOTCHA.kvx and spec/ are outside the explicit scope."

[gotcha.2]
observed = "The scanner reads only crates/ and matches ambient tokens literally, including tests and comments; the existing tests/support clock adapters are outside that tree, while many other source files still contain direct clock reads."
resolution = "Document that exact boundary without broad exemptions and name every current scanner-visible clock source for domain 9 wiring. Prove the scoped policy and already-correct SDK wallet path without asserting the external migration is complete."
