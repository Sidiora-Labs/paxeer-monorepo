# Scoped source qualification for audit 22.30.99; runtime clock migrations stay with domain 9.

[task]
id = "22.33.1565"
mode = "BUILD"
audit = "22.30.99"
acceptance = "22998.1"
base_revision = "aa5e0820b3652890f3812a220f4b91f4f8a45387"
repair = "Preserve the prerequisite topology and major-2 rewrite; add explicit native EVM signature and unavailable-feature guidance, connect release checks to the actual migration consumer, document Cargo owner/host roles and exact clock scanner policy, and prove these facts offline. No production interface or durable-state behavior is changed."

[baseline]
working_tree = "Initial git status/diff showed runner-prepared .cgignore and spec task-start bookkeeping only. The two scoped qualification files were absent, /out/run/gates.jsonl did not exist and gate.json recorded zero builds and verifies. Preserve all inherited changes."
verification = "No unchanged-tree verify was run and no baseline test failures are claimed. The explicit implementation-first order and exclusive hf-done verification supersede the older do_7 request for a preliminary verify. The baseline documents already describe major 2 and merged paxd after prerequisites; remaining missing facts were explicit unavailable-feature behavior, EVM signature details and accurate scanner/test adapter policy."

[finding.agent-compatibility-major]
file = "services/agent/COMPATIBILITY.md"
tests = ["test_agent_compatibility_major_matches_schema_manifest_and_publication", "test_agent_compatibility_signatures_rungs_and_unavailable_features", "test_agent_compatibility_release_checks_match_real_make_consumers", "test_agent_documentation_relative_links_resolve"]
source_proof = "Read the real canonical schema, request/response version goldens, workspace Cargo version, executable compatibility constants/matrix and published Markdown row; decode the goldens to major 2 minor 0. Assert exact external EVM signatures, ordered evidence rungs, approval authority limits and explicit UnavailableCapability/no-emulation behavior. Parse Makefile recipes and check the migration/verify_published/refusal and boundary-report consumers, URL forwarding and every relative documentation link."
review_only = "These are source assertions, not Rust execution or a live client handshake. Cryptographic verification, node capabilities, actual migration/restart recovery and live boundary qualification require native tooling and remain release checks. This doc-drift finding does not change the interface or recovery implementation."

[finding.agent-readme-topology]
file = "services/agent/README.md"
tests = ["test_agent_readme_topology_crates_and_root_rpc_match_current_inputs", "test_agent_readme_prerequisites_follow_make_and_real_node_script", "test_agent_documentation_relative_links_resolve"]
source_proof = "Assert the production README describes one paxd network, committed-block finality, exact-byte submission, tenant sub-chains and root HTTPS RPC on chain 125. Parse Cargo manifests and the toolchain pin; require one matching crate role per member and the actual host binary path. Parse Makefile recipes and the real-node script mode/root/tool guards, native fixture names, clock/TLS prerequisites and embedded Python AST, checking manifest/default chain and port sources. Resolve all relative links and anchors; reject removed daemon/LNI/verifier references."
review_only = "No native build, node, network, Foundry, Go, shell process or runtime clock service runs. The shell script is only a read-only documentation reference, not a repaired file; guards and commands are checked as source and its embedded Python is parsed, not executed. Shell syntax qualification with bash -n and runtime prerequisites remain owning release review; this gate requires no external executable or subprocess toolchain. No interface or restart-recovery finding is included."

[finding.clock-policy-drift]
file = "services/agent/nondeterminism-allowlist.toml"
tests = ["test_clock_policy_preserves_exact_process_exception_and_scanner_scope", "test_sdk_wallet_deadlines_use_explicit_clock_without_silent_fallback", "test_clock_scanner_violations_have_exact_out_of_scope_owner_requests"]
runtime_status = "owner wiring required"
source_proof = "Parse the actual TOML policy and mirror the production allowlist path-line grammar; require version 1 and exactly the original main.rs process exception. Check scanner recursion includes tests/host-tests/src/bin and skips only target directories; the shared wall_time/monotonic_time adapters are outside that traversal. Assert the current production SDK wallet delegates to RPC waits whose deadlines use injected Clock/Deadline, propagate unavailable clocks and preserve the 300-second bound. Inventory every currently scanner-visible ambient clock token outside main.rs and require an exact path/owner wiring request for each; none becomes an exception."
review_only = "The scoped configuration no longer falsely claims every library avoids ambient time or one read occurs per request. The current wallet deadline path is already explicit after prerequisites. Remaining SDK binary/tests and other crate clock reads cannot be changed in this scope and are listed below. This task does not claim boundary-check passes or that clock-policy-drift is globally remediated before owner wiring. Native clock regression/error/polling behavior requires Rust release qualification."

