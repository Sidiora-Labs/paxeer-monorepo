[task.22.33.418]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
inspection_revision = "7143f4f113fcd427b22950c7b0c1f87918050151"
readme_owner_task = "22.31.470"
repair = "Decision 2525 delegates README.md to task 22.31.470 (domain 16). Its integrated-network rewrite is already present and is preserved byte-for-byte. Add focused regression assertions for readme-two-domains and this finding-to-test record only. No missing expected fact was observed, so no additional README wiring request is needed."
source_proof = "The Python-only module proves README source facts: one paxd BFT network with an embedded proposing kernel and chain ID 125; api-mainnet-beta and the api1 through api14 root JSON-RPC host range; parsed curl arguments and JSON eth_chainId request with expected 0x7d; signed transaction submission, signed execution evidence, three receipt rungs and committed-block finality; retired custody/anchor/checkpoint executors and absence of separate daemon deployment; historical labels for any retained layerxd or settlement references. Cross-check the real node/host integration, signing producer, RPC receipt rungs, signature and committed-proof consumers, linked send/release source paths and Makefile native build prerequisites without executing them."
review_only = "Native Go/C/Rust code, curl, live RPC availability, transaction execution, signature verification, durable WAL acknowledgement, restart recovery and BFT commitment are not executed by this gate. The producer, transport and consumer connections are source assertions for documentation drift, not runtime certification. No interface-mismatch or restart-recovery finding applies, and no shell script, unit file or manifest changes. The Makefile dependencies are parsed as source facts, not built. The gate needs no environment variable, credential, live endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit order requires whole implementation before formatting/build/testing, hf-build before hf-done, and forbids running verify_cmd by hand. Therefore no baseline failures are claimed. Neither scoped file existed at inspection; gate.json showed zero build and verify runs and gates.jsonl did not exist. The initial working diff contained only runner-prepared .cgignore and spec task-start/prerequisite bookkeeping; all are preserved."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_418.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the exact verified content-derived candidate revision, command, exit code and log path for acceptance 22998.1. Build and verification must pass on the same candidate revision. This record is finalized before qualification; the runner retains the exact revision evidence and commits the result. Embedding that content-derived revision into its own source record would change the revision. No source edit follows a passing hf-done."
wiring_requests = []

[finding.readme-two-domains]
audit = "22.30.144"
file = "README.md"
line = 44
class = "doc-drift"
severity = "medium"
owner_domain = 16
observed = "The audited README described two execution domains, a separate C17 layerxd daemon and checkpoint settlement through layerxAnchor, and called the merge a draft."
expected = "One integrated paxd BFT network, chain 125, root-path node RPC, signed execution receipts and finality at committed blocks; separate kernel daemon and anchor settlement are retired."
out_of_path_step = "README.md rewrite: owner domain 16, task 22.31.470; supplied by the prerequisite and checked here without editing README.md. Any missing expected fact must be requested from that owner rather than changed in this task."
tests = ["test_readme_two_domains_is_one_integrated_chain_125_network", "test_readme_two_domains_root_rpc_hosts_and_chain_id_example", "test_readme_two_domains_transaction_to_committed_receipt_path", "test_readme_two_domains_signed_execution_is_distinct_from_finality", "test_readme_two_domains_retired_executors_and_deployment_history", "test_readme_two_domains_build_and_release_use_integrated_paxd", "test_readme_two_domains_record_maps_finding_proofs_and_limits"]

[gotcha.1]
