source_proof = "The module asserts README source facts for architecture and topology, one chain-125 BFT network, embedded kernel and block proposal, api1 through api14 root JSON-RPC names, parsed curl arguments and JSON chain-ID request, transaction submission and committed receipt order, historical refusal-only custody/checkpoint executors, linked paxd build prerequisites and operator instructions, and current release status. It follows production source connections from rpc/send.go into integrated sequencing, WAL acknowledgement before publication, rpc/sequencer_receipt.go commitment coverage and root dispatch; checks native retirement gates; parses Makefile target prerequisites and recipes; resolves operator/source links; and parses this KVX and the original audit record."
review_only = "Native Go/C/Rust builds, paxd startup, transaction execution, signature verification, endpoint availability, actual WAL restart/recovery and BFT commitment are not executed. Source connections prove documentation contracts, not runtime behavior or deployment health. This doc-drift finding changes no production interface or stateful component, so no interface-mismatch or restart-recovery behavior is claimed. No shell script, unit file or manifest is repaired; shell examples are parsed in-process, never executed, and no external binary, subprocess toolchain, environment variable, credential, live endpoint, native artifact or device is needed by the verify command."
baseline = "No pre-change verification was run: the explicit implementation-first order and exclusive hf-done verification gate override the older step asking for a baseline run, so no tests are claimed to have failed before this change. Initial git status/diff showed only runner-prepared .cgignore and spec status bookkeeping; both scoped files were absent. gate.json recorded zero builds and zero verifies, two repair cycles left, and /out/run/gates.jsonl did not exist."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_483.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl identify the exact verified content-derived revision, command, exit code and log path. Build and verify must pass on the same candidate revision. This record is finalized before gates; embedding its own candidate revision would change that revision. The runner retains qualification evidence and commits the result."
