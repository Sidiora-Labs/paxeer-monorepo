[task.22.33.1325]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
repair = "Consume the root README rewrite owned by 22.31.470 per decision 2525. Add an offline source contract for audit 22.30.70/docs-root-readme without changing README.md or any production source."
source_proof = "The tests read the real README and production sources: integrated paxd/kernel/consensus wiring and BFT commit finality; api1 through api14 root HTTPS JSON-RPC and parsed chain-125 curl request; hosted gateway OpenRPC and explicit native px_ registrations; transaction acceptance/forwarding, WAL acknowledgement before receipt release, receipt rungs and committed coverage; retired custody/checkpoint refusal surfaces; supported linked-native paxd build and runtime commands. The README is the producer of operator instructions, its Markdown and JSON-RPC example are the transport, and the parsed facts are the consumer contract. No shell script, unit file or manifest is changed."
review_only = "Native Go/C/Rust builds, documented shell commands, node startup, transaction execution, WAL restart/recovery, cryptography, live endpoint availability and BFT consensus are not executed by this documentation gate. Source checks prove documented connections and command facts, not runtime certification. There is no stateful component or production interface change requiring restart or interface execution here. Human review establishes prose completeness beyond the asserted facts."
baseline = "Initial git status/diff showed only runner-owned .cgignore and spec bookkeeping; both scoped files were absent and the private gate ledger had no prior runs. The unchanged-tree verify was not run: the explicit implementation-first order and exclusive hf-done gate prohibit a separate baseline invocation. No pre-change test failure is claimed. README already contains the 22.31.470 repair at the base revision."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1325.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence_ledger name the exact verified content-derived candidate revision, command, exit code and private log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification because embedding its own candidate hash would change the hash. The runner retains evidence and commits; no manual commit or push is performed."
wiring_requests = []

[finding.docs-root-readme]
audit = "22.30.70"
file = "README.md"
original_line = 47
class = "doc-drift"
severity = "medium"
owner_domain = 8
owner_task = "22.31.470"
resolution = "The existing README describes one chain-125 BFT paxd network, embedded C17 kernel, commit finality, root public node JSON-RPC, supported build/start commands and retired daemon/checkpoint topology. All expected facts are present; no missing-fact wiring request is needed. Closure is conditional on the declared hf-done evidence, not this declaration."
tests = ["test_docs_root_readme_single_paxd_network_and_commit_finality", "test_docs_root_readme_root_rpc_hosts_and_chain_probe", "test_docs_root_readme_hosted_contract_and_node_px_methods", "test_docs_root_readme_transaction_to_committed_receipt_path", "test_docs_root_readme_retired_executors_and_no_live_legacy_setup", "test_docs_root_readme_supported_build_and_runtime_commands"]

[reconciliation.px_methods]
observed = "The audit expected px_ methods to belong to the hosted gateway contract, while rpc/server.go also registers native px_ account/history and receipt-key methods."
resolution = "Use the current production registrations and 22.31.470's reconciliation: the README distinguishes the gateway OpenRPC contract from native node methods and does not promise all hosted methods at public node URLs."

[wiring.readme]
path = "README.md"
owning_domain = "8; root README owner task 22.31.470"
request = "The out-of-scope README rewrite was already supplied by 22.31.470; this task consumes it and requests no further change."

[format]
policy = "No Python or KVX formatter is configured for these paths. Apply .editorconfig UTF-8, LF, final newline and no trailing whitespace after implementation."

[gotcha.1]
observed = "Broad combined reads exceed tool output limits, Codify brief reports unrelated cached changes, and guessed adjacent task artifacts may not exist."
resolution = "Use bounded sections, actual Git status/diff and the private gate ledger. Record task notes here because GOTCHA.kvx and spec files are outside scope."
