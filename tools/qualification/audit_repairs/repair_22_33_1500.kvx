[task.22.33.1500]
base_revision = "3b455f045071818c07e89b4ab047e7194ba924d7"
checkout_revision = "ebb180defa964cc6888ee21ec80a3a07dae480fb"
repair = "Point the installation page at the maintained tools/platform/cli wallet guide; explain matching signing keys, receipt policy, fee bound and pre-signing disclosures; document the signed-only A2A input, checked txHash, submitted/unknown outcomes and same-hash receipt reconciliation without duplicating payments. Preserve the working emulator bootstrap and current MCP binding height/readiness requirements."
proof = "The Python documentation gate parses the production toolset JSON macro schemas and the actual installation-page argument examples in-process. It checks the production wallet disclosure/sign/send order, signer binding, signed transaction validation and network binding, RPC submission, returned-hash comparison, ambiguity classification and receipt consumer; it also checks the real bootstrap arguments and MCP binding source requirements."
proof_limits = "Rust code, EVM signing, server execution, emulator startup and MCP installation are not executed by this corrected offline documentation gate. Source contracts are checked, not runtime integration or restart recovery; this doc-drift repair changes no runtime component or interface."
planned_path_mapping = "services/platform/tests/repair_22_33_1500.rs maps to tools/qualification/audit_repairs/test_repair_22_33_1500.py under task step 8 and gotcha 2984: services/platform/Cargo.toml is a virtual workspace, so an unregistered Rust test would not execute. No Rust test or Cargo.lock edit is needed for the corrected Python gate."
baseline = "Initial git status/diff showed only inherited .cgignore and spec task-status changes; there was no scoped implementation and /out/run/gates.jsonl did not exist. No pre-change verification was run: the explicit implementation-first order and exclusive hf-done gate supersede step 5's baseline request. No pre-change failing test is claimed."
wiring_requests = []
build_cmd = "python3 -m py_compile tools/qualification/audit_repairs/test_repair_22_33_1500.py"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1500.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The private gate ledger and final hf-done JSON record the exact verified revision, command, exit code and log path; build and verify must pass on the same candidate revision. Embedding the candidate hash in this record would change that candidate, so the runner retains the final evidence separately and commits the qualified result. Closure is conditional on hf-done passing."

[finding.install_guide_inputs]
audit = "22.30.89"
file = "services/platform/docs/content/install.md"
line = 68
class = "doc-drift"
severity = "medium"
expected = "The installation page must link the current tools/platform/cli wallet instructions and give operators the actual inputs needed to use an installed payment-capable A2A runtime."
tests = ["test_install_guide_inputs_maintained_cli_link", "test_install_guide_inputs_signing_and_disclosure", "test_install_guide_inputs_raw_transaction_producer_transport", "test_install_guide_inputs_txhash_reconciliation_consumer", "test_install_guide_inputs_preserves_bootstrap_and_mcp_requirements", "test_install_guide_inputs_record_maps_finding_and_evidence"]

[format]
policy = "No Python, Markdown or KVX formatter is configured for these paths; use the repository .editorconfig UTF-8, LF, final-newline and file-type whitespace rules after completing implementation."

[gotcha.1]
observed = "cg brief reported unrelated next-task and changed-path state despite git status showing only runner bookkeeping; combined broad reads also exceeded output limits and some guessed source names did not exist."
resolution = "Use actual git status/diff and bounded reads of the declared task and production files; retain this note here because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "The inherited task steps still name a Rust integration test and pre-change verification, while the explicit gate order requires implementation first and the corrected step 8 declares only a Python documentation gate."
resolution = "Map the planned Rust path to the corrected Python test, disclose source-proof limits and the absent baseline, and run only hf-build then hf-done without changing spec files or invoking native tools."
