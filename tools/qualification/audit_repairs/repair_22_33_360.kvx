[task.22.33.360]
mode = "BUILD"
source_revision = "00614466646b07799a236d2742211fd5eb2d85c5"
implementation = "Rewrite the health guidance to match the already-corrected override, controller and Rust models; narrowly synchronize the merged generator input's health operation and schemas, removing its obsolete v1 operation. Preserve the shared legacy schemas referenced by the unrelated Celestia operation. Keep the retained Rust compatibility refusal and every existing test intact. The recording example already used /api/health at this prerequisite revision and is now protected by the declared regression gate."
source_proof = "The Python gate validates the documented JSON and committed upstream transcript plus all five source-derived lifecycle cases against the actual merged generator schema, checks required-field rejection, and ties the recorder, mounted router, controller and Rust fields to the documented contract. No alternate client implementation is introduced."
runtime_limits = "Rust integration cases exercise the production ApiClient over real loopback HTTP using the committed upstream health recording and explicitly labeled source-derived lifecycle fixtures. They are registered in the existing crate manifest but not executed by this Python-only gate. No Rust compilation, Elixir producer execution, deployment compatibility or restart recovery is claimed; doc-13 changes documentation and generator health inputs without changing runtime interfaces."
baseline = "No pre-change verification was run: the baseline clause conflicts with the explicit implementation-first order, hf-build-before-hf-done requirement and prohibition on invoking verify_cmd by hand. No baseline failures are claimed. At inspection the scoped tests and record were absent, gate.json recorded zero builds and verifications, and gates.jsonl was absent. Existing runner-prepared .cgignore and spec task-start edits are preserved."
planned_paths = "Register services/explorer/services/libs/tests/repair_22_33_360.rs in the existing blockscout-client/crate/Cargo.toml with a relative test path. The workspace Cargo.lock already exists and no dependency changes are needed."
build_cmd = "python3 -m py_compile tools/qualification/audit_repairs/test_repair_22_33_360.py"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_360.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "Acceptance 22998.1 is evidenced by the final hf-done JSON and private evidence ledger containing the exact candidate revision, command, exit code and log location. Build and verification must pass on the same candidate revision. This record is written before qualification because embedding its own content-derived revision would change that revision. No edit follows a passing hf-done; the runner publishes the qualified result."
wiring_requests = []
gotcha = "The prerequisite health override and generated Rust models were already aligned, while README still described their old defects and the merged generator input still contained metadata.latest_block, cache.mber and HealthV1. Repair only those health portions; do not rerun the whole merge or regenerate unrelated operations. The explicit scope forbids appending this discovery to GOTCHA.kvx or editing spec files."

