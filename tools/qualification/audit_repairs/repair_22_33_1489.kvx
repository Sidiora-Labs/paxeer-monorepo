[repair]
task = "22.33.1489"
audit = "22.30.88"
base = "0ba7cfa54c7f07b37201b1f12fcc2f1dd7ed0ed7"
mode = "BUILD"
baseline = "Not run: the explicit implementation-first and hf-build/hf-done-only gate order supersedes the contradictory request for unchanged-tree verification. No baseline failures are claimed. The initial tree had only runner-owned .cgignore and task-start changes and no gate ledger; both were preserved."
evidence = "The runner's hf-build/hf-done ledger binds the complete candidate tree, including this record, to its deterministic revision, exact command, exit and private /out/logs evidence. The final response copies the last gate JSON. A candidate cannot embed its own tree-derived revision without changing that revision; the base above is not claimed as the verified candidate. The runner owns publication."
scope = "The audit finding paths resolve the malformed task spelling storage environment-journey.sh to services/platform/ramps/sandbox-journey.sh. Both branches share journey_contract.py. The strict reference Work action wires the existing signed-customer engine path required by the migrated journey; no signer, ledger, settlement or journal authority is replaced."

[finding.journey-order-request]
tests = ["test_journey_order_request_shared_builder_matches_real_create_order_binding", "test_both_branches_drive_authority_conflicts_and_explicit_retired_refusal", "test_current_work_requests_bind_real_signed_customer_submission_path", "test_protected_input_schema_refuses_retired_and_unknown_fields", "test_protected_authority_is_required_canonical_and_nonzero", "test_protected_file_reader_reopens_real_inputs_and_refuses_unsafe_files", "test_customer_work_preflight_rejects_malformed_or_unbounded_bytes", "test_other_work_actions_cannot_smuggle_customer_signed_bytes"]
change = "Both branches require the protected LAYERX_RAMP_INPUTS_FILE, send customer_budget_id plus customer_budget_purpose, and check missing authority, changed authority/purpose conflicts, operator-signed off-ramp refusal and canonical_receive_payload rejection. submit_customer_payment carries exact customer-signed EIP-1559 raw_transaction bytes through the strict authenticated Work decoder to RampEngine::submit_customer_payment, preserving existing payer recovery, chain/calldata/budget-purpose/nonce/fee checks and journal-before-broadcast ordering. On-ramp work keeps account_sequence null. Protected inputs reject duplicate, unknown and retired fields, zero/noncanonical authority, symlinks and unsafe permissions."
schema = "Root keys on/off/rebalance. On: order_id, quote_id, amount (canonical positive decimal string), asset/from_account/to_account/context (nonzero lowercase hex32). Off: the same keys plus customer_budget_id/customer_budget_purpose (nonzero lowercase hex32) and raw_transaction (lowercase hex EIP-1559 bytes, no 0x prefix). Rebalance: asset, idempotency_key (nonzero lowercase hex32), operator_account and amount. No account_sequence, canonical_receive_payload, payer_grant or confirmation fields."

[finding.journey-confirmation-vocabulary]
tests = ["test_bft_consumer_admits_only_authenticated_commit_as_completion", "test_no_credit_before_commit_rejects_premature_block_evidence", "test_bft_commit_rejects_unbound_or_invalid_evidence", "test_recovered_committed_identifiers_cannot_change", "test_restart_journey_stops_and_reopens_service_before_retained_state_checks"]
change = "Inventory responses use submitted/receipted/committed status and rung. Completion requires committed plus nonzero block hash and positive bounded block height, exact terms and stable operation/transaction identity. Submitted and receipted observations cannot carry commit evidence or complete the journey. Source assertions bind these checks to InventoryRebalancer::poll authenticating settlement before journal observation and to native signed receipt plus exact block inclusion verification. Recovery now executes stop/start argv for the real service, proves the operator listener refuses a connection while stopped, waits for recovered journal readiness with the same source identity and then compares complete retained order and rebalance snapshots, including operation, transaction, height, block hash and rung. No confirmation count or reorg vocabulary remains in the full journey."
restart = "LAYERX_RAMP_SERVICE_CONTROL_FILE is a protected JSON object with exactly stop and start, each a nonempty argv array beginning with an absolute executable path. The stop command must synchronously stop the actual direct operator service listener; start must launch the same service and journal and return. Commands run without a shell, must exit zero and are bounded to 60 seconds. The full journey preflights this control document before submitting any work. Gateway customer ingress may remain listening; only the direct operator listener is required to close."

[proof]
source = "The sole pytest gate executes real production Python request builders, protected-file reads and BFT observation validation, parses the full embedded journey Python with ast, checks actual guarded shell HTTP commands and exact typed refusal expectations, and compares the real Rust decoder, order binding, engine, signed transaction/budget authentication, BFT response producer and verified journal recovery. It parses both existing Cargo manifests. Consumer negative vectors test shape and identity guards and are not presented as node-generated transactions or authenticated receipts. hf-build alone runs the declared bash -n syntax check; pytest does not repeat it or invoke any subprocess toolchain."
review_only = "The Python-only declared gate cannot execute the Rust service, prove cryptographic signatures, execute the native producer-to-HTTP-to-consumer path, or stop/reopen its native journal process. The restart test proves the production journey orders an actual stop, refused listener, start, verified readiness and retained-state checks; it does not claim a native service restart occurred during pytest. Native compilation and real signed transaction, receipt, transport and process-recovery execution require owner qualification. The preflight intentionally validates only EIP-1559 byte shape; the real Rust customer-payment path owns all signature, payer, purpose, nonce, calldata and fee validation."

[wiring]
hosted_inputs = "Domain 8: services/platform/hosted/tests/beta-cluster.sh and tools/qualification/paxeer-x must provision the maintained protected on/off/rebalance schema, customer-signed raw_transaction for the bound budget/order and LAYERX_RAMP_SERVICE_CONTROL_FILE with synchronous stop/start argv for the direct operator service and retained journal."
native_qualification = "Domain 8: tools/qualification/paxeer-x must build the reference service with the strict submit_customer_payment Work action and run both journey branches against the real service and native chain-125 customer payment/receipt producers, including actual service stop/reopen and authenticated commit recovery; this source-only gate does not claim those native runtime proofs."
operations = "Domain 8: services/platform/hosted/tests and the owning deployment inputs must supply independently pinned TLS/receipt configuration and preserve the journal across lifecycle commands; the existing README.md/OPERATIONS.md statements that no customer-payment Work action exists need coordinated owner documentation after this interface lands."

[gotcha]
baseline = "The request for a pre-change verification conflicts with the mandatory implementation-first, bounded hf-done-only order; no undeclared baseline gate was run and no pre-change failure is invented."
authority = "The former journey expected native_payer_grant_authorization_required, but the actual service maps PayerGrantRequired to layerx_binding_refused; both branches now assert the maintained typed refusal."
runtime = "Python source qualification cannot be relabeled as native process-recovery proof. Runtime boundaries and restart remain explicit owner wiring, with no mock service or fallback claim."
