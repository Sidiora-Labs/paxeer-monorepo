source_proof = "The module reads the real README, checks the one-paxd topology and embedded native host against node and cgo wiring, parses the documented root JSON-RPC probe and hosted OpenRPC contract, checks signed transaction acceptance/forwarding and WAL acknowledgement before receipt publication against production sources, checks committed receipt coverage and diagram order, checks retired executor guards, and parses actual make rules and release identity JSON for the documented binary and linked archives."
review_only = "Native Go/C/Rust builds, actual node startup, signed transaction execution, cryptographic verification, WAL restart/recovery, endpoint availability, deployment state and BFT finality are not executed by this documentation gate. Production source checks prove documented connections, not runtime execution. No stateful component or interface is modified, so no restart or interface integration proof is claimed. The current release inventory and upgrade handlers are source facts, not evidence that a deployed network has activated v7.0."
baseline = "Initial git status/diff contained only runner-prepared .cgignore and spec task-status changes; neither scoped repair file existed. /out/run/gate.json recorded zero builds and verifies and no /out/run/gates.jsonl existed. A pre-change verify was not run: the explicit implementation-first order and exclusive hf-done verification supersede the embedded baseline request. No test is claimed to have failed before this change. README.md remains unchanged from the checkout."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_707.py"
