readme_revision = "38801bb427090ac96d47c86a026a63ec05e67315"
repair = "Consume the root README rewrite owned by 22.31.470 under decision 2525. Add finding-specific regression assertions for audit 22.30.4/028 without changing README.md or production sources. The owner already replaced daemon/draft/retired-interface guidance with the integrated paxd architecture, implemented upgrade-controlled interfaces and native-library node build."
source_proof = "Eight pytest tests read the real README and compare its architecture to the production cgo host and consensus source; parse the documented curl arguments and JSON chain probe and check root RPC dispatch; trace transaction acceptance/forwarding through WAL release and committed receipt coverage; check implemented upgrade handlers; parse and compare all thirteen documented merge precompile rows with MergeAddressTable; assert retirement guards and the absence of old daemons; parse Makefile dependencies and verify the chain.mk paxd output and CLI startup registration; validate this finding-to-test map and resolve relevant local source links."
review_only = "Native Go/C/Rust builds, paxd startup, live RPC availability, transaction execution, cryptographic verification, WAL restart/recovery and BFT commitment are not executed by this gate. Producer, transport and consumer connections are source facts for documentation drift, not runtime certification. No production interface or stateful component changes, so no restart or interface round-trip proof is claimed. No shell script, unit file or manifest is changed; shell example arguments and JSON are parsed in-process, without invoking curl, bash or any subprocess toolchain. The gate needs no environment variable, credential, endpoint, native artifact or device. Editorial clarity and any future explicitly dated historical migration account require review; the current README omits layerxd and layerxctl entirely."
baseline = "No pre-change verification was run: the explicit implementation-first order and exclusive hf-done gate prohibit manual or pre-implementation pytest runs. No baseline failures are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task-status bookkeeping, neither scoped file existed, and /out/run/gates.jsonl did not exist. The README was already rewritten by 22.31.470 at readme_revision."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1037.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl name the exact verified content-derived candidate revision, command, exit code and log path. hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification; embedding its candidate hash into its own content would change the hash. No source edit follows a passing hf-done. The runner retains evidence and publishes the result; no manual commit or push is performed."
missing_facts = []
wiring_requests = ["README.md -> domain 17 / task 22.31.470: own the architecture, specification-status, current precompile and paxd build rewrite for finding 028; satisfied by readme_revision, with no additional missing fact identified in this source review."]

