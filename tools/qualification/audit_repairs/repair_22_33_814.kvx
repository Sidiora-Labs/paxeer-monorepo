[task.22.33.814]
audit = "22.30.179"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
repair = "Preserve the merged assembly delivered by prerequisite 22.31.427: one paxd with the linked C/Rust kernel and typed native keepers, no bootstrap/supervisor/generation/core/replica/authority/Human service bundle. Separate EVM-chain validation from domain identity in init.sh and direct Python invocation: current LAYERX_NODE_EVM_CHAIN_ID and historical LAYERX_NODE_PAXEER_CHAIN_ID must independently be 125 if supplied; LAYERX_NODE_NETWORK_ID is never substituted for either or rewritten. Refuse legacy metadata, settlement or guarantor state even in a partly provisioned native home, before reading genesis or private inputs; retain all bytes and require an explicit offline migration to a separately provisioned home. Document both profile defaults, migration, authoritative EVM identity and the owning public RPC/KMS deployment policies."
prior_repair = "The five finding locations describe the pre-merge entrypoint. At this task's base, prerequisite 22.31.427 had already removed the external peer/quorum selector, receipt_authority_prepare, agent_boundary_prepare, human_kms_chain_snapshot and every caller of the Human KMS loader from docker/kernel, and built/copied only the native kernel closure. Restoring those retired launch paths to apply the old line-local proposals would contradict the prerequisite and the retired-reference findings. Their in-kernel closure is retirement, not an assertion that out-of-path service integration has run. Dockerfile, unit, build exclusions and files.tsv remain byte-identical to the prerequisite because no additional assembly edit is needed."
baseline = "No pre-change verification was run: the explicit Order requires complete implementation, hf-build, then hf-done, and forbids running verify_cmd by hand; step 9's unchanged-tree baseline contradicts those instructions. No baseline failing-test result is claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task-start bookkeeping; /out/run/gates.jsonl did not exist and gate.json reported zero builds/verifications. Preserve that work. Source inspection found that init.sh still equated LAYERX_NODE_NETWORK_ID with EVM chain 125, despite the committed native fixture carrying domain 402 and EVM 125."
source_proof = "Parse Docker instructions, stage inheritance, COPY/ENTRYPOINT arrays and embedded Python ASTs; check pinned build inputs, native C/Rust and cgo paxd producers, shared typed keeper consumers, current Python runtime closure and private input exclusions. Parse the systemd unit and environment, check durable mount, restart/stop behavior, loopback host RPC exposure and real guarded shell commands. hf-build runs bash -n once; pytest does not invoke Bash or a subprocess toolchain. Execute production validate_home and validate_chain_environment against committed native-home fixtures; assert explicit legacy refusal preserves every path, mode and byte across reopening, archived sibling state is never consumed, both profiles need no obsolete boundary name, domain 402 remains distinct from signing chain 125 and every wrong/empty/ambiguous EVM-id input is refused."
runtime_proof = "Reuse only the committed recorded-peer transport helpers from test_repair_22_31_427.py and its native node-owner RPC transcript fixture. Drive kernel_runtime.CommittedReadiness through the production native_runtime.rpc and committed_health calls into a forked loopback transcript peer and read the actual production HTTP readiness server. Require canonical consensus commit, chain identity and identical EVM block before readiness; stop the peer and HTTP consumer, reopen with the production checkpoint retained, and require fresh chain reads. Dead/unavailable peers cannot turn retained state into health. This proves production Python readiness recovery, not native node database recovery."
review_only = "The gate does not compile paxd/C/Rust, build or run Docker, execute Bash/setpriv/systemd, run BFT consensus, recover the native paxd database or execute the Rust KMS loader. KMS ChainSnapshot serde schema, chain-id-only material read and chain-125 refusal are checked as source facts only; no projected file is produced or consumed by this kernel because the whole service path was retired. Public TLS verification and distinct-peer quorum belong to the gateway/client deployment: this kernel has no public-peer selector and accepts only its local root RPC as a readiness authority. Tests exercise all fifteen canonical names plus invalid names as refused local authorities, not as a new public allowlist. The documented public acceptance policy and actual KMS-loader acceptance with distinct ids need owning-domain execution below. No test emulates Rust, BFT, TLS peers or native services."
evidence = "hf-build runs bash -n docker/kernel/init.sh; hf-done runs cg spec done 22.33.814 -f layerx-merge --root with the runner-provided task root and python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_814.py. The final hf-done JSON and private /out/run/gates.jsonl ledger record the exact content-derived verified candidate revision, command, exit code and private log location; both gates must name the same revision. This record is part of that candidate and is not rewritten after the gate to insert a self-referential revision. The runner owns the final revision/evidence record and commit; no manual commit or push."
wiring_requests = ["services/wallet/deploy/human.toml — wallet/Human deployment owners, domains 12/10: replace the obsolete kernel-image build, old full-profile inputs and 8080/9454 service assumptions with the owning Human service image, authenticated merged gateway and current KMS configuration; the merged kernel image exposes only native node/readiness ports.", "spec/layerx-merge/interfaces.kvx and generated contracts/operations.md — registry/tooling owners, domains 17/16: reconcile 16.cli-dock-kernel-init and obsolete authority environment rows with the single paxd entrypoint, explicit offline migration and committed readiness; remove retired public-peer/network-name/KMS projection claims without hand-editing generated views here.", "services/platform/hosted/gateway and public RPC/client deployment — platform/RPC owners, domains 8/7: enforce exactly fifteen accepted names, api1 through api14.mainnet-beta.paxeer.network plus api-mainnet-beta.paxeer.network, HTTPS root paths, authenticated TLS name/CA checks and distinct serving peers; test aggregate acceptance, api15/api16 and malformed/duplicate-name refusal against the real selector, which is no longer part of kernel init.", "services/human/crates/layerx-human-service/src/bin/layerx-human-kms-gateway.rs and Human deployment projection — Human owner, domain 10: supply the strict chain_id-only registry file from authoritative EVM id 125, retain domain id 402 for domain policy material, and drive the real Rust KMS loader with that producer's file under distinct ids; no kernel KMS launcher/projection exists after 22.31.427, and a Python substitute is not loader evidence.", "docker/kernel image/native deployment and services/platform/hosted/node/tests — image/node owners, domains 16/5: build and run the actual admitted paxd image on the separately provisioned native home, qualify committed state and native database/WAL/key recovery before switching an archived legacy mount; the Python-only gate proves readiness checkpoint recovery, not that native qualification."]

[finding.kernel-image-retired-assembly]
tests = ["test_kernel_image_retired_assembly_current_dependency_closure", "test_kernel_image_unit_and_persistent_volume_contract"]
closure_boundary = "Current merged image/source dependency closure and service wiring are asserted; actual image build and out-of-path Human deployment alignment require the owner requests above. No retired assembly is restored."

[finding.kernel-retired-state]
tests = ["test_kernel_retired_state_offline_migration_preserves_volume", "test_kernel_retired_state_archived_sibling_is_not_consumed", "test_kernel_retired_state_committed_identity_survives_readiness_restart"]
closure_boundary = "Legacy state is explicitly refused without mutation, offline migration is documented, and production Python readiness recovers from committed-chain state instead of retired trust projections; native backend recovery and registry reconciliation remain owning-domain work."

[finding.kernel-rpc-hosts]
tests = ["test_kernel_rpc_hosts_public_names_cannot_replace_local_committed_node", "test_kernel_rpc_hosts_refuses_nonroot_or_ambiguous_local_origin", "test_kernel_rpc_hosts_native_acceptance_and_public_owner_policy"]
closure_boundary = "The obsolete in-kernel external-peer selector is absent; all fifteen public names and invalid hosts are refused as local chain authorities. Exact public-name acceptance, distinct-peer quorum and TLS deployment verification are documented and requested from the real out-of-path owner, not claimed as executed."

[finding.kernel-native-network-name]
tests = ["test_kernel_native_network_name_default_inputs"]
closure_boundary = "Both historical profile names select the same native runtime with their documented input set; no boundary name lookup or retired service preparation can wait for an unset name. Shell execution remains covered only by the declared syntax gate and source checks."

[finding.kernel-kms-chain-selection]
tests = ["test_kernel_kms_chain_selection_domain_is_not_evm_identity", "test_kernel_kms_chain_selection_refuses_wrong_evm_input"]
closure_boundary = "The retired KMS snapshot producer/caller stays absent, current entrypoint/direct invocation never substitute domain id for EVM id, and the real Rust loader schema/refusal is checked as source. Actual projected-file acceptance by that loader is explicitly an out-of-path owner obligation."

[gotcha.1]
symptom = "Step 9 requests an unchanged-tree verification that conflicts with the explicit implementation-first order and single-run gate budget."
resolution = "Follow the explicit order, never run verify_cmd manually, and claim no baseline gate result. Root GOTCHA.kvx and spec qualification files are out of scope; record task gotchas here."

[gotcha.2]
symptom = "Finding line numbers refer to launch paths retired by prerequisite 22.31.427; restoring them would undo the merged kernel repair."
resolution = "Prove their retirement and current production path, fix the remaining chain-id conflation, and name out-of-path public selector, registry and KMS-loader requests honestly."

[gotcha.3]
symptom = "Large workflow/gotcha reads exceeded tool output limits; some prerequisite ids do not use the assumed audit-repair filenames. An atomic patch failed when a comment from concatenated files was attributed to the environment example."
resolution = "Use bounded relevant source/record reads and the committed 427 repair evidence; inspect actual files after a refused patch and apply only the corrected in-scope change. No build or test ran during partial implementation."
