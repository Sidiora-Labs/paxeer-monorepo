[gotcha.scope_and_baseline]
observed = "General workflow requests GOTCHA/spec edits and commit/push, while the direct task forbids them and forbids pre-implementation verification."
resolution = "Keep notes here, use only hf-build then hf-done, preserve runner setup, and leave publication to the runner."

[gotcha.fixture_shape]
observed = "The prior attempt required journey sequence fields and shared-fixture case IDs that do not exist in the adapter-derived capture shape."
resolution = "Resolve each declared fixture/case; use the positive sequence from authenticated receiptJson.seq and preserve pending/reverted recordings."

[gotcha.cached_context]
observed = "cg brief reports unrelated cached task context and broad reads exceed the output budget; gate wrappers live in /out/run/bin rather than /usr/local/bin."
resolution = "Use exact task/finding sections and bounded source reads; command -v locates wrappers and the private ledger controls gate usage."
