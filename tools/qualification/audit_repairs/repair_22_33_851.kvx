[gotcha.baseline]
symptom = "The requested unchanged-tree verify conflicts with implementation-first, hf-build-before-hf-done and the prohibition on manual verification."
resolution = "Follow the explicit gate order, claim no baseline result and record here because root GOTCHA.kvx and spec files are outside scope."

[gotcha.shell_build]
symptom = "bash -n with several filenames parses only the first script and treats the remaining filenames as positional arguments."
resolution = "Keep the declared hf-build command unchanged; the pytest module parses each changed shell individually."

[gotcha.context]
symptom = "Whole-ledger and broad graph/source output was too large and truncated; the graph's native paths are excluded by runner setup."
resolution = "Use bounded exact source reads and targeted section extraction instead of broad output; preserve runner setup."

[gotcha.retained_sources]
symptom = "The old node deployment test expects retired core-boundary containers and the probe Cargo manifest still references retired platform-core."
resolution = "Select the retained current kernel committed-readiness corpus alongside the existing complete broker corpus; record out-of-path probe and native node qualification requests without modifying neighboring modules or weakening tests."
