[task]
id = "22.33.851"
mode = "BUILD"
audit = "22.30.181"
base_revision = "7f73e1e62e9ec5f5baf39701e42280257640cf0a"
implementation = "Keep the retained foundation Go corpus and standard marker, rejecting completion-before-start and unrequested child events. Replace generation gate legacy daemon/authority binaries and source lists with build/paxd, retained node lifecycle modules, merged kernel image/runtime and deployment sources. Execute the complete retained generation pytest module including its free-function adoption/reopen test, and the current merged-kernel committed readiness/recovery/refusal corpus; count real collected setup/call/teardown passes and actual Go JSON completions, then emit the standard dispatcher marker only after both corpora succeed. Correct the multi-asset recorder singleton tuple and factor its exact compiler-event selection into a directly tested production function without replacing executable bytes or loosening artifact/source checks."
baseline = "Not run: the explicit implementation-first order and exclusive hf-done rule prohibit the conflicting unchanged-tree verify instruction. No pre-change failing or passing tests are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task-start bookkeeping. gate.json reported zero builds and verifies and no prior gates.jsonl existed. The 24.18 standard marker and exact retained corpus already existed at base; preserve them and add event-order/unrequested-child refusals."
build_cmd = "bash -n tools/paxeer-x/gates/24.18.sh tools/paxeer-x/gates/24.20.sh tools/paxeer-x/gates/5.1.sh"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_851.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private runner ledger name the exact content-derived verified revision, command, exit and log, with hf-build on the identical candidate. The runner commits; no manual commit or push. This record is written before qualification: inserting its own verified content revision afterwards would change that revision."
source_proof = "Parse each shell individually with bash -n and every embedded Python block with ast. Check retained declared Go test functions, exact package/case inventories, bounded native commands and exit propagation, real compiler transcript input and exact singleton loop shape, Cargo binary manifest keys, executable/ELF/digest provenance and durable private manifest writes. Execute both production and consumer source-list expressions to prove identical retained path sets and existence. Parse current deployment YAML, systemd service keys and probe Cargo TOML, checking paxd identity, persistent mount, readiness and non-root deployment."
runtime_proof = "Run the production native generation publisher on committed genesis/config/certificate/identity inputs, transport its actual output through a real Unix listener with the production SO_PEERCRED/SCM_RIGHTS broker handler into generation_client.receive, child_environment and materialize. Close all descriptors/views/listeners, discard the broker and state reader, reopen retained durable state and prove identical generation, identity and artifact digests; refuse the wrong generation. Reuse the committed kernel recovery proof to stop/reopen the production readiness consumer and captured RPC loopback peer, recover the actual persisted height/hash checkpoint and demand fresh committed reads. Run actual pytest on four committed protected-record refusal cases through the gate's production reporting plugin, then transport its real count through the exact production marker print and actual dispatcher COUNT matcher. Exercise real count/selector functions on explicitly labelled Go/Cargo/report protocol unit data, never native execution evidence."
review_only = "This Python gate does not compile Go/Rust/C, build containers, run native paxd or the probe, or certify compiler-emitted executable authenticity, native database/WAL recovery or BFT consensus. The native gate commands and artifact/source checks are source-qualified only. Compiler selection protocol examples never create an executable, transcript evidence file or manifest and never replace emitted artifacts. Actual compiler-event-to-ELF-hash-to-manifest provenance is checked along the unchanged real source path and remains native owner qualification. The broker and committed-readiness reopen checks prove production Python recovery with committed peers, not native backend recovery. The full retained generation/native Go corpora are selected and source-qualified here; only the named in-process Python proofs actually execute during this task's verify."
formatting = "No Python, Shell or KVX formatter is configured for these paths; follow .editorconfig final-newline/trailing-whitespace conventions after completing implementation."

