repair = "Consume the root README rewrite landed by 22.31.470 under decision 2525 and add a focused offline regression proof for root-overview-retired-daemon; README.md is outside this task's scope and is unchanged."
source_proof = "The six-test pytest module reads the actual README and audit record. It checks one embedded-kernel paxd BFT network, chain 125, api1 through api14 root JSON-RPC, the parsed eth_chainId curl JSON request, the mirror-only library host, transaction submission and receipt rungs, commitment finality, topology and ordered receipt diagrams, retirement and archive-only language, and parsed merged-node build/start commands. Static comparisons connect these claims to the real node host, root RPC dispatcher, transaction accept/forward paths, durable WAL release before receipt publication, committed sequence coverage, retirement gates and paxd build target. It parses this KVX and maps the finding to every declared source test."
review_only = "Native Go/C/Rust execution, actual URL availability, transaction execution, cryptography, BFT commitment, upgrade activation and WAL restart/recovery are not executed. This is a documentation finding, with no production interface or persistent-state change; source facts establish documented connections, not runtime certification. README shell examples are parsed in Python; no shell script, unit file, manifest or native build is repaired here."
baseline = "Both scoped files were absent; git status/diff showed only runner-prepared .cgignore and spec bookkeeping. gate.json recorded zero builds and verifies and no gates.jsonl existed. Baseline verification was not run: the explicit implementation-first order and exclusive hf-done gate supersede the older pre-change-verify clause. No pre-change test failures are claimed."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1491.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The last hf-done JSON and private /out/run/gates.jsonl name the exact verified revision, command, exit code and log. Build and verification must pass on the same candidate revision. This record is finalized before the gates because inserting its own candidate hash would change that hash; the runner retains the evidence and publishes the task."
