[task.22.33.744]
mode = "BUILD"
base_revision = "76c050242a1edcad6212aa52fac15670ecb5612d"
acceptance = "22998.1: retain the GIGA workload and both Go suites; qualify the repaired source contracts through the declared build and verify gates without skipping or weakening cases."
scope = ["tests/integration/evm_module/scripts", "tools/qualification/audit_repairs/repair_22_33_744.kvx", "tools/qualification/audit_repairs/test_repair_22_33_744.py"]
repair = "Require all four mixed-mode validators to advance after the workload and return equal AppHash/LastResultsHash at one committed header above every post-workload baseline; diagnose failures through an exit-status-preserving EXIT trap. Require frozen npm ci. Make sender lookup, sequence advancement, both deployments, successful matching receipts and mandatory Go fixture bindings fail closed."
source_proof = "Pytest parses each changed shell script individually with bash -n and checks production function bodies and command ordering. It tokenizes the actual bounded validator transport and receipt request, parses the JSON payload, checks response/error/status/hash/height/address guards, traces CLI Transaction hash output through Docker arguments and receipt lookup to exports consumed by the existing Go runner, and checks all waits and bindings precede both unchanged suites. It checks the three finding-to-test mappings in this parsed record. No stub, fake, mock, credential, live endpoint, npm/Go toolchain or native artifact is used."
review_only = "Source review establishes the intended control-flow contract; runtime execution of Docker, curl, jq, paxd, npm, Hardhat and Go is not qualified here. The only test subprocess is the explicitly requested bash -n syntax parser, also used by the declared build; no subprocess build toolchain runs. Live mixed-executor consensus, CLI signing, sequence progression and on-chain receipt contents require integration review. These are test-gap/config-drift findings, with no restart-recovery or interface-mismatch repair."
baseline = "Unchanged-tree verify was not run: the explicit Order requires full implementation before testing and permits verify only through hf-done after hf-build, superseding the conflicting baseline clause. No baseline failing test is claimed. Initial scoped files had no changes; the only dirty files were runner-prepared .cgignore and spec status. gate.json recorded zero builds and verifies; no gates.jsonl existed."
build_cmd = "bash -n tests/integration/evm_module/scripts/evm_giga_mixed_tests.sh tests/integration/evm_module/scripts/evm_giga_tests.sh tests/integration/evm_module/scripts/evm_rpc_tests.sh"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_744.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private ledger record the exact verified candidate revision, command, exit code and log path. Both gates must name the same candidate. This source record is written before qualification because embedding its own content-derived revision would change the candidate. The runner publishes the result; no manual commit or push is performed."
wiring_requests = ["contracts/package-lock.json (manifest contracts/package.json): owning dependency domain 16 must repair any frozen-install failure in a separate dependency task with its own evidence; this task removes only the fallback and does not change the lock or claim it installs."]

