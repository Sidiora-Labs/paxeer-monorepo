[gotcha.1]
observed = "The baseline-verify clause conflicts with the explicit implementation-first, wrapper-only gate order."
resolution = "Follow the explicit order, claim no baseline result, and record the contradiction here because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "Combined workflow, graph and audit reads exceeded the output budget, and guessed neighboring repair paths did not exist."
resolution = "Use bounded task-specific reads and actual paths; no extra gate was run and no out-of-scope file was changed."

[gotcha.3]
observed = "The CLI deploy producer emits a Transaction hash label, whereas associate-address emits a Response-prefixed JSON-RPC envelope and can return a JSON-RPC error with a successful process exit."
resolution = "Parse the precise hash label; reject association envelopes with an error or missing result before waiting and submitting the next signed transaction."

[gotcha.4]
observed = "The declared multi-path bash -n invocation parses the first script and passes later paths as arguments."
resolution = "Keep the exact declared build command and parse all three production scripts separately in the declared pytest module."
