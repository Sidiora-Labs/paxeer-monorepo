[task.22.33.1121]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
readme_owner = "22.31.470 / domain 17"
repair = "Decision 2525 assigns README.md to task 22.31.470. Preserve its completed rewrite without editing that out-of-scope path; add independent regression assertions for audit 22.30.48/readme-retired-network covering architecture, root-path node RPC, transaction and committed receipt flows, integrated paxd builds, upgrade gates and retired executors. No pre-merge deployment procedure remains in the README to move; retained codecs, witness formats and anchor views are explicitly historical."
source_proof = "The pytest module asserts README source facts and diagrams for one chain-125 BFT network with a proposing kernel inside paxd, api1 through api14 root JSON-RPC and no router or separate execution interface. It parses the documented curl arguments and JSON payload without executing them, checks the real root-path dispatcher, follows source connections from SendRawTransaction through integrated acceptance or forwarding and WAL acknowledgement before receipt publication, and checks the sequencer receipt consumer's three rungs and committed block coverage. It parses Makefile prerequisites and recipes for linked native libraries and build/paxd, checks production host and consensus wiring, upgrade handler names and executor retirement guards, resolves historical source links, and rejects obsolete daemon, route and draft-merge instructions. The task record is parsed and mapped to every declared proving test and the owning README task's coverage entry."
review_only = "Native Go/C/Rust builds, node startup, signed transaction execution, cryptographic verification, WAL restart/recovery, live endpoint availability and actual BFT commitment are not executed by this Python-only documentation gate. Producer, transport and consumer relationships are source assertions, not runtime or deployment certification. No interface-mismatch or restart-recovery finding is being repaired and no production interface or state is changed. No shell script, unit file or manifest is modified; no subprocess, external toolchain, environment variable, credential, live endpoint, native artifact or device is needed by the test module."
baseline = "No pre-change verification was run: the explicit implementation-first order requires complete implementation before formatting/build/testing and hf-build before hf-done, and prohibits a manual verify_cmd run. Thus no baseline test failure is claimed. Initial gate.json recorded zero build and verify runs, two repair cycles available and no gates.jsonl existed. Initial git status/diff showed only runner-prepared .cgignore and spec bookkeeping; neither scoped repair file existed, and README.md already contained task 22.31.470's corrections."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1121.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl name the exact verified content-derived candidate revision, command, exit code and log location. hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification; embedding its own candidate revision would change that revision. The runner records evidence and publishes the task; no manual commit or push is performed."
wiring_requests = []
wiring_policy = "Any missing README fact must remain an assertion failure and be recorded here as a one-line request naming README.md, owning domain 17 and task 22.31.470; never edit README.md or weaken the check. Inspection found all requested facts present, so no wiring request is outstanding."

