repair = "Consume the root README rewrite owned by 22.31.470 under decision 2525. Add focused regression assertions for audit 22.30.18 finding 22: one chain-125 BFT network with its kernel inside paxd, root JSON-RPC, transaction submission and committed-block receipts, merged build/start commands, separate optional hosted contracts, and explicitly historical custody/checkpoint refusal surfaces. README.md is read only."
source_proof = "Seven tests read the actual README, parse its chain probe with shlex and JSON, inspect URLs, diagrams and linked node/gateway contracts, check production host/consensus wiring, transaction acceptance or forwarding, WAL release before receipt publication, receipt rungs and committed sequence coverage, parse Makefile target dependencies and recipes through chain.mk to daemon/paxd, check retirement guards, and validate this finding-to-test map. No production text is replaced by a fixture."
review_only = "Native Go/C/Rust builds, shell execution, node startup, transaction execution, WAL restart/recovery, cryptographic proof verification, BFT consensus and endpoint availability are not executed. The checks prove source and documentation facts along the producer, transport and consumer path, not runtime certification. This is a documentation finding; no stateful component or interface is changed, and no restart/recovery or runtime interface proof is claimed. No shell script, unit file or manifest is changed; documented commands are parsed without invoking an external binary."
baseline = "No pre-change verification was run: the explicit implementation-first order and exclusive hf-done gate prohibit the older audit baseline instruction. No baseline failures are claimed. Initial git status/diff contained runner-prepared .cgignore and spec status changes only; both scoped files were absent. The private gate configuration showed zero builds and verifies, two repair cycles left, and no gates.jsonl existed. README already contained the owner task's rewrite."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_834.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl record the exact verified content-derived candidate revision, command, exit and log path; hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification because embedding its own candidate hash would change that hash. The runner retains qualification evidence and publishes; no manual commit or push is performed."
