verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_202.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the exact verified content-derived candidate revision, command, exit code and log. Build and verification must pass on the same candidate revision. This source record is finalized before qualification; embedding its own candidate hash would change that hash. The runner retains the exact revision evidence and publishes the task. No manual commit or push."
