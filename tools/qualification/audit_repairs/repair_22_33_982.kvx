[repair]
task = "22.33.982"
acceptance = "22998.1"
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
starting_revision = "3cab1f3a70634449c9bf931285b2e313b62cdf39"
implementation = "Decision 2525 assigns the README rewrite to task 22.31.470. Its qualified rewrite is merged into the starting revision. Preserve README.md and add focused regression assertions for audit 22.30.30/readme-merge-topology, plus this finding-to-proof record."
source_proof = "Read the actual README sections and Mermaid diagrams; parse the documented curl arguments and JSON payload; check chain 125, api1 through api14 HTTPS root JSON-RPC hosts, embedded paxd execution, block-commit finality, transaction submission, WAL-before-receipt release, committed receipt coverage, retirement and versioned history. Compare documented producer, transport and consumer facts with production node host wiring, RPC dispatch, receipt publication and upgrade gates. Resolve README source links and check documented paxd build/start entrypoints against Makefile, chain.mk and daemon command registration."
review_only = "Native Go/C/Rust builds, node startup, transaction execution, WAL recovery, cryptographic verification, BFT consensus and live endpoint availability are not executed. These are documentation source assertions, not runtime or deployment certification. No interface or restart-recovery behavior changes. No shell script, unit file or manifest is repaired, and the gate needs no subprocess, external binary, environment variable, credential, endpoint, native artifact or device."
baseline = "No pre-change verification was run: the explicit implementation-first order and exclusive hf-done gate supersede the older unchanged-tree baseline instruction. No baseline failures are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec changes; neither scoped file existed. gate.json recorded zero builds and verifies and no gates.jsonl existed. The runner merged prerequisite 22.31.470 after the stated base, yielding starting_revision."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_982.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The revision field of this task's final passing hf-done row in /out/run/gates.jsonl."
evidence = "The final hf-done JSON and private evidence ledger record the exact content-derived candidate revision, command, exit code and log path. Build and verification must pass on the same candidate revision. Finalize this source record before qualification: inserting its own candidate hash would change that hash. The runner retains the evidence and commits the result; no manual commit or push is performed."
wiring_requests = []

[finding.readme-merge-topology]
audit = "22.30.30"
file = "README.md"
audit_line = 47
class = "doc-drift"
severity = "medium"
owner_domain = 17
tests = ["test_merged_paxd_network_and_block_commit_finality", "test_chain_125_and_numbered_root_rpc_hosts", "test_transaction_to_committed_receipt_producer_transport_consumer", "test_topology_and_receipt_diagrams_agree_with_commit_model", "test_retired_executors_and_versioned_upgrade_history", "test_current_build_start_and_source_links", "test_finding_record_names_every_proof_and_evidence_contract"]
wiring_request = "README.md -> owning domain 17, task 22.31.470: rewrite network architecture and upgrades for single paxd execution and block commitment, current root RPC and startup, versioned historical refusal surfaces, and no separate daemon or checkpoint deployment; satisfied by the inherited rewrite, with no missing fact identified in source review."
closure = "The tests assert every required README fact; closure requires the final hf-done evidence, not this declaration. Any missing fact must remain a failing assertion and be routed to 22.31.470 rather than editing README.md here."

[format]
policy = "No Python or KVX formatter is configured for these qualification paths. Follow neighboring Python style and apply .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions to the two scoped files after implementation."

[gotcha.1]
observed = "The older baseline-verification step conflicts with the explicit implementation-first order and the prohibition on manual verify_cmd execution."
resolution = "Use only hf-build followed by hf-done after complete implementation; claim no baseline run."

[gotcha.2]
observed = "Combined context reads exceeded output limits, guessed gate paths were absent, and cg brief reported unrelated cached changes."
resolution = "Use bounded task and source sections, command-discovered /out/run/bin wrappers, actual Git state and the private gate ledger. Record notes here because GOTCHA.kvx and spec files are outside scope."

[gotcha.3]
observed = "The first hf-done passed six tests and failed the daemon-name assertion because lowercasing getLayerXDid made it contain the substring layerxd."
resolution = "Match the forbidden daemon as a case-insensitive whole token so the valid account ABI name is parsed correctly; retain the daemon prohibition and every source-fact assertion. Failed candidate bf4334aa5861db36f6dfe2db531493f460d3f4b2, command cg spec done 22.33.982 -f layerx-merge --root /work/paxeer-monorepo, exit 1, private log /out/logs/verify-1.log. Rerun build and verification on the repaired candidate."
