repair = "Consume the README correction owned by 22.31.470 under decision 2525. Add focused regression proofs for audit 22.30.121/doc-03: one paxd BFT network, embedded kernel, chain 125, root JSON-RPC hosts api1 through api14, transaction and committed receipt flow, Programs at 0x101D, retired custody/checkpoint executors, linked-library node builds and the merged-network developer path. README.md already contains every required fact and is outside scope; no README edit is made."
source_proof = "The Python module asserts actual README source facts, parses its precompile table against the production MergeAddressTable, traces Programs registration to the embedded host, parses the documented curl arguments and JSON without execution, and checks root-path RPC dispatch. It follows real transaction acceptance/forwarding, durable WAL acknowledgement before receipt publication and committed sequence coverage in RPC source. It checks retired executor guards, Makefile prerequisite/recipe structure and chain.mk node output, diagram execution/commit ordering and local developer links. The record maps the sole finding to all declared tests."
review_only = "Go/C/Rust builds, node startup, EVM execution, signature/proof verification, live endpoint availability, durable recovery and BFT consensus are not executed by this documentation gate. These source assertions establish the documented producer, transport and consumer connections, not runtime or deployment certification. No production interface or restart-recovery implementation changes, so no runtime interface or restart test is claimed. No shell script, unit file or manifest is modified; the tests use only Python standard-library reads/parsers and pytest, without environment variables, credentials, endpoints, external binaries, subprocess toolchains, native artifacts or devices."
baseline = "No pre-change verification was run: the explicit implementation-first order requires hf-build before hf-done and forbids invoking verify_cmd by hand, superseding the contradictory unchanged-tree baseline clause. No baseline failed tests are claimed. Initial git status/diff contained only runner-prepared .cgignore and spec task-start/dependency bookkeeping; neither scoped artifact existed. gate.json recorded zero builds and verification runs, and no gates.jsonl existed."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_216.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence_ledger verify row record the exact verified revision, command, exit code and log path. Build and verify must pass on the same candidate revision. This record is finalized before qualification; embedding the content-derived candidate revision inside its own source would change that revision. No edit follows passing hf-done. The runner retains the evidence and commits; no manual commit or push is performed."
