[task.22.33.1318]
base_revision = "2a8418f3ce46275830d68ea57514c30466a3493f"
seed_revision = "5e7d4aaa3d48cca0326ee1fd40bc4fafa28fc2ec"
repair = "Preserve the prior README setup and qualification repairs and Node example test. Remove the withdrawn Rust test, replace its obsolete Cargo and Node wiring requests with the corrected offline Python documentation proof, and map the finding to that proof."
proof = "Read the actual README, all four beta profiles and package scripts, the application manifest, the paid API offer/key consumer, the runtime receipt resolver and the qualification entry point. Compare documented RPC roots, environment-variable names, launch commands, x402 offer, pinned-key fields, receipt states and historical emulator limitations with those committed sources."
proof_limit = "Source-level doc-drift proof only: Node, Rust and native chain execution, cryptographic verification, loopback transport and deployed economic outcomes are not executed by this gate. The existing Node test is retained unchanged as supplemental coverage; its runtime behavior is not claimed by the Python gate. No restart-recovery or interface-mismatch finding applies. No environment variable, credential, live endpoint, subprocess toolchain, native artifact or device is required."
baseline = "Attempt 1's recorded Cargo verify exited 101 because the platform manifest is a virtual workspace without the named test target; this pre-existing gate defect is corrected by the supplied attempt-2 ruling. Initial status and diff contained the seeded README, repair record, Node test and Rust test plus runner-owned bookkeeping, which was preserved. This attempt began with zero builds/verifies and no /out/run/gates.jsonl. No unchanged-tree baseline verification was run: the implementation-first and wrapper-only gate order supersedes that older clause, and no pre-change Python test failures are claimed."
build_cmd = "python3 -m py_compile tools/qualification/audit_repairs/test_repair_22_33_1318.py"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1318.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision_source = "The revision field in the final hf-done JSON and final verify entry in /out/run/gates.jsonl."
evidence = "The runner records exact revision, command, exit code and private log location; build and verify must pass on the same candidate revision. Finalize this record before the gates: embedding its own content-derived revision would change that revision. The final hf-done JSON names the verified revision and is copied into the final response. No pass is claimed before that result. The runner owns commit/publication."
wiring_requests = []

[finding.examples-authority-doc]
