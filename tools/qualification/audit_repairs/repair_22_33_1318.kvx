tests = ["test_examples_authority_doc_matches_per_application_profiles", "test_examples_authority_doc_matches_paid_offer_and_pinned_key_consumer", "test_examples_authority_doc_distinguishes_receipt_states", "test_examples_authority_doc_separates_beta_qualification_from_history", "test_examples_authority_doc_repair_record_maps_proofs_and_evidence"]

[format]
