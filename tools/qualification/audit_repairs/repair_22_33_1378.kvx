[evidence]
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1378.py"
gate_cmd = "cg spec done 22.33.1378 -f layerx-merge --root /work/paxeer-monorepo"
ledger = "/out/run/gates.jsonl"
verified_revision = "The last hf-done JSON and private /out/run/gates.jsonl name the exact verified revision, command, exit code and log. Build and verification must pass on the same candidate revision. This record is finalized before qualification because embedding its own content-derived revision would change that revision; evidence is retained externally by the runner."
publication = "Runner owns publication; no manual commit or push, and no edits after passing hf-done."

[gotcha.baseline_order]
observed = "Step 7 requests pre-change verification while the explicit order forbids tests until implementation is complete and permits verify only through hf-done."
resolution = "Follow explicit gate order and disclose the unexecuted baseline without claiming baseline failures."

[gotcha.scope]
observed = "Root .github/workflows and GOTCHA.kvx are outside scope, although inherited instructions request editing them."
resolution = "Record root workflow registration requests to owning domain 16 and gotchas here; preserve all out-of-scope files and runner setup changes."

[gotcha.read_budget]
observed = "Broad combined reads exceeded output budgets; a lookup of optional ownership files found no matching paths."
resolution = "Use exact task and audit blocks, gate implementation sections, current source files and feature.16 ownership in bounded reads; no missing optional file is treated as authority."

[format]
policy = "No Python, YAML or KVX formatter is configured for these paths; apply .editorconfig and pre-commit whitespace/final-newline conventions to the five touched files only, retaining YAML two-space indentation. yamllint is a linter and is outside the declared gates."
