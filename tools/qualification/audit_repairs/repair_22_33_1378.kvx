[repair]
task = "22.33.1378"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
implementation = "Repair only benchmark.yml, ci.yml and security.yml: use services/platform/perf-db for Cargo run steps, crate-prefixed change filters and Rust cache workspaces, a repository-relative coverage upload path and cargo-deny manifest input, and Rust 1.85 matching Cargo.toml for MSRV. Preserve existing jobs, command flags, branch selection, matrix, dispatch and schedule behavior. Repository-root registration belongs to domain 16 and is explicitly requested below, not claimed implemented."
baseline = "Pre-change verify was not run: the mandatory implementation-first order and exclusive hf-done gate supersede step 7 baseline verification. No tests are claimed to have failed before the change. Initial git status/diff showed only runner-prepared .cgignore and spec task-start changes; no task repair files existed. /out/run/gate.json showed zero build and verify runs, two repair cycles available, and /out/run/gates.jsonl did not exist. Those existing changes were preserved."
source_proof = "Four offline pytest tests parse the actual workflow YAML with BaseLoader (preserving the GitHub on key), crate manifest/lock and deny policy with tomllib, and Cargo run strings with shlex. They connect checkout to inherited run directory and actual crate targets, check all unchanged Cargo commands and job coverage, evaluate crate and workflow path filters including negative unrelated paths, compare MSRV to rust-version, connect llvm-cov output to the root-relative codecov input, and connect cargo-deny action manifest to the crate and deny policy. Audit fields and each finding-to-test mapping and domain-16 root wiring request are asserted."
review_only = "GitHub discovery, trigger delivery, third-party action execution, dependency resolution, Rust compilation, MSRV compatibility, benchmark results, vulnerability database checks and coverage uploads are not executed by this Python source gate. Actual automation remains dependent on the three out-of-scope root workflow registrations requested below; no full operational closure is claimed. These config-drift findings change neither runtime interfaces nor persistent state, so restart-recovery and interface-driving tests do not apply. No shell script or unit file is changed. The gate requires no environment variable, credential, endpoint, subprocess toolchain, external binary, native artifact or device."
scope = ["services/platform/perf-db/.github/workflows", "tools/qualification/audit_repairs/repair_22_33_1378.kvx", "tools/qualification/audit_repairs/test_repair_22_33_1378.py"]

[finding.perf-benchmark-workflow-location]
audit = "22.30.75"
file = "services/platform/perf-db/.github/workflows/benchmark.yml"
line = 3
class = "config-drift"
severity = "medium"
observed = "The benchmark workflow resides under services/platform/perf-db/.github/workflows, which GitHub does not discover. Its Cargo commands assume repository-root execution even though the crate manifest is nested; the declared automation does not qualify this crate."
expected = "The monorepo must actually run the advertised database benchmark checks from root-discovered workflows with the correct crate directory and path filters."
proposal = "Register the benchmark workflow under the repository-root .github/workflows and set services/platform/perf-db as its Cargo working directory; align manifest paths and filters."
owner_domain = 8
resolution = "In-scope workflow configuration repaired and proven by the named test; root-discovered workflow registration is requested from domain 16 below."
tests = ["test_perf_benchmark_workflow_location"]

[wiring.benchmark]
path = ".github/workflows/perf-db-benchmark.yml"
source = "services/platform/perf-db/.github/workflows/benchmark.yml"
owner_domain = 16
status = "requested; outside task scope"
request = ".github/workflows/perf-db-benchmark.yml -> domain 16 (tools-ops, coordinating with domain 8): register the corrected services/platform/perf-db/.github/workflows/benchmark.yml contents at this root-discovered path, retaining its crate working directory, scoped filters and action inputs; do not merely call a nested workflow, which GitHub cannot discover."

