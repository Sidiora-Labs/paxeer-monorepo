[repair]
task = "22.33.1337"
requirement = "22998.1"
input_revision = "6a96588c94c1a9ec5464168975c00cc2120b9922"
programme_base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
scope = ["tools/qualification/audit_repairs/repair_22_33_1337.kvx", "tools/qualification/audit_repairs/test_repair_22_33_1337.py"]
repair = "Consume the root README rewrite owned by task 22.31.470 under decision 2525, adding independent regression proofs for audit 22.30.72/readme-separate-daemon without modifying README.md. The overview, topology, operations, build and release guidance describe the embedded kernel in one chain-125 paxd BFT network and block-commit finality."
source_proof = "Six focused tests read the production README and check the embedded host and consensus source, root api1..api14 HTTPS JSON-RPC range and parsed curl JSON chain probe, EIP-1559 submission and send/forward paths, WAL acknowledgement before receipt publication, submitted/receipted/committed rungs and block coverage, committed receipt and state consumers, retired custody/checkpoint refusal gates and archive-only views, and parsed paxd build/start instructions against the actual Makefile and chain.mk. A seventh test parses this record and requires exact coverage by declared test functions."
review_only = "Go/C/Rust compilation, node startup, transaction execution, cryptographic verification, BFT consensus, WAL restart/recovery and endpoint availability are not executed by this documentation gate. Production source assertions establish the documented producer/transport/consumer connections, not runtime certification. No stateful component or public interface changes; no restart-recovery or interface-mismatch finding applies. No audited shell script, unit file or manifest requires repair. README shell snippets are tokenized in-process, not executed; no external binary, credential, environment variable, live endpoint, native artifact or device is needed."
baseline = "No pre-change verification was run: explicit implementation-first ordering and exclusive hf-done verification supersede the older unchanged-tree baseline clause. No baseline failures are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task bookkeeping, preserved unchanged; neither scoped task file existed. gate.json recorded zero builds/verifications, two repair cycles left and no gates.jsonl existed."
completed_wiring_request = "README.md; owner domain 8 (platform), task 22.31.470: replace separate-daemon/checkpoint architecture and build instructions with the integrated paxd chain-125 EIP-1559 and block-commit model; fulfilled by the prerequisite README rewrite, consumed unchanged here under decision 2525."
missing_fact_wiring_requests = []
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1337.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private /out/run/gates.jsonl identify the exact verified content-derived revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification; embedding its own candidate hash would change that hash. The runner retains the evidence and commits the result; no manual commit or push is performed."

[finding.readme-separate-daemon]
audit = "22.30.72"
path = "README.md"
original_line = 47
class = "doc-drift"
severity = "medium"
owner_domain = 8
expected = "One BFT paxd network with integrated kernel, chain ID 125, EIP-1559 operations and finality at block commit; root api1..api14 JSON-RPC, transaction and committed receipt flows, retired custody/checkpoint executors and no separate layerxd or checkpoint deployment."
tests = ["test_readme_describes_one_bft_paxd_with_embedded_kernel", "test_root_json_rpc_range_and_chain_125_probe", "test_eip1559_submission_follows_production_send_and_receipt_path", "test_finality_requires_committed_block_and_receipt_consumer", "test_custody_and_checkpoint_executors_are_retired", "test_build_and_release_guidance_uses_integrated_paxd"]

[gotcha.baseline_order]
observed = "The generic unchanged-tree baseline clause conflicts with the explicit implementation-first and wrapper-only gate sequence."
resolution = "Follow the explicit order and claim no unrun baseline result; keep this note in the in-scope repair record because GOTCHA.kvx and spec files cannot be changed."

[gotcha.markdown_code_fences]
revision = "0e02af1bdbba16c73bd0ebbed452c2340ee7532c"
command = "cg spec done 22.33.1337 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Six tests passed; the chain-probe test failed because the section reader treated the fenced curl example's expected-result comment as a Markdown heading."
resolution = "Repair the section reader to track Markdown code fences and retain shell comments inside them; preserve every assertion and rerun hf-build followed by hf-done on the repaired candidate."

[format]
policy = "No Python or KVX formatter is configured for these paths. After complete implementation, apply the repository .editorconfig UTF-8, LF, final-newline and trailing-whitespace rules to these two files only."
