[gotcha.baseline_order]
observed = "The unchanged-tree baseline step contradicts the explicit implementation-first, hf-build-then-hf-done, wrapper-only Order."
resolution = "Follow the explicit Order and claim no baseline execution; GOTCHA.kvx and spec files are outside this task's permitted paths."

[gotcha.stale_graph]
observed = "cg brief/survey reports unrelated graph paths and an unrelated next task, while Git shows only runner-prepared bookkeeping before implementation."
resolution = "Use the assigned task block, Git diff and private gate ledger; preserve runner-prepared .cgignore and spec status edits."

[gotcha.applied_cli_shape]
observed = "The production upgrade applied CLI prints the first BlockMeta rather than the AppliedPlan gRPC response."
resolution = "Read its header.height and assert the production MarshalJSONIndent(headers.BlockMetas[0]) producer in the offline test."
