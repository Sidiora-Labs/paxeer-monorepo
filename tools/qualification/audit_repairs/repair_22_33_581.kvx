tests = ["test_readme_one_paxd_network_with_embedded_kernel_and_block_finality", "test_readme_chain_125_probe_and_api1_through_api14_use_root_json_rpc", "test_readme_transaction_receipt_path_matches_producer_transport_consumer", "test_readme_custody_and_checkpoint_executors_are_retired_refusal_surfaces", "test_readme_build_and_upgrade_guidance_use_merged_paxd", "test_readme_native_perps_and_historical_exchange_are_distinguished", "test_repair_record_maps_finding_to_checks_and_private_revision_evidence"]

