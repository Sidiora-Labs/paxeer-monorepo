evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl bind this repair record to the exact verified content-derived revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification; embedding the candidate revision into its own content would change that revision. The runner retains the private evidence and publishes the candidate; no manual commit or push."
