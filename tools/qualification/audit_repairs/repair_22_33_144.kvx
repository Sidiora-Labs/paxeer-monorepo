[task.22.33.144]
source_revision = "508d5f0e0d9c0fc123760c30cfc8bb872a00cda1"
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
repair = "Decision 2525 assigns README.md to task 22.31.470. Preserve that completed prerequisite and add eight focused offline checks for audit 22.30.115 finding readme-english: one integrated chain-125 paxd BFT network, root node RPC, separate hosted gateway contracts, submission and committed receipt flows, current precompile inventory, historical retirement and operator builds. No README or production file is modified."
source_proof = "The module asserts README source facts against real production files: node cgo host and consensus wiring; root HTTP path dispatch; parsed curl arguments and JSON chain probe; parsed gateway OpenRPC methods and node registrations; raw transaction acceptance/forwarding, WAL release before publication, receipt rungs and committed batch coverage; signing and proof consumers; parsed MergeAddressTable compared with all thirteen README rows; custody/verify refusal and anchor upgrade guards; Makefile dependencies, node binary build and linked source paths. This is producer/transport/consumer source coverage for documentation drift."
review_only = "Native Go/C/Rust builds, node startup, shell command execution, transactions, cryptographic verification, WAL restart/recovery, public endpoint availability and BFT consensus are not executed. These require runtime qualification or operator review, not this documentation gate. No interface or stateful component is changed and no runtime recovery proof is claimed. No shell script, unit file or manifest is modified; no bash or subprocess toolchain is required by the pytest module. The gate needs no environment variable, credential, live endpoint, external binary, native artifact or device."
baseline = "No pre-change verification was run: the explicit implementation-first order, hf-build before hf-done and ban on manually running verify_cmd supersede step 5's baseline clause. No baseline failures are claimed. Initial status/diff contained only existing runner-prepared .cgignore and feature spec bookkeeping; both scoped files were absent. The private gate configuration recorded zero builds and verifies with two repair cycles available; gates.jsonl was absent. README already contained the expected corrections from 22.31.470."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_144.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the exact verified content-derived candidate revision, command, exit code and log path for acceptance 22998.1. Build and verification must pass on the same candidate revision. This record is finalized before qualification; embedding its own candidate hash would change the hash. The runner retains that evidence and commits the result. No manual commit or push is performed."
