[gotcha.baseline_order]
observed = "The inherited pre-change verification clause conflicts with the explicit implementation-first, wrapper-only gate order."
resolution = "Follow the explicit Order and claim no baseline execution; retain this note in the scoped record because GOTCHA.kvx and spec files are outside scope."

[gotcha.context_reads]
observed = "Combined broad context reads exceeded output limits, and guessed precompile tx.go paths do not exist."
resolution = "Read bounded finding and task sections and actual precompile implementation paths; do not treat truncated broad output or guessed paths as evidence."

[format]
