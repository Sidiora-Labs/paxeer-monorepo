observed = "The audit described two execution domains, a separately running layerxd, current layerxAnchor checkpoint settlement, and daemon build and separate settlement examples."
expected = "One chain with the kernel inside paxd, EVM chain ID 125 and finality at block commit; the separate daemon and active checkpoint settlement path are retired after the merge."
tests = ["test_readme_network_one_network_embeds_kernel_and_commits_blocks", "test_readme_network_root_rpc_hosts_and_chain_probe", "test_readme_network_hosted_and_node_method_contracts", "test_readme_network_transaction_to_committed_receipt_path", "test_readme_network_custody_and_checkpoint_executors_are_retired", "test_readme_network_maintained_paxd_build_and_launch", "test_readme_network_supported_native_views", "test_readme_network_record_maps_finding_proofs_and_limits"]

[wiring.readme_network]
