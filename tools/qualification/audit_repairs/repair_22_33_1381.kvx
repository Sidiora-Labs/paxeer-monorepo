owner_domain = 8
request = "services/platform/examples/test/merchant-app.test.mjs -> domain 8: extend the shared production merchant checkout receipt-read test to select the configured beta profile, rebase only its origin to a loopback peer, reject /rpc, produce a native chain-125 transaction and signed receipt with the committed conformance producer, and assert eth_getRawTransactionByHash then pax_sequencerReceipt at the root and the verified consumer result; execute under the owning Node gate."
status = "requested; not executed by this gate"

