verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_815.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The final hf-done JSON and matching private ledger row name the exact content-derived candidate revision, command, exit and log. Build and verification must pass on that same revision. This record is finalized before qualification to avoid a self-referential revision edit."
evidence_policy = "No manual commit or push; the runner retains private gate logs and publishes the candidate."
format = "No Python or KVX formatter is configured for these paths; apply .editorconfig UTF-8, LF, final newline and no trailing whitespace; JSON uses two-space indentation."

