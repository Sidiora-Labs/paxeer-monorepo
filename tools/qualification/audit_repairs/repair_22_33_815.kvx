[gotcha.1]
observed = "The baseline verify request contradicts the explicit implementation-first order and bounded hf-done-only gate."
resolution = "Run no manual or pre-change verify; report that limitation without inventing baseline failures."

[gotcha.2]
observed = "Broad combined context output was truncated, the graph excluded SDK Go paths, and an inspection script initially expected a migrations key instead of registrations."
resolution = "Read bounded source sections directly after graph lookup and use the actual registrations schema. Record notes here because GOTCHA.kvx and spec files are outside scope."

[gotcha.3]
observed = "The audited registry had 75 migrations; the current base has 76, with 15 absent retired handoff inputs and 25 changed source-input digests."
resolution = "Qualify the full current inventory, preserve original SQL/provenance hashes, and enumerate missing or drifted inputs as owner wiring requests while withdrawing approval."

