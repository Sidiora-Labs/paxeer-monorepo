tests = ["test_legacy_source_checksums_and_import_refusal_contract", "test_legacy_evidence_survives_manifest_close_and_reopen"]
repair = "Relocate all legacy source paths to their real monorepo owners while preserving exact source/up checksums, original per-service versions, byte counts and null structural fingerprints. Retain the independently approved structural import requirement and mark the manifest implemented-not-qualified."
closure_boundary = "Import remains refused through LegacyMigrationAlias.Key while any structural fingerprint is absent; runtime import/restart proof and reviewed source-schema collection remain owner obligations, not a claimed passing runtime gate."

[finding.readiness-registry-digest]
tests = ["test_readiness_revokes_stale_binding_until_qualification", "test_readiness_roles_and_real_expected_schema_consumer"]
repair = "Withdraw the stale registry_sha256 rather than re-sign an unqualified registry. Preserve absent catalog/reader/recovery evidence and trusted read-only ExpectedSchema requirements."
closure_boundary = "Stale binding removed; reissue requires measured evidence for the complete registry and deployment. No new trusted ExpectedSchema is produced by this task."

[finding.migration-admission-unqualified]
tests = ["test_unqualified_registry_has_no_approval_authority", "test_real_coordinator_checks_admission_before_ddl"]
repair = "Withdraw approval_digest so MigrationRegistry.ValidateOrder refuses the unqualified registry before execution. Preserve every absent measured field and extension version; withdraw migration 180001 admission fields tied to the prior registry approval while retaining its proposed values in pnl-reward-approval.json and this record; enumerate the missing review and execution gates."
closure_boundary = "Production admission remains refused. Actual deployment measurements and independent approval are not fabricated or claimed."

[finding.migration-paths]
