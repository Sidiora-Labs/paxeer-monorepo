[task.22.33.1281]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
repair = "Decision 2525 delegates root README edits to task 22.31.470. Preserve its existing integrated paxd network description and qualify finding readme-separated-network with focused regression assertions. README.md is read only in this task; all expected facts are present, so no additional wiring request is needed."
source_proof = "The pytest module asserts README source facts for one BFT network, the embedded block-proposing kernel, chain 125, api1 through api14 root HTTPS JSON-RPC hosts, signed transaction submission, durable execution receipts, committed-block finality, retired custody/checkpoint executors and paxd startup. It parses the documented curl arguments and JSON payload without executing commands, checks diagram order, and traces production source wiring from RPC submission to sequencer acceptance and durable release, then RPC committed coverage and the proof consumers. Retirement checks inspect the actual refusal gates."
review_only = "Native Go/C/Rust execution, real transactions, signature verification, BFT commitment and live endpoint availability are not executed by this documentation gate. Producer, transport and consumer assertions prove source wiring only. No interface or restart-recovery behavior is changed and no runtime interface or recovery qualification is claimed. No shell script, unit, manifest or build file is repaired. The test needs no environment variable, credential, live endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit order requires complete implementation before formatting/build/testing and hf-build before hf-done, and forbids manually running verify_cmd. No baseline failing tests are claimed. The initial private gate ledger did not exist and gate configuration showed zero builds and verify runs. The initial git diff contained only runner-prepared .cgignore and spec task-status bookkeeping; neither scoped file existed, and the README already contained the required facts from 22.31.470."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1281.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the exact verified content-derived candidate revision, command, exit code and log path. hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification; embedding its own content-derived revision would change that revision. The runner retains the exact evidence and commits the result. No source edit follows a passing hf-done."
wiring_requests = []

[finding.readme-separated-network]
