expected = "The merged network runs paxd with the kernel proposing BFT blocks; a committed receipt is final and there is no separate sequencer daemon or checkpoint-settlement service."
tests = ["test_readme_integrates_kernel_and_block_proposal_inside_paxd", "test_readme_public_rpc_uses_chain_125_and_numbered_root_hosts", "test_readme_transaction_receipt_flow_matches_producer_transport_consumer", "test_readme_finality_requires_authenticated_committed_block", "test_readme_retires_custody_checkpoint_executors_and_separate_startup", "test_readme_diagrams_keep_execution_and_finality_in_one_network", "test_repair_record_maps_readme_finding_to_all_proofs_and_limits"]

[gotcha.1]
observed = "The baseline verification clause conflicts with the explicit implementation-first bounded gate order."
resolution = "Follow the explicit order, record no measured baseline failures and run verification only through hf-done after hf-build."

[gotcha.2]
observed = "Root README changes and central gotcha/spec ledger changes are outside this task's scope."
resolution = "Keep the inherited README repair and runner bookkeeping intact; record task notes here and route any missing README fact to domain 17 task 22.31.470. No missing fact was observed."

[gotcha.3]
