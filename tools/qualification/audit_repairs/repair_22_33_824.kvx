[task.22.33.824]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
start_revision = "bd09b6fa16afd5f9f92bef280322d1be0dc3a5c2"
repair = "Decision 2525 assigns the README rewrite to 22.31.470 in domain 17. Preserve README.md exactly as supplied and add independent source assertions for audit 22.30.179/doc-readme: one integrated paxd BFT network, chain 125, root api1..api14 JSON-RPC, tenant namespaces, mirror distinction, transaction and committed receipt flows, retired custody/checkpoint executors, current build and activation, and historical-only settlement formats. All requested facts are present; no missing-fact wiring request is needed."
source_proof = "Seven offline pytest tests read the actual README and production files. They check integrated host/consensus and topology wiring, parse the documented curl arguments and JSON payload without executing it, validate root URLs, trace transaction acceptance/forwarding through WAL-backed receipt publication and committed RPC coverage, inspect signed receipt and authenticated proof consumers, check executor refusal gates, check native build prerequisites and activation names, resolve README repository links, and validate this finding-to-test mapping."
review_only = "Native Go/C/Rust execution, builds, node startup, endpoint availability, transaction execution, cryptographic verification, WAL restart/recovery and BFT consensus are not executed by this documentation gate. Producer/transport/consumer relationships are source assertions, not runtime certification. No interface or stateful production component changes, so no restart or interface execution proof is claimed. No shell script, unit or manifest is changed; shell examples and build rules are inspected in-process without bash, make or another subprocess toolchain. Editorial completeness and operational suitability require review."
baseline = "No pre-change verification was run: the explicit task order requires complete implementation, formatting, hf-build, then hf-done and prohibits a manual verify_cmd run. Thus no baseline test failure is claimed despite the older baseline clause in step 5. Initial scoped files were absent; git status/diff contained only runner-prepared .cgignore and spec task status changes. The private gate configuration reported zero builds, zero verifies, zero repairs used and no gates.jsonl existed. README already contained the owning task's rewrite."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_824.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private /out/run/gates.jsonl record the exact verified content-derived candidate revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification; embedding its own candidate hash would change that hash. The runner retains evidence and publishes the task; no manual commit or push is performed and no source edit follows a passing hf-done."
wiring_requests = []

