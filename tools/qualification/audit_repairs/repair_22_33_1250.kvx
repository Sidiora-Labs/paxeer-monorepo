[task.22.33.1250]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
inspected_revision = "0fc2ddbe29baad8cb85e22d8b9492d748c989f42"
readme_owner_task = "22.31.470"
repair = "Consume the README correction delivered by documentation owner 22.31.470 under decision 2525, preserving README.md unchanged. Prove one paxd BFT network, embedded block-proposing kernel, chain 125, api1 through api14 root JSON-RPC, signed transaction submission and committed receipt flow, paxd build/start guidance, and retired custody/checkpoint refusal compatibility surfaces. No expected README fact is missing on inspection."
source_proof = "The six offline pytest tests read the actual README and production sources. They check runtime and finality prose against node host and consensus wiring; parse the curl example with shlex and JSON and validate root host URLs against node root dispatch; trace transaction acceptance/forwarding, durable release before receipt publication, receipt rungs and committed coverage; check retirement and historical-read upgrade guards; parse Makefile target dependencies and documented build/start arguments against the node binary target; and validate this finding-to-test mapping."
review_only = "These are source assertions for documentation drift, not execution of Go/C/Rust components, node startup, transaction execution, WAL recovery, retirement reverts, live RPC availability or BFT consensus. No interface or restart-recovery finding is repaired here. README contains shell examples but no shell script, unit, manifest or build file is changed; examples are parsed in process without bash or another external binary. The gate needs only Python/pytest and committed repository text, without credentials, environment variables, endpoints, native artifacts or devices."
baseline = "No earlier scoped changes or gate ledger existed; gate.json recorded zero builds and verifies. Git status/diff showed only runner-prepared .cgignore and feature-spec bookkeeping. The ordered implementation-first and exclusive hf-done rules prohibit the older step 5 request for a manual unchanged-tree verification; no baseline was executed and no baseline failure is claimed. README already contains the owning task's correction."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1250.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private /out/run/gates.jsonl provide the exact verified candidate revision, command, exit code and log path. Build and verify must pass on that same revision. Finalize this record before gates: placing a content-derived candidate hash inside its own source would change it. The runner retains qualification evidence and commits; no manual commit or push is performed."
wiring_requests = []

