source_proof = "The pytest module parses production Makefile target prerequisites and logical recipes, Cargo profile and release JSON keys, compares the README precompile table to the actual constructor inventory, parses the release shell script with bash -n, and checks fail-fast guards, optimized-byte size/deployment/manifest order, chain-domain binding, retained admission assertions, artifact names, checksum commands, verification and forward recovery documentation. The real Rust manifest consumer and C deployment producer are read directly, not replaced with fixtures."
review_only = "Make, native C/Go/Rust builds, Binaryen optimization, native admission execution, guest deployment and the 106-byte upgrade envelope, runtime restart/recovery, node consensus, release reproducibility, publication and operational rollback are not executed by this offline source gate. The recipe now invokes the real native harness to deploy and upgrade the optimized bytes before publishing the manifest; execution of that production recipe and native refusal assertions requires the owning native qualification environment. These config/documentation/retirement changes introduce no runtime wire format or restart-recovery implementation. Bash is used only for the required syntax parse."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_788.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "Use the exact content-derived candidate revision, command, exit and private log in the final hf-done entry of /out/run/gates.jsonl; it must match hf-build. Embedding the candidate's own hash in this file would change the candidate."
evidence_policy = "Finalize scoped sources and this record before hf-build and hf-done; claim qualification only on their recorded matching candidate and passing result. The runner commits and publishes; this task does neither."
wiring_requests = ["spec/layerx-merge/interfaces.kvx — domain 16 (tools/operations), with domain 5 for historical archive producers: remove interface.16.mk-layerx-archive-codec and interface.16.mk-builddir-bin-layerx-archive-codec, refresh the two retained native test signatures, and route any retained archive consumer to the current paxd-backed committed-history producer rather than restoring the deleted daemon/codec.", ".github/workflows/paxeer-release-check.yml and .github/workflows/paxeer-release-publish.yml — domain 16 (release tooling): remove PAXD_RELEASE_LAYERXD from the release environment; the builder explicitly refuses the stale opt-in before toolchains or output replacement.", "tools/release/tests/build.test.sh — domain 16 (release tooling): replace the stale PAXD_RELEASE_LAYERXD=1 caller and expected layerxd asset with the merged artifact inventory and assert explicit rejection of the retired option.", "tests/programs/test_blob_admission.c, tests/programs/test_paxai_native_gaps.c, tests/programs/test_ai_host_boundary.c and programs/crates/layerx-programs-ai-market/tests/host_boundary.rs — owning native Programs/kernel domain: qualify the already retained-kernel consumers and each admission refusal with the corrected Makefile linkage and final optimized artifact; preserve the configured chain-domain assertion and both deployment and upgrade checks."]
