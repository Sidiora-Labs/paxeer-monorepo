owner_domain = 16
resolution = "Invalidate any old manifest; require wasm-opt; keep the configurable canonical chain domain and its validation; override the guest release profile to opt-level z; apply wasm-opt -Oz --strip-debug --strip-producers; reject final bytes above 524184 (524288 minus the 104-byte deployment envelope); run the real native deployment/upgrade harness on those same bytes before publishing their absolute path and unchanged chain binding. Any failing line stops Make before the manifest is written."
tests = ["test_finding_7_guest_size_profile_and_required_binaryen_pass", "test_finding_7_final_bytes_are_bounded_deployed_and_then_published"]

