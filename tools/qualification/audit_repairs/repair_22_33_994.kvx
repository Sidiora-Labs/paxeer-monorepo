repair = "Consume the root README rewrite supplied by 22.31.470 under decision 2525. Add independent regression checks for audit 22.30.32/readme_network: the integrated chain-125 paxd BFT network, embedded block-proposing kernel, root JSON-RPC hosts, transaction and committed receipt flow, retired custody/checkpoint executors, and merged-node build/start commands. README.md is outside this task's scope and is unchanged."
source_proof = "The pytest module reads the actual README, checks its prose and diagrams, parses the documented curl arguments and JSON payload without executing them, validates public URL roots and the api1..api14 range, traces source facts through node host/consensus wiring, root HTTP dispatch, transaction acceptance/forwarding, durable receipt release and committed-block coverage, checks production retirement guards, and parses the declared paxd Makefile dependencies and recipe. It rejects the audited separate-daemon/draft instructions and maps readme_network to five executed source-proof tests."
review_only = "Native Go/C/Rust builds, shell example execution, endpoint reachability, node startup, transaction execution, signatures, BFT consensus and restart/recovery are not executed by this documentation gate. Producer, transport and consumer connections are source assertions, not runtime or deployment certification. No interface or stateful component is changed; no runtime restart or interface behavior is claimed. No shell script, unit file or manifest is changed, so bash -n and deployment-tool gates do not apply. The tests require only Python/pytest and committed source files, with no credential, environment variable, endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "Initial git status/diff showed only runner-prepared .cgignore and spec task status changes, with no scoped implementation present. The gate configuration recorded zero builds and verifies and two repair cycles available; /out/run/gates.jsonl was absent. No pre-change verification was run: the explicit implementation-first order and exclusive hf-done gate supersede step 5's baseline request. No baseline failures are claimed. README already states all requested facts from 22.31.470."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_994.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private /out/run/gates.jsonl record the exact verified content-derived revision, command, exit code and log path; hf-build and hf-done must pass on the same candidate revision. Finalize this record before qualification: embedding the content-derived revision in its own source would change it. The runner retains qualification evidence and publishes the task."
