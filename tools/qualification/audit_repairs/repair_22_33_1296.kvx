readme_owner_task = "22.31.470"
repair = "Decision 2525 assigns the root README rewrite to 22.31.470, which already supplied the expected architecture at the inspected revision. Preserve README.md unchanged and qualify readme-architecture-drift with eight focused regression checks. Only this record and test_repair_22_33_1296.py are created; no production code, translation or spec is changed."
source_proof = "The module proves README source facts: one chain-125 paxd BFT network and embedded kernel, integrated proposal and commit finality, the api1..api14 HTTPS root JSON-RPC range, the parsed chainId curl request, transaction submission and committed receipt flow, matching topology/sequence diagrams, live precompile inventory, explicit historical custody/checkpoint refusal surfaces, linked paxd build/run commands, maintained architecture source and existing local source links. It reads production host/consensus wiring, root URL dispatch, transaction acceptance/forwarding, WAL acknowledgement before receipt publication, verified receipt rungs and committed coverage, precompile registry and retirement gates. Makefile and chain.mk target dependencies and recipes are parsed without invoking them. The test parses actual documented shell arguments and JSON rather than sending requests."
review_only = "Native Go/C/Rust builds, paxd startup, transaction execution, cryptographic verification, live endpoint availability, consensus commitment and WAL restart/recovery are not executed by this documentation gate. Producer, transport and consumer connections are source assertions, not runtime certification. The finding changes no production interface or persistent component, so no interface-mismatch or restart-recovery proof is claimed. No shell script, unit file or manifest is under repair; no external binary, subprocess toolchain, environment variable, credential, live endpoint, native artifact or device is required by the pytest module. Translation quality and operator deployment remain review concerns."
baseline = "No pre-change verification was run: the explicit implementation-first order requires hf-build followed by hf-done and forbids running verify_cmd by hand, superseding the older baseline clause in step 5. No baseline test failures are claimed. The two scoped files were absent initially, gate.json recorded zero builds and zero verifies, and /out/run/gates.jsonl did not exist. Initial status/diff contained only runner-prepared .cgignore and spec/layerx-merge/spec.kvx bookkeeping, preserved unchanged by this task. README already contained the 22.31.470 rewrite."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1296.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl name the exact verified content-derived candidate revision, command, exit code and private log path. hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification; inserting the candidate hash into its own content would change that hash. The final response copies the gate evidence, and the runner records and publishes the candidate; no manual commit or push is performed."
missing_readme_facts = []
wiring_requests = ["docs/readme/README.pt-BR.md, docs/readme/README.fr.md, docs/readme/README.ja.md, docs/readme/README.ru.md, docs/readme/README.zh-CN.md, docs/readme/README.de.md — domain 5 localized documentation owners: align translated architecture, features, build commands and endpoint examples with README.md maintained by 22.31.470 and link that maintained architecture source; translation edits are outside 22.33.1296."]

