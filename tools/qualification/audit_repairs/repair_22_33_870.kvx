[gotcha.scope_and_order]
observed = "The older step asks for baseline verification and the workflow asks for global ledger edits/publication, but the explicit task order forbids an early verify, out-of-scope edits, manual commits and pushes."
resolution = "Record the baseline limitation and gotchas here, retain runner-prepared changes, use only hf-build/hf-done and leave publication to the runner."

[gotcha.context]
observed = "Combined broad context reads exceeded output limits, and cg brief reported graph paths that differ from git status because graph auto-sync is disabled."
resolution = "Use bounded exact finding/source reads and git status/diff as working-tree evidence; do not infer gate success or source facts from truncated graph context."
