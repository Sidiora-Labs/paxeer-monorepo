[gotchas]
scope = "GOTCHA.kvx and spec files are out of scope; observations are recorded here. Runner setup remains intact."
wallet_install = "The workflow now has two identical pnpm install commands in different directories; command-only indexing selects the services/wallet workspace install before the apps/wallet install."
receipt_reference = "The daemon owner hashes the unsigned canonical encoding while the legacy TypeScript consumer fixture still uses a tagged signed-byte reference; preserve its explicit recorded adaptation and do not claim their runtime integration is qualified."
paths = "Use NUL-delimited Git inventories so Unicode recording paths remain literal."
bank_constructor = "The first hf-done at b72089bdfeb8aa6b7127ff59a811b33dcd0f6952 exited 1 (/out/logs/verify-1.log): 260 cases passed and the bank result pin still expected a constructor call removed by 22.39.240; re-pin the exact direct result object and rebuild before the final hf-done."
