observed = "The audited introduction described a separate layerxd daemon, checkpoint settlement and make layerxd; those instructions are absent from the README supplied by 22.31.470."
expected = "One paxd BFT network with the kernel proposing committed blocks, EVM chain 125, root api1..api14 JSON-RPC hosts, transaction and committed receipt flows, retired custody/checkpoint executors, and merged build/operations entry points in the supported layout."
tests = ["test_doc_root_merged_network_and_embedded_proposer", "test_doc_root_public_rpc_hosts_and_chain_probe", "test_doc_root_transaction_transport_and_committed_receipt", "test_doc_root_custody_and_checkpoint_executors_are_retired", "test_doc_root_build_operations_and_supported_layout"]
source_proof = "The pytest module reads README.md directly; checks embedded paxd execution and BFT topology, chain 125 and root hosts; parses the documented curl argv and JSON-RPC request; checks ordered signing, broadcast, durable receipt and committed-state consumer guidance and diagrams; asserts authenticated commitment and retired executor semantics; parses build/start argv and resolves the documented source layout. A sixth test parses this record and the original audit and requires every mapped proving test to be declared."
review_only = "These are documentation source assertions, not runtime certification. Native compilation, node startup, transaction execution, WAL restart/recovery, BFT consensus, signature/proof validation and endpoint availability are not exercised. No shell script, unit file, manifest or build file is repaired; shell examples are parsed in-process rather than executed. No credentials, environment variables, network calls, external binaries, subprocess toolchains, native artifacts or devices are required by the module."
wiring = "README.md | owning domain 17 | task 22.31.470: rewrite architecture, build and operations for merged paxd and committed-block finality, removing separate kernel/checkpoint deployment guidance; already supplied at the reviewed revision, with the expected facts asserted here and no missing fact identified during source review."

[baseline]
working_tree = "Initial git status and diff showed only pre-existing .cgignore and spec task bookkeeping; both scoped files were absent. No prior /out/run/gates.jsonl existed and gate.json recorded zero builds and verifies. These inherited changes are preserved."
verification = "No pre-change verify was run and no pre-change test failures are claimed. The explicit implementation-first order and exclusive hf-done gate prohibit the older task step requesting a separate unchanged-tree verify; the new module checks the README unchanged from the reviewed revision during the sole authorized verification."

[qualification]
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1555.py"
done_cmd = "cg spec done 22.33.1555 -f layerx-merge --root /work/paxeer-monorepo"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The last hf-done evidence row in the private ledger names the exact content-derived verified candidate revision, command, exit code and log path; the final response copies that row verbatim. This record is finalized before qualification because embedding its own candidate hash would change that hash. Build and verification must refer to the same candidate revision."
publication = "The runner retains private gate logs and publishes the task; no manual commit or push. A passing build alone is not qualification and no passing verification is claimed in advance."
format = "No Python or KVX formatter is configured for these paths; after the complete implementation apply .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions to these two files only."

