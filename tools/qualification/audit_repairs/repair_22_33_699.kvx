[repair]
task = "22.33.699"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
acceptance = "22998.1"
source_proof = "Parse the real workflow YAML, Dockerfile directives, shared registry JSON and production shell syntax with bash -n; assert native prerequisites, digest checks, all existing node targets, image references and build arguments, publisher/consumer registry wiring, token owner guard, dry-run defaults, Slack masking before upload and nonsecret logging, embedded release artifacts and checksum publication transport. Execute the production GHCR producer/retention helpers over a loopback HTTP server with committed response documents, compare dry-run candidates to deletion paths and reject unproven runs before any delete. Execute the production checksum parser and evidence writer against canonical records, malformed/missing/duplicate records and mismatching download metadata; invalid input cannot create evidence."
review_only = "Docker/Go/C/Rust builds, native linking and version execution, real ECR/GHCR publication and retention, remote token grants, Slack delivery, proxy installs and checksum-database availability are not executed by this offline gate. Image qualification proves source contracts: tag identities, regular/mock arguments, paxd entrypoint, native archive linkage and verified Wasm runtime libraries; it does not certify built container bytes or remote deployment. No restart-recovery finding applies. The owner mismatch is driven through the production image producer, HTTP registry transport and retention consumer; no external credential, environment configuration, live endpoint, subprocess toolchain, native artifact or device is required. Bash is used only as the explicitly required syntax parser, never to run build or workflow commands."
baseline = "Initial git status/diff contained only runner-prepared .cgignore and task in_progress bookkeeping; preserved unchanged. Both scoped repair files were absent. gate.json reported zero builds and verify runs and no /out/run/gates.jsonl existed. The unchanged-tree verification clause conflicts with the explicit implementation-first and hf-done-only order, so no pre-change verification was run. No baseline failures are claimed."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_699.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private gate ledger supply exact revision, command, exit code and log path. Build and verify must pass on the same candidate revision. This record precedes qualification: embedding its own content-derived candidate revision would change that revision. The runner retains private evidence and commits the qualified candidate."
wiring_requests = ["domain 16, tools/release/tests/build.test.sh, tools/release/tests/reproducible.test.sh and tools/release/tests/verify-release.test.sh: remove retired PAXD_RELEASE_LAYERXD inputs and the standalone layerxd inventory entries; keep complete paxd/native-library, sidecar, Wasm and upgrade-info checksum assertions.", "domain 16, spec/layerx-merge/interfaces.kvx and spec/layerx-merge/contracts/operations.md: refresh the release environment inventory to retire PAXD_RELEASE_LAYERXD and describe the shared integration registry configuration and validated retention plan; preserve the frozen inventory's historical revision labels."]

[release_inventory]
linux_amd64 = ["SHA256SUMS", "paxd-<version>-linux-amd64", "price-sidecar-<version>-linux-amd64", "libwasmvm.x86_64.so", "libwasmvm152.x86_64.so", "libwasmvm155.x86_64.so", "native-libs.sha256", "upgrade-info.json"]
embedded_archives = ["build/liblayerx.a", "programs/target/release/liblayerx_programs_sandbox.a"]
verification = "Build and verify the native-libs.sha256 manifest, stamp the combined archive digest into paxd, check paxd version JSON reports that digest, verify pinned Wasm copies and final SHA256SUMS, retain the native manifest and all assets through the existing reproducibility and publish paths. Static archives remain embedded in paxd; the native manifest records their exact bytes."

