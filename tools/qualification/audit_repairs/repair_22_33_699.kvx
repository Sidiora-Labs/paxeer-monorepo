resolution = "Follow the explicit order and claim no baseline result; GOTCHA.kvx and spec files are outside scope."

[gotcha.scope_inventory]
observed = "Existing release test inventories still request and expect a separate layerxd artifact, but those files are outside scope."
resolution = "Record the exact domain 16 wiring request instead of changing or running those tests."

[gotcha.context_output]
observed = "Combined repository context reads exceeded tool output limits."
resolution = "Read task and finding sections and directly affected sources in bounded outputs; use the private gate ledger for qualification evidence."

