[task.22.33.97]
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
repair = "Add three current eip155:125 MCP offers without extra.layerx, using unchanged committed signed payer bytes and matching amount, asset, payee and payment reference; retain all eight original envelope cases and explicitly classify semantic refusals and unproven settlement."
source_proof = "Seven offline pytest tests parse the actual MCP JSON, preserve every original role document and accepted flag by digest, compare current offers and both transaction fields with the committed Go-produced sequencer case, decode its RLP/ABI facts, bind them to recorded receipt topics/data/hash and observation time, assert production validator, codec, mounted route, service and relay source connections, and execute the real Python deployment renderer to prove it derives the exact changed suite count and digest."
review_only = "Python does not execute Rust PaymentRequirements::validate, codecs, mounted ingress, signature recovery, sequencer signature verification or settlement. RLP/ABI parsing inspects recorded facts and does not replace production semantic validation. Signed transaction and receipt bytes remain unchanged; no test double, subprocess, toolchain, live endpoint, credential, environment variable, native artifact or device is used. There is no restart-recovery or interface implementation change in this fixture-only repair."
runtime_closure = "pending owning-domain wiring"
baseline = "Initial git status/diff showed only runner changes to .cgignore and spec/layerx-merge/spec.kvx, no scoped implementation, gate.json counters at zero and no gates.jsonl. No unchanged-tree verify ran and no baseline test failure is claimed: the explicit implementation-first order and exclusive hf-done gate supersede the contradictory older pre-change verification step."
pre_existing = "Source review finds unconditional layerx_terms in Seller::new and FacilitatorRequest::validate, which reject the corrected profile-free offers with ProfileMissing; the existing transports.rs harness also conflates envelope acceptance with validated binding acceptance. No unrelated runtime gate was run or failure chased."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_97.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private ledger name the exact verified candidate revision, command, exit and log location; hf-build and hf-done must name the same candidate. This record is finalized before qualification because embedding its own content-derived revision would change that revision. The runner retains the evidence and commits; this task does not commit or push."

