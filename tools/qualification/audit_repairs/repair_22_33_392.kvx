[repair]
task = "22.33.392"
mode = "BUILD"
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
acceptance = "22998.1"
decision = "2525"
scope = ["tools/qualification/audit_repairs/repair_22_33_392.kvx", "tools/qualification/audit_repairs/test_repair_22_33_392.py"]
implementation = "Consume the production README supplied by owner task 22.31.470; add independent offline regression checks for the audit finding without changing README.md."

[finding.root-readme-standalone-kernel]
audit = "22.30.141"
file = "README.md"
original_line = 47
class = "doc-drift"
severity = "medium"
observed = "The audit revision described a separate layerxd daemon built from cmd/layerxd, checkpoint settlement through layerxAnchor and make layerxd."
expected = "One BFT network embeds the kernel in paxd, proposes and commits final blocks, and builds the current merged node without a standalone daemon or separate settlement lifecycle."
resolution = "The inherited README documents the merged node, committed finality, current paxd build/start commands, chain 125 root JSON-RPC and transaction/receipt flows, and retired custody/checkpoint refusal surfaces."
tests = ["test_root_readme_integrates_kernel_and_committed_finality", "test_root_readme_root_rpc_hosts_and_chain_probe", "test_root_readme_transaction_to_committed_receipt_path", "test_root_readme_retires_custody_checkpoint_and_standalone_operations", "test_root_readme_builds_and_starts_current_paxd_target"]

[wiring.root_readme]
path = "README.md"
owner_domain = "16 (root documentation); fm-programme"
owner_task = "22.31.470"
request = "README.md -> domain 16 / task 22.31.470: rewrite the architecture and build example for integrated paxd, committed finality and the current target; remove retired standalone deployment instructions."
status = "Satisfied by the inherited README from 22.31.470; this task makes no out-of-path edit."
missing_facts = []

[baseline]
working_tree = "Initial git status/diff contained only pre-existing .cgignore and spec/layerx-merge/spec.kvx bookkeeping; neither scoped artifact existed. Those edits are preserved."
ledger = "Before implementation /out/run/gates.jsonl was absent and gate.json recorded builds_used=0 and verify_runs_used=0."
verification = "Baseline verification was not run: the explicit implementation-first order and exclusive hf-done gate prohibit the older step 5 request for a manual unchanged-tree verify. No pre-change failing tests are claimed."

[proof]
automated = "Five tests read the actual README: integrated network and block finality; numbered api1..api14 root HTTPS JSON-RPC and parsed eth_chainId request/response example; signed transaction through ordered receipted/committed states and committed views; retired custody/checkpoint surfaces and absence of layerxd operations; parsed make/build and paxd start examples. A sixth test checks this finding-to-test mapping and wiring ownership."
production_path = "Read-only source checks tie the README to node/app.go and modules/lxphost/host.go for the embedded kernel, rpc/rpcstack.go for root routing, rpc/send.go for acceptance/forwarding, rpc/sequencer_receipt.go for receipt rungs and committed results, and parsed Makefile/chain.mk rules for the real native-library-to-paxd build path."
review_only = "Native builds, node execution, consensus finality, cryptographic proof verification, endpoint availability and retirement behavior are not executed by this documentation gate; runtime correctness remains review and owning-domain qualification evidence. No interface or restart/recovery behavior is changed."
historical_context = "Retained layerxVerify/layerxCustody/layerxAnchor ABI names identify upgrade-gated retired refusal surfaces; archive-only historical reads do not introduce a current checkpoint or settlement deployment."

[format]
policy = "No Python or KVX formatter is configured for these paths; apply the repository .editorconfig UTF-8, LF, final newline and trailing-whitespace conventions after implementation."

[evidence]
build = "hf-build (python3 --version)"
verify = "hf-done (cg spec done 22.33.392 -f layerx-merge --root $TASK_ROOT; verify_cmd: python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_392.py)"
ledger = "/out/run/gates.jsonl"
verified_revision = "The final hf-done JSON and private ledger record the exact content-derived candidate revision, command, exit code and log path. Build and verify must name the same candidate revision; this record is finalized before either gate to avoid changing that revision."
publication = "The runner records qualification and publishes; this task does not commit or push."

[gotcha.context]
observed = "Combined context output was truncated, and cg brief reported unrelated cached tasks and changes."
resolution = "Use bounded reads of task-relevant source sections, actual git status/diff and the private gate ledger; record this note here because GOTCHA.kvx and spec files are outside scope."

[gotcha.markdown_fences]
observed = "The initial section reader interpreted the shell example's # Expected result comment as a Markdown heading and truncated the quickstart before the mirror facts; five checks passed and the root-RPC check failed."
resolution = "Track Markdown fences when locating section boundaries, preserving every original assertion and the real README unchanged."
revision = "71cc1319776fb14252df8a5e9c368af22cc6a303"
command = "cg spec done 22.33.392 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
