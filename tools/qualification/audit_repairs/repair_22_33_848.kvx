[finding.f018]
file = "tools/paxeer-x/gates/104.30.5.sh"
tests = ["test_f018_native_profile2_uses_paxd_funding_committed_proofs_and_real_restart", "test_f018_inventory_and_account_conservation_reject_missing_duplicate_and_wrong_asset"]
source_proof = "The gate invokes profile2_native.py, which builds paxd and the retained registry winddown corpus, uses the real merged PaxdFixture/WinddownSession/Node, requires the exact eleven historical multiasset cases, owner profile-2 registration for two assets, positive native transfer funding, per-account deltas, native typed refusals and verified committed receipt comparisons. Restart stops and starts the same private paxd home and compares observed state and earlier committed proofs. Daemon, bridge-credit and custody fixture prerequisites are removed."
review_only = "No paxd process, bank state, signed receipt or node restart is executed by this source gate. The replacement private profile case producer is an explicit wiring request; this source repair does not fabricate that profile or claim operational multiasset qualification."

[finding.f062]
file = "tools/paxeer-x/gates/104.33.7.sh"
tests = ["test_f062_services_and_protected_profile_keep_all_connected_acceptance_cases", "test_f062_real_profile_producer_private_transport_consumer_and_reopen", "test_f062_profile_consumer_refuses_external_plaintext_inline_secret_and_wrong_identity", "test_private_evidence_roundtrip_reopen_and_refusals"]
source_proof = "The real catalogue binds the gateway, explorer index, program registry, sequencer and receipt authority producers. hosted_profile.publish writes a protected revision-bound document that hosted_profile.load reopens, validates and consumes; the secret is itself a protected file rather than an inline environment value. Tests drive that actual producer -> private file -> consumer path and close/reopen it, and exercise stale revision, permissions, symlink, hardlink, duplicate-key, external URL, plaintext URL and wrong identity refusals. Discovery, code-bound interface, simulation, idempotency, signed call, receipt verification, exact replay, tamper refusal and language-binding assertions remain."
review_only = "Opaque local file inputs in the profile transport test are inert committed fixture/source bytes; no TLS, authentication, signed activity or receipt success is substituted or claimed. The connected native corpus and loopback HTTPS operational profile remain separate operational evidence."

[wiring.profile2]
path = "tools/qualification/paxeer-x/programs_accounts_winddown.py"
owner_domain = "16 / tools-ops, with domain 1 chain fixture owner"
request = "Produce a private paxeer-x.merged-winddown-fixture.v2 document with cases[104.30.5] containing the exact profile2_native.REQUIRED cases and their closed steps/observations, per-account expected_deltas and committed_proofs against a funded private paxd seed; replace the removed services/platform/hosted/agent-boundary/tests/real_node.rs profile-2 producer in domain 9 rather than restoring a daemon consumer."

[wiring.hosted_profile]
path = "tools/paxeer-x/candidate.py"
owner_domain = "16 / tools-ops and domain 9 hosted fixture owner"
request = "Have the private hosted Programs fixture producer call gates/hosted_profile.publish and supply PAXEER_X_HOSTED_PROGRAM_PROFILE with the current revision and protected CA, secret, activity and retained verifier paths; include both gate helper sources in its existing artifact source manifest."

[wiring.compiler_manifests]
path = "tools/paxeer-x/build"
owner_domain = "16 / tools-ops"
request = "For each of 104.17.4, 104.24.1 and 104.24.2, invoke gates/compiler_manifest.py <gate> --evidence <private-directory> on the published source and pass its printed manifest as PAXEER_X_COMPILER_MANIFEST alongside the existing selected executable inputs."

