[task]
id = "22.33.848"
mode = "BUILD"
audit = "22.30.181"
base_revision = "00614466646b07799a236d2742211fd5eb2d85c5"
implementation = "Require private compiler-produced current-source manifests before the three existing binary corpora; correct exact service bindings; replace the removed interface C target with the retained native Rust interface transport; move multiasset qualification to the real merged paxd fixture with native funding and committed proofs; transport the connected hosted profile as protected evidence."
baseline = "Not run: the explicit implementation-first order and exclusive hf-done verification rule prohibit the conflicting unchanged-tree verification instruction. No baseline failures or passes are claimed. Initial git status/diff contained only runner-prepared .cgignore and spec bookkeeping; no scoped prior edits existed, gate.json recorded zero builds/verifies and /out/run/gates.jsonl was absent."
scope = ["tools/paxeer-x/gates", "tools/qualification/audit_repairs/repair_22_33_848.kvx", "tools/qualification/audit_repairs/test_repair_22_33_848.py"]
build_cmd = "bash -n tools/paxeer-x/gates/104.17.4.sh tools/paxeer-x/gates/104.24.1.sh tools/paxeer-x/gates/104.24.2.sh tools/paxeer-x/gates/104.25.1.sh tools/paxeer-x/gates/104.25.2.sh tools/paxeer-x/gates/104.30.3.sh"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_848.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger identify the exact verified content-derived candidate revision, command, exit and log. Build and verify must pass on that same candidate. This record is finalized before qualification: embedding its own candidate hash would change that hash. The runner publishes; no manual commit or push is performed."
qualification_limits = "The declared pytest gate needs no environment variables, external credentials, native artifacts, live endpoint or compiler toolchain. It parses the eight shell scripts using the required bash -n parser, parses embedded Python, Cargo manifests, Programs ABI and this KVX, and executes production evidence writer/readers, profile transport, refusal checks, case inventory and balance decoding. Native corpus execution, publisher recovery, paxd execution and cryptographic proofs are source-reviewed only; the bounded gate does not certify those operational runs."

[finding.f014]
file = "tools/paxeer-x/gates/104.17.4.sh"
tests = ["test_f014_manifest_precedes_gateway_inventory_and_preserves_corpus", "test_compiler_producer_and_consumer_bind_revision_complete_closure_log_and_executables", "test_compiler_consumer_refuses_absent_failed_and_empty_compiler_transcripts", "test_compiler_consumer_refuses_stale_revision_or_incomplete_source_before_io", "test_private_evidence_roundtrip_reopen_and_refusals"]
source_proof = "The manifest guard runs before executable discovery/execution; compiler_manifest.py invokes the exact locked Cargo command, captures actual compiler-artifact and successful build-finished events, requires the full exact target multiplicity, records native executable SHA256s and a private transcript digest, and compares current HEAD/tree and the entire tracked source closure including links and gitlinks. The existing gateway/lib/bin and Redis key-store corpora and count/skip assertions remain."
review_only = "No gateway/Rust/Redis corpus or compiler is executed by this pytest gate. Successful real compilation and executable provenance require the private compiler_manifest.py producer output, never a hand-authored success manifest."

