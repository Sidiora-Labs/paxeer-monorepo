[task.22.33.159]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
inspected_revision = "e65e8919dfb9fc6284a629dcb05c241648a026a7"
repair = "Qualify audit 22.30.117 finding 15 against the production README inherited from 22.31.470 under decision 2525. Preserve its one-network paxd architecture, chain-125 root JSON-RPC, transaction and committed receipt flows, merged activation inventory, historical retirement labels and linked paxd build/release examples. README.md is outside this task's paths and is not edited."
source_proof = "The Python-only module asserts README source facts and diagrams, parses the curl arguments and JSON-RPC payload without executing them, compares every merge-table address/name against precompiles/setup.go and node activation gates, checks actual RPC acceptance/forwarding, WAL release ordering and committed receipt coverage, checks upgrade-gated retirement sources, and parses Makefile prerequisites/recipe plus release-version JSON and chain.mk output. The record maps finding 15 to every declared proving test."
review_only = "Native Go/C/Rust execution, node startup, network availability, signatures, transaction execution, WAL recovery and BFT commitment are not executed. Source assertions establish documented producer/transport/consumer wiring; runtime correctness and the completeness of the prose require review and the owning domains' qualification. No production interface or stateful component is changed, so no runtime interface or restart-recovery proof is claimed. No shell script, unit file or manifest is modified; the documented shell command is parsed in-process, not run. The gate needs no environment variable, credentials, endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run. The explicit implementation-first order and exclusive hf-done gate supersede the older baseline-verification clause; no baseline failures are claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task-status bookkeeping, neither scoped task file existed, and /out/run/gates.jsonl had no recorded runs."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_159.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private evidence_ledger name the exact verified content-derived candidate revision, command, exit code and log path. hf-build and hf-done must pass on the same candidate revision. This record is finalized before qualification; embedding its content-derived revision into itself would change that revision. No source edit follows a passing hf-done; the runner retains the evidence and commits the result."
wiring_requests = []
wiring_policy = "Any missing README fact must be recorded as a one-line wiring request naming README.md, owning domain 1 and task 22.31.470; keep its failing assertion intact. Inspection found all finding-15 facts present, so no wiring request is outstanding."

[finding.15]
audit = "22.30.117"
file = "README.md"
line = 47
class = "doc-drift"
severity = "medium"
owner_domain = 1
repair_owner = "22.31.470"
tests = ["test_f15_single_paxd_network_and_block_finality", "test_f15_root_rpc_hosts_and_chain_probe", "test_f15_transaction_and_committed_receipt_path", "test_f15_merge_inventory_matches_activation_sources", "test_f15_retired_executors_and_archives_are_explicit", "test_f15_paxd_build_and_release_examples", "test_f15_record_maps_audit_to_proofs_and_evidence"]

[format]
policy = "No Python or KVX formatter is configured for these paths. After implementation, apply only .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions to the two scoped files."

[gotcha.1]
observed = "The historical baseline-verification clause conflicts with the task's explicit gate order."
resolution = "Run only hf-build then hf-done after full implementation; record no unexecuted baseline result."

[gotcha.2]
observed = "Codify brief/survey reports unrelated cached task/change information; broad reads exceed output limits and guessed root formatter files are absent."
resolution = "Use bounded source reads, Git status/diff, the exact task block and private gate ledger. Follow the existing audit-repair formatting policy. Keep notes here because GOTCHA.kvx and spec files are outside scope."

[gotcha.3]
observed = "The inspected HEAD differs from the runner's declared base, and the README repair is already present."
resolution = "Record both revisions, preserve prerequisite and runner changes, and qualify the inherited README without editing it or claiming this task authored its rewrite."
