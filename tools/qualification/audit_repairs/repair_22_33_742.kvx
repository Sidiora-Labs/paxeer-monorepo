evidence = "The final hf-done JSON and private gate ledger record the exact verified candidate revision, command, exit code and log path. Build and verification must pass on that same revision. This record is finalized before qualification; embedding its own candidate hash would change that hash. The runner retains the evidence and commits the qualified result."
wiring_request = []

[finding.state-store-fixed-fixtures]
audit = "22.30.172"
file = "tests/integration/db/state_store_test.yaml"
class = "test-gap"
severity = "medium"
observed = "Wasm counts assumed a baseline of three and fixed later totals; hard-coded IDs and outdated hundred-item comments hid fixture dependencies."
closure_basis = "All three existing cases remain active with strict batch deltas and recorded-height queries. Historical checks now identify all ten code records per batch, verify their creator and compare their metadata across later heights and both iteration orders without fixed absolute code IDs. No external producer changes are required: existing beginning/batch height and creator files supply the inputs."
tests = ["test_state_store_yaml_captures_every_input_before_consuming_it", "test_wasm_totals_use_the_recorded_baseline_and_both_iteration_orders", "test_real_verifier_accepts_count_deltas_and_rejects_missing_or_extra_codes", "test_fixture_ids_and_creators_are_captured_and_compared_across_heights", "test_tokenfactory_uses_baseline_deltas_and_comments_match_ten_item_batches", "test_source_proof_connects_fixture_producers_cli_pagination_and_consumers"]

[format]
policy = "No Python, YAML or KVX formatter is configured for these paths; apply .editorconfig two-space YAML indentation, UTF-8, LF, final-newline and trailing-whitespace conventions after implementation. The configured yamllint hook is a linter, not a formatter, and is outside the allowed gates."

[gotcha.1]
observed = "The unchanged-tree verification clause conflicts with the explicit implementation-first and wrapper-only gate order."
resolution = "Follow the explicit order and report no baseline execution; record the conflict here because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "Fixture producers persist heights and creator addresses but do not persist wasm code IDs; page lengths also truncate nonempty baselines."
resolution = "Capture IDs and complete metadata at recorded heights using baseline-relative ten-record pages, require the recorded creator, and use pagination.total for strict cumulative deltas. No out-of-scope fixture producer edit is necessary."
