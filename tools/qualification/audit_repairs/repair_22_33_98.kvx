closure = "The fixture/source-fact repair is proven by the named tests only after passing hf-done. Full semantic-policy and mounted-runtime closure remains with the three explicit out-of-path wiring requests; neither fixture labels nor source assertions claim that native runtime coverage executed."

[format]
policy = "No Python or KVX formatter is configured for these qualification paths. Follow neighboring Python style and .editorconfig UTF-8, LF, final newline and trailing whitespace rules after complete implementation. Preserve JSON two-space indentation and Markdown layout."

[gotcha.1]
observed = "The baseline-verification clause conflicts with the explicit implementation-first order and prohibition on manually running verify_cmd."
resolution = "Run only hf-build then hf-done after complete implementation; claim no baseline run. Record notes here because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "The audit says chain 125 plus a LayerX profile is rejected; current model.rs requires that profile, and transport.rs already calls validate in both directions. Profile-free offers and recorded_x402_request in server.rs cannot pass that validator."
resolution = "Preserve production checks and existing vectors, add profile-free refusal regressions and recorded native offers with the producer-derived account, and route policy resolution and mounted-runtime wiring to domain 11 without changing out-of-scope files."

[gotcha.3]
observed = "Broad context reads exceeded output limits, guessed transport/routes paths did not exist, and cg searches were limited to the cached index."
resolution = "Use bounded reads of discovered source paths and current Git state; no prior gate ledger existed and no earlier task implementation was found."
