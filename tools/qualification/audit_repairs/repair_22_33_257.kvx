verified_revision = "Resolved by the final hf-done JSON and its private evidence_ledger entry, which record the exact content-derived candidate revision, command, exit code and log path; no gate result is claimed before that entry exists."
evidence = "Finalize this record before hf-build and hf-done so their candidate revisions match. Embedding the candidate hash in its own source would change that hash; the immutable external gate ledger provides verified revision evidence. The runner commits and publishes; no manual commit or push."

[finding.034]
audit = "22.30.13"
file = "README.md"
line = 47
class = "doc-drift"
severity = "medium"
owner_domain = 17
owner_task = "22.31.470"
observed = "The audit's old README advertised a separate C17 layerxd daemon and layerxAnchor checkpoint settlement, and called the merge a draft."
expected = "One chain-125 BFT network embeds kernel execution in paxd; receipts become final at committed blocks. Public api1..api14 JSON-RPC hosts use the root path; signed transactions and committed receipt flows use the node. Custody and checkpoint executors are retired refusal surfaces, with no separate daemon or checkpoint deployment. Current source paths and integrated merge status are documented."
resolution = "The actual README delivered by 22.31.470 satisfies the expected documentation facts. It contains no layerxd topology to preserve in a dated migration section; retained ABI names identify historical refusal surfaces and explicitly add no finality step. Closure is qualified only by the declared hf-done result."
tests = ["test_034_one_chain_125_embeds_kernel_in_paxd", "test_034_public_root_hosts_and_chain_probe", "test_034_transaction_producer_transport_and_receipt_consumer", "test_034_finality_requires_authenticated_block_commitment", "test_034_retired_custody_checkpoint_executors_are_refusal_surfaces", "test_034_current_repository_paths_and_merge_status", "test_034_record_maps_proof_limits_and_external_revision_evidence"]
wiring_requests = []
wiring_policy = "README.md belongs to domain 17, task 22.31.470: any missing expected README fact must be requested there rather than edited here; inspection found none. No other out-of-path proposal step applies."

