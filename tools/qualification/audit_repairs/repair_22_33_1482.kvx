[task]
id = "22.33.1482"
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
initial_revision = "d36825b73d94056d621754462535f0c7d3c0ebbc"
repair = "Decision 2525 delegates README.md changes to domain 17 / task 22.31.470. Preserve that task's merged-network README and add focused regression assertions for audit 22.30.86/doc-root-readme. The expected architecture, root RPC, transaction/committed receipt, executor retirement and paxd build/run facts are present. The missing tenant integration guide link is an explicit out-of-path wiring request. No production or README file is changed here."
source_proof = "Seven Python tests read the actual README and production sources. They assert chain 125, embedded block-proposing kernel, shared tenant domains and topology; parse the curl arguments, JSON payload and root HTTPS URLs; follow source connections from transaction admission/forwarding through WAL receipt release to committed receipt coverage; check retirement refusals and absence of the standalone daemon; parse documented operator commands and check Makefile dependencies, version stamping and chain.mk output; resolve payment/tenant links and bind the remaining wiring request; parse this KVX and bind the audit finding to every declared test."
review_only = "Native Go/C/Rust builds, paxd startup, transaction execution, WAL restart/recovery, cryptographic verification, BFT commitment and live public RPC availability are not executed by this documentation gate. Producer, transport and consumer paths are source assertions, not runtime qualification. No interface or stateful component changes and no restart-recovery finding exists. No shell script, unit or manifest is modified. Tests require no environment variable, credential, endpoint, external binary, subprocess toolchain, native artifact or device. The tenant guide's discoverability remains the owning documentation task's responsibility."
baseline = "Initial git status/diff showed only runner-prepared .cgignore and spec task bookkeeping; both scoped files were absent. gate.json showed zero build and verify runs and no /out/run/gates.jsonl existed. README.md already contained the 22.31.470 corrections. No pre-change verification was run: the explicit implementation-first order and hf-build then hf-done gates supersede the conflicting baseline-run clause. No baseline test failures are claimed."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1482.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl name the exact verified content-derived candidate revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification because embedding its own candidate hash would change that hash. No source edit follows a passing hf-done; the runner retains the evidence and commits the task."
wiring_requests = ["tenant_integration"]

[finding.doc-root-readme]
audit = "22.30.86"
file = "README.md"
line = 44
class = "doc-drift"
severity = "medium"
resolution = "The obsolete two-domain, separate daemon and checkpoint finality model has been replaced by 22.31.470's single paxd BFT network. Tests assert the expected source facts without editing the out-of-scope README. The proposal's tenant integration link is tracked below rather than silently omitted."
tests = ["test_doc_root_readme_merged_network_and_tenants", "test_doc_root_readme_root_rpc_and_chain_probe", "test_doc_root_readme_transaction_to_committed_receipt", "test_doc_root_readme_retired_executors_and_deployments", "test_doc_root_readme_paxd_build_and_operator_commands", "test_doc_root_readme_integration_links_and_wiring_request", "test_doc_root_readme_record_binds_finding_proofs_and_evidence"]

[wiring.tenant_integration]
path = "README.md"
owner_domain = 17
owner_task = "22.31.470"
target = "docs/wiki/VirtualChains.md"
observed = "README.md explains tenant domains and links modules/layerxchains/ but does not link the current tenant integration guide; its PaymentsQuickstart link is already present."
request = "README.md: domain 17 / task 22.31.470 must link docs/wiki/VirtualChains.md as the current tenant integration guide."

[format]
policy = "No Python or KVX formatter is configured for these paths. After complete implementation, apply .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions to the two scoped files only."

[gotcha.1]
observed = "The baseline verification clause conflicts with the explicit implementation-first gate order and exclusive hf-done verification."
resolution = "Follow the explicit order and record no baseline execution or failure; never run verify_cmd manually. GOTCHA.kvx and spec files are outside scope, so task notes are recorded here."

[gotcha.2]
observed = "Codify's cached brief/next reports an unrelated task and thousands of unrelated changes, whereas git status shows runner bookkeeping only; combined broad reads exceeded output limits and indexed file searches missed documentation files."
resolution = "Use the assigned task block, actual Git diff, private gate configuration and bounded reads of known paths; preserve existing bookkeeping and use filesystem discovery when the graph omits files."

[gotcha.3]
observed = "The acceptance identifier is not a req.22998.1 section in the feature KVX, and a guessed modules/layerxchains/README path does not exist."
resolution = "Use the explicit acceptance text and task block supplied by the user, the existing modules/layerxchains/ source directory and docs/wiki/VirtualChains.md; do not invent an absent source or baseline result."
