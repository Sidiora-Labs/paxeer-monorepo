[repair]
task = "22.33.613"
acceptance = "22998.1"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
implementation = "LayerXHolder reads the required publishable layerx_receipt_keys string into PublishableConfiguration.RECEIPT_KEYS_KEY before creating LayerXAndroid and WalletModel. Runtime resource lookup avoids referencing a generated R field absent until the out-of-scope Gradle publisher is wired. A missing resource throws INVALID_CONFIGURATION immediately; malformed, empty or untrusted pins retain the existing configuration and verification refusals. No default pins, event-key substitution or relay-derived trust is introduced."
source_proof = "The pytest module checks executable Java source bodies: required resource binding and failure order, strict receipt-key parsing, configuration-to-gate pin propagation, WalletActivity payment through WalletModel, relay evidence transport/decode, evidence identity and pinned signed-receipt verification, height bounds, transaction binding and expected asset/recipient/amount checks. It parses existing Gradle resource mappings and source directories and the Android launcher manifest. These are source facts, not execution of the Java path. No shell scripts or unit files are repaired."
review_only = "Android startup and a signed payment through the actual sample configuration, Android resource generation/escaping and release resource retention, Java compilation and cryptographic execution are not executed by this gate. The existing Gradle publisher still lacks receipt pins and the sample cannot start until the wiring request is fulfilled. Review traces the real configuration/relay/consumer code; full runtime closure is pending. This config-drift repair changes no persisted state or wire interface, so no restart-recovery or interface-mismatch execution is claimed."
baseline = "No baseline verification was run: the explicit implementation-first order and exclusive hf-done gate prohibit the older do_5 pre-change verify instruction. No baseline test failures are claimed. Initial git status/diff showed only runner bookkeeping in .cgignore and spec/layerx-merge/spec.kvx; the scoped repair and test files were absent. /out/run/gate.json reported zero build and verification runs; no /out/run/gates.jsonl existed. Source inspection confirmed the missing receipt pin binding and Gradle resource."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_613.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private /out/run/gates.jsonl bind this record to the exact content-derived revision, command, exit code and private log path. Build and verification must pass at the same revision. This record is finalized before qualification: embedding its own candidate hash would change that hash. No gate success is claimed before the gate runs. Publication belongs to the runner."

