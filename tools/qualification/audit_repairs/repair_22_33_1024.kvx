source_proof = "Offline source facts: one chain-125 paxd BFT network with an embedded block-proposing kernel; root public JSON-RPC host range api1 through api14 and a parsed chain-ID request; distinct hosted OpenRPC contract and node registrations; signed transaction acceptance/forwarding, durable acknowledgement before receipt release, committed MsgSequenceBatch coverage and proof consumers; retired custody/checkpoint refusal gates with historical reads distinguished; supported native-linked paxd build and operator start commands. Repository links resolve to real sources."
review_only = "Native Go/C/Rust builds, node startup, transaction execution, signatures, BFT commitment, endpoint availability and WAL restart/recovery are not executed. Production sources are inspected as documentation evidence, not executed or replaced by test doubles. This doc-drift finding changes no stateful component or interface, so no runtime recovery or interface exercise is claimed. README shell examples are parsed as data; no shell script, unit file or manifest is repaired by this task."
baseline = "Initial git status/diff showed only pre-existing .cgignore and spec bookkeeping; both scoped files were absent. The private gate configuration reported zero build and verification runs and two repair cycles available; /out/run/gates.jsonl was absent. No pre-change verification was run and no pre-change test failure is claimed: the explicit implementation-first order and hf-done-only verification rule supersede step 5's conflicting baseline instruction. README already contained the 22.31.470 rewrite."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1024.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the exact verified content-derived candidate revision, command, exit code and log path. Build and verification must pass on the same candidate revision. This record is finalized before qualification; embedding its own candidate hash would change that revision. The runner retains evidence and commits the result; no manual commit or push is made."
