[repair]
task = "22.33.1534"
audit = "22.30.95"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
acceptance = "22998.1; retain all checks and run the declared verification through hf-done on the same candidate as hf-build."
verified_revision = "The exact content-addressed candidate revision is recorded by hf-done in the private /out/run/gates.jsonl ledger and /out/logs/verify-1.log (or the numbered repair log); the final response copies the gate's revision, command, exit and log. No gate result is claimed in advance."
build_command = "bash -n docker/human-service/entrypoint.sh"
verify_command = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1534.py"
baseline = "No baseline verification was run: the task's explicit Order forbids testing before the implementation is complete and forbids invoking verify_cmd before hf-done. The test module did not exist on the unchanged tree. Source inspection at the base confirmed unconditional journal installation and the trust-history wait; these observations are not baseline test failures."
source_proof = "The tests execute the production Python bootstrap against protected temporary directories, close and reopen its module and disk state after real recorded receipt bytes replace a seed record and new records are added, and compare bytes, inode, modification time and permissions. They exercise seed conflicts, exact legacy adoption, invalid material, corrupt markers and interrupted staging. Tests execute the actual entrypoint's protected-copy Python body using its source/target argv, provision an existing canonical LXTR corpus fixture without a retired file, parse shell syntax with bash -n, parse Dockerfile COPY arguments, and assert producer-to-copy-to-provider environment and consumer proof guards. The committed receipt/header recordings are opaque filesystem payloads in this gate; their native semantic validity is not asserted."
review_only = "The Python-only gate does not launch the Rust agent, runtime clock or security provider, decode native journal records, verify cryptographic signatures, build the image or deploy workloads. Security startup is proven through protected material copying and shell/configuration source wiring up to exec, not native process readiness. Native consensus authority provisioning and the provider's existing TrustRoot and authenticated height-bound receipt-key verification are reviewed source facts. No static receipt key, handover file or trust-history copy substitutes for committed evidence."

[finding.2]
id = "22.30.95.2"
file = "docker/human-service/entrypoint.sh"
repair = "Replace unconditional installs with journal_bootstrap.py. Publish fsynced seeds and a versioned SHA-256 seed inventory marker in one atomic directory rename under an exclusive startup lock. Restarts require the same seed inventory and preserve all retained records, including records whose bytes advanced. Adopt an unmarked journal only when every seed is already byte-identical; preserve extras. Refuse conflicting seeds, unsafe records and interrupted staging for explicit reconciliation. The marker has a JSON extension and the real agent consumer selects admission records only."
tests = ["test_finding_2_restart_preserves_advanced_journal", "test_finding_2_changed_seed_refused_without_mutation", "test_finding_2_adopts_identical_unmarked_records_and_preserves_extras", "test_finding_2_unmarked_conflicting_journal_is_preserved", "test_finding_2_invalid_seeds_never_publish", "test_finding_2_invalid_retained_state_refused", "test_finding_2_interrupted_staging_requires_reconciliation", "test_shell_syntax_image_and_durable_publication_wiring"]
wiring_request = "services/platform/hosted/human/deployment.yaml and the owning node workload in services/platform/hosted/node/deployment.yaml (platform domain 8 and Human domain 10): retain the protected /run/human-private/agent parent, including journal and its bootstrap marker, on durable storage across container replacements so first publication can atomically rename the journal directory. Process restart over the same private directory is covered here; container volume lifecycle is outside this task."

[finding.1]
id = "22.30.95.1"
file = "docker/human-service/entrypoint.sh"
repair = "Remove the retired-file wait and copy; require a protected consensus-authority projection immediately and retain the former root:4020 mode-0440 input and mode-0600 private-destination checks. Set the provider's existing LAYERX_HUMAN_SECURITY_PROVIDER_TRUST_HISTORY path variable to the private consensus-authority file. This compatibility variable carries the current LXTR consensus TrustRoot, never retired history. The consumer authenticates chain commits using that root and obtains receipt keys from a sequencer-store proof against the same committed header, including key height bounds. Missing authority fails closed immediately."
tests = ["test_finding_1_security_startup_provisions_current_authority_without_retired_file", "test_finding_1_authority_copy_fails_closed", "test_finding_1_receipt_keys_follow_consensus_proof_consumer", "test_shell_syntax_image_and_durable_publication_wiring"]
wiring_request = "services/platform/hosted/human/history_material.py and services/platform/hosted/human/provision.sh, plus the owning Human security workload deployment (platform domain 8 and Human domain 10): project /run/human-material/consensus-authority as a root:4020 mode-0440 canonical LXTR TrustRoot for the governed merged chain/validator set; deliver committed recovery evidence with receipt_keys_proof verified against that authority, and remove retired trust-history secret keys/configuration. Existing history_material.py publishes native context and merged owner evidence, not this LXTR projection; do not claim deployment is wired by this entrypoint repair."
consumer_wiring_request = "services/human/crates/layerx-human-security-provider/src/transport.rs and src/main.rs (Human domain 10): rename the historical TRUST_HISTORY path variable and trust_history field to consensus authority in a coordinated producer/consumer deployment migration; this task preserves the actual existing consumer interface while replacing its file prerequisite."

[gotcha.1]
observed = "The explicit bounded-gate order conflicts with the embedded step asking for an unchanged-tree verification."
resolution = "Follow the explicit Order, record source observations honestly, and run verification only through hf-done after implementation and hf-build."

[gotcha.2]
observed = "The security provider uses the legacy-named TRUST_HISTORY environment variable to load the current binary LXTR consensus TrustRoot; merged receipt keys are authenticated within recovery evidence rather than a standalone static-key file."
resolution = "Wire the current authority through the real consumer variable without inventing an unsupported environment setting; request the owning deployment projection and later coordinated variable rename outside this scope."
