verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_1023.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private evidence ledger name the verified content-derived candidate revision, exact command, exit code and log path; build and verify must pass on the same candidate revision. This record is finalized before the gates: embedding its own candidate hash would change that revision. The runner retains the declared evidence and publishes the task."
