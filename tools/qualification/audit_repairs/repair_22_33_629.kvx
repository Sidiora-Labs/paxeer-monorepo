[task.22.33.629]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
repair = "Qualify audit 22.30.163 finding 051 against README.md as rewritten by its owning task 22.31.470 under decision 2525. Architecture, build and current-status guidance describes the integrated paxd network and BFT-committed receipts; retained checkpoint material is explicitly historical. README.md is outside this task's scope and is unchanged."
source_proof = "The offline pytest module reads the actual README sections, diagrams and shell examples. It checks chain 125, api1..api14 root JSON-RPC hosts and the parsed eth_chainId request; integrated host and consensus wiring; transaction acceptance/forwarding, durable acknowledgement before receipt publication and committed block coverage; signed receipt verification; merged-node build/start commands and production targets; retired custody/checkpoint refusal gates and archive-only historical formats."
review_only = "Native Go/C/Rust compilation, node startup, transaction execution, signature verification, BFT consensus, WAL restart/recovery and live endpoint availability are not executed. Producer, transport and consumer connections are source facts for a documentation finding, not runtime certification. No shell script, unit file, manifest or build file is repaired; no interface-mismatch or restart-recovery finding applies. The gate needs no environment variable, credential, endpoint, external binary, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run and no baseline test failures are claimed: the explicit implementation-first order and hf-done-only verification override the contradictory unchanged-tree baseline clause. Initial Git status/diff contained only runner-prepared .cgignore and spec task bookkeeping; both scoped artifacts were absent. Initial gate.json recorded zero builds and verifies, two repair cycles left, and gates.jsonl was absent."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_629.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The exact verified candidate revision is named by the final hf-done JSON and the corresponding private evidence_ledger entry, together with command, exit code and log path."
evidence = "Build and verification must pass on the same candidate revision. This record is finalized before qualification; embedding its content-derived candidate hash in its own source would change that hash. The runner retains the exact revision and private logs and publishes the result; no manual commit or push is performed."
outstanding_wiring_requests = []

