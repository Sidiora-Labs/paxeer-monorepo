repair = "Consume README.md as rewritten by owning task 22.31.470 under decision 2525 without modifying it. Add regression proof of root-network-description: one chain-125 BFT network, embedded block-proposing kernel inside paxd, root public JSON-RPC hosts, transaction submission and committed receipt finality, merged node build and implemented specification status, retired custody/checkpoint executors and historical settlement formats."
source_proof = "The pytest module asserts README source facts in its component, topology, quick-start, receipt, build and specification sections. It parses the curl arguments and JSON payload without executing them, checks HTTPS root URLs and the api1..api14 range, checks both Mermaid diagrams, and traces production source wiring from node host and consensus source through transaction acceptance/forwarding, WAL release before receipt publication, RPC receipt rungs and committed coverage. It checks real Makefile dependencies, chain binary output, retirement guards and historical-document links."
review_only = "Native Go/C/Rust builds, node startup, endpoint availability, actual transaction execution, signature verification, durable restart/recovery and BFT commitment are not executed by this Python-only documentation gate. Source assertions prove documented producer/transport/consumer connections, not runtime certification. No interface or stateful component changes, shell script, unit or manifest edits require runtime recovery, bash syntax or deployment gates here. Tests need no environment variable, credential, live endpoint, subprocess toolchain, native artifact or device."
baseline = "No pre-change verification was run: the explicit implementation-first order and exclusive hf-build then hf-done gates prohibit the older step-5 baseline request and manual verify_cmd execution. No baseline failure is claimed. Initial git status/diff showed only runner-prepared .cgignore and spec task-state changes; both scoped files were absent. gate.json showed zero builds and verifies and no gates.jsonl existed. The prerequisite merge already supplied the README repair."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_279.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private evidence ledger record the verified content-derived candidate revision, exact command, exit code and log location. Build and verify must pass on the same candidate revision. This source record is finalized before qualification; embedding the content-derived revision in itself would change that revision. The runner retains the exact result and commits; no source edits follow passing hf-done."
