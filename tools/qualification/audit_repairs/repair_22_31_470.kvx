[task.22.31.470]
base_revision = "76bd4ca9414014055f61431cd0c7be0dc9ac5fe2"
repair = "Rewrite architecture, topology diagrams, quick start and transaction/committed receipt flows for one chain-125 paxd BFT network with its block-proposing kernel embedded. State root public JSON-RPC, no router or separate interface, optional hosted contracts, tenant namespaces and mirror-only hpx hosting. Retire daemon/checkpoint deployment guidance and isolate retained executor names in the explicit refusal paragraph. Preserve account binding, native funding, proof trust, active precompile inventory, source layout and linked-library builds."
source_proof = "The focused Python module checks actual README text and diagrams against production node registrations, root-path dispatch, transaction acceptance/forwarding, WAL acknowledgement before receipt publication, receipt rungs and committed coverage, host and consensus wiring, account ABIs, bank mapping, proof consumers, retirement gates and build targets. It checks all root RPC URLs and the documented curl payload without executing a request, resolves repository links, rejects retired symbols using the retirement inventory and maps all 97 medium README findings to declared checks."
review_only = "Native Go/C/Rust builds, node startup, transaction execution, cryptographic operations, WAL restart/recovery, actual endpoint availability and BFT consensus are not executed by this documentation gate. Source checks establish documented producer/transport/consumer connections, not runtime or deployment certification. No production interface or stateful component changes."
baseline = "Initial Git status/diff showed only runner-prepared .cgignore and spec task-start bookkeeping, no changes to any scoped file. gate.json recorded zero builds and verifies, two repair cycles left, and no gates.jsonl existed. No pre-change test was run: explicit implementation-first ordering and the exclusive hf-done verification gate supersede older audit task baseline instructions."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_31_470.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The last hf-done JSON and private /out/run/gates.jsonl name the exact verified content-derived candidate revision, command, exit code and log path. Build and verification must pass on the same candidate revision. The record is finalized before qualification: embedding the candidate hash into its own content would change that hash. The runner retains evidence and publishes the task; no manual commit or push is performed."
wiring_requests = []

[reconciliation]
prior_work = "Task 22.33.9 is done at this base and its repair record and eight source checks were read; preserve its dual-consent binding bytes, ABI signatures and nonpayability, native bank sub-accounts and gas separation, expiry units, derivation/recovery context, ProtocolReceipt v2 key pinning, authenticated commitment proofs, historical formats, and paxd native library prerequisites. Task 22.33.33 is pending in this checkout, its repair record and test file are absent, and README history contains no published change attributed to it. Preserve every existing README fact and satisfy its architecture-root audit expectation with the new topology and receipt diagrams; do not invent absent publication evidence."
coverage = "95 pending medium-wave tasks require 22.31.470 at this base. Their complete task text and root README audit findings were read, including three findings named root-readme-topology, and all existing repair_22_33 records were inspected for root README claims. Only repair_22_33_9.kvx exists for README. Two additional root findings are audit 22.30.1/39 and 22.30.176/23; all 97 medium README findings are mapped below."

[conflict.px_methods]
observed = "Some audit expectations and BRIEF fact 3 reserve all px_ methods to the hosted gateway and list fewer node namespaces."
authority = "rpc/server.go registers native pxAccountAPI, pxHistoryAPI and receiptKeysAPI on the node; rpc/sequencer_receipt.go defines px_getReceiptKeys, and services/platform/hosted/gateway/openrpc.json declares the gateway contract. rpc/server.go also registers web3/pax2 and restricts test to non-live chain IDs."
resolution = "Document each server's method contract and the node's explicit px_ subset. The hosted contract never implies public endpoint availability; hosting remains optional, with no router or separate LayerX execution interface."

[conflict.anchor_reads]
observed = "Several findings call all checkpoint interfaces retired at merge, while prior work explicitly preserves historical reads."
authority = "precompiles/layerxanchor/layerxanchor.go gates non-view calls at MergeUpgrade and all calls at StoreDeleteUpgrade; node/upgrades.go names the later store-deletion plan."
resolution = "Describe checkpoint writes as retired refusal surfaces, historical views as archive-only before v7.0-anchor-store-delete, and current finality as authenticated BFT block commitment. Keep the external native bridge distinct from retired kernel custody."

[conflict.retired_names]
observed = "The task asks that no retired construct name remain while also requiring retired refusal surfaces and preservation of 22.33.9's explicit ABI retirement facts."
authority = "The retained precompile implementations and 22.33.9 require the three historical ABI names, addresses and source links to identify their actual upgrade-gated refusals."
resolution = "Remove the retired daemon name and every retired runtime, route and inventory symbol from current guidance. Permit only the three retained executor ABI names and their source links in one explicit pre-merge refusal paragraph; assert the entire remaining README contains no inventory symbol or deleted tree. Historical codec and witness prose explicitly states it adds no settlement step."

[format]
policy = "No Python or KVX formatter is configured for these paths; Markdown has a lint hook, not a formatter. After the complete implementation, apply only .editorconfig UTF-8, LF, final-newline and non-Markdown trailing-whitespace conventions to the three scoped files."

[gotcha.1]
observed = "Broad combined context reads exceeded output limits; the Codify brief/survey cache reports unrelated tasks or changes, and guessed documentation/source paths may be absent."
resolution = "Use bounded task/record sections, actual Git status/diff, discovered production paths and the private gate ledger. Task-specific notes live here because GOTCHA.kvx and spec files are outside scope."

[gotcha.2]
observed = "The prompt describes 22.33.33 as already published, but the base task is pending and its repair artifacts are absent."
resolution = "Record the checkout's evidence, preserve inherited facts, and satisfy its architecture-root proposal without claiming an absent gate or publication."

