status = "satisfied"
observed = "All expected facts are present in the inherited README; no missing-fact wiring request remains. Historical separate-daemon build commands have been removed, retained settlement formats are explicitly historical and retired, and make build is explicitly a kernel-library/development target rather than a network runtime."

[format]
policy = "No Python or KVX formatter is configured for these paths. After completing implementation, apply repository .editorconfig UTF-8, LF, trailing-whitespace and final-newline conventions only to the two scoped files."

[gotcha.1]
observed = "The audit step requests a baseline verify before implementation, while the explicit order prohibits testing until implementation is complete and permits verification only through hf-done after hf-build."
resolution = "Follow the explicit order; record no baseline execution or failure and never run verify_cmd manually."

[gotcha.2]
observed = "Codify brief reports unrelated cached task/change counts and broad combined context output exceeds the output budget."
