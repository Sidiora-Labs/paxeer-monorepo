[task.22.33.959]
base_revision = "399c122802fbe3326c62ef9251760c3e53ee4060"
checkout_revision = "56473aac5d40028d45d7cebb2cb508d73366c852"
repair = "Qualify readme-two-domains against the root README already rewritten by owning task 22.31.470 under decision 2525; add focused regression proofs and this finding-to-test record without changing README.md or any other production file."
source_proof = "Read the actual README and production sources offline. Assert one chain-125 BFT network, embedded block-proposing paxd kernel, committed-block finality, integrated diagrams, api1 through api14 HTTPS root JSON-RPC and the parsed curl JSON chain probe. Trace source connections from SendRawTransaction through local acceptance or forwarding, WAL acknowledgement before receipt publication, and committed MsgSequenceBatch coverage. Check retired custody/verification/anchor source guards, historical settlement labels, native-library Makefile dependencies and the paxd build/start commands. Reject the audited two-domain, separate-daemon, draft-merge and routed-RPC guidance."
review_only = "This documentation gate does not execute Go/C/Rust builds, paxd startup, transactions, WAL recovery, signature verification, BFT consensus or live RPC requests. Producer, transport and consumer links are source assertions, not runtime certification. No stateful or interface implementation changes, so no restart-recovery or interface-mismatch runtime proof is claimed. No shell script, unit or manifest is changed; shell examples are tokenized and JSON is parsed in-process, without subprocesses, external binaries, environment variables, credentials, endpoints, native artifacts or devices."
baseline = "Initial Git status/diff showed only existing runner changes to .cgignore and spec task bookkeeping, with no scoped implementation. gate.json recorded zero builds and verifies and gates.jsonl was absent. No pre-change verification ran and no baseline test failures are claimed: the explicit implementation-first order and exclusive hf-done gate supersede the contradictory older baseline instruction. README.md already contains the owning task's corrections and remains unchanged throughout this task."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_959.py"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The final hf-done JSON and private gate ledger record the exact verified content-derived candidate revision, command, exit code and log path. Build and verify must pass on that same candidate revision. This record is finalized before qualification; embedding its own candidate revision would change the candidate. The runner retains the exact evidence and publishes the result; no manual commit or push is performed."
wiring_requests = []

