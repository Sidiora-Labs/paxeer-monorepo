repair = "Decision 2525 delegates README.md edits to root documentation task 22.31.470. Its committed README already describes the merged paxd network; this task adds a dedicated regression gate and finding-to-test evidence without changing README.md."
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_187.py"
evidence_ledger = "/out/run/gates.jsonl"
verified_revision = "The final hf-done ledger entry identifies the exact content-derived candidate revision; its build and verification revisions must match. Embedding that hash in this record would change the candidate itself."
evidence = "The final hf-done JSON and private /out/run/gates.jsonl retain revision, exact command, exit code and private log path. Only a passing hf-done qualifies this task; the runner handles publication."
baseline = "Initial git status and diff showed only pre-existing .cgignore and spec bookkeeping; neither scoped file existed. gate.json recorded zero builds and verifies and gates.jsonl was absent. No baseline test ran and no baseline failures are claimed: the explicit implementation-first order and exclusive hf-done gate supersede step 5's older instruction to run verification on the unchanged tree."
source_proof = "The module reads the real README, production root-path dispatcher, send/accept/WAL/receipt consumer path, retirement guards, and Makefile/chain.mk target declarations. It asserts one embedded block-proposing kernel, chain 125, numbered root JSON-RPC URLs, signed transaction submission, durable execution receipts versus authenticated committed finality, retired custody/checkpoint executors, supported paxd build/start commands, and absence of separate-daemon deployment guidance."
review_only = "These are offline documentation and production-source contract checks. Native builds, node startup, live endpoints, cryptographic verification, transaction execution, WAL restart/recovery and actual BFT commitment are not executed. No runtime interface or persistent state changes; this doc-drift finding requires neither a restart test nor an interface-mismatch integration test."
wiring_requests = []
wiring_review = "README.md is owned by the root documentation domain, task 22.31.470. Its inherited text supplies every expected fact for readme-separate-kernel, so no missing-fact wiring request is needed; any future missing fact must be requested from that task instead of editing README.md here."

[finding.readme-separate-kernel]
file = "README.md"
class = "doc-drift"
severity = "medium"
repair_owner = "22.31.470 / root documentation domain"
observed = "The audit described two execution domains, a separate layerxd daemon, checkpoint settlement, retired daemon build instructions and a draft merge."
expected = "The upgrade documentation must describe one BFT network with the kernel in paxd and final committed receipts, with no separate layerxd deployment or checkpoint-settlement procedure."
tests = ["test_readme_describes_one_merged_paxd_network", "test_readme_uses_chain_125_and_root_numbered_rpc_hosts", "test_readme_transaction_receipt_flow_matches_production_sources", "test_readme_retires_custody_and_checkpoint_executors", "test_readme_build_and_start_use_supported_paxd_targets", "test_readme_has_no_separate_daemon_or_checkpoint_instructions"]
closure = "The listed tests assert README.md as left by 22.31.470; their successful bounded hf-done run is the closure evidence."

[format]
policy = "No Python or KVX formatter is configured for these paths. Apply .editorconfig UTF-8, LF, final newline and trailing-whitespace conventions only after implementation is complete."

[gotcha.scope]
observed = "The inherited workflow asks for GOTCHA/spec edits and commits while this task permits only two files and delegates publication to the runner."
resolution = "Keep task notes here, preserve existing runner bookkeeping, and do not edit README.md, GOTCHA.kvx or spec files or manually commit or push."

[gotcha.context]
observed = "Combined context reads exceeded output limits because the root gotcha ledger and upstream repair record are large."
resolution = "Use bounded sections for the audit finding, README, upstream coverage entry and gate configuration; no gate has been run during context inspection."

