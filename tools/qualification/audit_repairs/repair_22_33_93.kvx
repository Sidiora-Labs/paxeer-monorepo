[repair]
task = "22.33.93"
audit = "22.30.110"
base_revision = "04c1e9407e75f7ac92c260452f2232ab07bf3ef1"
implementation = "Publish the two positive checkout-bound vectors from the existing UCP consumer fixture, using the committed node recording V1-ucp-checkout-pay-exact without modifying its transaction, receipt, signature, pin or logs. Derive completed and stored order evidence from those bytes and use 100 USD minor units under the existing 2-to-6 decimal binding. Preserve the entire original tampered-log refusal vector."
closure = "The fixture transaction-binding mismatch is repaired; the declared Python gate proves recorded-byte and source contracts. It does not claim execution of the Rust consumer or production service restart. Exact qualification is only the passing hf-done evidence on the built revision."

[finding.ucp_fixture_transaction_binding]
path = "services/interop/specs/conformance/ucp/sequenced-order.json"
tests = ["test_ucp_fixture_preserves_unmodified_node_recording", "test_ucp_fixture_transaction_binding", "test_ucp_fixture_authenticated_receipt_and_expected_order", "test_ucp_fixture_preserves_tampered_log_refusal", "test_ucp_real_producer_transport_consumer_source_contract", "test_ucp_reopened_replay_source_contract"]
producer = "sdk/platform/conformance/fixtures/ucp-checkout-receipt-v1.json, generated by rpc/sequencer_receipt_vectors_test.go TestRepairM_466_UCPCheckoutReceiptVector (task 22.31.466); the recording already exists on the task base."
consumer = "services/interop/crates/layerx-ucp/tests/fixtures/sequenced-order.json supplies the existing positive vectors; its sequenced_vectors.rs consumer and support/producer_checkout.rs recovery regression are inspected without invoking a toolchain."

[baseline]
working_tree = "Initial git status and git diff showed only runner-prepared .cgignore and spec/layerx-merge/spec.kvx changes; no scoped implementation existed. These existing changes were left intact."
ledger = "No earlier hf-build or hf-done ledger existed at /out/run/gates.jsonl."
verification = "No unchanged-tree verification was run: the explicit Order requires complete implementation before gates and forbids running verify_cmd manually. The test module did not exist on the unchanged tree; no baseline failing tests are claimed."
observed = "Source inspection confirmed that raw calldata carried 26fde3de... while the edited receipt/log carried d6f99442...; this observation is not a baseline test result."

[proof]
minor_decimals = 2
atomic_decimals = 6
runtime_executed = false
source_facts = "Pytest parses the JSON arrays, the actual EIP-1559 RLP transaction and the repair KVX. It checks chain 125, ledger address, six payExact ABI words, UUID-domain reference, payer/recipient/asset, exact currency conversion, immutable producer transaction/log/signature/pin equality, signed receipt activity, signature framing, node digest and key range, derived completed/stored order, submitted behavior and retained tampered-log refusal."
producer_transport_consumer = "Source contracts check the actual Go recorder sets the checkout reference before transaction signing, signs and serves the node receipt, then writes the recording. The Rust adapter verifies signature, activity, logs, checkout reference and configured amount before settlement; order reads reverify evidence. The published positives exactly equal those consumed by the existing Rust conformance test. No substitute consumer is implemented in Python."
reopened_replay = "Source inspection checks the existing Rust transcript peer writes and syncs unchanged producer bytes, closes the consumer and store after submitted status, reopens and reads the transcript, recreates the real UcpAdapter payment consumer, completes and reads the order, retries, and asserts one submission and identical order/evidence. This checks the regression's source, not execution or production service durability."
review_only = "Go transaction signature recovery/Keccak hashing and Ed25519 receipt authentication, native transaction execution, Rust checkout completion and retry, and any durable production service journal restart require the owning runtime gate. Byte equality preserves the committed producer signatures; the Python module does not perform cryptographic authentication or run those toolchains. The existing transcript peer is test-owned, not a service journal."
dependencies = "Python standard library and pytest only; no environment variables, credentials, live endpoint, subprocess toolchain, external binary, native artifact or device."

[wiring]
fixture_publication = "Domain 11: the tests/repair_22_33_115.kvx request to publish the regenerated positive vectors into services/interop/specs/conformance/ucp/sequenced-order.json is fulfilled here."
durable_service_replay = "Domain 11: services/interop/crates/layerx-interop-service/src/{config,server,relay}.rs and its integration tests must wire the configured UCP amount binding and unchanged checkout recording through the real relay/journal, stop and reopen that service, and assert completed-order replay with one submission; this out-of-scope runtime step is not claimed by the Python source gate."

[qualification]
build_cmd = "python3 --version"
verify_cmd = "python3 -m pytest -q tools/qualification/audit_repairs/test_repair_22_33_93.py"
build_gate = "hf-build"
verify_gate = "hf-done"
evidence_ledger = "/out/run/gates.jsonl"
evidence = "The runner's last hf-done line records the exact immutable revision, command, exit code and private log location and is copied verbatim in the final response. This record is written before qualification: embedding its own content-derived revision afterward would invalidate the built candidate. No passing or executed runtime gate is asserted in advance."

[format]
policy = "No Python or KVX formatter is configured for these paths; follow .editorconfig UTF-8, LF, final newline and trailing-whitespace conventions. The JSON retains two-space indentation."

[gotcha.1]
observed = "Broad ledger/context reads exceeded output limits and guessed sibling paths were absent; Codify's task index excludes most out-of-scope source files."
resolution = "Read bounded actual task/finding sections and directly inspect the owning sources; keep task notes here because GOTCHA.kvx is outside the allowed scope."

[gotcha.2]
observed = "The older do_5 requests baseline verification while the explicit bounded Order prohibits it before full implementation."
resolution = "Follow the explicit Order and record no baseline test execution; never invent earlier failures."

[gotcha.3]
observed = "The source receipt pays 1000000 atomic units, while the configured UCP binding converts currency minor units with two decimals to six asset decimals."
resolution = "Use 100 minor units for the positive checkout and expected orders, preserving the node payment amount and the production binding checks."
