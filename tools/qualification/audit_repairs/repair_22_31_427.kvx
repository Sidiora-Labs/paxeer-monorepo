[task.22.31.427]
audit = "22.30.179"
finding = "kernel-backend"
base_revision = "79d99a9cd334a5da02f3a4aac2a324549c9a0d5e"
repair = "Replace the standalone-daemon container assembly with one cgo-enabled paxd linked to the production C kernel/Rust programs runtime and shared typed Go keepers. Both image profiles start the same native node owner. Start paxd with its provisioned chain-125 genesis, validator/node/receipt keys, retained signing state and persistent sequencer WAL. Validate genesis before launch, hold an exclusive home lock, use the existing parent-death wrapper, handle shutdown, and exit on node loss so the container owner restarts the complete component. Remove retired supervisor, program/replica listeners, generation socket/core environment readiness and standalone core/authority/agent processes from this image. Keep executable/source digest, candidate revision, ELF/runtime linkage and pinned WASM library admission checks."
proofs = ["test_kernel_backend_cold_start_and_reopened_committed_readiness", "test_kernel_backend_refuses_uncommitted_or_divergent_peers", "test_kernel_backend_preserves_recovery_floor_on_refusal", "test_kernel_backend_refuses_untrusted_recovery_record", "test_kernel_backend_native_home_and_launch_contract", "test_kernel_backend_refuses_invalid_native_home", "test_kernel_backend_image_build_transport_and_typed_consumers", "test_kernel_backend_artifact_admission_still_checks_candidate_sources", "test_kernel_backend_entrypoint_unit_and_environment_agree", "test_kernel_backend_record_names_proofs_limits_and_owner_requests"]
runtime_proof = "Execute docker/kernel/kernel_runtime.py's production readiness server and the existing native_runtime.committed_health/rpc producer-consumer path against the committed node-owner RPC exchanges at services/platform/hosted/node/tests/fixtures/repair_22_31_355/native_configuration.json. A real forked loopback peer transports only captured method/parameter responses. Refuse an unavailable cold peer, then require status, canonical consensus commit, EVM chain id and the identical committed EVM block before returning 200. Persist the actual production checkpoint; stop the peer and HTTP consumer, reopen both at the same origin with only durable state retained, recover the checkpoint and require fresh reads again. Check loss/recovery after restart, dead/PID-reused process identity, rollback/divergence, stale/future commit time, wrong chain, syncing, empty head, uncommitted height, noncanonical/invalid commits, EVM mismatch and protected checkpoint admission. This is readiness recovery against recorded peers, not native database recovery."
source_proof = "Parse Docker instructions/continuations/heredocs and embedded Python, verify cgo/native library production, Go build/source closure, paxd export/COPY/runtime entrypoints, private build-input exclusions and the actual node/app.go shared-host/typed-keeper consumers. Preserve and assert exact manifest revision/digest/source/ELF guards. Execute the real native home parser and command builder on committed native genesis/config/key-format fixtures, rejecting missing/private/symlink/old-daemon material and off-volume data/signing paths. Parse the unit/environment and entrypoint arguments, asserting persistent data, privilege drop, restart/shutdown, loopback host RPC exposure and removal of obsolete service dependencies. hf-build alone runs bash -n docker/kernel/init.sh once; pytest checks guarded shell source facts without running Bash or another external binary."
review_only = "The Python-only gate does not compile/build the actual paxd executable or Docker image, execute Bash/setpriv/systemd, validate genesis/key cryptography with paxd, run BFT consensus, or prove actual paxd backend cold start/restart, transactions or state recovery. The shared C/Rust host and Go keeper assembly, artifact linkage, launch/stop ordering and container wiring are source facts, not runtime certification. The retained readiness checkpoint is a recovery floor, not stored health or a replacement for the node's canonical commit checks. No claim is made that retired Human/core/authority HTTP APIs are implemented by paxd or that current Autobahn status supplies a caught-up signal. Those owning interfaces require the wiring requests below. The complete native home must be provisioned externally; startup refuses legacy data and never creates/replaces keys, resets signing state, initializes an isolated chain or silently falls back to remote RPC."
baseline = "No pre-change verification was run: the explicit order requires full implementation before tests, hf-build before hf-done, and forbids manually running verify_cmd. No baseline failing-test result is claimed. The initial git status/diff contained only runner-prepared .cgignore and spec task-start bookkeeping; the private /out/run/gates.jsonl ledger had no earlier runs. Preserve that state untouched. Source inspection found no paxd launcher in init.sh, both runtime profiles copying legacy dependencies, and readiness waiting on generation.sock/core.env with retired 9401/9402 consumers. No Python/shell/Docker formatter is configured here; apply the repository's whitespace and final-newline conventions only after implementation is complete."
evidence = "The last hf-done JSON and the private runner gate ledger identify the exact candidate revision, command, exit and log path. hf-build and hf-done must identify the same candidate revision; no source changes after the final verification, and no manual commit or push. The runner retains/publishes the record and its content-derived revision, avoiding a self-referential revision edit after the gate."
wiring_requests = ["services/platform/hosted/core/src/main.rs, services/platform/hosted/authority/src/main.rs and services/platform/hosted/agent-boundary/src/main.rs — owning platform domain 8: complete the previously recorded 22.31.355 consumer migration from retired program/replica/supervisor HTTP to native committed RPC; these processes are not launched as kernel state authorities in the merged image.", "services/platform/hosted/gateway/deployment.yaml, gateway/src/paxeer.rs and gateway/src/main.rs — owning platform/RPC domains 8/7: route authenticated root eth_* and supported px_* projections to this single node on 8545/8546 with consensus reads on 26657; preserve tenant/mirror distinctions and do not restore a second chain, replica or external relay.", "consensus/internal/rpc/core/status.go — owning consensus/node domains 15/5: provide a real caught-up signal for Autobahn, whose current no-reactor status defaults catching_up=true; native_runtime.committed_health intentionally continues refusing that status until its owner fixes the interface.", "services/platform/hosted/paxeer and chain genesis provisioning — owning chain/node domains 6/5: provision the complete mode-0700 uid-4020 native home with authoritative hyperpax_125-1 merged genesis, native validator membership, node/validator keys, pinned receipt.key, configs and retained signing state; the image never creates a new isolated network or migrates legacy state implicitly.", "docker/kernel image qualification and services/platform/hosted/node/tests — owning image/node domains 16/5: build the admitted image with the actual paxd, cold-start the provisioned node, commit/read a native transaction, stop and reopen the same home/WAL/keys, and compare recovered committed height/hash and account/module state; this external native qualification is not executed or claimed by the Python-only gate.", "services/wallet/deploy/human.toml and Human/mirror service deployment — owning wallet/Human/interop domains 12/10/11: move application services to their owning service images, point them at the authenticated merged gateway, and replace old kernel profile ports/token assumptions; full/native now both identify the same single-node kernel.", "tools/bringup/kernel-genesis.sh and kernel deployment provisioning — owning tools/node domains 16/5: retire the old init --identity-generation/metadata.lxgb ceremony and use the native node genesis/key provisioning interface; legacy volume contents are retained and refused, never deleted."]

[finding.kernel-backend]
proving_test = "test_kernel_backend_cold_start_and_reopened_committed_readiness"
source_tests = ["test_kernel_backend_image_build_transport_and_typed_consumers", "test_kernel_backend_artifact_admission_still_checks_candidate_sources", "test_kernel_backend_entrypoint_unit_and_environment_agree"]
closure_boundary = "Docker/kernel producer/transport/consumer source wiring and production Python readiness recovery are covered; actual node/image qualification and out-of-path consumer/status integration are explicitly review/owner obligations, not executed gate evidence."

[gotcha.1]
symptom = "The requested unchanged-tree baseline verify conflicts with the explicit implementation-first order and single-run budget."
resolution = "Follow the explicit order, claim no baseline execution and record observations here because root GOTCHA.kvx and spec files are out of scope."

[gotcha.2]
symptom = "Large workflow/graph/source outputs were truncated, the graph excludes native Go paths, and an attempted delete/add patch for the same path was refused without applying."
resolution = "Read bounded file sections and actual native sources directly after graph lookup, then replace the task-owned script in place; no gate was run during partial implementation."

[gotcha.3]
symptom = "A copied all-architecture WASM checksum list would require absent arm64 libraries in the pinned x86-64 runtime, and a build-source glob could include a directory."
resolution = "Use the owning paxd image's exact three-library digest selection, retain source hashes for those library bytes, and include only regular build-input files; keep the original ELF architecture/size/linkage bounds."

[gotcha.4]
symptom = "The node owner already implements canonical committed health, but native readiness still refuses the current no-reactor Autobahn catching_up=true response."
resolution = "Reuse the real health implementation unchanged, retain fail-closed readiness and name the consensus owner interface request instead of weakening its check."
