[format]
policy = "No Python or KVX formatter is configured for these paths. Apply .editorconfig UTF-8, LF, final-newline and trailing-whitespace conventions; JSON uses two-space indentation."

[gotcha.1]
observed = "do_5 requests baseline verification, while the controlling order prohibits testing before complete implementation and permits verify only through hf-done after hf-build."
resolution = "Follow the explicit gate order; claim no baseline execution or failing tests. GOTCHA.kvx and spec files are out of scope, so record the conflict here."

[gotcha.2]
