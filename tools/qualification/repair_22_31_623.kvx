baseline_reconciliation = "Preserve the original 267 failures and one error verbatim as 268 baseline entries. Attempt 3 reported 23 failures, 4427 passed, 12 skipped and 52 subtests passed. The continuation inventory records all 23 remaining cases separately without changing the historical baseline or running an extra baseline gate."
scope = "Preserve the carried implementation and complete the explicitly authorized producer settlements; the do_8 local full-suite runs precede the bounded hf-build and hf-done pair, and the runner owns publication."
build_command = "python3 -m pip install -q -r tools/qualification/requirements.txt && python3 -m pytest -q --collect-only tools/qualification > /dev/null && python3 -m py_compile tests/ci/test_qualification_suites_collect.py"
verify_command = "python3 -m pytest -q tools/qualification && python3 -m pytest -q tests/ci/test_qualification_suites_collect.py"
