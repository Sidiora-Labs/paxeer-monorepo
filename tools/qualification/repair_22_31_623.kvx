[implementation]

[implementation.gateway]
producer = "services/platform/hosted/gateway/src/main.rs:KERNEL_VARIABLES"
observation = "The live producer declares the exact eight kernel variables already asserted by the prerequisite repair, configures service identity independently, and refuses a configured kernel without identity. Historical failure.48 is already repaired in the supplied starting tree."
change = "Preserve the exact current assertions, require explicit optional=false on the real receipt-key Secret projection, and assert that invoking the maintained renderer twice leaves the production pod unchanged. Expand the producer and deployment projection blocks for direct review; their runtime values remain intact."
verification = "The complete tools/qualification suite through hf-done; no narrowed run."

[implementation.dependencies]
producer = "tools/launchpad/production/load/requirements.lock"
change = "Declare exact real frozen load dependency closure plus pycryptodome, PyYAML, eth-hash and fastapi used by collected suites. Only hf-build installs them."
verification_ref = "evidence.build"

[implementation.regressions]
path = "tests/ci/test_qualification_suites_collect.py"
tests = ["test_qualification_suites_pass", "test_repair_record_settles_every_baseline_entry"]
proof = "Run the entire tools/qualification directory in a subprocess and require exit zero and a nonempty passing summary. Parse both KVX files, require an exact one-to-one baseline mapping and reason-family grouping with original observations intact, and reject every unresolved entry or settlement lacking successful full-suite revision/command/exit/log evidence."

[gotcha]

[gotcha.scope]
observed = "Attempt 3 authorizes the listed producer repairs. The required SDK refusal-copy JSON is still absent from SCOPE; a precise scope clarification was requested before changing it."
assumption = "Continue the expressly authorized producers and preserve all assertions; leave the excluded SDK JSON unchanged pending a scope answer."

[gotcha.editing]
observed = "A source edit used a guessed wallet serializer path and a script omitted shlex; read the actual producer paths and resumed the scoped edits."
assumption = "Use tools/platform/cli/src/wallet_gateway.rs and explicit imports; no successful gate inferred."

[gotcha.evidence]
observed = "Literal final commit hashes in a content-derived candidate create a self-reference and can claim unrun success."
assumption = "Resolve by-reference proof from actual full-suite subprocess and final gate ledger; no literal success is prewritten."

[gotcha.qualification]
observed = "First full gate exposed exact source moves, required-parser-input ordering, isolated CA HOME omission and supervised startup pins; no full-suite pass resulted."
assumption = "Make one consolidated scoped repair, preserve unrelated producer assertions and qualify the final revision through both gates."

