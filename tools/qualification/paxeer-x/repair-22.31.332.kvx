[meta]
task = "22.31.332"
audit = "22.30.184"
base_revision = "00614466646b07799a236d2742211fd5eb2d85c5"
seed_revision = "bba5fe0828187284a52af14598b5b82a2abdc693"
qualification = "hf-build followed by hf-done; the private gate ledger records the exact candidate revision, command, exit and log. No native lifecycle pass is claimed by this Python gate."
baseline = "No pre-change verify ran: the explicit implementation-first order permits verification only through hf-done after hf-build. No pre-change test failures are claimed. On the continuation base the publisher already uses BindingDocument.core_height and the eleven-field web schema; the unmodified harness still expects core_sequence and the retired six-field web schema."
proof_boundary = "Tests execute production harness code over loopback JSON-RPC, protected JSON file reads and a Unix socket protocol peer, including reopening the Python consumer. Rust publisher/consumer schemas and guards are checked against their real sources. They do not execute Rust enrolment, MCP initialization or a paid request; that native proof requires the out-of-path wiring below."

[finding.binding-core-coordinate]
tests = ["test_binding_core_coordinate_producer_consumer_contract", "test_binding_core_coordinate_json_file_reopens", "test_binding_core_coordinate_refuses_wrong_numeric_encoding", "test_binding_core_coordinate_refuses_retired_missing_or_changed_height"]
repair = "Retain the publisher's existing u64 core_height from enrolment on both publication and validation; require the same key, exact enrolled height and unsigned JSON integer encoding in the harness, rejecting booleans, strings, negative values and overflow. The native harness still restarts both processes, checks unchanged files and reinitializes MCP through the emitted file."
native_proof = "Not executed by the Python-only gate; source contract checks and Python coordinate-file recovery are qualified separately from the requested native enrol-to-file-to-MCP restart path."

[finding.binding-web-authority]
tests = ["test_binding_web_authority_producer_consumer_contract", "test_binding_web_authority_preserves_landed_constructor_and_authority_guards", "test_binding_web_authority_real_rpc_reference_and_reopen", "test_binding_web_authority_changed_reference_refused", "test_binding_web_authority_rpc_shape_refused", "test_binding_web_authority_configuration_refused", "test_binding_web_authority_environment_transport", "test_binding_web_authority_unix_client_initializes_and_reconnects", "test_binding_web_authority_initialization_refusals", "test_binding_web_authority_native_harness_retains_actual_lifecycle_checks"]
repair = "Preserve the landed nine-argument constructor and MCP eleven-field schema with eip155:125, nonzero payer/receiver addresses, the full governed key index, selected sequencer id and inclusive bounded batch range. The constructor attaches WebAuthority from the selected node-resolved key, validating 1 to 64 nonzero unique keys and ordered covering ranges. WebDeclaration.with_authority retains the payment parties, full index, sequencer id and public-key pin and permits only range narrowing. A declaration without authority cannot publish. Existing document and secret equality checks still refuse changed authority after restart."
configuration = "Require LAYERX_AGENT_MCP_WEB_PAYER_ADDRESS, LAYERX_AGENT_MCP_WEB_RECEIVER_ADDRESS, LAYERX_AGENT_MCP_WEB_FIRST_BATCH_NUMBER and LAYERX_AGENT_MCP_WEB_LAST_BATCH_NUMBER alongside the existing numeric receipt-key selector. The harness fetches the real px_getReceiptKeys wire shape, keeps its numeric heights and normalizes its two 0x-prefixed hashes to the MCP document's bare hex."
fixture = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json, V1-pax-transfer pinnedKey and chain/address fields, generated by rpc/sequencer_receipt_vectors_test.go; no signature, key or receipt bytes are invented. The Unix peer exercises only the real Python framing and response checks."
native_proof = "The native harness now initializes and lists enrolled paid tools before and after reopening the same emitted file, checks unchanged binding/token/bearer inodes and hashes, and refuses changed payer, receiver, key selector or range. This path is not run by the declared Python gate and remains dependent on the host wiring below."

[wiring.1]
request = "Domain 9 agent host, services/agent/crates/layerx-agentd/src/main.rs:mcp_web: parse LAYERX_AGENT_MCP_WEB_FIRST_BATCH_NUMBER and LAYERX_AGENT_MCP_WEB_LAST_BATCH_NUMBER and narrow the constructor's attached full-key-range authority through WebAuthority::new and with_authority; the landed host already supplies signed_authority keys, key selection, explicit payer/receiver addresses and eip155:125, but does not yet read the two range settings, so native configured-range and changed-range proofs remain pending that wiring."

[wiring.2]
request = "Domain 9 MCP, services/agent/crates/layerx-mcp/tests/binding_heights.rs: extend the Rust-owned gate to run actual enrolment, Binding::open initialization and restart with the emitted web document and attached payer/approval authority, including refusal of changed parties, key and range; a Python source assertion is not native lifecycle evidence."

[wiring.3]
request = "Domain 9 agent host and MCP, services/agent/crates/layerx-agentd/src/main.rs and services/agent/crates/layerx-mcp/src/bin/layerx-mcp.rs: supply the authenticated readiness declaration and daemon-owned paid-tool authority on the current open_daemon_client route; the legacy no-payer startup refusal is no longer an assertion about that route, so the harness explicitly removes payer_address to prove required-document-field refusal."

[gotcha.1]
observed = "The task's baseline request conflicts with its explicit implementation-first gate order and one verify budget."
resolution = "Follow the explicit order and record static baseline observations without inventing a baseline run."

[gotcha.2]
observed = "py_compile writes bytecode even when PYTHONDONTWRITEBYTECODE is set; directory-scoped candidates can accidentally carry compiled caches."
resolution = "Run both bounded gates with a private PYTHONPYCACHEPREFIX outside the repository, keeping the final candidate source-only."

[gotcha.3]
observed = "The environment loader and native MCP initialization tests are outside scope, while the declared Python-only gate forbids the Rust/native runtime needed for an actual publisher-to-MCP lifecycle proof."
resolution = "Keep missing authority fail-closed, preserve the current host API and attached authority, leave explicit owner wiring requests, and distinguish executed Python transport proofs from Rust source checks and unexecuted native paths."

[gotcha.4]
observed = "Reapplying the seed onto the continuation base left eight conflict hunks beside the landed governed web constructor; choosing the seed alone would remove the current payment parameters and chain-125 checks."
resolution = "Resolve every marker by keeping the current nine-argument API and strict validations, integrating the seed's typed bounded authority beside them, and retaining every existing assertion with additional constructor, zero-address and wrong-chain coverage."
