[meta]
task = "22.33.703"
audit = "22.30.169"
base_revision = "0d67b10a1307bd87573ba79cf46b7f9c0337f7e3"
qualification = "hf-build then hf-done; the private gate ledger and final evidence line record the verified candidate revision, exact command, exit code and private log location."
baseline = "The supplied previous-attempt gate reported 38 passed and two failures: test_committed_recording_is_the_real_producers_signed_receipt and test_unknown_recovers_committed_receipt_across_stop_and_reopen. No additional unchanged-tree test ran: the explicit Order forbids early testing or running verify_cmd outside hf-done."
proof_boundary = "The production Phase.rpc, Phase.unknown and receipt evidence validators consume real HTTP/1.1 framing and JSON from a loopback recording of the committed Rust dispatch producer. The gate does not execute native Agentd/MCP, qualify their crash durability, or independently verify a consensus header; those checks still belong to the pinned native process qualification."

[finding.mcp-recovery-rung-contract]
tests = ["test_committed_recording_is_the_real_producers_signed_receipt", "test_unknown_recovers_committed_receipt_across_stop_and_reopen", "test_pending_restart_preserves_unknown_without_receipt_or_transmission", "test_verified_rpc_accepts_current_committed_rung", "test_verified_rpc_rejects_retired_pending_and_unverified_rungs", "test_receipt_lookup_keeps_every_credential_coordinate", "test_restart_rejects_misbound_submission", "test_recovery_rejects_missing_or_misbound_receipt_and_header", "test_real_http_transport_refuses_cross_tenant_tracking"]
repair = "Consume achieved.rung, the current flat track submission, and program.receipt found/receipt responses. Bind the retained transaction and reference across restart, require consistent submission/response/receipt rungs, and compare the canonical successful receipt digest and state roots with receipt_ref and authorised_batch header metadata. Reject retired levels, pending verification, malformed/missing receipts, foreign identities and inconsistent header evidence."
producer = "services/agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs MIDDLEWARE_SUBMISSION_TRANSCRIPT is pinned by SHA-256 5b366b9ce6190ee46c6b8ab5808312a41f794397185c531b88b7dd4669c9546a for its recorded payload shapes and unchanged signed receipt. The real Python SDK verifies that receipt against its raw transaction and pinned receipt key and supplies receipt_digest as the regenerated fixture's receipt_ref. The native vector's stale reference is never used as protocol authority."
transport = "The real HTTP.rpc_request client sends POST /rpc with Host, Content-Length and canonical JSON envelopes; credentials remain in the envelope. The recorded peer returns the current success_body envelope and decode_tracked/decode_receipt_lookup payload shapes, never replacing the qualifier's transport or validation methods."
recovery = "The qualifier stops/reopens the actual loopback server over its fsynced private send ledger; a newly constructed peer and qualifier recover the identical receipt without another submit. Pending and rejected evidence preserve one recorded economic transmission. Original executable/source identity, tenant and session isolation, native transmission-count, process kill/restart and durable invocation checks remain intact."

[wiring.1]
request = "Domain 16 Agentd fixture owner: provision mcp_revocation.unknown_receipt_request in the protected PAXEER_X_AGENTD_UPSTREAM_ARTIFACTS manifest consumed by tools/qualification/paxeer-x/fixtures/agentd_fixture.py, using program.receipt with the original credential/idempotency_key, expected_activity_id and requested_rung; replay the same transcript through services/agent/crates/layerx-agentd/src/human_runtime.rs in the native crash/restart gate. External fixture manifests and that domain's runtime are outside this task's write scope."

[wiring.2]
request = "Domain 16 Agentd owner: align services/agent/crates/layerx-agentd/src/human_runtime.rs write_submission and services/agent/crates/layerx-agentd/src/agent_rpc_dispatch.rs MIDDLEWARE_SUBMISSION_TRANSCRIPT receipt_ref with services/agent/schema/agent-api/read.kvx's unsigned receipt domain digest; these paths are outside this task's scope."

[gotcha.1]
observed = "The task requests a pre-change verify but forbids both early testing and direct verify_cmd execution."
resolution = "Follow the explicit bounded gate order; document static observations without claiming a baseline test result."

[gotcha.2]
observed = "py_compile can leave bytecode under the directory-scoped candidate."
resolution = "Point PYTHONPYCACHEPREFIX outside the checkout for bounded gates so generated bytecode is not published as source."

[qualification.initial]
revision = "fa244a74517b9d09ed5a00cca8d8e6726a4c13f1"
command = "cg spec done 22.33.703 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "37 failures: tests named the wrong dynamically imported Failure class, and receipt_ref is the protocol domain digest of the complete signed bytes rather than the untagged SHA-256."
assumption = "Use the exact READINESS.HTTP.Failure type and human_runtime::write_submission receipt_digest(canonical_bytes) contract; retain all refusal cases and exact digest equality."

[gotcha.3]
observed = "The prior signed-byte assumption in qualification.initial contradicts read.kvx: both the complete signed-byte digest and the native dispatch vector's reference differ from the unsigned receipt domain digest."
resolution = "Supersede that assumption with the product contract: decode the complete receipt with the real SDK codec, hash domain plus canonical unsigned bytes, and retain exact equality with detailed mismatch inputs."

[continuation]
regenerate_command = "python3 tools/qualification/paxeer-x/fixtures/mcp_recovery_recording.py"
recording = "fixtures/mcp_recovery_transcript.json is generated by the real qualifier's Phase.rpc and Phase.unknown HTTP recovery path over the pinned source payloads, with receipt_ref supplied by verify_sequencer_receipt's cryptographically verified digest; it is never edited by hand."
proof = "The declared test independently reconstructs canonical None(signature), derives sha256(domain plus unsigned bytes), asserts equality with both the SDK producer digest and recorded submission, and prints both values and complete preimages on mismatch. Recovery asserts exact equality of recorded requests, responses and observable result, then reopens the peer and checks one retained transmission. Malformed signature framing is additionally refused."
evidence = "hf-build and hf-done capture this unchanged candidate's revision, exact command, exit and private log in /out/run/gates.jsonl; the final response copies the hf-done evidence line. No post-gate source or record edits are required."
