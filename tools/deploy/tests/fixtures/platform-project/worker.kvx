[service.worker]
kind = "image"
image = "platform-worker"
health = "/healthz"
restart = "ON_FAILURE"
replicas = 2
order = 2
needs = ["store"]

[vars.worker]
PORT = "8080"
DATABASE_URL = "${{store.DATABASE_URL}}"
PROVIDER_KEY = "env:PLATFORM_WORKER_PROVIDER_KEY"
SIGNING_KEY = "env:PLATFORM_WORKER_SIGNING_KEY"

[inputs.worker]
# Provider API key: a string issued by the provider.
PLATFORM_WORKER_PROVIDER_KEY = "provider"
# Chain signing key: a hexadecimal private key.
PLATFORM_WORKER_SIGNING_KEY = "chain"
