[restoration.path_1]
path = "README.md"
source_revision = "8742bd00eb3acc490f28e5d26038636590216955"
sha256 = "188d8c138efd7e35992f0a390886bd129a05322d55cd00f9a3f1c43cc6e28d1b"
text = "The pre-merge `layerxVerify` (`0x1012`) and `layerxCustody` (`0x1013`) interfaces are retired at the merge. `layerxAnchor` (`0x1014`) rejects writes after the merge; its remaining historical views retire at `v7.0-anchor-store-delete`. See the retirement gates in [`precompiles/layerxverify`](precompiles/layerxverify/), [`precompiles/layerxcustody`](precompiles/layerxcustody/) and [`precompiles/layerxanchor`](precompiles/layerxanchor/). These are retired refusal surfaces retained for compatibility, not active funding or checkpoint executors. They return retirement errors (including `LXP_MODULE_DISABLED`) at their applicable upgrade gates. Historical anchor reads before store deletion are archive-only; they do not provide current funding or finality paths. The external native bridge at `0x1016` remains distinct from retired kernel custody: outward transfers use its native `bridgeOut` interface."
pinning_cases = ["tools/qualification/audit_repairs/test_repair_22_33_404.py", "tools/qualification/audit_repairs/test_repair_22_33_508.py", "tools/qualification/audit_repairs/test_repair_22_33_581.py", "tools/qualification/audit_repairs/test_repair_22_33_592.py", "tools/qualification/audit_repairs/test_repair_22_33_707.py", "tools/qualification/audit_repairs/test_repair_22_33_894.py"]
symbols = ["layerxAnchor", "layerxCustody", "layerxVerify", "layerxanchor", "layerxcustody", "layerxverify"]
citation = "Decisions 3125 and 3173 retain the retirement and archive statements pinned by tools/qualification/audit_repairs/test_repair_22_33_404.py and the five other README digest cases (508, 581, 592, 707 and 894), rather than invoking retired executors."

