[finding.24]
tests = ["TestRepairM_1106_PersistedHeightAndTimestamp", "TestRepairM_1106_UnproducedRowsFailQualification", "TestRepairM_1106_RemovedRowsFailQualification", "TestRepairM_1106_OutOfIntervalTimestampsFailQualification"]
path = "Production EventSink IndexBlockEvents and IndexTxEvents write through database/sql to the committed embedded SQLite fixture using schema.sql; the same scanned height and timestamp helpers qualify the PostgreSQL integration suite and the focused repair tests."
height = "Both expected heights are actually produced; queries bind the expected height and chain, scan the returned height, and compare it with producer input."
timestamp = "Scan persisted timestamps in blocks, tx_results and tx_events and require them within the measured indexing interval; created_at is sink write time, not header time."
negative = "Removing the expected block, transaction or view-producing events makes the shared qualification return sql.ErrNoRows even with another height present; unproduced heights and chains and timestamps outside both bounds also fail."
