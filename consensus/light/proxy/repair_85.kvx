[finding.11]
repair = "Delegate proxyService.ABCIInfo to p.Client.ABCIInfo so the registered endpoint forwards the real application result or returns a typed transport refusal."
tests = ["TestRepair_85_ABCIInfoRoundTrip", "TestRepair_85_UnavailableProviderRefusal"]
proof = "The real kvstore application finalizes and commits transactions; the core Environment handler serves its Info result over JSON-RPC HTTP into the real HTTP and light RPC clients. Proxy.listen registers and starts the proxy endpoint; a second real HTTP client asserts every ResponseInfo field at two committed heights. Closing the provider proves the upstream transport fails and the proxy consumer receives RPCError CodeInternalError with no result. No light verifier is needed for the unproved ABCIInfo forwarding method."
