acceptance = "22998.1"
findings = ["grpc-concurrent-filepv", "grpc-chain-boundary", "grpc-vote-chain-argument"]
baseline = "Not run: the explicit ordered gate instructions prohibit verification before implementation and restrict verification to hf-done after hf-build; no baseline failures are claimed."
evidence = "The runner records the candidate revision, exact commands, exits and private log paths in its gate ledger; final response copies the last gate evidence."
