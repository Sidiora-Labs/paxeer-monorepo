[finding.grpc-concurrent-filepv]
repair = "One SignerServer mutex serializes the complete PrivValidator signing call across votes and proposals, including FilePV state comparison and durable save; socket transport is untouched."
test = "TestRepair_171_ConcurrentFilePV"
proof = "Thirty-two conflicting real TCP gRPC requests for votes, proposals and mixed methods; verify at most one signature per HRS, stop server, reopen FilePV, match durable canonical bytes and signature, replay accepted history and refuse conflicts."

[finding.grpc-chain-boundary]
repair = "GetPubKey, SignVote and SignProposal reject a chain different from the configured chain with InvalidArgument before accessing PrivValidator."
test = "TestRepair_171_ServerChainBoundary"
proof = "Raw generated RPC client bypasses SignerClient checks; wrong and empty chains cannot advance a seeded disk HRS; stop and reopen recovers the accepted state and signs the next intended-chain height."

[finding.grpc-vote-chain-argument]
repair = "Both SignerClient signing methods reject an argument that differs from the client configuration with InvalidArgument before issuing the RPC."
test = "TestRepair_171_ClientChainArgument"
proof = "Real client/transport/FilePV signatures verify only for the requested chain; mismatches preserve caller messages and disk state even when the remote server accepts the mismatched chain."

[gotcha.gate-order]
observed = "Task step 7 requests an unchanged-tree verify, contradicting the explicit implementation-first order and hf-done-only verification budget."
resolution = "Follow the explicit gate order; record baseline as unrun rather than inventing failing evidence."

