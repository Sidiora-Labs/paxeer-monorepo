[gotcha.22.31.90]
observed = "Splitting compact event names cannot resolve type/key dot collisions or reconstruct repeated event grouping; converting byte values to JSON strings also loses non-UTF-8 bytes."
repair = "Carry structured ABCI events with base64 attribute bytes in an explicitly versioned extension."

