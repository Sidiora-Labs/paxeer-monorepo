observed = "The first verification at 64d14222607881caf3149c717b66180eee450d02 failed the new subscription test's exact payload assertion because a zero header's nil hex-byte hashes decode as empty slices. Event metadata equality passed."
repair = "Supply a populated header with nonempty hashes and retain the exact payload and event equality assertions."
