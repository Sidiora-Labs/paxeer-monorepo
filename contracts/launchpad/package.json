{
  "name": "kindle-contracts",
  "version": "2.0.0",
  "private": false,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:paxeer": "hardhat run scripts/deploy.js --network paxeer-x-network",
    "verify:paxeer": "hardhat run --no-compile scripts/verify.js --network paxeer-x-network",
    "lint:sol": "solhint 'contracts/**/*.sol' --config .solhint.json",
    "lint:js": "eslint 'scripts/**/*.js' 'test/**/*.js' --ext .js",
    "format": "prettier --write 'contracts/**/*.sol' 'scripts/**/*.js' 'test/**/*.js'",
    "format:check": "prettier --check 'contracts/**/*.sol' 'scripts/**/*.js' 'test/**/*.js'",
    "gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "slither": "slither . --config-file slither.config.json",
    "clean": "hardhat clean && rm -rf coverage",
    "clean:all": "pnpm clean && rm -rf node_modules artifacts cache",
    "meta-ag:test": "hardhat test --grep meta-ag",
    "meta-ag:coverage": "hardhat coverage --testfiles \"test/meta-ag/**/*.test.js\"",
    "meta-ag:gas": "REPORT_GAS=true hardhat test --grep meta-ag",
    "meta-ag:lint": "solhint \"contracts/meta-ag/**/*.sol\" --config .solhint.json",
    "meta-ag:layout": "node scripts/meta-ag/snapshot-storage-layout.js",
    "meta-ag:layout:check": "node scripts/meta-ag/check-storage-layout.js",
    "health": "node scripts/production-health.js",
    "release:check": "node scripts/release-check.js",
    "release:qualify": "node scripts/release-qualify.js"
  },
  "devDependencies": {
    "@fastify/busboy": "^3.2.2",
    "@bonadocs/docgen": "1.0.1-alpha.6",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "eslint": "8.57.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.6",
    "hardhat-gas-reporter": "^2.3.0"
  },
  "author": "Sidiora",
  "license": "GPL-3.0",
  "dependencies": {
    "prettier-plugin-solidity": "^2.3.1",
    "solhint": "^6.2.1",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-docgen": "0.6.0-beta.36",
    "viem": "^2.47.10"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "overrides": {
      "@fastify/busboy@<3.2.2": "^3.2.2",
      "adm-zip@<0.6.1": "^0.6.1",
      "axios@<1.20.0": "^1.20.0",
      "brace-expansion@<5.0.9": "^5.0.9",
      "cookie@<0.7.0": "^0.7.0",
      "fast-uri@<3.1.9": "^3.1.9",
      "follow-redirects@<1.16.0": "^1.16.0",
      "form-data@<4.0.6": "^4.0.6",
      "glob@<14.0.2": "^14.0.2",
      "handlebars@<4.7.9": "^4.7.9",
      "immutable@<4.3.9": "^4.3.9",
      "js-yaml@<4.3.2": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "minimatch@<11.0.1": "^11.0.1",
      "picomatch@<4.0.4": "^4.0.4",
      "qs@<6.16.1": "^6.16.1",
      "serialize-javascript@<7.1.3": "^7.1.3",
      "tmp@<0.2.6": "^0.2.6",
      "undici@<6.29.1": "^6.29.1",
      "uuid@<11.1.1": "^11.1.1",
      "ws@<8.21.0": "^8.21.0",
      "elliptic": "npm:@mapped/elliptic@6.6.10"
    }
  }
}
