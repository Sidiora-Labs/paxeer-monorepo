[repair.22.31.478]
acceptance = "22998.1"
base_revision = "71ea2b5cfcf9fa483db0ed65d0630e08bca86d9f"
kernel_allowance = 10000000
cpu_allowance = 1000000
measurement = "The declared Go gate executes the historical and candidate ABI5 guests under CPU budget 1000000 and kernel allowance 10000000. The attempt-9 before measurement is the recorded stop at 999968, not a completed cost. Exact completed candidate fuel and verified revision are retained in programs/target/repair-478/measurement.kvx. The Rust FUND row independently runs the candidate guest through Executor::declared and DeclaredBudget::protocol_maximum over the exact current state, request and real kernel balance observation transported by Go."
before = "Attempt 9 stopped at consumed CPU fuel 999968 against its 1000000 CPU cap (gotcha 3246). This is the authorized before measurement; no over-cap call or completed historical measurement is claimed."
after = "programs/target/repair-478/measurement.kvx records after_cpu_fuel from successful production Fund, its result code and verified revision. The Go gate asserts the fuel is below 1000000 and 999968, exact next state, one deposit and actual balance 100; the Rust FUND row asserts independent executor success, exact result, event, state and transfer and equal CPU fuel."
cause = "Fund entered the general view, decoding the full policy, joint reputation/admission state and F06 dictionary, epoch rows and refund record before depositing into the ledger head. The retained repairs already removed repeated carry_reputation serialization and reused the SDK rewards-account binding. The dedicated FundingView now decodes the market header, shared framing/control replay table and F06 ledger head; it reads only framing and immutable epoch/roster bindings from carried sections. Fund never constructs a fully validated RewardState from opaque regions and never decodes or validates their dictionary entries, epoch rows or refund cursor. Commit encodes the changed ledger head, market revision and replay table, carrying every other byte and binding hash unchanged. First funding writes the empty reward suffix directly once, avoiding an intermediate initialized layout and its copy. Full decoders remain strict for transitions that own those regions; both production allowances are unchanged."
changed_files = ["programs/Cargo.lock", "modules/lxphost/host.go", "modules/lxphost/simulate.go", "modules/lxphost/ctx.go", "programs/crates/layerx-programs-ai-market/Cargo.toml", "programs/crates/layerx-programs-ai-market/src/lib.rs", "programs/crates/layerx-programs-ai-market/src/dispatch.rs", "programs/crates/layerx-programs-ai-market/src/rewards.rs", "programs/crates/layerx-programs-ai-market/src/registry.rs", "programs/crates/layerx-programs-ai-market/src/value_adapter.rs", "programs/crates/layerx-programs-ai-market/tests/fuel_budget.rs", "programs/crates/layerx-programs-ai-market/tests/support/repair_478_fixture.rs", "programs/crates/layerx-programs-ai-market/examples/repair_478_fixture.rs", "rpc/repair_478_test.go", "rpc/repair_478.kvx"]
proof = "The Go regression deploys real ABI5 guests, registers the derived rewards account, executes CREATE and Fund with the real prior receipt supplying balance sight. It checks exact producer-generated state, one deposit and actual balance. Every Fund logs status, terminal response and the decoded registered application error. The Rust unit decodes the canonical kernel terminal; the FUND fuel-table row independently executes the transported candidate guest and pre-Fund state under the protocol maximum. Existing populated-region, replay, wrong epoch/roster and corruption assertions remain enforced."
verified_revision = "The declared gate writes the verified candidate revision with the before/after CPU measurements to programs/target/repair-478/measurement.kvx; qualification requires hf-build and hf-done at that same revision. No successful Fund measurement is claimed before that gate passes."

