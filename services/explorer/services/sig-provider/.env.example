# Signature provider environment inputs and settings-type defaults.
# SIG_PROVIDER__CONFIG optionally selects a configuration file.
# Environment values override the corresponding file section and key.
# Commented entries stay unset or retain their source endpoint defaults.

RUST_LOG=info
# SIG_PROVIDER__CONFIG=
# SIG_PROVIDER__JAEGER__AGENT_ENDPOINT=
SIG_PROVIDER__JAEGER__ENABLED=false
# SIG_PROVIDER__METRICS__ADDR=
SIG_PROVIDER__METRICS__ENABLED=false
SIG_PROVIDER__METRICS__ROUTE=/metrics
# SIG_PROVIDER__SERVER__GRPC__ADDR=
SIG_PROVIDER__SERVER__GRPC__ENABLED=false
# SIG_PROVIDER__SERVER__HTTP__ADDR=
# SIG_PROVIDER__SERVER__HTTP__BASE_PATH=
SIG_PROVIDER__SERVER__HTTP__CORS__ALLOWED_CREDENTIALS=true
SIG_PROVIDER__SERVER__HTTP__CORS__ALLOWED_METHODS='PUT, GET, POST, OPTIONS, DELETE, PATCH'
SIG_PROVIDER__SERVER__HTTP__CORS__ALLOWED_ORIGIN=
SIG_PROVIDER__SERVER__HTTP__CORS__BLOCK_ON_ORIGIN_MISMATCH=false
SIG_PROVIDER__SERVER__HTTP__CORS__ENABLED=false
SIG_PROVIDER__SERVER__HTTP__CORS__MAX_AGE=3600
SIG_PROVIDER__SERVER__HTTP__CORS__SEND_WILDCARD=false
SIG_PROVIDER__SERVER__HTTP__ENABLED=true
SIG_PROVIDER__SERVER__HTTP__MAX_BODY_SIZE=2097152
SIG_PROVIDER__SOURCES__ETH_BYTECODE_DB__ENABLED=true
# SIG_PROVIDER__SOURCES__ETH_BYTECODE_DB__URL=
# SIG_PROVIDER__SOURCES__FOURBYTE=
SIG_PROVIDER__SOURCES__PRECOMPILES__ENABLED=true
# SIG_PROVIDER__SOURCES__SIGETH=
SIG_PROVIDER__TRACING__ENABLED=true
SIG_PROVIDER__TRACING__FORMAT=default
