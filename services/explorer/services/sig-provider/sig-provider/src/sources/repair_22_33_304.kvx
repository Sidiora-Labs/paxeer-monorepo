[repair.22.33.304]
mode = "BUILD"
scope = "sig-provider/src/sources, sig-provider/tests/repair_22_33_304.rs, workspace Cargo.lock"
allowed_gates = "hf-build then hf-done, with at most two task-scoped repair cycles"
stop_condition = "hf-done passes or the bounded repair/time budget is exhausted; final exact evidence comes from the private runner ledger"
fourbyte-pagination-bound = "fourbyte_pagination_accepts_relative_and_same_origin_pages; fourbyte_pagination_rejects_cycles_malformed_origins_and_redirects; fourbyte_pagination_bounds_pages_and_total_deadline; fourbyte_lookup_retries_only_transient_status_and_preserves_event_path"
fourbyte-import-status = "imports_require_http_success_and_declared_acceptance; imports_retry_transient_failures_with_identical_production_payloads; service_import_dispatches_real_adapters_to_rejecting_upstreams"
sigeth-import-status = "imports_require_http_success_and_declared_acceptance; imports_retry_transient_failures_with_identical_production_payloads; service_import_dispatches_real_adapters_to_rejecting_upstreams"
precompile-inventory-test = "precompile_inventory_exact_selector_signature_coverage; producer_path::precompile_table_coverage_matches_versioned_node_inventory; producer_path::precompile_table_coverage_current_and_historical_calldata_over_http; producer_path::precompile_table_coverage_current_events_and_batch_over_http"
producer_transport_consumer = "Real directory Source adapters consume loopback HTTP transcripts, including status, JSON result and Retry-After; actual generated routes mount production Service and SourceAggregator; actual ethabi encodes producer ABI calldata and consumes mounted decode replies"
baseline = "No baseline run: initial ledger had zero builds/verifies and no source repair; ordered instructions prohibit testing before implementation and running verify manually, so no pre-change failures are claimed"
inventory = "In-process reconstruction from the declared versioned and merge ABI inventory, checked against precompiles/setup.go, plus exact canonical ABI and selector/signature equality; existing mounted-service proofs execute inside the required integration target"
wiring_import_errors = "services/explorer/services/sig-provider/sig-provider/src/aggregator.rs and sig-provider-server/src/service.rs: domain 14 must propagate adapter Err through aggregation and replace fire-and-forget import acknowledgement with an observable lifecycle result; these out-of-scope consumers currently discard errors"
wiring_backend_adapter = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/sig_provider_interface.ex and its ExUnit tests: domain 14 must execute current producer calldata against the mounted service through the actual Elixir adapter; Rust proof covers its HTTP DTO contract only and cannot execute Elixir in this gate"
wiring_task_record = "spec/layerx-merge/spec.kvx task 22.33.304: domain 14 must copy this finding/test mapping, baseline conflict and runner qualification evidence into the task record; spec edits are prohibited in this sandbox task"
evidence = "hf-build/hf-done record exact candidate revision, command, exit and private log path outside the published sources; final response copies the terminal ledger evidence"
gotcha_baseline = "The unchanged-tree verify requested by step 8 conflicts with the ordered implementation-first single-gate rule; obey the ordered gate and do not invent baseline evidence"
gotcha_lifecycle = "Import adapter errors reach the real aggregator but its proxy logs/discards them, while the service acknowledges before asynchronous execution; both required lifecycle changes are outside this scope"
