[repair.22.33.305]
mode = "BUILD"
scope = "sig-provider/src, sig-provider/tests/repair_22_33_305.rs, sig-provider/Cargo.toml, workspace Cargo.lock"
allowed_gates = "hf-build then hf-done; at most two repair cycles; exact terminal evidence in private runner ledger"
stop_condition = "hf-done passes, repair budget is exhausted, or the task's enforced wall clock expires"
signature-errors-hidden = "all_capable_failures_remain_unavailable_through_aggregation_and_service; successful_misses_and_partial_results_preserve_source_coverage; batch_fallback_reads_the_real_directory_and_rejects_malformed_complete_rows; import_refusal_is_not_hidden_by_local_or_successful_sources"
event-indexed-layout = "producer_path::producer_backed_swap_preserves_layout_over_http; embedded_event_metadata_is_exact_in_single_and_mixed_batch_results; unknown_indexed_layouts_are_explicit_candidates_including_the_producer_order"
signature-collision-fixture = "producer_path::precompile_signature_ranks_first: executeStopLossOrder(uint256) and collisionFixture762890(uint256) canonically hash to 1a617148; real ABI encoders produce identical calldata; PrecompileSource, fourbyte HTTP adapter, aggregator, production Service and generated HTTP route preserve local priority"
producer_transport_consumer = "Production ABI encoders, PrecompileSource, sigeth/fourbyte/eth-bytecode-db clients, aggregator, included production Service and generated HTTP routes consume committed ABI/transcript fixtures through loopback TCP; no public endpoint, environment variable, credential, subprocess or mocked component is needed by these proofs"
coverage = "Typed LookupUnavailable and ImportRefused retain per-source outcomes; with_coverage APIs expose successful, failed and outside-coverage outcomes on partial answers; finite local misses never mask capable remote failures; malformed complete batch lengths are source failures; default batch adapters execute real lookups"
event_metadata = "The prerequisite already exposed embedded full event ABI descriptions; the repair retains those exact layouts, rejects trailing bytes and emits every exact-roundtrip signature-only permutation as EventLayout::Candidate rather than the first guess; reaching the existing combination bound is an explicit error, never silent truncation"
baseline = "No pre-change verify ran: the initial ledger had zero builds/verifies and no source repair; ordered instructions prohibit testing before implementation or running verify_cmd manually, so no baseline failure is claimed"
wiring_service = "services/explorer/services/sig-provider/sig-provider-server/src/service.rs, owning domain 14: map typed LookupUnavailable to gRPC Unavailable/HTTP 503 instead of the existing Internal/500; transport report coverage and EventLayout::Candidate alongside ABI candidates while preserving the frozen API contract through an explicit versioned extension"
wiring_backend = "services/explorer/backend/apps/explorer/lib/explorer/smart_contract/sig_provider_interface.ex and its tests, owning domain 14: consume the versioned coverage/layout extension, retain partial-coverage and candidate semantics, and distinguish unavailable from unknown; Rust gate proves the current DTO path but cannot execute Elixir"
wiring_spec = "spec/layerx-merge/spec.kvx task 22.33.305, owning domain 14: copy this finding-to-test map, baseline conflict, wiring requests and exact runner qualification evidence into the task record; this sandbox forbids editing spec files"
wiring_gotchas = "GOTCHA.kvx, owning workflow domain: copy the baseline-order conflict and any terminal qualification blocker from this in-scope record; the root gotcha ledger is outside the task's allowed paths"
evidence = "The final hf-build/hf-done JSON names the deterministic candidate revision, exact command, exit code and access-controlled log path; no passed gate is claimed in advance"
gotcha_baseline = "Step 7 asks for an unchanged-tree verify while the explicit Order requires full implementation before any test and forbids manual verify; follow the ordered bounded gates and never invent baseline evidence"
gotcha_collision = "cancelOrder(bytes32) and cancelOrder(uint256) do not collide; canonical hashes and encoder-produced identical calldata are asserted before source or ranking expectations"
qualification_build_1 = "612550ed0eeab15e8028aa599bad01ea72358bbb | cargo build --locked --manifest-path services/explorer/services/sig-provider/sig-provider/Cargo.toml --tests | exit 101 | /out/logs/build-1.log | E0433: production sig-provider-server/src/service.rs:212-213 references config, which the including sig-provider crate does not declare"
build_dependency_repair = "Attempt 2 expands scope to sig-provider/Cargo.toml and workspace Cargo.lock: declare config 0.13 as a dev-dependency, matching the included production server source and reusing the existing locked config 0.13.4 package"
gotcha_service_dependency = "Including a production source file compiles it with the including crate's direct dependencies; the server's config dependency is not inherited by the sig-provider integration/unit test crate"
qualification_status = "Attempt 1 was implemented, not qualified: hf-build failed on the then out-of-scope config dependency and hf-done did not run; attempt 2 repairs that dependency under the explicit continuation ruling and qualifies through hf-build then hf-done, whose private ledger records the terminal result"
