delivery = "The prerequisites now await every writable source and confirm every function and event before success; the restart case asserts storage at both upstreams at acknowledgement, drops the provider runtime, reopens the production service and reads the accepted ABI through its real clients."
production = "Service import and confirmation errors retain the originating source and full error chain; the sigeth fixture emits the complete production acceptance schema instead of an empty result."
wiring_aggregator = "Owner domain 14: services/explorer/services/sig-provider/sig-provider/src/aggregator.rs direct-library create_signatures callers still need error propagation; this service already bypasses that swallowing path and awaits its configured import sources directly."
