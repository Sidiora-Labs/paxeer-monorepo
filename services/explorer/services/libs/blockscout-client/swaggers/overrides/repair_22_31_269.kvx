[repair.22.31.269]
finding = "health-response-shape"
source_revision = "4edaf4fff3f943e154c8337c0bcc16fe4dd9dd3c"
continued_candidate = "198bc6dd09eedad382f1558a91ec832b989de96d"
status = "health overlay and production consumer implemented; qualification evidence is recorded by the bounded gate ledger"
tests = ["health_response_shape_preserves_recorded_blocks", "health_response_shape_preserves_controller_lifecycle", "health_response_shape_requires_complete_models"]
baseline = "Attempt 2 ran the crate-owned repair_22_31_269 target and reported 0 passed, 2 failed: health_response_shape_preserves_recorded_blocks and health_response_shape_preserves_controller_lifecycle. The supplied ruling identifies missing generated metadata.blocks fields, media data and a typed HTTP 500 response. The explicit gate order forbids a separate unchanged-tree verification in this continuation."
schema = "The override declares named object schemas for metadata, blocks, batches and media data, requires healthy in every success and the fields emitted by each indexing subtree, and declares a non-null structured error and metadata in the HTTP 500 UnhealthyHealthCheckResponse schema. Block numbers and timestamps stay strings, including empty values when there are no blocks."
proof = "The existing committed /api/health recording crosses a loopback TCP server, the production HealthApi client, reqwest and the generated HealthCheckResponse codec; strict recursive assertions require blocks, cache.number, node.number and top-level error to survive. The lifecycle matrix exercises typed HTTP 200/500, empty timestamps, structured errors, batches and standalone media output through that same client with no external runtime or database. Every matrix case runs even if another fails."
fixture_provenance = "The healthy recording is crate/tests/recorded/eth_blockscout_com/_api_health.json. crate/tests/health/repair_22_31_269.json contains deterministic contract examples derived from backend/apps/block_scout_web/lib/block_scout_web/controllers/api/health_controller.ex blocks_indexing_status, batches_indexing_status and health, backend/apps/explorer/lib/explorer/chain/health/helper.ex, and the committed API/V1/HealthControllerTest response expectations; these examples are not claimed as newly captured controller transcripts."
wiring_merged_schema = "Domain 14: regenerate services/explorer/services/libs/blockscout-client/swaggers/blockscout-api-final.yaml with ts-src/merge-overrides.ts; that committed output is outside this task's scope, so the merged schema used here was generated in a temporary staging copy. Production health consumer sources are now in scope and regenerated in this candidate."
regeneration_inputs = "A temporary staging copy contains the committed ts-src, swaggers and rust-template-handlebars directories plus openapi-generator-config.json and tsconfig.json. Only health models and health_api.rs are copied back; unrelated hand-maintained client repairs remain intact. No generator, Java, Node or external process is required by the integration gate."
merge_command = "/tmp/repair-22-31-269-tools/node_modules/.bin/ts-node --transpile-only --project /tmp/repair-22-31-269-tools/stage/tsconfig.json /tmp/repair-22-31-269-tools/stage/ts-src/merge-overrides.ts"
generator_command = "/root/.local/share/mise/installs/java/temurin-21.0.13+9.0.LTS/bin/java -jar /tmp/repair-22-31-269-tools/openapi-generator-cli-7.27.0.jar generate -c /tmp/repair-22-31-269-tools/stage/openapi-generator-config.json -i /tmp/repair-22-31-269-tools/stage/swaggers/blockscout-api-final.yaml --skip-validate-spec -g rust -o /tmp/repair-22-31-269-tools/generated --engine handlebars -t /tmp/repair-22-31-269-tools/stage/rust-template-handlebars --type-mappings=integer=i64 --global-property 'apis=Health,models=BatchIndexingStatus:BatchIndexingStatus_latest_batch:BatchIndexingStatus_latest_batch_db:BlockIndexingStatus:HealthCheckError:HealthCheckResponse:HealthCheckResponseMetadata:LatestBlock:LatestBlock_cache:LatestBlock_db:LatestBlock_node:UnhealthyHealthCheckResponse,apiDocs=false,modelDocs=false,apiTests=false,modelTests=false'"
generation_corrections = "The generic model template maps every numeric field to Decimal and empty objects to serde_json::Value. The production health codec keeps code as i64 (the declared int64 JSON integer) and uses HealthCheckResponseData with deny_unknown_fields (the declared empty object with additionalProperties false). These preserve the schema rather than widening it; the lifecycle and completeness tests assert both constraints."
generation_gotchas = "The openapitools.json 7.6.0 pin predates the configured reqwest-trait library; generation therefore uses 7.27.0, as supported by the unpinned Docker script. API documentation generation trips the existing api_doc.handlebars backslash, so this source-only generation selects health sources with API/model documentation and generated test output disabled. The staged ts-node needs the repository's TypeScript 5.4.5 rather than current TypeScript."
compatibility = "repair_22_31_273::transaction_feed_native_items matches the production response parser's FeedItem::Native and FeedItem::Evm; its independent GetTxs200Response assertions still exercise TransactionFeedItem. Health assertions in that target and it_works now read required blocks/latest_block/cache/db/node fields while retaining their original expected values."

wiring_producer = "Domain 14: capture genuine controller transcripts for no-blocks, stale-blocks, rollup and standalone-media branches from services/explorer/backend/apps/block_scout_web; the existing recorded healthy response proves the producer path, while the additional deterministic contract examples alone do not establish new producer execution."
test_registration = "Cargo discovers crate/tests/repair_22_31_269.rs without a manifest edit. That target includes the completeness test from libs/tests/repair_22_31_269.rs, satisfying the required graph path without duplicating test implementations; all three tests and their assertions remain active with committed fixtures."
evidence = "The bounded hf-build and hf-done ledger names the exact candidate revision, command, exit code and private evidence path; this record does not claim a passing gate before that evidence exists."
scope_resolution = "The continuation explicitly adds crate/src and crate/tests to scope. The generated merged swagger remains outside scope and is named in wiring_merged_schema; no specification, manifest, ignore file or unrelated model is edited by this continuation."

continuation_integration = "Resolved seed conflicts while preserving the landed HealthApi REST origin, timeout, bounded response decoding, unsupported v1 route, and native feed page assertions. Status500 retains the landed Box allocation and uses the regenerated UnhealthyHealthCheckResponse. Existing crate-owned health tests retain expected values and use the required regenerated fields. The stale libs/tests/repair_22_31_269.rs was already absent from the supplied base; the graph requires that path to change, so it now owns the completeness test included by the crate target."
continuation_compatibility = "Adapted crate-owned health assertions in repair_22_31_278, repair_22_33_427 and repair_22_33_428 to the required fields without changing expected values; preserve omission of absent block/batch errors when serializing, as the landed exact-roundtrip test requires."
wiring_consumer = "Resolved by attempt 7 scope expansion: services/explorer/services/libs/tests/repair_22_33_430.rs now reads required healthy, metadata, error, blocks, cache, db and node fields directly; all expected values, typed-error checks and transport assertions are retained."

