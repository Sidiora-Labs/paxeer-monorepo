# Smart-contract verifier environment inputs and settings-type defaults.
# SMART_CONTRACT_VERIFIER__CONFIG optionally selects a configuration file.
# Environment values override the corresponding file section and key.
# List and S3 compiler fetchers are alternatives; configure one per family.
# S3 credentials are empty. Commented entries stay unset or retain computed
# defaults. Compiler cache paths follow the system temporary directory.

# CARGO_MANIFEST_DIR=
# OUT_DIR=
RUST_LOG=info
# SMART_CONTRACT_VERIFIER__COMPILERS__MAX_THREADS=
# SMART_CONTRACT_VERIFIER__CONFIG=
# SMART_CONTRACT_VERIFIER__JAEGER__AGENT_ENDPOINT=
SMART_CONTRACT_VERIFIER__JAEGER__ENABLED=false
# SMART_CONTRACT_VERIFIER__METRICS__ADDR=
SMART_CONTRACT_VERIFIER__METRICS__ENABLED=false
SMART_CONTRACT_VERIFIER__METRICS__ROUTE=/metrics
# SMART_CONTRACT_VERIFIER__SERVER__GRPC__ADDR=
SMART_CONTRACT_VERIFIER__SERVER__GRPC__ENABLED=false
# SMART_CONTRACT_VERIFIER__SERVER__HTTP__ADDR=
# SMART_CONTRACT_VERIFIER__SERVER__HTTP__BASE_PATH=
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__ALLOWED_CREDENTIALS=true
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__ALLOWED_METHODS='PUT, GET, POST, OPTIONS, DELETE, PATCH'
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__ALLOWED_ORIGIN=
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__BLOCK_ON_ORIGIN_MISMATCH=false
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__ENABLED=false
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__MAX_AGE=3600
SMART_CONTRACT_VERIFIER__SERVER__HTTP__CORS__SEND_WILDCARD=false
SMART_CONTRACT_VERIFIER__SERVER__HTTP__ENABLED=true
SMART_CONTRACT_VERIFIER__SERVER__HTTP__MAX_BODY_SIZE=2097152
SMART_CONTRACT_VERIFIER__SOLIDITY__COMPILERS_DIR=/tmp/solidity-compilers
SMART_CONTRACT_VERIFIER__SOLIDITY__ENABLED=true
# SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__LIST__LIST_URL=
# SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__ACCESS_KEY=
# Required when this S3 compiler fetcher is selected.
# SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__BUCKET=
# SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__ENDPOINT=
# SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__REGION=
# SMART_CONTRACT_VERIFIER__SOLIDITY__FETCHER__S3__SECRET_KEY=
SMART_CONTRACT_VERIFIER__SOLIDITY__REFRESH_VERSIONS_SCHEDULE='0 0 * * * * *'
# SMART_CONTRACT_VERIFIER__SOURCIFY__API_URL=
SMART_CONTRACT_VERIFIER__SOURCIFY__ENABLED=true
SMART_CONTRACT_VERIFIER__SOURCIFY__REQUEST_TIMEOUT=15
SMART_CONTRACT_VERIFIER__SOURCIFY__VERIFICATION_ATTEMPTS=3
SMART_CONTRACT_VERIFIER__TRACING__ENABLED=true
SMART_CONTRACT_VERIFIER__TRACING__FORMAT=default
SMART_CONTRACT_VERIFIER__VYPER__COMPILERS_DIR=/tmp/vyper-compilers
SMART_CONTRACT_VERIFIER__VYPER__ENABLED=true
# SMART_CONTRACT_VERIFIER__VYPER__FETCHER__LIST__LIST_URL=
# SMART_CONTRACT_VERIFIER__VYPER__FETCHER__S3__ACCESS_KEY=
# Required when this S3 compiler fetcher is selected.
# SMART_CONTRACT_VERIFIER__VYPER__FETCHER__S3__BUCKET=
# SMART_CONTRACT_VERIFIER__VYPER__FETCHER__S3__ENDPOINT=
# SMART_CONTRACT_VERIFIER__VYPER__FETCHER__S3__REGION=
# SMART_CONTRACT_VERIFIER__VYPER__FETCHER__S3__SECRET_KEY=
SMART_CONTRACT_VERIFIER__VYPER__REFRESH_VERSIONS_SCHEDULE='0 0 * * * * *'
SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ENABLED=true
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ERA_EVM_FETCHER__LIST__LIST_URL=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ERA_EVM_FETCHER__S3__ACCESS_KEY=
# Required when this S3 compiler fetcher is selected.
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ERA_EVM_FETCHER__S3__BUCKET=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ERA_EVM_FETCHER__S3__ENDPOINT=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ERA_EVM_FETCHER__S3__REGION=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ERA_EVM_FETCHER__S3__SECRET_KEY=
SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_COMPILERS_DIR=/tmp/zksync-solc-compilers
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_FETCHER__LIST__LIST_URL=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_FETCHER__S3__ACCESS_KEY=
# Required when this S3 compiler fetcher is selected.
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_FETCHER__S3__BUCKET=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_FETCHER__S3__ENDPOINT=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_FETCHER__S3__REGION=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_FETCHER__S3__SECRET_KEY=
SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__EVM_REFRESH_VERSIONS_SCHEDULE='0 0 * * * * *'
SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_COMPILERS_DIR=/tmp/zksync-zksolc-compilers
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_FETCHER__LIST__LIST_URL=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_FETCHER__S3__ACCESS_KEY=
# Required when this S3 compiler fetcher is selected.
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_FETCHER__S3__BUCKET=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_FETCHER__S3__ENDPOINT=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_FETCHER__S3__REGION=
# SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_FETCHER__S3__SECRET_KEY=
SMART_CONTRACT_VERIFIER__ZKSYNC_SOLIDITY__ZK_REFRESH_VERSIONS_SCHEDULE='0 0 * * * * *'
# TMPDIR=
VERIFICATION_METRIC_CHAIN_IDS=125
