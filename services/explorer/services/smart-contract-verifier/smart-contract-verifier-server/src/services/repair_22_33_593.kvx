[repair.22.33.593]
audit = "22.30.161"
acceptance = "22998.1"
mode = "BUILD"
baseline = "The initial tree has no hf-build/hf-done ledger and no task implementation; no pre-change failures are claimed because the explicit ordered instructions require complete implementation before any gate and forbid running verify_cmd by hand."
qualification = "The runner retains the exact candidate revision, command, exit and private evidence location in its hf-build/hf-done ledger; cg spec done names the verified revision."

[finding.compiler-cache-trust-after-restart]
test = "compiler_cache_trust_after_restart"
implementation = "The inherited production DownloadCache already separates discovery from admission and calls Fetcher::validate_cached against catalogue digests and optional version validators before recovery; the existing ListFetcher installs private owned directories and regular executables. The test stops and reopens real pools, authenticates intact recovery without download, refuses altered persisted bytes and a corrupt replacement, admits only a checksum-verified replacement, and refuses an unlisted version directory."
peer = "The loopback distribution serves committed opaque bytes with their pinned SHA-256; no compiler process, external binary or substitute compiler implementation participates in the cache proof."
wiring_request = "Domain 14: smart-contract-verifier/src/compiler/fetcher.rs must close writable temporary executable handles before invoking SolcValidator and independently verify the effective service owner during cached admission; smart-contract-verifier/src/compiler/download_cache.rs and the fetcher API remain outside this task's permitted paths."

[finding.negative-optimization-runs]
test = "negative_optimization_runs_and_verification_counter_misses_routes"
implementation = "The canonical proto conversion checks signed multipart runs and enforces the documented inclusive range 0..=1000000 in the shared multipart and standard-json content builders, covering solo and batch. Real HTTP and gRPC reject -1 and excessive runs before compiler discovery; the real JSON codec, canonical request conversion and compiler-input producer preserve zero and the upper boundary settings."

[finding.sourcify-import-timeout-drift]
test = "sourcify_import_timeout_drift"
implementation = "Both service routes enforce request_timeout as a total operation deadline, cancelling the library future across preflight, import, retrieval and retry waits; zero is rejected. Loopback transcripts prove successful import and direct verification, each individually stalled import stage, and cumulative upstream latency exceeding the shared deadline."
retry_semantics = "The existing upstream clients retain verification_attempts as their retry policy; retries and backoff consume the service's single total operation budget and never reset it. A timeout returns gRPC DEADLINE_EXCEEDED / HTTP 504. This service-level total limit is stricter than independent per-request timeouts."
wiring_request = "Domain 14: smart-contract-verifier/src/sourcify/api_client.rs should inject request_timeout into the linked sourcify::ClientBuilder HTTP client so each upstream request also has the configured transport timeout; that library file is outside this task's scope."

[finding.verification-counter-misses-routes]
test = "negative_optimization_runs_and_verification_counter_misses_routes; sourcify_import_timeout_drift"
implementation = "All registered verification handlers use a shared result boundary that observes conversion errors and normal results. Solo requests count once; batches count each submitted contract, including request-wide failures, with mixed results classified per item; an empty batch counts zero contracts. Lookup and list operations are excluded."
labels = "chain_id is 125, unknown for absent/empty, or other; language is solidity or vyper; endpoint is one of multi-part, standard-json, batch-multi-part, batch-standard-json, sourcify, sourcify-from-etherscan, zksync-standard-json. No caller text or error message becomes a label."
status_semantics = "SUCCESS and FAILURE describe verification outcomes, with compilation/invalid-content failures counted as FAILURE even on HTTP/gRPC success. Transport errors use bounded INVALID_ARGUMENT, INTERNAL, DEADLINE_EXCEEDED, CANCELLED, UNAVAILABLE or RESOURCE_EXHAUSTED labels. Requests rejected by a transport before handler dispatch and cancelled futures that never return are outside this completion counter."
proof = "Real launched HTTP/gRPC services and their live metrics exporter prove solo error/failure counts, both batch endpoints with each contract's bounded chain label, Zksync compilation and parse failures, Vyper parse errors, and successful Sourcify import/direct calls plus deadline errors."
wiring_request = "Domain 14: spec/layerx-merge/contracts/explorer-metrics.md must publish the labels, per-contract batch counting and completion/error semantics recorded here; direct edits to that document are outside scope."

[gotcha.runner_scope]
observed = "Runner changes to .cgignore and spec.kvx predate this implementation; they are preserved, and this repair record is in the permitted services directory because direct spec and GOTCHA edits are forbidden."

[gotcha.linked_provenance]
observed = "The local Sourcify client has migrated APIs; this workspace links revision c4261d0, whose actual import and retrieval endpoints are verify/etherscan and files/any. Tests use that linked producer's real transcripts."

[gotcha.tooling]
observed = "The sandbox initially has no Cargo source cache; launcher and actix-prost APIs were read from their exact registry versions before implementation, without running an undeclared cargo command."

[gotcha.formatter]
observed = "rustfmt reported trailing whitespace left inside the Solidity async wrappers; the first full build passed, and this qualification repair removes that whitespace and formats the wrappers before rebuilding the unchanged behavioral implementation."

[qualification.repair]
revision = "937464f2e505e71f43a7b78382b9ebd8e7dc8aac"
command = "cg spec done 22.33.593 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Optimization/metrics and Sourcify tests passed; the cache test correctly received Internal/HashMismatch, but its assertion looked for the display phrase hashsum in a Debug representation that contains the variant name instead."
repair = "Require the Internal variant and fetching evm compiler context, and assert its immediate error source debug shape is HashMismatch; retain every download-count, persisted-byte, restart and catalogue-identity assertion."

[gotcha.attempt_2_scope]
observed = "The continued implementation uses server src/services/{mod.rs,verification_metrics.rs,vyper_verifier.rs,repair_22_33_593.kvx}, but the listed scope and graph touches still name library src/services paths and an absent library test; the original server files are preserved without out-of-scope edits, and no unused duplicate implementation is introduced."
wiring_request = "Task runner / Domain 14: map the four service module paths and the library test touch to the real server paths in the task graph and candidate allowlist; this record occupies the explicitly allowed library repair-record path."

[qualification.attempt_2_build]
revision = "06918a27a74707891ffc83ec94f2894d44e90d85"
command = "cargo build --locked --manifest-path services/explorer/services/smart-contract-verifier/smart-contract-verifier-server/Cargo.toml --tests"
exit = 101
