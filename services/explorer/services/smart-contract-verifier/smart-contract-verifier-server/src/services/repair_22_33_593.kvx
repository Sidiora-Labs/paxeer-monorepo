observed = "Existing repair_22_33_598 includes zksync_solidity_verifier.rs outside the server services module, so its new super::verification_metrics reference fails with E0433; no verification ran."
assumption = "Domain 14 must wire the real metrics and verification_metrics modules into smart-contract-verifier-server/tests/repair_22_33_598.rs under its own scope; this cross-task module contradiction is recorded without altering that test or weakening checks."

[gotcha.error_chain]
observed = "FetchError::HashMismatch itself wraps Mismatch as a source; inspect the immediate source below the fetching evm compiler context to assert HashMismatch, rather than root_cause(), which reaches the inner digest mismatch. The final assertion adjustment is not qualified because the build stopped on the recorded cross-task module contradiction."

[continuation.attempt_3]
implementation = "Restore the shared boundary and Vyper instrumentation in the now-authorized server paths. The Zksync source owns the helper module, re-exported by services/mod.rs, so standalone include-based integration targets resolve the same implementation without changes to their files. The helper reuses the existing allowlist source and configuration. Every target uses the linked server SolidityVerifierService collector accessor, including standalone include targets, so mixed included/linked services never register duplicate metric families."
record = "The duplicate library task record is removed; all findings and historical evidence are retained here. No baseline verification is repeated because the continued implementation is already applied and the ordered gate instructions forbid a manual verify run."
labels = "Configured decimal/hex chain IDs retain the existing bounded allowlist; absent or empty IDs map to unknown, and other supplied IDs map to other. The default allowlist is 125."

[gotcha.embedded_metrics]
observed = "A standalone target compiles an included Zksync service and a linked Solidity service in the same process. An independent lazy collector would register the same family twice; all boundaries therefore obtain the linked server collector through the service accessor, and no duplicate collector is initialized."

