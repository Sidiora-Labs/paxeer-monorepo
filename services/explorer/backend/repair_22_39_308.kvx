[regression.1806]
case = "issue1806_governed_receipt_keys"
repair = "Keep every tagged assertion unchanged: absent authority, non-digest IDs, restart/reload, restricted configured coverage, substituted keys, invalid IDs/heights, maximum uint64 and tampered signatures. Production guard conditions remain intact."

[regression.kernel_height]
case = "kernel-layout vectors stop at R3 because their batch_id is not a sequencer height; valid-0 stops at R3 under the full checks and stays submitted with no block"
repair = "Configure admissible positive-height keys before verification; explicitly assert the kernel batch ID is not a sequencer-height encoding so R3 cannot be explained solely by missing trust."

[gotcha.scope]
observed = "Recorded fixtures have already advanced to daemon height 10 with authenticated inclusion; old consumers still expect height 1000 and discard the batch transaction and proof."
repair = "Adapt consumers to the recording and preserve all authentication checks; an otherwise valid independent Comet commit cannot supply receipt inclusion."
