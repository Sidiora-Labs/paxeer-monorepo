[inventory.governed]
producer = "receipt_vectors.json#sequencer; rpc/sequencer_receipt_vectors_test.go"
key_id = "0x6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b6b"
public_key = "0x8146640f02493af4fbc54fe33388e75dc2c937ae0b7727cc2b2afb1b75199a3e"
first_height = 1000
last_height = 1999
observed = "The non-digest identifier and both bounds satisfy governed_keys. V1/V2 receipt heights 1000..1002 are covered. V3 deliberately names another key, height 2000, altered activity/log/sequence data or non-canonical bytes."
repair = "Configure the independently pinned recording before presenting discovered keys; retain every signed byte, ID, height and expected R1-R8 outcome."

[inventory.daemon]
producer = "committed_vectors.json#cases; daemon/committed-fixture/vectors/vector-v4-committed.json"
key_id = "0x9fe7d4491a2dfba1b61b8b5283b486fa92b3e90b8a29d7e4ff7f0ed89e389d9b"
public_key = "0x98bcc99e26fda009118f88f4a01864c65bd40cb2064c2cde3b156fde2f71804c"
first_height = 10
last_height = 10
observed = "The SHA256 public-key identifier and both bounds satisfy governed_keys; the recorded landing and signed receipt height are 10, not 1000."
repair = "Configure the positive recording's pin and validator checkpoint independently of each candidate. Preserve complete batch transaction/proof and inclusion evidence through verify/4; expect the recorded height 10. Correct obsolete fixture provenance claiming digest identity is mandatory."

[inventory.kernel]
producer = "receipt_vectors.json#receipts; kernel_key/2 and verify_kernel/1 in the affected tests"
key_id = "0x2929292929292929292929292929292929292929292929292929292929292929"
first_height_before = 0
first_height_after = 1
last_height = 18446744073709551615
observed = "The context identifier is a valid non-zero governance identifier. The locally built first_height=0 violates first>0; uint64_max is admitted. Missing configured authority also rejects discovery before signature checking."
repair = "Build and independently configure positive bounded keys. Preserve invalid kernel batch IDs so valid signatures still stop at height_in_range; altered signatures/bodies reach R2."

[case.1]
file = "committed_vectors_test.exs"
case = "committed_vectors_drive_verify"
refusing_clause = "governed_keys requires nonempty chain_id and receipt_keys configuration; supplying discovered keys alone grants no authority."
repair = "Install the daemon pin/checkpoint; pass full recorded evidence; assert committed at 10, R7 for earlier landing, R8 for unrelated commit. Assert digest ID and exact 10..10 pin."

