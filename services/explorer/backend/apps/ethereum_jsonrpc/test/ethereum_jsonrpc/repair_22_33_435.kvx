[meta]
task = "22.33.435"
audit = "22.30.147"
acceptance = "22998.1"
base_revision = "876fbe3211af9ef09a8e5589f822c0e986d0a140"
continued_attempt = 4
test_module = "EthereumJSONRPC.Repair2233435Test"
implementation = "Persist the existing one-time recordings without changing payload values; replay through loopback HTTP/WebSocket peers into production PaxeerX, Blocks and Geth. Preserve decoder, mutation and legacy compatibility assertions."
qualification = "The exact candidate revision, command, exit and private log are recorded by hf-build/hf-done in the runner ledger; no pass is asserted before those gates execute."

[baseline]
source = "Prior attempt evidence supplied by the task runner; no duplicate baseline gate was run in this continuation."
initial_failures = "First qualification: syncing transport error was converted to synced and strict head parity failed; attempt 2 left only producer parity failing."
previous_result = "Attempt 4 ran ten tests successfully but failed ten graph checks for unwritten captures, helper and task record."
repair = "22.31.460 supplies the producer header repair; the retained PaxeerX change propagates transport errors unchanged."

[finding.newhead-fields-real-path]
tests = ["newhead-fields-real-path: recorded WebSocket head drives HTTP block import", "newhead-fields-real-path: mutated roots refetch by number and invalid heights are refused"]
proof = "Production WebSocketClient subscription delivery, HTTP refetch and Blocks conversion compare imported header fields and preserve root mutation and invalid-number refusals."

[finding.newhead-parity-real-path]
tests = ["newhead-parity-real-path: recorded WebSocket and HTTP fields agree in the imported block"]
proof = "The repaired producer pair agrees across every emitted header field and the imported transaction root, bloom and gas. Both historical public-node mismatches retain their original values."

[finding.syncing-real-path]
tests = ["syncing-real-path: recorded consensus catch-up progress reaches the adapter over HTTP"]
proof = "The recorded progress response crosses production HTTP into PaxeerX with ordered starting/current/highest heights; the capture explicitly records its after-only revision provenance."

[finding.sync-legacy-test]
tests = ["sync-legacy-test: recorded current false reaches the adapter over HTTP", "sync-legacy-test: a real HTTP transport error must remain an adapter error"]
proof = "Recorded false maps to synced; a closed real loopback socket returns econnrefused unchanged. The separately versioned legacy v1 refusal remains an error."

[finding.trace-real-path]
tests = ["trace-real-path: recorded empty block crosses HTTP and the real trace importer", "trace-real-path: recorded historical-block refusal survives the trace importer"]
proof = "The real Geth trace importer receives the recorded empty trace and preserves the historical lookback refusal; existing synthetic call/create and mutation assertions remain."

[finding.mixed-count-test-capture]
tests = ["mixed-count-test-capture: recorded eth block/count exclude recorded Cosmos shell activity", "mixed-count-test-capture: recorded pax refusals do not become eth visibility"]
proof = "The existing recorded eth block/count and fifteen Cosmos shell logs are replayed with namespace visibility separate; pax method-deprecation refusals survive HTTP. Original synthetic two-transaction index assertions remain separately named."

[provenance.headers]
path = "captures/new_heads.json"
layout = "Original public-node transcript at the top level; formatter_capture contains the repaired node transcript recorded once in attempt 3. captures/new_heads_previous.json preserves the earlier public-node transcript."
