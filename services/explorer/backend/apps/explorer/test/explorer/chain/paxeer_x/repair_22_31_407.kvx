[repair.22.31.407]
finding = "launchpad_code_probe"
status = "implemented; qualification pending in the private hf-build/hf-done ledger"
proving_tests = ["Explorer.Repair.Repair2231407Test.launchpad_code_probe_live", "Explorer.Repair.Repair2231407Test.launchpad_code_probe_refused", "Explorer.Repair.Repair2231407Test.launchpad_code_probe_malformed"]
in_scope = "Production Capabilities probes getPoolCount() with eth_call at the same explicit height as exchange, bridge and unified-account views. Exactly one hexadecimal uint256 ABI word establishes launchpad liveness, including zero pools; refusal reports absent, while malformed data rejects the probe and preserves the stored snapshot. Existing native-surface matrix and committed loopback replay cases remain strict."
baseline = "Attempt 2 at revision 91bf178924be03cb6d1f4ca4f8a1ef52b58c6f30 ran the declared verify command: launchpad_code_probe_live, launchpad_code_probe_refused and launchpad_code_probe_malformed all failed (3 tests, 3 failures; exit 2) because production still issued launchpad eth_getCode. The continuation ruling supplies this baseline; no duplicate unchanged gate was run."
fixtures = "fixtures/launchpad_rpc/{live,refused,malformed}.json commit request/response envelopes for eth_blockNumber, empty stored code and the four views; provenance names the native uint256(3) producer and explicitly identifies malformed ABI data as a negative vector, not a successful native response."
optional_live = "Explorer.Repair.Repair2231407Test.live_node_case(kind, url) retains manual root-node mode; a nil URL returns {:skip, :live_url_unset}, while all three mandatory tests always execute without reading environment variables or reaching an external network."
preexisting = "Existing capability tests also assert retired custody/anchor fields although the production snapshot omits them; those unrelated assertions remain intact."
qualification = "The private hf-build/hf-done ledger records the verified candidate revision, exact command, exit code and log path. Its final hf-done result is authoritative; this source record is finalized before qualification to keep the build and verification on the same candidate."
tooling = "The host elixir shim has no selected runtime; use the repository mix-in-builder.sh formatter and gates after the runner's dependency warm-up."
requirement_reconciliation = "Requirement 18771.1 retains discovery at a common explicit height and refusal handling. Native launchpad availability is now established by its supported getPoolCount() view; registry 7.rpc-eth-getcode remains a stored-code interface and does not establish native service liveness. No spec source is changed by this repair."
