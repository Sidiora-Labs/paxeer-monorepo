[repair.22.33.537]
finding = "pending-conversion-restart"
proving_test = "Explorer.Migrator.SwitchPendingOperationsTest: pending-conversion-restart: a committed partial batch survives worker and pool restart"
consumer_test = "Explorer.Repair.Repair2233537Test: pending-conversion-restart: recorded pending work reaches the real consumer and repeated startup is a no-op"
implementation = "The focused gate loads the original migration tests and the new restart regression. The real SwitchPendingOperations GenServer runs its production init and continuation against isolated PostgreSQL tables copied from the migrated schema, with real commits and independent connections. A telemetry handler blocks only after the first successful COMMIT; 10 of the 12 recorded blocks have converted while two remain. The test kills the worker, closes and reopens its pool, checks the durable partial state, restarts to normal completion, replays the source and verifies exact pending transaction hashes, row counts, timestamps and real consumer stream fields."
producer = "The existing committed Geth v1.14.13 geth_history.json recording supplies 12 unique blocks and 13 transactions. Production EthereumJSONRPC decoders and Explorer block, transaction and pending-operation changesets validate and persist the recorded data; no component under repair or transport is mocked."
completion = "SwitchPendingOperations has no migrations_status row; completion is the production worker's normal exit, an empty source queue and every recorded transaction available through PendingTransactionOperation.stream_transactions_with_unfetched_internal_transactions/2. No synthetic completion status is added."
baseline = "No prior hf-build/hf-done ledger or implementation existed on entry. An unchanged-tree verify was not run: the explicit ordered gate instructions prohibit testing before complete implementation and prohibit invoking verify_cmd outside hf-done. No baseline failures are claimed."
evidence = "The runner records the exact candidate revision, command, exit code and private log path in /out/run/gates.jsonl; this record does not predeclare a passing gate."
wiring = "None: the finding concerns missing restart coverage and its proposal is entirely within the allowed test paths."
