[task.22.33.538]
finding = "historical_pending_shape"
status = "implemented_pending_qualification"
historical = "block_importer_import_1_pending.json is labelled by block_importer_import_1_pending.provenance.json; its SHA-256, original request/response and seven mined transactions are preserved and replayed through the real HTTP transport, block decoder and schema."
proving_tests = ["historical_pending_shape preserves and labels the historical Parity regression", "historical_pending_shape rejects pending imports under both fullTx selections", "historical_pending_shape decodes one committed identity with both fullTx selections after refusal", "historical_pending_shape retains committed identity and pending refusal after transport restart"]
baseline = "Attempt 1 candidate 6071dd914f33a0dfd5b8ed29cffb2b009a66170c: the historical regression passed; the pending hashes/fullTx, commit and producer restart cases failed solely at producer_captures! because paxeer_pending_block_lifecycle.json was missing (4 tests, 3 failures, verify exit 2). The current explicit implementation/build/done order forbids repeating verify_cmd by hand."
closure = "Attempt-2 ruling permits the node refusal path: authentic chain-125 root RPC responses refuse pending,false and pending,true with -32000 pending served by sequencer. These refusals produce annotated errors, zero decoded blocks/transactions/withdrawals/uncle relations and an empty real import plan, with no write operations. Historical mined-shaped data cannot substitute for this response."
capture_format = "paxeer_pending_block_lifecycle.json preserves verbatim request/response bodies and HTTP statuses, chain ID 0x7d and the advertised client version, both pending selections, followed by one committed height with both selections. Its SHA-256 and ordered phases are pinned by the provenance sidecar. The endpoint does not expose its source revision; none is invented or attributed from the local checkout."
transport = "Tests send real JSON-RPC requests through EthereumJSONRPC.HTTP and HTTPoison to an in-process Plug/Cowboy transcript server. Batch replay correlates request IDs while preserving recorded result/error payloads. No live endpoint, credential, environment variable, database call, external binary or subprocess is used by these test cases."
consumer = "EthereumJSONRPC.fetch_block_by_tag/2, Blocks.from_responses/2, Block.to_elixir/1, Explorer.Chain.Block.changeset/2 and Explorer.Chain.Import.all_single_multi/2 with the production Blocks/Transactions runners prove refusal handling and committed-block validation/planning. Committed header fields and transaction selections agree for exactly the same height."
restart = "The test stops the actual Hackney connection pool, asserts the old process is dead, opens a different pool process and replays both committed selections and both pending refusals; decoded committed identity survives reconnection and refusal remains an empty import plan. No producer or database restart is claimed, and the refused node never supplied an open block."
wiring_1 = "Domain 7: rpc/block.go and node/sequencer/ own open-block success, seal/commit and producer restart conformance; this task records the public node refusal as explicitly permitted by attempt 2 and makes no claim that the public node executed pendingBlock."
wiring_2 = "Domain 14: services/explorer/backend/apps/ethereum_jsonrpc/lib/ethereum_jsonrpc/block.ex and blocks.ex own future successful pending import support: hash-only transaction decoding and committed-header requirements remain distinct from this qualified refusal path."
evidence = "The private hf-build/hf-done ledger is the authoritative verified revision, exact command, exit code and log location. Qualification is claimed only if hf-done passes on the unchanged candidate built by hf-build; the runner publishes the task."
gotcha_1 = "The historical Parity pending,true response is mined-shaped upstream regression evidence; preserve its original bytes rather than rewriting it into merged-node evidence."
gotcha_2 = "A root chain-125 non-proposer refuses pending regardless of fullTx selection before reaching pendingBlock; record the actual refusal instead of manufacturing a pendingBlock response or claiming a producer revision/restart."
gotcha_3 = "HTTPoisonHelper selects a connection pool through http_options.pool, not a nested hackney option; the restart test must restart the pool the production transport actually uses."
gotcha_4 = "The recorded chain-125 node omits totalDifficulty under fullTx=false and includes exactly 0x0 under fullTx=true; assert both exact wire shapes while requiring every other header field to agree."
repair_1 = "Candidate abad0bcde5de97dfa0104d19e98bab3db850326c built successfully; cg spec done 22.33.538 -f layerx-merge --root /work/paxeer-monorepo exited 1 (verify_cmd exit 2), private evidence /out/logs/verify-1.log: 4 tests, 1 failure at the overbroad raw-header equality. The repair pins the recorded totalDifficulty presence/value distinction and retains equality for every other header field."
