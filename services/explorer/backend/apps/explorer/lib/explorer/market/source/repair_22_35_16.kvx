[chainflow]
api_key_setting = "MARKET_CHAINFLOW_API_KEY"
api_key = "Optional X-API-Key header on coin and history requests; an unset or empty value omits the header."
coin_id_setting = "MARKET_CHAINFLOW_COIN_ID"
coin_id_default = "paxeer"
secondary_coin_id_setting = "MARKET_CHAINFLOW_SECONDARY_COIN_ID"
secondary_coin_id_default = "sidiora"
coin_route = "/api/v3/coins/{coin_id}"
history_route = "/api/{market}/history"
tokens = "WPAX uses the native coin id and SID uses the secondary coin id."

[fields]
fiat_value = "market_data.current_price.usd"
market_cap = "market_data.market_cap.usd; null uses price times explorer held supply, or remains empty when that supply is absent."
volume_24h = "market_data.total_volume.usd"
available_supply = "market_data.circulating_supply"
total_supply = "market_data.total_supply"
last_updated = "market_data.last_updated"
name = "name"
symbol = "symbol converted to upper case"
image_url = "image.small or image.thumb"
token_fields = ["fiat_value", "circulating_market_cap", "volume_24h"]
