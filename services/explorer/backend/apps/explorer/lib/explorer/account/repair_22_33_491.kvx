[repair.22.33.491]
audit = "22.30.151"
acceptance = "22998.1"
baseline = "No prior gate ledger or task implementation existed. No unchanged-tree verification was run: the explicit Order requires complete implementation before qualification and forbids running verify_cmd outside hf-done. No pre-change test failure is claimed."
finding_migration_error_shape = "migration-error-shape: Repair2233491Test / real Multi failure records its group and rollback survives reopening. The earlier high repair already handled Account.merge's four-element Multi error and made all groups atomic; retain that match, acquire group identities in a real Multi, persist the failure group and all source/target mappings, and reconcile an account COMMIT whose following checkpoint was interrupted. Completed merges are empty on rollback and the full group list after commit."
finding_migration_provider_restart = "migration-provider-restart: Repair2233491Test / durable provider and source mapping survive lost runtime configuration; missing or damaged durable state never falls back to Auth0; checkpoint storage failure prevents imports and identity writes. Authentication selects the persisted provider after a migration process exits, rejects old-provider callbacks, and only opens access after synced cutover state can be reopened."
finding_migration_revocation_errors = "migration-revocation-errors: Repair2233491Test / DEL rejection retains keys and pending acknowledgment across restart; SCAN rejection preserves acknowledged progress and rescans the whole namespace. Production Redix transports RESP to a committed in-memory namespace implementation, errors propagate, and only acknowledged deletion of both pages permits cutover completion."
finding_identity_watchlist_atomicity = "identity-watchlist-atomicity: Repair2233491Test / rejected initial watchlist rolls identity back before a fresh login; legacy identity recovers its missing watchlist after login process restart. Real PostgreSQL constraints reject the dependent row; identity creation rolls back, and reopened production login creates exactly one watchlist while holding the identity lock."
finding_tag_address_encrypted_lookup = "tag-address-encrypted-lookup: Repair2233491Test / a saved private tag is found after independently randomized encryption. The production changeset and lookup normalize to lowercase and compare the deterministic hash column; fresh Cloak ciphertexts differ while string and typed-hash queries recover the saved tag."
finding_tag_transaction_error_shape = "tag-transaction-error-shape: Repair2233491Test / real identity deletion Multi returns the documented validation changeset. A transaction with the committed Geth trace recording's hash is tagged, the identity is deleted with production Identity.delete, and a new tag request returns the foreign-key validation changeset from :acquire_identity."
wiring_checkpoint = "services/explorer/backend/config/runtime.exs and deployment persistent-volume configuration, owning domain 14: configure Explorer.Account.Auth0ToKeycloakMigration checkpoint_path identically across restarts on durable protected storage; all account nodes must share the checkpoint and participate in the same distributed lock, with one cutover writer. Preserve the configured path after completion. No migration apply proceeds without a writable checkpoint."
wiring_access = "services/explorer/backend/apps/explorer/lib/explorer/account.ex and services/explorer/backend/apps/block_scout_web/lib/block_scout_web/account.ex, owning domain 14: have the account-access/session-validation gate consult MigrationCheckpoint.access so existing sessions also remain blocked during recovery after the deployment enabled flag resets; authentication and Identity enforce the durable state within this task's scope."
evidence = "The runner's hf-build/hf-done private ledger records the exact candidate revision, command, exit code and log location; the final response copies the last record."
gotcha = "The pre-existing high repair made the entire account apply atomic, so completed merges must not record rolled-back groups. A checkpoint synced before apply retains all secondary source UIDs; restart distinguishes the committed primary target UIDs and deleted secondary rows from a rolled-back transaction."
