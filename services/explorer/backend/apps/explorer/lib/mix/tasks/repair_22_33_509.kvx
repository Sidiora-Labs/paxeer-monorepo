[repair.22.33.509]
finding_migration_options = "migration-options: Repair2233509Test cases reject misspelled preview switches, positional input, missing/noninteger/nonpositive/excessive batches and unsafe export execution before app.start; the real offline preview proves aliases, default and inclusive bounds with recorded identities."
finding_migration_status = "migration-status: Repair2233509Test missing Auth0 and Keycloak and create_failed/poll_failed command cases prove nonzero diagnostics and unchanged account data/configuration through the real runner and loopback Auth0/Redis transports; the preview no-op remains successful."
wiring = "Domain 14: services/explorer/backend/apps/explorer/lib/explorer/account/auth0_to_keycloak_migration.ex must return {:ok, results} for successful execution including no-op and {:error, reason} for configuration, phase and finalization failures; the CLI consumes that contract, but its producer is outside this task's scope."
limitation = "The legacy service returns [] for both failed phases and successful empty migrations; the CLI rejects this ambiguous result rather than claiming success. The explicit execution no-op result requires the domain 14 wiring above; no producer-contract closure is claimed here."
baseline = "Not run: the ordered qualification rules prohibit testing before implementation and allow verify_cmd only via hf-done after hf-build. No pre-change test failures are claimed."
evidence = "Exact revision, command, exit and private log location are recorded by the runner's hf-build/hf-done ledger; this record claims no unrun gates."
gotcha = "The supplied scope excludes the migration result producer and spec task record; the wiring request and finding-to-test mapping are retained in this in-scope repair record instead. The prior preview repair's explicit CLI execution test expects the old silent [] on missing Auth0 and requires an owning-domain update for the new failure contract."
qualification_repair = "First hf-done ran 11 tests with two fixture failures: the OAuth TLS client rejected a self-signed leaf before reaching Auth0 responses. The fixture now uses a separate CA and signed localhost leaf with verify_peer retained; all phase, transport and state assertions remain unchanged."
