assumption = "Supply the independently pinned trusted_validator_hashes and complete recorded gateway batch/activity IDs, install that authority for direct verifier tests, and preserve all assertions and recordings for the bounded repair build/verify pair."

[continuation.attempt_3]
status = "implemented-awaiting-bounded-qualification"
baseline = "The supplied attempt-2 evidence reports build passed and 49 tests executed with 36 failures; no new unchanged-tree verification is claimed because the required gate order starts after implementation."
production = "Both receipt routes retain batch bytes/proofs, load independently governed receipt pins and chain/checkpoint authority, and authenticate transaction/results inclusion against linked signed headers via standard Comet block and block_results transport."
identity = "Native Pax spellings derive from the bound account bytes on read, including existing null identity rows; no importer enrichment or backfill write is needed, and canonical block joins govern unbind/reorg reads."
authority = "PAXEER_X_RECEIPT_AUTHORITY_FILE supplies durable operator-controlled chain_id, governed receipt_keys, validator_checkpoints and authenticated validator_history; RPC discovery can neither establish trust nor widen a key validity range."
status_committed_inclusion = "recorded_settlement_authenticates_execution_and_successor; status_committed_inclusion_rejects_*; *_controller_refuses_*; *_authenticates_native_transport_*; both committed controller suites"
signature_self_supplied_authority = "*_rejects_correctly_signed_foreign_chain; *_rejects_correctly_signed_unauthorized_validators; *_does_not_discover_its_own_receipt_authority; *_governed_key_rotation_survives_restart; validator_checkpoint_history_is_authenticated_after_restart"
pax_identity_not_imported = "pax_identity_round_trips_import_restart_replay_and_reorg; pax_identity_replay_enriches_an_existing_unenriched_row; IdentitySearchTest"
wiring = "daemon fixture owning domain: daemon/committed-fixture/vector_v4.go may additionally record native addr association/bind/unbind transcripts; the identity regressions drive the real ABI transformer and importer, and do not claim those event inputs were recorded by that fixture."
evidence = "The final private gate ledger /out/run/gates.jsonl names the verified candidate revision, command, exit and log; only a passing hf-done closes qualification."

[gotcha.native_result_height]
symptom = "A batch proof authenticates transaction zero but cannot authenticate the receipt's EVM transaction or execution output."
cause = "Comet data_hash covers hashed transaction leaves at H, while deterministic ExecTxResult leaves are committed by last_results_hash at H+1."
resolution = "Preserve the gateway proof, authenticate both native transaction and result proofs, and verify linked execution/successor commits against configured checkpoint authority."

[qualification.attempt_3_first_gate]
revision = "1ce57707d090e950fef62407caed54014c5845b0"
command = "cg spec done 22.31.396 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
