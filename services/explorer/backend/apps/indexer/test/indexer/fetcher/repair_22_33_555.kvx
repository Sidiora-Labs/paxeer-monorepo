[repair.22.33.555]
audit = "22.30.158"
acceptance = "22998.1"
finding_009 = "Indexer.Repair2233555Test: 009 reward-buffer persistence and caller-owned timeout cases; BlockRewardTest delegates to the same bounded polling helper."
finding_011 = "Indexer.Repair2233555Test: 011 complete keyword restoration after normal and failing sanitizer import; EmptyBlocksSanitizerTest.setup_all uses that same callback registration."
finding_012 = "InternalTransactionTest and Indexer.Repair2233555Test: 012 Geth and PaxeerX recorded trace retry, stopped/reopened BufferedTask recovery, persisted trace values, and a second restart with no remaining work."
finding_028 = "TokenTest catalogs tokens unconditionally with conditional Mox expectations; Indexer.Repair2233555Test: 028 HTTPoison and Tesla catalog the retained known-contract responses through the production reader and token schema."
finding_017 = "WithdrawalTest: requested quantities and persisted index, validator, address and amount; Indexer.Repair2233555Test: 017 partial catchup, stopped/reopened worker, missing-block resumption and completed restart."
trace_source = "../block/realtime/fixtures/chain_125_batch.json retains the chain-125 Geth producer trace and transaction; successful responses are replayed unchanged apart from JSON-RPC request ids."
legacy_sources = "fixtures/repair_22_33_555/catalog.json retains TokenTest's Bancor ABI return values; withdrawals.json retains WithdrawalTest's historical response template with distinct requested block identities. Reward replies retain BlockRewardTest's trace_block contract."
baseline = "No earlier hf-build/hf-done ledger or repair implementation existed. Unchanged-tree verification was not run: the explicit ordered gate instructions require complete implementation, formatting, hf-build, then hf-done and prohibit a manual verify run. No baseline test failure is claimed."
wiring_requests = "None remain: the attempt-3 ruling explicitly includes services/explorer/backend/apps/explorer/lib/explorer/chain/pending_operations_helper.ex in this task's scope."
evidence = "The verified candidate revision, exact command, exit code and private log location are recorded by hf-done in /out/run/gates.jsonl and copied into the final response; this source record is not edited after qualification."
qualification_1 = "revision 6935f7a5d88f7441961c779a8f0c653ef213be25; command cg spec done 22.33.555 -f layerx-merge --root /work/paxeer-monorepo; exit 1; private log /out/logs/verify-1.log; 11 tests, 5 failures in newly introduced regression setup."
repair_1 = "Use the factory miner association, configure Tesla's real Mint adapter, delete the stopped transient child spec through its real supervisor, and assert trace_address=[] at the decoded producer interface and trace_address=nil after the import runner's deliberate normalization; all persistence, retry and recovery assertions remain."
gotcha = "The local Elixir formatter shim requires the installed version to be selected explicitly; ExUnit.stop_supervised cannot unlink an already-stopped transient child on the installed ExUnit version."
continuation = "Retained all ten seeded paths from attempt 1. Its last verification reported 11 tests and two recovery failures. Recovery now uses the actual selected adapter for the explorer queue and reports missing recorded exchanges and recovered pending records by name instead of dereferencing nil."
qualification_2 = "revision 36ce9ca5c39cde2111cf0051bccd3efb9e74dea8; command cg spec done 22.33.555 -f layerx-merge --root /work/paxeer-monorepo; exit 1; private log /out/logs/verify-1.log; 11 tests, two failures: Geth zero-value dereference and PaxeerX selecting blocks instead of transactions."
repair_2 = "Assert the recorded value is exactly zero, the real Geth decoder returns exactly nil for zero, and persistence retains exactly that producer value; name a missing persisted trace explicitly. Keep the PaxeerX queue assertion intact pending production scope clarification."
gotcha_zero_trace = "EthereumJSONRPC.Geth.Call deliberately normalizes zero call values to nil; a nil value is not a missing internal-transaction record and must not be dereferenced as a Wei struct."
qualification_2_final = "revision 194f40639f5df405392df82bf0b1d4b3afa223de; command cg spec done 22.33.555 -f layerx-merge --root /work/paxeer-monorepo; exit 1; private log /out/logs/verify-1.log in the preceding attempt; 11 tests, one failure: PaxeerX selected blocks instead of transactions."
continuation_3 = "Preserved the preceding implementation. PendingOperationsHelper now selects transaction operations for both Geth and its PaxeerX delegate when Geth block tracing is disabled; InternalTransaction recognizes both adapters when block tracing is enabled."
finding_012_queue_proof = "Indexer.Repair2233555Test: 012 Geth and PaxeerX migrate the durable queue consumed by both tracing modes; the real helper converts recorded-chain pending identities in both directions, and the real fetcher initialization consumes each selected queue. The existing recorded HTTP trace retry and restart cases remain intact."
gotcha_queue_contract = "PaxeerX delegates both tracing methods to Geth and reads Geth's block_traceable? configuration; the pending-operations producer and the fetcher consumer must agree on both queue formats."
qualification_3 = "revision 323fc08fdacc1f2f71ca8820f34cbbf2e99ecfed; command cg spec done 22.33.555 -f layerx-merge --root /work/paxeer-monorepo; exit 1; private log /out/logs/verify-1.log; 13 tests, one PaxeerX recovery case exited shutdown after its loopback request was interrupted."
repair_3 = "Wait for the real failed response to reach the BufferedTask retry queue, explicitly flush and assert a second completed failed attempt, then stop and reopen the supervisor; await initialization completion before stopping the successful worker. Existing persistence, recovery, timeout and transport assertions remain intact."
gotcha_restart_request = "Counting a loopback request before its response is consumed races supervisor shutdown and leaves Bypass reporting an aborted handler; wait for zero active tasks and the retried entry in the real buffer before stopping."
gotcha_supervisor_source = "Fetcher supervisors are generated by Indexer.Fetcher.defsupervisor rather than standalone supervisor.ex files; their existing case helpers live under test/support/indexer/fetcher."
