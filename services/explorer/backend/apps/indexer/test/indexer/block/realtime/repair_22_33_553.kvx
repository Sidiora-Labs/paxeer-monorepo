baseline = "Not run: the explicit task order forbids testing before full implementation and running verify_cmd by hand; the initial gate ledger has zero builds and zero verify runs. The audit itself is static and records no failing runtime tests."
qualification = "The bounded hf-build/hf-done ledger records the exact candidate revision, command, exit code and private log location; no gate result is claimed in advance."
wiring = "Domain 14: services/explorer/backend/apps/ethereum_jsonrpc/test/support/ethereum_jsonrpc/case/geth/http_websocket.ex still replaces the paired configured HTTP transport with its historical Infura endpoint; consume WebSocket.Case.Geth.setup().json_rpc_named_arguments for that external test profile."
