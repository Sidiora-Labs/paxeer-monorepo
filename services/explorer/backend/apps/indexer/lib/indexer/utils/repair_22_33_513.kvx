[repair.22.33.513]
finding = "notification-recovery"
delivery = "Disposable best-effort invalidations; max_age bounds payload availability and does not promise replay or loss of authoritative chain state."
implementation = "EventNotificationsRecovery completes LISTEN, reads the canonical head from Explorer.Repo and requests authoritative resource reload; connection failure restarts the sequence instead of transparently reconnecting."
proof = "Indexer.Repair2233513Test: expired outage payloads reconcile after listener stop and reopen; transport failure restarts LISTEN and invalidates unchanged-height state; empty authoritative state is explicit and payload retention stays bounded."
baseline = "Not run: the task's exact gate order requires full implementation before qualification and forbids running verify_cmd by hand; no pre-change failure is claimed."
evidence = "The private hf-build/hf-done ledger records the candidate revision, command, exit and log; no qualification is claimed until hf-done passes."
wiring_listener = "Domain 14: services/explorer/backend/apps/explorer/lib/explorer/application.ex must supervise the reconciling listener in place of Explorer.Chain.Events.Listener; relocate the recovery module into explorer ownership to preserve umbrella dependency direction."
wiring_consumers = "Domain 14: services/explorer/backend/apps/block_scout_web/lib/block_scout_web/realtime_event_handlers must subscribe before accepting live events, handle event_notifications_reconcile by invalidating cached resources and notify connected clients to reload their authoritative API resources; frontend reconnect handlers must perform the same reload."
closure = "The focused gate qualifies the in-scope recovery contract and implementation only on success; deployment closure additionally requires the explicitly listed out-of-scope listener and consumer wiring."
qualification_repair = "The first focused verification passed two cases and exposed a wrong test helper name; block hashes use Chain.string_to_full_hash/1. The test call was corrected without changing its assertions."
continuation_baseline = "Attempt 1 revision 48ded44650bf0027130502cfb4e12c22e2af4ef8 failed expired outage payloads reconcile after listener stop and reopen at refute Process.alive?(connection); the other two cases passed, as recorded in the supplied gate output."
continuation_repair = "Trap supervisor shutdown so terminate/2 synchronously closes the notification connection; explicitly restart on killed and normal connection exits. The outage case monitors both processes and retains the original liveness assertion."
fixture_interface = "The supplied continuation ruling names an in-process database fixture, but the checked-in package support uses Explorer.DataCase and Ecto SQL Sandbox; its module/path has been requested. No substitute database, mock or weakened assertion is introduced."
