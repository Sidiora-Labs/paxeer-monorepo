build_cmd = "python3 -m py_compile tests/ci/test_explorer_suites_wired.py && bash -n scripts/explorer/gate-test.sh"
verify_cmd = "python3 -m pytest -q tests/ci/test_explorer_suites_wired.py"
verified_revision_source = "The verify row in the runner's private /out/run/gates.jsonl names the exact verified candidate revision, command, exit and private log; the final task handoff copies that row."
verification_scope = "The declared gate checks real workflow jobs, matrix coverage, commands, setup, manifests and local-gate parity; execution of the newly wired full suites belongs to the workflow."
