# Explorer deployment and operational environment inputs.
# Local Compose inputs, development-container build arguments and optional
# database-copy, builder and deployment-script inputs are listed by name.
# Secrets are empty. Commented entries stay unset; supply deployment endpoints
# and account names before enabling a section that requires them.
# Dynamic families use the configured uppercase deployment environment.
# Backend, frontend and Rust service inputs have separate component examples.

ALLOW_NONEMPTY_DESTINATION=0
# Required for the selected CodeDeploy environment.
# AWS_<ENV>_CHAINS=
# Required for the selected CodeDeploy environment.
# AWS_<ENV>_PREFIX=
# Required by the CodeDeploy deployment script.
AWS_ACCESS_KEY_ID=
# Required by the CodeDeploy deployment script.
AWS_SECRET_ACCESS_KEY=
BACKEND_PUBLISHED_PORT=4000
# BACK_PROXY_PASS=
BLOCKSCOUT_VERSION=7.0.2
BLOCK_BATCH=100000
# CARGO_MANIFEST_DIR=
# Required to supply the composed frontend network identifier.
CHAIN_ID=
CHAIN_TYPE=paxeer_x
# CIRCLE_BRANCH=
# CIRCLE_BUILD_NUM=
# CIRCLE_SHA1=
# COMMON_SCRIPT_SOURCE=
DISABLE_INDEXER=false
# Required for the registry login target.
DOCKER_PASSWORD=
DOCKER_REPO=blockscout
DOCKER_TAG=latest
# Required for the registry login target.
# DOCKER_USERNAME=
DRY_RUN=0
# Required by the database copy utility.
DST_DATABASE_URL=
ETHEREUM_JSONRPC_VARIANT=paxeer_x
# Required by the local Compose deployment.
# EXPLORER_IMAGE_TAG=
# EXPLORER_PUBLIC_HOST=
FRONTEND_DOCKER_TAG=latest
FRONTEND_PUBLISHED_PORT=3000
# FRONT_PROXY_PASS=
# HOME=
INSTALL_ZSH=true
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SIG_PROVIDER_ENABLED=true
MIX_BUILD_PATH=/build
# MIX_BUILD_VOLUME=
MIX_ENV=test
# MIX_IN_BUILDER_BROWSER_DRIVER=
MIX_IN_BUILDER_IMAGE=explorer-elixir-builder:v10.2.6
# NODE_SCRIPT_SOURCE=
NODE_VERSION=20
# OUT_DIR=
# PATH=
PAXEER_X_CAPABILITIES_ENABLED=false
PGPASSWORD=
# PGUSER=
PHOENIX_VERSION=1.7.10
# Required by the remote database Compose override.
# POSTGRES_BIND_ADDRESS=
POSTGRES_DB=blockscout
# Required by the remote database Compose override.
POSTGRES_PASSWORD=
POSTGRES_PUBLISHED_PORT=7432
# Required by the remote database Compose override.
# POSTGRES_USER=
RELEASE_VERSION=10.2.6
# RPC_FIXTURE_DIR=
# RPC_FIXTURE_HOST=
RPC_FIXTURE_PORT=8545
RPC_FIXTURE_PUBLISHED_PORT=8545
# RPC_HTTP_URL=
# RPC_WS_URL=
# Required for production web endpoints.
SECRET_KEY_BASE=
SIG_PROVIDER_DOCKER_TAG=latest
SMART_CONTRACT_VERIFIER_DOCKER_TAG=latest
# Required by the database copy utility.
SRC_DATABASE_URL=
STATS_DOCKER_TAG=latest
STATS__BLOCKSCOUT_DB_URL=
STATS__CREATE_DATABASE=true
STATS__DB_URL=
STATS__RUN_MIGRATIONS=true
# TABLES=
UPGRADE_PACKAGES=true
# USERNAME=
USER_GID=1000
USER_OPS_INDEXER_DOCKER_TAG=latest
USER_OPS_INDEXER_VERSION=1.3.1
USER_OPS_INDEXER__DATABASE__CONNECT__URL=
# USER_OPS_INDEXER__INDEXER__RPC_URL=
USER_UID=1000
VARIANT=1.19.4-erlang-27.3.4.6-debian-bookworm-20251117
VISUALIZER_DOCKER_TAG=latest
