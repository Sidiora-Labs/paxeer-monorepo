# Railway service ramp (project layerx, environment beta), image docker/ramps/Dockerfile target railway; one replica (the order
# journal under /data/ramp has one writer), volume at /data. Public domain ramp.paxeer.network on the plain listener; healthcheck /readyz.
# layerx-env-files writes the files.tsv secrets (base64 variables below) to /run/ramp-source; services/platform/ramps/env-init.sh copies them to
# /run/secrets as uid 4020, renders /run/layerx-ramp/config/config.json and starts the ramp under uid 4020. The init refuses to start
# while any input is missing or malformed.
PORT=8080
RAMP_LISTEN=[::]:8080
RAMP_WORKER_ID=paxeer-ramp-1
RAMP_LEASE_SECONDS=60
RAMP_RECONCILE_SECONDS=5
RAMP_CLIENT_TIMEOUT_SECONDS=8
RAMP_IDENTITY_ENDPOINT=https://identity.railway.internal:9443
RAMP_IDENTITY_AUDIENCE=layerx-ramp
RAMP_SEQUENCER_RPC_ENDPOINT=
RAMP_RPC_CHAIN_ID=125
RAMP_MAX_FEE_PER_GAS=2000000000
RAMP_MAX_PRIORITY_FEE_PER_GAS=1000000000
RAMP_GAS_LIMIT_CAP=1000000
RAMP_POLL_CADENCE_SECONDS=5

# Owner inputs.
RAMP_OPERATOR_PRINCIPAL_ID=
RAMP_ACTOR_DID=
RAMP_LAYERX_SIGNER_KEY_HANDLE=
RAMP_PAXEER_SIGNER_KEY_HANDLE=
RAMP_COMPLIANCE_ENDPOINT=
RAMP_COMPLIANCE_PUBLIC_KEY=
RAMP_PROVIDER_ENDPOINT=
RAMP_PROVIDER_CALLBACK_PUBLIC_KEY=
RAMP_CUSTODY_ENDPOINT=
RAMP_WALLET_ADDRESS=
RAMP_VAULT_ID=
RAMP_SIGNER_ENDPOINT=
RAMP_OPERATOR_ADDRESS=
# JSON array of pinned receipt keys: keyId, publicKey, firstHeight and lastHeight.
RAMP_RECEIPT_KEYS_JSON=

# Secrets, base64 (docker/ramps/files.tsv, all under /run/ramp-source). RAMP_CA_BUNDLE_PEM is the internal CA root, ISRG Root X1 and
# ISRG Root X2 followed by the roots of the owner's compliance, provider and custody services; RAMP_CLIENT_* is the client identity
# of the ramp-client row of tools/bringup/ca.sh.
RAMP_QUOTES=
RAMP_CA_BUNDLE_PEM=
RAMP_CLIENT_CERT=
RAMP_CLIENT_P12=
RAMP_CLIENT_PASSWORD=
RAMP_RPC_TRUST_ANCHOR_DER=
RAMP_IDENTITY_TOKEN=
RAMP_COMPLIANCE_TOKEN=
RAMP_PROVIDER_CREDENTIAL=
RAMP_GATEWAY_KEY=
RAMP_AUTHORITY_TOKEN=
RAMP_SIGNER_TOKEN=
RAMP_CUSTODY_CREDENTIAL=
RAMP_OPERATOR_CONTROL_TOKEN=
