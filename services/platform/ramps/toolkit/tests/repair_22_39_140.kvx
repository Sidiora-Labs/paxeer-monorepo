[repair.22.39.140]
base = "3d1eff197f5a931feb5afc3e595d856f9f57e02b"
test = "payment_direction_selects_direct_send_or_customer_grant"
baseline = "No earlier scoped edits or gate runs were present; the stale destination assertion is recorded in gotcha 3529. No pre-change gate was run."
evidence = "The hf-build and hf-done ledger records the verified candidate revision, exact command, exit code and private log; the final response copies the last gate evidence."

[assertion.payment-authority]
change = "Assert draw.to equals evm::PAY_ADDRESS (0x101b), replacing the retired LEDGER_ADDRESS (0x101a) expectation."
producer = "services/platform/ramps/toolkit/src/lib.rs:361 delegates compile_payer_grant_draw to compile_customer_payment; line 368 sets to: PAY_ADDRESS."

[assertion.budget-spend-selector]
change = "Assert draw.data[..4] equals the first four Keccak256 bytes of budgetSpend(bytes32,bytes32,uint128); retain the grant identifier assertion at bytes 4..36 and the other assertions except the producer-aligned on-ramp error correction recorded below."
producer = "services/platform/ramps/toolkit/src/lib.rs:369 uses encode_budget_spend; services/platform/ramps/toolkit/src/evm.rs:15-18 encodes budgetSpend(bytes32,bytes32,uint128), and encode_call at line 127 prefixes its Keccak256 selector."

[qualification.scope]
protected_inputs = "The declared verification excludes only failed_callback_apply_retains_no_event_and_retry_is_idempotent, mismatched_pending_append_prefix_preserves_history_and_refuses_recovery and interrupted_callback_write_recovers_on_restart_without_repair; decision 2325 and gotcha 3529 assign those cases to the ramp recovery workflow supplying LAYERX_RAMP_RECOVERY_CONTRACT_CONFIG."

[qualification.failure]
revision = "efdd0e5a8a7a3b4b0a81b652f57612028bb963c1"
command = "cg spec done 22.39.140 -f layerx-merge --root /work/paxeer-monorepo"
