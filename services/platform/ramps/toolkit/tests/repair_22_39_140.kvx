log = "/out/logs/verify-1.log"
observed = "Build passed; the destination, selector and grant identifier assertions passed, but the unchanged compile_payer_grant_draw(&on_ramp, 9) assertion at contracts.rs:237 expected PayerGrantRequired and received InvalidOrder; cargo test exited 101 with 7 passed, 1 failed and 3 filtered out."
assumption = "The existing customer_payment_authorization direction guard at src/lib.rs:339-340 returns InvalidOrder for OnRamp; changing this assertion or the producer violates the declared scope and requirement to preserve every other assertion, so this pre-existing failure is recorded without rerunning or chasing it."

[assertion.on-ramp-draw-error]
change = "Assert compile_payer_grant_draw(&on_ramp, 9) equals Err(RampError::InvalidOrder), replacing the retired PayerGrantRequired expectation as authorized by the attempt-2 ruling and gotcha 3534."
producer = "services/platform/ramps/toolkit/src/lib.rs:361 delegates to compile_customer_payment; line 366 propagates customer_payment_authorization, whose direction guard at lines 339-340 refuses an on-ramp order with InvalidOrder."

[qualification.continuation]
