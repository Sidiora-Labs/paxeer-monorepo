[repair]
members = ["layerx-ramp-toolkit", "layerx-reference-ramp"]
behavior = "Ramp library, command, and integration targets preserve order, receipt, journal, and HTTP response bindings."

[lint.1]
name = "clippy::assigning_clones"
files = ["toolkit/src/journal.rs", "toolkit/tests/contracts.rs", "toolkit/tests/evm_submit.rs", "toolkit/tests/repair_22_33_1486.rs", "toolkit/tests/source_settlement.rs"]

[lint.2]
name = "clippy::cast_possible_wrap"
