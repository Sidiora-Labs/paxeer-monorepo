assumption = "Correct the regression input and retain a wrong-sender refusal; the merchant recording requires the node-domain wiring already recorded above, without weakening its purpose check."

[gotcha.rpc-sender]
observed = "verifyRpcPayment binds expectedPayer to the EVM transaction sender, while the PaymentExact indexed payer is a distinct ledger account ID."
resolution = "Use the producer's left-padded receiptJson.from as the RPC sender and assert that substituting the ledger account is refused."

[qualification.continuation-authentication]
revision = "51786c2e6e76794c5a2cb16c1993212181be6d62"
command = "cg spec done 22.33.1400 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "All builds and twelve tests passed; three merchant tests failed at startup because the current application requires a customerCredentialsEnvironment binding missing from the inherited harness."
assumption = "Supply real MerchantCredentials configuration and authenticated checkout/order requests in the test harness, preserving the production authentication boundary and every existing payment assertion."

[gotcha.merchant-customer-binding]
observed = "Merchant checkout now authenticates customer credentials and scopes order identities by tenant and principal."
resolution = "Bind a dedicated customer credential list and send its bearer token on checkout and order reads; do not bypass MerchantCredentials or trust the JSON principal."

[qualification.continuation-authentication-repair]
