[continuation.transaction-recovery]
tests = ["merchantCheckoutOfferUsesReceiptedRung", "sellerRetainsPortableNodeReceiptAcrossRestart"]
implementation = "Seller fulfillment lookup uses the verified transaction hash for new records, including transaction-only headers, and still reads legacy receipt-keyed records; stored proofs are reverified before release and a different request cannot reuse the transaction."
prior_attempt = "The supplied attempt-5 evidence reports duplicate settlement after merchant restart and invalid-webhook on a matching delivery; this continuation does not rerun the old candidate."

[wiring.merchant-webhook-digest]
resolved = "The continuation brings merchant/src into scope: bind the event transaction to the raw transaction before receipt verification, compare the event digest with the authenticated protocol digest and mark paid only after both checks succeed."

[gotcha.transaction-only-replay]
observed = "A transaction-only header has no receiptDigest, so receipt-key-only lookup contacts settlement again after restart despite an existing fulfillment."
resolution = "Use a transaction-derived key across portable and transaction-only payments, bind authority output to the hinted transaction, retain legacy receipt lookup and verify the persisted proof on replay."

[gotcha.merchant-webhook-digest]
observed = "The merchant webhook consumer still compares the retired signed-byte keccak digest, rejecting the correct protocol digest even after the transaction matches."
resolution = "Compare verified.receiptDigest after checking transaction binding; keep valid-delivery assertions and protocol digest unchanged, and refuse the retired signed-byte digest."

