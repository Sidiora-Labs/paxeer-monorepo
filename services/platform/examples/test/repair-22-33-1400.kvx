[continuation.merchant-webhook]
tests = ["merchantWebhookRefusesTransactionMismatch", "merchantMiddlewareKeepsProofAfterRefusedWebhook"]
prior_attempt = "The supplied attempt-6 evidence reports fifteen passing cases and a matching delivery rejected after a transaction-mismatch refusal; the old candidate is not rerun."
implementation = "MerchantSettlementWebhooks checks the raw transaction hash before verifying the proof, then checks the authenticated protocol digest and verified transaction before changing the order."
proof = "The middleware-owned regression in merchant/src uses real node evidence over loopback RPC, signed webhook envelopes, file-backed orders and an in-memory delivery store; wrong transactions, wrong digests and legacy digests leave the order awaiting-payment and release the delivery claim, then the same delivery id succeeds and replays without resolving proof again."
evidence = "The bounded hf-build and hf-done ledger records the final candidate revision, command, exit code and private log; the runner publishes the verified revision."
