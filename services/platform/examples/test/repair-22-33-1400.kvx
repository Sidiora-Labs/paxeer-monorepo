[repair]
task = "22.33.1400"
base_revision = "5fc0c55eaaa6d43868c4a2872366299b8b7e2007"
record = "spec/layerx-merge/programme/audit/records/22.30.78.kvx"
qualification = "hf-build and hf-done retain the exact candidate revision, command, exit and private log in /out/run/gates.jsonl; no manual gate or baseline run is claimed."
baseline = "Not run: the ordered instructions prohibit testing before complete implementation and require the sole verify command to run through hf-done after hf-build; the new repair test does not exist at the base."

[finding.walkthrough-test-receipt]
tests = ["walkthroughVerifiesActualSequencerReceipt", "walkthroughKeepsWrongPinsAndPendingReceiptsUnknown"]
producer = "sdk/platform/conformance/fixtures/sequencer-receipt-v1.json#V1-layerxprograms-call; rpc/sequencer_receipt_vectors_test.go executes the real program precompile and signs the node receipt."
consumer = "Real verify-receipt.mjs entrypoint and verifyCalledReceipt through a loopback node; submissionResult preserves unknown-fate after untrusted evidence."
remaining = "The shell walkthrough's called output and daemon discovery envelope encoder cannot be qualified by a Node-only gate without an in-process interface or a recorded CLI/discovery transcript."

[finding.buyer-config-test-rpc]
tests = ["buyerAgentExampleConfigHasNoReceiptAuthority", "buyerAgentRefusesLayerxNetworkConfig", "buyerAgentUsesHostedHumanPaymentRoute"]
producer = "Recorded node ledger payment and human API golden quote, journey and evidence envelopes; quote expiry is relocated relative to the test clock."
consumer = "runBuyerAgent, LayerXPaymentHttpTransport, BuyerMiddleware and SellerMiddleware over separate loopback human/resource/node origins; paid assertions are retained."
baseline_inspection = "Beta node root URL was already correct at the base; no prior execution result is asserted."

[finding.merchant-proof-test-shape]
tests = ["merchantCheckoutOfferUsesReceiptedRung", "merchantWebhookRefusesTransactionMismatch", "merchantWebhookRefusesInvalidSignature"]
producer = "Test support regenerates the node ledger transaction and receipt for the checkout URL using the public conformance keys, secp256k1 transaction signing, canonical SDK receipt encoding and protocol-domain receipt signing; runtime resolves complete JSON over root RPC before strict portable import and settlement."
consumer = "Real merchant-checkout entrypoint, receipt consumer, file orders and fulfillments; paid state, persisted proof and restart assertions remain mandatory."
binding = "Each checkout offer hashes its authenticated resource URL into both signed calldata and the PaymentExact log; the generic recording's purpose is explicitly refused."

[finding.merchant-config-test-rpc]
tests = ["merchantExampleConfigsUseEip155AndReceiptKeys", "merchantConfigTransportsNodeReceiptWithRequiredPins"]
consumer = "All three merchant configurations require beta root RPC and receipt key bindings; missing and empty pins refuse, configured pins transport actual node evidence."
baseline_inspection = "Owning merchant configurations already use beta node root RPC at the base."

[finding.runtime-proof-test-shape]
tests = ["sequencerReceiptClientReturnsVerifiedReceipt", "sequencerReceiptClientReportsSubmittedAsPending", "runtimeProofMatchesCrossSdkPortableFixture"]
producer = "Unmodified node/sequencer corpus including signed summary effects and the protocol sequence domain."
consumer = "SequencerReceiptClient returns the SDK-verified domain-separated digest and receiptJson; its output matches the shared portable fixture accepted by other SDKs."
remaining = "Fixture equivalence is covered; executing another language SDK's portable importer requires an external runtime prohibited by this gate, and the TypeScript SDK exposes no portable import API."

[wiring.seller]
request = "services/platform/middleware/{buyer,agent}/src — middleware domain: migrate the six-field portable constructors to required receiptJson before replacing the legacy PortableReceiptV2 type; this task adds the strict PortableNodeReceiptV2 importer and preserves authenticated node JSON through seller settlement and stored fulfillment."

[wiring.buyer]
request = "services/platform/middleware/buyer/src/index.ts — middleware domain: retain and verify receiptJson and protocol digest through evidence import, payment headers and settlement capture."

[wiring.merchant]
resolved = "The continuation ruling authorizes test-side regeneration in services/platform/examples/test/support/merchant-receipt.mjs; no node-domain change or production seller signer is needed for checkout-specific receipts."

[wiring.walkthrough]
request = "services/platform/examples/agent-program-call/walkthrough.sh, tools/platform and services/agent/crates/layerx-agentd — example/CLI/daemon domains: expose a Node-callable walkthrough result and actual discovery envelope recording compatible with the real submitted transaction; the focused gate cannot build native CLI or run shell/jq."

[wiring.portable]
request = "services/agent/sdk/typescript/src — SDK domain: expose shared portable v2 import/export with JSON/summary/log/sequence checks so the examples can exercise an actual portable import within the Node-only gate."

[qualification.middleware]
revision = "b584f37bdd826812009734c23811f9d913b00e02"
command = "cg spec done 22.33.1400 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Buyer paid-path and both merchant success-path tests refuse the correct protocol digest in the existing middleware verifier."
assumption = "The out-of-scope middleware owners must implement the wiring requests; the success assertions and exact consumer checks remain mandatory."

[gotcha.loader-stderr]
observed = "Node source transformation emits an experimental feature diagnostic on child stderr."
resolution = "The buyer subprocess suppresses that specific Node diagnostic; its empty application stderr assertion remains unchanged."

[gotcha.recorded-pin-range]
observed = "A producer fixture's first authorised height is higher than a negative test's old upper bound."
resolution = "Use a valid one-height pin range below the producer height so the verifier, rather than key configuration validation, proves refusal."

[gotcha.marketplace-emulator-root]
observed = "Marketplace's emulator configuration already uses root RPC while merchant checkout and shop use the local emulator's RPC route."
resolution = "Assert each owning configuration's exact declared local route and require root for every beta node."

[gotcha.beta-network-refusal]
observed = "The beta human-origin boundary runs before unsupported payment network validation."
resolution = "Supply a valid dedicated HTTPS human origin in the beta unsupported-network test so it reaches payment validation while the observed resource endpoint still receives no connection."

[continuation.seller-digest]
tests = ["sellerVerifiesProducerReceiptDigest", "buyerAgentUsesHostedHumanPaymentRoute"]
implementation = "ReceiptPayloadAuthority and verifyPaymentReceipt compare the carried digest with the SDK's authenticated protocol digest; verifyRpcPayment produces the same digest after pinned signature verification."
refusals = "The node-backed regression retains wrong-pin, signature, amount and transaction checks, and explicitly refuses the legacy signed-byte keccak digest and an all-zero digest."
prerequisite = "22.31.457 is present at the base and widens committed inclusion; it does not migrate the buyer or agent portable receipt producers."
remaining = "Required receiptJson cannot be added to the seller PortableReceiptV2 interface alone: services/platform/middleware/buyer/src/index.ts and services/platform/middleware/agent/src still construct the six-field shape, outside this task's scope."

[qualification.continuation-first]
revision = "e6cb2749af009c9d0f9eb8159e805f85a6ebe1d3"
command = "cg spec done 22.33.1400 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
