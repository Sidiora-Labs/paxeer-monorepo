assumption = "The recorded purpose must remain unchanged until the actual node producer emits a merchant-bound recording; no receipt signer or node execution producer exists in seller/src."

[continuation.portable-node-evidence]
tests = ["sellerRetainsPortableNodeReceiptAcrossRestart", "sellerVerifiesProducerReceiptDigest"]
implementation = "The required seven-field PortableNodeReceiptV2 importer retains receiptJson, checks its complete node response against signed receipt summary and log effects, and propagates it through RPC proof production, settlement headers and durable fulfillment without widening the existing six-field producer type."
proof = "The runtime fetches committed node evidence over loopback RPC; the strict seller import, real ReceiptPayloadAuthority and SellerMiddleware transport the proof over HTTP, persist every portable field, and replay it after the seller and file store reopen without releasing twice."
refusals = "Missing required receiptJson and unknown portable fields refuse; altered node transaction, signature bytes, signing key, height, status, nonce, gas, fee, denominations, return data, log data, topics, index and unknown JSON fields refuse against the unchanged signed producer recording."
continuation = "The checkout-specific recording is regenerated by test support under the continuation ruling; the merchant paid state, strict proof preservation and process restart replay assertions remain intact."

[continuation.checkout-purpose]
tests = ["merchantCheckoutOfferUsesReceiptedRung", "merchantWebhookRefusesTransactionMismatch", "merchantWebhookRefusesInvalidSignature", "sellerRetainsPortableNodeReceiptAcrossRestart"]
implementation = "Regenerate signed calldata, transaction hash, PaymentExact effect, domain-separated sequence root and canonical signed receipt for each authenticated checkout offer; independently verify it with pinned SDK keys before transporting the seven-field portable document."
recovery = "The merchant process stops and reopens orders and fulfillments, returning the identical settlement without another RPC or settlement call; the separate seller test stops its HTTP server and reopens FileFulfillments, preserving all portable fields and releasing once."
evidence = "hf-build and hf-done record the matching candidate revision, command, exit and private evidence log in /out/run/gates.jsonl; the runner publishes that verified revision."

[gotcha.checkout-recording-purpose]
observed = "An otherwise valid generic payment recording fails the merchant's checkout URL purpose binding."
resolution = "Regenerate both the signed transaction and signed log effect with the test-side conformance keys and canonical codec; never change a recorded purpose without regenerating its signatures and protocol digest."

[gotcha.source-loader-linking]
observed = "Static production imports are linked before the source-loader hook evaluates, so a clean install refuses the unbuilt merchant middleware dist entrypoint before tests start."
resolution = "Dynamically import production modules after the source-loader registration, exercising committed sources without depending on generated merchant bundles."

