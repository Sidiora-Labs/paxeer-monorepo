retained_dependencies = ["viem", "@sidiora/layerx-agent-integrations"]
retained_reason = "services.mjs and wallet-review-transport.mjs import viem; index.mjs imports the agent integrations package."
lock_generation = "npm install --package-lock-only --ignore-scripts"
stale_lock_failed_gates = ["22.31.477", "22.33.612", "22.33.619", "22.33.1478", "22.33.1480"]

[lock.added]
entries = ["node_modules/@adraffy/ens-normalize", "node_modules/abitype", "node_modules/isows", "node_modules/ox", "node_modules/ox/node_modules/@noble/ciphers", "node_modules/ox/node_modules/@noble/curves", "node_modules/ox/node_modules/@noble/hashes", "node_modules/ox/node_modules/@scure/base", "node_modules/ox/node_modules/@scure/bip32", "node_modules/ox/node_modules/@scure/bip39", "node_modules/ox/node_modules/eventemitter3", "services/platform/examples/agent-spend/node_modules/@noble/curves", "services/platform/examples/agent-spend/node_modules/@noble/hashes", "services/platform/examples/agent-spend/node_modules/@scure/base", "services/platform/examples/agent-spend/node_modules/@scure/bip32", "services/platform/examples/agent-spend/node_modules/@scure/bip39", "services/platform/examples/agent-spend/node_modules/viem", "services/platform/examples/agent-spend/node_modules/ws"]
