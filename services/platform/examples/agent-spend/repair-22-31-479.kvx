[repair.22.31.479]
acceptance = "22998.1"
base_revision = "b664b08b724ec5b190920b99ba70b283c8a796c9"
cause = "Audit repair 22.30.74 (ea2e88ad0a, task 22.33.1364) changed the workspace manifest without regenerating the root npm lock; root npm ci failed with EUSAGE (gotcha 2994)."
removed_devDependencies = ["@supabase/supabase-js", "typescript"]
