workspace_entry = "services/platform/examples/agent-spend now records all four runtime dependencies and Node >=22.18.0; the integrations package already has a root workspace link."

[proof.workspace_dependency_closure]
test = "everyWorkspaceDependencyResolvesFromRootLock"
criterion = "Read every member from the root workspaces list, compare dependency and devDependency declarations with its lock entry, and resolve every declared name through member or ancestor node_modules entries, including linked workspace targets."
stale_lock_regression = "The base lock omits agent-spend's declared integrations and viem dependencies in its workspace entry and contains no viem package entry, so this assertion fails against the pre-repair lock. No baseline gate was rerun."

[proof.imported_devDependencies]
test = "agentSpendDevDependenciesAreImported"
criterion = "Inspect the example's source imports, excluding installed packages and tests, require every devDependency to be imported, and retain the directly imported viem and integrations runtime dependencies."

[qualification]
build = "hf-build: npm ci --ignore-scripts"
verify = "hf-done: cg spec done 22.31.479 -f layerx-merge --root /work/paxeer-monorepo"
verify_cmd = "npm ci --ignore-scripts && node --test services/platform/examples/agent-spend/test/repair-22-31-479.test.mjs"
verified_revision_record = "/out/run/gates.jsonl: the final hf-done row names the exact verified candidate revision, command, exit code and private log; its revision must match the passing hf-build row."
private_build_log = "/out/logs/build-1.log"
private_verify_log = "/out/logs/verify-1.log"
publication = "The runner publishes the unchanged qualified candidate; the agent does not commit or push."
