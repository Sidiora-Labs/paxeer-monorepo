proof = "Execute the real deploy-payload module in process against a loopback Ganache EVM node on chain 125; assert root request/response envelopes and real block state, then consume its nonces in EIP-1559 deployment/list/buy calldata transactions and assert EVM receipts, transaction inputs and storage."
proof_limit = "The test proves standard EVM anchoring and transaction inputs; its storage/echo contract is not the native marketplace guest or the merged paxd implementation."
baseline = "Not run: the explicit implementation-first order and hf-done-only verification prohibit the contradictory unchanged-tree verify step; no baseline test result is claimed."
previous_attempt = "Attempt 2 verification failed before test registration while resolving the SDK; the declared gate now builds the SDK first, and named node:test subtests dynamically import its built dist and the production example so dependency and assertion failures retain their test context."
evidence = "The bounded hf-build and hf-done ledger in /out/run/gates.jsonl records the exact candidate revision, command, exit and private log; the final response copies the last gate evidence."
wiring_cli = "tools/platform/cli/src/main.rs and tools/platform/cli/src/programs.rs — platform-tools owner: reconcile the separate existing marketplace index lifecycle flags with the current EVM key-file CLI contract; no CLI source changes in this repair."
wiring_node = "rpc/ — chain node owner: run the retained native marketplace deployment/call release qualification against merged paxd; this task has only the declared JavaScript gates and no paxd build target."
preexisting_test_contract = "marketplace/test/deploy-payload.test.mjs still asserts retired emulator/kernel and lx_getSequence contracts (including selector identity); it was already inconsistent with the pending selector at the base and was neither changed nor run."

