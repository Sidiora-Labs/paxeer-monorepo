# Railway service dashboard (project layerx, environment beta) from
# docker/platform-dashboard/Dockerfile: the plain API listener answers GET /healthz on
# the same port. Every file row is an env var holding base64, written by
# layerx-env-files to the path shown; values are the base64 lines
# tools/bringup/mint-secrets.sh and tools/bringup/ca.sh print.
LAYERX_FILES_OWNER=65532:65532
PORT=9445
LAYERX_DASHBOARD_LISTEN=[::]:9445
LAYERX_DASHBOARD_LISTENER=plain
LAYERX_WEBHOOKS_REDIS_URL=rediss://redis-internal.railway.internal:6379
LAYERX_WEBHOOKS_LEASE_SECONDS=120
LAYERX_WEBHOOKS_INTERNAL_CA_DER=/run/layerx/ca/internal.der
LAYERX_WEBHOOKS_REDIS_USERNAME_FILE=/run/layerx/redis/username
LAYERX_WEBHOOKS_REDIS_PASSWORD_FILE=/run/layerx/redis/password
LAYERX_DASHBOARD_GATEWAY_REDIS_URL=rediss://redis-router.railway.internal:6379
LAYERX_DASHBOARD_REDIS_CA_DER=/run/layerx/ca/internal.der
LAYERX_DASHBOARD_INTERNAL_CA_DER=/run/layerx/ca/internal.der
LAYERX_DASHBOARD_GATEWAY_REDIS_USERNAME_FILE=/run/layerx/dashboard-redis/username
LAYERX_DASHBOARD_GATEWAY_REDIS_PASSWORD_FILE=/run/layerx/dashboard-redis/password
LAYERX_DASHBOARD_IDENTITY_URL=https://identity.railway.internal:9443
LAYERX_DASHBOARD_IDENTITY_TOKEN_FILE=/run/layerx/tokens/identity
LAYERX_DASHBOARD_CLIENT_IDENTITY_PKCS12=/run/layerx/client/identity.p12
LAYERX_DASHBOARD_CLIENT_IDENTITY_PASSWORD_FILE=/run/layerx/client/password
# /run/layerx/client/identity.p12 and password: ca.sh issue dashboard-client
DASHBOARD_CLIENT_P12=
DASHBOARD_CLIENT_PASSWORD=
# /run/layerx/ca/internal.der
DASHBOARD_CLIENT_CA_DER=
# /run/layerx/redis/username and password (internal Redis, webhooks store)
DASHBOARD_WEBHOOKS_REDIS_USERNAME=
DASHBOARD_WEBHOOKS_REDIS_PASSWORD=
# /run/layerx/dashboard-redis/username and password (router Redis, keys and usage)
DASHBOARD_GATEWAY_REDIS_USERNAME=
DASHBOARD_GATEWAY_REDIS_PASSWORD=
# /run/layerx/tokens/identity
DASHBOARD_IDENTITY_TOKEN=
# Not set: DASHBOARD_CLIENT_CERT (client cert.pem) duplicates in PEM the certificate the
# binary reads from identity.p12; no code path reads it.

# Additional settings. Commented assignments remain unset.
# Default: IPv4 loopback HTTP on port 9445 outside production; required in production.
# DASHBOARD_API_ORIGIN=
LAYERX_DASHBOARD_TLS_CERT_DER=
LAYERX_DASHBOARD_TLS_KEY_DER=
LAYERX_WEBHOOKS_BASE_DELAY_SECONDS=10
LAYERX_WEBHOOKS_MAXIMUM_ATTEMPTS=8
LAYERX_WEBHOOKS_MAXIMUM_DELAY_SECONDS=3600
LAYERX_WEBHOOKS_SPREAD_PERCENT=20
LAYERX_WEBHOOKS_SUSPEND_AFTER_DEAD_LETTERS=20
# Default: Unset; framework supplies its execution mode.
# NODE_ENV=
