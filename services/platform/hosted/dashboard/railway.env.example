# Environment variables for hosted/dashboard
# Required values have no default unless stated. Supply protected credentials separately.
# Commented assignments keep optional settings unset; enable complete feature groups together.
# Default: IPv4 loopback HTTP on port 9445 outside production; required in production.
# DASHBOARD_API_ORIGIN=
LAYERX_DASHBOARD_CLIENT_IDENTITY_PASSWORD_FILE=
LAYERX_DASHBOARD_CLIENT_IDENTITY_PKCS12=
LAYERX_DASHBOARD_GATEWAY_REDIS_PASSWORD_FILE=
LAYERX_DASHBOARD_GATEWAY_REDIS_URL=
LAYERX_DASHBOARD_GATEWAY_REDIS_USERNAME_FILE=
LAYERX_DASHBOARD_IDENTITY_TOKEN_FILE=
LAYERX_DASHBOARD_IDENTITY_URL=
LAYERX_DASHBOARD_INTERNAL_CA_DER=
# Default: All IPv4 interfaces, port 9445.
# LAYERX_DASHBOARD_LISTEN=
LAYERX_DASHBOARD_LISTENER=tls
LAYERX_DASHBOARD_REDIS_CA_DER=
LAYERX_DASHBOARD_TLS_CERT_DER=
LAYERX_DASHBOARD_TLS_KEY_DER=
LAYERX_WEBHOOKS_BASE_DELAY_SECONDS=10
LAYERX_WEBHOOKS_INTERNAL_CA_DER=
LAYERX_WEBHOOKS_LEASE_SECONDS=120
LAYERX_WEBHOOKS_MAXIMUM_ATTEMPTS=8
LAYERX_WEBHOOKS_MAXIMUM_DELAY_SECONDS=3600
LAYERX_WEBHOOKS_REDIS_PASSWORD_FILE=
LAYERX_WEBHOOKS_REDIS_URL=
LAYERX_WEBHOOKS_REDIS_USERNAME_FILE=
LAYERX_WEBHOOKS_SPREAD_PERCENT=20
LAYERX_WEBHOOKS_SUSPEND_AFTER_DEAD_LETTERS=20
# Default: Unset; framework supplies its execution mode.
# NODE_ENV=
