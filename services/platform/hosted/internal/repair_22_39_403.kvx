[queue_state.validate]
steps = ["validate_scheduling", "validate_retention_bounds", "validate_replay_boundary", "validate_retained_observations", "validate_resource_counters", "validate_pending_entries"]

[queue_state.validate_scheduling]
steps = ["check delivery attempts", "check redelivery state", "check delivery identity", "check refusal timestamps"]

[queue_state.validate_retention_bounds]
steps = ["check pending capacity", "check retained capacity", "check resource capacity", "check compacted counter capacity"]

[queue_state.validate_replay_boundary]
steps = ["check closed stream key"]

[queue_state.validate_retained_observations]
steps = ["validate observations", "check transition size", "collect stream sequences"]

[queue_state.validate_resource_counters]
steps = ["check resource keys and counters", "check compacted floors", "check contiguous sequences", "check counter coverage"]

[queue_state.validate_pending_entries]
steps = ["check pending stream order", "validate pending bodies", "check pending identities"]

