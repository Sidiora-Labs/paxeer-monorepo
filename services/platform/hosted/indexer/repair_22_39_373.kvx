lint = "clippy::too_many_lines"
reason = "Keep the ordered names route dispatch together without changing route precedence."

[allowance.2]
file = "api.rs"
item = "pub fn route_with"
lint = "clippy::too_many_lines"
reason = "Keep the existing ordered public route dispatch and refusal precedence together."

[allowance.3]
file = "paxeer.rs"
item = "fn decode_log"
lint = "clippy::too_many_lines"
reason = "Keep the existing event-family decoding order and transfer projection together."

[allowance.4]
file = "paxeer.rs"
item = "pub fn decode_cosmos_tx"
lint = "clippy::too_many_lines"
reason = "Keep one transaction decoding pass together with its existing event and transfer ordering."

[allowance.5]
file = "paxscan.rs"
item = "pub fn range"
lint = "clippy::too_many_lines"
reason = "Read all six table families in the same read-only repeatable-read transaction."

[allowance.6]
file = "store.rs"
item = "fn write_unit"
lint = "clippy::too_many_lines"
reason = "Keep every row family and cursor update in one atomic unit write path."

[allowance.7]
file = "store.rs"
item = "pub fn rollback"
lint = "clippy::too_many_lines"
reason = "Keep the finality checks and every projection deletion in one atomic rollback path."

[allowance.8]
file = "paxeer.rs"
item = "pub fn block_with_receipts"
lint = "clippy::type_complexity"
reason = "Preserve the public return type pairing a full block with its transaction-hash-indexed receipts."

[allowance.9]
file = "store.rs"
item = "pub fn name"
lint = "clippy::case_sensitive_file_extension_comparisons"
reason = "The suffix is a name-service domain, not a file extension; the name is already ASCII lowercase."

[allowance.10]
file = "store.rs"
item = "pub fn name_for_address"
lint = "clippy::case_sensitive_file_extension_comparisons"
reason = "The suffix is a name-service domain, not a file extension; the reverse name is already ASCII lowercase."

[allowance.11]
file = "transport.rs"
item = "fn source_io"
lint = "clippy::needless_pass_by_value"
reason = "Own the I/O error to match Result::map_err callbacks without changing the error adapter signature."

[implementation.notes]
ordinal = "Registry event ordinals use an i64 counter; the prior enumerate cast cannot wrap for a Vec of nonzero-sized EventRow values, whose allocated bytes are bounded by isize::MAX."
proof_fields = "Leaf operation fields 1 through 4 map to literal array indexes 0 through 3, preserving protobuf decoding without a narrowing cast."

