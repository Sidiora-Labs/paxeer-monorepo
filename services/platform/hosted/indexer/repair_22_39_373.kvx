[finding.test_lint]
task = "22.39.373"
file = "services/platform/hosted/indexer/tests and src unit-test modules"
symbol = "test targets (inventory only)"
observed = "At source revision e35304feb8bbbdde332bc02ea80e2e3bec88d075 with the in-scope lint repair applied, cargo clippy --locked --keep-going --manifest-path services/platform/Cargo.toml -p layerx-indexer --no-deps --tests --message-format=json -- -D warnings exited 101; private evidence /out/logs/indexer-test-lint.jsonl records 903 test-target reports."
assumption = "Existing test-target lint is outside this library-and-executables repair and is recorded without changes or reruns."
severity = "note"

[gotcha.task_scope]
symptom = "A clean library does not imply clean integration or unit-test targets; the test sweep reports existing test-only lints."
cause = "The declared verification lints only the library and executables, then executes two integration targets without linting them."
do = "Keep the test-target inventory separate from production target counts and qualify only through the declared bounded gates."
