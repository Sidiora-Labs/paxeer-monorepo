# Railway service indexer (project layerx, environment beta), image docker/platform-indexer/Dockerfile; one replica, volume at /data.
# No public domain; the router reaches the TLS listener at https://indexer.railway.internal:8095 under the internal CA.
LAYERX_INDEXER_DB=/data/state/indexer.sqlite
LAYERX_INDEXER_LISTEN=[::]:8095
LAYERX_INDEXER_TLS_CERT_DER=/data/tls/indexer/cert.der
LAYERX_INDEXER_TLS_KEY_DER=/data/tls/indexer/key.der
LAYERX_INDEXER_EVM_CHAIN_ID=125
LAYERX_INDEXER_EVM_CA_DER=/usr/local/share/layerx/isrg-root-x1.der
LAYERX_INDEXER_COMET_CA_DER=/usr/local/share/layerx/isrg-root-x1.der
LAYERX_INDEXER_RELAY_URL=https://archive.paxeer.network
LAYERX_INDEXER_RELAY_CA_DER=/usr/local/share/layerx/isrg-root-x1.der
LAYERX_INDEXER_EXPLORER_URL=https://api.paxscan.io
LAYERX_INDEXER_EXPLORER_CA_DER=/usr/local/share/layerx/isrg-root-x1.der
LAYERX_INDEXER_ABI_DIR=/usr/local/share/layerx/precompiles

# The archive node's public RPC name and its CometBFT location; env-init.sh reads LAYERX_INDEXER_START_BLOCK from it at run time.
LAYERX_INDEXER_EVM_URL=
LAYERX_INDEXER_COMET_URL=
# Backfill requires the read-only paxscan Postgres URL and the paxscan certificate's 32-byte SHA-256 pin as 64 hex characters; fill both.
PAXSCAN_DATABASE_PUBLIC_URL=
LAYERX_INDEXER_PAXSCAN_CERT_SHA256=

# Separate layerx-ai-source process beside the indexer, one per node endpoint.
# Keep this listener private. Configure RuntimeConfig.source to http://127.0.0.1:8096
# when both processes share a network namespace. The indexer still pins validators.
# LAYERX_INDEXER_AI_CONFIG=/data/config/ai-runtime.json
LAYERX_AI_SOURCE_LISTEN=127.0.0.1:8096
LAYERX_AI_SOURCE_NODE_URL=http://127.0.0.1:26657
# Optional DER trust anchor for an HTTPS node. Plaintext node URLs must be loopback.
LAYERX_AI_SOURCE_NODE_CA_DER=
# Required deployment chain domain and program: each exactly 32 bytes in hex.
LAYERX_AI_SOURCE_CHAIN=
LAYERX_AI_SOURCE_PROGRAM=
