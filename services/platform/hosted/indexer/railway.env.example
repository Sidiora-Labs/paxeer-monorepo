# Environment variables for hosted/indexer
# Required values have no default unless stated. Supply protected credentials separately.
# Commented assignments keep optional settings unset; enable complete feature groups together.
LAYERX_AI_SOURCE_CHAIN=
LAYERX_AI_SOURCE_LISTEN=
# LAYERX_AI_SOURCE_NODE_CA_DER=
LAYERX_AI_SOURCE_NODE_URL=
LAYERX_AI_SOURCE_PROGRAM=
# LAYERX_INDEXER_ABI_DIR=
# LAYERX_INDEXER_AI_CONFIG=
LAYERX_INDEXER_ALLOW_REMOTE_PLAINTEXT=0
LAYERX_INDEXER_BACKFILL_RANGE_BLOCKS=1000
# Default: Built-in chains registry precompile.
# LAYERX_INDEXER_CHAINS_PRECOMPILE=
# LAYERX_INDEXER_CLIENT_CA_DER=
LAYERX_INDEXER_COMET_ATTRIBUTES=base64
# LAYERX_INDEXER_COMET_CA_DER=
# LAYERX_INDEXER_COMET_URL=
LAYERX_INDEXER_DB=
# LAYERX_INDEXER_EVM_CA_DER=
# LAYERX_INDEXER_EVM_CHAIN_ID=
LAYERX_INDEXER_EVM_URL=
# LAYERX_INDEXER_EXPLORER_CA_DER=
# LAYERX_INDEXER_EXPLORER_URL=
# Default: 0 for committed block ingestion.
# LAYERX_INDEXER_FINALITY_DEPTH=
# Default: IPv4 loopback, port 8095.
# LAYERX_INDEXER_LISTEN=
LAYERX_INDEXER_MAX_UNITS_PER_STEP=64
# LAYERX_INDEXER_NAMES_CONTROLLER=
# LAYERX_INDEXER_NAMES_REGISTRAR=
# LAYERX_INDEXER_NAMES_REGISTRY=
# LAYERX_INDEXER_NAMES_RESOLVER=
# LAYERX_INDEXER_NAMES_REVERSE=
# LAYERX_INDEXER_PAXSCAN_CERT_SHA256=
# LAYERX_INDEXER_PAXSCAN_TLS_UNAUTHENTICATED=
LAYERX_INDEXER_POINTERS=
LAYERX_INDEXER_POLL_MS=1000
LAYERX_INDEXER_STALL_SECS=30
LAYERX_INDEXER_START_BLOCK=1
LAYERX_INDEXER_TIMEOUT_MS=10000
# LAYERX_INDEXER_TLS_CERT_DER=
# LAYERX_INDEXER_TLS_KEY_DER=
PAXSCAN_DATABASE_PUBLIC_URL=
