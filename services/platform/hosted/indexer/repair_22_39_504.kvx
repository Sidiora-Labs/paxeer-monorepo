[platform_tests]
rule = "Indexer event cases state every loaded launchpad event by name, signature, topic and count; generator drift trees include every generated output and compare it with the published inventory. Platform tests run workspace cases serially and build the kernel and program sandbox archives before invoking application producers, which deliver their receipts to the history assertions. Budget revocation returns unused funds with or without spend in the period; the payment proof preserves its spend, funding and revocation sequence and its two recorded blocks. PaxAI admission, recovery, membership, task handoff, transport and workload cases build markets with the current AI-market state sections and operation inputs while retaining their service assertions. PaxAI tests use the configured runner or the member-built runner; recovery gives the built runner isolated durable state and model directories shared by replicas and restarts. Worker TLS cases publish native state chunks before requesting signed status and refuse new admissions after finalized authority becomes unavailable. Workload aggregation runs the joint F05/F07 epoch transition, and unsupported metadata schema cases use a version outside the supported pair. The endpoint client refuses unknown paths locally, and a certificate-validated, pinned TLS request verifies the worker HTTP refusal for the same path."
files = ["services/platform/hosted/indexer/src/abi.rs", "services/platform/hosted/indexer/tests/history_position.rs", "services/platform/hosted/indexer/tests/native_membership_history.rs", "services/platform/hosted/indexer/tests/support/consumer_fixture.rs", "services/platform/hosted/paxai-worker/tests/job_admission.rs", "services/platform/hosted/paxai-worker/tests/job_recovery.rs", "services/platform/hosted/paxai-worker/tests/membership_recovery.rs", "services/platform/hosted/paxai-worker/tests/real_workload.rs", "services/platform/hosted/paxai-worker/tests/support/authority_snapshot.rs", "services/platform/hosted/paxai-worker/tests/task_chain_handoff.rs", "services/platform/hosted/paxai-worker/tests/transport_identity.rs", "services/platform/hosted/paxai-worker/tests/transport_and_admission_lifecycle.rs", "services/platform/hosted/paxai-worker/tests/support/native_workload_extra.rs", "sdk/platform/generators/tests/drift.rs", "sdk/platform/pipeline.kvx", "services/platform/Makefile.inc", "precompiles/layerxpay/proof_layerxpay_0x101b_test.go"]
generation_command = "make platform-sdk-generate"
build_command = "make -s platform-build"
command = "test -s services/platform/hosted/indexer/repair_22_39_504.kvx && make -s platform-test"
selection_variables = ["PLATFORM_TEST_SCOPE", "PLATFORM_TOOLS_TEST_SCOPE"]
