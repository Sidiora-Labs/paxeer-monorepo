[repair.22.33.1319]
audit = "spec/layerx-merge/programme/audit/records/22.30.70.kvx"
base_revision = "72c91077cb966f1c4c640ded61b4b259f41cad90"
scope = "services/platform/hosted/paxeer"
decision = "Remove the historical deployment runner; retain no contract broadcasting, signing command or phase resumption interface. Resolve the native deployment from its maintained node owner instead of copying a second chain configuration."
entrypoint = "go run ./services/platform/hosted/paxeer/cmd/deployment manifest services/platform/hosted/paxeer/deployment-profile.json; apply the resulting maintained node manifest. The profile subcommand emits the validated native-node and tenant-domain inputs."
initialization = "init-chain.sh forwards explicit native bootstrap arguments to ../node/bootstrap.sh and refuses legacy environment configuration; prepare-beta.py refuses the removed deployment-input consumer before generating keys or writing artifacts. Existing fixture encoder/key-helper imports are preserved for their separately scoped retirement tasks."
historical_support = "Not retained: deployment-key-argv and deployment-phase-recovery are eliminated by deleting deploy-contracts.sh, not by inventing a replacement historical signer or receipt journal. No historical deployment, receipt reconciliation or chain restart qualification is claimed."
baseline = "Not run: the task's ordered gate instructions prohibit verification before implementation and prohibit running verify_cmd by hand. repair_m1319_test.go and a Go package were absent at the base; no baseline failure or passing baseline is claimed."
qualification = "Run only hf-build then hf-done on the unchanged candidate; the runner's final hf-done JSON and private gate ledger name the exact verified revision, command, exit and log. The runner publishes the task; this record makes no pre-gate success claim."

[finding.relay-retirement-1]
repair = "Retain the boundary Cargo manifest and layerx-paxeer-boundary binary declaration per decision 2524. Decision 2532 deploys exactly one maintained chain and one kernel container, ghcr.io/sidiora-labs/kernel:0.1.0; the rendered node, provisioner and node fixture images must agree, and no relay binary is deployed. The workspace wiring request is withdrawn."
test = "TestRepairM_1319_RelayWorkspaceRetirement"

[finding.relay-retirement-3]
repair = "Deleted custody-genesis.py and the relay-owned genesis mutations; retained initialization delegates to the native node bootstrap. Decision 2532 provisions genesis.json, config.toml, app.toml, priv_validator_key.json and receipt.key through the rendered native-home paths map; tests decode that map rather than searching an obsolete init-container name."
test = "TestRepairM_1319_CustodyGenesisRetirement"

[finding.relay-retirement-4]
repair = "Deleted deploy-contracts.sh; the rendering handler refuses every historical phase before opening a profile, key or endpoint. There is no current settlement deployment or checkpoint-domain writer in the handoff."
test = "TestRepairM_1319_RelayDeployerRetirement"

[finding.deployment-key-argv]
repair = "Deleted the cast wallet/send signing commands with the unsupported runner. The handoff refuses signing operations and raw-key flags without leaking keys. Decision 2532 keeps raw signing material out of both node command and args and provisions receipt.key as config/receipt.key; no receipt-key command-line flag is required or accepted by the deployment assertion."
test = "TestRepairM_1319_DeploymentKeyArgv"

[finding.deployment-phase-recovery]
repair = "Deleted the nonrecoverable runner rather than retaining historical deployment support. Closing and reopening the real read-only handoff preserves its native manifest, leaves a committed recorded broadcast transcript untouched, publishes no legacy phase record and refuses phase resumption."
test = "TestRepairM_1319_DeploymentPhaseRecovery"
limit = "The test qualifies retirement across a handoff restart, not interruption/reconciliation of an executable historical contract broadcast: that component has been removed."

[finding.relay-retirement-5]
repair = "Deleted deployment-input.beta.json; deployment-profile.json contains only schema, maintained native node identity/routes and tenant gateway routing. The production profile codec rejects legacy settlement and phase fields."
test = "TestRepairM_1319_SettlementInputRetirement"

[finding.relay-retirement-6]
repair = "Deleted the relay StatefulSet, custody mounts, TLS sidecar, relay Services and relay policy manifest; the production renderer hands off the exact maintained ../node/deployment.yaml bytes and root RPC origins. Decision 2532 exposes rpc 8545 to rpc, consensus 26657 to consensus and health 9460 to health, with HTTP /readyz probes. Tests compare rendered selectors, container/service ports and probes, and profile RPC ports, without duplicating manifest port numbers. Group consumers must apply that canonical deployment once."
test = "TestRepairM_1319_NativeDeployment"

[finding.relay-retirement-7]
repair = "Deleted evm.py. The remaining historical settlement fixture helper imports only the maintained SDK's public-data Keccak function; supported operator signing/client migrations outside scope are wiring requests."
test = "TestRepairM_1319_EVMToolRetirement"

[proof]
path = "Committed native profile -> production strict JSON reader -> production rendering CLI handler -> OS pipe -> YAML codec consuming the actual maintained Kubernetes resources. The restart case also uses production WriteProfile -> synced file -> OpenDeployment/Close/OpenDeployment -> exact native manifest bytes."
peers = "The real committed ../node/deployment.yaml, ../node/bootstrap.sh and ../node/tests/fixtures/repair_22_31_355/native_configuration.json; no replaced deployment component, mocked network or subprocess toolchain."
negative_test = "TestRepairM_1319_ProfileRefusals"
gates = "For 22.31.481: hf-build runs go vet ./services/platform/hosted/paxeer/; hf-done runs cg spec done 22.31.481 -f layerx-merge --root $TASK_ROOT with the declared TestRepairM_1319_ gate and graph checks. The private gate ledger and final evidence line identify the verified revision and outcomes. Relay retirement and single-chain checks remain; legacy Rust/Python relay test-target migration belongs to its own audit findings."

[wiring.workspace]
request = "Withdrawn per decision 2524: retain hosted/paxeer in services/platform/Cargo.toml and the boundary binary consumers in services/platform/Makefile.inc; retirement of the historical deployment runner does not retire the boundary crate."

[wiring.cluster]
request = "services/platform/hosted/tests/beta-cluster.sh — platform domain 8: remove custody-genesis.py, deploy-contracts.sh, prepare-beta.py and relay-manifest invocations; apply services/platform/hosted/node/deployment.yaml once, provision authoritative native inputs, and remove settlement ConfigMap publication."

[wiring.funding]
request = "daemon/paxd/cmd, modules/layerxledger/keeper/genesis.go and services/platform/hosted/node/native_runtime.py — native node/ledger domains 5/6: provision and validate bank and layerxledger funding in the authoritative merged genesis consumed by native bootstrap; preserve validator membership, pinned receipt keys and existing chain data."

[wiring.routing]
request = "services/platform/hosted/gateway and services/platform/hosted/testnet — platform/RPC domains 8/7: consume the native root RPC on layerx-native-chain:8545 with consensus evidence on :26657; update the removed deployment.yaml include in gateway/tests/repair_22_31_345.rs and topology defaults without a relay sidecar/service."

[wiring.images]
request = "docker/paxeer/Dockerfile, docker/paxeer/Dockerfile.paxd, tools/containers/check.sh and tools/workspace/platform-dependency-roots.txt — image/tooling domain 16: remove relay binary/member/image wiring and package the maintained native bootstrap and provisioned native home instead of the old relay init image."

[wiring.operator_tools]
request = "tools/bringup/kernel-genesis.sh, tools/bringup/tests/paxeer-x-fixture-foundation.py, tools/bringup/tests/paxeer-x-runtime-contract.py, tools/qualification/paxeer-x/fixtures/xweb_fixture.py and tools/release/rehearsal/programme.py — tooling/node domains 16/5: move retained EVM operator actions to their maintained SDK/node owner, preserve protected-file signing and refusal coverage, and remove evm.py/custody-genesis.py consumers."

[wiring.qualification]
request = "tools/paxeer-x/gates/24.16.sh, tools/qualification/paxeer-x/programs_accounts_winddown.py, tools/qualification/paxeer-x/router-complete-readiness.py and tools/platform/cli/README.md — tooling/platform domains 16/8: qualify and document the maintained node profile instead of the removed relay crate, deployer or signer paths."

[gotcha.gate_order]
observed = "Step 12 asks for an unchanged-tree baseline, while the explicit ordered instructions permit only implementation, hf-build, then hf-done and forbid hand-running verify_cmd."
resolution = "Follow the ordered bounded gates; record baseline as unmeasured, not as a fabricated failure or pass."

[gotcha.scope]
observed = "The proposals require changes to parent Cargo membership, cluster/group consumers, images and operator tooling beyond the allowed directory."
resolution = "Record exact paths and owning domains as wiring requests, leave those files untouched, and do not claim integrated workspace/image/cluster qualification."

[repair.22.31.465]
base_revision = "9fda5aafcf8b4dba3d79ad6d650ea1272c960511"
files = ["services/platform/hosted/paxeer/Cargo.toml", "services/platform/hosted/paxeer/repair_m1319_test.go", "services/platform/hosted/paxeer/repair_m1319.kvx"]
repair = "Restore the boundary manifest exactly as it stood before repair 22.33.1319, retaining workspace metadata, lints, dependencies and the existing platform lockfile. Remove only the obsolete manifest-absence assertion; preserve every deployment-document assertion."
build_cmd = "cargo build --locked --manifest-path services/platform/hosted/paxeer/Cargo.toml --tests && go vet ./services/platform/hosted/paxeer/"
verify_cmd = "cargo metadata --locked --format-version 1 --manifest-path services/platform/Cargo.toml > /dev/null && cargo build --locked --manifest-path services/platform/hosted/webhooks/Cargo.toml --tests && go test -count=1 -run '^TestRepairM_1319_' ./services/platform/hosted/paxeer/"
qualification = "Run hf-build then hf-done on the unchanged candidate. The runner's final hf-done JSON and private gate ledger record the exact verified revision, command, exit code and log; no gate success is claimed before those gates run."
