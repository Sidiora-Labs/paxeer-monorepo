[repair.22.33.1323]
audit = "spec/layerx-merge/programme/audit/records/22.30.70.kvx"
base_revision = "cfe99ca0f6e389c490375eed57c49af7d14b30b8"
status = "implemented in-process genesis migration and native profile proofs; not qualified; eight-finding closure is not claimed"
continuation = "Decision 2524 and 22.31.465 restore the manifest and existing Rust handlers; the previous attempt's missing-manifest blocker is resolved. Its unchanged findings and wiring requests below are historical observations, not current missing-manifest claims."
implementation = "genesis.rs calls support/genesis_transport.rs in process, compiling the unchanged production main.rs, genesis.rs and transport.rs. Loopback HTTP peers serve the committed genesis fixture. The qualifier retains direct/wrapped and HTTP-chunked identity, SHA256, consumer headers, ordered genesis chunks, malformed envelopes and metadata/base64, direct and aggregate 32 MiB limits, truncation, 30-second deadline, endpoint rejection, route restrictions and unreachable-node refusal. It no longer launches Python, OpenSSL or the boundary executable."
profile_proof = "repair_m1323_test.go drives the actual native WriteProfile/RunDeployment/OpenDeployment/WriteManifest consumer and OS pipe, closes and reopens the deployment and compares canonical manifest bytes; all seven retired deployment phases plus bootstrap/check-profile/status are refused by the real handler. These Go proofs are implemented, not executed by the corrected Rust-only gate."
remaining = "comet.py, deployment_profile.py, genesis.py, gov-scripts-test.sh, real_chain.py and real_chain.rs retain their existing assertions pending maintained-owner adoption. Do not claim that in-process qualification of the restored transport alone migrates the node owner or executes the Go/Bash producers."
baseline = "Unmeasured: explicit ordered gates prohibit verification before implementation and prohibit running verify_cmd manually. The prior attempt failed before compilation because the manifest was absent; no pre-change test failure or success is inferred."
qualification = "Only hf-build then hf-done are authorized. The private gate ledger and final response record candidate revision, exact command, exit and log; no successful gate or closure is declared here. The corrected Rust target now executes ten TestRepairM_1323_ functions against unchanged production code. NativeProfileConsumer checks the committed maintained deployment-profile artifact against the real restored NodeEndpoint parser. It must accept the maintained node root origin to enable this migration; the existing parser only permits literal loopback addresses. Do not widen that production security boundary outside scope, relax the test, or claim all eight findings closed."

