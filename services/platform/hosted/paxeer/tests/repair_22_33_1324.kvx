[finding.relay-retirement-28]
tests = ["relay_retirement_28_bounded_tls_shutdown_and_resource_release"]
repair = "The focused Rust target retains 1000 successful TLS requests across eight clients, exact body framing, bidirectional close_notify, the one-second shutdown bound, joined workers, released TLS configurations and immediate listener-port reuse; it needs no relay process or Python toolchain. The Python endpoint probe now exposes qualify(port, ca_file) for the maintained service owner, and the legacy caller invokes it directly instead of starting a separate test subprocess; every original response/id/result/unwrap assertion remains."
wiring_request = "Domain 8: services/platform/hosted/gateway/src/main.rs and services/platform/hosted/gateway/tests: adopt the bounded close_notify/resource-release assertions in the maintained gateway's real connection lifecycle; retirement of services/platform/hosted/paxeer/Cargo.toml and external relay launch targets belongs to their owner, outside this task's paths."

