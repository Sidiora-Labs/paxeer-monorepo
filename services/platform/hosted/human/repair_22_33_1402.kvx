[finding.owner-test-current-success]
test = "test_TestRepairM_1402_OwnerTestCurrentSuccess"
repair = "test_owner_native.py uses the merged owner configuration and production owner_native.produce, merged_owner codec/HTTPS client, provision.owner_registration and provision.funding_evidence instead of the retired daemon socket and custody-credit bootstrap."
proof = "Eleven selected owner tests execute in process against the committed TLS loopback peer. They assert exact source debit and owner credit, authenticated funding transactions, original identity and recovery policy, then stop and reopen the peer and rerun the producer and consumer with unchanged evidence, balances and raw transactions."
refusals = "Missing funding evidence, wrong requested identity, changed original owner DID, malformed configuration, truncated or tampered receipts, forged guardian signatures, unsigned guardian sets and substituted guardian sets remain asserted; a correctly rotated guardian set succeeds with its own recovery policy."

[finding.web-explorer-relay]
test = "test_TestRepairM_1402_WebExplorerRelay"
repair = "web-deployment.yaml replaces the retired explorer-index configuration and relay with PAXEER_X_EXPLORER_BASE_URL from the required layerx-human-web-explorer/base-url ConfigMap, the internal CA Secret mounted for Node TLS verification, and paired HTTPS network policies for the current explorer backend. Retired program bearer and naming Secrets are no longer consumed."
proof = "The test parses the actual deployment and policies, checks exact current origin and CA wiring, checks removal of retired relay/authentication inputs, and preserves the production web client's documented program-read refusal. No successful deployed-program read is claimed."
observed = "apps/web/src/explorer/client.ts programRecord validates the identifier and explorer origin, then throws ExplorerInterfaceUnavailableError with program-read (interface.8.err-core-program-read-refused). Step 11 explicitly accepts this documented refusal; completing the external read remains a domain 10/14 wiring request."

[wiring]
web_consumer = "Domain 10: apps/web/src/explorer/client.ts and apps/web/src/explorer/model.ts must consume the native deployed-program read once domain 14 publishes it, retaining explicit unavailable refusals."
explorer_producer = "Domain 14: services/explorer/backend and services/explorer/deploy must publish the native deployed-program read and provision layerx-human-web-explorer/base-url with the current HTTPS origin, a Service on port 443 and backend pod label app=paxeer-x-explorer-backend in layerx-testnet to match the paired policies."

