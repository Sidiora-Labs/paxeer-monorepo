[finding.funding-wrong-network]
tests = ["funding_wrong_network_refuses_connection_readiness_and_signing", "funding_wrong_network_durable_intent_is_bound_on_reopen"]
repair = "Require deployment EVM chain 125 on connection, readiness and immediately before signing; validate the durable signed-transfer chain with the same deployment constant."
proof = "Loopback RPC exercises refused network IDs, correct-network raw signing and cached-origin drift; real durable storage is closed and reopened before replay and foreign-network refusal."

[finding.absent-receipt-status]
tests = ["absent_receipt_status_preserves_lookup_and_http_outcomes"]
repair = "Carry typed absent, submitted and verified results through lookup and route consumption; return 404 for absence, 202 for submission and 503 with Retry-After for dependency failures."
proof = "Recorded producer receipt and submitted fixtures traverse the real RPC client, receipt authentication and TLS HTTP route, including successful receipt and unavailable receipt/key dependency cases."

[finding.receipt-event-authentication]
tests = ["receipt_event_authentication_accepts_producer_evidence_without_promoting_rung", "receipt_event_authentication_rejects_unpinned_and_mismatched_evidence", "receipt_event_authentication_keeps_authentication_absence_and_submission_distinct"]
repair = "Use the authenticated lookup with receipt-key identity and height policy; preserve the authenticated rung and refuse unpinned signatures, invalid logs and mismatched execution fields."
proof = "Committed Go-producer success/refusal and negative vectors traverse loopback RPC, the real signature/log verifier and TLS event route; mutated execution metadata and unsupported rung promotion are checked separately."
