# Environment variables for hosted/webhooks
# Required values have no default unless stated. Supply protected credentials separately.
# Commented assignments keep optional settings unset; enable complete feature groups together.
# Default: All IPv6 interfaces, port 8080 in shared HTTP; webhook init uses PORT, otherwise role-specific port 9442 (public) or 8080 (ingress).
# LAYERX_HEALTH_ADDR=
LAYERX_ROLE=
# LAYERX_WEBHOOKS_APPROVAL_SOURCE_TOKEN_FILE=
# LAYERX_WEBHOOKS_APPROVAL_SOURCE_URL=
LAYERX_WEBHOOKS_BASE_DELAY_SECONDS=10
# LAYERX_WEBHOOKS_CHAIN_POLICY_FILE=
LAYERX_WEBHOOKS_CLIENT_IDENTITY_PASSWORD_FILE=
LAYERX_WEBHOOKS_CLIENT_IDENTITY_PKCS12=
# LAYERX_WEBHOOKS_COMET_URL=
LAYERX_WEBHOOKS_CURSOR_KEY_FILE=
LAYERX_WEBHOOKS_DISPATCH_BUDGET=64
LAYERX_WEBHOOKS_DISPATCH_INTERVAL_SECONDS=1
# Default: Unset in the binary; init derives it from LAYERX_HEALTH_ADDR, PORT or its role default.
# LAYERX_WEBHOOKS_HEALTH_LISTEN=
# LAYERX_WEBHOOKS_IDENTITY_TOKEN_FILE=
# LAYERX_WEBHOOKS_IDENTITY_URL=
# LAYERX_WEBHOOKS_INGRESS_CLIENT_CA_DER=
LAYERX_WEBHOOKS_INSTANCE_ID=
LAYERX_WEBHOOKS_INTERNAL_CA_DER=
# LAYERX_WEBHOOKS_JOURNEY_SOURCE_TOKEN_FILE=
# LAYERX_WEBHOOKS_JOURNEY_SOURCE_URL=
LAYERX_WEBHOOKS_KEY_OVERLAP_SECONDS=86400
LAYERX_WEBHOOKS_KMS_TOKEN_FILE=
LAYERX_WEBHOOKS_KMS_URL=
LAYERX_WEBHOOKS_LEASE_SECONDS=120
# Default: All IPv4 interfaces, port 9444; init selects IPv6 port 9444 for public or 9443 for ingress.
# LAYERX_WEBHOOKS_LISTEN=
LAYERX_WEBHOOKS_LISTENER=tls
# LAYERX_WEBHOOKS_MARKET_OUTBOX_DIR=
# LAYERX_WEBHOOKS_MARKET_POLICY_FILE=
LAYERX_WEBHOOKS_MAXIMUM_ATTEMPTS=8
LAYERX_WEBHOOKS_MAXIMUM_DELAY_SECONDS=3600
# LAYERX_WEBHOOKS_NODE_TOKEN_FILE=
# LAYERX_WEBHOOKS_NODE_URL=
# LAYERX_WEBHOOKS_OPERATOR_TOKEN_FILE=
# LAYERX_WEBHOOKS_PAYMENT_SOURCE_TOKEN_FILE=
# LAYERX_WEBHOOKS_PAYMENT_SOURCE_URL=
# LAYERX_WEBHOOKS_PROGRAM_SOURCE_TOKEN_FILE=
# LAYERX_WEBHOOKS_PROGRAM_SOURCE_URL=
LAYERX_WEBHOOKS_PUBLIC_CA_DER=
LAYERX_WEBHOOKS_REDIS_PASSWORD_FILE=
LAYERX_WEBHOOKS_REDIS_URL=
LAYERX_WEBHOOKS_REDIS_USERNAME_FILE=
LAYERX_WEBHOOKS_RETENTION_EVENTS=10000
LAYERX_WEBHOOKS_ROLE=
# LAYERX_WEBHOOKS_SOURCE_TRIGGER_TOKEN_FILE=
LAYERX_WEBHOOKS_SPREAD_PERCENT=20
LAYERX_WEBHOOKS_SUSPEND_AFTER_DEAD_LETTERS=20
LAYERX_WEBHOOKS_TLS_CERT_DER=
LAYERX_WEBHOOKS_TLS_KEY_DER=
# PORT=
# Default: System hostname used by webhook init when unset.
# RAILWAY_REPLICA_ID=
