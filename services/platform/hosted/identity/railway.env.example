# Environment variables for hosted/identity
# Required values have no default unless stated. Supply protected credentials separately.
# Commented assignments keep optional settings unset; enable complete feature groups together.
# IDENTITY_DASHBOARD_TOKEN=
# IDENTITY_FAUCET_TOKEN=
# IDENTITY_GATEWAY_TOKEN=
# IDENTITY_PROVISIONING_TOKEN=
# IDENTITY_RAMP_TOKEN=
# IDENTITY_REGISTRAR_TOKEN=
# IDENTITY_REGISTRY_TOKEN=
# IDENTITY_TESTNET_TOKEN=
# IDENTITY_WEBHOOKS_TOKEN=
# LAYERX_IDENTITY_CLIENT_CA_DER=
# LAYERX_IDENTITY_DISPOSABLE_DOMAINS_FILE=
# Default: All IPv6 interfaces, port 8080.
# LAYERX_IDENTITY_HEALTH_ADDR=
# Default: All IPv6 interfaces, port 9443.
# LAYERX_IDENTITY_LISTEN=
LAYERX_IDENTITY_SERVICE_TOKENS_DIR=
LAYERX_IDENTITY_SESSION_TTL_SECONDS=86400
LAYERX_IDENTITY_SIGNUP_DAILY_CAP=1000
# Default: signup-outbox under LAYERX_IDENTITY_STATE_DIR.
# LAYERX_IDENTITY_SIGNUP_OUTBOX_DIR=
LAYERX_IDENTITY_SIGNUP_PER_EMAIL_PER_HOUR=3
LAYERX_IDENTITY_SIGNUP_PER_IP_PER_HOUR=5
LAYERX_IDENTITY_SIGNUP_TOKEN_TTL_SECONDS=86400
# LAYERX_IDENTITY_SMTP_FROM=
# LAYERX_IDENTITY_SMTP_URL=
LAYERX_IDENTITY_STATE_DIR=
LAYERX_IDENTITY_STORE_KEY_FILE=
LAYERX_IDENTITY_TLS_CERT_DER=
LAYERX_IDENTITY_TLS_KEY_DER=
