[repair.22.31.209]
finding = "rewind-projections"
status = "implemented; qualification is recorded by the bounded task gates"
proof = ["TestRepair_209_RefoldAndRestart", "TestRepair_209_EmptySurvivorAndRollback", "TestRepair_209_FollowerRecovery", "TestRepair_209_SnapshotBoundary", "TestRepair_209_CapturedScope", "TestRepair_209_InvalidRecovery"]
behavior = "Use captured accounts, markets and fork time after deletion; refold surviving facts through the real store, remove orphan projections and spot state, preserve unrelated account rows and keep recovery inside the follower transaction."
compatibility = "The store already accepts captured store.Recovery; the follower's global snapshot deletion and missing spot scope still require a full surviving-history refold; transaction-local copies preserve unrelated account projections exactly. Spot history is refolded globally because Affected does not carry registry or token entities."
baseline = "No unchanged-tree verify was run: the explicit gate order permits verification only through hf-done after implementation and hf-build, with a single initial verification budget. No baseline failures are claimed."
evidence = "The runner records the exact candidate revision, command, exit and private log in /out/run/gates.jsonl; the final response copies the final bounded gate record."
wiring_store = "services/platform/perps-data/internal/store/facts.go — perps-data, owner_domain 8: retain the existing captured-scope Recovery API and coordinate snapshot deletion boundaries with source/follower.go so the indexer can replace its full-history compatibility fold with a scoped call."
wiring_source = "services/platform/perps-data/internal/source/follower.go — perps-data, owner_domain 8: capture spot token/registry entities before fork deletion and pass them in Affected for a scoped spot refold."
wiring_replay = "services/platform/perps-data/cmd/perps-replay/main.go — perps-data, owner_domain 8: pass source.Affected as store.Recovery to the existing captured-scope store API rather than discarding it in Rebuild(From, From)."

[qualification.constraints]
service_free = "RefoldAndRestart, EmptySurvivorAndRollback, SnapshotBoundary and FollowerRecovery use the real PostgreSQL-only store and the harness database variable. FollowerRecovery now starts its RPC, Comet and broker peers in-process without live endpoint variables. Retained store assertions are not weakened or replaced with doubles; the no-PostgreSQL requirement remains unfulfilled."
seed_failure = "The supplied previous-attempt output records TestRepair_209_FollowerRecovery failing for missing PERPS_DATA_TEST_RPC because it called the TestIndexer setup fixture. No new baseline run is claimed."
implementation = "Pass captured accounts, markets and FromTime as store.Recovery even for an empty survivor, remove the redundant manual spot-history codec/refold now supplied by the store, and reject unsigned height overflow or missing scoped recovery time before mutation."
rpc_fixture = "testdata/repair_209_rpc.json supplies exact EVM block, log and registry-call exchanges and Comet header/results exchanges through one loopback HTTP server; unmatched requests and unused exchanges fail the test. FollowerRecovery explicitly clears the live RPC and Comet variables, uses the production New wiring, verifies the rewind envelope, closes the database and all first-indexer peers, reopens the indexer and consumes canonical logs into real store facts."
wiring_test_storage = "services/platform/perps-data/internal/store — perps-data, owner_domain 8: provide a service-free transactional database fixture for Open, Migrate, WriteBlock and Rebuild; the existing PostgreSQL-only API prevents the retained real-store proofs from meeting the no-PostgreSQL and no-database-variable requirement within this indexer-only scope."
