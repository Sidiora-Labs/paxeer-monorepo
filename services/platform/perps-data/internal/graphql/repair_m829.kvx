[repair.22.33.829]
audit = "22.30.18"
finding = "7"
base_revision = "fedbeb3bb47c5bb972f66afc8189f92f5395f3eb"
tests = ["TestRepairM_829_ProducerToGraphQLAndSnapshots", "TestRepairM_829_PriceChangeWindows", "TestRepairM_829_IndexSubscription", "TestRepairM_829_SharePointerTable"]
semantics = "Latest index is the greatest (block, tx_index, log_index, sub) among MarkPriceUpdated and non-null successful aggregates; skipped aggregates never contribute; observation time is that row's block_time; mark and mark history remain MarkPriceUpdated values; basis is (latest mark - latest index) * 10000 / latest index, rounded to three decimals, null at zero index."
coverage = "Production ABI/block-event decoding is checked against actual PostgreSQL-stored rows; exact recorded SQL requests and server results drive production GraphQL HTTP, records.Symbol, REST, socket snapshot providers and GraphQL subscription delivery without a database at gate time."
transcript = "testdata/repair_m829/postgres.json; reproducible fixture authoring is testdata/repair_m829/capture.py; PostgreSQL migrations and recorded producer inputs run inside one rolled-back transaction. Clock parameters are explicitly recorded with offsets and checked against the runtime clock when replayed."
baseline = "No baseline verify was run: the task's explicit gate order prohibits tests before complete implementation and prohibits running verify_cmd by hand; the new TestRepairM_829_* tests did not exist on the base, so no pre-change failing test run is claimed."
baseline_observation = "The committed baseline_latest transcript runs the exact base-revision SQL against the same stored producer inputs: index_without_mark returns BTC=100 at block 100 instead of 110 at block 101 and omits the index-only ETH market; TestRepairM_829_ProducerToGraphQLAndSnapshots asserts that recorded defect before proving the repaired path."
qualification = "The runner's final hf-build/hf-done evidence supplies the exact candidate revision, command, exit and private log; no test, build or completion gate is claimed by this source record."

[wiring.data_services_contract]
