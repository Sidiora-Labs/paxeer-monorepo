[gotcha.fixture_capture]
area = "tooling"
observed = "The local Python interpreter is installed under the root user's mise tree and cannot be executed by the postgres OS user; /usr/bin/python3 is absent."
resolution = "The authoring script loads libpq as the invoking user and temporarily selects the postgres effective uid only while establishing the local peer-authenticated capture connection; tests use only committed transcripts."

