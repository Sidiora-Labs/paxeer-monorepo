[platform_services]
rule = "Platform services check resource cleanup, bound wire integers before conversion and share named protocol strings."

[rule.1]
file = "services/platform/hosted/paxeer/profile.go"
linter = "errcheck"
action = "removed"

[rule.2]
file = "services/platform/hosted/paxeer/profile.go"
linter = "gosec"
action = "narrowed"
reason = "Deployment profiles and their adjacent manifest are selected by the operator."

[rule.3]
file = "services/platform/hosted/paxeer/profile.go"
linter = "staticcheck"
action = "removed"

