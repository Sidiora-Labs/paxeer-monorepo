[repair.22.31.457]
audit = "22.30.101"
mode = "BUILD"
fields = "executionHeader, successorHeader, executionCommit, executionValidators, transaction, transactionProof, batchTransaction, batchProof, result.code, result.data, result.gasWanted, result.gasUsed, resultProof; retain transactionHash, receiptDigest, sequence and activityIds."
implementation = "Require the full SDK NodeCommittedReceiptEvidence inclusion, map every field through the portable codec, and preserve the original SDK-authenticated receipt identity at the verifier call."
fixture = "test/committed-fixture.mjs maps sdk/platform/conformance/fixtures/vector-v4-committed.json exactly as the SDK repair-22-31-148 committed-proof test does, with the successor header/commit/validators as the landing block."
existing_test = "repair-22-31-434.test.mjs retains every assertion; refresh the recorded fixture and cryptographically authentic unrelated/self-signed witness setup for execution plus successor evidence."
new_test = "repair-22-31-457.test.mjs proves SDK and seller acceptance, tamper rejection for all added proof components, strict portable decoding and durable repository reopen without a second release."
agent_resolution = "AgentGrantMiddleware.resolveGrant forwards the grant ID and network to its configured GrantDrawExecution store, retaining its complete ResolvedPayerGrant and undefined for unknown grants without weakening either interface."
agent_test = "agent/test/repair-22-31-457.test.mjs queries SQLite grant state through the middleware, covering the complete seller grant shape, unknown grants, network isolation and inactive state; the seller repair test imports it so the declared behavior gate executes it before the agents integration build."
build_gate = "hf-build: npm ci --ignore-scripts && npm --prefix services/agent/sdk/typescript run build && npm --prefix services/platform/middleware/seller run build"
behavior_gate = "hf-done: node --test services/platform/middleware/seller/test/repair-22-31-434.test.mjs services/platform/middleware/seller/test/repair-22-31-457.test.mjs (within the declared verify_cmd)."
consumer_gate = "hf-done: npm --prefix sdk/integrations/agents run build (within the declared verify_cmd)."
evidence = "The private hf-build/hf-done gate ledger records the exact candidate revision, command, exit code and log; a gate is qualified only by its passing ledger entry."
