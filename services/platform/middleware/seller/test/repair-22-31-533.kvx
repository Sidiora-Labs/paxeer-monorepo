verify_targets = ["receipt-replay.test.mjs", "settlement-response.test.mjs", "receipt-verification.test.mjs", "repair-22-31-434.test.mjs"]
gate_results = "/out/run/gates.jsonl: authoritative build and verify rows record exact candidate revision, command, exit code and private evidence log location."
verified_revision = "The revision in the passing verify row of /out/run/gates.jsonl, repeated verbatim in the final evidence line; no completion is claimed before hf-done passes."
build_log = "/out/logs/build-1.log"
verify_log = "/out/logs/verify-1.log"
record_policy = "This record precedes qualification and references the private gate results so recording evidence does not change the candidate after build or verification."
external_access = "Only the declared build and verification; no credential or live endpoint (gotcha 2962)."
attempt = 2
prior_evidence = "The gate.build.1, gate.verify.1 and finding sections below are historical evidence from attempt 1; their private logs belonged to that attempt."
current_evidence = "Attempt 2 uses the fresh /out/run/gates.jsonl. Its build and verify rows provide revision, command, exit and log; build and verify must both exit zero at the same candidate revision. The final response copies the last hf-done evidence line verbatim."
completion = "Qualification is established only by the passing hf-done row and cg spec done record, never by the historical attempt-1 rows or this pre-gate record."

