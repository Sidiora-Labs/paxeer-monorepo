[repair]
task = "22.31.533"
base_revision = "224d7971000a239cfe434af3c093ba0edb40bb25"
acceptance = "22998.1"
decisions = ["2538", "2588"]
gotchas = ["3121", "3126", "2962"]
landed_through = "22.31.530, revision 12909a1d24de566cdd513c6af39cf496a8b2edf4, merged into the current main base."
receipt_digest = "SHA-256 over LXP/v1/receipt followed by a NUL byte and the canonical unsigned receipt encoding, including its zero signature-count byte; this is the receipt-signature digest returned by the workspace SDK's verifySequencerReceipt."
replay = "receipt-replay.test.mjs:7,36,42: verify the committed V1-layerxledger-pay-exact vector with its pinned key and use hex(verified.receiptDigest) in the portable proof."
settlement = "settlement-response.test.mjs:105,108: verify the generated signed receipt with the workspace SDK and put hex(verified.receiptDigest) in the portable proof."
verification = "receipt-verification.test.mjs:100,103: verify the generated signed receipt with the workspace SDK and put hex(verified.receiptDigest) in the portable proof."
tampering = "Original re-pin sites receipt-replay.test.mjs:149 and receipt-verification.test.mjs:152 (now 153) retain tampered signed bytes with keccak-256 digests that cannot verify as receipt-signature digests; both verification-failure assertions remain unchanged."
assertions = "Attempt 2 preserves every test and assertion from the landed 22.31.530 candidate; no test or product code changes in this continuation."
resolution = "Take the current main side of all three seed conflicts and retain the main tampered-receipt cases. All three suites are byte-for-byte identical to the current base."

[alignment.principal]
test = "receiptIdentityIsBoundToOnePrincipal"
landed = "22.31.530 renamed receiptIdentityIsScopedToMerchant and aligned it with receiptReusePrincipal: the second principal and later cross-principal replays receive receipt_reuse (409), with exactly one release."

[alignment.schemes]
test = "meteredOfferRefusesExactEvidence"
landed = "22.31.530 renamed meteredOfferWithPurposeHashVerifies and aligned it with sellerGrantFinalVerifier: exact-payment evidence is refused with verification-failure for both metered and subscription offers; purpose-hash mismatch remains refused."

[alignment.committed]
test = "settlementResponseCarriesPortableReceipt"
landed = "22.31.530 uses recordedCommittedReceipt and its independent validator resolver through SellerMiddlewareConfig.commitments. The portable digest equals hex(signed.receiptDigest), and signature and validator counts match recorded evidence. Stored replay, missing-evidence refusal and downgrade refusal remain asserted."

[alignment.replay]
test = "replayedSettlementAnswersStoredTransaction"
landed = "22.31.530 verifies a differing request before refusing receipt reuse, satisfying the retained settleCount 2 assertion with one release and one stored fulfillment."

[qualification]
