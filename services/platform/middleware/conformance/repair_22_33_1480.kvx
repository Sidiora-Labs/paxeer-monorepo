[wiring.daemon_receipt_proof]
path = "services/platform/middleware/agent/src/daemon.ts::resolveDaemonReceipt"
owner = "fm-platform"
request = "Separate the tracked observation rung from signed-receipt proof strength: when only a sequencer signature is available, preserve receipted proof rather than promoting it to committed from the observation label; genuine committed proof still requires authenticated commitment evidence."
observed = "The production resolver assigns verificationLevel committed solely from submission.verification_level; AgentMiddleware then passes this proof to verifyPaymentReceipt, which requires a commitment resolver and returns an unknown result with the budget reserved when it is absent. The conformance recovery assertions remain intact."
revision = "ec48318ccca2a61e5878a3764a2090e25c4698db"
evidence = "/out/logs/verify-1.log"

[continuation.3]
inherited_failure = "The previous restart scenario observed Committed/committed but returned unknown with a reserved budget because resolveDaemonReceipt promoted signature-only evidence to committed proof."
implementation = "resolveDaemonReceipt verifies the configured sequencer signature and emits receipted proof while preserving the exact Committed observation. AgentMiddleware.resume then verifies the actual payment and commits its existing reservation through the ordinary settlement path; failed observations still release it."
proof = "conformance_daemon_fixture_tracks_and_recovers_real_serializer_output asserts the exact producer transcript over HTTP, pending reservation across stop/reopen, original receipt and transaction bytes, independent observation and proof rungs, durable budget commit and replay without a second commit."
resolved_wiring = "The historical wiring.daemon_receipt_proof request is fulfilled in services/platform/middleware/agent/src/daemon.ts, now explicitly in task scope; wiring_requests for the Rust track dispatcher remains owned by fm-agent."
gate_evidence = "The final hf-done ledger records the exact verified candidate revision, command, exit and private evidence log; no success is claimed before that bounded gate passes."

