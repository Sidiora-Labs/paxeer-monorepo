[repair.22.31.492]
decision = "2538"
gotcha = "3025"
requirement = "22998.1"
digest = "receiptDigest is verifySequencerReceipt's receipt-signature digest; keccak256(signedReceipt) is refused."
implementation = "Buyer payment evidence and settlement checks, agent payment verification and budget replay/commit, daemon portable evidence and the conformance recorder use the verifier's digest."
fixture = "The three digest cases replay V1-layerxledger-pay-exact from sequencer-receipt-v1.json through the production daemon adapter, real middleware and HTTP transports."
buyer_case = "buyerReceiptSignatureDigestRoundTrip: buyer preparation, seller release, buyer settlement acceptance and durable seller reopen without duplicate release."
agent_case = "agentReceiptSignatureDigestReleasesSeller: daemon evidence, agent verification and budget replay agree with the verifier and release through the real seller."
refusal_case = "sellerRefusesKeccakDerivedReceiptDigest: replacing only receiptDigest with the blob hash causes verification-failure and no release; the authentic evidence then releases."
regression = "Each digest case consumes daemon-produced evidence, so the pre-repair blob-hash producer fails the case's positive control."
human_evidence_decision = "2555"
human_evidence = "prepareSelectsHumanEvidenceRungs loads vector-v7-named-payee.json with the conformance sibling loader test/named-payee-fixture.mjs, preserving recorded signatures, headers, inclusion proofs, absent votes and validators; all rung, header and refusal assertions remain. V4 remains the shared conformance fixture."
payee = "Buyer accepts the named main account's legacy or native identifier, or the native identifier of agent:<did>:asset:<32 lower-case asset hex bytes without 0x>; no other recipient is accepted."
payee_cases = "prepareRefusesDifferentPayeeDid refuses a different DID before quoting; prepareAcceptsNamedMainAccountIdentifier reaches the real preparation path with the recorded main account identifier."
rpc_gotcha = "3104"
rpc = "buildSignedReceipt exports the complete node receiptJson from the signed receipt, execution summary and exact encoded payment log; ConformancePaymentRpcSession retains and returns that complete receipt."
rpc_case = "conformanceRpcReceiptPassesStrictSellerConsumer transports the production session response over HTTP, asserts all 24 fields and passes it to seller verifyRpcPayment, asserting the verified digest, transaction, recipient and amount."
resume_decision = "2579"
resume_gotcha = "3115"
rung_contract = "SDK generated/client.ts Rung and requireVerified distinguish submitted, receipted and committed evidence. A receipt signature proves receipted execution; a tracker's Committed label does not prove consensus inclusion."
resume = "The existing settleSubmission Unknown branch returns before receipt resolution or commitment resolution; pending/Unknown tracking never consults the commitment resolver. The recovery case preserves the unknown result, reserved budget and zero transitions, now also asserting the submitted rung and zero resolver calls."
rung_case = "daemonSubmissionShapeUsesDispatchTranscripts now asserts the adapter's actual receipted evidence and verifier rung, no commitment evidence and refusal of a committed request with an unrelated recorded commitment; it still asserts the tracker state is Committed."
recovery_case = "daemonSubmissionRecoversAfterLostSubmit replaces the fabricated four-validator commitment with the real recorded resolver and asserts it is never consulted for the requested receipted rung. After the tracker supplies the signed receipt, exactly one budget transition verifies that receipt without resubmitting; both tracker Committed assertions remain."
format = "No JavaScript/TypeScript formatter is configured for these middleware packages; touched text follows the repository EditorConfig."
build_gate = "hf-build runs the declared build_cmd."
verify_gate = "hf-done runs cg spec done 22.31.492 -f layerx-merge with the declared verify_cmd and graph checks, including repair-22-31-435.test.mjs."
evidence = "The private hf-build/hf-done ledger records the candidate revision, command, exit code and log path. The final evidence line names the verified revision; no success is asserted before hf-done passes."
