[repair.22.33.1481]
audit = "22.30.86"
finding = "memory-fulfillment-race"
implementation = "Receipt claims precede release; matching concurrent requests share the pending result, competing request digests raise MiddlewareError fulfillment-conflict, and failed release claims prevent uncertain retries."
tests = ["memory_fulfillment_concurrent_replays_share_one_release", "memory_fulfillment_claim_precedes_reentrant_release_and_is_per_receipt", "memory_fulfillment_conflicts_are_typed_before_and_after_release", "memory_fulfillment_failed_release_retains_uncertain_claim", "memory_fulfillment_real_seller_concurrency_scenario", "fulfillment_restart_recovers_durable_resource_and_receipt", "fulfillment_restart_retains_interrupted_durable_claim"]
path = "Real signed receipt producer, payment header codec, ReceiptPayloadAuthority, SellerMiddleware and fulfillment repositories; the concurrent scenario is also registered in runScenarios."
restart = "Restart assertions discard seller/repository instances and reopen the existing production DurableFulfillmentRepository on the same temporary directory; the in-memory repository makes no restart claim."
baseline = "Not run: the explicit gate order prohibits pre-implementation testing and manual verify_cmd execution; no before-change failure is claimed. Static inspection shows the old implementation permits duplicate releases, uses an untyped conflict and discards uncertain claims."
verification = "hf-build then hf-done; the private gate ledger records the exact verified revision, command, exit and evidence log."
wiring = "None: the existing seller-owned DurableFulfillmentRepository already provides disk-backed reopen semantics and needs no out-of-scope change."

