{
  "name": "@sidiora/layerx-middleware-conformance",
  "version": "0.1.0",
  "description": "Non-authority conformance suite for the LayerX buyer, seller, merchant and agent middleware",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "npm --prefix ../../../.. run build:dependencies -- @sidiora/layerx-middleware-conformance",
    "build": "tsc -p tsconfig.json",
    "conformance": "node run.mjs",
    "conformance:connected": "node connected.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:payments": "node --test pay6/*.test.mjs"
  },
  "dependencies": {
    "@sidiora/layerx-agent-integrations": "file:../../../../sdk/integrations/agents",
    "@sidiora/layerx-agent-middleware": "file:../agent",
    "@sidiora/layerx-buyer-middleware": "file:../buyer",
    "@sidiora/layerx-merchant-middleware": "file:../merchant",
    "@sidiora/layerx-sdk": "file:../../../agent/sdk/typescript",
    "@sidiora/layerx-seller-middleware": "file:../seller"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
