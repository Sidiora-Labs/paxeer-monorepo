[repair.22.31.446]
finding = "attestor-manifest deployment entry guards"
base_revision = "72c91077cb966f1c4c640ded61b4b259f41cad90"
implementation = "Both checklist.sh and deploy-evm-chain.sh run the single check-attestor-manifest.py guard as their first command and propagate its failure before shell setup, overlays, argument handling, tool checks or deployment. The guard honors PAXEER_BRIDGE_ATTESTOR_MANIFEST, otherwise reads the adjacent committed attestors.json, and refuses pending_governance, malformed documents, placeholder addresses, duplicate or descending signers and thresholds outside the signer count."
governance_step = "governance signer-set approval (22.31.402; decision 2522): bridge governance owners supply the approved public signer set and threshold for attestors.json before the upgrade and remove pending_governance."
wiring_requests = ["Bridge governance owners alone supply the approved public signer set and threshold; no other out-of-path step is requested by this repair."]
proving_tests = ["test_refuses_committed_manifest_naming_governance", "test_refuses_repeated_byte_addresses", "test_refuses_invalid_threshold", "test_accepts_filled_manifest", "test_marker_must_be_removed_even_with_filled_signers", "test_refuses_invalid_signer_sets", "test_refuses_invalid_documents", "test_missing_manifest_does_not_fall_back", "test_entry_points_guard_first", "test_task_record_names_only_governance_signer_set_wiring"]
runtime_proof = "The declared pytest gate executes the production Python CLI in-process with committed and temporary public JSON manifests. It parses both shell scripts with bash -n, checks the first guarded command, then executes each entry with bash tracing and a credential-free environment through refusal or argument usage only. Absolute, relative and basename invocations prove shared-script resolution, default and override selection, failure propagation and continuation with a filled manifest. No network or deployment toolchain is used."
limits = "Filled public addresses prove structural acceptance only, not governance approval or live chain ownership; the committed manifest stays pending and deployment is refused. Existing proposal-loader validation remains authoritative downstream."
qualification = "The runner's private hf-build/hf-done ledger records the exact verified candidate revision, command, exit code and log location; final evidence copies the last gate record without editing the qualified source tree."

[gotcha.patch-hunk-order]
observed = "A patch with hunks in reverse file order failed context verification before applying any changes."
resolution = "Keep each file's patch hunks in source order; root GOTCHA.kvx is outside the task scope."

[gotcha.gate-ledger]
observed = "No gates.jsonl exists at task entry; gate.json reports zero build and verification runs."
resolution = "Continue the existing runner bookkeeping and invoke only the declared wrappers after implementation."
