[repair.22.31.446]
finding = "attestor-manifest deployment entry guards"
base_revision = "72c91077cb966f1c4c640ded61b4b259f41cad90"
implementation = "Both checklist.sh and deploy-evm-chain.sh run the single check-attestor-manifest.py guard as their first command and propagate its failure before shell setup, overlays, argument handling, tool checks or deployment. The guard honors PAXEER_BRIDGE_ATTESTOR_MANIFEST, otherwise reads the adjacent committed attestors.json, and refuses pending_governance, malformed documents, placeholder addresses, duplicate or descending signers and thresholds outside the signer count."
governance_step = "governance signer-set approval (22.31.402; decision 2522): CLOSED by decision 3042; attestors.json records 0x12598F221f1e645322C7665537D4Ab130281f51d at threshold 1 with no pending marker."
wiring_requests = []
proving_tests = ["test_accepts_committed_governed_manifest", "test_refuses_committed_manifest_naming_governance", "test_refuses_repeated_byte_addresses", "test_refuses_invalid_threshold", "test_accepts_filled_manifest", "test_marker_must_be_removed_even_with_filled_signers", "test_refuses_invalid_signer_sets", "test_refuses_invalid_documents", "test_missing_manifest_does_not_fall_back", "test_entry_points_guard_first", "test_task_record_names_only_governance_signer_set_wiring"]
runtime_proof = "The Python CLI accepts the committed manifest and retains explicit public fixtures for pending markers, repeated-byte signers, thresholds, malformed documents and canonical-order refusals. Both shell entry points run the guard first; absolute, relative and basename invocations with the committed or filled manifest continue to usage (exit 2), while invalid manifests stop at the guard (exit 1). The all-chain deployment tests continue to real environment refusals before signing or RPC commands."
limits = "Decision 3042 closes signer-set approval and task 22.39.212 reconciles the nine chain configurations. Guard acceptance does not prove deployment readiness: owner/program placeholders and deployment environment preconditions still refuse deployment."
qualification = "Task 22.39.212 evidence is referenced in repair_22_39_212.kvx; exact revision, command, exit and private log location remain in the hf-build/hf-done ledger."
status = "governed-manifest-live"
wiring_fulfilled = "Decision 3042 supplies the governed signer set and threshold."

[gotcha.patch-hunk-order]
