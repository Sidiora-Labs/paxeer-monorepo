[repair.22.31.402]
audit = "22.30.152"
finding = "attestor-manifest"
base_revision = "5c06a9cfa23f88d328fc7e91545e90609e8cd0c0"
source_attempt_revision = "79bae11cf474e594fd2085f780a5f17e7e8eddeb"
status = "governed-manifest-live"
implementation = "Decision 3042 supplies 0x12598F221f1e645322C7665537D4Ab130281f51d at threshold 1 without pending_governance. Task 22.39.212 reconciles only attestors and threshold in all nine committed chain configurations; the production Go loader, Python guard and refusal rules are unchanged."
proving_tests = ["test_attestor_manifest_contains_live_canonical_signers", "test_governed_manifest_has_no_pending_signer_slots", "test_governed_manifest_rejects_every_pending_marker", "test_signer_checks_remain_strict_without_pending_governance", "test_attestor_manifest_matches_every_committed_chain", "test_manifest_loader_retains_placeholder_and_threshold_refusals", "test_proposal_source_checks_manifest_before_emitting_attestors", "TestCommittedManifestMatchesEveryChainAndEmitsGovernedProposals"]
closure = "The owner signer-set decision is CLOSED by decision 3042. The manifest and nine configurations share the live canonical signer and threshold. Remaining owner/program/deployment inputs are separate deployment preconditions."
owner_decision = "CLOSED — decision 3042 governs signer set [0x12598F221f1e645322C7665537D4Ab130281f51d], threshold 1, with no pending marker."
source_proof = "The Python tests reject duplicate JSON fields and require live, nonzero, non-repeated-byte, unique ascending signers and a valid threshold without any pending exception. They compare the manifest and all nine configurations exactly and retain strict production guard source assertions."
runtime_proof = "Task 22.39.212 declares go test ./services/bridge/deploy/... in hf-done. TestCommittedManifestMatchesEveryChainAndEmitsGovernedProposals loads the committed manifest, invokes AttestorManifest.Check on all nine committed configurations, emits bodies and opening proposals through Run using temporary copies with remaining deployment inputs filled, and decodes the resulting set-attestors message into real module types. Exact execution results are referenced by repair_22_39_212.kvx."
review_only = "Manifest acceptance establishes the governed signer inputs; it does not establish deployment readiness or live chain ownership. Production unknown-field, placeholder, canonical-order and threshold refusals remain unchanged."
baseline = "The supplied Attempt 1 outcome at source_attempt_revision reports test_attestor_manifest_contains_live_canonical_signers and test_attestor_manifest_matches_every_committed_chain failed, with the two source-guard tests passed (2 failed, 2 passed). No new baseline verify was run: the explicit gate order requires complete implementation then hf-build then hf-done. The continuation has no gates.jsonl at entry and gate.json records zero current runs."
qualification = "Task 22.39.212 evidence is referenced in repair_22_39_212.kvx; the private hf-build/hf-done ledger binds both gates to the same candidate revision without editing the qualified tree."
wiring_requests = []
wiring_fulfilled = "Decision 3042 supplies the governed manifest. Task 22.39.212 wires its signer list and threshold into all nine committed configurations; the attestor-manifest runbook gap is closed."

[gotcha.baseline-order]
observed = "The baseline verification step contradicts the explicit implementation-first gate order and bounded run budget."
resolution = "Follow the explicit order and record the absent baseline evidence here; root GOTCHA.kvx and spec ledgers are outside scope."

[gotcha.missing-authority]
observed = "The non-placeholder signer lists in proposals/testdata and deploy/tests/fixtures are test data; the runbook explicitly states the production identities are unfilled."
resolution = "Request governance-approved public inputs rather than inventing identities or treating test fixtures as approval; retain the production refusal and leave the finding unresolved."

[gotcha.pending-marker]
observed = "Adding pending_governance intentionally moves the committed manifest refusal from attestors[0] to the strict JSON document decoder; the existing Go test asserted the old refusal location."
resolution = "Keep the production decoder and placeholder refusal unchanged, assert the exact new unknown-field refusal in the existing Go test, and verify its source in the declared Python gate."

[gotcha.candidate-cache]
observed = "A Python gate can generate bytecode caches in source directories and change the candidate after hf-build."
resolution = "Set PYTHONDONTWRITEBYTECODE=1 for both declared gate wrappers and remove any inherited cache under the task paths before qualification; never edit the qualified tree."
