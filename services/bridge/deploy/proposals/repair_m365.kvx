[repair.22.33.365]
audit = "22.30.140"
base_revision = "aefa91aa13a43dff9d0a27098f8280d43fd1ed42"
baseline = "Not run: the explicit gate order requires complete implementation before hf-build and hf-done and forbids running verify_cmd by hand. No baseline test failures are claimed."
qualification = "hf-done records the verified candidate revision, exact command, exit and private log in the runner task ledger; the final evidence line copies that record."
wiring_requests = []

[finding.manifest-json-tail]
proving_test = "TestRepairM_365_ManifestJSONTail"
repair = "LoadAttestorManifest requires a second Decode to return io.EOF; malformed closing tokens, additional values/documents and incomplete tails are refused through Run before publication; whitespace preserves the signer authority and real emitted bodies. Existing unknown-field, signer-order and threshold refusals execute in the focused gate."

[finding.bridge-json-tail]
proving_test = "TestRepairM_365_BridgeJSONTail"
repair = "LoadChainConfig requires a second Decode to return io.EOF; malformed closing tokens, additional values/documents and incomplete tails are refused through Run; whitespace preserves real module-message bytes and all existing configuration refusals execute in the focused gate."

[finding.bridge-output-recovery]
proving_tests = ["TestRepairM_365_OutputStagingFailure", "TestRepairM_365_OutputRestartRecovery", "TestRepairM_365_InterruptedOutputsAreVerified", "TestRepairM_365_ReadbackLinkRestart", "TestRepairM_365_JournalRefusals"]
repair = "Run stages every requested output before publishing any and retains a durable versioned journal until all outputs are published. A reopened Run requires the same paths and generated bytes, verifies every already published output and remaining stage before resuming, and refuses corruption, symlinks, unexpected files or changed requests. File publication uses exclusive links; directory publication replaces only empty destinations."
proof_path = "Committed canonical chain fixtures -> chainconfig.Load -> FromChainConfig -> Generate -> staged real filesystem outputs and journal -> real publisher interrupted after zero, one, two or three outputs -> fresh Run reopens journal -> complete bodies and proposals decoded through the real module codec, complete readback identity and ordered success report."

[finding.bridge-recovery-tests]
proving_tests = ["TestRepairM_365_OutputStagingFailure", "TestRepairM_365_OutputRestartRecovery", "TestRepairM_365_ExistingRefusalsAndNestedOutputs"]
repair = "proposals_test.go adds real missing-parent and dangling-symlink staging failures plus filesystem publication collisions and restart cases for Ethereum and Solana. All output bodies, proposal contents and readback fields are checked, the identical argument list succeeds after the obstruction is removed, existing occupied-output refusals are retained and supported nested destinations remain complete."

[gotcha.baseline-order]
observed = "The inherited audit step asks for unchanged-tree verification while the task-specific execution order prohibits verification until implementation and hf-build complete."
resolution = "Follow the explicit execution order and record no unrun baseline claim."

[gotcha.configuration-path]
observed = "Canonical chain configuration fixtures are resolved by chainconfig.Path and are not under deploy/chains."
resolution = "Use the existing committedConfiguration and deployableConfiguration helpers without assuming a directory layout."

[gotcha.empty-output-directory]
observed = "First hf-done at bb03b131ac005b953cd466f64dbb47097928846b failed in the restart proof because Go os.Rename refuses an existing directory even when it is empty; evidence is /out/logs/verify-1.log (exit 1)."
resolution = "Remove only a confirmed empty destination directory before renaming its complete stage, leaving the durable journal intact across that gap; retain every test assertion unchanged."
