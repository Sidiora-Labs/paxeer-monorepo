helper_setup = "Decisions 3047 and 3052: .github/workflows/bridge-test.yml deploy-tooling installs Node.js 24.11.0 with actions/setup-node@820762786026740c76f36085b0efc47a31fe5020, the same action revision as bridge-app, after the pinned Go toolchain and before go test."
helper_installs = ["npm ci --no-audit --no-fund --prefix services/bridge/deploy/appenv", "npm ci --no-audit --no-fund --prefix services/bridge/deploy/proposals/testdata/repair_270"]
helper_lockfile = "services/bridge/deploy/appenv/package-lock.json is generated with npm install --package-lock-only from the unchanged pinned devDependencies @noble/curves 2.4.0 and viem 2.41.2. The proposal compiler retains its existing npm-shrinkwrap.json and pinned dependency versions."
helper_consumers = "The appenv install serves repair_277_app.mjs, which imports the real bridge app config.ts and chains.ts through viem and @noble/curves in TestRepair_277_DeploymentPhasesToApp. The proposal install serves testdata/repair_270/compile-vault.cjs, which uses solc and @openzeppelin/contracts to compile the real vault in TestRepair_270_VaultDepositReachesKeeper. Both installs also precede go build in the task build command. No dependency version or inherited test changes in this continuation."
rollback = "Revert the task's commit."

