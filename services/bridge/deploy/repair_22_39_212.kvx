acceptance = "22998.1"
decision = "3042"
base_revision = "b1fd5106ceaed43ab9d7fad46a5fb0cc7000c282"
status = "implemented; qualification is determined by the referenced bounded gate records"
manifest = "services/bridge/deploy/attestors.json"
attestors = ["0x12598F221f1e645322C7665537D4Ab130281f51d"]
threshold = 1
configurations = ["contracts/bridge/evm/chains/ethereum/config.json", "contracts/bridge/evm/chains/base/config.json", "contracts/bridge/evm/chains/arbitrum/config.json", "contracts/bridge/evm/chains/optimism/config.json", "contracts/bridge/evm/chains/bnb/config.json", "contracts/bridge/evm/chains/polygon/config.json", "contracts/bridge/evm/chains/avalanche/config.json", "contracts/bridge/evm/chains/hyperevm/config.json", "contracts/bridge/solana/chains/solana/config.json"]
implementation = "Only attestors and threshold change in the nine committed configurations. Production manifest loading, check script and every refusal rule remain unchanged. The historical records close the owner decision and mark manifest wiring fulfilled; the service operator runbook lists the governed manifest as implemented support."
proposal_proof = "TestCommittedManifestMatchesEveryChainAndEmitsGovernedProposals loads the real committed manifest, checks every committed chain signer configuration, runs the real proposal command for all nine chains with remaining deployment inputs filled in temporary copies, reads its emitted set-attestors body and opening proposal from disk and decodes them into real module messages. It asserts the governed signer, threshold, zero bond, authority and registered chain ID."
appenv_proof = "TestGovernedSolanaRecordRoundTripsToAppEnv feeds the committed Solana signer values into the real record writer, reopens the persisted record, generates app environment output and validates that output with Check and Run --check. Existing refusal tests remain."
refusal_proof = "All Python check-script refusal fixtures are retained. The former committed pending manifest is now an explicit temporary fixture. Chainconfig injects its placeholder-attestor refusal fixture explicitly. Entry scripts accept the committed manifest and stop at missing arguments, record directories, unreadable configurations or absent deployment tools before signing or RPC."
retired_assertions = ["test_pending_governance_manifest_uses_named_slots -> test_governed_manifest_has_no_pending_signer_slots: exact decision-3042 signer, threshold 1 and no named slot or pending marker in the manifest or nine configurations.", "test_pending_governance_requires_explicit_true -> test_governed_manifest_rejects_every_pending_marker: all seven prior marker values and boolean true are refused; pending no longer exempts signers from validation.", "test_signer_checks_remain_strict_without_pending_governance: retire acceptance of repeated-byte signers with pending true; require rejection instead, retaining the named-slot and repeated-byte refusal assertions and live fixture acceptance.", "test_refuses_committed_manifest_naming_governance: retire the claim that the current committed manifest is pending; retain the same test name and historical pending document as an explicit refusal fixture, plus test_accepts_committed_governed_manifest for the live committed document.", "test_entry_points_guard_first: replace committed-manifest exit-1 refusal with exit-2 usage after the first guard succeeds, across absolute, relative and basename invocations; repeated-byte and threshold refusal cases remain.", "test_bridge_all_rejected_cli_record_guard, test_bridge_all_rejected_cli_stops_first_failure, test_bridge_all_rejected_preflight_all and test_bridge_all_rejected_cli_usage: retire the shared assertion of an immediate pending-governance refusal; assert manifest acceptance, exact downstream environment/usage refusal and no deployment (only the retained deployment lock is permitted on a non-preflight first-chain refusal). All original test names and parameter cases remain; the nine preflight environments reach the first-chain absent-forge refusal before any deploy-key consumption.", "TestCommittedManifestCarriesPlaceholdersEveryToolRefuses -> TestCommittedManifestMatchesEveryChainAndEmitsGovernedProposals: all nine committed signer configurations pass the real loader and Check; persisted bodies and proposals carry the governed set.", "TestRunRefusesTheCommittedPlaceholderManifest -> TestRunRefusesConfigurationThatDiffersFromCommittedManifest: the governed manifest loads, the old five-signer fixture still refuses at the precise signer-count mismatch, and no output is published.", "test_manifest_loader_retains_placeholder_and_threshold_refusals: move source inspection of the pending-document refusal into TestPendingGovernanceManifestIsRefused, which retains the exact historical pending document as an explicit Go fixture; retain all production loader, placeholder, canonical-order and threshold guard assertions. Go TestManifestRefusals and TestChainConfigurationRefusals retain their fixtures.", "TestRequireDeployableRefusesEachPlaceholder: explicitly inject the placeholder-attestor fixture because committed attestors are now governed; the same refusal and field assertion remain.", "test_task_record_names_only_governance_signer_set_wiring: replace the open supply request with closed decision 3042 and an empty outstanding wiring list.", "test_service_operator_runbook_has_only_open_gaps: replace the sole pending-attestor gap row and marker with an implemented-support row that names decision 3042, all nine configurations and committed-check exit 0; every other release-doc test remains unchanged."]
qualification = "Both gates must reference the same final candidate revision. Read the last build and verify entries for task 22.39.212 in the runner private ledger; each entry records revision, command, exit and log. No success is claimed by this source record alone."
