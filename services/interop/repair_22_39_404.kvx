[interop_lint.lib]
file = "services/interop/crates/layerx-committed-proof/src/lib.rs"
lint = "unreadable_literal, doc_markdown, cast_sign_loss, too_many_lines, needless_pass_by_value"
change = "The proof verifier groups round constants, validates block heights and separates receipt parsing and verification steps."

[interop_lint.commit]
file = "services/interop/crates/layerx-committed-proof/src/commit.rs"
lint = "cast_sign_loss"
change = "Vote power is converted after validation, and signed timestamps retain their protobuf bit representation."

[interop_lint.header]
file = "services/interop/crates/layerx-committed-proof/src/header.rs"
lint = "cast_sign_loss"
change = "Signed header and validator fields retain their protobuf bit representation."

[interop_lint.proto]
file = "services/interop/crates/layerx-committed-proof/src/proto.rs"
lint = "cast_possible_truncation"
change = "Varint bytes are converted after their bounds are established."

[interop_lint.gateway_error]
file = "services/interop/crates/layerx-interop-gateway/src/error.rs"
lint = "match_same_arms"
change = "Retriable receipt failures share one match arm."

[interop_lint.mirror_committed]
file = "services/interop/crates/layerx-mirror/src/committed.rs"
lint = "missing_errors_doc, needless_pass_by_value"
change = "Committed source methods document refusals and classify RPC errors by reference."

[interop_lint.mirror_publisher]
file = "services/interop/crates/layerx-mirror/src/publisher.rs"
lint = "unnecessary_wraps, dead_code, missing_errors_doc, must_use_candidate"
change = "Archive coordinates reflect block identity, and test encoding stays with its unit cases."

[interop_lint.mirror_rpc]
file = "services/interop/crates/layerx-mirror/src/rpc.rs"
lint = "missing_errors_doc, needless_pass_by_value"
change = "RPC construction documents refusals and assigns the supplied resolver to an endpoint."

[interop_lint.mirror_runtime]
file = "services/interop/crates/layerx-mirror/src/runtime.rs"
lint = "unused_imports, dead_code, missing_errors_doc, assigning_clones, single_match_else, must_use_candidate, redundant_closure_for_method_calls"
change = "Runtime acquisition and lane progress retain their error behavior with scoped test helpers."

[interop_lint.mirror_signer]
