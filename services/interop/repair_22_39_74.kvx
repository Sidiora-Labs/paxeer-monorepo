[case.workspace_ci]
observed = "The original workflow tests layerx-x402 only and filters out changes to most interop members; make interop-test already selects the workspace but no workflow invokes it."
repair = "Add an unconditional workspace-tests job on push to main and pull requests, filter on all services/interop paths, install pinned Rust and native TLS dependencies, and invoke the locked workspace target. Retain the x402 transport job."
coverage = "The regression gate checks both triggers, the required job and real Make recipe, then reconciles every crates/*/Cargo.toml with Cargo metadata workspace members and executable test targets."

[case.workspace_execution]
repair = "Use --no-fail-fast so Cargo runs the other member suites even if one fails, while preserving its failing exit status. Set test debug information to zero to bound the full workspace's build footprint without changing assertions or test selection."
member_failures = "No member failure is claimed repaired without the declared build and verification evidence; any failure encountered during qualification is recorded here before a scoped repair."

