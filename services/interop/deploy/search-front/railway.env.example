# Search front image inputs; nginx listens on the port in nginx.conf.
# Empty required values are deployment inputs. Secret contents stay empty.
# Optional values without literal defaults stay unset until configured.
# LAYERX_FILES_OWNER=
# LAYERX_FILES_OWNER_SEARCH_FRONT_UPSTREAMS=
LAYERX_FILES_TABLE=/etc/layerx/files.tsv
# LAYERX_ROLE=
LAYERX_TRUSTED_PROXIES=
NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/search/conf.d
SEARCH_FRONT_UPSTREAMS=
