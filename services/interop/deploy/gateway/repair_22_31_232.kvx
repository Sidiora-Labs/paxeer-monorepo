acceptance = "22998.1"
evidence = "The hf-done ledger records the exact verified candidate revision, command, exit code and private log location; completion requires that gate to pass."
baseline = "No baseline gate ran: ordered implementation-first and wrapper-only gate rules prohibit do_5's unchanged-tree verification; the new test module did not exist on the base and no prior gate ledger existed."
