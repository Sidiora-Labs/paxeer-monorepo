[finding.gateway_rotation]
repair = "Derive sorted distinct did:layerx signers from every validated receipt public key; accept only the exact authorized set, including historical keys, in overrides."
tests = ["test_gateway_rotation_preserves_every_distinct_signer", "test_gateway_rotation_accepts_exact_signer_set_in_either_order", "test_gateway_rotation_refuses_unauthorized_signer_overrides", "test_gateway_rotation_keeps_receipt_window_validation", "test_gateway_rotation_real_service_and_receipts_survive_restart"]
proof = "The renderer CLI emits the manifest consumed by the actual service main and Config::load; the production HTTP client transports unchanged signed producer recordings into the same receipt verifier used by the service, before rotation and after two fresh service starts with old/new windows."
recordings = ["sdk/platform/conformance/fixtures/sequencer-receipt-v1.json", "sdk/platform/conformance/fixtures/receipt-sequencer-v1.json"]

[gotcha.rotation]
observed = "The singleton-key restriction existed in main, cluster-root derivation, render authority comparison and manifest signer validation."
resolution = "Update all four paths together, retain the service's 64-signer bound and reject duplicate, malformed, extra and missing signer identities."

[gotcha.qualification_candidate]
observed = "The prior attempt passed 14 tests but failed candidate consistency; generated Python bytecode was seeded into the task directory and changes when the gates run."
resolution = "Remove only generated bytecode, direct qualification bytecode to an external cache with PYTHONPYCACHEPREFIX, and resolve Cargo dependencies before building; preserve the renderer and all proving tests."
previous_verify_revision = "41853ef4d2a6c8f376191084f9cd8cfc46b7c982"
previous_verify_result = "14 passed; implemented_not_qualified because same_candidate and build_on_verified were unmet."
