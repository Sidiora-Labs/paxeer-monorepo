# Gateway executable inputs; TLS certificate and key must be unset in plain mode.
# Empty required values are deployment inputs. Secret contents stay empty.
# Optional values without literal defaults stay unset until configured.
LAYERX_INTEROP_ALLOW_RAILWAY_PRIVATE_NETWORK=0
# Secret file path; supply the path locally.
# LAYERX_INTEROP_AP2_RECEIPT_SIGNERS_FILE=
LAYERX_INTEROP_CHAIN_ID=
# Secret file path; supply the path locally.
LAYERX_INTEROP_CLIENT_IDENTITY_PASSWORD_FILE=
# Secret file path; supply the path locally.
LAYERX_INTEROP_CLIENT_IDENTITY_PKCS12=
LAYERX_INTEROP_CONFIG=
LAYERX_INTEROP_IDEMPOTENCY_SECONDS=604800
LAYERX_INTEROP_LISTEN=
LAYERX_INTEROP_LISTENER=tls
# LAYERX_INTEROP_MIGRATION_V2_CONFIG=
LAYERX_INTEROP_MODULE_REGISTRY_FILE=
LAYERX_INTEROP_NETWORK_ID=
LAYERX_INTEROP_OUTBOUND_CA_DER=
LAYERX_INTEROP_PROTOCOL_NETWORK_ID=
LAYERX_INTEROP_READINESS_MAX_AGE_MS=
LAYERX_INTEROP_RECEIPT_KEYS_FILE=
# Secret file path; supply the path locally.
LAYERX_INTEROP_REDIS_PASSWORD_FILE=
LAYERX_INTEROP_REDIS_URL=
# Secret file path; supply the path locally.
LAYERX_INTEROP_REDIS_USERNAME_FILE=
LAYERX_INTEROP_SEQUENCER_URL=
LAYERX_INTEROP_TAP_CLOCK_SKEW_SECONDS=
LAYERX_INTEROP_TLS_CERT_DER=
# Secret file path; supply the path locally.
LAYERX_INTEROP_TLS_KEY_DER=
LAYERX_INTEROP_WIRE_VERSION=
