tests = ["TestRepairM_109_ReadmeManifest", "test_repair_m109_readme_matches_manifest_and_live_interfaces"]

[finding.gateway_example_pins]
repair = "Regenerate config.example.json with the production renderer from trust-inputs.example.json and receipt-keys.example.json, without inherited deployment overrides."
tests = ["TestRepairM_109_ExamplePins", "test_repair_m109_example_matches_current_renderer"]
proof = "Go recomputes every adapter count and every adapter/transport suite and specification digest against the committed bytes; the native Python test compares the entire example to production render and every derived field, including future additions."

[finding.gateway_duplicate_key_id]
repair = "Refuse repeated keyId values across all receipt-key windows before the CLI writes configuration, retaining exact field, nonzero key, unsigned height, reversed-range and overlap checks; distinct ids may still share a public key."
tests = ["TestRepairM_109_ReceiptKeyWindows", "test_repair_m109_duplicate_key_id_refused_before_write", "test_repair_m109_distinct_ids_may_share_public_key", "test_repair_m109_preserves_key_and_range_checks", "rendered_example_windows_use_unambiguous_proof_keys"]
proof = "Native Python tests drive main and receipt_keys in-process in render/check modes and preserve existing output on refusal; the existing Rust probe's new unit test passes recorded receipts for both example windows through production verify_sequencer_signature, then asserts duplicate-id, range and signature refusals. The Go gate independently authenticates both recordings using production ReceiptSignature."
recordings = ["sdk/platform/conformance/fixtures/sequencer-receipt-v1.json", "sdk/platform/conformance/fixtures/receipt-sequencer-v1.json"]

[gotcha.gate_toolchain]
observed = "This task prescribes a Go-only gate for a Python renderer and Rust runtime while forbidding subprocesses, native artifacts, toolchain bridges and changes to the task's gate."
resolution = "Keep the prescribed gate and real Go signature verifier, supply native tests beside the existing tests, and record the unexecuted native proof explicitly rather than replacing production components with Go implementations."

[gotcha.baseline_order]
observed = "Step 7 requests a pre-change verify, but the ordered instructions permit hf-done only after full implementation and hf-build."
resolution = "Follow the explicit gate order and record that no pre-change tests were run."
