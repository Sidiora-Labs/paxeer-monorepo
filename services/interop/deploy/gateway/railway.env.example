# Gateway runtime and image file inputs; TLS is the source listener default.
# Empty required values are deployment inputs. Secret contents stay empty.
# Optional values without literal defaults stay unset until configured.
# Secret value.
INTEROP_AUTHORITY_TOKEN=
INTEROP_CLIENT_CA_DER=
# Secret value.
INTEROP_CLIENT_P12=
# Secret value.
INTEROP_CLIENT_PASSWORD=
INTEROP_CONFIG=
INTEROP_MODULE_REGISTRY=
# Secret value.
INTEROP_REDIS_PASSWORD=
# Secret value.
INTEROP_REDIS_USERNAME=
INTEROP_SEQUENCER_FIRST_BATCH=
INTEROP_SEQUENCER_ID=
INTEROP_SEQUENCER_LAST_BATCH=
INTEROP_SEQUENCER_PUBLIC_KEY=
