{
  "listen": "127.0.0.1:8482",
  "data_dir": "/var/lib/x-websearch",
  "seeds": [
    "${X_WEBSEARCH_SEED_URL}"
  ],
  "crawl": {
    "pages_per_cycle": 1000,
    "pages_per_host": 100,
    "max_depth": 3,
    "politeness_delay_ms": 1000
  },
  "fetch": {
    "connect_timeout_ms": 3000,
    "total_timeout_ms": 10000,
    "max_body_bytes": 2097152,
    "max_redirects": 3,
    "allow_loopback": false
  },
  "assets": {
    "SID": {
      "asset_id": "${X_WEBSEARCH_SID_ASSET_ID}",
      "price": "${X_WEBSEARCH_SID_PRICE}"
    },
    "PAX": {
      "asset_id": "${X_WEBSEARCH_PAX_ASSET_ID}",
      "price": "${X_WEBSEARCH_PAX_PRICE}"
    },
    "USDC": {
      "asset_id": "${X_WEBSEARCH_USDC_ASSET_ID}",
      "price": "${X_WEBSEARCH_USDC_PRICE}"
    },
    "USDL": {
      "asset_id": "${X_WEBSEARCH_USDL_ASSET_ID}",
      "price": "${X_WEBSEARCH_USDL_PRICE}"
    }
  },
  "gateway": {
    "endpoint": "${X_WEBSEARCH_GATEWAY_ENDPOINT}",
    "receipt_keys": [
      {
        "key_id": "${X_WEBSEARCH_RECEIPT_KEY_ID}",
        "public_key": "${X_WEBSEARCH_RECEIPT_PUBLIC_KEY}",
        "first_height": 0,
        "last_height": 1000000
      }
    ]
  },
  "evm": {
    "endpoint": "${X_WEBSEARCH_EVM_ENDPOINT}",
    "chain_id": 125,
    "confirmations": 12
  },
  "kernel_network_id": 125,
  "peers": [],
  "payment": {
    "payer_address": "${X_WEBSEARCH_PAYER_ADDRESS}"
  }
}
