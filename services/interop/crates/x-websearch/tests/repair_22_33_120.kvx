[finding.readme-peer-recovery]
test = "readme_peer_recovery_preserves_pre_quorum_bytes_and_retirement_tombstones"
repair = "Document watcher work, persisted attestation/response/local and collected signatures, identity binding and signed-transaction recovery as distinct stages. Link the existing pre-quorum restart proof; additionally stop/reopen all exchanges and stores below quorum, change the index, preserve exact answer bytes and signatures, collect the third signer through production HTTP and decode the observation. Verify quorum alone keeps the answer active and durable retirement hides it while retaining signatures and preventing re-signing after another reopen."

