repair = "Assert the exact typed HTTP refusal and pass the shared data root to ContentStore, with an explicit directory assertion; retain all signature, receipt, recovery and release assertions."

[continuation.receipt_reauthentication]
source_revision = "1b5f353e9b2eb9cc966bd7204133ab9b083da476"
observed = "PaymentGate::recover_pending_deliveries authenticates four persisted exact receipts and Plane::exact authenticates each retry, accounting for the eight lookups the previous attempt incorrectly treated as absent."
repair = "Assert one receipt lookup per recovered payment and per retry; corrupt each producer receipt after reopening and require receipt_unverified without handler release, restore it and require identical response bytes, then retain the zero-lookup assertion specifically for redirected request_mismatch refusals."
gotcha = "A durable exact-payment response remains subject to receipt authentication on recovery and retry; cached bytes guarantee one handler release, while redirected requests must fail before receipt lookup."

[qualification.continuation_repair_1]
