# Wallet runtime environment by variable name; use the component examples for deployment
# Fill required values before use. Secrets and deployment addresses have empty values.
# Commented assignments are unset; enable them only when configuring that feature.
# Address defaults are inherited from the source when their assignment is commented.

# Maximum account setup gas cost in wei
ACCOUNT_SETUP_GAS_CAP_WEI=10000000000000000

# Receipt confirmations required for durable actions
ACTION_CONFIRMATIONS=1

# Replacement transaction fee bump percentage
ACTION_FEE_BUMP_PERCENT=12

# Receipt wait timeout in milliseconds
ACTION_RECEIPT_TIMEOUT_MS=90000

# Durable-action reconciliation interval in milliseconds
ACTION_RECONCILE_INTERVAL_MS=30000

# Durable-action worker interval in milliseconds
ACTION_WORKER_INTERVAL_MS=3000

# Agent authentication challenge lifetime in seconds
AGENT_CHALLENGE_TTL_SECONDS=120

# Initial freeze flag for a new agent
AGENT_DEFAULT_FROZEN=true

# Default per-agent token approval cap in base units
AGENT_DEFAULT_MAX_APPROVE_WEI=0

# Default per-agent daily value cap in wei
AGENT_DEFAULT_MAX_DAILY_VALUE_WEI=0

# Default per-agent transaction value cap in wei
AGENT_DEFAULT_MAX_TX_VALUE_WEI=0

# Initial agent policy mode
AGENT_DEFAULT_MODE=read_only

# Default per-agent signing requests per minute
AGENT_DEFAULT_RATE_LIMIT_PER_MINUTE=30

# HS256 agent-token signing secret, at least 32 characters; setting it enables agent authentication
# AGENT_JWT_SECRET=

# Maximum signed agent-request lifetime in seconds
AGENT_REQUEST_MAX_TTL_SECONDS=300

# Agent bearer-token lifetime in seconds
AGENT_TOKEN_TTL_SECONDS=900

# Gateway worker count, from 1 to 64; each has its own database pool
API_WORKERS=1

# Comma-separated admitted activity type numbers; asset-send type is supported
# ATTESTOR_ACTIVITY_TYPES=

# Principal-file configuration path
# ATTESTOR_AGENTS_FILE=

# Maximum signed agent-request lifetime as a Go duration
ATTESTOR_AGENT_MAX_EXPIRY=5m

# Agent sponsored-transaction paymaster contract
# ATTESTOR_AGENT_PAYMASTER=

# Expected custody producer authority issuer
ATTESTOR_AUTHORITY_ISSUER=

# Path to pinned custody producer authority public key
ATTESTOR_AUTHORITY_PUBLIC_KEY_FILE=

# Expected custody producer authority tenant
ATTESTOR_AUTHORITY_TENANT=

# Encrypted snapshot directory; required for replication
# ATTESTOR_BACKUP_DIR=

# Path to snapshot encryption key; required with backup directory and for restore
# ATTESTOR_BACKUP_KEY_FILE=

# Path to attestor TLS CA bundle; required with attestor endpoints
# ATTESTOR_CA_FILE=

# Enable operator key imports during a ceremony window
ATTESTOR_CEREMONY=false

# Required EVM chain identifier
ATTESTOR_CHAIN_ID=

# Path to gateway client TLS certificate; required with attestor endpoints
# ATTESTOR_CLIENT_CERT_FILE=

# Path to gateway client TLS private key; required with attestor endpoints
# ATTESTOR_CLIENT_KEY_FILE=

# Encrypted share-store directory
ATTESTOR_DATA_DIR=

# Comma-separated HTTPS custody endpoints; when set, exactly five endpoints and quorum three are required
# ATTESTOR_ENDPOINTS=

# Attestor health polling interval in milliseconds
ATTESTOR_HEALTH_INTERVAL_MS=5000

# Path to signed approved custody inventory
ATTESTOR_INVENTORY_FILE=

# Path to approved inventory verification public key
ATTESTOR_INVENTORY_PUBLIC_KEY_FILE=

# JWT verifier JWKS endpoint; setting it enables user-token verification
# ATTESTOR_JWKS_URL=

# Expected JWT audience; required when JWKS verification is enabled
# ATTESTOR_JWT_AUDIENCE=

# Expected JWT issuer; required when JWKS verification is enabled
# ATTESTOR_JWT_ISSUER=

# Maximum age of accepted user JWTs as a Go duration
ATTESTOR_JWT_MAX_AGE=1h

# Path to native activity and grant policy JSON
# ATTESTOR_KERNEL_POLICY_FILE=

# API listener socket address
ATTESTOR_LISTEN_ADDR=

# Path to owner-purpose policy JSON
# ATTESTOR_NATIVE_POLICY_FILE=

# Participant identifier of this attestor
ATTESTOR_NODE_ID=

# Path to 32-byte share-store encryption key, raw or hex
ATTESTOR_NODE_KEY_FILE=

# Path to distinct operator client CA bundle
ATTESTOR_OPERATOR_CA_FILE=

# Comma-separated identifier and socket pairs for the other four participants
ATTESTOR_PEERS=

# Peer transport listener socket address
ATTESTOR_PEER_LISTEN_ADDR=

# Comma-separated identifier and SHA-256 SPKI pin pairs for the other four participants
ATTESTOR_PEER_PINS=

# Path to EVM signing policy JSON
# ATTESTOR_POLICY_FILE=

# Attestor signing threshold
ATTESTOR_QUORUM=3

# Region label reported by health
# ATTESTOR_REGION=

# Replica SSH socket address; required with any replica setting
# ATTESTOR_REPLICA_ADDR=

# Path to pinned replica SSH host public key; required with any replica setting
# ATTESTOR_REPLICA_HOST_KEY_FILE=

# Shipping interval as a Go duration, at least one second; required with any replica setting
# ATTESTOR_REPLICA_INTERVAL=

# Path to replica SSH private key; required with any replica setting
# ATTESTOR_REPLICA_KEY_FILE=

# SSH/SFTP operation timeout as a positive Go duration; applies when replication is configured
# ATTESTOR_REPLICA_OPERATION_TIMEOUT=2m

# Absolute per-node directory on the replica; required with any replica setting
# ATTESTOR_REPLICA_REMOTE_DIR=

# Replica SSH login name; required with any replica setting
# ATTESTOR_REPLICA_USER=

# Node RPC endpoint; required with kernel policy
# ATTESTOR_RPC_URL=

# Snapshot interval as a Go duration, at least one second
ATTESTOR_SNAPSHOT_INTERVAL=1h

# Number of newest snapshots to retain
ATTESTOR_SNAPSHOT_RETAIN=48

# Attestor request timeout in milliseconds
ATTESTOR_TIMEOUT_MS=15000

# Path to peer and gateway client CA bundle
ATTESTOR_TLS_CA_FILE=

# Path to API and peer TLS certificate
ATTESTOR_TLS_CERT_FILE=

# Path to API and peer TLS private key
ATTESTOR_TLS_KEY_FILE=

# Archive encryption passphrase, at least 16 bytes; required for archive, delivery and rehearsal
CEREMONY_ARCHIVE_PASSPHRASE=

# Archive output path; required for archive, delivery and rehearsal
CEREMONY_ARCHIVE_PATH=

# Attestor binary path supplied to rehearsal options
# CEREMONY_ATTESTOR_BIN=

# PostgreSQL database used by plan, archive, delivery and move commands
CEREMONY_DATABASE_URL=

# Gateway SQL migration directory; required for rehearsal and move
CEREMONY_GATEWAY_MIGRATIONS_DIR=

# Path to separate gateway-role client TLS certificate; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_GATEWAY_TLS_CERT_FILE=

# Path to gateway-role TLS private key; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_GATEWAY_TLS_KEY_FILE=

# Ceremony identifier; required for delivery and rehearsal
CEREMONY_ID=

# Absolute private journal directory; required for delivery and rehearsal
CEREMONY_JOURNAL_DIR=

# Path to 32-byte journal encryption key in an owned mode-0600 file; required for delivery and rehearsal
CEREMONY_JOURNAL_KEY_FILE=

# Base64 32-byte legacy envelope decryption key; required for delivery and rehearsal
CEREMONY_MASTER_KEY=

# Exactly five HTTPS node endpoints as identifier and URL pairs; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_NODES=

# Matching node identifier and SHA-256 certificate pin pairs; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_NODE_PINS=

# Path to private owner-subject to JWT JSON map; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_OWNER_TOKENS_FILE=

# Isolated rehearsal PostgreSQL admin URL; required for rehearsal
CEREMONY_REHEARSAL_ADMIN_URL=

# Path to separate gateway-role client TLS certificate; required for rehearsal
CEREMONY_REHEARSAL_GATEWAY_TLS_CERT_FILE=

# Path to gateway-role TLS private key; required for rehearsal
CEREMONY_REHEARSAL_GATEWAY_TLS_KEY_FILE=

# Separate private rehearsal journal directory; required for rehearsal
CEREMONY_REHEARSAL_JOURNAL_DIR=

# Exactly five HTTPS node endpoints as identifier and URL pairs; required for rehearsal
CEREMONY_REHEARSAL_NODES=

# Matching node identifier and SHA-256 certificate pin pairs; required for rehearsal
CEREMONY_REHEARSAL_NODE_PINS=

# Path to private owner-subject to JWT JSON map; required for rehearsal
CEREMONY_REHEARSAL_OWNER_TOKENS_FILE=

# Absolute path to rehearsal receipt; required for delivery and rehearsal
CEREMONY_REHEARSAL_RECEIPT=

# Isolated rehearsal node RPC endpoint; required for rehearsal
CEREMONY_REHEARSAL_RPC_URL=

# Path to node TLS CA bundle; required for rehearsal
CEREMONY_REHEARSAL_TLS_CA_FILE=

# Path to operator TLS certificate; required for rehearsal
CEREMONY_REHEARSAL_TLS_CERT_FILE=

# Path to operator TLS private key; required for rehearsal
CEREMONY_REHEARSAL_TLS_KEY_FILE=

# Node RPC endpoint for ceremony binding operations
# CEREMONY_RPC_URL=

# Source PostgreSQL database for rehearsal and move
CEREMONY_SOURCE_DATABASE_URL=

# Path to node TLS CA bundle; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_TLS_CA_FILE=

# Path to operator TLS certificate; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_TLS_CERT_FILE=

# Path to operator TLS private key; required for delivery; gateway-role certificate, key and token file are configured together
CEREMONY_TLS_KEY_FILE=

# Comma-separated allowed browser origins; required at gateway startup
CORS_ORIGINS=

# Host Caddyfile path, absolute or relative to compose directory; required for apply
CUTOVER_CADDYFILE=

# Proxy-container Caddyfile path; required for apply
CUTOVER_CADDYFILE_IN_CONTAINER=

# Existing compose project directory; required for preflight/apply and compose retirement; mutually exclusive with container retirement
CUTOVER_COMPOSE_DIR=

# Standalone container name; alternative to compose retirement
CUTOVER_CONTAINER=

# Bare gateway DNS hostname for preflight and apply
CUTOVER_GATEWAY_HOST=

# Compose proxy service name; required for preflight/apply and compose retirement
CUTOVER_PROXY_SERVICE=

# Bare public wallet DNS hostname for preflight, apply and retire
CUTOVER_PUBLIC_HOST=

# Comma-separated compose service names to retire; required for compose retirement
CUTOVER_RETIRE_SERVICES=

# Exact wallet site label in the Caddyfile; required for apply
CUTOVER_SITE_LABEL=

# Positive elapsed serving time before retirement, in seconds
CUTOVER_SOAK_SECONDS=

# Directory for proxy backups and applied state; required for apply and retire
CUTOVER_STATE_DIR=

# Maximum PostgreSQL connections per worker
DATABASE_POOL_MAX=20

# Gateway PostgreSQL connection string including credentials
DATABASE_URL=

# Admin-route bearer token, at least 32 characters; required for legacy-import apply; Legacy-import apply bearer token
GATEWAY_ADMIN_TOKEN=

# Gateway base URL; required for legacy-import apply
GATEWAY_ADMIN_URL=

# Deployment file secret mounted at /run/secrets/events-approval-token
HUMAN_EVENTS_APPROVAL_TOKEN=

# Deployment file secret mounted at /run/secrets/events-journey-token
HUMAN_EVENTS_JOURNEY_TOKEN=

# Deployment file secret mounted at /run/secrets/events-webhooks-token
HUMAN_EVENTS_WEBHOOKS_TOKEN=

# EVM chain identifier
HYPERPAXEER_CHAIN_ID=125

# Explorer URL returned to wallet clients
# HYPERPAXEER_EXPLORER_URL=

# Chain RPC URL
# HYPERPAXEER_RPC_URL=

# Required deployment-template event producer upstream URL
LAYERX_EVENTS_APPROVAL_UPSTREAM_URL=

# Required deployment-template event producer upstream URL
LAYERX_EVENTS_JOURNEY_UPSTREAM_URL=

# Required deployment-template event producer upstream URL
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_URL=

# Required deployment-template browser origin
LAYERX_HUMAN_WEB_ORIGIN=

# Deployment file secret mounted at /etc/layerx/trust/ca.crt
LAYERX_INTERNAL_CA_ROOT=

# Comma-separated proxy IP addresses or CIDRs trusted for client attribution
# LAYERX_TRUSTED_PROXIES=

# Read-only legacy PostgreSQL connection string for legacy-import
LEGACY_DATABASE_URL=

# Path to attestor TLS CA bundle; command-line settings override environment values
LOADTEST_CA_FILE=

# Target EVM chain identifier; command-line settings override environment values
LOADTEST_CHAIN_ID=

# Path to load generator client TLS certificate; command-line settings override environment values
LOADTEST_CLIENT_CERT_FILE=

# Path to load generator client TLS private key; command-line settings override environment values
LOADTEST_CLIENT_KEY_FILE=

# Positive number of concurrent signing sessions; command-line settings override environment values
LOADTEST_CONCURRENCY=

# Positive run length as a Go duration; command-line settings override environment values
LOADTEST_DURATION=

# Five attestor identifier and socket pairs; command-line settings override environment values
LOADTEST_ENDPOINTS=

# Key generation timeout as a positive Go duration; command-line settings override environment values
LOADTEST_KEYGEN_TIMEOUT=10m

# Signing session timeout as a positive Go duration; command-line settings override environment values
LOADTEST_SESSION_TIMEOUT=2m

# Owner bearer JWT used for signing sessions; command-line settings override environment values
LOADTEST_TOKEN=

# Gateway logging level
LOG_LEVEL=info

# Required deployment-template event producer upstream URL
NAME=

# OAuth callback URL override
# NEXT_PUBLIC_AUTH_REDIRECT_URL=

# Demo wallet API base URL
NEXT_PUBLIC_PAXEER_WALLET_API=

# Metadata base URL for demo page links
# NEXT_PUBLIC_SITE_URL=

# Public browser identity-provider key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo identity provider base URL
NEXT_PUBLIC_SUPABASE_URL=

# Gateway runtime mode
NODE_ENV=development

# Positive gas limit for gas-station provisioning
# PAXEER_GAS_STATION_GAS_LIMIT=

# Positive maximum sponsored token charge in base units
# PAXEER_GAS_STATION_MAX_TOKEN_AMOUNT=

# Paymaster contract; required for gas-station provisioning
# PAXEER_GAS_STATION_PAYMASTER=

# Maximum human-wallet daily value in wei
POLICY_MAX_DAILY_VALUE_WEI=10000000000000000000

# Maximum human-wallet value per transaction in wei
POLICY_MAX_TX_VALUE_WEI=1000000000000000000

# Human-wallet signing requests per minute
POLICY_RATE_LIMIT_PER_MINUTE=60

# Gateway HTTP listening port
PORT=8787

# HTTP requests per account per minute
RATE_LIMIT_ACCOUNT_PER_MINUTE=60

# HTTP requests per client per minute
RATE_LIMIT_CLIENT_PER_MINUTE=120

# RPC member health polling interval in milliseconds
RPC_HEALTH_INTERVAL_MS=5000

# Maximum RPC member lag in blocks
RPC_LAG_THRESHOLD_BLOCKS=20

# RPC request timeout in milliseconds
RPC_TIMEOUT_MS=8000

# Comma-separated HTTP(S) node RPC pool
# RPC_URLS=

# Node RPC endpoint for transaction submission and receipts
# SEQUENCER_RPC_URL=

# Identity provider base URL for JWT issuer and JWKS discovery
SUPABASE_URL=

# Comma-separated EIP-7702 delegation allowlist
# WALLET_AUTHORIZATION_DELEGATES=

# Path to approved signed custody inventory; required with attestor endpoints
# WALLET_CUSTODY_INVENTORY_FILE=

# Path to custody-inventory verification public key; required with attestor endpoints
# WALLET_CUSTODY_INVENTORY_PUBLIC_KEY_FILE=

# Gas-station service URL for sponsored account setup
# WALLET_GAS_STATION_URL=

# Path to identity-binding signing key; configure with the tenant; required by the gateway container and with attestor endpoints
# WALLET_IDENTITY_BINDING_PRIVATE_KEY_FILE=

# Identity-binding tenant; configure with the private-key file; required by the gateway container and with attestor endpoints
# WALLET_IDENTITY_BINDING_TENANT=

# Base64 master encryption key decoding to exactly 32 bytes
WALLET_MASTER_KEY=

# Encryption key version recorded with wallet envelopes
WALLET_MASTER_KEY_VERSION=1
