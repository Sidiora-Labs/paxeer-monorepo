[repair.22.31.247]
finding = "refresh-epoch-recovery"
proof = "TestRepair_247_RefreshEpochRecovery"
implementation = "Authenticated descriptions expose the durable refresh identity and decision; InspectRefreshRecovery admits only the journal-bound base/base+1 transition, replay retains the session, and strict reconciliation requires completed members."
