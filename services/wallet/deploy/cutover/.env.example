# Wallet endpoint cutover environment; select the apply or retirement settings
# Fill required values before use. Secrets and deployment addresses have empty values.
# Commented assignments are unset; enable them only when configuring that feature.
# Address defaults are inherited from the source when their assignment is commented.

# Host Caddyfile path, absolute or relative to compose directory; required for apply
CUTOVER_CADDYFILE=

# Proxy-container Caddyfile path; required for apply
CUTOVER_CADDYFILE_IN_CONTAINER=

# Existing compose project directory; required for preflight/apply and compose retirement; mutually exclusive with container retirement
CUTOVER_COMPOSE_DIR=

# Standalone container name; alternative to compose retirement
CUTOVER_CONTAINER=

# Bare gateway DNS hostname for preflight and apply
CUTOVER_GATEWAY_HOST=

# Compose proxy service name; required for preflight/apply and compose retirement
CUTOVER_PROXY_SERVICE=

# Bare public wallet DNS hostname for preflight, apply and retire
CUTOVER_PUBLIC_HOST=

# Comma-separated compose service names to retire; required for compose retirement
CUTOVER_RETIRE_SERVICES=

# Exact wallet site label in the Caddyfile; required for apply
CUTOVER_SITE_LABEL=

# Positive elapsed serving time before retirement, in seconds
CUTOVER_SOAK_SECONDS=

# Directory for proxy backups and applied state; required for apply and retire
CUTOVER_STATE_DIR=
