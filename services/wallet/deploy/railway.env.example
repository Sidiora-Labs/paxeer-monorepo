# Railway service wallet-gateway (project layerx, environment beta).
# Build: dockerfile docker/wallet-gateway/Dockerfile, repo root context; healthcheck path /healthz.
# File secrets are base64 values; layerx-env-files writes them to /run/secrets (docker/wallet-gateway/files.tsv).
NODE_ENV=production
PORT=8080
HYPERPAXEER_CHAIN_ID=125
DATABASE_URL=postgres://<user>:<password>@wallet-postgres.railway.internal:5432/<database>
LAYERX_TRUSTED_PROXIES=<railway edge proxy CIDRs>
CORS_ORIGINS=<comma-separated wallet origins>
SUPABASE_URL=https://supabase.paxeer.app
WALLET_MASTER_KEY=<base64 32 bytes>
WALLET_IDENTITY_BINDING_TENANT=paxeer-x-mainnet-beta
WALLET_IDENTITY_BINDING_PRIVATE_KEY_FILE=/run/secrets/wallet_identity_binding_key
WALLET_CUSTODY_INVENTORY_FILE=/run/secrets/wallet_custody_inventory.jwt
WALLET_CUSTODY_INVENTORY_PUBLIC_KEY_FILE=/run/secrets/wallet_custody_inventory_authority.pem
WALLET_GAS_STATION_URL=
ATTESTOR_ENDPOINTS=https://<attestor-1-host>:8443,https://<attestor-2-host>:8443,https://<attestor-3-host>:8443,https://<attestor-4-host>:8443,https://<attestor-5-host>:8443
ATTESTOR_CLIENT_CERT_FILE=/run/secrets/attestor_client.crt
ATTESTOR_CLIENT_KEY_FILE=/run/secrets/attestor_client.key
ATTESTOR_CA_FILE=/run/secrets/attestor_ca.crt
ATTESTOR_QUORUM=3
# Provision these base64 file secrets through layerx-env-files (not gateway Env keys):
# WALLET_IDENTITY_BINDING_KEY: <base64>
# WALLET_CUSTODY_INVENTORY: <base64>
# WALLET_CUSTODY_INVENTORY_PUBLIC_KEY: <base64>
# ATTESTOR_CLIENT_CERT: <base64>
# ATTESTOR_CLIENT_KEY: <base64>
# ATTESTOR_CA: <base64>

# Additional deployment variables

# Maximum account setup gas cost in wei
ACCOUNT_SETUP_GAS_CAP_WEI=10000000000000000

# Receipt confirmations required for durable actions
ACTION_CONFIRMATIONS=1

# Replacement transaction fee bump percentage
ACTION_FEE_BUMP_PERCENT=12

# Receipt wait timeout in milliseconds
ACTION_RECEIPT_TIMEOUT_MS=90000

# Durable-action reconciliation interval in milliseconds
ACTION_RECONCILE_INTERVAL_MS=30000

# Durable-action worker interval in milliseconds
ACTION_WORKER_INTERVAL_MS=3000

# Agent authentication challenge lifetime in seconds
AGENT_CHALLENGE_TTL_SECONDS=120

# Initial freeze flag for a new agent
AGENT_DEFAULT_FROZEN=true

# Default per-agent token approval cap in base units
AGENT_DEFAULT_MAX_APPROVE_WEI=0

# Default per-agent daily value cap in wei
AGENT_DEFAULT_MAX_DAILY_VALUE_WEI=0

# Default per-agent transaction value cap in wei
AGENT_DEFAULT_MAX_TX_VALUE_WEI=0

# Initial agent policy mode
AGENT_DEFAULT_MODE=read_only

# Default per-agent signing requests per minute
AGENT_DEFAULT_RATE_LIMIT_PER_MINUTE=30

# HS256 agent-token signing secret, at least 32 characters; setting it enables agent authentication
# AGENT_JWT_SECRET=

# Maximum signed agent-request lifetime in seconds
AGENT_REQUEST_MAX_TTL_SECONDS=300

# Agent bearer-token lifetime in seconds
AGENT_TOKEN_TTL_SECONDS=900

# Gateway worker count, from 1 to 64; each has its own database pool
API_WORKERS=1

# Base64 file input materialized at /run/secrets/attestor_ca.crt
ATTESTOR_CA=

# Base64 file input materialized at /run/secrets/attestor_client.crt
ATTESTOR_CLIENT_CERT=

# Base64 file input materialized at /run/secrets/attestor_client.key
ATTESTOR_CLIENT_KEY=

# Attestor health polling interval in milliseconds
ATTESTOR_HEALTH_INTERVAL_MS=5000

# Attestor request timeout in milliseconds
ATTESTOR_TIMEOUT_MS=15000

# Maximum PostgreSQL connections per worker
DATABASE_POOL_MAX=20

# Admin-route bearer token, at least 32 characters; required for legacy-import apply; Legacy-import apply bearer token
# GATEWAY_ADMIN_TOKEN=

# Explorer URL returned to wallet clients
# HYPERPAXEER_EXPLORER_URL=

# Chain RPC URL
# HYPERPAXEER_RPC_URL=

# Owner applied to materialized files when running as root
# LAYERX_FILES_OWNER=

# Ownership override for the materialized ATTESTOR_CA file
# LAYERX_FILES_OWNER_ATTESTOR_CA=

# Ownership override for the materialized ATTESTOR_CLIENT_CERT file
# LAYERX_FILES_OWNER_ATTESTOR_CLIENT_CERT=

# Ownership override for the materialized ATTESTOR_CLIENT_KEY file
# LAYERX_FILES_OWNER_ATTESTOR_CLIENT_KEY=

# Ownership override for the materialized SPONSOR_PRIVATE_KEY file
# LAYERX_FILES_OWNER_SPONSOR_PRIVATE_KEY=

# Ownership override for the materialized WALLET_CUSTODY_INVENTORY file
# LAYERX_FILES_OWNER_WALLET_CUSTODY_INVENTORY=

# Ownership override for the materialized WALLET_CUSTODY_INVENTORY_PUBLIC_KEY file
# LAYERX_FILES_OWNER_WALLET_CUSTODY_INVENTORY_PUBLIC_KEY=

# Ownership override for the materialized WALLET_IDENTITY_BINDING_KEY file
# LAYERX_FILES_OWNER_WALLET_IDENTITY_BINDING_KEY=

# Container secret-file mapping table path
LAYERX_FILES_TABLE=/etc/layerx/files.tsv

# Gateway logging level
LOG_LEVEL=info

# Positive gas limit for gas-station provisioning
# PAXEER_GAS_STATION_GAS_LIMIT=

# Positive maximum sponsored token charge in base units
# PAXEER_GAS_STATION_MAX_TOKEN_AMOUNT=

# Paymaster contract; required for gas-station provisioning
# PAXEER_GAS_STATION_PAYMASTER=

# Maximum human-wallet daily value in wei
POLICY_MAX_DAILY_VALUE_WEI=10000000000000000000

# Maximum human-wallet value per transaction in wei
POLICY_MAX_TX_VALUE_WEI=1000000000000000000

# Human-wallet signing requests per minute
POLICY_RATE_LIMIT_PER_MINUTE=60

# HTTP requests per account per minute
RATE_LIMIT_ACCOUNT_PER_MINUTE=60

# HTTP requests per client per minute
RATE_LIMIT_CLIENT_PER_MINUTE=120

# RPC member health polling interval in milliseconds
RPC_HEALTH_INTERVAL_MS=5000

# Maximum RPC member lag in blocks
RPC_LAG_THRESHOLD_BLOCKS=20

# RPC request timeout in milliseconds
RPC_TIMEOUT_MS=8000

# Comma-separated HTTP(S) node RPC pool
# RPC_URLS=

# Node RPC endpoint for transaction submission and receipts
# SEQUENCER_RPC_URL=

# Base64 file input materialized at /run/secrets/sponsor_private_key
SPONSOR_PRIVATE_KEY=

# Comma-separated EIP-7702 delegation allowlist
# WALLET_AUTHORIZATION_DELEGATES=

# Base64 file input materialized at /run/secrets/wallet_custody_inventory.jwt
WALLET_CUSTODY_INVENTORY=

# Base64 file input materialized at /run/secrets/wallet_custody_inventory_authority.pem
WALLET_CUSTODY_INVENTORY_PUBLIC_KEY=

# Base64 file input materialized at /run/secrets/wallet_identity_binding_key
WALLET_IDENTITY_BINDING_KEY=

# Encryption key version recorded with wallet envelopes
WALLET_MASTER_KEY_VERSION=1
