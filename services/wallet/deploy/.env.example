# Human-service deployment template inputs
# Fill required values before use. Secrets and deployment addresses have empty values.
# Commented assignments are unset; enable them only when configuring that feature.
# Address defaults are inherited from the source when their assignment is commented.

# Deployment file secret mounted at /run/secrets/events-approval-token
HUMAN_EVENTS_APPROVAL_TOKEN=

# Deployment file secret mounted at /run/secrets/events-journey-token
HUMAN_EVENTS_JOURNEY_TOKEN=

# Deployment file secret mounted at /run/secrets/events-webhooks-token
HUMAN_EVENTS_WEBHOOKS_TOKEN=

# Required deployment-template event producer upstream URL
LAYERX_EVENTS_APPROVAL_UPSTREAM_URL=

# Required deployment-template event producer upstream URL
LAYERX_EVENTS_JOURNEY_UPSTREAM_URL=

# Required deployment-template event producer upstream URL
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_URL=

# Required deployment-template browser origin
LAYERX_HUMAN_WEB_ORIGIN=

# Deployment file secret mounted at /etc/layerx/trust/ca.crt
LAYERX_INTERNAL_CA_ROOT=

# Required deployment-template event producer upstream URL
NAME=
