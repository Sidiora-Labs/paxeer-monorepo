# Wallet attestor environment; supply this node and peer identities
# Fill required values before use. Secrets and deployment addresses have empty values.
# Commented assignments are unset; enable them only when configuring that feature.
# Address defaults are inherited from the source when their assignment is commented.

# Comma-separated admitted activity type numbers; asset-send type is supported
# ATTESTOR_ACTIVITY_TYPES=

# Principal-file configuration path
# ATTESTOR_AGENTS_FILE=

# Maximum signed agent-request lifetime as a Go duration
ATTESTOR_AGENT_MAX_EXPIRY=5m

# Agent sponsored-transaction paymaster contract
# ATTESTOR_AGENT_PAYMASTER=

# Expected custody producer authority issuer
ATTESTOR_AUTHORITY_ISSUER=

# Path to pinned custody producer authority public key
ATTESTOR_AUTHORITY_PUBLIC_KEY_FILE=

# Expected custody producer authority tenant
ATTESTOR_AUTHORITY_TENANT=

# Encrypted snapshot directory; required for replication
# ATTESTOR_BACKUP_DIR=

# Base64 file input materialized at /run/secrets/backup.key
ATTESTOR_BACKUP_KEY=

# Path to snapshot encryption key; required with backup directory and for restore
# ATTESTOR_BACKUP_KEY_FILE=

# Enable operator key imports during a ceremony window
ATTESTOR_CEREMONY=false

# Required EVM chain identifier
ATTESTOR_CHAIN_ID=

# Encrypted share-store directory
ATTESTOR_DATA_DIR=

# Path to signed approved custody inventory
ATTESTOR_INVENTORY_FILE=

# Path to approved inventory verification public key
ATTESTOR_INVENTORY_PUBLIC_KEY_FILE=

# JWT verifier JWKS endpoint; setting it enables user-token verification
# ATTESTOR_JWKS_URL=

# Expected JWT audience; required when JWKS verification is enabled
# ATTESTOR_JWT_AUDIENCE=

# Expected JWT issuer; required when JWKS verification is enabled
# ATTESTOR_JWT_ISSUER=

# Maximum age of accepted user JWTs as a Go duration
ATTESTOR_JWT_MAX_AGE=1h

# Path to native activity and grant policy JSON
# ATTESTOR_KERNEL_POLICY_FILE=

# API listener socket address
ATTESTOR_LISTEN_ADDR=

# Path to owner-purpose policy JSON
# ATTESTOR_NATIVE_POLICY_FILE=

# Participant identifier of this attestor
ATTESTOR_NODE_ID=

# Base64 file input materialized at /run/secrets/node.key
ATTESTOR_NODE_KEY=

# Path to 32-byte share-store encryption key, raw or hex
ATTESTOR_NODE_KEY_FILE=

# Base64 file input materialized at /run/secrets/operator-ca.crt
ATTESTOR_OPERATOR_CA=

# Path to distinct operator client CA bundle
ATTESTOR_OPERATOR_CA_FILE=

# Comma-separated identifier and socket pairs for the other four participants
ATTESTOR_PEERS=

# Peer transport listener socket address
ATTESTOR_PEER_LISTEN_ADDR=

# Comma-separated identifier and SHA-256 SPKI pin pairs for the other four participants
ATTESTOR_PEER_PINS=

# Path to EVM signing policy JSON
# ATTESTOR_POLICY_FILE=

# Region label reported by health
# ATTESTOR_REGION=

# Replica SSH socket address; required with any replica setting
# ATTESTOR_REPLICA_ADDR=

# Base64 file input materialized at /run/secrets/replica-host.pub
ATTESTOR_REPLICA_HOST_KEY=

# Path to pinned replica SSH host public key; required with any replica setting
# ATTESTOR_REPLICA_HOST_KEY_FILE=

# Shipping interval as a Go duration, at least one second; required with any replica setting
# ATTESTOR_REPLICA_INTERVAL=

# Base64 file input materialized at /run/secrets/replica.key
ATTESTOR_REPLICA_KEY=

# Path to replica SSH private key; required with any replica setting
# ATTESTOR_REPLICA_KEY_FILE=

# SSH/SFTP operation timeout as a positive Go duration; applies when replication is configured
# ATTESTOR_REPLICA_OPERATION_TIMEOUT=2m

# Absolute per-node directory on the replica; required with any replica setting
# ATTESTOR_REPLICA_REMOTE_DIR=

# Replica SSH login name; required with any replica setting
# ATTESTOR_REPLICA_USER=

# Node RPC endpoint; required with kernel policy
# ATTESTOR_RPC_URL=

# Snapshot interval as a Go duration, at least one second
ATTESTOR_SNAPSHOT_INTERVAL=1h

# Number of newest snapshots to retain
ATTESTOR_SNAPSHOT_RETAIN=48

# Base64 file input materialized at /run/secrets/ca.crt
ATTESTOR_TLS_CA=

# Path to peer and gateway client CA bundle
ATTESTOR_TLS_CA_FILE=

# Base64 file input materialized at /run/secrets/tls.crt
ATTESTOR_TLS_CERT=

# Path to API and peer TLS certificate
ATTESTOR_TLS_CERT_FILE=

# Base64 file input materialized at /run/secrets/tls.key
ATTESTOR_TLS_KEY=

# Path to API and peer TLS private key
ATTESTOR_TLS_KEY_FILE=

# Owner applied to materialized files when running as root
# LAYERX_FILES_OWNER=

# Ownership override for the materialized ATTESTOR_BACKUP_KEY file
# LAYERX_FILES_OWNER_ATTESTOR_BACKUP_KEY=

# Ownership override for the materialized ATTESTOR_NODE_KEY file
# LAYERX_FILES_OWNER_ATTESTOR_NODE_KEY=

# Ownership override for the materialized ATTESTOR_OPERATOR_CA file
# LAYERX_FILES_OWNER_ATTESTOR_OPERATOR_CA=

# Ownership override for the materialized ATTESTOR_REPLICA_HOST_KEY file
# LAYERX_FILES_OWNER_ATTESTOR_REPLICA_HOST_KEY=

# Ownership override for the materialized ATTESTOR_REPLICA_KEY file
# LAYERX_FILES_OWNER_ATTESTOR_REPLICA_KEY=

# Ownership override for the materialized ATTESTOR_TLS_CA file
# LAYERX_FILES_OWNER_ATTESTOR_TLS_CA=

# Ownership override for the materialized ATTESTOR_TLS_CERT file
# LAYERX_FILES_OWNER_ATTESTOR_TLS_CERT=

# Ownership override for the materialized ATTESTOR_TLS_KEY file
# LAYERX_FILES_OWNER_ATTESTOR_TLS_KEY=

# Ownership override for the materialized WALLET_CUSTODY_INVENTORY file
# LAYERX_FILES_OWNER_WALLET_CUSTODY_INVENTORY=

# Ownership override for the materialized WALLET_CUSTODY_INVENTORY_PUBLIC_KEY file
# LAYERX_FILES_OWNER_WALLET_CUSTODY_INVENTORY_PUBLIC_KEY=

# Ownership override for the materialized WALLET_IDENTITY_BINDING_PUBLIC_KEY file
# LAYERX_FILES_OWNER_WALLET_IDENTITY_BINDING_PUBLIC_KEY=

# Container secret-file mapping table path
LAYERX_FILES_TABLE=/etc/layerx/files.tsv

# Base64 file input materialized at /run/secrets/wallet_custody_inventory.jwt
WALLET_CUSTODY_INVENTORY=

# Base64 file input materialized at /run/secrets/wallet_custody_inventory_authority.pem
WALLET_CUSTODY_INVENTORY_PUBLIC_KEY=

# Base64 file input materialized at /run/secrets/wallet_identity_binding_public.pem
WALLET_IDENTITY_BINDING_PUBLIC_KEY=
