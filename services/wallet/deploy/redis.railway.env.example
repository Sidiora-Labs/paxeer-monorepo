# Railway project layerx, environment beta: service redis-router from
# docker/redis/Dockerfile, volume at /data. Replaces the Fly app paxeer-shared-endpoint-redis.
# Private address: rediss://<user>:<password>@redis-router.railway.internal:6379
# File values are base64 (docker/redis/files.tsv): REDIS_TLS_* are the
# REDIS_TLS_CERT/KEY/CA lines of tools/bringup/ca.sh issue gateway-redis, REDIS_ACL is the
# users.acl holding the ACL users the clients send, REDIS_CONF holds extra
# directives (base64 of an empty file for none); the rendered TLS, ACL,
# persistence and bind directives override it.

# service redis-router
LAYERX_ROLE=redis-router
REDIS_MAXMEMORY=0
REDIS_CONF=
REDIS_TLS_CERT=
REDIS_TLS_KEY=
REDIS_TLS_CA=
REDIS_ACL=

# Additional deployment variables

# Owner applied to materialized files when running as root
# LAYERX_FILES_OWNER=

# Ownership override for the materialized REDIS_ACL file
# LAYERX_FILES_OWNER_REDIS_ACL=

# Ownership override for the materialized REDIS_CONF file
# LAYERX_FILES_OWNER_REDIS_CONF=

# Ownership override for the materialized REDIS_TLS_CA file
# LAYERX_FILES_OWNER_REDIS_TLS_CA=

# Ownership override for the materialized REDIS_TLS_CERT file
# LAYERX_FILES_OWNER_REDIS_TLS_CERT=

# Ownership override for the materialized REDIS_TLS_KEY file
# LAYERX_FILES_OWNER_REDIS_TLS_KEY=

# Container secret-file mapping table path
LAYERX_FILES_TABLE=/etc/layerx/files.tsv
