# Wallet deployment Redis container environment
# Fill required values before use. Secrets and deployment addresses have empty values.
# Commented assignments are unset; enable them only when configuring that feature.
# Address defaults are inherited from the source when their assignment is commented.

# Owner applied to materialized files when running as root
# LAYERX_FILES_OWNER=

# Ownership override for the materialized REDIS_ACL file
# LAYERX_FILES_OWNER_REDIS_ACL=

# Ownership override for the materialized REDIS_CONF file
# LAYERX_FILES_OWNER_REDIS_CONF=

# Ownership override for the materialized REDIS_TLS_CA file
# LAYERX_FILES_OWNER_REDIS_TLS_CA=

# Ownership override for the materialized REDIS_TLS_CERT file
# LAYERX_FILES_OWNER_REDIS_TLS_CERT=

# Ownership override for the materialized REDIS_TLS_KEY file
# LAYERX_FILES_OWNER_REDIS_TLS_KEY=

# Container secret-file mapping table path
LAYERX_FILES_TABLE=/etc/layerx/files.tsv

# Redis role; also selects rows in container secret-file tables
LAYERX_ROLE=redis-router

# Base64 file input materialized at /run/secrets/users.acl
REDIS_ACL=

# Base64 file input materialized at /run/secrets/redis.conf
REDIS_CONF=

# Redis maximum memory size
REDIS_MAXMEMORY=0

# Base64 file input materialized at /run/secrets/ca.crt
REDIS_TLS_CA=

# Base64 file input materialized at /run/secrets/redis.crt
REDIS_TLS_CERT=

# Base64 file input materialized at /run/secrets/redis.key
REDIS_TLS_KEY=
