before = "Nonce checkout and BEGIN remain open across callbacks that use pool-backed policy, custody, accounting and persistence."
after = "Signing callbacks serialize on a session advisory nonce lock and use the same client through a bounded AsyncLocalStorage scope. SQL helpers and short accounting transactions borrow that client. Nonce holds and signed hashes are persisted before broadcast; unsigned holds are removed on callback failure. Existing transaction-mode callers take the same advisory lock to serialize with signing sessions."

[site.signing_dependencies]
