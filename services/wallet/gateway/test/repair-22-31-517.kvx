[proof]
file = "services/wallet/gateway/test/repair-22-31-517.test.ts"
database = "Real PGlite with pgcrypto, exposed over PostgreSQL wire by PGLiteSocketServer; normal gateway migrations; env.DATABASE_POOL_MAX=1 before getPool."
transport = "Fastify injection into real routes with locally signed JWTs verified over the existing local identity-provider JWKS server; existing TestChain for signed EVM transactions and sequencer receipts. No live endpoints, credentials, subprocess toolchain or externally supplied environment required."
deadline = "Each named test has a 4000ms deadline, below the pool acquisition timeout of 5000ms."
tests = ["walletSendCompletesWithOneConnection", "walletSendKeepsClientAccountPolicyRefusalOrder", "walletSendKeepsMissingArchivedDisabledResponses", "messageSigningCommitsAccountingOnOneConnection", "lxApprovalLimiterAndRecoveryCompleteWithOneConnection", "evmApprovalAndRecoveryCompleteWithOneConnection", "parallelSendsKeepDistinctNoncesOnOneConnection", "sharedWalletLockReusesClientForDurableSigning", "signOnlyKeepsSignedBytesAndNonceWithOneConnection", "humanSendRecoveryReopensOnOneConnection"]
regression = "Pre-repair sign.ts checks out the only client before the account limiter requests another one. The send tests must therefore time out (or receive send_failed instead of the asserted response). The LX approve regression reaches its former pool client limiter inside BEGIN; recovery GET tests reach the former nested checkout under an advisory lock."

