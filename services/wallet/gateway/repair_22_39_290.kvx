[qualification.build_environment]
revision = "4040ba09f81668a4820cffc3557bfd874ece72ad"
command = "corepack enable && cd services/wallet && pnpm install --frozen-lockfile --ignore-scripts && cd ../.. && pnpm --dir services/wallet/gateway run typecheck"
exit = 1
log = "/out/logs/build-1.log"
observed = "The install succeeded, then the Corepack pnpm shim selected the repository root's npm packageManager before pnpm could handle --dir; TypeScript did not run."
repair = "Set COREPACK_ENABLE_PROJECT_SPEC=0 for the bounded gate processes so Corepack dispatches pnpm; pnpm retains its own workspace packageManager and frozen-lockfile checks. No manifest or validation assertion changes."

[qualification.build_dispatch]
revision = "cbc473c80537d0c8478205a1c8a154c4712cd75d"
command = "corepack enable && cd services/wallet && pnpm install --frozen-lockfile --ignore-scripts && cd ../.. && pnpm --dir services/wallet/gateway run typecheck"
exit = 1
log = "/out/logs/build-2.log"
observed = "With project selection disabled, Corepack selected its pnpm 12.18.0 default and pnpm correctly refused the workspace's required 10.34.9; TypeScript did not run."
repair = "Activate the already cached pnpm 10.34.9 using corepack prepare pnpm@10.34.9 --activate, then retain COREPACK_ENABLE_PROJECT_SPEC=0 for gate dispatch; no version or lockfile check is disabled."

