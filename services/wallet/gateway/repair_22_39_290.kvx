[repair]
task = "22.39.290"
acceptance = "22998.1"
base_revision = "7c65ca246479ea68169faf54cef98cfeb9e66537"
inventory_revision = "ffdbfa83942b"
inventory = "Gotcha 3992 / decision 3126: original 68 failing cases in 25 files; attempt 2 runs the explicitly requested base comparison before further implementation."
status = "implemented_not_qualified_pending_final_bounded_gate"
verify_command = "test -s services/wallet/gateway/repair_22_39_290.kvx && pnpm --dir services/wallet/gateway run test"
verified_revision = "Resolve the final verify row's revision in private /out/run/gates.jsonl; qualification is claimed only if that row has exit 0 and matches the preceding build revision."
evidence = "/out/run/gates.jsonl and the log path printed by hf-done; no raw operational evidence is published."

[cause.configuration_import]
site = "test/support/node-receipts.ts imported src/provision/bind.ts, which imported rpc/pool.ts and captured env before beforeAll configured custody, chain or provisioning."
repair = "Move unchanged binding protocol definitions and cryptography into src/provision/protocol.ts; re-export from bind.ts and have the receipt helper import the pure module. Runtime validation, assertions, custody policy and node transcript requirements remain in force."
affected = ["provisioning.test.ts", "backfill-command.test.ts", "e2e/gateway.e2e.test.ts", "agent.test.ts", "evm-sign.test.ts", "evm-approvals.test.ts", "lx-approvals.test.ts", "agent-daily-cap-concurrency.test.ts", "agent-rate-limit-reservation.test.ts", "agent-receipt.test.ts", "owner-broadcast-outcome.test.ts", "served-by.test.ts", "sign-client-nonce.test.ts"]

[cause.external_precompile]
site = "Precompile conformance proxies forwarded to setup.ts localhost:0 or an operator-provided RPC."
repair = "Each case owns an explicit loopback peer decoding the published Go ABI; empty scheduler/stream state, malformed TEE quote refusals and EIP-712 hashing/recovery follow the published contract. Unexpected methods fail teardown. The existing observers still assert target, selectors, arguments, response and absence of broadcasts."
affected = ["agent-precompiles-scheduler.test.ts", "agent-precompiles-streams.test.ts", "agent-precompiles-eip712.test.ts", "agent-precompiles-tee.test.ts"]
contract = "precompiles/layerxagent/{scheduler,streams,eip712,teeattestor}/*.go"

[cause.external_executable]
site = "Three tests spawned anvil although the qualification environment has no Anvil binary."
repair = "Use the existing TestChain signing/nonce/balance loopback material in explicit EVM mode. Real gateway child processes, PostgreSQL, identity verification and custody daemons remain exercised; EVM mode explicitly refuses Paxeer receipt methods and returns empty native-precompile calls."
affected = ["agent-actions-sequencer.test.ts", "proof_s27_embedded_wallet_gateway.test.ts", "served-by.test.ts"]

[cause.rpc_health]
site = "Existing peers answered eth_blockNumber but refused the eth_chainId health request, so the shared pool marked them down before a later read."
repair = "Answer eth_chainId=0x7d, matching the configured chain 125; retain the original method-specific replies and failure scenarios."
affected = ["agent-receipt.test.ts", "owner-broadcast-outcome.test.ts", "sign-client-nonce.test.ts", "chain-reads-receipt.test.ts", "evm-sign.test.ts"]

[cause.agent_setup]
site = "agent.test.ts used the identity-only HTTP server as an RPC and assumed authentication still created a wallet."
repair = "Use explicit EVM loopback RPCs and create the encrypted legacy wallet through the production repository after authentication; attach it to the principal before request-signing cases. The actual signature and replay assertions remain."
affected = ["agent.test.ts"]

[cause.tee_abi]
site = "teeRoutesEncodeNodeAbiSelectors assumed the published ABI contained only four gateway methods although it also declares bindPeer and peerBinding."
repair = "Assert the exact six published method names, assert exactly four gateway methods, and retain equality between emitted selectors and those four route selectors."
owner = "wallet gateway conformance; published peer methods are owned by node TEE precompile tasks"

[boundary.node_receipts]
site = "test/provisioning.test.ts::nodeEvidenceForTransaction"
observed = "Static inspection: this fixture generates random keys and transactions but requires each envelope to exist in a fixed node-recorded corpus; a missing transcript remains a hard assertion."
owner = "22.33.208 (node-produced sponsored receipt evidence); node execution transcripts belong to domain 5"
assumption = "No generated or unrecorded receipt is substituted for a required node transcript. Any qualification failure at this boundary must be reported with its command evidence."

[boundary.schema]
site = "test/schemas.injection.test.ts::TxRequest forward-compatible inner shape"
observed = "Static inspection: the case expects unknown fields to be stripped while repair-22-33-184.test.ts and the strict TxRequest codec require refusal."
owner = "22.33.184 (tx-extra-fields-discarded), wallet domain 12"
assumption = "Both assertions remain intact; a cross-task contradiction is reported rather than changing acceptance to obtain a pass."

