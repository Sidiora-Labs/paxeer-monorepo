[finding.raw-precompile-policy-bypass]
tests = ["rawPrecompilePolicyMatchesHelperRecipientsAndCaps", "rawPrecompilePolicyChecksNestedScheduledCalls", "rawPrecompilePolicyRefusesUndecodableMovement", "rawPrecompilePolicyAllowsDecodedCallsAtPolicyBoundaries", "rawPrecompilePolicyUsesServedAbiOnBothSides"]
