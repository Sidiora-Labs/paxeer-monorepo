qualification = "The runner records the verified candidate revision, exact command, exit code and private evidence log through hf-build and hf-done."
qualification_gotcha = "Vitest 4.1.12 accepts test(function) but registers TODOs without executing the callback; use test(function.name, function) with each declared proving function. Candidate feac3f9e17a619a83f37c15fe06e53dba8f9c95a exited zero with ten TODOs at /out/logs/verify-1.log, so that run is not behavioral evidence; repair registration and rerun both bounded gates."
wiring_request = "None: the finding and its HTTP proof are fully repairable within the declared RPC and test paths."
