build_cmd = "python3 -m py_compile tests/ci/test_wallet_js_suites_wired.py"
verify_cmd = "python3 -m pytest -q tests/ci/test_wallet_js_suites_wired.py"
baseline = "No prior gate ledger or task implementation was present. No pre-change suite was run: the task requires complete implementation before qualification and permits only the declared Python build and verification."
