# Agent service environment. See docs/release/variables/service-agent.md.
# Set the required inputs for the selected mode and enabled features.
# Empty entries have no source default. Credential values are always empty.
# Optional and Cargo-supplied entries are commented so they remain absent.
# Endpoint defaults are described without publishing host addresses.

# Crate directory supplied by Cargo to build scripts. build metadata; supplied by Cargo.
# CARGO_MANIFEST_DIR=

# Package version supplied by Cargo at compile time. build metadata; supplied by Cargo.
# CARGO_PKG_VERSION=

# Comma-separated paths to daemon MCP binding documents. agent RPC.
# Source default: Empty binding list.
# LAYERX_AGENTD_MCP_BINDINGS=

# Path to the protected JSON array of MCP payer configurations. agent RPC.
# Source default: No MCP payers attached.
# LAYERX_AGENTD_MCP_PAYERS=

# Daemon sequence retention bound for idempotency. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_IDEMPOTENCY_DAEMON_SEQUENCES=

# Protocol sequence retention bound for idempotency. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_IDEMPOTENCY_PROTOCOL_SEQUENCES=

# Absolute path to persistent idempotency records. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_IDEMPOTENCY_ROOT=

# Enables and binds the mutually authenticated agent RPC listener.
# Source default: RPC listener disabled.
# LAYERX_AGENTD_RPC_LISTEN=

# Expected TLS client peer identity. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_PEER=

# Absolute path to the RPC TLS certificate. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_TLS_CERT=

# Absolute path to the RPC TLS client CA. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_TLS_CLIENT_CA=

# Absolute path to the RPC TLS private key; the path itself is not a secret. required when LAYERX_AGENTD_RPC_LISTEN enables RPC.
LAYERX_AGENTD_RPC_TLS_KEY=

# Authority bearer credential, distinct from the program credential. full and inference-market modes.
LAYERX_AGENT_AUTHORITY_BEARER_TOKEN=

# Path to the DER CA used for authority and node connections. full and inference-market modes.
LAYERX_AGENT_AUTHORITY_CA_DER=

# Authority endpoint. full and inference-market modes.
LAYERX_AGENT_AUTHORITY_ENDPOINT=

# Authority replica digest. full and inference-market modes.
LAYERX_AGENT_AUTHORITY_REPLICA_ID=

# Absolute path to the protected binary chain trust root. full and inference-market modes.
LAYERX_AGENT_CHAIN_TRUST_ROOT=

# Consensus endpoint for program chain proofs.
# Source default: Uses the configured node endpoint when absent.
# LAYERX_AGENT_CONSENSUS_ENDPOINT=

# Directory holding verified deployment admissions and records. full and inference-market modes.
LAYERX_AGENT_DEPLOYMENT_JOURNAL=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_GENESIS_TRUST=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HANDOVER_FINALITY=

# Human authority bearer credential. all daemon modes.
LAYERX_AGENT_HUMAN_AUTHORITY_BEARER=

# Path to the human authority DER CA. all daemon modes.
LAYERX_AGENT_HUMAN_AUTHORITY_CA_DER=

# Human authority endpoint. all daemon modes.
LAYERX_AGENT_HUMAN_AUTHORITY_ENDPOINT=

# Maximum human authority response size in bytes. all daemon modes.
LAYERX_AGENT_HUMAN_AUTHORITY_MAX_BYTES=

# Human transport deadline in milliseconds. all daemon modes.
LAYERX_AGENT_HUMAN_DEADLINE_MS=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HUMAN_EXPORT_SETTLEMENT_DOMAIN=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HUMAN_EXPORT_SET_VERSION=

# Budget ceiling as an unsigned integer. all daemon modes.
LAYERX_AGENT_HUMAN_LIMIT_CEILING=

# Already consumed budget as an unsigned integer. all daemon modes.
LAYERX_AGENT_HUMAN_LIMIT_CONSUMED=

# 16-byte hexadecimal budget limit identifier. all daemon modes.
LAYERX_AGENT_HUMAN_LIMIT_ID=

# Budget limit name. all daemon modes.
LAYERX_AGENT_HUMAN_LIMIT_NAME=

# Budget scope: tenant, agent, session, capability or counterparty. all daemon modes.
LAYERX_AGENT_HUMAN_LIMIT_SCOPE=

# 32-byte hexadecimal budget scope identifier. all daemon modes.
LAYERX_AGENT_HUMAN_LIMIT_SCOPE_ID=

# Maximum simultaneous Human connections. all daemon modes.
LAYERX_AGENT_HUMAN_MAX_CONNECTIONS=

# Maximum Human frame size in bytes. all daemon modes.
LAYERX_AGENT_HUMAN_MAX_FRAME_BYTES=

# Maximum native activity payload size in bytes. all daemon modes.
LAYERX_AGENT_HUMAN_MAX_PAYLOAD_BYTES=

# Maximum queued Human transport bytes. all daemon modes.
LAYERX_AGENT_HUMAN_MAX_QUEUED_BYTES=

# Maximum simultaneous Human streams. all daemon modes.
LAYERX_AGENT_HUMAN_MAX_STREAMS=

# Human network identity; must match the node chain identity. all daemon modes.
LAYERX_AGENT_HUMAN_NETWORK_ID=

# Comma-separated peer entries, each containing uid, tenant and principal separated by semicolons. all daemon modes.
LAYERX_AGENT_HUMAN_PEERS=

# Current state-commitment wire protocol version. all daemon modes.
LAYERX_AGENT_HUMAN_PROTOCOL_VERSION=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HUMAN_RECONNECT_ATTEMPTS=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HUMAN_RECONNECT_BASE_MS=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HUMAN_RECONNECT_JITTER_PERCENT=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_HUMAN_RECONNECT_MAX_MS=

# Absolute path to the persistent session-key directory. all daemon modes.
LAYERX_AGENT_HUMAN_SESSION_KEY_ROOT=

# Absolute path to the protected operator-secret file; the path itself is not a secret. all daemon modes.
LAYERX_AGENT_HUMAN_SESSION_OPERATOR_SECRET_FILE=

# Absolute path to the Human Unix socket. all daemon modes.
LAYERX_AGENT_HUMAN_SOCKET=

# Human socket owner group ID. all daemon modes.
LAYERX_AGENT_HUMAN_SOCKET_GID=

# Human socket permissions in octal. all daemon modes.
LAYERX_AGENT_HUMAN_SOCKET_MODE=

# Human socket owner user ID. all daemon modes.
LAYERX_AGENT_HUMAN_SOCKET_UID=

# Absolute path to the persistent agent store. all daemon modes.
LAYERX_AGENT_HUMAN_STORE=

# Accepted activity timestamp span. all daemon modes.
LAYERX_AGENT_HUMAN_TIMESTAMP_SPAN=

# Attestation-family byte. required when host enrolment is enabled.
LAYERX_AGENT_INFERENCE_ATTESTATION_FAMILY=

# Bandwidth measurement probe URL. required when host enrolment is enabled.
LAYERX_AGENT_INFERENCE_BANDWIDTH_PROBE=

# Path to completion receipt material. inference-market mode.
# Source default: Absent.
# LAYERX_AGENT_INFERENCE_COMPLETION_RECEIPTS=

# Path to the local completion worker socket. inference-market mode.
# Source default: Absent.
# LAYERX_AGENT_INFERENCE_COMPLETION_SOCKET=

# Absolute path to protected inference deal and lap terms JSON. inference-market mode.
LAYERX_AGENT_INFERENCE_DEALS=

# Draft runtime kind as an unsigned byte. inference-market mode.
# Source default: Absent.
# LAYERX_AGENT_INFERENCE_DRAFT_RUNTIME_KIND=

# Path to the signed host enrolment document; enables host enrolment. inference-market mode.
# Source default: Host enrolment disabled.
# LAYERX_AGENT_INFERENCE_ENROLMENT=

# Path to the persistent enrolment operation journal. required when host enrolment is enabled.
LAYERX_AGENT_INFERENCE_ENROLMENT_JOURNAL=

# Independent hosted AI gateway credential. inference-market mode.
LAYERX_AGENT_INFERENCE_GATEWAY_API_KEY=

# Path to PEM or DER gateway trust roots. inference-market mode.
LAYERX_AGENT_INFERENCE_GATEWAY_CA_FILE=

# Canonical HTTPS endpoint for the hosted AI projection. inference-market mode.
LAYERX_AGENT_INFERENCE_GATEWAY_ENDPOINT=

# Nonzero model digest. inference-market mode.
LAYERX_AGENT_INFERENCE_MODEL_DIGEST=

# Two-byte region code. required when host enrolment is enabled.
LAYERX_AGENT_INFERENCE_REGION=

# Path to the JSON room offer. inference-market mode.
LAYERX_AGENT_INFERENCE_ROOM_PROFILE=

# Nonzero runtime digest. inference-market mode.
LAYERX_AGENT_INFERENCE_RUNTIME_DIGEST=

# Inference completion listener. inference-market mode.
# Source default: IPv4 loopback, TCP port 8791.
# LAYERX_AGENT_INFERENCE_SERVE_LISTEN=

# Inference signal listener. inference-market mode.
# Source default: IPv4 loopback, TCP port 8790.
# LAYERX_AGENT_INFERENCE_SIGNAL_LISTEN=

# Comma-separated activity type numbers. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_ACTIVITY_TYPES=

# Agent DID. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_AGENT_DID=

# Absolute path to the audit directory. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_AUDIT_ROOT=

# Absolute path to the MCP binding directory; enables MCP enrolment. full and inference-market modes.
# Source default: MCP enrolment disabled.
# LAYERX_AGENT_MCP_BINDING_ROOT=

# Capability digest. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_CAPABILITY_ID=

# Current committed core height. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_CORE_HEIGHT=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_MCP_CORE_SEQUENCE=

# MCP operation deadline in milliseconds. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_DEADLINE_MS=

# Session expiry height. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_EXPIRY_HEIGHT=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_MCP_EXPIRY_SEQUENCE=

# MCP budget ceiling. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LIMIT_CEILING=

# MCP consumed budget. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LIMIT_CONSUMED=

# 16-byte hexadecimal MCP budget identifier. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LIMIT_ID=

# MCP budget name. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LIMIT_NAME=

# MCP budget scope. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LIMIT_SCOPE=

# 32-byte hexadecimal MCP scope identifier. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LIMIT_SCOPE_ID=

# Comma-separated permitted MCP peer user IDs. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LISTENER_ADMITTED_UIDS=

# MCP Unix socket permissions in octal. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LISTENER_MODE=

# MCP socket owner group ID. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LISTENER_OWNER_GID=

# MCP socket owner user ID. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LISTENER_OWNER_UID=

# Absolute path to the MCP Unix socket. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_LISTENER_SOCKET=

# Binding mode: full or read-only. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_MODE=

# Client label recorded at session creation. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_OPENING_CLIENT=

# Configured Human peer user ID. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_PEER_UID=

# Policy version associated with the binding. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_POLICY_VERSION=

# Comma-separated distinct nonempty scope names. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_SCOPES=

# Session digest. required when LAYERX_AGENT_MCP_BINDING_ROOT enables MCP enrolment in full or inference-market mode.
LAYERX_AGENT_MCP_SESSION_ID=

# Amount above which web payments require approval. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_APPROVAL_THRESHOLD=

# Enables the MCP web sidecar and selects its endpoint. MCP enrolment.
# Source default: No web sidecar.
# LAYERX_AGENT_MCP_WEB_ENDPOINT=

# Web payment network identifier. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_NETWORK=

# EVM payer identity. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_PAYER_ADDRESS=

# Maximum pending-payment attempts. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_PENDING_ATTEMPTS=

# Index of the receipt authority fetched from the node. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_RECEIPT_KEY_INDEX=

# EVM receiver identity. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_RECEIVER_ADDRESS=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_MCP_WEB_SEQUENCER_PUBLIC_KEY=

# Web payment timeout in milliseconds. required when the MCP web sidecar is enabled.
LAYERX_AGENT_MCP_WEB_TIMEOUT_MS=

# Selects full, human-owner or inference-market.
# Source default: full.
# LAYERX_AGENT_MODE=full

# Node bearer credential, distinct from the program credential. full and inference-market modes.
LAYERX_AGENT_NODE_BEARER_TOKEN=

# Expected node chain identity, decimal or hexadecimal. all daemon modes.
LAYERX_AGENT_NODE_CHAIN_ID=

# Consensus RPC URL for committed native receipts, state exports and policy history. required by those operations.
LAYERX_AGENT_NODE_COMET_RPC_URL=

# Consensus endpoint for validator evidence used by exports. full and inference-market modes.
LAYERX_AGENT_NODE_CONSENSUS_ENDPOINT=

# Node JSON-RPC root endpoint. full and inference-market modes.
LAYERX_AGENT_NODE_ENDPOINT=

# Direct node JSON-RPC root URL. all daemon modes.
LAYERX_AGENT_NODE_RPC_URL=

# Program HTTP bearer credential; also authenticates human-owner health. all daemon modes.
LAYERX_AGENT_PROGRAM_BEARER_TOKEN=

# Program HTTP listener on IPv4 loopback. all daemon modes.
LAYERX_AGENT_PROGRAM_LISTEN=

# Positive maximum age of program evidence in milliseconds. full and inference-market modes.
LAYERX_AGENT_PROGRAM_MAX_STALENESS_MS=

# Probe program identifier. full and inference-market modes.
LAYERX_AGENT_PROGRAM_PROBE_ID=

# Absolute path to protected registry-source JSON configuration.
# Source default: Registry-source enrichment disabled.
# LAYERX_AGENT_REGISTRY_SOURCE_CONFIG=

# Presence is rejected at startup. leave unset.
# Source default: Unset.
# LAYERX_AGENT_SEQUENCER_TRUST_HISTORY=

# Absolute path to protected JSON account-slot selections.
# Source default: No configured state-export selections.
# LAYERX_AGENT_STATE_EXPORT_SOURCE=

# Expected EVM chain identity; mainnet-beta uses chain ID 125. full and inference-market modes or the startup-config API.
LAYERX_EXPECTED_CHAIN_ID=

# Rejected by the startup-config API. leave unset.
# Source default: Unset.
# LAYERX_EXPECTED_PROTOCOL_VERSION=

# Comma-separated tenant:absolute-path native-effect policy mappings.
# Source default: Empty map.
# LAYERX_NATIVE_EFFECT_POLICY_SOURCES=

# Comma-separated tenant:absolute-path mappings covering every Human tenant. all daemon modes.
LAYERX_NATIVE_POLICY_SOURCES=

# Startup network identity. startup-config API; overrides the matching file key.
LAYERX_NETWORK_ID=

# Node JSON-RPC root endpoint. startup-config API; overrides the matching file key.
LAYERX_NODE_ENDPOINT=

# Network label in agent RPC responses. required when agent RPC is enabled.
LAYERX_NODE_NETWORK_NAME=

# Comma-separated tenant:absolute-path policy mappings. full and inference-market modes or the startup-config API.
LAYERX_POLICY_SOURCES=

# Comma-separated tenant:absolute-path budget denomination mappings.
# Source default: Empty map.
# LAYERX_PROGRAM_BUDGET_DENOMINATION_SOURCES=

# Receipt-key source: px_getReceiptKeys or an absolute pinned-file path. startup-config API; overrides the matching file key.
LAYERX_RECEIPT_KEY_SOURCE=

# Expected clock supervisor process ID. daemon and wallet RPC runtime clock.
LAYERX_RUNTIME_CLOCK_PID=

# Absolute path to the private runtime-clock Unix socket. daemon and wallet RPC runtime clock.
LAYERX_RUNTIME_CLOCK_SOCKET=

# Expected clock supervisor user ID. daemon and wallet RPC runtime clock.
LAYERX_RUNTIME_CLOCK_UID=

# Rejected by the startup-config API. leave unset.
# Source default: Unset.
# LAYERX_SEQUENCER_AUTHORITY_SOURCE=

# Complete tenant:absolute-path signer configuration mappings. startup-config API; overrides the matching file key.
LAYERX_SIGNER_CONFIGURATIONS=

# Comma-separated distinct tenant identifiers. startup-config API; overrides the matching file key.
LAYERX_TENANTS=

# Complete tenant:verification-level mappings; committed selects committed evidence. startup-config API; overrides the matching file key.
LAYERX_VERIFICATION_DEFAULTS=

# Generated-source output directory supplied by Cargo. build metadata; supplied by Cargo.
# OUT_DIR=
