[finding.support-kernel-authorizations]
proving_tests = ["support_kernel_authorizations_cross_transport_receipt_consumer_and_reopen"]
repair = "Shared send fixtures compare ledger_payment_call with daemon prepare_bound, bind disclosure, sign real type-2 transactions, transport exact bytes through NodeRpc, authenticate signed receipts and reopen real outbox/finality stores. Budget fixtures call production BudgetRequest::create_protocol_budget directly, without protocol-3 envelope preparation; existing negative assertions are retained."

[finding.send-authorization-retired-shape]
proving_tests = ["send_authorization_restored_preparation_refuses_every_changed_binding"]
repair = "Remove fixed-offset trailer patching and manually constructed signature digests. Shared fixtures use typed SendDebit::sign and ledger_payment_call; out-of-scope callers retain a strict field-decoding adapter that delegates to the same producer. Restore exact SigningPreparation from the production store and reject modified call, nonce, chain, fees, gas, disclosure, idempotency, actor and foreign signature."

[finding.readiness-real-path-test-gap]
proving_tests = ["readiness_node_transcript_receipts_and_authority_survive_consumer_restart", "readiness_wrong_chain_uncovered_and_rotated_trust_refuse_node_transcript", "node_produced_uncovered_and_unpinned_receipts_fail_after_transport", "focused_authority_decoder_retains_restart_coverage"]
repair = "Retain focused decoder coverage with canonical current receipt-key response fields and no external chain-id variable. Replay Go node-produced ledger success/revert and signed out-of-range/unpinned receipts, preserving the producer's numeric key intervals and signed bytes through HTTP into NodeRpc, Gate and finality consumers. Stop the fixture server and production consumers, reopen Store and Gate, and require fresh readiness. Independent narrower or rotated policy and wrong chain refuse readiness without replacing node replies with constructed evidence. Live node-storage rotation/reopen is explicitly assigned to its owner above."

[gotcha.readiness_shape]
