policy = "COMMITTED is the current committed verification level, emitted as wire rank 6. Persisted and received legacy ranks 4 and 5 and the two legacy names normalize to COMMITTED. No deprecated current-level constant remains in daemon production code; events/ingest.rs retains its separate legacy type."

[sites.production]
receipt = "src/receipt.rs: persist_authenticated_receipt labels committed-rung receipts COMMITTED; encode_metadata retains wire_rank; decode_metadata maps 4, 5 and 6 to COMMITTED."
human_runtime = "src/human_runtime.rs: native_purpose_owner, validate_owner, subject_bound_address, subject_owner and read_bound_address enforce COMMITTED; augment_receipt_evidence raises COMMITTED; production_rung_floor returns COMMITTED; rank accepts 4/5/6; verification_level accepts committed and the two legacy spellings; verification_code writes wire_rank; receipt_rung_code writes committed as 6."
subject = "src/human_runtime/subject.rs: the subject-context label decoder accepts committed and both legacy spellings so a current identity producer can authenticate its subject."
managed = "src/managed_agent.rs: evidence_export reports COMMITTED."
reads = "src/read/committed.rs: CommittedCaps::level and CommittedCall::level report COMMITTED."
frame = "src/human_receipt_frame.rs: owner frame documentation names 6 COMMITTED; decoder maps 4/5/6 to COMMITTED; writer retains wire_rank."
config = "src/config.rs: parse_verification_defaults accepts committed, checkpoint-finalised and settlement-anchored as COMMITTED."
mcp = "src/session_control/mcp_record.rs: McpInvocationRecord::decode (used by src/session_control.rs) normalizes legacy ranks before validation, accepts current ranks through from_wire_rank, requires STATE_PROVEN just like mcp_reconcile_effect, and preserves Corrupt on refusal."
routing = "src/agent_rpc_dispatch.rs: rung retains 0/1/2 and accepts legacy verification ranks 4/5 plus committed rank 6 as the committed rung."
pay2 = "services/agent/qualification/pay2/sequence.rs: committed evidence reports COMMITTED."

[sites.tests]
