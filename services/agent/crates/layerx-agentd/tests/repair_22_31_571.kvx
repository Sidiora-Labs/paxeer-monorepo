[repair]
task = "22.31.571"
requirement = "22998.1"
gotcha = "3260"
decision = "2677"
base = "164a6ba7b9be73debd346e94d00dba5d612e4fcb"

[implementation]
track = "TRACK first preserves the principal's existing submission lookup, then resolves a tenant-scoped linked release, then checks the tenant's durable release against ApprovalSubmissionQueue::prepared. An unlinked release returns a Queued observation with its reference and canonical disclosure digest without reading the node."
submit = "The common verified external submission path used by rpc_submit_external and all three native carriers journals approval_release_ref to the exact EVM submission hash and submitting principal before dispatch. Existing releases retain their original hold and reservations in the versioned linked record; native releases retain their carrier and signing-preparation bindings."
recovery = "ProductionHumanOperations::new restores each link, validates the indexed principal and the retained signed transaction's unsigned bytes, and refuses conflicts or missing targets. Outbox recovery validates the same released records instead of treating them as ordinary submissions. Approval replay unwraps linked holds and validates native carrier links without replaying them as ordinary holds."
receipt = "Release TRACK runs the existing sequencer receipt signature and transaction-hash verification and returns the verified receipt frame in the Human observation. The principal's own submission-id answer stays unchanged. track_with_settlement resolves absent submission references through the same release path."
human_service = "No Human service file changes."

[proof]
path = "tests/repair_22_31_571.rs"
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
transport = "PREPARE, APPROVAL_APPROVE, SUBMIT and TRACK traverse AcceptedTransport over UnixStream and the production serve_one dispatcher into UnifiedAgentOwner; real typed preparation, signature verification, approval reservation, Store and restart paths execute."

[case.queued]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "After a granted approval, TRACK returns Queued, the release reference as submission id, the exact nonzero SHA256 digest of released unsigned bytes as activity id, no receipt, and no additional node request."

[case.linked]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "A valid SUBMIT with approval_release_ref broadcasts the verified signed EVM bytes once; another principal in the same tenant tracks the release and receives the submission's exact status, while direct TRACK of that principal's submission id remains Refused."

[case.unknown]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "An unknown release reference returns operation.refused without a node read."

[case.other_tenant]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "Another tenant cannot track the release before SUBMIT or after its verified receipt."

[case.status_restart]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "Drop the owner and durable store, reopen Store and reconstruct the production runtime; direct TRACK as the submitting principal and linked TRACK as the human observer both answer Unknown for the submission without a receipt, with identical submission-status bytes, unchanged header and submission identity, no receipt, and identical release journal bytes."

[case.invalid_receipt]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "A corrupted sequencer signature is refused before returning receipt material."

[case.verified_receipt]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "Once the sequencer serves the signed receipt, release TRACK returns Executed and the same tracked bytes as submission-id TRACK, plus the exact canonical receipt, submission hash, sequencer public key and Receipted rung; VerifiedReceipt verifies the returned bytes again."

[case.receipt_restart]
test = "approval_release_tracks_from_grant_through_submission_receipt_and_restart"
assertion = "After a second full owner/store restart, the complete verified receipt observation is unchanged."

[evidence]
policy = "Finalize before qualification; results are referenced rather than transcribed after the candidate is built."
ledger = "/out/run/gates.jsonl"
verified_revision = "/out/run/gates.jsonl: final passing verify row revision, equal to the preceding passing build row revision"
build = "hf-build: cargo build --locked --manifest-path services/agent/crates/layerx-agentd/Cargo.toml --tests"
dependents = "hf-done: /out/run/gates.jsonl final dependents row records the dependent-crate check, its candidate revision, exit and private log"
verify = "hf-done: cg spec done 22.31.571 -f layerx-merge --root /work/paxeer-monorepo; cargo test --locked --manifest-path services/agent/crates/layerx-agentd/Cargo.toml --test repair_22_31_571, plus graph checks"
results = "/out/run/gates.jsonl: exact revision, command, exit and private log for each bounded build/verify row; no pass claimed before execution"

