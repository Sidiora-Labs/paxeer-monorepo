log = "/out/run/sdk-compatibility-build.log"
observed = "The required compatibility compile fails with no test target named repair_22_31_547 in layerx-sdk; that file is absent from the supplied base. This unrelated missing target is recorded without expanding scope or rerunning it."
preserved = "Fixture, must, read_bytes, FIXTURE_LOCK and the preview request shape are unchanged for the include described by decision 2620."

[qualification]
