[repair.22.31.543]
acceptance = "22998.1"
gotchas = [3142, 3150, 3152, 3155, 3158, 3162, 3167]
decisions = [2607, 2609, 2611, 2614, 2618, 2620]
change = "Assert the complete reason-bearing refusal frames in the retired-rung and native preview daemon tests; preserve every existing test and assertion, including the retired source-name checks. Nothing under src changes."

[tests.retired_rung]
target = "human_peer_retired"
name = "export_above_committed_is_rung_unattainable"
producer = "src/human.rs::encode_response receives HumanOperationError::Typed(HumanRefusal::ExportLevelUnattainable)."
reason = "export.rung_unattainable"
criterion = "Build the expected LXHAGT01 magic, status byte 1 and big-endian u32 length-prefixed refusal.reason() with a field helper, then compare the complete encoded response."

[tests.native_preview]
target = "native_send_preview_evm"
name = "native_send_preview_is_an_unsigned_ledger_transfer_call"
producer = "post_preview(5, [12; 32]) traverses serve_one and native_send_preview_v1 to src/human_runtime.rs::native_send_preview. The capability purpose_commitments check rejects the unmatched commitment through SessionControlError::Human(HumanOperationError::Refused); src/human.rs::encode_response maps this untyped refusal to operation.refused."
reason = "operation.refused"
criterion = "Compare the entire response from the real Unix transport with LXHAGT01, status byte 1 and the big-endian u32 length-prefixed reason built by the same field helper pattern."
landed = "22.31.545 landed this complete refusal-frame assertion under decision 2618; preserve its field helper and V2 decode and field assertions. Only the expected frame variable is renamed for clarity."

[closure.owner_preview]
task = "22.31.545"
observed = "22.31.545 replaced the NativeSendPurposeV1 constructed by src/human_runtime.rs::native_send_owner_preview_on_surface with NativeSendPurposeV2, removing the unconditional ContractError::Mismatch(native_send.legacy_version) refusal from the legacy V1 validation guard."
preserved = "Keep the landed V2 decode, chain_id, transaction_type, evm_sender and consent_public_key assertions alongside both full refusal frames; nothing under src changes."

[compatibility.sdk_include]
