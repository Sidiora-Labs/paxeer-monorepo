[repair.22.31.538]
acceptance = "22998.1"
gotchas = [3141, 3142, 3143]
decisions = [2593, 2600, 2601]
baseline = "Continue attempt 1: retain the two authority budget guards and their three tests; restore the persisted MCP decoder and its test to the task base per decision 2601."
decision_2600 = "Decode current verification wire ranks with VerificationLevel::from_wire_rank and require COMMITTED; refuse retired and unknown labels."
decision_2601 = "The persisted MCP invocation decoder belongs to 22.31.539, which coordinates current COMMITTED receipts with legacy ranks 4 and 5; this task changes only the two hosted-authority budget guards."

[sites]
approval_budget_after = "src/human_runtime.rs: replace the literal 4..=5 guard with the private committed_budget_rank helper; every other guard condition is preserved."
program_presentation = "src/budget/program_sources.rs: compare proof.verification() with VerificationLevel::COMMITTED; preserve ProgramSourceError::Snapshot."
additional_consumer = "src/session_control.rs: McpInvocationRecord::decode checks verification_rank < 3 or > 5. Handed to 22.31.539: its writer takes receipt.metadata.verification_level.wire_rank(), and receipt.rs currently labels committed receipts CHECKPOINT_FINALISED (rank 4). Restored the decoder and removed only the attempt-1 test of the reverted change, as directed."

[search]
root = "services/agent/crates"
method = "Search Rust sources for literal ranges, verification and wire_rank comparisons, then inspect production consumers separately from test assertions and wire codecs."
result = "The two named sites and the persisted MCP receipt range were the only production literal verification rank comparisons found. The third site is unchanged and handed to 22.31.539 per decision 2601; rank encoders/decoders and historical codecs are separate from policy comparisons."
excluded = "The four assertions owned by 22.31.516 in tests/human_approval_budget_actor.rs and tests/human_projection_facts.rs are untouched."

[tests]
approval = "repair_22_31_538_approval_budget_accepts_committed_rank and repair_22_31_538_approval_budget_refuses_other_ranks accept COMMITTED.wire_rank() and refuse 0, 1, 2, 3, 4, 5, 7 and u8::MAX."
program = "repair_22_31_538_program_presentation_binds_committed_proof_and_sequence verifies the recorded authority export through verify_budget_proof against its signed checkpoint and recorded node answers, then asserts binding Ok(()) at the proof sequence and Snapshot for a later allocation sequence."
reservation = "The cfg(test) presentation_budget_reservation helper constructs a principal charge naming the verified proof asset and source, resolves its allocation rows with budget_allocations, creates BudgetLimiter with LimitConfig, binds ProgramLimitDenomination, stages ProgramReservationRequest with stage_program_allocation, publishes it, then round-trips ProgramBudgetReservation::encode/decode. The future reservation uses the same constructors with sequence + 1."
dependencies = "No credential, environment variable, external process or live endpoint; recorded node answers are replayed over an in-process loopback listener (gotcha 2962)."

[qualification]
ledger = "/out/run/gates.jsonl"
revision = "Read the exact verified revision from the final verify row in the private ledger; it must match the preceding successful build row and the candidate."
build_command = "cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd --lib"
verify_command = "cg spec done 22.31.538 -f layerx-merge --root /work/paxeer-monorepo"
verify_test_command = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd --lib -- repair_22_31_538"
build_log = "/out/logs/build-1.log"
verify_log = "/out/logs/verify-1.log"
results = "Gate results are recorded by reference: /out/run/gates.jsonl rows of kind build and verify contain the exact revision, command, exit and private log path. The first runs use the log paths above; repair runs, if needed, use the paths in their ledger rows. No passing result is asserted before execution."

[qualification.disposition]
previous_attempt = "Attempt 1 was implemented-not-qualified: its repair record was amended after its passing gates, so the final candidate differed from the verified revision (gotcha 3142)."
changes_after_gates = "No source or record edits after the final build and verify; this record refers to the gate ledger so it is already part of the candidate being qualified."
drift = "Preserve inherited runner bookkeeping in .cgignore and spec/layerx-merge/spec.kvx without edits; those paths are outside task scope."
publication = "No manual commit or push; publication is owned by the runner."
