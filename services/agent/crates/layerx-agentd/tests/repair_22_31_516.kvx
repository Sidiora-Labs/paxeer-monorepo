[repair.22.31.516]
acceptance = "22998.1"
base_revision = "f1d852f7ed429bc2dbdc025fc685e6a0f006bdd8"
gotcha = "3075"
decision = "2564"
exports = "budget_state::{Configuration, Session, identity_key, read, read_dynamic, export, export_at, export_dynamic}; BudgetStateConfig; human_policy::{PrincipalPolicy, Identity, EvidenceReference, Authority, ScopeBinding, KeyPolicy}; Response; committed::CommittedHeader and its shared native proof verification"
implementation = "The binary and daemon fixtures consume the same library budget producer, policy types, response helpers and committed-header verifier; the existing record/native submodules remain the single implementations."
removed = "Both authority_producer path-included crate stand-ins, including Config, Identity, PrincipalPolicy, Response, digest, json, refusal and unavailable."
compatibility = "Production checks, wire bytes, bounds and assertions are preserved. The two recovery reads supply the current trusted runtime-clock sample required by ApprovalService::get. Existing fixture-recording tests retain their original ignored recording-only status."

[verification]
build = "cargo build --locked --manifest-path services/platform/hosted/authority/Cargo.toml && cargo build --locked --manifest-path services/agent/crates/layerx-agentd/Cargo.toml --tests"
command = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd --test human_approval_budget_actor --test human_projection_facts"
revision = "The exact candidate revision in the private hf-build/hf-done ledger /out/run/gates.jsonl; both gates must identify the same revision."
evidence = "The final hf-done ledger row records revision, command, exit code and private log location. No passing result is claimed unless that gate exits zero."

[run.human_approval_budget_actor]
target = "human_approval_budget_actor"
criterion = "The authenticated approval actor preserves its budget facts and refuses invalid requests after durable recovery."
evidence = "The human_approval_budget_actor result in the focused hf-done verification log."

[run.human_projection_facts]
target = "human_projection_facts"
criterion = "Authenticated approval and managed exports preserve facts, refusals and reopen behavior."
evidence = "The human_projection_facts result in the same focused hf-done verification log."

[gotcha.dependency-index]
observed = "The sandbox starts without a populated Cargo index, so offline dependency resolution refused packages already named by the workspaces."
resolution = "Resolve the changed dependency graph through the normal Cargo index before the locked gates; no build or test was run during implementation."

