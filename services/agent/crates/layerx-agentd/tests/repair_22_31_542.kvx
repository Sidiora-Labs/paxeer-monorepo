cases = ["purpose_label_is_optional_and_outside_the_canonical_body", "unknown_budget_create_field_is_refused", "absent_purpose_label_keeps_the_unlabelled_digests", "present_purpose_label_is_bound_with_tag_length_and_text", "different_purpose_labels_give_different_digests", "same_purpose_label_gives_equal_digests", "replay_with_a_different_purpose_label_misses_the_cached_success", "native_activity_wire_preserves_modules_and_refuses_noncanonical_values", "native_purpose_wire_binds_every_coordinate_and_explicit_commitment", "signed_native_purpose_wire_preserves_structural_signature_bytes", "signed_native_purpose_wire_refuses_key_and_signature_encoding_errors", "signed_native_purpose_wire_refuses_unknown_missing_and_nonstring_fields", "native_prepare_wire_preserves_native_module_in_real_human_request", "native_prepare_wire_refuses_bounds_mismatches_and_noncanonical_values", "native_approval_requests_preserve_all_fields_and_refuse_bad_discriminants", "native_results_round_trip_typed_values_and_exact_owner_states", "native_prepare_result_refuses_version_hex_bounds_and_approval_inconsistency", "native_approval_result_refuses_unknown_state_bad_refs_and_oversized_list", "native_local_grant_wire_refuses_expiry_encoding_and_record_bounds", "native_purpose_wire_refuses_unknown_missing_and_malformed_fields", "proof_bundle_wire_keeps_native_selector_bytes_and_refuses_aliases", "native_send_wire_preserves_exact_signed_request_and_distinct_digest", "native_send_wire_refuses_unknown_fields_noncanonical_values_and_profile_aliases"]
criterion = "All wire cases remain under their existing cfg(test) modules or test functions. The public RPC exchange is also compared to the doc-hidden library wire export in the integration version exchange case."

[include.rpc_tls]
