[remaining_interface_constraints]
history = "authenticated_native_policy_usage requires independently trusted complete committed history through policy_history::read_policy_history_from_sources, including native Comet results and successor commits; missing node methods remain visible failures and are never replaced with unproven empty history."
carrier = "The existing interface_constraints.legacy_carriers finding remains: NativeEffectApprovalCarrier::bind and its validation require the envelope digest as reservation.id; these out-of-scope checks are preserved."

[attempt_7_refusal_trace]
basis = "Gotcha 3271: instrument the attempt-6 production tree before changing the fixture."
command = "cargo test --locked --manifest-path services/agent/crates/layerx-agentd/Cargo.toml --test repair_22_31_560 native_send_first_prepare_and_reopened_prepare_match_owner_preview -- --exact --nocapture"
exit = 101
log = "/out/logs/attempt-7-refusal-trace.log"
site = "rpc_prepare_native_send first with_native_preparation, human_runtime.rs:7191: Session(ScopeDenied), before either verify_native_owner_send_purpose or inspect_native_send_capability enters its closure; committed_prepared_caps and fee checks passed."
input = "session::authenticated_native_scope (session.rs:1368-1370) reads the absent native_scope_key for the credential tenant and session. Fixture::new opens an ordinary prepare session; native_send_owner_preview_on_surface stages and validates the signed local grant but never publishes its updates. prepare_rpc previously sent local_grant null, leaving the required native session scope absent. No committed read, policy row, history item or trust pin caused this refusal."
repair = "prepare_rpc now serializes the exact NativeLocalGrantConsentV1 used by owner preview, including the capability, session_scope, expiry, owner key and signature. The first and reopened Prepare use that same signed grant and purpose, retaining equal request bodies apart from outer RPC fields. The wrong-identifier case also carries the authentic grant and retains its mandatory owner.refused assertion. The daemon installs the grant through rpc_prepare_native_send's existing with_native_owner_install and stage_native_local_grant path; no store record is injected by the test."
production = "Every temporary TRACE560 diagnostic was removed by restoring the byte-exact attempt-6 human_runtime.rs before qualification. No production code changes are added in attempt 7."
environment = "Install the real @foundry-rs/anvil 1.7.1 binary outside the repository and link its native executable onto PATH; the unchanged fixture starts and reaps the real loopback node."
evidence = "Resolve the final candidate revision, commands, exits and private logs from the matching build, dependents and verify entries in qualification.ledger (/out/run/gates.jsonl). This record precedes those gates and claims no unrun outcome."

[attempt_7_history_gate_repair]
revision = "2d8815bdef016cb797295ffd268b02de03c76393"
command = "cg spec done 22.31.560 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Build and all 15 dependent-crate checks pass; two cases pass. The genuine first Prepare now passes native session admission, reaches authenticated_native_policy_usage and refuses because px_getHistory is forwarded to Anvil and returns -32601 Method not found."
repair = "The peer serves the history page plus complete native block_results and Comet commit responses for the covered ten-second window. native_send_history_commits uses the recorded checkpoint's test validator seed (the same [1;32] as support/record_human_budget_checkpoint.py), app hash, chain and head timestamp. It produces linked signed headers at 63, 64 and 65 with the production CheckpointHeader::block_hash and BlockCommit::vote_sign_bytes encoders; read::checkpoint and layerx_client::rpc::commit::verify_commit_material both verify every signature and hash before serving. The recorded checkpoint's original predecessor and result roots had no captured evidence, so the head is re-signed to bind these actual fixture result sets and their predecessor; no check of the recorded checkpoint is weakened."
absence = "Before producing the empty native result ranges at 63 and 64, the fixture reads the corresponding blocks from real Anvil and asserts their transactions arrays are empty. Each successor header commits to the production empty-result Merkle root. The consumer authenticates the entire range and predecessor links; an empty index response alone is never accepted as history proof."
proof = "assert_native_send_policy_history drives read_policy_history_from_sources and time_window with the exact owner, receipt-key trust, validator trust, head 64 and ten-second rate window used by Prepare. It requires first covered height 63, last 64 and zero authenticated activity and success counts before the unchanged first Prepare 200 assertion."
production = "No production files change in this repair. The prior native-effect carrier envelope-digest interface constraint remains preserved as recorded in interface_constraints and remaining_interface_constraints; no assertion, bound, signature check, scope or approval check is relaxed."
evidence = "The last matching build, dependents and verify entries in /out/run/gates.jsonl identify the final candidate revision, commands, exits and private logs. This record precedes the repair gates and claims no outcome before execution."

[attempt_8_refusal_site]
basis = "Gotcha 3278, decision 2688: retain the attempt-7 implementation and assertions; report every explicit native send Prepare refusal through one production diagnostic helper."
implementation = "rpc_prepare_native_send::refused prints layerx-agentd: native send prepare refused at <site> and returns the same HumanOperationError::Refused. Every explicit Refused mapping and former local refused closure call names its own static site; optional lookup diagnostics are evaluated only on absence. The external rejection remains owner.refused."
command = "cargo test --locked --manifest-path services/agent/crates/layerx-agentd/Cargo.toml --test repair_22_31_560 native_send_first_prepare_and_reopened_prepare_match_owner_preview -- --exact --nocapture"
exit = 101
log = "/out/logs/attempt-8-refusal-trace.log"
site = "layerx-agentd: native send prepare refused at budget source read; the genuine first Prepare answers 403 owner.refused instead of the mandatory 200 after committed inventory and authenticated history succeed."
condition = "budget/program_sources.rs::read_native_effect_budget_sources rejects caps.level() < VerificationLevel::STATE_PROVEN as ProgramSourceError::Snapshot before resolving charges. read/committed.rs::CommittedCaps::level unconditionally returns VerificationLevel::CHECKPOINT_FINALISED. layerx-types/src/verify.rs::VerificationLevel::cmp orders that retired level below STATE_PROVEN, independently of the signed checkpoint, state root, inventory, history or any other fixture input."
disposition = "The fixture cannot honestly satisfy this production condition: changing node responses cannot change CommittedCaps::level. Both production definitions are outside the six allowed paths. Per do_10, stop fixture repair here and preserve every assertion and check; do not substitute a level, bypass budget source admission or fabricate a capability witness. The existing carrier identifier constraint remains recorded separately, without claiming this run reached it."
evidence = "Final hf-build and hf-done results are referenced by their last build and verify entries in qualification.ledger, /out/run/gates.jsonl, for exact candidate revision, command, exit and private log. This record precedes the final gates, claims no passing outcome and must not be amended afterward."

[attempt_9_committed_level]
basis = "Gotcha 3285, decision 2694: preserve the attempt-8 identifier alignment, refusal helper, fixture and every assertion."
implementation = "Both CommittedCaps::level definitions in read/committed.rs return VerificationLevel::COMMITTED; no other code in that file changes. The authenticated committed snapshot can therefore satisfy the existing STATE_PROVEN floor in budget/program_sources.rs without weakening that check."
diagnostic = "Run hf-done with RUST_TEST_NOCAPTURE=1 so its declared repair_22_31_560 test command executes the first-Prepare case and prints any further refusing site in the private verify log. No separate cargo test invocation precedes the permitted verify gate."
environment = "Install the real @foundry-rs/anvil 1.7.1 binary outside the repository for the existing loopback EVM fixture; no credential or remote endpoint is required."
evidence = "The final matching build, dependents and verify entries in /out/run/gates.jsonl identify the exact candidate revision, command, exit and private log. hf-done runs the dependent-crate check and declared verify command with graph checks; qualification requires every entry to pass at the same candidate. This record precedes the gates and asserts no outcome."

