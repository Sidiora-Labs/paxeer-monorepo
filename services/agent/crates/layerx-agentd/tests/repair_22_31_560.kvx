repair = "The outer Prepare peer adds the committed getEvmAddrByLayerX read at exactly HEAD using the same verified SignedBinding as the preview peer, requiring the exact selector and owner public key. The original peer's pending-tag assertion remains unchanged. Committed proof requests and every upstream refusal are logged; no witness, proof or approval carrier is fabricated. The final matching build and verify results remain referenced through qualification.ledger."

[committed_inventory_peer]
basis = "Attempt 6, gotcha 3261: the first Prepare must read the complete committed identity and asset inventory at HEAD."
implementation = "committed_native_send_calls binds getEvmAddrByLayerX, getUnifiedAccount and getLayerXDid to the fixture's verified SignedBinding, owner DID and main account, using the exact ABI words and dynamic DID layout consumed by read/committed.rs::inventory. The ledger serves getAsset metadata for upax, accountId, accountOwner, balanceOf and nextSequence for the same owner, fee asset and source sequence."
budget = "The peer also serves getBudget, budgetRemaining and the budget account balance using the production ProtocolBudgetRecord and ProtocolBudgetState codecs with tests/vectors/native-budget-records.json, the same record as human_approval_budget_actor.rs. Its owner and asset are bound to this fixture; the other values are retained. support/human_budget_checkpoint.json supplies the signed checkpoint and validators, and contains no budget call values."
dispatch = "Answers require the pinned HEAD, destination and full calldata. A known destination and selector with different arguments panics; every other request is forwarded to the configured loopback node, and any upstream refusal prints the exact request and response. Pending binding, fee denomination, gas and nonce reads retain the existing real Anvil path."
scope = "Only the test peer, test runtime configuration, shared fixture environment cleanup and this task record are amended in attempt 6; the attempt-5 production tree and every test assertion remain intact."
environment = "The fresh sandbox lacks anvil on PATH; the real @foundry-rs/anvil 1.7.1 binary is installed outside the repository and linked onto PATH for the unchanged loopback node fixture. No credential or live endpoint is required."
evidence = "qualification.ledger references the final hf-build and hf-done records for the exact candidate revision, command, exit code and private evidence path; a successful qualification requires matching build and verify revisions. This record precedes the gates and asserts no unrun outcome."

[attempt_6_first_gate]
revision = "5270978d2a7c16f386d28c6ec2254d48e69a705d"
command = "cg spec done 22.31.560 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
