[meta]
task = "22.31.560"
requirement = "22998.1"
basis = "Gotcha 3192 and decision 2634."

[identifier]
definition = "prepare/expiry.rs::DurablePreparation::native_identifier computes SHA-256 of Eip1559Call::encode_unsigned; DurablePreparation::store_key retains its existing tenant, Configuration kind and prepare/record/<32 bytes> shape."
producer = "human_runtime.rs::native_send_preview and native_send_owner_preview_on_surface publish that identifier as purpose.preparation_id and canonical_digest."
cache = "human_runtime.rs::prepare_gated keys the prepared entry and SigningPreparation::retain by the same identifier; rpc_prepare_native, rpc_prepare_native_effect and rpc_prepare_native_send already select that cache key and DurablePreparation::store_key using the signed purpose identifier."
restore = "restore_native_cache and restore_native_effect_cache refuse a retained signing transaction whose unsigned call digest differs from the requested identifier before populating the cache."
submit = "submit_external_with_origin uses the submitted preparation_ref for both durable lookups instead of recomputing the authorization-envelope digest."
response = "rpc_prepare_native_send returns the unsigned call and its signing hash, matching the owner preview."
binding = "capability/binding.rs::verify_native_owner_send_purpose and inspect_native_send_capability use the shared call identifier. verify_native_owner_purpose restores the retained signing inputs at that identifier, checks their exact relationship to the authorization envelope and binds the V1 purpose to the call digest. NativePreparationBindingV1 separately retains the verified envelope digest for subsequent authorization checks."
tenant = "prepare_gated takes the storage tenant from the authenticated gate principal; its cache key, SigningPreparation::retain and authorization-reference key use that tenant. Native RPC cache selection and restore use the same principal tenant. verify_native_owner_purpose restores with the verified owner tenant, which native_purpose_owner derives from that principal and verifies against the session tenant. The transport tenant remains the authority and policy lookup tenant."
diagnostics = "prepare_gated reports the originating signing retention and authorization-reference put_local errors; verify_native_owner_purpose reports the SigningPreparation::restore error before mapping it to BindingError::Corrupt; BindingError::owner_error reports the binding error when mapping to Unavailable."

[envelope_consumer]
name = "human_runtime.rs::rpc_native_disclosure consumes the envelope bytes returned beside preparation_id by rpc_prepare_native and rpc_prepare_native_effect, deriving their envelope digest."
reference = "prepare_gated retains a prepare/authorization-reference/<envelope digest> index to the single call preparation identifier; rpc_native_disclosure resolves this index before every held-preparation lookup and still compares and returns the exact canonical envelope bytes beside the identifier. The envelope digest remains derivable from these unchanged envelope bytes; no second preparation record or signing record is created under it."

[proof]
fixture = "repair_22_31_560.rs includes the existing native_send_preview_evm.rs loopback Anvil, authenticated authority and runtime-clock fixture; Anvil is selected by LAYERX_TEST_ANVIL or anvil on PATH. No remote endpoint or credential is required."
producer_transport = "owner_preview_over_unix drives AcceptedTransport and serve_one over UnixStream, decodes the production owner preview and signs its actual NativeSendPurposeV2. prepare_rpc sends the complete V2 request through handle_rpc with a distinct outer idempotency key on each call."
first_prepare = "native_send_first_prepare_and_reopened_prepare_match_owner_preview requires status 200 and exact equality of preview preparation_id, unsigned canonical bytes and signing preimage; assert_durable reads DurablePreparation::store_key and SigningPreparation::restore under that same identifier."
restart = "reopen_daemon closes the Store instance, reopens its original directory and constructs a fresh ProductionHumanOperations and UnifiedAgentOwner with restored sessions; the second handle_rpc Prepare uses the same purpose and a fresh outer idempotency key so RPC idempotency cannot bypass durable preparation recovery."
tenant = "assert_durable checks the authorization reference, signing inputs and durable preparation under the credential's principal tenant before and after reopen, asserts that tenant differs from the fixture's transport tenant and requires all three records to be absent under the transport tenant."
refusal = "native_send_prepare_refuses_a_different_signed_preparation_identifier changes both preparation_id and canonical_digest and signs the changed purpose with the real owner key; handle_rpc must answer 403 owner.refused."
unchanged_assertions = "The included native_send_preview_is_an_unsigned_ledger_transfer_call test retains all its existing assertions."

[interface_constraints]
legacy_carriers = "approval/native_program.rs::NativeProgramApprovalCarrier::bind and approval/native_effect.rs::NativeEffectApprovalCarrier::bind independently require reservation.id to equal SHA-256 of the authorization-envelope bytes; their read and validation paths require the same envelope identifier. These files are outside this task's allowed scope; their checks are not relaxed or bypassed."
fixture_authority = "The named preview fixture serves preview and EVM preparation reads; native RPC admission additionally requests committed capability, receipt-key and authenticated rate-usage evidence. No proof, authority, approval carrier or reservation is fabricated by this repair test."

[qualification]
ledger = "/out/run/gates.jsonl"
revision = "The candidate revision on the final matching build and verify ledger entries is the verified revision, only if both entries pass."
build = "The command, exit and log fields of the build entry produced by hf-build are authoritative."
verify = "The command, exit and log fields of the verify entry produced by hf-done are authoritative; hf-done invokes cg spec done 22.31.560 -f layerx-merge --root TASK_ROOT with the declared cargo test and graph checks."
policy = "This record precedes the gates and asserts no gate outcome. Do not amend files after the final gates. Unrelated or missing-interface failures are reported with the exact private evidence reference."

[first_gate_observation]
revision = "ae1d4f2289a8428f7b543c18feffdfaacfd182d1"
command = "cg spec done 22.31.560 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The genuine first Prepare answers 503 owner.unavailable instead of the required 200; the held fixture mutex is then poisoned by that assertion."
repair = "The test harness resumes every caught assertion panic only after releasing its fixture mutex, so the other unchanged assertions execute independently; the first case additionally verifies the production signing record under the preview identifier before requiring 200. The installed Anvil command points directly to the binary so fixture shutdown reaps its actual child."

[continue_environment_repair]
revision = "e63f630bffcfacf264f28f958c122e9df8d17e1f"
command = "cg spec done 22.31.560 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The build and all 15 dependent-crate checks passed; verification could not start the loopback EVM fixture because anvil was absent from this fresh sandbox, producing OS error 2 at native_send_preview_evm.rs:161."
repair = "Install the real @foundry-rs/anvil 1.7.1 fixture binary on PATH; keep every test and assertion, rerun hf-build and hf-done at the resulting candidate, and resolve the final evidence through qualification.ledger."

[receipt_key_peer]
basis = "Attempt 3, gotcha 3238: the loopback EVM node does not implement px_getReceiptKeys."
implementation = "repair_22_31_560.rs::fixture_with_receipt_keys adds a loopback chain peer in front of the existing fixture peer, holds a real Ed25519 signing key and serves one nonzero SHA-256 keyId with its valid publicKey, firstHeight 1 and lastHeight HEAD + 1000. decode_receipt_keys validates the response and assertions bind the decoded key and range; all EVM calls still reach the original peer and real Anvil."
startup = "The fixture runtime is reconstructed with that peer before the owner preview; reopen_daemon uses separate clock and key directories on every reconstruction. The later store close/reopen and all first and second Prepare equality assertions remain mandatory."
diagnostic = "The chain peer prints any upstream JSON-RPC error with its originating request. Production budget_read_parts already prints receipt key and chain-id read errors into the private verify log. A first Prepare 503 is retained as a failing assertion with its daemon diagnostic in that log."
evidence = "Resolve final build, dependent-crate and verify revision, command, exit and private log through /out/run/gates.jsonl; this record asserts no unrun gate."

[attempt_3_first_gate]
revision = "30c4add5c2dbb06309e2e33ac9241c6b6b914dd3"
command = "cg spec done 22.31.560 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The key peer rejected its own unprefixed hex as Malformed, and the daemon printed layerx-agentd: preparation receipt key read failed: Unavailable before first Prepare answered 503; joining that panicked peer during assertion cleanup aborted the test."
repair = "Use the sequencer decoder's required 0x-prefixed fixed hex fields and validate the complete key response before spawning the peer. Every original test and assertion is retained; final gate results remain referenced through qualification.ledger."

[authority_prepare_peer]
basis = "Attempt 4, gotcha 3243: the shared authority peer must serve the balance-context read made by genuine Prepare."
balance = "native_send_preview_evm.rs::authority_peer serves the same balance-context document fields as human_approval_budget_actor.rs and repair_22_31_562.rs, binding account_id to the fixture subject account and asset_id to its asset. Its sequencer key, SHA-256 identifier and height range match fixture_with_receipt_keys, which holds the matching real signing key."
routes = "Both initial and reopened runtimes use authority_peer. Registry, subject-context and identity retain their existing documents; balance-context supports budget_read_parts. The native send Prepare code requests no other authority route directly; all unknown routes still panic so additional required reads fail visibly."
cleanup = "Peer::drop reports the original worker panic payload and resumes it when no panic is active; during an assertion unwind it reports without starting a second panic. No assertion or unknown-route check is removed."
production = "The attempt-3 production tree and all mandatory first Prepare, durable lookup, reopened Prepare and wrong-identifier assertions remain intact."
evidence = "The final build and dependent-crate check and hf-done results, including their matching candidate revision, commands, exits and private logs, are referenced through qualification.ledger; no gate outcome is asserted before it runs."

[committed_checkpoint_peer]
basis = "Attempt 5, gotcha 3252: verify_direct_node_readiness requires the signed committed checkpoint at the EVM fixture head."
implementation = "fixture_with_receipt_keys serves px_getCommit and px_getValidators at HEAD 64 from support/human_budget_checkpoint.json, requiring the exact requested height. decode_validators and verify_commit_material under ChainProofVerifier chain id 125 authenticate the recorded signedHeader before starting the peer; assertions require chain 125 and height HEAD."
block = "The real Anvil node mines HEAD blocks. For eth_getBlockByNumber at HEAD or latest, the peer forwards to that node, requires its block number to equal HEAD, and binds hash, stateRoot and timestamp to VerifiedChainHead::header_hash, app_hash and time_ms in seconds. All other EVM reads retain the real node result and every upstream RPC refusal is printed."
production = "The attempt-4 production changes and every first Prepare, durable retention, reopened Prepare and wrong-identifier assertion remain intact."
evidence = "qualification.ledger references the final matching hf-build and hf-done entries for their candidate revision, command, exit and private log. This record precedes qualification; no gate outcome is asserted before execution and no file is amended after the final gates."

[attempt_5_committed_binding_repair]
revision = "7789c270f8e48aa3a8ff58d6c1987c7fcd5e4dc5"
command = "cg spec done 22.31.560 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
