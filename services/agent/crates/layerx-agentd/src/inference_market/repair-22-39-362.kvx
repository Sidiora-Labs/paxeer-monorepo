[allowances]
deal_server_frame = "large_enum_variant: tests/inference_deals.rs constructs the unboxed Deal variant; preserve its public shape and wire representation."
lap_listener_tick = "needless_pass_by_value: src/main.rs calls tick with an owned FinalizedSnapshot; preserve its signature."
completion_binding_new = "large_types_passed_by_value: tests/inference_serve.rs calls new with RoomRecord and DealRecord values; preserve its signature."
serve_routes_new = "needless_pass_by_value: src/main.rs and tests/inference_serve.rs call new with owned receipt paths; preserve its signature."
serve_routes_respond = "needless_pass_by_value: tests/inference_serve.rs calls respond with owned request, gate and binding values; preserve its signature."
level = "Every allowance is attached to exactly the affected item; no crate/module lint level changes."

[qualification]
build = "hf-build"
verify = "hf-done"
build_log = "/out/logs/build-1.log"
verify_log = "/out/logs/verify-1.log"
verified_revision = "The revision field of the final passing verify entry in /out/run/gates.jsonl, printed by hf-done; its build entry must name the same revision."
result = "The private gate ledger records the authoritative final command, revision, exit and log; qualification requires hf-build and hf-done to pass at that revision."

