command = "cargo build --locked --manifest-path services/agent/crates/layerx-agentd/Cargo.toml --tests"
exit = 101
log = "/out/logs/build-1.log"
observed = "Five integration-harness call sites used Clone on SequencerEndpoint, which intentionally does not implement Clone."
repair = "Open independent clients to the same real loopback node; retain every assertion and real producer/consumer path."

[continuation.codec_coverage]
create = "repair_create_native_source_nonce_round_trips_signed_codec_and_rejects_maximum drives BudgetRequest -> deployed ABI encoder -> production EIP-1559 signer -> budget identity consumer for zero, above-height and maximum-minus-one nonces; rejects maximum, missing source and self-source."
mutation = "repair_fund_and_revoke_signed_codecs_preserve_nonce_and_counter_units drives the real ABI and signed transaction codecs into budget mutation identity; asserts zero/high nonces, reserved-maximum refusal, high revocation counters and strict monotonic rejection."
restoration = "repair_native_carrier_validates_real_preparation_and_restores_after_store_restart drives a supported real prepare_bound -> verify_before_submit -> budget native binding -> Store close/reopen -> budget restoration path; checks exact recovered bytes and disclosure and rejects seven retained-field substitutions and a different real carrier payload. This supplements rather than replaces the full allocation and settlement assertions."
limits = "Codec coverage does not establish native precompile confirmation, fee selection, committed proof export or settlement. The ten original success tests remain mandatory; their failures cannot be turned into expected errors or skipped to qualify."

[continuation.gotchas]
shared_producer = "The unchanged layerx-crypto disclosure/call.rs producer rejects zero source nonce and lacks budgetFundNative, budgetRevoke and native program lifecycle method binding; verify_before_submit invokes this producer before issuing its opaque VerifiedSubmission. Budget code cannot bypass that validation."
inputs = "The inherited full integration harness requires an unavailable external corpus and loopback node. No real producer captures for these operations are committed in the checkout; synthesizing chain replies or receipts would violate the task's path proof rule."
carrier = "The previous native carrier checked envelope scalar fields but did not compare the retained payload/hash with the native disclosure; the continuation binds both through the real semantic encoder."
checkpoint = "The previous pipeline authenticated source nonces at the latest head, losing the caller's preparation coordinate; pipeline_at retains the supplied checkpoint and validates it against the head before submission."

[continuation.fixture_corpus]
path = "services/agent/crates/layerx-agentd/tests/fixtures/repair_22_31_217"
producer_inputs = "Five unchanged native program C-codec conformance captures and the native budget-record vector are copied from their committed producers; each program capture retains its provenance. The existing signed checkpoint transcript is retained. The counter-1000 peer export changes the counter word and recomputes its receipt/evidence hashes while preserving the exact block coordinate. These are peer fixtures, not a claimed live node execution."
source_authentication = "repair_native_source_nonce_authenticates_owner_and_checkpoint drives the production signer, RPC client, committed checkpoint acquisition, sender/DID/account-owner join and exact nonce reader for zero and nonce 1000 at height 8, rejecting a substituted nonce and the reserved maximum."
fee_reservation = "repair_fee_payer_preferences_bind_metadata_and_durable_fee_holds reads two senders' committed preferences and metadata through the production RPC client, checks the authenticated inventory, reserves each fee in its selected denomination with the production limiter, closes/reopens Store and decodes the identical durable hold."
malformed = "repair_recorded_malformed_payload_refusal_is_explicit asserts the exact production PrepareError::Disclosure(DisclosureError::MalformedPayload) on the recorded first-use zero-nonce input while preserving the separate mandatory preparation/submission/confirmation success assertion."
assertions = "All thirteen inherited tests remain declared, executable and mandatory. No success assertion is changed into an expected error; additional source-allocation admission assertions ensure a refused preparation never acquires invented execution evidence."

[continuation.external_interfaces]
shared_disclosure = "services/agent/crates/layerx-crypto/src/disclosure/call.rs rejects native create nonce zero and has no native fund/revoke or deploy/upgrade/wind-down construct variants; this out-of-path interface is left intact and named in wiring.crypto."
shared_effects = "services/agent/crates/layerx-agentd/src/capability/effects.rs calls Disclosure::reencode on native Source::Call, which explicitly refuses that source kind; this out-of-path interface is left intact and named in wiring.effects."
account_contract = "The base tree precompiles/layerxprograms/abi.json now declares getValueAccount's second output frozen and view_accounts.go returns account.Frozen after task 22.31.251, contradicting this task's specified exists contract; the task's exists and separate-status-proof assertions are preserved pending resolution by the programs owning domain."

[continuation.fixture_gotchas]
