[attempt_7]
baseline = "Supplied attempt-6 revision 817473b0e734068dd60976e352614f2a965cd994: verify exited 101, 6 passed and 10 failed; gotcha 3210 and decision 2644 identify binder, Snapshot, retired-export-rank and absent-receipt failures. No extra baseline gate was run."
evidence = "The final hf-build and hf-done records in /out/run/gates.jsonl and /out/logs/build-*.log or /out/logs/verify-*.log name the exact candidate revision and outcome. This record is written before qualification and is not amended after the final gates."
mutation = "verify_committed_budget_mutation is the same confirmation consumer called by confirm_budget_mutation after admission. Tests feed signed deployed ABI through production decoding, loopback receipt/state/balance transport and that consumer while asserting the unsupported binder refusal separately. The peer's canonical module-12 receipt codec signs the actual transaction hash and log effects and self-checks them with verify_sequencer_signature and verify_logs; it makes no claim to execute a live precompile."
lifecycle = "verify_native_lifecycle_binding compares signed deploy/upgrade/deprecate/exit calldata to typed native semantics from the committed C producer vectors, validates signatures and transaction constraints, and is called by both lifecycle settlement readers. repair_unsupported_binder_methods_preserve_real_native_lifecycle_binding proves each binding and Store restart plus payload and chain-id substitutions without inventing a VerifiedSubmission for unsupported methods. The inherited full lifecycle settlement success assertions remain mandatory."
proof = "budget-proof-counter-1000.json now carries current COMMITTED rank 6; rank 4 was refused by budget_verification_level in budget_proof.rs:21 before any revocation-counter check. The test retains the original rank-4 refusal, authenticates the signed checkpoint and exact getBudget reply with counter 1000 at height 8, and rejects an independently substituted counter."
no_receipt = "Decision 2644 explicitly permits the no-receipt refusal path for program_settlement: read_native_execution_observation validates the native preparation and exact submission, reads the loopback node's unknown transaction result and returns Receipt. The test reopens Store, restores the real native preparation and proves the unknown signed transaction remains retained and still cannot settle; no execution receipt is invented. This is refusal evidence, not successful program settlement evidence."
source = "repair_source_checkpoint_identifies_retired_caps_level proves nonzero now, actor/caps identity, nonzero root, matching preparation/global/head/batch coordinates and node height; only the current-evidence-strength predicate cannot be satisfied because CommittedCaps::level at src/read/committed.rs:166 always returns retired rank 4 and VerificationLevel::compare refuses retired labels. Both the source success assertions and the current-evidence check stay intact."

