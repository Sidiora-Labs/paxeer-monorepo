[attempt_11]
baseline = "The supplied attempt-10 outcome was 15 passed and 3 failed. The initial working tree and empty current gate ledger were inspected; no baseline verification was repeated. The base includes the lifecycle disclosure producer from 22.31.585."
lifecycle = "verify_native_lifecycle_binding now reuses bind_call's disclosed deploy, upgrade and wind-down values. Native preparation, signature verification, held source resolution, public enrolment denomination installation, hold_call/decide_call/queue_call and the real outbox produce the settlement inputs; the loopback peer serves signed module-12 receipts and precompile logs. The budget native settlement reader validates the current call-bound approval format instead of sending it through the retired DurablePreparation codec."
wind_down = "The full exit success case derives its account from the production program-account derivation and seed, encodes its NativeProgramWindDown input, verifies a nested account/account-tree/universal-root proof and signed header through layerx_proof, and serves that exact root under a signed committed checkpoint. Existence and unfrozen status are asserted separately; removing the proof refuses settlement. The original C conformance captures remain unchanged and are exercised by the standalone binding test."
