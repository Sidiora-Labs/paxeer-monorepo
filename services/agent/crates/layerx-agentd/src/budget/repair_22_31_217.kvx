[repair]
task = "22.31.217"
audit = "22.30.92"
acceptance = "22998.1"
status = "implemented_pending_qualification"
evidence = "The bounded hf-build/hf-done ledger records the candidate revision, exact command, exit code and private log. No successful verification is claimed before those gates pass."
baseline = "The supplied attempt-1 evidence at ae38baaeab2af82b6d689c2a7d8a50d2ca885708 reports all ten declared integration tests failing (zero passed): create/fund fail native preparation, the remaining cases lack producer captures. This continuation preserves those assertions. No extra baseline gate was run because the explicit gate order permits verification only through hf-done after implementation."
integration_inputs = "Tests load tests/fixtures/repair_22_31_217/corpus.json directly. Native codec captures, checkpoint transcript, high-counter export and ABI peer vectors are committed beside it. A loopback replay server starts and stops in process; EIP-1559 signatures, budget validation, fee reservation and Store recovery use production code. No runtime variable, credential, external endpoint or subprocess is read."

[finding.create_source_nonce]
test = "repair_create_source_nonce_first_use_prepares_submits_and_confirms"
repair = "Accept zero and reject the reserved maximum; bind source ownership and exact nextSequence at the retained preparation checkpoint via pipeline_at before native submission; reject reserved maximum and invalid sources in both the request producer and signed-byte consumer."
status = "awaiting_gate_and_external_wiring"

[finding.fund_source_nonce]
test = "repair_fund_source_nonce_zero_and_above_height_confirm"
repair = "Treat the native third word as a source nonce, independent of height, and authenticate source ownership and nextSequence before submission. Compatibility field names expose unit-correct sequence accessors."
status = "awaiting_gate_and_external_wiring"

[finding.revoke_counter]
test = "repair_revoke_counter_above_height_confirms"
repair = "Retain strict increase over the prior record and exact event/state matching without a block-height ceiling."
status = "awaiting_gate_and_external_wiring"

[finding.proof_revocation_counter]
test = "repair_proof_revocation_counter_exports_and_verifies"
repair = "Retain nonzero counter and exact authenticated getBudget/export binding without a height ceiling."
status = "awaiting_gate_and_external_wiring"

[finding.execution_account_exists]
test = "repair_execution_account_exists_funded_unfrozen_wind_down"
repair = "Decode balance/existence separately and require independently verified account status matching the held height, root, account kind, authority, asset and balance; never invent an unfrozen status."
status = "awaiting_gate_and_external_wiring"

[finding.fee_payer_denom]
test = "repair_fee_payer_denom_selects_two_real_preferences_and_reservations"
repair = "Read getFeeDenom for the disclosed authenticated sender and bind its DID/address join and fee metadata to the source checkpoint."
status = "awaiting_gate_and_external_wiring"

[finding.lifecycle_native_envelope]
test = "repair_lifecycle_native_envelope_deploy_upgrade_wind_down_and_restart"
repair = "Validate signed EIP-1559 bytes, recovered sender, transaction hash and bound disclosure; derive lifecycle operations from that disclosure and consume the authenticated receipt while preserving prestate and debit checks."
status = "awaiting_gate_and_external_wiring"

[finding.settlement_native_envelope]
test = "repair_settlement_native_envelope_program_receipt_and_restart; repair_settlement_native_envelope_effect_receipt_and_restart"
repair = "Consume native call-bound disclosures and already-authenticated receipt evidence; independently authenticate supplied program terminal/call-graph artifacts and preserve reservation identity, occupancy and debit bounds."
status = "awaiting_gate_and_external_wiring"

[finding.sources_native_envelope]
test = "repair_sources_native_envelope_allocates_and_restores_real_preparation"
repair = "Validate native unsigned bytes, signing digest and bound disclosure directly; restore canonical native bytes without re-encoding a retired signing envelope, and check retained payload, payload hash and owner authority consistency."
status = "awaiting_gate_and_external_wiring"

[wiring]
crypto = "Domain 9, services/agent/crates/layerx-crypto/src/disclosure/call.rs: accept native create source nonce zero and add deployed native fund/revoke and deploy/upgrade/wind-down ABI disclosure producers."
authority = "Domain 8, services/platform/hosted/authority/src/human/budget_state and services/platform/hosted/authority/tests/budget_proof_exports.rs: export and test monotonic revocation counters independently of height."
preparation = "Domain 9, services/agent/crates/layerx-agentd/src/prepare: retain and restore native call-bound preparations and approval carriers; supply the held source checkpoint/nonce to BudgetRequest::pipeline_at instead of using a fresh head during admission."
effects = "Domain 9, services/agent/crates/layerx-agentd/src/capability/effects.rs: validate Source::Call through the native disclosure codec instead of Disclosure::reencode before deriving program and native-effect plans."
program_artifacts = "Domain 9, services/agent/crates/layerx-agentd/src/ops/program.rs: acquire native transaction terminal/call-graph artifacts for verify_native_program_debit_settlement without decoding signed kernel activities."
account_status = "Domain 9, services/agent/crates/layerx-agentd/src/human_runtime.rs and src/read: acquire authoritative frozen-state proofs at the receipt prestate checkpoint and pass them to committed_execution_state_with_account_proofs; the current ABI supplies existence only."
fee_preparation = "Domain 9, services/agent/crates/layerx-agentd/src/human_runtime.rs: pass the authenticated sender/actual fee payer to native_fee_policy_for during preparation and presentation, replacing default-denomination reads."
integration = "Domain 9, services/agent/crates/layerx-crypto/src/disclosure/call.rs and services/agent/crates/layerx-agentd/src/capability/effects.rs: enable native preparation and source allocation so the still-mandatory native execution and settlement success paths can emit their bound receipts and artifacts; never bypass these admission checks to invent an execution fixture."

[gotchas]
scope = "Root GOTCHA.kvx and spec records are outside the user-authorized scope; this in-scope record carries task findings and wiring requests."
account_abi = "getValueAccount's second word is existence; existing callers have no authoritative frozen-state field and must fail explicitly when separate proof is unavailable."
native_producer = "Shared native disclosure binding rejects first-use zero nonce before budget admission and lacks several deployed methods; budget-only edits cannot repair that producer."
recovery = "Legacy shared durable preparation restoration still validates kernel envelope bytes; native budget validation alone cannot qualify the complete restart path."

[qualification.build_1]
