rule = "Verify receipt identity and replay protection, then add requested_amount for successful current evidence and verified receipt amount for successful legacy evidence; failed receipts contribute zero; checked arithmetic and protocol reconciliation bounds are unchanged."
requested_amount = "The tenant-scoped persisted unknown reservation for the activity wins, including resolved reservations; otherwise recover the uint128 amount from canonical budgetSpend(bytes32,bytes32,uint128) calldata of the retained signed transaction whose hash equals the activity id and whose target is the pay precompile; otherwise zero. Malformed retained evidence is refused."
regression = "rebuild_accounting_counts_the_requested_spend_of_a_zero_value_receipt verifies the unmodified node-produced zero-value conformance receipt, reopens the persisted reservation, and asserts receipt_consumed 25, protocol_consumed 25 and reconciled true."
coverage = "requested_spend_recovers_signed_calldata_and_prefers_the_persisted_reservation checks restart calldata recovery, reservation precedence, absent spend, other destinations, invalid uint128 and mismatched hashes; recovery_keeps_legacy_receipt_amount_for_requested_spend preserves legacy consumption. Existing budget_schema, budget_unknown and recovery assertions are retained."
qualification = "The hf-build and hf-done runner records the exact candidate revision, command, exit and private log in /out/run/gates.jsonl; the final response copies the terminal gate evidence."

