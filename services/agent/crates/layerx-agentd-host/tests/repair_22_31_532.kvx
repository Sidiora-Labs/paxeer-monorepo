[repair.22.31.532]
acceptance = "22998.1"
fields = "ProductionWebPayer.approval_resources is optional WebApprovalResources; with_approval_resources takes the shared Store, shared BudgetLimiter and limit ids and constructs ApprovalExpiry::from_shared_store; preparation retains the production EVM pending/header reader."
wiring = "main.rs carries the sole shared_store from start_shared_owner to start_agent_rpc and attach_mcp_payers; attach_mcp_payers builds one BudgetLimiter from mcp_limit, shares it across payers and supplies only that limit id. publish_mcp_binding already receives this same store; payer construction now lives in attach_mcp_payers."
held_path = "prepare_bound uses the signer sender and the node pending nonce, base fee, head height and pending gas estimate; submit_transaction validates canonical bytes, signing hash, digest, sender and chain, signs without re-preparation, and verifies the raw transaction hash through send."
tests = "Four executing tests cover shared resources and durable rejection recovery, EVM preparation binding, exact prepared-byte submission after payer restart and changed node state with malformed hash refusal, node hash mismatch refusal, and unavailable defaults without resources. Local TLS attestor protocol and receipt signing use real cryptography in process; no external credential, live endpoint or subprocess toolchain is used by this repair target."

[gates]
build = "hf-build"
build_command = "cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd-host --tests && cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd"
verify = "hf-done"
verify_command = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd-host --test repair_22_31_532 --test payer_evm --test payer && cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-agentd"
results = "The bounded runner records each gate result, exact verified candidate revision, command, exit code and private log in /out/run/gates.jsonl; the final response copies the terminal gate evidence. This record is included in that candidate before qualification to keep build and verify on the same revision."

[interface_limitation]
observed = "The existing layerx-crypto disclosure call decoder does not implement payExact; prepare_bound therefore refuses exact payments, while ledger draw and issueGrant have real decoding paths."
assumption = "The shared disclosure decoder is outside this task's allowed paths; its missing payExact interface is preserved and recorded rather than replaced with a fallback or weakened binding."

