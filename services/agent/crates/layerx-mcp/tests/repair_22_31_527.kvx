[repair.22.31.527]
requirement = "22998.1"
gotcha = "3094"
decision = "2572"
signatures = ["approval::{require,approve,reject,expire,decide}: clock: &dyn Clock", "WebApproval: clock: &dyn Clock", "WebAuthority::new: clock: Arc<dyn Clock>", "WebRoute::new: clock: Arc<dyn Clock>", "WebCall::{exact_terms,exact_terms_with_payer,exact_terms_with_view}: clock: &dyn Clock"]
clock_sampling = "One-second Clock::sample; invalid zero generation or sampling failure is ApprovalError::Daemon(Unavailable); Unix seconds become TimestampSeconds; sequences remain ApprovalSequence."
clock_sources = "WebAuthority owns the host-supplied runtime clock; WebRoute and WebApproval preserve the same authority. Deterministic test adapters use layerx_types::test_support::DeterministicClock at each case's explicit time."
web_boundary = "hold_reserved_at receives the boundary clock; disclosure expiry and retry expiry checks sample that clock. SharedPayer forwards durable resources, prepare_transaction and submit_transaction to the actual payer. No ambient decision-time source remains in MCP production code."
production_wiring = "Decision 2574: layerx-agentd/src/main.rs::attach_mcp_payers supplies SharedAgentOwner::mcp_clock() as the first WebAuthority::new argument and maps failure to MCP approval clock is unavailable. WebAuthority and WebRoute carry this same runtime clock. The environment-clock leg of decision 2572 is withdrawn; MCP constructs no clock and adds no production dependency."
list_callers = ["tests/repair_22_33_1552.rs::OwnerTransport::consume", "tests/repair_22_33_1552.rs::approval_page_bound_authenticated_transport", "tests/support/session_transport.rs approval.list dispatch (ported in attempt 1, retained)"]
list_time = "Each fifth list argument is TimestampSeconds from the case's layerx_types::test_support::DeterministicClock at HEIGHT; every assertion is retained."
fixture_helpers = "TestClock remains a thin Mutex adapter over DeterministicClock. Advance and zero-generation constructors belong only to repair_22_31_527; session/approval/codec helpers used solely by repair_22_33_1551 live with those tests, preserving their assertions."
proof = ["timed_hold_is_approved_through_the_binding_and_spend_completes", "restart_recovers_the_hold_and_advanced_runtime_clock_can_decide_it", "zero_generation_refuses_unavailable_without_a_hold"]
path = "SDK encode_envelope -> daemon decode_mcp_invocation -> Binding::daemon_invocation -> Server -> WebRoute -> real EVM preparation -> durable approval registry -> served approval owner -> exact retained spend -> recorded signed receipt verification."
restart = "Drop the binding, registry and approval resources; reopen the same store; replay the hold and budget reservation; advance the same deterministic clock and approve through the binding."
existing_tests = "All six repair_22_33_1551 test functions and their assertions are retained. Their unchanged real recording/preparation fixture is shared with the new proof; timed entries receive an explicit deterministic clock."
expectation_conflicts = []
files_touched = ["services/agent/crates/layerx-mcp/src/boundary.rs", "services/agent/crates/layerx-agentd-host/tests/payer_evm.rs", "services/human/crates/layerx-human-service/tests/decide.rs", "services/agent/crates/layerx-agentd/src/main.rs", "services/agent/crates/layerx-mcp/tests/repair_22_33_1552.rs", "services/agent/crates/layerx-mcp/src/approval.rs", "services/agent/crates/layerx-mcp/src/binding.rs", "services/agent/crates/layerx-mcp/src/server.rs", "services/agent/crates/layerx-mcp/src/tools/web.rs", "services/agent/crates/layerx-mcp/src/tools/web/approval_state.rs", "services/agent/crates/layerx-mcp/tests/approval.rs", "services/agent/crates/layerx-mcp/tests/repair_22_31_223.rs", "services/agent/crates/layerx-mcp/tests/repair_22_31_224.rs", "services/agent/crates/layerx-mcp/tests/repair_22_31_527.rs", "services/agent/crates/layerx-mcp/tests/repair_22_33_1551.rs", "services/agent/crates/layerx-mcp/tests/session_tools_major_two.rs", "services/agent/crates/layerx-mcp/tests/support/clock.rs", "services/agent/crates/layerx-mcp/tests/support/seller_exchange.rs", "services/agent/crates/layerx-mcp/tests/support/session_transport.rs", "services/agent/crates/layerx-mcp/tests/support/web_hold.rs", "services/agent/crates/layerx-mcp/tests/web.rs", "services/agent/crates/layerx-mcp/tests/web_payments_layerxpay.rs", "services/agent/crates/layerx-mcp/tests/repair_22_31_527.kvx"]

