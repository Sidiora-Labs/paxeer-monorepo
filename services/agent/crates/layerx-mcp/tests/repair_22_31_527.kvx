refusal_provenance = "ToolBoundary::preflight performs local checks without effects; WebBoundary samples the same runtime clock before Server::execute_for_release opens the durable invocation. DaemonBoundary and OwnerBoundary forward this check."
durable_result = "For a new invocation, a preflight refusal bypasses boundary execution and is audited and settled with its refusal bytes. Unavailable remains the public refusal variant. Retained outcomes and reconciliation take precedence; errors after execution starts retain the existing unknown-outcome handling."
proof = "All three binding tests and all six restart tests retain every assertion; the zero-generation case also asserts that no transaction preparation occurred."
