[repair.22.31.531]
requirement = "22998.1"
gotcha = "3119"
decision = "2583"
removed_refusal = "Configuration(metered_receiver_approval) for an existing standing or offered grant; approval_call validates the existing grant, reads nextSequence through WebPayer::view, decodes the sequence and prepares the receiver draw."
stored_spend = "Existing-grant draws retain the canonical PrecompileCall ABI bytes, boundary actor address, SHA-256 byte digest and domain-separated SHA-256 signing hash over layerx-web-receiver-draw-v1, the spend commitment and the draw bytes; fee limit is zero. This is a receiver-executed draw disclosure, not an unsigned payer transaction. The existing durable StoredSpend schema, save, reservation, approval decision reference and recovery remain in use."
bindings = "Reopen checks canonical draw encoding, digest and signing hash; retry binds the spend commitment, actor, amount, receiver, asset and activity type. Metered validation compares the draw target, selector, grant ID, recipient, amount, idempotency key, purpose hash and reserved word with the terms. The retained receiver sequence word is not revalidated against pending state."
changed_grant = "Before a held draw can resume, validate_existing_grant reads the grant again and checks ID, payer account, recipient, asset, purpose, per-draw maximum and allowance. The changed-grant proof replaces the prior RPC observation with the committed, authentically signed lowLimit grant (maximum 3113 below amount 3114); changing signed grant terms also changes its grant ID."
approved_spend = "After the unchanged durable grant decision and reservation checks, receiver draws carry the retained approved grant ID through WebPlane::authorise's standing-grant settlement path without rediscovering or replacing it; no prepare_transaction, new grant, submit or submit_transaction is called. Exact payments and new-grant metered payments retain unsigned EIP-1559 preparation and submission. A payer without approval_resources remains unavailable."
producer_path = "Authenticated Server -> stdio Session tools/call -> WebRoute -> approval_state -> durable ApprovalRegistry and budget -> ApprovalService -> WebRoute retry -> standing-grant payload -> committed seller settlement -> real receipt signature and ledger log verification. SequencerEndpoint owns pending ledger view request encoding and response decoding."
recordings = "tests/support/web_hold.rs replays client-exchange.json search entries 0/1 and gateway/metered.json ledger RPC observations; RecordedNodePayer's optional standing-grant mode selects the committed grant for the requested asset. Existing exact-payment recording assertions remain enforced. No credential or live endpoint is used."
cases = ["above_threshold_standing_grant_search_is_held_on_its_disclosure", "standing_grant_hold_survives_server_restart_and_is_pending", "approval_after_restart_settles_under_the_standing_grant_without_a_payer_transaction", "rejection_refuses_the_standing_grant_draw_without_payment", "a_grant_changed_below_the_draw_amount_is_refused_as_changed", "standing_grant_payer_without_approval_resources_is_unavailable"]
regression = "The first three cases must create the metered hold through the real approval_state path; the previous Configuration(metered_receiver_approval) refusal prevents each from reaching its first ticket assertion. No pre-repair gate was run, as the task explicitly requires implementation before qualification."
restart = "Drop the served server, registry and all original approval resources; reopen the same store; replay the original hold and budget reservation; assert the preparation is byte-exact and the served retry is pending; approve and settle through the restarted server."

[qualification]
build_gate = "hf-build"
build_command = "cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-mcp --tests"
verify_gate = "hf-done"
verify_command = "cargo test --locked --manifest-path services/agent/Cargo.toml -p layerx-mcp --lib --test repair_22_31_531 --test repair_22_33_1551 --test repair_22_31_527"
evidence_command = "cg spec done 22.31.531 -f layerx-merge --root /work/paxeer-monorepo"
results = "The gate-written /out/run/gates.jsonl build and verify rows record exact candidate revision, command, exit code and private log. The final response copies the last hf-done row, or hf-build if verification never ran. This source record is finalized before the gates so build and verify qualify the same candidate, without a self-referential revision."
private_build_log = "/out/logs/build-1.log"
private_verify_log = "/out/logs/verify-1.log"
result_policy = "No unrun gate is claimed as passed; stop on hf-done success or the bounded repair/deadline result. No spec edit, commit or push is performed by the worker."

