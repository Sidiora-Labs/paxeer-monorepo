verification_reference = "Private /out/run/gates.jsonl verify record and its referenced /out/logs/verify-N.log."
assertions = "Every test and assertion is retained; fixture bytes are unchanged, and consumer imports now link the real API and client crates through their public namespaces."
support = "The carried independent verifier retains its license, provenance, vectors and verification rules; Fe::invert is restored and arithmetic operations retain their order."
scope = "Only services/agent/crates/layerx-types is edited; no public library signature or workspace lint level is changed."

[gotcha.tooling]
symptom = "The first tree-sitter binding version crashed during source traversal before repairs were written."
repair = "Use tree-sitter 0.25.2 for the local Rust grammar; continue the existing implementation without rerunning gates."

[repair.fixture_conversions]
files = ["tests/repair_22_33_1542.rs", "tests/support/recorded_commit.rs", "tests/support/rung_cases.rs"]
lints = ["clippy::cast_possible_truncation", "clippy::cast_lossless", "clippy::unwrap_used", "clippy::expect_used"]
repair = "Use fallible bounded length/rank conversions, byte extraction for base64, and explicit failure diagnostics; assertion conditions stay intact."

[repair.compatibility]
files = ["src/verify.rs", "tests/repair_22_33_1542.rs", "tests/support/rung_cases.rs"]
lint = "deprecated"
repair = "Retain legacy decoding coverage with a reason on each compatibility test that uses the deprecated decoder."

