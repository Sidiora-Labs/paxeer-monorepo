[repair.22.39.211]
acceptance = "22998.1"
workspace = "The agent workspace lints cover all workspace members and targets."
repair_scope = "Public method signatures and test assertions remain intact."

[inventory]
types = 8
client = 21
agentd = 2
sdk = 1
client_test = 10
agentd_host = 1
workspace_remaining = 0

[source_repairs]
