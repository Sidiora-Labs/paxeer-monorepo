[agent_workspace_tests]
verified_revision = "The qualified candidate revision carrying this record after the declared build and verification pass."
rule = "Native terminal recovery uses an exclusively created private store root for each invocation. Native preparation and disclosure use the daemon prepare operation and the unsigned call signing digest. Audit header reads preserve I/O errors and reject truncated headers as invalid. Exported terminal rows carry a transaction hash, nonce and receipt rung. Native balance reads pin the requested block and host account proofs. Idempotency retains the inclusive window and binds journal submission to durable registration. Proof bundles verify ABCI execution results against the covering header. Readiness distinguishes absent receipt keys from malformed keys. Session records preserve the current layout and private store permissions. Store migration fixtures create private snapshots. Webhook backfill delivers a canonical Ethereum log with its block cursor before the live boundary. Finality requires trusted validator material to reopen committed records. Receipt lookup framing refuses unsupported verification codes. Audit observers bound each operation independently. Receipt references use the unsigned receipt digest. Lifecycle idempotency binds the transaction hash and call selector. Account digests retain their exact byte width. Signed receipt vectors distinguish EVM reverts from preexecution refusals. Market finality uses a verified namespace witness and the exact covering header. Archive ranks decode only through historical types and cannot satisfy current policies. Wallet enumeration carries the complete committed balance schema and drains subprocess output concurrently. Program chain head reads serve the observed sequence for eth_blockNumber. Timed approval replay counts the retained terminal decision once without restoring a released reservation. Evidence inventory reports retained legacy recovery records until authenticated migration completes."
changed_files = [
    "services/agent/crates/layerx-agentd/tests/audit_binding_receipt_recovery.rs",
    "services/agent/crates/layerx-agentd/tests/program_chain_head.rs", "services/agent/crates/layerx-agentd/src/audit/log.rs", "services/agent/crates/layerx-agentd/src/protocol_evidence_native_tests.rs", "services/agent/crates/layerx-agentd/tests/audit_export.rs", "services/agent/crates/layerx-agentd/tests/balance.rs", "services/agent/crates/layerx-agentd/tests/budget_reserve.rs", "services/agent/crates/layerx-agentd/tests/finality.rs", "services/agent/crates/layerx-agentd/tests/idempotency.rs", "services/agent/crates/layerx-agentd/tests/idempotency_height.rs", "services/agent/crates/layerx-agentd/tests/inference_signal.rs", "services/agent/crates/layerx-agentd/tests/managed_agent_evm_tx.rs", "services/agent/crates/layerx-agentd/tests/native_send_preview_evm.rs", "services/agent/crates/layerx-agentd/tests/program_balances_eth_call.rs", "services/agent/crates/layerx-agentd/tests/proof_agentd_env.rs", "services/agent/crates/layerx-agentd/tests/proof_bundle_v2.rs", "services/agent/crates/layerx-agentd/tests/readiness_node_rpc.rs", "services/agent/crates/layerx-agentd/tests/repair_22_31_220.rs", "services/agent/crates/layerx-agentd/tests/repair_22_31_495.rs", "services/agent/crates/layerx-agentd/tests/repair_22_31_559.rs", "services/agent/crates/layerx-agentd/tests/session.rs", "services/agent/crates/layerx-agentd/tests/store.rs", "services/agent/crates/layerx-agentd/tests/suites/protocol_evidence.rs", "services/agent/crates/layerx-agentd/tests/support/native_routes_live.rs", "services/agent/crates/layerx-agentd/tests/tenant_resolve.rs", "services/agent/crates/layerx-agentd/tests/webhook.rs", "services/agent/crates/layerx-agentd/tests/human_approval_budget_actor.rs", "services/agent/crates/layerx-proof/tests/native_terminal_outcome.rs", "services/agent/crates/layerx-sdk/tests/issue_1764.rs", "services/agent/crates/layerx-client/tests/ai_market_commit.rs", "services/agent/crates/layerx-client/tests/proof_client.rs", "services/agent/crates/layerx-client/tests/repair_22_31_221.rs", "services/agent/crates/layerx-client/tests/support/market_22_33_1546.rs", "services/agent/crates/layerx-proof/tests/sequencer_receipt_vectors.rs", "services/agent/crates/layerx-sdk/src/agent_envelope.rs", "services/agent/crates/layerx-sdk/tests/proof_layerx_wallet_rpc.rs", "services/agent/crates/layerx-sdk/tests/repair_22_31_190.rs", "services/agent/crates/layerx-sdk/tests/rpc_node.rs", "services/agent/crates/layerx-sdk/tests/support/audit_22_30_99.rs", "services/agent/crates/layerx-sdk/tests/support/native_send_preview.rs", "services/agent/crates/layerx-types/tests/support/rung_cases.rs", "services/agent/crates/layerx-agentd/tests/approval_decision_time.rs", "services/agent/crates/layerx-agentd/tests/receipt_rpc_roundtrip.rs", "services/agent/crates/layerx-sdk/repair_22_39_498.kvx", "Makefile"]
build_command = "make -s agent-build"
verify_command = "anvil --version > /dev/null && test -s services/agent/crates/layerx-sdk/repair_22_39_498.kvx && make -s agent-test AGENT_TEST_SCOPE='--workspace --exclude layerx-agentd --exclude layerx-agentd-host --exclude layerx-client --exclude layerx-mcp --exclude layerx-sdk --exclude layerx-types --exclude layerx-wire'"
do_4_rule = "The receipt refusal case follows the current frame reader: verification code 6 is historical COMMITTED metadata and is accepted, so malformed verification inputs use unsupported codes 0 and 255 while retaining the refusal assertion. The repair is in services/agent/crates/layerx-agentd/tests/receipt_rpc_roundtrip.rs."

do_5_rule = "The agent-test target accepts AGENT_TEST_SCOPE and defaults it to the full workspace; the bounded selection leaves the seven member workspaces to their own qualification tasks."
hand_selection = "The seven-member hand selection runs serially with no fail-fast and preserves the workspace test target and runtime-clock configuration."
