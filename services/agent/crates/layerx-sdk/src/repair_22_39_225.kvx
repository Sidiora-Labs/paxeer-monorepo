[gate.build_1]
revision = "97853cdcb4a69352b70ac3284f01a84d2306ad2b"
command = "cargo build --locked --manifest-path services/agent/Cargo.toml -p layerx-sdk --all-targets"
exit = 101
log = "/out/logs/build-1.log"
observed = "Option assertions in proof_sdk, shared audit support and repair_22_31_547 used Result-style closure arguments."
repair = "Use zero-argument missing-value assertion closures; retain each failure message and all test assertions."

[gotcha.option_assertions]
observed = "Source-only assertion conversion must distinguish Option from Result, including field values and find closures in macro arguments."
resolution = "Use the compiler-reported receiver type to choose the failure branch; all missing values continue to panic."

[gotcha.generic_callback_return]
observed = "A must_use annotation on SecretBytes::expose_to made the included external secret-hygiene test warn when its callback returned unit."
resolution = "Preserve the original callback API without adding a return-value requirement."

