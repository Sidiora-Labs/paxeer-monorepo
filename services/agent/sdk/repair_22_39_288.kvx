[qualification]
build = "hf-build"
verify = "hf-done"
ledger = "/out/run/gates.jsonl"
logs = "/out/logs/build-*.log and /out/logs/verify-*.log"
format = "No SDK Python or TypeScript formatter is configured; apply repository .editorconfig whitespace and final-newline rules to touched files."

[gotchas]
recording_identity = "Local regenerated metered captures also contain historical exact rows; do not pair those exact receipts with the subsequently recorded type-2 gateway/exact.json transactions. Follow the current exact producer without regenerating or re-signing a positive receipt."
contract_inventory = "The task history mentions four inference reads, but the current contract and TypeScript client also publish px_getInferenceReceipts; assert all five actual producer names."

[qualification.corepack_environment]
revision = "1ad19b38712fb92f1d6978fdad37008bba7a752a"
command = "corepack enable && cd services/wallet && pnpm install --frozen-lockfile --ignore-scripts && cd ../.. && npm --prefix services/agent/sdk/typescript ci --no-audit --no-fund && pnpm --dir services/agent/sdk/typescript run build && python3 -m py_compile services/agent/sdk/python/layerx_sdk/px.py"
exit = 1
log = "/out/logs/build-1.log"
observed = "Corepack rejected the task-prescribed pnpm invocation in the SDK because the ancestor package.json declares npm, after both installs succeeded; compilation did not run."
repair = "Run both declared gates with COREPACK_ENABLE_STRICT=0 so Corepack permits the explicitly requested package-manager binary in this mixed npm/pnpm repository; frozen installs, compiler checks, test selection, graph checks and all product assertions remain intact. No package manifest changes."

[qualification.first_verify]
revision = "bfe763b5237cf0bf707b8ad00d7f3896c73131ed"
command = "cg spec done 22.39.288 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "52 TypeScript files executed; web-search-sequencer.test.ts, proof_gas_station.test.ts, Python parity and Python inference HTTP request tests passed; inventory assertions and an absent Comet vote adapter failed, alongside the unrelated revert digest pin. Python pytest was not reached."

[repair.contract_inventory]
files = ["services/agent/sdk/typescript/src/px.ts", "services/agent/sdk/python/layerx_sdk/px.py", "services/agent/sdk/python/layerx_sdk/px.pyi", "services/agent/sdk/typescript/test/px.test.ts"]
cases = ["px_methods_list_is_the_hosted_gateway_px_set", "receipt_keys_shape", "python_px_matches_ts"]
producer = "services/platform/hosted/gateway/openrpc.json methods"
change = "Preserve full inventory equality and explicit name pins: the contract also carries px_register, px_getCommit, px_getValidators, px_getSequenceBatch, px_requestFunds, px_listHolderRecords, px_getCapabilities and px_getRouteCatalogue. Include these actual producer names in both SDK inventories and PxMethod declarations, for 21 total. Keep all five typed inference helpers and their request checks."

