baseline = "Retire the 48 entries for the five repaired modules. Preserve all 46 entries of 22.39.119 and the unchanged test_receipt_fixture.py entry outside scope; assert the exact retained list against the task base."

[producer_lines]
revision = "3a0f70d0fce59d96719043d5294b98aa3718e3bd"
web_search_payer = "web_search.py passes offer.payer as ledger_payer following layerx_sdk/x402.py:176-177 and 197-198: payer identifies the recovered signer while ledger_payer identifies the payExact source account; x402.py:214-217 authenticates the signer and 241-250 binds the ledger account to calldata."
web_search_settlement = "web_search.py reads the settlement payer from authenticated payExact calldata[4:36] following layerx_sdk/x402.py:245 and 250,273: the source account is independently bound to the PaymentExact event. x402.py:295-304 ledger_payment_payer returns the EVM signer, which is a different identity. Receipt and transaction verification runs before settlement comparison."
web_search_ledger_rpc = "The retained ledger_rpc option and web_search.pyi declaration supply the canonical ledger account read required by layerx_sdk/x402.py:239-250 independently of signer identity discovery. The existing payer_rpc/payer_address pair remains validated; ledger_rpc defaults to payer_rpc and resolves accounts through precompiles/layerxledger/views.go:65-77 accountId."
account_replay = "Replay accountId answers from services/agent/sdk/typescript/test/recorded-web-ledger.json in the same method/params/result shape as the other recorded RPC answers. The producer is precompiles/layerxledger/views.go:73-77 through modules/lxphost/accountmap.go AssetAccountID and layerxproof/codec/state.go:397-416 DeriveAccountID. Unmatched RPC requests still fail; HTTP request matching and recorded responses are unchanged."
payer_owner = "The metered payer selector uses the zero-padded EVM address owner as services/interop/crates/x-websearch/tests/payment.rs:64-87 payer_account and payer_account_rules do; the distinct grant signing key remains BUYER.payerDid and is asserted independently."
metered_refusal = "layerx_sdk/x402.py:68-71,185-186 refuses retired payer-grant authority with terminal LXP_NO_PAYER_GRANT. Metered cases assert receipt-unverified with that exact cause and retryability, including changed purposes, while preserving the recorded HTTP exchange."
committed_refusal = "layerx_sdk/x402.py:282-291 requires caller-pinned finality for a committed payment; x402_rpc.py:350-351 wraps SDK binding errors and 358-361 refuses a committed rung without committed evidence even when the requested minimum is receipted. The genuine signature, transaction, height, key and block identity assertions remain."

[scope]
