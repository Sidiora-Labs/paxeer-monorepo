revision_evidence = "The bounded gates record the exact candidate revision, command, exit code and private log in /out/run/gates.jsonl; hf-done advances the task ref to that candidate. A failed gate does not qualify this repair."
build = "hf-build"
verify = "hf-done"

[wire]
reference = "services/platform/middleware/seller/src/index.ts; services/platform/middleware/seller/src/commitment.ts; services/platform/middleware/conformance/pay6/node-fixtures.mjs"
changes = "Accept eip155 network names and prefixed asset/account bytes; authenticate receipt-proof-v2 raw transaction, signature, pinned key metadata, digest and optional node JSON; bind the EVM sender separately from the ledger payer and payment reference; refuse submitted and retired commitment values; retain committed inclusion verification, replay protection and durable reservations."
digest = "After 22.39.146, the pay6 portable proof and agent peer emit receiptDigest from verifySequencerReceipt: the authenticated SHA-256 signing digest. HTTP proof generation, verification, fulfillment rows and agent budget reservations use that verified digest."

[assertion.1]
test = "test_x402_draw_verifies_the_sequencer_receipt"
edited = "The calldata payer word equals terms.ledger_payer; successful verify_payment_receipt calls receive terms.payer from the recorded EVM from address and the separate ledger_payer."
reason = "The producer's PaymentExact.from topic identifies the ledger account, while the signed receipt from field identifies the recovered EVM sender. Both accounts remain asserted and mismatches of either are rejected."

[assertion.2]
test = "test_seller_verifies_a_sequencer_receipt_through_receipt_keys"
edited = "The entire settlement equality now expects the producer transaction hash, eip155:125 network, padded EVM sender and full receipt-proof-v2 extension."
reason = "The TypeScript seller emits txHash and PortableReceiptV2, replacing the retired lxp receipt URI and base64 receipt extension. The full dictionary assertion remains exact."

[assertion.3]
test = "test_seller_verifies_a_sequencer_receipt_through_receipt_keys"
edited = "The exact persisted fulfillment row uses the authenticated receiptDigest from the recorded sequencer vector, retaining the same request-key and request-digest assertions."
reason = "The seller stores the portable proof's verified signing digest; 22.39.146 corrected the pay6 producer to emit that digest, replacing the attempt-5 Keccak identifier for HTTP proofs."

[assertion.4]
test = "test_buyer_verifies_sequencer_receipts_through_receipt_keys"
edited = "The exact prepared payload equality compares all six receipt-proof-v2 fields, including prefixed rawTransaction, signedReceipt and receiptDigest and the full receiptKey range; buyer support is eip155:125 and its payer argument is the recorded EVM sender."
reason = "These are the producer's public payload names and payer binding. Signature, key-refusal, transaction-hash, receipt-digest and RPC exchange assertions remain intact."

[assertion.5]
test = "test_http_committed_offer_waits_for_verified_inclusion_after_restart"
edited = "Pending and successful prepare assertions select eip155:125 with the recorded EVM sender; the missing-finality refusal explicitly supplies a committed receipt-proof-v2 payload."
reason = "A receipted proof is a rung mismatch for a committed offer; a committed proof without finality must still reach and fail the existing PaymentBindingError check. Restart, single-submission, no-release and committed-inclusion assertions are retained."

[assertion.6]
test = "test_payment_commitment_refuses_the_retired_executed_rung; grant refusal cases in both local suites"
edited = "Shared grant offers use eip155:125 and preserve the ledger payer in receive and grant authorization bytes. The retired purposeHash extension is removed from the portable settlement proof supplied to grant-refusal assertions."
reason = "PortableReceiptV2 carries the actual transaction and receipt rather than an invented purposeHash proof field; the grant path still refuses with LXP_NO_PAYER_GRANT, including after restart, with empty journals and no release."

[coverage]
added = "Invalid proof format, rung, raw transaction, signed receipt, digest and pin metadata cannot release; optional producer node JSON fields and logs are authenticated; sender and ledger payer are independently bound; payment references are bound; every invalid commitment is refused."
preserved = "All existing tests and assertions remain active; no skip, expected failure, relaxed bound or disabled check is introduced."

[observation.1]
revision = "83246ad5676945addcbf4dd6eae86cf6f55b6ded"
observed = "The pay6 node-fixtures.mjs producer emits Keccak-256(signedReceipt), while the current TypeScript verifier.ts returns the SHA-256 receipt signing digest and seller/index.ts compares that value to proof.receiptDigest."
scope = "Those producer and TypeScript verifier paths are outside this task's scope; the declared hf-done gate must report their actual behavior without modifying them or accepting alternative digests."

