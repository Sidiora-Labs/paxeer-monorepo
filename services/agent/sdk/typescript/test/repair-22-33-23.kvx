[finding.daemon-probe-test]
tests = ["daemon_probe_uses_hosted_authentication_and_disclosure"]
repair = "The actual case-file probe is callable without process environment, uses read_hosted and readiness_hosted on AgentEnvelopeTransport's hosted route, refuses retired TLS/endpoint inputs, and retains authentication, generation, readiness, refusal, redaction and malformed-read/mutation disclosure checks."
peer = "Loopback HTTPS with committed test certificate and shared agent-api golden envelopes; only the correlated request ID changes during replay; readiness cases use the production readiness codec with in-memory peer observations."
wiring = "tools/qualification/paxeer-x/agent_operation_envelope.py — domain 9 agent qualification owner: emit read_hosted/readiness_hosted cases and expected_readiness, remove daemon_endpoint/client_cert_file/client_key_file/server_ca_file from the owning case-file producer."

[finding.trading-latest-test]
tests = ["TradingWriter.send signs and sends for the bound pair", "an unbound account binds through the explicit bind path and then writes through TradingWriter.send", "trading_pending_queue_accepts_a_second_trade", "trading_pending_queue_refuses_stale_and_malformed_nonces"]
repair = "The in-memory addr peer has separate committed and pending nonce state; production TradingWriter sends must discover pending, sign the exact queued nonce, admit two distinct trades without committing the first, and refuse stale and malformed nonce replies without a raw send."
wiring = "services/agent/sdk/typescript/src/perps.ts — domain 9 TypeScript SDK owner: retain the input revision's canonical pending-nonce validation; the committed-nonce floor belongs to the node admission consumer and is represented separately by the in-memory queue peer."

[finding.exchange-execution-test]
tests = ["exchange_account_bearing_dispatch_is_required"]
repair = "The existing Anvil wallet-request and transaction-byte assertions remain intact and are labelled as unit transport coverage; the focused regression reproduces the committed SDK calldata consumed by the native repair-459 test, checks the real account-bearing ABI selector and every argument word, and independently encodes the supported legacy overload."
remaining = "No merged-node execution success, created order account or cancellation is claimed: no producer-issued account-bearing execution transcript is committed, and the allowed Node gate cannot invoke a native toolchain or node binary."
wiring = "precompiles/layerxexchange/testdata and modules/layerxexchange/keeper — domain 3 exchange owner: supply a committed execution/receipt/state transcript including created order account and cancellation for the offline SDK harness; account-bearing dispatch is already implemented by 22.31.459."

[finding.names-route-test]
tests = ["resolveName", "root_route_contracts_match_the_actual_producers"]
repair = "The existing real namehash/resolution consumer runs through JsonRpcClient at /; the loopback peer rejects /rpc and /rpc/ws before dispatch and retains all selector, method, shape, unowned-name, malformed-response and error assertions."
wiring = "rpc/rpcstack.go and services/platform/hosted/gateway/src/main.rs — node RPC and hosted gateway owners: retain the root route and provide producer-recorded name-resolution exchanges; source route checks are not native handler execution."

[finding.exchange-parity-test]
tests = ["exchange_account_abi_matches_place_order", "exchange_account_bearing_dispatch_is_required"]
repair = "Every exact ABI-membership assertion is retained; expectations select the approved accountId overload from the production ABI and check argument names/types, selector, total width, account word isolation and invalid width refusals; legacy-overload coverage preserves the complete ABI inventory check and proves five-input encoding remains valid while each overload refuses the other's argument count."
producer = "precompiles/layerxexchange/layerxexchange.go already dispatches both ABI overloads; precompiles/layerxexchange/repair_459_test.go exercises their real admission and the committed SDK calldata. The Node gate proves SDK/ABI encoding parity without claiming to execute the native handler."

[finding.lifecycle-abi-test]
tests = ["lifecycle_abi_4_5_registration_codecs"]
repair = "Real deploy/upgrade encoders, decoders and NativeProgramLifecycleRequest admit ABI 4/5; every supported monotonic transition is checked along with unsupported versions and 5-to-4 downgrade refusals; a retained ABI-2 signature cannot authorize changed ABI-4/5 payload bytes. All original signature, full-payload size, truncation, framing and mutation checks still execute."
remaining = "SDK registration-codec admission is proven; native registry deploy/upgrade execution is not claimed by a codec round trip."
wiring = "programs/crates/layerx-programs-registry and sdk/platform/conformance/fixtures — domain 13 native programs owner: publish native-consumer-issued ABI-4/5 signed registration and execution transcripts for the credential-free Node gate."

[finding.gas-proof-route-test]
tests = ["gas_nonce_root_route_uses_pending", "root_route_contracts_match_the_actual_producers"]
repair = "The original station proof mounts/fetches / and explicitly refuses /rpc and /rpc/ws while preserving every existing assertion. The focused proof loads the real wallet JSON-RPC transport, calls production discoverSponsoredNonce, changes the in-memory pending nonce between reads and checks exact pending parameters, malformed nonce refusal and suffix rejection through both wallet and agent RPC consumers."
peer = "Only sdk/wallet/src/rpc.ts is transpiled in process using the declared TypeScript dependency; no wallet build, viem install, external binary or subprocess is needed for the focused proof. The original full wallet station proof remains registered in its own test file."
wiring = "rpc/rpcstack.go and services/platform/hosted/gateway/src/main.rs — node RPC and hosted gateway owners: retain root dispatch and provide native handler recordings for the nonce route; SDK loopback transport is not native handler execution."

[finding.px-route-test]
tests = ["px_root_route_preserves_history_cursor_and_errors", "root_route_contracts_match_the_actual_producers"]
repair = "All px fixture endpoints and assertions use / and refuse invented suffixes before dispatch; the method inventory is named for the hosted gateway. Production PxClient consumes the committed gateway unified-history response with exact method/parameter/cursor, amount, metadata and error checks. Existing px method, shape, cursor, error and Python parity assertions remain intact in px.test.ts."
peer = "apps/web/e2e/fixtures/px-get-unified-history.json; the focused gate replays this real gateway recording without invoking the separate Python parity toolchain."
wiring = "services/platform/hosted/gateway/src/main.rs — hosted gateway owner: retain / JSON-RPC dispatch; the fixture replay proves the SDK transport/consumer path while the native route is checked against producer source."

[gotcha.baseline_order]
observed = "The requested unchanged-tree verification conflicts with the explicit ordered prohibition on pre-implementation gates; the entry point is also absent on input."
action = "Follow the explicit gate order and state that no baseline ran, rather than invent before-change evidence."

[gotcha.foreign_runtime]
observed = "The existing full gas-station wallet proof imports viem and the wallet dependency tree, which are not installed by the scoped agent SDK build."
action = "Keep that proof unchanged except its root routes; the focused root proof loads the actual dependency-free wallet RPC transport and production SDK nonce consumer instead."

