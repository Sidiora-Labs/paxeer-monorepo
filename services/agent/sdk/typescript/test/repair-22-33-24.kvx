[finding.draw-reopen-test]
tests = ["prepared_draw_reopens_before_send", "prepared_draw_reopens_after_uncertain_response", "prepared_draw_checks_receipt_arrival_after_restart", "prepared_draw_settles_recorded_payment_after_restart"]
