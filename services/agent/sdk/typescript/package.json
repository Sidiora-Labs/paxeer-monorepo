{
  "name": "@sidiora/layerx-sdk",
  "version": "0.1.0",
  "description": "Production TypeScript SDK for the LayerX Agent and Human APIs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sidiora-Labs/Paxeer-X-Network.git",
    "directory": "services/agent/sdk/typescript"
  },
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js",
      "default": "./dist/src/browser.js"
    }
  },
  "files": [
    "dist",
    "src/generated/guarantees.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:self-contained",
    "test:self-contained": "npm run build && node scripts/run-tests.mjs self-contained",
    "test:anvil": "npm run build && node scripts/run-tests.mjs anvil",
    "test:ci": "npm run build && node scripts/run-tests.mjs ci",
    "test:external-node": "npm run build && node scripts/run-tests.mjs external-node",
    "test:case-file": "npm run build && node scripts/run-tests.mjs case-file",
    "test:native-effect-case": "npm run build && node scripts/run-tests.mjs native-effect-case"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "ws": "8.21.3"
  },
  "module": "./dist/src/index.js",
  "sdkTestRequirements": {
    "anvil": [
      "exchange-v2.test.ts",
      "gas-station.test.ts"
    ],
    "case-file": [
      "agent-operation-envelope.test.ts"
    ]
  }
}
