[behavior]
database_migrations = "The migration command applies the embedded statistics schema to PostgreSQL."
fixture_connections = "The integration fixtures provide a migrated database, metadata table, cache, and broker connection."
bound_documents = "Runtime documents accept matching file and inline bytes and reject changed digests or trailing data."
runtime_pool = "The development database pool reads the migrated statistics schema."
legacy_holders = "Legacy holder rows retain their authority classification and update their observed balance."
canonical_holders = "The public holder route pages committed transfer balances with the canonical watermark and supply."
source_integrity = "Canonical rebuilds, accounting delivery, and public statistics reject changed source bindings and unavailable storage."
read_availability = "Holder and search routes expose stale snapshots, expired cursors, quarantined coverage, and request admission limits."
commit_acknowledgement = "The HTTP integration peer counts lost commit acknowledgements under its transaction mutex."

