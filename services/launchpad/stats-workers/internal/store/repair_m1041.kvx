[qualification.continuation_verify]
revision = "987ae7a62bd3c9c9184a44a5b48e6eb3af1e7a22"
command = "cg spec done 22.33.1041 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log; test detail /tmp/repair-m1041.log"
observed = "All six repair tests executed; HolderTextOrder passed, while the five fee/pressure/idle tests failed because SQLite treated pgx PostgreSQL boolean literals as text in SQL expressions."
repair = "Translate pgx 't'/'f' boolean literals to SQLite TRUE/FALSE before executing actual SQL; preserve all production paths and exact assertions."

[gotcha.boolean_literals]
observed = "PostgreSQL accepts simple-protocol 't'/'f' literals for BOOLEAN columns; SQLite BOOLEAN affinity retains them as text, producing false CASE branches and failed boolean equality."
fix = "The SQL peer translates the wire boolean literals to TRUE/FALSE so storage, predicates and CASE expressions share PostgreSQL boolean semantics."

[qualification.current_verify]
revision = "ed5a2bdf2b36f92055c54e654e7b77f5f7ffc4ef"
command = "cg spec done 22.33.1041 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log; test detail /tmp/repair-m1041.log"
observed = "PressureSellUnits, PressureFixtureWrongLeg and HolderTextOrder passed; fee and idle tests failed scanning integer-encoded is_buy into bool."
assumption = "Repair the SQL peer's boolean wire encoding, preserving the real Store code and every assertion, then rebuild and verify the same candidate."

[gotcha.boolean_wire]
observed = "SQLite returns BOOLEAN storage as int64; overwriting its declared BoolOID with Int8OID prevents pgx from scanning is_buy into Go bool."
fix = "Preserve BoolOID and encode only integer 0/1 as PostgreSQL f/t, rejecting other values."
