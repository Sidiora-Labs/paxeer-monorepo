[repair.22.31.71]
finding = "cross_token_unwired"
audit = "spec/layerx-merge/programme/audit/records/22.30.40.kvx"
implementation = "The production CanonicalLegacyBridge replays source-issued MultihopSwap intents, binds the raw route to exactly two source-qualified and locally committed leg fills within its Router execution boundary, and preserves both token/pool associations, intermediate USDL and per-leg fees in the existing history row. The transaction/log identity of that row is the atomic replay checkpoint."
proof = ["TestRepair_71_CrossTokenHistoryDuplicateAndRestart", "TestRepair_71_WaitsForBothCommittedLegs", "TestRepair_71_RejectsUnboundRouteEvidence", "TestRepair_71_RouteRollbackAndRestartRecovery", "TestRepair_71_RequiresCompleteCanonicalSource", "TestRepair_71_CanonicalTransactionAtomicity"]
source_evidence = "Pinned, replay-verified isolated-chain mined Router.multihop receipts and decoded logs in sdk/launchpad/protocol/contracts/v1/chain/golden-fixtures.json, independently admitted by the real historical receipt authority, copied through real indexer PostgreSQL source tables into the production bridge and actual HTTP token/wallet handlers. This is archival interface coverage, not live-chain qualification."
baseline = "No baseline gate ran: the explicit task order forbids testing before implementation and reserves the sole verify execution for hf-done; no pre-change test failure is claimed."
qualification = "The exact candidate revision, command, exit and private log location are recorded by hf-build/hf-done in /out/run/gates.jsonl and copied into the final evidence record."
wiring_request = "launchpad/spec/production-system/integration/migrations/190001.sql — indexer/storage domain: expose and grant the stats runtime read role SELECT on the existing canonical indexer_ingest_outbox route-intent source (MultihopSwap plus Buy/Sell execution boundaries); its raw-log, accounting-fill, completeness and creation views are already the bridge's source interfaces."
source_qualification_request = "services/launchpad/indexer/internal/processor/canonical.go — indexer domain: retain source-qualified Router route intents and both accounting leg facts atomically in ProcessQualifiedCanonicalBatch; cover current native-precompile route issuance in that domain's producer gate."
