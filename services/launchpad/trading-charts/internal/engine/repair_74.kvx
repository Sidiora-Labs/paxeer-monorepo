[task.22.31.74]
finding = "22.30.41/21"
implementation = "ReconstructArchive reads the independent economic commitment retained by an exact-range promoted chart_rebuild_runs record and its matching chart_archive_checkpoints entry; the damaged chart_exact projection is not consulted during recovery."
bootstrap = "Initial qualification still compares the authenticated archive output with the live projection before StageRebuild/PromoteRebuild persist the commitment; ChecksumAuthority reports this distinct initial qualification path. Overlapping retained authority forbids bootstrap."
epoch_policy = "A retained commitment is accepted only at its promotion revision; a later series revision requires a fresh range commitment from the store owner rather than trusting potentially stale parity."
tests = ["TestRepair_74_RetainedParitySurvivesRestart", "TestRepair_74_RejectsInvalidRetainedAuthority", "TestRepair_74_DeleteCloseReopenReconstructArchive"]
proof = "The offline proof retains the independent checkpoint produced from live FoldQualified bars, removes projection files, closes and reopens the checkpoint transport, decodes committed arithmetic archive codec vectors through store.ValidateArchive and the shared production reconstruction, and consumes staged SeriesCandle snapshots. It checks every interval, trader membership, checksum refusal and deterministic equal re-emission. It does not qualify PostgreSQL promotion or upstream chain authentication."
qualification = "Qualification evidence is the runner-emitted revision, command, exit and private log from hf-build/hf-done; no qualification is claimed from test declarations."
baseline = "Not run: task step 5 conflicts with the explicit ordered gate rules forbidding verification before complete implementation and forbidding a separate manual verify_cmd run. No baseline failures claimed."
wiring_request = "services/launchpad/trading-charts/internal/store (owner fm-launchpad, domain 4): persist immutable algorithm-versioned range economic commitments atomically before every retention deletion, bind their validity to in-range source changes, and retain them independently of rebuild cleanup; expose exact requested parent-boundary range lookup so recovery can also cover ranges without a matching retained promoted run."
gotcha = "Archive checkpoints currently store only manifest digests; economic commitments survive in promoted rebuild records, so unmatched/subrange checkpoints and advanced series revisions must fail closed until the store-owned wiring is implemented."

