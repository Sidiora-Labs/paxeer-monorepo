wiring_request = "services/launchpad/indexer/internal/processor (owner fm-launchpad, domain 4): publish an approved Archive.Produce capture with authenticated boundary headers for the store-owned end-to-end recovery gate; engine codec vectors do not replace upstream source authentication."
gotcha = "The previous repair tests depended on DELIVERY_TEST_DSN and L10 archive/RPC/S3 variables; the focused repair gate must exercise shared production codecs and reconstruction in-process, while store-owned integration and idempotent outbox wiring stay explicitly deferred."
