[continuation.22.31.74]
implementation = "The SQL adapter transports retained promoted-run authority through the same bounded strict JSON checkpoint decoder used in-process; exact pool/range, manifest, promoted state, retained checkpoint and revision checks precede economic parity. ReconstructArchive uses the shared reconstruction code, retaining authenticated reader, source identity, parent rollup, incident and promotion fencing paths."
