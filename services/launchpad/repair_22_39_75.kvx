[repair.attempt_14_clean_contract_proof_dependencies]
revision = "934add9d4fb1de7a859f95493b27db601201793d"
observed = "After hf-build passed at this revision, reproducing the workflow's Build protocol proof dependencies step exited 1; /out/logs/protocol-proof-compilation14.log reports that the nested repair37/contracts module has no go.sum entry for github.com/ethereum/go-ethereum. The clean checkout has that proof module's go.mod but no go.sum."
implementation = "Run go mod download all in sdk/launchpad/protocol/bindings/testdata/repair37/contracts before its existing read-only dependency discovery and compilation. Download only the declared real dependencies and generate their checksums; preserve the manifest, all dependency versions, every assertion and all time limits. Extend the existing wiring case to assert the complete download and its ordering."
download_observation = "The initial no-argument go mod download generated only go.mod hashes, leaving the go-ethereum source checksum absent; /out/logs/protocol-proof-compilation14-repaired.log retains that refusal. Explicit all populates checksums for the complete declared graph before read-only discovery. The intermediate hf-build passed at 7a864e37df27cc02e80d194dcef274509dec7422 (/out/logs/build-2.log); the final bounded build must follow this completed repair."
producer = "The retained contracts proof module declares go-ethereum v1.17.3 and replaces protocol with ../../../..; a clean workflow checkout must populate this independent module's checksums before go list -mod=readonly. Its generated go.sum is an install side effect, not a source or dependency-version change."
build_evidence = "By reference: the final hf-build record in /out/run/gates.jsonl supplies the repaired candidate revision, exact command, exit and private log."
verify_evidence = "By reference: the final hf-done record in /out/run/gates.jsonl supplies the same repaired candidate revision, exact command, exit and private log; only a passing hf-done qualifies the task."

