[repair.attempt_11_ports]
decision = "2965; gotcha 3667; continuation of 5bc20d955595fbe36737e9cf7dd2b8bd502cbc33"
implementation = "Replace the three freePort copies in gateway/internal/proxy/proof_launchpad_gateway_test.go, internal/app/app_test.go and internal/app/identity_peers_test.go with internal/internaltest.FreePorts. It opens all requested TCP listeners on 127.0.0.1:0, reads their allocated ports, and defers every close until the complete port set is chosen. All former callers use the shared helper; paired PostgreSQL/Redis and public/private service listeners are chosen in one call. No assertion changes."
producer = "net.Listen with port zero owns the allocation until Listener.Close; keeping all listeners open follows that allocation contract and prevents the same port from being selected twice in a pair."

