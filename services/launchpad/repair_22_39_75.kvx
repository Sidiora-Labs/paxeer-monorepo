[repair.attempt_15_security_surveys]
decision = "3004; gotcha 3701; decisions 2893, 2917, 2947 and 2948; continuation of 16947cc1cf6f165476d5ef4d7ee3844f2c27d503"
survey_evidence = "By reference: /out/run/security-survey15.json records the seed and base revisions, exact baseline-aware module runner command, exit code, duration and individual private log for security and security/control; both module measurements run before either bounded gate and continue past failure. The security measurement exited 1 with its sole failing case TestRequestParsing at policy_test.go line 66 (/out/logs/survey15-security.log)."
implementation = "Add security/policy TestRequestParsing to the reviewed package-scoped baseline with retiring task 22.39.168. The baseline now contains 261 entries; security has one and security/control retains its existing one. Update the exact inventory and module-count assertions and add a wiring case asserting the new identity, failing source line, producer revision, refusal and owner. Preserve every source and test under services/launchpad/security, including the inherited manifest repairs."
producer = "DecodeMutation has admitted only the exact canonical field names of the destination since 22.33.1021 at b2a65cc20d; the valid body of TestRequestParsing posts the lowercase alias name of the untagged field Name and receives policy: denied. Retiring task 22.39.168 owns following that canonical-field producer in this case; this task does not change its assertion."
classification = "One newly measured security failure is a pre-existing consumer/producer contract mismatch, not a missing service variable. Keep the existing security/control TestRepair_65_RoutingRestart classification and its owner; baseline exclusions are not test passes."
control_result = "The security/control measurement exited 0 (/out/logs/survey15-security-control.log) with its existing TestRepair_65_RoutingRestart baseline entry. No additional failing case was observed; classification counts are security one newly baselined conflict and security/control zero new conflicts, with its one prior exclusion retained."
environment = "Apply every launchpad-go-test job environment value over inherited values through private /out/run/launchpad-env-exec.py. Use Go 1.27.3, Node 22, attested Foundry 1.7.1, PostgreSQL 16 and Redis 7 at the public job ports, JetStream NATS, the real MinIO endpoint and export bucket, the native producer library, compiled contract artifacts and the workflow proof dependency compilation step. Recreate the entire disposable PostgreSQL container before each gate, which removes every test-created database and role as required by decision 2917, and keep owned chain and object store processes alive throughout."

