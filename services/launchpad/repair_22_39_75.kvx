[gotcha.attempt_13_fresh_database_readiness]
observed = "The first fresh-container preparation used pg_isready inside the container; it accepted the temporary initialization server before the kindle_fixture database existed, so setup stopped before hf-build ran. No gate was consumed."
handling = "Wait for a successful SELECT 1 through the published TCP port and the actual kindle_fixture database before creating the remaining databases and invoking either bounded gate."

[repair.attempt_13_protocol_cold_compilation]
observed = "At 3957d655ceaa7ffafa0b4f76a04bf183a91145c4, cg spec done 22.39.75 -f layerx-merge --root /work/paxeer-monorepo exited 1 (/out/logs/verify-1.log): all 38 wiring cases and shared passed, but TestRepair_37_native_family_events spent its eight-minute subprocess limit downloading and compiling the cold node dependency graph, followed by the bindings package ten-minute timeout during TestRepair_37_beacon_ownership_handoff; protocol coverage passed and later modules were not reached."
implementation = "Before the protocol matrix entry's timed tests, compile the real node producer package's production and test dependencies under the root go.mod directive, the retained-contract proof dependencies under the launchpad toolchain, and the coverage producer executable using a copied temporary modfile exactly as its proof does. Go list enumerates test dependencies without executing tests; go build compiles only real packages. Require a nonempty dependency inventory and propagate every discovery or compilation failure."
producer = "repair_37_test.go invokes the node precompiles/launchpad producer with the root directive and invokes its contracts testdata module with the launchpad toolchain; coverage/repair_28_test.go invokes testdata/repair28producer using a temporary copy of its manifest. Compile these real inputs before their existing timed behavior tests, preserving every test, baseline entry, assertion and timeout."
verification = "Add test_launchpad_go_job_builds_protocol_proofs_before_timed_tests to assert producer paths, toolchain ownership, failure propagation and step ordering. Reproduce the workflow compilation step locally before the repaired gate pair; private /out/logs/protocol-proof-compilation.log records the command output and /out/run/protocol-proof-compilation.json its result."
build_evidence = "By reference: the final hf-build record in /out/run/gates.jsonl names the repaired candidate, exact command, exit and private build log."
verify_evidence = "By reference: the final hf-done record in /out/run/gates.jsonl names the same candidate, exact command, exit and private verification log. Only a passing result qualifies the task."

[gotcha.attempt_13_test_dependency_preflight]
observed = "The successful workspace builds and vets plus five explicit daemon/authority builds did not prepare the node toolchain's large test-only dependency graph or the separate contracts testdata module before the protocol behavior test timers began."
handling = "Compile the enumerated real proof dependencies in the workflow and qualification environment before the timed tests, without running an extra behavior test or extending a limit."

