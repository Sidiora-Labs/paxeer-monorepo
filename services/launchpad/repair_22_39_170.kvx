[meta]
task = "22.39.170"
target = "services/launchpad/Makefile ci"

[stage.test]
modules = ["sdk/launchpad/shared", "sdk/launchpad/protocol", "api", "indexer", "pnl-tracker", "ranking-algo", "stats-workers", "trading-charts", "gateway", "livestream", "metadata", "social", "user", "discovery", "notifications", "security", "security/control"]
fixtures = "The public Go jobs use PostgreSQL, Redis, object storage, a chain node, an event broker, a malware scanner and local proof binaries."
role_cleanup = "The pnl tracker reward fixture removes its database role before the next case run."
files = ["services/launchpad/pnl-tracker/internal/app/proof_launchpad_pnl_tracker_test.go", "services/launchpad/pnl-tracker/internal/app/repair_29_test.go"]

[stage.build]
modules = "The complete module inventory is built independently."
files = []

[stage.vet]
modules = "The complete module inventory is vetted independently."
files = []

[stage.fmt_check]
modules = "The complete module inventory is checked with gofmt."
files = []

[stage.lint]
release = "v2.15.0"
toolchain = "go1.27.3"
analysis_dependency = "golang.org/x/tools v0.52.0"
selection = "The release declares the Go analysis dependency that reads the module export data with Go 1.27.3."
config = ".golangci.yml"
modules = "The complete module inventory is linted independently."
files = ["services/launchpad/Makefile"]

[stage.race]
modules = "The complete module inventory is tested with the race detector independently."
synchronization = "The stats-workers commit acknowledgment fixture sets and reads transaction state under its mutex."
worker_limits = "The metadata raster case runs the production service executable under the worker limits."
files = ["services/launchpad/stats-workers/internal/httpapi/repair_m1040_test.go"]

[stage.cover_check]
money_minimum = "90.0%"
default_minimum = "85.0%"
profiles = "services/launchpad/.cover"
modules = "The complete module inventory receives a fresh profile for each run."
module_resolution = "Coverage totals resolve package paths from each module root."
files = ["tools/launchpad/coverage-gate.sh", "sdk/launchpad/protocol/catalog/bounds_test.go", "sdk/launchpad/shared/util/util_test.go"]

[stage.public_job]
workflow = ".github/workflows/launchpad-test.yml"
go = "1.27.3"
command = "make -C services/launchpad ci"

services = "PostgreSQL 16 with commit timestamps and Redis 7, plus the same fixtures and Go toolchain as the per-module test job."
timeout = "GOFLAGS=-timeout=15m"
checks = "tests/ci/test_launchpad_go_tests_wired.py verifies the public job, module inventory and current production test names."

object_storage = "MinIO RELEASE.2025-04-22T22-12-26Z is built from its tagged Go source and serves the shared object-storage fixture on port 9000."
broker_readiness = "The three NATS monitors expose the elected metadata leader; readiness requires both replicas to be current."
reward_schema_dependencies = "Both Go jobs install the reward schema fixture's locked PGlite and Solidity compiler dependencies."
timeout_minutes = 360

[database_requirements]
indexer = "Source capacity cases require PostgreSQL commit timestamps."
charts_measure = "The measurement command validates commit timestamp authority before connecting to the canonical RPC."

[media_requirements]
playback = "Both Go jobs install FFmpeg for licensed playback encoding and decoding cases."

[raster_requirements]
cgroups = "Cgroup isolation requires delegated memory, CPU and process controllers."

[delivery_requirements]
isolation = "Ordered delivery cases create and remove a dedicated PostgreSQL database so canonical source schemas remain isolated across modules and stages."
files = ["sdk/launchpad/shared/delivery/ordered_test.go"]

[scanner_requirements]
version_binding = "Both Go jobs install the ClamAV signature builder and daemon for scanner engine and signature revision binding cases."

[consumer_requirements]
pull_lifecycle = "A consumer keeps its single pull slot until the broker completes the request, including after caller cancellation, while retaining the configured caller deadline."
verification = "A real broker serves repeated empty pulls followed by an acknowledged publication with matching bytes and broker identity."
files = ["sdk/launchpad/shared/delivery/natsdriver/driver.go", "sdk/launchpad/shared/delivery/natsdriver/consumer_boundaries_coverage_test.go", "services/launchpad/pnl-tracker/internal/app/runtime_lifecycle_test.go"]

[readiness_requirements]
server = "Readiness checks have a two-second dependency deadline."
lifecycle = "The production lifecycle case uses a 200-millisecond HTTP client deadline."

[upload_requirements]
scanner = "Connected upload cases require an unavailable response when the scanner cannot be reached."

[coverage_profile_lifecycle]
cleanup = "Every coverage run removes visible and dot-prefixed profiles, including the SDK module profiles, before creating its manifest."
files = ["services/launchpad/Makefile", "tests/ci/test_launchpad_go_tests_wired.py"]

[coverage.shared]
baseline_percent = 90.1
baseline_source = "sdk/launchpad/shared/repair_22_39_475.kvx"
measured_percent = 90.0
threshold_percent = 90.0

[coverage.pnl_tracker]
baseline_percent = 91.02
baseline_source = "services/launchpad/pnl-tracker/repair_22_39_479.kvx"
measured_percent = 91.0
threshold_percent = 90.0

[coverage.stats_workers]
baseline_percent = 86.2
baseline_source = "services/launchpad/stats-workers/repair_22_39_481.kvx"
measured_percent = 86.2
threshold_percent = 85.0

[coverage.protocol]
baseline_percent = 90.4
baseline_source = "sdk/launchpad/protocol/repair_22_39_476.kvx"
measured_percent = 90.3
threshold_percent = 90.0

[coverage.metadata]
baseline_percent = 86.0
baseline_source = "services/launchpad/metadata/repair_22_39_485.kvx"
threshold_percent = 85.0
