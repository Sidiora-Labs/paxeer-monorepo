[repair.22.33.1006]
audit = "22.30.35"
base_revision = "caa8b41ee668274ee1e5c1df6691288455c46278"
finding_4 = "TestRepairM_1006_CorruptOldestRecovery; TestRepairM_1006_IndependentWorkClasses"
finding_15 = "TestRepairM_1006_FactoryReceiptChainBinding"
finding_6 = "TestRepairM_1006_QuarantinePrivacy"
runtime = "Each scan attempt commits a 30-second private-until retry deadline before dependency IO; terminal integrity, key, size, decode and malware failures atomically persist REJECTED with 24-hour retention, successful promotion clears the deadline, and other items continue after temporary errors."
timestamp = "The existing asset_details_v2.rejected_until timestamptz is state-qualified: for pending or incomplete APPROVED rows it means next eligible scan; for REJECTED rows it means retention expiry. Existing expiry consumers select only REJECTED, so no schema migration or runtime DDL is needed."
scheduling = "Scan, account maintenance, accepted publication and rejected retention run independently with 12, 12, 15 and 4 second budgets inside the existing 20-second maintenance job; errors remain observable."
privacy = "Development requires an explicit distinct quarantine bucket, the production ACL and policy checks, unsigned listing and missing-key denial, and unsigned 403 reads of newly written known objects in both token and account quarantine namespaces; probes are removed on success and failure."
factory = "The v2 fixture consumes an unchanged deployed factory receipt with the matching real indexer's retained pools, canonical creation, completeness and raw-log output; the dynamic-wallet fixture reads the maintained EventEmitter ABI instead of duplicating it."
chain = "Development startup verifies eth_chainId=125 and the receipt boundary rechecks it before each receipt RPC; the proving test obtains chain IDs from actual in-process geth nodes on 125 and 1337 and requires the mismatched HTTP consumer to return 503 without requesting a receipt."
baseline = "The inspected gate ledger had builds_used=0 and verify_runs_used=0 and no earlier repair tests. No pre-change verification ran: the explicit task order prohibits testing until implementation is complete and permits the verify command only through hf-done after hf-build. No baseline failures are claimed."
proof = "All repair tests run without environment variables, credentials or external binaries: real pgx/ProductionStore, publication worker, identity resolver, canonical decoder, raster worker, scanner and S3 clients communicate with committed protocol transcripts and loopback store peers. Restart closes the pool and transport and reloads committed JSON state after discarding process memory."
fixture_factory = "testdata/repair_m1006_factory.json is copied unchanged from internal/metadata/testdata/paxeer125-creation-0x0f92fdd0.json."
fixture_indexer = "testdata/repair_m1006_indexer.json retains unchanged row values from services/launchpad/pnl-tracker/internal/production/l16/testdata/indexer_real_market/creation.json for the real indexer's pools, canonical creations, completeness and raw logs."
wiring_request_6 = "services/launchpad/metadata/internal/metadata/dev_connected.go — owner domain 4 (launchpad metadata): replace DevelopmentObjectsReadiness's authenticated-HeadBucket-only contract with the mandatory private-policy and known-object anonymous-denial contract enforced by this app; the app no longer uses that weaker helper."
wiring_request_15 = "services/launchpad/indexer/internal/decode and internal/processor — owner domain 4 (launchpad indexer): expose an importable in-process receipt-to-canonical-row fixture harness so app tests can replay the tracked factory receipt through current indexer internals instead of consuming their retained output."
qualification = "The runner's hf-build/hf-done ledger records the verified candidate revision, literal command, exit code and private evidence log; final reporting copies the last gate record without claiming any other gate."
gotcha_1 = "The bounded gate order overrides the conflicting pre-change verify step; never spend an extra verify run or claim an unexecuted baseline."
gotcha_2 = "The indexer's internal Go packages cannot be imported by the metadata module; retain actual producer output as the allowed transcript peer and request an importable owning-domain harness rather than copying the implementation."
gotcha_3 = "PostgreSQL wire fixtures must emit the driver's PostgreSQL timestamp and bytea text encodings; timestamps use an explicit +00 offset."

[qualification.attempt_1]
revision = "6dabff1355bcacbd9e642ab763e5078a8c51a577"
command = "cg spec done 22.33.1006 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The loader incorrectly equated the receipt's log count with the indexer's raw-log count: the tracked receipt has exactly 15 logs and the retained indexer stream has exactly 14; the repaired loader checks both exact counts and every retained log's position, data and topics."
