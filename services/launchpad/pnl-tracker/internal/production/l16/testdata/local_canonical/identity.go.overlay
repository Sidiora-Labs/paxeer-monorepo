package main

import (
	"context"
	"crypto/rand"
	"encoding/hex"
	"encoding/json"
	"io"
	"net/http/httptest"
	"os"
	"path/filepath"
	"strings"
	"time"

	owner "github.com/Sidiora-Technologies/KindleLaunch/media/gateway/internal/auth"
	sharedauth "github.com/Sidiora-Technologies/KindleLaunch/shared/auth"
	"github.com/ethereum/go-ethereum/accounts"
	"github.com/ethereum/go-ethereum/crypto"
	"github.com/ethereum/go-ethereum/ethclient"
	"github.com/go-chi/chi/v5"
	"github.com/jackc/pgx/v5/pgxpool"
)

func check(err error) {
	if err != nil {
		panic(err)
	}
}

func main() {
	ctx := context.Background()
	config, err := pgxpool.ParseConfig(os.Getenv("L16_FIXTURE_ADMIN_DSN"))
	check(err)
	config.MaxConns = 4
	config.ConnConfig.RuntimeParams["search_path"] = "gateway_identity,pg_catalog"
	pool, err := pgxpool.NewWithConfig(ctx, config)
	check(err)
	defer pool.Close()
	_, err = pool.Exec(ctx, "CREATE SCHEMA gateway_identity")
	check(err)
	source, err := os.ReadFile(filepath.Join(os.Getenv("L16_FIXTURE_ROOT"), "services/launchpad/gateway/internal/devidentity/migrations/00001_identity.sql"))
	check(err)
	up, _, ok := strings.Cut(string(source), "-- +goose Down")
	if !ok {
		panic("identity migration boundary required")
	}
	_, err = pool.Exec(ctx, up)
	check(err)
	rpc, err := ethclient.DialContext(ctx, os.Getenv("L16_FIXTURE_RPC"))
	check(err)
	defer rpc.Close()
	secret := make([]byte, 48)
	_, err = rand.Read(secret)
	check(err)
	check(os.Setenv("L16_FIXTURE_IDENTITY_SIGNING_KEY", hex.EncodeToString(secret)))
	now := time.Now()
	tokens, err := owner.NewIdentityTokens("https://kindle.test", "kindle-owner-v2", "local-canonical", []owner.SigningKey{{ID: "local-canonical", SecretReference: "L16_FIXTURE_IDENTITY_SIGNING_KEY", ActiveAt: now.Add(-time.Minute), RetireAt: now.Add(time.Hour)}}, owner.EnvironmentIdentitySecrets{}, time.Now)
	check(err)
	identity, err := owner.NewIdentity(owner.IdentityConfig{Pool: pool, Domain: "kindle.test", URI: "https://kindle.test/auth", AllowedOrigins: []string{"https://kindle.test"}, Verifier: owner.Chain125ProofVerifier{Backend: sharedauth.NewReportedHashBackend(rpc.Client())}, LimiterKey: secret, Tokens: tokens})
	check(err)
	router := chi.NewRouter()
	serviceToken := hex.EncodeToString(secret)
	check(identity.RegisterV2Routes(router, owner.IdentityHTTPConfig{ServiceToken: serviceToken}))
	server := httptest.NewServer(router)
	defer server.Close()
	key, err := crypto.HexToECDSA(os.Getenv("L16_FIXTURE_WALLET_KEY"))
	check(err)
	wallet := strings.ToLower(crypto.PubkeyToAddress(key.PublicKey).Hex())
	challenge, err := identity.IssueLogin(ctx, owner.ChallengeRequest{Wallet: wallet, Origin: "https://kindle.test"}, "127.0.0.1")
	check(err)
	signature, err := crypto.Sign(accounts.TextHash([]byte(challenge.Message)), key)
	check(err)
	signature[64] += 27
	credentials, err := identity.Login(ctx, owner.LoginRequest{ChallengeID: challenge.ChallengeID, Proof: owner.WalletProof{Kind: "eoa_eip191", Wallet: wallet, Signature: "0x" + hex.EncodeToString(signature)}, DeviceLabel: "Local portfolio"})
	check(err)
	check(json.NewEncoder(os.Stdout).Encode(struct{ URL, ServiceToken, AccessToken string }{server.URL, serviceToken, credentials.AccessToken}))
	_, err = io.Copy(io.Discard, os.Stdin)
	check(err)
}
