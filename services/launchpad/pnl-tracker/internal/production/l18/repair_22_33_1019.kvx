native_execution = "Go execution is not qualified by this Python-only gate: the task simultaneously requires executing production Go paths and forbids the toolchain/native artifact needed to do that. The declared pytest module executes production Python input/listener logic and its actual environment-binding statement; Go source contracts check implementation and native proof wiring only. They are not runtime reward, restart, PostgreSQL or NATS qualification. No subprocess, toolchain, environment input, credential, native artifact or external endpoint is required by the declared gate."
native_peers = "Native test declarations use production JourneyService, Creator, pgx/pgproto3, mounted HTTP, delivery.Store, delivery.Relay and natsdriver.Publisher with committed in-memory records and loopback JSON-RPC/PostgreSQL/NATS peers; no test invokes a subprocess or external server. Acknowledgements traverse real NATS request/reply frames. These declarations have not been compiled or executed by the permitted Python build/verify commands."
delivery_contract = "l18_outbox.published_at marks transactional handoff to delivery_outbox, whose existing fenced leases, immutable envelope, persistence acknowledgements, retry budget and quarantine own subsequent delivery. Event IDs hash the full schema/local identity/topic; source_order uses height 0, transaction index 0 and the local sequence, while canonical chain evidence remains in the original payload."
wiring_request_grants = "launchpad/spec/production-system/integration/migrations/grants.json (owning domain 4, launchpad shared database): register only UPDATE(published_at) on pnl.l18_outbox for pnl_runtime using l18.OutboxRuntimeGrantSQL; retain SELECT/INSERT and sequence grants, no UPDATE of identity/topic/payload/sequence; startup fails closed until this owner-applied grant exists."
wiring_request_broker = "services/launchpad/security/policy (owning domain 4, launchpad delivery/security operations): admit the exact 18 subjects enumerated by l18.RewardDeliveryPolicy in the configured journey broker stream and pnld publisher ACL, with consumer durable/ACL admission for its owning projections."
wiring_request_native_gate = "spec/layerx-merge/spec.kvx task.22.33.1019 (owning domain 4, launchpad task qualification): reconcile the Python-only gate/no-native-artifact constraint with the required production Go execution; run the authored TestRepair1019 cases under an admitted Go gate before claiming behavioral closure."
gotcha = "The existing qualification CLI supplied L18_POSTGRES_DSN while the l18 storage peer consumes PNL_TEST_POSTGRES_DSN; bind both explicitly to the admitted operator DSN. No default database or credential is introduced."
scope = "Runner-prepared .cgignore and spec status changes are preserved without edits. This task edits no spec, root gotcha ledger, grant manifest or broker deployment; required out-of-scope work is listed above. No manual commit or push is performed."
