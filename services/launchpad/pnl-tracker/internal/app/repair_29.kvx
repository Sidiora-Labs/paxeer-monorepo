command = "cg spec done 22.31.29 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Readiness passes; the contract compiler rejects imports with Callback not supported, so include the complete transitive production source input instead of relying on a callback."

[repair.continuation]
implementation = "Preserve the app.go admission and health checks, isolated migration-backed database recovery proof and all existing assertions; load the full Solidity import closure, including named imports, and assert unmigrated admission neither provisions tables nor fails for an unrelated reason."
environment = "The retained PGlite WASM engine runs in an owned local Node host, not inside the Go process; the chain executes in-process in go-ethereum and no PostgreSQL service, Anvil executable, credentials or live RPC endpoint is used."
gotcha = "A failed embedded-store startup must reap its process before reading captured stderr, and mark it stopped so cleanup does not signal an already exited child."

