exit = 1
log = "/out/logs/verify-1.log"
observed = "The existing TestProofLaunchpadPnlTracker and new recovery proof cannot start because anvil is absent from PATH; the unrelated environment prerequisite is recorded, not replaced or skipped."

[repair.cycle1]
observed = "proofLaunchpadPostgres applies the legacy migration, which already creates pnl; use that schema when applying the real reward migrations."

[repair.attempt2]
implementation = "Retain app.go admission and readiness checks; replace external-infrastructure repair proofs with real deployment SQL, pgx storage and an in-process chain, preserving every schema/type/key/privilege refusal assertion."
baseline = "Attempt 1 verification failed before this continuation: TestRepair_29_RewardRequestSchemaRecovery required Anvil and readiness encountered an existing pnl schema; its recorded evidence above is retained, not rerun."
dependencies = "Install the pinned test-only PGlite/socket and Solidity compiler dependencies from internal/app/testdata/repair29/npm-shrinkwrap.json; the Go verification starts only temporary embedded engines and owns each schema and database directory."
gotcha = "PGliteSocketServer is an EventTarget, and its ephemeral listener address is available from getServerConn after start; it is not a Node EventEmitter."
gotcha_dependencies = "The gate snapshots all files under a directory touch, including ignored node_modules; keep installed dependencies in an external cache through a local directory symlink, and publish the pinned npm shrinkwrap with its test manifest."

[repair.attempt2_qualification]
