observed = "Readiness passed; the simulated swap reverted after a latest-block gas estimate underpriced the next block's ERC20 checkpoint storage appends."

[repair.pending_estimate]
implementation = "Estimate fixture transactions through the real node's eth_estimateGas at pending before mining, preserving receipt-success assertions and avoiding any arbitrary gas padding or bound change."
gotcha = "ERC20 checkpoint transfers can update an existing checkpoint during latest-block estimation but append new storage during next-block execution; gas must be estimated against the pending execution block."
