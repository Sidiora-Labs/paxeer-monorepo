[repair.22.33.917]
finding = "reward-proof-schema"
status = "implemented-not-qualified; finding remains open until the declared tests execute and pass"
implementation = "Register 180001 with a source-bound reward approval, frozen reader interface digest, reader minimum, transactional lock ceiling and existing rollback/backfill policies; preserve other migrations' admission requirements. Both retained chain proof and bounded tests provision request/audit storage through production.ApplyCoordinatedMigration, after source-checked coordinator bootstrap of the legacy predecessors."
tests = "TestRepairM_917_FreshInstallMigrationContract; TestRepairM_917_ExistingSchemaUpgradeMigrationContract; TestRepairM_917_ApprovalBindings"
proof = "Fresh and reopened existing schemas run the real pgx coordinator, runtime admission, epoch-fenced ledger, committed creator, signed HTTP preparation and v2 decoder against loopback database/RPC peers. Close and reconstruct the database peer from durable bytes and reopen the production service; assert byte-identical replay and unchanged request/audit/outbox identities, deployment digests and legacy business state. Conflicting bodies and changed ownership refuse replay without writes; malformed producer responses are refused by the real decoder."
fixture = "The pgwire peer is an in-process source-bound catalog and durable row store, not a PostgreSQL engine or a lock-contention qualification. It accepts only registered DDL bytes under the real coordinator's owner transaction/locks/timeout; the existing actual-chain/PostgreSQL proof retains all ownership, damaged-response and reopen assertions and now uses the same migration entry point."
baseline = "The supplied attempt-1 ruling records TestRepairM_917_FreshInstallMigrationContract and TestRepairM_917_ExistingSchemaUpgradeMigrationContract failing registry admission at candidate 813ceb8b4784ebc9071cd3b48c770446a358a84c. This continuation preserves that evidence; implementation-first and hf-done-only instructions prohibit an extra unchanged verification."
evidence = "The verified revision, exact command, exit and private log are recorded in /out/run/gates.jsonl by hf-build/hf-done and copied to the final evidence line; this candidate is not edited after qualification."
approval_scope = "pnl-reward-approval.json admits only 180001; the full registry remains implemented-not-qualified and unrelated registrations still lack their own safety metadata. estimated_lock_ms=2000 is the declared coordinator ceiling, not a claimed PostgreSQL measurement."
wiring_request = "Domain 4 launchpad / L07 deployment owner: launchpad/spec/production-system/integration/migrations/readiness.json and the operator EXPECTED_SCHEMA attestation must bind migration 180001 and grants.json to the deployed catalog before production reward routes admit traffic; deployed qualification is outside this bounded gate."
gotcha = "A registry entry and direct DDL are insufficient: the production coordinator also needs migration_control history/attempts and checksum-bound predecessor rows; bootstrap those before applying 180001, and keep SET LOCAL ROLE inside its transaction."
gotcha_fixture = "Changing registry bytes requires refreshing the bound registry_sha256 of internal/production/l18/testdata/repair_62/catalog.json while preserving all recorded source checksums and catalog objects."

