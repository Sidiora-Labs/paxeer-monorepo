[task.22.33.980]
finding = "card-unavailable-as-zero"
repair = "Archive snapshots preserve optional basisQuality and pricingQuality fields through decoding and transport; incomplete or unrecognized explicit quality renders Unavailable. Required missing, malformed, negative unsigned or noncanonical numeric evidence renders distinct unavailable figures instead of fabricated zero or a nil-integer panic. Legacy snapshots without quality extensions retain their archived arithmetic only when the numeric evidence is present and valid."
tests = ["TestRepairM_980_MissingAndMalformedMarks", "TestRepairM_980_BasisAndPricingQuality", "TestRepairM_980_MissingAndMalformedPositionEvidence", "TestRepairM_980_ExactValuesAndClosedPosition", "TestRepairM_980_MintRemainsRetired"]
proof = "Positions originate from production pnlmath.Fold; production JSON encoding, Service.DecodeArchive, shared/http.WriteJSON over loopback TCP, consumer JSON decoding, BuildRenderInput and ogrender.Render prove evidence preservation and observable unavailable output. PNGs decode to the required dimensions and unavailable marks produce different images from priced evidence. Exact large integers, signed loss, explicit zero mark and no-exposure closed positions retain their calculated results. Mint remains retired without touching persistence."
baseline = "No earlier gate ledger or implementation existed at session start; no baseline failures are claimed. The explicit Order forbids testing before complete implementation and forbids running verify_cmd by hand, so it takes precedence over do_5's contradictory unchanged-tree run request."
existing_test = "TestBuildRenderInputLossNoMarket now supplies explicit received=0 in its synthetic closed-position fixture; every original assertion remains unchanged and missing receipts are separately required to render Unavailable."
evidence = "hf-build and hf-done record exact candidate revision, command, exit and private log location; qualification requires both gates to pass on the same candidate."
wiring = "None: legacy minting is already retired and existing HTTP rendering forwards the distinct unavailable labels without an interface change outside this directory."
gotcha = "The legacy pnlmath parser accepts empty strings as fold initialization, but archive rendering must validate required evidence before calling it; zero spent is an undefined ratio, missing mark is unnecessary only for explicitly zero holdings, and malformed received values must never reach big.Int.Add as nil."
