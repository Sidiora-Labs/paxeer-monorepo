[task.22.31.45]
finding = "legacy-card-link"
repair = "Retire legacy Mint with ErrMintRetired before any store access, card creation or referral creation; archived reads retain their snapshot and OG URL but emit no public landing URL."
tests = ["TestRepair_45_LegacyMintRetired", "TestRepair_45_ArchivedDisclosurePreserved"]
proof = "Real Service with an unconfigured Store and clock, mounted httpapi.RegisterCards routes, TCP HTTP transport and decoded error consumer prove retirement without accessing persistence or emitting disclosure links; the production archive codec, JSON response codec and renderer preserve historical payloads without a landing URL. The updated service-bound TestMintCapturesSnapshotAndPersists retains folded-position, zero-publication-write and persisted-archive round-trip coverage."
lifecycle = "Legacy addresses and short codes are never promoted into v3 publication UUIDs; no replacement disclosure is created without the v3 owner approval, field selection, expiry and revocation lifecycle."
baseline = "Continuation seed 094556123abe96ebd6a17df634955abe75dd83b7 records prior failures in TestMintCapturesSnapshotAndPersists and TestMintRejectsMissingPosition because their legacy mint expectations conflict with ErrMintRetired. No unchanged gate was repeated: the controlling Order permits only hf-build followed by hf-done after implementation; this attempt started without a gate ledger."
continuation = "Both existing Mint tests now require a nil disclosure and ErrMintRetired; the positioned test additionally requires zero card/referral writes, unchanged holdings and exact archive hydration. No test is deleted or skipped; focused repair tests require no external services."
evidence = "The private hf-done ledger records the exact candidate revision, command, exit code and log; build and verify must name the same candidate before qualification."
qualification_repair = "The first focused verification exposed an incorrect test expectation: shared/http.WriteError masks every 5xx message as An unexpected error occurred. The test now requires that exact transport message alongside the exact 500 status, error name and absence of disclosure fields or redirects."
wiring_http = "Domain 4 / fm-launchpad: services/launchpad/pnl-tracker/internal/httpapi/cards.go must map card.ErrMintRetired to HTTP 410 and direct owners to the v3 preview/publish workflow; the current generic error handler masks retirement as HTTP 500."
wiring_tests = "Domain 4 / fm-launchpad: services/launchpad/pnl-tracker/internal/httpapi/cards_test.go must reconcile legacy successful-mint expectations with retirement without dropping archive persistence and rendering coverage."
wiring_web = "Domain 4 / fm-launchpad: apps/launchpad/web/src/app/pnl/[cardId]/page.tsx and apps/launchpad/web/src/widgets/pnl/share-transport.ts must keep the UUID-only v3 publication landing contract and route creation through owner-approved v3 preview/publish; historical short-code landing support requires a separately reviewed resolver and lifecycle contract."
