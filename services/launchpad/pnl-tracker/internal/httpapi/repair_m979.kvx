[task.22.33.979]
mode = "BUILD"
findings = ["legacy-card-publication-policy", "legacy-webhook-body-bound"]
legacy_card_publication_policy = "TestRepairM_979_LegacyCardPublicationRetired proves the real registered route returns 410 before reading arbitrary owner, preview-like, malformed or empty input; no disclosure or redirect is emitted and no persistence is initialized."
legacy_webhook_body_bound = "TestRepairM_979_WebhookBodyBound, TestRepairM_979_WebhookRawHMACAndBoundaries, TestRepairM_979_WebhookEventBatchBound and TestRepairM_979_WebhookMalformedAndUnauthorized prove the real HMAC middleware, request codec, registered handler and dispatch path enforce a 1 MiB body budget and 1000-event budget, preserve exact signed bytes, reject chunked unauthenticated oversized input and reject over-budget batches before any dispatch."
archive_compatibility = "Retain the immutable legacy archive contract established by prerequisite 22.31.45: GET /pnl/cards/{cardId} returns only the previously stored disclosure with an empty shareUrl; GET /pnl/cards/{cardId}/og.png renders/caches that same immutable disclosure. No legacy mint, short-code resolver, v3 publication or new landing URL is issued. TestMintAndHydrateCard retains persisted archive, owner, snapshot, PNG, cache and hydration coverage and adds zero-publication-write and unchanged-position assertions after retirement."
publication = "POST /pnl/cards always returns 410 with no-store and names the owner-approved v3 preview/publish workflow, independently of supplied body or credentials; owner authentication, disclosure selection, intent, expiry and revocation remain exclusively in v3."
baseline = "No prior hf-build/hf-done ledger or repair tests existed at session start. No unchanged baseline verify was run: the controlling Order requires complete implementation before qualification and explicitly forbids running verify_cmd by hand. No baseline test failure is claimed."
evidence = "The private hf-done gate ledger and final JSON record the exact verified candidate revision, command, exit and log; hf-build and hf-done must qualify the same unchanged candidate."
wiring_card_test = "Domain 4 / fm-launchpad: services/launchpad/pnl-tracker/internal/card/repair_45_test.go TestRepair_45_LegacyMintRetired asserts the prior HTTP 500 Internal Server Error/masked message; reconcile its transport expectations with this task's explicit 410 Gone retirement while retaining every disclosure and persistence assertion. This file is outside scope and was not changed or run."
gotcha_baseline = "The task's baseline-verification step conflicts with its controlling implementation-first and gate-only Order; follow that Order and record the absence of baseline evidence."
gotcha_prerequisite = "The prerequisite retired card.Service.Mint before HTTP registration was repaired; preserve archive read/render tests using stored legacy fixtures, rather than attempting to mint new fixtures through the retired route."
