[repair.22.33.1015]
audit = "22.30.36"
legacy-consumer-path-test = "TestRepairM_1015_ProducerWebhookRestart; TestRepairM_1015_WebhookAuthentication; TestRepairM_1015_ProducerFixtureContract; TestProcessIndexerWebhookAfterStoreReopen"
baseline = "No earlier hf-build/hf-done ledger existed at intake, and no TestRepairM_1015_ functions existed. No baseline failure is claimed: the explicit ordered bounded gates prohibit the contradictory unchanged-tree verify requested by do_5."
implementation = "Extend consumer_test.go with a signed, serialized legacy indexer webhook journey through the production mounted HTTP handler, Consumer.ProcessEvent, Store.FoldTrade, pnlmath, cache invalidation and PublishJSON. Stop the HTTP receiver and pgx pool, reopen a new store and consumer, read recovered rows, and replay the identical producer bytes."
coverage = "Buy and sell raw USDL/token units, all trade identities and source coordinates, resolved token address, remaining holdings and signed realized PnL, exactly one trade per emission after both restarts, both user caches invalidated, unrelated/immutable caches retained, actual subscribed pnl:update payload, no repeat invalidation or publish on redelivery, missing/tampered/expired HMAC refusal with no state change."
peer_boundary = "The repaired Consumer, mounted webhook handler, pgx Store and Redis client are production code. In-process loopback PostgreSQL/RESP peers store the actual production INSERT/SET arguments and deliver actual pub/sub bytes. The PostgreSQL peer contains no position folding, amount conversion, cache invalidation or notification implementation. No running PostgreSQL/Redis server, environment setting, subprocess or external tool is used by TestRepairM_1015_*."
producer_fixture = "testdata/repair_m1015/record_indexer.go.overlay records the real indexer Decoder -> ProcessBatch -> PostgreSQL Store -> HMAC Publisher request bodies. The source logs use the historical EventEmitter ABI with identities and amounts from the committed real-market indexer rows; they do not claim those transactions historically emitted the legacy ABI. Provenance binds captured bytes to the producer source revision and SHA-256. The recorder is offline tooling and is never invoked by the gate."
fixture_capture = "The offline recorder ran once with go run -overlay /tmp/repair-m1015-producer-overlay.json ./internal/record_m1015 from the indexer module, with -input pointing to the committed traded.json, -out to this task's testdata/repair_m1015, and -revision caa8b41ee668274ee1e5c1df6691288455c46278. It exited 0 after recording the real publisher's buy/sell request bodies and checking the producer's committed swap rows. This resource-generation compile is separate from the prescribed task qualification gates."
wiring_request = "services/launchpad/pnl-tracker/internal/httpapi/webhook_test.go (domain 4, launchpad/pnl-tracker HTTP): adopt this committed producer-byte restart journey in the owning webhook integration proof; the scoped position test already mounts the unmodified production RegisterWebhook handler."
wiring_request_producer = "services/launchpad/indexer/internal/processor/processor.go and internal/publisher/publisher.go (domain 4, launchpad/indexer): retain an owning legacy producer fixture export/regeneration proof so consumer modules need not bypass Go internal-package boundaries."
gotcha = "The task's scope forbids spec/ and root GOTCHA.kvx changes, so its baseline contradiction, internal-package capture boundary and wiring requests are recorded here. Existing .cgignore and spec status changes are runner setup and are preserved."
gotcha_format = "A repository-relative gofmt invocation from the indexer module found no matching paths; use absolute paths when a command changes working directory. The touched Go sources were formatted successfully before qualification."
qualification = "The exact candidate revision, declared command, exit code and private log location are recorded by hf-build/hf-done in /out/run/gates.jsonl and copied verbatim in the final evidence JSON. No source changes follow a passing hf-done."

[qualification.22.33.1015.repair1]
revision = "9a64ee56baf4119f565b9bbcb868f2eaf606d926"
command = "cg spec done 22.33.1015 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Fixture provenance and all webhook authentication cases passed; the restart journey failed because the peer expected Go bool literals instead of PostgreSQL bool text."
assumption = "pgx convertSimpleArgument encodes bool through pgtype's text codec before quoting it, yielding t/f; validate and store that exact representation, preserving every journey assertion."
