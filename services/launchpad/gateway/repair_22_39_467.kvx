# Media gateway source and boundary checks.

[gateway]
component = "media gateway"
behavior = "Gateway request, response, storage, and identity boundaries retain their declared values."

[checks]
bodyclose = "11 response bodies are closed at their call sites."
dogsled = "1 request result has an explicit outcome check."
errcheck = "80 returned errors are handled or reported."
goconst = "117 repeated values use package constants."
goimports = "18 import groups follow the module format."
gosec = "19 boundary findings have guards or site-specific rationale."
prealloc = "1 route list reserves its known capacity."
staticcheck = "9 expressions use the supported forms."
unconvert = "1 CPU duration expression uses its native type."

[comment.1]
site = "internal/app/app.go:808"
reason = "The configured TLS file is regular, size bounded, and digest verified."

