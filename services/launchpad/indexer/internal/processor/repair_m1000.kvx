[repair.22.33.1000]
audit = "22.30.33"
base = "8d3c6f05d482687fa70aa669e1b839d9cebf02bd"
baseline = "The working tree had no scoped implementation and repair_m1000_test.go did not exist; the private gate ledger had zero build and verify runs. No pre-change failing tests are claimed. The explicit implementation-first bounded gate order supersedes step 8's request for an extra unchanged verification."
evidence = "The final hf-done line and /out/run/gates.jsonl contain the candidate revision, exact command, exit code and private log location. No test success is claimed before that gate."

[finding.native-feeflow-test-path]
test = "TestRepairM_1000_NativeFeeFlow"
path = "Native ABI encoder -> signed transaction and receipt wire -> approved RPCQualification registry -> issued QualifiedReceipt -> projectQualifiedLegacy -> transactional production SQL -> database reopen and immutable replay reconciliation."
assertions = "Kind 4 writes exactly one claim with exact amount, holder, epoch, transaction and log identity; kind 1 writes none; a failure at the canonical commit boundary rolls back the claim; a reopened database retains identical rows and rejects duplicate commit."
boundary = "The native ABI codec produces the fixture. This does not claim execution of the native keeper; the gate requires no native artifact or toolchain."

[finding.live-test-generation]
test = "TestRepairM_1000_LiveGeneration"
epoch_test = "TestRepairM_1000_TreasuryCodeEpoch"
native_test = "TestRepairM_1000_NativeFeeFlow"
path = "Approved deployment history selects anchor manifests and divides ranges at activation boundaries; recorded historical RPC runs through the production committed source and receipt authority into real PostgreSQL. The separate current native case exercises its own approved registry and PostgreSQL persistence."
assertions = "The default historical anchor selects the historical deployment; the historical segment ends immediately before current activation, the native segment includes activation, and actual historical creation, accounting fill and watermark persist."

[finding.measurement-refusal-mask]
test = "TestRepairM_1000_MeasurementRefusals"
guard_test = "TestRepairM_1000_ChangedCandidate"
path = "Run validates a digest-pinned topology and actual candidate file before independent provider refusals; the complete provider fixture passes provider admission before any collaborator is removed."
assertions = "Each required collaborator or binding is independently omitted, its exact error is asserted, and no capture, start timestamp, transaction count or capture digest exists; changed-source rejection is a separate test."

[finding.inventory-real-consumer-proof]
test = "TestRepairM_1000_InventoryDurableFrames"
status = "wiring-required"
path = "The actual recorded source, receipt authority, canonical producer and durable publisher write an inventory frame bound to the committed PNL-issued baseline fixture; a database restart and source fence change preserve its bytes, and the old source lease cannot renew."
limitation = "This proves producer and durable transport only. AccountingConsumer.PrepareAndConsume and BaselineAuthority are under the sibling module's internal import boundary; no public PNL bridge exists, so actual inventory/cost and baseline-use consumer proof remains unavailable inside this scope. The older consumeAsPnl checks are explicitly labelled partition-contract unit checks."
wiring_request = "services/launchpad/pnl-tracker/production/l16 — owning domain 4: expose aliases/constructors for the real AccountingConsumer and BaselineAuthority so processor tests can invoke PrepareAndConsume, inspect inventory/cost and persisted baseline uses, and repeat across restart and source fence changes without copying internal implementation."
source_fence = "BaselineAuthority.sourceLease holds FOR SHARE until the consuming transaction finishes, preventing the named source fence from changing between proof qualification and baseline-use persistence."

[gotcha.internal-boundary]
observed = "Allowing edits to baseline.go does not make its Go internal package importable from indexer."
resolution = "Record the public bridge as an owning-domain wiring request instead of adding a duplicate consumer, linkname bypass, subprocess toolchain, mock or silent fallback."

[qualification.initial]
revision = "e9cd6483fd99b91d8c6e5f3724c10ec3722e3c86"
command = "cg spec done 22.33.1000 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Build passed; native FeeFlow and changed-candidate tests passed; historical live, inventory and measurement tests refused historical receipt authority construction."
repair = "Supply the untrimmed approved catalog and exact supplemental Treasury epoch, select historical beacon-proxy pool discovery, and replay source-owned producer responses; derive address-filtered logs only from complete recorded blocks and their original receipts."

[wiring.historical-source]
request = "services/launchpad/indexer/internal/receipt/testdata/repair53-producer.json — owning domain 4: capture authenticated Treasury proxy code, implementation slot and implementation code pinned to historical buy block 33963733; the packet currently supplies those identities at creation and later generations only."
constraint = "Do not substitute state from another block, remove the Treasury emitter, or weaken the creation, fill and durable frame assertions. Final qualification remains subject to the bounded gate."
resolved = "The in-scope testdata/repair_m1000_treasury.json now records all three exact pinned state reads at creation and buy from public archival node 2; replay rejects any conflict with the original transcript."

[qualification.continuation-source]
base = "90c597177fcfcac6653ca7effb29d994ae45b128"
request = "https://api1.mainnet-beta.paxeer.network/ eth_getCode [0xBb82d74E071e03d8E68F1d78Fae9EFe8b6b7A723,0x2063ec4]"
observed = "The public node returned JSON-RPC -32000: requested height 33963716 has been pruned; earliest available is 42534998. EIP-1898 reads at the original creation and buy block hashes returned block not found by hash."
fixture = "The committed repair53-producer.json already records Treasury proxy code, implementation slot and implementation code at creation block 33963716 (0x81a18d822e327fbcbfe2be91b7f666bfa043016cb0e3f094c5bbabe91f9d192b); it does not contain Treasury state at buy block 33963733."
constraint = "Keep the exact approved Treasury epoch, require each original block-pinned response and preserve every assertion; neither a pruned-state error nor creation-block state supplies the missing buy-block evidence."
wiring_request = "services/launchpad/indexer/internal/receipt/testdata/repair53-producer.json — owning domain 4: obtain an authenticated archival recording of Treasury proxy code, implementation slot and implementation code at buy block 33963733; the requested public node no longer serves that history."

[qualification.continuation-public-node]
request = "https://api1.mainnet-beta.paxeer.network/ eth_getCode [0xBb82d74E071e03d8E68F1d78Fae9EFe8b6b7A723,0x2063ec4]"
response = "JSON-RPC -32000: requested height 33963716 has been pruned; earliest available is 42538451."
private_evidence = "/tmp/repair-m1000-treasury-public.json"
implementation = "Retain the exact committed creation-block code, implementation slot and implementation code; independently qualify the Treasury source logs and receipt binding at block 33963716 with TestRepairM_1000_TreasuryCodeEpoch, and log exact missing replay keys without substituting state across blocks."

[qualification.continuation-initial]
revision = "eb6ff4a4f4f0e6488a37206ff49eb6c9073c11de"
command = "cg spec done 22.33.1000 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Treasury creation, native FeeFlow, measurement refusals and changed-candidate passed; live-generation and inventory failed on the unrecorded Treasury eth_getCode at buy block 33963733."
repair = "Capture exact Treasury proxy code, implementation slot and implementation code from https://api2.mainnet-beta.paxeer.network/ at the original creation and buy block hashes, check chain ID and block identities against the committed transcript, and merge the new in-scope fixture with conflict rejection."

[continuation.attempt-4]
base_revision = "b664b08b724ec5b190920b99ba70b283c8a796c9"
baseline = "The supplied attempt-3 gate failed TestRepairM_1000_LiveGeneration and TestRepairM_1000_InventoryDurableFrames on Treasury code qualification; the continuation starts with no current gate ledger and does not repeat an unchanged gate."
fixture = "testdata/repair_m1000_batches.json preserves historical block, receipt, log and pinned state responses from the committed repair53-producer transcript; testdata/repair_m1000_treasury.json preserves exact creation and buy block-hash-pinned Treasury proxy, implementation slot and implementation code replies. No live endpoint or recording mode is used by replay."
proof = "TestRepairM_1000_TreasuryCodeEpoch qualifies both creation 33963716 and buy 33963733 through the real authority, checks every block and receipt binding, and requires Treasury provenance at each original block. LiveGeneration and InventoryDurableFrames consume the same committed replay through real processor and SQL paths with every inherited assertion retained."
gotcha = "Historical JSON-RPC headers may encode an empty transaction list as null, and block-receipt selectors may use EIP-1898 objects; transcript selection preserves those responses unchanged."
external_interface = "The public PNL bridge wiring request above remains open; passing producer/transport tests does not establish the out-of-scope inventory/cost consumer proof."
evidence = "The last hf-done line and /out/run/gates.jsonl supply the exact candidate revision, command, exit and private log. No completed gate is claimed in advance."

[qualification.attempt-4.first-pass]
revision = "0eea57581d3a92d54569ce0156d419a1ed99ff6b"
command = "cg spec done 22.33.1000 -f layerx-merge --root /work/paxeer-monorepo"
