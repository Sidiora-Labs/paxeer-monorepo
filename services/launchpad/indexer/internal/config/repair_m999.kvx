proof = "Receipt qualification additionally requires both distinct native and tenant swap transaction identities from the committed producer packet to appear in the qualified backfill result."
baseline = "The supplied previous attempt passed TestRepairM_999_ProductionBackfillDefault and failed TestRepairM_999_ReceiptQualifiedBackfill on an explicit zero-sender request; no unchanged-tree gate is repeated."
