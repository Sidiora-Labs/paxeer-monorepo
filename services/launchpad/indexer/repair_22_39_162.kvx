[qualification]
build = "hf-build; exact candidate revision, command, exit and private log in /out/run/gates.jsonl build row and /out/logs/build-1.log (repair suffix increments on rerun)"
verify = "hf-done -> cg spec done 22.39.162 -f layerx-merge --root /work/paxeer-monorepo; exact candidate revision, command, exit and private log in /out/run/gates.jsonl verify row and /out/logs/verify-1.log (repair suffix increments on rerun)"
policy = "The gate ledger and final hf-done line own the qualification result; this record never declares a gate that has not run. No edits follow successful hf-done."

[gotcha.1]
observed = "Replay SQL mixes parameter 10 as a bigint column and untyped arithmetic, independent of the pgx version."
repair = "Cast both appearances to bigint; preserve replay bounds and all assertions."

[gotcha.2]
observed = "Anvil impersonated eth_sendTransaction hashes need not match the hash reconstructed from the unsigned transaction payload."
repair = "Generate the second NFT transfer with a genuine chain-125 signature and funded fixture key before waiting for its receipt."

[gotcha.3]
observed = "The sandbox initially provided PostgreSQL 18, Redis 8, Foundry 1.9.0 and a different Go toolchain."
repair = "Use the exact job versions and env for the two requested replay measurements and both qualification gates."

