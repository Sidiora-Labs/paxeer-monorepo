[repair]
task = "22.39.359"
decision = "3244"
gotcha = "4172"
source_revision = "ee5fac325dd65598f30f940b85c0caef0122a3e3"
cause = "The command passed unchanged default delivery parameters whose zero lag budget the renderer refuses."
change = "Parse an explicit bounded lag budget and optional strict dead letter JSON before any anchor request; pass those parameters into the real renderer."
scope = "Only main.go, main_test.go and this record in cmd/indexer-runtime-docs; internal/app and DefaultDeliveryParameters remain unchanged."

[flags]
max_delivery_lag_ms = "-max-delivery-lag-ms is required, decimal whole milliseconds from 1 through 9223372036854 inclusive; no default budget."
dead_letters = "-dead-letters is optional; its file must decode as exactly one app.DeadLetterParameters JSON object with no unknown members; absent means no policy."

[cases]
required_budget = "TestRepair_22_39_359_lag_budget_is_required rejects absent, zero, negative, oversized, fractional, nonnumeric and overflowing budgets; run rejects them before attempting its anchor URL."
accepted_budget = "60000 preserves every other default member; 1 and the exact duration bound are accepted."
policy = "All eight declared dead letter members survive decoding; unreadable, empty, malformed, unknown-member, wrong-type, null, array and trailing-value files are refused."
render = "TestRepair_22_39_359_rendered_delivery_document_carries_the_budget renders via app.RenderRuntimeDocuments and reads maxDeliveryLagMs 60000 from delivery.json, asserting absent deadLetters."
render_inputs = "Approved historical deployment 32226215, committed historical reviewed catalog, SidioraERC20 compiler artifact and the recorded anchor at height 33963715 from internal/internaltest/chainfixture/testdata/paxeer125-market.jsonl.gz."
pool_identity = "Historical runtime hash from internal/app/render_test.go:46 and internal/runtimedocs/paxeer_test.go:37; no invented anchor or external RPC required."
existing_case = "TestInputPathsResolveCommittedInputs remains intact and executes in the declared verification."

