[meta]
name = "Indexer source quality"
module = "services/launchpad/indexer"
criterion = "The indexer module passes its configured source checks with its published values intact."

[findings]
bodyclose = "3 HTTP responses close within their owning functions."
dogsled = "2 caller locations check the returned availability bit."
errcheck = "56 resource, transaction, stream, and digest operations report cleanup errors."
goconst = "Repeated protocol and state values use package constants without changing their bytes."
goimports = "Source imports follow the module import groups."
gosec = "File outputs use restricted permissions; selected paths and bounded numeric conversions carry local reasons."
ineffassign = "3 overwritten initial values were removed."
prealloc = "The market query argument slice reserves capacity for its addresses."
staticcheck = "Conditional forms and retired publisher target use were simplified."
unconvert = "3 redundant integer conversions were removed."

