[meta]
module = "social"
surface = "launchpad social service"

[lint.errcheck]
sites = 51
behavior = "Transaction rollback, resource close, response encoding and digest writes handle errors."

[lint.goconst]
sites = 130
behavior = "Shared package constants preserve environment, action, state, event and response values."

[lint.goimports]
sites = 18
behavior = "Go imports follow the module formatter."

[lint.gosec]
sites = 18
behavior = "File reads stay in their selected directory and numeric conversions check their bounds. Voice responses retain validated JSON envelopes."

[lint.staticcheck]
sites = 20
behavior = "Conditionals, status constants and runtime profile branches use explicit forms while published response text stays stable."

[comment.1]
