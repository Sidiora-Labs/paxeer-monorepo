finding_21 = "TestRepair_68_SocketRESTAndRestartUseDurableMessages: real policy/session checks, pgx durable store and WebSocket hub with in-process database/broker peers, committed pool/DM acknowledgements, REST history/edit/delete, signed replay cursor invalidation, private ACLs and store/server reopen."
baseline = "Not run: the explicit numbered gate order prohibits testing before complete implementation and reserves verification for hf-done; no pre-change test result is claimed."
qualification_record = "Runner-owned /out/run/gates.jsonl records the candidate revision, exact commands, exits and private logs for hf-build and hf-done; the final task response copies the bounded gate evidence."

[wiring.app]
