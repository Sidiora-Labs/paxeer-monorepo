acceptance = "22998.1"
route = "Wallet bank movements call transfer(address,uint256) on the denomination native pointer obtained from getNativePointer(string) on the chain pointer view at 0x100a. The pointer invokes the bank precompile send at 0x1001 as the denomination pointer caller."
binding = "The resolver rejects zero and bank precompile pointers and binds the asset to the denomination digest. Chain reads require an existing matching pointer before signing or submission. Exact nonce, fee ceiling, wallet, custody authorization and signed transaction bindings are retained."
receipts = "Pointer transfer completion requires encoded true, an authenticated receipt and independently verified consensus coverage retained across durable reopen."
recording = "The node supplies the pointer view, transfer return data, receipts, sequence batches, validator sets, signed headers and transaction inclusion proofs."
production = "Move quotes and intent legs resolve the native pointer at the balance height and validate it again before signing. Durable production journeys bind pointer transfers to current node EVM receipts and require encoded true. Live production cases use a funded attestor wallet and independently authenticated consensus coverage."
