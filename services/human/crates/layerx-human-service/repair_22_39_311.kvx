[site.tls]
file = "services/human/crates/layerx-human-service/src/event_producer_tls.rs"
symbol = "human_journey_and_approval_cross_tls_and_recover_after_sink_loss"
repair = "Start the real runtime-clock Server inside a case-owned private temporary directory; explicitly bind its socket and current process identity, then pass the connected clock to privileged components, the component server, both Unix component clients, the HTTP router and both bounded sink-loss and recovery waits. Keep every journey, approval, foreign-principal refusal and durable recovery assertion."

[site.subject]
file = "services/human/crates/layerx-human-service/src/server/agent_runtime.rs"
symbol = "cloned_subject_handle_binds_every_coordinate_without_changing_original_head_frame"
repair = "Replace the fixed /tmp/lxp-subject-wire.sock with agent.sock under the case-owned temporary directory and use new_with_clock with the served authority. AgentRuntime::new reads the environment before constructing its endpoint; it does not bind the agent socket. Keep every coordinate and refusal assertion."

[rule]
isolation = "Each case owns a randomly named private directory and a real clock authority, explicitly binds the runtime clock without environment reads, keeps that authority alive through all consumers, then joins its worker and removes its directory. Cases and runs share neither socket paths nor mutable clock environment."
binding = "ClockBinding::for_current_process is shared by the client loopback cases and Human service cases; socket permissions and peer credentials remain checked by RuntimeClock::connect."

[qualification]
evidence = "/out/run/gates.jsonl"
verified_revision = "The final passing build and verify rows in the private gate ledger name the exact same candidate revision; this reference avoids changing the candidate after qualification."
build_command = "cargo build --locked --manifest-path services/human/Cargo.toml -p layerx-human-service --lib --tests && cargo build --locked --manifest-path services/platform/Cargo.toml --target-dir services/human/target -p layerx-platform-webhooks --bin layerx-webhooks"
verify_command = "cg spec done 22.39.311 -f layerx-merge --root /work/paxeer-monorepo"
status = "Qualified only when hf-build and hf-done pass at the same candidate revision; the verify row records the exact revision, command, exit code and private evidence location."

