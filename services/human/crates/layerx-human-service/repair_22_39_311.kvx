[site.webhook_fixture]
file = "services/platform/hosted/internal/src/producer_test_support.rs"
symbol = "Webhooks::start"
repair = "Wait for the Redis TLS listener before starting delivery; configure the real webhook process as ingress with its client CA, issue the producer client leaf with the required role URI SAN, omit public identity credentials from ingress, and supply the required node, Comet and validated chain policy configuration. Journey and approval events without activity receipts keep their existing real source paths and assertions."
diagnostics = "Capture Redis and webhook stdout and stderr in case-owned append-only log files, preserve the same bounded listener wait across restarts, and report exit status plus the final twenty log lines when startup fails. The Webhooks owner kills and reaps both children during unwinding."
qualification = "The final matching build and verify candidate revision in /out/run/gates.jsonl is the verified revision for this continuation; historical failed attempts remain above. No assertion, test or production binary is weakened or replaced."

