[site.readiness_endpoint]
file = "services/platform/hosted/internal/src/producer_test_support.rs"
symbol = "readiness_listener"
repair = "Serve POST / over TLS using the existing fixture certificate and require the bearer read from the NODE_TOKEN file written for the delivery process. Return JSON-RPC 2.0 with the request id: eth_chainId returns 0x4d from the same network id 77 configured for delivery, and status returns node_info.network from the same producer-integration chain id written to the chain policy plus sync_info.catching_up false. Unsupported methods return JSON-RPC method-not-found errors; malformed JSON and malformed RPC envelopes return explicit errors."
lifetime = "Webhooks owns the listener on a separately allocated loopback port and points both LAYERX_WEBHOOKS_NODE_URL and LAYERX_WEBHOOKS_COMET_URL at it. The endpoint stays available across delivery restarts and stops and joins its worker when the Webhooks fixture drops, after both children are stopped."
qualification = "The final matching build and verify entries in /out/run/gates.jsonl name the verified revision, exact commands, exit codes and private evidence logs without a post-verification candidate edit."

[qualification.attempt_5.repair]
revision = "1354e084dda062e1ba178a388c22356182de7891"
command = "cg spec done 22.39.311 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The subject-coordinate case passed, but the TLS case still failed with webhook-trigger refused: HostedService::ready_until also requires KmsClient readiness to decode ready and ed25519_non_exportable, while the fixture still pointed KMS_URL at the event source, whose readiness has no KMS field."
repair = "Serve the existing production kms::Service with its real KeyStore and a randomly derived SealKey over a case-owned TLS listener using the fixture certificate, peer verification and KMS_TOKEN file; point KMS_URL at it and keep the listener and key store alive through delivery restarts. No production handler, readiness check or test assertion changes."

[continuation.attempt_6]
base_revision = "85c4dfcb4811fc625ae248afaff6b0357ead4ea6"
decision = "3183"
gotcha = "4117"
delivery_sequence = "Client::spawn in services/platform/hosted/internal/src/producer.rs starts independent admission and delivery workers. Client::delivery_step persists store.acknowledge before health.recovered clears failed_since; poll_admission separately refreshes admitted_at. HumanOutbox::ready in services/human/crates/layerx-human-service/src/event_producer.rs requires Health::ready and scheduling_ready, which reads persisted delivery attempts and first_refused_at; QueueState::acknowledge resets attempts to zero. An empty queue can therefore be observed before readiness returns."
repair = "The recovery loop in verify_delivery waits until both the queue is empty and outbox.ready is true under the existing single 10-second runtime-clock deadline and unchanged polling interval. Both the empty-queue assertion and the readiness assertion remain, together with the approval record and durable acknowledgement assertions."
qualification = "The final passing build and verify rows in /out/run/gates.jsonl identify this continuation's identical candidate revision, exact commands, exit codes and private evidence logs without editing the candidate after qualification."
