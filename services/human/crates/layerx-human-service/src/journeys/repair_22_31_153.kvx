[gotcha.attempt-3]
observed = "A receipted RPC response and ordinary EVM landing receipt do not authenticate a committed rung; recovery must retain the signed consensus header and sequence-batch inclusion proof as well as the signed execution receipt."
resolution = "The bank adapter explicitly accepts pinned consensus evidence, verifies it through the existing daemon checkpoint and Comet proof codecs, retains the exact evidence, and refuses damaged proof material."

