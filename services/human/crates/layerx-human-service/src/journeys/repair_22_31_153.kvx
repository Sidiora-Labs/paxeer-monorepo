[finding.history-state-schema]
test = "history_state_schema_get_list_after_reopen"
repair = "JourneyState has a serde closed variant and JourneyEngine::historical_response encodes retained legacy get/list members from the same state; retired kinds remain unconstructible."
schema = "The live contract and compatibility baseline declare closed, ApiSchema checks the engine vocabulary at startup, and reopened get/list responses pass through the actual schema encoder and JourneyState consumer."

[finding.receipt-operation-domain]
test = "bank_plan_constructor_commit_reopen_two_sends"
repair = "EVM receipt module 12/version 1/type 2 is checked independently of intent ordinals, against the exact durable signed transaction hash, canonical signature, sender, destination, nonce, fee and time limits, authenticated key/height and receipt authority; EVM execution uses its signed execution projection, while kernel receipts retain verify_outcome."

[finding.bank-plan-cannot-commit]
test = "bank_plan_constructor_commit_reopen_two_sends"
repair = "MoveJourney commits every bank call to JourneyEngine and retains the canonical bank plan, transfer amounts, signed bytes, nonces, hashes and verified receipt/key/rung evidence; advance_bank uses SequencerEndpoint and lookup_authenticated and resumes the same transactions after reopening; advance_bank_with_commit retains the verified signed-batch inclusion proof and reaches Committed without another send."

[wiring.history-server]
request = "Domain 10: services/human/crates/layerx-human-service/src/server/production_reads.rs should delegate its existing closed-history encoding to JourneyEngine::historical_response after the schema contract is wired; server/http.rs must keep enforcing ApiSchema."

[wiring.history-client]
request = "Domain 10: regenerate apps/web/src/api/generated/index.ts JourneyState/decodeJourneyState from the schema and add the closed label/status in apps/web/copy/catalog.ts, apps/web/src/journeys/activity/model.ts and apps/web/src/journeys/approvals/model.ts."

[wiring.bank-server]
request = "Domain 10: services/human/crates/layerx-human-service/src/server/production_components.rs should route bank MoveJourney execution through advance_bank_with_commit with its governed receipt keys, pinned consensus validators, signed batch inclusion evidence and sequencer endpoint, replacing the separate intent-evm persistence path; preserve native-purpose approval for native journeys."

[wiring.receipt-adapter]
request = "Domain 10: services/human/crates/layerx-human-service/src/server/production_components.rs verify_move_evm_outcome must also check type 2 separately from the disclosed activity ordinal; server/agent_runtime.rs must retain authenticated ReceiptMaterial key, height and rung transport."

