tests = ["store_independent_writer_loss_recovery", "store_independent_writer_loss_process_recovery", "store_independent_writer_loss_all_open_modes"]
rule = "Every open mode acquires the same nonblocking exclusive provider.lock before migration or snapshot access and retains it until the store is dropped; competing opens return StoreError::Io with WouldBlock."
