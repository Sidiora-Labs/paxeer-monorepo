[gotcha.baseline-order]
observed = "hf-done refuses verification before a passing hf-build even when continuation instructions request a baseline verify first."
resolution = "Run the unchanged-tree build through hf-build, then the unchanged-tree baseline through hf-done; never bypass the wrapper."

[gotcha.rotation-shape]
observed = "A correctly compiled KeyRotation payload is still unsupported by both the current Auth disclosure codec and node lifecycle keeper."
resolution = "Assert the production tag, field count, fields and ABI envelope, preserve the positive acceptance assertion, and request wiring from the owning domains rather than substituting another lifecycle operation."

