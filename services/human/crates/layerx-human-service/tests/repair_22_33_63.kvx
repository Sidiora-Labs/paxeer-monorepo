source_test = "session_rungs::current_rotation_requires_a_real_producer_before_rung_acceptance"
status = "blocked_on_external_interface"
observed = "The same production payload/ABI shape and positive preparation/custody boundary remain required. Existing focused below-Committed refusal policy cases remain intact; no fabricated accepted rotation or receipt is supplied."
wiring = "Domain 1: services/agent/crates/layerx-agentd/src/managed_agent_rotation.rs must provide accepted owner-rotation projection and committed recovery evidence; prepare currently returns rotation_unsupported for every request."
wiring_human = "Domain 10: services/human/crates/layerx-human-service/src/server/production_rotation.rs must provide supported announce/commit stages and a durable consumer contract; those stages currently return operation_retired."

