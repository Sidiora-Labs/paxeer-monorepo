build_command = "python3 -m pip install -q -r tests/bridge/requirements.txt pytest PyYAML && go mod download && make -s human-build"
command = "test -s services/human/crates/layerx-human-identity-provider/repair_22_39_499.kvx && git grep -q -F 'HUMAN_TEST_SCOPE' -- Makefile && make -s human-test HUMAN_TEST_SCOPE='--workspace --exclude layerx-human-service --exclude layerx-human-kms'"
account_head = "Positive CLI observations use the configured account, asset and chain and assert every published field; malformed and tampered batch envelopes publish no consumption value."
wallet_binding = "The wallet binding recording is emitted by record_wallet_binding_22_33_35.mjs using the provisioning producer and account reader."
purpose_catalog = "The service reader preserves the two native call selectors published by the hosted beta purpose catalog: 0x78ea11db and 0x8608d32b."
identity_responses = "Successful responses contain zero fields for probe, five for provision, one for email resolution, three for device resolution and one or two for assertions; other operations and field counts are refused."
operator_guide = "Committed RPC and bank receipt contracts precede retained configuration; account observations authenticate stable chain state and a zero debit sequence, and process projections preserve their published bindings."
hosted_observation = "The evidence workflow registers the native owner, consumes funding evidence, validates the funded registration, observes the account head and then deploys naming; native registration produces before validation."
merged_owner = "Merged-owner provisioning authenticates native receipts and preserves account, recovery and funding bindings across restart; retired custody provisioning modules remain absent."
principal_store = "Tenancy authority is authenticated before principal directory creation; refused or unavailable bindings preserve the complete store tree and acknowledged rows across reopen."
attestor_bindings = "KMS signing configuration binds each custody digest to its tenant, principal, signer configuration and protected assertion file."
assertion_refresh = "Owner assertions carry signed subject and validity claims; an empty assertion refuses signing and renewal for the same subject restores it."
signing_quorum = "A replay refusal advances the audit sequence once on each selected signer and preserves the sequences of unselected nodes."
clock_consumers = "The in-process KMS and its client authenticate separate runtime clock consumers against the same authority."
registry_network = "Hosted KMS material consumes the canonical module registry bound to network 125."
signing_disclosure = "Signing reconstructs each supported call disclosure from its declared sender and compares every encoded field before dispatch. Native operation disclosures retain their actor representation."
provider_admission = "The remote provider supports the production keystore boundary and explicitly refuses admission as a complete Human native-consent service."
session_authority = "Managed agent session grants carry the padded EVM address derived from the provisioned secp256k1 seed; daemon suspension preserves sessions already closed by protocol revocation."
creation_payload = "Lifecycle evidence binds the compiled native payload retained in the signed call."
control_receipts = "Protocol limit changes require a committed native lifecycle receipt for the declared module, a zero nonmonetary operation and the exact replacement payload."
approval_budget = "Approval content preserves the observed budget rung and canonical disclosure digest; only committed budget evidence permits approval."
nonce_response = "The pending nonce response contains one unsigned 64-bit integer and no trailing fields; native contexts and preparation records retain that same value."
account_balance = "LXHB2 account material encodes balance presence before the verified rung."
store_ownership = "Each durable store has one live writer; restart cases release the previous writer before opening its replacement, and agent store roots are private directories."
principal_tree = "Foreign names and nondirectory entries in the principals tree are refused as corrupt stored data."
export_delivery = "Authorized primary key delivery recovers the same key and custody timestamp after restart; owner acknowledgement retires further delivery."
principal_projection = "An active principal projection contains its authenticated account, tenant and session identifiers."
receipt_inventory = "The sequencer receipt recording contains seven valid envelopes and six refusal vectors."
fuzz_inventory = "The intent fuzz package publishes one executable target with its shared harness and fixture directory."
submitted_receipt = "Both the delivery constructor and the activity feed refuse a submitted reference presented as verified receipt evidence."
recovery_trust = "Recovery receipt access revalidates the protected consensus chain and fixed validator authority."
attestor_identity = "A retained wallet refuses an assertion subject change during provider startup; restoring the original binding preserves signing authority."
receipt_key_response = "Receipt-key readiness material uses the keys object and numeric first and last heights. Pending nonce evidence retains the exact response value."
consensus_votes = "Committed node recordings preserve validator slots, canonical absent votes and signatures for the authenticated block quorum."
observed_balance = "Top-up planning distinguishes an observed zero agent balance from an unobserved balance."
recipient_handover = "Primary key handover uses a recipient-authenticated encrypted envelope, verifies the exported public identity and acknowledges durable delivery; the legacy one-shot route is refused."
scope_refusal = "Foreign tenant authorizations are refused before action-key conflict handling or durable mutation."
send_handover = "Send authorization refuses a self-custodied key before consulting cleared wallet actions or archived sends; the refusal survives provider restart."
service_commands = "The service guide publishes executable commands for its documentation contract, EIP-1559 runtime and nonce tests."
approval_context = "Submitted and receipted budget observations retain the complete rendered disclosure and exact observed rung while refusing approval."
submission_reference = "EIP-1559 submission responses carry a fixed 32-byte reference; the runtime preserves it alongside the transaction hash and submitted rung."
approval_notifications = "Full approval notifications derive their exact amount and disclosure binding from the durable inbox produced by the agent approval stream, and respect the current channel preferences."
attestor_admission = "Bearer capabilities reach an isolated live attestor quorum with signed assertions and wallet bindings; foreign subjects and changed session identifiers are refused."
workspace_inputs = "Protected input cases execute their complete assertions when their named input is supplied; an absent external input is identified by its variable name. Quorum cases start the local KMS attestors. Workspace member test dependencies retain package versions."
receipt_finalization = "src/server/agent_creation.rs authenticates native lifecycle outcomes through ProtocolEvidence::verify_outcome and EVM execution outcomes through verify_evm_outcome, preserving operation, action, payload and committed-rung bindings."
receipt_fixture = "agent_creation_rungs.rs supplies module 12 operation 2 receipts and fixed-width submission references to the EVM creation adapter; changed disclosure fields are refused."
activity_positions = "Activity ingestion uses RPC log positions through CoreEvent::from_log and publishes completed blocks through EventIngestor::new_head before durable subscription delivery."
bearer_binding = "Bearer admission consumes the signed wallet provisioning recording and its published producer key."
external_inputs = ["LAYERX_HUMAN_KMS_REGISTRY_FILE", "LAYERX_HUMAN_KMS_GATEWAY_REGISTRY_FILE", "PAXEER_X_NATIVE_JOURNEY_APPROVAL_FIXTURE", "PAXEER_X_HUMAN_NATIVE_SEND_PRODUCER_FIXTURE", "PAXEER_X_NATIVE_SEND_LIVE_FIXTURE"]
workspace_command = "cargo test --manifest-path services/human/Cargo.toml --locked --workspace --exclude layerx-human-service --exclude layerx-human-kms --no-fail-fast"
bank_abi = "send_routes.rs and move_money_bank_send.rs encode the canonical bank address, denomination asset digest and send(address,address,string,uint256) arguments, retaining nonce, signing and receipt bindings."
control_evidence = "agent_control_persistence.rs verifies native lifecycle receipts with ProtocolEvidence::verify_outcome."
bearer_tenancy = "The signed producer binding is available through the identity server binding reader before bearer request admission."
export_authority = "export_receipts.rs serializes version-3 evidence with the recorded committed node receipt and independently installed consensus authority; export.rs binds state and receipt inclusion to the same signed header and governed receipt key."
provider_transport = "Provider cases complete mutual TLS before sending application frames, and lost-response export retains its connection until durable custody state is observed. Distinct monetary calls use distinct wallet nonces and retain the same nonce on replay after restart."
fragmented_transport = "Attestor deadline cases initialize client TLS before connecting and send fragments without TCP coalescing; the connection deadline and permit-release bounds remain exact."
test_scope = "Makefile defines HUMAN_TEST_SCOPE with --workspace as its default. The human-test cargo invocation accepts this member selection while retaining hosted provisioning, custody prerequisites, webhooks and web tests. The provider, test-support, intents and network-gateway members can be selected independently of the service and KMS members."
