change = "README names the HTTP JSON-RPC admission fixture, Submitted-only receipt replies, journal recovery and the separate recorded-paxd consensus proof required for Committed evidence."
producer_transport_consumer = "Eip1559Call::sign -> EvidenceNode over loopback HTTP JSON-RPC -> NodeRpc -> Submitted receipt; stopped server reopens AdmissionJournal, truncates torn tail, recovers the first admission and persists the second without duplicating retries."
committed_path = "The committed-evidence helper replays the crate-owned fresh paxd recording through NodeRpc and the production human consensus verifier, reopens PrincipalStore and rejects malformed and foreign evidence."
baseline = "Attempt 1 built successfully but stopped before this repair target ran because the dependency check failed in the human-service observed-balances test; no failure of repair_22_33_55 is claimed."
continuation = "Attempt 2 preserves the existing README and integration tests and reruns hf-build followed by hf-done, including its dependency check, after the published Quantity producer repair 22.31.443. The ordered gate rules prohibit a separate baseline verify run."
wiring_request = "None for this repair: the committed-proof helper now uses a separately recorded source and derived vector inside this crate; the external interop and daemon fixtures remain owned by their respective domains."
gotcha = "An earlier task already corrected most audited README text; preserve that work and explicitly identify the separate real-node proof. Task-specific scope forbids edits to root GOTCHA.kvx or spec records."
evidence = "The runner hf-build/hf-done ledger binds the final candidate revision to exact commands, exit codes and private log paths; the final response copies its last gate record."
previous_qualification = "Attempt 2 candidate ef9e6b599f67f00dba08b6009a1617c58c5b9f84 passed hf-build and the dependent-crate check. hf-done exited 1: admission/recovery passed; the committed-proof case failed because sourceSha256 34e9f6abc84b7d714dea573b2a0db0bb055fc51715a72d63fd9a489594e81a03 differed from actual fc3fe1494c91ff8720a8d8fced398ea6c483c7aa70e3b655212e2b68de75eaab."
continuation_3 = "Re-recorded the separate production paxd proof during implementation into tests/fixtures/committed and derived the conformance vector with the existing interop converter, recomputing sourceSha256. The original source-integrity assertions and all production verifier, restart and refusal assertions remain intact; hf-build and hf-done qualify the final unchanged candidate."
recording_source_revision = "9d1a06c7f3635f5556023760af7a75ee9755efdd"
recording_provenance = "tests/fixtures/committed/README.md gives the production recorder command and local trust boundary; sourceSha256 in vector-v4-conformance.json identifies the exact raw recording."
recording_gotcha = "The production recorder initially exited before capture because its launch configuration omits required replication TLS settings; the crate-owned implementation-only launcher supplies real CA-signed role certificates and peer SPKI pins without disabling or changing production checks."
recording_sha256 = "01bc45914c965c0448447ef51c53a463fa19d6d3ce4b44b7172d762efe734b5a"
