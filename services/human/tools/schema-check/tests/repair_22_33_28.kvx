previous_attempt = "The supplied attempt-1 evidence and spec/layerx-merge/qualification.kvx finding.22.33.28.1 record one passing version test and nine failures on breaking-declaration-change: all five individual binding cases, the aggregate binding case and all three marker cases. The verify command is not rerun before implementation because the continuation's ordered gates prohibit that."
finding.binding-golden-assertions = "repair_22_33_28::{binding_statement,binding_submit,binding_status,binding_rebind_action,binding_rebind}_has_complete_retired_failure and retired_binding_goldens::retired_binding_failure_vectors_answer_operation_retired validate the actual schema and decode each committed vector through the production schema-check codec, retaining the original checks and asserting the complete retirement envelope."
finding.retirement-marker-baseline = "repair_22_33_28::retired_markers::{operation_marked_retired_is_accepted_and_reported,retired_variant_outside_variants_is_rejected,removing_a_retired_operation_is_still_a_baseline_break} assert all eleven current operations and all four current retirement sets before explicit deltas; they retain invalid forms, missing goldens and frozen-baseline removals through the production human_api_schema and baseline_manifest paths."
goldens = "The continuation adds the schema directory to scope: all five binding failure examples now match the inspected ApiFailure::operation_retired contract in services/human/crates/layerx-human-service/src/server/backend.rs (410, operation-retired, error.operation.retired, final, no field or retry_after_ms); their original traces are retained. These are contract-aligned examples, not a claimed service execution capture."
wiring_request.producer_comparison = "Human domain 10: expose the service retirement producer to services/human/tools/schema-check/Cargo.toml as a test dependency, regenerate the five binding failure examples from the real refusal and compare its actual ApiFailure::operation_retired().envelope() serialization; this manifest and the service producer are outside scope, so the scoped tests currently assert the inspected contract rather than execute the service."
baseline_review.intent = "All twelve non-additive differences in intent.kvx are prose: module.{never_partial,no_new_verb,observed_state,progress,spine}, operation.intent.submit.repeat_rule, type.IntentConstraints.top_up, type.IntentDomain.meaning, type.IntentEndpointKind.closed, type.IntentLegBinding.account_sequence, type.PlanIntentRequest.asset_id and type.SubmitPlanRequest.replan. No method, path, request, response, required field, optional field or variant changes here."
baseline_review.journeys = "All six non-additive differences in journeys.kvx are prose: type.EvidenceMaterial.material, type.EvidenceRef.export, type.JourneyKind.boundary and type.JourneyState.{done-finalised,done,still-checking}.semantics. There are no removed declarations, changed methods, changed paths or incompatible wire shapes. Existing prefix-preserving extensions to EvidenceMaterial.optional (rung and inclusion_height) and JourneyState.variants (awaiting-approval) are already accepted by the production additive baseline rule; ten additional keys are explanatory prose only."
baseline_refresh = "Deliberate producer refresh: cargo run --manifest-path services/human/tools/schema-check/Cargo.toml --locked -- --write-baseline services/human/schema/human-api; refreshed_real_schema_baseline_matches_current_declarations checks byte-for-byte equality with baseline_manifest and zero additions, and the existing removal tests still enforce the frozen baseline."
qualification = "The bounded hf-build and hf-done ledger in /out/run/gates.jsonl and private /out/logs/build-1.log and /out/logs/verify-1.log record the exact verified candidate revision, command and exit code; this record does not claim a gate before it runs."
