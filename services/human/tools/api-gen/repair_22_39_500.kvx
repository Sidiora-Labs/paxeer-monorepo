[rule]
client = "Stream cancellation callbacks use a statement body and retain the subscription abort listener and cancellation signal."
dependencies = "Use accepted dependency releases where the dependency requirements permit them; each exception identifies one advisory or one exact duplicate version, its dependency constraint, reason and review date. Forbidden dependency crates remain denied."
reviewed = "2026-11-13"
retired_surfaces = "Completion checks include interfaces with retire or retired status and require all 52 retired interfaces and 11 retired schema routes."

[files]
generator = "services/human/tools/api-gen/src/lib.rs"
cases = "services/human/tools/api-gen/tests/generation.rs"
completion = "services/human/tools/api-gen/tests/completion_gate.rs"
client = "apps/web/src/api/generated/index.ts"
manifest = "services/human/Cargo.toml"
lock = "services/human/Cargo.lock"
policy = "services/human/deny.toml"
record = "services/human/tools/api-gen/repair_22_39_500.kvx"

[dependencies]
getrandom = "Human crates use getrandom 0.4.3, matching layerx-platform-internal and ureq; agent and cryptography dependencies retain their required older versions."
rustix = "layerx-client requires exactly rustix 1.1.4; its requirement excludes patched rustix 1.1.6."
webpki = "layerx-agentd requires exactly rustls-webpki 0.103.15; its requirement excludes patched rustls-webpki 0.103.16 and 0.103.17."
rsa = "jsonwebtoken 10.3.0 requires rsa ^0.9.6; its requirement excludes patched rsa 0.10."
crypto_bigint = "elliptic-curve 0.13.8 requires crypto-bigint ^0.5; its requirement excludes patched crypto-bigint 0.7."

[commands]
generate = "make -s human-gen-api"
sdk_check = "make platform-sdk-check"
build = "make -s human-build"
verify = "test -s services/human/tools/api-gen/repair_22_39_500.kvx && make -s human-lint"

[advisory.RUSTSEC-2024-0436]
reason = "Reviewed 2026-11-13: paste 1.0.15 is a compile-time proc macro required by the pinned vendored engine tree; no maintained paste release is available"

[advisory.RUSTSEC-2022-0061]
reason = "Reviewed 2026-11-13: parity-wasm 0.45.0 supplies the module representation required by the vendored wasm-instrument 0.4.0; no maintained parity-wasm release is available"

[advisory.RUSTSEC-2023-0071]
reason = "Reviewed 2026-11-13: jsonwebtoken 10.3.0 requires rsa ^0.9.6 for RS256 public-key verification; the patched rsa 0.10 release is outside that requirement"

[advisory.RUSTSEC-2026-0387]
reason = "Reviewed 2026-11-13: elliptic-curve 0.13.8 requires crypto-bigint ^0.5 for the pinned k256 and p256 APIs; patched crypto-bigint 0.7 releases are outside that requirement"

[advisory.RUSTSEC-2026-0486]
reason = "Reviewed 2026-11-13: layerx-client pins rustix =1.1.4; the patched 1.1.6 release cannot satisfy that exact requirement"

[advisory.RUSTSEC-2026-0382]
reason = "Reviewed 2026-11-13: layerx-agentd pins rustls-webpki =0.103.15; patched releases starting at 0.103.16 cannot satisfy that exact requirement"

[duplicate.1]
name = "getrandom"
version = "=0.2.17"
reason = "Reviewed 2026-11-13: ring 0.17.14 and rand_core 0.6.4 require getrandom ^0.2 while the human workspace and ureq 3.4.0 require 0.4.3"

[duplicate.2]
name = "syn"
version = "=2.0.119"
reason = "Reviewed 2026-11-13: curve25519-dalek-derive 0.1.1 and zeroize_derive 1.5.0 require syn ^2 while serde_derive 1.0.229 requires ^3"

[duplicate.3]
name = "base64"
version = "=0.22.1"
reason = "Reviewed 2026-11-13: passkey-auth 0.1.3 and jsonwebtoken 10.3.0 require base64 ^0.22 while ureq 3.4.0 and the interop crates require 0.23.1"

[duplicate.4]
name = "getrandom"
version = "=0.3.4"
reason = "Reviewed 2026-11-13: layerx-agentd pins getrandom 0.3.4 and rand_core 0.9.5 requires ^0.3 while the human workspace and layerx-platform-internal require 0.4.3"

