[violation.55]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "agents.kvx:type.ApprovalApproveRequest.required: [\"step_up_evidence:EvidenceId\"] -> [\"step_up_evidence:StepUpChallengeId\"]"
producer_commit = "7e32286b9a58600532e003f4f658ea95c05d0f91"
