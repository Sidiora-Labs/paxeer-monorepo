command = "cg spec done 22.39.161 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The build, schema command and all Rust tests passed at the same candidate revision, including verification_level_retires_settlement_values_and_maps_rungs; pytest reached both inventory cases but each failed assert_manifest_shape at test_beta_driver.py:256 because real_stack was false (2 failed, 1 passed). The multichain case stopped before its schema-check exit-code assertion."
