[qualification]
build_reference = "/out/run/gates.jsonl: kind=build; revision, command, exit and log are recorded by hf-build"
verify_reference = "/out/run/gates.jsonl: kind=verify; revision, command, exit and log are recorded by hf-done"
verified_revision_reference = "/out/run/gates.jsonl: last kind=verify row revision; the same revision must have a passing kind=build row"
baseline_command = "cargo run --manifest-path services/human/tools/schema-check/Cargo.toml --locked -- --write-baseline services/human/schema/human-api"
baseline_log = "/out/22_39_161-baseline.log"

[ownership]
mechanism = "Operation declarations list every supplemental path by its request, response, failure, producer-input or artifact role; schema-check checks HTTP vectors with the owner type, producer JSON syntax and nonempty input shape, and nonempty artifact bytes. Unlisted files, missing files, duplicate owners and paths outside one supplemental set fail."
current = "activity.export.evidence owns current/activity.evidence.bundle; the unchanged service producer test validates the bundle bytes."
historical_decode = "activity.entry and activity.export.evidence own their historical-decode responses; retained enum vocabulary remains decodable."
historical = "intent.plan and journey.get own their historical responses; schema-check validates their wire types without promoting legacy data to current execution authority."
negative = "intent.plan owns the unsupported route request and its typed refusal; shape validation does not imply execution authority."
producer = "intent.plan owns its observation context and journey.get owns its projection record; unchanged producer tests consume these internal input objects."
consumer_paths = "Preserved all five set paths: service production_reads.rs and production_components.rs and qualification test_repair_22_33_29.py and test_repair_22_33_30.py outside scope depend on them. Explicit ownership avoids breaking those references or exempting directories by name."

[scalar_format_repair]
source = "identity.kvx:scalar.StepUpChallengeId.format and scalar.OperationDigest.format; auth/mod.rs:mint_identifier encodes sixteen entropy bytes as lowercase hexadecimal; operation digests encode 32 bytes."
implementation = "Recognize both exact declared formats and enforce their prefix, width and lowercase hexadecimal alphabet, retaining rejection of unknown formats."
examples = "All affected challenge_id and step_up_evidence examples use chg_000102030405060708090a0b0c0d0e0f; confirms uses opd_000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f. Every other JSON field and all producer artifact bytes are unchanged."

[gotcha.1]
symptom = "The starting checker does not recognize the two prose scalar formats already declared by identity.kvx, so changing golden values alone cannot pass the gate."
cause = "SCALAR_FORMATS and format_matches only implement decimal, currency, rfc3339-utc and copy-key."
repair = "Implement strict recognition and hexadecimal validation for the declared challenge and digest formats with rejection tests for width, alphabet and prefix."

[workflow]
path = ".github/workflows/human.yml"
job = "schema-check"
trigger = "Unconditional job in the existing Human workflow, including push to main and pull_request."
command = "cargo run --manifest-path services/human/tools/schema-check/Cargo.toml --locked -- services/human/schema/human-api"

[qualification.attempt1]
revision = "a3375cf7edfcc5752957d96b75661c5ef05035ac"
command = "cg spec done 22.39.161 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The schema command passed with 1343 declarations, 95 operations and 285 primary vectors; cargo test found three stale mutation targets in conformance.rs and stopped before the beta driver."
repair = "Use the current journey state done, current journey kind move and current EvidenceRef.export declaration as mutation targets, preserving the existing undeclared-enum-value, missing-required-field and breaking-declaration-removal assertions. The tests still exercise invalid data and deletion through the production checker."

[gotcha.2]
symptom = "Three conformance mutation tests panic before exercising the checker because their old golden or declaration source text no longer exists."
cause = "The live journey fixture and EvidenceRef export text changed while the mutation targets retained processing, deposit and the older export description."
repair = "Update only the source mutation anchors to the current owned fixture and declaration, keeping all rejection criteria intact."

[qualification.attempt2]
continued_revision = "f23ff54833698defec05b5585cae05c0b52b6078"
decision = "2953"
gotcha = "3658"
producer = "services/human/schema/human-api/journeys.kvx:58, type.EvidenceMaterial.optional"
producer_task = "10.92.1"
producer_commit = "c55d8901a7aac95ed5f4717e821f9cf3d0f77a73"
repair = "In verification_level_retires_settlement_values_and_maps_rungs, assert the exact per-section optional lists: settlement_domain:SettlementDomain for EvidenceRef; settlement_domain:SettlementDomain, rung:Rung and inclusion_height:integer for EvidenceMaterial. Keep both settlement_domain.retired and settlement_domain assertions, every required-field assertion and the schema declarations unchanged."
build_reference = "/out/run/gates.jsonl: passing kind=build row records the final candidate revision, command, exit and private log location"
verify_reference = "/out/run/gates.jsonl: passing kind=verify row records the same final candidate revision, cg spec done command, exit and private log location; its verify_cmd includes schema-check, all crate tests and tools/qualification/test_beta_driver.py"
verified_revision_reference = "/out/run/gates.jsonl: last kind=verify row revision, with a passing kind=build row at that same revision"

[gotcha.3]
symptom = "The journey vocabulary loop expected EvidenceMaterial.optional to contain settlement_domain alone, preventing the beta driver tests from being reached."
cause = "The test predates task 10.92.1, whose receipt-proof v2 producer added rung and inclusion_height at journeys.kvx:58 in c55d8901a7."
repair = "Compare each section against its own complete optional-field list while retaining the retired settlement assertions for both."

[qualification.attempt2.result]
revision = "c2899bf12994f2c43410d34df27450f5fac86367"
build_command = "cargo build --locked --manifest-path services/human/tools/schema-check/Cargo.toml"
build_exit = 0
