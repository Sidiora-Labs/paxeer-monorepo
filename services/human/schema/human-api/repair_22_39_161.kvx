[finding.attempt2.beta_driver]
task = "22.39.161"
file = "tools/qualification/test_beta_driver.py:256"
symbol = "BetaDriverTests.assert_manifest_shape"
observed = "At revision c2899bf12994f2c43410d34df27450f5fac86367, cg spec done 22.39.161 -f layerx-merge --root /work/paxeer-monorepo exited 1 with private log /out/logs/verify-1.log after both inventory tests failed the real_stack is True assertion while the schema command and all Rust tests passed."
assumption = "The beta driver manifest real_stack contract is unrelated to the schema repair and requires its owner to reconcile the producer and consumer outside this task's allowed paths."
severity = "blocker"

[qualification.attempt3]
