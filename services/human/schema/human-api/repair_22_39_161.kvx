[violation.56]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "intent.kvx:module.progress: \"Progress and completion are read through GET /v1/journeys/{journey_id} in journeys.kvx. Submission and a transaction hash do not establish completion. The production EVM intent path waits for a verified committed receipt for each leg before advancing; a committed block on this network is final.\" -> \"Progress and completion are read through GET /v1/journeys/{journey_id} in journeys.kvx. Submission initially reports processing. Submission and a transaction hash establish only submitted progress, not receipt verification or completion. The production EVM intent path waits for a verified committed receipt for each leg before advancing; a committed block on this network is final.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "Submission initially reports processing; only committed verified receipts advance execution or complete the intent."

[violation.57]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "intent.kvx:module.spine: \"A human states one intent - move an amount of one asset from one endpoint to another - and the service plans its ordered calls on the merged Paxeer network. The kernel is part of that network and proposes blocks; the EVM chain id is 125 (0x7d). Planning is pure and deterministic: the same intent over the same observed state produces byte-identical plan bytes and therefore the same plan digest.\" -> \"A human states one intent - move an amount of one asset from one endpoint to another - and the service plans its ordered bank and budget calls on the single merged Paxeer network. The kernel is part of that network and proposes blocks; the EVM chain id is 125 (0x7d). Planning is pure and deterministic: the same intent over the same observed state produces byte-identical plan bytes and therefore the same plan digest.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "The planner constructs bank and budget calls on the single merged Paxeer network."

[violation.58]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "intent.kvx:type.IntentDomain.meaning: \"Retained wire labels, not separate settlement networks. The current planner labels protocol legs layerx and the production serializer preserves that value even though execution is an EVM call on Paxeer. paxeer labels the retired custody deposit and withdrawal mechanisms, which are refused by the current executable-shape classifier. A client must use the disclosed EVM call fields and must not select a second network from this label.\" -> \"Retained wire labels, not separate settlement networks. The current planner labels protocol legs layerx and the production serializer preserves that value even though execution is an EVM call on Paxeer. paxeer labels the retired custody deposit and withdrawal mechanisms, which are refused by the current executable-shape classifier. These labels are compatibility vocabulary, not execution authority. A client must use the disclosed EVM call fields and chain_id 125 and must not select a second network from this label.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "Retained domain labels are compatibility vocabulary; disclosed EVM fields and chain_id 125 determine execution."

[violation.59]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "intent.kvx:type.IntentLeg.order: \"Legs execute in index order. Each leg runs to its own verified receipt before the next leg starts.\" -> \"Legs execute in index order. Each leg runs to its own verified committed receipt before the production EVM intent path starts the next leg; a submitted transaction or a receipted execution alone cannot advance that path.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "Each leg waits for its verified committed receipt before the next leg starts."

[violation.60]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "journeys.kvx:module.network: \"Journeys describe one merged Paxeer network, whose kernel participates in the network and proposes blocks. A receipt establishes the verified execution outcome; that outcome is final once its block is committed. The rung and verification labels below describe evidence on this same network.\" -> \"Journeys describe one merged Paxeer network, whose kernel participates in the network and proposes blocks. A receipt establishes the verified execution outcome; that outcome is final once its block is committed. The current rungs are submitted, receipted and committed on this same network; committed is final, with no later settlement or checkpoint rung.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "Submitted, receipted and committed are rungs on one network; no later settlement rung follows committed."

[violation.61]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "journeys.kvx:type.EvidenceClass.meaning: \"layerx-receipt is the retained wire class for a receipt on the merged network. checkpoint-proof describes commitment evidence on that network. paxeer-finality is retired legacy vocabulary, not another finality source for new journeys.\" -> \"layerx-receipt is the retained wire class for a receipt on the merged network. checkpoint-proof describes commitment evidence on that network. paxeer-finality is retired legacy vocabulary, not another finality source for new journeys. Legacy evidence classes remain decodable but never authorize a new execution or promote a current journey to final.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "Legacy evidence stays decodable but does not authorize execution or upgrade finality."

[violation.62]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "journeys.kvx:type.JourneyState.done-finalised.semantics: \"The receipt-backed outcome has committed evidence on the same network, represented by checkpoint-finalised verification. This retained status label is not required for every committed journey: the EVM intent and native journey projections render done and expose evidence separately.\" -> \"The receipt-backed outcome has committed evidence on the same network, represented by checkpoint-finalised verification. checkpoint-finalised names the committed rung rather than an additional proof to await after commitment. This retained status label is not required for every committed journey: the EVM intent and native journey projections render done and expose evidence separately.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "checkpoint-finalised denotes commitment, not an extra proof after commitment."

[violation.63]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "journeys.kvx:type.JourneyState.done.semantics: \"A verified receipt backs the exact outcome of every completed leg. The production EVM intent path requires committed receipt material before rendering done. Other receipt-backed projections may render done at receipted; use evidence verification and rung to distinguish execution evidence from block commitment. No independent settlement step follows a committed block.\" -> \"A verified receipt backs the exact outcome of every completed leg. The production EVM intent path requires committed receipt material before rendering done. Other receipt-backed projections may render done at receipted; use evidence.get and its authenticated material, verification and rung to distinguish execution evidence from block commitment; the done label alone is not a finality proof. No independent settlement step follows a committed block.\""
producer_commit = "cdcf3bfd4700337810ee0c3f599a7b71d0c4b9d5"
reason = "The done label alone proves no finality; authenticated evidence material and rung distinguish receipt from commitment."

[violation.64]
class = "breaking-declaration-change"
path = "services/human/schema/human-api/baseline.kvx"
detail = "program-approvals.kvx:type.ProgramApprovalDecisionRequest.required: [\"held_digest:string\",\"step_up_evidence:EvidenceId\"] -> [\"held_digest:string\",\"step_up_evidence:StepUpChallengeId\"]"
producer_commit = "7e32286b9a58600532e003f4f658ea95c05d0f91"
reason = "Approval decisions pass the original completed challenge_id to the durable evidence loader, preserving its chg_ prefix rather than using an evidence export identifier."

