[module]
name = "intent"
contract_major = 1
compatibility = "additive_only"
spine = "A human states one intent - move an amount of one asset from one endpoint to another - and the service plans its ordered bank and budget calls on the single merged Paxeer network. The kernel is part of that network and proposes blocks; the EVM chain id is 125 (0x7d). Planning is pure and deterministic: the same intent over the same observed state produces byte-identical plan bytes and therefore the same plan digest."
observed_state = "The service assembles the observed state the planner reads. The authenticated principal's balance and managed budget state come through the agent runtime; allowance headroom and budget bindings come from managed-agent records checked against that state. The fee schedule uses the configured EVM gas limit and maximum fee per gas. Bank send construction resolves the denomination against the network gateway's asset and balance inventory and resolves the recipient's bound EVM address through identity and node reads. The caller states an intent and never states the headroom that would authorise it."
never_partial = "The observation contract requires a typed refusal naming any source that cannot answer, and forbids treating an unobserved balance as zero. Unknown balances must remain distinct from known zero balances; callers cannot supply a balance to bypass this rule. The production path refuses stale required state and a missing bank asset or denomination match rather than constructing an executable plan."
digest_binding = "The plan digest commits to the intent and to every leg, and each leg's action key and signing context are derived from it. A signed plan therefore cannot be re-routed: altering any leg changes the digest and invalidates every signature over it."
replan_on_submit = "Submission re-plans server-side against the observed state at submission time and refuses when the digest no longer matches. A plan is never executed on the strength of the caller's copy of it."
no_new_verb = "Intent planning adds no transfer type. Current movements use move and the planner selects the mechanism. The production intent path constructs send calls and budget-defund calls; deposit and withdraw are retired custody-boundary journeys and cannot be initiated. A planner candidate is not an executable offer until the service has constructed its EVM calls."
progress = "Progress and completion are read through GET /v1/journeys/{journey_id} in journeys.kvx. Submission initially reports processing. Submission and a transaction hash establish only submitted progress, not receipt verification or completion. The production EVM intent path waits for a verified committed receipt for each leg before advancing; a committed block on this network is final."

[type.IntentEndpointKind]
variants = ["paxeer-wallet","human","agent","agent-budget"]
closed = "The closed wire vocabulary for source and destination kinds. paxeer-wallet is a retained legacy label naming the bound wallet with no account name; the production intent path refuses it as either endpoint. Current plans use canonical human, agent or agent-budget accounts, subject to route and authority checks."

[type.IntentEndpoint]
required = ["kind:IntentEndpointKind"]
optional = ["account:string"]
account_rule = "account carries the canonical protocol account name for human, agent and agent-budget endpoints and is absent for paxeer-wallet."

[type.IntentDomain]
variants = ["paxeer","layerx"]
meaning = "Retained wire labels, not separate settlement networks. The current planner labels protocol legs layerx and the production serializer preserves that value even though execution is an EVM call on Paxeer. paxeer labels the retired custody deposit and withdrawal mechanisms, which are refused by the current executable-shape classifier. These labels are compatibility vocabulary, not execution authority. A client must use the disclosed EVM call fields and chain_id 125 and must not select a second network from this label."

[type.IntentConstraints]
required = ["deadline:Timestamp","max_fee:Money","allow_top_up:boolean"]
deadline = "A plan observed after its deadline is refused rather than planned."
top_up = "allow_top_up false forbids any top-up leg outright. allow_top_up true permits one only where a user-signed allowance already covers that exact leg; it does not make an unsupported mechanism executable or enable a retired custody route."

[type.PlanIntentRequest]
required = ["source:IntentEndpoint","destination:IntentEndpoint","asset_id:string","money:Money","constraints:IntentConstraints"]
asset_id = "The 32-byte lowercase hexadecimal asset identifier, unprefixed. For a bank send, the service matches it to SHA-256 of the denomination in a gateway asset row whose asset_id is denom:<denomination> and requires the corresponding balance row."
authority = "The request states the movement only. Balances, allowances and limits are read by the service and are never accepted from the caller."

[type.IntentLeg]
required = ["index:integer","mechanism:string","domain:IntentDomain","source:IntentEndpoint","destination:IntentEndpoint","money:Money","fee:Money"]
optional = ["to:EvmAddress","value:Amount","calldata:string","nonce:integer","chain_id:integer","gas_limit:integer","max_fee_per_gas:Amount","max_priority_fee_per_gas:Amount"]
order = "Legs execute in index order. Each leg runs to its own verified committed receipt before the production EVM intent path starts the next leg; a submitted transaction or a receipted execution alone cannot advance that path."
evm_call = "The production response supplies to, value, calldata, nonce, chain_id, gas_limit, max_fee_per_gas and max_priority_fee_per_gas for every leg. Addresses and calldata have a 0x prefix; value and gas prices are decimal strings. The EIP-1559 transaction uses value zero. Nonces start at the sender's pending EVM nonce and increase by leg index."
send = "send targets the bank precompile at 0x0000000000000000000000000000000000001001 with send(address,address,string,uint256), selector 0x5c05961b. Its arguments bind the custody wallet, resolved recipient address, denomination and amount."
budget_defund = "budget-defund targets 0x000000000000000000000000000000000000101b with budgetDefund(bytes32,uint128), binding the managed budget identifier and amount. Unsupported mechanisms refuse EVM call construction."

[type.IntentSigningRequirement]
required = ["leg_index:integer","action_key:string","signing_context:string","authority:string"]
derivation = "action_key and signing_context are lowercase hexadecimal and are derived from the plan digest, so they change whenever any leg changes."

[type.IntentPlan]
required = ["plan_digest:string","journey_kind:string","total_fee:Money","legs:IntentLeg[]","signing_requirements:IntentSigningRequirement[]"]
optional = ["tx_hash:WalletTxId"]
digest = "plan_digest is the lowercase hexadecimal plan digest, unprefixed. It is what the caller signs and what submission re-checks."
tx_hash = "Present only when an actual transaction hash is known; pure planning never invents one."

[type.IntentLegBinding]
required = ["leg_index:integer","action_key:string","actor:string","authority:string","relationship:string","account_sequence:integer","not_before:integer","not_after:integer","fee_limit:Money"]
binding = "One binding per leg, carrying the action key it was signed against. A binding whose action key belongs to another plan is refused."
account_sequence = "Per decision.1003, account_sequence keeps its existing name and integer type and carries the sender EVM nonce read at the pending tag plus the leg index. Submission checks that nonce, actor, authority, relationship, validity window and fee limit against server observations; repeated sender/nonce pairs are refused."

[type.SubmitPlanRequest]
required = ["plan_digest:string","signed_digest:string","bindings:IntentLegBinding[]"]
optional = ["native_access_id:string"]
replan = "The service retrieves the original intent from the authenticated observation memo and re-plans against the observed state at submission time. When the recomputed digest differs from plan_digest the submission is refused and no journey is created. The canonical plan, disclosed EVM transactions and custody and identity bindings must also match the memo."

[type.IntentSubmission]
required = ["journey_id:JourneyId","plan_digest:string","state:string","state_copy_key:CopyKey"]
optional = ["tx_hash:WalletTxId"]
progress = "The journey is then read through GET /v1/journeys/{journey_id} like every other journey."
tx_hash = "The actual submitted EVM transaction hash, when known. Submission alone does not establish a verified receipt."

[operation.intent.plan]
authorization_class = "money-movement"
method = "POST"
path = "/v1/intents/plan"
request = "PlanIntentRequest"
response = "IntentPlan"
purity = "Planning changes no money, custody, signing, authorization or journey state. The service retains an immutable private canonical observation memo scoped to the authenticated tenant, principal, session and custody identity, so the existing strict submission body can reference the original intent by plan_digest. Planning output remains deterministic and states exactly what must be signed."
refusal = "A route the planner cannot serve, a deadline already passed, an unobservable balance and a top-up without a covering allowance are each typed refusals, never a partial plan."

[operation.intent.submit]
authorization_class = "money-movement"
method = "POST"
path = "/v1/intents/submit"
request = "SubmitPlanRequest"
response = "IntentSubmission"
idempotency = true
repeat_rule = "Repeating the same request under the same Idempotency-Key and authenticated session returns the retained original result rather than a second effect. Reusing the key with a changed body, plan or identity binding is refused. Read current progress through journeys.kvx."
digest_check = "The submission is refused when the re-planned digest no longer matches the signed one, so a plan signed against a state that has since changed never executes."
