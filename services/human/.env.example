# Human workspace environment inputs.
# Required entries without defaults need deployment values.
# Optional entries remain commented until their feature is selected.
# File settings contain paths; secret contents belong in protected files.
# Empty RP_ID and WEB_ORIGIN entries select the source constants.
# Cargo supplies CARGO_MANIFEST_DIR, CARGO_PKG_VERSION and OUT_DIR at build time.

# Cargo-supplied package directory used by gateway code generation. Build time only; supplied by Cargo.
# CARGO_MANIFEST_DIR=

# Cargo-supplied package version embedded in the HTTP service. Build time only; supplied by Cargo.
# CARGO_PKG_VERSION=

# Expected chain ID for native node RPC reads; configure the merged network chain ID.
LAYERX_AGENT_NODE_CHAIN_ID=

# Node JSON-RPC URL used for native reads and receipt evidence.
LAYERX_AGENT_NODE_RPC_URL=

# Path to the event upstream trust-root DER certificate.
LAYERX_EVENTS_APPROVAL_UPSTREAM_CA_DER=

# Path to the protected PKCS#12 password file. Required for authenticated event delivery.
LAYERX_EVENTS_APPROVAL_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=

# Path to the event producer client certificate and private key PKCS#12 bundle. Required for authenticated event delivery.
LAYERX_EVENTS_APPROVAL_UPSTREAM_CLIENT_IDENTITY_PKCS12=

# Path to an optional protected upstream session cookie file. Omit for authenticated event delivery, which requires mTLS and a bearer credential without a cookie.
# LAYERX_EVENTS_APPROVAL_UPSTREAM_COOKIE_FILE=

# Path to the protected event producer bearer token file. Required for authenticated event delivery.
LAYERX_EVENTS_APPROVAL_UPSTREAM_TOKEN_FILE=

# HTTPS origin for approval event delivery.
LAYERX_EVENTS_APPROVAL_UPSTREAM_URL=

# Path to the event upstream trust-root DER certificate.
LAYERX_EVENTS_JOURNEY_UPSTREAM_CA_DER=

# Path to the protected PKCS#12 password file. Required for authenticated event delivery.
LAYERX_EVENTS_JOURNEY_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=

# Path to the event producer client certificate and private key PKCS#12 bundle. Required for authenticated event delivery.
LAYERX_EVENTS_JOURNEY_UPSTREAM_CLIENT_IDENTITY_PKCS12=

# Path to an optional protected upstream session cookie file. Omit for authenticated event delivery, which requires mTLS and a bearer credential without a cookie.
# LAYERX_EVENTS_JOURNEY_UPSTREAM_COOKIE_FILE=

# Path to the protected event producer bearer token file. Required for authenticated event delivery.
LAYERX_EVENTS_JOURNEY_UPSTREAM_TOKEN_FILE=

# HTTPS origin for journey event delivery.
LAYERX_EVENTS_JOURNEY_UPSTREAM_URL=

# Path to the event upstream trust-root DER certificate.
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CA_DER=

# Path to the protected PKCS#12 password file. Required for authenticated event delivery.
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=

# Path to the event producer client certificate and private key PKCS#12 bundle. Required for authenticated event delivery.
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_CLIENT_IDENTITY_PKCS12=

# Path to an optional protected upstream session cookie file. Omit for authenticated event delivery, which requires mTLS and a bearer credential without a cookie.
# LAYERX_EVENTS_WEBHOOKS_UPSTREAM_COOKIE_FILE=

# Path to the protected event producer bearer token file. Required for authenticated event delivery.
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_TOKEN_FILE=

# HTTPS origin for webhooks event delivery.
LAYERX_EVENTS_WEBHOOKS_UPSTREAM_URL=

# Maximum activity export size in bytes.
LAYERX_HUMAN_ACTIVITY_EXPORT_MAXIMUM_BYTES=

# Activity freshness bound in seconds.
LAYERX_HUMAN_ACTIVITY_FRESHNESS_SECONDS=

# Agent DID used for lifecycle requests.
LAYERX_HUMAN_AGENT_ACTOR=

# Authority reference used for agent lifecycle requests.
LAYERX_HUMAN_AGENT_AUTHORITY=

# Agent-runtime request deadline in seconds.
LAYERX_HUMAN_AGENT_DEADLINE_SECONDS=

# Maximum agent operation fee.
LAYERX_HUMAN_AGENT_FEE_LIMIT=

# Maximum agent-runtime connections.
LAYERX_HUMAN_AGENT_MAX_CONNECTIONS=

# Maximum agent-runtime frame size in bytes.
LAYERX_HUMAN_AGENT_MAX_FRAME_BYTES=

# Maximum agent-runtime queued bytes.
LAYERX_HUMAN_AGENT_MAX_QUEUED_BYTES=

# Maximum agent-runtime streams.
LAYERX_HUMAN_AGENT_MAX_STREAMS=

# Owner account used in agent creation.
LAYERX_HUMAN_AGENT_OWNER_ACCOUNT=

# Absolute path to the agent purpose preset JSON catalogue.
LAYERX_HUMAN_AGENT_PURPOSE_CATALOG=

# Base64url encoding without padding of the 32-byte recovery commitment.
LAYERX_HUMAN_AGENT_RECOVERY_ROOT=

# Agent recovery approval threshold.
LAYERX_HUMAN_AGENT_RECOVERY_THRESHOLD=

# Absolute path to the agent runtime Unix socket.
LAYERX_HUMAN_AGENT_SOCKET=

# Agent request timestamp span in seconds.
LAYERX_HUMAN_AGENT_TIMESTAMP_SPAN_SECONDS=

# Passkey assertion lifetime in seconds.
LAYERX_HUMAN_ASSERTION_TTL_SECONDS=

# Absolute path to the attestor client DER certificate. Required when ATTESTOR_NODES selects attestor custody.
LAYERX_HUMAN_ATTESTOR_CLIENT_CERTIFICATE_DER=

# Absolute path to the attestor client DER private key. Required when ATTESTOR_NODES selects attestor custody.
LAYERX_HUMAN_ATTESTOR_CLIENT_PRIVATE_KEY_DER=

# Attestor request deadline in seconds. Required when ATTESTOR_NODES selects attestor custody.
LAYERX_HUMAN_ATTESTOR_DEADLINE_SECONDS=

# Comma-separated attestor node identifiers paired with socket endpoints; a nonempty value selects attestor custody.
# LAYERX_HUMAN_ATTESTOR_NODES=

# Absolute path to the attestor trust-root DER certificate. Required when ATTESTOR_NODES selects attestor custody.
LAYERX_HUMAN_ATTESTOR_ROOT_CERTIFICATE_DER=

# Comma-separated attestor signer identifiers; at least three distinct configured nodes. Required when ATTESTOR_NODES selects attestor custody.
LAYERX_HUMAN_ATTESTOR_SIGNERS=

# Base64url encoding without padding of the 32-byte authentication-index key.
LAYERX_HUMAN_AUTH_INDEX_KEY=

# Absolute path to the authentication discovery index directory.
LAYERX_HUMAN_AUTH_INDEX_ROOT=

# Authentication attempts allowed per rate window.
LAYERX_HUMAN_AUTH_RATE_ATTEMPTS=

# Authentication rate window in seconds.
LAYERX_HUMAN_AUTH_RATE_WINDOW_SECONDS=

# HTTP service listen socket.
LAYERX_HUMAN_BIND=

# Capability lifetime in seconds; accepts 1 through 60.
LAYERX_HUMAN_CAPABILITY_TTL_SECONDS=

# Passkey ceremony lifetime in seconds.
LAYERX_HUMAN_CEREMONY_TTL_SECONDS=

# UID required for the component process and its authorized local caller.
LAYERX_HUMAN_COMPONENT_ALLOWED_UID=

# Component request queue capacity.
LAYERX_HUMAN_COMPONENT_QUEUE_CAPACITY=

# Unix socket connecting the HTTP service and privileged component server.
LAYERX_HUMAN_COMPONENT_SOCKET=

# Component worker count.
LAYERX_HUMAN_COMPONENT_WORKERS=

# Deadline for unresolved continuations in seconds.
LAYERX_HUMAN_CONTINUATION_UNKNOWN_DEADLINE_SECONDS=

# Absolute path to the custody state directory.
LAYERX_HUMAN_CUSTODY_ROOT=

# Absolute path enabling the owner-only event delivery status Unix socket.
# LAYERX_HUMAN_EVENT_STATUS_SOCKET=

# EVM transaction gas limit.
LAYERX_HUMAN_EVM_GAS_LIMIT=

# EVM transaction maximum fee per gas.
LAYERX_HUMAN_EVM_MAX_FEE_PER_GAS=

# EVM transaction maximum priority fee per gas.
LAYERX_HUMAN_EVM_MAX_PRIORITY_FEE_PER_GAS=

# Gas-station HTTPS origin; required when the onboarding registry omits gas_station.
LAYERX_HUMAN_GAS_STATION_ENDPOINT=

# Path to the gas-station trust-root DER certificate. Read by onboarding prepare and sign.
LAYERX_HUMAN_GAS_STATION_UPSTREAM_CA_DER=

# Path to the protected PKCS#12 password file; required with a client identity. Read by onboarding prepare and sign.
# LAYERX_HUMAN_GAS_STATION_UPSTREAM_CLIENT_IDENTITY_PASSWORD_FILE=

# Path to an optional gas-station client certificate and private key PKCS#12 bundle. Read by onboarding prepare and sign.
# LAYERX_HUMAN_GAS_STATION_UPSTREAM_CLIENT_IDENTITY_PKCS12=

# Path to an optional protected gas-station session cookie file. Read by onboarding prepare and sign.
# LAYERX_HUMAN_GAS_STATION_UPSTREAM_COOKIE_FILE=

# Path to an optional protected gas-station bearer token file. Read by onboarding prepare and sign.
# LAYERX_HUMAN_GAS_STATION_UPSTREAM_TOKEN_FILE=

# Gas-station HTTPS origin; must match the registry or endpoint setting. Read by onboarding prepare and sign.
LAYERX_HUMAN_GAS_STATION_UPSTREAM_URL=

# Principal-to-tenant binding lookup deadline in seconds.
LAYERX_HUMAN_IDENTITY_BINDING_DEADLINE_SECONDS=

# Expected binding provider peer GID.
LAYERX_HUMAN_IDENTITY_BINDING_PEER_GID=

# Expected binding provider peer UID.
LAYERX_HUMAN_IDENTITY_BINDING_PEER_UID=

# Absolute path to the principal-to-tenant binding Unix socket.
LAYERX_HUMAN_IDENTITY_BINDING_SOCKET=

# Tenant pinned for principal binding lookups.
LAYERX_HUMAN_IDENTITY_BINDING_TENANT=

# Identity provider request deadline in seconds.
LAYERX_HUMAN_IDENTITY_DEADLINE_SECONDS=

# Maximum identity provider frame size in bytes.
LAYERX_HUMAN_IDENTITY_MAX_FRAME_BYTES=

# Expected identity provider peer GID.
LAYERX_HUMAN_IDENTITY_PEER_GID=

# Expected identity provider peer UID.
LAYERX_HUMAN_IDENTITY_PEER_UID=

# UID permitted to call the identity provider.
LAYERX_HUMAN_IDENTITY_PROVIDER_ALLOWED_UID=

# Expected assertion audience. Required when any assertion login setting is present.
LAYERX_HUMAN_IDENTITY_PROVIDER_ASSERTION_AUDIENCE=

# Wallet-binding producer public verification key in uncompressed SEC1 hexadecimal.
# LAYERX_HUMAN_IDENTITY_PROVIDER_ASSERTION_BINDING_PRODUCER_KEY=

# Assertion time tolerance in seconds; maximum 300.
# LAYERX_HUMAN_IDENTITY_PROVIDER_ASSERTION_CLOCK_SKEW_SECONDS=60

# Expected assertion issuer. Required when any assertion login setting is present.
LAYERX_HUMAN_IDENTITY_PROVIDER_ASSERTION_ISSUER=

# Assertion verification JWKS URL. Required when any assertion login setting is present.
LAYERX_HUMAN_IDENTITY_PROVIDER_ASSERTION_JWKS_URL=

# JWKS freshness and refresh interval in seconds; accepts 1 through 3600.
# LAYERX_HUMAN_IDENTITY_PROVIDER_ASSERTION_REFRESH_INTERVAL_SECONDS=300

# Comma-separated UIDs permitted to read identity bindings. Required together when any provider BINDING variable is present.
LAYERX_HUMAN_IDENTITY_PROVIDER_BINDING_ALLOWED_UIDS=

# Binding reader Unix socket path. Required together when any provider BINDING variable is present.
LAYERX_HUMAN_IDENTITY_PROVIDER_BINDING_SOCKET=

# Binding reader tenant. Required together when any provider BINDING variable is present.
LAYERX_HUMAN_IDENTITY_PROVIDER_BINDING_TENANT=

# Identity provider and probe deadline in seconds; accepts 1 through 60.
# LAYERX_HUMAN_IDENTITY_PROVIDER_DEADLINE_SECONDS=5

# Path to the owner-only recovery policy JSON file.
LAYERX_HUMAN_IDENTITY_PROVIDER_RECOVERY_POLICY_FILE=

# Absolute identity provider Unix socket path; also used by its probe.
LAYERX_HUMAN_IDENTITY_PROVIDER_SOCKET=

# Identity provider durable state directory.
LAYERX_HUMAN_IDENTITY_PROVIDER_STATE_ROOT=

# Absolute path to the identity provider Unix socket.
LAYERX_HUMAN_IDENTITY_SOCKET=

# HTTP connection I/O deadline in seconds.
# LAYERX_HUMAN_IO_DEADLINE_SECONDS=15

# Absolute path to protected principal-bound EVM attestor configuration JSON.
# LAYERX_HUMAN_KMS_ATTESTOR_CONFIG_FILE=

# Absolute path to the KMS client trust-root DER certificate.
LAYERX_HUMAN_KMS_CLIENT_CA_DER=

# Absolute path to the component KMS client DER certificate. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_CLIENT_CERTIFICATE_DER=

# Absolute path to the pinned service client DER certificate.
LAYERX_HUMAN_KMS_CLIENT_CERT_DER=

# Absolute path to the component KMS client DER private key. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_CLIENT_PRIVATE_KEY_DER=

# KMS request deadline in seconds; the standalone provider requires 1 through 60. Required by components when attestor custody is absent. Also required by the standalone KMS provider.
LAYERX_HUMAN_KMS_DEADLINE_SECONDS=

# Remote KMS socket endpoint. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_ENDPOINT=

# Absolute path to the distinct attestor EVM signer client DER certificate.
# LAYERX_HUMAN_KMS_EVM_CLIENT_CERT_DER=

# Absolute path to the gateway client trust-root DER certificate.
LAYERX_HUMAN_KMS_GATEWAY_CLIENT_CA_DER=

# Absolute path to the pinned gateway client DER certificate.
LAYERX_HUMAN_KMS_GATEWAY_CLIENT_CERT_DER=

# Gateway client request deadline in seconds.
LAYERX_HUMAN_KMS_GATEWAY_DEADLINE_SECONDS=

# Gateway listen socket.
LAYERX_HUMAN_KMS_GATEWAY_LISTEN=

# Maximum gateway client connections.
LAYERX_HUMAN_KMS_GATEWAY_MAX_CONNECTIONS=

# Maximum gateway client frame size in bytes.
LAYERX_HUMAN_KMS_GATEWAY_MAX_FRAME_BYTES=

# Absolute path to the gateway-to-provider client DER certificate.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_CLIENT_CERTIFICATE_DER=

# Absolute path to the gateway-to-provider client DER private key.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_CLIENT_PRIVATE_KEY_DER=

# Gateway-to-provider request deadline in seconds.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_DEADLINE_SECONDS=

# Remote provider socket endpoint; must differ from the gateway listener.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_ENDPOINT=

# Provider selection; requires remote-lxkp.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_KIND=

# Maximum gateway-to-provider connections.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_MAX_CONNECTIONS=

# Maximum gateway-to-provider frame size in bytes.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_MAX_FRAME_BYTES=

# Maximum gateway-to-provider queued bytes.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_MAX_QUEUED_BYTES=

# Maximum gateway-to-provider streams.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_MAX_STREAMS=

# Expected remote KMS provider reference.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_REFERENCE=

# Absolute path to the provider trust-root DER certificate.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_ROOT_CERTIFICATE_DER=

# Provider TLS server name.
LAYERX_HUMAN_KMS_GATEWAY_PROVIDER_SERVER_NAME=

# Maximum gateway operations per rate window.
LAYERX_HUMAN_KMS_GATEWAY_RATE_MAXIMUM=

# Gateway operation rate window in seconds.
LAYERX_HUMAN_KMS_GATEWAY_RATE_WINDOW_SECONDS=

# Absolute path to the gateway chain snapshot JSON file.
LAYERX_HUMAN_KMS_GATEWAY_REGISTRY_FILE=

# Absolute path to the gateway server DER certificate.
LAYERX_HUMAN_KMS_GATEWAY_TLS_CERT_DER=

# Absolute path to the gateway server DER private key.
LAYERX_HUMAN_KMS_GATEWAY_TLS_KEY_DER=

# KMS server listen socket.
LAYERX_HUMAN_KMS_LISTEN=

# Maximum component-to-KMS connections. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_MAX_CONNECTIONS=

# Maximum component-to-KMS frame size in bytes. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_MAX_FRAME_BYTES=

# Maximum component-to-KMS queued bytes. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_MAX_QUEUED_BYTES=

# Maximum component-to-KMS streams. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_MAX_STREAMS=

# KMS provider identity reference. Required by components when attestor custody is absent. Also required by the standalone KMS provider.
LAYERX_HUMAN_KMS_PROVIDER_REFERENCE=

# Absolute path to the KMS chain snapshot JSON file.
LAYERX_HUMAN_KMS_REGISTRY_FILE=

# Absolute path to the remote KMS trust-root DER certificate. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_ROOT_CERTIFICATE_DER=

# Absolute path to the protected 32-byte state-sealing secret file.
LAYERX_HUMAN_KMS_SEAL_SECRET_FILE=

# Remote KMS TLS server name. Required by components when attestor custody is absent.
LAYERX_HUMAN_KMS_SERVER_NAME=

# KMS durable state directory.
LAYERX_HUMAN_KMS_STATE_DIR=

# Absolute path to the KMS server DER certificate.
LAYERX_HUMAN_KMS_TLS_CERT_DER=

# Absolute path to the KMS server DER private key.
LAYERX_HUMAN_KMS_TLS_KEY_DER=

# HTTP listener mode; accepts tls or plain.
# LAYERX_HUMAN_LISTENER=tls

# Interval between component maintenance passes in seconds.
LAYERX_HUMAN_MAINTENANCE_INTERVAL_SECONDS=

# Maximum items processed per maintenance pass.
LAYERX_HUMAN_MAINTENANCE_MAXIMUM_ITEMS=

# Maximum HTTP request body size in bytes.
# LAYERX_HUMAN_MAX_BODY_BYTES=1048576

# Maximum simultaneous HTTP connections.
# LAYERX_HUMAN_MAX_CONNECTIONS=1024

# Maximum HTTP header size in bytes.
# LAYERX_HUMAN_MAX_HEADER_BYTES=32768

# Maximum principals tracked by the HTTP limiter.
# LAYERX_HUMAN_MAX_PRINCIPALS=100000

# Network identifier for custody operations; configure the merged network chain ID.
LAYERX_HUMAN_NETWORK_ID=

# Initial funding amount for onboarding.
LAYERX_HUMAN_ONBOARDING_INITIAL_FUNDING=

# Absolute path to the onboarding JSON registry; required by prepare and sign.
LAYERX_HUMAN_ONBOARDING_REGISTRY_FILE=

# Principal authorized to sponsor onboarding.
LAYERX_HUMAN_ONBOARDING_SPONSOR_PRINCIPAL=

# Expected passkey assertion origin.
LAYERX_HUMAN_ORIGIN=

# Custody commitment protocol version; accepts 3.
# LAYERX_HUMAN_PROTOCOL_VERSION=3

# Session refresh lifetime in seconds.
LAYERX_HUMAN_REFRESH_TTL_SECONDS=

# Requests allowed per principal per 60-second window.
# LAYERX_HUMAN_REQUESTS_PER_MINUTE=240

# Audit retention period in seconds.
LAYERX_HUMAN_RETENTION_AUDIT_SECONDS=

# Cache retention period in seconds.
LAYERX_HUMAN_RETENTION_CACHE_SECONDS=

# Journeys retention period in seconds.
LAYERX_HUMAN_RETENTION_JOURNEYS_SECONDS=

# Notifications retention period in seconds.
LAYERX_HUMAN_RETENTION_NOTIFICATIONS_SECONDS=

# Telemetry retention period in seconds.
LAYERX_HUMAN_RETENTION_TELEMETRY_SECONDS=

# Passkey relying party identifier; whitespace-only or empty input selects the source default.
# LAYERX_HUMAN_RP_ID=

# Passkey relying party display name.
LAYERX_HUMAN_RP_NAME=

# Security provider request deadline in seconds.
LAYERX_HUMAN_SECURITY_DEADLINE_SECONDS=

# Maximum security provider frame size in bytes.
LAYERX_HUMAN_SECURITY_MAX_FRAME_BYTES=

# UID permitted to call the security provider.
LAYERX_HUMAN_SECURITY_PROVIDER_ALLOWED_UID=

# Security provider and probe deadline in seconds; accepts 1 through 60.
# LAYERX_HUMAN_SECURITY_PROVIDER_DEADLINE_SECONDS=5

# Absolute security provider Unix socket path; also used by its probe.
LAYERX_HUMAN_SECURITY_PROVIDER_SOCKET=

# Absolute security provider durable state directory.
LAYERX_HUMAN_SECURITY_PROVIDER_STATE_ROOT=

# Absolute path to the encoded validator trust root used to verify recovery receipts.
LAYERX_HUMAN_SECURITY_PROVIDER_TRUST_HISTORY=

# Absolute path to the security provider Unix socket.
LAYERX_HUMAN_SECURITY_SOCKET=

# Access session lifetime in seconds.
LAYERX_HUMAN_SESSION_TTL_SECONDS=

# Maximum custody signatures per rate window.
LAYERX_HUMAN_SIGNING_RATE_MAXIMUM=

# Custody signing rate window in seconds.
LAYERX_HUMAN_SIGNING_RATE_WINDOW_SECONDS=

# Step-up evidence lifetime in seconds.
LAYERX_HUMAN_STEP_UP_TTL_SECONDS=

# Absolute path to the principal store directory; also read by onboarding store initialization.
LAYERX_HUMAN_STORE_ROOT=

# Base64url encoding without padding of the 32-byte stream cursor authentication key.
LAYERX_HUMAN_STREAM_CURSOR_KEY=

# Base64url encoding without padding of the 32-byte installed tenancy-map digest.
LAYERX_HUMAN_TENANCY_DIGEST=

# Path to the HTTP listener DER certificate. Required in TLS mode; omitted in plain mode.
LAYERX_HUMAN_TLS_CERT_DER=

# Path to the HTTP listener DER private key. Required in TLS mode; omitted in plain mode.
LAYERX_HUMAN_TLS_KEY_DER=

# Comma-separated HTTP allowed origins; whitespace-only or empty input selects the source default.
# LAYERX_HUMAN_WEB_ORIGIN=

# Hosted network gateway HTTP or HTTPS endpoint used for identity and balance lookups.
LAYERX_NETWORK_GATEWAY_ENDPOINT=

# Runtime clock supervisor process ID.
LAYERX_RUNTIME_CLOCK_PID=

# Absolute runtime clock supervisor Unix socket path.
LAYERX_RUNTIME_CLOCK_SOCKET=

# Runtime clock supervisor owner UID.
LAYERX_RUNTIME_CLOCK_UID=

# Cargo-supplied generated-code output directory. Build time only; supplied by Cargo.
# OUT_DIR=

# Presence enables native custody consumer and principal-store diagnostic messages.
# PAXEER_X_NATIVE_CUSTODY_LIVE_FIXTURE=

# Presence enables native custody consumer and principal-store diagnostic messages.
# PAXEER_X_NATIVE_SEND_LIVE_FIXTURE=
