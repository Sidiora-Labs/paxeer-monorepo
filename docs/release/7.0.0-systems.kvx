# Paxeer 7.0.0 systems.
# Build commands run from the repository root unless they include cd.

[system.chain-node]
title = "Paxeer chain node"
kind = "node"
path = "daemon/paxd"
build = "make build"
artefact = "build/paxd"
configuration = "node/params/config.go and docs/release/7.0.0-validator-runbook.md"
ports = ["26656", "26657", "8545", "8546", "1317"]
health = "paxd status"
depends = []
docs = ["docs/release/7.0.0-upgrade-plan.md", "docs/release/7.0.0-validator-runbook.md", "docs/site/paxeer-docs/src/app/run-node/page.tsx", "/run-node"]
change = "changed"

[system.kernel]
title = "LayerX kernel host"
kind = "kernel"
path = "modules/lxphost"
build = "make build"
artefact = "build/paxd with the native kernel archive"
configuration = "modules/lxphost and docs/site/paxeer-docs/src/app/layerx-kernel/page.tsx"
ports = []
health = "paxd status"
depends = ["chain-node"]
docs = ["docs/system/kernel-modules.md", "docs/site/paxeer-docs/src/app/layerx-kernel/page.tsx", "/layerx-kernel"]
change = "changed"

[system.module-epoch]
title = "Epoch module"
kind = "module"
path = "modules/epoch"
build = "go build ./modules/epoch/..."
artefact = "linked into build/paxd"
configuration = "modules/epoch/types and node/app.go"
ports = []
health = "paxd status"
depends = ["chain-node"]
docs = ["docs/system/chain-modules.md", "docs/site/paxeer-docs/src/app/modules/page.tsx", "/modules"]
change = "unchanged"

