contract = "Extract the production C preamble through lxphost_reset byte for byte, excluding only cgo directives; existing tests compare the entire snapshot against the producer before consuming real C-built witnesses. The twelve-leaf compatibility fixture still uses the unchanged production C encoder/decoder/verifier."

[producer.host_transcript]
commit = "b37eb82c177a90aa046c214fa879cbc671fbc5c5"
source = "modules/lxphost/host.go"
generator = "python3 layerxproof/verify/testdata/record_repair_m2.py"
output = "layerxproof/verify/testdata/repair_m2.json"
contract = "The existing recorder compiles the current production host preamble, commits account/module state, persists a snapshot, destroys the original host, restores a new host, and regenerates native witnesses; every source hash and every resulting byte comes from the recorder. No transcript field was edited by hand."

[case.TestNativeStateProofsFromCore]
