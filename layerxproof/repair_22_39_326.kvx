cause = "The producer source hash and the committed host state no longer match the production host."
repair = "Run record_repair_m2.py, regenerating the complete transcript, native roots, paths, proofs, persisted snapshot, manifest digest and provenance hashes."

[case.TestRepairM_2_PersistedCHostRecovery]
inventory_first_error = "verify/repair_m2_test.go:233: native producer modules/lxphost/host.go changed; regenerate the recorded transcript"
cause = "The restart proof reads the same stale transcript before validating recovery."
repair = "Capture the real snapshot-store write/read and restored host again; retain exact before/after state equality, manifest binding and full 128-bit account balances."

[case.TestRepairM_2_RestoredProofRejectsForeignBindingsAndTampering]
inventory_first_error = "verify/repair_m2_test.go:266: native producer modules/lxphost/host.go changed; regenerate the recorded transcript"
cause = "The restored account witnesses and source provenance came from the earlier host."
repair = "Regenerate all restored witnesses with the existing recorder; retain exact foreign identity/asset, state-root substitution, balance/path tampering and trailing-byte refusals."

[case.TestStateProofMatchesRust]
inventory_first_error = "verify/verify_test.go:117: module-tree-width: Go verdict <nil>, Rust valid=false"
cause = "The historical fixture labels eleven leaves unsupported, while both current Go and current Rust sources implement the current native width contract."
native_source = "src/state/lxp_state_root.c:lxp_state_module_root_count returns max(8, highest registered module)+1; src/state/lxp_state_proof.c:root accepts widths 9 through LXP_MODULE_RESERVED_COUNT+1 (12). The current host registers module 10 and emits width 11."
native_proof_commit = "a66af7c870a43e00f7f3ff1e3e0104ffb21d489b"
rust_source = "services/agent/crates/layerx-proof/src/state_witness.rs:StateWitness::root already accepts the native 9..=12 range and binds module_id inside it."
rust_source_commit = "6b74041116674ce6959b025e52b4f1a13682b7d3"
verdict = "Width 11 is valid; no Go or Rust verifier bound needs widening or narrowing at this revision. The recorded Rust verdict and the obsolete codec input-rewrite shim are stale."
generator = "python3 layerxproof/testdata/record_state_vectors.py"
repair = "Compile the actual production Rust StateWitness source with the actual layerx-types dependency; preserve the original width-11 wire/root as valid-module-tree-width-11, generate module-tree-width at invalid width 13, and record Rust verdicts/refusal classes for every state case. Assert all other historical expectations unchanged. Remove the codec-only wire rewrite so codec and verify consume identical recorded bytes."
tests = "TestStateWitnessAgainstRustFixture and TestStateWitnessRefusalClasses retain their assertions; TestStateProofMatchesRust additionally requires both the exact width-11 inclusion and ErrStateModule refusal cases. Native host and twelve-leaf compatibility cases remain in both codec gates."

[gotcha.scope_and_evidence]
symptom = "The task asks for a starting verify run and root/spec ledger updates while its explicit Order forbids manual verification and all edits outside layerxproof."
do = "Follow the explicit gate order and scope, record the historical inventory without claiming a baseline run, retain task notes here, and bind final qualification to the private runner ledger."

[gotcha.stale_rust_fixture]
symptom = "The fixture generator named in vectors.json is absent and its width-11 negative verdict predates the current production Rust verifier."
do = "Refresh state verdicts from the actual production Rust source with the in-scope recorder; keep non-state sections intact and preserve the original positive witness as well as the invalid-width refusal."
