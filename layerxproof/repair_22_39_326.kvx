[case.TestRepairM_1_CurrentHostNativeWitnesses]
inventory_first_error = "codec/repair_m1_test.go:254: fixture must compile the current production node creation and reset code"
cause = "The same byte-exact host preamble snapshot is stale."
repair = "Regenerate the snapshot, including programs_iface, gas accounting and the production module registration wrapper; keep all 32 native witnesses, registration/path/root/account assertions and refusal classes."

[case.TestRepairM_2_CurrentCHostStateAndAccountProof]
