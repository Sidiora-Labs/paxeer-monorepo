build_command = "go build ./layerxproof/... && go test -count=1 -run '^$' ./layerxproof/codec/... ./layerxproof/verify/..."
verify_command = "test -s layerxproof/repair_22_39_326.kvx && go test -count=1 -timeout 30m ./layerxproof/codec/... ./layerxproof/verify/..."
evidence = "The verified candidate revision, exact command, exit code and private log are recorded by hf-build/hf-done in /out/run/gates.jsonl and copied verbatim in the final evidence JSON; this record is part of that candidate, so it does not embed its own recursive commit hash."

[producer.native_witness]
commit = "b37eb82c177a90aa046c214fa879cbc671fbc5c5"
source = "modules/lxphost/host.go"
source_sha256 = "f48c429b5124e019adfe65a2ff9e005a63979e5de31fe873adc75a18b733bbeb"
generator = "python3 layerxproof/codec/testdata/record_repair_m1.py"
