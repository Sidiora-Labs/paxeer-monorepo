[gotcha.strict_byte_container]
area = "test"
symptom = "A strict comparison rejects identical bytes stored in Buffer and Uint8Array."
cause = "Node strict deep equality also compares the container prototype."
do = "Normalize both byte operands to the same container and keep strict equality over every byte."
