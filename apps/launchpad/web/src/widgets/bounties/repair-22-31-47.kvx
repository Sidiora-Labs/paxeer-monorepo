[repair.22.31.47]
finding = "prepared-call-not-bound"
tests = ["prepared_call_not_bound_rejects_malicious_selector_and_spender", "prepared_call_not_bound_rejects_changed_winner_amount_asset_and_value", "prepared_call_not_bound_requires_canonical_calldata_and_local_review", "prepared_call_not_bound_refuses_plain_transfers_without_escrow_identity", "prepared_call_not_bound_snapshots_the_reviewed_bounty_and_winner"]
proof = "The deployed token ABI encodes calls, JSON transports the transaction DTO, and the real prepared-transaction consumer checks it against the same intent constructors used by funding and judging before the signing hook can access a wallet."
behavior = "Reject approvals and other selectors, changed asset/amount/winner/value, noncanonical calldata, missing intent and plain token transfers that cannot prove a bounty escrow operation."
baseline = "Not executed: the explicit implementation-first and hf-build/hf-done-only order prohibits the contradictory do_5 baseline run; rejection tests would fail against the old validator, which returned these token movements as valid."
external_interface = "services/launchpad/social/internal/devsocial/bounties.go:27-33 states there is no chain-125 bounty escrow and emits null requests; the deployed ABI catalogue has no bounty funding or settlement operation."
wiring_request = "Owning launchpad domain (fm-launchpad): publish a real bounty escrow deployment and ABI via sdk/launchpad/protocol/contracts/v1/chain/abi-catalog.json and apps/launchpad/web/src/core/runtime-authority.ts, then wire services/launchpad/social/internal/devsocial/bounties.go to prepare calls binding bountyId, asset, amount and winner/submissionId; signing remains explicitly refused until that interface exists."
evidence = "The final hf-done ledger row records the verified candidate revision, command, exit and private log; no baseline or unexecuted gate is claimed."
runner_gotcha = "Vitest 4 treats test(namedFunction) as TODO and executes no assertions even with exit zero; register test(namedFunction.name, namedFunction) so every named function actually executes. The first hf-done result is not behavioral proof; the repaired candidate must build and verify again."
