[repair.22.31.60]
finding = "metadata-token-identity"
proof = "repair-22-31-60.test.ts: metadata_token_identity_creator_discovery_through_gateway"
implementation = "Resolve creator-discovered pools through the canonical PoolRegistry, retain pool and token addresses, fetch metadata by token, and reject unknown or mismatched token/pool responses before rendering names."
producer = "Shipped Quoter and PoolRegistry contracts on an owned EVM; pool registration events and deployed SidioraERC20 name/symbol reads seed the real metadata database."
transport = "Production gateway Connected MetadataConnectedRoutes over mutually authenticated TLS to metadata Handlers.RegisterRoutes with sqlc queries and real PostgreSQL/Redis."
consumer = "Real MyTokenView under WagmiProvider and QueryClientProvider; names, tickers, selection, unknown-token refusal and pool-address panel requests are asserted."
baseline = "Not executed: the task's mandatory gate order forbids verification before the full implementation and forbids running verify_cmd by hand; no baseline failure is claimed."
evidence = "The runner's private hf-build/hf-done ledger records the candidate revision, exact command, exit code and evidence location."
wiring_requests = "Qualification runner owner: /out/run/bin/hf-gate.py carried() must retain new test-runtime/pnpm-lock.yaml and test-runtime/{metadata,gateway}/go.sum when their manifests are covered by a directory scope."
prerequisites = "Install test-runtime dependencies, Go, PostgreSQL (pg_config/initdb/postgres), and redis-server; all test listeners bind to loopback and temporary processes are stopped at teardown."
gotcha = "Keep installed test-runtime/node_modules behind an ignored symlink to an external cache because candidate creation traverses physical dependency directories; no build or verification ran during the interrupted first preparation."
repair_cycle = "First verification failed because the fixture collector did not handle Solidity named imports; use the compiler native import callback to load the unchanged shipped contract sources. Assertions remain unchanged."
continued_attempt = "Prior rendered-path verification reached the real metadata gateway but remained signed out: WagmiProvider with reconnectOnMount=false clears connections when storage is enabled. Disable persistence for the isolated wallet fixture, reconnect its real injected EVM wallet, assert the creator account before rendering, and assert that the mounted view is signed in. Existing assertions and wait bounds remain unchanged."
qualification_failure = "revision=a244f5d9448a22419eb58ec0c854e3eeaa1a37b6; command=cg spec done 22.31.60 -f layerx-merge --root /work/paxeer-monorepo; exit=1; log=/out/logs/verify-1.log; Ganache does not implement browser permission RPC eth_requestAccounts; reconnect reads the real unlocked accounts via eth_accounts."
teardown_repair = "The carried attempt failed with ENOTEMPTY while removing a running PostgreSQL data directory. Stop PostgreSQL with pg_ctl fast shutdown, await child process closure before removing the directory, and retain both assertion and cleanup errors."
session_gotcha = "A resumed sandbox retains source changes but not installed runtime dependencies. Restore private runtime packages and generated Go checksums before qualification; resolve copy sources from the repository root."
