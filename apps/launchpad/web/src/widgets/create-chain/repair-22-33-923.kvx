[repair.22.33.923]
finding = "chain-launch-path-proof"
test = "chain_launch_path_proof_recovers_the_submitted_journal_with_one_submission"
test_path = "apps/launchpad/web/src/widgets/create-chain/repair-22-33-923.test.ts"
proof = "The mounted production wizard uses real wagmi providers, an injected connector and viem HTTP clients against a loopback transcript server. Requests must match Go-generated createChain ABI vectors, including creator, payable value and all arguments. Committed ChainCreated log bytes are decoded and matched to the committed getChain tuple at the receipt block. Registry readback is interrupted after submission; the entire component, wallet provider, connector and query cache are closed and reopened with only the submitted journal retained. Retry reaches readiness and wallet registration with exactly one eth_sendTransaction."
fixtures = "tests/vectors/chains/abi-vectors.json (Go ABI producer: precompiles/layerxchains/abi_test.go, TestChainsVectorFileIsCurrent); services/platform/hosted/indexer/tests/fixtures/chains_blocks.json (scope block 42 and its single-creation receipt). Receipt envelope identity is joined from the committed block and transaction; log topics and data are never synthesized or re-encoded."
preserved = "Existing focused UI, adapter timeout/revert and hydration suites are unchanged. The repair test registers an explicit name and function so Vitest 4 executes its assertions."
baseline = "Not run: the explicit implementation-first order and hf-build/hf-done-only gate rules prohibit do_5's conflicting unchanged-tree verification. The selected repair test file did not exist before this task; no pre-change failing test run is claimed."
wiring_request = "Core chains producer domain: precompiles/layerxchains and node must publish a complete single-createChain JSON-RPC transcript captured from a chains-enabled local node for this consumer proof; live node execution and producer fixture generation are outside the create-chain scope and are not claimed by this in-process fixture gate."
evidence = "The final hf-done ledger row is the authority for verified revision, command, exit code and private evidence log; no gate is claimed until that row passes."
qualification_repair = "The first hf-build found two test-local typing errors: mutable optional config captured by the render callback and Vitest 4 options argument order. The repair captures the concrete config and uses test(name, options, function); assertions and timeout are unchanged."
qualification_repair_2 = "The first hf-done executed the test through submission, receipt decoding, journal persistence and reopening, then failed on a name-status label that the review step does not render. Name occupancy is now checked through the real registry read, and readiness waits for the actual chain ID rather than the progress label; all one-submit, receipt, journal and wallet assertions remain."
failed_verify = "revision=d071272e5a190297ee703df5ef4c3b7c55f88013; command=cg spec done 22.33.923 -f layerx-merge --root /work/paxeer-monorepo; exit=1; private_log=/out/logs/verify-1.log"
continuation = "Retained both files from the previous attempt, including its unqualified registry-occupancy and live-chain readiness correction. The resumed gate ledger starts with no build or verify runs; hf-build and hf-done now qualify that complete proof together on the final candidate."
gotcha = "A restored submitted journal opens the review step, which has no name-status element. Assert occupancy through the real registry RPC and readiness through the Live chain region's chain ID; a progress label alone does not establish readiness."
