{
  "version": 2,
  "color": {
    "canvas": "var(--sl-canvas)",
    "surface": "var(--sl-surface-1)",
    "raised": "var(--sl-surface-2)",
    "text": "var(--sl-text)",
    "muted": "var(--sl-text-muted)",
    "focus": "var(--sl-focus)",
    "error": "var(--sl-danger)"
  },
  "spacing": {
    "xs": "var(--sl-space-1)",
    "sm": "var(--sl-space-2)",
    "md": "var(--sl-space-3)",
    "lg": "var(--sl-space-4)",
    "xl": "var(--sl-space-6)"
  },
  "type": {
    "body": "var(--sl-text-base)",
    "label": "var(--sl-text-xs)",
    "heading": "var(--sl-text-xl)"
  },
  "radius": {
    "control": "var(--sl-radius-sm)",
    "panel": "var(--sl-radius-lg)"
  },
  "elevation": {
    "panel": "var(--sl-shadow-none)"
  },
  "focus": {
    "width": "var(--sl-focus-width)",
    "offset": "var(--sl-focus-offset)",
    "style": "solid"
  },
  "states": {
    "hover": "raised",
    "focus": "focus",
    "disabled": "muted with native disabled",
    "loading": "aria-busy",
    "error": "error with visible text"
  }
