[task.22.33.1026]
audit = "22.30.38"
finding = "account-readme-path"
tests = ["test_account_readme_paths_over_real_http", "test_account_readme_commands_match_owned_runners", "test_account_disclosure_imports_resolve_to_exported_primitives", "test_account_readme_discovery_and_qualification_boundaries"]
observed = "The base README already uses apps/launchpad roots; the historical command still relies on an evidence directory created in the separate synthetic command block, and the documented path/command contract has no bounded regression proof."
repair = "Preserve the corrected roots and qualification boundaries, expose existing runner declarations through import-safe entry points without changing child execution or required inputs, and place the evidence prerequisite beside run-check.py. Retarget disclosure assertions to the real account-disclosure.ts and share-disclosure.ts exports, retain exact output and privacy assertions, and point the scoped typecheck at the current watchlist-widget.tsx."
baseline = "No new baseline run: the explicit gate order forbids testing before full implementation and prohibits running verify_cmd by hand. The supplied attempt-1 result reports test_account_readme_paths_over_real_http failing on the nonexistent account-disclosure-view.tsx include, with the other two tests passing; its continued candidate is e8f7fd8abb05bf27150451de33154ba2b231fe93."
proof = "Real runner declarations are compared with README argv and owned discovery; the production ObservedHTTP client retrieves the actual committed TypeScript config through a loopback file server and records response bytes, status, request headers and digest. README local links, CLI paths and the disclosure consumer and its real exported producers are fetched through real HTTP; every included module must exist. No subprocess, external binary, credential or device is needed."
limits = "This proves documentation/command/configuration wiring only; it does not execute Vitest, service journeys, browser or native qualification and makes no release/capacity claim."
evidence = "The bounded hf-build and hf-done ledger at /out/run/gates.jsonl records the candidate revision, exact command, exit code and private log path; final task output copies its final evidence line."
wiring_requests = []

[gotcha.path_index]
observed = "A script file and its containing directory have parent indexes offset by one."
resolution = "Keep file parents[4] and containing-directory parents[3] for the checkout root; corrected during implementation before any gate ran."

[gotcha.command_selector]
observed = "Both mkdir and tsc take -p; selecting an argv solely by that flag fetched the evidence directory instead of tsconfig.json."
resolution = "Select the documented tsc executable before reading its -p argument; keep the real HTTP status and content assertions intact."

[gotcha.gate_bytecode]
revision = "bffa45626ade2fbbf479bb6531054de7317a18cd"
command = "cg spec done 22.33.1026 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The build produced three __pycache__ files that the gate included in the next candidate, changing the verification revision independently of source."
assumption = "Remove only task-generated bytecode and use PYTHONPYCACHEPREFIX=/out/python-cache for both repair gates, with PYTHONDONTWRITEBYTECODE=1 for verification."

[gotcha.removed_presentation_components]
observed = "The config names absent account-disclosure-view.tsx, share-disclosure-preview.tsx and watchlist-grid.tsx; the disclosure test also imports the first two."
resolution = "Use the existing account/share primitive exports directly, assert their complete current outputs including unavailable versus zero and anonymous selection, and include the existing watchlist-widget.tsx. Document JSON illustrations instead of nonexistent component HTML."
