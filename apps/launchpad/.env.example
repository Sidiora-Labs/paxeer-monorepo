# Launchpad web and native build environment inputs.
# Web: copy the needed entries to web/.env.local.
# Native: provide inputs through the build environment or Xcode build settings.
# Native builds do not automatically load this file.
# Required deployment-specific values and secrets are empty.
# Commented entries preserve source defaults or toolchain-supplied settings.
# Only public configuration belongs in NEXT_PUBLIC_* or SIDIORA_PUBLIC_CONFIGURATION.

ANALYZE=false
CI=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# CONFIGURATION=
# Xcode target default: 1.
CURRENT_PROJECT_VERSION=1
# Windows Gradle launcher; unset means echo off.
# DEBUG=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# DERIVED_FILE_DIR=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# EXECUTABLE_NAME=
# Windows Gradle launcher; unset preserves batch-context exit.
# GRADLE_EXIT_CONSOLE=
# Optional extra JVM options; wrapper already adds its memory defaults.
# GRADLE_OPTS=
# Unset selects java from the inherited executable search path.
# JAVA_HOME=
# Optional extra JVM options; wrapper already adds its memory defaults.
# JAVA_OPTS=
# Xcode target default: 0.1.0.
MARKETING_VERSION=0.1.0
NEXT_DEV_ALLOWED_ORIGINS=
NEXT_DIST_DIR=.next
NEXT_PUBLIC_ACTION_ENVIRONMENT=production
NEXT_PUBLIC_ANALYTICS_KEY=
# Unset derives the current application origin plus /auth/callback.
# NEXT_PUBLIC_AUTH_REDIRECT_URL=
# Unset uses the CANONICAL_ORIGIN fallback in web/src/core/wagmi-config.ts.
# NEXT_PUBLIC_CANONICAL_ORIGIN=
NEXT_PUBLIC_DATA_API_URL=
# Unset uses PAXSCAN_EXPLORER_API.
# NEXT_PUBLIC_EXPLORER_API=
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_LIVESTREAM_API_URL=
NEXT_PUBLIC_MARKET_SOCIAL_ORIGINS=
NEXT_PUBLIC_METADATA_API_URL=
# Leave all three RPC overrides unset to use DEFAULT_PAXEER_RPC_URL; an empty value is invalid.
# NEXT_PUBLIC_PAXEER_RPC_URL=
# Unset uses PAXPORT_WALLET_API when the embedded wallet is enabled.
# NEXT_PUBLIC_PAXEER_WALLET_API=
NEXT_PUBLIC_PNL_API_URL=
# Unset uses same-origin routing.
# NEXT_PUBLIC_PRIVATE_API_ORIGIN=
# Leave unset in production; optional JSON authority for development only.
# NEXT_PUBLIC_PRIVATE_QUALIFICATION_AUTHORITY_PROFILE=
# Unset uses same-origin routing.
# NEXT_PUBLIC_PRIVATE_STREAM_ORIGIN=
# Unset uses the other configured RPC overrides or DEFAULT_PAXEER_RPC_URL.
# NEXT_PUBLIC_RPC_URL=
# Unset uses the other configured RPC overrides or DEFAULT_PAXEER_RPC_URL.
# NEXT_PUBLIC_RPC_URL_FALLBACK=
NEXT_PUBLIC_SENTRY_DSN=
# Unset inherits NODE_ENV; an empty value overrides that default.
# NEXT_PUBLIC_SENTRY_ENV=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SOCIAL_WRITE_PREFIX=
NEXT_PUBLIC_SOCIAL_WS_PATH=/v2/stream
NEXT_PUBLIC_STATS_API_URL=
# Unset derives the WebSocket form of NEXT_PUBLIC_DATA_API_URL.
# NEXT_PUBLIC_STREAM_ORIGIN=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLET_IFRAME_ORIGIN=
# Supplied by Next for each runtime.
# NEXT_RUNTIME=
# Next selects development or production for the corresponding command.
# NODE_ENV=
# Supplied by Windows for the Gradle launcher.
# OS=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# OTHER_CFLAGS=
# Inherit the operating system executable search path.
# PATH=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# PLATFORM_NAME=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# PODS_PODFILE_DIR_PATH=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# PODS_ROOT=
# Uses the identifier declared in the Xcode target.
# PRODUCT_BUNDLE_IDENTIFIER=
# Xcode target default: Sidiora.
PRODUCT_NAME=Sidiora
# Supplied by Xcode or CocoaPods; inherit the build setting.
# REACT_NATIVE_PATH=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# SCRIPT_OUTPUT_FILE_0=
# Xcode project default: iphoneos.
SDKROOT=iphoneos
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SIDIORA_ANDROID_KEYSTORE=
SIDIORA_ANDROID_KEY_ALIAS=
SIDIORA_ANDROID_KEY_PASSWORD=
SIDIORA_ANDROID_STORE_PASSWORD=
SIDIORA_APNS_ENVIRONMENT=
SIDIORA_ASSOCIATED_HOST=
SIDIORA_IOS_PROVISIONING_PROFILE=
SIDIORA_IOS_SIGNING_IDENTITY=
SIDIORA_IOS_TEAM=
SIDIORA_PUBLIC_CONFIGURATION=
SIDIORA_SIGNING_OWNER=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# SRCROOT=
# Supplied by Xcode or CocoaPods; inherit the build setting.
# TOOLCHAIN_DIR=
VERCEL=
WEB_API_UPSTREAM=
WEB_CHARTS_UPSTREAM=
WEB_GATEWAY_UPSTREAM=
WEB_SOCKETS_UPSTREAM=
