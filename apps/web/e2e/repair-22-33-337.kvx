gates = "Run hf-build followed by hf-done on the same candidate; current evidence belongs to the private gate ledger, independently of the historical failure recorded above."

[gotcha.22.33.337.reopen-http]
observed = "Undici can reuse an idle connection after the loopback server has closed it during reopen, causing UND_ERR_SOCKET instead of a recovered-state read."
resolution = "The fixture HTTP server explicitly closes each response connection so reopen exercises a fresh transport connection without retries or timing sleeps."

