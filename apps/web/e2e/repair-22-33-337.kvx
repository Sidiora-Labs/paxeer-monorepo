[wiring.approval-counterparty-copy]
resolution = "Attempt 6 ruling: the current catalogue owns the label; Node and browser proofs resolve approval.detail.counterparty and require that exact visible message. No catalogue change or external action is required."

[wiring.onboarding-pending-copy]
resolution = "Attempt 6 ruling: acronym policy matches whole uppercase tokens; DID is forbidden and lowercase did remains ordinary prose. Positive DID and PROOF counterexamples, word boundaries and regex escaping remain asserted. No catalogue change or external action is required."

[recording.approval-producer]
source = "services/human/schema/human-api/golden/approval.{get,list,approve,reject}.response.json"
replay = "JourneyFixtureStore replays committed human service responses through the generated HTTP client and production approval controller, with in-memory state and verified passkey signatures; no live producer seeding is awaited by the declared gate."

[recording.native-receipt-producer]
source = "services/explorer/backend/apps/explorer/test/support/fixture/vcr_cassettes/transaction_importer_import_1_receipt.json"
replay = "Replay the committed explorer client's native receipt exchange over loopback, retaining the recorded result and changing only the JSON-RPC correlation id; the production gateway reader supplies the transaction identity to resolveReceiptLink and the destination is checked against that identity. No live endpoint or external wiring is awaited by the declared gate."

[qualification.22.33.337.attempt6]
implementation = "Continue the existing eight repairs, resolve visible approval labels from the catalogue, check uppercase acronym tokens, retain forbidden-message counterexamples, and replay the recorded native receipt without a synthetic receipt response."
gates = "Run hf-build then hf-done on the final unchanged candidate; copy exact revision, command, exit and private log from the runner ledger. The runner owns publication."

[gotcha.22.33.337.acronym-policy]
observed = "Case-insensitive acronym matching treats the ordinary word did as forbidden DID, while hard-coded field labels can disagree with the catalogue producer."
resolution = "Match uppercase acronym vocabulary case-sensitively at word boundaries and resolve visible labels from the current catalogue; preserve positive matcher counterexamples."
