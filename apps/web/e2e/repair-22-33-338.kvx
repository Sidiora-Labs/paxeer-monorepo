repair = "Current receipt targets require the resolved native transaction hash and lead to /tx/<hash>; the environment proof reads and authenticates a native receipt over root JSON-RPC, validates the public origin on each read, and refuses obsolete settings and malformed identifiers."

[finding.receipt-consumer-proof-retired-target]
test = "repair-22-33-338.test.ts:receipt_consumer_proof_retired_target"
repair = "The production ExplorerExternalLink renders the exact native transaction destination from freshly authenticated receipt bytes, hash, block and logs; receipt digests are deliberately different from the transaction hash. Only an explicit historical-receipt identity with frozen:true reaches the archive."

[finding.kit-separate-layerx-finality]
test = "repair-22-33-338.test.ts:kit_separate_layerx_finality; proof_kit.test.ts:kit_producers_reach_home_consumers_twice"
repair = "Both proofs require Finalised in a committed Paxeer block; the focused proof verifies the recorded receipt signature, native transaction inclusion and linked Comet commits, and refuses missing signatures and corrupt transaction inclusion before rendering the real kit copy consumer."
state = "The scoped catalogue and generated runtime describe committed Paxeer block finality. The production verifiedReceiptWord adapter authenticates the receipt and verifies committed inclusion before selecting finality copy; missing signatures and corrupt inclusion reject rather than render finality."

[finding.support-fixture-route-shape]
test = "repair-22-33-338.test.ts:support_fixture_route_shape; support.spec.ts:message delivery states"
repair = "SupportChatSession and the generated client/codec cross real loopback HTTP at /human/v1/support/conversations, replies, feedback, status and read, preserving service envelopes and typed refusals. Socket interruption and typed failure retain the failed message and next draft, and retry reuses its request identity. Browser cases use a public session and the real conversation producer, require exact request observation and validate reply/feedback envelopes."
limitation = "The loopback peer replays committed Human API golden contracts through the generated encoder, not a running Rust service. A public browser session cannot manufacture an operator reply; the browser feedback case requires the Human fixture wiring below."

[finding.sponsored-retired-transport]
test = "repair-22-33-338.test.ts:sponsored_retired_transport_reopens_recovery; wallet-sponsored-receipt.test.ts:resumed_submission_reports_receipt"
repair = "The shared sponsored fixture gives hosted wallet operations and node RPC distinct loopback origins, rejects foreign methods and paths at both servers, requires hosted bearer authentication and prevents bearer leakage to public RPC. It disconnects the provider, closes SQLite, reopens the same file and constructs a fresh provider before repeated read-only recovery; pending context is byte-identical and neither signing nor submission repeats. Completion authenticates the unchanged signed/committed native receipt and clears recovery context. Existing send, revert, cancellation, receipt-unavailable and stale-context assertions remain."
limitation = "Native receipt authenticity and restart-safe consumer recovery are proven; the signed native recordings are independent node transactions, not a capture of funded sponsored execution. The hosted signer uses real viem digest/signature code; the station status peer is an in-memory contract fixture."

[fixtures]
native = "sdk/platform/conformance/fixtures/vector-v4-committed.json and sequencer-receipt-v1.json; daemon/committed-fixture/vectors/vector-v4-committed.json (existing node recordings, unchanged cryptographic bytes)."
support = "services/human/schema/human-api/golden/support.*.json (existing generated contracts, unchanged create/reply/feedback/error envelopes; list projection uses the production generated encoder)."
recovery = "A real temporary SQLite file is closed and reopened through node:sqlite; the production wallet submission module and PaxeerProvider are recreated against the same persisted entries."

[wiring]
home_errors = "apps/web/src/journeys/home/home.tsx — Web home/states domain: route actual /human/v1/home errors through the shared error surface so its support and report controls expose the trace; retain the browser assertions until that consumer is wired."
kit = "apps/web/src/journeys/home/model.ts — Web home domain: feed native signed receipt and committed evidence through the verifiedReceiptWord adapter when replacing the legacy balance verification projection."
receipt_pages = "apps/web/src/explorer/components.tsx and apps/web/src/app/explorer/receipts — Web explorer domain: resolve a current receipt's native transaction before constructing its external target; keep frozen archive presentation explicitly historical."
support_operator = "services/human/crates/layerx-human-service/src/support.rs and apps/web/e2e/production-fixture.ts — Human service and Web fixture domains: call SupportService::record_support_reply for the conversation created by the authenticated public browser session before its next list read, and export a credential-free producer transcript."
sponsored_capture = "services/wallet/gateway/test/e2e/wallet-signing-adapters.production.ts — Wallet gateway domain: publish matching sponsored submit/status, native raw transaction and authenticated committed receipt transcripts, including a producer restart, for a complete funded sponsorship execution proof."

[gotchas]
ordered_gates = "The task's baseline-test step conflicts with implementation-before-testing and the gate-only run order; follow the ordered gates and do not invent a baseline result."
copy_scope = "Attempt 6 explicitly includes apps/web/copy and apps/web/src/kit/model.ts; catalogue and verified receipt presentation are repaired here instead of carrying the earlier copy wiring request forward."
producer_boundary = "Public support replies belong to the person; only SupportService::record_support_reply can create a support-authored message. A bare invented list cannot prove this interface."

