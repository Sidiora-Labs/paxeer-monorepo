# Human web application settings. Supply deployment-specific values where blank.
LAYERX_GATEWAY_URL=
LAYERX_HUMAN_SERVICE_URL=
LAYERX_HUMAN_WEB_ORIGIN=
# Omit this override to use DEFAULT_NODE_ENDPOINT from src/api/gateway.ts.
# LAYERX_NODE_ENDPOINT=
LAYERX_RUM_DEVELOPMENT_FALLBACK=
LAYERX_RUM_STORAGE_DIRECTORY=
# Secret: support-report retrieval bearer credential.
LAYERX_SUPPORT_REPORT_BEARER_TOKEN=
LAYERX_SUPPORT_REPORT_DIR=
LAYERX_SUPPORT_REPORT_RETENTION=1000
# Public explorer origin included in the browser bundle at build time.
NEXT_PUBLIC_PAXEER_X_EXPLORER_BASE_URL=
# Next.js supplies its execution mode when this override is omitted.
# NODE_ENV=
# The UI build prepends its local binaries to the inherited command search path.
# PATH=
PAXEER_GAS_STATION_CHAIN_ID=
PAXEER_GAS_STATION_PAYMASTER=
PAXEER_GAS_STATION_QUOTE_URL=
PAXEER_GAS_STATION_SPONSOR=
PAXEER_GAS_STATION_SUBMIT_URL=
PAXEER_X_EXPLORER_BASE_URL=
