[meta]
task = "22.39.269"
requirement = "22998.1"
status = "implemented-awaiting-qualification"
baseline_revision = "d5a0c9940685169b25d2095344655f65d2ff6420"
verified_revision = "UNQUALIFIED; the final hf-done receipt names the exact candidate revision and private evidence log."
baseline_command = "python3 tools/paxeer-x/tests/retired_callers_test.py --path apps/web --path docker/gas-station"
baseline_exit = 1
baseline_findings = 62

[repair.attempt-3-consent]
path = "apps/web/e2e/gas-station.test.ts"
symbol = "quoteFixture"
repair = "Generate the quote with the real SDK digest and sign it with the declared sponsor using viem, matching the producer's 65-byte relayer signature contract so valid consent reaches all existing assertions."

[repair.attempt-3-sdk-import]
path = "apps/web/e2e/gas-station.test.ts"
symbol = "PaxeerProvider; constructionDigest; toWireConstruction"
repair = "Import the actual wallet provider source outside node_modules through the suite's TypeScript loader, preserving the exact construction and consent assertions."

[repair.attempt-3-catalogue-merge]
path = "tools/paxeer-x/retired_callers.json"
repair = "Keep the current main Makefile and launchpad allowances and integrate the three seed allowances for the live ramp response, generated compatibility declarations and explorer refusal identity beside them."

[qualification.attempt-3]
base_revision = "6d3b4c37bdbfc9fa167a41fc812e460da9b9c3d7"
status = "Awaiting hf-build and hf-done at the final candidate; no successful gate is claimed."
verified_revision = "The hf-done receipt and /out/run/gates.jsonl identify the exact candidate revision, command, exit and private evidence location without a post-gate tree edit."

[scope]
constraint = "Attempt 2 authorizes the eleven listed paths, including both RPC cases and tools/paxeer-x/retired_callers.json; generator sources, schemas and spec files remain outside scope."
live_rpc = "The catalogue already retains px_getNetwork, px_listAssets and px_getUnifiedHistory; gateway.ts, activity-feed.tsx and gas-station/init.sh have no baseline finding and require no replacement."
retained_paths = "Per decisions 3125 and 3131, keep production routing unchanged, retain live history and network methods, and allow generated compatibility declarations without hand-editing generated code."

[source.generated-client]
file = "services/human/tools/api-gen/src/lib.rs"
symbol = "collect_declarations"
observed = "The generator filters retired operations in plan_operations but collect_declarations emits every enum and record, and collect_record emits every optional field, including schema declarations marked retired."
disposition = "Decision 3125 allows the generated retirement-marked schema compatibility declarations under apps/web/src/api/generated; no generator change or hand edit is required."

[source.ramp]
file = "services/platform/ramps/reference/src/main.rs"
symbol = "rebalance_presentation"
observed = "The live rebalance producer still emits settlement_domain=paxeer and proof_ramp_reference_http_routes.rs requires decode_ramp_response to reject a changed domain."
disposition = "Allow settlement_domain under apps/web/e2e with the live producer citation; retain the exact response validation."

[source.anchor-refusal]
file = "apps/web/src/explorer/links.ts"
symbol = "EXPLORER_ANCHOR_PATH"
observed = "The exported path is a refusal identity, never a navigation target; explorer.spec.ts and explorer-admission.test.ts import it and proof_explorer.test.ts asserts its exact value."
disposition = "Allow paxeer-x/anchors under apps/web/src/explorer as the explicit admission refusal identity."

