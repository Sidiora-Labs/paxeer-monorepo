[gotcha.22.33.361]
observed = "The old account route calls unifiedAccountAvailability, which deliberately refuses the retired projection after the native transport prerequisite."
resolution = "Wire the actual route to loadNativeAccountPage and NativeAccountPage; preserve opaque cursor links and explicit refusal states, and never infer native totals or commitment from retired split fields."
