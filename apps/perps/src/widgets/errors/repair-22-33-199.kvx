tests = ["repair_f042_unreportable_feedback_keeps_editable_draft", "repair_f042_missing_sentry_client_is_not_receipt", "repair_f042_real_capture_and_retry_require_feedback_acknowledgement"]
behavior = "The production modal preserves comments and email, remains editable, and offers retry unless core reporting explicitly acknowledges both the error event and the feedback event; exceptions show a recoverable failure."
wiring_request = "Domain 3, apps/perps/src/core/errors/report.ts: return {status: accepted, eventId, feedbackEventId} only when the enabled reporting path accepts both captures; return explicit unavailable/failed outcomes for non-reportable errors, missing or disabled clients, missing feedback API, or capture failures. Until wired, the modal treats the current void result as unavailable."
baseline_revision = "5b8e28177e02e72583261cf570a830f407fbbea8"
baseline_command = "cg spec done 22.33.199 -f layerx-merge --root /work/paxeer-monorepo"
baseline_exit = 1
baseline_log = "/out/logs/verify-1.log"
baseline = "On the unchanged attempt-4 implementation, repair_f042_unreportable_feedback_keeps_editable_draft passed; repair_f042_missing_sentry_client_is_not_receipt and repair_f042_real_capture_and_retry_require_feedback_acknowledgement failed because API_OFFLINE is not reportable. The fixtures now use the reportable API_TIMEOUT catalog error without changing their assertions."
evidence = "The runner's hf-build/hf-done ledger records the exact qualified candidate revision, command, exit code, and private log; the final evidence line names the verified revision."
gotcha = "The installed Sentry SDK can return event IDs without an initialized client; a fulfilled Promise<void> and even a generated event ID cannot acknowledge accepted feedback."
format_gotcha = "pnpm --dir dlx resolves file arguments from the invocation directory; use absolute paths when formatting the scoped files."
fixture_gotcha = "A real capture fixture must use a reportable catalog error: API_OFFLINE deliberately bypasses Sentry, whereas API_TIMEOUT exercises error and feedback capture."
main_line = "The sandbox base already contains 22.31.480; origin/main equals the base and apps/perps/tsconfig.tsbuildinfo is no longer tracked."
