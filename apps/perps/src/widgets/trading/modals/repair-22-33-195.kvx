[task.22.33.195]
finding = "f017: f017TieredMaintenanceAndAccountRisk drives the production risk query through loopback JSON-RPC, the real ABI encoder/decoder, removal preview and transaction builder; f017RefreshBeforeSubmissionAndUnavailableRisk proves fresh submission reads and refusal on missing tiers, foreign ownership or failed account reads."
baseline = "No earlier gate ledger or partial repair was present. An unchanged-tree verification was not run because the explicit task order requires complete implementation before hf-build and hf-done and prohibits running verify_cmd by hand. No baseline failure is claimed. The unsafe-amount regression identifies a removal the original one-percent check allowed."
wiring = "None: the existing getPositionDetails, getMarginTiers and getAccount interfaces supply marked notional, authoritative tiers, PnL/funding-adjusted account equity and native-unit withdrawable collateral."
evidence = "The runner records the exact candidate revision, command, exit code and private log in /out/run/gates.jsonl; closure is qualified only by a passing hf-done at the build revision."
gotcha = "removeCollateral withdraws from the cross-margin account, bounded by getAccount.withdrawable; position collateral minus a percentage is not the account removal limit. All snapshot reads are pinned to one fresh block and submission rereads them."
qualification = "Initial build: revision 58ca99484d80300b22812562d85027520d54c085; command pnpm --dir apps/perps exec tsc --noEmit; exit 2; private log /out/logs/build-1.log. TS2307 reports missing viem, @noble/curves/ed25519.js and @noble/hashes/sha2.js under sdk/wallet and zod under services/wallet/gateway; the viem toolchain gap is already recorded in finding.22.31.13.3. No out-of-scope repair was attempted."
formatting = "The initial TypeScript formatter call passed its context in the wrong argument and failed before writing; the corrected formatDocument(sourceFile, formatContext) invocation formatted only the three touched TypeScript files."
