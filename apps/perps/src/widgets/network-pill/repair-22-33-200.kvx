[finding.f043]
proving_tests = ["f043_failedRefreshMarksLastBlockStaleAndRecovers", "f043_closedObservationsExpireBeforeReopen"]
repair = "The production NetworkStatusMonitor timestamps connected observations, clears latency and labels the retained block stale after transport failure, invalid JSON, chain disconnection or 60 seconds without a connected response. Expiry continues while the popover is closed. Generation checks discard responses from closed polls; only a connected health response restores freshness."
proof = "An in-process loopback health server drives the production fetchJsonWithPolicy transport, activePoll scheduler, NetworkStatusMonitor consumed by useNetworkStatus and networkBlockLabel consumed by NetworkPill. Tests cover HTTP retry exhaustion, network failure, parse failure, disconnection, close/reopen, late response isolation and real elapsed-time expiry without mocked timers or transport."
wiring = "None: all producer/transport/consumer changes required by f043 are inside widgets/network-pill; the health response interface is unchanged."
