# ═══════════════════════════════════════════════════
# Generic .env template (copy and add your framework prefix)
#
# Prefixes by framework:
#   Next.js:    NEXT_PUBLIC_
#   Vite:       VITE_
#   CRA:        REACT_APP_
#   Nuxt 3:     NUXT_PUBLIC_
#   SvelteKit:  PUBLIC_
#   Remix:      (none — use loader)
#   Node/Py:    (none)
# ═══════════════════════════════════════════════════

# Sidiora Perpetual Protocol — Environment Variables
# Chain: Paxeer Network (ID: 125)

# ── Network ──
# Left empty: the perps gateway supplies RPC.
RPC_URL=
CHAIN_ID=125
CHAIN_NAME=Paxeer Network
EXPLORER_URL=https://paxscan.io
NATIVE_SYMBOL=PAX

# ── Collateral Tokens ──
USDL_ADDRESS=0x85FcD13735F4309833A503EE804ea32395851479

# ── Perps gateway and market feed ──
# Required bare HTTP(S) data-gateway origin, without credentials, path, query or fragment; derives REST, GraphQL and WebSocket URLs.
NEXT_PUBLIC_PERPS_GATEWAY_URL=
# Browser market and candle feed hostname or bare HTTP(S) origin.
NEXT_PUBLIC_MARKET_PROXY_HOST=

# ── Precompile address overrides (optional, for a local node) ──
# Perps precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_PERPS_PRECOMPILE=
# Launchpad precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_LAUNCHPAD_PRECOMPILE=
# Spot market precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_PECOR_MARKET_PRECOMPILE=
# Spot orders precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_PECOR_ORDERS_PRECOMPILE=
# Spot stop-order precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_PECOR_STOP_PRECOMPILE=
# Spot quoter precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_PECOR_QUOTER_PRECOMPILE=
# Spot vault precompile override; accepts a 20-byte hex address.
NEXT_PUBLIC_PECOR_VAULT_PRECOMPILE=

# ── WalletConnect / Web3Modal (frontend only) ──
WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID_HERE

# ── Keeper / Backend (server-side only — NEVER prefix with NEXT_PUBLIC_ etc.) ──
# KEEPER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
# ORACLE_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Additional application environment inputs
# Perps application and Next.js environment. Copy to apps/perps/.env.local.
# NEXT_PUBLIC_* values are client-visible build inputs.
# Empty values use the source fallback or require deployment configuration.
# NEXT_RUNTIME and NODE_ENV are selected by Next.js; leave their overrides commented.

# Comma-separated IPs of socket peers allowed to supply X-Real-IP to candle rate limiting.
CANDLE_TRUSTED_PROXY_IPS=

# Server candle-data upstream hostname.
MARKET_PROXY_HOST=data.feed.chainflowtrading.com

# Bare HTTP(S) Origin header for candle upstream requests, with no trailing slash; required for Compose and candle serving.
MARKET_PROXY_ORIGIN=

# Embedded-wallet OAuth callback URL.
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# Minimum logger level: debug, info, warn or error (case insensitive).
NEXT_PUBLIC_LOG_LEVEL=

# Preferred JSON-RPC node prepended to the built-in pool when no usable plural override is supplied.
NEXT_PUBLIC_PAXEER_RPC_URL=

# Comma-separated JSON-RPC pool override; trimmed, deduplicated and filtered before use.
NEXT_PUBLIC_PAXEER_RPC_URLS=

# Embedded-wallet API URL; required when the publishable key enables embedded sign-in.
NEXT_PUBLIC_PAXEER_WALLET_API=

# Explorer HTTP API URL.
NEXT_PUBLIC_PAXSCAN_API_URL=

# Bare HTTP(S) explorer origin for external links.
NEXT_PUBLIC_PAXSCAN_BASE_URL=

# Explorer socket endpoint.
NEXT_PUBLIC_PAXSCAN_WS_URL=

# Sentry release identifier for browser, server and edge events.
NEXT_PUBLIC_RELEASE=

# Opens the spot route, navigation and markets mode only when exactly 1.
NEXT_PUBLIC_RELEASE_SPOT_OPEN=

# Public Sentry event-ingestion DSN; also the fallback for server and edge capture.
NEXT_PUBLIC_SENTRY_DSN=

# Browser Sentry environment label.
NEXT_PUBLIC_SENTRY_ENV=

# Enables the /monitoring Sentry tunnel only when exactly 1.
NEXT_PUBLIC_SENTRY_TUNNEL=

# Bare HTTPS status-page origin, without a trailing slash.
NEXT_PUBLIC_STATUS_PAGE_URL=

# Public anonymous authentication key; a nonempty value enables embedded-wallet configuration.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase project URL used for embedded-wallet authentication.
NEXT_PUBLIC_SUPABASE_URL=https://zezsqawedbikldiedlse.supabase.co

# Public build identity; development is the source default.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=development

# Trusted parent origin for the iframe postMessage wallet bridge.
NEXT_PUBLIC_WALLET_IFRAME_ORIGIN=

# Framework-selected runtime; edge skips server instrumentation, nodejs or unset loads server Sentry.
# NEXT_RUNTIME=

# Runtime mode for logging, explorer warnings, secure presence cookies, PWA generation and Sentry environment fallback.
# NODE_ENV=

# Comma-separated IPs of socket peers allowed to supply X-Real-IP to presence limits.
PRESENCE_TRUSTED_PROXY_IPS=

# Highest-priority server /api/build-id identifier.
RAILWAY_GIT_COMMIT_SHA=

# Build-time authentication for Sentry source-map uploads.
SENTRY_AUTH_TOKEN=

# Server and edge Sentry event-ingestion DSN.
SENTRY_DSN=

# Server and edge Sentry environment label.
SENTRY_ENV=

# Sentry organization identifier for source-map uploads.
SENTRY_ORG=

# Sentry project identifier for source-map uploads.
SENTRY_PROJECT=

# Server /api/build-id identifier when the Railway identifier is absent; Compose supplies BUILD_COMMIT_SHA.
VERCEL_GIT_COMMIT_SHA=
