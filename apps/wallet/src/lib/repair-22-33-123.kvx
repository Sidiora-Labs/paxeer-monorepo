[repair.22.33.123]
audit = "22.30.114"
criterion = "22998.1"
base_revision = "b664b08b724ec5b190920b99ba70b283c8a796c9"
requalification_base_revision = "fab97ff9640765434585dd0f8799c602aa2e6ff3"
requalification = "Attempt 3 retains the attempt-2 implementation and all fourteen proving tests after prerequisite 22.31.482 was merged. The prerequisite places the swap fixture dependencies in the wallet application's existing install root; no dependency manifests or out-of-scope files are changed by this continuation. Exact verification evidence is recorded by the bounded gate ledger."
continuation = "Resolved the five push.ts integration conflicts on the published base while preserving typed registration outcomes, server acknowledgement checks and confirmed enabled-state tracking. Serialize direct registration, confirmation and explicit-subscription heartbeats with deletion recovery so stale work cannot bypass a pending removal. The loopback transport routes both relative URLs and the published registration URL objects to its real HTTP peer."
test_file = "apps/wallet/src/lib/repair-22-33-123.test.ts"
implementation = "Persist a registered, fail-closed queue of at most sixteen validated endpoint/owner pairs before browser unsubscription; reject persistence failures and capacity overflow without removing the browser endpoint or evicting pending work. Reconcile browser and backend removal on wallet reconnect, online events, subscription lookup and heartbeat; sign fresh endpoint-specific unsubscribe proofs and require successful HTTP status plus acknowledgement before retiring an intent. Serialize operations and stop retries on wallet disconnect; retain intents belonging to a different wallet."
proof = "The production push module registers the initial association through heartbeat and signed POST, then sends signed DELETE over real fetch to a loopback HTTP peer with an in-memory association store and the committed production unsubscribe codec. Browser subscription and service-worker peers retain their in-memory state; jsdom's real local storage retains the queue while the production module and repository are stopped and reimported. Tests assert recovered browser, queue and server state across HTTP refusal, socket failure and application restart."
baseline = "Not run: the explicit implementation-first order and prohibition on running verify_cmd manually override the contradictory do_5 pre-change verification step. No pre-change execution or failures are claimed. On the base, HTTP refusal and disconnect still return success after browser removal and no persisted intent exists; the recovery and persistence-before-removal assertions detect these defects."
evidence = "The bounded hf-build and hf-done ledger records contain the exact candidate revision, command, exit and private log path; the final hf-done evidence identifies the verified revision."
gotcha = "The DELETE contract now requires a fresh EIP-191 paxport:push-unsubscribe ownership proof; endpoint-only deletion receives 401. Use the production unsubscribe-intent codec, and never persist signing credentials or proofs."
gotcha_test_registration = "Vitest 4 requires test(namedFunction.name, namedFunction) to execute named functions; test(namedFunction) records TODO."
wiring_request = "Domain 12: apps/wallet/src/app/api/push/subscribe/unsubscribe.ts must retain bounded ownership-authenticated deletion tombstones and acknowledge retries after a committed deletion whose response was lost; the current absent-endpoint 401 cannot safely be interpreted as successful deletion by this client."

[finding.17]
tests = ["finding17_recovers_http_failure_after_component_restart", "finding17_retries_transport_failure_on_connectivity_recovery", "finding17_reopens_intent_persisted_before_browser_removal", "finding17_storage_failure_preserves_browser_and_server", "finding17_bounds_intents_without_evicting_pending_deletions", "finding17_keeps_failed_acknowledgements_and_wrong_owner_pending", "finding17_refreshes_proof_after_restart_and_never_reregisters_pending_endpoint", "finding17_retains_intent_when_server_commits_but_ack_is_lost", "finding17_orders_deletion_after_inflight_heartbeat", "finding17_does_not_send_after_wallet_disconnect_during_signing", "finding17_preserves_registration_acknowledgement_contract", "finding17_blocks_explicit_registration_while_deletion_pending", "finding17_orders_deletion_after_explicit_registration", "finding17_confirms_existing_browser_subscription"]

[qualification_notes]
formatter = "The configured formatter is Prettier; this sandbox has no installed Prettier executable, so the same formatter is invoked through pnpm dlx without changing manifests."
gotcha = "A formatter command using apps/wallet as its working directory must use src/lib paths; an earlier edit command used repository-relative paths there and failed before making changes."
gotcha_dlx = "pnpm --dir apps/wallet dlx does not change the formatter's working directory; invoke pnpm dlx from apps/wallet with src/lib paths. The initial path-only failure changed no files."
