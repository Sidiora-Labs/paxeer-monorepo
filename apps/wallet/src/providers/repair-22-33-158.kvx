[task.22.33.158]
audit_record = "22.30.117"
finding = 9
repair = "LocaleProvider exposes currencyRevision and includes it in the memoized context dependencies so currency-rate events notify useLocale subscribers without a locale change."
tests = ["repair_9_refreshes_mounted_portfolio_after_currency_rates_event", "repair_9_refreshes_mounted_portfolio_when_display_currency_changes"]
proof = "Real storage repositories supply fresh cached rates and display preferences; the currency service loads those rates and emits CURRENCY_RATES_EVENT through announceCurrencyChanged; a memoized context subscriber renders the production HeroBalance with constant props and asserts updated balance, PnL and spot amounts on the same mounted DOM node."
proof_boundary = "SubscribedPortfolio is a test consumer demonstrating the subscription contract; production fiat-widget subscription changes are outside this task's paths."
baseline = "Not run: the explicit implementation-first order and bounded hf-build/hf-done gates prohibit the baseline verification requested by step 5. No pre-change failing execution is claimed."
evidence = "The runner's private gates.jsonl records the qualified candidate revision, exact command, exit code and log path; the final response copies the last gate evidence."
wiring_request = "Domain 12 (fm-wallet): subscribe apps/wallet/src/widgets/portfolio/{HeroBalance,BentoTokenCard,PaxCardExpand}.tsx, apps/wallet/src/widgets/tokenDetail/{PriceHero,PerformanceCard,InfoCard,PositionCard,MarketStatsCard}.tsx, apps/wallet/src/widgets/discover/RankedTokenList.tsx and apps/wallet/src/widgets/swap/PaxSwapModal.tsx to useLocale currencyRevision, including it in dependencies wherever fiat amounts are memoized."
gotcha = "A provider context update reaches subscribed consumers only; changing the context cannot refresh fiat widgets that never subscribe."
formatter_gotcha = "pnpm --dir apps/wallet dlx kept the repository working directory, so formatter paths must be absolute; the initial relative-path attempt matched no files."
test_registration_gotcha = "Vitest 4 treats test(namedFunction) as a todo because no callback is supplied; register test(namedFunction.name, namedFunction) so both declared proving functions execute. The first hf-done returned zero with two todos and supplied no behavioral proof; the repaired candidate must execute both tests."
