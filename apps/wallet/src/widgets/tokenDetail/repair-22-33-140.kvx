[repair.22.33.140]
audit = "22.30.115"
path = "apps/wallet/src/widgets/tokenDetail/repair-22-33-140.test.ts"
market-stats-window = "market_stats_window_is_independent_of_chart_period; market_stats_window_reports_missing_coverage"
wpax-address-detection = "wpax_address_detection_uses_active_chain_and_exact_alias"
token-detail-zero-decimals = "token_detail_zero_decimals_preserves_units_through_display_and_actions; token_detail_precision_is_null_aware_and_validated"
token-activity-symbol-identity = "token_activity_symbol_identity_survives_transport_and_filters_contract_and_chain"
proof = "Real WalletProvider and IdentitySession authenticate against the committed gateway recordings; a loopback HTTP fixture serves typed explorer and candle responses through the real API/facade codecs, query hooks, TokenDetailWidget and rendered consumer cards/actions. QueryClient provides the production in-memory store. The Node fetch URL bridge only resolves browser-relative URLs onto that loopback origin."
market_window = "The market query requests an independent 97-candle 15-minute series; the card reports the exact 24h window ending at the latest completed candle boundary and requires contiguous timestamp coverage. Short, missing, gapped, old and future candles cannot supply mislabeled extrema."
precision = "Preserve zero from public metadata, holding metadata or chain metadata in that order; absent or invalid precision remains explicit and disables Send/Swap before conversion. Supported integer precision is 0..80, the ethers fixed-point consumer limit. Unknown activity precision remains visible without converting its raw amount."
baseline = "Not run: the ordered instructions prohibit verification before complete implementation and require hf-build before hf-done; no unchanged-tree failure is claimed. Each regression asserts behavior contradicted by the audited implementation."
wiring_request_history = "Domain 12: apps/wallet/src/lib/queries/transactions.ts must retain token_address plus the source chain in shared TxHistoryRow normalization; this widget uses an identity-preserving scoped query until that shared interface is repaired."
wiring_request_network = "Domain 12: apps/wallet/src/lib/data/client.ts and apps/wallet/src/lib/data/facades/wallet.ts need a chain-aware explorer source and chain provenance for virtual history; the widget explicitly treats the current facade as root-chain-only instead of relabeling its rows."
wiring_request_precision = "Domain 12: apps/wallet/src/lib/data/facades/wallet.ts must retain absent token-transfer/holding precision instead of substituting 18 before consumers validate it; apps/wallet/src/widgets/send and apps/wallet/src/widgets/swap must preserve zero through their own amount conversion and funded-action metadata paths."
evidence = "The runner's private hf-build/hf-done ledger records the exact candidate revision, command, exit code and log; the final response copies the last bounded gate result."
tooling_note = "The repository's jsxBracketSameLine Prettier option is deprecated; formatting completed with its existing configuration. Root GOTCHA.kvx is outside the permitted edit scope."
qualification_repair = "First hf-done at cc0759866fd13ca94beba21b50f039ca2eeca9d8 ran six tests, with three passing and three failing (exit 1, /out/logs/verify-1.log): the network fixture tried registering against an unset environment-backed root RPC, and two cache-update assertions preceded scheduled observer notifications. The repair seeds a valid saved-network fixture through preferencesRepository and awaits real query notifications; all six tests and every assertion are retained."
