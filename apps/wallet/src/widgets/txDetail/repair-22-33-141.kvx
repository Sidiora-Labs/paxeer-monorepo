[finding.tx-detail-zero-decimals]
tests = ["tx_detail_zero_decimals_preserves_numeric_and_string_zero", "tx_detail_multiple_wallet_transfers_keep_each_direction_and_counterparty", "tx_detail_unknown_precision_stays_explicit_in_headline_and_rows"]
repair = "Preserve numeric and string zero, accept only integer precision supported by ethers (0 through 80), and show raw units with an explicit unavailable amount for unknown or invalid precision before conversion."

[test_path]
producer = "Committed in-memory explorer peer derives transfer endpoints and raw values from ethers ERC-20 event encoding/decoding; zero precision is derived through the decimals ABI."
transport = "Loopback HTTP server through the production Blockscout client, transaction API, wallet facade, query hook and QueryClient."
consumer = "Production TxDetailWidget rendered with the real WalletProvider and committed EIP-6963 injected-wallet fixture."

[qualification.registration]
