[finding.tx-detail-first-transfer]
tests = ["tx_detail_first_transfer_selects_wallet_endpoints", "tx_detail_multiple_wallet_transfers_keep_each_direction_and_counterparty", "tx_detail_unrelated_logs_are_not_wallet_movements"]
