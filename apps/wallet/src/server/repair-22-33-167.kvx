fixture = "Provider URLs remain valid production origins; the fixture agent connects real encrypted HTTPS requests to its loopback listener with certificate validation enabled, including child-process campaign participants."
prior_attempt = "The inherited record above retains the earlier attempt's two gate repairs; this continuation starts with a fresh runner ledger and the already-applied P-256 TLS identity. No deadline or 50-recipient assertion is relaxed."
gotcha = "Seed merges overlap a newer provider allowlist and server-owned subscription metadata; retain the current checks and adapt the committed TLS fixture transport rather than relaxing input validation."

