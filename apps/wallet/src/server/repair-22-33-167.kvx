[repair.22.33.167]
audit = "22.30.118"
baseline = "Not run: the explicit implementation-first and hf-build/hf-done-only gate order prohibits unchanged-tree verification; no pre-change failing execution is claimed. The starting tree already locked read/migration and persisted corruption markers from task 22.31.246."
paths = ["atomic-json-store.ts", "atomic-json-store.test.ts", "push-store.ts", "push-service.ts", "repair-22-33-167.test.ts", "repair-22-33-167.store-fixture.ts", "fixtures/repair-22-33-167"]
wiring_requests = []
evidence = "The private hf-build/hf-done ledger binds qualification to the exact candidate revision, commands, exit codes and log paths; completion is claimed only after hf-done passes."

[finding.store-tests-reopen]
proof = "store_corruption_reopen_refuses_empty_writes_and_verifies_backup; store_migration_and_insertion_serialize_in_separate_processes; store_publication_crash_boundaries_reopen_with_verified_generations; store_live_holder_dead_takeover_and_late_release_keep_ownership"
change = "Extend atomic-json-store.test.ts using the same executable production-store lifecycle scenarios registered by the declared repair test."

[finding.store-read-migration-lock]
proof = "store_migration_and_insertion_serialize_in_separate_processes"
change = "Retain the starting tree's file lock around mutation-capable reads and prove a blocked migration and insertion in independent Node processes, including reopened primary and backup."

[finding.store-rename-durability]
proof = "store_publication_crash_boundaries_reopen_with_verified_generations"
change = "Sync completed private temporary files, atomically publish and directory-sync the verified previous generation before primary replacement, then directory-sync the primary; explicit recovery retains the marker and backup until the restored primary is durable."
crash_model = "Process termination at each observable publication boundary verifies generations and backup recovery; file and directory fsync establish the local Linux filesystem durability contract, without claiming a simulated process kill is a physical power-loss test."

[finding.store-lock-lease]
proof = "store_live_holder_dead_takeover_and_late_release_keep_ownership"
change = "Publish a prepared nonempty ownership directory atomically, retain live owners using Linux PID/start-tick identity, recover dead owners, assert ownership before publication, and unlink only the observed unique owner entry on release. A late rmdir cannot remove a nonempty successor."

[finding.push-send-deadline]
proof = "push_deadlines_bound_stalled_tls_and_trickling_batches"
change = "Set the web-push socket timeout and an absolute shared routing deadline; destroy each request's private TLS agent at the deadline, including continuously trickling responses; retain rejected and uncertain outcomes distinctly."

[finding.inactivity-cooldown]
proof = "inactivity_atomic_cooldown_survives_concurrent_scans_and_reopen"
change = "Select against lastNotifiedAt, atomically persist a cooldown reservation before delivery, and preserve the notification timestamp across subscription refresh; verify concurrent scans, reopened stores and the exact next window."

[finding.campaign-concurrent-restart]
proof = "campaign_concurrent_processes_recover_interrupted_send_without_blind_redelivery"
change = "Persist a recipient snapshot, recoverable token claim, and in-flight record before routing; persist each outcome separately, convert expired in-flight attempts to exposed uncertain state, and require explicit reconciliation before any resend."

[finding.campaign-transient-failure-loss]
proof = "campaign_transient_rejections_remain_retryable_after_reopen_and_complete_only_terminal_recipients; campaign_retry_policy_persists_exhaustion_without_marking_transient_attempts_sent"
change = "Persist attempts and exponential retry eligibility, retain subscriptions after transient rejection, distinguish terminal removal and bounded exhaustion, and complete campaigns only when every recipient is terminal."

[qualification_notes]
legacy_lock = "Unowned empty-file locks from old releases fail closed and require explicit operator recovery, since their live owner cannot be established; new ownership locks recover automatically."
fixture_runtime = "Child fixtures execute production TypeScript using Node's native type stripping and a relative-import resolver; no subprocess compiler, credentials, environment setup or external service is required."
fixture_transport = "Committed TLS material is isolated loopback test material; generated subscription and VAPID keys are ephemeral, and the HTTPS receiver decrypts actual web-push ciphertext with the library's codec."
scope = "The task-specific prohibition on spec and out-of-scope edits takes precedence over generic instructions to append GOTCHA.kvx or qualification.kvx; workflow observations are retained here instead."

