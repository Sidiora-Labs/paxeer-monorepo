[repair.22.33.206]
findings = ["minimal-receipt-fixture-contract", "unsigned-surface-fixture"]
minimal_receipt_fixture_contract = "surface_chain_preserves_node_execution_fields_and_governed_signatures; surface_chain_refuses_removed_or_mutated_authenticated_fields; repair_22_33_206_minimal_receipt_fixture_contract_gates_surface_confirmation"
unsigned_surface_fixture = "surfaces_test_chain_answers_the_sequencer_receipt_of_a_sent_transaction; surface_chain_refuses_unrecorded_calls_and_invented_logs; repair_22_33_206_unsigned_surface_fixture_replays_node_send_and_read"
producer = "rpc/sequencer_receipt_vectors_test.go produced sdk/platform/conformance/fixtures/sequencer-receipt-v1.json; SurfaceChain replays its six positive/reverted records unchanged, including canonical signed bytes, all execution fields, raw transactions and governed key pins."
transport = "The repair test starts an in-process loopback HTTP node-recording server and drives the production JsonRpcClient, sendModuleTransactionReceipted, readSequencerReceipt, bridge decoder, surfaceReceipt and useModuleSend; both direct and unsupported-method fallback sends are exercised."
baseline = "Not run: the mandated gate order requires complete implementation before hf-build, then hf-done as the only verification entry point. No pre-change failing test or baseline result is claimed; the prior helper lacks px_getReceiptKeys/raw transactions and generates unsigned receipts, which the new proofs require."
evidence = "hf-build and hf-done retain the exact candidate revision, command, exit code and private evidence location; the runner publishes that qualified candidate."
qualification_repair = "42a37df75c20ca7d38484ee04b1d40a64e2f4760: pnpm --dir apps/wallet exec tsc --noEmit -p tsconfig.json exited 2 (/out/logs/build-1.log); the negative-test payload now copies the typed receipt into a plain wire object before indexed mutation, retaining the production receipt types and every assertion."
qualification_repair_2 = "4df278d7928d65ab6115874cab7edc542f205b93: cg spec done 22.33.206 -f layerx-merge --root /work/paxeer-monorepo exited 1 (/out/logs/verify-1.log), five tests passed; the six-vector conformance proof now sends via eth_sendTransaction and authenticates through readSequencerReceipt, so the native PAX transfer does not incorrectly enter the contract-call API that requires a selector."
wiring = "apps/wallet/src/surfaces/{BridgeView,WebDataView,LaunchpadView,FeeChoice,ExchangeView}.test.tsx: wallet surface domain must migrate arbitrary successful sends/logs to node-produced recordings for those calls; SurfaceChain now refuses unrecorded calls and fabricated logs instead of inventing signed evidence."
request_sequence_repair = "Task 22.39.179 records the producer comparison and qualification references in repair-22-39-179.kvx: fallback send/read expects eight requests after 5577807085a205dc03e13c98ad58d876c8d3e1c6 returns the already authenticated wait result; direct send/read still expects six, with every receipt, authentication and surface assertion preserved."
