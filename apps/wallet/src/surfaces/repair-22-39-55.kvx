[qualification.verify1]
revision = "423e90783e78d1d3293dacd6241d89375a91c88d"
command = "cg spec done 22.39.55 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "Nine failed assertions: four perps sends, one fee preference, one launchpad creation, two XWeb sends and the missing Go-producer ledgerProof context; 97 passed and 20 registered as todo."
settlement = "Preserve assertions on missing external producer evidence; replace one-argument test registrations with the actual Vitest name-plus-body form so the functions execute rather than register as todo."

[gotcha.vitest_registration]
symptom = "A single function passed to Vitest test is interpreted as a test title with no body and becomes todo."
settlement = "Register the declared function with test(functionName.name, functionName); preserve its name and execute every assertion."

[qualification.attempt2]
build_reference = "/out/run/gates.jsonl: final successful kind=build entry; candidate revision, command, exit and private log are recorded by hf-build."
verify_reference = "/out/run/gates.jsonl: final kind=verify entry from hf-done; qualification requires exit zero and the same candidate revision as the build entry."
recorded_model_source = "spec/layerx-merge/contracts/sequencer.md#sequencer-receipt and spec/layerx-merge/contracts/ledger-auth.md#layerxledger-0x101a; generated fixture provenance names encoder, ABI/event inputs and public signing-seed source."

[gotcha.model_abi]
symptom = "The shared construct ABI writer supports strings and fixed words but not the ledger/XWeb dynamic bytes argument; the fixture recording command initially refused request argument 1."
settlement = "Encode dynamic bytes with canonical Solidity length, offset and zero padding in the model recorder; keep the production writer for fixed ABI words and authenticate every emitted vector in the declared suite."

[qualification.attempt2_repair1]
revision = "7f67f82da16bb812436590d38362a7d6aeaf47ac"
command = "cg spec done 22.39.55 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
