[repair.22.33.161]
base_revision = "2b502183a86af3a2498748de6572b1bde20e4768"
test_file = "apps/wallet/src/account/repair-22-33-161.test.ts"
asset-tests-retired-shape = "asset_list_renders_gateway_bank_rows_without_balance_sides; asset_list_shows_one_bank_balance_per_denom; asset_rows_decode_numeric_heights_and_nullable_metadata; AssetList unavailable-node case"
plan-tests-retired-shape = "kernel_plan_presents_and_submits_the_merged_chain_plan; kernel_plan_binds_legs_with_the_pending_nonce_of_the_wallet_address; KernelPlan service-refusal and consensus-unavailable/catching-up cases"
plan-two-domain-presentation = "kernel_plan_presents_and_submits_the_merged_chain_plan; legBindings consumes one pending nonce for every chain transaction independent of the retained domain label"
ladder-tests-retired-rungs = "transaction_ladder_reaches_receipted_from_the_sequencer_before_the_explorer; status_ladder_labels_submitted_receipted_and_committed; ladder_refuses_tampered_receipt_evidence"
ladder-no-pending-refresh = "ladder_observes_pending_receipts_until_commitment; ladder_bounds_pending_reads_and_retries_visibly; ladder_cancels_waiting_and_inflight_reads_and_reopens_from_node_evidence"
ladder-discards-commit = "ladder_keeps_committed_receipts_with_unavailable_or_lagging_explorer; transaction_ladder_reaches_receipted_from_the_sequencer_before_the_explorer; status_ladder_prefers_explorer_evidence_at_the_committed_rung"
proof = "Production AccountProvider, EndpointClient, HumanClient, receipt/key decoders, hooks and account components communicate with loopback HTTP peers. Signed receipt evidence and governed keys come from SDK node conformance captures; submitted and committed envelopes come from the existing interop peer fixture as detailed below. Bank vectors cover numeric wire heights, native and bank balances, nullable metadata and unavailable state. The Human peer uses the current intent schema and an in-scope merged fixture; it checks every submitted binding, fee, actor, deadline and pending nonce. The declared test imports all three repaired component suites so the single gate executes their assertions."
baseline = "No pre-change gate ran: the explicit implementation-first, hf-build then hf-done order prohibits the conflicting do_10 baseline verification; no pre-change test failures are claimed."
qualification = "hf-build and hf-done record the exact candidate revision, command, exit and private evidence location; the final hf-done record identifies the verified revision."
gotcha = "Vitest 4 treats test(namedFunction) as TODO; use test(namedFunction.name, namedFunction) to execute each declared test function."
wiring_request_schema = "Domain 10: services/human/schema/human-api/golden/intent.plan.request.json, intent.plan.response.json and journey.get.response.json still describe retired custody movement; publish merged producer captures for canonical Human sources, executable send/budget-defund legs and move journeys."
wiring_request_sdk = "Domain 10 with wallet SDK domain 12: sdk/wallet/src/types.ts IntentLeg and sdk/wallet/src/human.ts decodeIntentPlan must retain and validate the disclosed EVM nonce, chain_id, to, value, calldata, gas_limit and gas-price fields from services/human/schema/human-api/intent.kvx; the account binding currently follows the schema's pending nonce plus transaction index contract."
formatter_gotcha = "pnpm --dir apps/wallet dlx retained the repository working directory; run the formatter from apps/wallet explicitly so src/account paths resolve. The initial invocation matched no files and changed nothing."

