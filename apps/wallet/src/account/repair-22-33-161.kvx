gotcha = "The seeded daemon committed-fixture raw transaction uses EIP-155 chain 2770; the current wallet SDK authenticator requires chain 125, so adding the missing raw transaction method alone cannot qualify that capture."
wiring_request = "Node/daemon domain with wallet SDK domain 12: daemon/committed-fixture/vectors/vector-v4-committed.json and sdk/platform/conformance/fixtures/vector-v4-committed.json need a canonical chain-125 committed node capture with matching raw transaction and governed key data; retain SDK authentication and chain checks."

