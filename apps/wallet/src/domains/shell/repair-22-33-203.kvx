qualification_gotcha = "The first gate found that leaving a forward history entry between cases invalidates the next push-length assertion because pushState truncates that entry; each proof now restores the forward entry and asserts Settings recovery before cleanup, preserving the original length assertion."
evidence = "The verified candidate revision, exact command, exit code and private evidence location are recorded by hf-done in its final JSON line and /out/run/gates.jsonl; this record belongs to that candidate."
