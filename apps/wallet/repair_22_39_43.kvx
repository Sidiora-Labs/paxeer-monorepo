[repair.22.39.43]
mode = "BUILD"
criterion = "22998.1"
base_revision = "31084c2a39cdb49c1bbd01b48422cc3b169c76b6"
attempt_2_base_revision = "ee355f88697cff0e92f01537e2e8537368b52e28"
previous_attempt_base_revision = "a9167fbc68cb22ef78b223a753236832c99cda2f"
state = "Implementation complete; qualification is determined only by the bounded hf-done receipt."
verified_revision = "The exact candidate revision in the last hf-done receipt and matching build/verify rows of /out/run/gates.jsonl; this pointer does not claim a passing result before qualification."
evidence_ledger = "/out/run/gates.jsonl"
build_command = "cd apps/wallet && corepack enable && pnpm install --frozen-lockfile && cd ../.. && python3 -m py_compile tests/ci/test_wallet_repair_suites_listed.py"
verify_command = "python3 -m pytest -q tests/ci/test_wallet_repair_suites_listed.py && cd apps/wallet && corepack enable && pnpm exec vitest run src/widgets/txDetail/repair-22-33-141.test.ts src/lib/data/ src/lib/portfolio-api/repair-22-31-235.test.ts src/widgets/swap/repair-22-33-139.test.ts src/widgets/portfolio/repair-22-33-137.test.ts src/widgets/send/repair-22-33-136.test.ts src/widgets/tokenDetail/repair-22-33-140.test.ts src/app/api/push/subscribe/repair-22-33-166.test.ts src/lib/swap/executor.test.ts src/account/AccountView.test.tsx src/app/api/wallet/"
baseline = "No pre-change tests ran: the ordered task requires complete implementation before hf-build and hf-done. The initial working tree contained only runner-owned .cgignore and spec task-state changes, and no previous gate ledger."

[decision.account]
path = "apps/wallet/src/account/AccountView.test.tsx"
authority = "repair-22-33-161.kvx and current sdk/wallet chain-account and consensus decoders"
wrong_side = "The test replayed the retired available-network recording without consensus or account height, asserted a nonce absent from that recording, and registered the chain-account regression without a callback."
change = "Use the existing chain recording with consensus and numeric height, assert its exact 0x3 nonce, retain every identity/transport/error assertion, execute the named regression, and assert the consensus-unavailable notice for the three scenarios the peer now translates into that state."

[decision.push]
path = "apps/wallet/src/app/api/push/subscribe/repair-22-33-166.test.ts"
authority = "repair-22-33-166.kvx: exact endpoint/current stored owner/time/operation binding; current push-store provider/key validation and immutable ownership"
wrong_side = "The test supplied forbidden arbitrary push origins, invalid P-256/auth key bytes, and attempted to overwrite an existing endpoint owner."
change = "Generate real P-256 and 16-byte auth key material, use an admitted FCM origin, prove an attempted takeover leaves storage unchanged, then relinquish and resubscribe through real signed routes before asserting the old owner's proof is refused. All original signature, time, operation, endpoint, persistence and successful-removal assertions remain."

[decision.facades]
path = "apps/wallet/src/lib/data/facades/repair-22-33-126.test.ts"
authority = "repair-22-33-126.kvx: exact large-integer valuation, explicit partial/unknown valuation, and structured transfer errors"
wrong_side = "The existing peer omitted the wallet read chain acknowledgment required before decoding its payloads."
change = "Parse the actual request with parseWalletReadRequest, assert root identity, and emit walletReadResponseHeaders. Preserve exact path/query assertions after consuming the reserved chain parameter and retain all valuation and failure/retry assertions."

[decision.hooks]
path = "apps/wallet/src/lib/data/hooks/repair-22-33-132.test.ts"
authority = "repair-22-33-132.kvx: generation-guarded account reads and serialized pagination"
wrong_side = "The strict transcript peer compared requests without the subsequently required chain_id and returned no acknowledgment."
change = "Validate and consume the production chain identity contract at the HTTP boundary, then compare the original exact application path/query and headers; retain controlled out-of-order successes/errors, disconnect and pagination assertions."

[decision.portfolio_api]
path = "apps/wallet/src/lib/portfolio-api/repair-22-31-235.test.ts"
authority = "repair-22-31-235.kvx: real proxy authorization, authenticated lifecycle, bounded transport and unchanged producer errors"
wrong_side = "Production mismatch: Portfolio API GET clients now require chain_id and response acknowledgment, while the real portfolio proxy rejects that query parameter and emits no chain acknowledgment. The production proxy is outside this task's scope."
change = "Keep the real proxy/client lifecycle assertions intact and strengthen unauthorized mutation cases to prove no request reaches the producer. Do not strip identity from real client requests or inject acknowledgment headers into real proxy responses to conceal this mismatch."

[decision.executor]
path = "apps/wallet/src/lib/swap/executor.test.ts"
authority = "repair-22-31-236.kvx and repair-22-33-121.kvx: immutable confirmed minimums, real transaction execution and atomic slippage protection"
wrong_side = "The test depended on an absent external Anvil binary and unbuilt Hardhat artifacts rather than the wallet-owned JavaScript EVM environment introduced by later repairs."
change = "Compile the actual Solidity sources with the wallet's pinned solc during suite setup and execute them through the existing createSwapEvm state manager. A controlled mining queue signs real EthereumJS transactions and checks pending/mined hashes agree. Retain every original receipt, revert, decoded calldata, balance delta and adverse-price assertion with unchanged test timeouts."

[decision.portfolio]
path = "apps/wallet/src/widgets/portfolio/repair-22-33-137.test.ts"
authority = "repair-22-33-137.kvx: zero precision, persistent filters and chain/sender/hash-scoped pending reconciliation"
wrong_side = "The HTTP peer predated chain-aware wallet reads and fresh-read acknowledgments."
change = "Use the production read parser and response headers on real loopback reads, including fresh reconciliation; preserve layout, precision, filter, signed-send, account isolation, restart, durable retry and exact read-count assertions."

[decision.send]
path = "apps/wallet/src/widgets/send/repair-22-33-136.test.ts"
authority = "repair-22-33-136.kvx and repair-22-33-137.kvx wiring.legacy-pending-interface"
wrong_side = "The peer omitted chain/freshness acknowledgment and the optimistic assertion consumed the retired unscoped pending repository."
change = "Acknowledge real chain reads and inspect the actual scoped pending send produced by useSendForm; assert sender, chain, key, hash, zero precision and raw subtraction through that repository. Preserve all QR atomicity, network, account change, signing and recovery checks."

[decision.swap]
path = "apps/wallet/src/widgets/swap/repair-22-33-139.test.ts"
authority = "repair-22-33-139.kvx and repair-22-33-121.kvx: one frozen approval, validated units, and chain/endpoint-scoped discovery"
wrong_side = "The test never selected the new required swap network, replayed no registry membership read, persisted the retired token-list cache shape, and omitted wallet read acknowledgments."
change = "Select the real loopback JSON-RPC provider, replay ABI-encoded registry reads alongside existing quote responses, and obtain the persisted discovery record through fetchLaunchpadTokens. Age that actual serialized record through writeSwapRecord and retain exact freshness, merged-list, quote-count, immutable approval and stale-response assertions."

[decision.token_detail]
path = "apps/wallet/src/widgets/tokenDetail/repair-22-33-140.test.ts"
authority = "repair-22-33-140.kvx: independent 24-hour window, validated precision, contract/chain identity and disabled unknown-precision actions"
wrong_side = "The peer omitted wallet chain/freshness acknowledgment, while cache reads and updates still addressed keys from before network scoping."
change = "Use the production read boundary headers and production queryKeys/scopedQueryKey factories for portfolio, price and metadata; preserve exact candle coverage, zero-decimal units, action, contract identity and wrong-chain activity assertions."

[decision.tx_detail]
path = "apps/wallet/src/widgets/txDetail/repair-22-33-141.test.ts"
authority = "repair-22-33-141.kvx: wallet-related movements, separate outer status/fee, zero and unknown precision"
wrong_side = "The peer omitted the read identity contract and the tests refetched transaction metadata after transfers moved into an independent query."
change = "Validate real HTTP chain reads, wait for both independent queries, and refetch txTransfers when the peer's transfers change. Preserve all movement, precision, fee, status and counterparty assertions, including every invalid-precision parameter."

[decision.inventory]
path = "tests/ci/test_wallet_repair_suites_listed.py"
change = "Inventory every repair record under wallet/src, require its canonical or explicitly referenced colocated suite to exist, and prove each suite matches the Vitest includes used by the unconditional wallet matrix workflow. Existing records with different repair filenames resolve through their declared test paths rather than being exempted."

[gotcha.scope]
observed = "The task forbids edits to GOTCHA.kvx, qualification.kvx and spec files, and forbids committing/pushing; task-local decisions and findings stay in this repair record and qualification receipts stay in private runner storage."

[gotcha.query_split]
observed = "Transaction metadata and token transfers now have separate queries; refetching txDetail cannot update the token-transfer consumer."

[gotcha.tools]
observed = "The graph's scoped grep returned no results for a known route; direct source inspection established the actual interfaces. Anvil, compiled launchpad artifacts and an installed Prettier executable were absent."

[gotcha.formatter_directory]
observed = "An optional unused-import cleanup used repository-relative paths from apps/wallet and failed before writing; the formatter uses wallet-relative scoped paths."

