[decision.portfolio_api_attempt_3]
path = "apps/wallet/src/lib/portfolio-api/repair-22-31-235.test.ts"
authority = "repair-22-31-235.kvx finding.2 and finding.3 require real authenticated client/proxy lifecycle reads, restart recovery, no-store responses and unchanged producer errors. The current wallet-read-contract requires canonical chain_id and response acknowledgment."
wrong_side = "Production code: portfolio-api/client.ts sends chain_id on every GET and validates x-wallet-chain-id, but app/api/wallet/[...path]/route.ts forwardPortfolio admits only address or limit query parameters and copies no chain acknowledgment. Both successful lifecycle read assertions remain valid."
required_change = "The real proxy must consume and validate the wallet read identity before portfolio query validation and upstream routing, preserve credential and response bounds, and acknowledge the served chain. Both production files are outside the thirteen authorized paths."
preserved = "Keep the real client GET calls, exact successful lifecycle payload/status assertions, all recorded exchanges, restart checks and authorization/error checks intact. Do not strip chain_id or synthesize response headers in the HTTP adapter, replace real reads with direct fetch, or turn successful reads into expected failures."

