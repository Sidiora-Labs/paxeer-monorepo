[decision.portfolio_api_attempt_4]
paths = ["apps/wallet/src/app/api/wallet/[...path]/route.ts", "apps/wallet/src/lib/wallet-read-contract.ts", "apps/wallet/src/lib/portfolio-api/repair-22-31-235.test.ts"]
wrong_side = "Production code, as established in attempt 3: canonical root-chain reads are valid client requests and must reach the authenticated producer without the wallet-only identity parameter."
change = "Extract the existing canonical query-chain validator as parseWalletReadChainId and reuse it in both parseWalletReadRequest and forwardPortfolio. Admit exactly one chain_id on GET/HEAD, require the configured root chain and return the existing QUERY_INVALID 400 for malformed, duplicate or foreign identities; consume chain_id before upstream routing. Legacy reads without the reserved parameter remain supported."
bounds = "Permit only the existing one address or limit application parameter in addition to chain identity; preserve address syntax, delivery limits 1 through 100, mutation query refusal, authorization precedence, body/response bounds, rate limiting, timeouts, concurrency and all cache budgets/TTLs/deduplication."
response = "Every exported handler decorates its final response with WALLET_CHAIN_HEADER for the configured chain, including successful, cached, HEAD, upstream-error, admission-error and unsupported-method responses; cached payloads and upstream cache-control headers stay unchanged."
regression = "portfolio_reads_consume_chain_identity_and_preserve_query_bounds drives real GET/HEAD handlers and native loopback transport, asserting consumed identity, unchanged address/limit forwarding, legacy reads, no-store, bodyless HEAD, chain acknowledgment, and zero producer requests for invalid/duplicate/foreign chain and invalid application query cases. Existing authenticated restart lifecycle assertions remain unchanged."

[gotcha.attempt_4_contract]
observed = "validateWalletChainId intentionally admits virtual chain identities for general wallet reads, while the portfolio producer serves only the configured root chain; forwardPortfolio must additionally refuse valid-but-foreign virtual identities before upstream admission."

[gotcha.attempt_4_tools]
observed = "cortex_guard and a local Prettier executable are absent; no destructive or production action is needed. The scoped formatter uses the repository's existing Prettier configuration through an ephemeral package invocation."

[gotcha.attempt_4_formatter]
observed = "An ephemeral npx formatter invocation from apps/wallet failed before formatting because npm rejects the existing direct ws dependency override; invoking Prettier from /tmp with the same wallet configuration and explicit scoped paths succeeded without manifest changes."


