[repair.22.33.319]
finding = "rate_limit_without_captcha"
scope = "apps/explorer/ui/shared/AppError/custom"
implementation = "The rate-limit explanation always renders. Captcha, its button and the human-verification wording require a configured site key in the active chain configuration, a permitted bypass and public mode. The server reset countdown remains independent of captcha."
tests = "repair-22-33-319.spec.ts: rateLimitWithoutCaptchaShowsNoBypassExplanation, rateLimitWithoutCaptchaPreservesServerResetCountdown, rateLimitWithoutConfiguredBypassDoesNotOfferVerification, rateLimitNoBypassNeverRendersConfiguredCaptcha, rateLimitConfiguredPermittedBypassOffersCaptcha, rateLimitPrivateModeDoesNotOfferDisabledCaptcha, rateLimitUsesTheSameChainConfigurationAsCaptcha"
proof_boundary = "The committed response fixture is delivered through the harness fetch mock, as required by the continuation ruling; unexpected routes reject explicitly. Static imports load the real component and fetch hook module graphs during suite collection before each case reloads configuration; test timeouts are unchanged. Production modules are not mocked. Production useFetch decodes the headers; its rejected error supplies the production AppErrorTooManyRequests component rendered with real Chakra and multichain providers. Assertions inspect the rendered explanation, initial reset countdown, captcha container and bypass button. No captcha endpoint or external service is contacted."
baseline = "No baseline gate was run: the explicit task order requires full implementation before hf-build and hf-done and forbids running verify_cmd by hand. No pre-change execution failure is claimed; the missing-key tests exercise the unconditional throw in the original component."
wiring_requests = "None for this finding. The earlier ganache and frontend spec prerequisites are published; their out-of-scope files remain unchanged."
qualification = "Previous attempts were not qualified: the first build lacked ganache, and attempt 2 passed six tests while rateLimitWithoutCaptchaShowsNoBypassExplanation timed out. This continuation retains all assertions and replaces the live fixture transport with the required harness fetch mock. The bounded hf-build and hf-done ledger is the authority for this candidate revision, exact commands, exit codes and private evidence locations."
previous_build_evidence = "revision=777d16d3f9621275db7ed8ce9a1f8c76d7221ebf; command=pnpm --dir apps/explorer exec tsc --noEmit -p tsconfig.json; exit=2; log=/out/logs/build-1.log"
previous_observed = "TypeScript reports TS2307 at ui/marketplace/essentialDapps/revoke/hooks/repair-22-31-381.spec.ts(2,21): Cannot find module 'ganache' or its corresponding type declarations."
continuation = "Run the current frozen Yarn install, explorer type-check and focused Vitest gate through hf-build and hf-done without modifying the published prerequisites."
gotcha = "The captcha renderer selects the active multichain site key and suppresses itself in private mode; the error screen must use those same conditions before advertising a bypass."
gotcha_transport = "Disabling the harness fetch mock exposes fixture requests to live transport; keep the mock enabled, register the rate-limit fixture routes and reject unexpected requests."
gotcha_paths = "The production useFetch and useReCaptcha hooks use .tsx filenames despite containing no JSX; resolve record paths from the repository root."
lint_evidence = "command=cd apps/explorer && yarn eslint ui/shared/AppError/custom/AppErrorTooManyRequests.tsx ui/shared/AppError/custom/repair-22-33-319.spec.ts --fix; exit=0; log=/out/logs/format-eslint.log"
repair_evidence = "revision=7b2dd9c5ad016c1a1835bb2dda7eb74a41a51b12; command=cg spec done 22.33.319 -f layerx-merge --root /work/paxeer-monorepo; exit=1; log=/out/logs/verify-1.log; observed=The component module graph exceeded the setup hook timeout before any test executed; repair=Load production dependencies through static imports during suite collection, keeping every test assertion and timeout unchanged."
