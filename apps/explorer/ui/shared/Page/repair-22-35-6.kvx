[repair.22.35.6]
decision = "2587"
continuation_decision = "2605 (gotcha 3148): preserve attempt 1 and independently assert entity tab labels and the API transfer count; leave the other eight proofs unchanged."
navigation_decision = "2619 (gotcha 3165): preserve attempt 2, wait for the History trigger to report enabled, await the exact shallow router push and run that proof by name before the declared gates."
brief = "spec/layerx-merge/programme/docs/explorer-ui/design-brief.md sections 5 and 6"
base_revision = "d833a6274d362a720d5c0faf8b20f8a0b25e5348"
continuation_base_revision = "934c4543c0da2ea3489d79e7f7f1cea0ede0cdf1"
implementation = "Shared entity header with kind, h1, mono identifier, copy and QR controls and pill tags; labelled responsive 220px key grids; scrolling entity tabs; Transaction overview groups; Block information; Address Overview, History, Transfers, Portfolio, Analytics, Contract and More; Token Markets, History, Holders, Metadata and NFT Inventory."
routes = "Existing ids and nested ids remain the query values; parent groups recognize descendant aliases. The block index route remains Details, with Transactions the default. Token contract and widget routes live under Metadata."
market_data = "Render exchange_rate, circulating_market_cap, volume_24h and holders_count independently. Missing fields are em dashes, zero is retained, and no onchain market cap is derived. The existing API exposes no token price series, so Markets draws no chart."
proof = "Named jsdom tests render real shared components and entity pages with committed API fixtures, assert Address legacy route selection, missing and zero market values, labelled transaction and block groups, and colour roles in both modes."
existing_tests = "Update layout expectations to the requested entity names and grouped tabs; keep supply precision, socket buffering, count values, row ordering and control assertions on their real new surfaces."
visual_stories = "Transaction, Block, Address, Token, TokenInstance and touched component stories run in default light and dark-color-mode; screenshot gates are outside this task's declared gates."

[gotchas]
legacy_nft_aliases = "Address NFT collection/list aliases previously selected the NFT view without enabling its query; classify all existing NFT aliases consistently, preserve explicit list/collection selection and leave the alias when the user changes the display preference."
section_wrapper = "Changing a grid into a labelled group requires moving the matching closing tag with it; keep parent-hash rows in BLOCK INFO while preserving their existing copy and link controls."
formatter = "The app formatter is ESLint with layout fixes. Install the locked app dependencies to make it available, then format only task-touched TypeScript before the declared build."
gotcha_2962 = "The repair proof runs in jsdom against the actual React and query code with the committed API fixtures; no credentials, live RPC, external services, subprocess tests or browser gate."
state_pagination = "The transaction state-change API requires a next_page_params object even for an empty story response; retain items_count and state_changes instead of using null."
tab_counters = "The entity tab markup lives in toolkit/components/RoutedTabs/RoutedTabs.tsx; ui/shared/RoutedTabs/EntityTabs.tsx supplies grouping helpers. Labels expose data-tab-label and muted mono counters expose data-tab-count. The Address proof waits for and asserts the exact API count independently of the seven labels."
dependency_install = "The pre-format locked install timed out downloading @tabler/icons 3.35.0 from the registry; retry installation with a longer network timeout while preserving the lockfile and the declared gate commands."
named_registration_lint = "The layout formatter applied its fixes but ESLint exited 1 on the existing nine test(function.name, function) registrations (vitest/expect-expect and vitest/valid-title); preserve the required named proofs and use only hf-build and hf-done for qualification."
dependency_scan = "The candidate wrapper walks ignored dependency files; moving dependencies during that walk raced with an open and aborted preparation before a build command or ledger row. Keep installed dependencies outside the repository behind an ignored node_modules symlink before restarting qualification."
dependency_resolution = "An external dependency root must itself be named node_modules so transitive package imports resolve. Correct the external layout to /tmp/explorer-22-35-6-dependencies/node_modules while retaining the app's ignored node_modules symlink."
navigation_timing = "The tab-counter response is not a barrier for every query that disables Address tabs, and tab navigation may complete asynchronously. Assert that History is enabled before clicking and await the unchanged exact router query assertion under the existing waitFor timeout."
continuation_formatter = "ESLint applied layout fixes to the 53 task TypeScript files and exited 1 on the existing named-test registration rules, the existing snake-case transaction proof and conflicting function-parenthesis rules in repair-22-33-314/315; preserve the named proofs and assertions. Exact output is /out/logs/task-format.log; the declared build and verify remain the only qualification gates."

