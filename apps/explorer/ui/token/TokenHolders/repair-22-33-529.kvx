[finding.rows-holders]
tests = ["rowsHoldersTraversesLocalSubpagesBeforeAdvancingTheCursor", "rowsHoldersPaginatesASingleServerPageAndResetsTheSelection"]
repair = "Render every local subpage before advancing the API cursor, return to the previous server page's last local subpage, reset local paging on row-size changes, and offer only sizes supported within the fixed 50-row server page."
before_change = "The old component skips holders 26-50 on Next, has no local Next for a terminal 50-row response, and offers unsupported size 100; these regression assertions target those paths."

[finding.total-holder]
tests = ["totalHolderLabelsTheFinalPageWithoutInventingAGlobalTotal", "totalHolderPreservesAnAuthoritativeTotalAcrossPages"]
repair = "Without holdersCount, label the visible count as holders on this page even on a final server page reached after earlier pages; retain supplied authoritative totals."
before_change = "The old title reports More than 50 holders found initially and A total of 7 holders found on the final page; the page-count assertions reject both claims."
