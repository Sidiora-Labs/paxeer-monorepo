[gotcha.relative-path]
observed = "A dependency relocation using a repository-relative path failed while the command was running from the explorer directory."
action = "Resolve dependency paths relative to the command working directory; no source files were affected."

[gotcha.continuation-tooling]
observed = "The continuation sandbox ships pnpm 12, which refuses even version queries for this npm/yarn repository; pnpm 10 also refuses the npm package-manager declaration, and no explorer dependencies were restored."
action = "Restore the explorer's frozen Yarn dependency graph and use pnpm 8 for the prescribed gate commands; keep installed dependencies outside the source candidate."

[qualification.continuation-dependencies]
