[gotcha.tooling]
observed = "The sandbox dependency warm-up installed only root packages; its explorer pnpm install stopped because the application declares yarn."
action = "Install the declared explorer dependencies without changing its manifest, and retain the prescribed pnpm gate commands."

[gotcha.formatter]
observed = "The repository formatter's Vitest lint rules require string titles and inline assertions, while this task explicitly requires test(namedFunction) registration."
action = "Preserve the required named function registration and real assertions; leave lint rules enabled and use only the declared qualification gates."

[qualification.unrelated]
