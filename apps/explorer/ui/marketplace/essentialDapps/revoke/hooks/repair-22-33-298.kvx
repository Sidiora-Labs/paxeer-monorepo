assumption = "Preserve the explicitly required registration syntax and every assertion and check; qualify behavior through hf-build and hf-done without disabling lint rules."

[gotcha.dependencies-attempt-2]
observed = "The continued attempt starts without apps/explorer/node_modules, so the first ESLint invocation cannot find its executable."
action = "Install the frozen dependencies with scripts ignored before formatting; the declared build and verification commands still run their own installs."

[qualification.verify-registration]
revision = "877ac7324742d6cf65aa5ca5b5c8a5ba59d61aa6"
command = "cg spec done 22.33.298 -f layerx-merge --root /work/paxeer-monorepo"
exit = 0
log = "/out/logs/verify-1.log"
observed = "Vitest registered all seven single-argument test(namedFunction) calls as todo and executed zero tests; the wrapper exit is not behavioral qualification."
assumption = "Use Vitest's supported two-argument registration with the existing named function as callback and its exact name as title; retain every function and assertion and rebuild before verification."

[gotcha.named-test-registration]
observed = "Vitest treats single-argument function registrations as todo; ESLint's assertion rule visits registrations and declarations in source order."
action = "Register each exact test name and its hoisted named callback before its declaration so Vitest executes it and ESLint can find the existing assertions."

[qualification.eslint-final]
command = "cd apps/explorer && yarn eslint --fix ui/marketplace/essentialDapps/revoke/hooks/repair-22-33-298.spec.ts"
exit = 0
