[repair.22.33.532]
finding = "pending-stat-total"
implementation = "TxsContent labels pending counts as the number of pending transactions on the current page; general:stats.total_transactions continues to supply the validated heading only. HomeStats has no pending-total field, so the pending heading never claims a global total or extrapolates from a short later page."
proving_tests = "repair-22-33-532.spec.ts: pendingTitleCountsCurrentPageInsteadOfMinedHistory, pendingTitleUsesShortLaterPageWithoutEstimatingATotal; regression coverage: validatedTitleRetainsMatchingMinedTotal, emptyPendingPageDoesNotAdvertiseMinedHistory."
proof_boundary = "The production useApiQuery/useApiFetch/useFetch hooks read recorded stats and transaction fixtures over a test-owned loopback HTTP server; the production TxsContent, ScanTableCard and row components render through the real providers and Next router. The mined count 82258122 differs from the pending page sizes 3 and 1. No production endpoint or credential is required."
baseline = "No baseline gate was run: the governing order requires complete implementation before hf-build and then hf-done, and prohibits running verify_cmd by hand. No pre-change execution is claimed. Before this repair the two pending-title assertions would receive the mined-history total."
wiring_requests = "None; the audit proposal is fully implementable inside apps/explorer/ui/txs."
qualification = "The runner hf-build/hf-done ledger records the exact candidate revision, command, exit code and private evidence location; no passing result is claimed in advance."
gotcha = "Pending pagination can end with a short page, so multiplying its length by the page number cannot describe the total pending population. Use explicit current-page wording."
formatter_note = "The repository ESLint formatter applied layout fixes to the two touched TypeScript files. Its vitest/expect-expect rule reports four false positives at named-function registrations despite assertions in every callback; no lint rule or test was disabled. The declared gates are TypeScript and the targeted Vitest suite."
repair_cycle_1 = "The first hf-build exited 2 at revision 31483489c77faa09bf3312f227aa7a1589f197ae; /out/logs/build-1.log records TS2322 because the Next router was given TxsContent, which requires props. The router now receives the actual no-props TransactionPage that supplies the fetched rows and pagination, with each router disposed after its test. No type or assertion was loosened."
