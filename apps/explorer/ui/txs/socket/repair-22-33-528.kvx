wiring_requests = "None required by the repair proposal; the loopback producer uses committed transaction fixtures and does not claim execution of the backend notifier."
evidence = "The private hf-build/hf-done ledger records the exact candidate revision, command, exit and log; the runner retains and publishes that evidence with the repair."
