[qualification.previous-attempt-budget-accounting]
observed = "The wrapper counts each additional gate invocation as a repair: build-2 uses one; the required build-3 after the verify-1 repair uses the second before verify-2 can run. The user-ordered build-then-verify pair cannot fit that invocation accounting. No gate is bypassed, no budget is changed and no unexecuted result is claimed."

[qualification.continuation]
observed = "The resumed tree already contains the stats fixture and online-manager lifecycle repair described above, without qualification evidence for that repair. The continuation starts with an empty gate ledger, one build and one verify available, and two repair invocations remaining; only hf-build and hf-done will qualify this candidate."
scope = "Pre-existing .cgignore and spec/layerx-merge/spec.kvx changes are runner bookkeeping and remain untouched; gotchas and out-of-path wiring requests are recorded here because the explicit task scope prohibits editing the root and spec ledgers."
gotcha = "The resumed sandbox has no explorer node_modules, so the initial formatter invocation found no executable and changed nothing. Install the frozen dependencies with scripts disabled before formatting; no build or test runs during that setup."

