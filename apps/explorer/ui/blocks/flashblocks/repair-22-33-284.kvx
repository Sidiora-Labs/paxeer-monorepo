[gotcha.1]
observed = "jsdom Blob lacks the standard browser arrayBuffer API."
resolution = "The Blob codec proof uses Node's real web Blob; the hook receives actual text and ArrayBuffer frames over loopback WebSockets."

[gotcha.2]
observed = "Sandbox pnpm 11 and 10 refuse exec in this Yarn-configured app (and npm-configured workspace root)."
resolution = "Install dependencies with the declared Yarn 1.22.22 and run the unchanged pnpm exec gates with pnpm 8.15.9."

[gotcha.3]
observed = "Node 20 Buffer declarations are incompatible with the TypeScript 5.9 compression InputType used by the declared build."
resolution = "Encode fixture JSON with the standard TextEncoder before Brotli compression, preserving the bytes without a type cast."
