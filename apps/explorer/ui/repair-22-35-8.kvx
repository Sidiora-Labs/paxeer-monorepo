[repair.22.35.8]
decision = 2587
acceptance = "22998.1"
baseline = "c237654c0b31fa6ed26b3f94dac4267eab05b67d"
implementation = "Semantic colours across ui and toolkit components, persisted mode before OS preference, no sidebar calls in the shell, light and dark page integration."

[literals]
charts = "ChartSelectionX selection and border -> accent.soft/accent; ChartWidget stories -> chart.area/accent/positive."
indicators = "Home and multichain transaction/address/locked icons -> indicator semantic roles; ChainWidget translucent surface -> surface."
security = "Six SolidityScan severity colours -> securitySeverity roles; Uniswap brand pink -> brand.uniswap."
rewards = "Badge pastels, activity-pass background/badge/foreground/icon, merit-icon shadow and congratulations gradient -> rewards roles."
shared = "UserIdenticon overlay -> identicon.overlay; description fade -> description.fade; multichain promo gradient -> promo roles; social-link empty value -> text.muted."
editor = "Monaco colours -> LIGHT/DARK semantic palette adapter; RawDataSnippet -> surface; editor search shadow -> editor.search.shadow."
theme = "Progress stripe -> progress.stripe; invisible scrollbar border -> transparent; empty-state clipping path -> currentColor."
fixtures = "API payload fixtures and spec files retain arbitrary caller colours; production components and Playwright stories are swept."

[persistence]
mode = "ColorModeProvider reads the same chakra-ui-color-mode storage key as settings and the toggle; saved cookie supplies the initial mode when localStorage is absent."
canvas = "Light and dark theme choices share the foundational canvas colours, avoiding a legacy dark background override."
proof = "Real provider, controls, cookies and localStorage exercised across remount and an opposite system preference; default OS mode checked separately."

[stories]
paths = ["ui/home/VisualSystem.pw.tsx", "ui/snippets/header/VisualSystem.pw.tsx", "ui/tx/VisualSystem.pw.tsx", "ui/block/VisualSystem.pw.tsx", "ui/address/VisualSystem.pw.tsx", "ui/token/VisualSystem.pw.tsx"]
variants = "Every story registers +@dark-mode for the default light and existing dark-color-mode projects; shared helper asserts actual body canvas colour and sidebar absence."
execution = "Stories are supplied for the release browser matrix; this task runs only its declared build and verification."

