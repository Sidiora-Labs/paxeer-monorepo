[gotcha.baseline-order]
observed = "Task step 6 requests an unchanged-tree verify while the ordered gate instructions require implementation before testing."
resolution = "Follow the explicit gate order and record that no baseline was executed; do not consume a gate on an incomplete candidate."

[gotcha.dependency-setup]
observed = "The environment's initial dependency bootstrap failed: npm ci saw an unrelated root lock mismatch and pnpm refused the explorer's yarn package-manager pin."
resolution = "Install explorer dependencies with its declared Yarn manager before formatting and qualification."

[gotcha.gate-launcher]
observed = "The sandbox pnpm launcher enforces the root npm pin before executing a command inside the Yarn application."
resolution = "Use pnpm 10 with package-manager launcher selection disabled for gate execution; the declared TypeScript and Vitest commands and every test check stay intact."

[gotcha.test-registration-lint]
observed = "The existing ESLint Vitest plugin rejects test(functionReference), although the task explicitly requires that registration and the installed Vitest supports it."
resolution = "Keep the required named-function registrations and all assertions through a typed registration adapter that passes the function name and body to Vitest. No lint rule is disabled."

