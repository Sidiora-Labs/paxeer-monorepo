[repair.fixture_height]
file = "apps/explorer/lib/api/services/general/repair-22-31-380.spec.ts"
observed = "The literal height 1000 predates the committed-ok fixture's blockNumber 0xa, carried since bd50fa0d6a (22.30.156)."
repair = "Parse the fixture blockNumber with Number.parseInt, compare committedHeight with that value, and assert the signed tail's complete 32-byte big-endian batch ID encodes it; retain valid-signature and tampered-signature checks unchanged."
