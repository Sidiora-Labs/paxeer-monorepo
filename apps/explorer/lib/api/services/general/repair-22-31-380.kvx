finding = "signature_gateway_route"
implementation = "Admit only GET /api/v2/transactions/{transaction_hash_param}/signature through the existing bounded gateway path and header checks."
tests = ["signatureGatewayRouteMatchesTheProducerAndExplorerResource", "signatureReplayUsesTheBackendsCryptographicallyValidFixture", "signatureResourcePreservesTheReceiptKeySignatureAndCommittedHeight", "signatureResourcePreservesMissingAndInvalidHashRefusals", "explorer_signature_route_preserves_admission_bounds"]
