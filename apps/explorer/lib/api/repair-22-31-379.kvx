[repair.22.31.379]
finding = "chain_api_upstream"
scope = "apps/explorer/lib/api"
implementation = "Existing general:paxeer_x_chain resource names explicitly select paxeerXIndexer; the resolver requires that API in the selected configuration and never substitutes Blockscout. The dedicated namespace uses the same resource definitions."
tests = "repair-22-31-379.spec.ts: chainApiUsesDedicatedIndexerForEveryExistingConsumer, chainApiSupportsItsExplicitNamespace, chainApiRefusesMissingIndexerWithoutUsingBlockscout, chainApiPreservesTenantIdentityAcrossAllReads, chainApiReconstructsFeedRequestsFromPersistedCursorUrls, chainApiRoutesUnknownChainIdsToTheSameUpstream, chainApiReadsDirectoryDetailAndSummaryThroughRealTransport, chainApiPropagatesUnknownChainErrorsThroughRealTransport, chainApiResumesFeedCursorAfterReopeningTheConsumer"
proof_boundary = "The tests drive the production configuration resolver, URL builder and useApiFetch/useFetch hooks over real loopback HTTP against committed peer fixtures. They assert directory/detail/summary responses, tenant-specific routes and payloads, unknown_chain error propagation, both feeds and continuation from a saved cursor after closing and reopening the consumer. The Rust indexer and public gateway remain outside this proof boundary; their admission and producer restart proof are requested from domain 8."
baseline = "No baseline gate was run: the governing task order requires complete implementation before hf-build, then hf-done, and prohibits running verify_cmd by hand. No pre-change test failure is claimed."
wiring_request_config = "Domain 14: apps/explorer/configs/app/apis.ts must register paxeerXIndexer from an explicitly configured indexer-backed public endpoint and tenant basePath; deploy/env registration must carry the corresponding setting. Until configured the chain reads fail explicitly."
wiring_request_gateway = "Domain 8: services/platform/hosted/gateway/src/explorer_proxy.rs must admit bounded GET chain-directory, detail, summary, transfers and events routes to services/platform/hosted/indexer/src/api.rs with tenant identity preserved; register that public interface and prove directory/detail/feeds, unknown_chain errors and cursor recovery against the real producer."
qualification = "The runner hf-build/hf-done ledger records the exact candidate revision, command, exit and private evidence path; no qualification result is claimed in advance."
gotcha = "Chain resources retain general-prefixed consumer names, so upstream selection must use the resource API override before selecting config, credentials and headers."
environment = "The earlier attempt and runner dependency bootstrap failed before compilation with ERR_PNPM_OTHER_PM_EXPECTED. This continuation provisions pnpm 8.15.9 and installs dependencies with the application's pinned Yarn 1.22.22 using its frozen lockfile; the declared TypeScript and Vitest gate commands and repository manifests are unchanged."
formatter_note = "The repository ESLint formatter was applied only to the four task TypeScript files. Its Vitest lint plugin rejects the named-function test registration explicitly required by this task (valid-title and expect-expect); those lint rules and all nine test registrations remain intact. This is not a declared qualification gate."
repair_cycle_1 = "The first bounded build reported TS2322 only at the two recovered-cursor JSON.parse assignments; the repository intentionally returns unknown from JSON.parse. Both recovery paths now validate the saved cursor and chain id with Valibot instead of asserting a type. The next bounded build and verification qualify this repaired candidate."
