resolution = "Attempt 2 step do_5 explicitly authorizes replacing this undeclared import with a local TestResizeObserver class implementing observe, unobserve and disconnect, installed on globalThis for jsdom. No dependency, case, assertion or production observer behavior changes."

[repair.resize-observer]
