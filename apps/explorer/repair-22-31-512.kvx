[repair.page-tests]
prerequisite = "22.31.503 already merged into this branch."
implementation = "The node-fetch allowlist uses nextjs/pages-tests, verifies every allowlisted test exists outside pages, and retains the assertion that no test modules are routes. No prerequisite page-test move is repeated."

