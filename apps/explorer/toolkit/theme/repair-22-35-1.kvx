warning_soft = "The brief does not give a warning tint; use its warning RGB with the same 0.10 light / 0.14 dark alpha as the other feedback tints."
compatibility = "Keep variant names, legacy declarations and pill sizing contracts; compound variants apply the explorer visual system after legacy variant and size styles. The repair test checks resolved Chakra styles and existing recipe specs remain unchanged."
decision_2598 = "Amend the stat recipe scan assertion to retain its label check, require text.primary with no competing textStyle, and require statValue with fontWeight 600 in the scan compound variant because the brief retires heading.sm for stat values (gotcha 3139)."
component_path = "Existing isNumeric props emit a data marker consumed by the table number recipe; existing tab counters use the semantic muted tone. Call sites keep their current props."
proof = "repair-22-35-1.spec.ts walks every semantic colour, requires both modes, resolves all references without cycles, asserts exact role values and type metrics, composes real Chakra recipes and renders numeric cells and counts in process."
gotcha_2962 = "No external service, credential, RPC, device, subprocess or environment dependency in the repair proof."

[gotcha]
vitest_registration = "Vitest 4 accepts a function as the test name but requires a separate handler; register each declared function as both name and handler so all six proofs execute."

formatter = "The existing ESLint formatter was applied to touched TypeScript. Its older Vitest plugin rejects valid assertion messages and declared-function registrations; those assertions and handlers remain intact for the declared Vitest gate."

