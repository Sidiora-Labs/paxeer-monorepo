implementation = "Dark and light explorer palette, configured body and matching headings, mono numerals, flat hairline surfaces and composed core recipes."
tokens_added = ["canvas", "surface", "raised", "hairline", "border.strong", "text.primary", "text.secondary", "text.muted", "accent", "accent.soft", "onAccent", "positive", "positiveSoft", "negative", "negativeSoft", "warning", "warningSoft", "headerBar", "focusRing", "sparkline.up", "sparkline.down", "chart.grid", "chart.area.start", "chart.area.stop"]
keys_repointed = ["graphStart", "graphStop", "success", "successSoft", "destructive", "destructiveSoft", "warning", "warningSoft", "tonal", "outline", "dataTableBorder", "selectedOption", "bg.*", "text.*", "border.*", "icon.*", "heading", "accent.*", "feedback.*", "button.solid.*", "header.sticky.bg", "card.border", "table.row.hover", "stat.indicator.*"]
