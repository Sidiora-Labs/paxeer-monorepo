# Paxeer X Network explorer — run-time ENV preset.
#
# The image reads this tracked file when ENVS_PRESET=paxeer-x; no copy is needed.
# Deployment values, including empty strings, take precedence for:
# NEXT_PUBLIC_APP_PROTOCOL, NEXT_PUBLIC_APP_HOST, NEXT_PUBLIC_APP_PORT,
# NEXT_PUBLIC_APP_ENV, NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL,
# NEXT_PUBLIC_API_HOST and NEXT_PUBLIC_ASSISTANT_ENABLED.
# When absent from the process, these names take their preset values.
#
# The public explorer is paxscan.io and its API is api.paxscan.io. Link lists
# that the app fetches at run time come from this repository's main branch.

# App
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_APP_HOST=paxscan.io
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_INSTANCE=paxeer-x

# API
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=api.paxscan.io
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# Chain
NEXT_PUBLIC_NETWORK_NAME=Paxeer X Network
NEXT_PUBLIC_NETWORK_SHORT_NAME=Paxeer X
NEXT_PUBLIC_NETWORK_ID=125
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Paxeer
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=PAX
NEXT_PUBLIC_NETWORK_SECONDARY_COIN_SYMBOL=SID
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_IS_TESTNET=false

# Branding
NEXT_PUBLIC_NETWORK_LOGO=file:///app/public/static/paxeer-x/logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=file:///app/public/static/paxeer-x/logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=file:///app/public/static/paxeer-x/icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=file:///app/public/static/paxeer-x/icon-dark.svg
NEXT_PUBLIC_COLOR_THEME_OVERRIDES={'canvas':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#0B0C10'}},'surface':{'_light':{'value':'#F7F8FA'},'_dark':{'value':'#111319'}},'raised':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#171A21'}},'hairline':{'_light':{'value':'rgba(16,18,24,0.08)'},'_dark':{'value':'rgba(255,255,255,0.08)'}},'borderStrong':{'_light':{'value':'rgba(16,18,24,0.55)'},'_dark':{'value':'rgba(255,255,255,0.40)'}},'onAccent':{'_light':{'value':'#FFFFFF'},'_dark':{'value':'#0B0C10'}},'positive':{'_light':{'value':'#087645'},'_dark':{'value':'#2FD27D'}},'positiveSoft':{'_light':{'value':'rgba(14,143,85,0.10)'},'_dark':{'value':'rgba(47,210,125,0.14)'}},'negative':{'_light':{'value':'#D1343B'},'_dark':{'value':'#FF5C5C'}},'negativeSoft':{'_light':{'value':'rgba(209,52,59,0.10)'},'_dark':{'value':'rgba(255,92,92,0.14)'}},'warning':{'_light':{'value':'#945700'},'_dark':{'value':'#F5B544'}},'warningSoft':{'_light':{'value':'rgba(180,106,0,0.10)'},'_dark':{'value':'rgba(245,181,68,0.14)'}},'headerBar':{'_light':{'value':'rgba(255,255,255,0.85)'},'_dark':{'value':'rgba(11,12,16,0.85)'}},'focusRing':{'_light':{'value':'#2B4FDA'},'_dark':{'value':'#4F7DFF'}},'sparklineUp':{'_light':{'value':'#087645'},'_dark':{'value':'#2FD27D'}},'sparklineDown':{'_light':{'value':'#D1343B'},'_dark':{'value':'#FF5C5C'}},'chartGrid':{'_light':{'value':'rgba(16,18,24,0.08)'},'_dark':{'value':'rgba(255,255,255,0.08)'}},'chartAreaStart':{'_light':{'value':'rgba(43,79,218,0.30)'},'_dark':{'value':'rgba(79,125,255,0.30)'}},'chartAreaStop':{'_light':{'value':'rgba(43,79,218,0)'},'_dark':{'value':'rgba(79,125,255,0)'}},'graphStart':{'_light':{'value':'rgba(43,79,218,0.30)'},'_dark':{'value':'rgba(79,125,255,0.30)'}},'graphStop':{'_light':{'value':'rgba(43,79,218,0)'},'_dark':{'value':'rgba(79,125,255,0)'}},'success':{'_light':{'value':'#087645'},'_dark':{'value':'#2FD27D'}},'successSoft':{'_light':{'value':'rgba(14,143,85,0.10)'},'_dark':{'value':'rgba(47,210,125,0.14)'}},'destruc