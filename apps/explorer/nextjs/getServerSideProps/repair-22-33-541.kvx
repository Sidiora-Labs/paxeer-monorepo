[repair.22.33.541]
finding = "telemetry-rejection"
test_file = "apps/explorer/nextjs/getServerSideProps/repair-22-33-541.spec.ts"
tests = ["repairTelemetryRejectionKeepsPageRenderable", "repairTelemetryHttpFailureIsHandled", "repairTelemetryTimeoutAbortsWithoutBlockingPage", "repairTelemetrySuccessPreservesPayloadAndReleasesBody", "repairTelemetryRespectsTrackingGuards"]
baseline = "Not run: the explicit implementation-first order and hf-build/hf-done-only gates override step 5's unchanged-tree verification request; no pre-change test failure is claimed."
proof = "Real SSR handler props render through React over a loopback HTTP request; the real Undici HTTPS transport reaches a TLS-verified loopback monitor that refuses connections, resets connections, returns 503, stalls before headers, streams a body or returns 204. Tests assert page delivery, failure diagnostics, bounded abort and connection closure, unchanged reporting payload and tracking guards, with no unhandled rejections."
implementation = "Pageview reporting stays detached from page delivery, aborts after 1000 milliseconds, consumes rejected transport and non-success responses, cancels unused bodies and clears its timer."
tooling = "The runner's pnpm refused the app's Yarn pin before installing its dependencies. Install with the manifest-pinned Yarn 1.22.22 and run the unchanged declared gates with pnpm 8.15.9; no package-manager check or manifest is changed."
formatting_note = "ESLint layout fixes apply only to the touched TypeScript files. Its Vitest rules do not recognize the required named-function test registrations; assertions remain in those functions and no rule is disabled. Reporting diagnostics use the existing HTTP logger, configured with a real in-memory Pino stream in the test."
repair_cycle_1 = "Build revision 38c7fca11da88ebf6fe49d8d590d7f34e9247c20 exited 2 (private log /out/logs/build-1.log): HTTPS connection events expose Duplex and route queries can be undefined. Use server.closeAllConnections for cleanup and explicitly require query props before rendering; no casts, widened types or fallback values."
repair_cycle_2 = "Verification revision 410194fd11ac52f25269bd4295d8dceb0b3254ce exited 1 (private log /out/logs/verify-1.log): four tests passed, but Undici ignored the fixture's Host header and reported the loopback URL host. Route the explorer.test URL directly through the real connector to the loopback page server; preserve the exact hostname assertion."
wiring_request = "spec/layerx-merge/spec.kvx | fm-web-explorer-bridge (domain 14): attach this telemetry-rejection test mapping and the runner's verified revision, command, exit and private log to task 22.33.541."
