{
  "name": "@paxeer/names-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "pnpm --ignore-workspace --dir ../../sdk/names exec tsc -p tsconfig.json --outDir ../../apps/names/node_modules/@paxeer/names/dist"
  },
  "dependencies": {
    "@paxeer/names": "file:../../sdk/names",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.6.5"
    }
  }
}
