# Empty BENCHMARK_CONFIG selects the built-in configuration.
# Benchmark inputs apply to builds with the benchmark tag, on non-live chains.
BENCHMARK_CONFIG=
BENCHMARK_TXS_PER_BATCH=1000

# Set HOME to the process user's home directory; the node supplies no default.
HOME=

# Empty UPGRADE_VERSION_LIST keeps the embedded node/tags upgrade list.
UPGRADE_VERSION_LIST=
