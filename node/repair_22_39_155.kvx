[repair.replication_tls]
producer = "node/sequencer/dial.go:28 TLSConfig requires certificate, key, roots, DNS peer identity and SHA-256 SPKI pin; DialStandby at line 75 authenticates the primary connection"
fixture_producer = "node/sequencer/replication_tls_test.go:24 Repair103TLSFixture issues CA-signed Ed25519 certificates with client/server EKUs and cross-pinned peer identities"
helper = "node/standby_recorder_replication_test.go:replicationTLSFixture supplies the equivalent real certificates in package app_test; another package's test-only helper cannot be imported"
rpc = "TestEVMServerServesSequencerReceiptOption serves its real standby through a TLS listener from standbyTLS.TLSConfig(true), and the replicator dials with primaryTLS; receipt, replay, balances, nonces and WAL equality assertions remain"
recorder = "TestStandbyReplicatesRecorderGroupsThroughOpenAccount passes standbyTLS in Config.ReplicationTLS and primaryTLS to DialStandby, including the reconnect; every recorded execution, commit identity, account and stale-lease refusal assertion remains"

[repair.module_versions]
test = "TestV640ToV66UpgradeServesTheExchangeBridgeAndLaunchpadPrecompiles"
assertion = "After the production v6.6 plan, require each active module entry and its exact declared version; preserve the pre-plan NotContains loop for all five stores"
layerxcustody = "2 follows modules/layerxcustody/module.go:122 AppModule.ConsensusVersion"
layerxanchor = "No version-map entry follows node/upgrades.go:769 activationModulesPresent skipping anchor and node/app.go:1314 registering only its services; node/app.go:1169 constructs the module manager without anchor, so sdk/types/module/module.go:683 RunMigrations does not initialise or version it"
layerxexchange = "1 follows modules/layerxexchange/module.go:117 AppModule.ConsensusVersion"
layerxbridge = "1 follows modules/layerxbridge/module.go:122 AppModule.ConsensusVersion"
launchpad = "1 follows modules/launchpad/module.go:136 AppModule.ConsensusVersion"

[repair.baseline]
change = "Remove the three repaired tests from tests/ci/data/node_go_test_baseline.json and from .github/workflows/node-build.yml's skip pattern; recursive node coverage, timeout and count remain. The current base has also retired the three 22.39.116 entries, so preserve its empty baseline and full command without a skip pattern"

[repair.workflow_test_inventory]
file = "tests/ci/test_node_build_workflow_scope.py:node_test_command"
correction = "Preserve the current empty inventory following tests/ci/data/node_go_test_baseline.json:4 and the full suite command in .github/workflows/node-build.yml:118; the current base already retired 22.39.116. Keep the exact empty baseline, absence of -skip, full package command, timeout and count assertions rather than restoring stale seed exclusions"

[repair.served_venue]
test = "TestV640ToV66UpgradeServesTheExchangeBridgeAndLaunchpadPrecompiles"
producer = "node/app.go:4098 v6120Contracts constructs perps and node/app.go:4125 pairs it with the historical exchange at the exchange address; precompiles/perps/perps.go:25 declares that address as 0x1015"
abi_selection = "node/repair_m1142_test.go:85 selects totalMarkets for ordinary execution, and lines 92-115 obtain GetABI from the contract in EvmKeeper.CustomPrecompiles(ctx)"
assertion = "Require the served 0x1015 contract and its address, call totalMarkets through its selected ABI via StaticCallEVM, and assert the returned uint256 market count is exactly zero; replace the stale exchange intentNonce call without changing bridge assertions; the launchpad assertion is corrected below after qualification exposed its historical ABI mismatch"

[evidence.build]
command = "go vet ./node/"
reference = "/out/run/gates.jsonl: final kind=build row supplies revision, command, exit and private log"

[evidence.verify]
