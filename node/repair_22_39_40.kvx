verify_cmd = "go test -timeout 15m -count=1 -skip 'TestMergePlanReturnsGuarantorBonds|TestHostedKernelProgramsABIFollowsTheMergeUpgrade|TestHostedKernelProgramsABISurvivesRestart|TestEVMServerServesSequencerReceiptOption|TestStandbyReplicatesRecorderGroupsThroughOpenAccount|TestV640ToV66UpgradeServesTheExchangeBridgeAndLaunchpadPrecompiles' ./node/ && go test -timeout 15m -count=1 -run TestDriverReleasesNextOpenAcrossStandbyCommit ./node/sequencer/ && python3 -m pytest -q tests/ci/test_node_build_workflow_scope.py"
evidence = "The private runner ledger /out/run/gates.jsonl names the exact built and verified candidate revision, command, exit code and log. Qualification is claimed only when hf-done passes on the built revision."

[activation]
source = "docs/release/7.0.0-upgrade-plan.md sections 1 and 2"
decision = "Keep the 7.0 module and precompile set: anchor is absent from the module manager and version map, its historical store is preserved, and verify and anchor retirement interfaces depend on the live upgrade module. The activation tests must assert those interfaces remain registered before activation when their dependency exists, while every active fork module remains gated."
repair = "Activation readiness checks the active modules, preserving the historical anchor store list. Tests assert the exact module version map, retained anchor parameters, both precompile states and unchanged activation-height bounds. The pending-store fixture commits a consensus block identity with the height-2 tree deletion and asserts that identity after reopening."
pending_store_repair = "Keep the real xweb pending placeholder and the activation refusal. Flush the block cache and assert every activation store's commitment changeset is empty before pending writes can be discarded; iterate only stores with committed trees. The missing xweb tree has no committed entries and its empty changeset proves the block added none, without invoking the unsupported missing-tree iterator."

[standby]
repair = "Propagate the caller context through the driver's two ordered releases and bound WAL acknowledgement waits by the configured replication timeout. The real primary/standby scenario keeps both consensus commits, receipt and WAL equality assertions, and the requirement that the next OPEN is acknowledged before the standby commits. A context deadline bounds the entire scenario in a child process, including synchronous snapshot restore."

[workflow]
repair = "Keep recursive node package coverage and explicitly pass -timeout 15m -count=1. Three Python tests read the actual workflow and assert node coverage, sequencer coverage and the declared timeout."
baseline = "Decision 2820 and gotcha 3464 authorize exactly the three named node failures in tests/ci/data/node_go_test_baseline.json until retiring task 22.39.116 repairs them. Each entry names the failing assertion; the public workflow uses the identical skip pattern as the task verification, and the Python tests assert the exact command, baseline names, reasons and retiring task."

[qualification.first_run]
revision = "a981cacf0b289718ba69d85bccd3e4aa48f94882"
command = "cg spec done 22.39.40 -f layerx-merge --root /work/paxeer-monorepo"
exit = 1
log = "/out/logs/verify-1.log"
observed = "The other three activation repairs ran without failure. The pending-store fixture rejected an unsupported secp256k1 consensus key; the standby deadline produced stacks showing snapshot restore blocked on the SS importer, whose configured worker count was zero."
repair = "Use an ed25519 validator for the height-2 identity, configure one real SS import worker for the standby application, and assert a cancelled driver release writes no WAL entries. Keep the 30-second deadline and every cross-commit assertion."

