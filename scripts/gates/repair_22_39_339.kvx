[proof]
permitted = "RunGateTest.test_declared_untracked_build_outputs_are_permitted commits pom.xml, Package.swift and GateFixture.csproj in three directories, drives the real runner to create outputs under target, .build, obj and bin, asserts the untracked and ignored Git states and successful evidence, then reopens retained outputs in a fresh runner process. Existing output and evidence assertions remain intact."
missing_manifest = "RunGateTest.test_build_directories_without_manifests_are_refused asserts exit 125 before execution for all four directory names, both untracked and ignored, and proves no later command ran."
tracked_maven_source = "RunGateTest.test_tracked_files_in_maven_target_are_source commits a Maven manifest and a tracked file under target, modifies the tracked file through the real runner child, and asserts exit 125 after execution with no later command."
regressions = "Every existing RunGateTest case is retained. TestRepair2233899 inherits all cases and executes them again through the real CLI and isolated Git checkouts."
