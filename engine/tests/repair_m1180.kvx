[finding.state-runbook-recommends-exclusion]
implementation = "AGENTS.md separates diagnostics from qualification, declares a counted oracle-required command, prohibits exclusions as repairs and requires original command/count/revision evidence."
proving_test = "TestRepairM_1180_Runbook; TestRepairM_1180_RequiredSelection"

[finding.state-skip-inventory-hides-failures]
implementation = "Qualification never consults diagnostic exclusions; state_repairs.json owns all 101 cases and 23 categories, retaining literal identities and reasons, explicit missing historical evidence, active case replay commands and unresolved status. No exclusion has been removed or represented as repaired."
proving_test = "TestRepairM_1180_OwnedInventory; TestRepairM_1180_RequiredSelection"
remaining = "The historical divergences are not all qualified by this bounded transfer gate; unchanged original targets need owner repairs and original private failure evidence before this finding can be fully closed."
wiring_request = "node/app.go and engine/executor/** — owning domain 5: repair and qualify each unresolved executor divergence in data/state_repairs.json against its unchanged original fixture and command; retain counted candidate-revision evidence before removing any exclusion."
wiring_evidence_request = "spec/layerx-merge/programme/audit/records/22.30.54.kvx and private qualification evidence — owning domain 5: recover missing original commands, literal category selections and revisions; this task cannot manufacture them or edit spec records."

[finding.state-exception-one-sided-pass]
implementation = "Both real executors must return exactly one nonnil result; unexpected processing errors or transaction failures fail; expected exceptions need the same known kind on both sides and membership in the fixture's named allowed kinds. Unknown exceptions cannot pass."
proving_test = "TestRepairM_1180_ExceptionAgreement"
cases = "Real signed valid, nonce-rejected and funds-rejected transactions through both executors; both one-sided outcomes, different errors, wrong kind, unsupported kind, unexpected common failure and malformed encoded transaction inputs."

[finding.state-suite-zero-execution]
implementation = "An explicit directory/name/Cancun/count selection is mandatory; absent/empty/unsupported or mismatched selection fails; all selected fixtures execute without exclusions; selected/executed/required/skipped counts and exact identifiers are reported and asserted."
proving_test = "TestRepairM_1180_RequiredSelection"

[finding.state-oracle-opt-in]
implementation = "The qualification oracle is mandatory, checks either executor's explicit state differences and receipt-log hash, converts full uhpx plus wei balances correctly, and documents local chain-ID/fork/store-commitment adaptations without changing fixture expectations."
proving_test = "TestRepairM_1180_IndependentOracle; TestRepairM_1180_RequiredSelection"
cases = "An unchanged committed transfer expectation passes through both production executors; equal deliberately corrupted real-store nonces still pass the differential check but fail both independent fixture checks."

[gotcha.baseline-order]
